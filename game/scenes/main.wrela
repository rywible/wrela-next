// The scenes of slice 1a, each drawn by the engine (`engine::picture::pixels::Sight`) and, where
// `JUDGE` asks, held to the reference (`engine::reference`) by the judges (`engine::judge`).
// Nothing here draws: a scene says what is before the eye, and asks.
//
//     SCENE 0  the stage (`world::stage`) with the creature (`world::creature`) walking on it
//              (`rules::gaits::walk`), under the clear sky, in the photographic look
//     SCENE 1  the stone stack (`world::stack`) alone, from 100 m with a long lens (the volume
//              spike's view of it: spikes/volume/main.wrela's FROM, TO and FOV)
//     SCENE 2  the creature alone, 6 m off (the volume spike's body view); SCENE 3, 1.5 m off
//     SCENE 4  the stage alone, from the stage's eye
//     SCENE 5  no picture: how tight the derived ranges are (`engine::matter::ranges`)
//     SCENE 6  the hole audit (`engine::judge::audit`): the stage, the creature walking and the
//              stack, each alone, from `AUDIT_EYES` eyes round it, each drawn `AUDIT_FRAMES`
//              frames and its last picture held to the thing's own field
//
// Not judging, the walk plays at `PACE` s a frame and the engine draws every frame, a load beside
// it where `LOAD` asks (to time it). Judging, a moment at a time (`MOMENTS`, `PACE` s of the walk
// apart, from `FROM`): the reference's looks (the simple light the engine's stand-in is held to),
// while the engine draws the same moment; then the judges hold the engine's picture to the
// reference, with crawl from the moment before, and (first moment) the reference's second half
// to its first, the judges' own floor.
//
//     wrela build game/scenes -o <out> [--set SCENE=1] [--set JUDGE=true] [--set LOOKS=32]

use engine::judge::audit::{Audit, audit, eye_round}
use engine::judge::judge::{Judge, judge, marks}
use engine::mesh::draw::{MeshSight, MeshWorld, mesh_sight}
use engine::picture::eye::Eye
use engine::picture::picture::{Picture, picture}
use engine::picture::pixels::{Sight, sight, sight_held}
use engine::picture::screen::show
use engine::matter::ranges::{heard, probe}
use engine::matter::world::{many, one}
use engine::reference::reference::{Reference, Truth, reference, truth}
use engine::reference::traced::{SIMPLE, WHOLE}
use kit::motion::humanoid::{Rig, palette}
use kit::motion::playback::Move
use look::look::photo
use rules::gaits::walk
use rules::rig::rig
use std::io::print
use std::transform::translate
use world::creature::creature
use world::skeleton::on_rig
use world::sky::clear
use world::stack::{TALL_STACK, stack}
use world::stage::{PAINT, stage}
use kit::substances::matte::matte
use std::field::cuboid

/// Which scene (see the head of the file).
pub const SCENE: u32 = 0

/// Whether to realise the scene via universal GPU surface meshlets (`engine::mesh::draw::MeshSight`)
/// instead of the per-pixel raymarcher (`Sight`).
pub const MESH: bool = false

/// Whether the engine's picture is held to the reference.
pub const JUDGE: bool = false

/// Looks a half of the reference takes (an even number), the rays over the hemisphere a look.
pub const LOOKS: u32 = 32
pub const RAYS: u32 = 2

/// The reference's light: the sky as if nothing were in its way (false: its `SIMPLE`), or each sky
/// ray followed until it escapes or stops, nothing bouncing (true: `WHOLE` with no bounce).
pub const SKY_HIDDEN: bool = false

/// The moments judged, how far apart in the walk (s), and the first (s in). Not judging, the
/// walk moves `PACE` s a frame.
pub const MOMENTS: u32 = 1
pub const PACE: f32 = 0.016667
pub const FROM: f32 = 0.0

/// The load beside each frame while it is timed (sines a pixel; 0 none).
pub const LOAD: u32 = 0

/// To measure the engine's choices, not an author's: 0 the engine's own; 1 every root that holds
/// a surface answered by its field, 2 a still thing's by its cells (`ASKS`); a cell's side in m
/// (`CELL`, 0 the engine's own).
pub const ASKS: u32 = 0
pub const CELL: f32 = 0.0

/// To measure the engine's choices: whether a root may be answered by the parts live there (true,
/// the engine's own) or always by the whole field (false).
pub const PARTS: bool = true

/// The stack (SCENE 1): how far from its surface the eye stands (m, along the spike's line of
/// sight; 0: the spike's own eye, 100 m from its axis); whether the eye walks toward it at
/// `WALK_SPEED` m/s turning to and fro at up to `TURN_RATE` rad/s, for `WALK_FRAMES` frames, then
/// stops. Judged: the picture of the last walking frame (cells still filling), then the picture
/// `STILL_FRAMES` frames after it stopped. A still eye is judged after `STILL_FRAMES` frames too
/// (the cells a still eye wants are filled by then, or the lines say not).
pub const STACK_AT: f32 = 0.0

/// An instrument: after `STILL_FRAMES` frames, trace the eye's ray through pixel (`TRACE_X`,
/// `TRACE_Y`) through the stack and print it (SCENE 1, not judging: `Sight::trace`).
pub const TRACE: bool = false
pub const TRACE_X: u32 = 0
pub const TRACE_Y: u32 = 0
pub const TRACE_KIND: u32 = 1
pub const TRACE_EYE: u32 = 0
pub const EDGE: bool = false
pub const WALK: bool = false
pub const WALK_FRAMES: u32 = 90
pub const STILL_FRAMES: u32 = 30
const WALK_SPEED: f32 = 1.4
const TURN_RATE: f32 = 0.5236
const TURN_SWING: f32 = 0.15

/// An instrument: light's store's decisions held to the rays they save (the moving things'
/// shadows left out: `Sight::light_checked`).
pub const LIGHT_CHECK: bool = false

/// An instrument: light's store left out (every pixel's sun by its ray: `Sight::light_off`).
pub const LIGHT_OFF: bool = false

/// The hole audit (SCENE 6): eyes round each kind of thing, and frames each is drawn.
pub const AUDIT_EYES: u32 = 24
pub const AUDIT_FRAMES: u32 = 30

/// What is shown: 0 the engine's picture; 1 the reference; 2 where the judges read the engine's
/// coverage as off (`engine::judge::marks`); 3 each pixel's steps, 4 its edge pixels red (the
/// engine's instruments).
pub const SHOW: u32 = 0

/// Where the creature walks (its feet's spot), and toward the sun.
const AT = vec3(2.0, 0.0, 3.5)

/// The probe of many things (SCENE 8): how many creatures walk on the stage, out of step, and how
/// many small still boxes lie on it.
pub const CREATURES: u32 = 1
pub const BOXES: u32 = 256
const SUN = vec3(0.3, 0.6, 0.74)
const EXPOSURE: f32 = 1.2

/// The eye on the stage; on the stack (the spike's); on the creature 6 m and 1.5 m off (the
/// spike's).
const STAGE_EYE = Eye { at: vec3(9.0, 6.0, 11.0), toward: vec3(0.0, 1.0, 0.0), wide: 0.6 }
const STACK_EYE = Eye { at: vec3(0.0, 24.0, -100.0), toward: vec3(0.0, 21.0, 0.0), wide: 0.2 }
const BODY_FAR = Eye { at: vec3(2.7, 1.32, 5.28), toward: vec3(0.0, 0.6, 0.0), wide: 0.6 }
const BODY_NEAR = Eye { at: vec3(0.675, 0.78, 1.32), toward: vec3(0.0, 0.6, 0.0), wide: 0.6 }

pub struct Program {
    sight: Sight,
    mesh: MeshSight,
    reference: Reference,
    truth: Truth,
    full: Truth,
    scratch: Truth,
    shown: Picture,
    half: Picture,
    marked: Picture,
    judge: Judge,
    walk: Move,
    rig: Rig,
    moment: u32,
    /// Whether the engine has drawn this moment, and how many frames it has drawn in it.
    drawn: bool,
    draws: u32,
    frames: u32,
    finished: bool,
    said: bool,
    /// The turn that puts the stack's outline mid-view (`EDGE`; -1 until found).
    edge: f32,
    heard: Vec<engine::matter::ranges::Heard>,
    audit: Audit,
    /// The audit's kind (0 stage, 1 creature, 2 stack), eye, and frames drawn for it.
    kind: u32,
    eye_k: u32,
    shot: u32,
}

pub fn init() -> Program {
    var s = if ASKS != 0 || CELL > 0.0 || !PARTS { sight_held(ASKS, CELL, if PARTS { 0 } else { 1 }) } else { sight() }
    s.load = LOAD
    s.steps = if SHOW == 3 { 1 } else if SHOW == 4 { 2 } else if SHOW == 6 { 3 } else if SHOW == 7 { 4 } else { 0 }
    if LIGHT_CHECK {
        s.light_checked()
    }
    if LIGHT_OFF {
        s.light_off()
    }
    Program {
        sight: s,
        mesh: mesh_sight(),
        reference: reference(looks: LOOKS, rays: RAYS, bounces: 0, light: if SKY_HIDDEN { WHOLE } else { SIMPLE }),
        truth: truth(),
        full: truth(),
        scratch: truth(),
        shown: picture(width: 1, height: 1),
        half: picture(width: 1, height: 1),
        marked: picture(width: 1, height: 1),
        judge: judge(),
        walk: walk(),
        rig: rig(),
        moment: 0,
        drawn: false,
        draws: 0,
        frames: 0,
        finished: false,
        said: false,
        edge: -1.0,
        heard: Vec::new(),
        audit: audit(),
        kind: 0,
        eye_k: 0,
        shot: 0,
    }
}

/// The eye on the stack, `k` frames into its walk: on the spike's line of sight, `STACK_AT` m from
/// the surface (or the walk's start, 30 m), walked toward it and turned to and fro; or, still and
/// `EDGE`, turned (about the upright) until the stack's outline is in the middle of the view.
fn stack_eye(p: mut Program, field: world::stack::Stack, k: u32) -> Eye {
    if STACK_AT <= 0.0 && !WALK {
        return STACK_EYE
    }
    let d = normalize(STACK_EYE.toward - STACK_EYE.at)
    // Where the line of sight meets the stack's surface (a march on the CPU, by its value over
    // its stated steepness).
    var t = 0.0
    var i: u32 = 0
    while i < 4000 && field.distance(STACK_EYE.at + d * t) > 0.001 {
        t += max(field.distance(STACK_EYE.at + d * t) / 3.5, 0.0005)
        i += 1
    }
    let away = if WALK { 30.0 - WALK_SPEED * f32(k) / 60.0 } else { STACK_AT }
    let at = STACK_EYE.at + d * (t - away)
    if EDGE && !WALK && p.edge < 0.0 {
        // (The outline: the turn at which the line of sight just misses, halved to.)
        var a = 0.0
        var b = 1.4
        var j: u32 = 0
        while j < 24 {
            let m = 0.5 * (a + b)
            if meets(field, at, turned(d, m)) { a = m } else { b = m }
            j += 1
        }
        p.edge = a
    }
    let swing = if WALK { TURN_SWING * sin(TURN_RATE / TURN_SWING * f32(k) / 60.0) } else if EDGE { p.edge } else { 0.0 }
    let way = turned(d, swing)
    Eye { at, toward: at + way, wide: STACK_EYE.wide }
}

/// `d` turned by `a` rad about the upright.
fn turned(d: vec3, a: f32) -> vec3 {
    vec3(d.x * cos(a) - d.z * sin(a), d.y, d.x * sin(a) + d.z * cos(a))
}

/// Whether a ray from `o` along `d` meets the stack within 200 m (a march on the CPU).
fn meets(field: world::stack::Stack, o: vec3, d: vec3) -> bool {
    var t = 0.0
    var i: u32 = 0
    while i < 4000 && t < 200.0 {
        let f = field.distance(o + d * t)
        if f < 0.001 {
            return true
        }
        t += max(f / 3.5, 0.0005)
        i += 1
    }
    false
}

/// The creature as the walk poses it `t` s in.
fn posed(p: Program, t: f32) -> [mat4; 64] {
    on_rig(palette(p.rig, p.walk.pose(t), translate(vec3(0.0))))
}

pub fn frame(p: mut Program, time: f32, width: u32, height: u32) {
    let t = if JUDGE { FROM + PACE * f32(p.moment) } else { FROM + PACE * f32(p.frames) }
    p.frames += 1
    if p.frames % 60 == 0 {
        let (used, room) = p.sight.bytes()
        print(f"cells: frame {p.frames}: {used / 1048576.0} MB of cells in use, {room / 1048576.0} MB of room; {used / f32(width * height)} bytes a screen pixel")
    }
    let sky = clear(SUN)
    let look = photo(EXPOSURE)
    if SCENE == 1 {
        let field = stack(TALL_STACK)
        let world = one(field)
        // (Judging, once the engine has drawn the moment, the eye it drew it from: the frame before.)
        // (The walk's last frame is `WALK_FRAMES` - 1; it stops there.)
        let k = if JUDGE && p.drawn { min(p.draws - 1, WALK_FRAMES - 1) } else if JUDGE { min(p.draws, WALK_FRAMES - 1) } else { min(p.frames, WALK_FRAMES - 1) }
        let eye = stack_eye(mut p, field, if WALK { k } else { 0 })
        if JUDGE {
            judged(mut p, world, sky, look, eye, width, height, t)
        } else if MESH {
            p.mesh.draw(world, sky, look, eye, width, height)
        } else {
            p.sight.draw(world, sky, look, eye, width, height)
            if TRACE && p.frames == STILL_FRAMES {
                p.sight.trace(world, eye, width, height, TRACE_X, TRACE_Y)
            }
            if TRACE && p.sight.traced_said() {
                print("scene: done")
            }
        }
        return
    }
    if SCENE == 6 {
        audited(mut p, sky, look, width, height)
        return
    }
    if SCENE == 5 {
        if p.frames == 1 {
            var all = probe(stack(TALL_STACK), "the stack", n: 64, samples: 512)
            p.heard.push(heard(take all))
            all = probe(creature(posed(p, 0.0)), "the creature", n: 64, samples: 512)
            p.heard.push(heard(take all))
            all = probe(stage(), "the stage", n: 64, samples: 512)
            p.heard.push(heard(take all))
        }
        var done = true
        var i: u32 = 0
        while i < p.heard.len() {
            done = p.heard[i].done("") && done
            i += 1
        }
        if done && !p.said {
            p.said = true
            print("scene: done")
        }
        return
    }
    if SCENE == 4 {
        let world = one(stage())
        if JUDGE {
            judged(mut p, world, sky, look, STAGE_EYE, width, height, t)
        } else if MESH {
            p.mesh.draw(world, sky, look, STAGE_EYE, width, height)
        } else {
            p.sight.draw(world, sky, look, STAGE_EYE, width, height)
        }
        return
    }
    if SCENE == 8 {
        // A probe, nothing optimised: the stage, `CREATURES` creatures walking out of step on a
        // grid across it, `BOXES` small boxes strewn on it, at the game's camera.
        var bodies = [creature(posed(p, t)).translate(AT); CREATURES]
        for i in 0..CREATURES {
            let at = if CREATURES == 1 { AT } else { vec3(-6.3 + 1.8 * f32(i % 8), 0.0, -6.3 + 1.8 * f32(i / 8)) }
            bodies[i] = creature(posed(p, t + 0.37 * f32(i))).translate(at)
        }
        var boxes = [cuboid(vec3(0.08)).translate(vec3(0.0)).with(matte(PAINT)); BOXES]
        for i in 0..BOXES {
            let f = f32(i) + 0.5
            boxes[i] = cuboid(vec3(0.06 + 0.06 * fract(f * 0.754878))).translate(vec3(fract(f * 0.618034) * 15.0 - 7.5, 0.12, fract(f * 0.569840) * 15.0 - 7.5)).with(matte(PAINT))
        }
        let world = one(stage()).and(many(bodies)).and(many(boxes))
        if JUDGE {
            judged(mut p, world, sky, look, STAGE_EYE, width, height, t)
        } else if MESH {
            p.mesh.draw(world, sky, look, STAGE_EYE, width, height)
        } else {
            p.sight.draw(world, sky, look, STAGE_EYE, width, height)
        }
        return
    }
    let body = creature(posed(p, t))
    if SCENE >= 2 {
        let eye = if SCENE == 2 { BODY_FAR } else { BODY_NEAR }
        let world = one(body)
        if JUDGE {
            judged(mut p, world, sky, look, eye, width, height, t)
        } else if MESH {
            p.mesh.draw(world, sky, look, eye, width, height)
        } else {
            p.sight.draw(world, sky, look, eye, width, height)
        }
        return
    }
    let world = one(stage()).and(one(body.translate(AT)))
    if JUDGE {
        judged(mut p, world, sky, look, STAGE_EYE, width, height, t)
    } else if MESH {
        p.mesh.draw(world, sky, look, STAGE_EYE, width, height)
    } else {
        p.sight.draw(world, sky, look, STAGE_EYE, width, height)
    }
}

/// A frame of the hole audit (SCENE 6).
fn audited<S: engine::matter::sky::Sky, L: engine::picture::look::Look>(p: mut Program, sky: S, look: L, width: u32, height: u32) {
    if p.kind >= 3 {
        if !p.said {
            p.said = true
            print("scene: done")
        }
        return
    }
    if p.eye_k >= AUDIT_EYES {
        let what = if p.kind == 0 { "the stage" } else if p.kind == 1 { "the creature walking" } else { "the stack" }
        if p.audit.say(f"{what}, {AUDIT_EYES} eyes") {
            p.kind += 1
            p.eye_k = 0
            p.shot = 0
            p.sight = sight()
        }
        return
    }
    let body = creature(posed(p, PACE * f32(p.frames)))
    if p.kind == 0 {
        let field = stage()
        let eye = out_of(field, eye_round(field, vec4(0.0, 1.0, 0.0, 9.0), p.eye_k))
        audit_eye(mut p, one(field), field, sky, look, eye, width, height)
    } else if p.kind == 1 {
        let eye = out_of(body, eye_round(body, vec4(0.0, 0.62, 0.0, 0.8), p.eye_k))
        audit_eye(mut p, one(body), body, sky, look, eye, width, height)
    } else {
        let field = stack(TALL_STACK)
        let eye = out_of(field, eye_round(field, vec4(0.0, 20.0, 0.0, 28.0), p.eye_k))
        audit_eye(mut p, one(field), field, sky, look, eye, width, height)
    }
}

/// `eye`, moved out of `field`'s matter along its way from the middle of the view where it is in it.
fn out_of<M: std::field::Field<engine::matter::substance::Substance>>(field: M, eye: Eye) -> Eye {
    var e = eye
    var k: u32 = 0
    while k < 64 && field.distance(e.at) <= 0.05 {
        e.at = e.at + normalize(e.at - e.toward) * 0.5
        k += 1
    }
    e
}

/// One eye of the audit: drawn `AUDIT_FRAMES` frames, then its picture held to `field`.
fn audit_eye<W: engine::matter::world::World, M: std::field::Field<engine::matter::substance::Substance>, S: engine::matter::sky::Sky, L: engine::picture::look::Look>(
    p: mut Program,
    world: W,
    field: M,
    sky: S,
    look: L,
    eye: Eye,
    width: u32,
    height: u32,
) {
    p.sight.drawn_only(world, sky, look, eye, width, height)
    if p.sight.settled() {
        p.shot += 1
    }
    // (An instrument: the ray of pixel (`TRACE_X`, `TRACE_Y`) of eye `TRACE_EYE` of the kind
    // `TRACE_KIND`, traced (`Sight::trace`) as its picture is held.)
    if TRACE && p.kind == TRACE_KIND && p.eye_k == TRACE_EYE && p.shot == AUDIT_FRAMES {
        p.sight.trace(world, eye, width, height, TRACE_X, TRACE_Y)
    }
    if TRACE {
        let _ = p.sight.traced_said()
    }
    if p.shot >= AUDIT_FRAMES {
        p.audit.held(field, eye, p.sight.drawn.place, width, height, p.eye_k)
        p.eye_k += 1
        p.shot = 0
    }
    show(p.sight.drawn.colour)
}

/// A frame of judging: the engine draws the moment, the reference works on it; when its looks
/// are in, the judges hold the engine's picture to it.
fn judged<W: engine::matter::world::World + MeshWorld, S: engine::matter::sky::Sky, L: engine::picture::look::Look>(
    p: mut Program,
    world: W,
    sky: S,
    look: L,
    eye: Eye,
    width: u32,
    height: u32,
    t: f32,
) {
    if p.shown.width() != width || p.shown.height() != height {
        p.shown = picture(width: width, height: height)
    }
    if !p.finished {
        if !p.drawn {
            if MESH {
                p.mesh.drawn_only(world, sky, look, eye, width, height)
                p.draws += 1
                p.drawn = true
            } else {
                // (The engine draws until its cells are filled for this eye: `STILL_FRAMES` frames,
                // or the walk's.)
                p.sight.drawn_only(world, sky, look, eye, width, height)
                if p.sight.settled() {
                    p.draws += 1
                }
                let need = if WALK { WALK_FRAMES + STILL_FRAMES * p.moment } else { STILL_FRAMES }
                p.drawn = p.draws >= need
            }
        }
        if p.drawn && !p.reference.done() {
            p.reference.work(world, sky, look, eye, width, height)
        }
        if p.reference.done() && p.drawn {
            p.reference.picture(0, mut p.shown, mut p.scratch)
            p.reference.settle(0, mut p.full)
            if MESH {
                let _ = p.judge.held(p.mesh.drawn, p.full, eye, crawl: true, what: f"moment {p.moment} (walk at {t} s): the meshlet picture against the reference", sun: p.mesh.drawn.sun)
            } else {
                let _ = p.judge.held(p.sight.drawn, p.full, eye, crawl: true, what: f"moment {p.moment} (walk at {t} s): the engine's picture against the reference", sun: p.sight.drawn.sun)
            }
            if p.moment == 0 {
                p.reference.settle(1, mut p.truth)
                p.reference.picture(2, mut p.half, mut p.scratch)
                if MESH {
                    let _ = p.judge.held(p.half, p.truth, eye, crawl: false, what: "the reference's second half against its first (the judges' floor)", sun: p.mesh.drawn.sun)
                } else {
                    let _ = p.judge.held(p.half, p.truth, eye, crawl: false, what: "the reference's second half against its first (the judges' floor)", sun: p.sight.drawn.sun)
                }
            }
            if SHOW == 2 {
                if MESH {
                    marks(p.mesh.drawn, p.full, mut p.marked)
                } else {
                    marks(p.sight.drawn, p.full, mut p.marked)
                }
            }
            print(f"moment {p.moment} done")
            p.moment += 1
            p.drawn = false
            if WALK {
                // (The eye stopped: the same reference, the engine drawing on.)
                p.draws = WALK_FRAMES
                if p.moment >= 2 {
                    p.finished = true
                }
            } else {
                p.draws = 0
                if p.moment >= MOMENTS {
                    p.finished = true
                } else {
                    p.reference.begin()
                }
            }
        }
    }
    let all_heard = p.judge.heard(p.sight.edges_refused())
    if p.finished && all_heard && !p.said {
        p.said = true
        let refused = p.sight.edges_refused()
        print(f"judge: edge pixels refused a place: {refused.x}, in {refused.y} frames")
        print("scene: done")
    }
    if SHOW == 1 {
        show(p.shown.colour)
    } else if SHOW == 2 && p.marked.width() == width {
        show(p.marked.colour)
    } else if MESH && p.mesh.drawn.placed {
        show(p.mesh.drawn.colour)
    } else if p.sight.drawn.placed {
        show(p.sight.drawn.colour)
    } else {
        show(p.shown.colour)
    }
}

// ---- The paced reference against `traced`'s, on the CPU, by bits ------------------------------------------
use engine::matter::matter::{Matter, matter}
use engine::matter::substance::Substance
use std::field::Field
use engine::picture::eye::view
use engine::reference::paced::{DONE, PacedAt, UNITS, paced_begun, paced_step, said_begun}
use engine::reference::reference::{dice, jitter, THICK}
use engine::reference::traced::{ends, entered, lit, thickness}
use engine::matter::sky::seen
use engine::picture::look::{Look, Seen}
use engine::picture::screen::luma

/// The world, eye and light a judged scene `scene` is drawn in (as `frame` builds it at its first
/// moment): 0 the stage and one creature, 2 and 3 the creature far and near, 8 SCENE 8 at one creature.
fn judged_world_check(scene: u32, x0: u32, y0: u32, step_x: u32, step_y: u32, nx: u32, ny: u32, looks: u32, bounces: u32, light: u32) -> vec2u {
    let r = rig()
    let wk = walk()
    let body = creature(on_rig(palette(r, wk.pose(FROM), translate(vec3(0.0)))))
    var boxes = [cuboid(vec3(0.08)).translate(vec3(0.0)).with(matte(PAINT)); BOXES]
    for i in 0..BOXES {
        let f = f32(i) + 0.5
        boxes[i] = cuboid(vec3(0.06 + 0.06 * fract(f * 0.754878))).translate(vec3(fract(f * 0.618034) * 15.0 - 7.5, 0.12, fract(f * 0.569840) * 15.0 - 7.5)).with(matte(PAINT))
    }
    if scene == 8 {
        let world = one(stage()).and(many([body.translate(AT); 1])).and(many(boxes))
        return paced_check(matter(world.field()), STAGE_EYE, x0, y0, step_x, step_y, nx, ny, looks, bounces, light)
    } else if scene == 0 {
        let world = one(stage()).and(one(body.translate(AT)))
        return paced_check(matter(world.field()), STAGE_EYE, x0, y0, step_x, step_y, nx, ny, looks, bounces, light)
    }
    let world = one(body)
    paced_check(matter(world.field()), if scene == 2 { BODY_FAR } else { BODY_NEAR }, x0, y0, step_x, step_y, nx, ny, looks, bounces, light)
}

/// Paced against `traced`, by bits, at `nx` x `ny` pixels of 960x540 from (`x0`, `y0`) every
/// (`step_x`, `step_y`): the middle ray, its thickness and `looks` looks a half; how many checked and
/// how many differ.
fn paced_check<M: Field<Substance>>(m: Matter<M>, eye: Eye, x0: u32, y0: u32, step_x: u32, step_y: u32, nx: u32, ny: u32, looks: u32, bounces: u32, light_kind: u32) -> vec2u {
    let sky = clear(SUN)
    let lk = photo(EXPOSURE)
    let middle = view(eye, 960, 540)
    var checked: u32 = 0
    var differ: u32 = 0
    for j in 0..ny {
        for i in 0..nx {
            let x = x0 + i * step_x
            let y = y0 + j * step_y
            // traced's, as the reference's passes ask it.
            let d0 = middle.ray(vec2(f32(x) + 0.5, f32(y) + 0.5))
            let span0 = m.span(middle.at, d0)
            var centre = vec4(0.0)
            var behind = vec4(lk.tone(Seen { light: seen(sky, d0) }), 1.0)
            var thick = THICK
            if span0.y > max(span0.x, 0.0) {
                let t = entered(m, middle.at, d0, max(span0.x, 0.0), ends(m, middle.at, d0))
                if t < 0.0 {
                    behind.w = if t < -1.5 { 2.0 } else { 1.0 }
                } else {
                    let p = middle.at + d0 * t
                    let n = m.facing(p, -d0)
                    centre = vec4(n, t)
                    thickness_into(m, p, n, mut thick)
                }
            }
            var met = [vec4(0.0); 2]
            var mat = [vec4(0.0); 2]
            var far = [vec4(0.0); 2]
            for index in 0..(2 * looks) {
                let half = index % 2
                let v = middle.moved(jitter(half, index / 2))
                let d = v.ray(vec2(f32(x) + 0.5, f32(y) + 0.5))
                let span = m.span(v.at, d)
                var t = -1.0
                if span.y > max(span.x, 0.0) {
                    t = entered(m, v.at, d, max(span.x, 0.0), ends(m, v.at, d))
                }
                if t < 0.0 {
                    met[half] = met[half] + vec4(lk.tone(Seen { light: seen(sky, d) }), 0.0)
                } else {
                    let p = v.at + d * t
                    let n = m.facing(p, -d)
                    let s = m.made_of(p)
                    let light = lit(m, sky, p, n, s, -d, dice(x, y, index, 0), RAYS, bounces, light_kind)
                    let c = lk.tone(Seen { light })
                    let l = luma(c)
                    met[half] = met[half] + vec4(c, 1.0)
                    mat[half] = mat[half] + vec4(c, l * l)
                    far[half] = far[half] + vec4(t, t * t, 0.0, 0.0)
                }
            }
            // paced's.
            let at = PacedAt { x, y, salt: 0, looks, rays: RAYS, bounces, light: light_kind, spare: 0 }
            var ps = paced_begun()
            var sd = said_begun()
            var steps: u32 = 0
            while ps.st.x != DONE && steps < 200000 {
                steps += 1
                ps = paced_step(m, sky, lk, middle, at, ps, mut sd)
            }
            checked += 1
            let same_c = ps.st.x == DONE && same4(sd.centre, centre) && same4(sd.behind, behind) && bitcast_u32(sd.thick.x) == bitcast_u32(thick)
            let same_m = same4(sd.met0, met[0]) && same4(sd.matter0, mat[0]) && same4(sd.met1, met[1]) && same4(sd.matter1, mat[1])
            let same_f = same4(sd.far, vec4(far[0].x, far[0].y, far[1].x, far[1].y))
            let same = same_c && same_m && same_f
            if !same {
                differ += 1
                if differ <= 5 {
                    print(f"paced: ({x}, {y}) differs: centre {sd.centre} / {centre}, behind {sd.behind} / {behind}, thick {sd.thick.x} / {thick}, met0 {sd.met0} / {met[0]}, met1 {sd.met1} / {met[1]}, far {sd.far}; steps {steps}")
                }
            }
        }
    }
    vec2u(checked, differ)
}

@test
fn paced_is_traced_scene_0() {
    let a = judged_world_check(0, 16, 15, 32, 32, 30, 17, 2, 0, WHOLE)
    print(f"paced: SCENE 0: {a.x} px checked, {a.y} differ")
    assert(a.y == 0, "SCENE 0")
}

@test
fn paced_is_traced_scene_0_bounced_and_simple() {
    let a = judged_world_check(0, 0, 135, 64, 24, 15, 12, 2, 2, WHOLE)
    let b = judged_world_check(0, 32, 147, 64, 24, 15, 12, 2, 0, SIMPLE)
    print(f"paced: SCENE 0 with two bounces: {a.x} px checked, {a.y} differ; with the simple light: {b.x} px, {b.y} differ")
    assert(a.y == 0 && b.y == 0, "SCENE 0 bounced and simple")
}

@test
fn paced_is_traced_far() {
    let a = judged_world_check(2, 16, 15, 32, 32, 30, 17, 2, 0, WHOLE)
    print(f"paced: far: {a.x} px checked, {a.y} differ")
    assert(a.y == 0, "far")
}

@test
fn paced_is_traced_near() {
    let a = judged_world_check(3, 16, 15, 32, 32, 30, 17, 2, 0, WHOLE)
    print(f"paced: near: {a.x} px checked, {a.y} differ")
    assert(a.y == 0, "near")
}

@test
fn paced_is_traced_scene_8_grid() {
    let a = judged_world_check(8, 16, 15, 32, 32, 30, 17, 2, 0, WHOLE)
    print(f"paced: SCENE 8 at one creature, a grid: {a.x} px checked, {a.y} differ")
    assert(a.y == 0, "SCENE 8 grid")
}

@test
fn paced_is_traced_scene_8_heavy_rows() {
    // (The rows the CPU replay found heaviest, 288-432, where rays graze the stage's top among
    // the boxes; the replay's worst pixels (96, 336) and (768, 352) among them.)
    let a = judged_world_check(8, 0, 288, 32, 16, 30, 10, 2, 0, WHOLE)
    let b = judged_world_check(8, 96, 336, 1, 1, 8, 4, 2, 0, WHOLE)
    let c = judged_world_check(8, 768, 352, 1, 1, 8, 4, 2, 0, WHOLE)
    print(f"paced: SCENE 8 heavy rows: {a.x} px checked, {a.y} differ; round (96, 336): {b.x}, {b.y}; round (768, 352): {c.x}, {c.y}")
    assert(a.y == 0 && b.y == 0 && c.y == 0, "SCENE 8 heavy rows")
}

/// Paced against `traced` as the listed rounds drive it: `n` pixels of SCENE `scene` taken together,
/// `UNITS` steps a call, round after round over the pixels still undone, in `order` (0 row order,
/// 1 reversed, 2 rotated and reversed differently each round: always a permutation): each pixel's answers the same bits as `traced`'s.
fn paced_rounds_check(scene: u32, order: u32) -> vec2u {
    let r = rig()
    let wk = walk()
    let body = creature(on_rig(palette(r, wk.pose(FROM), translate(vec3(0.0)))))
    var boxes = [cuboid(vec3(0.08)).translate(vec3(0.0)).with(matte(PAINT)); BOXES]
    for i in 0..BOXES {
        let f = f32(i) + 0.5
        boxes[i] = cuboid(vec3(0.06 + 0.06 * fract(f * 0.754878))).translate(vec3(fract(f * 0.618034) * 15.0 - 7.5, 0.12, fract(f * 0.569840) * 15.0 - 7.5)).with(matte(PAINT))
    }
    if scene == 8 {
        let world = one(stage()).and(many([body.translate(AT); 1])).and(many(boxes))
        return rounds_of(matter(world.field()), STAGE_EYE, order)
    }
    let world = one(stage()).and(one(body.translate(AT)))
    rounds_of(matter(world.field()), STAGE_EYE, order)
}

fn rounds_of<M: Field<Substance>>(m: Matter<M>, eye: Eye, order: u32) -> vec2u {
    let sky = clear(SUN)
    let lk = photo(EXPOSURE)
    let middle = view(eye, 960, 540)
    let looks: u32 = 2
    // 48 pixels: a row through the heavy band and a column down the screen.
    var xs = [u32(0); 48]
    var ys = [u32(0); 48]
    for i in 0..24 {
        xs[i] = 40 * i
        ys[i] = 336
        xs[24 + i] = 480
        ys[24 + i] = 22 * i
    }
    var ps = [paced_begun(); 48]
    var sds = [said_begun(); 48]
    var undone = [u32(0); 48]
    var n: u32 = 48
    for i in 0..48 {
        undone[i] = i
    }
    var round: u32 = 0
    while n > 0 && round < 100000 {
        round += 1
        var next = [u32(0); 48]
        var m2: u32 = 0
        for j in 0..48 {
            if j < n {
                // The list's order this round.
                let rot = (j + round * 13) % n
                let jj = if order == 0 { j } else if order == 1 { n - 1 - j } else if round % 2 == 0 { rot } else { n - 1 - rot }
                let i = undone[jj]
                let at = PacedAt { x: xs[i], y: ys[i], salt: 0, looks, rays: RAYS, bounces: 0, light: WHOLE, spare: 0 }
                var s = ps[i]
                var sd = sds[i]
                var u: u32 = 0
                while u < UNITS && s.st.x != DONE {
                    u += 1
                    s = paced_step(m, sky, lk, middle, at, s, mut sd)
                }
                ps[i] = s
                sds[i] = sd
                if s.st.x != DONE {
                    next[m2] = i
                    m2 += 1
                }
            }
        }
        undone = next
        n = m2
    }
    var differ: u32 = 0
    for i in 0..48 {
        let one = paced_check(m, eye, xs[i], ys[i], 1, 1, 1, 1, looks, 0, WHOLE)
        // (paced_check runs the machine straight through; the rounds' answers must be its bits.)
        let at = PacedAt { x: xs[i], y: ys[i], salt: 0, looks, rays: RAYS, bounces: 0, light: WHOLE, spare: 0 }
        var s = paced_begun()
        var sd = said_begun()
        while s.st.x != DONE {
            s = paced_step(m, sky, lk, middle, at, s, mut sd)
        }
        let same = same4(sd.centre, sds[i].centre) && same4(sd.behind, sds[i].behind) && same4(sd.thick, sds[i].thick) && same4(sd.met0, sds[i].met0) && same4(sd.matter0, sds[i].matter0) && same4(sd.met1, sds[i].met1) && same4(sd.matter1, sds[i].matter1) && same4(sd.far, sds[i].far)
        if one.y != 0 || !same {
            differ += 1
        }
    }
    vec2u(48, differ)
}

@test
fn paced_rounds_are_traced_in_any_order() {
    var all: u32 = 0
    for order in 0..3 {
        let a = paced_rounds_check(0, order)
        let b = paced_rounds_check(8, order)
        print(f"paced: rounds in order {order}: SCENE 0 {a.x} px, {a.y} differ; SCENE 8 {b.x} px, {b.y} differ")
        all += a.y + b.y
    }
    assert(all == 0, "the rounds' answers are traced's in every order")
}

fn thickness_into<M: Field<Substance>>(m: Matter<M>, p: vec3, n: vec3, out: mut f32) {
    out = thickness(m, p, n, THICK)
}

/// Two vectors the same to the bit.
fn same4(a: vec4, b: vec4) -> bool {
    bitcast_u32(a.x) == bitcast_u32(b.x) && bitcast_u32(a.y) == bitcast_u32(b.y) && bitcast_u32(a.z) == bitcast_u32(b.z) && bitcast_u32(a.w) == bitcast_u32(b.w)
}

/// (SCRATCH) The paced machine's answers on the CPU at SCENE 0, 96x54, two looks a half (the judge's
/// first moment), every 8th pixel, as bits: to hold a --exact GPU run's to.
@test
fn paced_bits_scene_0_96x54() {
    let r = rig()
    let wk = walk()
    let body = creature(on_rig(palette(r, wk.pose(FROM), translate(vec3(0.0)))))
    let world = one(stage()).and(one(body.translate(AT)))
    let m = matter(world.field())
    let sky = clear(SUN)
    let lk = photo(EXPOSURE)
    let middle = view(STAGE_EYE, 96, 54)
    for j in 0..7 {
        for i in 0..12 {
            let x = 4 + 8 * i
            let y = 3 + 8 * j
            let at = PacedAt { x, y, salt: 0, looks: 2, rays: RAYS, bounces: 0, light: WHOLE, spare: 0 }
            var s = paced_begun()
            var sd = said_begun()
            while s.st.x != DONE {
                s = paced_step(m, sky, lk, middle, at, s, mut sd)
            }
            print(f"bits: {x} {y} {bitcast_u32(sd.centre.x)} {bitcast_u32(sd.centre.y)} {bitcast_u32(sd.centre.z)} {bitcast_u32(sd.centre.w)} {bitcast_u32(sd.behind.x)} {bitcast_u32(sd.behind.y)} {bitcast_u32(sd.behind.z)} {bitcast_u32(sd.behind.w)} {bitcast_u32(sd.thick.x)} {bitcast_u32(sd.met0.x)} {bitcast_u32(sd.met0.y)} {bitcast_u32(sd.met0.z)} {bitcast_u32(sd.met0.w)} {bitcast_u32(sd.matter0.x)} {bitcast_u32(sd.matter0.y)} {bitcast_u32(sd.matter0.z)} {bitcast_u32(sd.matter0.w)} {bitcast_u32(sd.met1.x)} {bitcast_u32(sd.met1.y)} {bitcast_u32(sd.met1.z)} {bitcast_u32(sd.met1.w)} {bitcast_u32(sd.matter1.x)} {bitcast_u32(sd.matter1.y)} {bitcast_u32(sd.matter1.z)} {bitcast_u32(sd.matter1.w)} {bitcast_u32(sd.far.x)} {bitcast_u32(sd.far.y)} {bitcast_u32(sd.far.z)} {bitcast_u32(sd.far.w)}")
        }
    }
}
