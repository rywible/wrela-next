/// Which scene (see the head of the file).
pub const SCENE: u32 = 0

/// Whether the engine's picture is held to the reference.
pub const JUDGE: bool = false

/// Whether the engine's sun visibility is held to the reference's shadow rays
/// (`engine::judge::sunlight`): the scene is drawn until its meshes are settled (`SUN_SETTLE` frames
/// at least), then judged row by row.
pub const SUNJUDGE: bool = false
/// The sun's judge over every placement and cell width the gate holds it at, one after another
/// in one run (`SUN_ROUND_RUNS`: placements 0 to 7 at `CELL_PX`, then placement 0 with cells a
/// tenth narrower and a tenth wider), each said as a judging alone is: thirty runs of a view were
/// thirty builds and thirty launches.
pub const SUN_ROUND: bool = false
const SUN_ROUND_RUNS: u32 = 10
/// The pool's judge (`engine::judge::pool`): each pooled kind of the arena and the study drawn
/// along a run and a turn at the game's fastest, its pooled mesh held to a cold extraction of its
/// cut, bit for bit; `scene: done` once all are held.
pub const POOLJUDGE: bool = false
/// Which placement of the world's lattice of cells the things are meshed on (`engine::mesh::grid::
/// placement`: 0 the world's own): `tools/gate` holds its judges and spans as means over several.
pub const PLACE: u32 = 0
pub const SUN_SETTLE: u32 = 16
/// How wide the meshes' finest cells are, in pixels where the surface is seen
/// (`engine::mesh::grid::CELL_PX`): `tools/gate` holds the sun's judge over others.
pub const CELL_PX: f32 = 2.5

/// Looks a half of the reference takes (an even number), the rays over the hemisphere a look.
pub const LOOKS: u32 = 32
pub const RAYS: u32 = 2

/// The reference's light: the sky as if nothing were in its way (false: its `SIMPLE`), or each sky
/// ray followed until it escapes or stops, nothing bouncing (true: `WHOLE` with no bounce).
pub const SKY_HIDDEN: bool = false

/// The moments judged, how far apart in the walk (s), and the first (s in). Not judging, the
/// walk moves `PACE` s a frame.
pub const MOMENTS: u32 = 1
pub const PACE: f32 = 0.016667
pub const FROM: f32 = 0.0

/// The stack (SCENE 1): how far from its surface the eye stands (m; 0: 100 m from its axis),
/// whether it walks toward it, and whether it turns to put the stack's outline mid-view.
pub const STACK_AT: f32 = 0.0
pub const EDGE: bool = false
pub const WALK: bool = false
pub const WALK_FRAMES: u32 = 90
const WALK_SPEED: f32 = 1.4
const TURN_RATE: f32 = 0.5236
const TURN_SWING: f32 = 0.15

/// The forge's showcase (SCENE 13): which eye, 0 the room's, 1 the carving's, 2 the book's
/// (`ROOM_EYE`, `CARVING_EYE`, `BOOK_EYE`), or 3 a tour that moves from the room's to the
/// carving's and on to the book's, `TOUR_FRAMES` frames each way (`tour_eye`): what is measured
/// of an eye that moves. The arena (SCENE 10): 3 is its eye walking round the casters
/// (`arena_walk_eye`), any other its still eye. In both, 4 is the eye running at the game's
/// fastest (`rules::caster::RUN_MOST`) and 5 the eye turning in place at its fastest
/// (`rules::caster::TURN_MOST`): what enters the view a frame at the most the rules allow
/// (`running_eye`, `turning_eye`).
pub const VIEW: u32 = 0

/// A frame at which to print each batch's extractions since frame 30 (`MeshDraw::
/// extraction_report`: how many times each thing was meshed, and the active bricks a meshing);
/// 0 for none.
pub const REPORT: u32 = 0

/// The frames the tour (`VIEW = 3`) takes from one of its eyes to the next.
pub const TOUR_FRAMES: u32 = 120

/// The hole audit (SCENE 6): eyes round each kind of thing.
pub const AUDIT_EYES: u32 = 24

/// The one kind the hole audit holds (its place in `audited`'s list), or every kind
/// (`AUDIT_KINDS` or more): `tools/audit --kind N`.
pub const AUDIT_KIND: u32 = 1000

/// The one eye of each kind the hole audit holds, or every eye (`AUDIT_EYES` or more):
/// `tools/audit --eye N`.
pub const AUDIT_EYE: u32 = 1000

/// What is shown when judging: 0 the engine's picture; 1 the reference; 2 where the judges read
/// the engine's coverage as off (`engine::judge::judging::SHOW_PICTURE`...).
pub const SHOW: u32 = 0

/// Whether the judges are checked at the first moment by faults planted in the reference's second
