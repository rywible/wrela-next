const ROOM_EYE = Eye { at: vec3(1.9, 1.5, 3.6), toward: vec3(0.0, 0.55, 1.4), wide: 0.6 }
const CARVING_EYE = Eye { at: vec3(0.62, 0.6, 2.18), toward: vec3(0.12, 0.52, 1.69), wide: 0.6 }
/// The stage's wall's face toward the table (z = its half thickness), and the gold set's eye.
const WALL_FACE: f32 = 0.1
const GOLD_EYE = Eye { at: vec3(2.3, 1.55, 4.1), toward: vec3(0.0, 0.8, 1.2), wide: 0.62 }
const BOOK_EYE = Eye { at: vec3(0.42, 1.28, 1.92), toward: vec3(0.2, 0.8, 1.48), wide: 0.6 }

/// Animated ocean swells surrounding the stage (`SCENE=9` cohesion showcase: pure `Height` field).
struct SeaWaves: Copy + GpuData {
    time: f32,
}

impl Height for SeaWaves {
    const HAS_OPAQUE: bool = false

    fn height_at(self, xz: vec2) -> HeightSample {
        let a = vec4(0.38, 0.24, 1.4, 0.14)
        let b = vec4(0.22, 0.51, 1.1, 0.09)
        let c = vec4(0.75, 0.62, 2.0, 0.04)
        swells(xz, self.time, a, b, c, level: -0.35, tint: vec3(0.10, 0.36, 0.44), roughness: 0.06)
    }
}

/// Low-lying drifting sea mist (`SCENE=9` cohesion showcase: pure `Medium` field).
struct SeaMist: Copy + GpuData {
    time: f32,
}

impl Medium for SeaMist {
    fn sample_at(self, p: vec3) -> MediumSample {
        let h = max(p.y + 0.2, 0.0)
        let wisp = 0.65 +
            0.35 * sin(p.x * 0.35 + self.time * 0.4) * cos(p.z * 0.3 - self.time * 0.3)
        let density = 0.032 * exp(-h * 0.42) * wisp
        MediumSample {
            density,
            albedo: vec3(0.86, 0.90, 0.95),
            emits: vec3(0.0),
            g: 0.55,
        }
    }
}

pub struct Program {
    mesh: MeshSight,
    judging: Judging<SHOW>,
    walk: Move,
    rig: Rig,
    frames: u32,
    said: bool,
    /// The turn that puts the stack's outline mid-view (`EDGE`; -1 until found).
    edge: f32,
    heard: Vec<engine::matter::ranges::Heard>,
    auditing: Auditing,
    edits: WorldEdits,
    sun: SunJudge,
    /// Whether the sun's judge has begun: the scene's meshes were settled.
    sun_begun: bool,
    /// The judging of a round (`SUN_ROUND`) under way, and the frames drawn for it.
    sun_run: u32,
    sun_frames: u32,
    /// The parry (SCENE 16) as it goes on: its break worked out once, when it breaks.
    parry: world::parry::ParryLoop,
    /// The pool's judge (`POOLJUDGE`) and the kind it is at.
    pool: PoolJudge,
    pool_kind: u32,
    /// The rule's count of the frames the gate reads, asked for (`coarse_counted`).
    coarse: Vec<std::io::Pending<u32>>,
    /// The pools' and watches' counts over a moving view's frames, asked for, and the pools' cold
    /// starts then (`tallied`).
    tally: Vec<std::io::Pending<u32>>,
    tally_colds: vec3u,
}

pub fn init() -> Program {
    Program {
        mesh: mesh_sight(gi: !JUDGE || SKY_HIDDEN, place: PLACE, cell_px: CELL_PX),
        judging: judging::<SHOW>(
            reference(looks: LOOKS, rays: RAYS, bounces: 0, light: if SKY_HIDDEN { WHOLE } else {
                SIMPLE
            }),
            moments: if WALK { 2 } else { MOMENTS },
            again: !WALK,
        ),
        walk: walk(),
        rig: rig(),
        frames: 0,
        said: false,
        edge: -1.0,
        heard: Vec::new(),
        auditing: auditing(),
        edits: world_edits(),
        sun: sun_judge(),
        sun_begun: false,
        sun_run: 0,
        sun_frames: 0,
        parry: world::parry::parry_loop(),
        pool: pool_judge(placement(PLACE), CELL_PX),
        pool_kind: 0,
        coarse: Vec::new(),
        tally: Vec::new(),
        tally_colds: vec3u(0, 0, 0),
    }
}

/// The eye on the stack, `k` frames into its walk: on the spike's line of sight, `STACK_AT` m from
/// the surface (or the walk's start, 30 m), walked toward it and turned to and fro; or, still and
/// `EDGE`, turned (about the upright) until the stack's outline is in the middle of the view.
fn stack_eye(p: mut Program, field: world::stack::Stack, k: u32) -> Eye {
    if STACK_AT <= 0.0 && !WALK {
        return STACK_EYE
    }
    let d = normalize(STACK_EYE.toward - STACK_EYE.at)
    // Where the line of sight meets the stack's surface.
    let (t, _) = march(field, STACK_EYE.at, d, 1.0e30)
    let away = if WALK { 30.0 - WALK_SPEED * f32(k) / 60.0 } else { STACK_AT }
    let at = STACK_EYE.at + d * (t - away)
    if EDGE && !WALK && p.edge < 0.0 {
        // (The outline: the turn at which the line of sight just misses, halved to.)
        var a = 0.0
        var b = 1.4
        var j: u32 = 0
        while j < 24 {
            let m = 0.5 * (a + b)
            let (_, met) = march(field, at, turned(d, m), 200.0)
            if met { a = m } else { b = m }
            j += 1
        }
        p.edge = a
    }
    let swing = if WALK { TURN_SWING * sin(TURN_RATE / TURN_SWING * f32(k) / 60.0) } else if EDGE {
        p.edge
    } else { 0.0 }
    let way = turned(d, swing)
    Eye { at, toward: at + way, wide: STACK_EYE.wide }
}

/// `d` turned by `a` rad about the upright.
fn turned(d: vec3, a: f32) -> vec3 {
    vec3(d.x * cos(a) - d.z * sin(a), d.y, d.x * sin(a) + d.z * cos(a))
}

/// How far along the ray from `o` along `d` the march stopped, and whether it met the stack's
/// surface (within 0.001 m) before `far` m or 4000 steps: a march on the CPU, by its value over
/// its stated steepness.
fn march(field: world::stack::Stack, o: vec3, d: vec3, far: f32) -> (f32, bool) {
    var t = 0.0
    var i: u32 = 0
    while i < 4000 && t < far {
        let f = field.distance(o + d * t)
        if f <= 0.001 {
            return (t, true)
        }
        t += max(f / 3.5, 0.0005)
        i += 1
    }
    (t, false)
}

/// The tour's eye (`VIEW = 3`) at frame `k`: the room's, then a smooth walk to the carving's
/// and on to the book's, `TOUR_FRAMES` frames each way, then the book's.
fn tour_eye(k: u32) -> Eye {
    let s = f32(k) / f32(max(TOUR_FRAMES, 1))
    let (a, b, u) = if s < 1.0 { (ROOM_EYE, CARVING_EYE, s) } else {
        (CARVING_EYE, BOOK_EYE, min(s - 1.0, 1.0))
    }
    let w = u * u * (3.0 - 2.0 * u)
    Eye { at: mix(a.at, b.at, vec3(w)), toward: mix(a.toward, b.toward, vec3(w)), wide: a.wide }
}

/// The arena's eye `k` frames into a walk round the casters: `ARENA_EYE` carried round the
/// upright through what it looks at, at a walker's pace (1.4 m/s at its 9 m, 60 frames a second),
/// looking at the same point.
fn arena_walk_eye(k: u32) -> Eye {
    let from = ARENA_EYE.at - ARENA_EYE.toward
    let turn = WALK_SPEED / (60.0 * length(vec2(from.x, from.z))) * f32(k)
    let (s, c) = (sin(turn), cos(turn))
    let at = ARENA_EYE.toward + vec3(c * from.x + s * from.z, from.y, c * from.z - s * from.x)
    Eye { at, toward: ARENA_EYE.toward, wide: ARENA_EYE.wide }
}

/// How far the running eye (`running_eye`) runs before it turns back (m).
const RUN_SPAN: f32 = 6.0

/// The eye `k` frames into a run at the game's fastest (`rules::caster::RUN_MOST`, 60 frames a
/// second) across what `from` looks at: sideways, back and forth over `RUN_SPAN` centred on
/// `from`, looking the way `from` does, so the scene stays in view.
fn running_eye(from: Eye, k: u32) -> Eye {
    let look = from.toward - from.at
    let side = normalize(cross(look, vec3(0.0, 1.0, 0.0)))
    let gone = rules::caster::RUN_MOST * f32(k) / 60.0
    let lap = gone / RUN_SPAN + 0.5
    let back = lap - 2.0 * floor(0.5 * lap)
    let off = RUN_SPAN * ((if back < 1.0 { back } else { 2.0 - back }) - 0.5)
    Eye { at: from.at + side * off, toward: from.toward + side * off, wide: from.wide }
}

/// The eye `k` frames into a turn in place about the upright at the game's fastest
/// (`rules::caster::TURN_MOST`, 60 frames a second), from looking as `from` does.
fn turning_eye(from: Eye, k: u32) -> Eye {
    let a = rules::caster::TURN_MOST * f32(k) / 60.0
    Eye { at: from.at, toward: from.at + turned(from.toward - from.at, a), wide: from.wide }
}

/// The frames of the pool's judge's run, then of its turn: past a few of the finest rings' steps,
/// then twice round.
const JUDGE_RUN: u32 = 90
const JUDGE_TURN: u32 = 60

/// A run across what `from` looks at, then a turn in place, at the game's fastest.
fn run_and_turn(from: Eye) -> Vec<Eye> {
    var eyes: Vec<Eye> = Vec::new()
    for k in 0..JUDGE_RUN {
        eyes.push(running_eye(from, k))
    }
    let end = running_eye(from, JUDGE_RUN - 1)
    for k in 1..(JUDGE_TURN + 1) {
        eyes.push(turning_eye(end, k))
    }
    eyes
}

/// The frames of camera cuts round a thing (the hole audit's eyes, `eye_round`, each held for
/// `JUDGE_HOLD` frames): a pool's updates after cuts, where an eye's last cut is not its next one's.
fn cuts_round<M: Field<Substance>>(field: M) -> Vec<Eye> {
    let b = field.bound()
    let sphere = vec4(b.centre, b.radius)
    var eyes: Vec<Eye> = Vec::new()
    for k in 0..JUDGE_CUTS {
        let e = eye_round(field, sphere, k)
        for _hold in 0..JUDGE_HOLD {
            eyes.push(e)
        }
    }
    eyes
}

/// The cuts `cuts_round` makes, and the frames each is held.
const JUDGE_CUTS: u32 = 12
const JUDGE_HOLD: u32 = 8

/// The pool's judge (`POOLJUDGE`): the arena's courtyard, then the study's room and table, each
/// held in turn, a fresh pool each (the arena's pillars are meshed at one level from its eye: no
/// pool).
fn pools_judged(p: mut Program, width: u32, height: u32) {
    let done = if p.pool_kind == 0 {
        p.pool.frame(arena_courtyard(), run_and_turn(ARENA_EYE), width, height, "the arena's courtyard")
    } else if p.pool_kind == 1 {
        p.pool.frame(study_room(), run_and_turn(ROOM_EYE), width, height, "the study's room")
    } else if p.pool_kind == 2 {
        p.pool.frame(table().translate(TABLE_AT), run_and_turn(CARVING_EYE), width, height, "the study's table, close")
    } else if p.pool_kind == 3 {
        p.pool.frame(citadel(), run_and_turn(CITADEL_EYE), width, height, "the citadel")
    } else if p.pool_kind == 4 {
        p.pool.frame(citadel(), cuts_round(citadel()), width, height, "the citadel, cut to eyes round it")
    } else {
        if !p.said {
            p.said = true
            print("judge pool: 5 kinds held")
            print("scene: done")
        }
        return
    }
    if done {
        p.pool_kind += 1
        p.pool = pool_judge(placement(PLACE), CELL_PX)
    }
}

/// One of the study room's slabs, and the room (`study_room`).
type StudySlab = std::field::With<std::field::Warp<std::field::Cuboid, std::field::Shift>, Substance>
type StudyRoom = std::field::Union<std::field::Union<StudySlab, StudySlab>, StudySlab>

/// The study's room (SCENE 13): its floor, its wall and the wall's skirting.
fn study_room() -> StudyRoom {
    let study_floor = cuboid(vec3(10.0, 0.25, 10.0))
        .translate(vec3(0.0, -0.25, 0.0))
        .with(glazed(vec3(0.24, 0.22, 0.20), roughness: 0.80, coat: 0.0, micro: 0.03))
    let study_wall = cuboid(vec3(9.0, 2.4, WALL_FACE))
        .translate(vec3(0.0, 2.4, 0.0))
        .with(glazed(vec3(0.38, 0.34, 0.28), roughness: 0.90, coat: 0.0, micro: 0.04))
    let skirting = cuboid(vec3(9.0, 0.075, 0.014))
        .translate(vec3(0.0, 0.075, WALL_FACE + 0.014))
        .with(glazed(vec3(0.14, 0.10, 0.068), roughness: 0.65, coat: 0.0, micro: 0.02))
    study_floor.union(study_wall).union(skirting)
}

/// The creature as the walk poses it `t` s in.
fn posed(p: Program, t: f32) -> [mat4; 64] {
    on_rig(palette(p.rig, p.walk.pose(t), translate(vec3(0.0))))
}

/// The creature as the walk poses it at `FROM` (a judged scene's first moment), on the CPU.
fn rest_body() -> Creature {
    creature(on_rig(palette(rig(), walk().pose(FROM), translate(vec3(0.0)))))
}

pub fn frame(p: mut Program, time: f32, width: u32, height: u32) {
    let t = if JUDGE { FROM + PACE * f32(p.judging.moment()) } else { FROM + PACE * f32(p.frames) }
    if REPORT > 0 && (p.frames == 30 || p.frames == REPORT) {
        let r = p.mesh.extraction_report()
        if p.frames == REPORT {
            print(f"extractions: SCENE {SCENE} VIEW {VIEW}, frames 30 to {REPORT}:{r}")
        }
    }
    if VIEW >= 3 && p.frames == 30 {
        p.mesh.reset_lateness()
    }
    if VIEW >= 3 && p.frames == 269 {
        let (lf, ms) = p.mesh.lateness()
        print(f"lateness: SCENE {SCENE} VIEW {VIEW}: late_frames {lf}, max_streak {ms}")
    }
    if VIEW >= 3 {
        tallied(mut p)
    }
    p.frames += 1
    let sky = clear(SUN)
    let look = photo(EXPOSURE)
    if SCENE == 1 {
        let field = stack(TALL_STACK)
        let world = one(field)
        // (Judging, the walk's first frame and then its last, each a moment.)
        let k = if JUDGE && p.judging.moment() == 0 { 0 } else if JUDGE { WALK_FRAMES - 1 } else {
            min(p.frames, WALK_FRAMES - 1)
        }
        let eye = stack_eye(mut p, field, if WALK { k } else { 0 })
        framed(mut p, world, sky, look, eye, width, height, t)
        return
    }
    if SCENE == 6 {
        audited(mut p, sky, look, width, height)
        return
    }
    if POOLJUDGE {
        pools_judged(mut p, width, height)
        return
    }
    if SCENE == 5 {
        if p.frames == 1 {
            var all = probe(stack(TALL_STACK), "the stack", n: 64, samples: 512)
            p.heard.push(heard(take all))
            all = probe(creature(posed(p, 0.0)), "the creature", n: 64, samples: 512)
            p.heard.push(heard(take all))
            all = probe(stage(), "the stage", n: 64, samples: 512)
            p.heard.push(heard(take all))
        }
        var done = true
        var i: u32 = 0
        while i < p.heard.len() {
            done = p.heard[i].done("") && done
            i += 1
        }
        if done && !p.said {
            p.said = true
            print("scene: done")
        }
        return
    }
    if SCENE == 4 {
        let world = one(stage())
        framed(mut p, world, sky, look, STAGE_EYE, width, height, t)
        return
    }
    if SCENE == 9 {
        // Unified PBR + refraction + dynamic emitter cohesion showcase:
        // still stage + walking creature + morphing glowing spell orb (auto-extracted dynamic light)
        // + refractive arcane crystal monolith (`glass`) + polished gold totem (`metal`) +
        // refractive ocean swells (`Height` + `water`) + sea mist (`Medium`) + physical Rayleigh/Mie
        // golden-hour `Atmosphere` sky + AgX `cinema` look with optical HDR bloom.
        let body = creature(posed(p, t)).translate(AT)
        let pulse = 0.40 + 0.06 * sin(t * 4.0)
        let orb = sphere(pulse)
            .smooth_union(cuboid(vec3(0.28)), 0.14)
            .translate(vec3(-0.7, 1.30 + 0.16 * sin(t * 2.2), 2.3))
            .with(emissive(vec3(1.0, 0.85, 0.60), vec3(24.0, 9.5, 2.2), roughness: 0.2))
        let crystal = cuboid(vec3(0.45, 1.15, 0.22))
            .smooth_union(sphere(0.32).translate(vec3(0.0, 0.75, 0.0)), 0.12)
            .translate(vec3(1.35, 1.15, 1.9))
            .with(glass(vec3(0.72, 0.92, 1.0), roughness: 0.04, ior: 1.52))
        let gold = sphere(0.42)
            .translate(vec3(-2.1, 0.55, 1.6))
            .with(metal(vec3(0.96, 0.76, 0.34), roughness: 0.18))
        let wet_slab = cuboid(vec3(2.8, 0.08, 2.4))
            .translate(vec3(-0.2, 0.04, 1.8))
            .with(glazed(vec3(0.14, 0.15, 0.17), roughness: 0.28, coat: 0.85))
        let world = one(stage())
            .and(one(wet_slab))
            .and(one(body))
            .and(one(orb))
            .and(one(crystal))
            .and(one(gold))
        let golden_sky = atmosphere(vec3(-0.65, 0.24, 0.72), turbidity: 2.4, intensity: 1.1)
        let cin_look = cinema(EXPOSURE * 1.15, bloom_strength: 0.09, bloom_threshold: 1.2)
        drawn_whole(
            mut p,
            world,
            SeaWaves { time: t },
            SeaMist { time: t },
            NoSwarm {},
            golden_sky,
            cin_look,
            STAGE_EYE,
            width,
            height,
        )
        return
    }
    if SCENE == 10 {
        // Signature parry-spellcraft arena showcase (100% pure fields, zero GPU code in game/):
        // wet basalt coastal courtyard + fluted ruined pillars with glowing runes + bronze braziers
        // + flickering HDR fire cores + opposing casters + refractive glass shard barrage + golden
        // parry arc + 16,384-grain GPU glass->sparks->sand swarm colliding with exact World SDF +
        // refractive ocean swells + sunlit volumetric sea mist + Rayleigh/Mie sky + AgX bloom.
        let hero = creature(posed(p, t))
            .rotate(Quat::axis_angle(vec3(0.0, 1.0, 0.0), 1.5707963))
            .translate(vec3(-2.75, 0.0, 0.20))
        let rival = creature(posed(p, t + 0.55))
            .rotate(Quat::axis_angle(vec3(0.0, 1.0, 0.0), -1.5707963))
            .translate(vec3(3.75, 0.0, 0.05))
        let world = one(arena_courtyard())
            .and(one(arena_pillars()))
            .and(one(arena_brazier_stands()))
            .and(pool_of(arena_flames(t)))
            .and(one(parry_arc(t)))
            .and(one(rival_orb(t)))
            .and(pool_of(glass_barrage(t)))
            .and(one(hero))
            .and(one(rival))
        let arena_sky = atmosphere(
            vec3(0.62, 0.14, -0.77),
            turbidity: 2.8,
            ground: vec3(0.04, 0.06, 0.09),
            intensity: 0.85,
        )
        let arena_look = cinema(EXPOSURE * 0.88, bloom_strength: 0.065, bloom_threshold: 1.65)
        drawn_whole(
            mut p,
            world,
            arena_sea(t),
            arena_mist(t),
            parry_sand_cloud(t),
            arena_sky,
            arena_look,
            if VIEW == 3 {
                arena_walk_eye(p.frames)
            } else if VIEW == 4 {
                running_eye(ARENA_EYE, p.frames)
            } else if VIEW == 5 {
                turning_eye(ARENA_EYE, p.frames)
            } else { ARENA_EYE },
            width,
            height,
        )
        return
    }
    if SCENE == 11 {
        // 100 m occluded stone citadel + 256 walking creatures: stresses 2-pass Reversed-Z Hi-Z
        // occlusion culling (`> 60%` occluded bricks culled, `< 10 ms` on Apple M4).
        let n_creatures = if CREATURES > 1 { CREATURES } else { 256 }
        var bodies: Vec<Translate<Creature>> = Vec::new()
        for i in 0..n_creatures {
            let at = in_the_citadel(i, n_creatures)
            bodies.push(creature(posed(p, t + 0.29 * f32(i))).translate(at))
        }
        let world = one(citadel()).and(pool(take bodies))
        let cit_sky = atmosphere(vec3(-0.42, 0.36, 0.83), turbidity: 2.2, intensity: 1.05)
        let cit_look = cinema(EXPOSURE * 1.05, bloom_strength: 0.05, bloom_threshold: 1.5)
        p.mesh.draw(world, cit_sky, cit_look, CITADEL_EYE, width, height)
        coarse_counted(mut p, CITADEL_EYE, width, height)
        if p.frames == 30 {
            let cs = p.mesh.cull.stats()
            print(
                f"cull: total={cs.total} frustum={cs.frustum_culled} hiz={cs.hiz_culled} p1={cs.pass1_drawn} p2={cs.pass2_drawn} culled_pct={cs.culled_fraction() * 100.0} hiz_in_frustum_pct={cs.hiz_fraction() * 100.0}",
            )
        }
        return
    }
    if SCENE == 12 {
        // Live CSG destruction showcase (`Edited<MarbleColumn>`):
        //   - Left: intact veined marble column
        //   - Center: live-edited column receiving a sphere blast on frame 6 and a diagonal spell
        //     slash on frame 10 (`< 0.15 ms` dirty-region in-place brick patch exposing real 3D
        //     interior marble veining and casting accurate cut shadows)
        //   - Right: pre-carved column with a seared glowing spell-blast interior material
        if p.frames == 6 {
            p.edits.append(edit_sphere_sub(vec3(0.32, 2.35, 0.44), radius: 0.54, k: 0.04))
        }
        if p.frames == 10 {
            p.edits.append(
                edit_capsule_sub(
                    vec3(-0.78, 1.35, 0.56),
                    vec3(0.82, 2.95, 0.22),
                    radius: 0.18,
                    k: 0.02,
                ),
            )
        }
        var right_edits = world_edits()
        right_edits.append(
            edit_sphere_sub(
                vec3(2.05, 2.20, 0.42),
                radius: 0.52,
                k: 0.05,
                interior: Some(
                    emissive(vec3(1.0, 0.55, 0.20), vec3(7.5, 2.2, 0.35), roughness: 0.5),
                ),
            ),
        )
        let floor = cuboid(vec3(6.0, 0.25, 4.5))
            .translate(vec3(0.0, -0.25, 0.0))
            .with(glazed(vec3(0.14, 0.15, 0.17), roughness: 0.34, coat: 0.55))
        let world = one(floor)
            .and(one(marble_column(centre_x: -2.35, centre_z: 0.0)))
            .and(one(edited(marble_column(centre_x: 0.0, centre_z: 0.0), p.edits)))
            .and(one(edited(marble_column(centre_x: 2.35, centre_z: 0.0), right_edits)))
        let csg_sky = atmosphere(vec3(0.55, 0.42, 0.72), turbidity: 2.0, intensity: 1.05)
        let csg_look = cinema(EXPOSURE * 1.05, bloom_strength: 0.06, bloom_threshold: 1.4)
        p.mesh.draw(world, csg_sky, csg_look, CSG_EYE, width, height)
        return
    }
    if SCENE == 13 {
        let desk = table().translate(TABLE_AT)
        let book = grimoire()
            .rotate(Quat::axis_angle(vec3(0.0, 1.0, 0.0), BOOK_TURN))
            .translate(TABLE_AT + BOOK_AT)
        let study_floor = cuboid(vec3(10.0, 0.25, 10.0))
            .translate(vec3(0.0, -0.25, 0.0))
            .with(glazed(vec3(0.24, 0.22, 0.20), roughness: 0.80, coat: 0.0, micro: 0.03))
        let study_wall = cuboid(vec3(9.0, 2.4, WALL_FACE))
            .translate(vec3(0.0, 2.4, 0.0))
            .with(glazed(vec3(0.38, 0.34, 0.28), roughness: 0.90, coat: 0.0, micro: 0.04))
        let skirting = cuboid(vec3(9.0, 0.075, 0.014))
            .translate(vec3(0.0, 0.075, WALL_FACE + 0.014))
            .with(glazed(vec3(0.14, 0.10, 0.068), roughness: 0.65, coat: 0.0, micro: 0.02))
        let room = study_floor.union(study_wall).union(skirting)
        let study_sky = clear(vec3(0.54, 0.52, 0.66))
        let study_look = photo(EXPOSURE * 1.05)
        let world = one(room).and(one(desk)).and(one(book))
        let eye = if VIEW == 1 { CARVING_EYE } else if VIEW == 2 { BOOK_EYE } else if VIEW == 3 {
            tour_eye(p.frames)
        } else if VIEW == 4 {
            running_eye(ROOM_EYE, p.frames)
        } else if VIEW == 5 {
            turning_eye(ROOM_EYE, p.frames)
        } else { ROOM_EYE }
        framed(mut p, world, study_sky, study_look, eye, width, height, t)
        return
    }
    if SCENE == 16 {
        // The parry the game is built toward (`world::parry`), on the arena's court, from behind
        // the shoulder of the caster the lightning is thrown at: the bolt strikes, meets the
        // sand, leaves its branch of glass hanging and glowing, and the branch breaks and falls.
        let now = p.parry.at(t)
        let world = one(arena_courtyard())
            .and(one(arena_pillars()))
            .and(one(arena_brazier_stands()))
            .and(one(now.bolt))
            .and(one(now.branch))
            .and(pool_of(now.pieces))
        let parry_sky = atmosphere(
            vec3(0.62, 0.14, -0.77),
            turbidity: 2.8,
            ground: vec3(0.04, 0.06, 0.09),
            intensity: 0.85,
        )
        let parry_look = cinema(EXPOSURE * 0.88, bloom_strength: 0.065, bloom_threshold: 1.65)
        // The sand is a cloud of grains far finer than a pixel: a medium, drawn in the volume.
        drawn_whole(mut p, world, engine::matter::height::NoHeight {}, now.sand, NoSwarm {}, parry_sky, parry_look, PARRY_EYE, width, height)
        return
    }
    if SCENE == 15 {
        // One part moves among still ones: a slab and three blocks standing, and a ball circling
        // them. Only the bricks the ball leaves and enters are extracted again each frame.
        let ball = sphere(0.35).translate(vec3(2.2 * cos(t * 0.8), 0.9, 2.2 * sin(t * 0.8)))
        let still = cuboid(vec3(4.0, 0.2, 4.0))
            .translate(vec3(0.0, -0.2, 0.0))
            .union(cuboid(vec3(0.3, 0.8, 0.3)).translate(vec3(-1.2, 0.8, 0.0)))
            .union(cuboid(vec3(0.3, 0.8, 0.3)).translate(vec3(1.2, 0.8, 0.0)))
            .union(cuboid(vec3(0.3, 0.8, 0.3)).translate(vec3(0.0, 0.8, -1.2)))
        let world = one(still.union(ball).with(matte(vec3(0.6, 0.55, 0.5))))
        framed(mut p, world, sky, look, STAGE_EYE, width, height, t)
        return
    }
    if SCENE == 14 {
        let desk = table().translate(TABLE_AT)
        let book = grimoire()
            .rotate(Quat::axis_angle(vec3(0.0, 1.0, 0.0), BOOK_TURN))
            .translate(TABLE_AT + BOOK_AT)
        let light = candlestick().translate(TABLE_AT + vec3(-0.32, 0.76, -0.16))
        let seat = chair()
            .rotate(Quat::axis_angle(vec3(0.0, 1.0, 0.0), 3.1415927))
            .translate(TABLE_AT + vec3(-0.3, 0.0, 0.62))
        let ledge = shelf().translate(vec3(0.4, 1.45, WALL_FACE))
        let study_floor = cuboid(vec3(10.0, 0.25, 10.0))
            .translate(vec3(0.0, -0.25, 0.0))
            .with(glazed(vec3(0.24, 0.22, 0.20), roughness: 0.80, coat: 0.0, micro: 0.03))
        let study_wall = cuboid(vec3(9.0, 2.4, WALL_FACE))
            .translate(vec3(0.0, 2.4, 0.0))
            .with(glazed(vec3(0.38, 0.34, 0.28), roughness: 0.90, coat: 0.0, micro: 0.04))
        let skirting = cuboid(vec3(9.0, 0.075, 0.014))
            .translate(vec3(0.0, 0.075, WALL_FACE + 0.014))
            .with(glazed(vec3(0.14, 0.10, 0.068), roughness: 0.65, coat: 0.0, micro: 0.02))
        let room = study_floor.union(study_wall).union(skirting)
        let study_sky = clear(vec3(0.54, 0.52, 0.66))
        let study_look = photo(EXPOSURE * 1.05)
        let world = one(room)
            .and(one(desk))
            .and(one(book))
            .and(one(light))
            .and(one(seat))
            .and(one(ledge))
        framed(mut p, world, study_sky, study_look, GOLD_EYE, width, height, t)
        return
    }
    if SCENE == 8 {
        // Crowd probe: the stage, `CREATURES` creatures walking out of step on a grid across it,
        // `BOXES` small boxes strewn on it, at the game's camera — backed by dynamic `Pool<M>`.
        var bodies: Vec<Translate<Creature>> = Vec::new()
        for i in 0..CREATURES {
            let at = if CREATURES == 1 { AT } else { on_the_stage(i, CREATURES) }
            bodies.push(creature(posed(p, t + 0.37 * f32(i))).translate(at))
        }
        let world = one(stage()).and(pool(take bodies)).and(pool_of(strewn()))
        p.mesh.draw(world, sky, look, STAGE_EYE, width, height)
        return
    }
    let body = creature(posed(p, t))
    if SCENE >= 2 {
        let eye = if SCENE == 2 { BODY_FAR } else { BODY_NEAR }
        let world = one(body)
        framed(mut p, world, sky, look, eye, width, height, t)
        return
    }
    framed(mut p, stage_with(body), sky, look, STAGE_EYE, width, height, t)
}

/// A frame of `world` through `eye`: judged where `JUDGE` asks, else drawn.
fn framed<W: engine::matter::world::World + MeshWorld, S: engine::matter::sky::Sky, L: engine::picture::look::Look>(
    p: mut Program,
    world: W,
    sky: S,
    look: L,
    eye: Eye,
    width: u32,
    height: u32,
    t: f32,
) {
    if SUNJUDGE {
        // Drawn until its meshes are settled (and `SUN_SETTLE` frames at least: the frames'
        // history), then judged: a machine that takes more frames to mesh the scene is judged on
        // its whole picture too (the Radeon, at 16 frames, was judged with casters missing).
        p.sun_frames += 1
        if !p.sun_begun && (p.sun_frames <= SUN_SETTLE + 1 || !p.mesh.settled()) {
            // (One subframe: the sun judged is the first's, `drawn.sun`; the rest are the colour's.)
            p.mesh.drawn_only(world, sky, look, eye, width, height, subframes: 1)
        } else if !p.sun.done() {
            p.sun_begun = true
            p.sun.work(
                p.mesh.drawn,
                p.mesh.sun_cls,
                world,
                sky,
                eye,
                f"SCENE {SCENE} VIEW {VIEW}",
                160,
                untraced: p.mesh.sun_untraced(),
            )
            if p.sun.done() {
                if SUN_ROUND && p.sun_run + 1 < SUN_ROUND_RUNS {
                    // The round's next judging: the mesh and the judge begun again at its
                    // placement and cell width.
                    p.sun_run += 1
                    let r = p.sun_run
                    p.mesh = mesh_sight(
                        gi: !JUDGE || SKY_HIDDEN,
                        place: if r < 8 { r } else { 0 },
                        cell_px: if r == 8 { CELL_PX * 0.9 } else if r == 9 { CELL_PX * 1.1 } else { CELL_PX },
                    )
                    p.sun = sun_judge()
                    p.sun_begun = false
                    p.sun_frames = 0
                    return
                }
                print("scene: done")
            }
        }
        if p.sun.done() {
            show(p.sun.marks)
        } else {
            show(p.mesh.drawn.colour)
        }
    } else if JUDGE {
        p.judging.frame(mut p.mesh, world, sky, look, eye, width, height, t)
        if FAULTS {
            p.judging.faults(p.mesh, eye, FAULT_AT)
        }
    } else {
        p.mesh.draw(world, sky, look, eye, width, height)
        coarse_counted(mut p, eye, width, height)
    }
}

/// The last frame the gate reads of a still view and of a moving one (`tools/gate`'s
/// `FRAME_RANGE`, `MOVING_RANGE`).
const STILL_LAST: u32 = 89
const MOVING_LAST: u32 = 269

/// A moving view's pools and watches over the frames the gate reads (from frame 30, where
/// `reset_lateness` empties the counts, to `MOVING_LAST - 2`), said once the GPU's counts are in:
/// `pool: SCENE s VIEW v: resident bricks meshed again N ...` (the bricks a pool let go in a cold
/// start for the same thing, and the keys it meshed that it held or its hash lost: the plan wants
/// none) and `watch: SCENE s VIEW v: S of R runs short ...` (an outline's watch whose lists held
/// more than its slices took: its frame was drawn without the exact cells of the rest).
fn tallied(p: mut Program) {
    if p.frames + 2 == MOVING_LAST {
        let (colds, dropped, grown) = p.mesh.pool_colds()
        p.tally_colds = vec3u(colds, dropped, grown)
        p.tally.push(p.mesh.read_tally())
    }
    if p.tally.len() > 0 {
        match p.tally[0].poll() {
            Some(Ok(c)) => {
                let again = p.tally_colds.y + c[TALLY_DOUBLED] + c[TALLY_LOST]
                print(f"pool: SCENE {SCENE} VIEW {VIEW}: resident bricks meshed again {again} ({p.tally_colds.x} cold starts, {p.tally_colds.z} of them for buffers grown, let go {p.tally_colds.y}, {c[TALLY_DOUBLED]} keys meshed while held, {c[TALLY_LOST]} keys the hash lost), frames 30 to {MOVING_LAST - 3}")
                print(f"watch: SCENE {SCENE} VIEW {VIEW}: {c[TALLY_SHORT]} of {c[TALLY_RUNS]} runs short of their lists ({c[TALLY_UNASKED]} cells unasked), frames 30 to {MOVING_LAST - 3}")
                p.tally = Vec::new()
            },
            Some(Err(_)) => {
                p.tally = Vec::new()
            },
            None => {},
        }
    }
}

/// The rings held to the rule over the frames the gate reads (`MeshSight::count_coarse`): each
/// frame's pixels counted from frame 30 on, and said once the frames are in, as
/// `coarse: SCENE s VIEW v: ...`.
fn coarse_counted(p: mut Program, eye: Eye, width: u32, height: u32) {
    let last = if VIEW >= 3 { MOVING_LAST } else { STILL_LAST }
    if p.frames == 30 {
        p.mesh.reset_coarse()
    }
    if p.frames >= 30 && p.frames + 2 < last {
        p.mesh.count_coarse()
    }
    if p.frames + 2 == last {
        p.coarse.push(p.mesh.read_coarse())
    }
    if p.coarse.len() > 0 {
        match p.coarse[0].poll() {
            Some(Ok(c)) => {
                let levels = f32(c[3]) / 16.0 / f32(max(c[0], 1))
                print(f"coarse: SCENE {SCENE} VIEW {VIEW}: {levels} levels coarser than the rule wants a judged pixel ({c[1]} of {c[0]} coarser: by up to 1 level {c[4]}, to 2 {c[5]}, to 3 {c[6]}, more {c[7]}), {c[2]} not judged, frames 30 to {last - 3}")
                for b in 0..COARSE_BATCHES {
                    let row = COARSE_ROWS + COARSE_ROW_WORDS * b
                    if c[row] > 0 {
                        print(f"coarse: batch {b}: {f32(c[row + 2]) / 16.0 / f32(c[row])} levels coarser a pixel of its {c[row]} judged, {c[row + 1]} of them coarser")
                    }
                }
                p.coarse = Vec::new()
            },
            Some(Err(_)) => {
                p.coarse = Vec::new()
            },
            None => {},
        }
    }
}

/// Where the `i`th of `n` things stands on a square grid across the stage's 15 m (SCENE 8): as
/// many rows as columns, so every one is on the stage, however many there are.
fn on_the_stage(i: u32, n: u32) -> vec3 {
    let side = max(u32(ceil(sqrt(f32(n)))), 1)
    let step = 15.0 / f32(side)
    vec3(-7.5 + step * (f32(i % side) + 0.5), 0.0, -7.5 + step * (f32(i / side) + 0.5))
}

/// Distributes `n` creatures across the 100 m stone citadel (`SCENE=11`): a vanguard squad in the
/// forecourt and central portal axis, and the bulk across the occluded cloister bays (`z in [-72, 2]`).
fn in_the_citadel(i: u32, n: u32) -> vec3 {
    if i < 12 {
        // Forecourt & central portal vanguard (cleanly clear of the gatehouse piers at x = ±2.2).
        let row = i / 3
        let col = i % 3
        let z = if row == 0 { 11.2 } else if row == 1 { 8.6 } else if row == 2 { 2.2 } else { -2.0 }
        return vec3(-1.35 + 1.35 * f32(col), 0.0, z)
    }
    let rem = i - 12
    let cols: u32 = 16
    let c = rem % cols
    let r = rem / cols
    let rows = max((n - 12 + cols - 1) / cols, 1)
    let x = -34.0 + (68.0 / f32(cols)) * (f32(c) + 0.5)
    let z = 1.5 - (74.0 / f32(rows)) * (f32(r) + 0.5)
    vec3(x, 0.0, z)
}

/// A frame of a whole scene (`MeshSight::draw_scene`: solids with a height, a medium and a
/// swarm). The judges hold solids only (`Judging::frame` draws no height, medium or swarm, and the
/// reference traces none), so judging one is refused, loudly, not drawn unjudged with its time
/// held at `FROM`.
fn drawn_whole<W: MeshWorld, H: Height, Med: Medium, Sw: engine::matter::swarm::Swarm, S: engine::matter::sky::Sky, L: engine::picture::look::Look>(
    p: mut Program,
    world: W,
    height: H,
    medium: Med,
    swarm: Sw,
    sky: S,
    look: L,
    eye: Eye,
    width: u32,
    height_px: u32,
) {
    if JUDGE {
        print(
            f"scene: SCENE {SCENE} can't be judged: the judges hold solids, and it has a height, a medium and a swarm",
        )
        panic(
            "scene: JUDGE asks to judge a scene with a height, a medium or a swarm, which the judges can't hold",
        )
    }
    p.mesh.draw_scene(world, height, medium, swarm, sky, look, eye, width, height_px)
    coarse_counted(mut p, eye, width, height_px)
}

/// `BOXES` small still boxes strewn on the stage (SCENE 8).
fn strewn() -> [Block; BOXES] {
    var boxes = [cuboid(vec3(0.08)).translate(vec3(0.0)).with(matte(PAINT)); BOXES]
    for i in 0..BOXES {
        let f = f32(i) + 0.5
        boxes[i] = cuboid(vec3(0.06 + 0.06 * fract(f * 0.754878)))
            .translate(
                vec3(fract(f * 0.618034) * 15.0 - 7.5, 0.12, fract(f * 0.569840) * 15.0 - 7.5),
            )
            .with(matte(PAINT))
    }
    boxes
}

/// The stage with `body` standing on it at `AT`.
fn stage_with(body: Creature) -> And<One<Stage>, One<Translate<Creature>>> {
    one(stage()).and(one(body.translate(AT)))
}

/// The kinds of thing the hole audit (SCENE 6) holds to their fields, in turn (`audited`).
const AUDIT_KINDS: u32 = 20

/// The frames of its motion a thing that moves is drawn through before the audit holds it
/// (`Auditing::move_eyes`).
const AUDIT_MOVES: u32 = 8

/// A frame of the hole audit (SCENE 6): the stage, the creature walking, the stack, the
/// arena's still pillars and braziers, a flame, the ward, a CSG-cut marble column, a crowd of
/// creatures (one `Pool`), the citadel's gate with a crowd behind it (occlusion culling), a column
/// cut while seen, a stroll past the pillars, the glass barrage, the carved table, and the
/// grimoire, in turn.
fn audited<S: engine::matter::sky::Sky, L: engine::picture::look::Look>(
    p: mut Program,
    sky: S,
    look: L,
    width: u32,
    height: u32,
) {
    if AUDIT_EYE < AUDIT_EYES {
        p.auditing.only_eye(AUDIT_EYE)
    }
    let alone = AUDIT_KIND < AUDIT_KINDS
    let k = if alone { AUDIT_KIND + p.auditing.thing() } else { p.auditing.thing() }
    if k >= AUDIT_KINDS || (alone && k > AUDIT_KIND) {
        // (Done once the eyes' marches made this run are kept: `Auditing::keep_marches`.)
        if !p.said && p.auditing.keep_marches() {
            p.said = true
            print(f"audit: kinds {if alone { 1 } else { AUDIT_KINDS }}")
            print("scene: done")
        }
        return
    }
    if k == 0 {
        let field = stage()
        p.auditing.frame(
            mut p.mesh,
            one(field),
            whole(field),
            vec4(0.0, 1.0, 0.0, 9.0),
            "the stage",
            AUDIT_EYES,
            sky,
            look,
            width,
            height,
        )
    } else if k == 1 {
        // (Walking from eye to eye, still while an eye settles.)
        let body = creature(posed(p, PACE * f32(AUDIT_EYES + 2 + p.auditing.eye())))
        p.auditing.frame(
            mut p.mesh,
            one(body),
            whole(body),
            vec4(0.0, 0.62, 0.0, 0.8),
            "the creature walking",
            AUDIT_EYES,
            sky,
            look,
            width,
            height,
        )
    } else if k == 2 {
        let field = stack(TALL_STACK)
        p.auditing.frame(
            mut p.mesh,
            one(field),
            whole(field),
            vec4(0.0, 20.0, 0.0, 28.0),
            "the stack",
            AUDIT_EYES,
            sky,
            look,
            width,
            height,
        )
    } else if k == 3 {
        let field = arena_pillars()
        p.auditing.frame(
            mut p.mesh,
            one(field),
            whole(field),
            bounded(field),
            "the arena's pillars",
            AUDIT_EYES,
            sky,
            look,
            width,
            height,
        )
    } else if k == 4 {
        let field = arena_brazier_stands()
        p.auditing.frame(
            mut p.mesh,
            one(field),
            whole(field),
            bounded(field),
            "the arena's braziers",
            AUDIT_EYES,
            sky,
            look,
            width,
            height,
        )
    } else if k == 5 {
        let field = arena_flames(0.0)[0]
        p.auditing.frame(
            mut p.mesh,
            one(field),
            whole(field),
            bounded(field),
            "a brazier's flame",
            AUDIT_EYES,
            sky,
            look,
            width,
            height,
        )
    } else if k == 6 {
        let field = parry_arc(0.0)
        p.auditing.frame(
            mut p.mesh,
            one(field),
            whole(field),
            bounded(field),
            "the ward",
            AUDIT_EYES,
            sky,
            look,
            width,
            height,
        )
    } else if k == 7 {
        var log = world_edits()
        log.append(edit_sphere_sub(vec3(0.42, 2.05, 0.48), radius: 0.44, k: 0.08))
        log.append(
            edit_capsule_sub(
                vec3(-0.78, 1.05, 0.55),
                vec3(0.85, 2.85, -0.35),
                radius: 0.16,
                k: 0.05,
            ),
        )
        let field = edited(marble_column(), log)
        p.auditing.frame(
            mut p.mesh,
            one(field),
            whole(field),
            bounded(field),
            "the CSG-cut column",
            AUDIT_EYES,
            sky,
            look,
            width,
            height,
        )
    } else if k == 8 {
        let bodies = crowd(p, AUDIT_EYES + 2 + p.auditing.eye())
        p.auditing.frame(
            mut p.mesh,
            pool_of(bodies),
            each(bodies),
            bounded(bodies.union()),
            "a crowd",
            AUDIT_EYES,
            sky,
            look,
            width,
            height,
        )
    } else if k == 10 {
        // The column cut while it is seen: each odd eye stands where the even eye before it
        // stood, and only its column is cut, so the cut is met by the mesh the even eye left
        // (patched in place, `MeshBatch::try_patch_dirty`), not by one begun afresh.
        p.auditing.pair_eyes()
        var log = world_edits()
        if p.auditing.eye() % 2 == 1 {
            log.append(edit_sphere_sub(vec3(0.42, 2.05, 0.48), radius: 0.44, k: 0.08))
            log.append(
                edit_capsule_sub(
                    vec3(-0.78, 1.05, 0.55),
                    vec3(0.85, 2.85, -0.35),
                    radius: 0.16,
                    k: 0.05,
                ),
            )
        }
        let field = edited(marble_column(), log)
        p.auditing.frame(
            mut p.mesh,
            one(field),
            whole(field),
            // Eyes from four times its bound out: a cut patches in place only where it meets
            // no seam between levels (`try_patch_dirty`), as seen from farther.
            vec4(bounded(marble_column()).xyz, 4.0 * bounded(marble_column()).w),
            "the column cut while seen",
            AUDIT_EYES,
            sky,
            look,
            width,
            height,
        )
    } else if k == 11 {
        // A walk past the arena's pillars: each eye is the one before moved 7 mm, so the mesh an
        // eye sees was made for an eye a step back (within `eye_step` of it, or re-made).
        p.auditing.stroll(vec3(0.0049, 0.0021, 0.0049))
        let field = arena_pillars()
        p.auditing.frame(
            mut p.mesh,
            one(field),
            whole(field),
            bounded(field),
            "a walk past the pillars",
            AUDIT_EYES,
            sky,
            look,
            width,
            height,
        )
    } else if k == 12 {
        // The glass barrage: fourteen faceted shards, transmissive, as one `Pool` (the audit sees
        // glass: `MeshSight::drawn_only` puts it in its picture's place).
        let shards = glass_barrage(0.5)
        p.auditing.frame(
            mut p.mesh,
            pool_of(shards),
            each(shards),
            bounded(shards.union()),
            "the glass barrage",
            AUDIT_EYES,
            sky,
            look,
            width,
            height,
        )
    } else if k == 9 {
        let bodies = crowd(p, AUDIT_EYES + 2 + p.auditing.eye())
        p.auditing.frame(
            mut p.mesh,
            one(citadel()).and(pool_of(bodies)),
            both(whole(citadel()), each(bodies)),
            bounded(citadel().union(bodies.union())),
            "the citadel's gate with a crowd behind it",
            AUDIT_EYES,
            sky,
            look,
            width,
            height,
        )
    } else if k == 13 {
        let field = table()
        p.auditing.frame(
            mut p.mesh,
            one(field),
            whole(field),
            vec4(0.0, 0.38, 0.0, 0.8),
            "the carved table",
            AUDIT_EYES,
            sky,
            look,
            width,
            height,
        )
    } else if k == 17 {
        // The bolt as it strikes, as the flame: seen eight frames on from where it was meshed.
        p.auditing.move_eyes(AUDIT_MOVES)
        let at = 0.31 * f32(p.auditing.eye() / 2) + PACE * f32(p.auditing.moment())
        let field = bolt(time: at, struck: 1.0)
        p.auditing.frame(
            mut p.mesh,
            one(field),
            whole(field),
            vec4(bounded(field).xyz, 4.0 * bounded(field).w),
            "the bolt as it strikes",
            AUDIT_EYES,
            sky,
            look,
            width,
            height,
        )
    } else if k == 19 {
        // A piece of the broken branch as it falls and tumbles, as the flame: a rigid thing, meshed
        // once and carried by its transform, its exact cells solved through it
        // (`exact_box_hit_fs`'s `rigid_inv_point`), seen eight frames on.
        p.auditing.move_eyes(AUDIT_MOVES)
        let since = 0.04 * f32(p.auditing.eye() / 2) + PACE * f32(p.auditing.moment())
        let landings = world::parry::break_landings()
        var which: u32 = 0
        for j in 0..6 {
            if landings[5 - j] >= 0.0 {
                which = 5 - j
            }
        }
        let field = world::parry::branch_pieces(since, landings)[which]
        p.auditing.frame(
            mut p.mesh,
            one(field),
            whole(field),
            vec4(bounded(field).xyz, 4.0 * bounded(field).w),
            "a piece of the branch as it falls",
            AUDIT_EYES,
            sky,
            look,
            width,
            height,
        )
    } else if k == 18 {
        // The branch of glass, a third of a second after the stroke fused it.
        let field = glass_branch(age: 0.3, whole: 1.0)
        p.auditing.frame(
            mut p.mesh,
            one(field),
            whole(field),
            bounded(field),
            "the branch of glass",
            AUDIT_EYES,
            sky,
            look,
            width,
            height,
        )
    } else if k == 15 {
        // A flame as it burns: each odd eye stands where the even eye before it stood and sees
        // the flame `AUDIT_MOVES` frames on, drawn through each of them, so its cut is met by
        // whatever the engine kept of the frames before, not by a mesh begun afresh. Each pair
        // of eyes starts at another moment of the flame.
        p.auditing.move_eyes(AUDIT_MOVES)
        let at = 0.9 * f32(p.auditing.eye() / 2) + PACE * f32(p.auditing.moment())
        let field = arena_flames(at)[0]
        p.auditing.frame(
            mut p.mesh,
            one(field),
            whole(field),
            // Eyes from four times its bound out, where one grid holds it (no seam between
            // levels): a camera's distance, and where a mesh may be carried from frame to frame.
            vec4(bounded(field).xyz, 4.0 * bounded(field).w),
            "a brazier's flame as it burns",
            AUDIT_EYES,
            sky,
            look,
            width,
            height,
        )
    } else if k == 16 {
        // The ward as it waves, as the flame.
        p.auditing.move_eyes(AUDIT_MOVES)
        let at = 0.9 * f32(p.auditing.eye() / 2) + PACE * f32(p.auditing.moment())
        let field = parry_arc(at)
        p.auditing.frame(
            mut p.mesh,
            one(field),
            whole(field),
            // Eyes from four times its bound out, where one grid holds it (no seam between
            // levels): a camera's distance, and where a mesh may be carried from frame to frame.
            vec4(bounded(field).xyz, 4.0 * bounded(field).w),
            "the ward as it waves",
            AUDIT_EYES,
            sky,
            look,
            width,
            height,
        )
    } else {
        let field = grimoire()
        p.auditing.frame(
            mut p.mesh,
            one(field),
            whole(field),
            bounded(field),
            "the grimoire",
            AUDIT_EYES,
            sky,
            look,
            width,
            height,
        )
    }
}

/// The audit's crowd: twelve creatures out of step, where the citadel's vanguard stands (in its
/// forecourt and behind its gate), at moment `k`.
fn crowd(p: Program, k: u32) -> [Translate<Creature>; 12] {
    let t = PACE * f32(k)
    var bodies = [creature(posed(p, t)).translate(AT); 12]
    for i in 0..12 {
        bodies[i] = creature(posed(p, t + 0.37 * f32(i))).translate(in_the_citadel(i, 256))
    }
    bodies
}

/// A thing's stated bound as the audit takes it: its centre and radius.
fn bounded<M: Surface>(field: M) -> vec4 {
    let b = field.bound()
    vec4(b.centre, b.radius)
}

// ---- The paced reference against `traced`'s, on the CPU, by bits ------------------------------------------
use engine::matter::matter::{Matter, matter}
use engine::matter::substance::Substance
use std::field::Field
use engine::picture::eye::view
use engine::reference::paced::{DONE, PacedAt, UNITS, paced_begun, paced_step, said_begun, same_said}
use engine::reference::traced::traced_said

/// The world, eye and light a judged scene `scene` is drawn in (as `frame` builds it at its first
/// moment): 0 the stage and one creature, 2 and 3 the creature far and near, 8 SCENE 8 at one creature.
fn judged_world_check(
    scene: u32,
    x0: u32,
    y0: u32,
    step_x: u32,
    step_y: u32,
    nx: u32,
    ny: u32,
    looks: u32,
    bounces: u32,
    light: u32,
) -> vec2u {
    let body = rest_body()
    if scene == 8 {
        let world = one(stage()).and(one(body.translate(AT))).and(one(strewn().union()))
        return paced_check(
            matter(world.field()),
            STAGE_EYE,
            x0,
            y0,
            step_x,
            step_y,
            nx,
            ny,
            looks,
            bounces,
            light,
        )
    } else if scene == 0 {
        return paced_check(
            matter(stage_with(body).field()),
            STAGE_EYE,
            x0,
            y0,
            step_x,
            step_y,
            nx,
            ny,
            looks,
            bounces,
            light,
        )
    }
    let world = one(body)
    paced_check(matter(world.field()), if scene == 2 { BODY_FAR } else {
        BODY_NEAR
    }, x0, y0, step_x, step_y, nx, ny, looks, bounces, light)
}

/// Paced against `traced` (`traced_said`), by bits, at `nx` x `ny` pixels of 960x540 from (`x0`,
/// `y0`) every (`step_x`, `step_y`): the middle ray, its thickness and `looks` looks a half; how many
/// checked and how many differ.
fn paced_check<M: Field<Substance>>(
    m: Matter<M>,
    eye: Eye,
    x0: u32,
    y0: u32,
    step_x: u32,
    step_y: u32,
    nx: u32,
    ny: u32,
    looks: u32,
    bounces: u32,
    light_kind: u32,
) -> vec2u {
    let sky = clear(SUN)
    let lk = photo(EXPOSURE)
    let middle = view(eye, 960, 540)
    var checked: u32 = 0
    var differ: u32 = 0
    for j in 0..ny {
        for i in 0..nx {
            let x = x0 + i * step_x
            let y = y0 + j * step_y
            let at = PacedAt {
                x,
                y,
                salt: 0,
                looks,
                rays: RAYS,
                bounces,
                light: light_kind,
                spare: 0,
            }
            let traced = traced_said(m, sky, lk, middle, at)
            var ps = paced_begun()
            var sd = said_begun()
            var steps: u32 = 0
            while ps.st.x != DONE && steps < 200000 {
                steps += 1
                ps = paced_step(m, sky, lk, middle, at, ps, mut sd)
            }
            checked += 1
            if !(ps.st.x == DONE && same_said(sd, traced)) {
                differ += 1
                if differ <= 5 {
                    print(
                        f"paced: ({x}, {y}) differs: centre {sd.centre} / {traced.centre}, behind {sd.behind} / {traced.behind}, thick {sd.thick.x} / {traced.thick.x}, met0 {sd.met0} / {traced.met0}, met1 {sd.met1} / {traced.met1}, far {sd.far} / {traced.far}; steps {steps}",
                    )
                }
            }
        }
    }
    vec2u(checked, differ)
}

@test
fn paced_is_traced_scene_0() {
    let a = judged_world_check(0, 16, 15, 32, 32, 30, 17, 2, 0, WHOLE)
    print(f"paced: SCENE 0: {a.x} px checked, {a.y} differ")
    assert(a.y == 0, "SCENE 0")
}

@test
fn paced_is_traced_scene_0_bounced_and_simple() {
    let a = judged_world_check(0, 0, 135, 64, 24, 15, 12, 2, 2, WHOLE)
    let b = judged_world_check(0, 32, 147, 64, 24, 15, 12, 2, 0, SIMPLE)
    print(
        f"paced: SCENE 0 with two bounces: {a.x} px checked, {a.y} differ; with the simple light: {b.x} px, {b.y} differ",
    )
    assert(a.y == 0 && b.y == 0, "SCENE 0 bounced and simple")
}

@test
fn paced_is_traced_far() {
    let a = judged_world_check(2, 16, 15, 32, 32, 30, 17, 2, 0, WHOLE)
    print(f"paced: far: {a.x} px checked, {a.y} differ")
    assert(a.y == 0, "far")
}

@test
fn paced_is_traced_near() {
    let a = judged_world_check(3, 16, 15, 32, 32, 30, 17, 2, 0, WHOLE)
    print(f"paced: near: {a.x} px checked, {a.y} differ")
    assert(a.y == 0, "near")
}

@test
fn paced_is_traced_scene_8_grid() {
    let a = judged_world_check(8, 16, 15, 32, 32, 30, 17, 2, 0, WHOLE)
    print(f"paced: SCENE 8 at one creature, a grid: {a.x} px checked, {a.y} differ")
    assert(a.y == 0, "SCENE 8 grid")
}

@test
fn paced_is_traced_scene_8_heavy_rows() {
    // (The rows the CPU replay found heaviest, 288-432, where rays graze the stage's top among
    // the boxes; the replay's worst pixels (96, 336) and (768, 352) among them.)
    let a = judged_world_check(8, 0, 288, 32, 16, 30, 10, 2, 0, WHOLE)
    let b = judged_world_check(8, 96, 336, 1, 1, 8, 4, 2, 0, WHOLE)
    let c = judged_world_check(8, 768, 352, 1, 1, 8, 4, 2, 0, WHOLE)
    print(
        f"paced: SCENE 8 heavy rows: {a.x} px checked, {a.y} differ; round (96, 336): {b.x}, {b.y}; round (768, 352): {c.x}, {c.y}",
    )
    assert(a.y == 0 && b.y == 0 && c.y == 0, "SCENE 8 heavy rows")
}

/// Paced against `traced` as the listed rounds drive it: `n` pixels of SCENE `scene` taken together,
/// `UNITS` steps a call, round after round over the pixels still undone, in `order` (0 row order,
/// 1 reversed, 2 rotated and reversed differently each round: always a permutation): each pixel's answers the same bits as `traced`'s.
fn paced_rounds_check(scene: u32, order: u32) -> vec2u {
    let body = rest_body()
    if scene == 8 {
        let world = one(stage()).and(one(body.translate(AT))).and(one(strewn().union()))
        return rounds_of(matter(world.field()), STAGE_EYE, order)
    }
    rounds_of(matter(stage_with(body).field()), STAGE_EYE, order)
}

fn rounds_of<M: Field<Substance>>(m: Matter<M>, eye: Eye, order: u32) -> vec2u {
    let sky = clear(SUN)
    let lk = photo(EXPOSURE)
    let middle = view(eye, 960, 540)
    let looks: u32 = 2
    // 48 pixels: a row through the heavy band and a column down the screen.
    var xs = [u32(0); 48]
    var ys = [u32(0); 48]
    for i in 0..24 {
        xs[i] = 40 * i
        ys[i] = 336
        xs[24 + i] = 480
        ys[24 + i] = 22 * i
    }
    var ps = [paced_begun(); 48]
    var sds = [said_begun(); 48]
    var undone = [u32(0); 48]
    var n: u32 = 48
    for i in 0..48 {
        undone[i] = i
    }
    var round: u32 = 0
    while n > 0 && round < 100000 {
        round += 1
        var next = [u32(0); 48]
        var m2: u32 = 0
        for j in 0..48 {
            if j < n {
                // The list's order this round.
                let rot = (j + round * 13) % n
                let jj = if order == 0 { j } else if order == 1 { n - 1 - j } else if round % 2 ==
                    0 { rot } else { n - 1 - rot }
                let i = undone[jj]
                let at = PacedAt {
                    x: xs[i],
                    y: ys[i],
                    salt: 0,
                    looks,
                    rays: RAYS,
                    bounces: 0,
                    light: WHOLE,
                    spare: 0,
                }
                var s = ps[i]
                var sd = sds[i]
                var u: u32 = 0
                while u < UNITS && s.st.x != DONE {
                    u += 1
                    s = paced_step(m, sky, lk, middle, at, s, mut sd)
                }
                ps[i] = s
                sds[i] = sd
                if s.st.x != DONE {
                    next[m2] = i
                    m2 += 1
                }
            }
        }
        undone = next
        n = m2
    }
    var differ: u32 = 0
    for i in 0..48 {
        let one = paced_check(m, eye, xs[i], ys[i], 1, 1, 1, 1, looks, 0, WHOLE)
        // (paced_check runs the machine straight through; the rounds' answers must be its bits.)
        let at = PacedAt {
            x: xs[i],
            y: ys[i],
            salt: 0,
            looks,
            rays: RAYS,
            bounces: 0,
            light: WHOLE,
            spare: 0,
        }
        var s = paced_begun()
        var sd = said_begun()
        while s.st.x != DONE {
            s = paced_step(m, sky, lk, middle, at, s, mut sd)
        }
        if one.y != 0 || !same_said(sd, sds[i]) {
            differ += 1
        }
    }
    vec2u(48, differ)
}

@test
fn paced_rounds_are_traced_in_any_order() {
    var all: u32 = 0
    for order in 0..3 {
        let a = paced_rounds_check(0, order)
        let b = paced_rounds_check(8, order)
        print(
            f"paced: rounds in order {order}: SCENE 0 {a.x} px, {a.y} differ; SCENE 8 {b.x} px, {b.y} differ",
        )
        all += a.y + b.y
    }
    assert(all == 0, "the rounds' answers are traced's in every order")
}

/// What distance-only rings (`engine::mesh::rings`) keep of the arena's and the study's still
/// things at 1080p from their scenes' eyes (docs/plans/build-time-engine-4d.md, phase 0 step 6):
/// each level's cell, its region's bricks, and those the cull keeps.
@test
fn ring_census_report() {
    let arena_px = view(ARENA_EYE, 1920, 1080).pixel()
    ring_line("arena_courtyard", world::arena::arena_courtyard(), ARENA_EYE.at, arena_px)
    ring_line("arena_pillars", world::arena::arena_pillars(), ARENA_EYE.at, arena_px)
    ring_line("arena_brazier_stands", world::arena::arena_brazier_stands(), ARENA_EYE.at, arena_px)
}

/// How flat the arena's and the study's still things are, brick by brick, at the cells the
/// coarsest levels mesh them at (`engine::mesh::census::flat_census`).
@test
fn flat_census_report() {
    for k in 0..4 {
        let h = 0.125 * exp2(-f32(k))
        flat_line("arena_courtyard", world::arena::arena_courtyard(), h)
        flat_line("arena_pillars", world::arena::arena_pillars(), h)
        flat_line("table", table(), h)
    }
}

fn flat_line<M: Field<Substance>>(name: str, f: M, h: f32) {
    let c = engine::mesh::census::flat_census(f, h)
    print(f"flat: {name} at {h * 1000.0} mm: {c.w} bricks, {c.z} with no slab; slab most {c.x * 1000.0} mm, 95th percentile {c.y * 1000.0} mm")
}

fn ring_line<M: Field<Substance>>(name: str, f: M, eye: vec3, px: f32) {
    let steep = engine::mesh::extract::steep(f)
    let cpx = engine::mesh::extract::CELL_PX * (if steep { 0.55 } else { 0.90 })
    let r = min(f.bound().radius, 1.0e4)
    let levels = engine::mesh::census::ring_census(f, eye, px, cpx, engine::mesh::extract::size_floor(r))
    var kept = 0.0
    var line = String::new()
    for i in 0..levels.len() {
        kept += levels[i].z
        line.push_str(f" {levels[i].x * 1000.0} mm: {levels[i].z} of {levels[i].y};")
    }
    print(f"rings: {name}: {kept} bricks kept;{line}")
}
