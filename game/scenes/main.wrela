// The scenes, each drawn by the engine (`engine::mesh::draw::MeshSight`) and, where `JUDGE` asks,
// held to the brute-force reference (`engine::reference`) by the judges (`engine::judge`).
// Nothing here draws: a scene says what is before the eye, and asks.
//
//     SCENE 0  the stage (`world::stage`) with the creature (`world::creature`) walking on it
//              (`rules::gaits::walk`), under the clear sky, in the photographic look
//     SCENE 1  the stone stack (`world::stack`) alone, from 100 m with a long lens
//     SCENE 2  the creature alone, 6 m off; SCENE 3, 1.5 m off
//     SCENE 4  the stage alone, from the stage's eye
//     SCENE 5  no picture: how tight the derived ranges are (`engine::matter::ranges`)
//     SCENE 6  the hole audit (`engine::judge::audit`): the stage, the creature walking, the
//              stack, the arena's pillars, braziers, a flame and the ward, and the forge's
//              carved table and grimoire, each alone, from
//              `AUDIT_EYES` eyes round it, held to the thing's own field
//     SCENE 8  crowd stress test: stage + `BOXES` boxes + `CREATURES` walking creatures
//     SCENE 9  unified cohesion showcase: stage + walking creature + morphing glowing spell orb +
//              ocean swells (`Height`) + sea mist (`Medium`) in one depth buffer, one light, one look
//     SCENE 10 signature parry-spellcraft arena: wet basalt coastal temple + broken fluted pillars
//              with glowing runes + flickering braziers + refractive glass shard barrage + golden
//              parry arc + 16,384-grain GPU glass->sparks->sand transmutation swarm + ocean + mist
//     SCENE 11 100 m occluded stone citadel + 256 walking creatures (2-pass Hi-Z occlusion stress)
//     SCENE 12 live CSG marble column destruction (`Edited<M>` dirty-region `< 0.15 ms` rebuild)
//     SCENE 13 the forge's showcase: the carved oak table (`world::table`) with the grimoire
//              (`world::grimoire`) lying on it, on the stage before its wall; `VIEW` 0 the room's
//              eye, 1 the carving's, 60 cm from the frieze's corner at its height, 2 the book's,
//              60 cm above its brass corner
//     SCENE 14 the forge's gold set together: SCENE 13's table and grimoire, a brass candlestick
//              (`world::candlestick`) on the table, the side chair (`world::chair`) pulled up to it,
//              the wall shelf (`world::shelf`) on the stage's wall
//
//     wrela build game/scenes -o <out> [--set SCENE=10] [--set JUDGE=true] [--set LOOKS=32]

use engine::judge::audit::{Auditing, auditing, both, each, whole}
use engine::judge::judging::{Judging, judging}
use engine::judge::sunlight::{SunJudge, sun_judge}
use engine::picture::screen::show
use engine::matter::edits::{WorldEdits, edit_capsule_sub, edit_sphere_sub, edited, world_edits}
use engine::mesh::draw::{MeshSight, MeshWorld, mesh_sight}
use engine::picture::eye::Eye
use engine::matter::height::{Height, HeightSample}
use engine::matter::medium::{Medium, MediumSample}
use engine::matter::swarm::NoSwarm
use engine::matter::ranges::{heard, probe}
use engine::matter::world::{And, One, one, pool, pool_of}
use engine::reference::reference::reference
use engine::reference::traced::{SIMPLE, WHOLE}
use kit::motion::humanoid::{Rig, palette}
use kit::motion::playback::Move
use kit::sky::atmosphere::atmosphere
use kit::substances::matte::matte
use kit::substances::pbr::{emissive, glass, glazed, metal}
use look::look::{cinema, photo}
use rules::gaits::walk
use rules::rig::rig
use std::io::print
use std::transform::translate
use world::arena::{
    arena_brazier_stands, arena_courtyard, arena_flames, arena_mist, arena_pillars, arena_sea,
    glass_barrage, parry_arc, parry_sand_cloud, rival_orb,
}
use world::citadel::{citadel, marble_column}
use world::creature::{Creature, creature}
use world::skeleton::on_rig
use world::sea::swells
use world::sky::clear
use world::candlestick::candlestick
use world::chair::chair
use world::grimoire::grimoire
use world::shelf::shelf
use world::stack::{TALL_STACK, stack}
use world::table::table
use world::stage::{Block, PAINT, Stage, stage}
use std::field::{Surface, Translate, cuboid, sphere}

/// Which scene (see the head of the file).
pub const SCENE: u32 = 0

/// Whether the engine's picture is held to the reference.
pub const JUDGE: bool = false

/// Whether the engine's sun visibility is held to the reference's shadow rays
/// (`engine::judge::sunlight`): the scene is drawn `SUN_SETTLE` frames, then judged row by row.
pub const SUNJUDGE: bool = false
pub const SUN_SETTLE: u32 = 16
/// Whether the sun's judge holds the picture to the field filtered to each pixel's footprint and
/// the sun's cone (detail no pixel can hold averaged away), or to the field itself.
pub const SUN_FILTERED: bool = false

/// Looks a half of the reference takes (an even number), the rays over the hemisphere a look.
pub const LOOKS: u32 = 32
pub const RAYS: u32 = 2

/// The reference's light: the sky as if nothing were in its way (false: its `SIMPLE`), or each sky
/// ray followed until it escapes or stops, nothing bouncing (true: `WHOLE` with no bounce).
pub const SKY_HIDDEN: bool = false

/// The moments judged, how far apart in the walk (s), and the first (s in). Not judging, the
/// walk moves `PACE` s a frame.
pub const MOMENTS: u32 = 1
pub const PACE: f32 = 0.016667
pub const FROM: f32 = 0.0

/// The stack (SCENE 1): how far from its surface the eye stands (m; 0: 100 m from its axis),
/// whether it walks toward it, and whether it turns to put the stack's outline mid-view.
pub const STACK_AT: f32 = 0.0
pub const EDGE: bool = false
pub const WALK: bool = false
pub const WALK_FRAMES: u32 = 90
const WALK_SPEED: f32 = 1.4
const TURN_RATE: f32 = 0.5236
const TURN_SWING: f32 = 0.15

/// The forge's showcase (SCENE 13): which eye, 0 the room's, 1 the carving's, 2 the book's
/// (`ROOM_EYE`, `CARVING_EYE`, `BOOK_EYE`).
pub const VIEW: u32 = 0

/// The hole audit (SCENE 6): eyes round each kind of thing.
pub const AUDIT_EYES: u32 = 24

/// The one kind the hole audit holds (its place in `audited`'s list), or every kind
/// (`AUDIT_KINDS` or more): `tools/audit --kind N`.
pub const AUDIT_KIND: u32 = 1000

/// The one eye of each kind the hole audit holds, or every eye (`AUDIT_EYES` or more):
/// `tools/audit --eye N`.
pub const AUDIT_EYE: u32 = 1000

/// What is shown when judging: 0 the engine's picture; 1 the reference; 2 where the judges read
/// the engine's coverage as off (`engine::judge::judging::SHOW_PICTURE`...).
pub const SHOW: u32 = 0

/// Whether the judges are checked at the first moment by faults planted in the reference's second
/// half (`Judging::faults`), the hole about `FAULT_AT` (a point on the stage's wall, sunlit: for the
/// scenes with the stage, 0, 4 and 8).
pub const FAULTS: bool = false
const FAULT_AT = vec3(-1.5, 1.5, 0.1)

/// Where the creature walks (its feet's spot), and toward the sun.
const AT = vec3(2.0, 0.0, 3.5)

/// The probe of many things (SCENE 8): how many creatures walk on the stage, out of step, and how
/// many small still boxes lie on it.
pub const CREATURES: u32 = 1
pub const BOXES: u32 = 256
const SUN = vec3(0.3, 0.6, 0.74)
const EXPOSURE: f32 = 1.2

/// The eye on the stage; on the stack (the spike's); on the creature 6 m and 1.5 m off (the
/// spike's).
const STAGE_EYE = Eye { at: vec3(9.0, 6.0, 11.0), toward: vec3(0.0, 1.0, 0.0), wide: 0.6 }
const ARENA_EYE = Eye { at: vec3(-1.35, 2.55, 8.8), toward: vec3(0.25, 1.45, -0.35), wide: 0.58 }
const CITADEL_EYE = Eye { at: vec3(0.0, 2.35, 16.5), toward: vec3(0.0, 2.25, -20.0), wide: 0.72 }
const CSG_EYE = Eye { at: vec3(0.35, 2.35, 6.4), toward: vec3(0.0, 2.05, 0.0), wide: 0.58 }
const STACK_EYE = Eye { at: vec3(0.0, 24.0, -100.0), toward: vec3(0.0, 21.0, 0.0), wide: 0.2 }
const BODY_FAR = Eye { at: vec3(2.7, 1.32, 5.28), toward: vec3(0.0, 0.6, 0.0), wide: 0.6 }
const BODY_NEAR = Eye { at: vec3(0.675, 0.78, 1.32), toward: vec3(0.0, 0.6, 0.0), wide: 0.6 }

/// Where the showcase's table stands (its feet's middle), and the grimoire on it: turned 20°,
/// lying on the top's face, toward the front right.
const TABLE_AT = vec3(0.0, 0.0, 1.4)
const BOOK_AT = vec3(0.16, 0.76 + 0.5 * world::grimoire::THICK + 0.0002, 0.06)
const BOOK_TURN: f32 = 0.35

/// The showcase's eyes: the room's, 2.9 m off, the whole table in view; the carving's, 60 cm from
/// the frieze's front corner, a little below the top, the frieze, a leg's vase and the rosette in
/// view; the book's, 60 cm above and before its nearer brass corner.
const ROOM_EYE = Eye { at: vec3(1.9, 1.5, 3.6), toward: vec3(0.0, 0.55, 1.4), wide: 0.6 }
const CARVING_EYE = Eye { at: vec3(0.62, 0.6, 2.18), toward: vec3(0.12, 0.52, 1.69), wide: 0.6 }
/// The stage's wall's face toward the table (z = its half thickness), and the gold set's eye.
const WALL_FACE: f32 = 0.1
const GOLD_EYE = Eye { at: vec3(2.3, 1.55, 4.1), toward: vec3(0.0, 0.8, 1.2), wide: 0.62 }
const BOOK_EYE = Eye { at: vec3(0.42, 1.28, 1.92), toward: vec3(0.2, 0.8, 1.48), wide: 0.6 }

/// Animated ocean swells surrounding the stage (`SCENE=9` cohesion showcase: pure `Height` field).
struct SeaWaves: Copy + GpuData {
    time: f32,
}

impl Height for SeaWaves {
    fn has_opaque(self) -> bool {
        false
    }

    fn height_at(self, xz: vec2) -> HeightSample {
        let a = vec4(0.38, 0.24, 1.4, 0.14)
        let b = vec4(0.22, 0.51, 1.1, 0.09)
        let c = vec4(0.75, 0.62, 2.0, 0.04)
        swells(xz, self.time, a, b, c, level: -0.35, tint: vec3(0.10, 0.36, 0.44), roughness: 0.06)
    }
}

/// Low-lying drifting sea mist (`SCENE=9` cohesion showcase: pure `Medium` field).
struct SeaMist: Copy + GpuData {
    time: f32,
}

impl Medium for SeaMist {
    fn sample_at(self, p: vec3) -> MediumSample {
        let h = max(p.y + 0.2, 0.0)
        let wisp = 0.65 +
            0.35 * sin(p.x * 0.35 + self.time * 0.4) * cos(p.z * 0.3 - self.time * 0.3)
        let density = 0.032 * exp(-h * 0.42) * wisp
        MediumSample {
            density,
            albedo: vec3(0.86, 0.90, 0.95),
            emits: vec3(0.0),
            g: 0.55,
        }
    }
}

pub struct Program {
    mesh: MeshSight,
    judging: Judging<SHOW>,
    walk: Move,
    rig: Rig,
    frames: u32,
    said: bool,
    /// The turn that puts the stack's outline mid-view (`EDGE`; -1 until found).
    edge: f32,
    heard: Vec<engine::matter::ranges::Heard>,
    auditing: Auditing,
    edits: WorldEdits,
    sun: SunJudge,
}

pub fn init() -> Program {
    Program {
        mesh: mesh_sight(gi: !JUDGE || SKY_HIDDEN),
        judging: judging::<SHOW>(
            reference(looks: LOOKS, rays: RAYS, bounces: 0, light: if SKY_HIDDEN { WHOLE } else {
                SIMPLE
            }),
            moments: if WALK { 2 } else { MOMENTS },
            again: !WALK,
        ),
        walk: walk(),
        rig: rig(),
        frames: 0,
        said: false,
        edge: -1.0,
        heard: Vec::new(),
        auditing: auditing(),
        edits: world_edits(),
        sun: sun_judge(),
    }
}

/// The eye on the stack, `k` frames into its walk: on the spike's line of sight, `STACK_AT` m from
/// the surface (or the walk's start, 30 m), walked toward it and turned to and fro; or, still and
/// `EDGE`, turned (about the upright) until the stack's outline is in the middle of the view.
fn stack_eye(p: mut Program, field: world::stack::Stack, k: u32) -> Eye {
    if STACK_AT <= 0.0 && !WALK {
        return STACK_EYE
    }
    let d = normalize(STACK_EYE.toward - STACK_EYE.at)
    // Where the line of sight meets the stack's surface.
    let (t, _) = march(field, STACK_EYE.at, d, 1.0e30)
    let away = if WALK { 30.0 - WALK_SPEED * f32(k) / 60.0 } else { STACK_AT }
    let at = STACK_EYE.at + d * (t - away)
    if EDGE && !WALK && p.edge < 0.0 {
        // (The outline: the turn at which the line of sight just misses, halved to.)
        var a = 0.0
        var b = 1.4
        var j: u32 = 0
        while j < 24 {
            let m = 0.5 * (a + b)
            let (_, met) = march(field, at, turned(d, m), 200.0)
            if met { a = m } else { b = m }
            j += 1
        }
        p.edge = a
    }
    let swing = if WALK { TURN_SWING * sin(TURN_RATE / TURN_SWING * f32(k) / 60.0) } else if EDGE {
        p.edge
    } else { 0.0 }
    let way = turned(d, swing)
    Eye { at, toward: at + way, wide: STACK_EYE.wide }
}

/// `d` turned by `a` rad about the upright.
fn turned(d: vec3, a: f32) -> vec3 {
    vec3(d.x * cos(a) - d.z * sin(a), d.y, d.x * sin(a) + d.z * cos(a))
}

/// How far along the ray from `o` along `d` the march stopped, and whether it met the stack's
/// surface (within 0.001 m) before `far` m or 4000 steps: a march on the CPU, by its value over
/// its stated steepness.
fn march(field: world::stack::Stack, o: vec3, d: vec3, far: f32) -> (f32, bool) {
    var t = 0.0
    var i: u32 = 0
    while i < 4000 && t < far {
        let f = field.distance(o + d * t)
        if f <= 0.001 {
            return (t, true)
        }
        t += max(f / 3.5, 0.0005)
        i += 1
    }
    (t, false)
}

/// The creature as the walk poses it `t` s in.
fn posed(p: Program, t: f32) -> [mat4; 64] {
    on_rig(palette(p.rig, p.walk.pose(t), translate(vec3(0.0))))
}

/// The creature as the walk poses it at `FROM` (a judged scene's first moment), on the CPU.
fn rest_body() -> Creature {
    creature(on_rig(palette(rig(), walk().pose(FROM), translate(vec3(0.0)))))
}

pub fn frame(p: mut Program, time: f32, width: u32, height: u32) {
    let t = if JUDGE { FROM + PACE * f32(p.judging.moment()) } else { FROM + PACE * f32(p.frames) }
    p.frames += 1
    let sky = clear(SUN)
    let look = photo(EXPOSURE)
    if SCENE == 1 {
        let field = stack(TALL_STACK)
        let world = one(field)
        // (Judging, the walk's first frame and then its last, each a moment.)
        let k = if JUDGE && p.judging.moment() == 0 { 0 } else if JUDGE { WALK_FRAMES - 1 } else {
            min(p.frames, WALK_FRAMES - 1)
        }
        let eye = stack_eye(mut p, field, if WALK { k } else { 0 })
        framed(mut p, world, sky, look, eye, width, height, t)
        return
    }
    if SCENE == 6 {
        audited(mut p, sky, look, width, height)
        return
    }
    if SCENE == 5 {
        if p.frames == 1 {
            var all = probe(stack(TALL_STACK), "the stack", n: 64, samples: 512)
            p.heard.push(heard(take all))
            all = probe(creature(posed(p, 0.0)), "the creature", n: 64, samples: 512)
            p.heard.push(heard(take all))
            all = probe(stage(), "the stage", n: 64, samples: 512)
            p.heard.push(heard(take all))
        }
        var done = true
        var i: u32 = 0
        while i < p.heard.len() {
            done = p.heard[i].done("") && done
            i += 1
        }
        if done && !p.said {
            p.said = true
            print("scene: done")
        }
        return
    }
    if SCENE == 4 {
        let world = one(stage())
        framed(mut p, world, sky, look, STAGE_EYE, width, height, t)
        return
    }
    if SCENE == 9 {
        // Unified PBR + refraction + dynamic emitter cohesion showcase:
        // still stage + walking creature + morphing glowing spell orb (auto-extracted dynamic light)
        // + refractive arcane crystal monolith (`glass`) + polished gold totem (`metal`) +
        // refractive ocean swells (`Height` + `water`) + sea mist (`Medium`) + physical Rayleigh/Mie
        // golden-hour `Atmosphere` sky + AgX `cinema` look with optical HDR bloom.
        let body = creature(posed(p, t)).translate(AT)
        let pulse = 0.40 + 0.06 * sin(t * 4.0)
        let orb = sphere(pulse)
            .smooth_union(cuboid(vec3(0.28)), 0.14)
            .translate(vec3(-0.7, 1.30 + 0.16 * sin(t * 2.2), 2.3))
            .with(emissive(vec3(1.0, 0.85, 0.60), vec3(24.0, 9.5, 2.2), roughness: 0.2))
        let crystal = cuboid(vec3(0.45, 1.15, 0.22))
            .smooth_union(sphere(0.32).translate(vec3(0.0, 0.75, 0.0)), 0.12)
            .translate(vec3(1.35, 1.15, 1.9))
            .with(glass(vec3(0.72, 0.92, 1.0), roughness: 0.04, ior: 1.52))
        let gold = sphere(0.42)
            .translate(vec3(-2.1, 0.55, 1.6))
            .with(metal(vec3(0.96, 0.76, 0.34), roughness: 0.18))
        let wet_slab = cuboid(vec3(2.8, 0.08, 2.4))
            .translate(vec3(-0.2, 0.04, 1.8))
            .with(glazed(vec3(0.14, 0.15, 0.17), roughness: 0.28, coat: 0.85))
        let world = one(stage())
            .and(one(wet_slab))
            .and(one(body))
            .and(one(orb))
            .and(one(crystal))
            .and(one(gold))
        let golden_sky = atmosphere(vec3(-0.65, 0.24, 0.72), turbidity: 2.4, intensity: 1.1)
        let cin_look = cinema(EXPOSURE * 1.15, bloom_strength: 0.09, bloom_threshold: 1.2)
        drawn_whole(
            mut p,
            world,
            SeaWaves { time: t },
            SeaMist { time: t },
            NoSwarm {},
            golden_sky,
            cin_look,
            STAGE_EYE,
            width,
            height,
        )
        return
    }
    if SCENE == 10 {
        // Signature parry-spellcraft arena showcase (100% pure fields, zero GPU code in game/):
        // wet basalt coastal courtyard + fluted ruined pillars with glowing runes + bronze braziers
        // + flickering HDR fire cores + opposing casters + refractive glass shard barrage + golden
        // parry arc + 16,384-grain GPU glass->sparks->sand swarm colliding with exact World SDF +
        // refractive ocean swells + sunlit volumetric sea mist + Rayleigh/Mie sky + AgX bloom.
        let hero = creature(posed(p, t))
            .rotate(Quat::axis_angle(vec3(0.0, 1.0, 0.0), 1.5707963))
            .translate(vec3(-2.75, 0.0, 0.20))
        let rival = creature(posed(p, t + 0.55))
            .rotate(Quat::axis_angle(vec3(0.0, 1.0, 0.0), -1.5707963))
            .translate(vec3(3.75, 0.0, 0.05))
        let world = one(arena_courtyard())
            .and(one(arena_pillars()))
            .and(one(arena_brazier_stands()))
            .and(pool_of(arena_flames(t)))
            .and(one(parry_arc(t)))
            .and(one(rival_orb(t)))
            .and(pool_of(glass_barrage(t)))
            .and(one(hero))
            .and(one(rival))
        let arena_sky = atmosphere(
            vec3(0.62, 0.14, -0.77),
            turbidity: 2.8,
            ground: vec3(0.04, 0.06, 0.09),
            intensity: 0.85,
        )
        let arena_look = cinema(EXPOSURE * 0.88, bloom_strength: 0.065, bloom_threshold: 1.65)
        drawn_whole(
            mut p,
            world,
            arena_sea(t),
            arena_mist(t),
            parry_sand_cloud(t),
            arena_sky,
            arena_look,
            ARENA_EYE,
            width,
            height,
        )
        return
    }
    if SCENE == 11 {
        // 100 m occluded stone citadel + 256 walking creatures: stresses 2-pass Reversed-Z Hi-Z
        // occlusion culling (`> 60%` occluded bricks culled, `< 10 ms` on Apple M4).
        let n_creatures = if CREATURES > 1 { CREATURES } else { 256 }
        var bodies: Vec<Translate<Creature>> = Vec::new()
        for i in 0..n_creatures {
            let at = in_the_citadel(i, n_creatures)
            bodies.push(creature(posed(p, t + 0.29 * f32(i))).translate(at))
        }
        let world = one(citadel()).and(pool(take bodies))
        let cit_sky = atmosphere(vec3(-0.42, 0.36, 0.83), turbidity: 2.2, intensity: 1.05)
        let cit_look = cinema(EXPOSURE * 1.05, bloom_strength: 0.05, bloom_threshold: 1.5)
        p.mesh.draw(world, cit_sky, cit_look, CITADEL_EYE, width, height)
        if p.frames == 30 {
            let cs = p.mesh.cull.stats()
            print(
                f"cull: total={cs.total} frustum={cs.frustum_culled} hiz={cs.hiz_culled} p1={cs.pass1_drawn} p2={cs.pass2_drawn} culled_pct={cs.culled_fraction() * 100.0} hiz_in_frustum_pct={cs.hiz_fraction() * 100.0}",
            )
        }
        return
    }
    if SCENE == 12 {
        // Live CSG destruction showcase (`Edited<MarbleColumn>`):
        //   - Left: intact veined marble column
        //   - Center: live-edited column receiving a sphere blast on frame 6 and a diagonal spell
        //     slash on frame 10 (`< 0.15 ms` dirty-region in-place brick patch exposing real 3D
        //     interior marble veining and casting accurate cut shadows)
        //   - Right: pre-carved column with a seared glowing spell-blast interior material
        if p.frames == 6 {
            p.edits.append(edit_sphere_sub(vec3(0.32, 2.35, 0.44), radius: 0.54, k: 0.04))
        }
        if p.frames == 10 {
            p.edits.append(
                edit_capsule_sub(
                    vec3(-0.78, 1.35, 0.56),
                    vec3(0.82, 2.95, 0.22),
                    radius: 0.18,
                    k: 0.02,
                ),
            )
        }
        var right_edits = world_edits()
        right_edits.append(
            edit_sphere_sub(
                vec3(2.05, 2.20, 0.42),
                radius: 0.52,
                k: 0.05,
                interior: Some(
                    emissive(vec3(1.0, 0.55, 0.20), vec3(7.5, 2.2, 0.35), roughness: 0.5),
                ),
            ),
        )
        let floor = cuboid(vec3(6.0, 0.25, 4.5))
            .translate(vec3(0.0, -0.25, 0.0))
            .with(glazed(vec3(0.14, 0.15, 0.17), roughness: 0.34, coat: 0.55))
        let world = one(floor)
            .and(one(marble_column(centre_x: -2.35, centre_z: 0.0)))
            .and(one(edited(marble_column(centre_x: 0.0, centre_z: 0.0), p.edits)))
            .and(one(edited(marble_column(centre_x: 2.35, centre_z: 0.0), right_edits)))
        let csg_sky = atmosphere(vec3(0.55, 0.42, 0.72), turbidity: 2.0, intensity: 1.05)
        let csg_look = cinema(EXPOSURE * 1.05, bloom_strength: 0.06, bloom_threshold: 1.4)
        p.mesh.draw(world, csg_sky, csg_look, CSG_EYE, width, height)
        return
    }
    if SCENE == 13 {
        let desk = table().translate(TABLE_AT)
        let book = grimoire()
            .rotate(Quat::axis_angle(vec3(0.0, 1.0, 0.0), BOOK_TURN))
            .translate(TABLE_AT + BOOK_AT)
        let study_floor = cuboid(vec3(10.0, 0.25, 10.0))
            .translate(vec3(0.0, -0.25, 0.0))
            .with(glazed(vec3(0.24, 0.22, 0.20), roughness: 0.80, coat: 0.0, micro: 0.03))
        let study_wall = cuboid(vec3(9.0, 2.4, WALL_FACE))
            .translate(vec3(0.0, 2.4, 0.0))
            .with(glazed(vec3(0.38, 0.34, 0.28), roughness: 0.90, coat: 0.0, micro: 0.04))
        let skirting = cuboid(vec3(9.0, 0.075, 0.014))
            .translate(vec3(0.0, 0.075, WALL_FACE + 0.014))
            .with(glazed(vec3(0.14, 0.10, 0.068), roughness: 0.65, coat: 0.0, micro: 0.02))
        let room = study_floor.union(study_wall).union(skirting)
        let study_sky = clear(vec3(0.54, 0.52, 0.66))
        let study_look = photo(EXPOSURE * 1.05)
        let world = one(room).and(one(desk)).and(one(book))
        framed(mut p, world, study_sky, study_look, if VIEW == 1 { CARVING_EYE } else if VIEW == 2 {
            BOOK_EYE
        } else { ROOM_EYE }, width, height, t)
        return
    }
    if SCENE == 14 {
        let desk = table().translate(TABLE_AT)
        let book = grimoire()
            .rotate(Quat::axis_angle(vec3(0.0, 1.0, 0.0), BOOK_TURN))
            .translate(TABLE_AT + BOOK_AT)
        let light = candlestick().translate(TABLE_AT + vec3(-0.32, 0.76, -0.16))
        let seat = chair()
            .rotate(Quat::axis_angle(vec3(0.0, 1.0, 0.0), 3.1415927))
            .translate(TABLE_AT + vec3(-0.3, 0.0, 0.62))
        let ledge = shelf().translate(vec3(0.4, 1.45, WALL_FACE))
        let study_floor = cuboid(vec3(10.0, 0.25, 10.0))
            .translate(vec3(0.0, -0.25, 0.0))
            .with(glazed(vec3(0.24, 0.22, 0.20), roughness: 0.80, coat: 0.0, micro: 0.03))
        let study_wall = cuboid(vec3(9.0, 2.4, WALL_FACE))
            .translate(vec3(0.0, 2.4, 0.0))
            .with(glazed(vec3(0.38, 0.34, 0.28), roughness: 0.90, coat: 0.0, micro: 0.04))
        let skirting = cuboid(vec3(9.0, 0.075, 0.014))
            .translate(vec3(0.0, 0.075, WALL_FACE + 0.014))
            .with(glazed(vec3(0.14, 0.10, 0.068), roughness: 0.65, coat: 0.0, micro: 0.02))
        let room = study_floor.union(study_wall).union(skirting)
        let study_sky = clear(vec3(0.54, 0.52, 0.66))
        let study_look = photo(EXPOSURE * 1.05)
        let world = one(room)
            .and(one(desk))
            .and(one(book))
            .and(one(light))
            .and(one(seat))
            .and(one(ledge))
        framed(mut p, world, study_sky, study_look, GOLD_EYE, width, height, t)
        return
    }
    if SCENE == 8 {
        // Crowd probe: the stage, `CREATURES` creatures walking out of step on a grid across it,
        // `BOXES` small boxes strewn on it, at the game's camera — backed by dynamic `Pool<M>`.
        var bodies: Vec<Translate<Creature>> = Vec::new()
        for i in 0..CREATURES {
            let at = if CREATURES == 1 { AT } else { on_the_stage(i, CREATURES) }
            bodies.push(creature(posed(p, t + 0.37 * f32(i))).translate(at))
        }
        let world = one(stage()).and(pool(take bodies)).and(pool_of(strewn()))
        p.mesh.draw(world, sky, look, STAGE_EYE, width, height)
        return
    }
    let body = creature(posed(p, t))
    if SCENE >= 2 {
        let eye = if SCENE == 2 { BODY_FAR } else { BODY_NEAR }
        let world = one(body)
        framed(mut p, world, sky, look, eye, width, height, t)
        return
    }
    framed(mut p, stage_with(body), sky, look, STAGE_EYE, width, height, t)
}

/// A frame of `world` through `eye`: judged where `JUDGE` asks, else drawn.
fn framed<W: engine::matter::world::World + MeshWorld, S: engine::matter::sky::Sky, L: engine::picture::look::Look>(
    p: mut Program,
    world: W,
    sky: S,
    look: L,
    eye: Eye,
    width: u32,
    height: u32,
    t: f32,
) {
    if SUNJUDGE {
        if p.frames <= SUN_SETTLE {
            p.mesh.drawn_only(world, sky, look, eye, width, height)
        } else if !p.sun.done() {
            p.sun.work(p.mesh.drawn, p.mesh.sun_cls, world, sky, eye, f"SCENE {SCENE} VIEW {VIEW}", 160, footprint: SUN_FILTERED, untraced: p.mesh.sun_untraced())
            if p.sun.done() {
                print("scene: done")
            }
        }
        if p.sun.done() {
            show(p.sun.marks)
        } else {
            show(p.mesh.drawn.colour)
        }
    } else if JUDGE {
        p.judging.frame(mut p.mesh, world, sky, look, eye, width, height, t)
        if FAULTS {
            p.judging.faults(p.mesh, eye, FAULT_AT)
        }
    } else {
        p.mesh.draw(world, sky, look, eye, width, height)
    }
}

/// Where the `i`th of `n` things stands on a square grid across the stage's 15 m (SCENE 8): as
/// many rows as columns, so every one is on the stage, however many there are.
fn on_the_stage(i: u32, n: u32) -> vec3 {
    let side = max(u32(ceil(sqrt(f32(n)))), 1)
    let step = 15.0 / f32(side)
    vec3(-7.5 + step * (f32(i % side) + 0.5), 0.0, -7.5 + step * (f32(i / side) + 0.5))
}

/// Distributes `n` creatures across the 100 m stone citadel (`SCENE=11`): a vanguard squad in the
/// forecourt and central portal axis, and the bulk across the occluded cloister bays (`z in [-72, 2]`).
fn in_the_citadel(i: u32, n: u32) -> vec3 {
    if i < 12 {
        // Forecourt & central portal vanguard (cleanly clear of the gatehouse piers at x = ±2.2).
        let row = i / 3
        let col = i % 3
        let z = if row == 0 { 11.2 } else if row == 1 { 8.6 } else if row == 2 { 2.2 } else { -2.0 }
        return vec3(-1.35 + 1.35 * f32(col), 0.0, z)
    }
    let rem = i - 12
    let cols: u32 = 16
    let c = rem % cols
    let r = rem / cols
    let rows = max((n - 12 + cols - 1) / cols, 1)
    let x = -34.0 + (68.0 / f32(cols)) * (f32(c) + 0.5)
    let z = 1.5 - (74.0 / f32(rows)) * (f32(r) + 0.5)
    vec3(x, 0.0, z)
}

/// A frame of a whole scene (`MeshSight::draw_scene`: solids with a height, a medium and a
/// swarm). The judges hold solids only (`Judging::frame` draws no height, medium or swarm, and the
/// reference traces none), so judging one is refused, loudly, not drawn unjudged with its time
/// held at `FROM`.
fn drawn_whole<W: MeshWorld, H: Height, Med: Medium, Sw: engine::matter::swarm::Swarm, S: engine::matter::sky::Sky, L: engine::picture::look::Look>(
    p: mut Program,
    world: W,
    height: H,
    medium: Med,
    swarm: Sw,
    sky: S,
    look: L,
    eye: Eye,
    width: u32,
    height_px: u32,
) {
    if JUDGE {
        print(
            f"scene: SCENE {SCENE} can't be judged: the judges hold solids, and it has a height, a medium and a swarm",
        )
        panic(
            "scene: JUDGE asks to judge a scene with a height, a medium or a swarm, which the judges can't hold",
        )
    }
    p.mesh.draw_scene(world, height, medium, swarm, sky, look, eye, width, height_px)
}

/// `BOXES` small still boxes strewn on the stage (SCENE 8).
fn strewn() -> [Block; BOXES] {
    var boxes = [cuboid(vec3(0.08)).translate(vec3(0.0)).with(matte(PAINT)); BOXES]
    for i in 0..BOXES {
        let f = f32(i) + 0.5
        boxes[i] = cuboid(vec3(0.06 + 0.06 * fract(f * 0.754878)))
            .translate(
                vec3(fract(f * 0.618034) * 15.0 - 7.5, 0.12, fract(f * 0.569840) * 15.0 - 7.5),
            )
            .with(matte(PAINT))
    }
    boxes
}

/// The stage with `body` standing on it at `AT`.
fn stage_with(body: Creature) -> And<One<Stage>, One<Translate<Creature>>> {
    one(stage()).and(one(body.translate(AT)))
}

/// The kinds of thing the hole audit (SCENE 6) holds to their fields, in turn (`audited`).
const AUDIT_KINDS: u32 = 15

/// A frame of the hole audit (SCENE 6): the stage, the creature walking, the stack, the
/// arena's still pillars and braziers, a flame, the ward, a CSG-cut marble column, a crowd of
/// creatures (one `Pool`), the citadel's gate with a crowd behind it (occlusion culling), a column
/// cut while seen, a stroll past the pillars, the glass barrage, the carved table, and the
/// grimoire, in turn.
fn audited<S: engine::matter::sky::Sky, L: engine::picture::look::Look>(
    p: mut Program,
    sky: S,
    look: L,
    width: u32,
    height: u32,
) {
    if AUDIT_EYE < AUDIT_EYES {
        p.auditing.only_eye(AUDIT_EYE)
    }
    let alone = AUDIT_KIND < AUDIT_KINDS
    let k = if alone { AUDIT_KIND + p.auditing.thing() } else { p.auditing.thing() }
    if k >= AUDIT_KINDS || (alone && k > AUDIT_KIND) {
        if !p.said {
            p.said = true
            print(f"audit: kinds {if alone { 1 } else { AUDIT_KINDS }}")
            print("scene: done")
        }
        return
    }
    if k == 0 {
        let field = stage()
        p.auditing.frame(
            mut p.mesh,
            one(field),
            whole(field),
            vec4(0.0, 1.0, 0.0, 9.0),
            "the stage",
            AUDIT_EYES,
            sky,
            look,
            width,
            height,
        )
    } else if k == 1 {
        // (Walking from eye to eye, still while an eye settles.)
        let body = creature(posed(p, PACE * f32(AUDIT_EYES + 2 + p.auditing.eye())))
        p.auditing.frame(
            mut p.mesh,
            one(body),
            whole(body),
            vec4(0.0, 0.62, 0.0, 0.8),
            "the creature walking",
            AUDIT_EYES,
            sky,
            look,
            width,
            height,
        )
    } else if k == 2 {
        let field = stack(TALL_STACK)
        p.auditing.frame(
            mut p.mesh,
            one(field),
            whole(field),
            vec4(0.0, 20.0, 0.0, 28.0),
            "the stack",
            AUDIT_EYES,
            sky,
            look,
            width,
            height,
        )
    } else if k == 3 {
        let field = arena_pillars()
        p.auditing.frame(
            mut p.mesh,
            one(field),
            whole(field),
            bounded(field),
            "the arena's pillars",
            AUDIT_EYES,
            sky,
            look,
            width,
            height,
        )
    } else if k == 4 {
        let field = arena_brazier_stands()
        p.auditing.frame(
            mut p.mesh,
            one(field),
            whole(field),
            bounded(field),
            "the arena's braziers",
            AUDIT_EYES,
            sky,
            look,
            width,
            height,
        )
    } else if k == 5 {
        let field = arena_flames(0.0)[0]
        p.auditing.frame(
            mut p.mesh,
            one(field),
            whole(field),
            bounded(field),
            "a brazier's flame",
            AUDIT_EYES,
            sky,
            look,
            width,
            height,
        )
    } else if k == 6 {
        let field = parry_arc(0.0)
        p.auditing.frame(
            mut p.mesh,
            one(field),
            whole(field),
            bounded(field),
            "the ward",
            AUDIT_EYES,
            sky,
            look,
            width,
            height,
        )
    } else if k == 7 {
        var log = world_edits()
        log.append(edit_sphere_sub(vec3(0.42, 2.05, 0.48), radius: 0.44, k: 0.08))
        log.append(
            edit_capsule_sub(
                vec3(-0.78, 1.05, 0.55),
                vec3(0.85, 2.85, -0.35),
                radius: 0.16,
                k: 0.05,
            ),
        )
        let field = edited(marble_column(), log)
        p.auditing.frame(
            mut p.mesh,
            one(field),
            whole(field),
            bounded(field),
            "the CSG-cut column",
            AUDIT_EYES,
            sky,
            look,
            width,
            height,
        )
    } else if k == 8 {
        let bodies = crowd(p, AUDIT_EYES + 2 + p.auditing.eye())
        p.auditing.frame(
            mut p.mesh,
            pool_of(bodies),
            each(bodies),
            bounded(bodies.union()),
            "a crowd",
            AUDIT_EYES,
            sky,
            look,
            width,
            height,
        )
    } else if k == 10 {
        // The column cut while it is seen: each odd eye stands where the even eye before it
        // stood, and only its column is cut, so the cut is met by the mesh the even eye left
        // (patched in place, `MeshBatch::try_patch_dirty`), not by one begun afresh.
        p.auditing.pair_eyes()
        var log = world_edits()
        if p.auditing.eye() % 2 == 1 {
            log.append(edit_sphere_sub(vec3(0.42, 2.05, 0.48), radius: 0.44, k: 0.08))
            log.append(
                edit_capsule_sub(
                    vec3(-0.78, 1.05, 0.55),
                    vec3(0.85, 2.85, -0.35),
                    radius: 0.16,
                    k: 0.05,
                ),
            )
        }
        let field = edited(marble_column(), log)
        p.auditing.frame(
            mut p.mesh,
            one(field),
            whole(field),
            // Eyes from four times its bound out: a cut patches in place only where it meets
            // no seam between levels (`try_patch_dirty`), as seen from farther.
            vec4(bounded(marble_column()).xyz, 4.0 * bounded(marble_column()).w),
            "the column cut while seen",
            AUDIT_EYES,
            sky,
            look,
            width,
            height,
        )
    } else if k == 11 {
        // A walk past the arena's pillars: each eye is the one before moved 7 mm, so the mesh an
        // eye sees was made for an eye a step back (within `eye_step` of it, or re-made).
        p.auditing.stroll(vec3(0.0049, 0.0021, 0.0049))
        let field = arena_pillars()
        p.auditing.frame(
            mut p.mesh,
            one(field),
            whole(field),
            bounded(field),
            "a walk past the pillars",
            AUDIT_EYES,
            sky,
            look,
            width,
            height,
        )
    } else if k == 12 {
        // The glass barrage: fourteen faceted shards, transmissive, as one `Pool` (the audit sees
        // glass: `MeshSight::drawn_only` puts it in its picture's place).
        let shards = glass_barrage(0.5)
        p.auditing.frame(
            mut p.mesh,
            pool_of(shards),
            each(shards),
            bounded(shards.union()),
            "the glass barrage",
            AUDIT_EYES,
            sky,
            look,
            width,
            height,
        )
    } else if k == 9 {
        let bodies = crowd(p, AUDIT_EYES + 2 + p.auditing.eye())
        p.auditing.frame(
            mut p.mesh,
            one(citadel()).and(pool_of(bodies)),
            both(whole(citadel()), each(bodies)),
            bounded(citadel().union(bodies.union())),
            "the citadel's gate with a crowd behind it",
            AUDIT_EYES,
            sky,
            look,
            width,
            height,
        )
    } else if k == 13 {
        let field = table()
        p.auditing.frame(
            mut p.mesh,
            one(field),
            whole(field),
            vec4(0.0, 0.38, 0.0, 0.8),
            "the carved table",
            AUDIT_EYES,
            sky,
            look,
            width,
            height,
        )
    } else {
        let field = grimoire()
        p.auditing.frame(
            mut p.mesh,
            one(field),
            whole(field),
            bounded(field),
            "the grimoire",
            AUDIT_EYES,
            sky,
            look,
            width,
            height,
        )
    }
}

/// The audit's crowd: twelve creatures out of step, where the citadel's vanguard stands (in its
/// forecourt and behind its gate), at moment `k`.
fn crowd(p: Program, k: u32) -> [Translate<Creature>; 12] {
    let t = PACE * f32(k)
    var bodies = [creature(posed(p, t)).translate(AT); 12]
    for i in 0..12 {
        bodies[i] = creature(posed(p, t + 0.37 * f32(i))).translate(in_the_citadel(i, 256))
    }
    bodies
}

/// A thing's stated bound as the audit takes it: its centre and radius.
fn bounded<M: Surface>(field: M) -> vec4 {
    let b = field.bound()
    vec4(b.centre, b.radius)
}

// ---- The paced reference against `traced`'s, on the CPU, by bits ------------------------------------------
use engine::matter::matter::{Matter, matter}
use engine::matter::substance::Substance
use std::field::Field
use engine::picture::eye::view
use engine::reference::paced::{DONE, PacedAt, UNITS, paced_begun, paced_step, said_begun, same_said}
use engine::reference::traced::traced_said

/// The world, eye and light a judged scene `scene` is drawn in (as `frame` builds it at its first
/// moment): 0 the stage and one creature, 2 and 3 the creature far and near, 8 SCENE 8 at one creature.
fn judged_world_check(
    scene: u32,
    x0: u32,
    y0: u32,
    step_x: u32,
    step_y: u32,
    nx: u32,
    ny: u32,
    looks: u32,
    bounces: u32,
    light: u32,
) -> vec2u {
    let body = rest_body()
    if scene == 8 {
        let world = one(stage()).and(one(body.translate(AT))).and(one(strewn().union()))
        return paced_check(
            matter(world.field()),
            STAGE_EYE,
            x0,
            y0,
            step_x,
            step_y,
            nx,
            ny,
            looks,
            bounces,
            light,
        )
    } else if scene == 0 {
        return paced_check(
            matter(stage_with(body).field()),
            STAGE_EYE,
            x0,
            y0,
            step_x,
            step_y,
            nx,
            ny,
            looks,
            bounces,
            light,
        )
    }
    let world = one(body)
    paced_check(matter(world.field()), if scene == 2 { BODY_FAR } else {
        BODY_NEAR
    }, x0, y0, step_x, step_y, nx, ny, looks, bounces, light)
}

/// Paced against `traced` (`traced_said`), by bits, at `nx` x `ny` pixels of 960x540 from (`x0`,
/// `y0`) every (`step_x`, `step_y`): the middle ray, its thickness and `looks` looks a half; how many
/// checked and how many differ.
fn paced_check<M: Field<Substance>>(
    m: Matter<M>,
    eye: Eye,
    x0: u32,
    y0: u32,
    step_x: u32,
    step_y: u32,
    nx: u32,
    ny: u32,
    looks: u32,
    bounces: u32,
    light_kind: u32,
) -> vec2u {
    let sky = clear(SUN)
    let lk = photo(EXPOSURE)
    let middle = view(eye, 960, 540)
    var checked: u32 = 0
    var differ: u32 = 0
    for j in 0..ny {
        for i in 0..nx {
            let x = x0 + i * step_x
            let y = y0 + j * step_y
            let at = PacedAt {
                x,
                y,
                salt: 0,
                looks,
                rays: RAYS,
                bounces,
                light: light_kind,
                spare: 0,
            }
            let traced = traced_said(m, sky, lk, middle, at)
            var ps = paced_begun()
            var sd = said_begun()
            var steps: u32 = 0
            while ps.st.x != DONE && steps < 200000 {
                steps += 1
                ps = paced_step(m, sky, lk, middle, at, ps, mut sd)
            }
            checked += 1
            if !(ps.st.x == DONE && same_said(sd, traced)) {
                differ += 1
                if differ <= 5 {
                    print(
                        f"paced: ({x}, {y}) differs: centre {sd.centre} / {traced.centre}, behind {sd.behind} / {traced.behind}, thick {sd.thick.x} / {traced.thick.x}, met0 {sd.met0} / {traced.met0}, met1 {sd.met1} / {traced.met1}, far {sd.far} / {traced.far}; steps {steps}",
                    )
                }
            }
        }
    }
    vec2u(checked, differ)
}

@test
fn paced_is_traced_scene_0() {
    let a = judged_world_check(0, 16, 15, 32, 32, 30, 17, 2, 0, WHOLE)
    print(f"paced: SCENE 0: {a.x} px checked, {a.y} differ")
    assert(a.y == 0, "SCENE 0")
}

@test
fn paced_is_traced_scene_0_bounced_and_simple() {
    let a = judged_world_check(0, 0, 135, 64, 24, 15, 12, 2, 2, WHOLE)
    let b = judged_world_check(0, 32, 147, 64, 24, 15, 12, 2, 0, SIMPLE)
    print(
        f"paced: SCENE 0 with two bounces: {a.x} px checked, {a.y} differ; with the simple light: {b.x} px, {b.y} differ",
    )
    assert(a.y == 0 && b.y == 0, "SCENE 0 bounced and simple")
}

@test
fn paced_is_traced_far() {
    let a = judged_world_check(2, 16, 15, 32, 32, 30, 17, 2, 0, WHOLE)
    print(f"paced: far: {a.x} px checked, {a.y} differ")
    assert(a.y == 0, "far")
}

@test
fn paced_is_traced_near() {
    let a = judged_world_check(3, 16, 15, 32, 32, 30, 17, 2, 0, WHOLE)
    print(f"paced: near: {a.x} px checked, {a.y} differ")
    assert(a.y == 0, "near")
}

@test
fn paced_is_traced_scene_8_grid() {
    let a = judged_world_check(8, 16, 15, 32, 32, 30, 17, 2, 0, WHOLE)
    print(f"paced: SCENE 8 at one creature, a grid: {a.x} px checked, {a.y} differ")
    assert(a.y == 0, "SCENE 8 grid")
}

@test
fn paced_is_traced_scene_8_heavy_rows() {
    // (The rows the CPU replay found heaviest, 288-432, where rays graze the stage's top among
    // the boxes; the replay's worst pixels (96, 336) and (768, 352) among them.)
    let a = judged_world_check(8, 0, 288, 32, 16, 30, 10, 2, 0, WHOLE)
    let b = judged_world_check(8, 96, 336, 1, 1, 8, 4, 2, 0, WHOLE)
    let c = judged_world_check(8, 768, 352, 1, 1, 8, 4, 2, 0, WHOLE)
    print(
        f"paced: SCENE 8 heavy rows: {a.x} px checked, {a.y} differ; round (96, 336): {b.x}, {b.y}; round (768, 352): {c.x}, {c.y}",
    )
    assert(a.y == 0 && b.y == 0 && c.y == 0, "SCENE 8 heavy rows")
}

/// Paced against `traced` as the listed rounds drive it: `n` pixels of SCENE `scene` taken together,
/// `UNITS` steps a call, round after round over the pixels still undone, in `order` (0 row order,
/// 1 reversed, 2 rotated and reversed differently each round: always a permutation): each pixel's answers the same bits as `traced`'s.
fn paced_rounds_check(scene: u32, order: u32) -> vec2u {
    let body = rest_body()
    if scene == 8 {
        let world = one(stage()).and(one(body.translate(AT))).and(one(strewn().union()))
        return rounds_of(matter(world.field()), STAGE_EYE, order)
    }
    rounds_of(matter(stage_with(body).field()), STAGE_EYE, order)
}

fn rounds_of<M: Field<Substance>>(m: Matter<M>, eye: Eye, order: u32) -> vec2u {
    let sky = clear(SUN)
    let lk = photo(EXPOSURE)
    let middle = view(eye, 960, 540)
    let looks: u32 = 2
    // 48 pixels: a row through the heavy band and a column down the screen.
    var xs = [u32(0); 48]
    var ys = [u32(0); 48]
    for i in 0..24 {
        xs[i] = 40 * i
        ys[i] = 336
        xs[24 + i] = 480
        ys[24 + i] = 22 * i
    }
    var ps = [paced_begun(); 48]
    var sds = [said_begun(); 48]
    var undone = [u32(0); 48]
    var n: u32 = 48
    for i in 0..48 {
        undone[i] = i
    }
    var round: u32 = 0
    while n > 0 && round < 100000 {
        round += 1
        var next = [u32(0); 48]
        var m2: u32 = 0
        for j in 0..48 {
            if j < n {
                // The list's order this round.
                let rot = (j + round * 13) % n
                let jj = if order == 0 { j } else if order == 1 { n - 1 - j } else if round % 2 ==
                    0 { rot } else { n - 1 - rot }
                let i = undone[jj]
                let at = PacedAt {
                    x: xs[i],
                    y: ys[i],
                    salt: 0,
                    looks,
                    rays: RAYS,
                    bounces: 0,
                    light: WHOLE,
                    spare: 0,
                }
                var s = ps[i]
                var sd = sds[i]
                var u: u32 = 0
                while u < UNITS && s.st.x != DONE {
                    u += 1
                    s = paced_step(m, sky, lk, middle, at, s, mut sd)
                }
                ps[i] = s
                sds[i] = sd
                if s.st.x != DONE {
                    next[m2] = i
                    m2 += 1
                }
            }
        }
        undone = next
        n = m2
    }
    var differ: u32 = 0
    for i in 0..48 {
        let one = paced_check(m, eye, xs[i], ys[i], 1, 1, 1, 1, looks, 0, WHOLE)
        // (paced_check runs the machine straight through; the rounds' answers must be its bits.)
        let at = PacedAt {
            x: xs[i],
            y: ys[i],
            salt: 0,
            looks,
            rays: RAYS,
            bounces: 0,
            light: WHOLE,
            spare: 0,
        }
        var s = paced_begun()
        var sd = said_begun()
        while s.st.x != DONE {
            s = paced_step(m, sky, lk, middle, at, s, mut sd)
        }
        if one.y != 0 || !same_said(sd, sds[i]) {
            differ += 1
        }
    }
    vec2u(48, differ)
}

@test
fn paced_rounds_are_traced_in_any_order() {
    var all: u32 = 0
    for order in 0..3 {
        let a = paced_rounds_check(0, order)
        let b = paced_rounds_check(8, order)
        print(
            f"paced: rounds in order {order}: SCENE 0 {a.x} px, {a.y} differ; SCENE 8 {b.x} px, {b.y} differ",
        )
        all += a.y + b.y
    }
    assert(all == 0, "the rounds' answers are traced's in every order")
}
