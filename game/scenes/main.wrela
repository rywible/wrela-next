// The first scene: the stage (`world::stage`) with the creature (`world::creature`) walking on it
// (`rules::gaits::walk`), under a clear sky (`world::sky`), in the photographic look
// (`look::look`), drawn by the reference alone (`engine::reference`) and judged by the judges
// (`engine::judge`). Nothing here draws: the scene says what is before the eye, and asks.
//
// A moment at a time (`MOMENTS` of them, `PACE` s of the walk apart, from `FROM` s in): the
// reference's looks, both halves; then the judges hold its second half to its first (a picture
// that is right but for the reference's own noise: what every judge says of a right picture),
// with crawl from the moment before; and at the first moment, the same picture with each of three
// faults planted in it, to see that the judges find them. The finished moment is shown until the
// next is; "scene: done" once every judge is heard.
//
//     wrela build game/scenes -o <out> [--set LOOKS=32] [--set MOMENTS=4] [--set PACE=0.25]

use engine::judge::judge::{DIMMED, HOLE, Judge, SHIFTED, judge, marks, planted}
use engine::matter::matter::matter
use engine::picture::eye::Eye
use engine::picture::picture::{Picture, picture}
use engine::picture::screen::show
use engine::reference::reference::{Reference, Truth, reference, truth}
use kit::motion::humanoid::{Rig, palette}
use kit::motion::playback::Move
use look::look::photo
use rules::gaits::walk
use rules::rig::rig
use std::field::Union
use std::io::print
use std::transform::translate
use world::creature::creature
use world::skeleton::on_rig
use world::sky::clear
use world::stage::stage

/// Looks a half of the reference takes (an even number), the rays over the hemisphere a look,
/// and how many times a ray is followed on.
pub const LOOKS: u32 = 32
pub const RAYS: u32 = 2
pub const BOUNCES: u32 = 3

/// The moments drawn, how far apart in the walk (s), and the first (s in).
pub const MOMENTS: u32 = 1
pub const PACE: f32 = 0.016667
pub const FROM: f32 = 0.0

/// Whether faults are planted at the first moment.
pub const FAULTS: bool = true

/// What is shown: 0 the reference; 1 where the judges read the second half's coverage as off
/// (`engine::judge::marks`); 2 the same of the picture with a hole planted.
pub const SHOW: u32 = 0

/// Where the creature walks (its feet's spot), and toward the sun.
const AT = vec3(2.0, 0.0, 3.5)
const SUN = vec3(0.3, 0.6, 0.74)

/// The eye, and how much light makes the look's middle grey.
const EYE = Eye { at: vec3(9.0, 6.0, 11.0), toward: vec3(0.0, 1.0, 0.0), wide: 0.6 }
const EXPOSURE: f32 = 1.2

/// Where a hole is planted (a point on the wall's sunlit face), and how wide (px).
const HOLE_AT = vec3(-1.5, 1.5, 0.1)
const HOLE_SIZE: f32 = 12.0

pub struct Program {
    reference: Reference,
    truth: Truth,
    scratch: Truth,
    shown: Picture,
    half: Picture,
    faulty: Picture,
    marked: Picture,
    judge: Judge,
    walk: Move,
    rig: Rig,
    moment: u32,
    finished: bool,
    said: bool,
}

pub fn init() -> Program {
    Program {
        reference: reference(looks: LOOKS, rays: RAYS, bounces: BOUNCES),
        truth: truth(),
        scratch: truth(),
        shown: picture(width: 1, height: 1),
        half: picture(width: 1, height: 1),
        faulty: picture(width: 1, height: 1),
        marked: picture(width: 1, height: 1),
        judge: judge(),
        walk: walk(),
        rig: rig(),
        moment: 0,
        finished: false,
        said: false,
    }
}

pub fn frame(p: mut Program, time: f32, width: u32, height: u32) {
    if p.shown.width() != width || p.shown.height() != height {
        p.shown = picture(width: width, height: height)
    }
    let t = FROM + PACE * f32(p.moment)
    let pose = on_rig(palette(p.rig, p.walk.pose(t), translate(vec3(0.0))))
    let world = stage().union(creature(pose).translate(AT))
    let m = matter(world)
    let sky = clear(SUN)
    let look = photo(EXPOSURE)
    if !p.finished {
        p.reference.work(m, sky, look, EYE, width, height)
        if p.reference.done() {
            p.reference.picture(0, mut p.shown, mut p.scratch)
            p.reference.settle(1, mut p.truth)
            p.reference.picture(2, mut p.half, mut p.scratch)
            let _ = p.judge.held(p.half, p.truth, EYE, crawl: true, what: f"moment {p.moment} (walk at {t} s): the reference's second half against its first")
            if SHOW == 1 {
                marks(p.half, p.truth, mut p.marked)
            }
            if FAULTS && p.moment == 0 {
                planted(p.half, p.truth, HOLE, EYE, HOLE_AT, HOLE_SIZE, mut p.faulty)
                if SHOW == 2 {
                    marks(p.faulty, p.truth, mut p.marked)
                }
                let _ = p.judge.held(p.faulty, p.truth, EYE, crawl: false, what: f"the second half with a hole {HOLE_SIZE} px square planted on the wall")
                planted(p.half, p.truth, SHIFTED, EYE, HOLE_AT, HOLE_SIZE, mut p.faulty)
                let _ = p.judge.held(p.faulty, p.truth, EYE, crawl: false, what: "the second half moved a pixel right")
                planted(p.half, p.truth, DIMMED, EYE, HOLE_AT, HOLE_SIZE, mut p.faulty)
                let _ = p.judge.held(p.faulty, p.truth, EYE, crawl: false, what: "the second half with the light on matter a tenth darker")
            }
            print(f"moment {p.moment} done")
            p.moment += 1
            if p.moment >= MOMENTS {
                p.finished = true
            } else {
                p.reference.begin()
            }
        }
    }
    let all_heard = p.judge.heard()
    if p.finished && all_heard && !p.said {
        p.said = true
        print("scene: done")
    }
    if SHOW != 0 && p.marked.width() == width {
        show(p.marked.colour)
    } else {
        show(p.shown.colour)
    }
}
