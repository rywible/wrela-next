// The opening, stage 1 (docs/opening.md): the old game's opening scene (rywible/wrela 7ae6711e,
// scenes/opening) without its skiff and its floating isle, as a scene hands it to the frame. Once:
// the gale's sea to the lister of height charts (lib/heights, from lib/sea's tiles), the sea
// stacks as copies of the opening's own baked stacks to the solid lister (lib/atoms), and the
// storm's air and ink to the frame. Each frame: the
// skiff (unseen) stepped on the swell, the eye where the old shot stood, the ocean summed, the
// storm's light, the sea and the stacks into the frame's picture, and the storm's sky (the deck,
// its air, the far islands) to the frame's end as its paint, which the frame cooks into its table
// a sixteenth a frame. It names no pass and imports no `std::gpu`.
//
//     tools/wrela build game/opening -o <out> [--set FROM=10.0] [--set LOAD=400]
//     tools/wrela build game/opening -o <out> --set JUDGE=true --set AT=15     (frame::judge)
//     tools/wrela build game/opening -o <out> --set STEADY=400 --set AT=15     (heights::steady)
//     tools/wrela build game/opening -o <out> --set SKY=true --set AT=15       (frame::sky)
//
// One frame is a sixtieth of a second of the scene, from `FROM` s; the skiff starts at rest at
// `FROM`, as the old's `START` did.

use gale::air::{AIR, STORM_AIR}
use atoms::solids::{Solids, solids}
use gale::camera::{SEEN_FROM, as_the_old_saw, held, hull, shot}
use gale::sail::{Helm, Rig, rest, scripted, step}
use form::ink::NO_LINES
use form::kinds::Chart
use form::look::{Look, Place, Skin}
use frame::eye::{Eye, eye_at}
use frame::judge::{Judge, judge}
use frame::picture::{Frame, picture}
use frame::sky::{SkyJudge, sky_judge}
use heights::lister::{Grounds, ground}
use heights::reference::{Reference, reference}
use heights::steady::{Steady, steady}
use heights::marks::{held as held_to, marks}
use heights::tiled::{Seas, sea}
use gale::clusters::clusters
use gale::light::{STORM_INK, storm_light}
use gale::sea::{GaleSea, MID_CALM, REACH, RIDING, SEA, height_at, rest_under}
use gale::sail::YAW
use ocean::swell::{Swell, loudest, ridden}
use gale::sky::{CLOUD_LIGHT, SCAPE, SUN, Storm, StormWeather, storm}
use frame::clouds::clouds
use canvas::{Canvas, PLACES, Sail, nodes, normals, rigged, yard_of}
use limbs::sheets::{Sheets, sheets}
use skiff::{
    FOOT, FREEBOARD, HULL_MESH, MAST_MESH, YARD_MESH, hull_at, spar_at, spars,
}
use stacks::{SOLIDS, Wears, World, copies_of, meshed}
use isle::{ISLE_LOOK, ISLE_MESH}
use gale::camera::ISLE as ISLE_AT
use frame::held_judge::{HeldJudge, held_judge}
use frame::air::NO_AIR
use rider::{COPIES, aboard, charted, part_colour, part_meshed, parts_at, stance}
use hakuro::drawn::{Fighters, fighters}
use hakuro::dress::dress_of
use hakuro::tails
use std::derive::Box2
use std::transform::{inverse, translate}
use std::input::{Event, Key, events}
use std::io::{Pending, print}
use check::{texel_places, tiles_said}

/// How far into the scene the first frame is (s), or under 0 the run's own; and a moment held
/// (s; under 0, none: the scene runs on).
pub const FROM: f32 = 0.0
pub const AT: f32 = -1.0

/// The load beside the frame while it's timed (sines a pixel; 0 for none).
pub const LOAD: u32 = 0


/// What's drawn, each switch to leave one part out and see what it costs: the sea (and its
/// ocean), the stacks, the deck (the sky's clouds; else the sky is the storm's air alone), the far
/// islands, the air (on the sea, the stacks and the deck), the ink.
pub const WATER: bool = true
pub const STACKS: bool = true
pub const SKIFF: bool = true
pub const ISLE: bool = true
pub const RIDER: bool = true
pub const DECK: bool = true
pub const ISLANDS: bool = true
pub const AIRED: bool = true
pub const INK: bool = true
/// Whether the solids are drawn at all (to measure what drawing them costs).
pub const DRAWN: bool = true
/// Whether the solids hold the sky off what is round them (`solids.cast`: lib/frame's `held`).
pub const HOLD: bool = true

/// Who sails the skiff: 0 the keyboard (W or Up sheets in, S or Down lets fly, A and D or Left
/// and Right steer), 1 the scripted helm (`sail::scripted`: the bench's fixed run).
pub const HELM: u32 = 0

/// Where the camera stands: 0 the opening's shot, low behind the skiff looking up at the rock's
/// bearing; 1 the player's, up behind it with the sea ahead.
pub const FRAMING: f32 = 0.0

/// Which eye: 0 the opening's; 1 the same place looking at the far islands (the Still Ring and
/// the needle, east of north); 2 looking straight up the deck from the same place.
pub const EYE: u32 = 0

/// The judges: `JUDGE` (the frame against the reference of the same
/// frames, `SAMPLES` looks a moment, `MOMENTS` moments, the eye walking `STEP` m to its right and
/// turning `TURN` rad a moment); `STEADY` frames' pictures each against the last, the eye walking
/// `STEP` m a frame; `SKY` the sky's table against the paint run at every pixel, at frame
/// `CHECK_FRAME` (the sun's disc is behind the deck: nothing left out).
pub const JUDGE: bool = false
pub const SAMPLES: u32 = 16
pub const MOMENTS: u32 = 24
pub const STEADY: u32 = 0
pub const STEP: f32 = 0.01
pub const TURN: f32 = 0.0005
pub const SKY: bool = false
pub const CHECK_FRAME: u32 = 20

/// The judge of what holds the sky off a point (`frame::held_judge`), from frame `HELD_FROM`,
/// the time held (`AT`): 0 none; drawn as 1 the reference's sky, 2 the store's, 3 the store's
/// less the reference's, four times over (red where the store gives more, blue less).
pub const HELD: u32 = 0

/// 1: the long tiles' texels at frame 300 held to every wave of their bands (`check`).
pub const WATER_CHECK: u32 = 0
pub const HELD_FROM: u32 = 30

pub struct Program {
    frame: Frame,
    sea: Seas<GaleSea>,
    solids: Solids<Wears>,
    placed: bool,
    /// The skiff's copies among the solids: its hull, mast, yard and boom batten.
    hull: u32,
    mast: u32,
    yard: u32,
    boom: u32,
    /// The skiff's sail: cloth.
    sail: Sheets<Sail, Canvas>,
    /// Its rider: his charted body and coat, his stance at rest, and his solid parts' copies
    /// among the solids (his boots, hair and mask).
    rider: Fighters,
    stance: [mat4; 64],
    worn: Vec<u32>,
    rig: Rig,
    /// Where the skiff's stern was the frame before (x, z), for its wake.
    wake_from: vec2,
    keys: u32,
    steps: u32,
    frames: u32,
    judge: Judge,
    reference: Reference,
    nowhere: Grounds<Nowhere, Bare>,
    steady: Steady,
    sky_check: Option<Pending<u32>>,
    sky_judge: Option<SkyJudge>,
    held_judge: Option<HeldJudge>,
    /// The drawn water's check (`check`): the long and mid tiles' texels asked for, at their times.
    water: Option<Pending<vec4>>,
    water_mid: Option<Pending<vec4>>,
    water_at: vec2,
}

/// The bodies the sea writes among the charts, and the first a stack's copy writes among the
/// solids.
const SEA_BODY: u32 = 101
const STACK_BODY: u32 = 1
const SKIFF_BODY: u32 = 100000
const ISLE_BODY: u32 = 200000

pub fn init() -> Program {
    var frame = picture(load: LOAD)
    frame.ink = STORM_INK
    if AIRED {
        frame.air = STORM_AIR
    }
    if !INK {
        frame.ink = NO_LINES
    }
    let from = if AT >= 0.0 { AT } else { FROM }
    Program {
        frame,
        sea: wake_kept(sea(GaleSea { t: from }, SEA, body: SEA_BODY, reach: REACH)),
        solids: solids(),
        placed: false,
        hull: 0,
        mast: 0,
        yard: 0,
        boom: 0,
        sail: sailed(),
        rider: rider_added(),
        stance: stance(),
        worn: Vec::new(),
        rig: rest(from),
        wake_from: vec2(-1.0e9),
        keys: 0,
        steps: 0,
        frames: 0,
        judge: judge(samples: SAMPLES, moments: MOMENTS, settled: 1),
        reference: reference(),
        nowhere: ground(Nowhere {}, Bare {}, body: 0),
        steady: steady(frames: STEADY),
        sky_check: None,
        sky_judge: None,
        held_judge: None,
        water: None,
        water_mid: None,
        water_at: vec2(0.0),
    }
}

/// The stacks and the skiff loaded and placed, once (the skiff moved each frame after).
fn placed(p: mut Program, t: f32) {
    p.placed = true
    var body = STACK_BODY
    if STACKS {
        var solid: Vec<u32> = Vec::new()
        for i in 0..SOLIDS {
            solid.push(p.solids.load(meshed(i)))
        }
        for cl in clusters() {
            for c in copies_of(cl) {
                let _ = p.solids.place(solid[c.solid], c.look, at: c.at, body: body, group: 0)
                body += 1
            }
        }
    }
    if ISLE {
        let isle = p.solids.load(ISLE_MESH.clone())
        let _ = p.solids.place(isle, ISLE_LOOK, at: translate(ISLE_AT), body: ISLE_BODY, group: 0)
    }
    if SKIFF {
        let h = hull_at(p.rig, t)
        let wood = Wears { spare: vec3(0.0), kind: 2.0 }
        let pole = Wears { spare: vec3(0.0), kind: 3.0 }
        let hull = p.solids.load(HULL_MESH.clone())
        let mast = p.solids.load(MAST_MESH.clone())
        let yard = p.solids.load(YARD_MESH.clone())
        p.hull = p.solids.place(hull, wood, at: h, body: SKIFF_BODY, group: 0)
        p.mast = p.solids.place(mast, pole, at: h, body: SKIFF_BODY + 1, group: 0)
        p.yard = p.solids.place(yard, pole, at: h, body: SKIFF_BODY + 2, group: 0)
        p.boom = p.solids.place(yard, pole, at: h, body: SKIFF_BODY + 4, group: 0)
        if RIDER {
            var kinds: Vec<u32> = Vec::new()
            for k in 0..5 {
                kinds.push(p.solids.load(part_meshed(k)))
            }
            let at = parts_at(aboard(p.stance, p.rig, h))
            for c in 0..COPIES {
                let (m, k) = at[c]
                let look = Wears { spare: part_colour(k), kind: 4.0 }
                p.worn.push(p.solids.place(kinds[k], look, at: m, body: SKIFF_BODY + 5 + c, group: 0))
            }
        }
    }
    print(f"opening: {body - STACK_BODY} copies of the stacks' {SOLIDS} baked solids")
}

/// The sea `s` with the skiff's wake kept on it: marks over 64 m round the skiff, a texel 25 cm,
/// carried down the wind as its foam is (lib/sea's `BLOWN`: 3.5% of the wind's speed) and fading
/// over a few seconds (a fifth left after a second: the old churn's `CHURN_LASTS` was its whole
/// life, 10 s; wake.wrela:30-53).
fn wake_kept(s: take Seas<GaleSea>) -> Seas<GaleSea> {
    var k = take s
    k.marks = marks(texels: 256, side: 64.0, kept: 0.2, drift: SEA.wind * (0.035 * SEA.speed))
    k
}

/// The rider, in his own dress, his hair's loose locks left to his hair's mass.
fn rider_added() -> Fighters {
    var f = fighters(vec2(8.0, 8.0), 0.1)
    f.locks = false
    f.add(dress_of(false), 0)
    f
}

/// How far round the hull's centreline the water is held down (m: its beam's half and as much
/// again), and how far over its waterline it is held to (m).
const HELD_WIDE: f32 = 1.0
const HELD_OVER: f32 = -0.05

/// The skiff's sail, its one view worn as the skiff's.
fn sailed() -> Sheets<Sail, Canvas> {
    let n = nodes()
    let k = normals()
    var s: Sheets<Sail, Canvas> = sheets(Sail { spare: vec4(0.0) }, n, k, [0.0], PLACES, views: 1)
    s.add(view: 0, body: SKIFF_BODY + 3, group: 0, look: Canvas { spare: vec4(0.0) })
    s.thick = 0.004
    s
}

/// The skiff's hull and spars moved to where the rig has them at `t`, and its sail held by them
/// and stepped a sixtieth of a second.
fn moved(p: mut Program, t: f32) {
    let h = hull_at(p.rig, t)
    let m = rigged(p.rig, h, t)
    let palette: [mat4; 64] = [m; 64]
    p.sail.hold(0, canvas::held(m), palette)
    p.sail.work(1.0 / 60.0)
    let (mast, boom) = spars(p.rig)
    // Its wake: a stroke from where its stern was a frame ago to where it is, churned white as it
    // makes way, a darker slick in it (wake.wrela:363-484, the churn and the slick).
    // (Marks lie on the sea's places: the hull's are where the water under it rests, metres from
    // where it is now on a gale's crest.)
    let mid = (h * vec4(0.0, 0.0, 0.0, 1.0)).xyz
    let off = rest_under(RIDING, RIDING.moment(t), mid.xz) - mid.xz
    let stern = (h * vec4(0.0, 0.0, -1.9, 1.0)).xyz + vec3(off.x, 0.0, off.y)
    let way = smoothstep(0.3, 4.0, abs(p.rig.speed))
    if p.wake_from.x > -1.0e8 && way > 0.0 {
        p.sea.marks.press(p.wake_from, stern.xz, wide: 0.55 + 0.06 * abs(p.rig.speed), amount: vec4(way, way, 0.0, 0.0))
    }
    p.wake_from = stern.xz
    // The water the hull displaces held down under it, to its waterline (the old's press,
    // wake.wrela's `PRESS`, and its sea held under the hull's side, paint.wrela:414-447).
    let bow = (h * vec4(0.0, 0.0, 2.0, 1.0)).xyz
    let aft = (h * vec4(0.0, 0.0, -2.0, 1.0)).xyz
    let waterline = (h * vec4(0.0, -FREEBOARD, 0.0, 1.0)).y
    p.sea.marks.press(aft.xz + off, bow.xz + off, wide: HELD_WIDE, amount: held_to(waterline + HELD_OVER))
    p.sea.marks.step(p.rig.at, dt: 1.0 / 60.0)
    p.solids.move_to(p.hull, h)
    if RIDER {
        let pal = aboard(p.stance, p.rig, h)
        p.rider.pose(0, charted(pal))
        p.rider.hold(0, tails::held(pal, max(abs(p.rig.speed), 3.0)), pal)
        p.rider.work(1.0 / 60.0)
        let at = parts_at(pal)
        for c in 0..COPIES {
            let (m, _) = at[c]
            p.solids.move_to(p.worn[c], m)
        }
    }
    p.solids.move_to(p.mast, spar_at(h, FOOT, mast))
    let (yard_foot, yard_way, batten_foot, batten_way) = yard_of(mast, boom)
    p.solids.move_to(p.yard, spar_at(h, yard_foot, yard_way))
    p.solids.move_to(p.boom, spar_at(h, batten_foot, batten_way))
}

/// The eye at `t` with the skiff `s`, as `EYE` asks, walked `walked` m to its right and turned
/// `turned` rad about the upright (for the judges).
fn eye_for(r: Rig, t: f32, width: u32, height: u32, walked: f32, turned: f32) -> Eye {
    let (at, to, focal) = shot(r, t, FRAMING)
    var way = to - at
    if EYE == 1 {
        way = vec3(sin(1.15), 0.02, cos(1.15))
    } else if EYE == 2 {
        way = vec3(0.02, 1.0, 0.3)
    }
    let c = cos(turned)
    let sn = sin(turned)
    let turned_way = vec3(way.x * c - way.z * sn, way.y, way.x * sn + way.z * c)
    let right = normalize(cross(way, vec3(0.0, 1.0, 0.0)))
    let from = at + right * walked
    as_the_old_saw(eye_at(from, from + turned_way, 2.0 * atan(1.0 / focal), width: width, height: height))
}

pub fn frame(p: mut Program, time: f32, width: u32, height: u32) {
    let t = if AT >= 0.0 { AT } else { FROM + time }
    // The rules: the helm's keys read, and the rig stepped a sixtieth of a second a frame, by the
    // frame's count, never the clock (docs/design.md, "The rules of play").
    for e in events() {
        match e {
            Event::KeyDown { key, .. } => p.keys |= key_bit(key),
            Event::KeyUp { key, .. } => p.keys &= !key_bit(key),
            _ => {},
        }
    }
    if AT < 0.0 {
        p.steps += 1
        let ruled = FROM + f32(p.steps) / 60.0
        let helm = if HELM == 1 { scripted(ruled - FROM) } else { held_keys(p.keys) }
        p.rig = step(p.rig, helm, ruled)
    }
    let moment = if JUDGE { f32(p.judge.moment()) } else if STEADY > 0 { f32(p.frames) } else {
        0.0
    }
    let walked = STEP * moment
    let turned = if JUDGE { TURN * moment } else { 0.0 }
    let eye = eye_for(p.rig, t, width, height, walked, turned)
    let sky = Storm {
        islands: if ISLANDS { 1.0 } else { 0.0 },
        aired: if AIRED { 1.0 } else { 0.0 },
        ..storm(SEEN_FROM)
    }
    if DECK && p.frames == 0 {
        p.frame.sky.set_clouds(clouds(SCAPE, CLOUD_LIGHT, StormWeather {}))
    }
    // Compute first: the ocean summed.
    if WATER {
        p.sea.waters = GaleSea { t: held(t) }
        p.sea.step(held(t))
    }
    if (STACKS || SKIFF || ISLE) && !p.placed {
        placed(mut p, t)
    }
    if SKIFF {
        moved(mut p, t)
    }
    if SKIFF && RIDER {
        p.rider.ready(eye)
    }
    p.frame.begin(eye, storm_light())
    // The solids' work before the picture: their copies laid out, and what each holds off the sky.
    if STACKS || SKIFF || ISLE {
        p.solids.hold = HOLD
        p.solids.cast(mut p.frame)
    }
    if !INK {
        p.frame.ink = NO_LINES
    }
    p.frame.at(t)
    // The picture's one pass (docs/frame.md): the sea.
    p.frame.draw(|d| {
        if WATER {
            p.sea.draw_into(d)
        }
        if (STACKS || SKIFF || ISLE) && DRAWN {
            p.solids.draw_into(d)
        }
        if SKIFF && RIDER {
            p.rider.draw_into(d)
        }
        if SKIFF {
            p.sail.draw_into(d)
        }
        if SKIFF && RIDER {
            p.rider.cut_into(d)
        }
    })
    // (The skiff at `camera::skiff_at`, and the isle at `camera::ISLE`: stages 2 and 3.)
    if WATER_CHECK == 1 {
        if p.frames == 300 {
            let at = texel_places()
            p.water_at = vec2(p.sea.ocean.big.at, p.sea.ocean.mid.at)
            p.water = Some(p.sea.ocean.texels_of(0, at))
            p.water_mid = Some(p.sea.ocean.texels_of(1, at))
        }
        match mut p.water {
            Some(q) => match q.poll() {
                Some(Ok(v)) => {
                    tiles_said(0, p.water_at.x, texel_places(), v)
                    p.water = None
                },
                _ => {},
            },
            None => {},
        }
        match mut p.water_mid {
            Some(q) => match q.poll() {
                Some(Ok(v)) => {
                    tiles_said(1, p.water_at.y, texel_places(), v)
                    p.water_mid = None
                },
                _ => {},
            },
            None => {},
        }
    }
    p.frames += 1
    if JUDGE && !p.judge.done() {
        p.judge.sized(eye)
        p.judge.resolve(mut p.frame, sky)
        p.reference.look(
            mut p.judge,
            p.judge.looking(eye),
            p.frame.light,
            sky,
            p.nowhere,
            p.sea,
            p.frame.sky,
        )
        p.judge.after(p.frame, sky)
        return
    }
    if STEADY > 0 {
        p.steady.end(mut p.frame, sky)
        return
    }
    p.judge.heard()
    if HELD > 0 && p.frames >= HELD_FROM {
        if p.held_judge.is_none() {
            p.held_judge = Some(held_judge(width, height))
        }
        match mut p.held_judge {
            Some(j) => {
                j.step(
                    p.frame.eye,
                    p.frame.light.held,
                    World { to_hull: inverse(hull_at(p.rig, t)) },
                    p.frame.depth,
                    p.frame.identity,
                    vec2u(STACK_BODY, SKIFF_BODY),
                    SEA_BODY,
                    HELD - 1,
                )
                if j.done {
                    j.shown(mut p.frame)
                    p.frame.air = NO_AIR
                }
            },
            None => {},
        }
    }
    p.frame.end(sky)
    if SKY {
        if p.frames == CHECK_FRAME {
            p.sky_judge = Some(sky_judge(width, height))
        }
        if p.sky_check.is_none() {
            match mut p.sky_judge {
                Some(j) => {
                    p.sky_check = j.step(p.frame.eye, sky, p.frame.ink, p.frame.sky, p.frame.depth, SUN, 0.0)
                },
                None => {},
            }
        }
        match mut p.sky_check {
            Some(c) => match c.poll() {
                Some(Ok(v)) => {
                    let n = max(f32(v[0]), 1.0)
                    print(
                        f"sky: {v[0]} pixels of sky against the paint's mean of 16 looks a pixel: the table {f32(v[1]) / 100.0 / n} of 255 on average, {f32(v[2]) / 100.0} at most, over 2/255 at {v[3]}, over 1/255 at {v[4]}; the paint once a pixel {f32(v[6]) / 100.0 / n} on average, {f32(v[7]) / 100.0} at most, over 2/255 at {v[8]}, over 1/255 at {v[9]}",
                    )
                    p.sky_check = None
                    p.sky_judge = None
                },
                _ => {},
            },
            None => {},
        }
    }
}

/// No land: a chart nowhere near, for the judges' reference, which draws a land beside the sea.
pub struct Nowhere: Copy + GpuData {}

impl Chart for Nowhere {
    fn at(self, uv: vec2) -> vec3 {
        vec3(uv.x, -100.0, uv.y)
    }

    fn domain(self) -> Box2 {
        Box2 { lo: vec2(1.0e6), hi: vec2(1.0e6 + 1.0) }
    }
}

/// What nowhere wears.
pub struct Bare: Copy + GpuData {}

impl Look for Bare {
    fn skin(self, at: Place) -> Skin {
        Skin { albedo: AIR, line: 1.0, metal: 0.0 }
    }
}

/// The bit a key holds in `Program::keys` (the old's: sail.wrela:282-295).
fn key_bit(k: Key) -> u32 {
    match k {
        Key::W => 1,
        Key::Up => 2,
        Key::S => 4,
        Key::Down => 8,
        Key::A => 16,
        Key::Left => 32,
        Key::D => 64,
        Key::Right => 128,
        _ => 0,
    }
}

/// The helm the keys held hold.
fn held_keys(k: u32) -> Helm {
    Helm {
        sheet_in: (k & 3) != 0,
        let_fly: (k & 12) != 0,
        port: (k & 48) != 0,
        starboard: (k & 192) != 0,
    }
}

/// What `tool` does: 0 the scripted path, 1 the ride compared.
pub const TOOL: u32 = 0

/// The waves a body 4.4 m long rides, at two counts, against the full sum's 4,096 loudest.
const R512: Swell<512> = ridden(SEA, MID_CALM, long: 4.4)
const R1024: Swell<1024> = ridden(SEA, MID_CALM, long: 4.4)
const FULL: Swell<4096> = loudest(SEA, MID_CALM)

/// The water under the hull at `at` heading `yaw` (its middle's height, its bow less its stern
/// over 3 m, its starboard less its port over 1 m), as `sail::bearing` reads it, from `w`.
fn under<const N: u32>(w: Swell<N>, t: f32, at: vec2, yaw: f32, once: bool) -> vec3 {
    let now = w.moment(t)
    let along = vec2(sin(yaw), cos(yaw))
    let across = vec2(cos(yaw), -sin(yaw))
    if once {
        let u = w.under(now, at, along * 1.5, across * 0.5)
        return vec3((u.bow + u.stern + u.port + u.star + 2.0 * u.mid) / 6.0, (u.bow - u.stern) / 3.0, u.star - u.port)
    }
    let bow = height_at(w, now, at + along * 1.5)
    let stern = height_at(w, now, at - along * 1.5)
    let port = height_at(w, now, at - across * 0.5)
    let star = height_at(w, now, at + across * 0.5)
    let mid = height_at(w, now, at)
    vec3((bow + stern + port + star + 2.0 * mid) / 6.0, (bow - stern) / 3.0, star - port)
}

/// The ride under the waves the hull's length and longer against the full sum, over the scripted
/// minute (the hull where the rules sail it on the full sum), every tenth of a second: the most
/// and the root mean square of each difference (m, rad).
fn ride() -> u32 {
    var r = rest(0.0)
    var most = [vec3(0.0); 3]
    var sq = [vec3(0.0); 3]
    var n = 0.0
    print(f"held: 512 {R512.held}, 1024 {R1024.held}, full {FULL.held} (the first line: the full sum once for the body)")
    for f in 1..3601 {
        let t = f32(f) / 60.0
        r = step(r, scripted(t), t)
        if f % 6 == 0 {
            let yaw = YAW + r.steer
            let full = under(FULL, t, r.at, yaw, false)
            let d = [
                abs(under(FULL, t, r.at, yaw, true) - full),
                abs(under(R512, t, r.at, yaw, false) - full),
                abs(under(R1024, t, r.at, yaw, false) - full),
            ]
            for k in 0..3 {
                most[k] = max(most[k], d[k])
                sq[k] += d[k] * d[k]
            }
            n += 1.0
        }
    }
    let names = [4096, 512, 1024]
    for k in 0..3 {
        let rms = sqrt(sq[k] / n)
        print(f"{names[k]} waves: height most {most[k].x} rms {rms.x} m; pitch most {most[k].y} rms {rms.y} rad; roll most {most[k].z} rms {rms.z} rad")
    }
    0
}

/// The scripted run over its minute, on the CPU: where the skiff sails, how fast, how high the eye
/// rides.
///
///     wrela tool game/opening                  (the path)
///     wrela tool game/opening --set TOOL=1     (the ride on the waves the hull's length and
///                                               longer, against the full sum)
pub fn tool() -> u32 {
    if TOOL == 1 {
        return ride()
    }
    var r = rest(0.0)
    var least = 1.0e9
    var most = -1.0e9
    for f in 1..3601 {
        let t = f32(f) / 60.0
        r = step(r, scripted(t), t)
        let (at, _, _) = shot(r, t, 0.0)
        least = min(least, at.y)
        most = max(most, at.y)
        if f % 300 == 0 {
            let (k, _, _, _) = hull(r, t)
            print(f"t {t}: skiff at ({k.x}, {k.y}, {k.z}), way {r.speed} m/s, steer {r.steer}, heel {r.heel}, eye at ({at.x}, {at.y}, {at.z})")
        }
    }
    print(f"eye height {least} to {most} m")
    0
}
