// The opening's own tests (`tools/wrela test game/opening`).

use skiff::{Hull, MAST, YARD}
use stacks::{PILLARS, SKERRY}

/// Every solid the opening bakes has a value, a slope and a curvature that are numbers wherever
/// its cook reads it (a testing build stops at the operation where one isn't): the hull's
/// superellipse once made a NaN at its centreline, which ran every cook out of its heap
/// (docs/opening.md, stage 2).
@test
@fuel(2 ** 42)
fn every_baked_solids_slopes_are_numbers() {
    for p in PILLARS {
        atoms::cook::slopes_checked(p, 24, 0.05)
    }
    atoms::cook::slopes_checked(SKERRY, 24, 0.05)
    atoms::cook::slopes_checked(Hull { spare: vec4(0.0) }, 24, 0.005)
    atoms::cook::slopes_checked(MAST, 24, 0.002)
    atoms::cook::slopes_checked(YARD, 24, 0.002)
}
