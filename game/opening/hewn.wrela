// What the isle and its cathedral are made of (rywible/wrela 7ae6711e, scenes/opening/isle.wrela:
// 784-934, `isle_material`, carried as it was): the rock's bedded stone darkening down its
// underside and greened over its lip, the town's lime-washed walls and red and slate roofs, the
// cathedral's limestone ashlar, its leaded roofs, its gilding and its stained glass lit from
// within. Which it is at a point is the form's own (`isle::isle`'s material).

use isle::{DROP, GILT, GLASS, GRAND, HOUSE, ROCK, ROOF, SCALE, TILE, at_church, isle, shown}
use gale::noise::{hash2, hash3, noise, noise3}

/// How high over the isle's centre its town's slab begins (m): under it, only rock.
const BUILT_FROM: f32 = -25.0

/// Whether `p` (from the isle's centre, m) is on its plateau, where the town and the cathedral
/// stand: under it, all is rock.
pub fn built(p: vec3) -> bool {
    p.y >= BUILT_FROM
}

/// What the isle wears at `p` (from its centre, m), facing `n`, seen `foot` m wide: its albedo,
/// how much of it is metal, and the light it gives.
pub fn hewn(p: vec3, n: vec3, foot: f32) -> (vec3, f32, vec3) {
    // (Under the town's slab, 20 m below the plateau's rim and down, all of it is the rock:
    // the form is asked which only over the plateau, where the town and the cathedral stand.)
    let id = if !built(p) { ROCK } else { isle(p, foot).y }
    worn_as(id, p, n, foot)
}

/// What the isle wears at `p` facing `n`, seen `foot` m wide, where it is material `id`.
pub fn worn_as(id: f32, p: vec3, n: vec3, foot: f32) -> (vec3, f32, vec3) {
    let q = p / SCALE
    if id == ROCK {
        // Bedded stone: warm sandstone and grey beds, darker toward the underside, the plateau's
        // grass and the moss on its ledges.
        let bed = noise(vec2(q.y * 0.11 + noise3(q * 0.02) * 2.0, 0.5))
        let band_ = smoothstep(0.35, 0.65, noise(vec2(q.y * 0.045 + noise3(q * 0.015) * 1.5, 7.0)))
        var a = mix(vec3(0.20, 0.15, 0.13), vec3(0.42, 0.33, 0.25), vec3(bed))
        // Its great beds: red sandstone and pale grey limestone in turn, tens of metres deep.
        a = mix(a, a * vec3(1.25, 0.85, 0.7), vec3(band_ * 0.6))
        a = mix(
            a,
            vec3(0.42, 0.42, 0.42) * (0.8 + 0.4 * bed),
            vec3((1.0 - band_) * smoothstep(0.55, 0.8, noise(vec2(q.y * 0.07, 3.0))) * 0.5),
        )
        a *= 0.75 + 0.5 * noise3(q * 0.18)
        // Its strata, read from far off: broad bands of lighter and darker stone, level.
        a *= 0.6 + 0.8 * smoothstep(0.3, 0.7, noise(vec2(q.y * 0.06 + noise3(q * 0.01) * 0.8, 11.0)))
        // Darker and cooler down its underside, toward the tip, as a mass hung in its own shade.
        let under = clamp(-q.y / DROP, 0.0, 1.0)
        a = mix(a, vec3(0.16, 0.15, 0.17), vec3(under * 0.5))
        a *= mix(1.0, 0.5, smoothstep(0.15, 0.95, under))
        // Under the plateau's lip, the green that spills over it and hangs down the cliff.
        let spill = smoothstep(-34.0, -10.0, q.y) * smoothstep(0.75, 0.35, n.y) *
            smoothstep(0.35, 0.6, noise3(q * vec3(0.25, 0.06, 0.25)))
        a = mix(a, mix(vec3(0.07, 0.1, 0.04), vec3(0.14, 0.17, 0.07), vec3(noise3(q * 0.5))), vec3(spill * 0.85))
        let grass = smoothstep(0.65, 0.85, n.y) * smoothstep(-30.0, -4.0, q.y)
        // (The close's green in fields and copses, worn paths across it: not one flat lawn.)
        let field = noise3(q * 0.035 + vec3(2.0))
        let copse = smoothstep(0.55, 0.75, noise3(q * 0.09 + vec3(7.0)))
        var green = mix(vec3(0.09, 0.14, 0.05), vec3(0.17, 0.22, 0.08), vec3(noise3(q * 0.3)))
        green *= 0.7 + 0.6 * field
        green = mix(green, vec3(0.04, 0.07, 0.03), vec3(copse * 0.8))
        let path = smoothstep(0.035, 0.0, abs(noise(vec2(q.x, q.z) * 0.03) - 0.5)) * shown(6.0, foot)
        green = mix(green, vec3(0.3, 0.27, 0.2), vec3(path * 0.7))
        a = mix(a, green, vec3(grass))
        let moss = smoothstep(0.45, 0.7, n.y) * (1.0 - grass) * smoothstep(0.5, 0.7, noise3(q * 0.07))
        a = mix(a, vec3(0.12, 0.16, 0.08), vec3(moss * 0.7))
        return (a, 0.0, vec3(0.0))
    }
    if id == GILT {
        // Gilding: the crosses and the spires' tips, burnished.
        return (mix(vec3(0.75, 0.52, 0.2), vec3(1.0, 0.8, 0.4), vec3(noise3(p * 0.3))), 1.0, vec3(0.0))
    }
    let c = at_church(p)
    let along = if abs(n.x) > abs(n.z) { c.z } else { c.x }
    if id == ROOF {
        // Lead, sheeted in bays with standing seams down the slope; dulled, a few sheets newer.
        let lead_k = shown(0.9 * GRAND, foot)
        let seam = smoothstep(0.06, 0.0, abs(fract(along / 0.9) - 0.5) - 0.44) * lead_k
        let sheet = mix(0.5, hash3(vec3(floor(along / 0.9), floor(c.y / 3.0), 1.0)), lead_k)
        let a = mix(vec3(0.13, 0.15, 0.17), vec3(0.2, 0.22, 0.24), vec3(sheet)) * (1.0 - 0.35 * seam)
        return (a, 0.25, vec3(0.0))
    }
    if id == HOUSE {
        // Lime-washed walls and stone, each house its own, its windows dark specks.
        let lot = floor(vec2(p.x, p.z) / 13.0)
        var a = mix(vec3(0.62, 0.57, 0.48), vec3(0.72, 0.68, 0.6), vec3(hash2(lot + vec2(5.1, 2.2))))
        // (Half of them bare stone, warm grey and ochre: a town of its rock, not of the
        // cathedral's pale ashlar, so it doesn't melt into the keep from far off.)
        let stone_ = mix(vec3(0.38, 0.33, 0.28), vec3(0.52, 0.44, 0.33), vec3(hash2(lot + vec2(2.4, 7.7))))
        a = mix(a, stone_, vec3(step(0.5, hash2(lot + vec2(9.9, 1.3)))))
        let win = smoothstep(0.3, 0.1, abs(fract(p.y / 3.2) - 0.55)) *
            smoothstep(0.3, 0.1, abs(fract((p.x + p.z) / 2.6) - 0.5))
        a *= 1.0 - 0.55 * win * shown(2.6, foot) - 0.2 * (1.0 - shown(2.6, foot))
        return (a, 0.0, vec3(0.0))
    }
    if id == TILE {
        // Their roofs: red tile and grey slate, weathered, each its own (a value darker than the
        // walls under them, so far off the town reads as roofs over walls).
        let lot = floor(vec2(p.x, p.z) / 13.0)
        let h = hash2(lot + vec2(1.7, 8.8))
        let a = if h < 0.5 { mix(vec3(0.3, 0.12, 0.07), vec3(0.38, 0.18, 0.1), vec3(hash2(lot))) } else {
            mix(vec3(0.11, 0.115, 0.13), vec3(0.16, 0.16, 0.17), vec3(hash2(lot)))
        }
        return (a, 0.0, vec3(0.0))
    }
    if id == GLASS {
        // Stained glass lit from inside the nave; too far for a pixel to hold its panes, a
        // window is one warm light, and from kilometres off by day no more than a warm speck.
        let h = hash3(floor(c * 0.6))
        let pane = if h < 0.45 { vec3(0.15, 0.25, 0.9) } else if h < 0.75 { vec3(0.9, 0.18, 0.12) } else {
            vec3(1.0, 0.75, 0.25)
        }
        let k = shown(1.67 * GRAND, foot)
        let tint = mix(vec3(1.0, 0.56, 0.24), pane, vec3(k))
        let lead = smoothstep(0.08, 0.0, min(abs(fract(c.y * 0.6) - 0.5), abs(fract((c.x + c.z) * 0.6) - 0.5)) - 0.42) * k +
            0.15 * (1.0 - k)
        return (vec3(0.02), 0.0, tint * ((1.0 - lead) * 1.8 * mix(0.02, 1.0, k)))
    }
    // Limestone in ashlar: courses 0.6 m, blocks staggered, each its own tint; rain's dark streaks
    // below every ledge; grime at the foot; lichen.
    let row = floor(c.y / 0.6)
    let col = floor(along / 1.2 + row * 0.5)
    let course_k = shown(0.6 * GRAND, foot)
    let block = mix(0.5, hash3(vec3(row, col, 3.0)), shown(1.2 * GRAND, foot))
    let joint = course_k * max(
        smoothstep(0.05, 0.0, abs(fract(c.y / 0.6) - 0.5) - 0.44),
        smoothstep(0.03, 0.0, abs(fract(along / 1.2 + row * 0.5) - 0.5) - 0.47),
    ) * smoothstep(0.7, 0.3, abs(n.y))
    var a = vec3(0.62, 0.56, 0.46) * (0.86 + 0.22 * block)
    a = mix(a, vec3(0.5, 0.52, 0.5), vec3(0.3 * smoothstep(0.3, 0.8, noise3(c * 0.05))))
    // Weathered unevenly, wall by wall, in tall patches a far eye still reads.
    a *= 0.8 + 0.4 * noise3(c * vec3(0.07, 0.018, 0.07) + vec3(3.3))
    let streak = mix(0.25, smoothstep(0.45, 0.9, noise(vec2(along * 0.9, c.y * 0.04))), shown(1.1 * GRAND, foot)) *
        smoothstep(0.5, -0.2, n.y)
    a *= 1.0 - 0.45 * streak
    a *= 1.0 - 0.3 * smoothstep(12.0, 0.0, c.y)
    a *= 1.0 - 0.25 * joint
    let lichen = smoothstep(0.62, 0.8, noise3(c * 0.3)) * smoothstep(30.0, 0.0, c.y)
    a = mix(a, vec3(0.36, 0.38, 0.22), vec3(lichen * 0.5))
    (a, 0.0, vec3(0.0))
}
