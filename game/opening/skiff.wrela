// The skiff: its hull and spars as solids, baked once and placed each frame where the rules have
// it (`gale::sail`, `gale::camera::hull`), and what they wear.
//
// The old opening's planing skiff (rywible/wrela 7ae6711e, scenes/opening/skiff.wrela: `form`,
// :109-133, with `PLANING` 1; `hull`, :154-176; `FREEBOARD` 0.28, main.wrela:68): 4.4 m long and
// 1 m in the beam, flat-bottomed and flared, wide at its transom, its keel swept up forward to a
// fine bow, decked flush, a low bulwark round its deck. What is left to its look: the laps of its
// clinker planking (steps of 6 mm, under a pixel from where the camera stands, at 1 cm at 21 m at
// 1080p) and its old wood. Its frame: across, up, along; the origin on its deck at its middle,
// `FREEBOARD` over the waterline.

use atoms::bake::Baked
use atoms::mesh::bake_mesh
use gale::camera::hull
use gale::sail::{Rig, TURN_RATE, YAW, wind_off}
use form::look::{Look, Place, Skin}
use std::field::{Bound, Surface, value_noise}

/// The hull's half-length, its beam's half and its depth (m: skiff.wrela:72-74), and how far its
/// deck stands over the waterline (main.wrela:68).
pub const LONG: f32 = 2.2
pub const BEAM: f32 = 0.62
pub const DEEP: f32 = 0.42
pub const FREEBOARD: f32 = 0.28

/// The sheer's rise over the gunwale's middle at `z` (along, of the half-length).
fn sheer_at(z: f32) -> f32 {
    0.13 * z * z + 0.3 * pow(max(z, 1.0e-4), 2.5)
}

/// The hull's half-breadth at `z` (of the half-length): fine at the bow, wide at the transom.
fn breadth(z: f32) -> f32 {
    let taper = if z > 0.0 { 1.0 - pow(max(z, 1.0e-4), 1.35) } else {
        1.0 - 0.5 * pow(max(-z, 1.0e-4), 2.2)
    }
    max(BEAM * 0.8 * taper, 0.02)
}

/// How deep the hull is under its sheer at `z`: its keel swept up forward, shallower aft.
fn depth_at(z: f32) -> f32 {
    max(DEEP * 0.85 * (1.0 - 0.85 * pow(max(z, 1.0e-4), 1.6)) *
        (1.0 - 0.25 * z * z * (if z < 0.0 { 1.0 } else { 0.0 })), 0.03) +
        FREEBOARD * (1.0 - smoothstep(0.4, 0.95, z))
}

/// The larger of `a` and `b`, rounded over `k` where they meet (a polynomial smooth maximum: its
/// gradient no longer than theirs).
fn smax(a: f32, b: f32, k: f32) -> f32 {
    let h = max(k - abs(a - b), 0.0) / k
    max(a, b) + h * h * k * 0.25
}

/// The hull's form at `q` (its frame): the old's planing hull (skiff.wrela:109-130), as near a
/// true distance as its parts allow: its plan (half-breadth `breadth`), its bottom (flat with a
/// little deadrise, `depth_at` under its sheer), its deck (crowned 5 cm), each scaled under its
/// steepest slope (the plan's 0.3, the bottom's and the deck's under 0.5), met by smooth maxima
/// (its bilge rounded over 12 cm). The old's
/// form was a superellipse scaled by 0.8, its gradient up to 4.6 near the bow: baked, it ran out
/// of a build's 1 GiB heap however coarse. (Every power's base is kept off 0: `pow` at a base of
/// 0 has a NaN derivative, and the cook's fits, given NaN normals, split its cells forever.)
fn form(q: vec3) -> f32 {
    let z = clamp(q.z / LONG, -1.0, 1.0)
    let plan = (abs(q.x) - breadth(z)) * 0.95
    let top = sheer_at(z)
    let bottom = (top - depth_at(z) + 0.1 * abs(q.x) - q.y) * 0.9
    let crown = 0.05 * (1.0 - min(q.x * q.x / (BEAM * BEAM * 0.64), 1.0))
    let deck = (q.y - top - crown) * 0.9
    let ends = abs(q.z) - LONG
    max(smax(smax(plan, bottom, 0.12), deck, 0.03), ends)
}

/// A box's distance at `p`, its half-sizes `b`.
fn sd_box(p: vec3, b: vec3) -> f32 {
    let q = abs(p) - b
    length(max(q, vec3(0.0))) + min(max(q.x, max(q.y, q.z)), 0.0)
}

/// A capsule's distance at `p`, from `a` to `b`, `r` round.
fn sd_capsule(p: vec3, a: vec3, b: vec3, r: f32) -> f32 {
    let pa = p - a
    let ba = b - a
    let h = clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0)
    length(pa - ba * h) - r
}

/// Where the old crate is lashed aft (its middle, the skiff's frame) and its half-sizes
/// (skiff.wrela:340-346): what stands on the deck aft of the rider.
pub const CRATE = vec3(0.06, 0.2345, -1.55)
pub const CRATE_HALF = vec3(0.2, 0.13, 0.15)

/// What stands on the hull's deck: the old crate lashed aft, its lid warped over it; the stem
/// carried up past the bow and curled back over it as a fern's head; the mast's step, a block
/// bound to the deck (skiff.wrela:337-349).
fn on_deck(q: vec3) -> f32 {
    let crate_ = sd_box(q - CRATE, CRATE_HALF) - 0.008
    let lid = sd_box(q - CRATE - vec3(0.0, 0.14, 0.0), vec3(0.22, 0.012, 0.17))
    let stem = sd_capsule(q, vec3(0.0, 0.36, 2.1), vec3(0.0, 0.58, 2.22), 0.04)
    let step_ = sd_box(q - vec3(0.0, sheer_at(FOOT.z / LONG) + 0.06, FOOT.z), vec3(0.09, 0.04, 0.13)) - 0.01
    // (A low bulwark round the deck's edge, 6 cm thick and up to 14 cm tall, lower toward the
    // ends: from off its quarter it reads as a boat's gunwale, not a board's edge; skiff.wrela:
    // 174-178.)
    let z = clamp(q.z / LONG, -1.0, 1.0)
    let side = (abs(q.x) - breadth(z)) * 0.95
    let tall = 0.14 * (0.25 + 0.75 * smoothstep(1.95, 1.45, abs(q.z)))
    let up = q.y - sheer_at(z)
    let rail = max(max(abs(side + 0.03) - 0.03, abs(up - tall * 0.5) - tall * 0.5), abs(q.z) - 1.95)
    min(min(min(crate_, lid), min(stem, step_)), rail)
}

/// The hull: decked flush, its deck crowned a little, a low bulwark round it.
pub struct Hull: Copy + GpuData {
    pub spare: vec4,
}

impl Surface for Hull {
    fn distance(self, q: vec3) -> f32 {
        min(form(q), on_deck(q))
    }

    /// A sphere round it: 4.4 m long, under a metre wide, from its keel to its bow's sheer.
    fn bound(self) -> Bound {
        Bound { centre: vec3(0.0, 0.1, 0.0), radius: 2.6, slope: 0.5 }
    }

    /// Each part's distance is divided by its own gradient's length, and a smooth maximum's is
    /// no longer than its parts': near 1 (1.12 at most, sampled), with a margin. Not proved.
    fn lipschitz(self, near: f32) -> f32 {
        1.5
    }
}

/// A spar: a round pole from its foot `length` m along +y, `radius` m round, a little thinner
/// toward its head.
pub struct Spar: Copy + GpuData {
    pub length: f32,
    pub radius: f32,
    pub spare: vec2,
}

impl Surface for Spar {
    fn distance(self, q: vec3) -> f32 {
        let y = clamp(q.y, 0.0, self.length)
        let r = self.radius * (1.0 - 0.35 * y / self.length)
        length(q - vec3(0.0, y, 0.0)) - r
    }

    fn bound(self) -> Bound {
        Bound {
            centre: vec3(0.0, 0.5 * self.length, 0.0),
            radius: 0.5 * self.length + self.radius + 0.01,
            slope: 0.5,
        }
    }

    fn lipschitz(self, near: f32) -> f32 {
        1.1
    }
}

/// The mast (to the yard's peak, 4.2 m: skiff.wrela:58-59) and the junk's yard and boom batten
/// (2.6 m and 2.3 m between the sail's corners: one spar for both, the batten standing proud of
/// the luff as a junk's do; skiff.wrela:58-60).
pub const MAST = Spar { length: 4.4, radius: 0.045, spare: vec2(0.0) }
pub const YARD = Spar { length: 2.62, radius: 0.032, spare: vec2(0.0) }

/// The nearest the skiff is cooked for (m): the player's camera stands 6.2 m behind it, the
/// opening's shot 21 m.
const NEAREST: f32 = 5.0

/// The hull, mast and yard, cooked as meshes (`atoms::mesh`).
@fuel(2 ** 46)
pub const HULL_MESH: Baked = bake_mesh("opening-hull", Hull { spare: vec4(0.0) }, nearest: NEAREST)
@fuel(2 ** 46)
pub const MAST_MESH: Baked = bake_mesh("opening-mast", MAST, nearest: NEAREST)
@fuel(2 ** 46)
pub const YARD_MESH: Baked = bake_mesh("opening-yard", YARD, nearest: NEAREST)

/// Where the mast stands on the deck (the skiff's frame), how far up it the boom is lashed (m),
/// and the boom's length (sail.wrela:513-515).
pub const FOOT = vec3(0.0, 0.02, 0.95)
pub const LASHED: f32 = 1.15

/// The matrix carrying the hull's frame to the world's with the rig `r` at time `t`: its axes
/// (across, up, along) as the sea holds it and the rig heels it, its origin on its deck,
/// `FREEBOARD` over its middle at the waterline.
pub fn hull_at(r: Rig, t: f32) -> mat4 {
    let (mid, x, y, z) = hull(r, t)
    let o = mid + y * FREEBOARD
    mat4(vec4(x, 0.0), vec4(y, 0.0), vec4(z, 0.0), vec4(o, 1.0))
}

/// The mast's way up and the boom's way aft from its lashing (the skiff's frame), as the rig `r`
/// stands them (sail.wrela:572-600, `rigged`): the mast leant to windward as the sail's sheeted
/// and squared off, raked forward to bear away and aft to head up; the boom at its angle on its
/// own side, square to the mast.
pub fn spars(r: Rig) -> (vec3, vec3) {
    let phi = r.boom
    let side = if phi >= 0.0 { 1.0 } else { -1.0 }
    let wind = -clamp(phi / 0.5, -1.0, 1.0)
    let a = min(abs(phi), 3.0)
    let off = wind_off(YAW + r.steer + r.veer)
    let up_into = r.turn * clamp(sin(off) / 0.3, -1.0, 1.0)
    let rake = clamp(-up_into / TURN_RATE, -1.0, 1.0) * 0.22 + 0.05
    let tilt = (0.1 + 0.32 * smoothstep(0.6, 1.5, a)) * smoothstep(0.1, 0.6, r.power)
    let mast = normalize(vec3(wind * sin(tilt), cos(tilt) * cos(rake), sin(rake)))
    let b0 = vec3(side * sin(a), 0.0, -cos(a))
    (mast, normalize(b0 - mast * dot(b0, mast)))
}

/// A spar's copy: its foot at `foot` (the skiff's frame), running along `way`, carried by the
/// hull's matrix `h`.
pub fn spar_at(h: mat4, foot: vec3, way: vec3) -> mat4 {
    let side = normalize(cross(way, if abs(way.y) < 0.9 { vec3(0.0, 1.0, 0.0) } else { vec3(1.0, 0.0, 0.0) }))
    let back = cross(side, way)
    h * mat4(vec4(side, 0.0), vec4(way, 0.0), vec4(back, 0.0), vec4(foot, 1.0))
}

/// Value noise in [0, 1].
fn n01(p: vec3) -> f32 {
    0.5 + 0.5 * value_noise(p)
}

/// The hull's old wood at `q` (its frame) facing `n` (skiff.wrela:588-641, `old_wood`, cut to
/// what holds at the distance it's seen from): its sides of laps 7.5 cm deep, each its own tone,
/// the paint worn off to bare wood but for a faded red band under the rail, grime run down from
/// the rail, weed and slime below the water; its deck of planks fore and aft, grey and wet in
/// patches. Laps and seams finer than a few pixels are left to their mean.
pub fn wood(q: vec3, n: vec3) -> vec3 {
    // (The crate: grey weathered boards, its lid darker.)
    if sd_box(q - CRATE, CRATE_HALF + vec3(0.04)) < 0.0 {
        let board = floor((q.y - CRATE.y) / 0.065)
        let tone = fract(sin(board * 31.7 + 3.0) * 43758.547)
        return vec3(0.33, 0.31, 0.27) * (0.75 + 0.3 * tone) * (0.85 + 0.3 * n01(vec3(q.x * 9.0, q.y * 30.0, 4.0)))
    }
    let y = q.y - sheer_at(clamp(q.z / LONG, -1.0, 1.0))
    let lap = floor(y / 0.075)
    let tone = fract(sin(lap * 12.9898 + 7.0) * 43758.547)
    let grain = n01(vec3(q.z * 1.7, y * 30.0, 3.0))
    var c = mix(vec3(0.18, 0.13, 0.09), vec3(0.3, 0.22, 0.15), vec3(tone * 0.5 + grain * 0.5))
    let wear = n01(vec3(q.z * 2.6, y * 7.0, 1.0)) + 0.2 * smoothstep(-0.06, 0.0, y) +
        0.15 * smoothstep(1.2, 2.0, q.z)
    let painted = (1.0 - smoothstep(0.62, 0.7, wear)) * smoothstep(-0.13, -0.1, y)
    c = mix(c, vec3(0.3, 0.12, 0.08) * (0.85 + 0.25 * grain), vec3(painted))
    c *= 1.0 - 0.3 * smoothstep(0.55, 0.8, n01(vec3(q.z * 11.0, y * 0.8, 5.0))) * smoothstep(-0.3, 0.0, y)
    let water = 1.0 - smoothstep(-0.3 - FREEBOARD, -0.26 - FREEBOARD, y)
    c = mix(c, vec3(0.06, 0.07, 0.04), vec3(water))
    // (Its deck, where it faces up.)
    let board = floor(q.x / 0.085 + 0.5)
    let bt = fract(sin(board * 78.233 + 11.0) * 43758.547)
    var deck = mix(vec3(0.16, 0.14, 0.12), vec3(0.27, 0.24, 0.2), vec3(bt * 0.5 + 0.5 * n01(vec3(q.z * 2.0 + bt * 9.0, q.x * 9.0, 7.0))))
    deck *= 1.0 - 0.45 * smoothstep(0.55, 0.75, n01(vec3(q.x * 1.6, q.z * 1.6, 9.0)))
    mix(c, deck, vec3(smoothstep(0.5, 0.8, n.y) * smoothstep(-0.02, 0.0, y)))
}

/// A spar's weathered pole: grey-brown, darker toward its foot.
pub fn pole(q: vec3) -> vec3 {
    vec3(0.32, 0.26, 0.19) * (0.8 + 0.3 * n01(vec3(q.y * 3.0, q.x * 40.0, 2.0)))
}
