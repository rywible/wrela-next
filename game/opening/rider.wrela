// The skiff's rider: the game's own figure (game/hakuro, drawn by lib/limbs: his charted body, his
// coat's tails as cloth, his hair and mask as solids) stood on the skiff's deck aft of the mast,
// as the old opening's traveller stood (rywible/wrela 7ae6711e, scenes/opening/sail.wrela:
// 570-640, `rigged`'s pose; scenes/opening/skiff.wrela:361-393). Posed once in his armed guard
// (`moves::gaits::GUARD` at its first frame), and carried each frame by the skiff's frame, leant
// out to windward against the heel and the sail's pull (sail.wrela:753-762: his weight thrown out
// as the gust comes on and the skiff heels).

use atoms::bake::Baked
use atoms::mesh::bake_mesh
use gale::sail::Rig
use hakuro::fields::{BOOT, BOOT_SHAFT, BOOT_TOE, Hair, Mask, NO_IMAGE, WORN}
use hakuro::skeleton::REST
use hakuro::hakuro::{Charted, charted_as}
use hakuro::posed::of_rig
use motion::humanoid::palette
use moves::gaits::GUARD
use moves::rig::rig
use std::transform::{rotate_y, rotate_z, scale, translate}

/// The nearest his solid parts are seen from (m): the player's camera, 6 m behind the skiff.
const PART_NEAREST: f32 = 2.0

/// His hair's mass (his skull in it), his mask and his boots' parts, cooked once as meshes
/// (`atoms::mesh`; the fight's own parts: the same forms, so the same cooked constants).
@fuel(2 ** 46)
pub const HAIR_MESH: Baked = bake_mesh("hair", Hair {}, nearest: PART_NEAREST)
@fuel(2 ** 46)
pub const MASK_MESH: Baked = bake_mesh("mask", Mask {}, nearest: PART_NEAREST)
@fuel(2 ** 46)
pub const BOOT_MESH: Baked = bake_mesh("boot", BOOT, nearest: PART_NEAREST)
@fuel(2 ** 46)
pub const BOOT_TOE_MESH: Baked = bake_mesh("boot-toe", BOOT_TOE, nearest: PART_NEAREST)
@fuel(2 ** 46)
pub const BOOT_SHAFT_MESH: Baked = bake_mesh("boot-shaft", BOOT_SHAFT, nearest: PART_NEAREST)

/// Part `k` of `PARTS` cooked as meshes.
pub fn part_meshed(k: u32) -> Baked {
    if k == 0 { BOOT_MESH.clone() } else if k == 1 { BOOT_TOE_MESH.clone() } else if k == 2 {
        BOOT_SHAFT_MESH.clone()
    } else if k == 3 { HAIR_MESH.clone() } else { MASK_MESH.clone() }
}

/// His solid parts, by `hakuro::fields::WORN`'s index (his belt, under his coat, left out): each
/// boot's foot, toe and shaft, his hair and his mask.
pub const PARTS: [u32; 5] = [1, 2, 3, 4, 5]

/// What part `k` of `PARTS` wears (linear: his boots' and hair's black, his mask's bone white).
pub fn part_colour(k: u32) -> vec3 {
    if k < 3 { vec3(0.03, 0.028, 0.03) } else if k == 3 { HAIR_COLOUR } else { MASK_COLOUR }
}

/// Where each copy of his parts goes as `palette` poses him: each of `PARTS` on its bone, from
/// that bone's joint at rest, and its mirror image on its image's bone (x turned over); with
/// which of `PARTS` each is. Seven copies: two boots of three pieces, his hair, his mask.
pub fn parts_at(palette: [mat4; 64]) -> [(mat4, u32); 8] {
    var out = [(translate(vec3(0.0)), 0); 8]
    var n = 0
    for k in 0..5 {
        let f = WORN[PARTS[k]]
        out[n] = (palette[f.bone] * translate(REST[f.bone]), k)
        n += 1
        if f.image != NO_IMAGE {
            out[n] = (palette[f.image] * translate(REST[f.image]) * scale(vec3(-1.0, 1.0, 1.0)), k)
            n += 1
        }
    }
    out
}

/// How many copies `parts_at` gives.
pub const COPIES: u32 = 8

/// Which of `hakuro::fields::WORN` his hair and his mask are, and their colours (linear: his
/// hair's black, his mask's bone white).
pub const HAIR_WORN: u32 = 4
pub const MASK_WORN: u32 = 5
pub const HAIR_COLOUR = vec3(0.02, 0.02, 0.025)
pub const MASK_COLOUR = vec3(0.80, 0.78, 0.72)

/// Where he stands on the deck (the skiff's frame: across, up, along): aft of the mast, a little
/// to windward of the middle; and which way he faces (rad about the upright from facing the bow).
const STANDS = vec3(0.0, 0.08, -0.55)
const FACES: f32 = 0.0

/// His body at rest in his own frame (feet on the floor at the origin): the guard's first frame.
pub fn stance() -> [mat4; 64] {
    let g = GUARD.clone()
    of_rig(palette(rig(), g.pose(0.0), translate(vec3(0.0))))
}

/// How far he leans out to windward (rad, about the skiff's along axis; positive leans to
/// starboard): against the heel, more as the sail pulls (sail.wrela:753-762).
fn leant(r: Rig) -> f32 {
    let windward = if r.boom > 0.0 { -1.0 } else { 1.0 }
    windward * (0.12 + 0.35 * smoothstep(0.1, 0.8, r.power)) - 0.6 * r.heel
}

/// His palette on the hull's matrix `h`: his stance stood on the deck at `STANDS`, facing the
/// bow, leant out by the rig.
pub fn aboard(at_rest: [mat4; 64], r: Rig, h: mat4) -> [mat4; 64] {
    let m = h * translate(STANDS) * rotate_z(leant(r)) * rotate_y(FACES)
    var out = at_rest
    for k in 0..64 {
        out[k] = m * at_rest[k]
    }
    out
}

/// His charted parts as `palette` poses him.
pub fn charted(palette: [mat4; 64]) -> Charted {
    charted_as(palette)
}

/// Where his hair and his mask are as `palette` poses him (each on its bone, from that bone's
/// joint at rest: `hakuro::fields::WORN`).
pub fn head_of(palette: [mat4; 64]) -> (mat4, mat4) {
    let h = WORN[HAIR_WORN].bone
    let m = WORN[MASK_WORN].bone
    (palette[h] * translate(REST[h]), palette[m] * translate(REST[m]))
}
