// The opening's sea stacks, where game/gale's `clusters` puts them (the old opening's placement:
// 107 clusters, 12 in the opening's view), as the solid lister draws them.
//
// The old opening's own stacks (rywible/wrela 7ae6711e, scenes/opening/stacks.wrela: `stack`,
// :64-92; `skerry`, :102-106), baked once each at four heights and one skerry (`Pillar`,
// `Skerry`), and drawn as copies: each cluster's main stack a copy of the baked one nearest its
// height, stretched to its height and girth and turned; its four satellites (stacks.wrela:
// 129-147) a lesser stack or a skerry. What makes them the old's and not round lumps: their sides
// are lobed by a noise of the way round the column that changes only every 80 m up (broad
// buttresses and bays running up the stack, slab faces), not of the place in 3D. Left behind:
// the ring of solid white water round each foot (stacks.wrela:117-120: the stone's surf here, as
// the old's albedo also had it), the scale by 0.6 and every bound the march needed, and the foot
// below 6 m under the sea (the old's went to 12: what is under the water is never seen, and the
// triangles under it are drawn all the same).

use atoms::bake::Baked
use atoms::mesh::bake_mesh_worn
use form::look::{Look, Place, Skin}
use gale::clusters::{CELL, TALLEST, cluster}
use gale::noise::{hash2, noise}
use skiff::{Hull, pole, wood}
use hewn::{built, hewn, worn_as}
use isle::{kept_at, material_kept}
use gale::camera::SEEN_FROM
use std::field::{Bound, Surface, value_noise}
use std::transform::{identity, rotate_y, scale, translate}

/// One copy of a baked solid in the scene: which (`baked`), where, what it wears.
pub struct Laid: Copy {
    pub solid: u32,
    pub at: mat4,
    pub look: Wears,
}

/// Value noise in [0, 1] (std's, the same bits on the CPU and the GPU).
fn n01(p: vec3) -> f32 {
    0.5 + 0.5 * value_noise(p)
}

/// A number from `seed` and `k` in [0, 1).
fn pick(seed: f32, k: f32) -> f32 {
    fract(sin(seed * 12.9898 + k * 78.233) * 43758.547)
}

/// How far under the sea a stack's foot reaches (m): under the deepest trough the gale makes.
const FOOT: f32 = 6.0

/// The most a stack's gradient reaches (its lobes, crown and crags, its rough faces), with a
/// margin: what a cook steps by. Not proved.
const STEEPEST: f32 = 3.5

/// A stack `girth` m round at its foot and `tall` m high, from its seed: the old's `stack`.
pub struct Pillar: Copy + GpuData {
    pub girth: f32,
    pub tall: f32,
    pub seed: f32,
    pub spare: f32,
}

impl Surface for Pillar {
    /// A pillar of bedded stone, leaning, its crown tilted and broken into crags, its footprint
    /// lobed by buttresses running up it, its beds standing out where a harder one lies, its
    /// foot notched by the sea, its faces rough (stacks.wrela:64-92, its distance unscaled).
    fn distance(self, q: vec3) -> f32 {
        let r = self.girth
        let tall = self.tall
        let seed = self.seed
        let lean = vec2(pick(seed, 1.0) - 0.5, pick(seed, 2.0) - 0.5) * 0.22
        let v = q.xz - lean * max(q.y, 0.0)
        let rv = length(v)
        let dir = v / max(rv, 1.0e-3)
        let up = clamp(q.y / tall, 0.0, 1.0)
        let lobe = 1.0 + 0.36 * (n01(vec3(dir.x * 1.3 + seed, dir.y * 1.3, q.y * 0.012)) - 0.5) +
            0.16 * (n01(vec3(dir.x * 2.9 + seed * 2.0, dir.y * 2.9, q.y * 0.035 + 7.0)) - 0.5)
        let hard = smoothstep(0.55, 0.8, n01(vec3(q.y * 0.22, seed * 1.7, 0.5)))
        let lip = 1.0 + 0.06 * hard
        let notch = 1.0 - 0.26 * exp(-pow((q.y - 2.2) / 2.2, 2.0))
        let girth = r * lobe * lip * (1.0 - 0.35 * up) * notch
        let tilt = vec2(pick(seed, 3.0) - 0.5, pick(seed, 4.0) - 0.5) * 0.6
        let crags = n01(vec3(dir.x * 2.4 + seed * 3.0, dir.y * 2.4, 3.0)) * tall * 0.16
        let crown = tall - dot(v, tilt) - 0.15 * rv - crags
        let rough = (n01(q * 0.16 + vec3(seed)) - 0.5) * 2.4 +
            (n01(q * 0.4 + vec3(seed * 2.0)) - 0.5) * 0.9
        let shell = max(rv - girth, max(q.y - crown, -q.y - FOOT))
        shell + rough * smoothstep(8.0, 0.0, abs(shell))
    }

    /// A sphere round its widest (its lobes and ledges at most 1.26 × 1.06 its girth, leant as
    /// far as any leans, 0.11 a metre up, roughened 1.2 m) and its foot.
    fn bound(self) -> Bound {
        let wide = self.girth * 1.34 + 0.11 * self.tall + 1.2
        let lo = -FOOT - 1.2
        let hi = self.tall * 1.05 + 1.2
        let half = vec2(wide, 0.5 * (hi - lo))
        Bound { centre: vec3(0.0, 0.5 * (hi + lo), 0.0), radius: length(half), slope: 0.5 }
    }

    fn lipschitz(self, near: f32) -> f32 {
        STEEPEST
    }
}

/// A skerry: a low hump of broken rock `r` m round and `tall` high, awash (stacks.wrela:102-106,
/// its oval's distance std's `Oval`'s).
pub struct Skerry: Copy + GpuData {
    pub r: f32,
    pub tall: f32,
    pub seed: f32,
    pub spare: f32,
}

impl Surface for Skerry {
    fn distance(self, q: vec3) -> f32 {
        let wob = 1.0 + 0.35 * (n01(vec3(q.x / 7.0 + self.seed, q.z / 7.0, 1.0)) - 0.5)
        let radii = vec3(self.r, self.tall, self.r) * wob
        let k0 = length(q / radii)
        let k1 = length(q / (radii * radii))
        let oval = if k0 < 1.0 { (k0 - 1.0) * min(self.r, self.tall) } else {
            k0 * (k0 - 1.0) / max(k1, 1.0e-9)
        }
        max(oval, -q.y - FOOT) + 0.1 * min(self.r, self.tall) * (n01(q * 0.5 + vec3(self.seed)) - 0.5)
    }

    fn bound(self) -> Bound {
        let wide = self.r * 1.2 + 0.5
        Bound {
            centre: vec3(0.0, 0.0, 0.0),
            radius: length(vec2(wide, max(self.tall * 1.2 + 0.5, FOOT + 0.5))),
            slope: 0.5,
        }
    }

    fn lipschitz(self, near: f32) -> f32 {
        2.0
    }
}

/// The baked stacks' heights (m), their girths at the foot (m), seeds; and the skerry's size.
pub const PILLARS: [Pillar; 4] = [
    Pillar { girth: 6.0, tall: 18.0, seed: 41.0, spare: 0.0 },
    Pillar { girth: 8.5, tall: 30.0, seed: 97.3, spare: 0.0 },
    Pillar { girth: 11.0, tall: 44.0, seed: 12.7, spare: 0.0 },
    Pillar { girth: 14.0, tall: 60.0, seed: 63.1, spare: 0.0 },
]
pub const SKERRY = Skerry { r: 7.0, tall: 3.0, seed: 5.0, spare: 0.0 }

/// The nearest the eye comes to a stack (m): the nearest cluster is 261 m off; a copy stretched
/// to its height and girth is drawn from sets as if nearer by its stretch (docs/atoms.md).
const NEAREST: f32 = 100.0

/// The stone's look as the cook bakes it, in each solid's own space (a copy's own tint is laid
/// on it at its corners: `Wears::copied`).
const STONE = Wears { spare: vec3(1.0), kind: 0.0 }
const SKERRY_STONE = Wears { spare: vec3(1.0), kind: 1.0 }

/// Each cooked as meshes (`atoms::mesh`), wearing the stone, baked in its own space: a copy
/// stretched to its height stretches its beds with it.
@fuel(2 ** 46)
pub const PILLAR_0_MESH: Baked = bake_mesh_worn("opening-pillar-0", PILLARS[0], STONE, identity(), nearest: NEAREST)
@fuel(2 ** 46)
pub const PILLAR_1_MESH: Baked = bake_mesh_worn("opening-pillar-1", PILLARS[1], STONE, identity(), nearest: NEAREST)
@fuel(2 ** 46)
pub const PILLAR_2_MESH: Baked = bake_mesh_worn("opening-pillar-2", PILLARS[2], STONE, identity(), nearest: NEAREST)
@fuel(2 ** 46)
pub const PILLAR_3_MESH: Baked = bake_mesh_worn("opening-pillar-3", PILLARS[3], STONE, identity(), nearest: NEAREST)
@fuel(2 ** 46)
pub const SKERRY_MESH: Baked = bake_mesh_worn("opening-skerry", SKERRY, SKERRY_STONE, identity(), nearest: NEAREST)

/// The baked solids the opening draws, by `Laid::solid`: the four stacks, then the skerry.
pub fn meshed(i: u32) -> Baked {
    if i == 0 { PILLAR_0_MESH.clone() } else if i == 1 { PILLAR_1_MESH.clone() } else if i == 2 {
        PILLAR_2_MESH.clone()
    } else if i == 3 { PILLAR_3_MESH.clone() } else { SKERRY_MESH.clone() }
}

/// How many baked solids the opening draws.
pub const SOLIDS: u32 = 5

/// Where a copy stands: which baked solid (`Laid::solid`), its foot (x, z), how far it is turned
/// about the upright (rad), and how far it is stretched along its own x, y and z.
pub struct Stand: Copy + GpuData {
    pub size: vec3,
    pub solid: u32,
    pub foot: vec2,
    pub turn: f32,
    pub spare: f32,
}

/// A stack `tall` m high and `girth` m round at its foot, standing at `foot` (x, z), turned
/// `turn` rad: baked stack `k`, stretched to it.
fn stack_stand(k: u32, foot: vec2, tall: f32, girth: f32, turn: f32) -> Stand {
    let across = girth / PILLARS[k].girth
    Stand { size: vec3(across, tall / PILLARS[k].tall, across), solid: k, foot, turn, spare: 0.0 }
}

/// A skerry `r` m round and `tall` high at `at` (x, z): the baked skerry stretched to it.
fn skerry_stand(at: vec2, r: f32, tall: f32, turn: f32) -> Stand {
    Stand {
        size: vec3(r / SKERRY.r, tall / SKERRY.tall, r / SKERRY.r),
        solid: 4,
        foot: at,
        turn,
        spare: 0.0,
    }
}

/// The baked stack whose height is nearest `tall` (m), so a copy is stretched as little as can
/// be: a copy stretched `s` times is drawn from sets cooked as if it stood `s` times nearer
/// (docs/atoms.md).
fn nearest_stack(tall: f32) -> u32 {
    var best: u32 = 0
    for i in 1..4 {
        if abs(log(tall / PILLARS[i].tall)) < abs(log(tall / PILLARS[best].tall)) {
            best = i
        }
    }
    best
}

/// How many copies a cluster has: its main stack and four satellites.
pub const IN_CLUSTER: u32 = 5

/// Cluster `cl`'s copy `i`: 0 its main stack, 1 to 4 its satellites (stacks.wrela:110-148).
pub fn stand(cl: vec4, i: u32) -> Stand {
    let foot = cl.xy
    let tall = cl.z
    let seed = cl.w
    if i == 0 {
        let girth = (4.5 + tall * 0.16) * mix(0.85, 1.7, hash2(vec2(seed, 9.0)))
        return stack_stand(nearest_stack(tall), foot, tall, girth, hash2(vec2(seed, 12.0)) * 6.2831853)
    }
    let fi = f32(i - 1)
    let a = hash2(vec2(seed, fi + 10.0)) * 6.2831853
    let reach = 14.0 + 24.0 * hash2(vec2(seed, fi + 20.0))
    let at = foot + vec2(cos(a), sin(a)) * reach
    let pick = hash2(vec2(seed, fi + 30.0))
    let turn = hash2(vec2(seed, fi + 70.0)) * 6.2831853
    if pick < 0.45 {
        let t2 = tall * (0.25 + 0.5 * pick)
        let r = 2.5 + t2 * 0.2
        return stack_stand(nearest_stack(t2), at, t2, r, turn)
    }
    skerry_stand(at, 4.0 + 7.0 * pick, 1.5 + 3.0 * pick, turn)
}

/// Where `s` puts a point of its solid's own frame: its map to the world.
pub fn placed_at(s: Stand) -> mat4 {
    translate(vec3(s.foot.x, 0.0, s.foot.y)) * rotate_y(s.turn) * scale(s.size)
}

/// How much lighter or darker copy `i` of the cluster seeded `seed` is than the stone baked: each
/// its own, a tenth either way, so the copies of one baked solid are not one stone.
fn tint_of(seed: f32, i: u32) -> f32 {
    0.9 + 0.2 * hash2(vec2(seed, f32(i) + 50.0))
}

/// Cluster `cl`'s copies: its main stack, and its four satellites (stacks.wrela:110-148).
pub fn copies_of(cl: vec4) -> Vec<Laid> {
    var out: Vec<Laid> = Vec::new()
    for i in 0..IN_CLUSTER {
        let s = stand(cl, i)
        out.push(
            Laid {
                solid: s.solid,
                at: placed_at(s),
                look: Wears { spare: vec3(tint_of(cl.w, i)), kind: if s.solid == 4 { 1.0 } else { 0.0 } },
            },
        )
    }
    out
}

/// The stone (from the old opening's `stacks_albedo`, stacks.wrela:366-402).
/// The stone's colour at `p` facing `n` (a unit normal), and its line field: ink where it
/// changes sign, along the top of the wet band the spray keeps dark. From `stacks_albedo`: warm
/// sandstone and grey beds, level; salt-pale tops and the birds' white; gullies and streaks down
/// its faces; wet and dark in the spray's reach. (Its white surf is the sea's foam now.)
fn stone(p: vec3, n: vec3) -> (vec3, f32) {
    let n01 = |q: vec2| 0.5 + 0.5 * value_noise(vec3(q.x, 17.0, q.y))
    let n013 = |q: vec3| 0.5 + 0.5 * value_noise(q)
    let bed = n01(vec2(p.y * 0.35 + n01(vec2(p.x + p.z, p.x - p.z) * 0.05) * 1.5, 0.5))
    var a = mix(vec3(0.20, 0.15, 0.13), vec3(0.42, 0.33, 0.25), vec3(bed))
    let band_ = smoothstep(0.35, 0.65, n01(vec2(p.y * 0.08, 7.0)))
    a = mix(a, vec3(0.42, 0.42, 0.42) * (0.8 + 0.4 * bed), vec3((1.0 - band_) * 0.5))
    // Its strata, read from the few hundred metres it is seen from: beds a few metres deep,
    // lighter and darker in turn, sharp-edged and level, wandering a little round the stack.
    let strata = smoothstep(0.4, 0.6, n01(vec2(p.y * STRATA + n01(vec2(p.x + p.z, p.x - p.z) * 0.02) * 0.6, 23.0)))
    a *= 1.0 - STRATA_DEPTH + 2.0 * STRATA_DEPTH * strata
    a *= 1.0 + 0.4 * (n01(vec2(p.x * 0.3 + p.z * 0.2, p.y * 0.5)) - 0.5)
    // Tops: salt-pale and the birds' white.
    a = mix(a, vec3(0.22, 0.22, 0.2), vec3(smoothstep(0.55, 0.9, n.y) * 0.7))
    let guano = smoothstep(0.7, 0.85, n01(vec2((p.x + p.z) * 0.12, p.y * 0.04))) *
        smoothstep(10.0, 25.0, p.y) *
        smoothstep(0.4, -0.1, n.y)
    a = mix(a, vec3(0.42, 0.42, 0.4), vec3(guano * 0.35))
    // Gullies the rain has cut, and the pale streaks of salt under the ledges.
    let gully = smoothstep(0.62, 0.78, n013(vec3(p.x * 0.18, p.y * 0.02, p.z * 0.18)))
    a *= 1.0 - 0.45 * gully * smoothstep(0.6, 0.1, abs(n.y))
    let streak = smoothstep(0.66, 0.8, n013(vec3(p.x * 0.22 + 5.0, p.y * 0.015, p.z * 0.22))) *
        smoothstep(3.0, 12.0, p.y)
    a = mix(a, vec3(0.5, 0.5, 0.48), vec3(streak * 0.5 * smoothstep(0.6, 0.1, abs(n.y))))
    // The spray's reach, wet: dark at the foot, up to a torn line 2.5 to 5.5 m up.
    let wet_top = 2.5 + 3.0 * n01(vec2((p.x - p.z) * 0.08, 1.0))
    a *= mix(0.45, 1.0, smoothstep(wet_top - 2.0, wet_top, p.y))
    (a, p.y - wet_top)
}

/// How wide the isle's detail is seen a metre off (m): a pixel at 1920x1080 under the
/// opening's lens, so its courses and seams fade before a pixel can't hold them.
const ISLE_FOOT: f32 = 0.0005

/// How much of the stone's own colour shows with no shadow and no occlusion to darken it: with
/// its strata, so each stack's mean value is where the opening's values step put it (at t 15,
/// 4K, the stacks' pixels: left about (67, 76, 90) of 255, right (45, 53, 67)).
pub const UNLIT: f32 = 0.88

/// The old opening's stacks read blue-black under the storm (their stone wet, the sky's slate on
/// it): the stone taken this far toward a cold dark basalt, its beds' value kept.
const BASALT = vec3(0.16, 0.18, 0.22)
const COLD: f32 = 0.7

/// How many beds a metre up (about one every 5 m) and how far each is lighter or darker than
/// the stone round it; how much of the stone's own value its basalt keeps (`LIFT`: 1 all of it).
const STRATA: f32 = 0.2
const STRATA_DEPTH: f32 = 0.3
const LIFT: f32 = 3.0

/// What the opening's solids wear, chosen per copy by `kind`: 0 a stack's stone (`stone`, the
/// old surf white on its foot, stacks.wrela:389-401),
/// baked in the solid's own space, each copy tinted by `spare`; 1 a skerry's (the same), 2 the hull's old wood (`skiff::wood`), 3 a spar's pole, 4 one colour
/// (`spare`: the rider's hair, mask and boots, rim-lit as his cloth is), 5 the isle's rock, town
/// and cathedral (`hewn`).
pub struct Wears: Copy + GpuData {
    pub spare: vec3,
    pub kind: f32,
}

impl Look for Wears {
    /// The stone (its beds, gullies and wet foot are metres across, on copies that never move)
    /// and one colour are coarser than a triangle; the hull's wood (its planks' seams, a few
    /// centimetres) and the spars' poles are not.
    fn coarse(self) -> bool {
        self.kind < 1.5 || self.kind > 3.5
    }

    /// A stack's or a skerry's stone, baked, tinted as this copy is (`spare`).
    fn copied(self, baked: Skin) -> Skin {
        if self.kind < 1.5 {
            return Skin { albedo: baked.albedo * self.spare, ..baked }
        }
        baked
    }

    /// The isle's plateau, where its town and cathedral stand (`hewn::built`): houses, roofs and
    /// windows finer than its vertices (21.5 m apart at 6 km).
    fn fine(self, at: Place) -> bool {
        self.kind > 4.5 && built(at.rest)
    }

    /// There, which material a pixel is on from what the cook kept at the corners (how far in
    /// from the brink, the rock's distance: `isle::kept_at`), never the rock asked again; the
    /// rock's own pixels wear what was baked, the rest their material's look at the pixel.
    fn finished(self, baked: Skin, at: Place) -> Skin {
        if self.kind < 4.5 {
            return baked
        }
        let foot = length(at.world - SEEN_FROM) * ISLE_FOOT
        let id = material_kept(at.rest, baked.kept, foot)
        let (albedo, metal, emits) = worn_as(id, at.rest, at.normal, foot)
        Skin { albedo, line: 1.0, metal, rim: false, emits }
    }

    fn skin(self, at: Place) -> Skin {
        if self.kind > 4.5 {
            // (Seen `ISLE_FOOT` m wide a metre off: a 1080p pixel of the opening's lens, from
            // where the eye stands.)
            let foot = length(at.world - SEEN_FROM) * ISLE_FOOT
            let (albedo, metal, emits) = hewn(at.rest, at.normal, foot)
            return Skin { albedo, line: 1.0, metal, rim: false, emits, kept: if built(at.rest) { kept_at(at.rest, foot) } else { vec2(0.0) } }
        }
        if self.kind > 3.5 {
            return Skin { albedo: self.spare, line: 1.0, metal: 0.0, rim: true, emits: vec3(0.0) }
        }
        if self.kind > 2.5 {
            return Skin { albedo: pole(at.rest), line: 1.0, metal: 0.0, rim: false, emits: vec3(0.0) }
        }
        if self.kind > 1.5 {
            return Skin { albedo: wood(at.rest, at.normal), line: 1.0, metal: 0.0, rim: false, emits: vec3(0.0) }
        }
        let p = at.world
        let (a, _) = stone(p, at.normal)
        // The sea breaking on it: white a few metres up its foot, torn above (stacks.wrela:391-401).
        let reach = 2.5 + 3.0 * noise(vec2((p.x - p.z) * 0.08, 1.0))
        let torn = noise(vec2(p.x * 0.4 + p.z * 0.3, p.y * 0.9))
        let surf = max(
            smoothstep(reach, reach * 0.3, p.y) *
                smoothstep(0.25, 0.55, torn + 0.3 * smoothstep(reach * 0.5, 0.0, p.y)),
            smoothstep(1.4, 0.6, p.y),
        )
        let side = mix(1.0, smoothstep(0.85, 0.45, at.normal.y), smoothstep(0.8, 2.0, p.y))
        // (Darkened by half: the old stacks stood in their own shade and occlusion, 24-step soft
        // shadows and four taps of it, stacks.wrela:340-361, which no light here gives yet; their
        // stone read 41 to 67 of 255 a few hundred metres off.)
        let albedo = mix(mix(a, BASALT * (1.0 + LIFT * (dot(a, vec3(0.33)) - 0.25)), vec3(COLD)) * UNLIT, vec3(0.72, 0.74, 0.76), vec3(surf * side))
        // (No line along the wet band's top: a hard stroke across every stack, in a scene whose
        // stone the air and the storm make masses, not drawings.)
        Skin { albedo, line: 1.0, metal: 0.0, rim: false, emits: vec3(0.0) }
    }
}

/// The opening's sea stacks as the light's reference sees them (`frame::held_judge`): every
/// cluster's copies, by their forms themselves, not as cooked.
pub struct World: Copy + GpuData {
    /// The map from the world to the hull's own frame (it moves).
    pub to_hull: mat4,
}

/// The hull's distance at `p` (the world's): a rigid map, so its own distance.
fn hull_distance(w: World, p: vec3) -> f32 {
    Hull { spare: vec4(0.0) }.distance((w.to_hull * vec4(p, 1.0)).xyz)
}

/// Baked solid `k`'s form's distance at `q` (its own frame).
fn form_distance(k: u32, q: vec3) -> f32 {
    if k < 4 { PILLARS[k].distance(q) } else { SKERRY.distance(q) }
}

/// Baked solid `k`'s form's bound.
fn form_bound(k: u32) -> Bound {
    if k < 4 { PILLARS[k].bound() } else { SKERRY.bound() }
}

/// Where `p` (the world's) is in `s`'s solid's own frame.
fn in_stand(s: Stand, p: vec3) -> vec3 {
    let v = rotate_y(-s.turn) * vec4(p.x - s.foot.x, p.y, p.z - s.foot.y, 0.0)
    v.xyz / s.size
}

/// How far `p` is from `s`'s copy (m): its form's distance there, stretched as little as it is
/// (so never past the true distance).
fn stand_distance(s: Stand, p: vec3) -> f32 {
    form_distance(s.solid, in_stand(s, p)) * min(s.size.x, min(s.size.y, s.size.z))
}

/// How far the forms step toward their surface a metre of their distance: their gradient's most.
const STEEP: f32 = 3.5

impl frame::held_judge::Seen for World {
    /// The nearest copy's way out and distance (the copies of the cluster cells round `p`).
    fn near(self, p: vec3) -> vec4 {
        let c = floor(p.xz / CELL)
        var d = 1.0e4
        var best = Stand { size: vec3(1.0), solid: 0, foot: vec2(1.0e6), turn: 0.0, spare: 0.0 }
        for dz in 0..3 {
            for dx in 0..3 {
                let cl = cluster(c + vec2(f32(dx) - 1.0, f32(dz) - 1.0))
                if cl.z > 0.0 {
                    for i in 0..IN_CLUSTER {
                        let s = stand(cl, i)
                        let e = stand_distance(s, p)
                        if e < d {
                            d = e
                            best = s
                        }
                    }
                }
            }
        }
        let hd = hull_distance(self, p)
        let h = 0.05
        if hd < d {
            let g = vec3(
                hull_distance(self, p + vec3(h, 0.0, 0.0)) - hull_distance(self, p - vec3(h, 0.0, 0.0)),
                hull_distance(self, p + vec3(0.0, h, 0.0)) - hull_distance(self, p - vec3(0.0, h, 0.0)),
                hull_distance(self, p + vec3(0.0, 0.0, h)) - hull_distance(self, p - vec3(0.0, 0.0, h)),
            )
            return vec4(g / max(length(g), 1.0e-9), hd)
        }
        let g = vec3(
            stand_distance(best, p + vec3(h, 0.0, 0.0)) - stand_distance(best, p - vec3(h, 0.0, 0.0)),
            stand_distance(best, p + vec3(0.0, h, 0.0)) - stand_distance(best, p - vec3(0.0, h, 0.0)),
            stand_distance(best, p + vec3(0.0, 0.0, h)) - stand_distance(best, p - vec3(0.0, 0.0, h)),
        )
        vec4(g / max(length(g), 1.0e-9), d)
    }

    fn meets(self, p: vec3, d: vec3, far: f32) -> bool {
        // (Nothing stands higher than the tallest stack: a ray is followed only until it is over
        // them, through the cells it crosses until then, at most two either side; and only the
        // two copies whose bounds it enters first are marched.)
        let reach = min(far, max(TALLEST * 1.1 + 2.0 - p.y, 0.0) / max(d.y, 1.0e-3))
        let end = p + d * reach
        let here = floor(p.xz / CELL)
        let lo = max(floor(min(p.xz, end.xz) / CELL), here - vec2(2.0))
        let hi = min(floor(max(p.xz, end.xz) / CELL), here + vec2(2.0))
        let none = Stand { size: vec3(1.0), solid: 0, foot: vec2(1.0e6), turn: 0.0, spare: 0.0 }
        var first = none
        var second = none
        var t1 = vec2(1.0e9)
        var t2 = vec2(1.0e9)
        for cz in 0..5 {
            for cx in 0..5 {
                let c = lo + vec2(f32(cx), f32(cz))
                if c.x <= hi.x && c.y <= hi.y {
                    let cl = cluster(c)
                    if cl.z > 0.0 {
                        for i in 0..IN_CLUSTER {
                            let s = stand(cl, i)
                            let b = form_bound(s.solid)
                            let centre = (placed_at(s) * vec4(b.centre, 1.0)).xyz
                            let r = b.radius * max(s.size.x, max(s.size.y, s.size.z))
                            let oc = p - centre
                            let along = dot(oc, d)
                            let h = along * along - (dot(oc, oc) - r * r)
                            if h > 0.0 {
                                let root = sqrt(h)
                                let span = vec2(max(-along - root, 0.0), min(-along + root, reach))
                                if span.x < span.y {
                                    if span.x < t1.x {
                                        second = first
                                        t2 = t1
                                        first = s
                                        t1 = span
                                    } else if span.x < t2.x {
                                        second = s
                                        t2 = span
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        // (The hull, near the eye: marched a few metres from where the ray starts.)
        var th = 0.0
        for _k in 0..48 {
            if th < 8.0 {
                let gap = hull_distance(self, p + d * th)
                if gap < 0.005 {
                    return true
                }
                th += max(gap * 0.8, 0.005)
            }
        }
        for k in 0..2 {
            let s = if k == 0 { first } else { second }
            let span = if k == 0 { t1 } else { t2 }
            var t = span.x
            for _k in 0..64 {
                if t < span.y {
                    let gap = stand_distance(s, p + d * t)
                    if gap < 0.02 {
                        return true
                    }
                    t += max(gap / STEEP, 0.02)
                }
            }
        }
        false
    }
}
