// The drawn water held to its definition: the long tiles' texels the GPU steps, read back, against
// every wave of their band summed on the CPU at the tile's own time, for the
// gale's sea. Asked for with `--set WATER_CHECK=1`, at frame 300 (t 45 with `--set FROM=40.0`).

use gale::sea::{DRAWN, SEA}
use ocean::spectrum::{SIDE, SIDES}
use ocean::swell::band_sum
use std::io::print

/// The texels read: 24 spread over the tile.
pub fn texel_places() -> Vec<vec2u> {
    var at: Vec<vec2u> = Vec::new()
    for i in 0..24 {
        at.push(vec2u((i * 37 + 5) % SIDE, (i * 101 + 17) % SIDE))
    }
    at
}

/// Band `tile`'s texels (`got`: shape, tilt, foam a texel) stepped at `t` against the CPU's sum
/// of every wave of the band at their places, said: the worst difference of where the water is
/// (mm), and the most it is carried, to judge it by.
pub fn tiles_said(tile: u32, t: f32, at: [vec2u], got: [vec4]) {
    var worst = 0.0
    var most = 0.0
    for i in 0..at.len() {
        let p = vec2(f32(at[i].x), f32(at[i].y)) * (SIDES[tile] / f32(SIDE))
        let s = DRAWN.shaped(band_sum(SEA, tile, p, t))
        worst = max(worst, length(got[3 * i].xyz - s.at))
        most = max(most, length(s.at))
    }
    let name = if tile == 0 { "long" } else { "mid" }
    print(
        f"check: water: the {name} band's tile stepped at t {t} s, {at.len()} texels, against every wave of the band summed on the CPU: within {worst * 1000.0} mm (the water carried up to {most * 1000.0} mm)",
    )
}
