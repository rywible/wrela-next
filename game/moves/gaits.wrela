// The gaits a fighter with a sword stands and goes with (`motion::playback::Gaits`): the armed
// guard, the walk and run, and locked on to a foe, stepping to either side and backing off at a
// walk and a run. From rywible/wrela's content/humanoid at 7ae6711e (armed.wrela's `ARMED_GAITS`,
// `LOCKED`; body.wrela's `GAITS_CODE`), cut to what a fight plays: no start or stop of the
// actor's own (a fighting body sets off and stops at once, as the rules do).

use motion::humanoid::Clip
use motion::playback
use motion::playback::{Gaits, Move}
use rig::rig
use sourced::{RUN_FPS, STANCE, WALK_FPS}
use step::{in_place, mirrored}

/// The armed guard: Quaternius's sword idle lived over the slash's first key, its hands made
/// fists (`sourced::STANCE`, written out from what rywible/wrela's `armed::STANCE` made), as a
/// move that stays where it stands.
@fuel(2 ** 40)
pub const GUARD: Move = in_place(STANCE.clone())

/// The gaits of a body ready to fight with a sword: standing in the armed guard, walking and
/// running as ACCAD's Male 2 does (written as cycles: `walk::WALK`, `run::RUN`, sampled at the
/// rates their captures were taken at), its upper body held in the guard over its legs as it
/// goes; locked on, 100STYLE's side and back steps (`LOCKED`).
@fuel(2 ** 40)
pub const ARMED: Gaits = Gaits {
    idle: GUARD.clone(),
    walk: gait(walk::WALK.clip(rig(), WALK_FPS)),
    run: gait(run::RUN.clip(rig(), RUN_FPS)),
    locked: LOCKED.clone(),
    holds: true,
}

/// A cycle's clip as a gait (looped in place, its footfalls marked).
fn gait(c: Clip) -> Move {
    playback::with_steps(playback::moved(c, rig()), rig())
}

/// `c` mirrored across the body (left for right), its travel with it.
fn mirrored_going(c: Clip) -> Clip {
    let r = rig()
    var out = mirrored(c.clone())
    let t = r.base.q.rotate(c.travel_local)
    out.travel_local = r.base.q.inverse().rotate(vec3(-t.x, t.y, t.z))
    out
}

/// The lock-on gaits, as `Gaits::locked` has them: back, left and right, each a walk and a run.
/// The captures step to the body's right; its left is their mirror.
@fuel(2 ** 40)
pub const LOCKED: Vec<Move> = locked_gaits()

fn locked_gaits() -> Vec<Move> {
    let r = rig()
    let (sw, sr) = (
        side_walk::SIDE_WALK.clip(r.clone(), 60.0),
        side_run::SIDE_RUN.clip(r.clone(), 60.0),
    )
    Vec::from(
        [
            gait(back_walk::BACK_WALK.clip(r.clone(), 60.0)),
            gait(back_run::BACK_RUN.clip(r.clone(), 60.0)),
            gait(mirrored_going(sw.clone())),
            gait(mirrored_going(sr.clone())),
            gait(sw),
            gait(sr),
        ],
    )
}
