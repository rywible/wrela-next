// The sword both fighters hold: its shape, a solid in its own frame (`Sword`), and how a fist
// grips it (`STICK`, a `motion::held::Held` on the rig's right hand). The rules give a sword to
// whoever fights, so it is the weapon's, not a fighter's. From rywible/wrela's
// content/humanoid/stick.wrela at 7ae6711e (`STICK`, `Sword`), where it began as the lab's
// stand-in stick: the grip, the length, and the shape drawn as a longsword.

use motion::held::Held
use motion::humanoid::Rigid
use rig::rig
use std::field::{Bound, Surface}

/// How far a fist's grip runs along the diagonal of its palm (radians): the hilt held from the
/// root of the forefinger to the heel of the hand, as a hammer's is, not square across it, so the
/// blade at rest leans that far from square to the forearm toward its line. The 30 degrees are
/// rywible/wrela's, set so the cut's long point is in the wrists' range, not a measured figure.
pub const DIAGONAL: f32 = 0.5236

/// The sword in the right fist. Its own frame: along +y from the fist, its edge +x. Gripped at
/// the middle of the fist (a hand's width out along the hand from the wrist), pointing the way the
/// thumb does, along the palm's diagonal (`DIAGONAL`): with the arm out at rest, palm down, ahead
/// and leaning out toward the arm's line.
@fuel(2 ** 40)
pub const STICK: Held = stick()

fn stick() -> Held {
    let r = rig()
    let hand = r.rest_world()[r.find("rightHand")]
    // At rest (the arm out to the right, palm down): the fist's middle, its length ahead and
    // leaning `DIAGONAL` out toward the arm's line, its edge (the knuckles' way) out along the arm
    // and leaning back with it.
    let fist = hand.t + vec3(-0.08, -0.01, 0.0)
    // Its own frame (x the edge, y along it) in the world, square across the palm: x out along the
    // arm (-x), y ahead (+z), z up, a half turn about (0, 1, 1); then turned along the palm's
    // diagonal, about up.
    let own = Quat::axis_angle(vec3(0.0, 1.0, 0.0), -DIAGONAL).mul(
        Quat::axis_angle(normalize(vec3(0.0, 1.0, 1.0)), 3.14159265),
    )
    Held {
        hand: "rightHand",
        grip: Rigid { q: hand.q.inverse().mul(own), t: hand.q.inverse().rotate(fist - hand.t) },
        hilt: vec3(0.0, 0.0, 0.0),
        tip: vec3(0.0, LENGTH, 0.0),
        edge: vec3(1.0, 0.0, 0.0),
        // (A blade, and a blade cuts through.)
        cuts: true,
    }
}

/// The sword as `STICK` holds it, in its own frame: what a fighter's hand carries.
pub const HELD: Sword = Sword {
    hilt: vec3(0.0),
    along: vec3(0.0, 1.0, 0.0),
    edge: vec3(1.0, 0.0, 0.0),
}

/// How long the sword is from its hilt to its point, and how far its pommel's end is behind
/// the hilt (m): rywible/wrela's content/humanoid/stick.wrela `LENGTH` and `BUTT`.
pub const LENGTH: f32 = 0.9
pub const BUTT: f32 = 0.2

/// A plain longsword's shape, as a field (in the space of the bone that holds it, m): a blade with
/// an edge, a cross, a grip and a pommel, from its own frame (`hilt` where the right fist holds it,
/// `along` from the hilt to the point, `edge` the way its edge faces). Nothing fine: enough that
/// its edge and its cut read by eye. Its blade's cross-section is a flat diamond, edge to edge
/// `WIDE`, flat to flat `FLAT`, narrowing to its point.
pub struct Sword: Copy + GpuData {
    pub hilt: vec3,
    pub along: vec3,
    pub edge: vec3,
}

/// The blade's width edge to edge and its thickness at the cross (m), its length from the cross
/// (m), the cross's half length (m), how far the cross is ahead of the hilt, the grip's radius
/// and the pommel's.
pub const WIDE: f32 = 0.05
pub const FLAT: f32 = 0.012
pub const BLADE: f32 = LENGTH - 0.05
pub const CROSS: f32 = 0.11
pub const CROSS_AT: f32 = 0.05
pub const GRIP: f32 = 0.016
pub const POMMEL: f32 = 0.026

impl Surface for Sword {
    /// The sphere about the middle of its length that holds it from its pommel's end to its
    /// point and out to the ends of its cross (rywible/wrela stated none).
    fn bound(self) -> Bound {
        let half = 0.5 * (LENGTH + BUTT)
        Bound {
            centre: self.hilt + self.along * (0.5 * (LENGTH - BUTT)),
            radius: sqrt(half * half + CROSS * CROSS),
            slope: 0.5,
        }
    }

    fn distance(self, p: vec3) -> f32 {
        let flat_way = cross(self.along, self.edge)
        let d = p - self.hilt
        let (u, v, w) = (dot(d, self.along), dot(d, self.edge), dot(d, flat_way))
        // The blade: a diamond across, narrowing to its point along it.
        let b = u - CROSS_AT
        let narrow = 1.0 - 0.7 * clamp(b / BLADE, 0.0, 1.0)
        let (hw, ht) = (WIDE * 0.5 * narrow, FLAT * 0.5 * narrow)
        let across = (abs(v) * ht + abs(w) * hw - hw * ht) / sqrt(hw * hw + ht * ht)
        let blade = max(across, max(-b, b - BLADE))
        // The cross: a bar along the edge's line, square in section.
        let bar = max(abs(v) - CROSS, max(abs(u - CROSS_AT * 0.5) - 0.012, abs(w) - 0.014))
        // The grip back to the pommel, and the pommel.
        let g = clamp(u, -BUTT + POMMEL, 0.0)
        let grip = length(vec3(u - g, v, w)) - GRIP
        let pommel = length(vec3(u + BUTT - POMMEL * 0.5, v, w)) - POMMEL
        min(min(blade, bar), min(grip, pommel))
    }

    fn lipschitz(self, near: f32) -> f32 {
        1.0
    }
}

@test
fn the_sword_is_held_as_a_fist_holds_one_and_is_solid_along_its_blade() {
    let r = rig()
    let hand = r.rest_world()[r.find("rightHand")]
    let (hilt, tip) = STICK.ends_at(hand)
    let fist = hand.t + vec3(-0.08, -0.01, 0.0)
    assert(length(hilt - fist) < 1.0e-4, f"its hilt {hilt} in the fist {fist}")
    let ahead = vec3(-sin(DIAGONAL), 0.0, cos(DIAGONAL))
    assert(length(tip - (fist + ahead * LENGTH)) < 1.0e-3, f"its tip {tip} ahead, leaning out")
    assert(HELD.distance(vec3(y: 0.4)) < 0.0 && HELD.distance(vec3(x: 0.1, y: 0.4)) > 0.0)
}
