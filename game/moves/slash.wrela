// The slash: a sword cut written from a source and followed through, every strike either fighter
// makes. Quaternius's `Sword_Attack` (Universal Animation Library, CC0) is the source: a
// one-handed cut from a guard low at the right hip, loaded up over the right shoulder, brought
// over the top and down through ahead at shoulder height, followed through to a finish low on the
// far side, held a beat, and swung back round to the guard. Its keys were read off the source at
// its own moments (`sourced::SOURCE_KEYS`, written out from what rywible/wrela's
// content/humanoid/slash.wrela at 7ae6711e read from the file as it built). And it steps in
// (`STEP`), as a strike does in the fight: the source's feet leave the floor together as it goes
// over the top and land after the blow, so the step is laid in while they're off it, and they
// land a step on.

use motion::end::End
use motion::keys
use motion::keys::{BARE, Key, Wield}
use motion::playback::Move
use motion::written::{Beats, Chain, Taste, Written}
use rig::rig
use sourced::SOURCE_KEYS
use sword::STICK

/// What the slash holds: the sword in the right hand, one-handed, as its source does
/// (rywible/wrela's `BOTH_HANDS` false).
@fuel(2 ** 40)
pub const WIELD: Wield = Wield { held: STICK, off: BARE.off, both: false }

/// How many keys: the source's 15 moments, and one half way between each two through the swing.
pub const KEYS: u32 = 21

/// How far the slash steps in (m, ahead): the fight's step for a strike, 32 of its units, all
/// of it by the blow.
pub const STEP: f32 = 0.5

/// When the source's feet leave the floor together (s): half way between its frames 9 and 10,
/// 0.083 s before the blow. Both are off it from then till after the blow.
pub const LEAVES: f32 = 9.5 / 30.0

/// When the slash goes through its target (s): the source's frame 12, where its sword hand is
/// fastest, as a cut lands.
pub const CONTACT: f32 = 0.40

/// Where along the blade it strikes (0 the hilt, 1 the tip).
pub const ALONG: f32 = 0.75

/// What it strikes with.
@fuel(2 ** 40)
pub const STRIKE: End = STICK.at(ALONG)

/// `k`, the source's keys, stepping in: each carried on by as much of `STEP` as is done by its
/// moment, the step taken evenly from when the feet leave the floor (`LEAVES`) to the blow, so
/// it's laid in while neither foot is down. The keys before stand where the source does; those
/// after, the whole step on, its feet with them, so the feet land a step on and nothing slides.
pub fn stepped(k: [Key; KEYS]) -> [Key; KEYS] {
    var out = k
    for i in 0..KEYS {
        let done = clamp((k[i].at - LEAVES) / (CONTACT - LEAVES), 0.0, 1.0)
        out[i] = keys::shifted(k[i], vec3(0.0, 0.0, STEP * done))
    }
    out
}

/// The slash as written: its keys read off the source, stepping in, the parts on no chain of
/// their own (the source carries its own order from the hips out to the blade in its timing).
pub fn slash() -> Written<KEYS> {
    Written { keys: stepped(SOURCE_KEYS), taste: Taste { chain: Chain {} }, end: STRIKE }
}

/// The slash as the fight plays it at `beats` (`motion::written::Written::played`): at 60 a
/// second, the sword hand closed on its grip, its blade through its target on the frame the
/// rules hit.
pub fn slash_at(beats: Beats) -> Move {
    slash().played(rig(), CONTACT, beats, fps: 60.0, fist: 2.0)
}
