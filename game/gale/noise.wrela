// The old opening's own noise (rywible/wrela 7ae6711e, scenes/opening/look.wrela:423-463):
// Hoskins's hash without sine and a value noise with a smoothstep fade, in [0, 1]. Carried as it
// was because the old opening placed its stacks and drew its far islands' outlines with it, and
// they are placed and drawn the same here. A float hash: its bits may differ between the CPU and
// the GPU (the shore map's §7.4), so the scene asks it on the CPU alone where a place is decided
// (the stacks), and on the GPU alone where a picture is (the sky).

use std::field::hash_u32

/// A hash of a point in [0, 1).
pub fn hash2(p: vec2) -> f32 {
    var q = fract(vec3(p.x, p.y, p.x) * 0.1031)
    q += vec3(dot(q, vec3(q.y, q.z, q.x) + vec3(33.33)))
    fract((q.x + q.y) * q.z)
}

pub fn hash3(p: vec3) -> f32 {
    var q = fract(p * 0.1031)
    q += vec3(dot(q, vec3(q.z, q.y, q.x) + vec3(31.32)))
    fract((q.x + q.y) * q.z)
}

/// Value noise in [0, 1].
pub fn noise(p: vec2) -> f32 {
    let i = floor(p)
    let f = p - i
    let u = f * f * (vec2(3.0) - 2.0 * f)
    let a = hash2(i)
    let b = hash2(i + vec2(1.0, 0.0))
    let c = hash2(i + vec2(0.0, 1.0))
    let d = hash2(i + vec2(1.0, 1.0))
    mix(mix(a, b, u.x), mix(c, d, u.x), u.y)
}

/// Value noise in [0, 1] whose lattice repeats every `period` cells each way (so it tiles a
/// square of that many cells).
pub fn noise_wrapped(p: vec2, period: vec2) -> f32 {
    let i = floor(p)
    let f = p - i
    let u = f * f * (vec2(3.0) - 2.0 * f)
    // (Its lattice taken far from 0: the hash of small whole numbers is poor.)
    let w = |q: vec2| -> f32 { hash2(q - period * floor(q / period) + vec2(317.0, 1723.0)) }
    let a = w(i)
    let b = w(i + vec2(1.0, 0.0))
    let c = w(i + vec2(0.0, 1.0))
    let d = w(i + vec2(1.0, 1.0))
    mix(mix(a, b, u.x), mix(c, d, u.x), u.y)
}

pub fn noise3(p: vec3) -> f32 {
    let i = floor(p)
    let f = p - i
    let u = f * f * (vec3(3.0) - 2.0 * f)
    let a = mix(
        mix(hash3(i), hash3(i + vec3(1.0, 0.0, 0.0)), u.x),
        mix(hash3(i + vec3(0.0, 1.0, 0.0)), hash3(i + vec3(1.0, 1.0, 0.0)), u.x),
        u.y,
    )
    let b = mix(
        mix(hash3(i + vec3(0.0, 0.0, 1.0)), hash3(i + vec3(1.0, 0.0, 1.0)), u.x),
        mix(hash3(i + vec3(0.0, 1.0, 1.0)), hash3(i + vec3(1.0, 1.0, 1.0)), u.x),
        u.y,
    )
    mix(a, b, u.z)
}

/// Fractal noise in about [0, 1]: `n` layers, each turned, twice the frequency, half as strong
/// (look.wrela:466-479).
pub fn fbm(p: vec2, n: u32) -> f32 {
    var q = p
    var s = 0.0
    var a = 0.5
    var total = 0.0
    for _ in 0..n {
        s += a * noise(q)
        total += a
        q = vec2(1.6 * q.x - 1.2 * q.y, 1.2 * q.x + 1.6 * q.y) + vec2(17.3, -9.1)
        a *= 0.5
    }
    s / total
}

// The old engine's lattice noise (rywible/wrela 7ae6711e, engine/noise.wrela:14-131): a whole
// number hash of the lattice point (std's `hash_u32`, the same bits on the CPU and the GPU) and a
// value noise with a smoothstep fade, in [0, 1]. Carried because the old opening's storm deck was
// cooked with it (engine/sky.wrela's `cook_weather`), and its masses and rolls lie where they lay.

/// A lattice point's value in [0, 1) (engine/noise.wrela:24).
fn lattice(x: i32, y: i32) -> f32 {
    f32(hash_u32(u32(x).wrapping_mul(1597334677) ^ u32(y).wrapping_mul(3812015801)) >> 8) *
        (1.0 / 16777216.0)
}

/// Value noise in [0, 1], one cell a unit (engine/noise.wrela:58).
pub fn noise2(p: vec2) -> f32 {
    let i = floor(p)
    let f = p - i
    let u = f * f * (vec2(3.0) - 2.0 * f)
    let (x, y) = (i32(i.x), i32(i.y))
    mix(mix(lattice(x, y), lattice(x + 1, y), u.x), mix(lattice(x, y + 1), lattice(x + 1, y + 1), u.x), u.y)
}

/// Fractal `noise2` in about [0, 1]: `octaves` layers, each turned about 37 degrees, twice the
/// frequency and half as strong (engine/noise.wrela:117).
pub fn fbm2(p: vec2, octaves: u32) -> f32 {
    var q = p
    var s = 0.0
    var a = 0.5
    var total = 0.0
    for _ in 0..octaves {
        s += a * noise2(q)
        total += a
        q = vec2(1.6 * q.x - 1.2 * q.y, 1.2 * q.x + 1.6 * q.y) + vec2(17.3, -9.1)
        a *= 0.5
    }
    s / total
}
