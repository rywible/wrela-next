// Where the opening's sea stacks stand: one cluster or none in each 170 m cell of a grid laid
// over the sea out to 2.6 km, in groups, thinner farther out, none in the skiff's first reach, the
// lane it sails out along or in front of the cathedral rock, and one placed by hand (a 46 m stack
// 230 m out, which the skiff passes in its first half minute): as the old opening placed them
// (rywible/wrela 7ae6711e, scenes/opening/stacks.wrela:15-59), with its own hash and noise. 107
// clusters, 12 in the opening's view. game/opening draws them.

use camera::ISLE
use noise::{hash2, noise}

/// A cell's side (m), how far a cluster reaches from its middle (m), how far out the stacks
/// stand (m) and the tallest (m) (stacks.wrela:15-21).
pub const CELL: f32 = 170.0
pub const REACH: f32 = 50.0
pub const OUT: f32 = 2600.0
pub const TALLEST: f32 = 64.0

/// Whether a cluster at `at` (x, z) is kept out (stacks.wrela:29-39).
fn kept_out(at: vec2) -> bool {
    let r = length(at)
    let ahead = vec2(sin(-0.22), cos(-0.22))
    let along = dot(at, ahead)
    let off = abs(at.x * ahead.y - at.y * ahead.x)
    let to_isle = normalize(vec2(ISLE.x, ISLE.z))
    let bearing = dot(at / max(r, 1.0), to_isle)
    r < 120.0 + REACH ||
        (along > -60.0 && along < 900.0 && off < 40.0 + REACH) ||
        (bearing > cos(0.16) && r > 300.0)
}

/// Cell `c`'s cluster: its middle (x, z), its main stack's height (m) and its seed; height 0 if
/// the cell has none (stacks.wrela:43-59).
pub fn cluster(c: vec2) -> vec4 {
    if c.x == 0.0 && c.y == 1.0 {
        return vec4(70.0, 230.0, 46.0, 41.0)
    }
    let h = hash2(c * 0.913 + vec2(3.7))
    let at = (c + vec2(0.5)) * CELL +
        (vec2(hash2(c + vec2(1.1)), hash2(c + vec2(7.3))) - vec2(0.5)) * (CELL - 2.0 * REACH - 14.0)
    let gather = smoothstep(0.35, 0.7, noise(c * 0.21 + vec2(5.3))) *
        (1.0 - 0.65 * smoothstep(700.0, 2400.0, length(at)))
    if h > 0.45 * gather || kept_out(at) || length(at) > OUT {
        return vec4(at, 0.0, 0.0)
    }
    let size = hash2(c + vec2(5.9))
    vec4(at, 14.0 + (TALLEST - 18.0) * size * size, h * 97.0)
}

/// Every cluster: middle, height and seed.
pub fn clusters() -> Vec<vec4> {
    var out: Vec<vec4> = Vec::new()
    let n = i32(OUT / CELL) + 2
    for cy in -n..n {
        for cx in -n..n {
            let cl = cluster(vec2(f32(cx), f32(cy)))
            if cl.z > 0.0 {
                out.push(cl)
            }
        }
    }
    out
}
