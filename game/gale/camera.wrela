// The opening's eye: where the old opening's shot stood (rywible/wrela 7ae6711e,
// scenes/opening/look.wrela:196-324, `shot_at` with `VIEW` 0 and `FRAMING` 0), 21 m behind the
// skiff and 3 m to its port side, 1.9 m over the sea and rising and falling with the skiff on the
// swell, looking up past it at the cathedral rock, through a long lens (a focal length of 3.7
// screen half-heights); lifted over a crest that runs under it.
//
// The skiff at rest, as the opening finds it (scenes/opening/sail.wrela:200-247, `rest`, and
// `step`, :358-453, with no key held): its sail let fly, no way on it but what the swell gives it,
// surfing down a face and checked up the back, so it wanders a few metres along its heading over
// the minute. The rig's own float (a spring on its roll alone, sail.wrela:476-496) and its heel
// (nothing pulls it) don't move the eye. A run starts the skiff at rest at its first moment, as
// the old's `START` did, so a picture of moment T from a run started at T - 5 s is the old's.
//
// Where the skiff will be (`skiff_at`) and where the isle is (`ISLE`) are marked for the stages
// that bring them.

use frame::eye::{Eye, eye_at}
use sail::{Rig, YAW}
use sea::{RIDING, height_at}

/// Where the eye stands over the first minute, about: the skiff wanders a few metres, the eye 21 m
/// behind it and about 2.5 m up (`wrela tool game/opening`). What the sky's paint is seen from.
pub const SEEN_FROM = vec3(-3.0, 2.5, -21.0)

/// Where the eye goes in the scene's minute (the world's, m: a ball's middle and its radius): the
/// scripted helm's path (`wrela tool game/opening`: the eye from (-55, 2, -18) to (32, 2, 200))
/// and as much again round it. What a far solid's cook takes its distances from.
pub const WATERS = vec4(-10.0, 2.5, 90.0, 250.0)

/// Where the floating rock is (the world's, m: its plateau's middle), look.wrela:11.
pub const ISLE = vec3(-1890.0, 1806.0, 7560.0)

/// The drawings a second the sea and the skiff move at (sea.wrela:10).
pub const HELD: f32 = 120.0

/// `t` held to the last drawing (sea.wrela:13-18).
pub fn held(t: f32) -> f32 {
    floor(t * HELD + 0.5) / HELD
}

/// How far the shot stands behind the skiff and to its port side (m), how high (m), where it
/// looks (a way along the sea, m, from the skiff, and a height), and its focal length
/// (look.wrela:262-266, 292, `OPEN_SIDE` 3.5).
const BEHIND = vec2(0.5 - 3.5, -21.0)
const AHEAD = vec2(-530.5, 5421.0)
const LOOK_UP: f32 = 622.0
const EYE_UP: f32 = 1.9
const FOCAL: f32 = 3.7

/// The field of view upward (rad): a focal length of 3.7 half-heights.
pub fn fov() -> f32 {
    2.0 * atan(1.0 / FOCAL)
}

/// How far over the water under it the eye stays at least (m), and how softly it is lifted
/// (look.wrela:248, 315).
const CLEAR: f32 = 0.9
const SOFT: f32 = 0.6

/// How much lower the skiff sits than the open sea would hold it (m: look.wrela:241).
pub const SAT: f32 = 0.08

/// The player's camera (look.wrela:165-181, `CAMERA` 0): how far behind the skiff, how high,
/// its focal length, how far out to windward of the wake.
const PLAY_BACK: f32 = 6.2
const PLAY_UP: f32 = 2.5
const PLAY_FOCAL: f32 = 1.75
const PLAY_SIDE: f32 = 2.4

/// `v` (x, z) turned by `a` rad (look.wrela:184-186).
fn turned(v: vec2, a: f32) -> vec2 {
    vec2(v.x * cos(a) + v.y * sin(a), v.y * cos(a) - v.x * sin(a))
}

/// The skiff's hull as the sea holds it and the rig heels and pitches it at time `t`: where its
/// middle is at its waterline, and its axes (across, up, along) (sea.wrela:162-168, `held_at`;
/// look.wrela:206-230: heeled by the sail's pull, its bow lifted as it climbs onto the plane,
/// lifted a little on the plane and pressed down as it heels, a hand lower than the open sea
/// would hold it).
pub fn hull(r: Rig, t: f32) -> (vec3, vec3, vec3, vec3) {
    let b = r.float
    let yaw = YAW + 0.05 * sin(t * 0.23) + r.steer
    let along0 = vec2(sin(yaw), cos(yaw))
    let across0 = vec2(cos(yaw), -sin(yaw))
    let along_ = normalize(vec3(along0.x, b.y, along0.y))
    let across_ = normalize(vec3(across0.x, b.z, across0.y))
    let up0 = normalize(cross(along_, across_))
    let bx0 = normalize(cross(up0, along_))
    let bz0 = cross(bx0, up0)
    let hl = r.heel
    let bx1 = bx0 * cos(hl) - up0 * sin(hl)
    let by1 = up0 * cos(hl) + bx0 * sin(hl)
    let pl = r.plane
    let pitch = 0.1 * pl * (1.0 - pl) * 4.0 * smoothstep(0.5, 4.0, r.speed) + 0.02 * pl
    let bz = bz0 * cos(pitch) + by1 * sin(pitch)
    let by = by1 * cos(pitch) - bz0 * sin(pitch)
    let y = b.x + 0.02 * pl - SAT - 0.2 * abs(sin(hl))
    (vec3(r.at.x, y, r.at.y), bx1, by, bz)
}

/// The larger of `a` and `b`, rounded over `k` where they meet (look.wrela:251-254).
fn soft_max(a: f32, b: f32, k: f32) -> f32 {
    let h = clamp(0.5 + 0.5 * (a - b) / k, 0.0, 1.0)
    mix(b, a, h) + k * h * (1.0 - h)
}

/// Where the eye stands, what it looks at, and its focal length (screen half-heights), with the
/// rig `r` at time `t`, the camera at `framing` (0 the opening's shot: low behind the skiff,
/// looking up past it at the rock's bearing, swung after the steer; 1 the player's: up behind it
/// along its heading, the skiff low in the frame and the sea ahead; look.wrela:196-281); lifted
/// over a crest that runs under it.
pub fn shot(r: Rig, t: f32, framing: f32) -> (vec3, vec3, f32) {
    let h = held(t)
    let (boat, _, _, _) = hull(r, h)
    let behind = turned(BEHIND, r.look)
    let ahead = turned(AHEAD, r.look)
    let low = vec3(r.at.x + behind.x, EYE_UP + boat.y * 0.6, r.at.y + behind.y)
    let rock = normalize(vec3(ahead.x, LOOK_UP - low.y, ahead.y))
    let heading = vec2(sin(YAW + r.look), cos(YAW + r.look))
    let run = smoothstep(2.0, 10.0, r.rush)
    let surge = clamp(r.speed - r.rush, -1.0, 3.0)
    let back = PLAY_BACK - 0.3 * run + max(surge, 0.0) * 0.35 + min(surge, 0.0) * 0.15
    let beside = vec2(heading.y, -heading.x) * (PLAY_SIDE * r.perch)
    let high = vec3(
        r.at.x - heading.x * back + beside.x,
        PLAY_UP - 0.35 * run + boat.y * 0.5,
        r.at.y - heading.y * back + beside.y,
    )
    let ahead_of = vec3(
        r.at.x + heading.x * 24.0 + beside.x * 0.4,
        0.9,
        r.at.y + heading.y * 24.0 + beside.y * 0.4,
    )
    let k = smoothstep(0.0, 1.0, clamp(framing, 0.0, 1.0))
    let stand = mix(low, high, vec3(k))
    let way = normalize(mix(rock, normalize(ahead_of - high), vec3(k)))
    let focal = mix(FOCAL, PLAY_FOCAL - 0.06 * run - 0.03 * max(surge, 0.0), k)
    let floor = height_at(RIDING, RIDING.moment(h), stand.xz) + CLEAR
    let at = stand + vec3(0.0, soft_max(stand.y, floor, SOFT) - stand.y, 0.0)
    (at, at + way * 1000.0, focal)
}

/// The eye of `shot` on a `width` × `height` screen.
pub fn eye_of(r: Rig, t: f32, framing: f32, width: u32, height: u32) -> Eye {
    let (at, to, focal) = shot(r, t, framing)
    as_the_old_saw(eye_at(at, to, 2.0 * atan(1.0 / focal), width: width, height: height))
}

/// `e` as the old opening's screen had it: its right the world's left. The old frame's screen
/// was left-handed (look.wrela:316-322: right = up × forward, so +x on the screen's right looking
/// along +z), the frame's here right-handed (lib/frame's `eye_at`: forward × up); the world is
/// kept as the old placed it, so its pictures are the old's and not their mirror images. Every
/// lister works in the world or on the screen, never across the two, so nothing else changes.
pub fn as_the_old_saw(e: Eye) -> Eye {
    Eye { right: -e.right, ..e }
}
