// What is pure in the opening, held to the old opening's own numbers (rywible/wrela 7ae6711e, run
// with its pinned toolchain 0.33.0: `wrela-notes/next/scratch/opening/old/numbers.txt` and
// `eyes.txt`): the gale's sea as the CPU sums it, the eye's path over the first minute, where the
// stacks stand; and the air.

use air::{AIR, STORM_AIR, aired}
use frame::air::through
use camera::shot
use sail::{IDLE, rest, scripted, step}
use sea::height_at
use ocean::swell::Swell
use sea::{DRAWN, RIDING}
use clusters::{cluster, clusters}

/// The old opening's ridden sea's height (`Swell::new(SEA, 4096, MID_CALM)`'s `height`) and its
/// drawn sea's displacement (`Swell::new(SEA, 2048, 1.0)`'s `shape`), at four places and three
/// times: (x, z, t), then height, then the shape's x, height, z.
const OLD_SEA: [(vec3, f32, vec3); 12] = [
    (vec3(0.0, 0.0, 0.0), -1.684578, vec3(2.3971195, -1.7293484, -0.9522994)),
    (vec3(37.5, -12.25, 0.0), 0.45652452, vec3(0.07036257, 0.5766872, 0.9103806)),
    (vec3(-210.0, 455.0, 0.0), 2.425, vec3(0.033803463, 2.5462706, -0.6597688)),
    (vec3(1000.0, 2000.0, 0.0), -1.6492106, vec3(1.7481211, -1.6466995, -0.51958597)),
    (vec3(0.0, 0.0, 7.25), -0.18503904, vec3(-2.0615218, 0.039697006, -0.5763624)),
    (vec3(37.5, -12.25, 7.25), -2.4375992, vec3(3.5945344, -2.1114907, 1.4940597)),
    (vec3(-210.0, 455.0, 7.25), -2.328225, vec3(-2.1171367, -2.6854453, -1.0300044)),
    (vec3(1000.0, 2000.0, 7.25), 0.4569204, vec3(-1.6649941, 0.66785854, -0.7925378)),
    (vec3(0.0, 0.0, 31.0), 2.5770006, vec3(-1.7242644, 2.1349735, 1.6782267)),
    (vec3(37.5, -12.25, 31.0), -0.7834578, vec3(-8.462719, 0.60327345, -1.0972116)),
    (vec3(-210.0, 455.0, 31.0), 0.2789077, vec3(-1.1385162, 0.3373844, -1.2971717)),
    (vec3(1000.0, 2000.0, 31.0), 2.861761, vec3(-3.7126396, 2.6316745, 2.040693)),
]

/// The gale's sea is the old opening's: its ridden height and its drawn displacement within a
/// millimetre of the old's at every place and time.
@test
fn the_gale_sea_is_the_old_ones() {
    var worst = 0.0
    for o in OLD_SEA {
        let p = o.0.xy
        let t = o.0.z
        let h = height_at(RIDING, RIDING.moment(t), p)
        let s = DRAWN.shape(p, t)
        worst = max(worst, max(abs(h - o.1), length(s - o.2)))
    }
    assert(worst < 0.001, f"the sea is {worst} m from the old's")
}

/// The old shot's eye over the first minute (`look::shot_at`, VIEW 0, the rig at rest stepped
/// each sixtieth from 0): (t, the skiff's x, z), the eye.
const OLD_EYES: [(vec3, vec3); 13] = [
    (vec3(0.0, 0.0, 0.0), vec3(-3.0, 0.7795404, -21.0)),
    (vec3(5.0, 0.15176792, -0.67868835), vec3(-2.848232, 2.3019235, -21.678688)),
    (vec3(10.0, 0.0852919, -0.38141534), vec3(-2.9147081, 0.731509, -21.381414)),
    (vec3(15.0, 0.25790808, -1.1533352), vec3(-2.742092, 2.1549582, -22.153336)),
    (vec3(20.0, 0.38402277, -1.7173085), vec3(-2.6159773, 1.7070879, -22.717308)),
    (vec3(25.0, 0.57369596, -2.565517), vec3(-2.426304, 1.5467863, -23.565517)),
    (vec3(30.0, 0.7632463, -3.4131732), vec3(-2.2367537, 2.0933256, -24.413174)),
    (vec3(35.0, 0.8353058, -3.7354267), vec3(-2.1646943, -0.64677036, -24.735426)),
    (vec3(40.0, 0.9206102, -4.116903), vec3(-2.0793898, 2.9355664, -25.116903)),
    (vec3(45.0, 1.1432241, -5.112417), vec3(-1.8567759, 1.8247143, -26.112417)),
    (vec3(50.0, 1.2091961, -5.407435), vec3(-1.7908039, 1.2601652, -26.407434)),
    (vec3(55.0, 1.0439302, -4.668393), vec3(-1.9560698, 2.839517, -25.668392)),
    (vec3(60.0, 1.4898809, -6.662656), vec3(-1.5101191, 1.6513977, -27.662655)),
]

/// The eye stands where the old shot's stood every five seconds of the first minute, the skiff
/// adrift as the old's was: within a centimetre, its way within a thousandth.
@test
@fuel(2 ** 42)
fn the_eye_is_the_old_shots() {
    var s = rest(0.0)
    var k = 0
    var worst = 0.0
    var skiff = 0.0
    for f in 0..3601 {
        let t = f32(f) / 60.0
        s = step(s, IDLE, t)
        if f % 300 == 0 {
            let (at, to, _) = shot(s, t, 0.0)
            let o = OLD_EYES[k]
            worst = max(worst, length(at - o.1))
            skiff = max(skiff, length(s.at - o.0.yz))
            let way = normalize(to - at)
            assert(abs(way.y - 0.11331) < 0.001, f"the eye looks {way.y} up at {t} s")
            k += 1
        }
    }
    assert(worst < 0.01 && skiff < 0.01, f"the eye is {worst} m and the skiff {skiff} m off the old's")
}

/// Over the minute the eye never goes under the water under it, and the skiff stays within a few
/// metres of where it started.
@test
@fuel(2 ** 42)
fn the_eye_rides_over_the_sea() {
    var s = rest(0.0)
    var least = 1.0e9
    var wandered = 0.0
    for f in 0..3601 {
        let t = f32(f) / 60.0
        s = step(s, IDLE, t)
        if f % 30 == 0 {
            let (at, _, _) = shot(s, t, 0.0)
            least = min(least, at.y - height_at(RIDING, RIDING.moment(t), at.xz))
            wandered = max(wandered, length(s.at))
        }
    }
    assert(least > 0.3, f"the eye comes within {least} m of the water")
    assert(wandered < 10.0, f"the skiff wandered {wandered} m")
}

/// The stacks stand where the old opening put them: 107 clusters (the old's own placement run
/// in single precision, `wrela-notes/next/scratch/opening/scripts/clusters.py`), the one placed
/// by hand, and the nearest of the cells' in view at its place and height.
@test
fn the_stacks_are_the_old_clusters() {
    let all = clusters()
    assert(all.len() == 107, f"{all.len()} clusters")
    let placed = cluster(vec2(0.0, 1.0))
    assert(placed == vec4(70.0, 230.0, 46.0, 41.0), "the stack placed by hand moved")
    var found = false
    for c in all {
        if length(c.xy - vec2(98.8, 413.8)) < 0.1 {
            found = abs(c.z - 38.2) < 0.1
        }
    }
    assert(found, "the stack at (98.8, 413.8), 38.2 m tall, is gone")
}

/// The storm's haze, as fitted to the old opening's pictures by the tone judge (docs/opening.md):
/// a stack 300 m off keeps nine tenths of itself, one 2 km off under three fifths, the horizon is
/// all air, and it is thinner up toward the deck than along the sea.
@test
fn the_storm_air_hides_the_far_stacks() {
    let eye = vec3(-3.0, 2.5, -21.0)
    let near = through(STORM_AIR, eye, vec3(0.0, 0.0, 300.0))
    let far = through(STORM_AIR, eye, vec3(0.0, 0.0, 2000.0))
    assert(near > 0.85 && near < 0.93, f"through 300 m {near}")
    assert(far < 0.6, f"through 2 km {far}")
    let up = through(STORM_AIR, eye, vec3(0.0, 2000.0, 2000.0))
    assert(up > far, "the air is as thick up toward the deck as along the sea")
    let horizon = aired(vec3(0.0), eye, vec3(0.0, 0.0, 200000.0))
    assert(length(horizon - AIR) < 1.0e-3, "the horizon isn't the air's own colour")
}

/// The scripted run sails: sheeted in it gathers way and planes (over 6 m/s on its broad reach),
/// turns to port and back, never comes within the keep-off of a stack's foot, and goes the same
/// way to the bit when run again (the rules read no clock).
@test
@fuel(2 ** 42)
fn the_scripted_helm_sails_the_same_way_twice() {
    var a = rest(0.0)
    var b = rest(0.0)
    var fastest = 0.0
    var turned = 0.0
    for f in 0..3601 {
        let t = f32(f) / 60.0
        a = step(a, scripted(t), t)
        b = step(b, scripted(t), t)
        fastest = max(fastest, a.speed)
        turned = min(turned, a.steer)
    }
    assert(fastest > 6.0, f"its best speed was {fastest} m/s")
    assert(turned < -0.5, f"it turned to port at most {turned} rad")
    assert(length(a.at) > 150.0, f"it sailed {length(a.at)} m")
    assert(a.at.x == b.at.x && a.at.y == b.at.y && a.speed == b.speed && a.heel == b.heel, "two runs differ")
}
