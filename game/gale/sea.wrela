// The gale's sea: the old opening's sea state (rywible/wrela 7ae6711e, scenes/opening/sea.wrela:
// 19-31), an open ocean to the horizon with no shore under it, as lib/sea's waters. A chart
// (docs/design.md, "Forms"): from a place on the level where the water rests (x, z), to where
// that water is now; drawn from lib/sea's tiles by lib/heights' sea lister.
//
// The sea: a gale of 19 m/s (Beaufort 8: moderately high waves, their crests breaking into
// spindrift, foam blown in streaks) blowing across 300 km, over a heavy swell from the storm, 5.5
// m every 10.5 s, running the way the eye looks; its crests leaning and sharpening at a chop of
// 2.5. By lib/sea's formulas (the shore map's §1.2): the wind's sea peaks at about 11 s and 5.3 m,
// both about 7.7 m; 8.8% of its face white with breaking crests (Monahan's).
//
// Its look has no history (docs/opening.md, "What stage 2 needs"): the old foam was a texture
// kept from frame to frame, a crest's foam carried down the wind and fading over half a minute
// (engine/ocean.wrela:486-530, and lib/sea's tiles still keep it), and its whitecaps were read
// from that history four times a pixel (scenes/opening/paint.wrela:1224-1437). Here the white is
// where a crest breaks now (the water folding over, as the tiles' `settle` finds it, from the
// long bands' squeeze at each vertex) and where a crest stands high, its froth a grain of noise
// laid where the water rests so it rides with it, and a gust's patch (the old opening's wind
// cells, scenes/opening/wind.wrela:41-55) darkening the water and whitening its crests. No
// streak carried from a crest down the wind, no foam lingering where a crest broke: those are
// state.

use form::kinds::Chart
use form::look::Skin
use noise::{noise, noise_wrapped}
use ocean::spectrum::{SeaState, band, breaking, slope_variance}
use ocean::swell::{Moment, Shape, Swell, loudest}
use ocean::waters::{PATTERN_SIDE, UNSTEPPED, Waters, Wet}
use std::derive::Box2

/// The opening's sea state (sea.wrela:22-31).
pub const SEA = SeaState {
    wind: vec2(-0.96858, 0.24869),
    speed: 19.0,
    fetch: 300000.0,
    swell: vec2(0.17007, 0.98543),
    swell_height: 5.5,
    swell_period: 10.5,
    chop: 2.5,
    seed: 7,
}

/// How many of the long waves the CPU sums where the skiff rides (sea.wrela:36: in the gale the
/// 4096 loudest hold 98% of the two long tiles' height variance), and how much of the waves a
/// boat rides it rides (`MID_CALM`, sea.wrela:117: the hull too heavy to follow every one).
pub const RIDDEN: u32 = 4096
pub const MID_CALM: f32 = 0.6

/// The long waves the skiff rides and the eye is lifted over (scenes/opening/played.wrela:210,
/// `Ocean::new(SEA, RIDDEN, MID_CALM)`'s swell): what `camera` reads.
pub const RIDING: Swell<RIDDEN> = loudest(SEA, MID_CALM)


/// The places the chart covers (x, z): the sea to the horizon every way. A level sea's horizon
/// is as far as it goes: 200 km out its edge is within a twentieth of a pixel of the horizon's
/// line (docs/heights.md, "Rings").
pub const PLACES = Box2 { lo: vec2(-200000.0, -200000.0), hi: vec2(200000.0, 200000.0) }

/// The sea at time `t` (s).
pub struct GaleSea: Copy + GpuData {
    pub t: f32,
}

/// How far under 1 the water's squeeze must go for a crest to break (lib/sea's `breaking`, its
/// deviations the mid band's, as the GPU's tiles break), and over how much it whitens; worked out
/// when the game is built (a sum over 6,561 waves).
fn breaks() -> vec2 {
    let spread = SEA.chop * sqrt(slope_variance(SEA, band(1)))
    vec2(1.0 - (breaking(SEA) + 0.6) * spread, 0.45 * spread)
}

pub const BREAKS: vec2 = breaks()

/// How much more squeezed than the tiles' own rule the long bands' water may stay and still show
/// white: the vertices hold the long bands only as finely as they are apart, and their squeeze is
/// a mean over that (a crest's own fold is sharper than the rings hold it).
pub const LENIENT: f32 = 0.3

/// The water's own colour looking down into it (linear), deep everywhere: the old opening's
/// `water_up` (paint.wrela:1145), its sand never seen, turned bluer: the old's sea read slate-blue
/// beside it, its body lit by a storm sun a tenth as bright and its mirror of the slate deck the
/// most of what showed (fitted by the tone judge, docs/opening.md).
pub const WATER = vec3(0.088, 0.22, 0.19)

/// How much of the short bands' slopes a wave's face shows (the old's fine waves were read
/// through three times the footprint, and its face was smoother than the bands' full slopes).
pub const SHORT: f32 = 0.8

/// How bright the body is lit, of `WATER`: the old's body was `WATER` times the sky's light
/// from above times π (`sky_up`, paint.wrela:1145-1147); the storm's style lights an upturned
/// face with about 1.4 of that light (`light::SKY_LIGHT` and its lift), so π over 1.4.
pub const BODY: f32 = 2.24

/// Foam's colour (linear): the old's froth white, a little grey; and the light the whole overcast
/// gives it besides the storm's style (lit from above at the deck's grey, a white froth reads mid
/// grey; the old's foam took the low sky's light too, paint.wrela:1448-1483).
pub const FOAM = vec3(0.80, 0.83, 0.84)
pub const FOAM_LIT = vec3(0.50, 0.53, 0.56)

/// How many times its amount the foam is laid, and more in a gust: the old's 2.1 (paint.wrela:
/// 1322) heaped a fresh cap into one smooth lens of white at 1080p, where the old's foam, read
/// from its history, was rarely whole.
pub const FOAM_GAIN: f32 = 1.0

/// How white the water is (0 to 1), a pixel's footprint
/// there `foot` m, a gust `gust` over it (`gusting`), the water standing `wave` m over the level, the long tiles' own foam there
/// `kept` (their foam's history: a crest's foam carried down the wind and fading, lib/sea's
/// `settle`, as the old opening's was), the foam upwind `trail` (`Wet::trail`), its patterns
/// `pattern` (`gale_pattern`, through the footprint) and the long bands'
/// squeeze at the vertices `squeeze`. The old opening's rule (scenes/opening/paint.wrela:
/// 1224-1340), without its froth's cells: the foam densest on the crests (`on_crest`, 0.22 of it
/// in the troughs, where it is swept on), each break's foam trailing down the wind behind it in
/// streaks (the foam upwind drawn out to here), all of it `FOAM_GAIN` times its amount and more in a gust,
/// then torn into lace; and the streaks a gale blows along the wind (Beaufort 8: "foam blown in
/// well-marked streaks along the direction of the wind"). All laid where the water rests, so they
/// ride with it; each fades to its mean where the footprint is wider than it.
pub fn foam(squeeze: f32, kept: f32, trail: vec4, pattern: vec4, wave: f32, gust: f32, foot: f32) -> f32 {
    let b = BREAKS
    let breaking_now = saturate((b.x + LENIENT - squeeze) / b.y)
    // (Its streaks: long lines down the wind, a few metres apart, where the long pattern crosses
    // one level (a band of it laid a pale film over the water a pixel at 1080p couldn't break up);
    // and the gale's own, faint, thicker in a gust.)
    let wide = pattern.y
    let streaks = smoothstep(0.04, 0.0, abs(wide - 0.62)) * (0.3 + 0.7 * gust) * (0.4 + 0.6 * pattern.x)
    let fresh = max(kept, breaking_now * 0.6)
    // (High on a wave it breaks; in the troughs its foam is thinned and swept on.)
    let crest = smoothstep(-0.5, 1.5, wave) * smoothstep(-2.5, 0.3, wave)
    let on_crest = mix(0.22, 1.7, max(crest, smoothstep(0.4, 0.8, fresh)))
    let upwind = max(max(trail.z, trail.w), max(trail.x, trail.y) * 0.8)
    // (Most of the sea is bare of foam, here and upwind: its froth isn't worked out at all
    // there, paint.wrela:1271-1273. Its noises cost the sea's pixels 0.5 ms at 3840x2160.)
    // (The foam left from breaks a while ago, carried on the water and thinned to nothing whole:
    // lines where its lace crosses its middle, marbled as the water carries and squeezes it,
    // paint.wrela:1316-1350's oldest lace.)
    let level = kept * MARBLE + (pattern.x - 0.5) * 2.5 + (pattern.z - 0.5) * 1.5
    let to_line = abs(fract(level + 0.5) - 0.5)
    let marbled = (1.0 - smoothstep(0.0, 0.08 + fwidth(level) * 1.5, to_line)) * saturate(1.0 - foot * 4.0) *
        saturate(kept * 4.0) * (1.0 - smoothstep(0.15, 0.35, kept)) * MARBLED
    if max(fresh * on_crest, upwind * 0.35) * (FOAM_GAIN + gust) < 0.02 {
        return max(streaks * 0.3, marbled)
    }
    // (Its lace: `pattern`'s x.)
    let lace = pattern.x
    let streak = smoothstep(0.3, 0.8, wide * 0.65 + lace * 0.35)
    let tail = upwind * smoothstep(0.35, 0.75, streak + lace * 0.3) * 0.35 * mix(0.3, 1.0, crest)
    let dense = saturate(max(fresh * on_crest, tail) * (FOAM_GAIN + gust))
    // Eroded against a froth's height as it ages (it fades as e^-age): fresh, a heaped mass with
    // its holes kept open; older, lace; the last of it, streaks (paint.wrela:1316-1350, the
    // froth's bubble cells left out).
    let age = smoothstep(0.05, 0.8, -log(max(dense, 1.0e-3)))
    let web = saturate(1.0 - foot * 2.0)
    let coarse = pattern.z
    // (Where a pixel is too wide for its lace, the froth is torn by the coarser pattern: never a
    // smooth sheet, paint.wrela:1369.)
    let froth = mix(coarse, mix(lace, streak, smoothstep(0.3, 0.8, age)), web)
    let feather = 0.05 + 0.2 * age + 0.2 * (1.0 - web)
    // (The pattern's noise is gentler than the old froth's bubble cells: stretched, so a dense cap
    // keeps its holes and its creases.)
    let heap = saturate((froth - 0.5) * 3.0 + 0.5)
    let eroded = saturate((min(dense * (1.4 + 0.4 * lace), 0.9) - (1.0 - heap)) / feather + dense * dense * 0.1)
    // (Too far for its froth, still broken up by a coarser pattern a pixel there can hold.)
    let far_white = saturate((dense - (1.0 - coarse) * 1.1) / 0.25) * (0.5 + 0.5 * coarse)
    // (Never one smooth white even where it's densest: its domes bright, its creases grey,
    // paint.wrela:1371-1373.)
    let heaped = 0.3 + 0.7 * smoothstep(0.2, 0.9, heap)
    let white = max(
        mix(far_white * mix(1.0, streak, age), eroded * (1.0 - 0.25 * age), web),
        far_white * 0.15 * (1.0 - age),
    ) * heaped * smoothstep(0.04, 0.2, dense + tail + (lace - 0.5) * 0.3)
    saturate(max(max(white, streaks * 0.3), marbled))
}

/// How the old foam's marbling grows with what is left of it (of the tiles' kept foam), and how
/// white its lines are at most.
const MARBLE: f32 = 6.0
const MARBLED: f32 = 0.55

/// The gale's patterns (`Waters::pattern`), at `p` m down the wind and across it: its foam's lace,
/// three octaves drawn out a little down the wind (`x`, paint.wrela:1238-1247); its streaks,
/// long soft bands down the wind a few metres apart (`y`); the coarse pattern that breaks a far
/// whitecap (`z`, :1355-1368); and the churn's grain (`w`). Each octave's cells a whole number
/// over `PATTERN_SIDE`, the old's frequencies taken to the nearest such.
pub fn gale_pattern(p: vec2) -> vec4 {
    let n = |f: vec2, o: vec2| -> f32 {
        let c = round(f * PATTERN_SIDE)
        noise_wrapped(p * (c / PATTERN_SIDE) + o, c)
    }
    let lace = n(vec2(1.0, 2.5), vec2(3.0, 9.0)) * 0.5 + n(vec2(4.0, 9.0), vec2(7.0, 1.0)) * 0.32 +
        n(vec2(13.0, 24.0), vec2(0.0)) * 0.18
    let wide = n(vec2(0.0625, 0.547), vec2(11.0, 4.0))
    let coarse = n(vec2(0.125, 0.406), vec2(5.0, 3.0)) * 0.6 + n(vec2(0.406, 1.094), vec2(1.0, 8.0)) * 0.4
    vec4(lace, wide, coarse, n(vec2(1.7), vec2(4.0, 2.0)))
}

/// How much of a gust is over `xz` at `t` (0 to 1): the old opening's gust cells, broad and puffs,
/// riding down the wind (wind.wrela:41-55, `air_over`, and paint.wrela:985, its patch).
pub fn gusting(xz: vec2, t: f32) -> f32 {
    let at = xz - SEA.wind * (SEA.speed * t)
    let g = noise(at / 85.0) * 0.65 + noise(at / 25.0) * 0.35
    saturate((0.78 + 0.5 * g - 0.78) * 2.0)
}

/// How much of the sky's light a wave's face mirrors under the storm: the old's 0.72 under the
/// deck, times its gusts' mean (1.15 less 0.35 of a gust, about a third), paint.wrela:1221-1223.
pub const MIRRORED: f32 = 0.75

/// Under the storm the sea is slate (paint.wrela:1527-1529, `SLATE`): its colour taken this far
/// toward its own luminance, tinted `SLATE_TINT` and brightened `SLATE_LIFT` times, its blue and
/// green mostly gone grey and only a few values darker than the sky over it.
pub const SLATE: f32 = 0.85
pub const SLATE_TINT = vec3(0.93, 1.07, 1.0)
pub const SLATE_LIFT: f32 = 1.2

/// The bright low sky behind a crest shining through its thin top (paint.wrela:1209-1217, as
/// Atlas's water draws it): the higher the crest stands over the level (`wave` m, `CREST` its
/// full height), the more its face is turned to the eye away from that light (`behind`), the more
/// of it comes through, green-grey; only low across the water (from high over it the eye sees the
/// deep water's own dark).
pub fn through(wave: f32, n: vec3, toward: vec3, behind: vec3) -> vec3 {
    let low = 1.0 - smoothstep(0.12, 0.45, toward.y)
    let high = saturate(wave / CREST * 2.5)
    if low * high <= 0.0 {
        return vec3(0.0)
    }
    let way = normalize(vec3(-toward.x, 0.0, -toward.z) + vec3(1.0e-6, 0.0, 0.0))
    THROUGH * behind * (GLOW * high * low * pow(saturate(0.5 - 0.5 * dot(way, n)), 3.0))
}

/// The light through a crest: its colour (of the sky's light behind it), how much of it at a
/// crest's full height, and that height (m) (paint.wrela:860-863, 1213).
const THROUGH = vec3(0.05, 0.2, 0.15)
const GLOW: f32 = 1.0
const CREST: f32 = 7.0

impl GaleSea {
    /// The water resting at `r` (x, z) from each long band's water there: both whole (the open
    /// sea's: nothing damps them), the rest place carried for the look.
    pub fn water_of(self, r: vec2, b: Shape, m: Shape) -> Wet {
        let at = b.at + m.at
        let du = b.du + m.du + vec3(1.0, 0.0, 0.0)
        let dv = b.dv + m.dv + vec3(0.0, 0.0, 1.0)
        Wet {
            shape: Shape { at: vec3(r.x, 0.0, r.y) + at, du, dv },
            kept: vec4(at.y, du.x * dv.z - dv.x * du.z, 0.0, 0.0),
            more: vec4(r.x, r.y, 0.0, 0.0),
            foam: UNSTEPPED,
            marks: UNSTEPPED,
            trail: UNSTEPPED,
            pattern: UNSTEPPED,
        }
    }

    /// The water resting at `r`, both bands summed on the CPU from the loudest waves (`now`, from
    /// `swell`): the definition, which the tiles hold every wave of.
    pub fn water<const N: u32>(self, swell: Swell<N>, now: Moment<N>, r: vec2) -> Wet {
        let (big, mid) = swell.parts(now, r)
        self.water_of(r, swell.shaped(big), swell.shaped(mid))
    }
}

/// The waves the chart is defined by on the CPU: the loudest 2048 of both long bands, both whole
/// (what the tiles sum every wave of). For the chart's own definition and the tests.
pub const DRAWN: Swell<2048> = loudest(SEA, 1.0)

/// The most the long bands stand off the level (m, both whole: the drawn waves' bound): how far
/// the rings reach up and down.
pub const REACH: f32 = DRAWN.bend.height.x + DRAWN.bend.height.y

impl Chart for GaleSea {
    fn at(self, uv: vec2) -> vec3 {
        self.water(DRAWN, DRAWN.moment(self.t), uv).shape.at
    }

    fn domain(self) -> Box2 {
        PLACES
    }
}

/// The gale's sea as made of lib/sea's bands: both whole, no shore (nothing bounds the water
/// below), white where it breaks.
impl Waters for GaleSea {
    fn wet(self, rest: vec2, big: Shape, mid: Shape) -> Wet {
        self.water_of(rest, big, mid)
    }

    fn pattern(self, p: vec2) -> vec4 {
        gale_pattern(p)
    }

    fn short(self, w: Wet) -> f32 {
        SHORT
    }

    fn over(self, w: Wet) -> f32 {
        1000.0
    }

    fn skin(self, w: Wet, normal: vec3) -> Skin {
        let foot = length(fwidth(w.more.xy))
        // (Its wake, marked where the skiff passed: churned white torn by the foam's own lace, and
        // a slick darker for the foam in it beaten flat.)
        let churned = w.marks.x * (0.55 + 0.45 * w.pattern.w)
        // (A gust's patch lies darker: its ripples steeper, mirroring more of the dark deck.)
        let gust = gusting(w.more.xy, self.t)
        let white = max(foam(w.kept.y, max(w.foam.x, w.foam.z), w.trail, w.pattern, w.kept.x, gust, foot), churned)
        let body = WATER * (BODY - 0.15 * gust)
        Skin {
            albedo: mix(body, FOAM, vec3(white)),
            line: 1.0,
            metal: 0.0,
            rim: false,
            emits: FOAM_LIT * white,
        }
    }

    /// Its own light and the sky it mirrors by its facets' Fresnel, the mirror darkened under the
    /// storm (`MIRRORED`), the low sky behind a crest through its thin top (`through`), then slate
    /// (`SLATE`).
    fn seen(self, w: Wet, normal: vec3, toward: vec3, lit: vec3, sky: vec4, behind: vec3) -> vec3 {
        let f = sky.w
        let c = lit * (1.0 - f) + sky.xyz * (f * MIRRORED) + through(w.kept.x, normal, toward, behind)
        mix(c, vec3(dot(c, vec3(0.2126, 0.7152, 0.0722))) * SLATE_TINT * SLATE_LIFT, vec3(SLATE))
    }
}

/// The height of the water at the place `p` (x, z) at `now`: the water carried there found back
/// in two steps (engine/ocean.wrela:1067-1074, `height_at`).
pub fn height_at<const N: u32>(w: Swell<N>, now: Moment<N>, p: vec2) -> f32 {
    var q = p
    for _ in 0..2 {
        let (big, mid) = w.parts(now, q)
        let d = w.shaped(big).at + w.shaped(mid).at
        q = p - vec2(d.x, d.z)
    }
    let (big, mid) = w.parts(now, q)
    w.shaped(big).at.y + w.shaped(mid).at.y
}

/// Where the water now at the place `p` (x, z) rests (the chart's place under it), at `now`: found
/// back in two steps, as `height_at` finds it. A mark pressed where a body is goes here: the
/// sea's marks lie on its places, and a gale's crests carry their water metres along.
pub fn rest_under<const N: u32>(w: Swell<N>, now: Moment<N>, p: vec2) -> vec2 {
    var q = p
    for _ in 0..2 {
        let (big, mid) = w.parts(now, q)
        let d = w.shaped(big).at + w.shaped(mid).at
        q = p - vec2(d.x, d.z)
    }
    q
}
