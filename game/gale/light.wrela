// The light under the storm's deck: no sun reaches the sea or anything on it (the old opening's
// cloud shadow read zero under the deck, rywible/wrela b4bf2aae; its sun's light came through the
// deck a tenth, scenes/opening/heavens.wrela:95), so everything is lit by the deck's grey from
// above and the sea's from below. In Kinetic Ink's terms (lib/form's `Style`): its sun and its
// shade both the deck's dim grey, the side toward the sun's bearing a little lighter (the deck is
// brighter there), the tops of forms lifted more than the clear day's (the light comes from
// above); no slate on dark cloth (there is none, and on a form the air has darkened, `faded`,
// it would light what the air hides). Its levels are the old opening's rule for a solid's light
// (`SKY_LIGHT`), not a fit.

use form::ink::{InkStyle, PAINTED_LINES}
use form::shade::{PAINTED, Style}
use frame::light::Shine
use form::shade::NO_LIGHTS
use sky::SUN

/// The storm's style: lit by the sky's own light (the deck's, as the frame's sky gives it, at
/// `SKY_LIGHT` of it, as the old opening lit its solids), as much of it as reaches
/// a face; no sun's beam (the deck lets through at most 1e-12 of it
/// anywhere within 3 km: docs/opening.md, stage C); where no sky reaches, `covered` of it, and
/// the sea under a face throwing back `below` of what falls on it.
pub const STORM = Style {
    sun: vec3(0.0),
    shade: vec3(0.060, 0.070, 0.090),
    sky_base: 0.97,
    sky_lift: 0.11,
    sky_light: SKY_LIGHT,
    covered: COVERED,
    below: BELOW,
    fill: FILL,
    fill_reach: FILL_REACH,
    ground_dark: 1.0,
    cool: vec3(1.0),
    rim_cool: RIM,
    rim_edge: 0.66,
    rim_soft: 0.04,
    ..PAINTED
}

/// The old opening lit a solid under the deck by the deck's light toward its normal lifted up,
/// times π (0.2 + 0.25 n·up), times 0.25 + 0.75 of its occlusion squared (rywible/wrela 7ae6711e,
/// scenes/opening/paint.wrela:591-688, `lit_solid`): a wall 0.63 of that light and a top 1.41.
/// The frame's sky light (`sky_lit`, the sky's irradiance over π) gives a wall about half the
/// sky's light and a top all of it: so 1.3 of it, `sky_base` 0.97 and `sky_lift` 0.11, and where
/// no sky reaches, a quarter.
pub const SKY_LIGHT: f32 = 1.3

pub const COVERED: f32 = 0.25
pub const BELOW: f32 = 0.3

/// The bright sea's light thrown up on what rides it: the old opening lit its skiff and rider
/// "as a character is, never lost in the shade" by the sky low toward the sun times π 0.13 times
/// 2.2 under the overcast (paint.wrela:1689-1710, aboard.wrela:930-946), 0.9 of it on a wall;
/// the style's `fill` is over the share of the ground a face sees, a half on a wall. It reaches
/// what stands within `FILL_REACH` m of the sea's level, fading up it (the old's lit only the
/// skiff; the stacks' feet take a little).
pub const FILL: f32 = 1.8

/// The sky's light round a dark-clad figure's outline, a narrow band with a hard edge, as the old
/// opening drew its rider so his black read against the sea (aboard.wrela:948-971: 1 - n·v past
/// 0.62 over 0.08, 0.45 of the sky's light): only on what wears a rim (a character's cloth).
pub const RIM: f32 = 0.45
pub const FILL_REACH: f32 = 12.0

/// The frame's light: the storm's style, the sun behind the deck where the old opening had it,
/// the sea's level its ground (nothing darkened toward it: `ground_dark` 1), no live light.
pub fn storm_light() -> Shine {
    Shine { style: STORM, sun: SUN, ground: 0.0, lights: NO_LIGHTS }
}

/// The storm's ink: none. The old opening drew no line on its world (its `LOOK` 3): its stacks
/// dark masses in the haze, its skiff a shape against the sea. Its finish is the old's clean
/// look under the storm (rywible/wrela 7ae6711e, scenes/opening/ink.wrela:16-33, 670-690,
/// 759-766, its `storm` 1 and `LIFT` 1.8): the filmic curve, the shade toward a cool teal and the
/// light toward gold, a little more colour, the middle tones pulled apart, then drained half
/// toward a cold slate and the darks pressed.
pub const STORM_INK = InkStyle {
    exposure: EXPOSURE,
    film: 1.0,
    film_hue: 0.35,
    saturation: 1.18,
    shade_tint: vec3(0.86, 0.96, 1.1),
    split_low: 0.12,
    light_tint: vec3(1.07, 1.0, 0.88),
    split_high: 0.8,
    slate: vec3(0.93, 0.98, 1.05),
    drain: DRAIN,
    contrast: 0.4,
    press: 0.92,
    press_to: 0.6,
    glow: GLOW,
    glow_knee: 0.48,
    ..PAINTED_LINES
}

pub const EXPOSURE: f32 = 1.0
pub const DRAIN: f32 = 0.5

/// How much of the sky's light past the knee glows round it (0.48, exposed: what the old look showed as
/// 0.8 of white, its glow's knee; ink.wrela:283-305, its 0.32).
pub const GLOW: f32 = 0.32
