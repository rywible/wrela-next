// The storm's sky: a paint (docs/design.md, "Forms": a direction, to a colour), which the frame
// cooks into its table of directions a thirty-second a frame (docs/frame.md, "The sky"), and its
// clouds, the storm's deck, a medium the frame marches into its dome in front of the paint
// (lib/frame's `clouds`). The paint is the storm's own air, which the deck goes into low on the
// horizon where it is tens of kilometres off, and the far islands (`far`) standing in it.
//
// The deck is the old opening's (rywible/wrela 7ae6711e, engine/sky.wrela, driven by
// scenes/opening/heavens.wrela with `overcast` 1, `thin` 0, the veil behind the cathedral): its
// weather (`cook_weather`, :390-471: the deck's masses, its rolls laid along the wind, its base
// lifted 1 km over the layer's, thinned where the veil reaches), held still as the old shipped it
// (`main.wrela:178`, `MOVING_CLOUDS` false); its light fitted to the old opening's pictures
// (docs/opening.md).

use air::{AIR, DECK_AIR}
use far::far_seen
use form::kinds::Paint
use frame::clouds::{CloudLight, Cloudscape, Weather}
use noise::fbm2
use std::hash::StateHash

/// The cloud layer's base and its tallest tops (m), and how far the deck's own base stands over
/// the layer's (engine/sky.wrela:36-40).
pub const BASE: f32 = 1500.0
pub const TOP: f32 = 5500.0
pub const DECK_BASE: f32 = 1000.0

/// The weather map's span (m: what its noises are scaled to, engine/sky.wrela:46).
const SPAN: f32 = 48000.0

/// The way the gale blows (x, z): the deck's rolls lie along it.
pub const WIND = vec2(-0.96858, 0.24869)

/// The veil: the deck thinner over a reach behind the cathedral rock (a segment and its radius,
/// m; heavens.wrela:68).
const VEIL_A = vec2(-1700.0, 7000.0)
const VEIL_B = vec2(-2500.0, 11500.0)
const VEIL: f32 = 3800.0

/// Under the deck: the elevation (a direction's y) under which it goes into the storm's own air,
/// and how much darker that air is there than at the horizon (scenes/opening/look.wrela:27-29,
/// `STORM_LOW`; the horizon's lift, `STORM_HORIZON` 1.6, is the inverse of 0.62 here, the air
/// at the horizon being `AIR`).
pub const STORM_LOW: f32 = 0.075
const LOW_AIR: f32 = 0.8

/// The sun (scenes/opening/look.wrela:12, as the old scene used it: `normalize(SUN)`, :375), a unit
/// vector: behind the deck.
pub const SUN = vec3(0.34506, 0.38906, 0.85415)

// ---- the deck --------------------------------------------------------------------------------

/// The storm's cloud layer: its base and tops, the weather map's span (engine/sky.wrela:36-50), the
/// field's extinction (:85), a storm's deck all over (`GLOOM` 1, scenes/opening/heavens.wrela:92),
/// how far rays look and march through it (:81-82); and the lowest its deck condenses, its base
/// lifted `DECK_BASE` less the 250 m a thick mass hangs and the 16 m a billow drops it
/// (`StormWeather`; engine/sky.wrela:479). (The old march began at the layer's base, 734 m under
/// that, and spent most of a low ray's steps there.) Through a hole the deck closes round, a
/// higher layer 1.15 times the deck's light round it, over `STORM_LOW` (scenes/opening/
/// weather.wrela:207, 320-341).
pub const SCAPE = Cloudscape {
    base: BASE,
    top: TOP,
    span: SPAN,
    extinction: 0.06,
    gloom: 1.0,
    reach: 60000.0,
    through: 30000.0,
    floor: BASE + DECK_BASE - 266.0,
    higher: 1.15,
    closes: STORM_LOW,
    spare0: 0.0,
    spare1: 0.0,
}

/// The storm's weather: `cook_weather` with the opening's `overcast` 1, `thin` 0, no break, no
/// cumulus and no fair weather, the veil behind the cathedral (engine/sky.wrela:390-471,
/// scenes/opening/heavens.wrela:57-75): a deck over the whole sky, thicker and thinner in broad
/// masses, rolls laid along the wind under it, broken a little so nothing is a disc.
pub struct StormWeather: Copy + GpuData {}

impl Weather for StormWeather {
    fn at(self, xz: vec2) -> vec4 {
        let mass = fbm2(xz * (5.0 / SPAN) + vec2(13.0, 71.0), 4)
        let w2 = vec2(dot(xz, WIND) * (3.0 / SPAN), dot(xz, vec2(-WIND.y, WIND.x)) * (22.0 / SPAN))
        let roll = smoothstep(0.35, 0.75, fbm2(w2 + vec2(41.0, 7.0), 4))
        let thick = smoothstep(0.3, 0.72, mass)
        var cover = 0.6 + 0.35 * thick
        var tall = DECK_BASE + 1500.0 + 1800.0 * thick
        let lifted = DECK_BASE + 450.0 * (1.0 - roll) - 250.0 * thick
        // (Thinned in the veil's reach, its edge torn by the deck's own masses.)
        let vb = VEIL_B - VEIL_A
        let va = saturate(dot(xz - VEIL_A, vb) / max(dot(vb, vb), 1.0))
        let r = length(xz - VEIL_A - vb * va) / VEIL
        let k = smoothstep(1.0, 0.25, r + (mass - 0.5) * 0.8)
        cover *= 1.0 - 0.3 * k
        tall = mix(tall, DECK_BASE + 900.0, 0.55 * k)
        let broken = cover * (0.8 + 0.4 * fbm2(xz * (64.0 / SPAN) + vec2(5.0, 3.0), 3))
        let bottom = lifted + min(tall * 0.035, 65.0) * fbm2(xz * (40.0 / SPAN) + vec2(83.0, 19.0), 3)
        vec4(saturate(broken), tall, bottom, 0.85)
    }
}

/// The deck's light: the sun's above the air at the layer, the sky's from above, the light from
/// below, and in front of it the storm's air and its light. The old's (engine/sky.wrela:652-663,
/// 832-879) were its Hillaire tables': carried by an estimate (the sun 5.21 through its hazy air,
/// its open sky, its own air with mie 0.13 a km falling by e every 500 m, lit a quarter of the
/// air's light square to the sun, all by its exposure 2.538) they read flat and dim beside the old's
/// pictures (tone judge 47 of 114; through that air with these colours 4 of 9 in the sky at t 15:
/// docs/opening.md, stage 1's light round). So these are fitted to the old's pictures (76 of 114),
/// seen through the scene's own air.
pub const CLOUD_LIGHT = CloudLight {
    sun: SUN,
    spare0: 0.0,
    sunlit: vec3(36.0, 32.0, 25.0),
    spare1: 0.0,
    above: vec3(0.55, 0.85, 1.4),
    spare2: 0.0,
    below: vec3(0.05, 0.065, 0.09),
    spare3: 0.0,
    haze: AIR * 1.7,
    spare4: 0.0,
    air: DECK_AIR,
}

/// The storm's sky, seen from `eye` (the paint is a function of direction from there: the eye
/// moves metres, the islands are kilometres off): whether the far islands are drawn, and whether
/// they are seen through the air (to time what each costs).
pub struct Storm: Copy + GpuData + StateHash {
    pub eye: vec3,
    pub islands: f32,
    pub aired: f32,
    pub spare: vec3,
}

/// The storm's sky from `eye`.
pub fn storm(eye: vec3) -> Storm {
    Storm { eye, islands: 1.0, aired: 1.0, spare: vec3(0.0) }
}

/// The storm's air along `d`: `AIR` at the horizon, a little darker up to `STORM_LOW`, and under
/// the horizon the horizon's (what a mirror reads there).
pub fn low_air(d: vec3) -> vec3 {
    AIR * mix(1.0, LOW_AIR, smoothstep(0.0, STORM_LOW, max(d.y, 0.0)))
}

impl Paint for Storm {
    /// Along `d` itself (its finest).
    fn colour(self, d: vec3) -> vec4 {
        self.seen(d, 0.0)
    }

    /// The storm's air, and behind the deck a little darker (the old's open sky behind the deck,
    /// `STORM_BEHIND`, was a fifth of the open sky's grey: the air's here); the far islands
    /// standing in it.
    fn seen(self, d: vec3, foot: f32) -> vec4 {
        let air = low_air(d)
        var c = mix(air, air * LOW_AIR, vec3(smoothstep(STORM_LOW * 0.35, STORM_LOW, d.y)))
        if self.islands > 0.5 {
            let (met, island) = far_seen(self.eye, d, self.aired > 0.5)
            if met {
                c = island
            }
        }
        vec4(c, 1.0)
    }

    /// The deck, lost low on the horizon in the storm's air (`into_the_air`,
    /// scenes/opening/paint.wrela:167-185), and behind the far islands.
    fn veiled(self, d: vec3) -> f32 {
        if self.islands > 0.5 {
            let (met, _) = far_seen(self.eye, d, false)
            if met {
                return 0.0
            }
        }
        smoothstep(STORM_LOW * 0.35, STORM_LOW, d.y)
    }
}
