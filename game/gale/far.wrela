// The far islands: the archipelago's other islands, 5.5 to 8.5 km off. That far an island is all
// outline, its light side and its dark, and its air, so each is drawn as the old opening drew it
// (rywible/wrela 7ae6711e, scenes/opening/far.wrela): an outline across the line of sight, stood
// at its place on the chart, sunk by the earth's curve, its faces turned as the outline's slopes
// turn them; lit by the scene's one light (`light::STORM`) and seen through its one air.
//
// Drawn in the sky's paint (`sky::Storm`), so in the frame's table of directions: none of them is
// in the opening's own view (the camera looks 5.6 degrees west of north, 25.7 either side; the
// islands bear 43, -72 and 89 degrees), so in the opening they cost the table's texels and
// nothing more; and the eye moves metres, which moves nothing kilometres off. Seen through the
// table they are as fine as its texels: a texel is 0.0061 rad round the horizon, 26 pixels of the
// opening's long lens at 3840x2160, 13 of a player's camera at 1.03 rad (docs/opening.md, "Far
// islands"): fine enough for nothing that is in view. A view that looks at them wants them solids.
//
// The old chart has four; its loop ran to three (`CHARTED`, far.wrela:33, 96), so the arch was
// never drawn, and it isn't here.

use air::aired
use form::look::Skin
use form::shade::lit
use light::STORM
use noise::noise
use sky::SUN

/// The earth's radius (m): what the curve sinks the far islands by.
const EARTH: f32 = 6.371e6

const MESA: u32 = 0
const NEEDLE: u32 = 1
const RING: u32 = 2

/// One island as the horizon shows it: where it stands (x, z), its kind, its half-width across
/// and its height (m), its seed.
pub struct Far: Copy {
    pub at: vec2,
    pub kind: u32,
    pub half: f32,
    pub tall: f32,
    pub seed: f32,
}

/// A place on the chart at bearing `b` (rad, from +z toward +x) and `km` out from the skiff's
/// start.
fn placed(b: f32, km: f32) -> vec2 {
    vec2(sin(b), cos(b)) * km * 1000.0
}

/// How many islands are drawn.
pub const CHARTED: u32 = 3

/// Island `i` (far.wrela:37-51).
pub fn charted(i: u32) -> Far {
    if i == 0 {
        // The Still Ring: a low wall of black cliffs round a lagoon, its mouth a notch.
        Far { at: placed(b: 0.75, km: 6.0), kind: RING, half: 520.0, tall: 62.0, seed: 1.3 }
    } else if i == 1 {
        // A long table of an island, its cliffs a wall along the horizon.
        Far { at: placed(b: -1.25, km: 8.5), kind: MESA, half: 1500.0, tall: 110.0, seed: 7.7 }
    } else {
        // A leaning needle, taller than anything near it.
        Far { at: placed(b: 1.55, km: 5.5), kind: NEEDLE, half: 70.0, tall: 280.0, seed: 5.5 }
    }
}

/// How far a point `u` m across and `y` m up is outside island `f`'s outline (m; under 0 inside)
/// (far.wrela:55-83).
pub fn outline(f: Far, u: f32, y: f32) -> f32 {
    let w = f.half
    let h = f.tall
    let s = f.seed
    if f.kind == MESA || f.kind == RING {
        let rise = noise(vec2(u / w * 2.5 + s, 0.5))
        let top = h *
            (0.7 + 0.3 * (floor(rise * 4.0) + smoothstep(0.8, 1.0, fract(rise * 4.0))) / 4.0)
        let side = w * (1.0 - 0.3 * y / h) + w * 0.03 * (noise(vec2(y / 18.0 + s, 3.0)) - 0.5)
        let talus = max(abs(u) - side - w * 0.15 * max(1.0 - y / (h * 0.5), 0.0), y - h * 0.5)
        var body = min(max(abs(u) - side, y - top), talus)
        if f.kind == RING {
            body = max(body, -(abs(u - w * 0.15) - w * 0.09))
        }
        return body
    }
    let v = u - y * 0.18
    let half = w * pow(max(1.0 - y / h, 0.0), 0.7) + w * 0.12 * (noise(vec2(y / 12.0 + s, 1.0)) - 0.5)
    max(abs(v) - max(half, 0.0), max(y - h, -y - 5.0))
}

/// The far islands along `d` from `eye`: whether one is met, and its colour there, lit and seen
/// through the air (far.wrela:88-124, its albedo scenes/opening/yonder.wrela:530).
pub fn far_seen(eye: vec3, d: vec3, air: bool) -> (bool, vec3) {
    let hl = length(vec2(d.x, d.z))
    // (Nothing far off stands high over the horizon: a ray climbing past 8 degrees misses it all.)
    if hl < 1.0e-4 || d.y / hl > 0.14 {
        return (false, vec3(0.0))
    }
    let dh = vec2(d.x, d.z) / hl
    var best = 1.0e9
    var colour = vec3(0.0)
    var met = false
    for i in 0..CHARTED {
        let f = charted(i)
        let v = f.at - eye.xz
        let along = dot(v, dh)
        let reach = f.half * 1.7 + 20.0
        let u = -(dh.x * v.y - dh.y * v.x)
        if along > reach && along / hl < best && abs(u) < reach {
            let y = eye.y + d.y / hl * along + along * along / (2.0 * EARTH)
            if outline(f, u, y) < 0.0 {
                // Its faces as its outline turns them, toward the eye, read 8 m wide (finer is
                // its stone, not its form).
                let e = 8.0
                let g = normalize(
                    vec2(
                        outline(f, u + e, y) - outline(f, u - e, y),
                        outline(f, u, y + e) - outline(f, u, y - e),
                    ) +
                        vec2(1.0e-5, 0.0),
                )
                let side = vec3(-dh.y, 0.0, dh.x)
                let toward = -vec3(dh.x, 0.0, dh.y)
                let n = normalize(side * g.x * 0.9 + vec3(0.0, 1.0, 0.0) * g.y * 0.9 + toward * 0.7)
                best = along / hl
                let p = eye + d * best
                let albedo = vec3(0.07, 0.072, 0.08) * (0.85 + 0.3 * noise(vec2(p.x + p.z, p.y) * 0.02))
                let skin = Skin { albedo, line: 1.0, metal: 0.0, rim: false }
                let shade = lit(STORM, skin, n, SUN, -d, reach: 1.0, sky: 1.0, height: 1000.0)
                colour = if air { aired(shade, eye, p) } else { shade }
                met = true
            }
        }
    }
    (met, colour)
}
