// How each fighter is dressed. Both are Hakuro's body: Hakuro in his own black, and the
// swordsman, whom the rules have always had and who never had a body of his own, as the lab's
// double: his black cloth turned vermilion, the vermilion of a seal on an ink painting, a mid
// value that reads against the page and against Hakuro; his mask, hair, skin and gold his own, so
// a black fist lands on a white mask. From rywible/wrela's content/humanoid/fighter.wrela at
// 7ae6711e (`VERMILION`, `worn`). Nothing here draws: a look reads `worn` for a cloth's colour.

/// A fighter's clothes: Hakuro's own, or the swordsman's vermilion.
pub struct Dress: Copy + Eq {
    pub vermilion: bool,
}

/// Hakuro's own, and the swordsman's.
pub const HIS_OWN: Dress = Dress { vermilion: false }
pub const SWORDSMAN: Dress = Dress { vermilion: true }

/// The swordsman's cloth where Hakuro's is black (linear).
pub const VERMILION: vec3 = vec3(0.80, 0.22, 0.13)

/// How a fighter is dressed: the swordsman (the rules' foe) in vermilion, a player in his own.
pub fn dress_of(foe: bool) -> Dress {
    if foe { SWORDSMAN } else { HIS_OWN }
}

/// The colour a cloth of colour `albedo` (linear) and metalness `metal` is worn in, dressed as
/// `d`: his own; or, dressed in vermilion, his black cloth vermilion, its own steps of black kept
/// as steps of the red (his belt and boots deeper), his metal and anything whose colours are its
/// own (`own`: his head, his skin) as they are.
pub fn worn(albedo: vec3, metal: f32, own: bool, d: Dress) -> vec3 {
    if !d.vermilion || own || metal > 0.1 {
        return albedo
    }
    let v = dot(albedo, vec3(0.3, 0.55, 0.15))
    mix(VERMILION * (0.45 + 6.0 * v), albedo, vec3(smoothstep(0.12 - 0.04, 0.12 + 0.04, v)))
}

@test
fn the_swordsmans_black_is_vermilion_and_his_gold_and_skin_his_own() {
    // His coat's near-black, his gold (metal), and his skin (light enough to be its own).
    let black = vec3(0.050, 0.050, 0.066)
    let (gold, skin) = (vec3(0.690, 0.380, 0.016), vec3(0.500, 0.250, 0.130))
    assert(worn(black, 0.0, own: false, d: HIS_OWN) == black, "Hakuro wears his own")
    let red = worn(black, 0.0, own: false, d: SWORDSMAN)
    assert(red.x > 3.0 * red.y && red.x > 0.3, f"the swordsman's black is red: {red}")
    assert(worn(gold, 1.0, own: false, d: SWORDSMAN) == gold, "his gold his own")
    assert(worn(skin, 0.0, own: false, d: SWORDSMAN) == skin, "his skin his own")
}
