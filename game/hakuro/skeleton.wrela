// Hakuro's skeleton at rest (a T-pose, +x his left, m): his bones' joints, as measured off the
// Quaternius body he was designed on (CC0), and each bone's parent. A pose is a palette of 64
// matrices indexed by these bones, each carrying a point of him at rest to where the pose puts
// it. From rywible/wrela's content/hakuro/hakuro.wrela (`skeleton`) at 7ae6711e.

/// How many bones he has.
pub const BONES: u32 = 57

/// How many matrices a palette holds: his bones, and room.
pub const PALETTE: u32 = 64

/// His bones by number. A pair's left is even and its right odd from 6 to 55; a right bone's
/// joint is its left's mirrored in x = 0.
pub const PELVIS: u32 = 0
pub const SPINE_1: u32 = 1
pub const SPINE_2: u32 = 2
/// His chest: what carries his collarbones, his neck, his collar and his coat's shoulders.
pub const SPINE_3: u32 = 3
pub const NECK: u32 = 4
pub const HEAD: u32 = 5
pub const COLLARBONE_LEFT: u32 = 6
pub const COLLARBONE_RIGHT: u32 = 7
pub const UPPER_ARM_LEFT: u32 = 8
pub const UPPER_ARM_RIGHT: u32 = 9
pub const FOREARM_LEFT: u32 = 10
pub const FOREARM_RIGHT: u32 = 11
pub const HAND_LEFT: u32 = 12
pub const HAND_RIGHT: u32 = 13
/// The reference rig's single finger and thumb bones: no part is charted on them.
pub const FINGERS_LEFT: u32 = 14
pub const FINGERS_RIGHT: u32 = 15
pub const THUMB_LEFT: u32 = 16
pub const THUMB_RIGHT: u32 = 17
pub const THIGH_LEFT: u32 = 18
pub const THIGH_RIGHT: u32 = 19
pub const CALF_LEFT: u32 = 20
pub const CALF_RIGHT: u32 = 21
pub const FOOT_LEFT: u32 = 22
pub const FOOT_RIGHT: u32 = 23
pub const BALL_LEFT: u32 = 24
pub const BALL_RIGHT: u32 = 25

/// The first of his fingers' joints' bones: finger `f` (`FINGER_JOINTS`' order), its joint `k`
/// (0 to 2), on `side` (0 his left) is bone `FINGER_BONES + 6 f + 2 k + side`.
pub const FINGER_BONES: u32 = 26

/// His hair's bone (the last): his head's, turned about his skull as his hair sways.
pub const HAIR_BONE: u32 = 56

