// Hakuro's fields: what he wears and carries that is a solid, not a chart (`form::kinds::Solid`
// is `std::field::Surface`). Each is written in the space of the bone that carries it: from
// that bone's joint at rest (`skeleton::REST`), as he is at rest. `WORN` says which bone carries
// each and how each is joined to the one before it. From rywible/wrela's
// content/hakuro/hakuro.wrela and content/humanoid/stick.wrela at 7ae6711e, whose `hero()`,
// `head()`, `coat()` and `stick_creature()` joined them on his skeleton.

use shapes::{HEAD_JOINT, HEAD_SCALE, boot_foot, boot_shaft, fox, hair, unscaled}
use skeleton::{
    BALL_LEFT, BALL_RIGHT, CALF_LEFT, CALF_RIGHT, FOOT_LEFT, FOOT_RIGHT, HAIR_BONE, HEAD, REST,
    SPINE_1,
}
use std::derive::{Box3, Interval}
use form::kinds::Solid
use std::field::{Bound, Surface}

/// One of his fields on his skeleton: its name; the bone that carries it (`bone`); for a field
/// written for his left (x of 0 or more) and drawn on both sides, the bone that carries its
/// mirror image in x = 0 (`image`; `NO_IMAGE` for one drawn once); and how it is joined to what
/// is before it: the field it joins (`joins`, its place in `WORN`; its own for the first of a
/// group made together) by a hard union (`smooth` 0) or a smooth one `smooth` wide (m).
pub struct Worn: Copy {
    pub name: Text,
    pub bone: u32,
    pub image: u32,
    pub joins: u32,
    pub smooth: f32,
}

/// No mirror image.
pub const NO_IMAGE: u32 = 4294967295

/// Each field, in the order rywible/wrela joined them: his belt and his boots (`hero()`, a hard
/// union but for the shaft, smooth onto the boot's foot over 4 mm; each boot's toe on the ball's
/// bone, smooth onto its foot over 6 mm, so it bends with his toes), his hair and his mask
/// (`head()`, the mask hard onto the hair). His coat's tails, a field there too (`coat()`), are a
/// sheet chart here, stepped as cloth (`tails`): one way to draw them. The sword he holds is the
/// weapon's, not his (`moves::sword`): the rules give it to whoever fights.
pub const WORN: [Worn; 6] = [
    Worn { name: "belt", bone: SPINE_1, image: NO_IMAGE, joins: 0, smooth: 0.0 },
    Worn { name: "boot", bone: FOOT_LEFT, image: FOOT_RIGHT, joins: 0, smooth: 0.0 },
    Worn { name: "boot toe", bone: BALL_LEFT, image: BALL_RIGHT, joins: 1, smooth: 0.006 },
    Worn { name: "boot shaft", bone: CALF_LEFT, image: CALF_RIGHT, joins: 1, smooth: 0.004 },
    Worn { name: "hair", bone: HAIR_BONE, image: NO_IMAGE, joins: 4, smooth: 0.0 },
    Worn { name: "mask", bone: HEAD, image: NO_IMAGE, joins: 4, smooth: 0.0 },
]

/// His belt, his left boot's foot, its toe and its shaft, as `WORN` places them.
pub const BELT: Belt = Belt { at: REST[SPINE_1] }
pub const BOOT: BootFoot = BootFoot { at: REST[FOOT_LEFT] }
pub const BOOT_TOE: BootToe = BootToe { at: REST[BALL_LEFT] }
pub const BOOT_SHAFT: BootShaft = BootShaft { at: REST[CALF_LEFT] }

/// His belt's height, its half width, and where its buckle's middle is (rest space).
const BELT_AT: f32 = 0.975
const BELT_HALF: f32 = 0.021
const BUCKLE: vec3 = vec3(0.0, 0.975, 0.1225)

/// His belt at `q` (rest space): a leather band 4 cm wide round his trousers' waist, and a
/// buckle on its front, a frame with a prong across it.
fn belt(q: vec3) -> f32 {
    let e = length(vec2(q.x / 0.172, (q.z + 0.006) / 0.124))
    let band = max((e - 1.0) * 0.124, abs(q.y - BELT_AT) - BELT_HALF)
    let c = q - BUCKLE
    let outer = max(max(abs(c.x) - 0.031, abs(c.y) - 0.028), abs(c.z) - 0.0045)
    let hole = max(abs(c.x) - 0.021, abs(c.y) - 0.018)
    let frame = max(outer, -hole)
    let prong = max(max(abs(c.x + 0.004) - 0.0025, abs(c.y) - 0.0275), abs(c.z - 0.002) - 0.003)
    min(band, min(frame, prong))
}

/// His belt as a shape on his spine's first joint (`at`: the joint at rest).
pub struct Belt: Copy + GpuData {
    pub at: vec3,
}

impl Surface for Belt {
    fn bound(self) -> Bound {
        Bound { centre: vec3(0.0, BELT_AT, 0.0) - self.at, radius: 0.22, slope: 0.5 }
    }

    fn interval(self, over: Box3) -> Interval {
        let r = 1.5 * 0.5 * length(over.hi - over.lo)
        let d = self.distance(over.center())
        Interval { lo: d - r, hi: d + r }
    }

    fn distance(self, p: vec3) -> f32 {
        belt(p + self.at)
    }

    fn lipschitz(self, near: f32) -> f32 {
        1.5
    }
}

/// The mask, on the head's bone (the head's joint is the bone's place).
pub struct Mask: Copy + GpuData {}

impl Surface for Mask {
    fn bound(self) -> Bound {
        Bound { centre: vec3(0.0, 0.14, 0.05), radius: 0.31, slope: 0.5 }
    }

    /// By its bound on the gradient from its centre's distance: no derived interval of all
    /// of it, which would be most of a culling pass's shader.
    fn interval(self, over: Box3) -> Interval {
        let r = 1.5 * 0.5 * length(over.hi - over.lo)
        let d = self.distance(over.center())
        Interval { lo: d - r, hi: d + r }
    }

    fn distance(self, p: vec3) -> f32 {
        fox(unscaled(p + HEAD_JOINT)) * HEAD_SCALE
    }

    /// Ellipsoids by their usual bound, cones, a triangle and smooth extrema: about 1, with
    /// room.
    fn lipschitz(self, near: f32) -> f32 {
        1.5
    }
}

/// The hair, on the head's bone.
pub struct Hair: Copy + GpuData {}

impl Surface for Hair {
    fn bound(self) -> Bound {
        Bound { centre: vec3(0.0, 0.19, -0.13), radius: 0.34, slope: 0.5 }
    }

    /// By its bound on the gradient from its centre's distance: no derived interval of all
    /// of it, which would be most of a culling pass's shader.
    fn interval(self, over: Box3) -> Interval {
        let r = 1.5 * 0.5 * length(over.hi - over.lo)
        let d = self.distance(over.center())
        Interval { lo: d - r, hi: d + r }
    }

    fn distance(self, p: vec3) -> f32 {
        let q = unscaled(p + HEAD_JOINT)
        hair(q, shapes::skull(q)) * HEAD_SCALE
    }

    /// Flattened cones (each scaled back by its flattening) and his skull, by smooth extrema,
    /// and his locks' rise and fall on it (as steep as 1 in 1 at a lock's tip).
    fn lipschitz(self, near: f32) -> f32 {
        2.1
    }
}

/// A boot's foot, on the left foot's bone (its image on the right's).
pub struct BootFoot: Copy + GpuData {
    pub at: vec3,
}

impl Surface for BootFoot {
    fn bound(self) -> Bound {
        Bound { centre: vec3(0.006, 0.004, 0.088), radius: 0.21, slope: 0.5 }
    }

    /// By its bound on the gradient from its centre's distance: no derived interval of all
    /// of it, which would be most of a culling pass's shader.
    fn interval(self, over: Box3) -> Interval {
        let r = 1.5 * 0.5 * length(over.hi - over.lo)
        let d = self.distance(over.center())
        Interval { lo: d - r, hi: d + r }
    }

    fn distance(self, p: vec3) -> f32 {
        let q = p + self.at
        max(boot_foot(q), q.z - (TOE_CUT + TOE_LAP))
    }

    fn lipschitz(self, near: f32) -> f32 {
        1.5
    }
}

/// Where a boot is parted into its foot and its toe (rest space, m along z): the ball's joint,
/// which his toes bend about; and how far each part runs on past it under the other, so the two
/// still meet as the toe bends. Rigid on the foot's bone, a boot's toe went up to 10 cm through
/// the floor whenever he was up on his toes (the known fight's first 600 steps).
pub const TOE_CUT: f32 = REST[BALL_LEFT].z
pub const TOE_LAP: f32 = 0.015

/// A boot's toe, on the left ball's bone (its image on the right's): the boot ahead of where his
/// toes bend.
pub struct BootToe: Copy + GpuData {
    pub at: vec3,
}

impl Surface for BootToe {
    fn bound(self) -> Bound {
        Bound { centre: vec3(0.006, 0.075, 0.088) - self.at, radius: 0.16, slope: 0.5 }
    }

    /// By its bound on the gradient from its centre's distance: no derived interval of all
    /// of it, which would be most of a culling pass's shader.
    fn interval(self, over: Box3) -> Interval {
        let r = 1.5 * 0.5 * length(over.hi - over.lo)
        let d = self.distance(over.center())
        Interval { lo: d - r, hi: d + r }
    }

    fn distance(self, p: vec3) -> f32 {
        let q = p + self.at
        max(boot_foot(q), (TOE_CUT - TOE_LAP) - q.z)
    }

    fn lipschitz(self, near: f32) -> f32 {
        1.5
    }
}

/// A boot's shaft, on the left calf's bone.
pub struct BootShaft: Copy + GpuData {
    pub at: vec3,
}

impl Surface for BootShaft {
    fn bound(self) -> Bound {
        Bound { centre: vec3(0.006, -0.342, -0.024), radius: 0.21, slope: 0.5 }
    }

    /// By its bound on the gradient from its centre's distance: no derived interval of all
    /// of it, which would be most of a culling pass's shader.
    fn interval(self, over: Box3) -> Interval {
        let r = 1.5 * 0.5 * length(over.hi - over.lo)
        let d = self.distance(over.center())
        Interval { lo: d - r, hi: d + r }
    }

    fn distance(self, p: vec3) -> f32 {
        boot_shaft(p + self.at)
    }

    fn lipschitz(self, near: f32) -> f32 {
        1.5
    }
}

/// A solid's distance at `p`, through the design's name for what it is.
fn distance_of<S: Solid>(s: S, p: vec3) -> f32 {
    s.distance(p)
}

/// The point of his head in its bone's space (each of `Mask` and `Hair`) that is `q` of the
/// unscaled head's space (`shapes::unscaled`).
fn on_head(q: vec3) -> vec3 {
    (q - HEAD_JOINT) * HEAD_SCALE
}

@test
fn each_field_is_written_from_its_bones_joint_and_is_where_he_is() {
    // Each field is written from the joint at rest of the bone `WORN` puts it on.
    assert(BELT.at == REST[WORN[0].bone] && BOOT.at == REST[WORN[1].bone])
    assert(BOOT_TOE.at == REST[WORN[2].bone] && BOOT_SHAFT.at == REST[WORN[3].bone])
    assert(HEAD_JOINT == REST[WORN[4].bone] && HEAD_JOINT == REST[WORN[5].bone])
    // A field's image is on the image of its bone, and a field joins one before it.
    for k in 0..6 {
        let w = WORN[k]
        assert(w.joins <= k, f"{w.name} joins one after it")
        if w.image != NO_IMAGE {
            let a = REST[w.bone]
            assert(REST[w.image] == vec3(-a.x, a.y, a.z), f"{w.name}'s image")
        }
    }
    // Each is a solid, and solid where he is: his belt at his side, his boot round his toes,
    // its shaft round his shin, his mask at its snout, his hair at the root of a spike.
    assert(distance_of(BELT, vec3(0.17, 0.975, -0.006) - BELT.at) < 0.0)
    assert(distance_of(BOOT, vec3(0.125, 0.05, 0.0) - BOOT.at) < 0.0)
    assert(distance_of(BOOT_TOE, vec3(0.125, 0.04, 0.15) - BOOT_TOE.at) < 0.0)
    assert(distance_of(BOOT_SHAFT, vec3(0.12, 0.2, -0.066) - BOOT_SHAFT.at) < 0.0)
    assert(distance_of(Mask {}, on_head(shapes::TIP - vec3(z: 0.006))) < 0.0)
    assert(distance_of(Hair {}, on_head(vec3(0.0, 1.85, -0.01))) < 0.0)
}

/// At rest a boot's foot and toe together are the boot: on a grid a centimetre square through
/// it, a point is inside one of them exactly where it's inside the boot, and each part ends a lap
/// past where his toes bend.
@test
fn a_boots_foot_and_toe_at_rest_are_the_boot() {
    var inside = 0
    for i in 0..20 {
        for j in 0..25 {
            for k in 0..45 {
                let q = vec3(0.01 * f32(i), 0.01 * f32(j) - 0.01, 0.01 * f32(k) - 0.2)
                let parts = min(BOOT.distance(q - BOOT.at), BOOT_TOE.distance(q - BOOT_TOE.at))
                let whole = shapes::boot_foot(q)
                assert((parts < 0.0) == (whole < 0.0), f"the parts and the boot part at {q}")
                inside += if whole < 0.0 { 1 } else { 0 }
                if q.z > TOE_CUT + TOE_LAP + 0.005 {
                    assert(BOOT.distance(q - BOOT.at) > 0.0, f"the foot runs on to {q}")
                }
                if q.z < TOE_CUT - TOE_LAP - 0.005 {
                    assert(BOOT_TOE.distance(q - BOOT_TOE.at) > 0.0, f"the toe runs back to {q}")
                }
            }
        }
    }
    assert(inside > 500, f"{inside} points in the boot")
}
