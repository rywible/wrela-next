// What each fighter wears on his charted parts and his coat's tails, as a look (`form::look`,
// with what a garment's piece adds: `limbs::worn::Worn`): his cloth's colour by where a place is
// on him at rest, the line field that draws a seam between dark cloth and pale, his gold, the
// relief of a seam's welt or a weave, his coat's lining, and where his coat's pieces are cut.
// Hakuro in his own black; the swordsman in it turned vermilion (`dress::worn`).
//
// From rywible/wrela at 7ae6711e: content/hakuro/hakuro.wrela (`Cloth`, the palette, `chart_paint`
// and the cloth under it, `dressed`, `chart_cut`, `tails_paint`) and content/humanoid/fighter.wrela
// (`worn`, and `painted`'s raised colour, value and line field).

use dress::{Dress, HIS_OWN, SWORDSMAN, worn}
use form::look::{Look, Place, Skin}
use hakuro::{
    CAP_TO, COAT_SEAM, COLLAR, HAND_LEFT, HAND_PIECES, HEAD, JACKET_BODY, SHELF_OUT, YOKE_LEFT,
    YOKE_OUT, YOKE_RIGHT, YOKE_ROUND, collar_top, nape, of_cap, of_hand, of_jacket, opening,
    shows_inside,
}
use chart::chain::wrapped
use limbs::worn::{UNCUT, Worn}
use shapes::{TAILS_AXIS, TAILS_TOP, TAILS_UNDER, front_edge, hem}
use std::collections::Vec
use std::math::TAU

/// What a point of him is made of: its colour as the screen shows it (the palette was chosen on
/// the screen, and is raised to 2.2 to be light, fighter.wrela:765), how metallic, and how far
/// its surface stands off the form there (m: a seam's welt, a rib, a weave's thread).
pub struct Cloth: Copy {
    pub albedo: vec3,
    pub metal: f32,
    pub relief: f32 = 0.0,
}

// The locked palette: near-black, charcoal, gold, the lining, skin, his top, his trousers, his
// head's wrap, his mask's cord, thread, the void behind his mask, leather.
pub const BLACK = Cloth { albedo: vec3(0.050, 0.050, 0.066), metal: 0.0 }
pub const CHARCOAL = Cloth { albedo: vec3(0.070, 0.070, 0.088), metal: 0.0 }
pub const GOLD = Cloth { albedo: vec3(0.690, 0.380, 0.016), metal: 1.0 }
pub const LINING = Cloth { albedo: vec3(0.300, 0.150, 0.022), metal: 0.15 }
pub const SKIN = Cloth { albedo: vec3(0.500, 0.250, 0.130), metal: 0.0 }
/// His top: a fitted black compression knit, smoother than his jacket's cloth.
pub const TOP = Cloth { albedo: vec3(0.034, 0.034, 0.044), metal: 0.0 }
/// His trousers: a charcoal twill, a step lighter than his jacket and his top.
pub const TROUSERS = Cloth { albedo: vec3(0.098, 0.101, 0.118), metal: 0.0 }
/// The black wrap his mask is tied over, round his head above his top's neck.
pub const WRAP = Cloth { albedo: vec3(0.030, 0.030, 0.038), metal: 0.0 }
/// The cord his mask is tied on with: the vermilion of its marks.
pub const CORD: vec3 = vec3(0.57, 0.016, 0.007)
/// The thread his clothes are stitched with.
pub const THREAD: vec3 = vec3(0.19, 0.19, 0.21)
pub const VOID = Cloth { albedo: vec3(0.004, 0.003, 0.004), metal: 0.0 }
pub const LEATHER = Cloth { albedo: vec3(0.030, 0.030, 0.040), metal: 0.0 }

/// Where his cloth's value on the screen parts dark cloth from pale: the line field is the
/// value less this, so the edge between them is a seam (fighter.wrela:800).
pub const SEAM_VALUE: f32 = 0.14

/// How wide the gold along his jacket's front edges and his tails' is (m).
pub const TRIM: f32 = 0.017

/// How wide the gold hem of a sleeve is, along his arm (m).
pub const CAP_HEM: f32 = 0.012

/// Where the wrap round his left forearm ends, at his wrist (his rest space, m along his arm).
pub const WRAP_END: f32 = 0.664

/// How long his arm's path is at rest (m): what a share of it is in metres.
const ARM_LONG: f32 = 0.564

/// His coat's tails among what he wears: after his charted parts.
pub const TAILS: u32 = 27

// ---- what his clothes are made of -------------------------------------------------------------
//
// Each cloth is its colour and its relief at a point of him at rest: its weave, its seams and
// their stitches, its pockets and its ribs. `px` is how much of him a pixel covers there (m):
// a line is drawn a pixel soft, and a pattern finer than two pixels isn't drawn at all (it
// would shimmer).

/// How much of a line `w` wide (m) a point `d` from its middle is in.
fn stripe(d: f32, w: f32, px: f32) -> f32 {
    saturate((0.5 * w - abs(d)) / max(px, 0.0003) + 0.5)
}

/// How much of a pattern that repeats every `period` (m) is drawn: all of it from eight pixels
/// a repeat, none of it at four. (Drawn down to two pixels a repeat, a weave's threads beat
/// against the pixels in rings across his chest.)
fn fine(period: f32, px: f32) -> f32 {
    saturate(0.25 * period / max(px, 0.00001) - 1.0)
}

/// A sewn seam `d` from its line (m), `along` it (m): a welt 11 mm wide with a groove down its
/// middle (`x`: its relief, m) and a row of stitches either side of the groove (`y`: how much of
/// the point is thread).
fn seam(d: f32, along: f32, px: f32) -> vec2 {
    let dash = if fract(along / 0.008) < 0.62 { fine(0.008, px) } else { 0.0 }
    vec2(
        0.0009 * stripe(d, 0.011, px) - 0.0012 * stripe(d, 0.003, px),
        (stripe(d - 0.0045, 0.0013, px) + stripe(d + 0.0045, 0.0013, px)) * dash,
    )
}

/// `base` with a seam's relief and thread on it (`seam`'s answer, or several added).
fn sewn(base: Cloth, on: vec2) -> Cloth {
    Cloth {
        albedo: mix(base.albedo, THREAD, vec3(saturate(on.y) * 0.85)),
        relief: base.relief + on.x,
        ..base,
    }
}

/// How far outside a box `half` wide and high about `at` a point of a flat piece is (m;
/// negative inside).
fn boxed(q: vec2, at: vec2, half: vec2) -> f32 {
    let d = abs(q - at) - half
    max(d.x, d.y)
}

/// His trousers at a point of them at rest (his legs', and his trunk's under his belt):
/// charcoal twill combat trousers. A seam down the outside of each leg; a bellows pocket on each
/// thigh with a flap and a gold snap; a knee's panel between two seams, pleated to bend; the
/// cloth gathered into his boots; a fly and a waistband under his belt.
fn trousers_at(p: vec3, px: f32) -> Cloth {
    // About his leg's line: how far round from its front (0; a quarter turn its outside).
    let za = if p.y > 0.542 { -0.036 } else {
        mix(-0.088, -0.036, saturate((p.y - 0.086) / 0.456))
    }
    let out = abs(p.x) - 0.114
    let fore = p.z - za
    let phi = atan2(out, fore)
    let leg = p.y < 0.86
    // Its weave, and the cloth's own crumple: long soft folds across the leg, more of them where
    // it's gathered into his boot.
    let girth = phi * max(length(vec2(out, fore)), 0.04)
    var relief = 0.00016 * sin(TAU * (girth + p.y) / 0.0028) * fine(0.0028, px)
    relief += 0.0011 * sin(p.y * 70.0 + 2.2 * sin(phi * 2.0 + p.y * 17.0))
    let gathered = 1.0 - smoothstep(0.34, 0.45, p.y)
    relief += 0.0020 * gathered * sin(phi * 15.0 + 3.0 * sin(p.y * 40.0))
    var on = vec2(0.0)
    // Down its outside.
    if out > 0.0 {
        on += seam(fore, p.y, px)
    }
    var cloth = TROUSERS
    if leg {
        // His knee's panel, on the front of his leg.
        let front = smoothstep(-0.03, 0.01, fore)
        on += (seam(p.y - 0.615, girth, px) + seam(p.y - 0.468, girth, px)) * front
        for k in 0..3 {
            relief -= 0.0009 * front * stripe(p.y - (0.578 - 0.037 * f32(k)), 0.004, px)
        }
        // His thigh's pocket, on its outside: the pocket standing off his leg, its flap over its
        // top, a snap on the flap.
        if out > 0.0 {
            let q = vec2(fore, p.y)
            let pocket = boxed(q, vec2(0.0, 0.672), vec2(0.052, 0.078))
            let flap = boxed(q, vec2(0.0, 0.752), vec2(0.056, 0.022))
            relief += 0.0028 * saturate(-pocket / 0.004) + 0.0020 * saturate(-flap / 0.003)
            on.y += stripe(pocket + 0.006, 0.0013, px) *
                fine(0.008, px) *
                (if fract((q.x + q.y) / 0.008) < 0.62 { 1.0 } else { 0.0 })
            // (Under the flap's edge, its shadow.)
            let under = stripe(q.y - 0.727, 0.004, px) * saturate(-pocket / 0.004)
            cloth = Cloth { albedo: cloth.albedo * (1.0 - 0.55 * under), ..cloth }
            if length(q - vec2(0.0, 0.745)) < 0.0065 {
                return Cloth { relief: 0.0045, ..GOLD }
            }
        }
    } else {
        // Under his belt: its waistband, and its fly down his front.
        on += seam(p.y - 0.944, girth, px)
        if p.z > 0.0 {
            on += seam(p.x - 0.014, p.y, px) * smoothstep(0.944, 0.93, p.y)
        }
    }
    sewn(Cloth { relief, ..cloth }, on)
}

/// How far from the line from `a` to `b` a point of a flat piece is (m), and how far along it.
fn along_line(q: vec2, a: vec2, b: vec2) -> vec2 {
    let e = b - a
    let h = clamp(dot(q - a, e) / dot(e, e), 0.0, 1.0)
    vec2(length(q - (a + e * h)), h * length(e))
}

/// A flat-locked seam of his top `d` from its line: a low flat welt, its thread laid across it
/// in a ladder.
fn flatlock(d: f32, along: f32, px: f32) -> vec2 {
    let ladder = 0.5 + 0.5 * sin(TAU * along / 0.0032)
    vec2(0.0005 * stripe(d, 0.007, px), stripe(d, 0.0055, px) * mix(0.45, ladder, fine(0.0032, px)))
}

/// Where his top's neckline is at a point round his neck (rest height): a crew neck, at the root
/// of his neck, lower at his throat than behind.
pub fn neckline(p: vec3) -> f32 {
    1.497 + 0.028 * smoothstep(0.03, -0.06, p.z)
}

/// How wide the band round his top's neck is (m).
const NECKBAND: f32 = 0.013

/// His top at a point of it at rest (his trunk's over his belt, his right arm's): a black
/// compression knit, close as a skin and smoother than his jacket. Flat-locked seams from his
/// neck to under each arm and down each side; round its neck a ribbed band.
fn top_at(p: vec3, px: f32) -> Cloth {
    // Its knit's courses.
    let relief = 0.00010 * sin(TAU * p.y / 0.0018) * fine(0.0018, px)
    var on = vec2(0.0)
    let under = neckline(p) - p.y
    if abs(p.x) < 0.1 && under < NECKBAND {
        // Its neckband: ribs across it, standing a little off his skin, a seam under it.
        let round = atan2(p.x, p.z + 0.03)
        let ribs = fine(0.006, px)
        let across = under / NECKBAND * 2.0 - 1.0
        return Cloth {
            albedo: TOP.albedo * (1.0 + 0.5 * ribs * sin(round * 60.0)),
            relief: 0.0016 * sqrt(max(1.0 - across * across, 0.0)) +
                0.0005 * sin(round * 60.0) * ribs,
            ..TOP,
        }
    }
    if p.x < -0.2 {
        // His right arm's sleeve: one seam, under his arm.
        if p.y < 1.455 {
            on += flatlock(p.z + 0.068, p.x, px)
        }
    } else {
        // From his neck to under each arm, and down each side.
        let q = vec2(abs(p.x), p.y)
        let raglan = along_line(q, vec2(0.052, 1.495), vec2(0.176, 1.335))
        on += flatlock(raglan.x, raglan.y, px)
        if abs(p.x) > 0.09 && p.y < 1.33 {
            on += flatlock(p.z + 0.012, p.y, px)
        }
    }
    Cloth {
        albedo: mix(TOP.albedo, THREAD * 0.6, vec3(saturate(on.y) * 0.8)),
        relief: relief + on.x,
        ..TOP,
    }
}

/// What he wears under his coat at a point of him at rest, and what he doesn't: his trousers to
/// his belt, his top over it to its neckline, and his neck bare above that.
fn worn_under(p: vec3, px: f32) -> Cloth {
    if p.y < 0.97 {
        return trousers_at(p, px)
    }
    // (His neck, between his shoulders: his top's sleeve and shoulders are as high.)
    if abs(p.x) > 0.1 || p.y < neckline(p) {
        return top_at(p, px)
    }
    // (His head's wrap comes down his nape as a hairline does: to 4 cm under the foot of his
    // skull behind, and up to his jaw's corners at his sides.)
    if p.y > nape(p) {
        return Cloth { relief: 0.0012 * stripe(p.y - nape(p) - 0.004, 0.008, px), ..WRAP }
    }
    // His neck's skin, in his jaw's shade under his chin.
    let shade = mix(0.6, 1.0, smoothstep(1.6, 1.555, p.y))
    Cloth { albedo: SKIN.albedo * mix(1.0, shade, smoothstep(-0.03, 0.03, p.z)), ..SKIN }
}

/// The wrap round his head, under his mask and his hair, at a point of his head at rest: it
/// covers his head whole, to under his chin and to the foot of his skull. Round it, his mask's
/// cord.
fn wrapped_head(p: vec3, px: f32) -> Cloth {
    // (Behind his mask, a dark void.)
    if p.y > 1.607 && p.z > 0.02 {
        return VOID
    }
    // His mask's cord: from its sides at his eyes' height, back and down round his head.
    let cord = abs(p.y - (1.712 + 0.3 * p.z)) - 0.0045
    if cord < 0.0 && p.z < 0.04 {
        return Cloth { albedo: CORD, metal: 0.0, relief: 0.002 * sqrt(saturate(-cord / 0.0045)) }
    }
    WRAP
}

/// His coat's cloth at a point of it at rest, `e` outside its front opening (`opening`): a matte
/// black twill, its edge bound in gold, a row of stitches inside the binding. A seam across its
/// shoulders.
fn coat_at(p: vec3, e: f32, px: f32) -> Cloth {
    if e < TRIM {
        // (The binding: a rounded welt.)
        let across = (e / TRIM) * 2.0 - 1.0
        return Cloth { relief: 0.0016 * sqrt(max(1.0 - across * across, 0.0)), ..GOLD }
    }
    let relief = 0.00018 * sin(TAU * (p.x + p.z + p.y) / 0.003) * fine(0.003, px)
    var on = vec2(0.0, stripe(e - TRIM - 0.004, 0.0013, px) * (if fract(p.y / 0.008) < 0.62 {
        fine(0.008, px)
    } else { 0.0 }))
    if p.z < -0.02 {
        // Across its shoulders: its back's yoke. Under that its back is one piece to its hem.
        on += seam(p.y - 1.405, p.x, px)
    }
    sewn(Cloth { relief, ..BLACK }, on)
}

/// The wrap round his left forearm at a point of it at rest: a charcoal cloth band wound round
/// it, each turn rising to its edge and falling back within a fifth of the turn.
fn wrap_at(rest: vec3, px: f32) -> Cloth {
    let turn = fract((rest.x - 0.565) / 0.022)
    let rise = smoothstep(0.0, 0.8, turn) * (1.0 - smoothstep(0.8, 1.0, turn))
    Cloth { relief: 0.0009 * rise * fine(0.022, px), ..CHARCOAL }
}

/// What charted part `part` is made of at a point of it (`hakuro::charts`' order, then
/// `wide_charts`'): `rest` where it is on him at rest; `hem` how far a sleeve's point is from the
/// sleeve's end, along his arm (m); `inner` whether it's the inside of a piece of his coat that's
/// seen; `px` how much of him a pixel covers there (m). His bare arm, the wrap and the gauntlet
/// on his forearms, his hands; his coat's pieces (their outside its cloth, bound in gold at
/// every edge; their inside its lining); and what he wears under it (`worn_under`).
pub fn chart_paint(part: u32, rest: vec3, hem: f32, inner: bool, px: f32) -> Cloth {
    if of_cap(part) {
        // (Its hem, `hem` along his arm from its end.)
        if hem < CAP_HEM {
            let across = (hem / CAP_HEM) * 2.0 - 1.0
            return Cloth { relief: 0.0016 * sqrt(max(1.0 - across * across, 0.0)), ..GOLD }
        }
        return coat_at(rest, 1.0, px)
    }
    if part == 0 {
        // (His bare arm in his coat's shade where the shoulder's cap is over it.)
        let lit = mix(0.3, 1.0, smoothstep(0.17, 0.215, rest.x))
        return Cloth { albedo: SKIN.albedo * lit, ..SKIN }
    }
    if part == 2 {
        return wrap_at(rest, px)
    }
    if part == HEAD {
        return wrapped_head(rest, px)
    }
    if part == 3 {
        return LEATHER
    }
    if of_jacket(part) {
        if inner {
            // (Its lining in the coat's own shade away from its front edges and its collar's
            // top: lit all over, what showed of it past an edge was a bright patch on his
            // shoulder.)
            let edge = min(opening(rest), collar_top(rest) - rest.y)
            let lit = mix(0.1, 1.0, 1.0 - smoothstep(0.015, 0.09, edge))
            return Cloth { albedo: LINING.albedo * lit, ..LINING }
        }
        if part == JACKET_BODY {
            return coat_at(rest, opening(rest), px)
        }
        if part == COLLAR {
            // (Its front edges the jacket's own, on up; its top edge bound as they are.)
            return coat_at(rest, min(opening(rest), collar_top(rest) - rest.y), px)
        }
        // A shoulder: a seam along its top.
        return sewn(coat_at(rest, 1.0, px), seam(rest.z + 0.065, rest.x, px))
    }
    // (His left hand bare, his right in a black glove. The wrap round his left forearm carries
    // on over the heel of his palm to his wrist.)
    if of_hand(part) {
        if part >= HAND_LEFT + HAND_PIECES {
            return LEATHER
        }
        return if rest.x < WRAP_END { wrap_at(rest, px) } else { SKIN }
    }
    worn_under(rest, px)
}

/// Where a point of his coat's tails at rest is round them: degrees from straight ahead, toward
/// his left, about their axis.
fn round_tails(p: vec3) -> f32 {
    let rel = p - TAILS_AXIS
    var deg = atan2(rel.x, rel.z) * 57.2957795
    if deg < 0.0 {
        deg += 360.0
    }
    deg
}

/// How far inside the tails' front edges a point of them at rest is (m, round them; under 0 in
/// front of an edge, where the grid runs on past the cloth).
pub fn inside_front(p: vec3) -> f32 {
    let deg = round_tails(p)
    let edge = front_edge(p.y)
    min(deg - edge, 360.0 - edge - deg) * 0.0174532925 * length((p - TAILS_AXIS).xz)
}

/// His coat's tails at a point of them at rest: black outside, gold along the hem and the front
/// edges (one trim from his collar to the hem).
fn tails_face(p: vec3) -> Cloth {
    let low = hem(clamp(round_tails(p), 42.0, 318.0))
    if p.y < low + 0.022 || inside_front(p) < TRIM {
        return GOLD
    }
    BLACK
}

/// The tails' lining at a point at rest: an amber satin, darker than the trim's gold, in the
/// coat's shade further up inside it (lit gold all the way up, a run's lifted hem showed it as a
/// flat slab); gold along the hem and edges, as the binding wraps round.
fn tails_lining(p: vec3) -> Cloth {
    let low = hem(clamp(round_tails(p), 42.0, 318.0))
    if p.y < low + 0.022 || inside_front(p) < TRIM {
        return GOLD
    }
    let t = clamp((p.y - low - 0.03) / 0.18, 0.0, 1.0)
    let shade = 1.0 - 0.85 * t * t * (3.0 - 2.0 * t)
    Cloth { albedo: LINING.albedo * shade, ..LINING }
}

/// How far inside its cut edges a point of charted part `part` is (m on him at rest; under 0
/// where it's cut away): `chart_cut`'s rules as distances, so an edge is a line. `rest` is where
/// it is on him at rest, `place` where on its chart. The tails' front edges are cut back from
/// his waist, and their top runs on inside his jacket no further than `TAILS_UNDER`.
pub fn chart_kept(part: u32, rest: vec3, place: vec2) -> f32 {
    if part == TAILS {
        return min(inside_front(rest), TAILS_TOP + TAILS_UNDER - rest.y)
    }
    if part == COLLAR {
        // (Its form carries the top of his coat's back too, under its foot: that stops where a
        // shoulder takes over, `SHELF_OUT` from his middle.)
        return min(
            min(opening(rest), collar_top(rest) - rest.y),
            max(rest.y - 1.5, SHELF_OUT - abs(rest.x)),
        )
    }
    if part == YOKE_LEFT || part == YOKE_RIGHT {
        // (Its foot a line along its own chart, front and back: round it, at a shoulder's
        // radius.)
        return min((YOKE_ROUND - abs(wrapped(place.y))) * 0.06, YOKE_OUT - abs(rest.x))
    }
    if part != JACKET_BODY {
        return UNCUT
    }
    // (No hole for an arm: a sleeve comes out through its side. And none of it over the top of
    // his shoulder, past where a shoulder of his coat takes over.)
    let q = vec2(abs(rest.z + 0.065), rest.y - 1.455)
    let shoulder = max(0.15 - abs(rest.x), (atan2(q.x, q.y) - 1.1) * length(q))
    min(min(opening(rest), rest.y - COAT_SEAM), shoulder)
}

/// Which ink group part `part` is in (`hakuro::charts`' order, then `wide_charts`', then
/// `TAILS`): parts that join smoothly share one, so no line is drawn between them. His trunk,
/// legs, neck and head (his trousers' seat runs into his legs, his trunk ends inside his neck,
/// his head is filleted onto it); his coat's pieces, laid on its body, and its tails, which carry
/// on from it; each hand's palm and thumb (the thumb's ball rises from the palm). Each arm, the
/// wrap and the gauntlet, and each finger, a group of its own: a wrap's edge is a step, and a
/// fist's knuckles are drawn where its fingers stand on the palm.
pub fn ink_group(part: u32) -> u32 {
    if part == TAILS || of_jacket(part) || of_cap(part) {
        return 2
    }
    if of_hand(part) {
        let side = (part - HAND_LEFT) / HAND_PIECES
        let piece = (part - HAND_LEFT) % HAND_PIECES
        // (Its palm and thumb one group; each finger its own.)
        return 10 + side * 8 + (if piece >= 4 { 4 } else { piece })
    }
    if part <= 3 {
        return 3 + part
    }
    1
}

/// Whether part `part` is cut anywhere (`chart_kept`): his coat's pieces and its tails.
pub fn is_cut(part: u32) -> bool {
    part == TAILS || of_jacket(part)
}

/// What a fighter wears on one of his charted parts (`part`: `hakuro::charts`' order, then
/// `wide_charts`', then his coat's tails, `TAILS`), dressed as `vermilion` says (1: the
/// swordsman's vermilion; 0: Hakuro's own).
pub struct Dressed: Copy + GpuData {
    pub part: u32,
    pub vermilion: u32,
}

/// What a fighter dressed as `d` wears on part `part`.
pub fn dressed(part: u32, d: Dress) -> Dressed {
    Dressed { part, vermilion: if d.vermilion { 1 } else { 0 } }
}

/// A cloth worn by a fighter dressed as `d`, as a skin: its colour light (raised from the
/// screen's), its line field (its value on the screen less `SEAM_VALUE`), its metal and relief;
/// the rim off where it's a sheet seen along itself would be all edge (`rim`).
pub fn skin_of(c: Cloth, d: Dress, rim: bool) -> Skin {
    let shown = worn(c.albedo, c.metal, own: false, d: d)
    let value = dot(shown, vec3(0.3, 0.55, 0.15))
    Skin {
        albedo: pow(shown, vec3(2.2)),
        line: value - SEAM_VALUE,
        metal: c.metal,
        rim,
        relief: c.relief,
    }
}

impl Dressed {
    fn dress(self) -> Dress {
        if self.vermilion == 1 { SWORDSMAN } else { HIS_OWN }
    }

    /// What's worn at `at` (`inner`: its lining), a pixel covering `px` m there.
    fn cloth(self, at: Place, px: f32, inner: bool) -> Skin {
        if self.part == TAILS {
            // (Not his coat's tails' rim: a flat sheet seen along itself is all edge, and
            // swung out by a blow his black tails washed grey.)
            let c = if inner { tails_lining(at.rest) } else { tails_face(at.rest) }
            return skin_of(c, self.dress(), rim: false)
        }
        let place = at.chart.unwrap_or(vec2(0.0))
        // (A sleeve is hemmed at its end, on his arm: how far along his arm from there.)
        let hem = if of_cap(self.part) { (CAP_TO - place.x) * ARM_LONG } else { 1.0 }
        skin_of(chart_paint(self.part, at.rest, hem, inner, px), self.dress(), rim: true)
    }
}

impl Look for Dressed {
    fn skin(self, at: Place) -> Skin {
        self.cloth(at, 0.0005, inner: false)
    }
}

impl Worn for Dressed {
    fn worn(self, at: Place, px: f32) -> Skin {
        self.cloth(at, px, inner: false)
    }

    /// His jacket's inside shows at its open front and under its hem, and his collar's where it
    /// stands; his coat's tails' everywhere. Not the top of his coat's back and its shoulders,
    /// which lie on him.
    fn lined(self, at: Place) -> bool {
        self.part == TAILS || shows_inside(self.part, at.rest)
    }

    fn lining(self, at: Place, px: f32) -> Skin {
        self.cloth(at, px, inner: true)
    }

    fn kept(self, at: Place) -> f32 {
        chart_kept(self.part, at.rest, at.chart.unwrap_or(vec2(0.0)))
    }

    /// His lines are three quarters of a pixel, at 720 lines (fighter.wrela:817).
    fn ink(self) -> f32 {
        0.75
    }
}

/// His coat's cut edges, as distances, are where its rules cut it: over every place of each of
/// his coat's pieces at rest (and a grid round his tails), a place is cut away (`chart_cut`;
/// the tails' grid past their front edges, `tails::woven`) where it's kept less than nothing,
/// but within a tenth of a millimetre of the edge.
@test
fn his_coats_cut_edges_are_where_its_rules_cut_it() {
    let rest = hakuro::charted_at_rest()
    var cut = 0
    for part in [COLLAR, YOKE_LEFT, YOKE_RIGHT, JACKET_BODY] {
        for i in 0..60 {
            for j in 0..90 {
                let place = vec2((f32(i) + 0.5) / 60.0, TAU * (f32(j) + 0.5) / 90.0)
                let p = if part == JACKET_BODY {
                    rest.wide[1].side(f: place.x, theta: place.y)
                } else { rest.limbs[part].side(f: place.x, theta: place.y) }
                let kept = chart_kept(part, p, place)
                let gone = hakuro::chart_cut(part, p, vec3(place, 0.0))
                cut += if gone { 1 } else { 0 }
                if abs(kept) > 0.0001 {
                    assert(gone == (kept < 0.0), f"part {part} at {place}: cut {gone}, kept {kept}")
                }
            }
        }
    }
    assert(cut > 1000, f"only {cut} places cut")
    for c in 0..tails::DRAPE_COLS {
        for r in 0..tails::DRAPE_ROWS {
            let p = tails::node(c, r)
            let k = chart_kept(TAILS, p, vec2(0.0))
            if abs(k) > 0.0001 && p.y < TAILS_TOP {
                assert((k < 0.0) == (tails::woven(p) < 1.0), f"the tails at {p}: kept {k}")
            }
        }
    }
}

/// The way the middle of his coat's tails faces at each node of their grid at rest
/// (`tails::NODES`): its shape's own, folds and flare and all (`shapes::tails`' way through the
/// cloth, across a millimetre each way), so the cloth is lit by the folds it was made with, as
/// rywible/wrela lit its tails' field, however its grid hangs.
pub fn tails_normals() -> Vec<vec4> {
    var out: Vec<vec4> = Vec::new()
    let h = 0.001
    for k in 0..tails::DRAPE_NODES {
        let p = tails::NODES[k].rest
        let through = |q: vec3| -> f32 { shapes::tails(q).1 }
        let g = vec3(
            through(p + vec3(h, 0.0, 0.0)) - through(p - vec3(h, 0.0, 0.0)),
            through(p + vec3(0.0, h, 0.0)) - through(p - vec3(0.0, h, 0.0)),
            through(p + vec3(0.0, 0.0, h)) - through(p - vec3(0.0, 0.0, h)),
        )
        out.push(vec4(normalize(g), 0.0))
    }
    out
}
