// How Hakuro is handed to the listers, in any scene he's in: each fighter's
// charted pieces and their looks to the chart lister once, his coat's tails to the sheet lister
// once, his hair's locks to the strand lister; each frame his posed forms, his tails' pins and
// his locks. Both fighters are his body (the swordsman in vermilion).
//
//     var fighters = hakuro::drawn::fighters(quad, sag)
//     fighters.add(dress, view: k)                          // once a fighter
//     fighters.pose(k, charted)                             // each new drawing
//     fighters.hold(k, cloth, palette); fighters.work(dt)   // each frame
//     fighters.locked(palettes)                             // each frame
//     fighters.ready(eye)                                   // each frame, before the picture's pass
//     frame.draw(|d| {                                      // the picture's one pass
//         fighters.draw_into(d)                             // with the other opaque triangles
//         fighters.cut_into(d)                              // after them: what may drop pixels
//     })

use chart::cloth::Held
use chart::grown::Grown
use chart::radial::Radial
use dress::Dress
use frame::eye::Eye
use frame::picture::Drawing
use hakuro::{
    CHARTS, Charted, HAND_LEFT, HAND_PIECES, WIDE_CHARTS, charted_at_rest, charts, grown,
    grows_from, jacket_edges, of_hand, wide_charts,
}
use limbs::limbs::{Limbs, Piece, limbs, padded}
use limbs::placed::ALONE
use limbs::sheets::{Sheets, sheets}
use locks::{HAIR, HairLook, Lock, locks_of}
use look::{Dressed, TAILS, dressed, ink_group, is_cut, tails_normals}
use shading::{shaded, shaded_wide}
use strands::rig::{Rig, rig}
use tails::{LEG_RADII, NODES, Tails, sheet}

/// His limb-sized parts' size, and his wide parts'.
pub type Charts = Limbs<Dressed, 16, 13, 24, 21, 11>

/// The most a part is drawn under what's over it by a push from the eye (m): his palms' roots
/// (6 mm) and his thumbs' (2 mm). His legs' roots (6 cm), his neck's (3 cm) and his trunk (4 cm)
/// are drawn where they are: his trunk never comes out of his jacket's body, and where a leg's
/// root or his neck comes out of his trunk it's the same cloth or skin.
const MOST_UNDER: f32 = 0.01

/// How a finger's root is held onto its palm: over its first eighth, its side brought to the
/// palm's (eased as a thumb's is), with no fillet.
const FINGER_ON_PALM = Grown { fillet: 0.0, reach: 0.25, rooted: 0.12 }

/// How each of his charted parts is listed: its ink group, the part it grows from or lies on and
/// how, the cover its edges are read from (his jacket's body's, its first), whether it's cut, and
/// how far it's drawn under what's over it. With `fingers_held` false, his fingers stand on his
/// palms as they did (a break that shows as holes at his fingers' roots).
pub fn pieces(fingers_held: bool) -> Vec<Piece> {
    var out: Vec<Piece> = Vec::new()
    let parts = charts()
    let wides = wide_charts()
    for k in 0..CHARTS + WIDE_CHARTS {
        let sunk = if k < CHARTS { parts[k].sunk } else { wides[k - CHARTS].sunk }
        // (A finger's root is held onto its palm's side, so no sky shows between them; no fillet,
        // so a fist's knuckles stay a crease.)
        let finger = of_hand(k) && (k - HAND_LEFT) % HAND_PIECES < 4 && fingers_held
        let onto = if finger { HAND_LEFT + (k - HAND_LEFT) / HAND_PIECES * HAND_PIECES + 5 } else {
            grows_from(k)
        }
        out.push(
            Piece {
                group: ink_group(k),
                onto: if onto < CHARTS + WIDE_CHARTS { onto } else { ALONE },
                how: if finger { FINGER_ON_PALM } else { grown(k) },
                cover: if k == CHARTS + 1 { 0 } else { 4294967295 },
                cut: is_cut(k),
                under: if sunk.x <= MOST_UNDER { sunk } else { vec2(0.0) },
            },
        )
    }
    out
}

/// The fighters as the listers hold them: his charted parts (every fighter's, one body each),
/// his coat's tails (a view each), his hair's locks; each fighter's body number; and whether his
/// locks are drawn.
pub struct Fighters {
    pub limbs: Charts,
    pub tails: Sheets<Tails, Dressed>,
    pub hair: Rig<Lock, HairLook>,
    pub bodies: Vec<u32>,
    pub locks: bool,
    pub fingers_held: bool,
}

/// No fighters yet, their charts' grids with quads of at most `quad` px along (limb-sized, wide)
/// and chords within `sag` px of their outlines.
pub fn fighters(quad: vec2, sag: f32) -> Fighters {
    var charts: Charts = limbs(covers: jacket_edges())
    charts.quad = quad
    charts.per_pixel = true
    charts.sag = sag
    Fighters {
        limbs: charts,
        tails: sheets(Tails {}, NODES, tails_normals(), LEG_RADII, sheet().domain(), views: 2),
        hair: rig(HAIR, body: 0, room: 16),
        bodies: Vec::new(),
        locks: true,
        fingers_held: true,
    }
}

impl Fighters {
    /// A fighter added, dressed as `dress`, his tails view `view` (fighters are added in order).
    pub fn add(mut self, dress: Dress, view: u32) {
        var looks: Vec<Dressed> = Vec::new()
        for k in 0..CHARTS + WIDE_CHARTS {
            looks.push(dressed(k, dress))
        }
        let rest = charted_at_rest()
        let body = self.limbs.add(rest.limbs, rest.wide, pieces(self.fingers_held), looks)
        self.bodies.push(body)
        self.tails.add(
            view: view,
            body: body,
            group: ink_group(TAILS),
            look: dressed(TAILS, dress),
        )
    }

    /// Fighter `k` posed as `charted` has him, his parts' light read from their smoothed forms:
    /// a limb's posed form softened; a piece of his hand's, and a part grown from a limb-sized
    /// one's (his thumbs, his head), its form as it is (`shading`); his trunk's and jacket's
    /// softened.
    pub fn pose(mut self, k: u32, charted: Charted) {
        var shades: Vec<Radial<16, 13>> = Vec::new()
        for part in 0..CHARTS {
            let form = charted.limbs[part].form
            shades.push(if of_hand(part) || grows_from(part) < CHARTS { form } else {
                padded(shaded(form))
            })
        }
        var wide_shades: Vec<Radial<24, 11>> = Vec::new()
        for part in 0..WIDE_CHARTS {
            wide_shades.push(shaded_wide(charted.wide[part].form))
        }
        self.limbs.pose(self.bodies[k], charted.limbs, charted.wide, shades, wide_shades)
    }

    /// Fighter `k`'s coat's pins this frame (`cloth`), on `palette`.
    pub fn hold(mut self, k: u32, cloth: Held, palette: [mat4; 64]) {
        self.tails.hold(k, cloth, palette)
    }

    /// The tails' drape stepped `dt` s (0: held through a blow's hold).
    pub fn work(mut self, dt: f32) {
        self.tails.work(dt)
    }

    /// Every fighter's locks, as each one's `palettes` poses him.
    pub fn locked(mut self, palettes: [[mat4; 64]]) {
        var strands: Vec<Lock> = Vec::new()
        var hosts: Vec<vec3> = Vec::new()
        for p in palettes {
            let (ls, hs) = locks_of(p)
            for k in 0..ls.len() {
                strands.push(ls[k])
                hosts.push(hs[k])
            }
        }
        self.hair.place(strands, hosts)
    }

    /// Every fighter made ready for `eye`, before the picture's pass (compute and writes): each
    /// charted piece in view placed, his locks widened.
    pub fn ready(mut self, eye: Eye) {
        self.limbs.prepare(eye)
        if self.locks {
            self.hair.ready(eye)
        }
    }

    /// Every fighter's pieces that never drop a pixel, and his locks, drawn into the picture's
    /// one pass (`frame::picture::Frame::draw`), with the other listers' opaque triangles.
    pub fn draw_into(self, d: Drawing) {
        self.limbs.draw_into(d)
        if self.locks {
            self.hair.draw_into(d)
        }
    }

    /// Every fighter's pieces that his look or cover cuts, and his coat's tails, drawn into the
    /// picture's pass after every opaque triangle: they may drop pixels.
    pub fn cut_into(self, d: Drawing) {
        self.limbs.cut_into(d)
        self.tails.draw_into(d)
    }

    /// The identity fighter `k`'s parts write (its ink group's bits aside): for its blow.
    pub fn identity_of(self, k: u32) -> u32 {
        frame::picture::identity(frame::picture::CHART, body: self.bodies[k], group: 0)
    }
}
