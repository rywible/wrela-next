@test
fn the_light_on_his_arm_his_trunk_and_a_finger_is_the_old_pixels() {
    let posed = charted_as(PALETTE)
    let rest = charted_at_rest()
    let edges = jacket_edges()
    var worst = 0.0
    var at = 0
    // (How many places a cap or a fold makes the side's own normal the light's, part by part.)
    var own = [0, 0, 0]
    for k in 0..LIT.len() {
        let (part, uv, old, old_own) = LIT[k]
        let v = vertex_of(posed, rest, edges, part, uv.x, uv.y)
        let n = lit_of(posed, part, uv.x, uv.y, v)
        let off = max(length(n - old), abs(v.own - old_own))
        if off > worst {
            worst = off
            at = k
        }
        assert(length(light_at(posed, rest, edges, part, uv.x, uv.y) - n) == 0.0)
        if v.own > 0.0 {
            own[if part == 0 { 0 } else if part == 25 { 1 } else { 2 }] += 1
        }
    }
    assert(worst < WITHIN, f"the light is {worst} off the old at {LIT[at].0}, {LIT[at].1}")
    assert(own[0] > 20 && own[1] > 20 && own[2] > 20, f"own light at {own[0]}, {own[1]}, {own[2]}")
}

@test
fn his_grown_parts_are_where_the_old_code_put_them_and_lit_as_it_lit_them() {
    let posed = charted_as(PALETTE)
    let rest = charted_at_rest()
    let edges = jacket_edges()
    var worst = 0.0
    var at = 0
    var moved = 0
    for k in 0..GROWN.len() {
        let (part, uv, old_at, old_normal, old_own, old_lit) = GROWN[k]
        let v = vertex_of(posed, rest, edges, part, uv.x, uv.y)
        let n = lit_of(posed, part, uv.x, uv.y, v)
        let off = max(
            max(length(v.at - old_at), length(v.normal - old_normal)),
            max(abs(v.own - old_own), length(n - old_lit)),
        )
        if off > worst {
            worst = off
            at = k
        }
        if v.own > 0.0 {
            moved += 1
        }
    }
    assert(worst < WITHIN, f"{worst} off the old at {GROWN[at].0}, {GROWN[at].1}")
    assert(moved > 300, f"only {moved} places moved")
}
