// A few locks of Hakuro's hair, as strands on his rig: loose locks out of his hair's mass,
// swept back and out past his spikes, riding his hair's swayed bone. His hair's mass stays a
// solid (`hakuro::fields::Hair`), drawn by another lister. Each lock is a quadratic curve in
// his unscaled head's space (as `hakuro::shapes`'s spikes are), its root a few millimetres
// inside his hair's mass, tapering to a point; placed each frame by the matrix his palette
// gives his hair's field (`Posed::fields`).

use form::kinds::Strand
use form::look::{Place, Skin}
use shapes::{HEAD_JOINT, HEAD_SCALE}
use skeleton::{HAIR_BONE, REST}
use strands::scatter::Wears

/// A lock: where its field stands (its hair's bone, from `Posed::fields`), its curve from `a`
/// bent toward `b` to `c` (the unscaled head's space, m), and its radius at its root and tip.
pub struct Lock: Copy + GpuData {
    pub at: mat4,
    pub a: vec3,
    pub root: f32,
    pub b: vec3,
    pub tip: f32,
    pub c: vec3,
    pub spare: f32,
}

impl Strand for Lock {
    fn at(self, t: f32) -> vec4 {
        let s = 1.0 - t
        let q = self.a * (s * s) + self.b * (2.0 * s * t) + self.c * (t * t)
        // (The field's own space: the head's unscaled space grown about its joint.)
        let local = (q - HEAD_JOINT) * HEAD_SCALE
        let w = self.at * vec4(local, 1.0)
        vec4(w.xyz, mix(self.root, self.tip, t) * HEAD_SCALE)
    }
}

/// The locks: root, bend, tip (his unscaled head's space, m; z back is negative), from his
/// crown and temples out between his spikes (`hakuro::shapes::CLUMPS`).
const LOCKS: [(vec3, vec3, vec3); 6] = [
    (vec3(0.015, 1.835, -0.03), vec3(0.03, 1.95, -0.2), vec3(0.06, 1.88, -0.37)),
    (vec3(-0.02, 1.82, -0.06), vec3(-0.05, 1.9, -0.24), vec3(-0.1, 1.79, -0.39)),
    (vec3(0.07, 1.8, -0.04), vec3(0.17, 1.88, -0.14), vec3(0.27, 1.81, -0.22)),
    (vec3(-0.07, 1.8, -0.04), vec3(-0.17, 1.89, -0.13), vec3(-0.26, 1.84, -0.19)),
    (vec3(0.05, 1.76, -0.09), vec3(0.12, 1.72, -0.24), vec3(0.16, 1.6, -0.3)),
    (vec3(-0.05, 1.76, -0.09), vec3(-0.13, 1.73, -0.23), vec3(-0.18, 1.62, -0.28)),
]

/// How many locks a fighter has.
pub const COUNT: u32 = 6

/// A lock's radius at its root and at its tip (m, before the head's scale).
const ROOT: f32 = 0.007
const TIP: f32 = 0.0008

/// The locks as `field` (his hair field's matrix) places them, and the normal of his hair's mass
/// at each root (out from the middle of his skull), which their light leans to.
pub fn locks_at(field: mat4) -> (Vec<Lock>, Vec<vec3>) {
    var out: Vec<Lock> = Vec::new()
    var hosts: Vec<vec3> = Vec::new()
    for l in LOCKS {
        let lock = Lock { at: field, a: l.0, root: ROOT, b: l.1, tip: TIP, c: l.2, spare: 0.0 }
        out.push(lock)
        let middle = (field * vec4((vec3(0.0, 1.7, -0.01) - HEAD_JOINT) * HEAD_SCALE, 1.0)).xyz
        hosts.push(normalize(lock.at(0.0).xyz - middle))
    }
    (out, hosts)
}

/// His hair's colour (linear: `rywible/wrela` at 7ae6711e, content/hakuro/hakuro.wrela:69, the
/// hair's cloth), lighter toward a lock's tip as his spikes' are not: a lock reads against his
/// mass.
pub struct HairLook: Copy + GpuData {
    pub albedo: vec3,
    pub spare: f32,
}

pub const HAIR = HairLook { albedo: vec3(0.027, 0.028, 0.045), spare: 0.0 }

impl Wears<Lock> for HairLook {
    fn skin(self, s: Lock, t: f32, at: Place) -> Skin {
        Skin { albedo: self.albedo * (1.0 + 0.6 * t), line: 1.0, metal: 0.0, rim: true }
    }

    fn mean(self, s: Lock) -> vec3 {
        self.albedo * 1.3
    }
}

/// The locks as `palette` poses him (his hair's field on its bone, from its joint at rest, as
/// `bodies::door::fields_of` places it), and their roots' normals.
pub fn locks_of(palette: [mat4; 64]) -> (Vec<Lock>, Vec<vec3>) {
    locks_at(palette[HAIR_BONE] * std::transform::translate(REST[HAIR_BONE]))
}
