// Which smoothed form each of Hakuro's charted parts reads its light from, and the light's
// normal at a place of a posed part: the choice the combat lab made when it drew him
// (rywible/wrela's content/humanoid/fighter.wrela 271-350, at 7ae6711e). A limb reads its posed
// form softened (`shaded`); a hand's piece, and a part grown from one of his limbs (his thumbs
// on their palms, his head on his neck), its form as it is (`shaded_hand`), so the two read the
// same side where they meet; his trunk and his jacket's body theirs softened (`shaded_wide`); a
// piece laid on his jacket's body (its collar, its shoulders, its sleeves) leans to the body's.
// From rywible/wrela's content/hakuro/hakuro.wrela at 7ae6711e.

use chart::lit::{Vertex, lit, vertex, vertex_onto}
use chart::radial::Radial
use hakuro::{CHARTS, Charted, WIDE_CHARTS, grown, grows_from, of_hand}

/// How fine the detail round a charted part's path its shading keeps (harmonics): his light's
/// bands are read off his forms without the ripples finer than this (`Radial::softened`). More
/// kept, and dark spots stand inside a highlight.
pub const SHADED_DETAIL: f32 = 3.5

/// What a limb-sized part's pixels read their normals from: its posed form, softened
/// (`SHADED_DETAIL`) and kept to its first 4 harmonics of 6. What's dropped is a twentieth of
/// what it was before softening or less, and a pixel pays for every term.
pub fn shaded(form: Radial<16, 13>) -> Radial<16, 9> {
    form.softened(SHADED_DETAIL).kept()
}

/// What a piece of his hand's pixels read their normals from: its form as it is. A palm is a
/// flat section, which is its even harmonics to the last: softened as a limb is, the back of
/// his open hand was lit as a tube's and read as "a flat, unshaded paddle". And a thumb's ball
/// that rises from his palm (`grown`) is lit there as the palm's side is made, so the palm's
/// own pixels read the same side.
pub fn shaded_hand(form: Radial<16, 13>) -> Radial<16, 13> {
    form
}

/// What his trunk's and his jacket's pixels read their normals from: the posed form softened,
/// kept to its first 5 harmonics of 10.
pub fn shaded_wide(form: Radial<24, 21>) -> Radial<24, 11> {
    form.softened(SHADED_DETAIL).kept()
}

/// What place (`f`, `theta`) of his charted part `part` (`charts`' order, then `wide_charts`')
/// passes on as `posed` has him (`rest`: him at rest; `edges`: `jacket_edges`): where it is,
/// and the side's own normal and how much of the light is its own there (`chart::lit`).
pub fn vertex_of(
    posed: Charted,
    rest: Charted,
    edges: [f32],
    part: u32,
    f: f32,
    theta: f32,
) -> Vertex {
    if part >= CHARTS {
        return vertex(rest.wide[part - CHARTS], posed.wide[part - CHARTS], f: f, theta: theta)
    }
    let c = posed.limbs[part]
    let onto = grows_from(part)
    if onto < CHARTS {
        let o = posed.limbs[onto]
        return vertex_onto(
            rest.limbs[part],
            c,
            f: f,
            theta: theta,
            onto: o,
            light: shaded_hand(o.form),
            how: grown(part),
            covers: edges,
        )
    }
    if onto < CHARTS + WIDE_CHARTS {
        let o = posed.wide[onto - CHARTS]
        return vertex_onto(
            rest.limbs[part],
            c,
            f: f,
            theta: theta,
            onto: o,
            light: shaded_wide(o.form),
            how: grown(part),
            covers: edges,
        )
    }
    vertex(rest.limbs[part], c, f: f, theta: theta)
}

/// The unit normal the light uses at place (`f`, `theta`) of part `part` as `posed` has him,
/// from what its vertices passed on there (`v`, `vertex_of`'s, between them).
pub fn lit_of(posed: Charted, part: u32, f: f32, theta: f32, v: Vertex) -> vec3 {
    if part >= CHARTS {
        let c = posed.wide[part - CHARTS]
        return lit(c, shaded_wide(c.form), f: f, theta: theta, v: v)
    }
    let c = posed.limbs[part]
    if of_hand(part) || grows_from(part) < CHARTS {
        return lit(c, shaded_hand(c.form), f: f, theta: theta, v: v)
    }
    lit(c, shaded(c.form), f: f, theta: theta, v: v)
}

/// The unit normal the light uses at place (`f`, `theta`) of part `part`, worked out there
/// alone.
pub fn light_at(
    posed: Charted,
    rest: Charted,
    edges: [f32],
    part: u32,
    f: f32,
    theta: f32,
) -> vec3 {
    lit_of(posed, part, f, theta, vertex_of(posed, rest, edges, part, f, theta))
}
