/// The point of chart `c` at place `uv`, through what every chart has.
fn point_of<C: Chart>(c: C, uv: vec2) -> vec3 {
    c.at(uv)
}

/// Chart `c`'s places.
fn places_of<C: Chart>(c: C) -> Box2 {
    c.domain()
}

/// A box that holds chart `c`.
fn bound_of<C: Chart>(c: C) -> Box3 {
    c.bound()
}

fn held(b: Box3, p: vec3) -> bool {
    p.x >= b.lo.x &&
        p.y >= b.lo.y &&
        p.z >= b.lo.z &&
        p.x <= b.hi.x &&
        p.y <= b.hi.y &&
        p.z <= b.hi.z
}

@test
fn his_left_arm_is_a_chart_that_lies_on_the_old_posed_form() {
    let arm = charted_as(PALETTE).limbs[0]
    let d = places_of(arm)
    assert(d.lo == vec2(0.0, 0.0) && d.hi == vec2(0.84, TAU), f"its places {d.lo} to {d.hi}")
    let b = bound_of(arm)
    var worst = 0.0
    var at = 0
    for k in 0..ARM.len() {
        let (uv, old) = ARM[k]
        let p = point_of(arm, uv)
        assert(held(b, p), f"its box doesn't hold its point at {uv}")
        let off = length(p - old)
        if off > worst {
            worst = off
            at = k
        }
    }
    assert(worst < WITHIN, f"its side is {worst} m from the old one at {ARM[at].0}")
}

@test
fn every_part_of_him_lies_on_the_old_posed_form() {
    let posed = charted_as(PALETTE)
    for k in 0..CHARTS + WIDE_CHARTS {
        for n in 0..24 {
            let (uv, old) = PARTS[k * 24 + n]
            let p = if k < CHARTS { point_of(posed.limbs[k], uv) } else {
                point_of(posed.wide[k - CHARTS], uv)
            }
            let off = length(p - old)
            // (But the wrap's and the gauntlet's ends, drawn in toward his arm by as much as
            // `WRAP_TUCK` takes, and a tenth of a millimetre of its fit either way.)
            let tuck = if k == 2 || k == 3 {
                abs(WRAP_TUCK.radius(f: uv.x, theta: uv.y)) + 0.0001
            } else {
                0.0
            }
            assert(off < WITHIN + tuck, f"part {k} is {off} m from the old one at {uv}")
        }
    }
}

@test
fn where_his_arms_meet_his_coat_in_this_pose_his_coat_is_on_him() {
    // rywible/wrela's `where_his_arm_meets_his_coat_his_coat_is_on_him` (content/hakuro's
    // main.wrela) held this through nine moves; here, through this pose: from his armpits up,
    // wherever an upper arm's side (from 2 cm past his shoulder's joint to 5 cm short of his
    // elbow) passes through his coat's body, the body there is within 3.5 cm of what his chest
    // carries (`hakuro::off_him`).
    let rest = charted_at_rest()
    let cover = jacket_body_cover()
    let through = arms_through_coat(
        charted_as(PALETTE),
        rest,
        cover,
        from: 0.16,
        to: 0.48,
        over: 0.0,
    )
    for h in through {
        assert(
            h.rest.y < 1.33 || h.off < 0.035,
            f"arm {h.arm} is through his coat's body {h.off} m off him at {h.rest}",
        )
    }
}
