// His palette: the matrices that pose him, made from the moves' rig's. The moves are played on
// the rig Hakuro was measured on (Quaternius's Superhero Male, CC0), whose joints are his, so
// each of its bones moves one of his (`HAKURO_BONE`); his fingers, which no capture holds, are
// curled into fists round what he grips; his fists are kept off his mask's snout; and his hair's
// bone sways on a spring. From rywible/wrela's content/hakuro at 7ae6711e (reference_rig.wrela's
// `HAKURO_BONE`, manner.wrela's `on_rig`, fingers.wrela, clear.wrela's `fists_off_mask`,
// hakuro.wrela's hair) and content/humanoid/fighter.wrela's `hakuro_palette`.

use motion::humanoid::arc
use motion::sway
use fields::TOE_CUT
use shapes::boot_foot
use skeleton::{BALL_LEFT, FINGER_JOINTS, HAIR_BONE, HEAD, PARENT, REST}
use std::transform::translate

/// Each of the rig's 52 bones' bone in his skeleton (`skeleton`).
pub const HAKURO_BONE: [u32; 52] = [
    0, 1, 2, 3, 4, 5, 18, 20, 22, 24, 19, 21, 23, 25, 6, 8, 10, 12, 7, 9, 11, 13, 50, 52, 54, 26,
    28, 30, 32, 34, 36, 38, 40, 42, 44, 46, 48, 51, 53, 55, 27, 29, 31, 33, 35, 37, 39, 41, 43, 45,
    47, 49,
]

/// His palette as the lab posed him from the rig's (`motion::humanoid::palette`): each of its
/// bones' matrix as his, his hands closed into fists (`FIST_CURL`: he holds a sword, and the
/// captures hold no fingers), kept off his mask. His hair's bone goes with his head until
/// `with_hair` swings it.
pub fn of_rig(rig_m: [mat4; 64]) -> [mat4; 64] {
    with_hair(toes_off_floor(fists_off_mask(curled(on_rig(rig_m), FIST_CURL))), vec3(0.0))
}

// ---- his toes off the floor ----------------------------------------------------------------------

/// The sole of his left boot's toe at rest (rest space): each point of the boot's bottom ahead of
/// where his toes bend (`fields::TOE_CUT`), on a grid a centimetre square, 4 mm under the floor.
@fuel(2 ** 40)
pub const TOE_SOLE: [vec3; 256] = toe_sole()

/// How many of `TOE_SOLE`'s points are the sole's.
@fuel(2 ** 40)
pub const TOE_POINTS: u32 = toe_points()

fn toe_points() -> u32 {
    var n = 0
    for i in 0..18 {
        for j in 0..20 {
            let p = vec3(0.03 + 0.01 * f32(i), -0.002, TOE_CUT + 0.01 * f32(j))
            if boot_foot(p) < 0.0 {
                n += 1
            }
        }
    }
    n
}

fn toe_sole() -> [vec3; 256] {
    var out = [vec3(0.0); 256]
    var n = 0
    for i in 0..18 {
        for j in 0..20 {
            let p = vec3(0.03 + 0.01 * f32(i), -0.002, TOE_CUT + 0.01 * f32(j))
            if boot_foot(p) < 0.0 && n < 256 {
                out[n] = vec3(p.x, -0.004, p.z)
                n += 1
            }
        }
    }
    out
}

/// `m` (his palette) with each foot's toes turned up about the ball's joint as far as keeps his
/// boot's toe out of the floor: no lower than the floor, or than the ball's own sole where that's
/// lower (a foot the move has sunk). The moves' toes are a capture's, and point down through the
/// floor as a foot pushes off (up to 10 cm at the toe's tip, a run's first steps); a toe on the
/// floor bends up, as his does.
pub fn toes_off_floor(m: [mat4; 64]) -> [mat4; 64] {
    var out = m
    for side in 0..2 {
        let b = BALL_LEFT + side
        let sx = if side == 0 { 1.0 } else { -1.0 }
        let joint = (m[b] * vec4(REST[b], 1.0)).xyz
        let under = (m[b] * vec4(REST[b].x, -0.004, REST[b].z, 1.0)).y
        let floor = min(0.0, under)
        // (The toe bends about the ball's joint, along his foot's width: rest x.)
        let axis = normalize((m[b] * vec4(1.0, 0.0, 0.0, 0.0)).xyz)
        // (Turned the way that lifts its tip: the sole's point furthest along it.)
        var tip = vec3(0.0)
        for k in 0..TOE_POINTS {
            if TOE_SOLE[k].z > tip.z {
                tip = TOE_SOLE[k]
            }
        }
        let ahead = (m[b] * vec4(tip.x * sx, tip.y, tip.z, 1.0)).xyz - joint
        let way = if cross(axis, ahead).y >= 0.0 { 1.0 } else { -1.0 }
        var turn = 0.0
        for k in 0..TOE_POINTS {
            let q = TOE_SOLE[k]
            let p = (m[b] * vec4(q.x * sx, q.y, q.z, 1.0)).xyz - joint
            if joint.y + p.y >= floor {
                continue
            }
            // The least turn of `p` about `axis` that way that puts it on `floor`, in steps of a
            // degree, half a turn at most.
            var d = 1
            while d < 180 &&
                joint.y + Quat::axis_angle(axis, way * f32(d) * 0.017453292).rotate(p).y < floor {
                d += 1
            }
            turn = max(turn, f32(d))
        }
        turn = way * turn * 0.017453292
        if turn != 0.0 {
            let r = Quat::axis_angle(axis, turn).to_mat3()
            let t = joint - r * joint
            out[b] = mat4(vec4(r[0], 0.0), vec4(r[1], 0.0), vec4(r[2], 0.0), vec4(t, 1.0)) * m[b]
        }
    }
    out
}

/// Each of the rig's bones' matrix as his own bone's.
pub fn on_rig(rig_m: [mat4; 64]) -> [mat4; 64] {
    var m = [translate(vec3(0.0)); 64]
    for b in 0..52 {
        m[HAKURO_BONE[b]] = rig_m[b]
    }
    // His old single finger and thumb bones (14 to 17), unused by his skin, with his hands.
    for side in 0..2 {
        m[14 + side] = m[12 + side]
        m[16 + side] = m[12 + side]
    }
    m
}

// ---- his fingers ---------------------------------------------------------------------------------

/// A turn of `degrees` about `axis` (unit) about the point `at`.
pub fn turn_about(axis: vec3, degrees: f32, at: vec3) -> mat4 {
    let a = degrees * 0.0174532925
    let c = cos(a)
    let s = sin(a)
    let t = 1.0 - c
    let x = axis.x
    let y = axis.y
    let z = axis.z
    let r = mat4(
        vec4(t * x * x + c, t * x * y + s * z, t * x * z - s * y, 0.0),
        vec4(t * x * y - s * z, t * y * y + c, t * y * z + s * x, 0.0),
        vec4(t * x * z + s * y, t * y * z - s * x, t * z * z + c, 0.0),
        vec4(0.0, 0.0, 0.0, 1.0),
    )
    translate(at) * r * translate(-at)
}

/// Whether bone `b` is `of` or below it.

/// Whether bone `b` is `of` or below it.
pub fn below(b: u32, of: u32) -> bool {
    var i = b
    loop {
        if i == of {
            return true
        }
        let p = PARENT[i]
        if p == i {
            return false
        }
        i = p
    }
}

/// `m` with each finger's joints set by its hand's, curled toward the palm by `curl` (degrees a
/// joint, as `HIP_CURL`), each joint about its own rest z (the thumb's, `THUMB_AXIS`).
pub fn curled(m: [mat4; 64], curl: [f32; 15]) -> [mat4; 64] {
    curled_each(m, curl, curl)
}

/// `curled`, his left hand's fingers by `left` and his right's by `right`.
pub fn curled_each(m: [mat4; 64], left: [f32; 15], right: [f32; 15]) -> [mat4; 64] {
    var out = m
    for side in 0..2 {
        for j in 0..15 {
            out[26 + 2 * j + side] = out[12 + side]
        }
    }
    for side in 0..2 {
        for j in 0..15 {
            let b = 26 + 2 * j + side
            let at = (out[b] * vec4(REST[b], 1.0)).xyz
            // (His right hand is his left's mirror image: a mirrored turn is about the mirrored
            // axis the other way round. Turned the same way about the same axis, his left
            // hand's fingers curled toward the back of his hand.)
            let is_left = side == 0
            let own = if j >= 12 {
                if is_left { THUMB_AXIS } else { vec3(-THUMB_AXIS.x, THUMB_AXIS.y, THUMB_AXIS.z) }
            } else {
                vec3(0.0, 0.0, 1.0)
            }
            let axis = normalize((out[b] * vec4(own, 0.0)).xyz)
            let way = if j >= 12 { if is_left { 1.0 } else { -1.0 } } else if is_left {
                -1.0
            } else {
                1.0
            }
            let by = if is_left { left[j] } else { right[j] }
            let r = turn_about(axis, way * by, at)
            for k in 26..56 {
                if below(k, b) {
                    out[k] = r * out[k]
                }
            }
        }
    }
    out
}

/// A hand hanging relaxed (degrees, as `FIST_CURL`): the fingers curled more toward the little
/// one, the thumb resting along the index. Only the test of how both hands close reads it.
pub const RELAXED_CURL = [
    30.0, 40.0, 25.0, 36.0, 46.0, 25.0, 42.0, 50.0, 28.0, 48.0, 55.0, 30.0, 10.0, 22.0, 18.0,
]

/// A closed fist's curl (degrees; index, middle, ring, little, thumb): knuckles square, the
/// thumb folded across the middle bones.
pub const FIST_CURL = [
    88.0, 105.0, 70.0, 90.0, 108.0, 70.0, 92.0, 108.0, 70.0, 94.0, 108.0, 70.0, 35.0, 50.0, 40.0,
]

/// The thumb's joints' axis at rest (his left's): across its pad, so it closes toward the palm.
pub const THUMB_AXIS = vec3(-0.35, 0.55, 0.76)

@test
fn a_left_hands_fingers_curl_as_its_rights_do_mirrored() {
    // His right hand is his left's mirror image, and so is how it closes: each finger's tip,
    // his hands curled from rest, is where the other hand's is, mirrored. (Both hands' joints
    // were turned the same way about the same axis, and his left's fingers curled toward the
    // back of his hand.)
    let m = curled([translate(vec3(0.0)); 64], RELAXED_CURL)
    for f in 0..5 {
        let tip = FINGER_JOINTS[f * 4 + 3]
        let last = 26 + 2 * (f * 3 + 2)
        let left = (m[last] * vec4(tip, 1.0)).xyz
        let right = (m[last + 1] * vec4(-tip.x, tip.y, tip.z, 1.0)).xyz
        assert(length(left - vec3(-right.x, right.y, right.z)) < 0.0005, f"finger {f}")
    }
    // And toward his palm, which faces down as he stands at rest: his index's tip comes down.
    let tip = FINGER_JOINTS[3]
    let curled_tip = (m[30] * vec4(tip, 1.0)).xyz
    assert(curled_tip.y < tip.y - 0.02, f"his index's tip went from {tip.y} to {curled_tip.y}")
}

// ---- his fists off his mask -------------------------------------------------------------------

// His fists are kept off his mask's snout, cheeks and chin. The moves were fitted to a body with a face, not a fox's
// snout 21 cm long: a boxer's guard holds the fists at the chin, where Hakuro's snout is, and
// they went through it. Each fist near the snout is moved off it, the whole arm swung about its
// shoulder (so the elbow and the grip are the move's), by how far it's in, eased so that it
// never pops.

/// The snout's axis in his rest space (the mask's cone, the head scaled 1.1 about its joint):
/// its root and tip, and the cone's radius at each.
const ROOT = vec3(0.0, 1.677, 0.0743)
const TIP = vec3(0.0, 1.6528, 0.1953)
const R_ROOT: f32 = 0.044
const R_TIP: f32 = 0.0143

/// The mask's cheeks (his left's; the right mirrored): their middles and radius, in his rest space.
const CHEEK = vec3(0.052, 1.645, 0.072)
const R_CHEEK: f32 = 0.05

/// The mask's chin, under the snout's root, and its radius.
const CHIN = vec3(0.0, 1.602, 0.082)
const R_CHIN: f32 = 0.04

/// A fist's middle in his rest space (his left; the right mirrored), and its half thickness.
const FIST = vec3(0.795, 1.425, -0.062)
const FIST_R: f32 = 0.056

/// His shoulder joints at rest (his left).
const SHOULDER = vec3(0.212, 1.455, -0.065)

/// The bones of an arm from the upper arm down (his left's; the right's each one more): upper
/// arm, forearm, hand, the old finger and thumb bones, then each finger joint.
fn arm_bone(i: u32, side: u32) -> u32 {
    let b = if i == 0 { 8 } else if i == 1 { 10 } else if i == 2 { 12 } else if i == 3 {
        14
    } else if i == 4 { 16 } else { 26 + 2 * (i - 5) }
    b + side
}

/// A turn (a rotation matrix) taking `a` onto `b` about the point `at`.
fn swung(a: vec3, b: vec3, at: vec3) -> mat4 {
    let r = arc(a, b).to_mat3()
    translate(at) *
        mat4(vec4(r[0], 0.0), vec4(r[1], 0.0), vec4(r[2], 0.0), vec4(0.0, 0.0, 0.0, 1.0)) *
        translate(-at)
}

/// `m` (his palette) with each fist moved off the snout and cheeks.
pub fn fists_off_mask(m: [mat4; 64]) -> [mat4; 64] {
    var out = m
    let root = (m[5] * vec4(ROOT, 1.0)).xyz
    let tip = (m[5] * vec4(TIP, 1.0)).xyz
    for side in 0..2 {
        let sx = if side == 0 { 1.0 } else { -1.0 }
        let shoulder = (out[8 + side] * vec4(SHOULDER.x * sx, SHOULDER.y, SHOULDER.z, 1.0)).xyz
        // (Twice: a fist moved off may still graze it.)
        for _ in 0..2 {
            let fist = (out[12 + side] * vec4(FIST.x * sx, FIST.y, FIST.z, 1.0)).xyz
            let e = tip - root
            let h = clamp(dot(fist - root, e) / dot(e, e), 0.0, 1.0)
            var near = root + e * h
            var reach = mix(R_ROOT, R_TIP, h) + FIST_R + 0.045
            // (Or a cheek or the chin, whichever it's deepest in.)
            for c in 0..3 {
                let cx = if c == 0 { 1.0 } else { -1.0 }
                let at = if c < 2 { vec3(CHEEK.x * cx, CHEEK.y, CHEEK.z) } else { CHIN }
                let cheek = (m[5] * vec4(at, 1.0)).xyz
                let rc = (if c < 2 { R_CHEEK } else { R_CHIN }) + FIST_R + 0.045
                if rc - length(fist - cheek) > reach - length(fist - near) {
                    near = cheek
                    reach = rc
                }
            }
            let off = fist - near
            let d = length(off)
            // How far in, eased: nothing well clear, the full depth well in, smooth between.
            let x = reach - d
            let push = 0.5 * (x + sqrt(x * x + 0.0001)) - 0.005
            if push <= 0.0 {
                continue
            }
            // Out from the snout's axis; straight out sideways if the fist is on it.
            let dir = if d > 1.0e-4 { off / d } else { vec3(sx, 0.0, 0.0) }
            let r = swung(fist - shoulder, fist + dir * push - shoulder, shoulder)
            for i in 0..20 {
                let b = arm_bone(i, side)
                out[b] = r * out[b]
            }
        }
    }
    out
}

/// His hips and belt, with the coat on (his rest space): an upright elliptic cylinder, its half

// ---- his hair ----------------------------------------------------------------------------------

/// What his hair sways about, and where its mass is, on him at rest: the middle of his skull,
/// and a point over the back of his crown, in among its spikes.
pub const HAIR_PIVOT: vec3 = vec3(0.0, 1.7, -0.01)
pub const HAIR_MASS: vec3 = vec3(0.0, 1.85, -0.07)

/// His hair's spring (`engine::sway`): stiff and well damped, as spikes held with wax are.
/// It swings four times a second and is still within a quarter of a second, overshooting
/// once and barely; its mass goes no more than 3.5 cm from where his head holds it.
/// (At three swings a second and little damping it swung in time with his sprint's steps,
/// three and a quarter a second, and built up to its limit: his hair pumped at every
/// footfall and wobbled on after he stopped.)
pub const HAIR_SPRING: sway::Spring = sway::Spring { rate: 4.0, damping: 0.6, most: 0.035 }

/// Where his head holds his hair's mass as `palette` poses him: what `sway::Sway::step` is
/// given.
pub fn hair_held(palette: [mat4; 64]) -> vec3 {
    (palette[5] * vec4(HAIR_MASS, 1.0)).xyz
}

/// How far the air he's in pushes his hair's mass back for its speed squared (m for each
/// (m/s)²), and how far at most (m): at a sprint's 5.2 m/s, 2.5 cm, his spikes swept back.
pub const HAIR_BLOWN: f32 = 0.0009
pub const HAIR_BLOWN_MOST: f32 = 0.025

/// Where his hair's mass is from where his head holds it, swaying `sway` (m: `Sway::step`'s
/// answer) in air that meets him at `going` m/s from ahead (as `palette` poses him): its sway
/// and the air's push back along where his hips face, together no further than his hair's
/// spring lets it go.
pub fn hair_blown(palette: [mat4; 64], sway: vec3, going: f32) -> vec3 {
    let ahead = palette[0][2].xyz
    let level = vec3(ahead.x, 0.0, ahead.z)
    if length(level) < 0.2 {
        return sway
    }
    let off = sway - normalize(level) * min(HAIR_BLOWN * going * going, HAIR_BLOWN_MOST)
    let far = length(off)
    if far > HAIR_SPRING.most { off * (HAIR_SPRING.most / far) } else { off }
}

/// `palette` with his hair's bone set: his head's, turned about the middle of his skull so
/// that his hair's mass is `off` (m) from where his head holds it (`sway::Sway::step`'s
/// answer; none: his hair goes with his head). Every palette he's drawn with goes through
/// this: his hair's vertices are on its own bone.
pub fn with_hair(palette: [mat4; 64], off: vec3) -> [mat4; 64] {
    var out = palette
    let pivot = (palette[5] * vec4(HAIR_PIVOT, 1.0)).xyz
    out[HAIR_BONE] = sway::turn_about(pivot, hair_held(palette), off) * palette[5]
    out
}
