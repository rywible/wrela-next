// This game's looks (the look owns tone, alone; style enters nowhere else).
// `Photo` is the unbloomed photographic reference look (`filmic`, used for brute-force judging);
// `Cinema` adds AgX highlight roll-off and optical HDR bloom for live gameplay and showcases.

use engine::picture::look::{Bloom, Look, Seen}
use kit::looks::curves::{agx_punchy, filmic}

/// A photographic look: light times `exposure`, through the filmic curve (zero bloom).
pub struct Photo: Copy + GpuData {
    pub spare: vec3,
    pub exposure: f32,
}

pub fn photo(exposure: f32) -> Photo {
    Photo { exposure, spare: vec3(0.0) }
}

impl Look for Photo {
    fn tone(self, seen: Seen) -> vec3 {
        filmic(seen.light * self.exposure)
    }
}

/// Cinematic gameplay look: AgX punchy highlight roll-off + gentle optical HDR bloom.
pub struct Cinema: Copy + GpuData {
    pub exposure: f32,
    pub bloom_strength: f32,
    pub bloom_threshold: f32,
    pub spare: f32,
}

pub fn cinema(exposure: f32, bloom_strength: f32 = 0.08, bloom_threshold: f32 = 1.4) -> Cinema {
    Cinema { exposure, bloom_strength, bloom_threshold, spare: 0.0 }
}

impl Look for Cinema {
    fn tone(self, seen: Seen) -> vec3 {
        agx_punchy(seen.light * self.exposure)
    }

    fn bloom(self) -> Bloom {
        Bloom {
            strength: self.bloom_strength,
            threshold: self.bloom_threshold,
            knee: 0.65,
            radius: 1.0,
        }
    }
}
