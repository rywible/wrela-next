// This game's look, for now: a photograph's. Light is exposed (how much of it makes the screen's
// middle grey) and rolled off by a filmic curve, nothing more: no tone bands, no ink, no grade.
// The look is the one place the game's style will enter (docs/design.md: the look owns tone,
// alone), so the old engine's cel bands, rim and slate (branch `backend`, lib/form/shade.wrela)
// come back here, as a look's, if the game wants them; they are not in any substance.

use engine::picture::look::{Look, Seen}
use kit::looks::curves::filmic

/// A photographic look: light times `exposure`, through the filmic curve.
pub struct Photo: Copy + GpuData {
    pub spare: vec3,
    pub exposure: f32,
}

pub fn photo(exposure: f32) -> Photo {
    Photo { exposure, spare: vec3(0.0) }
}

impl Look for Photo {
    fn tone(self, seen: Seen) -> vec3 {
        filmic(seen.light * self.exposure)
    }
}
