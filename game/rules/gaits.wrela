// The gaits this game's bodies go with. Only the walk so far: ACCAD's Male 2 walking, written as
// a cycle (`walk::WALK`) and sampled at the rate its capture was taken at, played in place.
// From branch `backend`'s game/moves/gaits.wrela (`gait`, `ARMED.walk`) on 2026-11-18, cut to the
// walk alone: the guard, the run and the lock-on gaits stay on `backend` until a scene needs them,
// and the walk's footfall marks (`playback::with_steps`) with them.

use kit::motion::playback::{Move, moved}
use rig::rig

/// The rate (frames a second) the walk's capture was sampled at: the frame time of ACCAD's
/// `Male2_B3_Walk.bvh`, as branch `backend`'s game/moves/sourced.wrela (`WALK_FPS`) wrote it.
pub const WALK_FPS: f32 = 120.000046

/// The walk, in place, on the rig it was written for (`rig::rig`).
pub fn walk() -> Move {
    let r = rig()
    moved(walk::WALK.clip(r.clone(), WALK_FPS), r)
}
