/// Each joint of each frame of the walk in its range (its body's range field at most 1 mrad
/// out, at 240 moments of a cycle), and the worst said.
@test
fn the_walk_stays_in_each_joints_range() {
    let w = walk()
    let body = world::creature::BODY
    var worst = -1.0e9
    var at = 0
    for i in 0..240 {
        let p = w.pose(w.period * f32(i) / 240.0)
        for s in 1..world::creature_segments::SEGMENTS {
            let r = body.segments[s].joint.range(body.numbers(p, s))
            if r > worst {
                worst = r
                at = s
            }
        }
    }
    std::io::print(f"the walk: the most out of range {worst} rad (segment {at})")
    assert(worst <= 0.001, f"segment {at} is {worst} rad out of its range")
}
