const HAT_OB0: vec4 = vec4(0.06235, -0.15912, -0.17646, -0.17671)
const HAT_OB1: vec4 = vec4(0.10502, -0.19188, 0.00000, 0.0)
const HAT_CENTER: vec3 = vec3(0.00117, 0.11454, -0.00853)
const HAT_EXTENT: vec3 = vec3(0.24597, 0.20749, 0.26100)
const HAT_INV_EXT: vec3 = vec3(4.06553, 4.81951, 3.83147)
const _HAT_MAX_DELTA: f32 = 0.03200

pub struct HatResidual: Copy + GpuData + Eq + StateHash {
    pub tag: u32,
}

impl ResidualEval for HatResidual {
    fn eval_sdf(self, q: vec3) -> f32 {
        siren24_sdf(q, HAT_W0, HAT_W1, HAT_B1, HAT_OW0, HAT_OB0.x)
    }
}

fn hat_substance(p: vec3) -> Substance {
    let q = (p - HAT_CENTER) * HAT_INV_EXT
    let (_, raw_albedo, _, _) = siren24_sdf_pbr(
        q,
        HAT_W0,
        HAT_W1,
        HAT_B1,
        HAT_OW,
        HAT_OB0,
        HAT_OB1,
    )
    let mod_v = clamp(0.75 + 0.50 * (raw_albedo.x + raw_albedo.y + raw_albedo.z), 0.70, 1.25)
    let r = length(p.xz)
    // Espresso leather hatband around crown base + antique brass front buckle
    let is_buckle = p.y > 0.018 && p.y < 0.062 && p.z > 0.068 && abs(p.x) < 0.024
    if is_buckle {
        return Substance {
            albedo: vec3(0.68, 0.52, 0.22),
            roughness: 0.28,
            emits: vec3(0.0),
            metallic: 0.88,
            ior: 1.5,
            transmission: 0.0,
            subsurface: 0.0,
            coat: 0.0,
            micro: 0.05,
            pad0: 0.0,
            pad1: 0.0,
            pad2: 0.0,
        }
    }
    let is_band = p.y > 0.016 && p.y < 0.058 && r < 0.135
    if is_band {
        return Substance {
            albedo: vec3(0.085, 0.048, 0.026) * mod_v,
            roughness: 0.56,
            emits: vec3(0.0),
            metallic: 0.0,
            ior: 1.5,
            transmission: 0.0,
            subsurface: 0.0,
            coat: 0.02,
            micro: 0.14,
            pad0: 0.0,
            pad1: 0.0,
            pad2: 0.0,
        }
    }
    // Deep midnight-indigo felted wool with subtle antique gold brim piping
    let gold_edge = smoothstep(0.205, 0.225, r)
    let wool = vec3(0.036, 0.048, 0.084) * mod_v
    let trim = vec3(0.58, 0.44, 0.18)
    Substance {
        albedo: mix(wool, trim, vec3(gold_edge * 0.75)),
        roughness: mix(0.88, 0.36, gold_edge * 0.75),
        emits: vec3(0.0),
        metallic: mix(0.0, 0.75, gold_edge * 0.75),
        ior: 1.46,
        transmission: 0.0,
        subsurface: 0.0,
        coat: 0.0,
        micro: 0.18,
        pad0: 0.0,
        pad1: 0.0,
        pad2: 0.0,
    }
}

pub type HatBase = SmoothUnion<Lathe<8>, RoundCone>

fn hat_base() -> HatBase {
    // True revolved wide-brimmed wizard hat silhouette (`Lathe<8>`) + bent pointed wizard tip!
    let crown_brim = lathe(
        [
            vec2(0.095, -0.012),
            vec2(0.225, -0.002),
            vec2(0.232, 0.010),
            vec2(0.115, 0.022),
            vec2(0.104, 0.068),
            vec2(0.084, 0.135),
            vec2(0.056, 0.195),
            vec2(0.025, 0.225),
        ],
        bevel: 0.004,
    )
    let tip = round_cone(
        vec3(0.0, 0.185, -0.008),
        vec3(0.025, 0.345, -0.105),
        r_top: 0.048,
        r_bottom: 0.008,
    )
    crown_brim.smooth_union(tip, k: 0.022)
}

impl ChannelEval<Substance> for HatResidual {
    fn eval_channels(self, p: vec3) -> Substance {
        hat_substance(p)
    }
}

pub type Hat = Painted<BoundedResidual<HatBase, HatResidual>, HatResidual>

/// Returns the pure `Field<Substance>` for `hat` in its canonical local frame.
pub fn hat() -> Hat {
    painted(
        bounded_residual(
            hat_base(),
            HatResidual { tag: 1 },
            center: HAT_CENTER,
            extent: HAT_EXTENT,
            max_delta: 0.008,
            lip_extra: 0.55,
        ),
        HatResidual { tag: 1 },
    )
}
