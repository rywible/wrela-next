// A cast brass candlestick (the forge's gold set; its brief and record are in
// candlestick.provenance.json): 24 cm tall, turned from cast brass with a stepped gadrooned dome
// foot, a baluster stem with twin knops, a wide drip pan and a bored candle socket with a rolled
// rim. Antique brass: burnished gold on beads and rim where hands lift it, rich bronze in coves.
//
// Stands with its foot at y = 0 on its axis.

use kit::shapes::craft::{Craft, MotifOps, lathe, pt}
use kit::shapes::made::Asset
use kit::shapes::ornament::lobe
use kit::substances::brass::brass
use std::math::TAU
use std::units::{cm, mm}

pub const GADROONS: u32 = 16
pub const GADROON_SPAN = vec2(1.8cm, 4.3cm)
pub const GADROON_RELIEF: f32 = 1.5mm
pub const KNOCKS = vec3(2.4cm, 3.2mm, 0.06mm)

/// The turned brass candlestick, its domed base gadrooned with sixteen lobes.
pub fn stick() -> Craft {
    let r = 3.6cm
    let lobes = lobe(
        length: GADROON_SPAN.y - GADROON_SPAN.x,
        width: 0.88 * TAU * r / f32(GADROONS),
        height: GADROON_RELIEF,
        belly: 0.42,
    ).around(GADROONS, radius: r, wander: 0.12)

    lathe(
        [
            pt(vec2(55mm, 0mm), bow: 2.5mm),
            pt(vec2(56mm, 6mm), bow: -1mm),
            pt(vec2(50mm, 11mm), bow: 1.5mm),
            pt(vec2(46mm, 16mm), bow: 6mm),
            pt(vec2(22mm, 45mm), bow: -2mm),
            pt(vec2(12mm, 60mm), bow: 3mm),
            pt(vec2(16mm, 68mm), bow: -1.5mm),
            pt(vec2(9mm, 76mm), bow: 4mm),
            pt(vec2(11mm, 110mm), bow: 6mm),
            pt(vec2(18mm, 130mm), bow: -4mm),
            pt(vec2(10mm, 150mm), bow: 2.5mm),
            pt(vec2(14mm, 158mm), bow: -1.5mm),
            pt(vec2(9mm, 166mm)),
            pt(vec2(9mm, 180mm), bow: -4mm),
            pt(vec2(40mm, 188mm), bow: 2.5mm),
            pt(vec2(42mm, 194mm), bow: -3mm),
            pt(vec2(16mm, 197mm)),
            pt(vec2(15mm, 232mm), bow: 1.2mm),
            pt(vec2(13.5mm, 238mm), bow: 0.8mm),
            pt(vec2(10.5mm, 236mm)),
            pt(vec2(10.5mm, 200mm)),
            pt(vec2(0mm, 200mm)),
        ],
    ).carve_round(
        from: GADROON_SPAN.x,
        to: GADROON_SPAN.y,
        radius: r,
        inner: 2cm,
        motif: lobes,
        ground: GADROON_RELIEF,
    )
}

/// The candlestick in its antique burnished cast brass.
pub fn candlestick() -> Asset {
    stick()
        .named_piece(0, "stick")
        .worn_dings(spacing: KNOCKS.x, radius: KNOCKS.y, depth: KNOCKS.z, seed: 3)
        .in_material(brass(tarnish: 0.62, verdigris: 0.06, seed: 3.0))
}
