// A brass candlestick (the forge's gold set; its brief and record are in
// candlestick.provenance.json): 24 cm tall, turned from cast brass: a stepped round foot with a
// bead at its edge, a domed base, a baluster stem with two knops, a drip pan to catch the wax, and
// a socket bored 2 cm across for the candle, its rim rolled. Old brass: bright on the beads and the
// rim where it is lifted and polished, brown in the coves.
//
// It stands with its foot at y = 0 on its axis. Every number is a length in metres.

use kit::shapes::carve::{Carved, RoundFace, carved, round_face}
use kit::shapes::made::{Dressed, Piece, dressed, piece}
use kit::shapes::making::{Turned, turned}
use kit::shapes::ornament::{Lobe, Row, lobe, row}
use kit::substances::brass::{Brass, brass}

/// Its profile, (radius, height), from the foot's edge up the outside, over the socket's rolled
/// rim and down inside the socket to its floor, which the profile closes along the axis.
pub const PROFILE = [
    vec2(0.055, 0.0),
    vec2(0.056, 0.006),
    vec2(0.05, 0.011),
    vec2(0.046, 0.016),
    vec2(0.022, 0.045),
    vec2(0.012, 0.06),
    vec2(0.016, 0.068),
    vec2(0.009, 0.076),
    vec2(0.011, 0.11),
    vec2(0.018, 0.13),
    vec2(0.01, 0.15),
    vec2(0.014, 0.158),
    vec2(0.009, 0.166),
    vec2(0.009, 0.18),
    vec2(0.04, 0.188),
    vec2(0.042, 0.194),
    vec2(0.016, 0.197),
    vec2(0.015, 0.232),
    vec2(0.0135, 0.238),
    vec2(0.0105, 0.236),
    vec2(0.0105, 0.2),
    vec2(0.0, 0.2),
]
pub const BOWS = [
    0.0025, -0.001, 0.0015, 0.006, -0.002, 0.003, -0.0015, 0.004, 0.006, -0.004, 0.0025, -0.0015,
    0.0, -0.004, 0.0025, -0.003, 0.0, 0.0012, 0.0008, 0.0, 0.0, 0.0,
]

/// The domed base's gadrooning: sixteen lobes round it from 1.6 cm to 4.5 cm up, 1.5 mm proud.
pub const GADROONS: u32 = 16
pub const GADROON_SPAN = vec2(0.017, 0.044)
pub const GADROON_RELIEF: f32 = 0.0015

pub type Stick = Carved<Turned<22>, RoundFace, Row<Lobe>>

pub type Candlestick = Dressed<Piece<Stick>, Brass>

/// The candlestick's turning, its base gadrooned.
pub fn stick() -> Stick {
    let r = 0.036
    let lobes = row(
        lobe(
            length: GADROON_SPAN.y - GADROON_SPAN.x,
            width: 0.9 * 6.2831853 * r / f32(GADROONS),
            height: GADROON_RELIEF,
            belly: 0.4,
        ),
        period: 6.2831853 * r / f32(GADROONS),
    )
    carved(
        turned(PROFILE, BOWS),
        round_face(radius: r, base: GADROON_SPAN.x, inner: 0.02),
        lobes,
        ground: GADROON_RELIEF,
        region: vec4(-1.0, 0.0, 1.0, GADROON_SPAN.y - GADROON_SPAN.x),
    )
}

/// The candlestick in its brass.
pub fn candlestick() -> Candlestick {
    dressed(piece(0, "stick", stick()), brass(tarnish: 0.6, verdigris: 0.05, seed: 3.0))
}
