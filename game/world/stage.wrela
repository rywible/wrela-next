// A stage to light things on, the volume spike's light test (spike/volume, spikes/volume/
// stage.wrela): a ground slab 16 m square, a wall 6 m long, 3 m tall and 20 cm thick standing on
// it with the sun on one side, and a ball a metre round that casts a shadow. The wall stands on
// the ground face to face, so the joined field has a sheet of nought inside them where they meet
// (the buried contact face, which is not a surface), and the ground's top lies on whole metres:
// both bit the spike, so the stage keeps them.

use engine::matter::substance::Substance
use engine::matter::verify::verify_field_soundness
use kit::substances::matte::matte
use std::field::{Cuboid, Sphere, Translate, Union, With, cuboid, sphere}

/// The wall's half thickness (m): 20 cm through.
pub const WALL_HALF: f32 = 0.1

/// The ground's albedo (weathered concrete), the wall's (red brick), the ball's (pale blue paint).
pub const CONCRETE: vec3 = vec3(0.36, 0.35, 0.33)
pub const BRICK: vec3 = vec3(0.42, 0.17, 0.11)
pub const PAINT: vec3 = vec3(0.33, 0.42, 0.55)

pub type Block = With<Translate<Cuboid>, Substance>

pub type Ball = With<Translate<Sphere>, Substance>

pub type Stage = Union<Union<Block, Block>, Ball>

/// The stage: the ground's top at y = 0, the wall across x on it, the ball off the wall's end.
pub fn stage() -> Stage {
    let ground = cuboid(vec3(8.0, 0.25, 8.0)).translate(vec3(0.0, -0.25, 0.0)).with(matte(CONCRETE))
    let wall = cuboid(vec3(3.0, 1.5, WALL_HALF)).translate(vec3(0.0, 1.5, 0.0)).with(matte(BRICK))
    let ball = sphere(1.0).translate(vec3(-4.5, 1.0, 3.0)).with(matte(PAINT))
    ground.union(wall).union(ball)
}

@test
fn stage_field_contracts_are_sound() {
    verify_field_soundness(stage(), "stage")
}
