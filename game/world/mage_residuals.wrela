const MTORSO_OB0: vec4 = vec4(-0.28881, -0.15129, -0.16381, -0.16317)
const MTORSO_OB1: vec4 = vec4(0.12398, -0.19808, 0.0, 0.0)

pub const MTORSO_CENTER_LOCAL: vec3 = vec3(0.00000, -0.01800, -0.00400)
pub const MTORSO_EXTENT: vec3 = vec3(0.24000, 0.38000, 0.18000)
pub const MTORSO_INV_EXT: vec3 = vec3(4.16667, 2.63158, 5.55556)
pub const MTORSO_MAX_DELTA: f32 = 0.026

pub struct MageTorsoResidual: Copy + GpuData + Eq + StateHash {
    pub tag: u32,
}

impl ResidualEval for MageTorsoResidual {
    fn eval_sdf(self, q: vec3) -> f32 {
        siren24_sdf(q, MTORSO_W0, MTORSO_W1, MTORSO_B1, MTORSO_OW0, MTORSO_OB0.x)
    }
}

impl ChannelEval<Substance> for MageTorsoResidual {
    fn eval_channels(self, p_local: vec3) -> Substance {
        mage_torso_substance(p_local)
    }
}

pub fn mage_torso_substance(p_local: vec3) -> Substance {
    let q = (p_local - MTORSO_CENTER_LOCAL) * MTORSO_INV_EXT
    let (_, raw_albedo, _, _) = siren24_sdf_pbr(
        q,
        MTORSO_W0,
        MTORSO_W1,
        MTORSO_B1,
        MTORSO_OW,
        MTORSO_OB0,
        MTORSO_OB1,
    )
    let shade = clamp(0.78 + 0.45 * (raw_albedo.x + raw_albedo.y + raw_albedo.z), 0.72, 1.25)
    // Espresso leather waist belt (y around -0.22..-0.14 in SPINE_2 local coords) + brass front buckle
    let is_buckle = p_local.y > -0.215 && p_local.y < -0.155 && p_local.z > 0.075 && abs(p_local.x) < 0.032
    if is_buckle {
        return Substance {
            albedo: vec3(0.68, 0.52, 0.22),
            roughness: 0.28,
            emits: vec3(0.0),
            metallic: 0.88,
            ior: 1.5,
            transmission: 0.0,
            subsurface: 0.0,
            coat: 0.0,
            micro: 0.05,
            pad0: 0.0,
            pad1: 0.0,
            pad2: 0.0,
        }
    }
    let is_belt = p_local.y > -0.22 && p_local.y < -0.15
    if is_belt {
        return Substance {
            albedo: vec3(0.08, 0.045, 0.025) * shade,
            roughness: 0.56,
            emits: vec3(0.0),
            metallic: 0.0,
            ior: 1.5,
            transmission: 0.0,
            subsurface: 0.0,
            coat: 0.02,
            micro: 0.14,
            pad0: 0.0,
            pad1: 0.0,
            pad2: 0.0,
        }
    }
    // Tailored midnight-navy wool scholar tunic with crisp antique gold center placket & collar ring
    let collar_r = length(p_local.xz)
    let is_trim = (p_local.z > 0.04 && abs(p_local.x) < 0.014 && p_local.y > -0.15) ||
        (p_local.y > 0.258 && collar_r < 0.095)
    if is_trim {
        return Substance {
            albedo: vec3(0.62, 0.47, 0.20) * shade,
            roughness: 0.34,
            emits: vec3(0.0),
            metallic: 0.78,
            ior: 1.5,
            transmission: 0.0,
            subsurface: 0.0,
            coat: 0.0,
            micro: 0.08,
            pad0: 0.0,
            pad1: 0.0,
            pad2: 0.0,
        }
    }
    Substance {
        albedo: vec3(0.042, 0.060, 0.098) * shade,
        roughness: 0.86,
        emits: vec3(0.0),
        metallic: 0.0,
        ior: 1.46,
        transmission: 0.0,
        subsurface: 0.0,
        coat: 0.0,
        micro: 0.16,
        pad0: 0.0,
        pad1: 0.0,
        pad2: 0.0,
    }
}
