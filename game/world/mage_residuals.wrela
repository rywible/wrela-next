const MHEAD_OB0: vec4 = vec4(-0.20648, -0.09388, -0.13283, -0.14561)
const MHEAD_OB1: vec4 = vec4(0.10507, -0.18815, 0.0, 0.0)

pub const MHEAD_CENTER_LOCAL: vec3 = vec3(0.00000, 0.06500, 0.01200)
pub const MHEAD_EXTENT: vec3 = vec3(0.13000, 0.13500, 0.14500)
pub const MHEAD_INV_EXT: vec3 = vec3(7.69231, 7.40741, 6.89655)
pub const MHEAD_MAX_DELTA: f32 = 0.022

pub struct MageHeadResidual: Copy + GpuData + Eq + StateHash {
    pub tag: u32,
}

impl ResidualEval for MageHeadResidual {
    fn eval_sdf(self, q: vec3) -> f32 {
        siren24_sdf(q, MHEAD_W0, MHEAD_W1, MHEAD_B1, MHEAD_OW0, MHEAD_OB0.x)
    }
}

impl ChannelEval<Substance> for MageHeadResidual {
    fn eval_channels(self, p_local: vec3) -> Substance {
        mage_head_substance(p_local)
    }
}

pub fn mage_head_substance(p_local: vec3) -> Substance {
    let q = (p_local - MHEAD_CENTER_LOCAL) * MHEAD_INV_EXT
    let (_, raw_albedo, _, _) = siren24_sdf_pbr(
        q,
        MHEAD_W0,
        MHEAD_W1,
        MHEAD_B1,
        MHEAD_OW,
        MHEAD_OB0,
        MHEAD_OB1,
    )
    // Smooth organic cranial hairline & contoured beard (zero box cutoffs!) modulated by
    // TripoSG-fitted SIREN-24 facial shading.
    let shade = clamp(0.78 + 0.42 * (raw_albedo.x + raw_albedo.y + raw_albedo.z), 0.74, 1.20)
    // Back & crown of head hair curve smoothly forward over temples
    let hair_line = p_local.y - 0.118 + 0.42 * p_local.z - 0.28 * abs(p_local.x)
    let back_hair = -p_local.z - 0.012 + 0.35 * abs(p_local.x)
    let w_hair = clamp(max(smoothstep(-0.012, 0.012, hair_line), smoothstep(-0.012, 0.014, back_hair)), 0.0, 1.0)
    // Contoured scholar's beard along lower jaw & chin
    let jaw_curve = (0.036 - p_local.y) - 0.18 * p_local.z * p_local.z - 0.45 * abs(p_local.x) * abs(p_local.x)
    let w_beard = smoothstep(-0.010, 0.010, jaw_curve) * smoothstep(-0.015, 0.025, p_local.z)
    let w_dark = clamp(max(w_hair, w_beard), 0.0, 1.0)
    // Subtle eyebrows & eye sockets on front face
    let eye_l = length(vec2((p_local.x - 0.030) * 1.4, (p_local.y - 0.078) * 2.2))
    let eye_r = length(vec2((p_local.x + 0.030) * 1.4, (p_local.y - 0.078) * 2.2))
    let eye_w = (1.0 - smoothstep(0.012, 0.024, min(eye_l, eye_r))) * smoothstep(0.04, 0.07, p_local.z)
    let skin_col = vec3(0.47, 0.28, 0.19) * shade * (1.0 - 0.48 * eye_w)
    let hair_col = vec3(0.055, 0.040, 0.030) * shade
    Substance {
        albedo: mix(skin_col, hair_col, vec3(w_dark)),
        roughness: mix(0.50, 0.74, w_dark),
        emits: vec3(0.0),
        metallic: 0.0,
        ior: 1.45,
        transmission: 0.0,
        subsurface: 0.26 * (1.0 - w_dark),
        coat: 0.0,
        micro: mix(0.04, 0.14, w_dark),
        pad0: 0.0,
        pad1: 0.0,
        pad2: 0.0,
    }
}

