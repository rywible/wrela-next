// Ocean swells (`Height`): the sea's surface as three sines running across it. Each scene's sea is
// its own `Height` (`SCENE=9`'s round the stage, the arena's below its dais) that gives `swells`
// its own numbers, as literals, so they fold into its shaders.

use engine::matter::height::HeightSample
use kit::substances::pbr::water

/// The sea at `xz`, `t` s in: three swells over a still `level` (m), each its phase's rate across
/// x and z (rad/m, `xy`) and in time (rad/s, `z`), and how high it stands (m, `w`); its water `tint`
/// and `roughness`. The swells cross one another: the first runs toward -x and -z, the second
/// toward -x and +z, the third toward -x and +z.
pub fn swells(
    xz: vec2,
    t: f32,
    a: vec4,
    b: vec4,
    c: vec4,
    level: f32,
    tint: vec3,
    roughness: f32,
) -> HeightSample {
    let pa = xz.x * a.x + xz.y * a.y + t * a.z
    let pb = xz.x * -b.x + xz.y * b.y - t * b.z
    let pc = xz.x * c.x - xz.y * c.y + t * c.z
    let y = level + a.w * sin(pa) + b.w * sin(pb) + c.w * sin(pc)
    let dx = a.w * a.x * cos(pa) - b.w * b.x * cos(pb) + c.w * c.x * cos(pc)
    let dz = a.w * a.y * cos(pa) + b.w * b.y * cos(pb) - c.w * c.y * cos(pc)
    HeightSample {
        y,
        normal: normalize(vec3(-dx, 1.0, -dz)),
        sub: water(tint: tint, roughness: roughness),
    }
}
