// A grimoire (the forge's first showcase, with the table; its brief and provenance are in
// grimoire.provenance.json): a heavy old book 26 cm tall, 19 cm wide and 7 cm thick, bound in
// brown calf over wooden boards, its spine rounded and raised in four bands over the cords it was
// sewn on, its covers tooled blind with a border and a lozenge, its fore-edge corners sheathed in
// brass, a turned brass boss at the middle of its front cover, and its pages swelling a little,
// yellowed and foxed at their edges, the gatherings showing on the fore-edge.
//
// The book lies on its back cover, closed, its middle at the origin: its spine toward minus x,
// its fore-edge toward plus x, its head toward minus z. Every number is a length in metres and
// belongs to a named part.

use kit::shapes::carve::{Carved, DrapedFace, carved, draped_face}
use kit::shapes::made::{Dressed, Piece, dressed, piece}
use kit::shapes::making::{
    Board, Both, Extruded, Folded, Grown, Placed, Sheathed, Turned, board, both, extruded,
    folded_across, grown, placed, running_z, sheathed, turned, turned_y,
}
use kit::shapes::ornament::{Lobe, Rosette, Row, Set, lobe, rosette, row, set}
use kit::shapes::carve::{Cuts, cuts, groove}
use kit::substances::brass::{Brass, brass}
use kit::substances::leather::{Leather, leather}
use kit::substances::paper::{Paper, paper}
use std::field::{Union}

/// The book's width (spine to fore-edge), height (head to tail) and thickness.
pub const WIDTH: f32 = 0.19
pub const HEIGHT: f32 = 0.26
pub const THICK: f32 = 0.07

/// A board's thickness, the leather's over it, and how far the boards stand out past the pages
/// (the squares).
pub const BOARD: f32 = 0.005
pub const SKIN: f32 = 0.0012
pub const SQUARE: f32 = 0.004

// ---- the covers ---------------------------------------------------------------------------------

/// A board, its edges eased (as leather turned over it rounds them), from the spine's joint to
/// the fore-edge.
pub const JOINT: f32 = 0.012

pub type Covers = Folded<Placed<Board>>

/// The boards, front and back, each at its face of the book.
pub fn boards() -> Covers {
    let half = vec3(0.5 * (WIDTH - JOINT), 0.5 * BOARD, 0.5 * HEIGHT)
    let at = vec3(0.5 * JOINT, 0.5 * THICK - SKIN - 0.5 * BOARD, 0.0)
    folded_across(placed(board(half, round: 0.0015), at: at), y: true)
}

/// The blind tooling on each cover: a border 12 mm in from the board's edges, a lozenge between
/// its sides' middles, and the crease along the joint where the cover bends: lines pressed 0.5 mm
/// into the leather by a fillet 1 mm round.
pub const TOOL_DEPTH: f32 = 0.0005
pub const TOOL_RADIUS: f32 = 0.001
pub const BORDER: f32 = 0.012

pub type Tooling = Cuts<9>

/// The tooling's lines on a cover face, in (s across from the spine's joint, t down from the
/// head).
pub fn tooling() -> Tooling {
    let w = WIDTH - JOINT
    let a = vec2(BORDER, -0.5 * HEIGHT + BORDER)
    let b = vec2(w - BORDER, 0.5 * HEIGHT - BORDER)
    let m = 0.5 * (a + b)
    let cut = |p: vec2, q: vec2| groove(p, q, depth: TOOL_DEPTH, tool: TOOL_RADIUS)
    cuts(
        [
            // The border.
            cut(vec2(a.x, a.y), vec2(b.x, a.y)),
            cut(vec2(b.x, a.y), vec2(b.x, b.y)),
            cut(vec2(b.x, b.y), vec2(a.x, b.y)),
            cut(vec2(a.x, b.y), vec2(a.x, a.y)),
            // The lozenge.
            cut(vec2(m.x, a.y), vec2(b.x, m.y)),
            cut(vec2(b.x, m.y), vec2(m.x, b.y)),
            cut(vec2(m.x, b.y), vec2(a.x, m.y)),
            cut(vec2(a.x, m.y), vec2(m.x, a.y)),
            // The joint's crease, the length of the book.
            groove(
                vec2(-0.004, -0.5 * HEIGHT),
                vec2(-0.004, 0.5 * HEIGHT),
                depth: 0.0008,
                tool: 0.0025,
            ),
        ],
    )
}

pub type Covered = Folded<Carved<Grown<Placed<Board>>, DrapedFace, Tooling>>

/// The leather over the front board, tooled, and the back's the same (the book's two faces).
pub fn covers() -> Covered {
    let half = vec3(0.5 * (WIDTH - JOINT), 0.5 * BOARD, 0.5 * HEIGHT)
    let y = 0.5 * THICK - SKIN - 0.5 * BOARD
    let front = grown(placed(board(half, round: 0.0015), at: vec3(0.5 * JOINT, y, 0.0)), by: SKIN)
    // Its face: s across from the joint toward the fore-edge, t from head to tail.
    let face = draped_face(
        vec3(-0.5 * WIDTH + JOINT, 0.5 * THICK, 0.0),
        s: vec3(1.0, 0.0, 0.0),
        t: vec3(0.0, 0.0, 1.0),
    )
    let region = vec4(-0.01, -0.5 * HEIGHT, WIDTH, 0.5 * HEIGHT)
    folded_across(carved(front, face, tooling(), ground: 0.0, region: region), y: true)
}

// ---- the spine ----------------------------------------------------------------------------------

/// The spine in section, (out from the book's middle toward the spine, height): from the joints
/// round its back, which bows out 8 mm.
pub const SPINE_SECTION = [
    vec2(0.5 * WIDTH - 0.014, -0.5 * THICK),
    vec2(0.5 * WIDTH - 0.002, -0.5 * THICK),
    vec2(0.5 * WIDTH - 0.002, 0.5 * THICK),
    vec2(0.5 * WIDTH - 0.014, 0.5 * THICK),
]
pub const SPINE_BOWS = [0.0, 0.008, 0.0, 0.0]

/// Its four raised bands over the cords, 8 mm across and 2.2 mm proud, 5.5 cm apart.
pub const BANDS: u32 = 4
pub const BAND_GAP: f32 = 0.055
pub const BAND = vec2(0.008, 0.0022)

pub type Spine = Carved<Placed<Extruded<4>>, DrapedFace, Set<Row<Lobe>>>

/// The spine: its back, rounded, the leather moulded over its bands.
pub fn spine() -> Spine {
    let back = placed(
        extruded(SPINE_SECTION, SPINE_BOWS, length: HEIGHT + 2.0 * SKIN),
        at: vec3(0.0),
        axes: running_z(),
    )
    // Its face: s along the spine (head to tail), t round it (bottom to top); the bands across.
    let face = draped_face(
        vec3(-0.5 * WIDTH, -0.5 * THICK, 0.0),
        s: vec3(0.0, 0.0, 1.0),
        t: vec3(0.0, 1.0, 0.0),
    )
    let bands = set(
        row(
            lobe(length: THICK, width: BAND.x, height: BAND.y, belly: 0.5),
            period: BAND_GAP,
            count: BANDS,
        ),
        at: vec2(0.0, 0.0),
    )
    carved(
        back,
        face,
        bands,
        ground: BAND.y,
        region: vec4(-0.5 * HEIGHT, -0.01, 0.5 * HEIGHT, THICK + 0.01),
    )
}

// ---- the pages ----------------------------------------------------------------------------------

/// The text block in section, (in toward the spine, height): from its fore-edge, hollowed 3 mm as
/// a rounded-and-backed book's is, to its back inside the spine; its faces swelling 0.8 mm where
/// the leaves have cockled.
pub const PAGES = vec2(0.5 * THICK - BOARD - SKIN - 0.0005, 0.5 * HEIGHT - SQUARE)
pub const FORE_EDGE: f32 = 0.5 * WIDTH - SQUARE

pub type Pages = Placed<Extruded<4>>

/// The text block.
pub fn pages() -> Pages {
    let fore = -FORE_EDGE
    let back = 0.5 * WIDTH - 0.008
    let h = PAGES.x
    let section = [vec2(fore, -h), vec2(back, -h), vec2(back, h), vec2(fore, h)]
    let bows = [-0.0008, 0.004, -0.0008, -0.003]
    placed(extruded(section, bows, length: 2.0 * PAGES.y), at: vec3(0.0), axes: running_z())
}

// ---- the brass ----------------------------------------------------------------------------------

/// The corners: brass 1.2 mm thick folded over the board's corner, reaching 3.2 cm along each
/// edge from it, cut square across.
pub const CORNER_REACH: f32 = 0.032
pub const CORNER_THICK: f32 = 0.0012

pub type Corners = Folded<Sheathed<Grown<Placed<Board>>, Placed<Board>>>

/// The corners over the fore-edge's corners, front and back covers, head and tail.
pub fn corners() -> Corners {
    let half = vec3(0.5 * (WIDTH - JOINT), 0.5 * BOARD, 0.5 * HEIGHT)
    let y = 0.5 * THICK - SKIN - 0.5 * BOARD
    let cover = grown(placed(board(half, round: 0.0015), at: vec3(0.5 * JOINT, y, 0.0)), by: SKIN)
    // The region: a square turned 45° about the corner, its diagonal reaching in along each edge.
    let d = CORNER_REACH * 0.70710678
    let region = placed(
        board(vec3(d, 0.02, d), round: 0.001),
        at: vec3(0.5 * WIDTH, y, 0.5 * HEIGHT),
        axes: turned_y(0.78539816),
    )
    folded_across(sheathed(cover, thick: CORNER_THICK, region: region), y: true, z: true)
}

/// The boss: a turned brass dome 4.4 cm across and 7 mm high on a bead, its top cut with a
/// rosette of eight petals.
pub const BOSS_PROFILE = [
    vec2(0.022, 0.0),
    vec2(0.022, 0.0025),
    vec2(0.018, 0.004),
    vec2(0.0, 0.0072),
]
pub const BOSS_BOWS = [0.0, 0.001, 0.003, 0.0]

pub type Boss = Carved<Placed<Turned<4>>, DrapedFace, Rosette>

/// The boss at the middle of the front cover's panel.
pub fn boss() -> Boss {
    let at = vec3(0.5 * JOINT + 0.005, 0.5 * THICK - 0.0005, 0.0)
    let dome = placed(turned(BOSS_PROFILE, BOSS_BOWS), at: at)
    let face = draped_face(at, s: vec3(1.0, 0.0, 0.0), t: vec3(0.0, 0.0, -1.0))
    carved(
        dome,
        face,
        rosette(radius: 0.017, petals: 8, height: 0.0012),
        ground: 0.0012,
        region: vec4(-0.017, -0.017, 0.017, 0.017),
    )
}

// ---- the book -----------------------------------------------------------------------------------

/// The pieces: its leather, its paper, its brass.
pub const PIECE_LEATHER: u32 = 0
pub const PIECE_PAGES: u32 = 1
pub const PIECE_BRASS: u32 = 2

pub type Binding = Dressed<Both<Piece<Covered>, Piece<Spine>>, Leather>

pub type Leaves = Dressed<Piece<Pages>, Paper>

pub type Fittings = Dressed<Both<Piece<Corners>, Piece<Boss>>, Brass>

pub type Grimoire = Union<Union<Binding, Leaves>, Fittings>

/// The grimoire, in its leather, paper and brass.
pub fn grimoire() -> Grimoire {
    let binding = dressed(
        both(piece(PIECE_LEATHER, "covers", covers()), piece(PIECE_LEATHER, "spine", spine())),
        leather(),
    )
    let leaves = dressed(piece(PIECE_PAGES, "pages", pages()), paper(stack: vec3(0.0, 1.0, 0.0)))
    let fittings = dressed(
        both(piece(PIECE_BRASS, "corners", corners()), piece(PIECE_BRASS, "boss", boss())),
        brass(),
    )
    binding.union(leaves).union(fittings)
}
