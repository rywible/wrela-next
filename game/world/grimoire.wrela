// A grimoire (the forge's first showcase, with the table; its brief and provenance are in
// grimoire.provenance.json): a heavy old tome 26 cm tall, 19 cm wide and 7 cm thick, bound in
// deep antique oxblood-chestnut calfskin over wooden boards, its rounded spine wrapped cleanly
// with four raised cord bands and sewn head/tail endbands, its covers stamped with double-fillet
// borders, corner diagonals and a central lozenge holding traces of worn gold leaf, its fore-edge
// corners clad in riveted brass mounts, two hinged brass clasps locking the fore-edge, a sculpted
// brass rosette boss at the front cover's heart, and deckled rag-paper gatherings swelling inside.
//
// The book lies closed on its back cover, centred on the origin: spine toward -x, fore-edge
// toward +x, head toward -z. Every number carries its physical unit and belongs to a named part.

use kit::shapes::carve::{Cuts, cuts, draped_face, groove}
use kit::shapes::craft::{Craft, MotifOps, lathe, pt, rail}
use kit::shapes::made::Asset
use kit::shapes::making::{board, running_z}
use kit::shapes::ornament::rosette
use kit::substances::brass::brass
use kit::substances::leather::leather
use kit::substances::paper::paper
use std::units::{cm, mm}

/// Overall book dimensions (spine-to-fore-edge width, head-to-tail height, total thickness).
pub const WIDTH: f32 = 19cm
pub const HEIGHT: f32 = 26cm
pub const THICK: f32 = 7cm

/// Wooden board thickness, leather turn-in thickness, board overhang past the pages (squares),
/// and the French-groove hinge width beside the spine.
pub const BOARD: f32 = 5mm
pub const SKIN: f32 = 1.2mm
pub const SQUARE: f32 = 4mm
pub const JOINT: f32 = 1.1cm

// ---- the leather covers -------------------------------------------------------------------------

pub const TOOL_DEPTH: f32 = 0.5mm
pub const TOOL_RADIUS: f32 = 1.1mm
pub const BORDER: f32 = 1.1cm
pub const INNER_BORDER: f32 = 1.8cm

/// Blind- and gold-tooled frame, central lozenge and French-groove hinge crease stamped into each
/// cover (lean 9-groove set so distance evaluation stays fast across all audit and runtime passes).
pub fn tooling() -> Cuts<9> {
    let w = WIDTH - JOINT
    let a = vec2(BORDER, -0.5 * HEIGHT + BORDER)
    let b = vec2(w - BORDER, 0.5 * HEIGHT - BORDER)
    let m = 0.5 * (a + b)
    let cut = |p: vec2, q: vec2| groove(p, q, depth: TOOL_DEPTH, tool: TOOL_RADIUS)
    cuts(
        [
            // Outer fillet frame.
            cut(vec2(a.x, a.y), vec2(b.x, a.y)),
            cut(vec2(b.x, a.y), vec2(b.x, b.y)),
            cut(vec2(b.x, b.y), vec2(a.x, b.y)),
            cut(vec2(a.x, b.y), vec2(a.x, a.y)),
            // Central lozenge touching the frame's midpoints.
            cut(vec2(m.x, a.y), vec2(b.x, m.y)),
            cut(vec2(b.x, m.y), vec2(m.x, b.y)),
            cut(vec2(m.x, b.y), vec2(a.x, m.y)),
            cut(vec2(a.x, m.y), vec2(m.x, a.y)),
            // French-groove joint crease running head to tail where the cover opens.
            groove(
                vec2(-3mm, -0.5 * HEIGHT),
                vec2(-3mm, 0.5 * HEIGHT),
                depth: 0.7mm,
                tool: 2.4mm,
            ),
        ],
    )
}

/// One leather-wrapped board (front), mirrored cleanly across y = 0 for the back cover.
fn front_cover_raw() -> Craft {
    let half = vec3(0.5 * (WIDTH - JOINT), 0.5 * BOARD, 0.5 * HEIGHT)
    let y = 0.5 * THICK - SKIN - 0.5 * BOARD
    board(half, round: 1.5mm).at(vec3(0.5 * JOINT, y, 0.0)).wrapped(SKIN)
}

/// Front and back leather covers, blind- and gold-tooled.
pub fn covers() -> Craft {
    let face = draped_face(
        vec3(-0.5 * WIDTH + JOINT, 0.5 * THICK, 0.0),
        s: vec3(1.0, 0.0, 0.0),
        t: vec3(0.0, 0.0, 1.0),
    )
    let region = vec4(-8mm, -0.5 * HEIGHT, WIDTH, 0.5 * HEIGHT)
    front_cover_raw()
        .carve(face, tooling(), ground: 0.0, region: region)
        .mirrored_across(y: true)
}

// ---- the rounded spine & raised cord bands ------------------------------------------------------

pub const BAND_Z1: f32 = 3.0cm
pub const BAND_Z2: f32 = 8.4cm
pub const BAND_HALF_W: f32 = 2.8mm
pub const BAND_PROUD: f32 = 1.8mm

/// One raised leather cord band wrapping tightly along the rounded spine curve at `z = ±z_off`
/// (tucked inside the spine height so it reads as a sewn cord under leather, never protruding
/// past the top/bottom cover corners).
fn spine_band(z_off: f32) -> Craft {
    board(vec3(4.2mm, 0.5 * THICK - 7.5mm, BAND_HALF_W), round: 2.5mm)
        .at(vec3(-0.5 * WIDTH - 0.6mm, 0.0, z_off))
        .mirrored_across(z: true)
}

/// The continuous rounded leather spine overlapping cleanly into the boards' joints, crowned by
/// four raised sewing-cord bands (zero abrupt box cuts at head or tail).
pub fn spine() -> Craft {
    let h = 0.5 * THICK - 0.8mm
    let x_in = 0.5 * WIDTH - JOINT - 3mm
    let x_out = 0.5 * WIDTH - 1mm
    let section = [
        pt(vec2(x_in, -h)),
        pt(vec2(x_out, -h), bow: 8mm),
        pt(vec2(x_out, h)),
        pt(vec2(x_in, h)),
    ]
    let back = rail(section, length: HEIGHT + 2.0 * SKIN)
        .wrapped(0.8mm)
        .at(vec3(0.0), axes: running_z())
    back.with_part(spine_band(BAND_Z1)).with_part(spine_band(BAND_Z2))
}

// ---- the deckled text block ---------------------------------------------------------------------

pub const PAGES = vec2(0.5 * THICK - BOARD - SKIN - 0.5mm, 0.5 * HEIGHT - SQUARE)
pub const FORE_EDGE: f32 = 0.5 * WIDTH - SQUARE

/// The sewn rag-paper text block: hollowed 3 mm at the fore-edge and gently cockled at its faces.
pub fn pages() -> Craft {
    let fore = -FORE_EDGE
    let back = 0.5 * WIDTH - 8mm
    let h = PAGES.x
    let section = [
        pt(vec2(fore, -h), bow: -0.8mm),
        pt(vec2(back, -h), bow: 4mm),
        pt(vec2(back, h), bow: -0.8mm),
        pt(vec2(fore, h), bow: -3mm),
    ]
    rail(section, length: 2.0 * PAGES.y).at(vec3(0.0), axes: running_z())
}

// ---- the brass corners, clasps & central rosette boss -------------------------------------------

pub const CORNER_REACH: f32 = 3.4cm
pub const CORNER_THICK: f32 = 1.3mm

/// Riveted medieval L-bracket brass corner guards folded cleanly over all four fore-edge corners
/// (axis-aligned arms with zero diagonal voxel staircasing, anchored by twin domed brass rivets).
pub fn corners() -> Craft {
    let y = 0.5 * THICK - SKIN - 0.5 * BOARD
    let arm_len = CORNER_REACH
    let arm_w = 1.45cm
    let arm_x = board(vec3(0.5 * arm_len, 2cm, 0.5 * arm_w), round: 1.4mm)
        .at(vec3(0.5 * WIDTH - 0.5 * arm_len + 2mm, y, 0.5 * HEIGHT - 0.5 * arm_w + 2mm))
    let arm_z = board(vec3(0.5 * arm_w, 2cm, 0.5 * arm_len), round: 1.4mm)
        .at(vec3(0.5 * WIDTH - 0.5 * arm_w + 2mm, y, 0.5 * HEIGHT - 0.5 * arm_len + 2mm))
    let region = arm_x.with_part(arm_z)
    let guard = front_cover_raw().clad(thick: CORNER_THICK, region: region)
    let pin_x = board(vec3(1.8mm, 1.3mm, 1.8mm), round: 1.2mm)
        .at(vec3(0.5 * WIDTH - 2.3cm, 0.5 * THICK + CORNER_THICK, 0.5 * HEIGHT - 0.65cm))
    let pin_z = board(vec3(1.8mm, 1.3mm, 1.8mm), round: 1.2mm)
        .at(vec3(0.5 * WIDTH - 0.65cm, 0.5 * THICK + CORNER_THICK, 0.5 * HEIGHT - 2.3cm))
    guard.with_part(pin_x).with_part(pin_z).mirrored_across(y: true, z: true)
}

/// Two hinged brass fore-edge clasps with riveted catch plates pinned onto the front and back
/// covers and ribbed brass bars spanning the fore-edge.
pub fn clasps() -> Craft {
    let z_clasp = 6.2cm
    let strap_w = 1.5cm
    let x_fore = 0.5 * WIDTH + 0.8mm
    // Catch plate riveted onto front and back cover edges.
    let catch_plate = board(vec3(1.2cm, 1.4mm, 0.5 * strap_w), round: 0.9mm)
        .at(vec3(0.5 * WIDTH - 1.2cm, 0.5 * THICK + 0.6mm, z_clasp))
    let clasp_rivet = board(vec3(2.0mm, 1.4mm, 2.0mm), round: 1.3mm)
        .at(vec3(0.5 * WIDTH - 1.75cm, 0.5 * THICK + 1.8mm, z_clasp))
    let catches = catch_plate.with_part(clasp_rivet).mirrored_across(y: true)
    // Vertical brass clasp bar spanning front to back across the fore-edge with rolled hinge knuckles.
    let bar = board(vec3(2.2mm, 0.5 * THICK + 0.8mm, 0.5 * strap_w), round: 1.0mm)
        .at(vec3(x_fore, 0.0, z_clasp))
    let hinge_pin = board(vec3(2.5mm, 2.5mm, 0.5 * strap_w), round: 2.2mm)
        .at(vec3(x_fore + 0.6mm, 0.5 * THICK - 0.5mm, z_clasp))
        .mirrored_across(y: true)
    catches.with_part(bar).with_part(hinge_pin).mirrored_across(z: true)
}

/// The central brass boss: a turned dome 4.8 cm across on a stepped flange, carved with an eight-
/// petal rosette and ringed by four tiny mount rivets.
pub fn boss() -> Craft {
    let at = vec3(0.5 * JOINT + 4mm, 0.5 * THICK - 0.4mm, 0.0)
    let dome = lathe(
        [
            pt(vec2(24mm, 0mm)),
            pt(vec2(24mm, 2.2mm), bow: 1mm),
            pt(vec2(20mm, 3.8mm), bow: 3.4mm),
            pt(vec2(0mm, 7.6mm)),
        ],
    ).at(at)
    let face = draped_face(at, s: vec3(1.0, 0.0, 0.0), t: vec3(0.0, 0.0, -1.0))
    let carved_dome = dome.carve(
        face,
        rosette(radius: 18mm, petals: 8, height: 1.4mm),
        ground: 1.4mm,
        region: vec4(-18mm, -18mm, 18mm, 18mm),
    )
    let stud = board(vec3(2.0mm, 1.4mm, 2.0mm), round: 1.3mm)
        .at(vec3(16mm, 1.5mm, 16mm))
        .four_corners()
        .at(at)
    carved_dome.with_part(stud)
}

// ---- the finished grimoire ----------------------------------------------------------------------

pub const PIECE_LEATHER: u32 = 0
pub const PIECE_PAGES: u32 = 1
pub const PIECE_BRASS: u32 = 2
pub const GATHERINGS: f32 = 2.2mm
pub const LEATHER_WEAR: f32 = 0.65

/// The grimoire in its antique oxblood-chestnut gilded calfskin, deckled rag paper and cast brass.
pub fn grimoire() -> Asset {
    let binding = covers()
        .named_piece(PIECE_LEATHER, "covers")
        .with_part(spine().named_piece(PIECE_LEATHER, "spine"))
        .in_material(leather(wear: LEATHER_WEAR, gild: 0.26, seed: 2.0))
    let leaves = pages()
        .named_piece(PIECE_PAGES, "pages")
        .in_material(paper(stack: vec3(0.0, 1.0, 0.0), gathering: GATHERINGS))
    let fittings = corners()
        .named_piece(PIECE_BRASS, "corners")
        .with_part(clasps().named_piece(PIECE_BRASS, "clasps"))
        .with_part(boss().named_piece(PIECE_BRASS, "boss"))
        .in_material(brass(tarnish: 0.68, verdigris: 0.10, seed: 2.0))
    binding.union(leaves).union(fittings)
}
