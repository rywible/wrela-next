const GRIMOIRE_OB0: vec4 = vec4(0.11519, -0.09571, -0.12674, -0.16362)
const GRIMOIRE_OB1: vec4 = vec4(0.08436, -0.20970, 0.00000, 0.0)
const GRIMOIRE_CENTER: vec3 = vec3(-0.00770, -0.00523, 0.00008)
const GRIMOIRE_EXTENT: vec3 = vec3(0.14397, 0.06400, 0.17757)
const GRIMOIRE_INV_EXT: vec3 = vec3(6.94608, 15.62431, 5.63154)
const GRIMOIRE_MAX_DELTA: f32 = 0.01800

pub struct GrimoireResidual: Copy + GpuData + Eq + StateHash {
    pub tag: u32,
}

impl ResidualEval for GrimoireResidual {
    fn eval_sdf(self, q: vec3) -> f32 {
        siren24_sdf(q, GRIMOIRE_W0, GRIMOIRE_W1, GRIMOIRE_B1, GRIMOIRE_OW0, GRIMOIRE_OB0.x)
    }
}

fn grimoire_substance(p: vec3) -> Substance {
    let q = (p - GRIMOIRE_CENTER) * GRIMOIRE_INV_EXT
    let (_, albedo, roughness, metallic) = siren24_sdf_pbr(
        q,
        GRIMOIRE_W0,
        GRIMOIRE_W1,
        GRIMOIRE_B1,
        GRIMOIRE_OW,
        GRIMOIRE_OB0,
        GRIMOIRE_OB1,
    )
    Substance {
        albedo,
        roughness,
        emits: vec3(0.0),
        metallic,
        ior: 1.5,
        transmission: 0.0,
        subsurface: 0.0,
        coat: 0.0,
        micro: 0.10,
        pad0: 0.0,
        pad1: 0.0,
        pad2: 0.0,
    }
}

pub const GRIMOIRE_THICKNESS: f32 = 0.05600
pub const GRIMOIRE_HALF: vec3 = vec3(0.11000, 0.02800, 0.15000)

pub type GrimoireBase = SmoothUnion<RoundCuboid, RoundCone>

fn grimoire_base() -> GrimoireBase {
    let body = round_cuboid(vec3(0.11000, 0.02800, 0.15000), 0.008)
    let spine = round_cone(
        vec3(-0.09800, 0.0, -0.14000),
        vec3(-0.09800, 0.0, 0.14000),
        r_top: 0.02744,
        r_bottom: 0.02744,
    )
    body.smooth_union(spine, k: 0.006)
}

impl ChannelEval<Substance> for GrimoireResidual {
    fn eval_channels(self, p: vec3) -> Substance {
        grimoire_substance(p)
    }
}

pub type Grimoire = Translate<Painted<BoundedResidual<GrimoireBase, GrimoireResidual>, GrimoireResidual>>

/// Returns the pure `Field<Substance>` for `grimoire` in its canonical local frame.
pub fn grimoire() -> Grimoire {
    painted(
        bounded_residual(
            grimoire_base(),
            GrimoireResidual { tag: 1 },
            center: GRIMOIRE_CENTER,
            extent: GRIMOIRE_EXTENT,
            max_delta: GRIMOIRE_MAX_DELTA,
            lip_extra: 0.55,
        ),
        GrimoireResidual { tag: 1 },
    )
        .translate(vec3(0.0, 0.02800, 0.0))
}
