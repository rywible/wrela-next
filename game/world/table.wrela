// An ornate carved oak table (the forge's first showcase; its brief and provenance are in
// table.provenance.json): a library table 1.2 m by 0.75 m and 76 cm high, its planked top with
// breadboard ends run round with an ovolo over a cove, its frieze carved with a rosette between
// continuous running scrolls of acanthus, on four turned baluster legs whose gadrooned bulbs,
// astragal collars, acanthus-wrapped necks and fluted columns are tenoned into the frieze, braced
// by an H-stretcher of turned rails. Rich antique waxed oak: the top of five edge-joined planks
// with breadboard ends, the legs and rails quarter-sawn, dark in its carving's grounds, rubbed
// honey-amber on its edges and proud leaves.
//
// The table stands with its feet at y = 0, its long side along x, its front toward +z. Every
// number carries its physical unit and belongs to a named part.

use kit::shapes::carve::flat_face
use kit::shapes::craft::{Craft, MotifOps, apron, lathe, pt, slab}
use kit::shapes::made::Asset
use kit::shapes::making::{board, lying_x, lying_z}
use kit::shapes::ornament::{acanthus, lobe, rosette, scroll}
use kit::substances::wood::{log, oak}
use std::math::TAU
use std::units::{cm, mm}

// ---- the top ------------------------------------------------------------------------------------

/// The top's plan (half-length, half-width), corner radius, underside height and edge moulding.
pub const TOP_HALF = vec2(60cm, 37.5cm)
pub const TOP_CORNER: f32 = 2.8cm
pub const TOP_FROM: f32 = 72.5cm

/// How the wide top has seasoned over two centuries: gentle seasonal cup and end-to-end twist.
pub const TOP_CUP: f32 = 1.0mm
pub const TOP_TWIST: f32 = 0.6mm

/// The top: five edge-joined oak planks with breadboard ends, its edge moulded in an ovolo over a
/// cove rising 35 mm to the 76 cm tabletop face.
pub fn top() -> Craft {
    let edge = [
        pt(vec2(-3cm, 0mm)),
        pt(vec2(-3mm, 0mm), bow: 1mm),
        pt(vec2(0mm, 3mm)),
        pt(vec2(0mm, 10mm), bow: -1.2mm),
        pt(vec2(-3mm, 13mm)),
        pt(vec2(-3mm, 16mm), bow: 6mm),
        pt(vec2(-20mm, 35mm)),
        pt(vec2(-50mm, 35mm)),
    ]
    slab(TOP_HALF, corner: TOP_CORNER, edge: edge)
        .seasoned(across: TOP_HALF, cup: TOP_CUP, twist: TOP_TWIST)
        .at(vec3(0.0, TOP_FROM, 0.0))
}

// ---- the frieze ---------------------------------------------------------------------------------

/// The frieze's plan (8 cm in from the top's edge, set back 3 mm from the leg blocks so shoulder
/// lines read crisply), carving panel band, ground depth, rosette and scroll measures.
pub const FRIEZE_HALF = vec2(51.7cm, 29.2cm)
pub const FRIEZE_BAND = vec2(63.4cm, 71.8cm)
pub const FRIEZE_GROUND: f32 = 6mm
pub const ROSETTE_RADIUS: f32 = 3.5cm
pub const ROSETTE_PETALS: u32 = 8
pub const SCROLL_PERIOD: f32 = 9.8cm
pub const SCROLL_RELIEF: f32 = 5.6mm

/// Hand-carved irregularity across repeated motifs (smoothly tapered to zero at cell seams so
/// lunette arches stay unbroken).
pub const HAND: f32 = 0.24

/// The frieze's carving on a face `half_length` m long: an eight-petal rosette at the middle
/// flanked by a continuous semicircular Jacobean lunette-and-palmette arcade laid out to fit an
/// exact integer number of bays inside the panel frame.
pub fn frieze_motif(half_length: f32) -> MotifOps {
    let span = FRIEZE_BAND.y - FRIEZE_BAND.x
    let mid = 0.5 * span
    let start = ROSETTE_RADIUS + 6mm
    let avail = max(half_length - start - 4mm, SCROLL_PERIOD)
    let cells = u32(max(round(avail / SCROLL_PERIOD), 1.0))
    let bay = avail / f32(cells)
    let running = scroll(period: bay, span: span, height: SCROLL_RELIEF)
        .repeated(period: bay, count: cells, wander: HAND)
        .set_at(vec2(start + 0.5 * avail, mid))
        .mirrored()
    rosette(radius: ROSETTE_RADIUS, petals: ROSETTE_PETALS, height: FRIEZE_GROUND)
        .set_at(vec2(0.0, mid))
        .and_motif(running)
}

/// The frieze band run round the table, its long and short faces carved within framed panels that
/// stop cleanly short of the leg blocks.
pub fn frieze() -> Craft {
    let section = [
        pt(vec2(-22mm, 60cm)),
        pt(vec2(-2mm, 60cm), bow: 1.5mm),
        pt(vec2(4mm, 60.6cm), bow: 2.5mm),
        pt(vec2(4mm, 61.8cm), bow: 1.5mm),
        pt(vec2(0mm, 62.4cm)),
        pt(vec2(0mm, 72.6cm)),
        pt(vec2(-22mm, 72.6cm)),
    ]
    let band = apron(FRIEZE_HALF, corner: 0mm, section: section)
    let front = flat_face(
        vec3(0.0, FRIEZE_BAND.x, FRIEZE_HALF.y),
        s: vec3(1.0, 0.0, 0.0),
        t: vec3(0.0, 1.0, 0.0),
    )
    let side = flat_face(
        vec3(FRIEZE_HALF.x, FRIEZE_BAND.x, 0.0),
        s: vec3(0.0, 0.0, -1.0),
        t: vec3(0.0, 1.0, 0.0),
    )
    let height = FRIEZE_BAND.y - FRIEZE_BAND.x
    let long_half = FRIEZE_HALF.x - 2.0 * LEG_BLOCK - 1cm
    let short_half = FRIEZE_HALF.y - 2.0 * LEG_BLOCK - 1cm
    band
        .carve(
            front,
            frieze_motif(long_half),
            ground: FRIEZE_GROUND,
            region: vec4(-long_half, 0.0, long_half, height),
        )
        .carve(
            side,
            frieze_motif(short_half),
            ground: FRIEZE_GROUND,
            region: vec4(-short_half, 0.0, short_half, height),
        )
        .four_corners()
}

// ---- the legs -----------------------------------------------------------------------------------

/// Where the legs' axes stand and the half-width of their upper square joinery blocks.
pub const LEG_AT = vec2(48.8cm, 26.3cm)
pub const LEG_BLOCK: f32 = 3.2cm

/// Carving spans and relief heights along the turned leg (separated by a clean turned astragal
/// collar at 22..23.8 cm so gadroons and acanthus never collide at a cliff edge).
pub const GADROONS: u32 = 12
pub const GADROON_SPAN = vec2(9.6cm, 21.6cm)
pub const GADROON_RELIEF: f32 = 3.4mm
pub const VASE_LEAVES: u32 = 6
pub const LEAF_SPAN = vec2(24.0cm, 34.4cm)
pub const LEAF_RELIEF: f32 = 2.8mm
pub const COLUMN_FLUTES: u32 = 12
pub const COLUMN_SPAN = vec2(44cm, 54cm)
pub const FLUTE_DEPTH: f32 = 2mm

/// One leg's lathe turning before carving: bun foot, collar, swelling vase bulb, full astragal
/// collar dividing bulb from neck, waisted neck with upper bead framing the acanthus tips,
/// fluted column, upper collar and shoulder.
pub fn leg_turning() -> Craft {
    lathe(
        [
            pt(vec2(34mm, 0mm), bow: 9mm),
            pt(vec2(44mm, 3.2cm), bow: -4mm),
            pt(vec2(30mm, 6.4cm), bow: 2mm),
            pt(vec2(34mm, 7.4cm), bow: -2mm),
            pt(vec2(28mm, 9.0cm), bow: 18mm),
            pt(vec2(51mm, 21.6cm), bow: 3mm),
            pt(vec2(49mm, 24.0cm), bow: 11mm),
            pt(vec2(33mm, 34.4cm), bow: 3mm),
            pt(vec2(31mm, 36.8cm), bow: -2.5mm),
            pt(vec2(26mm, 40.0cm), bow: 2.5mm),
            pt(vec2(34mm, 41.4cm), bow: -2mm),
            pt(vec2(26mm, 43.0cm), bow: 1mm),
            pt(vec2(28mm, 55.0cm), bow: 2.5mm),
            pt(vec2(34mm, 56.6cm), bow: -1.5mm),
            pt(vec2(30mm, 58.0cm), bow: 2mm),
            pt(vec2(32mm, 60.5cm)),
        ],
    )
}

/// One leg's turning, carved: gadrooned lower bulb, acanthus-wrapped neck, fluted upper column.
pub fn turning() -> Craft {
    let r_bulb = 5cm
    let r_neck = 4cm
    let r_col = 2.8cm
    let bulb_lobes = lobe(
        length: GADROON_SPAN.y - GADROON_SPAN.x,
        width: 0.92 * TAU * r_bulb / f32(GADROONS),
        height: GADROON_RELIEF,
        belly: 0.58,
    ).around(GADROONS, radius: r_bulb, wander: 0.4 * HAND)
    let neck_leaves = acanthus(
        length: LEAF_SPAN.y - LEAF_SPAN.x,
        width: 0.88 * TAU * r_neck / f32(VASE_LEAVES),
        height: LEAF_RELIEF,
        curl: 0.42,
    ).mirrored().around(VASE_LEAVES, radius: r_neck, wander: 0.7 * HAND)
    leg_turning()
        .carve_round(
            from: GADROON_SPAN.x,
            to: GADROON_SPAN.y,
            radius: r_bulb,
            inner: 3cm,
            motif: bulb_lobes,
            ground: GADROON_RELIEF,
        )
        .carve_round(
            from: LEAF_SPAN.x,
            to: LEAF_SPAN.y,
            radius: r_neck,
            inner: 2.6cm,
            motif: neck_leaves,
            ground: LEAF_RELIEF,
        )
        .fluted(
            from: COLUMN_SPAN.x,
            to: COLUMN_SPAN.y,
            radius: r_col,
            inner: 2.4cm,
            count: COLUMN_FLUTES,
            depth: FLUTE_DEPTH,
            wander: 0.25 * HAND,
        )
}

/// All four legs: each carved turning joined to its square frieze block at the shoulder, with a
/// carved corner rosette medallion on the front face of each leg die-block.
pub fn legs() -> Craft {
    let at = vec3(LEG_AT.x, 0.0, LEG_AT.y)
    let die_face = flat_face(
        vec3(0.0, 0.0, LEG_BLOCK),
        s: vec3(1.0, 0.0, 0.0),
        t: vec3(0.0, 1.0, 0.0),
    )
    let block = board(vec3(LEG_BLOCK, 6.35cm, LEG_BLOCK), round: 2mm)
        .carve(
            die_face,
            rosette(radius: 2.1cm, petals: 8, height: 3.0mm),
            ground: 3.0mm,
            region: vec4(-2.3cm, -2.3cm, 2.3cm, 2.3cm),
        )
        .at(at + vec3(0.0, 66.35cm, 0.0))
    turning().at(at).joined_to(block, gap: 0.6mm, depth: 0.8mm).four_corners()
}

// ---- the stretcher ------------------------------------------------------------------------------

/// The H-stretcher's turned rails, 13 cm above the floor, joining the legs' lower collars.
pub const STRETCHER_HEIGHT: f32 = 13cm

/// One turned stretcher rail of length `span`, swelled in the middle with collars at each end.
fn stretcher_rail(span: f32) -> Craft {
    lathe(
        [
            pt(vec2(14mm, -0.5 * span)),
            pt(vec2(14mm, -0.42 * span), bow: 1.5mm),
            pt(vec2(19mm, -0.40 * span), bow: -1mm),
            pt(vec2(16mm, -0.38 * span), bow: 4mm),
            pt(vec2(18mm, 0.0), bow: 4mm),
            pt(vec2(16mm, 0.38 * span), bow: -1mm),
            pt(vec2(19mm, 0.40 * span), bow: 1.5mm),
            pt(vec2(14mm, 0.42 * span)),
            pt(vec2(14mm, 0.5 * span)),
        ],
    )
}

/// The H-stretcher: side rails front to back between each pair of legs, and the centre rail.
pub fn stretcher() -> Craft {
    let sides = stretcher_rail(2.0 * LEG_AT.y)
        .at(vec3(LEG_AT.x, STRETCHER_HEIGHT, 0.0), axes: lying_z())
        .four_corners()
    let mid = stretcher_rail(2.0 * LEG_AT.x)
        .at(vec3(0.0, STRETCHER_HEIGHT, 0.0), axes: lying_x())
    sides.with_part(mid)
}

// ---- the wood & finished table ------------------------------------------------------------------

pub const PIECE_TOP: u32 = 0
pub const PIECE_FRIEZE: u32 = 1
pub const PIECE_LEGS: u32 = 2
pub const PIECE_RAILS: u32 = 3

/// Gentle century-old surface knocks (sparse, wide, shallow dimples seen where raking light skims).
pub const KNOCKS = vec3(4.2cm, 6mm, 0.09mm)

/// The table's oak: five edge-joined planks with breadboard ends for the top, plain-sawn frieze
/// boards, and quarter-sawn legs and stretcher rails showing golden medullary flecks.
pub fn table_oak() -> kit::substances::wood::Oak<4> {
    oak(
        [
            log(
                vec3(0.0, 45cm, 4cm),
                axis: vec3(1.0, 0.0, 0.0),
                ring: 2.4mm,
                seed: 1.0,
                plank: 15cm,
                breadboard: 49cm,
            ),
            log(vec3(0.0, 85cm, 50cm), axis: vec3(1.0, 0.0, 0.0), ring: 2.1mm, seed: 2.0),
            log(vec3(62cm, 30cm, 45cm), axis: vec3(0.0, 1.0, 0.0), ring: 1.8mm, seed: 3.0),
            log(vec3(30cm, 40cm, 0.0), axis: vec3(0.0, 0.0, 1.0), ring: 2.0mm, seed: 4.0),
        ],
    )
}

/// The table's unfinished carcass: top resting on the frieze, frieze tenoned into the legs,
/// H-stretcher bracing the legs below.
pub fn carcass() -> Craft {
    let underframe = frieze()
        .named_piece(PIECE_FRIEZE, "frieze")
        .joined_to(legs().named_piece(PIECE_LEGS, "legs"), gap: 0.6mm, depth: 0.8mm)
    top()
        .named_piece(PIECE_TOP, "top")
        .with_part(underframe)
        .with_part(stretcher().named_piece(PIECE_RAILS, "stretcher"))
        .worn_dings(spacing: KNOCKS.x, radius: KNOCKS.y, depth: KNOCKS.z, seed: 17)
}

/// The carved library table in its antique waxed oak.
pub fn table() -> Asset {
    carcass().in_material(table_oak())
}
