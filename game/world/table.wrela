// An ornate carved oak table (the forge's first showcase; its brief and provenance are in
// table.provenance.json): a library table 1.2 m by 0.75 m and 76 cm high, its top's edge run with
// an ovolo over a cove, its frieze carved with a rosette between running scrolls of acanthus, on
// four turned baluster legs whose vases are wrapped in acanthus and whose upper columns are fluted,
// braced by an H-stretcher of turned rails. Old waxed oak: the top plain-sawn, the legs and rails
// quarter-sawn, dark in its carving's grounds, rubbed pale on its edges and the proudest leaves.
//
// The table stands with its feet at y = 0, its long side along x, its front toward +z. Every
// number is a length in metres or a share, and belongs to a named part.

use kit::shapes::carve::{Carved, FlatFace, RoundFace, carved, flat_face, round_face}
use kit::shapes::made::{Dressed, Piece, dressed, piece}
use kit::shapes::making::{
    Axes, Banded, Board, Both, Folded, Joined, Moulded, Placed, Turned, banded, board, both, folded,
    joined, lying_x, lying_z, moulded, placed, turned,
}
use kit::shapes::ornament::{
    Acanthus, Flute, Lobe, Mirrored, Pair, Rosette, Row, Scroll, Set, acanthus, flute, lobe,
    mirrored, pair, rosette, row, scroll, set,
}
use kit::substances::wood::{Log, Oak, log, oak}

// ---- the top ------------------------------------------------------------------------------------

/// The top's plan, half its length and half its width, and its corners' radius.
pub const TOP_HALF = vec2(0.6, 0.375)
pub const TOP_CORNER: f32 = 0.03

/// The top's underside, and its edge's moulding from its underside to its upper face, (out from
/// the edge, height above the underside): a round at the arris, a fillet, a small cove, a fillet,
/// and a broad ovolo rising to the upper face 35 mm above.
pub const TOP_FROM: f32 = 0.725
pub const TOP_EDGE = [
    vec2(-0.03, 0.0),
    vec2(-0.003, 0.0),
    vec2(0.0, 0.003),
    vec2(0.0, 0.01),
    vec2(-0.003, 0.013),
    vec2(-0.003, 0.016),
    vec2(-0.02, 0.035),
    vec2(-0.05, 0.035),
]
pub const TOP_BOWS = [0.0, 0.001, 0.0, -0.0012, 0.0, 0.006, 0.0, 0.0]

pub type Top = Placed<Moulded<8>>

/// The top.
pub fn top() -> Top {
    placed(
        moulded(TOP_HALF, corner: TOP_CORNER, points: TOP_EDGE, bulges: TOP_BOWS),
        at: vec3(0.0, TOP_FROM, 0.0),
    )
}

// ---- the frieze ---------------------------------------------------------------------------------

/// The frieze's plan: its outer face, half its length and half its width (8 cm in from the top's
/// edge, and set back 3 mm from the legs' blocks, as a joiner sets a frieze back so its shoulder
/// line reads), with square corners.
pub const FRIEZE_HALF = vec2(0.517, 0.292)

/// The frieze's board in section, (out from its outer face, height): 22 mm thick, from 60 cm up
/// to the top's underside, a bead run along its lower edge standing 4 mm proud.
pub const FRIEZE_SECTION = [
    vec2(-0.022, 0.6),
    vec2(-0.002, 0.6),
    vec2(0.004, 0.606),
    vec2(0.004, 0.618),
    vec2(0.0, 0.624),
    vec2(0.0, 0.726),
    vec2(-0.022, 0.726),
]
pub const FRIEZE_BOWS = [0.0, 0.0015, 0.0025, 0.0015, 0.0, 0.0, 0.0]

/// The carving's panel on each face: from 1.5 cm above the bead to 6 mm below the top, its ground
/// 6 mm deep, and the rosette at its middle 3.4 cm round.
pub const FRIEZE_BAND = vec2(0.633, 0.72)
pub const FRIEZE_GROUND: f32 = 0.006
pub const ROSETTE_RADIUS: f32 = 0.034
pub const ROSETTE_PETALS: u32 = 10

/// The running scroll out from the rosette to each end of a face: a wave every 10 cm, standing
/// 5.5 mm proud, the side going left the right's mirror image.
pub const SCROLL_PERIOD: f32 = 0.1
pub const SCROLL_RELIEF: f32 = 0.0055

pub type RunningScroll = Mirrored<Set<Row<Scroll>>>

pub type FriezeMotif = Pair<Set<Rosette>, RunningScroll>

/// The frieze's carving on a face `half_length` m long: the rosette at its middle and the scroll
/// running out from it to each end.
pub fn frieze_motif(half_length: f32) -> FriezeMotif {
    let span = FRIEZE_BAND.y - FRIEZE_BAND.x
    let mid = 0.5 * span
    let start = ROSETTE_RADIUS + 0.004
    let cells = u32(max(floor((half_length - start) / SCROLL_PERIOD), 1.0))
    let run = row(
        scroll(period: SCROLL_PERIOD, span: span, height: SCROLL_RELIEF),
        period: SCROLL_PERIOD,
        count: cells,
    )
    let running = mirrored(set(run, at: vec2(start + 0.5 * SCROLL_PERIOD * f32(cells), mid)))
    pair(
        set(
            rosette(radius: ROSETTE_RADIUS, petals: ROSETTE_PETALS, height: FRIEZE_GROUND),
            at: vec2(0.0, mid),
        ),
        running,
    )
}

pub type FriezeFace = Carved<Banded<7>, FlatFace, FriezeMotif>

pub type Frieze = Folded<Carved<FriezeFace, FlatFace, FriezeMotif>>

/// The frieze: its band round the table, its long faces and its short faces carved, the same on
/// the far side as on the near.
pub fn frieze() -> Frieze {
    let band = banded(FRIEZE_HALF, corner: 0.0, points: FRIEZE_SECTION, bulges: FRIEZE_BOWS)
    let front = flat_face(
        vec3(0.0, FRIEZE_BAND.x, FRIEZE_HALF.y),
        s: vec3(1.0, 0.0, 0.0),
        t: vec3(0.0, 1.0, 0.0),
    )
    let side = flat_face(
        vec3(FRIEZE_HALF.x, FRIEZE_BAND.x, 0.0),
        s: vec3(0.0, 0.0, -1.0),
        t: vec3(0.0, 1.0, 0.0),
    )
    let height = FRIEZE_BAND.y - FRIEZE_BAND.x
    // The panels stop short of the legs' blocks at the corners.
    let long = vec4(
        -(FRIEZE_HALF.x - 2.0 * LEG_BLOCK - 0.008),
        0.0,
        FRIEZE_HALF.x - 2.0 * LEG_BLOCK - 0.008,
        height,
    )
    let short = vec4(
        -(FRIEZE_HALF.y - 2.0 * LEG_BLOCK - 0.008),
        0.0,
        FRIEZE_HALF.y - 2.0 * LEG_BLOCK - 0.008,
        height,
    )
    let carved_front = carved(
        band,
        front,
        frieze_motif(long.z),
        ground: FRIEZE_GROUND,
        region: long,
    )
    folded(carved(carved_front, side, frieze_motif(short.z), ground: FRIEZE_GROUND, region: short))
}

// ---- the legs -----------------------------------------------------------------------------------

/// Where the legs' axes stand: at the frieze's corners, the blocks' faces 3 mm proud of it.
pub const LEG_AT = vec2(0.52 - 0.032, 0.295 - 0.032)

/// The leg's square block, half its side, where the frieze is tenoned into it (from 60 cm up to
/// the top's underside).
pub const LEG_BLOCK: f32 = 0.032

/// The leg turned below its block, (radius, height): a bun foot, a bead, a vase swelling to 5 cm
/// and waisting, a bead, a fluted column, a collar, and the shoulder under the block.
pub const LEG_PROFILE = [
    vec2(0.034, 0.0),
    vec2(0.044, 0.032),
    vec2(0.03, 0.064),
    vec2(0.034, 0.074),
    vec2(0.028, 0.09),
    vec2(0.05, 0.22),
    vec2(0.03, 0.355),
    vec2(0.026, 0.4),
    vec2(0.034, 0.414),
    vec2(0.026, 0.43),
    vec2(0.028, 0.55),
    vec2(0.034, 0.566),
    vec2(0.03, 0.58),
    vec2(0.032, 0.605),
]
pub const LEG_BOWS = [
    0.009, -0.004, 0.002, -0.002, 0.022, 0.013, -0.003, 0.0025, -0.002, 0.001, 0.0025, -0.0015,
    0.002, 0.0,
]

/// The vase's carving: its bulb gadrooned, twelve lobes from 9.5 cm up to 23 cm standing 3.5 mm
/// proud; its neck wrapped in six acanthus leaves from 23 cm to 35 cm, 3 mm proud; and the
/// column's twelve flutes, from 44 cm to 54 cm, 2 mm deep.
pub const GADROONS: u32 = 12
pub const GADROON_SPAN = vec2(0.095, 0.23)
pub const GADROON_RELIEF: f32 = 0.0035
pub const VASE_LEAVES: u32 = 6
pub const LEAF_SPAN = vec2(0.23, 0.35)
pub const LEAF_RELIEF: f32 = 0.003
pub const COLUMN_FLUTES: u32 = 12
pub const COLUMN_SPAN = vec2(0.44, 0.54)
pub const FLUTE_DEPTH: f32 = 0.002

pub type Bulb = Carved<Turned<14>, RoundFace, Row<Lobe>>

pub type Vase = Carved<Bulb, RoundFace, Row<Mirrored<Acanthus>>>

pub type Column = Carved<Vase, RoundFace, Row<Flute>>

pub type Leg = Folded<Joined<Placed<Column>, Placed<Board>>>

/// One leg's turning as the lathe left it, before it was carved.
pub fn leg_turning() -> Turned<14> {
    turned(LEG_PROFILE, LEG_BOWS)
}

/// One leg's turning, carved: its bulb gadrooned, the acanthus round its neck, the flutes round
/// its column.
pub fn turning() -> Column {
    let t = leg_turning()
    let r_bulb = 0.05
    let lobes = row(
        lobe(
            length: GADROON_SPAN.y - GADROON_SPAN.x,
            width: 0.95 * 6.2831853 * r_bulb / f32(GADROONS),
            height: GADROON_RELIEF,
            belly: 0.62,
        ),
        period: 6.2831853 * r_bulb / f32(GADROONS),
    )
    let bulb = carved(
        t,
        round_face(radius: r_bulb, base: GADROON_SPAN.x, inner: 0.03),
        lobes,
        ground: GADROON_RELIEF,
        region: vec4(-1.0, 0.0, 1.0, GADROON_SPAN.y - GADROON_SPAN.x),
    )
    let r_neck = 0.04
    let around = 6.2831853 * r_neck
    // Each leaf keeps within its sixth of the neck, a tenth to spare.
    let leaf = mirrored(
        acanthus(
            length: LEAF_SPAN.y - LEAF_SPAN.x,
            width: 0.9 * around / f32(VASE_LEAVES),
            height: LEAF_RELIEF,
            curl: 0.4,
        ),
    )
    let leaves = row(leaf, period: around / f32(VASE_LEAVES))
    let vase = carved(
        bulb,
        round_face(radius: r_neck, base: LEAF_SPAN.x, inner: 0.026),
        leaves,
        ground: LEAF_RELIEF,
        region: vec4(-1.0, 0.0, 1.0, LEAF_SPAN.y - LEAF_SPAN.x),
    )
    let r_col = 0.028
    let flutes = row(
        flute(
            length: COLUMN_SPAN.y - COLUMN_SPAN.x,
            width: 6.2831853 * r_col / f32(COLUMN_FLUTES) * 0.6,
            depth: FLUTE_DEPTH,
        ),
        period: 6.2831853 * r_col / f32(COLUMN_FLUTES),
    )
    carved(
        vase,
        round_face(radius: r_col, base: COLUMN_SPAN.x, inner: 0.024),
        flutes,
        ground: 0.0,
        region: vec4(-1.0, 0.0, 1.0, COLUMN_SPAN.y - COLUMN_SPAN.x),
    )
}

/// The legs: the turning and its block, joined at the shoulder, at each corner.
pub fn legs() -> Leg {
    let at = vec3(LEG_AT.x, 0.0, LEG_AT.y)
    let block = board(vec3(LEG_BLOCK, 0.0635, LEG_BLOCK), round: 0.002)
    folded(
        joined(
            placed(turning(), at: at),
            placed(block, at: at + vec3(0.0, 0.6635, 0.0)),
            gap: 0.0006,
            depth: 0.0008,
        ),
    )
}

// ---- the stretcher ------------------------------------------------------------------------------

/// The stretcher's rails, 13 cm above the floor: turned, (radius, along from the rail's middle),
/// a long swelling with a bead each side; the side rails run front to back between the legs, the
/// middle rail along the table between the side rails.
pub const STRETCHER_HEIGHT: f32 = 0.13
pub const RAIL_PROFILE = [
    vec2(0.014, -0.5),
    vec2(0.014, -0.42),
    vec2(0.019, -0.4),
    vec2(0.016, -0.38),
    vec2(0.018, 0.0),
    vec2(0.016, 0.38),
    vec2(0.019, 0.4),
    vec2(0.014, 0.42),
    vec2(0.014, 0.5),
]
pub const RAIL_BOWS = [0.0, 0.0015, -0.001, 0.004, 0.004, -0.001, 0.0015, 0.0, 0.0]

pub type Rails = Both<Folded<Placed<Turned<9>>>, Placed<Turned<9>>>

/// The stretcher: the side rails between each pair of legs, and the middle rail.
pub fn stretcher() -> Rails {
    // A side rail spans the legs' centres front to back: its profile is scaled to that span.
    let side_len = 2.0 * LEG_AT.y
    var side = RAIL_PROFILE
    for i in 0..9 {
        side[i] = vec2(RAIL_PROFILE[i].x, RAIL_PROFILE[i].y * side_len)
    }
    let mid_len = 2.0 * LEG_AT.x
    var mid = RAIL_PROFILE
    for i in 0..9 {
        mid[i] = vec2(RAIL_PROFILE[i].x, RAIL_PROFILE[i].y * mid_len)
    }
    let sides = folded(
        placed(turned(side, RAIL_BOWS), at: vec3(LEG_AT.x, STRETCHER_HEIGHT, 0.0), axes: lying_z()),
    )
    both(
        sides,
        placed(turned(mid, RAIL_BOWS), at: vec3(0.0, STRETCHER_HEIGHT, 0.0), axes: lying_x()),
    )
}

// ---- the wood -----------------------------------------------------------------------------------

/// The pieces, by the log each was cut from: the top plain-sawn from a log whose heart ran along
/// the table 30 cm below it; the frieze's boards plain-sawn too; the legs and the rails
/// quarter-sawn, their logs' hearts off to one side, so oak's rays show as flecks.
pub const PIECE_TOP: u32 = 0
pub const PIECE_FRIEZE: u32 = 1
pub const PIECE_LEGS: u32 = 2
pub const PIECE_RAILS: u32 = 3

/// The table's oak: one tree's wood, its pieces from four logs.
pub fn table_oak() -> Oak<4> {
    oak(
        [
            log(vec3(0.0, 0.45, 0.04), axis: vec3(1.0, 0.0, 0.0), ring: 0.0024, seed: 1.0),
            log(vec3(0.0, 0.85, 0.5), axis: vec3(1.0, 0.0, 0.0), ring: 0.0021, seed: 2.0),
            log(vec3(0.62, 0.3, 0.45), axis: vec3(0.0, 1.0, 0.0), ring: 0.0018, seed: 3.0),
            log(vec3(0.3, 0.4, 0.0), axis: vec3(0.0, 0.0, 1.0), ring: 0.002, seed: 4.0),
        ],
    )
}

// ---- the table ----------------------------------------------------------------------------------

pub type Underframe = Joined<Piece<Frieze>, Piece<Leg>>

pub type Carcass = Both<Both<Piece<Top>, Underframe>, Piece<Rails>>

pub type Table = Dressed<Carcass, Oak<4>>

/// The table's carcass, its wood unfinished: its top resting on the frieze, the frieze tenoned
/// into the legs' blocks, the stretcher between the legs.
pub fn carcass() -> Carcass {
    let underframe = joined(
        piece(PIECE_FRIEZE, "frieze", frieze()),
        piece(PIECE_LEGS, "legs", legs()),
        gap: 0.0006,
        depth: 0.0008,
    )
    both(
        both(piece(PIECE_TOP, "top", top()), underframe),
        piece(PIECE_RAILS, "stretcher", stretcher()),
    )
}

/// The table in its oak.
pub fn table() -> Table {
    dressed(carcass(), table_oak())
}
