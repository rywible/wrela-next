const TABLE_OB0: vec4 = vec4(-0.15652, -0.14749, -0.14861, -0.16007)
const TABLE_OB1: vec4 = vec4(-0.03326, -0.18818, 0.00000, 0.0)
const TABLE_CENTER: vec3 = vec3(0.00039, -0.35690, -0.00323)
const TABLE_EXTENT: vec3 = vec3(0.68685, 0.46928, 0.41531)
const TABLE_INV_EXT: vec3 = vec3(1.45592, 2.13092, 2.40784)
const TABLE_MAX_DELTA: f32 = 0.03500

pub struct OaktableResidual: Copy + GpuData + Eq + StateHash {
    pub tag: u32,
}

impl ResidualEval for OaktableResidual {
    fn eval_sdf(self, q: vec3) -> f32 {
        siren24_sdf(q, TABLE_W0, TABLE_W1, TABLE_B1, TABLE_OW0, TABLE_OB0.x)
    }
}

fn oaktable_substance(p: vec3) -> Substance {
    let q = (p - TABLE_CENTER) * TABLE_INV_EXT
    let (_, albedo, roughness, metallic) = siren24_sdf_pbr(
        q,
        TABLE_W0,
        TABLE_W1,
        TABLE_B1,
        TABLE_OW,
        TABLE_OB0,
        TABLE_OB1,
    )
    Substance {
        albedo,
        roughness,
        emits: vec3(0.0),
        metallic,
        ior: 1.5,
        transmission: 0.0,
        subsurface: 0.0,
        coat: 0.0,
        micro: 0.08,
        pad0: 0.0,
        pad1: 0.0,
        pad2: 0.0,
    }
}

pub const OAKTABLE_TOP_Y: f32 = 0.78000

pub type OaktableBase = SmoothUnion<
    SmoothUnion<
        SmoothUnion<RoundCuboid, Translate<RoundCuboid>>,
        SmoothUnionAll<RoundCone, 4>,
    >,
    SmoothUnion<SmoothUnion<Translate<RoundCuboid>, Translate<RoundCuboid>>, Translate<RoundCuboid>>,
>

fn oaktable_base() -> OaktableBase {
    let top = round_cuboid(vec3(0.62781, 0.024, 0.34729), 0.008)
    let apron = round_cuboid(vec3(0.56781, 0.055, 0.28729), 0.012)
        .translate(vec3(0.0, -0.061, 0.0))
    let legs = [
        round_cone(vec3(-0.53781, -0.73100, -0.26229), vec3(-0.53781, -0.026, -0.26229), r_top: 0.022, r_bottom: 0.036),
        round_cone(vec3(0.53781, -0.73100, -0.26229), vec3(0.53781, -0.026, -0.26229), r_top: 0.022, r_bottom: 0.036),
        round_cone(vec3(-0.53781, -0.73100, 0.26229), vec3(-0.53781, -0.026, 0.26229), r_top: 0.022, r_bottom: 0.036),
        round_cone(vec3(0.53781, -0.73100, 0.26229), vec3(0.53781, -0.026, 0.26229), r_top: 0.022, r_bottom: 0.036),
    ].smooth_union(k: 0.012)
    let sy = -0.59600
    let s_l = round_cuboid(vec3(0.022, 0.022, 0.26229), 0.006).translate(vec3(-0.53781, sy, 0.0))
    let s_r = round_cuboid(vec3(0.022, 0.022, 0.26229), 0.006).translate(vec3(0.53781, sy, 0.0))
    let s_c = round_cuboid(vec3(0.53781, 0.022, 0.024), 0.006).translate(vec3(0.0, sy, 0.0))
    top.smooth_union(apron, k: 0.015).smooth_union(legs, k: 0.012).smooth_union(
        s_l.smooth_union(s_r, k: 0.010).smooth_union(s_c, k: 0.010),
        k: 0.010,
    )
}

impl ChannelEval<Substance> for OaktableResidual {
    fn eval_channels(self, p: vec3) -> Substance {
        oaktable_substance(p)
    }
}

pub type Oaktable = Translate<Painted<BoundedResidual<OaktableBase, OaktableResidual>, OaktableResidual>>

/// Returns the pure `Field<Substance>` for the carved oak table in its canonical local frame.
pub fn oaktable() -> Oaktable {
    painted(
        bounded_residual(
            oaktable_base(),
            OaktableResidual { tag: 1 },
            center: TABLE_CENTER,
            extent: TABLE_EXTENT,
            max_delta: TABLE_MAX_DELTA,
            lip_extra: 0.55,
        ),
        OaktableResidual { tag: 1 },
    )
        .translate(vec3(0.0, 0.75600, 0.0))
}
