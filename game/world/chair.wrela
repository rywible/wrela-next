// A carved oak side chair (the forge's gold set; its brief and record are in
// chair.provenance.json): a planked moulded seat 46 cm wide and 42 cm deep at 45 cm height;
// turned baluster front legs; chamfered square back posts rising to 96 cm with turned acorn
// finials and a gentle 5° upper backrest rake; a carved scroll crest rail and lower back rail
// framing a rosette-carved central splat (tenoned cleanly into both rails — nothing floating);
// moulded seat apron rails and low stretchers linking all four legs. Rich antique waxed oak.
//
// Stands with feet at y = 0, front toward +z, centred on the origin.

use kit::shapes::carve::flat_face
use kit::shapes::craft::{Craft, MotifOps, apron, lathe, pt, rail, slab, tilted_x}
use kit::shapes::made::Asset
use kit::shapes::making::{board, lying_x, running_z}
use kit::shapes::ornament::{rosette, scroll}
use kit::substances::wood::{log, oak}
use std::units::{cm, deg, mm}

/// Seat dimensions and edge moulding.
pub const SEAT_HALF = vec2(23cm, 21cm)
pub const SEAT_TOP: f32 = 45cm
pub const SEAT_THICK: f32 = 2.5cm

/// Leg positions, back post height and upper backrest rake.
pub const FRONT_AT = vec2(20cm, 18cm)
pub const POST_AT = vec2(20cm, -18cm)
pub const POST_HALF: f32 = 1.8cm
pub const BACK_TOP: f32 = 95cm
pub const BACK_RAKE: f32 = 5deg

/// Backrest rails and splat, all anchored relative to `SEAT_TOP` and `BACK_TOP` so every tenon
/// stays solidly joined.
pub const CREST_H: f32 = 9.2cm
pub const CREST_AT: f32 = 87cm
pub const LOWER_RAIL_H: f32 = 4.2cm
pub const LOWER_RAIL_AT: f32 = 54.5cm
pub const RAIL_RELIEF: f32 = 4mm
pub const SPLAT_HALF_W: f32 = 7.4cm
pub const SPLAT_ROSETTE = vec2(4.2cm, 3.2mm)
pub const STRETCHER_AT: f32 = 10.5cm
pub const KNOCKS = vec3(3.6cm, 5mm, 0.08mm)

/// The planked, gently dished oak seat with a thumbnail-moulded edge.
pub fn seat() -> Craft {
    let edge = [
        pt(vec2(-20mm, 0mm), bow: 3mm),
        pt(vec2(0mm, 4mm)),
        pt(vec2(0mm, 14mm), bow: 6mm),
        pt(vec2(-9mm, SEAT_THICK)),
        pt(vec2(-30mm, SEAT_THICK)),
    ]
    slab(SEAT_HALF, corner: 1.2cm, edge: edge)
        .seasoned(across: SEAT_HALF, cup: 1.4mm, twist: 0.5mm)
        .at(vec3(0.0, SEAT_TOP - SEAT_THICK, 0.0))
}

/// Turned front legs and back posts (plumb square legs below the seat, gracefully raked 5° above
/// the seat with turned acorn finials at their tops).
pub fn legs() -> Craft {
    let front_leg = lathe(
        [
            pt(vec2(18mm, 0mm), bow: 4mm),
            pt(vec2(22mm, 2cm), bow: -2mm),
            pt(vec2(15mm, 4cm), bow: 9mm),
            pt(vec2(24mm, 15cm), bow: 8mm),
            pt(vec2(15mm, 27cm), bow: 1.5mm),
            pt(vec2(20mm, 28.4cm), bow: -1.5mm),
            pt(vec2(16mm, 29.8cm), bow: 2mm),
            pt(vec2(18mm, 43cm)),
        ],
    ).at(vec3(FRONT_AT.x, 0.0, FRONT_AT.y)).mirrored_across(x: true)

    let lower_post = board(vec3(POST_HALF, 0.5 * SEAT_TOP, POST_HALF), round: 3.5mm)
        .at(vec3(POST_AT.x, 0.5 * SEAT_TOP, POST_AT.y))
        .mirrored_across(x: true)

    let upper_h = BACK_TOP - SEAT_TOP
    let upper_post = board(vec3(POST_HALF, 0.5 * upper_h, POST_HALF), round: 3.5mm)
        .at(vec3(POST_AT.x, 0.5 * upper_h, 0.0))
    let finial = lathe(
        [
            pt(vec2(14mm, 0mm), bow: 2mm),
            pt(vec2(16mm, 8mm), bow: -1.5mm),
            pt(vec2(11mm, 15mm), bow: 5mm),
            pt(vec2(16mm, 28mm), bow: 6mm),
            pt(vec2(0mm, 46mm)),
        ],
    ).at(vec3(POST_AT.x, upper_h - 2mm, 0.0))
    let raked_posts = upper_post
        .with_part(finial)
        .mirrored_across(x: true)
        .at(vec3(0.0, SEAT_TOP, POST_AT.y), axes: tilted_x(BACK_RAKE))

    front_leg.with_part(lower_post).with_part(raked_posts)
}

/// The framed backrest (raked 5° to match the upper posts): carved scroll crest rail, lower back
/// rail, and central rosette-carved splat tenoned cleanly into both rails.
pub fn back() -> Craft {
    let inner_half_x = POST_AT.x - POST_HALF + 4mm
    let crest_y = CREST_AT - SEAT_TOP
    let lower_y = LOWER_RAIL_AT - SEAT_TOP
    let crest_half = vec3(inner_half_x, 0.5 * CREST_H, 1.2cm)
    let lower_half = vec3(inner_half_x, 0.5 * LOWER_RAIL_H, 1.1cm)
    // Splat spans continuously from inside the lower rail straight up into the crest rail.
    let splat_bot = lower_y + 0.25 * LOWER_RAIL_H
    let splat_top = crest_y - 0.25 * CREST_H
    let splat_mid = 0.5 * (splat_bot + splat_top)
    let splat_half_h = 0.5 * (splat_top - splat_bot)
    let splat_half = vec3(SPLAT_HALF_W, splat_half_h, 9.5mm)

    let crest_face = flat_face(
        vec3(0.0, crest_y, crest_half.z),
        s: vec3(1.0, 0.0, 0.0),
        t: vec3(0.0, 1.0, 0.0),
    )
    let waves = scroll(period: 6cm, span: 1.55 * crest_half.y, height: RAIL_RELIEF)
        .repeated(period: 6cm, count: 3, wander: 0.25)
        .mirrored()
    let crest = board(crest_half, round: 3mm)
        .at(vec3(0.0, crest_y, 0.0))
        .carve(
            crest_face,
            waves,
            ground: RAIL_RELIEF,
            region: vec4(-crest_half.x + 1cm, -crest_half.y + 1cm, crest_half.x - 1cm, crest_half.y - 1cm),
        )

    let lower_rail = board(lower_half, round: 2.5mm).at(vec3(0.0, lower_y, 0.0))

    let splat_face = flat_face(
        vec3(0.0, splat_mid, splat_half.z),
        s: vec3(1.0, 0.0, 0.0),
        t: vec3(0.0, 1.0, 0.0),
    )
    let splat = board(splat_half, round: 3mm)
        .at(vec3(0.0, splat_mid, 0.0))
        .carve(
            splat_face,
            rosette(radius: SPLAT_ROSETTE.x, petals: 10, height: SPLAT_ROSETTE.y).set_at(vec2(0.0, 1cm)),
            ground: SPLAT_ROSETTE.y,
            region: vec4(-5.4cm, -5cm, 5.4cm, 7cm),
        )

    crest
        .joined_to(splat, gap: 0.5mm, depth: 0.7mm)
        .joined_to(lower_rail, gap: 0.5mm, depth: 0.7mm)
        .at(vec3(0.0, SEAT_TOP, POST_AT.y), axes: tilted_x(BACK_RAKE))
}

/// Seat apron rails, side stretchers, and a turned front stretcher bracing the front legs.
pub fn rails() -> Craft {
    let apron_sec = [
        pt(vec2(-20mm, 35.5cm)),
        pt(vec2(0mm, 35.5cm), bow: 1.5mm),
        pt(vec2(3mm, 35.9cm), bow: 1.5mm),
        pt(vec2(0mm, 36.3cm)),
        pt(vec2(0mm, 42.7cm)),
        pt(vec2(-20mm, 42.7cm)),
    ]
    let seat_apron = apron(vec2(FRONT_AT.x + 1.2cm, FRONT_AT.y + 1.2cm), corner: 0mm, section: apron_sec)
    let side_sec = [
        pt(vec2(-10mm, 0mm)),
        pt(vec2(10mm, 0mm), bow: 3.5mm),
        pt(vec2(10mm, 22mm)),
        pt(vec2(-10mm, 22mm), bow: 3.5mm),
    ]
    let sides = rail(side_sec, length: FRONT_AT.y - POST_AT.y)
        .at(vec3(FRONT_AT.x, STRETCHER_AT, 0.0), axes: running_z())
        .mirrored_across(x: true)
    let span = 2.0 * FRONT_AT.x
    let front_stretcher = lathe(
        [
            pt(vec2(11mm, -0.5 * span)),
            pt(vec2(11mm, -0.38 * span), bow: 1.5mm),
            pt(vec2(15mm, -0.34 * span), bow: -1mm),
            pt(vec2(12mm, -0.30 * span), bow: 3.5mm),
            pt(vec2(15mm, 0.0), bow: 3.5mm),
            pt(vec2(12mm, 0.30 * span), bow: -1mm),
            pt(vec2(15mm, 0.34 * span), bow: 1.5mm),
            pt(vec2(11mm, 0.38 * span)),
            pt(vec2(11mm, 0.5 * span)),
        ],
    ).at(vec3(0.0, STRETCHER_AT + 4cm, FRONT_AT.y), axes: lying_x())
    seat_apron.with_part(sides).with_part(front_stretcher)
}

/// The chair's unfinished carcass.
pub fn carcass() -> Craft {
    seat()
        .named_piece(0, "seat")
        .with_part(back().named_piece(1, "back"))
        .with_part(
            legs()
                .named_piece(1, "legs")
                .joined_to(rails().named_piece(2, "rails"), gap: 0.6mm, depth: 0.8mm),
        )
        .worn_dings(spacing: KNOCKS.x, radius: KNOCKS.y, depth: KNOCKS.z, seed: 31)
}

/// The carved oak side chair in its antique waxed oak.
pub fn chair() -> Asset {
    carcass().in_material(
        oak(
            [
                log(vec3(0.0, 10cm, -10cm), axis: vec3(1.0, 0.0, 0.0), ring: 2.3mm, seed: 11.0, plank: 14cm),
                log(vec3(30cm, 50cm, 30cm), axis: vec3(0.0, 1.0, 0.0), ring: 1.8mm, seed: 12.0),
                log(vec3(0.0, 70cm, 20cm), axis: vec3(1.0, 0.0, 0.0), ring: 2.0mm, seed: 13.0),
            ],
        ),
    )
}
