// A carved oak side chair (the forge's gold set; its brief and record are in
// chair.provenance.json): a seat 46 cm wide and 42 cm deep, 45 cm up, its edge moulded; turned
// front legs; square back posts rising to 95 cm, their tops rounded; a carved top rail with a
// running scroll, a splat below it carved with a rosette, a seat rail round under the seat, and
// stretchers low between the legs. Waxed oak, darkened, its arms of the back worn where hands
// lift it.
//
// It stands with its feet at y = 0, its front toward +z, centred on the origin. Every number is a
// length in metres.

use kit::shapes::carve::{Carved, FlatFace, carved, flat_face}
use kit::shapes::made::{Dressed, Piece, dressed, piece}
use kit::shapes::making::{
    Banded, Board, Both, Extruded, Folded, Joined, Moulded, Placed, Turned, banded, board, both,
    extruded, folded_across, joined, moulded, placed, turned,
}
use kit::shapes::ornament::{
    Mirrored, Row, Scroll, Set, Rosette, mirrored, rosette, row, scroll, set,
}
use kit::substances::wood::{Oak, log, oak}

/// The seat: half its width and depth, its top 45 cm up, 2.5 cm thick, its edge a round over a
/// fillet.
pub const SEAT_HALF = vec2(0.23, 0.21)
pub const SEAT_TOP: f32 = 0.45
pub const SEAT_EDGE = [
    vec2(-0.02, 0.0),
    vec2(0.0, 0.004),
    vec2(0.0, 0.014),
    vec2(-0.009, 0.025),
    vec2(-0.03, 0.025),
]
pub const SEAT_BOWS = [0.003, 0.0, 0.006, 0.0, 0.0]

/// The front legs' turning, (radius, height), and where they stand.
pub const FRONT_AT = vec2(0.2, 0.18)
pub const FRONT_LEG = [
    vec2(0.018, 0.0),
    vec2(0.022, 0.02),
    vec2(0.015, 0.04),
    vec2(0.024, 0.15),
    vec2(0.015, 0.27),
    vec2(0.02, 0.284),
    vec2(0.016, 0.298),
    vec2(0.018, 0.43),
]
pub const FRONT_BOWS = [0.004, -0.002, 0.009, 0.008, 0.0015, -0.0015, 0.002, 0.0]

/// The back posts: square, 3.6 cm, from the floor to 95 cm, their tops rounded.
pub const POST_AT = vec2(0.2, -0.18)
pub const POST_HALF = vec3(0.018, 0.475, 0.018)

/// The top rail between the posts, 9 cm tall and 2.4 cm thick, its face carved with a running
/// scroll 4 mm proud; the splat below it, 26 cm tall and 14 cm wide, a rosette at its middle.
pub const RAIL = vec3(0.182, 0.045, 0.012)
pub const RAIL_AT: f32 = 0.87
pub const RAIL_RELIEF: f32 = 0.004
pub const PANEL = vec3(0.07, 0.13, 0.009)
pub const PANEL_AT: f32 = 0.66
pub const PANEL_ROSETTE = vec2(0.04, 0.003)

/// The seat rail round under the seat (7 cm tall, 2 cm thick, a bead on its lower edge), and the
/// stretchers 10 cm off the floor between front and back legs.
pub const SEAT_RAIL = [
    vec2(-0.02, 0.35),
    vec2(0.0, 0.35),
    vec2(0.003, 0.354),
    vec2(0.0, 0.358),
    vec2(0.0, 0.427),
    vec2(-0.02, 0.427),
]
pub const SEAT_RAIL_BOWS = [0.0, 0.0015, 0.0015, 0.0, 0.0, 0.0]
pub const STRETCHER = [vec2(-0.011, 0.0), vec2(0.011, 0.0), vec2(0.011, 0.022), vec2(-0.011, 0.022)]
pub const STRETCHER_BOWS = [0.0, 0.004, 0.0, 0.004]
pub const STRETCHER_AT: f32 = 0.1

pub type Seat = Placed<Moulded<5>>

pub type Legs = Both<Folded<Placed<Turned<8>>>, Folded<Placed<Board>>>

pub type TopRail = Carved<Placed<Board>, FlatFace, Mirrored<Row<Scroll>>>

pub type BackPanel = Carved<Placed<Board>, FlatFace, Set<Rosette>>

pub type Back = Both<TopRail, BackPanel>

pub type Rails = Both<Banded<6>, Folded<Placed<Extruded<4>>>>

pub type Carcass = Both<Both<Piece<Seat>, Piece<Back>>, Joined<Piece<Legs>, Piece<Rails>>>

pub type Chair = Dressed<Carcass, Oak<3>>

/// The seat.
pub fn seat() -> Seat {
    placed(
        moulded(SEAT_HALF, corner: 0.012, points: SEAT_EDGE, bulges: SEAT_BOWS),
        at: vec3(0.0, SEAT_TOP - 0.025, 0.0),
    )
}

/// The legs: the turned front legs and the square back posts.
pub fn legs() -> Legs {
    let front = folded_across(
        placed(turned(FRONT_LEG, FRONT_BOWS), at: vec3(FRONT_AT.x, 0.0, FRONT_AT.y)),
        x: true,
    )
    let posts = folded_across(
        placed(board(POST_HALF, round: 0.004), at: vec3(POST_AT.x, POST_HALF.y, POST_AT.y)),
        x: true,
    )
    both(front, posts)
}

/// The back: the carved top rail between the posts and the splat under it.
pub fn back() -> Back {
    let rail = placed(board(RAIL, round: 0.003), at: vec3(0.0, RAIL_AT, POST_AT.y))
    let rail_face = flat_face(
        vec3(0.0, RAIL_AT, POST_AT.y + RAIL.z),
        s: vec3(1.0, 0.0, 0.0),
        t: vec3(0.0, 1.0, 0.0),
    )
    let waves = mirrored(
        row(scroll(period: 0.06, span: 1.6 * RAIL.y, height: RAIL_RELIEF), period: 0.06, count: 3),
    )
    let carved_rail = carved(
        rail,
        rail_face,
        waves,
        ground: RAIL_RELIEF,
        region: vec4(-RAIL.x + 0.008, -RAIL.y + 0.01, RAIL.x - 0.008, RAIL.y - 0.01),
    )
    let panel = placed(board(PANEL, round: 0.003), at: vec3(0.0, PANEL_AT, POST_AT.y))
    let panel_face = flat_face(
        vec3(0.0, PANEL_AT, POST_AT.y + PANEL.z),
        s: vec3(1.0, 0.0, 0.0),
        t: vec3(0.0, 1.0, 0.0),
    )
    let carved_splat = carved(
        panel,
        panel_face,
        set(
            rosette(radius: PANEL_ROSETTE.x, petals: 10, height: PANEL_ROSETTE.y),
            at: vec2(0.0, 0.02),
        ),
        ground: PANEL_ROSETTE.y,
        region: vec4(-0.05, -0.03, 0.05, 0.07),
    )
    both(carved_rail, carved_splat)
}

/// The rails: the seat rail round under the seat, and the side stretchers.
pub fn rails() -> Rails {
    let round = banded(
        vec2(FRONT_AT.x + 0.012, FRONT_AT.y + 0.012),
        corner: 0.0,
        points: SEAT_RAIL,
        bulges: SEAT_RAIL_BOWS,
    )
    // The side stretchers run front to back: their section in their own (z, y) run along x, so
    // they are laid along z.
    let side = folded_across(
        placed(
            extruded(STRETCHER, STRETCHER_BOWS, length: FRONT_AT.y - POST_AT.y),
            at: vec3(FRONT_AT.x, STRETCHER_AT, 0.0),
            axes: kit::shapes::making::running_z(),
        ),
        x: true,
    )
    both(round, side)
}

/// The chair's carcass: the seat on its rails, the back between the posts, the rails tenoned into
/// the legs.
pub fn carcass() -> Carcass {
    both(
        both(piece(0, "seat", seat()), piece(1, "back", back())),
        joined(piece(1, "legs", legs()), piece(2, "rails", rails()), gap: 0.0006, depth: 0.0008),
    )
}

/// The chair in its oak.
pub fn chair() -> Chair {
    dressed(
        carcass(),
        oak(
            [
                log(vec3(0.0, 0.1, -0.1), axis: vec3(1.0, 0.0, 0.0), ring: 0.0023, seed: 11.0),
                log(vec3(0.3, 0.5, 0.3), axis: vec3(0.0, 1.0, 0.0), ring: 0.0018, seed: 12.0),
                log(vec3(0.0, 0.7, 0.2), axis: vec3(1.0, 0.0, 0.0), ring: 0.002, seed: 13.0),
            ],
        ),
    )
}
