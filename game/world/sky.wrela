// This game's sky, for now: a clear day. Light from far off brightest and palest at the horizon,
// deeper blue overhead, and below the horizon the dim light of distant ground; the sun high in
// the south-west of the stage (toward +z, so it lights the wall's +z face), half a degree wide.
// Its numbers are radiance in the engine's units, chosen so the sun lays about four times the
// light the open sky does on a face turned up (a clear day's ratio is about four to ten).

use engine::matter::sky::{Sky, Sun}
use std::hash::StateHash

pub struct Clear: Copy + GpuData + StateHash {
    /// The way toward the sun (unit).
    pub sun: vec3,
    pub spare: f32,
}

/// The clear sky with its sun toward `sun` (any length).
pub fn clear(sun: vec3) -> Clear {
    Clear { sun: normalize(sun), spare: 0.0 }
}

/// The sky's light overhead, at the horizon, and from below it.
const ZENITH: vec3 = vec3(0.10, 0.17, 0.32)
const HORIZON: vec3 = vec3(0.30, 0.34, 0.40)
const BELOW: vec3 = vec3(0.07, 0.065, 0.06)

/// The sun's light on a face square to it, and its angular radius (rad: the sun's, 0.267°).
const SUN_LIGHT: vec3 = vec3(3.2, 3.0, 2.7)
const SUN_SIZE: f32 = 0.00465

impl Sky for Clear {
    fn light(self, way: vec3) -> vec3 {
        if way.y < 0.0 {
            return mix(HORIZON, BELOW, vec3(min(-way.y * 4.0, 1.0)))
        }
        mix(HORIZON, ZENITH, vec3(pow(way.y, 0.5)))
    }

    fn sun(self) -> Sun {
        Sun { way: self.sun, size: SUN_SIZE, light: SUN_LIGHT, spare: 0.0 }
    }
}
