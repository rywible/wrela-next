// A small two-legged creature of rounded parts, the volume spike's walking stand-in
// (spike/volume, spikes/volume/body.wrela), written as a plain author would write it: a round
// cone between two joints of a skeleton as a move has posed them, the parts joined smoothly as
// flesh is, and a wand in its hand joined almost sharply so it stays thin. It rides Hakuro's
// skeleton (`skeleton`) scaled to about 1.2 m to its ears' tips. Two kinds of part are thin on
// purpose: its ears' tips (1.5 cm through) and the wand (1 cm), so a picture that loses thin
// things is seen to.
//
// The spike's body worked out each part's constants on the CPU, chose which parts mattered near a
// place and wrote its own gradient, because its engine needed it to. None of that is here: this
// is std::field's round cones, one smooth union, and a substance (docs/design.md, "Cost is the
// engine's, not the author's").

use kit::substances::matte::matte
use skeleton::{
    BALL_LEFT, CALF_LEFT, FINGERS_LEFT, FOOT_LEFT, FOREARM_LEFT, HAND_LEFT, HAND_RIGHT, HEAD, NECK, PELVIS, REST, SPINE_3,
    THIGH_LEFT, UPPER_ARM_LEFT, posed,
}
use engine::matter::substance::Substance
use std::field::{RoundCone, SmoothUnion, SmoothUnionAll, With, round_cone}

/// How large it is against the skeleton it rides (Hakuro's, a grown man's).
pub const SCALE: f32 = 0.6

/// How wide the join between two of its parts is (m), and the wand's join to its hand.
pub const JOIN: f32 = 0.03
pub const THIN_JOIN: f32 = 0.004

/// Its fur, and the wand's wood (albedos: a mid brown pelt; dark wood).
pub const FUR: vec3 = vec3(0.42, 0.28, 0.16)
pub const WOOD: vec3 = vec3(0.22, 0.13, 0.07)

/// The creature: its seventeen parts of flesh joined, and its wand.
pub type Creature = SmoothUnion<With<SmoothUnionAll<RoundCone, 17>, Substance>, With<RoundCone, Substance>>

/// Where the point `off` m from `bone`'s joint at rest is, posed by `pose` (the skeleton's), in
/// the creature's scale.
fn joint(pose: [mat4; 64], bone: u32, off: vec3) -> vec3 {
    posed(pose, bone, REST[bone] + off) * SCALE
}

/// A part from `a` to `b`, `ra` and `rb` thick there (m, at the skeleton's scale).
fn part(a: vec3, ra: f32, b: vec3, rb: f32) -> RoundCone {
    round_cone(a, b, r_top: ra * SCALE, r_bottom: rb * SCALE)
}

/// The creature as `pose` (its skeleton's palette) stands it: in place, its feet near y = 0,
/// facing +z.
pub fn creature(pose: [mat4; 64]) -> Creature {
    let j = |bone: u32, off: vec3| joint(pose, bone, off)
    var parts = [round_cone(vec3(0.0), vec3(0.0), r_top: 0.0, r_bottom: 0.0); 17]
    // Its trunk, and a big head.
    parts[0] = part(j(PELVIS, vec3(0.0)), 0.17, j(SPINE_3, vec3(0.0)), 0.16)
    parts[1] = part(j(SPINE_3, vec3(0.0)), 0.16, j(NECK, vec3(0.0)), 0.1)
    parts[2] = part(j(HEAD, vec3(0.0, 0.1, 0.02)), 0.25, j(HEAD, vec3(0.0, 0.16, 0.03)), 0.23)
    // Its limbs and ears: a left one and its right (the next bone).
    var n: u32 = 3
    for side in 0..2 {
        parts[n] = part(j(UPPER_ARM_LEFT + side, vec3(0.0)), 0.065, j(FOREARM_LEFT + side, vec3(0.0)), 0.058)
        parts[n + 1] = part(j(FOREARM_LEFT + side, vec3(0.0)), 0.058, j(HAND_LEFT + side, vec3(0.0)), 0.05)
        parts[n + 2] = part(j(HAND_LEFT + side, vec3(0.0)), 0.05, j(FINGERS_LEFT + side, vec3(0.0)), 0.045)
        parts[n + 3] = part(j(THIGH_LEFT + side, vec3(0.0)), 0.09, j(CALF_LEFT + side, vec3(0.0)), 0.072)
        parts[n + 4] = part(j(CALF_LEFT + side, vec3(0.0)), 0.072, j(FOOT_LEFT + side, vec3(0.0)), 0.056)
        parts[n + 5] = part(j(FOOT_LEFT + side, vec3(0.0)), 0.056, j(BALL_LEFT + side, vec3(0.0)), 0.046)
        // An ear, from the head's side to a tip 1.5 cm through.
        let out = if side == 0 { 1.0 } else { -1.0 }
        parts[n + 6] = part(j(HEAD, vec3(0.13 * out, 0.3, 0.02)), 0.05, j(HEAD, vec3(0.2 * out, 0.52, 0.0)), 0.0125)
        n += 7
    }
    // A wand in its right hand, 1 cm through and 36 cm long.
    let wand = part(j(HAND_RIGHT, vec3(0.0)), 0.0084, j(HAND_RIGHT, vec3(-0.12, 0.3, 0.5)), 0.0084)
    parts.smooth_union(k: JOIN).with(matte(FUR)).smooth_union(wand.with(matte(WOOD)), k: THIN_JOIN)
}
