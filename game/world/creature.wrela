// A small two-legged creature of rounded parts, the volume spike's walking stand-in
// (spike/volume, spikes/volume/body.wrela), written as a plain author would write it: a round
// cone between two points of its segments as a pose has placed them, the parts joined smoothly as
// flesh is, and a wand in its hand joined almost sharply so it stays thin. Its body is declared
// once (`creature_segments`, written by a tool from the rig its walk was captured on, at about
// 1.2 m to its ears' tips): the engine poses it (`engine::body`), weighs it and skins it from
// that. Two kinds of part are thin on purpose: its ears' tips (1.5 cm through) and the wand (1 cm), so a picture that loses thin
// things is seen to.
//
// The spike's body worked out each part's constants on the CPU, chose which parts mattered near a
// place and wrote its own gradient, because its engine needed it to. None of that is here: this
// is std::field's round cones, one smooth union, and a substance.

use creature_segments::{BIND_NUMBERS, BIND_ROOT, FREEDOM, PARTS, SEGMENTS, SEGMENT_LIST}
use engine::body::body::{Body, Pose, Span, body}
use engine::body::joint::Frame
use engine::body::mass::{Mass, masses, masses_by_grid}
use engine::body::skin::{Skin, bones, skin, spans_of}
use engine::body::sweep::{cleared, sweep}
use engine::matter::density::Density
use engine::matter::substance::Substance
use engine::matter::verify::prove_field_facts
use kit::substances::densities::TISSUE
use kit::substances::matte::matte
use std::cmp::Eq
use std::derive::{Box3, Interval}
use std::field::{
    Bound, Field, FieldFacts, Live, PartName, Pruned, RoundCone, Skinned, SmoothUnion,
    SmoothUnionAll, Surface, With, round_cone, skinned,
}
use std::hash::StateHash
use std::io::print

/// How wide the join between two of its parts is (m), and the wand's join to its hand.
pub const JOIN: f32 = 0.03
pub const THIN_JOIN: f32 = 0.004

/// Its fur, and the wand's wood (albedos: a mid brown pelt; dark wood).
pub const FUR: vec3 = vec3(0.42, 0.28, 0.16)
pub const WOOD: vec3 = vec3(0.22, 0.13, 0.07)

type CreatureRaw = SmoothUnion<With<SmoothUnionAll<RoundCone, 17>, Substance>, With<RoundCone, Substance>>

/// The creature's underlying 17-part flesh + wand smooth-union field, carrying build-time proven
/// `FieldFacts` so all 256 skinned instances erase transmissive, emissive, coat, and micro paths.
pub struct CreatureFlesh: Copy + GpuData + Eq + StateHash {
    pub inner: CreatureRaw,
}

impl Surface for CreatureFlesh {
    @budget(work: 2048)
    fn distance(self, p: vec3) -> f32 {
        self.inner.distance(p)
    }

    fn distance_within(self, p: vec3, most: f32) -> f32 {
        self.inner.distance_within(p, most)
    }

    fn bound(self) -> Bound {
        self.inner.bound()
    }

    fn lipschitz(self, near: f32) -> f32 {
        self.inner.lipschitz(near)
    }

    fn interval_near(self, b: Box3) -> Interval {
        self.inner.interval_near(b)
    }

    fn parts(self) -> u32 {
        self.inner.parts()
    }

    fn part_at(self, p: vec3) -> (f32, u32) {
        self.inner.part_at(p)
    }

    fn part_distance(self, p: vec3, i: u32) -> f32 {
        self.inner.part_distance(p, i)
    }

    fn part_name(self, i: u32) -> PartName {
        self.inner.part_name(i)
    }

    fn part_offset(self, p: vec3, i: u32, by: f32) -> f32 {
        self.inner.part_offset(p, i, by)
    }

    fn masked(self, p: vec3, live: Live, first: u32) -> f32 {
        self.inner.masked(p, live, first)
    }

    fn pruned<F: Copy + fn(vec3) -> vec3>(
        self,
        over: Box3,
        at: F,
        stretch: f32,
        live: Live,
        first: u32,
    ) -> Pruned {
        self.inner.pruned(over, at, stretch, live, first)
    }
}

impl Field<Substance> for CreatureFlesh {
    fn channels(self, p: vec3) -> Substance {
        self.inner.channels(p)
    }

    fn distance_and_channels(self, p: vec3) -> (f32, Substance) {
        self.inner.distance_and_channels(p)
    }

    fn field_facts(self) -> FieldFacts {
        CREATURE_FACTS
    }
}

/// The creature's body: its segments and joints (`creature_segments`), each joint's range cut
/// where its own flesh stops it (`engine::body::sweep::cleared`: 1 mm, from the bind pose).
@fuel(2 ** 38)
pub const BODY: Body<SEGMENTS> = cleared(body(SEGMENT_LIST), PARTS, BIND, 0.001, 64)

/// The pose its skin is made in: the T-pose, its arms dropped.
pub const BIND: Pose<FREEDOM> = Pose { root: BIND_ROOT, q: BIND_NUMBERS }

/// How many parts its field has (its flesh's 17 and the wand), and how many bones its skin
/// moves with (`engine::body::skin`: a segment each, and a second for each forearm and shin,
/// whose roll spreads along them).
pub const PART_COUNT: u32 = 18
pub const BONES: u32 = 26

/// The creature: its exact posed field and its bind-pose template, which the engine extracts once
/// and deforms each frame on the GPU by its bones (`std::field::Skinned`).
pub type Creature = Skinned<CreatureFlesh, BONES, PART_COUNT>

pub const SPANS: [Span; PART_COUNT] = spans_of(PARTS)
const SKIN: Skin<PART_COUNT> = skin(BODY, BIND, PARTS)

/// Part `i` (of its flesh, or the wand) with its segments at `at`.
fn part(at: [Frame; SEGMENTS], i: u32) -> RoundCone {
    let (a, b) = PARTS[i].placed(at)
    round_cone(a, b, r_top: PARTS[i].ra, r_bottom: PARTS[i].rb)
}

/// Its flesh's 17 parts, with its segments at `at`.
fn flesh_parts(at: [Frame; SEGMENTS]) -> [RoundCone; 17] {
    var parts = [round_cone(vec3(0.0), vec3(0.0), r_top: 0.0, r_bottom: 0.0); 17]
    for i in 0..17 {
        parts[i] = part(at, i)
    }
    parts
}

/// Its flesh and its wand, as they are seen, with its segments at `at`.
fn flesh(at: [Frame; SEGMENTS]) -> CreatureFlesh {
    CreatureFlesh {
        inner: flesh_parts(at)
            .smooth_union(k: JOIN)
            .with(matte(FUR))
            .smooth_union(part(at, 17).with(matte(WOOD)), k: THIN_JOIN),
    }
}

/// Its flesh and its wand as they are weighed, with its segments at `at`: the same shapes, with
/// their densities.
pub fn matter(at: [Frame; SEGMENTS]) -> SmoothUnion<With<SmoothUnionAll<RoundCone, 17>, Density>, With<RoundCone, Density>> {
    flesh_parts(at)
        .smooth_union(k: JOIN)
        .with(TISSUE)
        .smooth_union(part(at, 17).with(kit::substances::densities::WOOD), k: THIN_JOIN)
}

const REST_FLESH: CreatureFlesh = flesh(BODY.places(BIND))
const CREATURE_FACTS: FieldFacts = prove_field_facts(REST_FLESH)

/// What each segment weighs (`engine::body::mass`), in the bind pose.
@fuel(2 ** 40)
pub const MASSES: [Mass; SEGMENTS] = masses(BODY, BIND, matter(BODY.places(BIND)), SPANS, 0.006)

/// The creature as `pose` stands it: in place, its feet near y = 0, facing +z.
pub fn creature(pose: Pose<FREEDOM>) -> Creature {
    skinned(
        flesh(BODY.places(pose)),
        REST_FLESH,
        bones(BODY, SPANS, pose, BIND),
        SKIN.a,
        SKIN.b,
        SKIN.from,
        SKIN.to,
        JOIN,
    )
}

/// A pose with each number turned a different way (and its root where `BIND` has it): parts
/// brought near parts they don't touch at rest.
fn bent() -> Pose<FREEDOM> {
    var p = BIND
    for k in 0..FREEDOM {
        let f = f32(k)
        p.q[k] = 0.35 * sin(f * 2.3)
    }
    p
}

@test
fn creature_field_contracts_are_sound() {
    engine::matter::verify::verify_field_soundness(creature(BIND), "creature_rest")
    engine::matter::verify::verify_field_soundness(creature(bent()), "creature_bent")
    let f_cr = creature(BIND).field_facts()
    assert(
        f_cr.lip < 1.0e12 && !f_cr.may_transmit && !f_cr.may_emit && !f_cr.may_coat &&
            !f_cr.may_micro,
        f"creature facts: lip={f_cr.lip} tx={f_cr.may_transmit} em={f_cr.may_emit} coat={f_cr.may_coat} micro={f_cr.may_micro}",
    )
}

@test
fn a_bent_bodys_posed_distance_asks_only_near_parts_and_is_the_same() {
    let body = creature(bent())
    let bound = body.posed.bound()
    var checked: u32 = 0
    for i in 0..4096 {
        let f = f32(i) + 0.5
        let u = vec3(fract(f * 0.618034), fract(f * 0.754878), fract(f * 0.569840)) * 2.0 -
            vec3(1.0)
        let p = bound.centre + u * bound.radius
        let whole = body.posed.distance(p)
        let pruned = body.posed_local_distance(p)
        assert(
            bitcast_u32(whole) == bitcast_u32(pruned),
            f"posed distance at {p}: {pruned} asked of near parts, {whole} of all",
        )
        if abs(whole) < 0.05 {
            checked += 1
        }
    }
    assert(checked > 16, f"only {checked} points near the surface")
}

@test
@fuel(2 ** 45)
fn each_segment_weighs_what_the_slow_sum_says() {
    let m = MASSES
    let at = BODY.places(BIND)
    // The box its parts fill, and a centimetre more.
    var lo = vec3(1.0e9)
    var hi = vec3(-1.0e9)
    for i in 0..PART_COUNT {
        let p = PARTS[i]
        let (a, b) = p.placed(at)
        lo = min(lo, min(a - vec3(p.ra), b - vec3(p.rb)))
        hi = max(hi, max(a + vec3(p.ra), b + vec3(p.rb)))
    }
    let slow = masses_by_grid(BODY, BIND, matter(at), SPANS, lo - vec3(0.01), hi + vec3(0.01), 0.002)
    var total = 0.0
    for s in 0..SEGMENTS {
        total += m[s].mass
    }
    for s in 0..SEGMENTS {
        let f = m[s].mass
        var w = slow[s].mass
        // A segment of less than 1% of the body is a sliver the 2 mm grid can't weigh to 1%:
        // weighed again at 1 mm, over the box of its bone and 8 cm about it.
        if w > 0.0 && w < 0.01 * total {
            let (a, b) = BODY.bone(at, s)
            let near = masses_by_grid(
                BODY,
                BIND,
                matter(at),
                SPANS,
                min(a, b) - vec3(0.08),
                max(a, b) + vec3(0.08),
                0.001,
            )
            w = near[s].mass
        }
        print(f"creature segment {s}: {f} kg, the slow sum {w} kg, centre {m[s].centre}")
        // To 1% of itself, and 0.05% of the body: the neck is a wedge of 7 g between the head's
        // part and the chest's bone, which grids of 3, 2 and 1 mm weigh at 7.2, 8.0 and 7.4 g.
        assert(
            abs(f - w) <= 0.01 * w + 0.0005 * total,
            f"segment {s}: {f} kg fast, {w} kg slow",
        )
    }
    print(f"creature: {total} kg")
}

/// Each joint swept through its range from the bind pose (`engine::body::sweep`): no two parts
/// on segments that are not neighbours go more than 2 mm further into each other.
@test
@fuel(2 ** 40)
fn no_joint_in_its_range_puts_a_part_into_another() {
    let w = sweep(BODY, PARTS, BIND)
    var worst = 0.0
    for s in 1..SEGMENTS {
        if w[s].deeper > 0.0 {
            print(f"sweep: segment {s} number {w[s].number} at {w[s].value}: cones {w[s].cones.x} and {w[s].cones.y} {w[s].deeper * 1000.0} mm deeper")
        }
        worst = max(worst, w[s].deeper)
    }
    assert(worst <= 0.002, f"a part goes {worst * 1000.0} mm into another")
}
