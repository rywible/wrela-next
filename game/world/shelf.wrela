// A carved oak wall shelf (the forge's gold set; its brief and record are in shelf.provenance.json):
// a board 70 cm long and 22 cm deep, its front edge moulded with a thumbnail, on two brackets cut
// in an ogee and carved on their faces with a rosette, a back rail across them that hangs on the
// wall, the brackets tenoned into the rail with their seams showing. Waxed oak, darkened.
//
// The shelf's back is at z = 0 against the wall, its board's top at y = 0, its length along x.
// Every number is a length in metres.

use kit::shapes::carve::{Carved, FlatFace, carved, flat_face}
use kit::shapes::made::{Dressed, Piece, dressed, piece}
use kit::shapes::making::{
    Board, Both, Extruded, Folded, Joined, Moulded, Placed, both, board, extruded, folded_across,
    joined, moulded, placed,
}
use kit::shapes::ornament::{Rosette, Set, rosette, set}
use kit::substances::wood::{Oak, log, oak}

/// The board: half its length and half its depth, 22 mm thick, its front edge a thumbnail (a
/// quarter round over a fillet), (out from the edge, height from its underside).
pub const BOARD_HALF = vec2(0.35, 0.11)
pub const BOARD_EDGE = [
    vec2(-0.02, 0.0),
    vec2(0.0, 0.0),
    vec2(0.0, 0.008),
    vec2(-0.012, 0.022),
    vec2(-0.03, 0.022),
]
pub const BOARD_BOWS = [0.0, 0.0, 0.006, 0.0, 0.0]

/// A bracket's side outline, (out from the wall, height from the board's underside), traced with
/// its inside on the left: out along its foot from the wall, up and out in an ogee (a swell, a
/// long cove, a shoulder, a bead under the board), back along the board, and down the wall. 2.2 cm
/// thick.
pub const BRACKET = [
    vec2(0.0, -0.2),
    vec2(0.03, -0.2),
    vec2(0.05, -0.15),
    vec2(0.13, -0.06),
    vec2(0.165, -0.025),
    vec2(0.17, 0.0),
    vec2(0.0, 0.0),
]
pub const BRACKET_BOWS = [0.0, 0.006, -0.015, 0.008, 0.003, 0.0, 0.0]
pub const BRACKET_THICK: f32 = 0.022
/// The brackets stand 26 cm either side of the middle.
pub const BRACKET_AT: f32 = 0.26

/// The back rail: across the brackets' backs, 6 cm tall and 2 cm thick, under the board.
pub const RAIL_HALF = vec3(0.33, 0.03, 0.01)

/// The rosette carved on each bracket's outer face, 3 cm round, 2.5 mm proud.
pub const ROSETTE = vec2(0.03, 0.0025)

pub type Top = Placed<Moulded<5>>

pub type Bracket = Carved<Placed<Extruded<7>>, FlatFace, Set<Rosette>>

pub type Brackets = Folded<Bracket>

pub type Rail = Placed<Board>

pub type Carcass = Both<Piece<Top>, Joined<Piece<Brackets>, Piece<Rail>>>

pub type Shelf = Dressed<Carcass, Oak<3>>

/// The board.
pub fn top() -> Top {
    placed(
        moulded(BOARD_HALF, corner: 0.004, points: BOARD_EDGE, bulges: BOARD_BOWS),
        at: vec3(0.0, -0.022, BOARD_HALF.y),
    )
}

/// One bracket, at x = +`BRACKET_AT`, its rosette on its outer face; `brackets` mirrors it.
pub fn bracket() -> Bracket {
    // The outline is in the bracket's own (z, y), run along x: its back at z = 0, its top under the
    // board.
    let side = placed(
        extruded(BRACKET, BRACKET_BOWS, length: BRACKET_THICK),
        at: vec3(BRACKET_AT, -0.022, 0.0),
    )
    // The outer face: s toward the wall (so w, along s × t, points out of it), t up.
    let face = flat_face(
        vec3(BRACKET_AT + 0.5 * BRACKET_THICK, -0.022, 0.0),
        s: vec3(0.0, 0.0, -1.0),
        t: vec3(0.0, 1.0, 0.0),
    )
    carved(
        side,
        face,
        set(rosette(radius: ROSETTE.x, petals: 8, height: ROSETTE.y), at: vec2(-0.06, -0.07)),
        ground: ROSETTE.y,
        region: vec4(-0.094, -0.104, -0.026, -0.036),
    )
}

/// The shelf's carcass: the board resting on the brackets, the brackets tenoned into the rail.
pub fn carcass() -> Carcass {
    let brackets = folded_across(bracket(), x: true)
    let rail = placed(
        board(RAIL_HALF, round: 0.002),
        at: vec3(0.0, -0.022 - RAIL_HALF.y, RAIL_HALF.z),
    )
    both(
        piece(0, "board", top()),
        joined(piece(1, "brackets", brackets), piece(2, "rail", rail), gap: 0.0006, depth: 0.0008),
    )
}

/// The shelf in its oak: the board plain-sawn, the brackets and rail quarter-sawn.
pub fn shelf() -> Shelf {
    dressed(
        carcass(),
        oak(
            [
                log(vec3(0.0, -0.3, 0.1), axis: vec3(1.0, 0.0, 0.0), ring: 0.0022, seed: 7.0),
                log(vec3(0.4, -0.1, -0.2), axis: vec3(0.0, 1.0, 0.0), ring: 0.0019, seed: 8.0),
                log(vec3(0.0, 0.2, -0.3), axis: vec3(1.0, 0.0, 0.0), ring: 0.002, seed: 9.0),
            ],
        ),
    )
}
