// A carved oak wall shelf (the forge's gold set; its brief and record are in shelf.provenance.json):
// a planked board 70 cm long and 22 cm deep with an ovolo-over-cove front moulding, borne on two
// ogee-scrolled brackets carved with rosettes on their outer faces, tenoned cleanly into a
// bevelled wall rail. Rich antique waxed oak.
//
// Back against the wall at z = 0, board top at y = 0, length along x.

use kit::shapes::carve::flat_face
use kit::shapes::craft::{Craft, MotifOps, pt, rail, slab}
use kit::shapes::made::Asset
use kit::shapes::making::board
use kit::shapes::ornament::rosette
use kit::substances::wood::{log, oak}
use std::units::{cm, mm}

pub const BOARD_HALF = vec2(35cm, 11cm)
pub const BOARD_THICK: f32 = 2.4cm
pub const BRACKET_THICK: f32 = 2.2cm
pub const BRACKET_AT: f32 = 26cm
pub const RAIL_HALF = vec3(33cm, 3.2cm, 1cm)
pub const ROSETTE = vec2(3cm, 2.6mm)
pub const KNOCKS = vec3(4cm, 6mm, 0.10mm)

/// The moulded shelf board.
pub fn top() -> Craft {
    let edge = [
        pt(vec2(-22mm, 0mm), bow: -1.5mm),
        pt(vec2(-2mm, 4mm)),
        pt(vec2(0mm, 10mm), bow: 6.5mm),
        pt(vec2(-12mm, BOARD_THICK)),
        pt(vec2(-30mm, BOARD_THICK)),
    ]
    slab(BOARD_HALF, corner: 5mm, edge: edge).at(vec3(0.0, -BOARD_THICK, BOARD_HALF.y))
}

/// One carved ogee bracket at x = +`BRACKET_AT`, mirrored cleanly across x = 0.
pub fn bracket() -> Craft {
    let outline = [
        pt(vec2(0mm, -20cm)),
        pt(vec2(3cm, -20cm), bow: 6mm),
        pt(vec2(5cm, -15cm), bow: -15mm),
        pt(vec2(13cm, -6cm), bow: 8mm),
        pt(vec2(16.5cm, -2.5cm), bow: 3mm),
        pt(vec2(17cm, 0mm)),
        pt(vec2(0mm, 0mm)),
    ]
    let face = flat_face(
        vec3(BRACKET_AT + 0.5 * BRACKET_THICK, -BOARD_THICK, 0.0),
        s: vec3(0.0, 0.0, -1.0),
        t: vec3(0.0, 1.0, 0.0),
    )
    rail(outline, length: BRACKET_THICK)
        .at(vec3(BRACKET_AT, -BOARD_THICK, 0.0))
        .carve(
            face,
            rosette(radius: ROSETTE.x, petals: 8, height: ROSETTE.y).set_at(vec2(-6cm, -7cm)),
            ground: ROSETTE.y,
            region: vec4(-9.4cm, -10.4cm, -2.6cm, -3.6cm),
        )
}

/// The shelf's unfinished carcass.
pub fn carcass() -> Craft {
    let wall_rail = board(RAIL_HALF, round: 2.5mm)
        .at(vec3(0.0, -BOARD_THICK - RAIL_HALF.y, RAIL_HALF.z))
    top()
        .named_piece(0, "board")
        .with_part(
            bracket()
                .mirrored_across(x: true)
                .named_piece(1, "brackets")
                .joined_to(wall_rail.named_piece(2, "rail"), gap: 0.6mm, depth: 0.8mm),
        )
        .worn_dings(spacing: KNOCKS.x, radius: KNOCKS.y, depth: KNOCKS.z, seed: 21)
}

/// The carved oak wall shelf in its antique waxed oak.
pub fn shelf() -> Asset {
    carcass().in_material(
        oak(
            [
                log(vec3(0.0, -30cm, 10cm), axis: vec3(1.0, 0.0, 0.0), ring: 2.2mm, seed: 7.0, plank: 11cm),
                log(vec3(40cm, -10cm, -20cm), axis: vec3(0.0, 1.0, 0.0), ring: 1.9mm, seed: 8.0),
                log(vec3(0.0, 20cm, -30cm), axis: vec3(1.0, 0.0, 0.0), ring: 2.0mm, seed: 9.0),
            ],
        ),
    )
}
