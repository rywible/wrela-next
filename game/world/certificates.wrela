/// What the build proves of each field's facts (`engine::matter::verify::prove_field_facts`): its
/// steepness near its surface (`inf` where a box near it couldn't be bounded, so the engine's
/// solvers take the sound affine path), and whether its channels were proven in range (so
/// shading's guards are erased), and whether its distance reads its point alone. It reports; a
/// field whose `lip` turns `inf` lost a proof.
@test
fn field_facts_report() {
    let courtyard = arena_courtyard()
    let pillars = arena_pillars()
    let stands = arena_brazier_stands()
    let flame = arena_flames(0.5)[0]
    let arc = parry_arc(0.5)
    let orb = rival_orb(0.5)
    let stroke = parry::bolt(time: 0.5, struck: 1.0)
    let fused = parry::glass_branch(age: 0.3, whole: 1.0)
    let shard = glass_barrage(0.5)[0]
    let walls = citadel()
    let column = marble_column()
    let body = creature([translate(vec3(0.0)); 64])
    // Whether its distance reads its point alone (`std::derive::reads_only_input`): nothing it
    // captures, no time and no state, so its mesh is the same for every moment.
    let rows = [
        (
            "arena_courtyard",
            courtyard.field_facts(),
            reads_only_input(|p: vec3| courtyard.distance(p)),
        ),
        ("arena_pillars", pillars.field_facts(), reads_only_input(|p: vec3| pillars.distance(p))),
        (
            "arena_brazier_stands",
            stands.field_facts(),
            reads_only_input(|p: vec3| stands.distance(p)),
        ),
        ("arena_flame", flame.field_facts(), reads_only_input(|p: vec3| flame.distance(p))),
        ("parry_arc", arc.field_facts(), reads_only_input(|p: vec3| arc.distance(p))),
        ("rival_orb", orb.field_facts(), reads_only_input(|p: vec3| orb.distance(p))),
        ("bolt", stroke.field_facts(), reads_only_input(|p: vec3| stroke.distance(p))),
        ("glass_branch", fused.field_facts(), reads_only_input(|p: vec3| fused.distance(p))),
        ("glass_shard", shard.field_facts(), reads_only_input(|p: vec3| shard.distance(p))),
        ("citadel", walls.field_facts(), reads_only_input(|p: vec3| walls.distance(p))),
        ("marble_column", column.field_facts(), reads_only_input(|p: vec3| column.distance(p))),
        ("creature", body.field_facts(), reads_only_input(|p: vec3| body.distance(p))),
    ]
    for i in 0..10 {
        let (name, f, only) = rows[i]
        print(
            f"facts: {name}: lip {f.lip}, channels proven {f.channels_proven}, reads only its point {only}",
        )
    }
}

/// Each kind's parts, named, and the change class of each (phase 2 of
/// docs/plans/engine-at-build.md: `engine::mesh::extract::part_classes`), from the kind at two
/// moments a frame apart, as the scenes build it: what the engine extracts again when the time
/// moves. It reports.
@test
fn part_classes_report() {
    let dt = 1.0 / 60.0
    report_kind("arena_courtyard", arena_courtyard(), arena_courtyard())
    report_kind("arena_pillars", arena_pillars(), arena_pillars())
    report_kind("arena_brazier_stands", arena_brazier_stands(), arena_brazier_stands())
    report_kind("arena_flame", arena_flames(0.5)[0], arena_flames(0.5 + dt)[0])
    report_kind("parry_arc", parry_arc(0.5), parry_arc(0.5 + dt))
    report_kind("rival_orb", rival_orb(0.5), rival_orb(0.5 + dt))
    report_kind("bolt", parry::bolt(time: 0.5, struck: 1.0), parry::bolt(time: 0.5 + dt, struck: 1.0))
    report_kind(
        "glass_branch",
        parry::glass_branch(age: 0.3, whole: 1.0),
        parry::glass_branch(age: 0.3 + dt, whole: 1.0),
    )
    report_kind("glass_shard", glass_barrage(0.5)[0], glass_barrage(0.5 + dt)[0])
    report_kind("citadel", citadel(), citadel())
    report_kind("marble_column", marble_column(), marble_column())
    report_kind("stack", stack(TALL_STACK), stack(TALL_STACK))
    report_kind("stage", stage(), stage())
    report_kind("table", table(), table())
    report_kind("grimoire", grimoire(), grimoire())
    // A body posed a frame apart: every bone moved.
    report_kind(
        "creature",
        creature([translate(vec3(0.0)); 64]),
        creature([translate(vec3(0.0, 0.01, 0.0)); 64]),
    )
}

fn report_kind<M: Field<Substance> + StateHash>(name: str, then: M, now: M) {
    let classes = part_classes(then, now)
    var line = f"parts: {name}: {classes.len()}:"
    for i in 0..classes.len() {
        let c = if classes[i] == NEVER { "never" } else if classes[i] == FRAME { "frame" } else {
            "state"
        }
        line = f"{line} {i}{now.part_name(i).name}={c}"
    }
    print(line)
}

/// At cells `h` m wide round 100 points of `s`'s surface (where rays from inside its bound meet
/// it, the point at the cell's middle), with the parts live in each: how many of their
/// enclosures have slopes (`Surface::slope_affine`: one with none is a ball, and certifies only
/// by its size), and how many `certify_sheet` certifies in a slab `width` m wide parallel to the
/// surface at the point. What a kind is worth as a scene places it, at the cells it is meshed at
/// there. The rays start at `all.sample(from, k)` toward `all.sample(toward, k)`. It reports.
fn placed_cells<S: Surface>(s: S, label: str, h: f32, width: f32, from: u32, toward: u32) {
    let b = s.bound()
    let one = [s]
    let all = Box3 { lo: b.centre - vec3(b.radius), hi: b.centre + vec3(b.radius) }
    var n: u32 = 0
    var certified: u32 = 0
    var sloped: u32 = 0
    var k: u32 = 0
    while n < 100 && k < 4000 {
        let o = all.sample(from, k)
        let d0 = all.sample(toward, k) - b.centre
        k += 1
        if length(d0) < 0.01 {
            continue
        }
        let d = normalize(d0)
        var t = 0.0
        var hit = false
        for _ in 0..256 {
            let f = s.distance(o + d * t)
            if abs(f) < 1.0e-5 {
                hit = true
                break
            }
            t += abs(f) / max(s.lipschitz(abs(f)), 1.0)
            if t > 2.0 * b.radius {
                break
            }
        }
        if !hit {
            continue
        }
        let p = o + d * t
        let g = gradient(|q: vec3| s.distance(q), p)
        let gl = length(g)
        if !(gl > 1.0e-6) {
            continue
        }
        let lo = p - vec3(0.5 * h)
        let bx = Box3 { lo, hi: lo + vec3(h) }
        let live = s.live(bx)
        if length(s.slope_affine(bx, live).l) > 1.0e-6 {
            sloped += 1
        }
        if certify_sheet(one, 0, live, lo, h, p, g / gl, width) {
            certified += 1
        }
        n += 1
    }
    print(f"cells({label}) at {h} m: {n} cells; sloped {sloped}, certified within {width} m {certified}")
}

/// The made things (the table, the grimoire, the candlestick, the chair, the shelf): each as a
/// room places it, at the cells it is meshed at there, and as made at the scoreboard's three
/// sizes (`certify_report`). It reports.
@test
fn made_things_certificates() {
    let stick = candlestick()
    let desk = table()
    let book = grimoire()
    let seat = chair()
    let ledge = shelf()
    let book_w = book
        .rotate(Quat::axis_angle(vec3(0.0, 1.0, 0.0), 0.35))
        .translate(vec3(0.16, 0.76 + 0.0352, 1.46))
    let desk_w = desk.translate(vec3(0.0, 0.0, 1.4))
    let seat_w = seat
        .rotate(Quat::axis_angle(vec3(0.0, 1.0, 0.0), 3.1415927))
        .translate(vec3(-0.3, 0.0, 2.02))
    placed_cells(book_w, "grimoire", h: 0.00483, width: 0.00083, from: 37, toward: 41)
    placed_cells(stick, "candlestick", h: 0.0048, width: 0.4 * 0.0048, from: 11, toward: 13)
    placed_cells(desk_w, "table", h: 0.0037, width: 0.5 * 0.0037, from: 19, toward: 23)
    placed_cells(seat_w, "chair", h: 0.0048, width: 0.44 * 0.0048, from: 29, toward: 31)
    certify_report(desk, "table", boxes: 100)
    certify_report(book, "grimoire", boxes: 100)
    certify_report(stick, "candlestick", boxes: 100)
    certify_report(seat, "chair", boxes: 100)
    certify_report(ledge, "shelf", boxes: 100)
}

// The made things' enclosures (`Surface::slope_box`), each as made and as a room places it
// (moved, and the grimoire and the chair turned): the one part of a surface's contract
// (`verify_surface_soundness`) a whole made thing is light enough for; its bound, its steepness
// and its ranges are held part by part by the kit's own contracts (lib/kit/shapes).

@test
fn table_enclosures_are_sound() {
    let desk = table()
    verify_slope_soundness(desk, "table")
    verify_slope_soundness(desk.translate(vec3(0.0, 0.0, 1.4)), "table placed")
}

@test
fn grimoire_enclosures_are_sound() {
    let book = grimoire()
    verify_slope_soundness(book, "grimoire")
    let placed = book
        .rotate(Quat::axis_angle(vec3(0.0, 1.0, 0.0), 0.35))
        .translate(vec3(0.16, 0.76 + 0.0352, 1.46))
    verify_slope_soundness(placed, "grimoire placed")
}

@test
fn candlestick_enclosures_are_sound() {
    let stick = candlestick()
    verify_slope_soundness(stick, "candlestick")
    verify_slope_soundness(stick.translate(vec3(-0.32, 0.76, 1.24)), "candlestick placed")
}

@test
fn chair_enclosures_are_sound() {
    let seat = chair()
    verify_slope_soundness(seat, "chair")
    let placed = seat
        .rotate(Quat::axis_angle(vec3(0.0, 1.0, 0.0), 3.1415927))
        .translate(vec3(-0.3, 0.0, 2.02))
    verify_slope_soundness(placed, "chair placed")
}

@test
fn shelf_enclosures_are_sound() {
    let ledge = shelf()
    verify_slope_soundness(ledge, "shelf")
    verify_slope_soundness(ledge.translate(vec3(0.4, 1.45, -3.0)), "shelf placed")
}

/// What the extraction's cull keeps of each moving kind of the arena and the parry
/// (`engine::mesh::census`): of the bricks round it at a cell size, those the cull keeps, and of
/// them those its surface crosses. Kept and not crossed is work that meshes to nothing.
@test
fn cull_census_report() {
    census_line("parry_arc", parry_arc(0.5), 0.01)
    census_line("parry_arc", parry_arc(0.5), 0.005)
    census_line("rival_orb", rival_orb(0.5), 0.005)
    census_line("arena_flame", arena_flames(0.5)[0], 0.005)
    census_line("bolt", parry::bolt(time: 0.5, struck: 1.0), 0.004)
    census_line("bolt, absent", parry::bolt(time: 0.5, struck: 0.0), 0.004)
    let absent = cull_census(parry::bolt(time: 0.5, struck: 0.0), 0.004)
    assert(absent.kept == 0, f"an absent bolt (a path of no width) keeps {absent.kept} bricks")
    census_line("glass_branch", parry::glass_branch(age: 0.3, whole: 1.0), 0.008)
}

fn census_line<M: Field<Substance>>(name: str, f: M, cell: f32) {
    let c = cull_census(f, cell)
    let ratio = f32(c.kept) / max(f32(c.crossed), 1.0)
    print(
        f"census: {name} at {cell * 1000.0} mm: {c.bricks} bricks, supers kept {c.supers_kept} of {c.supers}, bricks kept {c.kept}, crossed {c.crossed} ({ratio} kept a crossed)",
    )
}

/// A branch of glass that cools changes its light and not its shape, and what its mesh is made
/// of (`engine::mesh::extract::mesh_key`, the compiler's account of what of a field a mesh
/// asks) keeps its shape and its glow's share (`glow.w`) and none of its colour: the batch
/// meshes it once while it cools.
@test
fn a_cooling_branch_keeps_its_mesh_key() {
    let a = parry::glass_branch(age: 0.3, whole: 1.0)
    let b = parry::glass_branch(age: 0.9, whole: 1.0)
    let ka = std::derive::kept_deps(|f: parry::GlassBranch, q: MeshAsk| mesh_answer(f, q), a)
    let kb = std::derive::kept_deps(|f: parry::GlassBranch, q: MeshAsk| mesh_answer(f, q), b)
    assert(ka.glow == vec4(0.0, 0.0, 0.0, 1.0), f"the glow kept: {ka.glow}")
    assert(ka.joints[0] == a.joints[0] && ka.spurs[3] == a.spurs[3], "the shape is kept")
    assert(ka == kb, "a moment later the kept shape is the same")
}

/// Whether an enclosure says nothing of the cell `h` wide it is over: no slopes (a ball, its
/// plane flat and its rest all error), or an error past the cell's own width.
fn slopeless(sb: std::field::SlopeBox, h: f32) -> bool {
    // A distance's slope is about one: a plane a quarter of that or less is no slope.
    length(sb.l) < 0.125 * h || !(abs(sb.r.x) + abs(sb.r.y) + abs(sb.r.z) + sb.e < h)
}

/// Why the candlestick's cells don't certify (docs/plans/build-time-engine-4d.md, phase 0 step
/// 5): of cells 4.8 mm wide round points on its surface, those not certified within a quarter
/// cell, each put to the layer of the asset whose enclosure has no slopes there first: the turned
/// profile alone (`stick_turned`: a profile's unsure nearest segment), the carving of its foot
/// (`stick`: `Carved`), the asset's dings and material (`candlestick`), or none (the slopes are
/// there and the cell is curved or wide past the slab). And the parts live in each failing cell.
@test
fn candlestick_enclosure_census() {
    let whole = candlestick::candlestick()
    let carved = candlestick::stick()
    let turned = candlestick::stick_turned()
    let h = 0.0048
    let b = whole.bound()
    let r = min(b.radius, 1.0e4)
    var cells: u32 = 0
    var certified: u32 = 0
    var by_profile: u32 = 0
    var by_carving: u32 = 0
    var by_asset: u32 = 0
    var by_width: u32 = 0
    var width_turned_ok: u32 = 0
    var width_carved_ok: u32 = 0
    var slab_sum = 0.0
    var live_sum: u32 = 0
    var live_most: u32 = 0
    var k: u32 = 0
    while cells < 100 && k < 8000 {
        let o = b.centre + (vec3(cu01(k * 7 + 1), cu01(k * 7 + 2), cu01(k * 7 + 3)) - vec3(0.5)) * r
        let dv = vec3(cu01(k * 7 + 4), cu01(k * 7 + 5), cu01(k * 7 + 6)) - vec3(0.5)
        k += 1
        if length(dv) < 0.05 {
            continue
        }
        let d = normalize(dv)
        var t = 0.0
        var hit = false
        for _ in 0..256 {
            let f = whole.distance(o + d * t)
            if abs(f) < 1.0e-5 {
                hit = true
                break
            }
            t += abs(f) / max(whole.lipschitz(abs(f)), 1.0)
            if t > 2.0 * r {
                break
            }
        }
        if !hit {
            continue
        }
        let p = o + d * t
        let g = gradient(|q: vec3| whole.distance(q), p)
        if !(length(g) > 1.0e-6) {
            continue
        }
        let lo = p - vec3(0.5 * h)
        let cell = Box3 { lo, hi: lo + vec3(h) }
        cells += 1
        if certify_sheet([whole], 0, std::field::ALL_LIVE, lo, h, p, normalize(g), 0.25 * h) {
            certified += 1
            continue
        }
        let live = whole.pruned(cell, |q: vec3| q, 1.0, std::field::ALL_LIVE, 0).live.count(whole.parts())
        live_sum += live
        live_most = max(live_most, live)
        if slopeless(turned.slope_box(cell, |q: vec3| q, std::field::MapBox::of(cell), std::field::ALL_LIVE, 0), h) {
            by_profile += 1
        } else if slopeless(carved.slope_box(cell, |q: vec3| q, std::field::MapBox::of(cell), std::field::ALL_LIVE, 0), h) {
            by_carving += 1
        } else if slopeless(whole.slope_box(cell, |q: vec3| q, std::field::MapBox::of(cell), std::field::ALL_LIVE, 0), h) {
            by_asset += 1
        } else {
            by_width += 1
            if certify_sheet([turned], 0, std::field::ALL_LIVE, lo, h, p, normalize(g), 0.25 * h) {
                width_turned_ok += 1
            }
            if certify_sheet([carved], 0, std::field::ALL_LIVE, lo, h, p, normalize(g), 0.25 * h) {
                width_carved_ok += 1
            }
            let sb = whole.slope_box(cell, |q: vec3| q, std::field::MapBox::of(cell), std::field::ALL_LIVE, 0)
            let slab = (abs(sb.r.x) + abs(sb.r.y) + abs(sb.r.z) + sb.e) / max(length(sb.l) / (0.5 * h), 1.0e-6)
            slab_sum += slab / h
        }
    }
    let failing = cells - certified
    print(
        f"census: of the {by_width} with slopes: the turned profile alone certifies {width_turned_ok}, the carved stick alone {width_carved_ok}; their enclosure's slab half-width a cell {slab_sum / max(f32(by_width), 1.0)} (a quarter cell certifies)",
    )
    print(
        f"census: candlestick at 4.8 mm: {cells} cells, {certified} certified within h/4; of the {failing} not: no slopes or an error past the cell in the turned profile {by_profile}, in the carving {by_carving}, in the asset's dings and material {by_asset}, slopes and an error within the cell but wider than the slab {by_width}; live parts a failing cell {f32(live_sum) / max(f32(failing), 1.0)} (most {live_most}) of {whole.parts()}",
    )
}

fn cu01(k: u32) -> f32 {
    f32(std::field::hash_u32(k) >> 8) * (1.0 / 16777216.0)
}
