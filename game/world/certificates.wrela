}

/// What the build proves of each field's facts (`engine::matter::verify::prove_field_facts`): its
/// steepness near its surface (`inf` where a box near it couldn't be bounded, so the engine's
/// solvers take the sound affine path), and whether its channels were proven in range (so
/// shading's guards are erased), and whether its distance reads its point alone. It reports; a
/// field whose `lip` turns `inf` lost a proof.
@test
fn field_facts_report() {
    let courtyard = arena_courtyard()
    let pillars = arena_pillars()
    let stands = arena_brazier_stands()
    let flame = arena_flames(0.5)[0]
    let arc = parry_arc(0.5)
    let orb = rival_orb(0.5)
    let shard = glass_barrage(0.5)[0]
    let walls = citadel()
    let column = marble_column()
    let body = creature([translate(vec3(0.0)); 64])
    // Whether its distance reads its point alone (`std::derive::reads_only_input`): nothing it
    // captures, no time and no state, so its mesh is the same for every moment.
    let rows = [
        (
            "arena_courtyard",
            courtyard.field_facts(),
            reads_only_input(|p: vec3| courtyard.distance(p)),
        ),
        ("arena_pillars", pillars.field_facts(), reads_only_input(|p: vec3| pillars.distance(p))),
        (
            "arena_brazier_stands",
            stands.field_facts(),
            reads_only_input(|p: vec3| stands.distance(p)),
        ),
        ("arena_flame", flame.field_facts(), reads_only_input(|p: vec3| flame.distance(p))),
        ("parry_arc", arc.field_facts(), reads_only_input(|p: vec3| arc.distance(p))),
        ("rival_orb", orb.field_facts(), reads_only_input(|p: vec3| orb.distance(p))),
        ("glass_shard", shard.field_facts(), reads_only_input(|p: vec3| shard.distance(p))),
        ("citadel", walls.field_facts(), reads_only_input(|p: vec3| walls.distance(p))),
        ("marble_column", column.field_facts(), reads_only_input(|p: vec3| column.distance(p))),
        ("creature", body.field_facts(), reads_only_input(|p: vec3| body.distance(p))),
    ]
    for i in 0..10 {
        let (name, f, only) = rows[i]
        print(
            f"facts: {name}: lip {f.lip}, channels proven {f.channels_proven}, reads only its point {only}",
        )
    }
}

/// Each kind's parts, named, and the change class of each (phase 2 of
/// docs/plans/engine-at-build.md: `engine::mesh::extract::part_classes`), from the kind at two
/// moments a frame apart, as the scenes build it: what the engine extracts again when the time
/// moves. It reports.
@test
fn part_classes_report() {
    let dt = 1.0 / 60.0
    report_kind("arena_courtyard", arena_courtyard(), arena_courtyard())
    report_kind("arena_pillars", arena_pillars(), arena_pillars())
    report_kind("arena_brazier_stands", arena_brazier_stands(), arena_brazier_stands())
    report_kind("arena_flame", arena_flames(0.5)[0], arena_flames(0.5 + dt)[0])
    report_kind("parry_arc", parry_arc(0.5), parry_arc(0.5 + dt))
    report_kind("rival_orb", rival_orb(0.5), rival_orb(0.5 + dt))
    report_kind("glass_shard", glass_barrage(0.5)[0], glass_barrage(0.5 + dt)[0])
    report_kind("citadel", citadel(), citadel())
    report_kind("marble_column", marble_column(), marble_column())
    report_kind("stack", stack(TALL_STACK), stack(TALL_STACK))
    report_kind("stage", stage(), stage())
    report_kind("table", table(), table())
    report_kind("grimoire", grimoire(), grimoire())
    // A body posed a frame apart: every bone moved.
    report_kind(
        "creature",
        creature([translate(vec3(0.0)); 64]),
        creature([translate(vec3(0.0, 0.01, 0.0)); 64]),
    )
}

fn report_kind<M: Field<Substance> + StateHash>(name: str, then: M, now: M) {
    let classes = part_classes(then, now)
    var line = f"parts: {name}: {classes.len()}:"
    for i in 0..classes.len() {
        let c = if classes[i] == NEVER { "never" } else if classes[i] == FRAME { "frame" } else {
            "state"
        }
        line = f"{line} {i}{now.part_name(i).name}={c}"
    }
    print(line)
}

fn check_slope_sound<S: Surface>(s: S, label: str) {
    let b = s.bound()
    let r = min(b.radius, 10.0)
    let world_box = Box3 { lo: b.centre - vec3(r), hi: b.centre + vec3(r) }
    var checked: u32 = 0
    for i in 0..120 {
        let c = world_box.sample(17, i)
        let h = if (i & 1) == 0 { 0.005 } else { 0.02 }
        let bx = Box3 { lo: c - vec3(0.5 * h), hi: c + vec3(0.5 * h) }
        let af = s.slope_affine(bx, ALL_LIVE)
        let lo = af.lo()
        let hi = af.hi()
        let hl = 0.5 * bx.lo
        let hh = 0.5 * bx.hi
        let cb = hl + hh
        let hin = (hh - hl) * (1.0 + 2.0 / 8388608.0)
        for j in 0..16 {
            let p = bx.sample(31 + i, j)
            let d = s.distance(p)
            assert(
                d >= lo - 1.0e-5 && d <= hi + 1.0e-5,
                f"slope_sound({label}): d={d} outside [{lo}, {hi}] at {p} in box {bx.lo}..{bx.hi}",
            )
            let u = (p - cb) / hin
            let pred = af.c + dot(af.l, u)
            assert(
                abs(d - pred) <= af.e + 2.0e-5,
                f"slope_sound({label}): |d - pred|={abs(d - pred)} > e={af.e} at {p}",
            )
            checked += 1
        }
    }
    print(f"slope_sound({label}): ok ({checked} points)")
}

@test
fn slope_box_report() {
    let stick = candlestick()
    let desk = table()
    let book = grimoire()
    let seat = chair()
    let ledge = shelf()
    // Measure grimoire at its actual SCENE 14 cell size (4.83 mm).
    let book_w = book
        .rotate(std::quat::Quat::axis_angle(vec3(0.0, 1.0, 0.0), 0.35))
        .translate(vec3(0.16, 0.76 + 0.0352, 1.46))
    let one_bw = [book_w]
    let bb = book_w.bound()
    var nb: u32 = 0
    var cb: u32 = 0
    var hsb: u32 = 0
    var kb: u32 = 0
    while nb < 100 && kb < 4000 {
        let bx0 = Box3 { lo: bb.centre - vec3(bb.radius), hi: bb.centre + vec3(bb.radius) }
        let o = bx0.sample(37, kb)
        let d0 = bx0.sample(41, kb) - bb.centre
        kb += 1
        if length(d0) < 0.01 { continue }
        let d = normalize(d0)
        var t = 0.0
        var hit = false
        for _ in 0..256 {
            let f = book_w.distance(o + d * t)
            if abs(f) < 1.0e-5 { hit = true; break }
            t += abs(f) / max(book_w.lipschitz(abs(f)), 1.0)
            if t > 2.0 * bb.radius { break }
        }
        if !hit { continue }
        let p = o + d * t
        let g = std::derive::gradient(|q: vec3| book_w.distance(q), p)
        let gl = length(g)
        if !(gl > 1.0e-6) { continue }
        let lo = p - vec3(0.5 * 0.00483)
        let bx = Box3 { lo, hi: lo + vec3(0.00483) }
        let lv = book_w.live(bx)
        let af = book_w.slope_affine(bx, lv)
        if length(af.l) > 1.0e-6 { hsb += 1 }
        if engine::matter::certify::certify_sheet(one_bw, 0, lv, lo, 0.00483, p, g / gl, 0.00083) { cb += 1 }
        nb += 1
    }
    print(f"grimoire_world at 4.83mm: {nb} cells, has_slope={hsb}, certified_0.83mm={cb}")
    check_slope_sound(stick, "candlestick")
    check_slope_sound(desk, "table")
    check_slope_sound(book, "grimoire")
    check_slope_sound(seat, "chair")
    check_slope_sound(ledge, "shelf")
    // Measure candlestick at its actual SCENE 14 cell size (4.8 mm) and table at 3.7 mm.
    let one_s = [stick]
    let b = stick.bound()
    var n: u32 = 0
    var cert_s: u32 = 0
    var has_slope: u32 = 0
    var k: u32 = 0
    while n < 100 && k < 4000 {
        let bx0 = Box3 { lo: b.centre - vec3(b.radius), hi: b.centre + vec3(b.radius) }
        let o = bx0.sample(11, k)
        let d0 = bx0.sample(13, k) - b.centre
        k += 1
        if length(d0) < 0.01 {
            continue
        }
        let d = normalize(d0)
        var t = 0.0
        var hit = false
        for _ in 0..256 {
            let f = stick.distance(o + d * t)
            if abs(f) < 1.0e-5 {
                hit = true
                break
            }
            t += abs(f) / max(stick.lipschitz(abs(f)), 1.0)
            if t > 2.0 * b.radius {
                break
            }
        }
        if !hit {
            continue
        }
        let p = o + d * t
        let g = std::derive::gradient(|q: vec3| stick.distance(q), p)
        let gl = length(g)
        if !(gl > 1.0e-6) {
            continue
        }
        let h = 0.0048
        let lo = p - vec3(0.5 * h)
        let af = stick.slope_affine(Box3 { lo, hi: lo + vec3(h) }, ALL_LIVE)
        if length(af.l) > 1.0e-6 {
            has_slope += 1
        }
        if engine::matter::certify::certify_sheet(one_s, 0, ALL_LIVE, lo, h, p, g / gl, 0.4 * h) {
            cert_s += 1
        }
        n += 1
    }
    print(f"candlestick at 4.8mm: {n} cells, has_slope={has_slope}, certified_0.4h={cert_s}")
    // Also check table translated (as in SCENE 14) at 3.7mm and chair rotated+translated at 4.8mm!
    let desk_w = desk.translate(vec3(0.0, 0.0, 1.4))
    let seat_w = seat
        .rotate(std::quat::Quat::axis_angle(vec3(0.0, 1.0, 0.0), 3.1415927))
        .translate(vec3(-0.3, 0.0, 2.02))
    check_slope_sound(desk_w, "table_world")
    check_slope_sound(seat_w, "chair_world")
    for (lbl, h_c) in [("table_world", 0.0037)] {
        let bt = desk_w.bound()
        var nt: u32 = 0
        var ct: u32 = 0
        var hs: u32 = 0
        var kt: u32 = 0
        let one_dw = [desk_w]
        while nt < 100 && kt < 4000 {
            let bx0 = Box3 { lo: bt.centre - vec3(bt.radius), hi: bt.centre + vec3(bt.radius) }
            let o = bx0.sample(19, kt)
            let d0 = bx0.sample(23, kt) - bt.centre
            kt += 1
            if length(d0) < 0.01 {
                continue
            }
            let d = normalize(d0)
            var t = 0.0
            var hit = false
            for _ in 0..256 {
                let f = desk_w.distance(o + d * t)
                if abs(f) < 1.0e-5 {
                    hit = true
                    break
                }
                t += abs(f) / max(desk_w.lipschitz(abs(f)), 1.0)
                if t > 2.0 * bt.radius {
                    break
                }
            }
            if !hit {
                continue
            }
            let p = o + d * t
            let g = std::derive::gradient(|q: vec3| desk_w.distance(q), p)
            let gl = length(g)
            if !(gl > 1.0e-6) {
                continue
            }
            let lo = p - vec3(0.5 * h_c)
            let bx = Box3 { lo, hi: lo + vec3(h_c) }
            let lv = desk_w.live(bx)
            let af = desk_w.slope_affine(bx, lv)
            if length(af.l) > 1.0e-6 {
                hs += 1
            }
            if engine::matter::certify::certify_sheet(one_dw, 0, lv, lo, h_c, p, g / gl, 0.5 * h_c) {
                ct += 1
            }
            nt += 1
        }
        print(f"{lbl} at {h_c}m: {nt} cells, has_slope={hs}, certified_0.5h={ct}")
    }
    let bs = seat_w.bound()
    var ns: u32 = 0
    var cs: u32 = 0
    var hss: u32 = 0
    var ks: u32 = 0
    let one_sw = [seat_w]
    while ns < 100 && ks < 4000 {
        let bx0 = Box3 { lo: bs.centre - vec3(bs.radius), hi: bs.centre + vec3(bs.radius) }
        let o = bx0.sample(29, ks)
        let d0 = bx0.sample(31, ks) - bs.centre
        ks += 1
        if length(d0) < 0.01 {
            continue
        }
        let d = normalize(d0)
        var t = 0.0
        var hit = false
        for _ in 0..256 {
            let f = seat_w.distance(o + d * t)
            if abs(f) < 1.0e-5 {
                hit = true
                break
            }
            t += abs(f) / max(seat_w.lipschitz(abs(f)), 1.0)
            if t > 2.0 * bs.radius {
                break
            }
        }
        if !hit {
            continue
        }
        let p = o + d * t
        let g = std::derive::gradient(|q: vec3| seat_w.distance(q), p)
        let gl = length(g)
        if !(gl > 1.0e-6) {
            continue
        }
        let h_c = 0.0048
        let lo = p - vec3(0.5 * h_c)
        let bx = Box3 { lo, hi: lo + vec3(h_c) }
        let lv = seat_w.live(bx)
        let af = seat_w.slope_affine(bx, lv)
        if length(af.l) > 1.0e-6 {
            hss += 1
        }
        if engine::matter::certify::certify_sheet(one_sw, 0, lv, lo, h_c, p, g / gl, 0.44 * h_c) {
            cs += 1
        }
        ns += 1
    }
    print(f"chair_world at 4.8mm: {ns} cells, has_slope={hss}, certified_0.44h={cs}")
    certify_report(desk, "table", boxes: 100)
    certify_report(book, "grimoire", boxes: 100)
    certify_report(seat, "chair", boxes: 100)
    certify_report(ledge, "shelf", boxes: 100)
}
