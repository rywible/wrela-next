// The certificate scoreboard (`engine::matter::certify`): how much of each field's surface, in
// cells the size the engine meshes it at, the compiler's intervals prove lies within a quarter of
// a cell of its tangent planes, so a mesh there can't hide a hole. It reports; `tools/check` shows
// it. A field whose share drops, or stays low at small cells, has an operation the intervals
// can't bound tightly (as `atan2` was, all of [-pi, pi] over any box, before 2026-11-23).

use arena::{
    arena_brazier_stands, arena_courtyard, arena_flames, arena_pillars, glass_barrage, parry_arc,
    rival_orb,
}
use citadel::{citadel, marble_column}
use creature::creature
use engine::matter::certify::certify_report
use stack::{TALL_STACK, stack}
use stage::stage
use std::transform::translate

@test
fn stack_certificates() {
    certify_report(stack(TALL_STACK), "stack", boxes: 100)
}

@test
fn stage_certificates() {
    certify_report(stage(), "stage", boxes: 100)
}

@test
fn arena_courtyard_certificates() {
    certify_report(arena_courtyard(), "arena_courtyard", boxes: 100)
}

@test
fn arena_pillars_certificates() {
    certify_report(arena_pillars(), "arena_pillars", boxes: 100)
}

@test
fn arena_brazier_stands_certificates() {
    certify_report(arena_brazier_stands(), "arena_brazier_stands", boxes: 100)
}

@test
fn arena_flame_certificates() {
    certify_report(arena_flames(0.5)[0], "arena_flame", boxes: 60)
}

@test
fn parry_arc_certificates() {
    certify_report(parry_arc(0.5), "parry_arc", boxes: 60)
}

@test
fn rival_orb_certificates() {
    certify_report(rival_orb(0.5), "rival_orb", boxes: 60)
}

@test
fn glass_shard_certificates() {
    certify_report(glass_barrage(0.5)[0], "glass_shard", boxes: 100)
}

@test
fn citadel_certificates() {
    certify_report(citadel(), "citadel", boxes: 100)
}

@test
fn marble_column_certificates() {
    certify_report(marble_column(), "marble_column", boxes: 100)
}

@test
fn creature_certificates() {
    certify_report(creature([translate(vec3(0.0)); 64]), "creature", boxes: 25)
}
