// The certificate scoreboard (`engine::matter::certify`): how much of each field's surface, in
// cells the size the engine meshes it at, the compiler's intervals prove lies within a quarter of
// a cell of its tangent planes, so a mesh there can't hide a hole. It reports; `tools/check` shows
// it. A field whose share drops, or stays low at small cells, has an operation the intervals
// can't bound tightly (as `atan2` was, all of [-pi, pi] over any box, before 2026-11-23).

use arena::{
    arena_brazier_stands, arena_courtyard, arena_flames, arena_pillars, glass_barrage, parry_arc,
    rival_orb,
}
use citadel::{citadel, marble_column}
use creature::creature
use engine::matter::certify::{certify_report, certify_sheet}
use engine::matter::verify::verify_slope_soundness
use engine::mesh::extract::{FRAME, NEVER, part_classes}
use stack::{TALL_STACK, stack}
use stage::stage
use table::table
use grimoire::grimoire
use candlestick::candlestick
use chair::chair
use shelf::shelf
use std::derive::{Box3, gradient, reads_only_input}
use engine::matter::substance::Substance
use std::field::{Field, Surface}
use std::hash::StateHash
use std::io::print
use std::quat::Quat
use std::transform::translate

@test
fn stack_certificates() {
    certify_report(stack(TALL_STACK), "stack", boxes: 100)
}

@test
fn stage_certificates() {
    certify_report(stage(), "stage", boxes: 100)
}

@test
fn arena_courtyard_certificates() {
    certify_report(arena_courtyard(), "arena_courtyard", boxes: 100)
}

@test
fn arena_pillars_certificates() {
    certify_report(arena_pillars(), "arena_pillars", boxes: 100)
}

@test
fn arena_brazier_stands_certificates() {
    certify_report(arena_brazier_stands(), "arena_brazier_stands", boxes: 100)
}

@test
fn arena_flame_certificates() {
    certify_report(arena_flames(0.5)[0], "arena_flame", boxes: 60)
}

@test
fn parry_arc_certificates() {
    certify_report(parry_arc(0.5), "parry_arc", boxes: 60)
}

@test
fn rival_orb_certificates() {
    certify_report(rival_orb(0.5), "rival_orb", boxes: 60)
}

@test
fn glass_shard_certificates() {
    certify_report(glass_barrage(0.5)[0], "glass_shard", boxes: 100)
}

@test
fn citadel_certificates() {
    certify_report(citadel(), "citadel", boxes: 100)
}

@test
fn marble_column_certificates() {
    certify_report(marble_column(), "marble_column", boxes: 100)
}

@test
fn creature_certificates() {
    certify_report(creature([translate(vec3(0.0)); 64]), "creature", boxes: 25)
}

/// What the build proves of each field's facts (`engine::matter::verify::prove_field_facts`): its
/// steepness near its surface (`inf` where a box near it couldn't be bounded, so the engine's
/// solvers take the sound affine path), and whether its channels were proven in range (so
/// shading's guards are erased), and whether its distance reads its point alone. It reports; a
/// field whose `lip` turns `inf` lost a proof.
@test
fn field_facts_report() {
    let courtyard = arena_courtyard()
    let pillars = arena_pillars()
    let stands = arena_brazier_stands()
    let flame = arena_flames(0.5)[0]
    let arc = parry_arc(0.5)
    let orb = rival_orb(0.5)
    let shard = glass_barrage(0.5)[0]
    let walls = citadel()
    let column = marble_column()
    let body = creature([translate(vec3(0.0)); 64])
    // Whether its distance reads its point alone (`std::derive::reads_only_input`): nothing it
    // captures, no time and no state, so its mesh is the same for every moment.
    let rows = [
        (
            "arena_courtyard",
            courtyard.field_facts(),
            reads_only_input(|p: vec3| courtyard.distance(p)),
        ),
        ("arena_pillars", pillars.field_facts(), reads_only_input(|p: vec3| pillars.distance(p))),
        (
            "arena_brazier_stands",
            stands.field_facts(),
            reads_only_input(|p: vec3| stands.distance(p)),
        ),
        ("arena_flame", flame.field_facts(), reads_only_input(|p: vec3| flame.distance(p))),
        ("parry_arc", arc.field_facts(), reads_only_input(|p: vec3| arc.distance(p))),
        ("rival_orb", orb.field_facts(), reads_only_input(|p: vec3| orb.distance(p))),
        ("glass_shard", shard.field_facts(), reads_only_input(|p: vec3| shard.distance(p))),
        ("citadel", walls.field_facts(), reads_only_input(|p: vec3| walls.distance(p))),
        ("marble_column", column.field_facts(), reads_only_input(|p: vec3| column.distance(p))),
        ("creature", body.field_facts(), reads_only_input(|p: vec3| body.distance(p))),
    ]
    for i in 0..10 {
        let (name, f, only) = rows[i]
        print(
            f"facts: {name}: lip {f.lip}, channels proven {f.channels_proven}, reads only its point {only}",
        )
    }
}

/// Each kind's parts, named, and the change class of each (phase 2 of
/// docs/plans/engine-at-build.md: `engine::mesh::extract::part_classes`), from the kind at two
/// moments a frame apart, as the scenes build it: what the engine extracts again when the time
/// moves. It reports.
@test
fn part_classes_report() {
    let dt = 1.0 / 60.0
    report_kind("arena_courtyard", arena_courtyard(), arena_courtyard())
    report_kind("arena_pillars", arena_pillars(), arena_pillars())
    report_kind("arena_brazier_stands", arena_brazier_stands(), arena_brazier_stands())
    report_kind("arena_flame", arena_flames(0.5)[0], arena_flames(0.5 + dt)[0])
    report_kind("parry_arc", parry_arc(0.5), parry_arc(0.5 + dt))
    report_kind("rival_orb", rival_orb(0.5), rival_orb(0.5 + dt))
    report_kind("glass_shard", glass_barrage(0.5)[0], glass_barrage(0.5 + dt)[0])
    report_kind("citadel", citadel(), citadel())
    report_kind("marble_column", marble_column(), marble_column())
    report_kind("stack", stack(TALL_STACK), stack(TALL_STACK))
    report_kind("stage", stage(), stage())
    report_kind("table", table(), table())
    report_kind("grimoire", grimoire(), grimoire())
    // A body posed a frame apart: every bone moved.
    report_kind(
        "creature",
        creature([translate(vec3(0.0)); 64]),
        creature([translate(vec3(0.0, 0.01, 0.0)); 64]),
    )
}

fn report_kind<M: Field<Substance> + StateHash>(name: str, then: M, now: M) {
    let classes = part_classes(then, now)
    var line = f"parts: {name}: {classes.len()}:"
    for i in 0..classes.len() {
        let c = if classes[i] == NEVER { "never" } else if classes[i] == FRAME { "frame" } else {
            "state"
        }
        line = f"{line} {i}{now.part_name(i).name}={c}"
    }
    print(line)
}

/// At cells `h` m wide round 100 points of `s`'s surface (where rays from inside its bound meet
/// it, the point at the cell's middle), with the parts live in each: how many of their
/// enclosures have slopes (`Surface::slope_affine`: one with none is a ball, and certifies only
/// by its size), and how many `certify_sheet` certifies in a slab `width` m wide parallel to the
/// surface at the point. What a kind is worth as a scene places it, at the cells it is meshed at
/// there. The rays start at `all.sample(from, k)` toward `all.sample(toward, k)`. It reports.
fn placed_cells<S: Surface>(s: S, label: str, h: f32, width: f32, from: u32, toward: u32) {
    let b = s.bound()
    let one = [s]
    let all = Box3 { lo: b.centre - vec3(b.radius), hi: b.centre + vec3(b.radius) }
    var n: u32 = 0
    var certified: u32 = 0
    var sloped: u32 = 0
    var k: u32 = 0
    while n < 100 && k < 4000 {
        let o = all.sample(from, k)
        let d0 = all.sample(toward, k) - b.centre
        k += 1
        if length(d0) < 0.01 {
            continue
        }
        let d = normalize(d0)
        var t = 0.0
        var hit = false
        for _ in 0..256 {
            let f = s.distance(o + d * t)
            if abs(f) < 1.0e-5 {
                hit = true
                break
            }
            t += abs(f) / max(s.lipschitz(abs(f)), 1.0)
            if t > 2.0 * b.radius {
                break
            }
        }
        if !hit {
            continue
        }
        let p = o + d * t
        let g = gradient(|q: vec3| s.distance(q), p)
        let gl = length(g)
        if !(gl > 1.0e-6) {
            continue
        }
        let lo = p - vec3(0.5 * h)
        let bx = Box3 { lo, hi: lo + vec3(h) }
        let live = s.live(bx)
        if length(s.slope_affine(bx, live).l) > 1.0e-6 {
            sloped += 1
        }
        if certify_sheet(one, 0, live, lo, h, p, g / gl, width) {
            certified += 1
        }
        n += 1
    }
    print(f"cells({label}) at {h} m: {n} cells; sloped {sloped}, certified within {width} m {certified}")
}

/// The made things (the table, the grimoire, the candlestick, the chair, the shelf): each as a
/// room places it, at the cells it is meshed at there, and as made at the scoreboard's three
/// sizes (`certify_report`). It reports.
@test
fn made_things_certificates() {
    let stick = candlestick()
    let desk = table()
    let book = grimoire()
    let seat = chair()
    let ledge = shelf()
    let book_w = book
        .rotate(Quat::axis_angle(vec3(0.0, 1.0, 0.0), 0.35))
        .translate(vec3(0.16, 0.76 + 0.0352, 1.46))
    let desk_w = desk.translate(vec3(0.0, 0.0, 1.4))
    let seat_w = seat
        .rotate(Quat::axis_angle(vec3(0.0, 1.0, 0.0), 3.1415927))
        .translate(vec3(-0.3, 0.0, 2.02))
    placed_cells(book_w, "grimoire", h: 0.00483, width: 0.00083, from: 37, toward: 41)
    placed_cells(stick, "candlestick", h: 0.0048, width: 0.4 * 0.0048, from: 11, toward: 13)
    placed_cells(desk_w, "table", h: 0.0037, width: 0.5 * 0.0037, from: 19, toward: 23)
    placed_cells(seat_w, "chair", h: 0.0048, width: 0.44 * 0.0048, from: 29, toward: 31)
    certify_report(desk, "table", boxes: 100)
    certify_report(book, "grimoire", boxes: 100)
    certify_report(stick, "candlestick", boxes: 100)
    certify_report(seat, "chair", boxes: 100)
    certify_report(ledge, "shelf", boxes: 100)
}

// The made things' enclosures (`Surface::slope_box`), each as made and as a room places it
// (moved, and the grimoire and the chair turned): the one part of a surface's contract
// (`verify_surface_soundness`) a whole made thing is light enough for; its bound, its steepness
// and its ranges are held part by part by the kit's own contracts (lib/kit/shapes). The table's
// and the grimoire's are held by samples alone: the affine form of their carved friezes' and
// boards' distance makes a NaN, which a test's debug build stops at.

@test
fn table_enclosures_are_sound() {
    let desk = table()
    verify_slope_soundness(desk, "table", derive: false)
    verify_slope_soundness(desk.translate(vec3(0.0, 0.0, 1.4)), "table placed", derive: false)
}

@test
fn grimoire_enclosures_are_sound() {
    let book = grimoire()
    verify_slope_soundness(book, "grimoire", derive: false)
    let placed = book
        .rotate(Quat::axis_angle(vec3(0.0, 1.0, 0.0), 0.35))
        .translate(vec3(0.16, 0.76 + 0.0352, 1.46))
    verify_slope_soundness(placed, "grimoire placed", derive: false)
}

@test
fn candlestick_enclosures_are_sound() {
    let stick = candlestick()
    verify_slope_soundness(stick, "candlestick")
    verify_slope_soundness(stick.translate(vec3(-0.32, 0.76, 1.24)), "candlestick placed")
}

@test
fn chair_enclosures_are_sound() {
    let seat = chair()
    verify_slope_soundness(seat, "chair")
    let placed = seat
        .rotate(Quat::axis_angle(vec3(0.0, 1.0, 0.0), 3.1415927))
        .translate(vec3(-0.3, 0.0, 2.02))
    verify_slope_soundness(placed, "chair placed")
}

@test
fn shelf_enclosures_are_sound() {
    let ledge = shelf()
    verify_slope_soundness(ledge, "shelf")
    verify_slope_soundness(ledge.translate(vec3(0.4, 1.45, -3.0)), "shelf placed")
}
