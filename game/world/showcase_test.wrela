// The forge's showcase assets as a reader checks them: their parts named, their sizes what their
// briefs say, standing where they should, and their fields bounds a tracer can step by.

use grimoire::{HEIGHT, THICK, WIDTH, grimoire}
use std::field::{Surface, part_named}
use std::io::print
use table::{TOP_FROM, TOP_HALF, table}

@test
fn the_table_is_named_by_its_parts() {
    let t = table()
    assert(t.parts() == 4, f"the table has {t.parts()} parts")
    var names = String::new()
    for i in 0..t.parts() {
        names.push_str(f" {t.part_name(i).name}")
    }
    print(f"table parts:{names}")
    assert(
        part_named(t, "top") < 4 &&
            part_named(t, "legs") < 4 &&
            part_named(t, "frieze") < 4 &&
            part_named(t, "stretcher") < 4,
        "each part by its name",
    )
}

@test
fn the_table_stands_on_the_floor_at_its_height() {
    let t = table()
    // Its top's face 76 cm up at the middle, its feet on the floor, nothing below it.
    assert(abs(t.distance(vec3(0.0, 0.8, 0.0)) - 0.04) < 1.0e-4, "the top's face at 76 cm")
    assert(t.distance(vec3(0.0, TOP_FROM + 0.01, 0.0)) < 0.0, "inside the top")
    assert(t.distance(vec3(0.488, 0.005, 0.263)) < 0.0, "a foot on the floor")
    // Nothing below the floor: a grid of points under it, each farther than its depth.
    for i in 0..25 {
        for k in 0..17 {
            let p = vec3(-0.6 + 0.05 * f32(i), -0.001, -0.4 + 0.05 * f32(k))
            assert(t.distance(p) > 0.0, f"nothing below the floor at ({p.x}, {p.z})")
        }
    }
    // Its plan: the top's edge is its widest.
    assert(
        abs(t.distance(vec3(TOP_HALF.x + 0.01, TOP_FROM + 0.008, 0.0)) - 0.01) < 1.0e-3,
        "the top's edge",
    )
}

@test
fn the_grimoire_is_its_brief() {
    let g = grimoire()
    var names = String::new()
    for i in 0..g.parts() {
        names.push_str(f" {g.part_name(i).name}")
    }
    print(f"grimoire parts:{names}")
    assert(g.parts() == 5, f"the grimoire has {g.parts()} parts")
    // Its size: through its middle, front to back cover; across, spine to fore-edge.
    assert(g.distance(vec3(0.0)) < 0.0, "solid at its middle")
    assert(g.distance(vec3(0.0, 0.5 * THICK + 0.002, 0.03)) > 0.0, "above its front cover")
    assert(g.distance(vec3(0.5 * WIDTH - 0.01, 0.0, 0.0)) < 0.0, "pages toward the fore-edge")
    assert(g.distance(vec3(0.0, 0.0, 0.5 * HEIGHT + 0.004)) > 0.0, "past its head")
}

@test
fn the_gold_sets_smaller_pieces_stand_as_their_briefs_say() {
    let c = candlestick::candlestick()
    // Solid in its stem, hollow in its socket, open above it; 24 cm tall.
    assert(c.distance(vec3(0.0, 0.12, 0.0)) < 0.0, "a solid stem")
    assert(c.distance(vec3(0.0, 0.22, 0.0)) > 0.0, "a socket bored for the candle")
    assert(c.distance(vec3(0.0125, 0.22, 0.0)) < 0.0, "the socket's wall")
    assert(
        c.distance(vec3(0.0, 0.25, 0.0)) > 0.0 && c.distance(vec3(0.03, 0.005, 0.0)) < 0.0,
        "its foot and top",
    )
    let s = shelf::shelf()
    assert(s.parts() == 3, f"the shelf has {s.parts()} parts")
    assert(s.distance(vec3(0.0, -0.011, 0.11)) < 0.0, "the board")
    assert(
        s.distance(vec3(0.26, -0.1, 0.02)) < 0.0 && s.distance(vec3(-0.26, -0.1, 0.02)) < 0.0,
        "a bracket each side",
    )
    assert(s.distance(vec3(0.26, -0.19, 0.12)) > 0.0, "the ogee cut away below the board's front")
    assert(s.distance(vec3(0.0, -0.05, 0.01)) < 0.0, "the rail across the back")
}

@test
fn the_chair_stands_as_its_brief_says() {
    let c = chair::chair()
    assert(c.parts() == 4, f"the chair has {c.parts()} parts")
    assert(c.distance(vec3(0.0, 0.44, 0.0)) < 0.0, "the seat")
    assert(c.distance(vec3(0.0, 0.47, 0.0)) > 0.0, "above the seat")
    assert(
        c.distance(vec3(0.2, 0.02, 0.18)) < 0.0 && c.distance(vec3(-0.2, 0.02, 0.18)) < 0.0,
        "front feet",
    )
    assert(c.distance(vec3(0.2, 0.93, -0.18)) < 0.0, "a back post's top")
    assert(c.distance(vec3(0.0, 0.87, -0.18)) < 0.0, "the top rail")
    assert(c.distance(vec3(0.0, 0.2, 0.0)) > 0.0, "open under the seat")
}
