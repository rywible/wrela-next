// A stack of sea-worn stone: a pillar of bedded rock, leaning, its crown tilted and broken into
// crags, its footprint lobed by buttresses running up it, its beds standing out where a harder one
// lies, its foot notched by the sea, its faces rough. Carried from branch `backend`'s
// game/opening/stacks.wrela (`Pillar`, `PILLARS[2]`: from rywible/wrela 7ae6711e,
// scenes/opening/stacks.wrela:64-92), its numbers unchanged, written as an author must write a new
// kind of field today: a std::field `Surface` of its own, which has to state a bound and a
// steepness by hand (std's primitives can't build it: its noises ride on its own frame). Both are
// held by `verify_surface_soundness` (the compiler's intervals, halving, samples past them), which
// found its crown breaking its steepness, 3.5, 24 times over (`CORE` and `CRAG_CORE` mend it).

use engine::matter::substance::Substance
use kit::substances::matte::matte
use std::cmp::Eq
use std::field::{Bound, Surface, With, hash_u32, value_noise}
use std::hash::StateHash

/// Value noise in [0, 1] (std's, the same bits on the CPU and the GPU).
fn n01(p: vec3) -> f32 {
    0.5 + 0.5 * value_noise(p)
}

/// A number from `seed` and `k` in [0, 1), the same on every machine. (The old code's
/// `fract(sin(seed * 12.9898 + k * 78.233) * 43758.547)` drew a different stack on the Radeon from
/// the M4's: `sin` of a large number is rounded differently by each GPU, and the hash multiplies
/// the difference forty thousand times. Filed as a gap.)
fn pick(seed: f32, k: f32) -> f32 {
    f32(hash_u32(u32(seed * 1000.0) * 131 + u32(k)) >> 8) * (1.0 / 16777216.0)
}

/// Within how far of its axis a stack's lobes and crags fade to its middle's (m): what keeps its
/// crown as steep as `STEEPEST` says where every direction from the axis meets.
const CORE: f32 = 6.0

/// Within how far of its axis its crown's crags fade to its middle's (m): they rise a sixth of
/// its height as their direction turns, so over a narrower core its crown grew steeper than the
/// rest of it (5 where the rest stays under 3.5).
const CRAG_CORE: f32 = 12.0

/// How far under the sea a stack's foot reaches (m).
const FOOT: f32 = 6.0

/// The most its gradient reaches (its lobes, crown and crags, its rough faces), with a margin:
/// 2.43 the most of 48,000 points within a metre of its surface (its crown broke this 24 times
/// over before `CORE` and `CRAG_CORE`), held by `verify_surface_soundness` (intervals, halving,
/// samples where they can't prove it).
const STEEPEST: f32 = 3.5

/// A stack `girth` m round at its foot and `tall` m high, from its seed.
pub struct Pillar: Copy + GpuData + Eq + StateHash {
    pub girth: f32,
    pub tall: f32,
    pub seed: f32,
    pub spare: f32,
}

impl Surface for Pillar {
    fn distance(self, q: vec3) -> f32 {
        let r = self.girth
        let tall = self.tall
        let seed = self.seed
        let lean = vec2(pick(seed, 1.0) - 0.5, pick(seed, 2.0) - 0.5) * 0.22
        let v = q.xz - lean * max(q.y, 0.0)
        let rv = length(v)
        // The way out from the axis, shrunk within `CORE` of it: its lobes and crags are cut by
        // direction, and every direction meets at the axis, so taken pure they turned the crown
        // arbitrarily fast where the axis meets it (24 times as steep as stated, 4 m out).
        let dir = v / max(rv, CORE)
        let up = clamp(q.y / tall, 0.0, 1.0)
        let lobe = 1.0 +
            0.36 * (n01(vec3(dir.x * 1.3 + seed, dir.y * 1.3, q.y * 0.012)) - 0.5) +
            0.16 * (n01(vec3(dir.x * 2.9 + seed * 2.0, dir.y * 2.9, q.y * 0.035 + 7.0)) - 0.5)
        let hard = smoothstep(0.55, 0.8, n01(vec3(q.y * 0.22, seed * 1.7, 0.5)))
        let lip = 1.0 + 0.06 * hard
        let nq = (q.y - 2.2) / 2.2
        let notch = 1.0 - 0.26 * exp(-(nq * nq))
        let girth = r * lobe * lip * (1.0 - 0.35 * up) * notch
        let tilt = vec2(pick(seed, 3.0) - 0.5, pick(seed, 4.0) - 0.5) * 0.6
        let cdir = v / max(rv, CRAG_CORE)
        let crags = n01(vec3(cdir.x * 2.4 + seed * 3.0, cdir.y * 2.4, 3.0)) * tall * 0.16
        let crown = tall - dot(v, tilt) - 0.15 * rv - crags
        let rough = (n01(q * 0.16 + vec3(seed)) - 0.5) * 2.4 +
            (n01(q * 0.4 + vec3(seed * 2.0)) - 0.5) * 0.9
        let shell = max(rv - girth, max(q.y - crown, -q.y - FOOT))
        shell + rough * smoothstep(8.0, 0.0, abs(shell))
    }

    /// A sphere round its widest (its lobes and ledges at most 1.26 × 1.06 its girth, leant as
    /// far as any leans, 0.11 a metre up, roughened 1.2 m) and its foot.
    fn bound(self) -> Bound {
        let wide = self.girth * 1.34 + 0.11 * self.tall + 1.2
        let lo = -FOOT - 1.2
        let hi = self.tall * 1.05 + 1.2
        let half = vec2(wide, 0.5 * (hi - lo))
        Bound { centre: vec3(0.0, 0.5 * (hi + lo), 0.0), radius: length(half), slope: 0.5 }
    }

    fn lipschitz(self, near: f32) -> f32 {
        STEEPEST
    }
}

/// Its stone (a weathered grey basalt's albedo).
pub const STONE: vec3 = vec3(0.21, 0.2, 0.19)

/// The stack the old opening's tallest-but-one cook was of (`PILLARS[2]`): 44 m tall, 11 m round
/// at its foot.
pub const TALL_STACK = Pillar { girth: 11.0, tall: 44.0, seed: 12.7, spare: 0.0 }

pub type Stack = With<Pillar, Substance>

/// A stack in its stone.
pub fn stack(p: Pillar) -> Stack {
    p.with(matte(STONE))
}

@test
fn stack_field_contracts_are_sound() {
    engine::matter::verify::verify_field_soundness(stack(TALL_STACK), "tall_stack")
}
