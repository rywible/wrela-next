#!/usr/bin/env python3
"""One frame of a build as a PNG. Usage:

    tools/shot <build> --frame N [--size WxH] -o file.png [--host PATH] [--timeout S]
               [-- <more wrela-host flags>]

Runs frames 0 to N (0-based, as tools/bench and the host's timestamps number them) through
tools/gpu (the guard, the machine's one GPU lock, the timeout) at --size (default 3840x2160) and
writes frame N's picture, then prints the run's state hash. Frames 0 and 1 are repeatable from
run to run, hash and picture; later frames are not (readbacks land on different frames under
load), so a later frame compared against another run carries that noise (tools/same --noise):
frame 2 of the opening at 3840x2160 differed in 4 pixels (up to 12/255) between two runs whose
state hashes were equal.

  --host PATH   a wrela-host binary for tools/gpu to run (else tools/gpu's own, built if stale).
  --timeout S   tools/gpu's wall-clock limit (default 600).

Exit status: the host's (3: the guard refused the build, 124: the timeout killed it); 2 for a
usage error.
"""

import os
import subprocess
import sys

TOOLS = os.path.dirname(os.path.abspath(__file__))
GPU = os.path.join(TOOLS, "gpu")
OWN = {"--frames", "--size", "--png", "--every", "--png-from", "--until", "--no-gpu", "--replay",
       "--compare-ticks"}


def main(argv):
    extra = []
    if "--" in argv:
        i = argv.index("--")
        argv, extra = argv[:i], argv[i + 1:]
    build, frame, size, out, host, timeout = None, None, "3840x2160", None, None, "600"
    i = 0
    try:
        while i < len(argv):
            a = argv[i]
            if a in ("-h", "--help"):
                print(__doc__, file=sys.stderr)
                return 2
            if a in ("--frame", "--size", "-o", "--host", "--timeout"):
                v = argv[i + 1]
                i += 2
                if a == "--frame":
                    frame = int(v)
                    assert frame >= 0
                elif a == "--size":
                    w, h = v.split("x")
                    assert int(w) > 0 and int(h) > 0
                    size = v
                elif a == "-o":
                    out = v
                elif a == "--host":
                    host = v
                else:
                    assert float(v) > 0
                    timeout = v
            elif a.startswith("-"):
                raise ValueError(f"unknown option {a} (wrela-host's own go after `--`)")
            elif build is None:
                build = a
                i += 1
            else:
                raise ValueError(f"unexpected argument {a}")
        if build is None or frame is None or out is None:
            raise ValueError("needs a build, --frame N and -o file.png")
        if not out.endswith(".png"):
            raise ValueError(f"-o names a .png, not {out}")
        for flag in extra:
            if flag in OWN:
                raise ValueError(f"the shot sets {flag} itself" if flag in ("--frames", "--size",
                                 "--png") else f"{flag} doesn't draw this frame")
    except (ValueError, AssertionError, IndexError) as e:
        print(f"shot: {e or 'a bad value'}\n{__doc__.splitlines()[2]}", file=sys.stderr)
        return 2
    cmd = [GPU] + (["--host", host] if host else []) + ["--timeout", timeout, build,
           "--frames", str(frame + 1), "--size", size, "--png", out] + extra
    if os.path.exists(out):
        os.remove(out)  # so a failed run can't leave an older picture in its place
    status = subprocess.call(cmd)
    if status == 0 and not os.path.isfile(out):
        print(f"shot: the host wrote no {out}", file=sys.stderr)
        return 1
    if status == 0:
        print(f"shot: frame {frame} of {build} at {size}: {out}", file=sys.stderr)
    return status


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
