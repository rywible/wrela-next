#!/bin/bash
# This repository's own `wrela-host`, built first if stale (tools/built). It runs only through
# tools/gpu, which takes the GPU lock, guards the build and times the run; this script refuses
# to start it any other way.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ "${WRELA_GPU_HELD:-}" != "1" ]]; then
  echo "wrela-host: launch the host through tools/gpu (the GPU lock, the guard and the timeout)" >&2
  echo "  tools/gpu $*" >&2
  exit 2
fi
bin="$("$here/built" wrela-host)"
exec "$bin" "$@"
