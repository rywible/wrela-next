@compute(64)
fn sin_f32(k: K, out: mut Slots<vec4>, id: GlobalId) {
    let x = f32(id.x % 1024) * 0.0009765625 + 0.5
    var a0 = vec4(x + 0.0 * 0.01, x + 0.0 * 0.02, x + 0.0 * 0.03, x + 0.0 * 0.04)
    var a1 = vec4(x + 1.0 * 0.01, x + 1.0 * 0.02, x + 1.0 * 0.03, x + 1.0 * 0.04)
    var a2 = vec4(x + 2.0 * 0.01, x + 2.0 * 0.02, x + 2.0 * 0.03, x + 2.0 * 0.04)
    var a3 = vec4(x + 3.0 * 0.01, x + 3.0 * 0.02, x + 3.0 * 0.03, x + 3.0 * 0.04)
    var a4 = vec4(x + 4.0 * 0.01, x + 4.0 * 0.02, x + 4.0 * 0.03, x + 4.0 * 0.04)
    var a5 = vec4(x + 5.0 * 0.01, x + 5.0 * 0.02, x + 5.0 * 0.03, x + 5.0 * 0.04)
    var a6 = vec4(x + 6.0 * 0.01, x + 6.0 * 0.02, x + 6.0 * 0.03, x + 6.0 * 0.04)
    var a7 = vec4(x + 7.0 * 0.01, x + 7.0 * 0.02, x + 7.0 * 0.03, x + 7.0 * 0.04)
    for _i in 0..32 {
        a0 = sin(a0) + vec4(k.b)
        a1 = sin(a1) + vec4(k.b)
        a2 = sin(a2) + vec4(k.b)
        a3 = sin(a3) + vec4(k.b)
        a4 = sin(a4) + vec4(k.b)
        a5 = sin(a5) + vec4(k.b)
        a6 = sin(a6) + vec4(k.b)
        a7 = sin(a7) + vec4(k.b)
    }
    out[id] = a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7
}

@compute(64)
fn sin_f16(k: K, out: mut Slots<vec4>, id: GlobalId) {
    let x = f32(id.x % 1024) * 0.0009765625 + 0.5
    let k = KH { a: f16(k.a), b: f16(k.b), c: f16(k.c), d: f16(k.d) }
    var a0 = vec4h(f16(x + 0.0 * 0.01), f16(x + 0.0 * 0.02), f16(x + 0.0 * 0.03), f16(x + 0.0 * 0.04))
    var a1 = vec4h(f16(x + 1.0 * 0.01), f16(x + 1.0 * 0.02), f16(x + 1.0 * 0.03), f16(x + 1.0 * 0.04))
    var a2 = vec4h(f16(x + 2.0 * 0.01), f16(x + 2.0 * 0.02), f16(x + 2.0 * 0.03), f16(x + 2.0 * 0.04))
    var a3 = vec4h(f16(x + 3.0 * 0.01), f16(x + 3.0 * 0.02), f16(x + 3.0 * 0.03), f16(x + 3.0 * 0.04))
    var a4 = vec4h(f16(x + 4.0 * 0.01), f16(x + 4.0 * 0.02), f16(x + 4.0 * 0.03), f16(x + 4.0 * 0.04))
    var a5 = vec4h(f16(x + 5.0 * 0.01), f16(x + 5.0 * 0.02), f16(x + 5.0 * 0.03), f16(x + 5.0 * 0.04))
    var a6 = vec4h(f16(x + 6.0 * 0.01), f16(x + 6.0 * 0.02), f16(x + 6.0 * 0.03), f16(x + 6.0 * 0.04))
    var a7 = vec4h(f16(x + 7.0 * 0.01), f16(x + 7.0 * 0.02), f16(x + 7.0 * 0.03), f16(x + 7.0 * 0.04))
    for _i in 0..32 {
        a0 = sin(a0) + vec4h(k.b)
        a1 = sin(a1) + vec4h(k.b)
        a2 = sin(a2) + vec4h(k.b)
        a3 = sin(a3) + vec4h(k.b)
        a4 = sin(a4) + vec4h(k.b)
        a5 = sin(a5) + vec4h(k.b)
        a6 = sin(a6) + vec4h(k.b)
        a7 = sin(a7) + vec4h(k.b)
    }
    let t = a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7
    out[id] = vec4(f32(t.x), f32(t.y), f32(t.z), f32(t.w))
}

@compute(64)
fn fma_uniform(k: K, out: mut Slots<vec4>, id: GlobalId) {
    // The same chains as fma_f32, from the uniform block alone: the same for every invocation.
    let x = k.c
    var a0 = vec4(x + 0.0 * 0.01, x + 0.0 * 0.02, x + 0.0 * 0.03, x + 0.0 * 0.04)
    var a1 = vec4(x + 1.0 * 0.01, x + 1.0 * 0.02, x + 1.0 * 0.03, x + 1.0 * 0.04)
    var a2 = vec4(x + 2.0 * 0.01, x + 2.0 * 0.02, x + 2.0 * 0.03, x + 2.0 * 0.04)
    var a3 = vec4(x + 3.0 * 0.01, x + 3.0 * 0.02, x + 3.0 * 0.03, x + 3.0 * 0.04)
    var a4 = vec4(x + 4.0 * 0.01, x + 4.0 * 0.02, x + 4.0 * 0.03, x + 4.0 * 0.04)
    var a5 = vec4(x + 5.0 * 0.01, x + 5.0 * 0.02, x + 5.0 * 0.03, x + 5.0 * 0.04)
    var a6 = vec4(x + 6.0 * 0.01, x + 6.0 * 0.02, x + 6.0 * 0.03, x + 6.0 * 0.04)
    var a7 = vec4(x + 7.0 * 0.01, x + 7.0 * 0.02, x + 7.0 * 0.03, x + 7.0 * 0.04)
    for _i in 0..32 {
        a0 = a0 * vec4(k.a) + vec4(k.b)
        a1 = a1 * vec4(k.a) + vec4(k.b)
        a2 = a2 * vec4(k.a) + vec4(k.b)
        a3 = a3 * vec4(k.a) + vec4(k.b)
        a4 = a4 * vec4(k.a) + vec4(k.b)
        a5 = a5 * vec4(k.a) + vec4(k.b)
        a6 = a6 * vec4(k.a) + vec4(k.b)
        a7 = a7 * vec4(k.a) + vec4(k.b)
    }
    out[id] = a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7
}


struct KH: Copy {
    a: f16,
    b: f16,
    c: f16,
    d: f16,
}

pub struct Game {
    out: GpuBuffer<vec4>,
}

pub fn init() -> Game {
    Game { out: buffer(1048576) }
}

pub fn frame(game: mut Game, time: f32, width: u32, height: u32) {
    let k = K { a: 0.999, b: 0.01, c: 0.5, d: 0.25 }

    dispatch(fma_uniform.bind(k: k, out: mut game.out), groups: 16384)
    dispatch(fma_f32.bind(k: k, out: mut game.out), groups: 16384)
    dispatch(fma_f16.bind(k: k, out: mut game.out), groups: 16384)
    dispatch(div_f32.bind(k: k, out: mut game.out), groups: 16384)
    dispatch(div_f16.bind(k: k, out: mut game.out), groups: 16384)
    dispatch(sqrt_f32.bind(k: k, out: mut game.out), groups: 16384)
    dispatch(sqrt_f16.bind(k: k, out: mut game.out), groups: 16384)
    dispatch(exp2_f32.bind(k: k, out: mut game.out), groups: 16384)
    dispatch(exp2_f16.bind(k: k, out: mut game.out), groups: 16384)
    dispatch(log2_f32.bind(k: k, out: mut game.out), groups: 16384)
    dispatch(log2_f16.bind(k: k, out: mut game.out), groups: 16384)
    dispatch(sin_f32.bind(k: k, out: mut game.out), groups: 16384)
    dispatch(sin_f16.bind(k: k, out: mut game.out), groups: 16384)
}
