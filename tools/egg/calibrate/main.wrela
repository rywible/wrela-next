// Per-machine costs of GPU operations, f32 against f16 (the e-graph spike's calibration,
// wrela-notes/next/backend.md). Each kernel runs 8 independent vec4 chains of 32 steps of one
// operation, a million invocations; tools/egg/passtime.py reads each dispatch's time.
use std::gpu::{GlobalId, GpuBuffer, Slots, buffer, dispatch}

struct K: Copy + GpuData {
    a: f32,
    b: f32,
    c: f32,
    d: f32,
}

@compute(64)
fn fma_f32(k: K, out: mut Slots<vec4>, id: GlobalId) {
    let x = f32(id.x % 1024) * 0.0009765625 + 0.5
    var a0 = vec4(x + 0.0 * 0.01, x + 0.0 * 0.02, x + 0.0 * 0.03, x + 0.0 * 0.04)
    var a1 = vec4(x + 1.0 * 0.01, x + 1.0 * 0.02, x + 1.0 * 0.03, x + 1.0 * 0.04)
    var a2 = vec4(x + 2.0 * 0.01, x + 2.0 * 0.02, x + 2.0 * 0.03, x + 2.0 * 0.04)
    var a3 = vec4(x + 3.0 * 0.01, x + 3.0 * 0.02, x + 3.0 * 0.03, x + 3.0 * 0.04)
    var a4 = vec4(x + 4.0 * 0.01, x + 4.0 * 0.02, x + 4.0 * 0.03, x + 4.0 * 0.04)
    var a5 = vec4(x + 5.0 * 0.01, x + 5.0 * 0.02, x + 5.0 * 0.03, x + 5.0 * 0.04)
    var a6 = vec4(x + 6.0 * 0.01, x + 6.0 * 0.02, x + 6.0 * 0.03, x + 6.0 * 0.04)
    var a7 = vec4(x + 7.0 * 0.01, x + 7.0 * 0.02, x + 7.0 * 0.03, x + 7.0 * 0.04)
    for _i in 0..32 {
        a0 = a0 * vec4(k.a) + vec4(k.b)
        a1 = a1 * vec4(k.a) + vec4(k.b)
        a2 = a2 * vec4(k.a) + vec4(k.b)
        a3 = a3 * vec4(k.a) + vec4(k.b)
        a4 = a4 * vec4(k.a) + vec4(k.b)
        a5 = a5 * vec4(k.a) + vec4(k.b)
        a6 = a6 * vec4(k.a) + vec4(k.b)
        a7 = a7 * vec4(k.a) + vec4(k.b)
    }
    out[id] = a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7
}

@compute(64)
fn fma_f16(k: K, out: mut Slots<vec4>, id: GlobalId) {
    let x = f32(id.x % 1024) * 0.0009765625 + 0.5
    let k = KH { a: f16(k.a), b: f16(k.b), c: f16(k.c), d: f16(k.d) }
    var a0 = vec4h(f16(x + 0.0 * 0.01), f16(x + 0.0 * 0.02), f16(x + 0.0 * 0.03), f16(x + 0.0 * 0.04))
    var a1 = vec4h(f16(x + 1.0 * 0.01), f16(x + 1.0 * 0.02), f16(x + 1.0 * 0.03), f16(x + 1.0 * 0.04))
    var a2 = vec4h(f16(x + 2.0 * 0.01), f16(x + 2.0 * 0.02), f16(x + 2.0 * 0.03), f16(x + 2.0 * 0.04))
    var a3 = vec4h(f16(x + 3.0 * 0.01), f16(x + 3.0 * 0.02), f16(x + 3.0 * 0.03), f16(x + 3.0 * 0.04))
    var a4 = vec4h(f16(x + 4.0 * 0.01), f16(x + 4.0 * 0.02), f16(x + 4.0 * 0.03), f16(x + 4.0 * 0.04))
    var a5 = vec4h(f16(x + 5.0 * 0.01), f16(x + 5.0 * 0.02), f16(x + 5.0 * 0.03), f16(x + 5.0 * 0.04))
    var a6 = vec4h(f16(x + 6.0 * 0.01), f16(x + 6.0 * 0.02), f16(x + 6.0 * 0.03), f16(x + 6.0 * 0.04))
    var a7 = vec4h(f16(x + 7.0 * 0.01), f16(x + 7.0 * 0.02), f16(x + 7.0 * 0.03), f16(x + 7.0 * 0.04))
    for _i in 0..32 {
        a0 = a0 * vec4h(k.a) + vec4h(k.b)
        a1 = a1 * vec4h(k.a) + vec4h(k.b)
        a2 = a2 * vec4h(k.a) + vec4h(k.b)
        a3 = a3 * vec4h(k.a) + vec4h(k.b)
        a4 = a4 * vec4h(k.a) + vec4h(k.b)
        a5 = a5 * vec4h(k.a) + vec4h(k.b)
        a6 = a6 * vec4h(k.a) + vec4h(k.b)
        a7 = a7 * vec4h(k.a) + vec4h(k.b)
    }
    let t = a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7
    out[id] = vec4(f32(t.x), f32(t.y), f32(t.z), f32(t.w))
}

@compute(64)
fn div_f32(k: K, out: mut Slots<vec4>, id: GlobalId) {
    let x = f32(id.x % 1024) * 0.0009765625 + 0.5
    var a0 = vec4(x + 0.0 * 0.01, x + 0.0 * 0.02, x + 0.0 * 0.03, x + 0.0 * 0.04)
    var a1 = vec4(x + 1.0 * 0.01, x + 1.0 * 0.02, x + 1.0 * 0.03, x + 1.0 * 0.04)
    var a2 = vec4(x + 2.0 * 0.01, x + 2.0 * 0.02, x + 2.0 * 0.03, x + 2.0 * 0.04)
    var a3 = vec4(x + 3.0 * 0.01, x + 3.0 * 0.02, x + 3.0 * 0.03, x + 3.0 * 0.04)
    var a4 = vec4(x + 4.0 * 0.01, x + 4.0 * 0.02, x + 4.0 * 0.03, x + 4.0 * 0.04)
    var a5 = vec4(x + 5.0 * 0.01, x + 5.0 * 0.02, x + 5.0 * 0.03, x + 5.0 * 0.04)
    var a6 = vec4(x + 6.0 * 0.01, x + 6.0 * 0.02, x + 6.0 * 0.03, x + 6.0 * 0.04)
    var a7 = vec4(x + 7.0 * 0.01, x + 7.0 * 0.02, x + 7.0 * 0.03, x + 7.0 * 0.04)
    for _i in 0..32 {
        a0 = vec4(k.b) / (a0 + vec4(k.a))
        a1 = vec4(k.b) / (a1 + vec4(k.a))
        a2 = vec4(k.b) / (a2 + vec4(k.a))
        a3 = vec4(k.b) / (a3 + vec4(k.a))
        a4 = vec4(k.b) / (a4 + vec4(k.a))
        a5 = vec4(k.b) / (a5 + vec4(k.a))
        a6 = vec4(k.b) / (a6 + vec4(k.a))
        a7 = vec4(k.b) / (a7 + vec4(k.a))
    }
    out[id] = a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7
}

@compute(64)
fn div_f16(k: K, out: mut Slots<vec4>, id: GlobalId) {
    let x = f32(id.x % 1024) * 0.0009765625 + 0.5
    let k = KH { a: f16(k.a), b: f16(k.b), c: f16(k.c), d: f16(k.d) }
    var a0 = vec4h(f16(x + 0.0 * 0.01), f16(x + 0.0 * 0.02), f16(x + 0.0 * 0.03), f16(x + 0.0 * 0.04))
    var a1 = vec4h(f16(x + 1.0 * 0.01), f16(x + 1.0 * 0.02), f16(x + 1.0 * 0.03), f16(x + 1.0 * 0.04))
    var a2 = vec4h(f16(x + 2.0 * 0.01), f16(x + 2.0 * 0.02), f16(x + 2.0 * 0.03), f16(x + 2.0 * 0.04))
    var a3 = vec4h(f16(x + 3.0 * 0.01), f16(x + 3.0 * 0.02), f16(x + 3.0 * 0.03), f16(x + 3.0 * 0.04))
    var a4 = vec4h(f16(x + 4.0 * 0.01), f16(x + 4.0 * 0.02), f16(x + 4.0 * 0.03), f16(x + 4.0 * 0.04))
    var a5 = vec4h(f16(x + 5.0 * 0.01), f16(x + 5.0 * 0.02), f16(x + 5.0 * 0.03), f16(x + 5.0 * 0.04))
    var a6 = vec4h(f16(x + 6.0 * 0.01), f16(x + 6.0 * 0.02), f16(x + 6.0 * 0.03), f16(x + 6.0 * 0.04))
    var a7 = vec4h(f16(x + 7.0 * 0.01), f16(x + 7.0 * 0.02), f16(x + 7.0 * 0.03), f16(x + 7.0 * 0.04))
    for _i in 0..32 {
        a0 = vec4h(k.b) / (a0 + vec4h(k.a))
        a1 = vec4h(k.b) / (a1 + vec4h(k.a))
        a2 = vec4h(k.b) / (a2 + vec4h(k.a))
        a3 = vec4h(k.b) / (a3 + vec4h(k.a))
        a4 = vec4h(k.b) / (a4 + vec4h(k.a))
        a5 = vec4h(k.b) / (a5 + vec4h(k.a))
        a6 = vec4h(k.b) / (a6 + vec4h(k.a))
        a7 = vec4h(k.b) / (a7 + vec4h(k.a))
    }
    let t = a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7
    out[id] = vec4(f32(t.x), f32(t.y), f32(t.z), f32(t.w))
}

@compute(64)
fn sqrt_f32(k: K, out: mut Slots<vec4>, id: GlobalId) {
    let x = f32(id.x % 1024) * 0.0009765625 + 0.5
    var a0 = vec4(x + 0.0 * 0.01, x + 0.0 * 0.02, x + 0.0 * 0.03, x + 0.0 * 0.04)
    var a1 = vec4(x + 1.0 * 0.01, x + 1.0 * 0.02, x + 1.0 * 0.03, x + 1.0 * 0.04)
    var a2 = vec4(x + 2.0 * 0.01, x + 2.0 * 0.02, x + 2.0 * 0.03, x + 2.0 * 0.04)
    var a3 = vec4(x + 3.0 * 0.01, x + 3.0 * 0.02, x + 3.0 * 0.03, x + 3.0 * 0.04)
    var a4 = vec4(x + 4.0 * 0.01, x + 4.0 * 0.02, x + 4.0 * 0.03, x + 4.0 * 0.04)
    var a5 = vec4(x + 5.0 * 0.01, x + 5.0 * 0.02, x + 5.0 * 0.03, x + 5.0 * 0.04)
    var a6 = vec4(x + 6.0 * 0.01, x + 6.0 * 0.02, x + 6.0 * 0.03, x + 6.0 * 0.04)
    var a7 = vec4(x + 7.0 * 0.01, x + 7.0 * 0.02, x + 7.0 * 0.03, x + 7.0 * 0.04)
    for _i in 0..32 {
        a0 = sqrt(a0) + vec4(k.b)
        a1 = sqrt(a1) + vec4(k.b)
        a2 = sqrt(a2) + vec4(k.b)
        a3 = sqrt(a3) + vec4(k.b)
        a4 = sqrt(a4) + vec4(k.b)
        a5 = sqrt(a5) + vec4(k.b)
        a6 = sqrt(a6) + vec4(k.b)
        a7 = sqrt(a7) + vec4(k.b)
    }
    out[id] = a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7
}

