@compute(64)
fn log2_f32(k: K, out: mut Slots<vec4>, id: GlobalId) {
    let x = f32(id.x % 1024) * 0.0009765625 + 0.5
    var a0 = vec4(x + 0.0 * 0.01, x + 0.0 * 0.02, x + 0.0 * 0.03, x + 0.0 * 0.04)
    var a1 = vec4(x + 1.0 * 0.01, x + 1.0 * 0.02, x + 1.0 * 0.03, x + 1.0 * 0.04)
    var a2 = vec4(x + 2.0 * 0.01, x + 2.0 * 0.02, x + 2.0 * 0.03, x + 2.0 * 0.04)
    var a3 = vec4(x + 3.0 * 0.01, x + 3.0 * 0.02, x + 3.0 * 0.03, x + 3.0 * 0.04)
