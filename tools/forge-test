#!/usr/bin/env python3
"""The forge's own checks (tools/forge), with no GPU. Usage:

    tools/forge-test [--quick]

  1. prompts: the lint passes a prompt that says what a thing is and refuses each kind of
     prompt that points at another work, a maker or a style;
  2. meshes: a cube written as OBJ, PLY and binary glTF reads back the same, is put in the asset's
     frame, and its samples lie on its faces with its normals, its volume samples on their own
     sides with their distances, and the even-odd fill finds its inside;
  3. the look: a picture against itself scores no difference; against itself darkened, almost
     none once exposure is matched; against itself blurred and shifted, less alike;
  4. the judge against brute force: a known program (a turned leg) against its own samples, the
     fast path's numbers within the brute force's (which finds the surface by sign changes and
     compares every pair);
  5. the fitter: the leg's 42 numbers moved off by up to 4 mm are fitted back to within the
     judge's tolerance;
  6. the judge's ranking: the leg written badly (straight pieces, twice the numbers, unnamed, a
     number nothing reads) against the leg written well, both against the good one's samples:
     worse on every count it has without a GPU (shape both ways, normals, sides, outlines, its
     literals, its named parts, its literals never moved);
  7. the record: the leg's chain replayed from its record, every step the same.

--quick skips 4 to 7 (they build and run wrela tools; about a minute in all).

Exit status 0 when every check holds.
"""

import importlib.util
import json
import os
import shutil
import struct
import subprocess
import sys
import tempfile
from importlib.machinery import SourceFileLoader

TOOLS = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(TOOLS)
FORGE = os.path.join(TOOLS, "forge")

loader = SourceFileLoader("forge", FORGE)
spec = importlib.util.spec_from_loader("forge", loader)
forge = importlib.util.module_from_spec(spec)
loader.exec_module(forge)

import numpy as np  # noqa: E402

FAILED = []


def check(ok, what):
    print(("  ok    " if ok else "  FAIL  ") + what)
    if not ok:
        FAILED.append(what)


# ---- 1. prompts ----------------------------------------------------------------------------------


def test_prompts():
    print("prompts")
    good = ("An ornate carved oak library table, its frieze carved with acanthus scrolls. Product "
            "photograph of the object alone, on a plain mid-grey background.")
    check(forge.lint(good) == [], "a prompt that says what the thing is passes")
    for bad in ["An oak table in the style of a famous designer",
                "A spellbook inspired by Harry Potter",
                "A grimoire like in Elden Ring",
                "A chair, trending on ArtStation",
                "A table as seen in the film"]:
        check(forge.lint(bad) != [], f"refused: {bad!r}")


# ---- 2. meshes -----------------------------------------------------------------------------------


def cube():
    v = np.array([[x, y, z] for x in (0.0, 1.0) for y in (0.0, 1.0) for z in (0.0, 1.0)])
    # Outward-wound quads, as triangles.
    quads = [(0, 1, 3, 2), (4, 6, 7, 5), (0, 4, 5, 1), (2, 3, 7, 6), (0, 2, 6, 4), (1, 5, 7, 3)]
    f = []
    for a, b, c, d in quads:
        f += [(a, b, c), (a, c, d)]
    return v, np.array(f)


def write_obj(path, v, f):
    with open(path, "w") as out:
        for p in v:
            out.write(f"v {p[0]} {p[1]} {p[2]}\n")
        for t in f:
            out.write(f"f {t[0] + 1} {t[1] + 1} {t[2] + 1}\n")


def write_ply(path, v, f):
    with open(path, "w") as out:
        out.write(f"ply\nformat ascii 1.0\nelement vertex {len(v)}\nproperty float x\nproperty float y\n"
                  f"property float z\nelement face {len(f)}\nproperty list uchar int vertex_indices\nend_header\n")
        for p in v:
            out.write(f"{p[0]} {p[1]} {p[2]}\n")
        for t in f:
            out.write(f"3 {t[0]} {t[1]} {t[2]}\n")


def write_glb(path, v, f):
    pos = v.astype("<f4").tobytes()
    idx = f.astype("<u4").tobytes()
    binc = pos + idx
    js = {"asset": {"version": "2.0"}, "scene": 0, "scenes": [{"nodes": [0]}],
          "nodes": [{"mesh": 0, "translation": [0.0, 0.0, 0.0]}],
          "meshes": [{"primitives": [{"attributes": {"POSITION": 0}, "indices": 1}]}],
          "buffers": [{"byteLength": len(binc)}],
          "bufferViews": [{"buffer": 0, "byteOffset": 0, "byteLength": len(pos)},
                          {"buffer": 0, "byteOffset": len(pos), "byteLength": len(idx)}],
          "accessors": [{"bufferView": 0, "componentType": 5126, "count": len(v), "type": "VEC3"},
                        {"bufferView": 1, "componentType": 5125, "count": f.size, "type": "SCALAR"}]}
    j = json.dumps(js).encode()
    j += b" " * (-len(j) % 4)
    binc += b"\0" * (-len(binc) % 4)
    total = 12 + 8 + len(j) + 8 + len(binc)
    with open(path, "wb") as out:
        out.write(b"glTF" + struct.pack("<II", 2, total))
        out.write(struct.pack("<II", len(j), 0x4E4F534A) + j)
        out.write(struct.pack("<II", len(binc), 0x004E4942) + binc)


def test_meshes():
    print("meshes")
    v, f = cube()
    with tempfile.TemporaryDirectory() as d:
        loaded = []
        for ext, w in ((".obj", write_obj), (".ply", write_ply), (".glb", write_glb)):
            p = os.path.join(d, "cube" + ext)
            w(p, v, f)
            lv, lf, _, _, _ = forge.load_mesh(p)
            loaded.append((lv, lf))
        same = all(np.allclose(lv, loaded[0][0]) and (lf == loaded[0][1]).all() for lv, lf in loaded)
        check(same, "OBJ, PLY and binary glTF read back the same cube")
        av, scale, offset = forge.align(loaded[0][0], [0.2, 0.2, 0.2], "y")
        check(np.allclose(av.min(0), [-0.1, 0.0, -0.1]) and np.allclose(av.max(0), [0.1, 0.2, 0.1]),
              "aligned: feet at y = 0, middle over the origin, the brief's height")
        pts, nrm, col, vol, spacing, area = forge.mesh_samples(av, loaded[0][1], None, None, None, 6000, 3000, 7)
        on_face = np.isclose(np.abs(pts - [0, 0.1, 0]).max(1), 0.1, atol=1e-6).all()
        check(on_face, "surface samples lie on the cube's faces")
        # Each normal is the face's: along the axis the point is out at, pointing out.
        q = pts - [0, 0.1, 0]
        axis = np.abs(q).argmax(1)
        expect = np.zeros_like(nrm)
        expect[np.arange(len(q)), axis] = np.sign(q[np.arange(len(q)), axis])
        check(np.allclose(nrm, expect, atol=1e-6), "surface normals are the faces' outward normals")
        check(abs(area - 0.24) < 1e-9 and abs(spacing - (0.24 / 6000) ** 0.5) < 1e-12,
              f"area {area:.4f} m² and spacing {spacing * 1000:.2f} mm as the faces say")
        box = np.abs(vol[:, :3] - [0, 0.1, 0]).max(1)
        inside_true = box < 0.1
        sides_ok = ((vol[:, 3] < 0) == inside_true).mean()
        check(sides_ok > 0.999, f"volume samples on their own sides ({sides_ok:.4f})")
        dist_true = np.abs(box - 0.1)
        # Inside, and outside a face (not past its edges, where the nearest sample's plane is
        # another face's), the distance is the face's, to within what samples a spacing apart say.
        face_out = (~inside_true) & (np.sort(np.abs(vol[:, :3] - [0, 0.1, 0]), 1)[:, 1] < 0.1 - spacing)
        err = np.abs(np.abs(vol[:, 3]) - dist_true)[face_out | inside_true]
        check(np.median(err) < 1e-6 and err.max() < spacing,
              f"volume samples' distances are the cube's (median {np.median(err) * 1000:.4f} mm off, at most {err.max() * 1000:.2f} mm, spacing {spacing * 1000:.2f})")
        solid, lo, cell = forge.solid_grid(av, loaded[0][1], np.array([-0.15, -0.05, -0.15]), np.array([0.15, 0.25, 0.15]), 60)
        filled = solid.sum() * cell ** 3
        check(abs(filled - 0.008) / 0.008 < 0.06, f"the even-odd fill holds the cube's volume ({filled * 1e6:.0f} of 8000 cm³)")
        out = os.path.join(d, "s.bin")
        forge.write_samples(out, pts, nrm, vol, None, spacing)
        a, b, c, sp = forge.read_samples(out)
        check(np.allclose(a[:, :3], pts, atol=1e-7) and np.allclose(b[:, 3], vol[:, 3], atol=1e-7) and sp == np.float32(spacing),
              "samples write and read back")


# ---- 3. the look ---------------------------------------------------------------------------------


def test_look():
    print("the look")
    rng = np.random.default_rng(1)
    img = np.full((96, 96, 3), 0.5)
    yy, xx = np.mgrid[0:96, 0:96]
    blob = ((xx - 48) ** 2 + (yy - 50) ** 2) < 30 ** 2
    tex = 0.25 + 0.5 * rng.random((96, 96, 1)) * np.array([0.9, 0.6, 0.4])
    img[blob] = tex[blob]
    same = forge.look_scores(img, img)
    check(same["delta_e"] < 1e-6 and same["ssim"] > 0.999, "a picture against itself: no difference")
    lin = forge.srgb_to_linear(img)
    dark = lin * 0.45
    dark = np.where(dark <= 0.0031308, dark * 12.92, 1.055 * dark ** (1 / 2.4) - 0.055)
    d = forge.look_scores(dark, img)
    check(d["delta_e"] < 1.0 and d["ssim"] > 0.99, f"darkened, exposure matched: ΔE {d['delta_e']:.2f}")
    shifted = np.roll(img, 3, axis=1)
    blurred = (shifted + np.roll(shifted, 1, 0) + np.roll(shifted, -1, 0) + np.roll(shifted, 1, 1) + np.roll(shifted, -1, 1)) / 5
    b = forge.look_scores(blurred, img)
    check(b["delta_e"] > same["delta_e"] + 2 and b["ssim"] < same["ssim"] - 0.05,
          f"blurred and shifted: less alike (ΔE {b['delta_e']:.2f}, SSIM {b['ssim']:.3f})")


# ---- 4 to 7: the chain ---------------------------------------------------------------------------


def forge_run(*args, check_status=True):
    p = subprocess.run([FORGE] + list(args), capture_output=True, text=True)
    if check_status and p.returncode != 0:
        print(p.stdout[-3000:] + p.stderr[-3000:])
        raise SystemExit(f"forge-test: `tools/forge {' '.join(args)}` failed")
    return p


def new_asset(name, source, field, stages):
    shutil.rmtree(os.path.join(ROOT, ".forge", name), ignore_errors=True)
    shutil.rmtree(os.path.join(ROOT, ".forge", name + "__replay"), ignore_errors=True)
    forge_run("new", name, "--source", source, "--field", field, "--size", "0.1,0.605,0.1",
              "--brief", "A turned oak table leg.")
    p = os.path.join(ROOT, ".forge", name, "forge.json")
    c = json.load(open(p))
    c["stages"] = stages
    json.dump(c, open(p, "w"), indent=2)


# The judge's tolerance for a recovered asset.
TOLERANCE = {"to_field_p95": 0.1, "to_reference_p95": 0.25, "normal_mean": 2.0}


def test_chain():
    fixture = os.path.join(ROOT, "tools", "forge-fixtures", "leg")
    good = "forgetest_good"
    stages = [{"name": "profile", "free": ["PROFILE", "BOWS"], "surface": 1536, "volume": 512, "steps": 80}]
    new_asset(good, "tools/forge-fixtures/leg/good.wrela", "leg", stages)
    forge_run("synth", good, "--program", fixture, "--field", "good::leg", "--cell", "0.003")

    print("the judge against brute force")
    truth = json.loads(forge_run("judge", good, "--of", "source", "--brute").stdout)
    f, b = truth["shape"], truth["brute"]
    check(abs(f["to_field_mean"] - b["to_field_mean"]) < 0.05 and abs(f["to_field_p95"] - b["to_field_p95"]) < 0.25,
          f"to the field: fast {f['to_field_mean']:.3f}/{f['to_field_p95']:.3f} mm, brute {b['to_field_mean']:.3f}/{b['to_field_p95']:.3f}")
    check(abs(f["to_reference_mean"] - b["to_reference_mean"]) < 0.02 and abs(f["to_reference_p95"] - b["to_reference_p95"]) < 0.05,
          f"to the reference: fast {f['to_reference_mean']:.3f}/{f['to_reference_p95']:.3f} mm, brute {b['to_reference_mean']:.3f}/{b['to_reference_p95']:.3f}")
    check(f["normal_within"] > 0.99 and b["normal_within"] > 0.97,
          f"normals within 10°: fast {f['normal_within']:.3f}, brute {b['normal_within']:.3f}")
    check(f["sides"] == b["sides"] == 1.0, "every volume sample on its side, both ways")
    check(all(truth[f"silhouette_{v}"] == 1.0 for v in ("front", "side", "top", "three_quarter")),
          "the true program's outlines are its samples' in every view")

    print("the fitter")
    forge_run("scramble", good, "--names", "PROFILE,BOWS", "--move", "0.004", "--seed", "5")
    before = json.loads(forge_run("judge", good).stdout)["shape"]
    fit = forge_run("fit", good).stdout.strip().splitlines()[-1]
    after = json.loads(forge_run("judge", good).stdout)["shape"]
    print(f"        {fit}")
    check(before["to_field_p95"] > 1.0, f"scrambled: {before['to_field_p95']:.2f} mm at the 95th percentile")
    check(all(after[k] <= v for k, v in TOLERANCE.items()),
          "fitted to within the judge's tolerance: " + ", ".join(f"{k} {after[k]:.3f}" for k in TOLERANCE))

    print("the record")
    forge_run("record", good)
    r = forge_run("replay", good, check_status=False)
    check(r.returncode == 0, "the chain replayed from its record, every step the same")
    if r.returncode != 0:
        print("\n".join("        " + l for l in (r.stdout + r.stderr).splitlines() if "replay" in l))

    print("the judge's ranking")
    bad = "forgetest_bad"
    new_asset(bad, "tools/forge-fixtures/leg/degraded.wrela", "leg",
              [{"name": "all", "free": ["PROFILE", "BOWS", "SHEEN"], "surface": 512, "volume": 128, "steps": 1}])
    # Its reference is the good leg's.
    os.makedirs(os.path.join(ROOT, ".forge", bad, "reference"), exist_ok=True)
    shutil.copyfile(os.path.join(ROOT, ".forge", good, "reference", "samples.bin"),
                    os.path.join(ROOT, ".forge", bad, "reference", "samples.bin"))
    new_good = "forgetest_good2"
    new_asset(new_good, "tools/forge-fixtures/leg/good.wrela", "leg",
              [{"name": "all", "free": ["PROFILE", "BOWS"], "surface": 512, "volume": 128, "steps": 1}])
    os.makedirs(os.path.join(ROOT, ".forge", new_good, "reference"), exist_ok=True)
    shutil.copyfile(os.path.join(ROOT, ".forge", good, "reference", "samples.bin"),
                    os.path.join(ROOT, ".forge", new_good, "reference", "samples.bin"))
    # A dry solve each, to find the numbers no fit moves, moving none.
    forge_run("fit", bad, "--dry")
    forge_run("fit", new_good, "--dry")
    g = json.loads(forge_run("judge", new_good, "--of", "work").stdout)
    d = json.loads(forge_run("judge", bad, "--of", "work").stdout)
    lower = ["to_field_mean", "to_field_p95", "to_reference_mean", "to_reference_p95", "normal_mean"]
    for k in lower:
        check(d["shape"][k] > g["shape"][k], f"{k}: written badly {d['shape'][k]:.3f} > well {g['shape'][k]:.3f}")
    for k in ("normal_within", "sides"):
        check(d["shape"][k] <= g["shape"][k], f"{k}: written badly {d['shape'][k]:.3f} <= well {g['shape'][k]:.3f}")
    sil = [k for k in g if k.startswith("silhouette_")]
    check(all(d[k] <= g[k] for k in sil) and any(d[k] < g[k] for k in sil),
          "outlines: written badly no better in any view, worse in some")
    check(d["literals"] > g["literals"], f"literals: written badly {d['literals']} > well {g['literals']}")
    named = lambda x: sum(1 for n in x["names"] if n)
    check(named(d) < named(g), f"named parts: written badly {named(d)} < well {named(g)}")
    check(d["literals_never_moved"] > g["literals_never_moved"],
          f"literals never moved: written badly {d['literals_never_moved']} > well {g['literals_never_moved']}")
    for a in (good, bad, new_good):
        shutil.rmtree(os.path.join(ROOT, ".forge", a), ignore_errors=True)
        shutil.rmtree(os.path.join(ROOT, ".forge", a + "__replay"), ignore_errors=True)


def main():
    quick = "--quick" in sys.argv[1:]
    test_prompts()
    test_meshes()
    test_look()
    if not quick:
        test_chain()
    print("forge-test: " + ("every check holds" if not FAILED else f"{len(FAILED)} failed"))
    return 1 if FAILED else 0


if __name__ == "__main__":
    sys.exit(main())
