// The bodies the movement tools work on, each as one value (`Def`), so a tool is written once for
// any body and picks one by its name: `human` (`world::human`, the body the movement work learns
// on) or `creature` (`world::creature`, a test of the types).

use engine::body::body::{Body, Pose}
use engine::body::mass::Mass
use engine::body::joint::Kind
use engine::body::skin::Cone
use std::collections::Vec
use std::hash::sha256::{hex, sha256}
use world::creature_segments as cs
use world::human as hs

/// A body: its name (the folder of its poses), its declaration, its masses, its parts, its rest,
/// and the segments the tools name: the hands, the head, the upper chest, the pelvis, the left
/// leg's thigh, shank and foot, and the right foot.
pub struct Def<const S: u32, const D: u32, const P: u32>: Copy {
    pub name: Text,
    pub body: Body<S>,
    pub masses: [Mass; S],
    pub parts: [Cone; P],
    pub rest: Pose<D>,
    pub hand_left: u32,
    pub hand_right: u32,
    pub head: u32,
    pub upper_chest: u32,
    pub pelvis: u32,
    pub thigh_left: u32,
    pub shank_left: u32,
    pub foot_left: u32,
    pub foot_right: u32,
}

/// Whether a clip's body sits: it needs a seat that neither the judge's world nor the simulator
/// has. It moves slowly (its root under 0.25 m/s along the ground on average, at `rate` frames a
/// second: a walk or a run is held up by its own momentum, its centre of mass often outside its
/// feet), and in most of its frames (each fifth looked at) it is not held up by what touches the
/// floor: its centre of mass, along the ground, is more than 3 cm outside the hull of its parts'
/// lowest points within 3 cm of the floor (a body that stands, crouches, crawls or lies is over
/// them; one that sits has its feet down and its weight behind them), or nothing touches. Until
/// 2026-11-27 a low, still root was a seat: that left out ACCAD's crouching, crawling and lying
/// with MPI EMBM's narrators (239 of whose 288 clips sit).
pub fn seated<const S: u32, const D: u32, const P: u32>(
    def: Def<S, D, P>,
    poses: [Pose<D>],
    rate: f32,
) -> bool {
    let n = poses.len()
    if n < 2 {
        return false
    }
    var path = 0.0
    for i in 1..n {
        let d = poses[i].root.t - poses[i - 1].root.t
        path += length(vec2(d.x, d.z))
    }
    if path * rate / f32(n - 1) >= 0.25 {
        return false
    }
    var total = 0.0
    for m in def.masses {
        total += m.mass
    }
    var looked = 0
    var held = 0
    var f = 0
    while f < n {
        let at = def.body.places(poses[f])
        var com = vec3(0.0)
        for s in 0..S {
            com += at[s].apply(def.masses[s].centre) * def.masses[s].mass
        }
        com = com / total
        var pts: Vec<vec2> = Vec::new()
        for c in def.parts {
            let (a, b) = c.placed(at)
            if a.y - c.ra < 0.03 {
                pts.push(vec2(a.x, a.z))
            }
            if b.y - c.rb < 0.03 {
                pts.push(vec2(b.x, b.z))
            }
        }
        looked += 1
        if pts.len() > 0 && outside_hull(pts, vec2(com.x, com.z)) < 0.03 {
            held += 1
        }
        f += 5
    }
    held * 2 < looked
}

/// How far `p` is outside the convex hull of `pts` (m; 0 inside): its distance to the nearest of
/// the points, edges of the hull (Andrew's monotone chain), or 0 within it.
fn outside_hull(pts: Vec<vec2>, p: vec2) -> f32 {
    var q = pts.clone()
    q.sort_by(|a, b| a.x < b.x || (a.x == b.x && a.y < b.y))
    let cross = |o: vec2, a: vec2, b: vec2| (a.x - o.x) * (b.y - o.y) - (a.y - o.y) * (b.x - o.x)
    var hull: Vec<vec2> = Vec::new()
    for pass in 0..2 {
        let start = hull.len()
        for i in 0..q.len() {
            let v = if pass == 0 { q[i] } else { q[q.len() - 1 - i] }
            while hull.len() >= start + 2 && cross(hull[hull.len() - 2], hull[hull.len() - 1], v) <= 0.0 {
                let _ = hull.pop()
            }
            hull.push(v)
        }
        let _ = hull.pop()
    }
    let k = hull.len()
    if k == 0 {
        return 1.0e9
    }
    if k < 3 {
        // A point or a segment: the distance to it.
        let a = hull[0]
        let b = hull[k - 1]
        let ab = b - a
        let t = if dot(ab, ab) > 1.0e-12 { clamp(dot(p - a, ab) / dot(ab, ab), 0.0, 1.0) } else { 0.0 }
        return length(p - (a + ab * t))
    }
    var inside = true
    var nearest = 1.0e9
    for i in 0..k {
        let a = hull[i]
        let b = hull[(i + 1) % k]
        if cross(a, b, p) < 0.0 {
            inside = false
        }
        let ab = b - a
        let t = clamp(dot(p - a, ab) / max(dot(ab, ab), 1.0e-12), 0.0, 1.0)
        nearest = min(nearest, length(p - (a + ab * t)))
    }
    if inside { 0.0 } else { nearest }
}

/// How many parts the creature's flesh has (its 17 and the wand).
pub const CREATURE_PARTS: u32 = 18

pub fn creature() -> Def<cs::SEGMENTS, cs::FREEDOM, CREATURE_PARTS> {
    Def {
        name: "creature",
        body: world::creature::BODY,
        masses: world::creature::MASSES,
        parts: cs::PARTS,
        rest: world::creature::BODY.rest(),
        hand_left: cs::HAND_LEFT,
        hand_right: cs::HAND_RIGHT,
        head: cs::HEAD,
        upper_chest: cs::UPPER_CHEST,
        pelvis: cs::PELVIS,
        thigh_left: cs::THIGH_LEFT,
        shank_left: cs::SHIN_LEFT,
        foot_left: cs::FOOT_LEFT,
        foot_right: cs::FOOT_RIGHT,
    }
}

pub fn human() -> Def<hs::SEGMENTS, hs::FREEDOM, hs::PART_COUNT> {
    Def {
        name: "human",
        body: hs::BODY,
        masses: hs::MASSES,
        parts: hs::PARTS,
        rest: hs::REST,
        hand_left: hs::HAND_LEFT,
        hand_right: hs::HAND_RIGHT,
        head: hs::HEAD,
        upper_chest: hs::THORAX_HIGH,
        pelvis: hs::PELVIS,
        thigh_left: hs::THIGH_LEFT,
        shank_left: hs::SHANK_LEFT,
        foot_left: hs::FOOT_LEFT,
        foot_right: hs::FOOT_RIGHT,
    }
}

fn put(b: mut Vec<u8>, x: f32) {
    let u = bitcast_u32(x)
    b.push(u8(u & 255))
    b.push(u8((u >> 8) & 255))
    b.push(u8((u >> 16) & 255))
    b.push(u8((u >> 24) & 255))
}

fn put3(b: mut Vec<u8>, v: vec3) {
    put(mut b, v.x)
    put(mut b, v.y)
    put(mut b, v.z)
}

/// A digest of a body's declaration as the movement tools see it (each joint's kind, parent,
/// frame, range and strength; each segment's tip; each mass; each part's ends and radii; the
/// rest), the first 16 hex digits of its SHA-256: what a calibration of the judge, or anything
/// else measured on one body, is keyed by, so a tool refuses it once the body has changed.
pub fn declaration<const S: u32, const D: u32, const P: u32>(def: Def<S, D, P>) -> String {
    var b: Vec<u8> = Vec::new()
    for s in 0..S {
        let seg = def.body.segments[s]
        let j = seg.joint
        put(mut b, match j.kind {
            Kind::Fixed => 0.0,
            Kind::Hinge => 1.0,
            Kind::Universal => 2.0,
            Kind::Ball => 3.0,
        })
        put(mut b, f32(j.parent))
        put3(mut b, j.at.t)
        put3(mut b, j.at.q.v.xyz)
        put(mut b, j.at.q.v.w)
        put3(mut b, j.lo)
        put3(mut b, j.hi)
        put3(mut b, j.strength)
        put3(mut b, seg.tip)
        let m = def.masses[s]
        put(mut b, m.mass)
        put3(mut b, m.centre)
        for k in 0..3 {
            put3(mut b, m.inertia[k])
        }
    }
    for c in def.parts {
        put(mut b, f32(c.a.on))
        put3(mut b, c.a.at)
        put(mut b, c.ra)
        put(mut b, f32(c.b.on))
        put3(mut b, c.b.at)
        put(mut b, c.rb)
    }
    put3(mut b, def.rest.root.t)
    for k in 0..D {
        put(mut b, def.rest.q[k])
    }
    let full = hex(sha256(b))
    String::from(full.as_str().slice(0, 16))
}
