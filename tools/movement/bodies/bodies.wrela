// The bodies the movement tools work on, each as one value (`Def`), so a tool is written once for
// any body and picks one by its name: `human` (`world::human`, the body the movement work learns
// on) or `creature` (`world::creature`, a test of the types).

use engine::body::body::{Body, Pose}
use engine::body::mass::Mass
use engine::body::skin::Cone
use world::creature_segments as cs
use world::human as hs

/// A body: its name (the folder of its poses), its declaration, its masses, its parts, its rest,
/// and the segments the tools name: the hands, the head, the upper chest, the pelvis, the left
/// leg's thigh, shank and foot, and the right foot.
pub struct Def<const S: u32, const D: u32, const P: u32>: Copy {
    pub name: Text,
    pub body: Body<S>,
    pub masses: [Mass; S],
    pub parts: [Cone; P],
    pub rest: Pose<D>,
    pub hand_left: u32,
    pub hand_right: u32,
    pub head: u32,
    pub upper_chest: u32,
    pub pelvis: u32,
    pub thigh_left: u32,
    pub shank_left: u32,
    pub foot_left: u32,
    pub foot_right: u32,
}

/// How many parts the creature's flesh has (its 17 and the wand).
pub const CREATURE_PARTS: u32 = 18

pub fn creature() -> Def<cs::SEGMENTS, cs::FREEDOM, CREATURE_PARTS> {
    Def {
        name: "creature",
        body: world::creature::BODY,
        masses: world::creature::MASSES,
        parts: cs::PARTS,
        rest: world::creature::BODY.rest(),
        hand_left: cs::HAND_LEFT,
        hand_right: cs::HAND_RIGHT,
        head: cs::HEAD,
        upper_chest: cs::UPPER_CHEST,
        pelvis: cs::PELVIS,
        thigh_left: cs::THIGH_LEFT,
        shank_left: cs::SHIN_LEFT,
        foot_left: cs::FOOT_LEFT,
        foot_right: cs::FOOT_RIGHT,
    }
}

pub fn human() -> Def<hs::SEGMENTS, hs::FREEDOM, hs::PART_COUNT> {
    Def {
        name: "human",
        body: hs::BODY,
        masses: hs::MASSES,
        parts: hs::PARTS,
        rest: hs::REST,
        hand_left: hs::HAND_LEFT,
        hand_right: hs::HAND_RIGHT,
        head: hs::HEAD,
        upper_chest: hs::THORAX_HIGH,
        pelvis: hs::PELVIS,
        thigh_left: hs::THIGH_LEFT,
        shank_left: hs::SHANK_LEFT,
        foot_left: hs::FOOT_LEFT,
        foot_right: hs::FOOT_RIGHT,
    }
}
