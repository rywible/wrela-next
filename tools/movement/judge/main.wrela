// The judge's calibration (docs/plans/bodies-and-movement.md, phase 3 steps 5 to 7): each clip
// of the calibration set judged (`engine::judge::movement`) beside damaged copies of it (a faster
// time, a slide of the root, noise on the joints, a root too high, a body that does not move), the
// distance of each from the statistics of the training clips, and how often and how surely the
// judge prefers the capture.
//
//     tools/wrela tool tools/movement/judge --read poses=.movement/poses --read split=tools/movement/split \
//         -- [BODY] calibrate [CLIPS]   the calibration set (at most CLIPS of it)
//
// BODY is `human` (`world::human`) or `creature` (`world::creature`, the default): the body whose
// poses (`poses/BODY/...`) are judged.
//     ... -- one SOURCE/CLIP            one clip's measures
//     ... --read play=.movement/solver/play -- play SET | SOURCE/CLIP...
//                                       the solver's rollouts of those clips, held to the targets
//     ... --read play=.movement/solver/goals -- goals
//                                       the goal test's movements (tools/movement/solver -- goaltest)
//
// Reads the pose files that tools/movement/capture writes.

use clips::clips::{Clip, read_all, set}
use engine::body::body::Pose
use engine::body::joint::{Frame, turn_of_vector, vector_of_turn}
use engine::judge::movement::{
    Measures, Stats, add_stats, judge, judge_into, no_stats, stats_distance, velocity_error,
    velocity_goals,
}
use std::serialize::Writer
use std::collections::Vec
use std::field::half_space
use std::hash::pcg
use std::io::print
use std::quat::Quat
use std::serialize::Reader
use std::time::now
use std::tool::{ToolError, all, args}
use std::tool::blob
use std::tool::files
use bodies::bodies::Def
use world::creature_segments as cs
use world::human as hs

fn next(r: mut Reader) -> u32 {
    match r.read_u32() {
        Ok(x) => x,
        Err(_) => 0,
    }
}

/// The clip `name` of the capture of body `body` (`--read poses=...`).
fn load<const D: u32>(body: str, name: str) -> Result<Clip<D>, ToolError> {
    clips::clips::load("poses", body, name)
}

// ---- damage ---------------------------------------------------------------------------------------

/// The pose between `a` and `b` (`u` of the way).
fn between<const D: u32>(a: Pose<D>, b: Pose<D>, u: f32) -> Pose<D> {
    var p = a
    p.root = Frame { q: a.root.q.nlerp(b.root.q, u), t: mix(a.root.t, b.root.t, vec3(u)) }
    for k in 0..D {
        p.q[k] = mix(a.q[k], b.q[k], u)
    }
    p
}

/// The clip played `by` times as fast.
fn faster<const D: u32>(poses: Vec<Pose<D>>, by: f32) -> Vec<Pose<D>> {
    var out: Vec<Pose<D>> = Vec::new()
    let n = poses.len()
    var t = 0.0
    while t <= f32(n - 1) {
        let i = min(u32(floor(t)), n - 2)
        out.push(between(poses[i], poses[i + 1], t - f32(i)))
        t += by
    }
    out
}

/// The root slid along x at `speed` (m/s).
fn slid<const D: u32>(poses: Vec<Pose<D>>, rate: f32, speed: f32) -> Vec<Pose<D>> {
    var out = poses.clone()
    for f in 0..out.len() {
        out[f].root.t.x += speed * f32(f) / rate
    }
    out
}

/// A normal random number from `seed` (Box and Muller).
fn normal(seed: u32) -> f32 {
    let a = (f32(pcg(seed.wrapping_mul(2654435761).wrapping_add(1)) >> 8) + 0.5) / 16777216.0
    let b = (f32(pcg(seed.wrapping_mul(2246822519).wrapping_add(7)) >> 8) + 0.5) / 16777216.0
    sqrt(-2.0 * log(a)) * cos(6.2831853 * b)
}

/// Each number moved by noise of `sigma` rad, frame by frame.
fn noisy<const D: u32>(poses: Vec<Pose<D>>, sigma: f32) -> Vec<Pose<D>> {
    var out = poses.clone()
    for f in 0..out.len() {
        for k in 0..D {
            out[f].q[k] += sigma * normal(f * 131 + k * 7919 + 17)
        }
    }
    out
}

/// The root `by` m higher.
fn raised<const D: u32>(poses: Vec<Pose<D>>, by: f32) -> Vec<Pose<D>> {
    var out = poses.clone()
    for f in 0..out.len() {
        out[f].root.t.y += by
    }
    out
}

/// The first pose held for the clip's length.
fn still<const D: u32>(poses: Vec<Pose<D>>) -> Vec<Pose<D>> {
    var out: Vec<Pose<D>> = Vec::new()
    for _ in 0..poses.len() {
        out.push(poses[0])
    }
    out
}

// ---- scores -----------------------------------------------------------------------------------

/// What one movement scored: its measures, its distance from the training clips' statistics, and
/// its goal error (the root's speed against the clean clip's mean speed and way).
struct Scored: Copy {
    m: Measures,
    distance: f32,
    goal: f32,
}

fn scored<const S: u32, const D: u32, const P: u32>(
    def: Def<S, D, P>,
    poses: Vec<Pose<D>>,
    rate: f32,
    reference: Stats<D>,
    goals: Vec<vec2>,
    stride: f32,
) -> Scored {
    let m = judge(
        def.body,
        def.masses,
        def.parts,
        half_space(vec3(0.0, 1.0, 0.0), 0.0),
        poses.clone(),
        rate,
    )
    var st = no_stats()
    add_stats(mut st, poses.clone(), rate)
    Scored {
        m,
        distance: stats_distance(st, reference),
        goal: velocity_error(poses, rate, goals, stride),
    }
}

/// The measures a score is made of, each over its target (the calibration's), summed: 0 is a
/// movement with nothing wrong, 1 a measure at its target.
const MEASURES: u32 = 8

fn values(s: Scored) -> [f32; MEASURES] {
    [
        s.m.residual,
        s.m.torque_over,
        s.m.slide,
        s.m.penetration,
        s.m.float,
        max(s.m.range_most, 0.0),
        s.distance,
        s.goal,
    ]
}

const NAMES: [Text; MEASURES] = [
    "root residual (share of weight)",
    "torque over strength (share)",
    "slide in contact (mm/s)",
    "penetration (mm)",
    "float (mm)",
    "out of range (rad)",
    "distance from capture",
    "goal error (m/s: the root's velocity against the clip's own over 1 s)",
]

/// Each body's calibration's targets (`calibrate`: each the clean clips' 95th percentile or its
/// floor), which `play` and `goals` hold movements to: the creature's of 2026-11-25 (117
/// calibration clips), the human's of 2026-11-26 (89 of 100STYLE; MPI EMBM's sit).
fn targets(body: str) -> [f32; MEASURES] {
    if body == "human" {
        [0.4342245, 0.8948665, 1220.2483, 2.5811484, 32.24444, 0.01, 2.3248482, 0.41221356]
    } else {
        [0.92266834, 1.7351655, 984.02716, 2.0, 40.864124, 0.01, 4.7855315, 0.3195029]
    }
}

// ---- the laws of movement, calibrated ------------------------------------------------------------

const LAWS: u32 = 4

const LAW_NAMES: [Text; LAWS] = [
    "the hands' paths: |the two-thirds power law's exponent + 1/3|",
    "turns: the share not in the order head, trunk, pelvis",
    "standing: the sway of the centre of mass (mm, RMS)",
    "standing: the chest's power outside breath (0.1 to 0.6 Hz), a share",
]

/// The laws of movement on a movement (engine::judge::laws), each a number, or -1 where the
/// movement has none of what the law is about: a turn of the pelvis of 0.5 rad within a second
/// for the order of a turn, standing (`standing`: an idle clip) for sway and breath.
fn law_values<const S: u32, const D: u32, const P: u32>(
    def: Def<S, D, P>,
    poses: Vec<Pose<D>>,
    rate: f32,
    standing: bool,
) -> [f32; LAWS] {
    var out = [-1.0; LAWS]
    var pl_sum = 0.0
    var pl_n = 0.0
    for hand in [def.hand_left, def.hand_right] {
        let p = engine::judge::laws::path(def.body, poses.clone(), hand, vec3(0.0))
        let pl = engine::judge::laws::power_law(p, rate, 0, poses.len())
        if pl.y > 30.0 {
            pl_sum += abs(pl.x + 1.0 / 3.0)
            pl_n += 1.0
        }
    }
    if pl_n > 0.0 {
        out[0] = pl_sum / pl_n
    }
    let up = vec3(0.0, 0.0, 1.0)
    let head = engine::judge::laws::headings(def.body, poses.clone(), def.head, up)
    let trunk = engine::judge::laws::headings(def.body, poses.clone(), def.upper_chest, up)
    let pelvis = engine::judge::laws::headings(def.body, poses.clone(), def.pelvis, up)
    var turns = 0
    var in_order = 0
    var f = 0
    let second = u32(rate)
    while f + second < poses.len() {
        if abs(pelvis[f + second] - pelvis[f]) > 0.5 {
            let o = engine::judge::laws::turn_order(head, trunk, pelvis, f, 0.1)
            if o.x != engine::judge::laws::NONE_FRAME && o.z != engine::judge::laws::NONE_FRAME {
                turns += 1
                if o.x <= o.y && o.y <= o.z {
                    in_order += 1
                }
            }
            f += second
        } else {
            f += 1
        }
    }
    if turns > 0 {
        out[1] = 1.0 - f32(in_order) / f32(turns)
    }
    if standing {
        let centre = engine::judge::laws::centre_path(def.body, def.masses, poses.clone())
        var chest: Vec<f32> = Vec::new()
        for p in poses {
            chest.push(def.body.places(p)[def.upper_chest].t.y)
        }
        let st = engine::judge::laws::standing(centre, chest, rate)
        out[2] = st.sway * 1000.0
        out[3] = 1.0 - st.breath_share
    }
    out
}

fn percentile(xs: Vec<f32>, q: f32) -> f32 {
    if xs.is_empty() {
        return -1.0
    }
    var v = xs.clone()
    v.sort_by(|a, b| a < b)
    v[min(u32(q * f32(v.len())), v.len() - 1)]
}

/// The laws on the calibration clips and their damaged copies (faster, noisy, still): each law's
/// band (the clean clips' 5th to 95th percentile) and how often a damaged copy lands outside it.
fn laws_calibrate<const S: u32, const D: u32, const P: u32>(
    def: Def<S, D, P>,
) -> Result<u32, ToolError> {
    let names = set("calibration")?
    var clean: Vec<[f32; LAWS]> = Vec::new()
    var damaged: Vec<[f32; LAWS]> = Vec::new()
    var kinds: Vec<u32> = Vec::new()
    let t0 = now()
    var seconds = 0.0
    for name in names {
        let c = load::<D>(def.name, name.as_str())?
        let n = name.as_str()
        let idle = n.ends_with("_ID") || n.starts_with("embm/")
        seconds += f32(c.poses.len()) / c.rate
        clean.push(law_values(def, c.poses.clone(), c.rate, idle))
        for k in 0..3 {
            let amount = [0.02, 0.05, 0.1][k]
            damaged.push(law_values(def, noisy(c.poses.clone(), amount), c.rate, idle))
            kinds.push(k)
            let by = [1.25, 1.5, 2.0][k]
            damaged.push(law_values(def, faster(c.poses.clone(), by), c.rate, idle))
            kinds.push(3 + k)
        }
        damaged.push(law_values(def, still(c.poses.clone()), c.rate, idle))
        kinds.push(6)
    }
    let kind_names = [
        "noisy 0.02",
        "noisy 0.05",
        "noisy 0.1",
        "faster 1.25",
        "faster 1.5",
        "faster 2",
        "still",
    ]
    for l in 0..LAWS {
        var xs: Vec<f32> = Vec::new()
        for v in clean {
            if v[l] >= 0.0 {
                xs.push(v[l])
            }
        }
        let (lo, hi) = (percentile(xs.clone(), 0.05), percentile(xs.clone(), 0.95))
        print(
            f"laws: {LAW_NAMES[l]}: {xs.len()} clean clips, band {lo} to {hi} (median {percentile(xs.clone(), 0.5)})",
        )
        for k in 0..7 {
            var n = 0
            var out = 0
            for i in 0..damaged.len() {
                if kinds[i] == k && damaged[i][l] >= 0.0 {
                    n += 1
                    if damaged[i][l] < lo || damaged[i][l] > hi {
                        out += 1
                    }
                }
            }
            if n > 0 {
                print(f"laws:     {kind_names[k]}: {out} of {n} outside the band")
            }
        }
    }
    print(
        f"laws: {f32(now() - t0)} s for {seconds} s of clean movement, each with 7 damaged copies",
    )
    Ok(0)
}

/// The solver's rollouts (`tools/movement/solver -- play`, read as `play`) of the clips `names`:
/// each judged with its source's statistics and the goals of the clip it followed over the same
/// frames; how many pass each measure, and the mean of each.
fn judge_play<const S: u32, const D: u32, const P: u32>(
    def: Def<S, D, P>,
    names: Vec<String>,
) -> Result<u32, ToolError> {
    let refs_100 = reference(def, 120, "100style/")?
    let refs_embm = reference(def, 120, "embm/")?
    let target = targets(def.name)
    var means = [0.0; MEASURES]
    var passed = [0; MEASURES]
    var all_passed = 0
    var n = 0
    for name in names {
        let Ok(p) = clips::clips::load::<D>("play", def.name, name.as_str()) else { continue }
        let c = load::<D>(def.name, name.as_str())?
        var goals = velocity_goals(c.poses.clone(), c.rate, 1.0)
        goals.truncate(p.poses.len())
        let refs = if name.as_str().starts_with("embm/") { refs_embm.clone() } else {
            refs_100.clone()
        }
        let s = scored(def, p.poses.clone(), p.rate, refs, goals, 1.0)
        let v = values(s)
        var ok = true
        for i in 0..MEASURES {
            means[i] += v[i]
            if v[i] <= target[i] {
                passed[i] += 1
            } else {
                ok = false
            }
        }
        if ok {
            all_passed += 1
        }
        n += 1
        print(
            f"{measures_line(name.as_str(), s)} | score {score(v, target)}{if ok { "" } else { " FAILS" }}",
        )
    }
    for i in 0..MEASURES {
        print(
            f"judge: {NAMES[i]}: mean {means[i] / f32(max(n, 1))}, {passed[i]} of {n} in the target {target[i]}",
        )
    }
    print(f"judge: {all_passed} of {n} rollouts in every target")
    Ok(n)
}

/// The goal test's movements (`tools/movement/solver -- goaltest`, read as `play`): each judged
/// with 100STYLE's statistics against the velocity it was asked for at each frame.
fn judge_goals<const S: u32, const D: u32, const P: u32>(
    def: Def<S, D, P>,
    names: Vec<String>,
) -> Result<u32, ToolError> {
    let refs = reference(def, 120, "100style/")?
    let target = targets(def.name)
    var all_passed = 0
    for name in names {
        let p = clips::clips::load::<D>("play", def.name, f"goal/{name}".as_str())?
        let bytes = read_all(f"play/{def.name}/goal/{name}.vel")?
        var r = Reader::new(take bytes)
        var goals: Vec<vec2> = Vec::new()
        for _ in 0..p.poses.len() {
            let x = bitcast_f32(next(mut r))
            let z = bitcast_f32(next(mut r))
            goals.push(vec2(x, z))
        }
        let s = scored(def, p.poses.clone(), p.rate, refs.clone(), goals, 1.0)
        let v = values(s)
        var failing: Vec<String> = Vec::new()
        for i in 0..MEASURES {
            if v[i] > target[i] {
                failing.push(f"{NAMES[i]} {v[i]} > {target[i]}")
            }
        }
        if failing.is_empty() {
            all_passed += 1
        }
        print(f"{measures_line(name.as_str(), s)} | score {score(v, target)}")
        for f in failing {
            print(f"    fails: {f}")
        }
    }
    print(f"judge: {all_passed} of the goal test's movements in every target")
    Ok(all_passed)
}

fn score(v: [f32; MEASURES], target: [f32; MEASURES]) -> f32 {
    var s = 0.0
    for i in 0..MEASURES {
        s += v[i] / max(target[i], 1.0e-6)
    }
    s
}

fn measures_line(name: str, s: Scored) -> String {
    let v = values(s)
    f"{name}: residual {v[0]} torque {v[1]} slide {v[2]} pen {v[3]} float {v[4]} range {v[5]} dist {v[6]} goal {v[7]} | speed {s.m.speed} energy {s.m.energy} duty {s.m.duty} flight {s.m.flight}"
}

fn print_measures(name: str, s: Scored) {
    print(measures_line(name, s).as_str())
}

/// The training clips' statistics of one source (`SOURCE/` names), at most `most` clips of it: a
/// movement is held to capture of its own kind (walks and runs to 100STYLE's, gestures while
/// standing to MPI EMBM's).
fn reference<const S: u32, const D: u32, const P: u32>(
    def: Def<S, D, P>,
    most: u32,
    source: str,
) -> Result<Stats<D>, ToolError> {
    let body = def.name
    var names: Vec<String> = Vec::new()
    for n in set("training")? {
        if n.as_str().starts_with(source) {
            names.push(n.clone())
        }
    }
    var st = no_stats()
    let step = max(names.len() / most, 1)
    var i = 0
    while i < names.len() {
        let c = load::<D>(body, names[i].as_str())?
        if !bodies::bodies::seated(def, c.poses.clone(), c.rate) {
            add_stats(mut st, c.poses, c.rate)
        }
        i += step
    }
    Ok(st)
}

/// One clip of the calibration set to judge, with the training clips' statistics.
struct Job<const D: u32>: Clone {
    name: String,
    refs: Stats<D>,
}

/// A clip judged with its damaged copies (the kinds in turn, each at its amounts): what it scored
/// and how long the judge took for the clean one.
struct Judged: Clone {
    failed: bool,
    clean: [f32; MEASURES],
    damaged: Vec<[f32; MEASURES]>,
    timing: f32,
    seconds: f32,
    lines: Vec<String>,
}

const KINDS: [Text; 5] = ["faster", "slid", "noisy", "raised", "still"]

/// Each kind's three amounts: times as fast, m/s of slide, rad of noise, m higher (the body that
/// does not move at one).
const AMOUNTS: [vec3; 5] = [
    vec3(1.25, 1.5, 2.0),
    vec3(0.2, 0.5, 1.0),
    vec3(0.02, 0.05, 0.1),
    vec3(0.02, 0.05, 0.1),
    vec3(1.0, 1.0, 1.0),
]

fn judged_human(j: take Job<hs::FREEDOM>) -> Judged {
    judged_clip(bodies::bodies::human(), j)
}

fn judged_creature(j: take Job<cs::FREEDOM>) -> Judged {
    judged_clip(bodies::bodies::creature(), j)
}

fn judged_clip<const S: u32, const D: u32, const P: u32>(def: Def<S, D, P>, j: Job<D>) -> Judged {
    var out = Judged {
        failed: true,
        clean: [0.0; MEASURES],
        damaged: Vec::new(),
        timing: 0.0,
        seconds: 0.0,
        lines: Vec::new(),
    }
    let Ok(c) = load::<D>(def.name, j.name.as_str()) else { return out }
    if bodies::bodies::seated(def, c.poses.clone(), c.rate) {
        out.lines.push(f"{c.name}: seated, left out")
        return out
    }
    let goals = velocity_goals(c.poses.clone(), c.rate, 1.0)
    let t0 = now()
    let s0 = scored(def, c.poses.clone(), c.rate, j.refs, goals.clone(), 1.0)
    out.timing = f32(now() - t0)
    out.seconds = f32(c.poses.len()) / c.rate
    out.clean = values(s0)
    out.lines.push(measures_line(f"{c.name} clean", s0))
    for k in 0..5 {
        for a in 0..3 {
            if k == 4 && a > 0 {
                continue
            }
            let amount = AMOUNTS[k][a]
            let poses = if k == 0 { faster(c.poses.clone(), amount) } else if k == 1 {
                slid(c.poses.clone(), c.rate, amount)
            } else if k == 2 { noisy(c.poses.clone(), amount) } else if k == 3 {
                raised(c.poses.clone(), amount)
            } else { still(c.poses.clone()) }
            let stride = if k == 0 { amount } else { 1.0 }
            let s = scored(def, poses, c.rate, j.refs, goals.clone(), stride)
            out.lines.push(measures_line(f"{c.name} {KINDS[k]} {amount}", s))
            out.damaged.push(values(s))
        }
    }
    out.failed = false
    out
}

/// The calibration's jobs: each calibration clip (at most `most`) with its source's statistics.
fn calibration_jobs<const S: u32, const D: u32, const P: u32>(
    def: Def<S, D, P>,
    most: u32,
) -> Result<Vec<Job<D>>, ToolError> {
    let names = set("calibration")?
    let refs_100 = reference(def, 120, "100style/")?
    let refs_embm = reference(def, 120, "embm/")?
    print(
        f"judge: {def.name}: the training clips' statistics over {refs_100.count} frames of 100STYLE and {refs_embm.count} of MPI EMBM",
    )
    let count = min(most, names.len())
    var jobs: Vec<Job<D>> = Vec::new()
    for ci in 0..count {
        let refs = if names[ci].as_str().starts_with("embm/") { refs_embm.clone() } else {
            refs_100.clone()
        }
        jobs.push(Job { name: names[ci].clone(), refs })
    }
    Ok(jobs)
}

/// The calibration from its judged clips: the targets, and how often the judge prefers the
/// capture to each damaged copy.
fn calibrate(results: Vec<Judged>) -> Result<u32, ToolError> {
    // Each clip and its damaged copies: the kinds, each at three amounts (the body that does not
    // move at one).
    let kinds = ["faster", "slid", "noisy", "raised", "still"]
    let amounts = [
        vec3(1.25, 1.5, 2.0),
        vec3(0.2, 0.5, 1.0),
        vec3(0.02, 0.05, 0.1),
        vec3(0.02, 0.05, 0.1),
        vec3(1.0, 1.0, 1.0),
    ]
    var clean: Vec<[f32; MEASURES]> = Vec::new()
    var damaged: Vec<[f32; MEASURES]> = Vec::new()
    var timing = 0.0
    var seconds = 0.0
    var left_out = 0
    for r in results {
        if r.failed {
            left_out += 1
            continue
        }
        timing += r.timing
        seconds += r.seconds
        clean.push(r.clean)
        for v in r.damaged {
            damaged.push(v)
        }
        for line in r.lines {
            print(line.as_str())
        }
    }
    print(f"judge: {clean.len()} clips judged, {left_out} left out (seated, or not read)")
    print(f"judge: {timing * 1000.0 / max(seconds, 1.0e-6)} ms a second of movement")
    // The targets: the 95th percentile of each measure over the clean clips (a clean clip passes),
    // or a floor where that is 0.
    let floors = [0.02, 0.02, 20.0, 2.0, 2.0, 0.01, 0.2, 0.05]
    var target = [0.0; MEASURES]
    for i in 0..MEASURES {
        var xs: Vec<f32> = Vec::new()
        for v in clean {
            xs.push(v[i])
        }
        xs.sort_by(|a, b| a < b)
        let p95 = xs[min(u32(f32(xs.len()) * 0.95), xs.len() - 1)]
        target[i] = max(p95, floors[i])
        print(f"judge: target {NAMES[i]}: {target[i]} (the clean clips' 95th percentile {p95})")
    }
    // The pairs: each clean clip against each of its damaged copies.
    let per = 13
    var better = 0
    var pairs = 0
    var by_kind = [vec2(0.0); 5]
    var monotone = [0; 5]
    var monotone_of = [0; 5]
    for ci in 0..clean.len() {
        let s_clean = score(clean[ci], target)
        var idx = ci * per
        for k in 0..5 {
            let n = if k == 4 { 1 } else { 3 }
            var last = s_clean
            var rising = true
            for _ in 0..n {
                let s = score(damaged[idx], target)
                pairs += 1
                by_kind[k] += vec2(if s > s_clean { 1.0 } else { 0.0 }, 1.0)
                if s > s_clean {
                    better += 1
                }
                if s <= last {
                    rising = false
                }
                last = s
                idx += 1
            }
            if n > 1 {
                monotone_of[k] += 1
                if rising {
                    monotone[k] += 1
                }
            }
        }
    }
    print(
        f"judge: the capture scored better in {better} of {pairs} pairs ({100.0 * f32(better) / f32(max(pairs, 1))}%)",
    )
    for k in 0..5 {
        print(
            f"judge:   {kinds[k]}: {by_kind[k].x} of {by_kind[k].y} better; worse with more damage in {monotone[k]} of {monotone_of[k]} clips",
        )
    }
    Ok(0)
}

pub fn tool() -> u32 {
    let all_args = args()
    // The body: the first argument, if it names one.
    let named = all_args.len() > 0 &&
        (all_args[0].as_str() == "human" || all_args[0].as_str() == "creature")
    let body = if named { all_args[0].clone() } else { String::from("creature") }
    var a: Vec<String> = Vec::new()
    for i in (if named { 1 } else { 0 })..all_args.len() {
        a.push(all_args[i].clone())
    }
    if a.len() < 1 {
        print("usage: judge [human | creature] calibrate [CLIPS] | one SOURCE/CLIP | ...")
        return 2
    }
    let what = a[0].as_str()
    if what == "calibrate" {
        let most = if a.len() > 1 { a[1].as_str().parse_u32().unwrap_or(1000) } else { 1000 }
        let results = if body.as_str() == "human" {
            let Ok(jobs) = calibration_jobs(bodies::bodies::human(), most) else { return 1 }
            all(take jobs, judged_human)
        } else {
            let Ok(jobs) = calibration_jobs(bodies::bodies::creature(), most) else { return 1 }
            all(take jobs, judged_creature)
        }
        return match calibrate(take results) {
            Ok(_) => 0,
            Err(e) => {
                print(f"judge: {e.message()}")
                1
            },
        }
    }
    if what == "walk" {
        return walk()
    }
    if body.as_str() == "human" { command(bodies::bodies::human(), a) } else {
        command(bodies::bodies::creature(), a)
    }
}

/// Today's walk cycle (rules::walk, the creature's), 4 s at 30 frames a second: in place, as the
/// scenes play it, and with its root carried along by its travel.
fn walk() -> u32 {
    let def = bodies::bodies::creature()
    let w = rules::walk::walk()
    for moving in [false, true] {
        var poses: Vec<Pose<cs::FREEDOM>> = Vec::new()
        for i in 0..120 {
            let t = f32(i) / 30.0
            var p = w.pose(t)
            if moving {
                p.root.t += w.travel * (t / w.period)
            }
            poses.push(p)
        }
        let goals = velocity_goals(poses.clone(), 30.0, 1.0)
        let s = scored(def, poses, 30.0, no_stats(), goals, 1.0)
        print_measures(if moving { "the walk, carried by its travel" } else {
            "the walk, in place"
        }, s)
    }
    0
}

/// The commands on one body's poses.
fn command<const S: u32, const D: u32, const P: u32>(def: Def<S, D, P>, a: Vec<String>) -> u32 {
    let what = a[0].as_str()
    if what == "feet" && a.len() > 1 {
        let Ok(c) = load::<D>(def.name, a[1].as_str()) else { return 1 }
        // Each foot part's lowest sample point: its height and how fast it moves along the ground
        // in the frames it is within 2 cm of it.
        var feet: Vec<u32> = Vec::new()
        for i in 0..P {
            if def.parts[i].span.from == def.foot_left || def.parts[i].span.from == def.foot_right {
                feet.push(i)
            }
        }
        for part in feet {
            var speeds: Vec<f32> = Vec::new()
            var low = 0
            for f in 1..c.poses.len() - 1 {
                let (fa, fb, fc) = (
                    def.body.places(c.poses[f - 1]),
                    def.body.places(c.poses[f]),
                    def.body.places(c.poses[f + 1]),
                )
                let cone = def.parts[part]
                var best = 1.0e9
                var v = 0.0
                for k in 0..3 {
                    let u = f32(k) * 0.5
                    let seg = if u < 0.5 { cone.a.on } else { cone.b.on }
                    let (a0, b0) = cone.placed(fb)
                    let centre = mix(a0, b0, vec3(u))
                    let r = mix(cone.ra, cone.rb, u)
                    let h = centre.y - r
                    if h < best {
                        best = h
                        let local = fb[seg].inverse().apply(centre - vec3(0.0, r, 0.0))
                        let d = fc[seg].apply(local) - fa[seg].apply(local)
                        v = length(vec2(d.x, d.z)) * c.rate * 0.5
                    }
                }
                if best < 0.02 {
                    speeds.push(v)
                    low += 1
                }
            }
            speeds.sort_by(|x, y| x < y)
            let m = speeds.len()
            if m > 0 {
                print(
                    f"feet: part {part}: {low} low frames, speed (mm/s) median {1000.0 * speeds[m / 2]} p25 {1000.0 * speeds[m / 4]} p75 {1000.0 * speeds[3 * m / 4]}",
                )
            }
        }
        0
    } else if what == "dump" && a.len() > 1 {
        // Each inner frame's joint moments and contact forces (`judge_into`'s detail), for the
        // simulator's inverse dynamics to be held to (tools/movement/check_dynamics.py):
        // `out/CLIP.dyn`: u32 frames, u32 segments, then each frame's 3 S vectors (f32 x, y, z).
        let Ok(c) = load::<D>(def.name, a[1].as_str()) else { return 1 }
        var forces: Vec<vec3> = Vec::new()
        var detail: Vec<vec3> = Vec::new()
        let _ = judge_into(
            def.body,
            def.masses,
            def.parts,
            half_space(vec3(0.0, 1.0, 0.0), 0.0),
            c.poses.clone(),
            c.rate,
            mut forces,
            mut detail,
            true,
        )
        var w = Writer::new()
        w.write_u32(forces.len())
        w.write_u32(S)
        for v in detail {
            w.write_u32(bitcast_u32(v.x))
            w.write_u32(bitcast_u32(v.y))
            w.write_u32(bitcast_u32(v.z))
        }
        let bytes = take w.into_bytes()
        let b = match blob::new().wait() {
            Ok(b) => b,
            Err(_) => return 1,
        }
        var at = 0
        while at < bytes.len() {
            let end = min(at + 524288, bytes.len())
            var part: Vec<u8> = Vec::new()
            for i in at..end {
                part.push(bytes[i])
            }
            let _ = blob::append(b, part).wait()
            at = end
        }
        let _ = files::write_blob(f"out/{a[1]}.dyn", b).wait()
        print(f"dump: {forces.len()} frames")
        0
    } else if what == "ranges" && a.len() > 1 {
        // Each segment's share of frames out of its range by more than 0.01 rad, and its worst.
        let Ok(c) = load::<D>(def.name, a[1].as_str()) else { return 1 }
        for sg in 1..S {
            var out = 0
            var worst = -1.0e9
            for p in c.poses {
                let r = def.body.segments[sg].joint.range(def.body.numbers(p, sg))
                worst = max(worst, r)
                if r > 0.01 {
                    out += 1
                }
            }
            if out > 0 {
                print(
                    f"ranges: segment {sg}: {out} of {c.poses.len()} frames out, the worst {worst} rad, numbers range lo {def.body.segments[sg].joint.lo} hi {def.body.segments[sg].joint.hi}",
                )
            }
        }
        0
    } else if what == "laws" && a.len() > 1 {
        // The laws of movement (engine::judge::laws) on a clip: the hands' paths (their reaches'
        // distance from minimum jerk, and the two-thirds power law's exponent), the turns' order
        // (head, trunk, pelvis), and standing (sway and breath).
        let Ok(c) = load::<D>(def.name, a[1].as_str()) else { return 1 }
        let t0 = now()
        for (side, hand) in [("left", def.hand_left), ("right", def.hand_right)] {
            let p = engine::judge::laws::path(def.body, c.poses.clone(), hand, vec3(0.0))
            let rs = engine::judge::laws::reaches(p.clone(), c.rate, 0.05, 0.3)
            var jerk = 0.0
            for r in rs {
                jerk += engine::judge::laws::reach_jerk(p.clone(), c.rate, r)
            }
            let pl = engine::judge::laws::power_law(p.clone(), c.rate, 0, c.poses.len())
            print(
                f"laws: {side} hand: {rs.len()} reaches, their mean distance from minimum jerk {jerk / max(f32(rs.len()), 1.0)}; the power law's exponent {pl.x} over {pl.y} frames (the law: -0.333)",
            )
        }
        let head = engine::judge::laws::headings(
            def.body,
            c.poses.clone(),
            def.head,
            vec3(0.0, 0.0, 1.0),
        )
        let trunk = engine::judge::laws::headings(
            def.body,
            c.poses.clone(),
            def.upper_chest,
            vec3(0.0, 0.0, 1.0),
        )
        let pelvis = engine::judge::laws::headings(
            def.body,
            c.poses.clone(),
            def.pelvis,
            vec3(0.0, 0.0, 1.0),
        )
        // Turns: from each frame where the pelvis is about to turn 0.5 rad within a second.
        var turns = 0
        var in_order = 0
        var lag_ht = 0.0
        var f = 0
        while f + u32(c.rate) < c.poses.len() {
            let ahead = f + u32(c.rate)
            if abs(pelvis[ahead] - pelvis[f]) > 0.5 {
                let o = engine::judge::laws::turn_order(head, trunk, pelvis, f, 0.1)
                if o.x != engine::judge::laws::NONE_FRAME &&
                    o.z != engine::judge::laws::NONE_FRAME {
                    turns += 1
                    if o.x <= o.y && o.y <= o.z {
                        in_order += 1
                    }
                    lag_ht += (f32(o.z) - f32(o.x)) / c.rate
                }
                f = ahead
            } else {
                f += 1
            }
        }
        print(
            f"laws: {turns} turns, {in_order} with the head before the trunk before the pelvis, the head {lag_ht / max(f32(turns), 1.0) * 1000.0} ms before the pelvis on average",
        )
        let centre = engine::judge::laws::centre_path(def.body, def.masses, c.poses.clone())
        var chest: Vec<f32> = Vec::new()
        for p in c.poses {
            chest.push(def.body.places(p)[def.upper_chest].t.y)
        }
        let st = engine::judge::laws::standing(centre, chest, c.rate)
        print(
            f"laws: standing: sway {st.sway * 1000.0} mm, {st.sway_below_1hz} of its power below 1 Hz; the chest's strongest rise and fall at {st.breath_hz} Hz ({st.breath_hz * 60.0} a minute), {st.breath_share} of its power between 0.1 and 0.6 Hz",
        )
        print(
            f"laws: {f32(now() - t0) * 1000.0} ms for {f32(c.poses.len()) / c.rate} s of movement",
        )
        0
    } else if what == "contacts" && a.len() > 1 {
        // Which segments carry contact force, frame by frame (every 30th), and how fast each such
        // segment's lowest point moves.
        let Ok(c) = load::<D>(def.name, a[1].as_str()) else { return 1 }
        var forces: Vec<vec3> = Vec::new()
        var detail: Vec<vec3> = Vec::new()
        let _ = judge_into(
            def.body,
            def.masses,
            def.parts,
            half_space(vec3(0.0, 1.0, 0.0), 0.0),
            c.poses.clone(),
            c.rate,
            mut forces,
            mut detail,
            true,
        )
        let n = S
        var f = 1
        while f + 1 < c.poses.len() {
            var line = String::from(f"contacts: frame {f}:")
            for sg in 0..n {
                let cf = detail[(f - 1) * 3 * n + n + sg]
                if length(cf) > 1.0 {
                    let pa = def.body.places(c.poses[f - 1])[sg].t
                    let pc = def.body.places(c.poses[f + 1])[sg].t
                    let v = (pc - pa) * (0.5 * c.rate)
                    line.push_str(
                        f" seg {sg} {length(cf)} N (its origin {length(vec2(v.x, v.z))} m/s)",
                    )
                }
            }
            print(line.as_str())
            f += 30
        }
        0
    } else if what == "play" && a.len() > 1 {
        // A set's name, or clip names.
        var names: Vec<String> = Vec::new()
        if a.len() == 2 && (a[1].as_str() == "training" || a[1].as_str() == "test") {
            let Ok(s) = set(a[1].as_str()) else { return 1 }
            names = take s
        } else {
            for i in 1..a.len() {
                names.push(a[i].clone())
            }
        }
        match judge_play(def, names) {
            Ok(_) => 0,
            Err(e) => {
                print(f"judge: {e.message()}")
                1
            },
        }
    } else if what == "laws-calibrate" {
        match laws_calibrate(def) {
            Ok(_) => 0,
            Err(e) => {
                print(f"judge: {e.message()}")
                1
            },
        }
    } else if what == "goals" {
        var names: Vec<String> = Vec::new()
        for n in ["start", "stop", "walk", "run", "turn", "side", "reach", "look"] {
            names.push(n.to_string())
        }
        match judge_goals(def, names) {
            Ok(_) => 0,
            Err(e) => {
                print(f"judge: {e.message()}")
                1
            },
        }
    } else if what == "one" && a.len() > 1 {
        match load::<D>(def.name, a[1].as_str()) {
            Ok(c) => {
                let goals = velocity_goals(c.poses.clone(), c.rate, 1.0)
                let s = scored(def, c.poses.clone(), c.rate, no_stats(), goals, 1.0)
                print_measures(c.name.as_str(), s)
                0
            },
            Err(e) => {
                print(f"judge: {e.message()}")
                1
            },
        }
    } else {
        2
    }
}
