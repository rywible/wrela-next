// The import of capture (docs/plans/bodies-and-movement.md, phase 2): reads capture files and
// writes poses of one of our bodies. The names of a capture format's bones stay in this tool
// (`maps`); the kit and the engine never see them.
//
//     tools/wrela tool tools/movement/capture --read capture=.movement/capture \
//         --write out=.movement/poses -- BODY SOURCE [FIRST COUNT [STEPS [ground | smooth]]]
//
// BODY is `human` (`world::human`, the body the movement work learns on) or `creature`
// (`world::creature`, a test of the types).
//
// For each clip of SOURCE (a source of the register, docs/plans/movement-sources.md, whose row
// is in docs/citations.md), it:
//
// 1. reads the capture (BVH: its skeleton, its channels and its frames) and works out each bone's
//    place and turn in each frame;
// 2. scales the capture to the body: lengths by the ratio of the body's leg (hip to ankle) to the
//    capture's, and time by that ratio's square root, which keeps the Froude number (a body with
//    shorter legs moves with a shorter period);
// 3. fits a pose of the body to each frame at `RATE` frames a second (`engine::body::fit`): each
//    mapped segment turned from its rest as the capture's bone turned from its own, its root, its
//    hands and its feet where the scaled capture puts them, each joint kept in its range field;
// 4. writes the poses (`out/BODY/SOURCE/CLIP.pose`) and the clip's record (`CLIP.json`: the
//    source, the file and its SHA-256, the credit, how the fit went), and prints a line a clip.
//
// A pose file: "WPOS", then u32s version (1), numbers a pose (D), frames, then f32 frames a
// second, then each frame's root place (3), root turn (4: a quaternion's x, y, z, w) and numbers
// (D), all little-endian.

use clips::clips::{read_all, write_all}
use engine::body::body::{Body, Pose}
use engine::body::fit::{Aim, aim_floor, aim_frame, aim_point, fit}
use engine::body::joint::{Frame, vector_of_turn}
use std::collections::Vec
use std::hash::sha256::{hex, sha256}
use std::io::print
use std::quat::Quat
use std::serialize::Writer
use std::tool::{ToolError, all, args}
use std::tool::blob
use std::tool::files
use engine::body::skin::Cone
use world::creature_segments as cs
use world::human as hs

/// The poses' rate (frames a second, in the body's time).
const RATE: f32 = 30.0

/// How much a number's change from the frame before weighs in the fit (per rad): a number no aim
/// fixes (a straight arm's twist) holds still rather than wander. With the fit's own default
/// (0.001), the judge's force against force plates was 25% of the weight off on average, with
/// spikes of ten weights where an arm's twist spun; with this, 6% (tools/movement/forces).
const STILL: f32 = 0.05

/// How many steps the fit takes for a frame (from the frame before, unless the command line
/// gives another number), and for a clip's first.
const STEPS: u32 = 4
const FIRST_STEPS: u32 = 200

// ---- a BVH file ---------------------------------------------------------------------------------

/// A bone of a BVH skeleton: its name, its parent (`NONE`), its offset in its parent at rest,
/// its channels (0 to 2 a place's x, y, z; 3 to 5 a turn about x, y, z, in the order written),
/// where its channels start in a frame's numbers, and its end site's offset (if it has one).
struct Bone: Clone {
    name: String,
    parent: u32,
    offset: vec3,
    channels: Vec<u32>,
    first: u32,
    end: vec3,
    has_end: bool,
}

const NONE: u32 = 4294967295

struct Bvh: Clone {
    bones: Vec<Bone>,
    frames: u32,
    frame_time: f32,
    stride: u32,
    values: Vec<f32>,
}

/// The words of `text`, as (start, end) byte ranges.
fn words(text: [u8]) -> Vec<vec2u> {
    var out: Vec<vec2u> = Vec::new()
    var i = 0
    let n = text.len()
    while i < n {
        while i < n && (text[i] == 32 || text[i] == 9 || text[i] == 10 || text[i] == 13) {
            i += 1
        }
        let s = i
        while i < n && !(text[i] == 32 || text[i] == 9 || text[i] == 10 || text[i] == 13) {
            i += 1
        }
        if i > s {
            out.push(vec2u(s, i))
        }
    }
    out
}

fn word(text: str, w: vec2u) -> borrow str {
    text.slice(w.x, w.y)
}

fn number(text: str, w: vec2u) -> Result<f32, ToolError> {
    match word(text, w).parse_f32() {
        Some(x) => Ok(x),
        None => Err(ToolError::new(f"not a number: {word(text, w)}")),
    }
}

fn parse(whole: String) -> Result<Bvh, ToolError> {
    let ws = words(whole.as_bytes())
    let text = whole.as_str()
    var bones: Vec<Bone> = Vec::new()
    var stack: Vec<u32> = Vec::new()
    var i = 0
    var channels_seen = 0
    var in_end = false
    while i < ws.len() {
        let w = word(text, ws[i])
        if w == "ROOT" || w == "JOINT" {
            let parent = if stack.len() > 0 { stack[stack.len() - 1] } else { NONE }
            bones.push(
                Bone {
                    name: word(text, ws[i + 1]).to_string(),
                    parent,
                    offset: vec3(0.0),
                    channels: Vec::new(),
                    first: 0,
                    end: vec3(0.0),
                    has_end: false,
                },
            )
            i += 2
        } else if w == "End" {
            in_end = true
            i += 2
        } else if w == "{" {
            if !in_end {
                stack.push(bones.len() - 1)
            }
            i += 1
        } else if w == "}" {
            if in_end {
                in_end = false
            } else {
                let _ = stack.pop()
            }
            i += 1
        } else if w == "OFFSET" {
            let v = vec3(
                number(text, ws[i + 1])?,
                number(text, ws[i + 2])?,
                number(text, ws[i + 3])?,
            )
            let b = bones.len() - 1
            if in_end {
                bones[b].end = v
                bones[b].has_end = true
            } else {
                bones[b].offset = v
            }
            i += 4
        } else if w == "CHANNELS" {
            let n = word(text, ws[i + 1]).parse_u32().unwrap_or(0)
            let b = bones.len() - 1
            bones[b].first = channels_seen
            for k in 0..n {
                let c = word(text, ws[i + 2 + k])
                let code = if c == "Xposition" { 0 } else if c == "Yposition" { 1 } else if c ==
                    "Zposition" {
                    2
                } else if c == "Xrotation" { 3 } else if c == "Yrotation" { 4 } else { 5 }
                bones[b].channels.push(code)
            }
            channels_seen += n
            i += 2 + n
        } else if w == "MOTION" {
            i += 1
            break
        } else {
            i += 1
        }
    }
    // "Frames:" n "Frame" "Time:" t, then the numbers.
    let frames = word(text, ws[i + 1]).parse_u32().unwrap_or(0)
    let frame_time = number(text, ws[i + 4])?
    i += 5
    var values: Vec<f32> = Vec::with_capacity(frames * channels_seen)
    while i < ws.len() && values.len() < frames * channels_seen {
        values.push(number(text, ws[i])?)
        i += 1
    }
    let got = values.len() / max(channels_seen, 1)
    Ok(Bvh { bones, frames: min(frames, got), frame_time, stride: channels_seen, values })
}

/// Each bone's place and turn in the capture's space in frame `f` (`world`), the capture's
/// units.
fn posed(b: Bvh, f: u32, places: mut Vec<vec3>, turns: mut Vec<Quat>) {
    places.clear()
    turns.clear()
    let deg = 3.14159265 / 180.0
    for k in 0..b.bones.len() {
        borrow bone = b.bones[k]
        var t = bone.offset
        var q = Quat::identity()
        for c in 0..bone.channels.len() {
            let v = b.values[f * b.stride + bone.first + c]
            let code = bone.channels[c]
            if code < 3 {
                t[code] = v
            } else {
                let axis = if code == 3 { vec3(1.0, 0.0, 0.0) } else if code == 4 {
                    vec3(0.0, 1.0, 0.0)
                } else { vec3(0.0, 0.0, 1.0) }
                q = q.mul(Quat::axis_angle(axis, v * deg))
            }
        }
        if bone.parent == NONE {
            places.push(t)
            turns.push(q)
        } else {
            let (pp, pq) = (places[bone.parent], turns[bone.parent])
            places.push(pp + pq.rotate(t))
            turns.push(pq.mul(q))
        }
    }
}

// ---- the map from a capture's bones to the body's segments ---------------------------------------

/// A capture bone that a segment follows: the bone's name, the segment, and what of it is aimed:
/// its turn (`TURN`), its place (`PLACE`, its joint where the bone's joint is), or both (`BOTH`: a
/// hand, a foot, the root).
struct Map: Clone {
    bone: String,
    segment: u32,
    aim: u32,
}

const TURN: u32 = 0
const PLACE: u32 = 1
const BOTH: u32 = 2

/// The body a clip goes onto: its name (the folder of its poses), its root, and the segments of
/// its left leg (the scale is the leg's length against the capture's).
struct Target: Copy {
    name: Text,
    pelvis: u32,
    thigh: u32,
    shank: u32,
    foot: u32,
    foot_right: u32,
}

fn target(body: str) -> Target {
    if body == "human" {
        Target {
            name: "human",
            pelvis: hs::PELVIS,
            thigh: hs::THIGH_LEFT,
            shank: hs::SHANK_LEFT,
            foot: hs::FOOT_LEFT,
            foot_right: hs::FOOT_RIGHT,
        }
    } else {
        Target {
            name: "creature",
            pelvis: cs::PELVIS,
            thigh: cs::THIGH_LEFT,
            shank: cs::SHIN_LEFT,
            foot: cs::FOOT_LEFT,
            foot_right: cs::FOOT_RIGHT,
        }
    }
}

/// What each capture format's bones are, for each body. 100STYLE's skeleton and MPI EMBM's are
/// the same (a spine of four, a collar each side, no fingers). On the human each bone of the
/// spine sets a level of it; its scapulae and fingers follow no bone (they hold their rest, as
/// the fit's `still` keeps a number no aim fixes).
fn maps(body: str, source: str) -> Vec<Map> {
    let m = |bone: str, segment: u32, aim: u32| Map { bone: bone.to_string(), segment, aim }
    var out: Vec<Map> = Vec::new()
    if source == "ceti" {
        // CeTI's skeleton (a Rokoko suit with gloves): three bones of spine, a neck and no head,
        // the clavicles, the arms, the hands and two bones a finger, the legs to the feet (no
        // toes). On the human its spine's bones set the lumbar's lower level and the thorax's
        // two; each finger's two bones its first two segments.
        if body != "human" {
            return out
        }
        out.push(m("Character1_Hips", hs::PELVIS, BOTH))
        out.push(m("Character1_Spine", hs::LUMBAR_LOW, TURN))
        out.push(m("Character1_Spine1", hs::THORAX_LOW, TURN))
        out.push(m("Character1_Spine2", hs::THORAX_HIGH, TURN))
        out.push(m("Character1_Neck", hs::NECK, TURN))
        let sides = [
            ("Left", hs::CLAVICLE_LEFT, hs::THIGH_LEFT, hs::FINGERS_LEFT),
            ("Right", hs::CLAVICLE_RIGHT, hs::THIGH_RIGHT, hs::FINGERS_RIGHT),
        ]
        for (side, c, t, f) in sides {
            out.push(m(f"Character1_{side}Shoulder".as_str(), c, TURN))
            out.push(m(f"Character1_{side}Arm".as_str(), c + 2, TURN))
            out.push(m(f"Character1_{side}ForeArm".as_str(), c + 3, PLACE))
            out.push(m(f"Character1_{side}Hand".as_str(), c + 4, BOTH))
            out.push(m(f"Character1_{side}HandThumb1".as_str(), f, TURN))
            out.push(m(f"Character1_{side}HandThumb2".as_str(), f + 1, TURN))
            out.push(m(f"Character1_{side}HandIndex1".as_str(), f + 3, TURN))
            out.push(m(f"Character1_{side}HandIndex2".as_str(), f + 4, TURN))
            out.push(m(f"Character1_{side}HandMiddle1".as_str(), f + 6, TURN))
            out.push(m(f"Character1_{side}HandMiddle2".as_str(), f + 7, TURN))
            out.push(m(f"Character1_{side}HandRing1".as_str(), f + 9, TURN))
            out.push(m(f"Character1_{side}HandRing2".as_str(), f + 10, TURN))
            out.push(m(f"Character1_{side}HandPinky1".as_str(), f + 12, TURN))
            out.push(m(f"Character1_{side}HandPinky2".as_str(), f + 13, TURN))
            out.push(m(f"Character1_{side}UpLeg".as_str(), t, TURN))
            out.push(m(f"Character1_{side}Leg".as_str(), t + 1, TURN))
            out.push(m(f"Character1_{side}Foot".as_str(), t + 2, BOTH))
        }
        return out
    }
    if source == "accad" {
        // ACCAD's skeleton (MotionBuilder's names, one for its three performers): three bones of
        // spine (the lower back, the waist, the chest to the neck), a neck and a head, the
        // shoulders, the arms, the hands (no fingers), the legs and the toes. Its rotations all 0
        // are no pose of a person (its bones' axes run along them): `calibration` gives each
        // bone's rest.
        if body != "human" {
            return out
        }
        out.push(m("Hips", hs::PELVIS, BOTH))
        out.push(m("ToSpine", hs::LUMBAR_LOW, TURN))
        out.push(m("Spine", hs::THORAX_LOW, TURN))
        out.push(m("Spine1", hs::THORAX_HIGH, TURN))
        out.push(m("Neck", hs::NECK, TURN))
        out.push(m("Head", hs::HEAD, TURN))
        let sides = [
            ("Left", hs::CLAVICLE_LEFT, hs::THIGH_LEFT),
            ("Right", hs::CLAVICLE_RIGHT, hs::THIGH_RIGHT),
        ]
        for (side, c, t) in sides {
            out.push(m(f"{side}Shoulder".as_str(), c, TURN))
            out.push(m(f"{side}Arm".as_str(), c + 2, TURN))
            out.push(m(f"{side}ForeArm".as_str(), c + 3, PLACE))
            out.push(m(f"{side}Hand".as_str(), c + 4, BOTH))
            out.push(m(f"{side}UpLeg".as_str(), t, TURN))
            out.push(m(f"{side}Leg".as_str(), t + 1, TURN))
            out.push(m(f"{side}Foot".as_str(), t + 2, BOTH))
            out.push(m(f"{side}ToeBase".as_str(), t + 3, BOTH))
        }
        return out
    }
    if source != "100style" && source != "embm" {
        return out
    }
    // A forearm is aimed by its place alone: its roll is its elbow's in our bodies, where the
    // capture turns it at the wrist, so the hand's turn sets it.
    if body == "human" {
        out.push(m("Hips", hs::PELVIS, BOTH))
        out.push(m("Chest", hs::LUMBAR_LOW, TURN))
        out.push(m("Chest2", hs::LUMBAR_HIGH, TURN))
        out.push(m("Chest3", hs::THORAX_LOW, TURN))
        out.push(m("Chest4", hs::THORAX_HIGH, TURN))
        out.push(m("Neck", hs::NECK, TURN))
        out.push(m("Head", hs::HEAD, TURN))
        out.push(m("LeftCollar", hs::CLAVICLE_LEFT, TURN))
        out.push(m("LeftShoulder", hs::UPPER_ARM_LEFT, TURN))
        out.push(m("LeftElbow", hs::FOREARM_LEFT, PLACE))
        out.push(m("LeftWrist", hs::HAND_LEFT, BOTH))
        out.push(m("RightCollar", hs::CLAVICLE_RIGHT, TURN))
        out.push(m("RightShoulder", hs::UPPER_ARM_RIGHT, TURN))
        out.push(m("RightElbow", hs::FOREARM_RIGHT, PLACE))
        out.push(m("RightWrist", hs::HAND_RIGHT, BOTH))
        out.push(m("LeftHip", hs::THIGH_LEFT, TURN))
        out.push(m("LeftKnee", hs::SHANK_LEFT, TURN))
        out.push(m("LeftAnkle", hs::FOOT_LEFT, BOTH))
        out.push(m("LeftToe", hs::TOES_LEFT, BOTH))
        out.push(m("RightHip", hs::THIGH_RIGHT, TURN))
        out.push(m("RightKnee", hs::SHANK_RIGHT, TURN))
        out.push(m("RightAnkle", hs::FOOT_RIGHT, BOTH))
        out.push(m("RightToe", hs::TOES_RIGHT, BOTH))
    } else {
        out.push(m("Hips", cs::PELVIS, BOTH))
        out.push(m("Chest", cs::SPINE, TURN))
        out.push(m("Chest2", cs::CHEST, TURN))
        out.push(m("Chest4", cs::UPPER_CHEST, TURN))
        out.push(m("Neck", cs::NECK, TURN))
        out.push(m("Head", cs::HEAD, TURN))
        out.push(m("LeftCollar", cs::COLLAR_LEFT, TURN))
        out.push(m("LeftShoulder", cs::UPPER_ARM_LEFT, TURN))
        out.push(m("LeftElbow", cs::FOREARM_LEFT, PLACE))
        out.push(m("LeftWrist", cs::HAND_LEFT, BOTH))
        out.push(m("RightCollar", cs::COLLAR_RIGHT, TURN))
        out.push(m("RightShoulder", cs::UPPER_ARM_RIGHT, TURN))
        out.push(m("RightElbow", cs::FOREARM_RIGHT, PLACE))
        out.push(m("RightWrist", cs::HAND_RIGHT, BOTH))
        out.push(m("LeftHip", cs::THIGH_LEFT, TURN))
        out.push(m("LeftKnee", cs::SHIN_LEFT, TURN))
        out.push(m("LeftAnkle", cs::FOOT_LEFT, BOTH))
        out.push(m("LeftToe", cs::TOES_LEFT, BOTH))
        out.push(m("RightHip", cs::THIGH_RIGHT, TURN))
        out.push(m("RightKnee", cs::SHIN_RIGHT, TURN))
        out.push(m("RightAnkle", cs::FOOT_RIGHT, BOTH))
        out.push(m("RightToe", cs::TOES_RIGHT, BOTH))
    }
    out
}

/// The capture's bone that segment `seg` follows in `ms`.
/// The creature at rest (its numbers 0).
fn creature_rest() -> Pose<cs::FREEDOM> {
    world::creature::BODY.rest()
}

fn bone_of(ms: [Map], seg: u32) -> String {
    for m in ms {
        if m.segment == seg {
            return m.bone.clone()
        }
    }
    String::new()
}

/// The units of a source's capture, in metres.
fn unit(source: str) -> f32 {
    if source == "100style" || source == "embm" || source == "ceti" || source == "accad" { 0.01 } else {
        1.0
    }
}

/// The credit a source asks for (docs/citations.md).
fn credit(source: str) -> Text {
    if source == "100style" { "The 100STYLE Dataset - Ian Mason (CC BY 4.0)" } else if source ==
        "embm" {
        "MPI Emotional Body Motion Database, E. Volkova et al. 2014 (CC BY 4.0)"
    } else if source == "ceti" {
        "CeTI-Age-Kinematics, L. Pogrzeba et al., Sci. Data 12, 531, 2025 (CC BY 4.0)"
    } else if source == "accad" {
        "Open Motion Project by ACCAD/The Ohio State University is licensed under a Creative Commons Attribution 3.0 Unported License"
    } else { "" }
}

fn bone_index(b: Bvh, name: str) -> u32 {
    for i in 0..b.bones.len() {
        if b.bones[i].name.as_str() == name {
            return i
        }
    }
    NONE
}

/// The shortest turn that takes unit direction `a` to `b`.
fn shortest_arc(a: vec3, b: vec3) -> Quat {
    let d = dot(a, b)
    if d > 0.999999 {
        return Quat::identity()
    }
    if d < -0.999999 {
        let side = if abs(a.x) < 0.9 { vec3(1.0, 0.0, 0.0) } else { vec3(0.0, 1.0, 0.0) }
        return Quat::axis_angle(cross(a, side), 3.14159265)
    }
    Quat { v: normalize(vec4(cross(a, b), 1.0 + d)) }
}

// ---- one clip ---------------------------------------------------------------------------------

/// What a clip came to.
struct Done: Clone {
    clip: String,
    frames: u32,
    seconds: f32,
    joint_mm: f32,
    out_of_range: u32,
    worst_range: f32,
    failed: String,
}

/// A clip to import: the source, the file (under the capture root), the clip's name, and its
/// first and last frames (the capture's clean part), or all of it.
struct Clip: Clone {
    body: String,
    steps: u32,
    source: String,
    file: String,
    name: String,
    first: u32,
    last: u32,
}

fn import(c: take Clip) -> Done {
    match import_or(c.clone()) {
        Ok(d) => d,
        Err(e) => Done {
            clip: c.name.clone(),
            frames: 0,
            seconds: 0.0,
            joint_mm: 0.0,
            out_of_range: 0,
            worst_range: 0.0,
            failed: e.message().to_string(),
        },
    }
}

fn import_or(c: Clip) -> Result<Done, ToolError> {
    if c.body.as_str() == "human" {
        import_into(hs::BODY, hs::REST, hs::PARTS, target("human"), c)
    } else {
        import_into(world::creature::BODY, creature_rest(), cs::PARTS, target("creature"), c)
    }
}

/// A point of a sole: its segment and where it is in the segment's frame.
struct Sole: Copy {
    segment: u32,
    point: vec3,
}

/// The middle of the densest `width` of `xs`: the value they keep most (a foot's height in its
/// stance).
fn densest(xs: Vec<f32>, width: f32) -> f32 {
    if xs.is_empty() {
        return 0.0
    }
    var v = xs.clone()
    v.sort_by(|a, b| a < b)
    var best = 0
    var count = 0
    var j = 0
    for i in 0..v.len() {
        while v[i] - v[j] > width {
            j += 1
        }
        if i + 1 - j > count {
            count = i + 1 - j
            best = j
        }
    }
    v[best + count / 2]
}

/// How much a sole below the floor weighs (per m): against a foot's turn aimed at 0.3 per rad, a
/// millimetre under weighs as a third of a degree, so the floor wins.
const SOLE: f32 = 10.0

fn import_into<const S: u32, const D: u32, const P: u32>(
    body: Body<S>,
    rest: Pose<D>,
    parts: [Cone; P],
    t: Target,
    c: Clip,
) -> Result<Done, ToolError> {
    // A clip already imported (its record written last) is kept.
    if files::stat(f"out/{t.name}/{c.source}/{c.name}.json").wait().is_ok() {
        return Ok(
            Done {
                clip: c.name.clone(),
                frames: 0,
                seconds: 0.0,
                joint_mm: 0.0,
                out_of_range: 0,
                worst_range: 0.0,
                failed: String::new(),
            },
        )
    }
    let bytes = read_all(f"capture/{c.file}")?
    let digest = hex(sha256(bytes))
    let Some(text) = String::from_utf8(take bytes) else { return Err(ToolError::new("not UTF-8")) }
    let bvh = parse(take text)?
    let ms = maps(t.name, c.source.as_str())
    var idx: Vec<u32> = Vec::new()
    for m in ms {
        let i = bone_index(bvh, m.bone.as_str())
        if i == NONE {
            return Err(ToolError::new(f"no bone {m.bone}"))
        }
        idx.push(i)
    }
    // The body at rest: each segment's turn and place there.
    let at0 = body.places(rest)
    // Each mapped bone's rest against the segment's: the turn that takes the segment's direction
    // at rest (its joint to its tip) to the bone's (its joint to its first child's, the capture's
    // rotations all 0), where they rest in different poses. A capture at rest in a T-pose
    // (100STYLE) needs none; one with its arms by its sides (MPI EMBM) turns each arm down.
    // A source whose rotations all 0 are no pose (`calibration`): each bone at rest as it is in
    // its performer's frame of standing, that frame's heading kept (from the right hip to the
    // left, the body's +x), and the bone's direction there what its segment's is compared with.
    var calib_turns: Vec<Quat> = Vec::new()
    var heading = Quat::identity()
    if let Some(cf) = calibration(c.source.as_str(), c.name.as_str()) {
        let cb = read_all(f"capture/{cf}")?
        let Some(ct) = String::from_utf8(take cb) else { return Err(ToolError::new("calibration: not UTF-8")) }
        let cal = parse(take ct)?
        var cal_places: Vec<vec3> = Vec::new()
        posed(cal, 0, mut cal_places, mut calib_turns)
        let lh = bone_index(cal, "LeftUpLeg")
        let rh = bone_index(cal, "RightUpLeg")
        if lh == NONE || rh == NONE {
            return Err(ToolError::new("calibration: no hips"))
        }
        let left = cal_places[lh] - cal_places[rh]
        let yaw = atan2(-left.z, left.x)
        heading = Quat::axis_angle(vec3(0.0, 1.0, 0.0), yaw)
    }
    var rest_turn: Vec<Quat> = Vec::new()
    for i in 0..ms.len() {
        let b = idx[i]
        var cap = vec3(0.0)
        for k in b + 1..bvh.bones.len() {
            if bvh.bones[k].parent == b && length(cap) == 0.0 {
                cap = bvh.bones[k].offset
            }
        }
        if length(cap) == 0.0 && bvh.bones[b].has_end {
            cap = bvh.bones[b].end
        }
        if calib_turns.len() > 0 {
            // The bone's direction in the frame of standing, in that frame's heading.
            cap = heading.inverse().rotate(calib_turns[b].rotate(cap))
        }
        let seg = ms[i].segment
        let ours = at0[seg].q.rotate(body.segments[seg].tip)
        // Only a bone that rests in another pose than its segment (more than 20 degrees apart, as
        // an arm by the side against an arm held out 30 degrees or a T-pose's): a smaller
        // difference is one of proportions, which the places of the hands and the feet carry (on
        // the creature, turning by such differences took 100STYLE's mapped joints from 30 to 37 mm
        // off; its threshold was 45 degrees, which the human's arms, 30 degrees out at rest,
        // would pass under).
        let apart = if length(cap) < 1.0e-6 || length(ours) < 1.0e-6 { 0.0 } else {
            acos(clamp(dot(normalize(ours), normalize(cap)), -1.0, 1.0))
        }
        let turn = if seg == t.pelvis || apart < 0.349066 {
            Quat::identity()
        } else { shortest_arc(normalize(ours), normalize(cap)) }
        // Calibrated: the bone's turn in the frame of standing undone, that frame's heading kept.
        rest_turn.push(if calib_turns.len() > 0 { calib_turns[b].inverse().mul(heading).mul(turn) } else { turn })
    }
    // The scale: the body's leg (hip to knee to ankle) against the capture's, at rest.
    let u = unit(c.source.as_str())
    let (knee, ankle) = (
        bone_index(bvh, bone_of(ms, t.shank).as_str()),
        bone_index(bvh, bone_of(ms, t.foot).as_str()),
    )
    let leg_cap = (length(bvh.bones[knee].offset) + length(bvh.bones[ankle].offset)) * u
    let leg_ours = length(at0[t.shank].t - at0[t.thigh].t) + length(at0[t.foot].t - at0[t.shank].t)
    let s = leg_ours / leg_cap
    let k = sqrt(s)
    // The frames: the clean part, at `RATE` a second of the body's time.
    let first = min(c.first, bvh.frames - 1)
    let last = min(c.last, bvh.frames - 1)
    let span_cap = f32(last - first) * bvh.frame_time
    let n = u32(floor(span_cap * k * RATE)) + 1
    // The capture's floor: the height its ankles keep most (in stance), frame by frame of the
    // scaled capture.
    let (ankle_l, ankle_r) = (
        bone_index(bvh, bone_of(ms, t.foot).as_str()),
        bone_index(bvh, bone_of(ms, t.foot_right).as_str()),
    )
    var heights: Vec<f32> = Vec::with_capacity(2 * n)
    var pl: Vec<vec3> = Vec::new()
    var tu: Vec<Quat> = Vec::new()
    for j in 0..n {
        let t_cap = f32(j) / RATE / k
        let f = min(first + u32(round(t_cap / bvh.frame_time)), last)
        posed(bvh, f, mut pl, mut tu)
        heights.push(pl[ankle_l].y * (u * s))
        heights.push(pl[ankle_r].y * (u * s))
    }
    let stance_a = densest(heights, 0.01)
    // Every height of the capture moves by `lift`, so its ankle in stance stands where the body's
    // ankle stands on the floor. The body's soles: each part's lowest points at rest within 6 mm
    // of its lowest, on a foot or its toes.
    let lift = at0[t.foot].t.y - stance_a
    let up = vec3(0.0, 1.0, 0.0)
    var lowest = 1.0e9
    for cone in parts {
        let (a, b) = cone.placed(at0)
        lowest = min(lowest, min(a.y - cone.ra, b.y - cone.rb))
    }
    var soles: Vec<Sole> = Vec::new()
    let feet = [t.foot, t.foot_right]
    for cone in parts {
        for e in 0..2 {
            let end = if e == 0 { cone.a } else { cone.b }
            let r = if e == 0 { cone.ra } else { cone.rb }
            let at = at0[end.on].apply(end.at) - up * r
            if at.y > lowest + 0.006 {
                continue
            }
            for side in 0..2 {
                let foot = feet[side]
                if end.on == foot || body.segments[end.on].joint.parent == foot {
                    soles.push(Sole { segment: end.on, point: at0[end.on].inverse().apply(at) })
                }
            }
        }
    }
    var w = Writer::new()
    w.write_u8(87)
    w.write_u8(80)
    w.write_u8(79)
    w.write_u8(83)
    w.write_u32(1)
    w.write_u32(D)
    w.write_u32(n)
    w.write_u32(bitcast_u32(RATE))
    var places: Vec<vec3> = Vec::new()
    var turns: Vec<Quat> = Vec::new()
    var prev = rest
    var dist_sum = 0.0
    var dist_n = 0.0
    var by_bone: Vec<f32> = Vec::filled(ms.len(), 0.0)
    var out_of_range = 0
    var worst_range = -1.0e9
    for j in 0..n {
        // The capture's frame at this moment of the body's time.
        let t_cap = f32(j) / RATE / k
        let f = min(first + u32(round(t_cap / bvh.frame_time)), last)
        posed(bvh, f, mut places, mut turns)
        var aims: Vec<Aim> = Vec::new()
        for i in 0..ms.len() {
            borrow m = ms[i]
            let b = idx[i]
            // Turned from its rest as the capture's bone turned from its own (both at rest in
            // a T-pose, facing +z, +x their left).
            let q = turns[b].mul(rest_turn[i]).mul(at0[m.segment].q)
            let p = places[b] * (u * s) + vec3(0.0, lift, 0.0)
            if m.aim == BOTH {
                let place = if m.segment == t.pelvis { 2.0 } else { 1.0 }
                aims.push(aim_frame(m.segment, Frame { q, t: p }, place, 0.3))
            } else if m.aim == PLACE {
                aims.push(aim_point(m.segment, vec3(0.0), p, 1.0))
            } else {
                aims.push(
                    Aim {
                        segment: m.segment,
                        point: vec3(0.0),
                        at: p,
                        place: 0.0,
                        turn: q,
                        turned: 0.3,
                        axes: vec3(1.0),
                        floor: false,
                    },
                )
            }
        }
        // Each sole held above the floor (the ground holds a foot up, never down): where the
        // body's foot is longer than the capture's, its toes would dip under the floor at
        // push-off.
        for sole in soles {
            aims.push(aim_floor(sole.segment, sole.point, 0.0, SOLE))
        }
        if j == 0 {
            // The pelvis's first turn as its aim will have it (its rest's turn too: a calibrated
            // source's is no turn of the body).
            prev.root = Frame {
                q: turns[idx[0]].mul(rest_turn[0]).mul(at0[t.pelvis].q),
                t: places[idx[0]] * (u * s) + vec3(0.0, lift, 0.0),
            }
        }
        let fr = fit(body, aims, prev, if j == 0 { FIRST_STEPS } else {
            c.steps
        }, still: if j == 0 { 0.001 } else { STILL })
        prev = fr.pose
        // How far each mapped joint is from the scaled capture's.
        let at = body.places(prev)
        for i in 0..ms.len() {
            let e = length(at[ms[i].segment].t - places[idx[i]] * (u * s) - vec3(0.0, lift, 0.0))
            dist_sum += e
            dist_n += 1.0
            by_bone[i] += e
        }
        var worst = -1.0e9
        for sg in 1..S {
            worst = max(worst, body.segments[sg].joint.range(body.numbers(prev, sg)))
        }
        if worst > 0.01 {
            out_of_range += 1
        }
        worst_range = max(worst_range, worst)
        let r = prev.root
        for x in [r.t.x, r.t.y, r.t.z, r.q.v.x, r.q.v.y, r.q.v.z, r.q.v.w] {
            w.write_u32(bitcast_u32(x))
        }
        for x in prev.q {
            w.write_u32(bitcast_u32(x))
        }
    }
    let dir = f"out/{t.name}/{c.source}"
    write_all(f"{dir}/{c.name}.pose", take w.into_bytes())?
    let mm = 1000.0 * dist_sum / max(dist_n, 1.0)
    // Each mapped bone's mean distance (mm): where a skeleton's proportions or rest differ.
    var bones_mm = String::new()
    for i in 0..ms.len() {
        let v = 1000.0 * by_bone[i] / f32(max(n, 1))
        bones_mm.push_str(if i == 0 { f"\"{ms[i].bone}\": {v}" } else { f", \"{ms[i].bone}\": {v}" })
    }
    let record = f"{{\"source\": \"{c.source}\", \"file\": \"{c.file}\", \"sha256\": \"{digest}\", \"credit\": \"{credit(c.source.as_str())}\", \"body\": \"{t.name}\", \"capture_frames\": [{first}, {last}], \"frames\": {n}, \"rate\": {RATE}, \"seconds\": {f32(n) / RATE}, \"length_scale\": {s}, \"time_scale\": {k}, \"mean_joint_mm\": {mm}, \"joint_mm_by_bone\": {{{bones_mm}}}, \"frames_out_of_range\": {out_of_range}, \"worst_range\": {worst_range}}}\n"
    write_all(f"{dir}/{c.name}.json", Vec::from(record.as_bytes()))?
    Ok(
        Done {
            clip: c.name.clone(),
            frames: n,
            seconds: f32(n) / RATE,
            joint_mm: mm,
            out_of_range,
            worst_range,
            failed: String::new(),
        },
    )
}

// ---- the sources ------------------------------------------------------------------------------

/// CeTI's clips: each BVH file of `ceti/bvh` (its participant, session, task and run), but its
/// first frame (the suit's T-pose).
fn clips_ceti() -> Result<Vec<Clip>, ToolError> {
    var out: Vec<Clip> = Vec::new()
    var names: Vec<String> = Vec::new()
    for e in files::list("capture/ceti/bvh").wait()? {
        if e.name.as_str().ends_with(".bvh") {
            names.push(e.name.clone())
        }
    }
    names.sort_by(|a, b| a.as_str() < b.as_str())
    for n in names {
        // `sub-d02_ses-01_task-w01_tracksys-rokokosmartsuit1_run-01_motion.bvh` is
        // `sub-d02_ses-01_task-w01_run-01`.
        let full = n.as_str()
        let cut = match full.find("_tracksys-") {
            Some(i) => i,
            None => full.len() - 4,
        }
        let run_at = match full.find("_run-") {
            Some(i) => i,
            None => full.len() - 4,
        }
        let base = f"{full.slice(0, cut)}{full.slice(run_at, run_at + 7)}"
        out.push(
            Clip {
                body: String::new(),
                steps: STEPS,
                source: String::from("ceti"),
                file: f"ceti/bvh/{n}",
                name: base,
                first: 1,
                last: 4294967295,
            },
        )
    }
    Ok(out)
}

/// ACCAD's clips: each BVH file of its three performers (`accad/bvh`, from the Open Motion
/// Project's archives), whole. (Three other files of the archive, of another skeleton, are left out.)
fn clips_accad() -> Result<Vec<Clip>, ToolError> {
    var out: Vec<Clip> = Vec::new()
    var names: Vec<String> = Vec::new()
    for e in files::list("capture/accad/bvh").wait()? {
        let n = e.name.as_str()
        if n.ends_with(".bvh") && (n.starts_with("Female1_") || n.starts_with("Male1_") || n.starts_with("Male2_")) {
            names.push(e.name.clone())
        }
    }
    names.sort_by(|a, b| a.as_str() < b.as_str())
    for n in names {
        out.push(
            Clip {
                body: String::new(),
                steps: STEPS,
                source: String::from("accad"),
                file: f"accad/bvh/{n}",
                name: String::from(n.as_str().slice(0, n.len() - 4)),
                first: 0,
                last: 4294967295,
            },
        )
    }
    Ok(out)
}

/// The frame a source's skeleton is at rest in, where its rotations all 0 are no pose of a person
/// (ACCAD's): each performer's first frame of standing (`Female1_A01_Stand`, `Male1_A1_Stand`,
/// `Male2_A1_Stand`), standing upright with the arms down.
fn calibration(source: str, name: str) -> Option<String> {
    if source != "accad" {
        return None
    }
    if name.starts_with("Female1_") {
        Some(String::from("accad/bvh/Female1_A01_Stand.bvh"))
    } else if name.starts_with("Male1_") {
        Some(String::from("accad/bvh/Male1_A1_Stand.bvh"))
    } else if name.starts_with("Male2_") {
        Some(String::from("accad/bvh/Male2_A1_Stand.bvh"))
    } else { None }
}

/// 100STYLE's clips: each style's takes, each cut to its clean frames (`Frame_Cuts.csv`).
fn clips_100style() -> Result<Vec<Clip>, ToolError> {
    let cuts_bytes = read_all("capture/100style/100STYLE/Frame_Cuts.csv")?
    let Some(cuts) = String::from_utf8(take cuts_bytes) else { return Err(ToolError::new("cuts")) }
    let text = cuts.as_str()
    let takes = ["BR", "BW", "FR", "FW", "ID", "SR", "SW", "TR1", "TR2", "TR3"]
    var out: Vec<Clip> = Vec::new()
    let lines = text.lines()
    for li in 1..lines.len() {
        let (l0, l1) = lines[li]
        let line = text.slice(l0, l1)
        let cells = line.split(",")
        if cells.len() < 21 {
            continue
        }
        let (c0, c1) = cells[0]
        let style = line.slice(c0, c1).to_string()
        for t in 0..10 {
            let (a0, a1) = cells[1 + 2 * t]
            let (b0, b1) = cells[2 + 2 * t]
            let a = line.slice(a0, a1)
            let b = line.slice(b0, b1).trim()
            let (Some(first), Some(last)) = (a.parse_u32(), b.parse_u32()) else { continue }
            out.push(
                Clip {
                    body: String::new(),
                    steps: STEPS,
                    source: String::from("100style"),
                    file: f"100style/100STYLE/{style}/{style}_{takes[t]}.bvh",
                    name: f"{style}_{takes[t]}",
                    first,
                    last,
                },
            )
        }
    }
    Ok(out)
}

/// MPI EMBM's clips: each BVH file of `embm/bvh` but its first frames (the archive as figshare serves it has no
/// directory at its end; its local entries were read in order: 288 of its clips).
fn clips_embm() -> Result<Vec<Clip>, ToolError> {
    var out: Vec<Clip> = Vec::new()
    var names: Vec<String> = Vec::new()
    for e in files::list("capture/embm/bvh").wait()? {
        if e.name.as_str().ends_with(".bvh") {
            names.push(e.name.clone())
        }
    }
    names.sort_by(|a, b| a.as_str() < b.as_str())
    for n in names {
        let base = n.as_str().slice(0, n.len() - 4).to_string()
        out.push(
            Clip {
                body: String::new(),
                steps: STEPS,
                source: String::from("embm"),
                file: f"embm/bvh/{n}",
                name: base,
                // Each file's first frame is a rest pose at the origin, not the movement.
                first: 3,
                last: 4294967295,
            },
        )
    }
    Ok(out)
}

/// Low-passes a clip in time: each number, the root's place and its turn (averaged on the sphere)
/// by a Gaussian of `SMOOTH` frames' spread, both ways, so no lag. The fit of each frame leaves a
/// jitter from frame to frame that inverse dynamics differentiates twice (playing a clip faster,
/// which resamples it, lowered its root residual); the laboratory filters markers at some 6 Hz
/// before it does the same (D. A. Winter). Each joint stays in its range: a mean of numbers in a
/// convex range is in it. Rewrites the clip's poses.
const SMOOTH: f32 = 0.8

fn smoothed_clip(c: take Clip) -> Done {
    if c.body.as_str() == "human" { smoothed_into(hs::REST, c) } else {
        smoothed_into(creature_rest(), c)
    }
}

fn smoothed_into<const D: u32>(_rest: Pose<D>, c: Clip) -> Done {
    var done = Done {
        clip: c.name.clone(),
        frames: 0,
        seconds: 0.0,
        joint_mm: 0.0,
        out_of_range: 0,
        worst_range: 0.0,
        failed: String::new(),
    }
    let path = f"out/{c.body}/{c.source}/{c.name}"
    let Ok(bytes) = read_all(f"{path}.pose") else {
        done.failed = String::from("no poses")
        return done
    }
    let head = 20
    let row = 4 * (7 + D)
    let n = (bytes.len() - head) / row
    var vals: Vec<f32> = Vec::with_capacity(n * (7 + D))
    for f in 0..n {
        for k in 0..7 + D {
            vals.push(bitcast_f32(le_word(bytes, head + f * row + 4 * k)))
        }
    }
    let w = 7 + D
    var out = bytes.clone()
    let h = u32(3.0 * SMOOTH) + 1
    for f in 0..n {
        let a = if f > h { f - h } else { 0 }
        let b = min(f + h, n - 1)
        var sum: Vec<f32> = Vec::filled(w, 0.0)
        var wsum = 0.0
        // The root's turns, each made to agree in sign with this frame's.
        let q0 = vec4(vals[f * w + 3], vals[f * w + 4], vals[f * w + 5], vals[f * w + 6])
        var qsum = vec4(0.0)
        for g in a..b + 1 {
            let d = (f32(g) - f32(f)) / SMOOTH
            let k = exp(-0.5 * d * d)
            wsum += k
            for i in 0..w {
                sum[i] += vals[g * w + i] * k
            }
            var q = vec4(vals[g * w + 3], vals[g * w + 4], vals[g * w + 5], vals[g * w + 6])
            if dot(q, q0) < 0.0 {
                q = -q
            }
            qsum += q * k
        }
        let qn = normalize(qsum)
        for i in 0..w {
            var v = sum[i] / wsum
            if i >= 3 && i < 7 {
                v = qn[i - 3]
            }
            let u = bitcast_u32(v)
            let o = head + f * row + 4 * i
            out[o] = u8(u & 255)
            out[o + 1] = u8((u >> 8) & 255)
            out[o + 2] = u8((u >> 16) & 255)
            out[o + 3] = u8(u >> 24)
        }
    }
    match write_all(f"{path}.pose", out) {
        Ok(_) => {},
        Err(e) => done.failed = e.message().to_string(),
    }
    done.frames = n
    done
}

/// The little-endian u32 at byte `i` of `b`.
fn le_word(b: [u8], i: u32) -> u32 {
    u32(b[i]) | (u32(b[i + 1]) << 8) | (u32(b[i + 2]) << 16) | (u32(b[i + 3]) << 24)
}

/// Stands a clip on the ground (again: the shift it finds on a grounded clip is 0): its lowest
/// point each frame (each part's ends less their radii) is found, and the height those points keep
/// most (the middle of the densest 10 mm of them: a foot flat in its stance) is put at y = 0 by
/// moving the root. A capture's foot joints stand some centimetres over its floor, and scaled to a
/// body whose feet are thicker or thinner they leave the body over the ground or in it. The 5th
/// percentile, used first, put the brief dips of a toe at push-off on the floor: on 2026-11-26 the
/// human's stance foot then hovered 35 to 40 mm in 100STYLE's walk (the creature's 22 mm on average,
/// 2026-11-25), and the judge found the walk in flight 69% of its frames. Rewrites the clip's
/// poses, and its record with the shift.
fn grounded(c: take Clip) -> Done {
    if c.body.as_str() == "human" {
        grounded_into(hs::BODY, hs::REST, hs::PARTS, c)
    } else {
        grounded_into(world::creature::BODY, creature_rest(), cs::PARTS, c)
    }
}

fn grounded_into<const S: u32, const D: u32, const P: u32>(
    body: Body<S>,
    rest: Pose<D>,
    parts: [Cone; P],
    c: Clip,
) -> Done {
    var done = Done {
        clip: c.name.clone(),
        frames: 0,
        seconds: 0.0,
        joint_mm: 0.0,
        out_of_range: 0,
        worst_range: 0.0,
        failed: String::new(),
    }
    let path = f"out/{c.body}/{c.source}/{c.name}"
    let Ok(bytes) = read_all(f"{path}.pose") else {
        done.failed = String::from("no poses")
        return done
    }
    // The header: "WPOS", then u32s version, numbers, frames, then f32 rate: 20 bytes.
    let head = 20
    let n = (bytes.len() - head) / (4 * (7 + D))
    var lows: Vec<f32> = Vec::with_capacity(n)
    let row = 4 * (7 + D)
    for f in 0..n {
        let o = head + f * row
        var x = [0.0; 7]
        for k in 0..7 {
            x[k] = bitcast_f32(le_word(bytes, o + 4 * k))
        }
        var p = rest
        p.root = Frame { q: Quat { v: vec4(x[3], x[4], x[5], x[6]) }, t: vec3(x[0], x[1], x[2]) }
        for k in 0..D {
            p.q[k] = bitcast_f32(le_word(bytes, o + 28 + 4 * k))
        }
        let at = body.places(p)
        var low = 1.0e9
        for cone in parts {
            let (a, b) = cone.placed(at)
            low = min(low, min(a.y - cone.ra, b.y - cone.rb))
        }
        lows.push(low)
    }
    var sorted = lows.clone()
    sorted.sort_by(|a, b| a < b)
    // The densest 10 mm: the window of sorted lows that holds the most frames.
    var best = 0
    var best_count = 0
    var j = 0
    for i in 0..n {
        while sorted[i] - sorted[j] > 0.01 {
            j += 1
        }
        if i + 1 - j > best_count {
            best_count = i + 1 - j
            best = j
        }
    }
    let shift = sorted[best + best_count / 2]
    var out = bytes.clone()
    for f in 0..n {
        let o = head + f * row + 4
        let y = bitcast_f32(le_word(bytes, o)) - shift
        let u = bitcast_u32(y)
        out[o] = u8(u & 255)
        out[o + 1] = u8((u >> 8) & 255)
        out[o + 2] = u8((u >> 16) & 255)
        out[o + 3] = u8(u >> 24)
    }
    match write_all(f"{path}.pose", out) {
        Ok(_) => {},
        Err(e) => {
            done.failed = e.message().to_string()
            return done
        },
    }
    // The record: its last line, with the shift.
    if let Ok(rb) = read_all(f"{path}.json") {
        if let Some(text) = String::from_utf8(take rb) {
            let t = text.as_str().trim()
            // An earlier shift's field (and what follows it) is replaced.
            let cut = match t.find(", \"ground_shift\"") {
                Some(i) => i,
                None => t.len() - 1,
            }
            let rec = f"{t.slice(0, cut)}, \"ground_shift\": {shift}}}\n"
            let _ = write_all(f"{path}.json", Vec::from(rec.as_bytes()))
        }
    }
    done.frames = n
    done.joint_mm = shift * 1000.0
    done
}

pub fn tool() -> u32 {
    let a = args()
    if a.len() < 2 || (a[0].as_str() != "human" && a[0].as_str() != "creature") {
        print(
            "usage: capture BODY SOURCE [FIRST COUNT [STEPS [ground | smooth]]] (BODY: human or creature)",
        )
        return 2
    }
    let body = a[0].as_str()
    let source = a[1].as_str()
    let Ok(all_clips) = (if source == "100style" { clips_100style() } else if source == "embm" {
        clips_embm()
    } else if source == "ceti" {
        clips_ceti()
    } else if source == "accad" {
        clips_accad()
    } else {
        Err(ToolError::new("unknown source"))
    }) else {
        print(f"capture: no clips of {source}")
        return 1
    }
    let from = if a.len() > 2 { a[2].as_str().parse_u32().unwrap_or(0) } else { 0 }
    let count = if a.len() > 3 { a[3].as_str().parse_u32().unwrap_or(100000) } else { 100000 }
    let steps = if a.len() > 4 { a[4].as_str().parse_u32().unwrap_or(STEPS) } else { STEPS }
    var chosen: Vec<Clip> = Vec::new()
    for i in from..min(from + count, all_clips.len()) {
        var c = all_clips[i].clone()
        c.steps = steps
        c.body = String::from(body)
        chosen.push(take c)
    }
    print(f"capture: {source}: {chosen.len()} of {all_clips.len()} clips")
    if a.len() > 5 && a[5].as_str() == "smooth" {
        let done = all(take chosen, smoothed_clip)
        var failed = 0
        for d in done {
            if d.failed.len() > 0 {
                failed += 1
                print(f"capture: {d.clip}: FAILED {d.failed}")
            }
        }
        print(f"capture: smoothed, {failed} failed")
        return 0
    }
    if a.len() > 5 && a[5].as_str() == "ground" {
        let count = chosen.len()
        let done = all(take chosen, grounded)
        var most = 0.0
        var sum = 0.0
        for d in done {
            if d.failed.len() > 0 {
                print(f"capture: {d.clip}: FAILED {d.failed}")
            }
            most = max(most, abs(d.joint_mm))
            sum += d.joint_mm
        }
        print(
            f"capture: grounded, the mean shift {sum / f32(max(count, 1))} mm down, the most {most} mm",
        )
        return 0
    }
    let done = all(take chosen, import)
    var secs = 0.0
    var failed = 0
    for d in done {
        if d.failed.len() > 0 {
            failed += 1
            print(f"capture: {d.clip}: FAILED {d.failed}")
        } else {
            secs += d.seconds
            print(
                f"capture: {d.clip}: {d.frames} frames ({d.seconds} s), joints {d.joint_mm} mm from the capture's, {d.out_of_range} frames out of range (worst {d.worst_range} rad)",
            )
        }
    }
    print(f"capture: {source}: {secs / 3600.0} h imported, {failed} failed")
    if failed > 0 { 1 } else { 0 }
}
