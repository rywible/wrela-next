#!/bin/bash
# Smooths and grounds again the imported clips of a list (SOURCE/CLIP a line), WORKERS at a time:
# after a change to the capture's smoothing or grounding, without fitting them again.
#
#     tools/movement/resmooth-clips LIST [WORKERS]
set -euo pipefail
cd "$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
one() {
  local src="${1%%/*}" name="${1#*/}"
  [[ -f ".movement/poses/human/$1.pose" ]] || return 0
  local c=(tools/wrela tool tools/movement/capture --read capture=.movement/capture --write out=.movement/poses -- human "$src" 0 100000 4)
  "${c[@]}" smooth "only=$name" >/dev/null 2>&1
  "${c[@]}" ground "only=$name" >/dev/null 2>&1
}
export -f one
grep -v '^#' "$1" | grep . | xargs -P "${2:-10}" -I{} bash -c 'one "$@"' _ {}
