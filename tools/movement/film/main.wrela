// A film of a movement (docs/plans/bodies-and-movement.md, phase 3 step 9): a body seen from the
// side and from the front, side by side, each frame a PNG, with the judge's contacts (red: a point
// that carries weight) and its root residual (a blue line from the centre of mass, a metre for the
// body's weight) drawn. It opens no window: each picture is marched on the CPU through the body's
// own field (`world::human` or `world::creature`), lit by one light and the sky.
//
//     tools/wrela tool tools/movement/film --read poses=.movement/poses --write out=.movement/film \
//         -- [human | creature] SOURCE/CLIP [FROM SECONDS EVERY]
//
// The pictures: `out/SOURCE/CLIP/NNNN.png`, 512 by 256, every EVERY-th frame (default 2) of
// SECONDS (default 4) from FROM (default 0).

use clips::clips::load
use engine::body::body::Pose
use engine::body::joint::Frame
use engine::judge::movement::{GRAVITY, TOUCH, judge_into}
use std::collections::Vec
use std::field::{Field, Surface, half_space}
use std::io::print
use std::quat::Quat
use std::tool::args
use std::tool::blob
use std::tool::blob::Data
use std::tool::files
use std::tool::image
use bodies::bodies::Def
use world::creature::creature

/// Each panel's size (pixels) and how many metres it shows across.
const SIZE: u32 = 256
const SPAN: f32 = 1.6

/// One panel: the field from `from` (a direction) toward `centre`, orthographic.
fn panel<S: Field<engine::matter::substance::Substance>>(
    field: S,
    centre: vec3,
    from: vec3,
    rgba: mut Vec<u8>,
    x0: u32,
    width: u32,
    marks: [vec3],
    mark_colour: [vec3],
    lines: [vec3],
    span: f32,
    size: u32,
) {
    let w = normalize(from)
    let r = normalize(cross(vec3(0.0, 1.0, 0.0), w))
    let u = cross(w, r)
    let light = normalize(vec3(0.4, 0.8, 0.45))
    let step = max(field.lipschitz(1.0e30), 1.0)
    for y in 0..size {
        for x in 0..size {
            let px = ((f32(x) + 0.5) / f32(size) - 0.5) * span
            let py = (0.5 - (f32(y) + 0.5) / f32(size)) * span
            let o = centre + r * px + u * py + w * (2.0 * span)
            var p = o
            var colour = vec3(0.86, 0.9, 0.95) - vec3(0.25) * (py / span)
            // The ground under the body: a darker floor below y = 0.
            var hit = false
            var t = 0.0
            for _ in 0..300 {
                let d = field.distance(p)
                if d < 2.0e-4 {
                    hit = true
                    break
                }
                p = p - w * (d / step)
                t += d / step
                if t > 4.0 * span {
                    break
                }
            }
            if hit {
                let n = field.gradient(p)
                let nn = if length(n) > 1.0e-6 { normalize(n) } else { w }
                let albedo = field.channels(p).albedo
                colour = albedo * (0.25 + 0.75 * max(dot(nn, light), 0.0)) +
                    albedo * 0.2 * max(nn.y, 0.0)
            } else if centre.y + py < 0.0 {
                colour = vec3(0.45, 0.43, 0.4)
            }
            let i = 4 * (x0 + x + width * y)
            rgba[i] = u8(clamp(sqrt(colour.x), 0.0, 1.0) * 255.0)
            rgba[i + 1] = u8(clamp(sqrt(colour.y), 0.0, 1.0) * 255.0)
            rgba[i + 2] = u8(clamp(sqrt(colour.z), 0.0, 1.0) * 255.0)
            rgba[i + 3] = 255
        }
    }
    // The marks, each a dot of 5 pixels.
    let to_px = |q: vec3| -> vec2 {
        let d = q - centre
        vec2((dot(d, r) / span + 0.5) * f32(size), (0.5 - dot(d, u) / span) * f32(size))
    }
    for k in 0..marks.len() {
        let c = to_px(marks[k])
        for dy in 0..5 {
            for dx in 0..5 {
                let (xx, yy) = (i32(c.x) + i32(dx) - 2, i32(c.y) + i32(dy) - 2)
                if xx >= 0 && yy >= 0 && xx < i32(size) && yy < i32(size) {
                    let i = 4 * (x0 + u32(xx) + width * u32(yy))
                    rgba[i] = u8(mark_colour[k].x * 255.0)
                    rgba[i + 1] = u8(mark_colour[k].y * 255.0)
                    rgba[i + 2] = u8(mark_colour[k].z * 255.0)
                }
            }
        }
    }
    // The lines, in pairs of ends: 200 dots along each.
    var k = 0
    while k + 1 < lines.len() {
        let (a, b) = (to_px(lines[k]), to_px(lines[k + 1]))
        for s in 0..200 {
            let c = mix(a, b, vec2(f32(s) / 199.0))
            let (xx, yy) = (i32(c.x), i32(c.y))
            if xx >= 0 && yy >= 0 && xx < i32(size) && yy < i32(size) {
                let i = 4 * (x0 + u32(xx) + width * u32(yy))
                rgba[i] = 30
                rgba[i + 1] = 60
                rgba[i + 2] = 230
            }
        }
        k += 2
    }
}

/// Writes `rgba` (`width` by `height`) as `out/NAME.png`.
fn write_png(rgba: Vec<u8>, width: u32, height: u32, name: str) -> u32 {
    let Ok(b) = blob::new().wait() else { return 1 }
    var at_b = 0
    while at_b < rgba.len() {
        let end = min(at_b + 524288, rgba.len())
        var part: Vec<u8> = Vec::new()
        for i in at_b..end {
            part.push(rgba[i])
        }
        let _ = blob::append(b, part).wait()
        at_b = end
    }
    let img = image::Image { width, height, rgba: Data::Blob(b) }
    let code = match image::encode_png(img).wait() {
        Ok(Data::Bytes(bytes)) => {
            let _ = files::write(f"out/{name}.png", bytes).wait()
            0
        },
        Ok(Data::Blob(pb)) => {
            let _ = files::write_blob(f"out/{name}.png", pb).wait()
            0
        },
        Err(e) => {
            print(f"film: {e.message()}")
            1
        },
    }
    let _ = blob::release(b).wait()
    code
}

/// Sets segment `s`'s numbers of the human's pose `p` to `q` (radians), put into its range.
fn set_human(p: mut Pose<world::human::FREEDOM>, s: u32, q: vec3) {
    let b = world::human::BODY
    b.set_numbers(mut p, s, b.segments[s].joint.clamped(q))
}

/// The human (`world::human`) at rest and in a pose that bends each kind of joint (the spine
/// forward and turned, an arm forward and one out, an elbow and a knee bent, a hip raised, a hand
/// closed): `out/human/rest.png` and `out/human/bent.png`, each from the side and the front.
fn human_poses() -> u32 {
    let rest = world::human::REST
    var bent = rest
    let d = 0.0174533
    for s in [world::human::LUMBAR_LOW, world::human::LUMBAR_HIGH, world::human::THORAX_LOW] {
        set_human(mut bent, s, vec3(8.0 * d, 0.0, 6.0 * d))
    }
    set_human(mut bent, world::human::NECK, vec3(10.0 * d, 0.0, 25.0 * d))
    set_human(mut bent, world::human::UPPER_ARM_LEFT, vec3(90.0 * d, 0.0, 0.0))
    set_human(mut bent, world::human::FOREARM_LEFT, vec3(90.0 * d, 60.0 * d, 0.0))
    set_human(mut bent, world::human::UPPER_ARM_RIGHT, vec3(0.0, -60.0 * d, 0.0))
    set_human(mut bent, world::human::THIGH_RIGHT, vec3(60.0 * d, 0.0, 0.0))
    set_human(mut bent, world::human::SHANK_RIGHT, vec3(70.0 * d, 0.0, 0.0))
    for k in 0..15 {
        let s = world::human::FINGERS_LEFT + k
        set_human(mut bent, s, vec3(if k < 3 { 30.0 * d } else { 75.0 * d }, 0.0, 0.0))
    }
    let size = 2 * SIZE
    let width = 2 * size
    var failed = 0
    for (name, pose) in [("rest", rest), ("bent", bent)] {
        let body = world::human::human(pose)
        let at = world::human::BODY.places(pose)
        let centre = vec3(0.0, 0.95, at[0].t.z)
        var rgba: Vec<u8> = Vec::filled(width * size * 4, 0)
        let none: [vec3; 0] = []
        panel(body, centre, vec3(1.0, 0.0, 0.0), mut rgba, 0, width, none, none, none, 2.0, size)
        panel(body, centre, vec3(0.0, 0.0, 1.0), mut rgba, size, width, none, none, none, 2.0, size)
        failed += write_png(rgba, width, size, f"human/{name}")
    }
    print(f"film: the human at rest and bent, {failed} failed")
    failed
}

pub fn tool() -> u32 {
    let all_args = args()
    // The body: the first argument, if it names one (`human` alone draws the human at rest and
    // bent).
    if all_args.len() == 1 && all_args[0].as_str() == "human" {
        return human_poses()
    }
    let named = all_args.len() > 0 &&
        (all_args[0].as_str() == "human" || all_args[0].as_str() == "creature")
    let body = if named { all_args[0].clone() } else { String::from("creature") }
    var a: Vec<String> = Vec::new()
    for i in (if named { 1 } else { 0 })..all_args.len() {
        a.push(all_args[i].clone())
    }
    if a.len() < 1 {
        print("usage: film [human | creature] SOURCE/CLIP [FROM SECONDS EVERY] | film human")
        return 2
    }
    let name = a[0].as_str()
    let from = if a.len() > 1 { a[1].as_str().parse_f32().unwrap_or(0.0) } else { 0.0 }
    let seconds = if a.len() > 2 { a[2].as_str().parse_f32().unwrap_or(4.0) } else { 4.0 }
    let every = if a.len() > 3 { a[3].as_str().parse_u32().unwrap_or(2) } else { 2 }
    if body.as_str() == "human" {
        return film(bodies::bodies::human(), world::human::human, name, from, seconds, every)
    }
    film(bodies::bodies::creature(), creature, name, from, seconds, every)
}

/// The film of clip `name` of body `def`, its flesh drawn by `draw`: `out/NAME/NNNN.png`.
fn film<const S: u32, const D: u32, const P: u32, F: Field<engine::matter::substance::Substance>>(
    def: Def<S, D, P>,
    draw: fn(Pose<D>) -> F,
    name: str,
    from: f32,
    seconds: f32,
    every: u32,
) -> u32 {
    let Ok(c) = load::<D>("poses", def.name, name) else {
        print(f"film: no poses of {name}")
        return 1
    }
    let (rate, all) = (c.rate, take c.poses)
    let first = min(u32(from * rate), all.len() - 1)
    let last = min(first + u32(seconds * rate) + 2, all.len())
    var poses: Vec<Pose<D>> = Vec::new()
    for f in first..last {
        poses.push(all[f])
    }
    // The panel's span and the height of its centre: by the body's height at rest (its highest
    // segment's origin), so a tall body and a short one are framed alike.
    let at_rest = def.body.places(def.rest)
    var top = 0.0
    for s in 0..S {
        top = max(top, at_rest[s].t.y)
    }
    let span = max(SPAN, 1.3 * top)
    // The judge's contacts and forces, a frame at a time (its detail: each segment's contact
    // force), and the residual: what the movement needs less what the contacts give.
    var forces: Vec<vec3> = Vec::new()
    var detail: Vec<vec3> = Vec::new()
    let ground = half_space(vec3(0.0, 1.0, 0.0), 0.0)
    let _ = judge_into(
        def.body,
        def.masses,
        def.parts,
        ground,
        poses.clone(),
        rate,
        mut forces,
        mut detail,
        true,
    )
    var mass = 0.0
    for m in def.masses {
        mass += m.mass
    }
    let weight = mass * length(GRAVITY)
    let width = 2 * SIZE
    var written = 0
    var f = 1
    while f + 1 < poses.len() {
        let at = def.body.places(poses[f])
        let body = draw(poses[f])
        // The centre of mass and its acceleration (the residual: m (a - g) less the contacts).
        var com = vec3(0.0)
        var acc = vec3(0.0)
        let (pa, pc) = (def.body.places(poses[f - 1]), def.body.places(poses[f + 1]))
        for s in 0..S {
            let m = def.masses[s]
            com += at[s].apply(m.centre) * m.mass
            acc += (pa[s].apply(m.centre) - 2.0 * at[s].apply(m.centre) + pc[s].apply(m.centre)) *
                (rate * rate * m.mass)
        }
        com = com / mass
        let need = acc - GRAVITY * mass
        let residual = need - forces[f - 1]
        // The contact points within reach of the ground, red where their segment carries weight.
        var marks: Vec<vec3> = Vec::new()
        var colours: Vec<vec3> = Vec::new()
        for c in def.parts {
            let (x, y) = c.placed(at)
            for k in 0..3 {
                let u = f32(k) * 0.5
                let centre = mix(x, y, vec3(u))
                let rr = mix(c.ra, c.rb, u)
                if centre.y - rr < TOUCH {
                    let seg = def.body.nearest_on(at, c.span, centre)
                    let carried = length(detail[(f - 1) * 3 * S + S + seg]) > 0.05 * weight
                    marks.push(centre - vec3(0.0, rr, 0.0))
                    colours.push(if carried { vec3(0.9, 0.1, 0.1) } else { vec3(0.95, 0.8, 0.1) })
                }
            }
        }
        let lines = [com, com + residual / weight]
        var rgba: Vec<u8> = Vec::filled(width * SIZE * 4, 0)
        let centre = vec3(com.x, 0.55 * span / SPAN, com.z)
        panel(body, centre, vec3(1.0, 0.0, 0.0), mut rgba, 0, width, marks, colours, lines, span, SIZE)
        panel(body, centre, vec3(0.0, 0.0, 1.0), mut rgba, SIZE, width, marks, colours, lines, span, SIZE)
        if f % every == 0 {
            if write_png(rgba, width, SIZE, f"{name}/{written:04}") != 0 {
                return 1
            }
            written += 1
        }
        f += 1
    }
    print(f"film: {written} pictures of {name}")
    0
}
