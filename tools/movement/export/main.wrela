// The export of a body to the simulator (docs/plans/bodies-and-movement.md, phase 4 step 1): a
// MuJoCo model of a body written from its declaration, and each imported clip as the simulator's
// states. No person and no script writes the model by hand.
//
//     tools/wrela tool tools/movement/export --read poses=.movement/poses \
//         --read split=tools/movement/split --write out=.movement/sim -- [BODY] [keep-weld] [SET ...]
//
// BODY is `human` or `creature` (the default: `tools/movement/bodies`). The model
// (`out/BODY.xml`):
// - each segment a body whose frame is the segment's at rest (its numbers 0), its mass, centre
//   of mass and inertia the engine's (the body's `MASSES`), written as they are: no
//   inertia from shapes. A segment the engine weighs at 0 (a collarbone, which carries no part)
//   gets `LEAST` kg, as the simulator can't move a body with no mass;
// - a segment that no exported clip moves (`moving`: a finger, where no capture has fingers) welded
//   to its parent: no joint;
// - each joint's numbers as the simulator's joints, in the segment's body: a hinge about x; a
//   universal joint a hinge about x then one about y, as the engine turns it; a ball joint three
//   hinges, its turn written as three turns exactly, the middle one about the axis of its
//   narrowest range (`ball_order`); the root a free joint;
// - each part a capsule of its smaller radius on the segment of its first end, and where its two
//   radii differ a sphere at its larger end and one at its middle (the points the judge measures
//   its depth at), colliding with the floor alone;
// - each hinge driven by a position servo whose force is held to the joint's strength
//   (`forcerange`), its stiffness `STIFF` times the strength a radian.
//
// A clip's states (`out/refs/CLIP.ref`): "WREF", then u32s version (1), the model's qpos size,
// segments, frames, then f32 frames a second; then each frame's qpos (the root's place, its turn
// as w, x, y, z, then each hinge's angle in the model's order: the segments depth first) and each
// segment's place (3) and
// turn (w, x, y, z) in the world, from `Body::places`: what the tracker is rewarded to follow.

use clips::clips::{load, pose_bytes, read_all, write_all}
use std::json::{TOP, parse}
use std::zlib::inflate
use engine::body::body::{Body, Pose}
use engine::body::joint::{Frame, Joint, Kind, numbers_of, turn}
use engine::body::mass::Mass
use std::collections::Vec
use std::io::print
use std::quat::Quat
use std::serialize::{Reader, Writer}
use std::tool::{ToolError, args}
use std::tool::blob
use std::tool::files
use bodies::bodies::Def

/// The least mass a body of the simulator can move with (kg), and its inertia's (kg m²).
const LEAST: f32 = 0.001
const LEAST_INERTIA: f32 = 0.000001

/// A servo's damping (N m s/rad), this many seconds times the joint's strength: a muscle's force
/// falls with its speed of shortening (A. V. Hill, 1938: its force-velocity relation, whose slope at
/// rest is (1 + a) / a of its strength over its fastest speed; a / F0 is 0.15 to 0.25 in muscles
/// measured, a joint's fastest 12 to 18 rad/s: 0.3 to 0.5 s). The tracker's servos damp toward the
/// clip's speed (`track.py --feed-forward`), so this brakes only a departure from the clip. The
/// damping of 0.04 of the stiffness (0.1 s of the strength) until 2026-11-27 was an eighth of
/// critical for a knee that holds the body up, and the tracker's loop rang (two thirds of the
/// knees' speed's power at 4.5 to 7.5 Hz, `b3`); at 0.2 s the ringing went lower (the body bounced
/// on its legs at 3 to 4.5 Hz, the root's height's speed above 2 Hz twice the clip's, `b8`); at
/// 0.4 s the same net, untrained for it, moved its joints 0.87 to 1.29 times as fast as its clips
/// above 2 Hz (1.48 to 1.63 at 0.2).
const MUSCLE_DAMPING: f32 = 0.4
/// A servo's stiffness: this many times the joint's strength per radian.
const STIFF: f32 = 2.5

/// Minimum share of the body's total mass a segment's subtree must carry to stay articulated in
/// the simulator (0.06%: on a 73 kg human, 44 g — keeps toes at 57 g and hands at 400 g, while
/// welding 3–19 g finger phalanges whose whole-finger subtrees are <= 35 g and otherwise add 40
/// high-frequency DOFs with negligible effect on whole-body balance and contact).
const DYNAMIC_SHARE: f32 = 0.0006

/// The floor's contact margin (m): the simulator's contact is soft, and a body that stands sinks
/// into it (1.6 mm at the median with the time constant of 20 ms; a quarter of that at
/// `CONTACT_TIME`); a contact that pushes from this far holds a part that carries weight at the
/// floor's surface, as the engine's rigid flesh and the judge's depth have it.
const FLOOR_MARGIN: f32 = 0.0005
/// The contacts' time constant (s, MuJoCo's `solref`): at least two steps. The default 20 ms let a
/// light segment that carries the body's weight (a toe, 57 g: a contact stiff in acceleration is
/// soft in force on a light body) sink 6 mm in a walk and 11 mm in a run on average (`p4h-12`'s
/// tracker, 2026-11-27); 10 ms at a step of 1/240 s, 0.8 and 1.7 mm.
const CONTACT_TIME: f32 = 0.01
/// The fewest frames of a filtered clip kept (1 s at 30 a second): the solver's windows are 16.
const LEAST_FRAMES: u32 = 30

/// The model's step (s): 8 to a frame of the poses at 30 a second (the tracker takes as many as
/// a frame holds), short enough for the contacts' `CONTACT_TIME`.
const STEP: f32 = 0.004166667

fn v3(v: vec3) -> String {
    f"{v.x} {v.y} {v.z}"
}

/// A quaternion as MuJoCo writes one: w, x, y, z.
fn wxyz(q: Quat) -> String {
    f"{q.v.w} {q.v.x} {q.v.y} {q.v.z}"
}

/// The order of a ball joint's three hinges: the axes (0 x, 1 y, 2 z) of its first, middle and
/// last. Three turns written so have one turn they can't tell apart, where the middle one is a
/// quarter turn: the middle is the axis of the joint's narrowest range (most often its twist), so
/// that turn is outside what the joint can do.
fn ball_order(j: Joint) -> vec3u {
    // A ball joint's numbers: the swing about x (`q.x`), about z (`q.y`), the twist about y (`q.z`).
    let wide = vec3(
        max(abs(j.lo.x), abs(j.hi.x)),
        max(abs(j.lo.z), abs(j.hi.z)),
        max(abs(j.lo.y), abs(j.hi.y)),
    )
    let middle = if wide.y <= wide.x && wide.y <= wide.z { 1 } else if wide.x <= wide.z { 0 } else {
        2
    }
    let (first, last) = if middle == 0 { (2, 1) } else if middle == 1 { (0, 2) } else { (0, 1) }
    vec3u(first, middle, last)
}

/// Turn `r` as three turns about axes `o.x`, then `o.y`, then `o.z` (each in the frame the one
/// before left): r = R_i(a) R_j(b) R_k(c).
pub fn euler(r: Quat, o: vec3u) -> vec3 {
    let m = r.to_mat3()
    // Row r, column c of the matrix is m[c][r].
    let at = |row: u32, col: u32| m[col][row]
    let (i, j, k) = (o.x, o.y, o.z)
    let even = (i == 0 && j == 1) || (i == 1 && j == 2) || (i == 2 && j == 0)
    let sgn = if even { 1.0 } else { -1.0 }
    let b = asin(clamp(sgn * at(i, k), -1.0, 1.0))
    let a = atan2(-sgn * at(j, k), at(k, k))
    let c = atan2(-sgn * at(i, j), at(i, i))
    vec3(a, b, c)
}

fn axis(i: u32) -> vec3 {
    if i == 0 { vec3(1.0, 0.0, 0.0) } else if i == 1 { vec3(0.0, 1.0, 0.0) } else {
        vec3(0.0, 0.0, 1.0)
    }
}

/// Which of a ball joint's numbers' ranges an axis's hinge takes: x the swing's `x`, z its `y`,
/// y the twist `z`.
fn number_of_axis(i: u32) -> u32 {
    if i == 0 { 0 } else if i == 2 { 1 } else { 2 }
}

/// The simulator's hinges for segment `s`'s joint: how many.
fn hinges(kind: Kind) -> u32 {
    match kind {
        Kind::Fixed => 0,
        Kind::Hinge => 1,
        Kind::Universal => 2,
        Kind::Ball => 3,
    }
}

/// Hinge `h` of joint `j`: its axis, and which of the joint's numbers its range is.
fn hinge(j: Joint, h: u32) -> (vec3, u32) {
    if j.kind == Kind::Ball {
        let o = ball_order(j)
        let i = if h == 0 { o.x } else if h == 1 { o.y } else { o.z }
        (axis(i), number_of_axis(i))
    } else if h == 0 { (vec3(1.0, 0.0, 0.0), 0) } else { (vec3(0.0, 1.0, 0.0), 1) }
}

/// The angles of segment `s`'s hinges in `pose`.
fn angles<const S: u32, const D: u32>(b: Body<S>, pose: Pose<D>, s: u32) -> vec3 {
    let j = b.segments[s].joint
    let q = b.numbers(pose, s)
    if j.kind == Kind::Ball { euler(turn(Kind::Ball, q), ball_order(j)) } else { q }
}

/// The simulator's qpos of `pose`: the root's place, its turn as w, x, y, z, then each hinge's
/// angle in the model's order (the segments depth first).
fn qpos_of<const S: u32, const D: u32>(b: Body<S>, moves: [bool; S], p: Pose<D>) -> Vec<f32> {
    let (q, t) = (p.root.q.v, p.root.t)
    var out: Vec<f32> = Vec::new()
    for v in [t.x, t.y, t.z, q.w, q.x, q.y, q.z] {
        out.push(v)
    }
    for s in depth_first(b) {
        if s == 0 {
            continue
        }
        let a = angles(b, p, s)
        for h in 0..(if moves[s] { hinges(b.segments[s].joint.kind) } else { 0 }) {
            out.push(a[h])
        }
    }
    out
}

/// The pose whose qpos is `x` (the inverse of `qpos_of`): a welded segment at its rest.
fn pose_of_qpos<const S: u32, const D: u32>(
    b: Body<S>,
    rest: Pose<D>,
    moves: [bool; S],
    x: [f32],
) -> Pose<D> {
    var p = rest
    p.root = Frame { q: Quat { v: vec4(x[4], x[5], x[6], x[3]) }, t: vec3(x[0], x[1], x[2]) }
    var at = 7
    for s in depth_first(b) {
        if s == 0 || !moves[s] {
            continue
        }
        let j = b.segments[s].joint
        let n = hinges(j.kind)
        var a = vec3(0.0)
        for h in 0..n {
            a[h] = x[at + h]
        }
        at += n
        if j.kind == Kind::Ball {
            let o = ball_order(j)
            let r = Quat::axis_angle(axis(o.x), a.x)
                .mul(Quat::axis_angle(axis(o.y), a.y))
                .mul(Quat::axis_angle(axis(o.z), a.z))
            b.set_numbers(mut p, s, numbers_of(Kind::Ball, r))
        } else {
            b.set_numbers(mut p, s, a)
        }
    }
    p
}

/// The segments depth first (a segment's children each after the one before's whole subtree):
/// the order of the model's bodies, and so of its qpos.
fn depth_first<const S: u32>(b: Body<S>) -> Vec<u32> {
    var order: Vec<u32> = Vec::new()
    var todo: Vec<u32> = Vec::new()
    todo.push(0)
    while let Some(s) = todo.pop() {
        order.push(s)
        var k = S
        while k > 1 {
            k -= 1
            if b.segments[k].joint.parent == s {
                todo.push(k)
            }
        }
    }
    order
}

/// Tight Euler angle bounds `(lo, hi)` for each hinge of joint `j`: for a ball joint, samples
/// valid swing-twist poses inside the joint's anatomical range cone and transforms them through
/// `euler`, because swing-twist bounds do not contain the decomposed Euler angles (shoulders and
/// wrists previously violated MuJoCo limits on 22–48% of capture frames).
fn euler_bounds(j: Joint) -> (vec3, vec3) {
    if j.kind != Kind::Ball {
        return (j.lo, j.hi)
    }
    let o = ball_order(j)
    var lo = vec3(1.0e9)
    var hi = vec3(-1.0e9)
    for h in 0..3 {
        let (_, k) = hinge(j, h)
        lo[h] = j.lo[k]
        hi[h] = j.hi[k]
    }
    for ix in 0..5 {
        let ux = f32(ix) / 4.0
        let qx = mix(j.lo.x, j.hi.x, ux)
        for iy in 0..5 {
            let uy = f32(iy) / 4.0
            let qy = mix(j.lo.y, j.hi.y, uy)
            for iz in 0..5 {
                let uz = f32(iz) / 4.0
                let qz = mix(j.lo.z, j.hi.z, uz)
                let q = j.clamped(vec3(qx, qy, qz))
                let e = euler(turn(Kind::Ball, q), o)
                lo = min(lo, e)
                hi = max(hi, e)
            }
        }
    }
    (lo, hi)
}

/// Mass of segment `s` plus all of its descendants (kg).
fn subtree_masses<const S: u32>(b: Body<S>, masses: [Mass; S]) -> [f32; S] {
    var out = [0.0; S]
    for s in 0..S {
        out[s] = masses[s].mass
    }
    let order = depth_first(b)
    var i = order.len()
    while i > 0 {
        i -= 1
        let s = order[i]
        if s != 0 {
            let p = b.segments[s].joint.parent
            if p < S {
                out[p] += out[s]
            }
        }
    }
    out
}

fn model<const S: u32, const D: u32, const P: u32>(def: Def<S, D, P>, moves: [bool; S]) -> String {
    let b = def.body
    let at = b.places(def.rest)
    var x = String::new()
    x.push_str(f"<mujoco model=\"{def.name}\">\n")
    x.push_str(
        f"  <!-- Written by tools/movement/export from game/world/{def.name}.wrela: do not edit. -->\n",
    )
    x.push_str("  <compiler angle=\"radian\" autolimits=\"true\"/>\n")
    x.push_str(
        f"  <option timestep=\"{STEP}\" iterations=\"20\" solver=\"Newton\" integrator=\"implicitfast\" gravity=\"0 -9.81 0\"/>\n",
    )
    x.push_str("  <default>\n    <joint limited=\"true\"/>\n")
    x.push_str(
        f"    <geom contype=\"1\" conaffinity=\"0\" condim=\"3\" solref=\"{CONTACT_TIME} 1\" friction=\"1.0 0.02 0.01\" density=\"0\"/>\n  </default>\n",
    )
    x.push_str("  <worldbody>\n")
    x.push_str(
        f"    <geom name=\"floor\" type=\"plane\" size=\"0 0 1\" zaxis=\"0 1 0\" contype=\"0\" conaffinity=\"1\" margin=\"{FLOOR_MARGIN}\"/>\n",
    )
    // Each segment's body, nested under its parent's.
    let order = depth_first(b)
    var open: Vec<u32> = Vec::new()
    var actuators = String::new()
    for s in order {
        let j = b.segments[s].joint
        // Close the bodies that are not this one's parent.
        while open.len() > 0 && open[open.len() - 1] != j.parent {
            let _ = open.pop()
            x.push_str(f"{indent(open.len() + 2)}</body>\n")
        }
        let ind = indent(open.len() + 2)
        let f = if s == 0 { at[0] } else { j.at }
        x.push_str(f"{ind}<body name=\"s{s}\" pos=\"{v3(f.t)}\" quat=\"{wxyz(f.q)}\">\n")
        if s == 0 {
            x.push_str(f"{ind}  <freejoint name=\"root\"/>\n")
        }
        let m = def.masses[s]
        let i = m.inertia
        if m.mass > 0.0 {
            x.push_str(
                f"{ind}  <inertial pos=\"{v3(m.centre)}\" mass=\"{m.mass}\" fullinertia=\"{i[0].x} {i[1].y} {i[2].z} {i[1].x} {i[2].x} {i[2].y}\"/>\n",
            )
        } else {
            x.push_str(
                f"{ind}  <inertial pos=\"0 0 0\" mass=\"{LEAST}\" diaginertia=\"{LEAST_INERTIA} {LEAST_INERTIA} {LEAST_INERTIA}\"/>\n",
            )
        }
        let i_max = max(i[0].x, max(i[1].y, i[2].z))
        let (elo, ehi) = euler_bounds(j)
        for h in 0..(if moves[s] { hinges(j.kind) } else { 0 }) {
            let (ax, k) = hinge(j, h)
            let (lo, hi) = (elo[h], ehi[h])
            let st = max(j.strength[k], 0.1)
            let kp = STIFF * st
            // Explicit position-actuator stiffness at substep `STEP` requires effective inertia
            // I_eff >= 1.5 * kp * STEP^2 to prevent single-precision numerical blowups on light
            // distal segments. Its damping is a muscle's (`MUSCLE_DAMPING`).
            let arm = max(0.01, 1.5 * kp * STEP * STEP - i_max)
            let damp = clamp(0.01 * st, 0.05, 2.0)
            x.push_str(
                f"{ind}  <joint name=\"s{s}h{h}\" type=\"hinge\" axis=\"{v3(ax)}\" range=\"{lo} {hi}\" armature=\"{arm}\" damping=\"{damp}\"/>\n",
            )
            // The servo's target within the joint's range: at a limit the limit holds the joint
            // (a straight knee in stance). A target past it (0.6 rad, and the range 0.1 wider,
            // until 2026-11-27) let the servos press joints through their soft limits: `p4h-12`'s
            // filtered capture left the body's ranges by up to 0.25 rad (the ankles).
            actuators.push_str(
                f"    <position name=\"s{s}h{h}\" joint=\"s{s}h{h}\" kp=\"{kp}\" kv=\"{MUSCLE_DAMPING * st}\" forcerange=\"{-st} {st}\" ctrlrange=\"{lo} {hi}\"/>\n",
            )
        }
        // The parts whose first end is on this segment, in its frame: each a cone of two radii,
        // which the simulator has not, so a capsule of its smaller radius and a sphere at its
        // larger end and at its middle with the cone's radius there: the points the judge
        // measures each part's depth at. (A capsule of the radii's mean, until 2026-11-27, left
        // the heel's flesh 5.5 mm under the surface that carried it.) A welded segment's parts (a
        // finger's) do not collide: its parent's parts (the palm) touch for it.
        let collide = if moves[s] { "" } else { " contype=\"0\"" }
        for c in def.parts {
            if c.a.on == s {
                let a = c.a.at
                let bb = at[s].inverse().apply(at[c.b.on].apply(c.b.at))
                x.push_str(
                    f"{ind}  <geom type=\"capsule\" fromto=\"{v3(a)} {v3(bb)}\" size=\"{min(c.ra, c.rb)}\"{collide}/>\n",
                )
                if abs(c.ra - c.rb) > 0.001 {
                    let big = if c.ra > c.rb { a } else { bb }
                    x.push_str(
                        f"{ind}  <geom type=\"sphere\" pos=\"{v3(big)}\" size=\"{max(c.ra, c.rb)}\"{collide}/>\n",
                    )
                    x.push_str(
                        f"{ind}  <geom type=\"sphere\" pos=\"{v3(0.5 * (a + bb))}\" size=\"{0.5 * (c.ra + c.rb)}\"{collide}/>\n",
                    )
                }
            }
        }
        open.push(s)
    }
    while open.len() > 0 {
        let _ = open.pop()
        x.push_str(f"{indent(open.len() + 2)}</body>\n")
    }
    x.push_str("  </worldbody>\n  <actuator>\n")
    x.push_str(actuators.as_str())
    x.push_str("  </actuator>\n")
    // Each moving ball joint's range as the body holds it (`Joint::range`: an ellipse of its swing
    // numbers and an interval of its twist), which its three hinges' box of Euler angles contains
    // but does not equal: the tracker reads them (`ball_s{segment}`: lo then hi) to keep the body
    // in its ranges.
    x.push_str("  <custom>\n")
    for s in 1..S {
        let j = b.segments[s].joint
        if moves[s] && j.kind == Kind::Ball {
            x.push_str(
                f"    <numeric name=\"ball_s{s}\" data=\"{j.lo.x} {j.lo.y} {j.lo.z} {j.hi.x} {j.hi.y} {j.hi.z}\"/>\n",
            )
        }
    }
    x.push_str("  </custom>\n</mujoco>\n")
    x
}

fn indent(n: u32) -> String {
    var s = String::new()
    for _ in 0..n {
        s.push_str("  ")
    }
    s
}

fn next(r: mut Reader) -> u32 {
    match r.read_u32() {
        Ok(x) => x,
        Err(_) => 0,
    }
}

/// How many numbers the model's qpos holds: the root's 7 and each hinge of a segment that moves.
fn qpos_size<const S: u32>(b: Body<S>, moves: [bool; S]) -> u32 {
    var n = 7
    for s in 1..S {
        if moves[s] {
            n += hinges(b.segments[s].joint.kind)
        }
    }
    n
}

/// Which segments the clips `names` move and that carry enough subtree mass to matter to
/// whole-body dynamics (`DYNAMIC_SHARE` of total mass): a segment none of whose numbers move, or a
/// featherweight distal digit (< 0.06% of body mass), is welded to its parent in the simulator.
fn moving<const S: u32, const D: u32, const P: u32>(
    def: Def<S, D, P>,
    names: Vec<String>,
) -> [bool; S] {
    var out = [names.is_empty(); S]
    out[0] = true
    for name in names {
        let Ok(c) = load::<D>("poses", def.name, name.as_str()) else { continue }
        for p in c.poses {
            for s in 1..S {
                if out[s] {
                    continue
                }
                let q = def.body.numbers(p, s)
                let r = def.body.numbers(def.rest, s)
                if max(abs(q.x - r.x), max(abs(q.y - r.y), abs(q.z - r.z))) > 0.001 {
                    out[s] = true
                }
            }
        }
    }
    let sub = subtree_masses(def.body, def.masses)
    let cutoff = DYNAMIC_SHARE * sub[0]
    for s in 1..S {
        if out[s] && sub[s] < cutoff {
            out[s] = false
        }
    }
    out
}

/// One clip's states.
fn refs<const S: u32, const D: u32, const P: u32>(
    def: Def<S, D, P>,
    moves: [bool; S],
    name: str,
) -> Result<u32, ToolError> {
    let c = load::<D>("poses", def.name, name)?
    if bodies::bodies::seated(def, c.poses.clone(), c.rate) {
        return Err(ToolError::new("seated: left out (no seat in the simulator)"))
    }
    let (n, rate) = (c.poses.len(), c.rate)
    let b = def.body
    var w = Writer::new()
    for c in [87, 82, 69, 70] {
        w.write_u8(c)
    }
    w.write_u32(1)
    w.write_u32(qpos_size(b, moves))
    w.write_u32(S)
    w.write_u32(n)
    w.write_u32(bitcast_u32(rate))
    for p in c.poses {
        for v in qpos_of(b, moves, p) {
            w.write_u32(bitcast_u32(v))
        }
        let at = b.places(p)
        for s in 0..S {
            let f = at[s]
            for v in [f.t.x, f.t.y, f.t.z, f.q.v.w, f.q.v.x, f.q.v.y, f.q.v.z] {
                w.write_u32(bitcast_u32(v))
            }
        }
    }
    write_all(f"out/refs/{name}.ref", take w.into_bytes())?
    Ok(n)
}

pub fn tool() -> u32 {
    let a = args()
    if a.len() > 0 && a[0].as_str() == "human" {
        return export(bodies::bodies::human(), a)
    }
    export(bodies::bodies::creature(), a)
}

fn export<const S: u32, const D: u32, const P: u32>(def: Def<S, D, P>, a: Vec<String>) -> u32 {
    for x in a.clone() {
        if x.as_str() == "unfilter" {
            // `unfilter [LEAST]`: the fewest frames of a clip kept (`LEAST_FRAMES` if not given).
            var least = LEAST_FRAMES
            for y in a.clone() {
                if let Some(n) = y.as_str().parse_u32() {
                    least = n
                }
            }
            return match unfilter(def, least) {
                Ok(_) => 0,
                Err(e) => {
                    print(f"export: unfilter: {e.message()}")
                    1
                },
            }
        }
        if x.as_str() == "inverse" {
            return inverse(def, a)
        }
    }
    // The clips of the sets named.
    var names: Vec<String> = Vec::new()
    var keep = false
    for set_name in a {
        if set_name.as_str() == "human" || set_name.as_str() == "creature" {
            continue
        }
        if set_name.as_str() == "keep-weld" {
            keep = true
            continue
        }
        let Ok(bytes) = files::read(f"split/{set_name}.txt").wait() else { continue }
        let Some(text) = String::from_utf8(take bytes) else { continue }
        let t = text.as_str()
        for (x, y) in t.lines() {
            let line = t.slice(x, y).trim()
            if line.len() > 0 && !line.starts_with("#") {
                names.push(line.to_string())
            }
        }
    }
    // The segments that move: from these clips, or (`keep-weld`) as the last export wrote them, so
    // another set's states fit the model a tracker trained on (the solver's movements, phase 5
    // step 12).
    var moves = moving(def, names.clone())
    if keep {
        if let Ok(bytes) = files::read(f"out/{def.name}_moves.txt").wait() {
            for s in 1..S {
                if s < bytes.len() {
                    moves[s] = bytes[s] == 49
                }
            }
        }
    }
    var flags: Vec<u8> = Vec::new()
    for s in 0..S {
        flags.push(if moves[s] { 49 } else { 48 })
    }
    let _ = files::write(f"out/{def.name}_moves.txt", flags).wait()
    var welded = 0
    for s in 1..S {
        if !moves[s] {
            welded += 1
        }
    }
    let xml = model(def, moves)
    match write_all(f"out/{def.name}.xml", Vec::from(xml.as_bytes())) {
        Ok(_) => print(
            f"export: out/{def.name}.xml, qpos {qpos_size(def.body, moves)}, {welded} segments that no clip moves welded",
        ),
        Err(e) => {
            print(f"export: {e.message()}")
            return 1
        },
    }
    // The engine's masses beside the model's, for the comparison (phase 4 step 2).
    var masses = String::from("segment mass cx cy cz ixx iyy izz ixy ixz iyz\n")
    for s in 0..S {
        let m: Mass = def.masses[s]
        let i = m.inertia
        masses.push_str(
            f"{s} {m.mass} {m.centre.x} {m.centre.y} {m.centre.z} {i[0].x} {i[1].y} {i[2].z} {i[1].x} {i[2].x} {i[2].y}\n",
        )
    }
    let _ = write_all(f"out/{def.name}_masses.txt", Vec::from(masses.as_bytes()))
    var clips = 0
    var frames = 0
    for line in names {
        match refs(def, moves, line.as_str()) {
            Ok(n) => {
                clips += 1
                frames += n
            },
            Err(e) => print(f"export: {line}: {e.message()}"),
        }
    }
    print(f"export: {clips} clips, {frames} frames")
    0
}

/// The segments the last export moved (`out/BODY_moves.txt`, under the root `sim` for the
/// commands that write elsewhere).
fn moved<const S: u32, const D: u32, const P: u32>(def: Def<S, D, P>, root: str) -> [bool; S] {
    var moves = [true; S]
    if let Ok(bytes) = files::read(f"{root}/{def.name}_moves.txt").wait() {
        for s in 1..S {
            if s < bytes.len() {
                moves[s] = bytes[s] == 49
            }
        }
    }
    moves
}

/// The check of `pose_of_qpos` (`-- BODY inverse SET ...`, `--read sim=`, the export's folder):
/// each frame of the sets' clips written as qpos and read back, the segments' places of the two
/// poses compared. A segment the model welds is compared at its rest in both.
fn inverse<const S: u32, const D: u32, const P: u32>(def: Def<S, D, P>, a: Vec<String>) -> u32 {
    let b = def.body
    let moves = moved(def, "sim")
    var worst = 0.0
    var worst_turn = 0.0
    var frames = 0
    for set_name in a {
        let Ok(names) = clips::clips::set(set_name.as_str()) else { continue }
        for name in names {
            let Ok(c) = load::<D>("poses", def.name, name.as_str()) else { continue }
            for p in c.poses {
                var q = p
                for s in 1..S {
                    if !moves[s] {
                        b.set_numbers(mut q, s, b.numbers(def.rest, s))
                    }
                }
                let x = qpos_of(b, moves, q)
                let back: Pose<D> = pose_of_qpos(b, def.rest, moves, x)
                let (u, v) = (b.places(q), b.places(back))
                for s in 0..S {
                    worst = max(worst, length(u[s].t - v[s].t))
                    // The turn between the two: twice the asin of its vector part's length.
                    let r = u[s].q.inverse().mul(v[s].q)
                    worst_turn = max(worst_turn, 2.0 * asin(min(length(r.v.xyz), 1.0)))
                }
                frames += 1
            }
        }
    }
    print(f"export: inverse: {frames} frames, the segments' places within {worst * 1000.0} mm and {worst_turn * 1000.0} mrad")
    if frames > 0 && worst < 0.0001 && worst_turn < 0.001 { 0 } else { 1 }
}

/// The filtered capture (phase 4 step 8: `filtered/filtered.bin`, which tools/movement/track.py
/// writes: "WFLT", a u32 length, a JSON head of each clip's name, set, whether it was followed and
/// its frames, then zlib's compression of each frame's qpos, f32, clip after clip) as pose files
/// under a root of poses (`out/BODY/CLIP.pose`, `--write out=.movement/poses-filtered`), each
/// clip's frames up to its fall (a clip of fewer than `LEAST_FRAMES` left out); a segment the
/// model welded is at its rest. Its `--read sim=` is the export whose model the tracker moved.
fn unfilter<const S: u32, const D: u32, const P: u32>(
    def: Def<S, D, P>,
    least: u32,
) -> Result<u32, ToolError> {
    let moves = moved(def, "sim")
    let bytes = read_all("filtered/filtered.bin")?
    if bytes.len() < 8 || bytes[0] != 87 || bytes[1] != 70 || bytes[2] != 76 || bytes[3] != 84 {
        return Err(ToolError::new("not a filtered capture"))
    }
    let n = u32(bytes[4]) | (u32(bytes[5]) << 8) | (u32(bytes[6]) << 16) | (u32(bytes[7]) << 24)
    var head: Vec<u8> = Vec::with_capacity(n)
    for i in 8..(8 + n) {
        head.push(bytes[i])
    }
    let Some(text) = String::from_utf8(take head) else { return Err(ToolError::new("head not UTF-8")) }
    let Some(doc) = parse(text.as_str()) else { return Err(ToolError::new("head not JSON")) }
    let nq = u32(doc.num(doc.get(TOP, "nq").unwrap()).unwrap())
    let rate = f32(doc.num(doc.get(TOP, "rate").unwrap()).unwrap())
    if nq != qpos_size(def.body, moves) {
        return Err(ToolError::new(f"qpos {nq}, the model's {qpos_size(def.body, moves)}"))
    }
    var packed: Vec<u8> = Vec::with_capacity(bytes.len() - 8 - n)
    for i in (8 + n)..bytes.len() {
        packed.push(bytes[i])
    }
    let Some(raw) = inflate(packed) else { return Err(ToolError::new("not zlib")) }
    let list = doc.get(TOP, "clips").unwrap()
    var at = 0
    var written = 0
    var kept = 0
    var total = 0
    var cut = 0
    var x: Vec<f32> = Vec::with_capacity(nq)
    for i in 0..doc.count(list) {
        let c = doc.at(list, i).unwrap()
        let name = doc.text(doc.get(c, "name").unwrap()).unwrap()
        let frames = u32(doc.num(doc.get(c, "frames").unwrap()).unwrap())
        let length = u32(doc.num(doc.get(c, "length").unwrap()).unwrap())
        let followed = doc.is_true(doc.get(c, "followed").unwrap())
        var poses: Vec<Pose<D>> = Vec::with_capacity(frames)
        for _ in 0..frames {
            x.clear()
            for k in 0..nq {
                let o = 4 * at + 4 * k
                x.push(bitcast_f32(
                    u32(raw[o]) | (u32(raw[o + 1]) << 8) | (u32(raw[o + 2]) << 16) | (u32(raw[o + 3]) << 24),
                ))
            }
            at += nq
            // Each joint's numbers put into its range (`Joint::clamped`), as the fit and the solver
            // end: the simulator's three hinges hold a box about a ball joint's cone, and a tracker
            // held to the cone by its reward still leaves it by hundredths of a radian in some
            // frame of most clips (`b1`: the worst frame within the judge's 0.0136 rad in 4% of
            // clips, 0.007 rad past on average). The engine takes no pose out of its ranges.
            var pose = pose_of_qpos(def.body, def.rest, moves, x)
            for sg in 1..S {
                let jt = def.body.segments[sg].joint
                def.body.set_numbers(mut pose, sg, jt.clamped(def.body.numbers(pose, sg)))
            }
            poses.push(pose)
        }
        total += length
        if !followed {
            cut += 1
        }
        if frames < least {
            continue
        }
        write_all(f"out/{def.name}/{name}.pose", pose_bytes(poses, rate))?
        let meta = f"{{\"source\": \"filtered\", \"body\": \"{def.name}\", \"followed\": {followed}, \"frames\": {frames}, \"length\": {length}, \"rate\": {rate}}}"
        write_all(f"out/{def.name}/{name}.json", Vec::from(meta.as_bytes()))?
        written += 1
        kept += frames
    }
    print(f"export: unfilter: {written} clips of {doc.count(list)} written ({cut} cut at a fall), {kept} frames of {total}")
    Ok(written)
}
