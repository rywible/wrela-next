// The cost of a net on the CPU (docs/plans/bodies-and-movement.md, phase 0.3): the engine's net
// (`engine::learned::net`) of three layers of `n` units each (n = 128, 256, 512, 1024), from
// `INPUTS` inputs to `OUTPUTS` outputs, with random weights, evaluated as the CPU runs a game's
// code (WASM, strict floats). It prints the median time of one evaluation of each size and how
// many bodies one millisecond of a tick moves.
//
// The sizes of the input and the output are estimates of the solver's (phase 5 step 3): the
// pose and its rate, the goals in the body's frame and samples of the world's field come to some
// hundreds of numbers; the change of the pose and the contacts to some tens.

use engine::learned::net::{Activation, Layer, layer, net}
use std::collections::Vec
use std::hash::pcg
use std::io::print
use std::time::now

/// The numbers in and out of each net.
const INPUTS: u32 = 256
const OUTPUTS: u32 = 64

/// How many times each size is timed, each time `REPEATS` evaluations.
const ROUNDS: u32 = 21
const REPEATS: u32 = 20

/// A number in [-1, 1) from `seed`.
fn random(seed: u32) -> f32 {
    f32(pcg(seed.wrapping_mul(747796405).wrapping_add(2891336453)) >> 8) / 8388608.0 - 1.0
}

/// A layer of random weights, scaled as a net starts (1 / sqrt(ins)).
fn random_layer(ins: u32, outs: u32, seed: u32, activation: Activation) -> Layer {
    let s = 1.0 / sqrt(f32(ins))
    var w: Vec<f32> = Vec::with_capacity(ins * outs)
    for i in 0..(ins * outs) {
        w.push(random(seed * 1000003 + i) * s)
    }
    var b: Vec<f32> = Vec::with_capacity(outs)
    for j in 0..outs {
        b.push(random(seed * 7919 + j) * 0.1)
    }
    layer(ins, outs, w, take b, activation)
}

fn median(xs: mut Vec<f64>) -> f64 {
    xs.sort_by(|a, b| a < b)
    xs[xs.len() / 2]
}

pub fn tool() -> u32 {
    print(f"netcost: {INPUTS} inputs, three layers of n units (ELU), {OUTPUTS} outputs")
    for n in [128, 256, 512, 1024] {
        var layers: Vec<Layer> = Vec::new()
        layers.push(random_layer(INPUTS, n, 1, Activation::Elu))
        layers.push(random_layer(n, n, 2, Activation::Elu))
        layers.push(random_layer(n, n, 3, Activation::Elu))
        layers.push(random_layer(n, OUTPUTS, 4, Activation::None))
        let it = net(Vec::filled(INPUTS, 0.0), Vec::filled(INPUTS, 1.0), 5.0, take layers)
        var input: Vec<f32> = Vec::new()
        for k in 0..INPUTS {
            input.push(random(99991 + k))
        }
        var out: Vec<f32> = Vec::new()
        var times: Vec<f64> = Vec::new()
        var keep = 0.0
        for _ in 0..ROUNDS {
            let t = now()
            for _ in 0..REPEATS {
                it.apply(input, mut out)
                keep += out[0]
            }
            times.push((now() - t) / f64(REPEATS))
        }
        let m = median(mut times)
        let us = f32(m * 1000000.0)
        let bodies = f32(0.001 / m)
        print(f"n={n} weights={it.size()} median={us} us bodies_in_1ms={bodies} (check {keep})")
    }
    0
}
