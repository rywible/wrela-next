#!/bin/bash
# Imports the clips of a list (SOURCE/CLIP a line) onto the human, each fitted, smoothed and stood
# on the ground (tools/movement/capture), WORKERS at a time: the benchmark's in minutes
# (tools/movement/split/benchmark), where a whole source takes hours.
#
#     tools/movement/import-clips LIST [WORKERS]
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$here"
list="$1"
workers="${2:-10}"
one() {
  local src="${1%%/*}" name="${1#*/}"
  local c=(tools/wrela tool tools/movement/capture --read capture=.movement/capture --write out=.movement/poses -- human "$src" 0 100000 4)
  if [[ -f ".movement/poses/human/$1.json" ]] && grep -q ground_shift ".movement/poses/human/$1.json"; then
    return 0
  fi
  "${c[@]}" "only=$name" 2>&1 | grep -E "^capture: $name" || true
  "${c[@]}" smooth "only=$name" >/dev/null 2>&1
  "${c[@]}" ground "only=$name" >/dev/null 2>&1
}
export -f one
grep -v '^#' "$list" | grep . | xargs -P "$workers" -I{} bash -c 'one "$@"' _ {}
