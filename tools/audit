#!/usr/bin/env python3
"""Automated GPU zero-hole audit gate (SCENE 6). Usage:

    tools/audit [--size WxH] [--eyes N] [--kind K] [--eye E] [--set NAME=VALUE]... [--timeout S]
                [--keep DIR | --built DIR]

Builds `game/scenes` with `SCENE=6` (and optional `AUDIT_EYES=N`), launches it through `tools/gpu`
until `scene: done`, and fails non-zero if ANY audited kind reports, on the frame of a cut or
settled:
  - a crack: a hole 3 px or more inside the field's own outline (solid matter seen through), or
    an extra 3 px or more outside it (matter where there is none)
  - more holes and extras within 2 px of the outline than OUTLINE_BUDGET of the pixels the field
    meets: an outline a pixel or two off is the outline's error (the judges'), held to a budget,
    not a hole
  - overflows > 0 (any `OVERFLOW_*` extraction capacity truncation)
  - eyes held unsettled > 0
  - fewer kinds completed than the scene says it audits (`audit: kinds N`), or a kind whose
    field met matter at no pixel (an audit of nothing)

Defaults: `--size 640x360`, `--eyes 24`, `--timeout 300`.
Use `--size 160x90 --eyes 12` for a quick smoke gate during iteration, and `--kind K` to audit
the scene's Kth kind alone (its place in `audited`'s list in game/scenes/main.wrela), `--eye E` to
hold each kind to its Eth eye alone (as the full audit places it), `--set NAME=VALUE` to pass a
setting of the scene's on to its build (`--set BY_FIELD=true`). `--keep DIR`
keeps the build and the last frame drawn (`DIR/audit.png`). `--built DIR` audits the build
already in DIR and builds nothing (tools/gate makes its builds together, ahead): the build must
be SCENE=6 with the AUDIT_EYES that `--eyes` says, and `--kind`, `--eye` and `--set` are its
builder's to pass.
"""

import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile

ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), ".."))
WRELA = os.path.join(ROOT, "tools", "wrela")
GPU = os.path.join(ROOT, "tools", "gpu")

AUDIT_COUNTS = re.compile(
    r"^audit:\s+(?P<what>.+?):\s+(?P<px>\d+)\s+px,\s+the field meets matter at\s+(?P<met>\d+);\s+"
    r"holes\s+(?P<holes>\d+),\s+extra\s+(?P<extra>\d+),\s+off by more than a pixel\s+(?P<off>\d+)"
)
AUDIT_DEPTHS = re.compile(
    r"^audit:\s+(?P<what>.+?):\s+holes by how far inside the field's outline \(px 1, 2, 3-4, deeper\):\s+"
    r"(?P<h1>\d+), (?P<h2>\d+), (?P<h3>\d+), (?P<h5>\d+); extras by how far outside it: "
    r"(?P<e1>\d+), (?P<e2>\d+), (?P<e3>\d+), (?P<e5>\d+)"
)
# Holes and extras within 2 px of the field's outline a kind may have, as a share of the pixels
# its field meets (one in ten thousand).
OUTLINE_BUDGET = 1.0e-4
AUDIT_SETTLE = re.compile(
    r"^audit:\s+(?P<what>.+?):\s+frames to settle after a cut:.*?eyes held unsettled\s+(?P<unsettled>\d+);\s+overflows\s+(?P<overflows>\d+)"
)


def parse_args(argv):
    opts = {"size": "640x360", "eyes": 24, "timeout": 300, "keep": None, "built": None, "kind": None,
            "eye": None, "set": []}
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("-h", "--help"):
            print(__doc__.strip())
            sys.exit(0)
        if a in ("--size", "--eyes", "--timeout", "--keep", "--built", "--kind", "--eye", "--set") and i + 1 < len(argv):
            val = argv[i + 1]
            if a == "--eyes":
                opts["eyes"] = int(val)
            elif a == "--set":
                opts["set"].append(val)
            elif a == "--eye":
                opts["eye"] = int(val)
            elif a == "--kind":
                opts["kind"] = int(val)
            elif a == "--timeout":
                opts["timeout"] = int(val)
            elif a == "--size":
                opts["size"] = val
            elif a == "--built":
                opts["built"] = val
            else:
                opts["keep"] = val
            i += 2
            continue
        print(f"audit: unknown argument `{a}`", file=sys.stderr)
        sys.exit(2)
    if opts["built"] is not None and (opts["keep"] or opts["set"] or opts["kind"] is not None or opts["eye"] is not None):
        print("audit: `--built DIR` is a build already made: `--keep`, `--kind`, `--eye` and `--set` don't go with it", file=sys.stderr)
        sys.exit(2)
    return opts


def main():
    opts = parse_args(sys.argv[1:])
    tmp = None
    out_dir = opts["built"] or opts["keep"]
    if out_dir is None:
        tmp = tempfile.mkdtemp(prefix="wrela-audit-")
        out_dir = os.path.join(tmp, "scene6")
    try:
        build_cmd = [
            WRELA, "build", os.path.join(ROOT, "game", "scenes"),
            "-o", out_dir,
            "--set", "SCENE=6",
            "--set", f"AUDIT_EYES={opts['eyes']}",
        ]
        if opts["kind"] is not None:
            build_cmd += ["--set", f"AUDIT_KIND={opts['kind']}"]
        if opts["eye"] is not None:
            build_cmd += ["--set", f"AUDIT_EYE={opts['eye']}"]
        for kv in opts["set"]:
            build_cmd += ["--set", kv]
        if opts["built"] is None:
            print(f"audit: building SCENE=6 (AUDIT_EYES={opts['eyes']}, size={opts['size']})", file=sys.stderr)
            subprocess.check_call(build_cmd)

        kept_marches(out_dir)

        # An eye is drawn till it settles (SETTLE_MOST, 12) and its march is in (at least a
        # quarter of MARCH_FRAME's 65,536 rays a frame, of 5 a pixel, as its field's step costs:
        # lib/engine/judge/audit.wrela's `march_frame`).
        w, h = (int(x) for x in opts["size"].split("x"))
        per_eye = max(14, -(-5 * w * h // 16384) + 2)
        max_frames = 16 * (opts["eyes"] * per_eye + 32)
        png_path = os.path.join(out_dir, "audit.png")
        run_cmd = [
            GPU, "--timeout", str(opts["timeout"]),
            out_dir,
            "--size", opts["size"],
            "--frames", str(max_frames),
            "--until", "scene: done",
            "--png", png_path,
        ]
        # A readback is answered the frame after it is asked (the host's `WRELA_READS_AFTER`),
        # unless the caller says otherwise: an eye settles in as few frames as its extractions take,
        # and a run's readbacks fall on the same frames every time.
        env = dict(os.environ)
        env.setdefault("WRELA_READS_AFTER", "1")
        proc = subprocess.run(run_cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, env=env)
        print(proc.stdout, end="")
        if proc.returncode != 0:
            tail = [l for l in proc.stdout.splitlines() if l.strip()][-12:]
            print("\n".join(tail), file=sys.stderr)
            print(f"audit: FAILED (host exited with {proc.returncode})", file=sys.stderr)
            return proc.returncode

        faults = []
        settled_seen = 0
        cut_seen = 0
        done_seen = False
        kinds = None
        met = {}
        depths_seen = set()
        pending = {}
        for raw in proc.stdout.splitlines():
            line = raw.strip()
            if line.startswith("wrela: "):
                line = line[len("wrela: "):].strip()
            if line == "scene: done":
                done_seen = True
            mk = re.match(r"^audit: kinds (\d+)$", line)
            if mk:
                kinds = int(mk.group(1))
            m = AUDIT_COUNTS.match(line)
            if m:
                what = m.group("what")
                holes = int(m.group("holes"))
                extra = int(m.group("extra"))
                if "settled" in what:
                    settled_seen += 1
                elif "frame of the cut" in what:
                    cut_seen += 1
                met[what] = int(m.group("met"))
                if holes + extra > 0 and what not in depths_seen:
                    pending[what] = (holes, extra)
                if int(m.group("met")) == 0:
                    faults.append(f"{what}: the field met matter at no pixel (an audit of nothing)")
                continue
            md = AUDIT_DEPTHS.match(line)
            if md:
                what = md.group("what")
                depths_seen.add(what)
                pending.pop(what, None)
                g = {k: int(v) for k, v in md.groupdict().items() if k != "what"}
                cracks = g["h3"] + g["h5"]
                ghosts = g["e3"] + g["e5"]
                near = g["h1"] + g["h2"] + g["e1"] + g["e2"]
                if cracks > 0 or ghosts > 0:
                    faults.append(f"{what}: {cracks} holes 3 px or more inside the outline (cracks), {ghosts} extras 3 px or more outside it")
                allowed = OUTLINE_BUDGET * met.get(what, 0)
                if near > allowed:
                    faults.append(f"{what}: {near} holes and extras at the outline, over its budget of {allowed:.0f}")
                continue
            ms = AUDIT_SETTLE.match(line)
            if ms:
                what = ms.group("what")
                unsettled = int(ms.group("unsettled"))
                overflows = int(ms.group("overflows"))
                if unsettled > 0 or overflows > 0:
                    faults.append(f"{what}: unsettled={unsettled}, overflows={overflows}")

        for what, (holes, extra) in pending.items():
            faults.append(f"{what}: holes={holes}, extra={extra}, and no line saying how deep they are")
        if not done_seen:
            faults.append("did not reach `scene: done`")
        if kinds is None:
            faults.append("the scene did not say how many kinds it audits (`audit: kinds N`)")
        elif settled_seen < kinds or cut_seen < kinds:
            faults.append(
                f"incomplete audit: saw {cut_seen} cut and {settled_seen} settled reports (expected {kinds})"
            )

        if faults:
            print("audit: FAILED:", file=sys.stderr)
            for f in faults:
                print(f"  - {f}", file=sys.stderr)
            return 1

        print(f"audit: PASSED ({kinds} kinds, {opts['eyes']} eyes @ {opts['size']}: no cracks, outlines within budget, 0 overflows)", file=sys.stderr)
        return 0
    finally:
        if tmp is not None:
            shutil.rmtree(tmp, ignore_errors=True)


MARCHES = os.path.join(os.path.expanduser("~"), ".wrela", "audit-marches")
MARCHES_KEPT = 3


def kept_marches(out_dir):
    """Gives the build in `out_dir` its storage: a directory of this machine's, named by the
    build's march kernels (their shaders, the fields' code in them), where the audit keeps each
    eye's march and reads it back the next run (lib/engine/judge/audit.wrela, "an eye's march,
    kept"). A march is most of an eye's frames, and the same until its field, its eye or the
    march's kernels change; the kernels are this name, the rest the name of its file. The
    `MARCHES_KEPT` directories last used are kept, the rest removed."""
    try:
        with open(os.path.join(out_dir, "manifest.json")) as f:
            manifest = json.load(f)
        h = hashlib.sha256()
        h.update(str(manifest.get("target")).encode())
        for p in manifest["pipelines"]:
            if p["name"] in ("marching", "marched"):
                h.update(p["name"].encode())
                with open(os.path.join(out_dir, p["shader"]), "rb") as f:
                    h.update(f.read())
        kept = os.path.join(MARCHES, h.hexdigest()[:24])
        os.makedirs(kept, exist_ok=True)
        os.utime(kept)
        link = os.path.join(out_dir, "storage")
        if os.path.islink(link):
            os.unlink(link)
        if not os.path.exists(link):
            os.symlink(kept, link)
        old = sorted((d for d in os.listdir(MARCHES) if os.path.isdir(os.path.join(MARCHES, d))),
                     key=lambda d: os.path.getmtime(os.path.join(MARCHES, d)), reverse=True)
        for d in old[MARCHES_KEPT:]:
            shutil.rmtree(os.path.join(MARCHES, d), ignore_errors=True)
    except (OSError, KeyError, ValueError) as e:
        print(f"audit: the eyes' marches are not kept this run: {e}", file=sys.stderr)


if __name__ == "__main__":
    sys.exit(main())
