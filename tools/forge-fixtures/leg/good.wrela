// A turned leg, written well (tools/forge-test's fixture): its profile in a dozen points and their
// bows, one named piece.

use kit::shapes::made::{Piece, piece}
use kit::shapes::making::{Turned, turned}

/// The leg's profile, (radius, height) from its foot to its head, and its bows.
pub const PROFILE = [
    vec2(0.034, 0.0),
    vec2(0.044, 0.032),
    vec2(0.03, 0.064),
    vec2(0.034, 0.074),
    vec2(0.028, 0.09),
    vec2(0.05, 0.22),
    vec2(0.03, 0.355),
    vec2(0.026, 0.4),
    vec2(0.034, 0.414),
    vec2(0.026, 0.43),
    vec2(0.028, 0.55),
    vec2(0.032, 0.605),
]
pub const BOWS = [
    0.009, -0.004, 0.002, -0.002, 0.022, 0.013, -0.003, 0.0025, -0.002, 0.001, 0.002, 0.0,
]

/// The leg.
pub fn leg() -> Piece<Turned<12>> {
    piece(0, "leg", turned(PROFILE, BOWS))
}
