#!/bin/bash
# The toolchain's check: its formatting, its build (release, toolchain/target), and its kept tests
# (the ignored ones, which need a GPU or a long run, aren't run). The tests run under the machine's
# GPU lock (tools/gpulock.py), as some draw on the GPU. Waits for any other cargo on the machine to
# finish first: one Rust build at a time. Extra arguments go to `cargo test` (a filter, say).
# It says how long each step took, when it ends and when it stops at a failure.
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root/toolchain"
while pgrep -x cargo > /dev/null; do
  echo "check: waiting for another cargo to finish" >&2
  sleep 5
done
began=$SECONDS
# `step NAME` ends the step before and starts NAME; the times are said as the check leaves.
step_name=""
step_began=$SECONDS
times=""
step() {
  if [[ -n "$step_name" ]]; then
    times+="$step_name $((SECONDS - step_began)) s, "
  fi
  step_name="$1"
  step_began=$SECONDS
  if [[ -n "$1" ]]; then echo "check: $1" >&2; fi
}
trap 'step ""; echo "check: times: ${times%, }" >&2' EXIT
step "tools"
python3 -m py_compile "$root/tools/gpulock.py"
for t in gpu bench shot same test-measure hosts shaders layers audit gate radeon forge forge-test; do
  python3 -c "import ast, sys; ast.parse(open(sys.argv[1]).read())" "$root/tools/$t"
done
bash -n "$root/tools/built" "$root/tools/wrela" "$root/tools/wrela-host" "$root/tools/check"
python3 "$root/tools/test-measure" > /dev/null || python3 "$root/tools/test-measure"
python3 "$root/tools/layers"
# The forge's checks that need no build: prompts, meshes, the look.
python3 "$root/tools/forge-test" --quick > /dev/null || python3 "$root/tools/forge-test" --quick
step "format"
cargo fmt --check
step "build"
cargo build --release --quiet --workspace
touch "$root/toolchain/target/release/.built"
# The engine, vocabulary, and world assets' own tests (each field kind against its contracts and
# CPU reference), on the CPU, with the toolchain just built.
step "packages"
for pkg in lib/engine lib/kit game/world; do
  out="$("$root/tools/wrela" test "$root/$pkg" 2>&1)" || {
    echo "$out" | grep -E "FAILED|panicked" >&2
    exit 1
  }
  echo "check: $pkg: $(echo "$out" | grep -E "passed, " | tail -1)" >&2
done
step "tests"
python3 - "$@" <<'EOF'
import subprocess, sys
sys.path.insert(0, "../tools")
import gpulock
lock = gpulock.take("tools/check: cargo test")
status = subprocess.call(["cargo", "test", "--release", "--quiet", "--workspace", "--no-fail-fast"]
                         + (["--"] + sys.argv[1:] if sys.argv[1:] else []))
# On this machine's GPU (both machines have one): what keeps a program from holding the GPU
# past a driver's timeout, a dispatch's guard and a submission's bound (language.md §18.11); and
# what a lost device does; that a serial run times each pass as itself; and that a settled read
# (`std::gpu::read_settled`) reads the work before it and waits for none.
# Any change to when the host submits is tested against it (language.md §18.11).
if not sys.argv[1:]:
    print("check: the GPU's guards", file=sys.stderr)
    status = status or subprocess.call(["cargo", "test", "--release", "--quiet", "-p", "wrela-host",
                                        "--lib", "--", "--ignored", "--test-threads=1",
                                        "a_frame_of_many_dispatches",
                                        "a_lost_device_is_made_again",
                                        "a_pass_after_cpu_work_runs_at_its_warm_time",
                                        "a_pass_of_many_heavy_draws_is_cut",
                                        "a_piece_alone_over_the_line_once",
                                        "a_serial_run_times_a_dispatch_of_no_groups",
                                        "a_settled_read_holds_the_work_before_it",
                                        "a_small_pass_after_cpu_work_is_judged",
                                        "an_indirect_dispatch_of_stated_most",
                                        "arithmetic_is_the_same_whatever_surrounds_it",
                                        "the_calibration_kernel_snaps"])
    status = status or subprocess.call(["cargo", "test", "--release", "--quiet", "-p", "wrela-tests",
                                        "--test", "suite", "--", "--ignored", "--test-threads=1",
                                        "fuel::a_lane_out_of_fuel",
                                        "exact::a_function_gives_the_same_bits",
                                        "a_readback_is_answered_on_the_next_call"])
sys.exit(status)
EOF
# The gate's GPU half (tools/gate; its layers and tests ran above): the hole audit at a small
# size (every kind, 12 eyes; `tools/gate --full` runs the full one too, before a commit that
# changes how anything is drawn), the sun's judge, and a frame's span at 1080p, each held to this
# machine's baseline in tools/gate.json.
step "the gate"
"$root/tools/gate" --only audit,sun,frames
echo "check: passed in $((SECONDS - began)) s" >&2
