#!/bin/bash
# The toolchain's check: its formatting, its build (release, toolchain/target), and its kept tests
# (the ignored ones, which need a GPU or a long run, aren't run). The tests run under the machine's
# GPU lock (tools/gpulock.py), as some draw on the GPU. Waits for any other cargo on the machine to
# finish first: one Rust build at a time. Extra arguments go to `cargo test` (a filter, say).
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root/toolchain"
while pgrep -x cargo > /dev/null; do
  echo "check: waiting for another cargo to finish" >&2
  sleep 5
done
began=$SECONDS
echo "check: tools" >&2
python3 -m py_compile "$root/tools/gpulock.py"
for t in gpu bench shot same test-measure hosts shaders; do
  python3 -c "import ast, sys; ast.parse(open(sys.argv[1]).read())" "$root/tools/$t"
done
bash -n "$root/tools/built" "$root/tools/wrela" "$root/tools/wrela-host" "$root/tools/check"
python3 "$root/tools/test-measure" > /dev/null || python3 "$root/tools/test-measure"
echo "check: format" >&2
cargo fmt --check
echo "check: build" >&2
cargo build --release --quiet --workspace
touch "$root/toolchain/target/release/.built"
echo "check: tests" >&2
python3 - "$@" <<'EOF'
import subprocess, sys
sys.path.insert(0, "../tools")
import gpulock
lock = gpulock.take("tools/check: cargo test")
status = subprocess.call(["cargo", "test", "--release", "--quiet", "--workspace", "--no-fail-fast"]
                         + (["--"] + sys.argv[1:] if sys.argv[1:] else []))
# On this machine's GPU (both machines have one): what keeps a program from holding the GPU
# past a driver's timeout, a dispatch's guard and a submission's bound (language.md §18.11); and
# what a lost device does.
# Any change to when the host submits is tested against it (backend.md, method notes).
if not sys.argv[1:]:
    print("check: the GPU's guards", file=sys.stderr)
    status = status or subprocess.call(["cargo", "test", "--release", "--quiet", "-p", "wrela-host",
                                        "--lib", "--", "--ignored", "a_frame_of_many_dispatches",
                                        "a_lost_device_is_made_again",
                                        "a_pass_after_cpu_work_runs_at_its_warm_time",
                                        "a_pass_of_many_heavy_draws_is_cut",
                                        "a_piece_alone_over_the_line_once",
                                        "a_small_pass_after_cpu_work_is_judged",
                                        "an_indirect_dispatch_of_stated_most",
                                        "arithmetic_is_the_same_whatever_surrounds_it",
                                        "the_calibration_kernel_snaps"])
    status = status or subprocess.call(["cargo", "test", "--release", "--quiet", "-p", "wrela-tests",
                                        "--test", "suite", "--", "--ignored",
                                        "fuel::a_lane_out_of_fuel",
                                        "exact::a_function_gives_the_same_bits",
                                        "a_readback_is_answered_on_the_next_call"])
sys.exit(status)
EOF
echo "check: passed in $((SECONDS - began)) s" >&2
