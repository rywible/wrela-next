def test_shot_runs_frames_through_n():
    a = build("shot", [{"span": 1.0}])
    png = os.path.join(WORK, "shot.png")
    saved = os.dup(1), os.dup(2)
    null = os.open(os.devnull, os.O_WRONLY)
    try:  # the launcher's own output, which shot passes through
        os.dup2(null, 1)
        os.dup2(null, 2)
        status, out, err = run(shot, [a, "--frame", "1", "--size", "64x32", "-o", png])
    finally:
        os.dup2(saved[0], 1)
        os.dup2(saved[1], 2)
        os.close(null)
    assert status == 0, err
    assert os.path.isfile(png)
    args = args_of(a, "shot")
    assert f"--frames 2 --size 64x32 --png {png}" in args, args
    status, out, err = run(shot, [a, "--frame", "1"])
    assert status == 2, "a shot with no -o ran"


