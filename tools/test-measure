#!/usr/bin/env python3
"""Tests of the measuring tools (tools/bench, tools/shot, tools/same, tools/hosts), with no GPU: synthetic
timestamp output from a fake tools/gpu, and synthetic pictures. Each gate is shown to hold where
it should and to fail where it should, and each test is shown to catch a broken tool (the
mutants at the end: a test that can't fail proves nothing).

    tools/test-measure

Exit status 0 when every test passes and every mutant is caught.
"""

import contextlib
import importlib.util
import io
import json
import os
import shutil
import statistics
import sys
import tempfile
from importlib.machinery import SourceFileLoader

# The bench waits for a quiet machine before a run; its own tests must not (they would wait
# ten minutes a run while builders work).
os.environ["WRELA_BENCH_QUIET_WAIT"] = "0"

TOOLS = os.path.dirname(os.path.abspath(__file__))


def tool(name):
    loader = SourceFileLoader(name.replace("-", "_"), os.path.join(TOOLS, name))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


bench = tool("bench")
same = tool("same")
hosts = tool("hosts")
shot = tool("shot")
from PIL import Image, ImageDraw  # noqa: E402  (tools/same needs Pillow too)

WORK = tempfile.mkdtemp(prefix="test-measure-")

# A stand-in for tools/gpu: reads the build's fake.json, `{"runs": [{"span": V, "passes": {label:
# V}}, ...], "last": frame}` (V in ms: a number, a list a frame in turn, or {"from", "to", "over"}
# frames, a line then level), and prints what wrela-host --timestamps prints: each label's pieces,
# then each frame's span; with --serial, the pieces and spans of 99 ms (a serial span is the CPU's
# waits). The span runs and the serial runs are counted apart, and each's arguments kept.
FAKE = r"""#!/usr/bin/env python3
import json, os, sys
args = sys.argv[1:]
while args[0] in ("--host", "--timeout"):
    args = args[2:]
build, n = args[0], int(args[args.index("--frames") + 1])
mode = ("serial" if "--serial" in args else "span" if "--timestamps" in args
        else "cpu" if "--cpu" in args else "shot")
open(os.path.join(build, ".args-" + mode), "w").write(" ".join(args))
if "--png" in args:
    open(args[args.index("--png") + 1], "wb").write(b"png")
spec = json.load(open(os.path.join(build, "fake.json")))
count = os.path.join(build, ".count-" + mode)
k = int(open(count).read()) if os.path.exists(count) else 0
open(count, "w").write(str(k + 1))
run = spec["runs"][k % len(spec["runs"])]
def at(v, f):
    if isinstance(v, list):
        return v[f % len(v)]
    if isinstance(v, dict):
        return v["from"] + (v["to"] - v["from"]) * min(f, v["over"]) / v["over"]
    return v
print("gpu: guard: largest 0 B (fake.wgsl)", file=sys.stderr)
shown = range(min(n, spec.get("last", n - 1) + 1))
for f in shown:
    for label, v in run.get("passes", {}).items():
        us = at(v, f) * 1000
        # Two pieces a label, as a pass and its dispatch: the bench sums them.
        print(f"frame {f:>4}  {label:<24} {us / 2:>10.3f} us", file=sys.stderr)
        print(f"frame {f:>4}  {label:<24} {us - us / 2:>10.3f} us", file=sys.stderr)
if mode == "cpu":
    for f in shown:
        c = {p: at(run.get("cpu", {}).get(p, 0.5), f) for p in ("program", "check", "record", "blocked")}
        total = sum(c.values())
        print(f"frame {f:>4}  cpu total {total:.3f} ms program {c['program']:.3f} check "
              f"{c['check']:.3f} record {c['record']:.3f} blocked {c['blocked']:.3f}", file=sys.stderr)
    shown = []
for f in shown:
    span = 99.0 if mode == "serial" else at(run.get("span", 1.0), f)
    print(f"frame {f:>4}  span {span:.3f} ms", file=sys.stderr)
print("%016x" % (0xabc + k))
"""
FAKE_PATH = os.path.join(WORK, "fake-gpu")
with open(FAKE_PATH, "w") as f:
    f.write(FAKE)
os.chmod(FAKE_PATH, 0o755)
bench.GPU = FAKE_PATH
shot.GPU = FAKE_PATH


def build(name, runs, last=None):
    """A fake build whose runs, in turn, time as `runs` says."""
    path = os.path.join(WORK, name)
    if os.path.exists(path):
        shutil.rmtree(path)
    os.makedirs(path)
    spec = {"runs": runs}
    if last is not None:
        spec["last"] = last
    with open(os.path.join(path, "fake.json"), "w") as f:
        json.dump(spec, f)
    return path


def args_of(build_dir, mode):
    path = os.path.join(build_dir, ".args-" + mode)
    if not os.path.exists(path):
        return None
    with open(path) as f:
        return f.read()


def run(module, argv):
    """A tool's main in this process: (status, stdout, stderr)."""
    out, err = io.StringIO(), io.StringIO()
    with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
        status = module.main(argv)
    return status, out.getvalue(), err.getvalue()


def near(x, y, eps=1e-9):
    return abs(x - y) <= eps


def bench_json(argv, frames="2-11"):
    path = os.path.join(WORK, "out.json")
    status, out, err = run(bench, ["--rest", "0", "--frames", frames, "--json", path] + argv)
    assert status == 0, f"bench exited {status}: {err}"
    with open(path) as f:
        return json.load(f), out, err


LOADED = {"work": 15.0, "sky": 10.0, "load": 20.0}


