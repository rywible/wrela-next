def test_timestamps_are_read():
    """The host's lines: pieces summed by label and frame, other lines ignored, labels with
    spaces kept whole, frames outside the range left out, medians and sums right, `load` out of
    the sum; spans read by frame."""
    lines = [
        "gpu: guard: largest 0 B (x.wgsl)",
        "frame    0  warm                        5000.000 us",
        "frame    1  sky                          100.000 us",
        "frame    1  ocean warming                200.000 us",
        "frame    1  ocean warming                300.000 us",
        "frame    1  load                       20000.000 us",
        "frame    2  sky                          300.000 us",
        "frame    2  ocean warming                700.000 us",
        "frame    2  load                       20000.000 us",
        "frame    3  sky                          200.000 us",
        "frame    3  ocean warming                600.000 us",
        "frame    3  load                       21000.000 us",
        "frame    1  span 9.500 ms",
        "frame    3  span 11.250 ms",
        "frame    0  span 99.000 ms",
        "c26ef2b0f0c54eb1",
    ]
    frames, order = bench.read_timings(lines)
    assert order == ["warm", "sky", "ocean warming", "load"], order
    m = bench.measure(frames, order, 1, 3)
    assert m["frames"] == [1, 2, 3]
    assert "warm" not in m["labels"], "a frame outside the range was read"
    assert near(statistics.median(m["labels"]["sky"]["values"]), 0.2)
    assert near(statistics.median(m["labels"]["ocean warming"]["values"]), 0.6)
    assert all(near(x, y) for x, y in zip(m["sums"], [0.6, 1.0, 0.8])), m["sums"]
    assert m["load"]
    assert bench.window(bench.read_spans(lines), 1, 3) == [9.5, 11.25]


def test_the_frame_is_the_span():
    """The frame's cost is the span runs' spans (17 ms, past one 60 ms frame in ten), not the
    passes alone, which sum to 25 here; the pass table says it doesn't add up to the frame."""
    a = build("steady", [{"span": [17.0] * 9 + [60.0], "passes": LOADED}])
    result, out, err = bench_json([a])
    r = result["span_runs"][0]
    assert r["frames_read"] == 10, r["frames_read"]
    assert near(result["summary"]["median"], 17.0), result["summary"]
    assert near(r["span"]["max"], 60.0), r["span"]
    t = result["passes_runs"][0]["table"]
    assert near(t["sum of passes alone"]["median"], 25.0), t
    assert "frame span: 17.000 ms" in out, out
    assert "these do not add up to the frame" in out
    assert "sum of passes alone (not the frame)" in out


