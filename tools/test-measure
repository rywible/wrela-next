def ab(a_spans, b_spans, canary=None, runs=3):
    a = build("A", [{"span": t, "passes": {"work": 5.0, "clouds": 2.5, "load": 20.0}}
                    for t in a_spans])
    b = build("B", [{"span": t, "passes": {"work": 5.0, "clouds": canary or 2.5, "load": 20.0}}
                    for t in b_spans])
    return bench_json([a, "--against", b, "--runs", str(runs), "--canary", "clouds"])


def test_inside_the_noise():
    """B 0.3 ms (3%) over A where A reads 10.0 to 10.4 against itself: noise, not slower."""
    result, out, err = ab([10.0, 10.4, 10.2], [10.5, 10.5, 10.5])
    v = result["verdict"]
    assert near(v["diff"], 0.3, 1e-6) and near(v["noise"], 0.4, 1e-6), v
    assert v["verdict"] == "inside the noise", v
    assert "INSIDE THE NOISE" in out


def test_an_a_a_pair_is_noise():
    """The same spans both sides, alternating: inside the noise."""
    result, out, err = ab([10.0, 10.4, 10.2], [10.2, 10.0, 10.4])
    assert result["verdict"]["verdict"] == "inside the noise"


