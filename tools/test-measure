def picture(name, draw=None, size=(256, 256), base=(40, 60, 90)):
    im = Image.new("RGB", size, base)
    if draw:
        draw(ImageDraw.Draw(im), im)
    path = os.path.join(WORK, name)
    im.save(path)
    return path


def disc(dx=0):
    return lambda d, im: d.ellipse((60 + dx, 70, 190 + dx, 200), fill=(220, 200, 160))


def test_identical_pictures_are_the_same():
    a = picture("a.png", disc())
    b = picture("a2.png", disc())
    d = same.compare(same.load(a), same.load(b), 24)
    for where in ("all", "edge"):
        m = d[where]
        assert m["over2"] == 0 and m["over8"] == 0 and m["mean"] == 0 and m["max"] == 0
        assert m["psnr"] == float("inf")
    assert d["edge"]["pixels"] > 0
    status, out, err = run(same, [a, b, "--over2", "0", "--max", "0", "--edge-over2", "0",
                                  "--psnr", "1000", "--edge-psnr", "1000"])
    assert status == 0, out


def test_measures_are_exact():
    """Two pixels of 100 differ: one by 4 in red, one by 10 in green."""
    a = picture("flat-a.png", size=(10, 10), base=(50, 50, 50))

    def nudge(d, im):
        im.putpixel((2, 3), (54, 50, 50))
        im.putpixel((7, 7), (50, 60, 50))
    b = picture("flat-b.png", nudge, size=(10, 10), base=(50, 50, 50))
    m = same.compare(same.load(a), same.load(b), 24)["all"]
    assert m["pixels"] == 100
    assert near(m["over2"], 2.0) and near(m["over8"], 1.0), m
    assert near(m["mean"], 0.14) and m["max"] == 10, m
    import math
    assert near(m["psnr"], 10 * math.log10(255 ** 2 / ((16 + 100) / 300))), m


def test_threshold_is_more_than():
    """A difference of exactly 2 is not over 2/255; exactly 8 is not over 8/255."""
    a = picture("t-a.png", size=(2, 1), base=(50, 50, 50))

    def nudge(d, im):
        im.putpixel((0, 0), (52, 50, 50))
        im.putpixel((1, 0), (50, 50, 58))
    b = picture("t-b.png", nudge, size=(2, 1), base=(50, 50, 50))
    m = same.compare(same.load(a), same.load(b), 24)["all"]
    assert near(m["over2"], 50.0) and m["over8"] == 0, m


def test_a_silhouette_moved_a_pixel_is_caught_at_the_edges():
    """The disc moved one pixel right: the whole picture's mean and share pass their gates, the
    edge pixels' share fails its gate."""
    a = picture("a.png", disc())
    b = picture("moved.png", disc(1))
    d = same.compare(same.load(a), same.load(b), 24)
    assert d["all"]["mean"] < 1.0 and d["all"]["over8"] < 1.0, d["all"]
    assert d["edge"]["over8"] > 30.0, d["edge"]
    status, out, err = run(same, [a, b, "--mean", "1", "--over8", "1"])
    assert status == 0 and "FAILS" not in out, out
    status, out, err = run(same, [a, b, "--mean", "1", "--over8", "1", "--edge-over8", "10"])
    assert status == 1, out
    assert "gate: over 8/255 over edge pixels" in out and "FAILS" in out


def test_each_gate_can_fail():
    """Every gate, all pixels and edge pixels, fails on the moved disc and holds on itself."""
    a = picture("a.png", disc())
    b = picture("moved.png", disc(1))
    for where in ("", "edge-"):
        for flag, limit in (("over2", "0"), ("over8", "0"), ("mean", "0"), ("max", "0"),
                            ("psnr", "60")):
            gate = [f"--{where}{flag}", limit]
            status, out, err = run(same, [a, b] + gate)
            assert status == 1 and "FAILS" in out, (gate, out)
            status, out, err = run(same, [a, a] + gate)
            assert status == 0 and "holds" in out, (gate, out)


def test_noise():
    """c.png: A's second run, 20 interior pixels off by 3. B equal to c is not above the noise;
    the moved disc is, as is one pixel off by 30."""
    a = picture("a.png", disc())

    def jitter(d, im):
        disc()(d, im)
        for i in range(20):
            im.putpixel((100 + i, 130), (223, 200, 160))
    c = picture("c.png", jitter)
    b_same = picture("b-same.png", jitter)
    moved = picture("moved.png", disc(1))

    def one(d, im):
        disc()(d, im)
        im.putpixel((120, 130), (250, 200, 160))
    spot = picture("spot.png", one)
    status, out, err = run(same, [a, b_same, "--noise", c])
    assert status == 0 and "not above the noise" in out, out
    status, out, err = run(same, [a, moved, "--noise", c])
    assert status == 1 and "ABOVE the noise" in out, out
    status, out, err = run(same, [a, spot, "--noise", c])
    assert status == 1 and "greatest over all pixels 30 against 3" in out, out


