def main():
    failed = 0
    for t in TESTS:
        try:
            t()
            print(f"ok      {t.__name__}")
        except Exception as e:  # noqa: BLE001
            failed += 1
            print(f"FAILED  {t.__name__}: {type(e).__name__}: {e}")
    for name, patch, tests in MUTANTS:
        caught = []
        with patch():
            for t in tests:
                try:
                    t()
                except Exception:  # noqa: BLE001
                    caught.append(t.__name__)
        if len(caught) == len(tests):
            print(f"caught  mutant: {name} ({', '.join(caught)})")
        else:
            failed += 1
            missed = [t.__name__ for t in tests if t.__name__ not in caught]
            print(f"MISSED  mutant: {name}: {', '.join(missed)} still passed")
    shutil.rmtree(WORK, ignore_errors=True)
    print(f"test-measure: {len(TESTS)} tests, {len(MUTANTS)} mutants: "
          f"{'all passed' if not failed else str(failed) + ' failed'}")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
