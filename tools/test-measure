# ---- the mutants: each breaks a tool, and a test must fail -------------------------------------


@contextlib.contextmanager
def patched(module, name, value):
    old = getattr(module, name)
    setattr(module, name, value)
    try:
        yield
    finally:
        setattr(module, name, old)


class MeanNotMedian:
    median = staticmethod(statistics.fmean)


def no_edges(a, step):
    return Image.new("L", a.size, 0)


def a_noise_only(a_runs, b_runs):
    a, b = statistics.median(a_runs), statistics.median(b_runs)
    noise = max(a_runs) - min(a_runs)
    word = "inside the noise" if abs(b - a) <= noise else ("faster" if b < a else "slower")
    return b - a, noise, word


def no_noise(a_runs, b_runs):
    a, b = statistics.median(a_runs), statistics.median(b_runs)
    return b - a, 0.0, "faster" if b < a else "slower"


def settling_by_standard_error(values):
    n = len(values) // 3
    early, late = values[:n], values[-n:]
    a, b = statistics.median(early), statistics.median(late)
    mad = statistics.median(abs(x - b) for x in late)
    noise = 5.0 * 2 ** 0.5 * 1.2533 * 1.4826 * mad / n ** 0.5
    return {"first": a, "last": b, "noise": noise, "settled": abs(a - b) <= noise}


def serial_sum_as_frame(lines):
    """The frame read as the sum of its passes (what the bench once called the frame)."""
    frames, order = bench.read_timings(lines)
    return {f: sum(us for label, us in per.items() if label != bench.LOAD) / 1000.0
            for f, per in frames.items()}


def always_serial(run_once):
    return lambda build, size, last, extra, host, timeout, serial, **kw: run_once(
        build, size, last, extra, host, timeout, True, **kw)


def cpu_with_timestamps(run_once):
    def run(build, size, last, extra, host, timeout, serial, cpu=False):
        return run_once(build, size, last, extra + (["--timestamps"] if cpu else []), host,
                        timeout, serial, cpu)
    return run


MUTANTS = [
