def fake_run(name, targets, screen, buffers):
    """A run's directory as `wrela-host --targets` writes it: `targets` [(label, bytes)] in
    order (4x1 rgba8 each), `buffers` {handle: bytes}."""
    d = os.path.join(WORK, name)
    t = os.path.join(d, "targets")
    os.makedirs(t, exist_ok=True)
    listed = []
    for k, (label, raw) in enumerate(targets):
        open(os.path.join(t, f"target-{k}.raw"), "wb").write(raw)
        listed.append({"label": label, "file": f"target-{k}", "width": 4, "height": 1,
                       "format": "Rgba8"})
    for h, raw in buffers.items():
        open(os.path.join(t, f"buffer-{h}.raw"), "wb").write(raw)
    json.dump({"targets": listed, "buffers": [{"handle": h, "file": f"buffer-{h}",
                                               "bytes": len(r)} for h, r in buffers.items()]},
              open(os.path.join(t, "targets.json"), "w"))
    open(os.path.join(d, "screen.rgba"), "wb").write(screen)
    return d


def test_hosts_name_the_first_differing_pass():
    px = bytes(range(16))
    other = px[:9] + b"\xff" + px[10:]
    a = fake_run("ha", [("sky", px), ("solids", px), ("last", px)], px, {3: b"abcd"})
    b = fake_run("hb", [("sky", px), ("solids", other), ("last", other)], other, {3: b"abce"})
    diffs, targets, buffers = hosts.compare(a, b)
    assert (targets, buffers) == (3, 1)
    names = [d[0] for d in diffs]
    assert names == ["target `solids`", "target `last`", "the screen", "buffer 3"], diffs
    assert "texel (2, 0)" in diffs[0][1], diffs[0]
    same_dir = fake_run("hc", [("sky", px), ("solids", px), ("last", px)], px, {3: b"abcd"})
    assert hosts.compare(a, same_dir)[0] == []
    assert hosts.first_byte(b"x" * 10000 + b"a", b"x" * 10000 + b"b") == 10000
    assert hosts.first_byte(b"abc", b"abcd") == 3


