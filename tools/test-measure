    order = [(r["side"], r["run"]) for r in result["span_runs"]]
    assert order == [("A", 1), ("B", 1), ("A", 2), ("B", 2), ("A", 3), ("B", 3)], order
    assert [r["side"] for r in result["passes_runs"]] == ["A", "B"]


