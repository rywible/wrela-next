#!/usr/bin/env python3
"""Every shader of a build through its platform's own offline tool: `wrela shaders`, built first
if stale (tools/wrela). Usage:

    tools/shaders <build> [--jobs N]

Each `.metal` is compiled by Apple's `metal`, each `.spv` validated by `spirv-val`, N at a time
(default: the machine's cores), with the flags the test suite checks every shader it builds with
(toolchain/shader/src/offline.rs, which `wrela shaders` calls).

Exit status: 0 when every shader passes; 1 when one fails (each failure printed); 2 for a usage
error or a build with a shader whose tool this machine hasn't.
"""

import os
import sys

if __name__ == "__main__":
    wrela = os.path.join(os.path.dirname(os.path.abspath(__file__)), "wrela")
    os.execv(wrela, [wrela, "shaders", *sys.argv[1:]])
