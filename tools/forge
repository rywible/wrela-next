def cmd_synth(args):
    """Samples of a known program: the program's field sampled by a wrela tool (its surface
    found by the judge's own projection, its normals its gradient), so a fit to them has a known
    answer."""
    asset = args.pop(0)
    opts = parse_opts(args, {"--program": 1, "--field": 1, "--cell": 1, "--seed": 1})
    cfg = load_config(asset)
    d = asset_dir(asset)
    prog = os.path.abspath(opts.get("--program") or die("give --program <package dir>", 2))
    field = opts.get("--field") or die("give --field <module::fn>", 2)
    cell = float(opts.get("--cell", 0.004))
    t = os.path.join(d, "synth")
    os.makedirs(t, exist_ok=True)
    toml = open(os.path.join(prog, "wrela.toml")).read()
    pname = re.search(r'name\s*=\s*"([^"]+)"', toml).group(1)
    module, fn = field.rsplit("::", 1)
    with open(os.path.join(t, "wrela.toml"), "w") as f:
        f.write(f"[package]\nname = \"forge_{asset}_synth\"\n\n[dependencies]\n"
                f"engine = {{ path = \"{rel(os.path.join(ROOT, 'lib/engine'), t)}\" }}\n"
                f"{pname} = {{ path = \"{rel(prog, t)}\" }}\n")
    with open(os.path.join(t, "main.wrela"), "w") as f:
        f.write(f"""// Samples of a known program for `{asset}` (tools/forge synth): its surface, its sides, as
// numbers on lines, read back by the forge.

use engine::judge::samples::{{projected, surface_points}}
use {pname}::{module}::{fn}
use std::field::{{Surface, hash_u32}}
use std::io::print

fn unit(k: u32) -> f32 {{
    f32(hash_u32(k) >> 8) * (1.0 / 16777216.0)
}}

pub fn tool() -> u32 {{
    let f = {fn}()
    let b = f.bound()
    let lo = b.centre - vec3(b.radius)
    let hi = b.centre + vec3(b.radius)
    let pts = surface_points(f, lo, hi, cell: {cell})
    for q in pts {{
        let (_, g) = projected(f, q)
        let n = normalize(g)
        print(f"s {{q.x}} {{q.y}} {{q.z}} {{n.x}} {{n.y}} {{n.z}}")
    }}
    var k = {int(opts.get('--seed', 11)) * 7919}
    // Volume: near the surface each side, then through the whole box; each with its signed
    // distance (the program's own, which is exact or a bound: a bound is less, never more).
    var j = 0
    while j < 3 * pts.len() / 10 {{
        let i = hash_u32(k) % pts.len()
        k += 3
        let (_, g) = projected(f, pts[i])
        let n = normalize(g)
        let off = {cell} * (0.25 + 1.75 * unit(k))
        let side = if unit(k + 1) < 0.5 {{ -1.0 }} else {{ 1.0 }}
        k += 2
        let p = pts[i] + n * (off * side)
        print(f"v {{p.x}} {{p.y}} {{p.z}} {{f.distance(p)}}")
        j += 1
    }}
    var box_lo = vec3(1.0e30)
    var box_hi = vec3(-1.0e30)
    for q in pts {{
        box_lo = min(box_lo, q)
        box_hi = max(box_hi, q)
    }}
    let ext = (box_hi - box_lo) * 0.1 + vec3({cell})
    j = 0
    while j < 3 * pts.len() / 10 {{
        let u = vec3(unit(k), unit(k + 1), unit(k + 2))
        k += 3
        let p = box_lo - ext + u * (box_hi - box_lo + 2.0 * ext)
        print(f"v {{p.x}} {{p.y}} {{p.z}} {{f.distance(p)}}")
        j += 1
    }}
    0
}}
""")
    p = run([WRELA, "tool", t, "--timeout", "3000"])
    n = np()
    s, v = [], []
    for line in p.stdout.splitlines():
        parts = line.split()
        if parts and parts[0] == "s":
            s.append([float(x) for x in parts[1:7]])
        elif parts and parts[0] == "v":
            v.append([float(x) for x in parts[1:5]])
    s = n.array(s)
    v = n.array(v)
    os.makedirs(os.path.join(d, "reference"), exist_ok=True)
    out = os.path.join(d, "reference", "samples.bin")
    # Grid points projected crowd where the surface crosses cells at a slant; the spacing is the
    # cell's.
    write_samples(out, s[:, :3], s[:, 3:], v, None, cell)
    log_step(asset, {"step": "reference", "kind": "synthetic", "program": rel(prog, ROOT),
                     "field": field, "cell_m": cell, "surface": len(s), "volume": len(v),
                     "spacing_m": cell, "samples_sha256": sha256(out),
                     "program_sha256": tree_sha256(prog)})
    print(f"forge: {len(s)} surface and {len(v)} volume samples of {field} in "
          f"{os.path.relpath(out, ROOT)}")


def tree_sha256(d):
    h = hashlib.sha256()
    for base, dirs, files in sorted(os.walk(d)):
        dirs[:] = sorted(x for x in dirs if x not in ("build", "target"))
        for f in sorted(files):
            if f.endswith(".wrela") or f == "wrela.toml":
                p = os.path.join(base, f)
                h.update(os.path.relpath(p, d).encode() + b"\0" + open(p, "rb").read())
    return h.hexdigest()


# ---- literals ------------------------------------------------------------------------------------


def code_of(text):
    """`text` with its comments and strings blanked, the same length: what literals are counted in."""
    out = []
    i = 0
    while i < len(text):
        if text.startswith("//", i):
            j = text.find("\n", i)
            j = len(text) if j < 0 else j
            out.append(" " * (j - i))
            i = j
        elif text[i] == '"':
            j = i + 1
            while j < len(text) and text[j] != '"':
                j += 2 if text[j] == "\\" else 1
            out.append(" " * (j + 1 - i))
            i = j + 1
        else:
            out.append(text[i])
            i += 1
    return "".join(out)


def literals_of(path):
    """The float literals in a .wrela file's code (what a lifted build lifts, §23.1): each with
    its place and the name it is bound to, if a `const` or `let` binds it."""
    text = open(path).read()
    code = code_of(text)
    spans = named_spans(code)
    out = []
    for m in NUM_FLOAT.finditer(code):
        name = next((k for k, (a, b) in spans.items() if a <= m.start() < b), None)
        out.append({"at": m.start(), "text": m.group(0), "name": name})
    return out


def work_name(work):
    toml = open(os.path.join(work, "wrela.toml")).read()
    return re.search(r'name\s*=\s*"([^"]+)"', toml).group(1)


def named_spans(text):
    """Each `pub const NAME` / `const NAME` / `let NAME` binding's byte span in a file."""
    spans = {}
    for m in re.finditer(r"^\s*(?:pub\s+)?(?:const|let|var)\s+([A-Za-z_][A-Za-z0-9_]*)\b[^=]*=", text, re.M):
        start = m.end()
        depth, i = 0, start
        while i < len(text):
            ch = text[i]
            if ch in "([{":
                depth += 1
            elif ch in ")]}":
                depth -= 1
            elif ch == "\n" and depth <= 0:
                break
            i += 1
        spans.setdefault(m.group(1), (start, i))
    return spans


NUM = re.compile(r"(?<![A-Za-z_0-9.])(-?(?:\d+\.\d+(?:[eE][-+]?\d+)?|\d+)(?:mm|cm|m|deg|rad)?)(?![A-Za-z_0-9.])")
NUM_FLOAT = re.compile(r"(?<![A-Za-z_0-9.])(-?(?:\d+\.\d+(?:[eE][-+]?\d+)?(?:mm|cm|m|deg|rad)?|\d+(?:mm|cm|m|deg|rad)))(?![A-Za-z_0-9.])")
UNIT_SCALE = {"": 1.0, "m": 1.0, "cm": 0.01, "mm": 0.001, "deg": math.pi / 180.0, "rad": 1.0}


def split_num(tok):
    """Splits a float/unit literal token like `3.5mm` into (value_in_unit, suffix, decimals)."""
    for suf in ("mm", "cm", "deg", "rad", "m"):
        if tok.endswith(suf):
            body = tok[:-len(suf)]
            dec = len(body.split(".")[1].split("e")[0].split("E")[0]) if "." in body else 1
            return float(body), suf, dec
    dec = len(tok.split(".")[1].split("e")[0].split("E")[0]) if "." in tok else 0
    return float(tok), "", dec


def cmd_scramble(args):
    """Moves the work copy's literals bound to `names` off by up to `by` of themselves, each its
    own way (seeded): what the fitter must undo in the synthetic test."""
    asset = args.pop(0)
    opts = parse_opts(args, {"--names": 1, "--by": 1, "--move": 1, "--seed": 1})
    w = make_work(asset, fresh=True)
    import random
    rng = random.Random(int(opts.get("--seed", 3)))
    by = float(opts.get("--by", 0.1))
    move = float(opts.get("--move", 0.0))
    path = os.path.join(w, "asset.wrela")
    text = open(path).read()
    spans = named_spans(text)
    names = (opts.get("--names") or die("give --names A,B,...", 2)).split(",")
    edits = []
    for nm in names:
        if nm not in spans:
            die(f"the source binds no `{nm}`")
        a, b = spans[nm]
        for m in NUM_FLOAT.finditer(text, a, b):
            v, suf, decimals = split_num(m.group(0))
            if v == 0.0:
                continue
            # By a share of itself, or (`--move`) by up to that many metres, each its own way.
            step = move / UNIT_SCALE[suf]
            nv = v + step * (2.0 * rng.random() - 1.0) if move > 0 else v * (1.0 + by * (2.0 * rng.random() - 1.0))
            edits.append((m.start(), m.end(), f"{nv:.{max(decimals, 4)}f}{suf}"))
    for s0, e0, t in sorted(edits, reverse=True):
        text = text[:s0] + t + text[e0:]
    open(path, "w").write(text)
    log_step(asset, {"step": "scramble", "names": names, "by": by, "move_m": move, "seed": int(opts.get("--seed", 3)),
                     "literals": len(edits), "work_sha256": sha256(path)})
    how = f"{move * 1000:g} mm" if move > 0 else f"{by:.0%}"
    print(f"forge: scrambled {len(edits)} literals of {', '.join(names)} by up to {how}")


