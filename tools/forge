DEFAULT_STAGES = [
    {"name": "proportions", "surface": 768, "volume": 256, "steps": 40},
    {"name": "parts", "surface": 1536, "volume": 512, "steps": 60},
    {"name": "ornament", "surface": 2048, "volume": 512, "steps": 60},
