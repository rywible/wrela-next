def cmd_fit(args):
    """Fits the work copy's literals, stage by stage, coarse to fine: each stage frees the names
    its `free` lists (forge.json's `stages`) and fits the misses of its samples by `wrela solve
    --fit`. `--starts K` tries K starting values for each stage's first literal (a motif's phase
    along its path, say: a loss of many minima) and keeps the best. `--write` copies the fitted
    copy over the source."""
    asset = args.pop(0)
    opts = parse_opts(args, {"--stage": -1, "--steps": 1, "--starts": 1, "--write": 0, "--sigma": 1, "--dry": 0})
    dry = "--dry" in opts
    cfg = load_config(asset)
    stages = cfg.get("stages") or die("forge.json has no `stages`: name what each frees", 1)
    only = opts.get("--stage") or []
    w = make_work(asset)
    sigma = float(opts.get("--sigma", 0.001))
    logs = []
    for st in stages:
        if only and st["name"] not in only:
            continue
        surface, volume = st.get("surface", 1024), st.get("volume", 256)
        write_fit(asset, surface, volume, sigma)
        free = "asset.wrela:" + ",".join(st["free"])
        steps = str(opts.get("--steps", st.get("steps", 60)))
        starts = int(opts.get("--starts", st.get("starts", 1)))
        best = None
        tried = []
        base_text = open(os.path.join(w, "asset.wrela")).read()
        for k in range(starts):
            text = base_text
            if k > 0:
                text = moved_first(base_text, st["free"][0], k, starts)
            open(os.path.join(w, "asset.wrela"), "w").write(text)
            began = time.time()
            p = run([WRELA, "solve", w, "--fit", "fit::residuals", "--free", free, "--steps", steps,
                     "--json"] + ([] if dry else ["--write"]), check=False)
            rep = last_json(p.stdout) or {"solved": False, "why": p.stderr[-2000:]}
            rep["seconds"] = round(time.time() - began, 1)
            rep["start"] = k
            tried.append({"start": k, "loss_after": rep.get("loss_after"), "seconds": rep["seconds"]})
            if not rep.get("solved"):
                die(f"stage {st['name']}: the solve failed: {rep.get('why', '')[-1500:]}")
            if best is None or rep["loss_after"] < best[0]["loss_after"]:
                best = (rep, open(os.path.join(w, "asset.wrela")).read())
        rep, text = best
        open(os.path.join(w, "asset.wrela"), "w").write(text)
        dead = [f"{l['file']}:{l['line']} {l['text']}" for l in rep.get("literals", []) if not l.get("changes")]
        entry = {"stage": st["name"], "free": st["free"], "surface": surface, "volume": volume,
                 "sigma_m": sigma, "steps": rep.get("steps"), "loss_before": rep.get("loss_before"),
                 "loss_after": rep.get("loss_after"), "literals": len(rep.get("literals", [])),
                 "dead": dead, "starts": tried, "seconds": rep["seconds"]}
        logs.append(entry)
        os.makedirs(os.path.join(asset_dir(asset), "fits"), exist_ok=True)
        with open(os.path.join(asset_dir(asset), "fits", f"{st['name']}.json"), "w") as f:
            json.dump(rep, f, indent=2)
        print(f"forge: fit {st['name']}: loss {rep.get('loss_before'):.4g} -> {rep.get('loss_after'):.4g} "
              f"in {rep.get('steps')} steps over {entry['literals']} literals, {len(dead)} never moved, "
              f"{rep['seconds']} s")
    log_step(asset, {"step": "fit", "dry": dry, "stages": logs, "work_sha256": sha256(os.path.join(w, "asset.wrela"))})
    if "--write" in opts and not dry:
        src = os.path.join(ROOT, cfg["source"])
        if cfg.get("work_from_sha256") and sha256(src) != cfg["work_from_sha256"]:
            die(f"{cfg['source']} changed since the work copy was taken: not written over")
        shutil.copyfile(os.path.join(w, "asset.wrela"), src)
        cfg = load_config(asset)
        cfg["work_from_sha256"] = sha256(src)
        save_config(asset, cfg)
        print(f"forge: wrote the fitted literals to {cfg['source']}")


def moved_first(text, name, k, starts):
    """`text` with the first literal bound to `name` moved to its k-th of `starts` starting values
    (spread over ±50% of it)."""
    spans = named_spans(text)
    if name not in spans:
        return text
    a, b = spans[name]
    m = NUM_FLOAT.search(text, a, b)
    if not m:
        return text
    v, suf, dec = split_num(m.group(0))
    nv = v * (0.5 + k / max(starts - 1, 1))
    return text[:m.start()] + f"{nv:.{max(dec, 4)}f}{suf}" + text[m.end():]


