def rel(a, b):
    return os.path.relpath(a, b)


def module_of(cfg):
    return os.path.splitext(os.path.basename(cfg["source"]))[0]


def make_work(asset, fresh=False):
    """The work package: a copy of the asset's source (`asset.wrela`) beside the reference's
    samples, and the fit's misses (`fit.wrela`), its dependencies the source package's. Kept
    across fits; `fresh` copies the source again."""
    cfg = load_config(asset)
    d = asset_dir(asset)
    w = os.path.join(d, "work")
    os.makedirs(w, exist_ok=True)
    src = os.path.join(ROOT, cfg["source"])
    copy = os.path.join(w, "asset.wrela")
    # An author who edits the source after a fit means the edit: the copy is taken again.
    edited = cfg.get("work_from_sha256") not in (None, sha256(src))
    if edited and not fresh:
        print(f"forge: {cfg['source']} changed since the work copy was taken: taking it again", file=sys.stderr)
    if fresh or edited or not os.path.exists(copy):
        shutil.copyfile(src, copy)
        cfg["work_from_sha256"] = sha256(src)
        save_config(asset, cfg)
    samples = os.path.join(d, "reference", "samples.bin")
    if os.path.exists(samples):
        shutil.copyfile(samples, os.path.join(w, "samples.bin"))
    elif os.path.exists(os.path.join(w, "samples.bin")):
        os.remove(os.path.join(w, "samples.bin"))
    with open(os.path.join(w, "wrela.toml"), "w") as f:
        f.write(f"# The forge's work package for `{asset}` (tools/forge): a copy of its source and "
                f"its reference's samples.\n[package]\nname = \"forge_{asset}\"\n\n[dependencies]\n"
                f"engine = {{ path = \"{rel(os.path.join(ROOT, 'lib/engine'), w)}\" }}\n"
                f"kit = {{ path = \"{rel(os.path.join(ROOT, 'lib/kit'), w)}\" }}\n")
    return w


