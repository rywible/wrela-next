#!/usr/bin/env python3
"""The forge: the authoring pipeline from a brief to a gold asset. Usage:

    tools/forge new <asset> --source game/world/<file>.wrela --field <fn> --size X,Y,Z
                [--brief "<text>"] [--gold]       (a gold asset's record goes beside its source)
    tools/forge prompts <asset>               the concept views' prompts, from the brief, linted
    tools/forge lint "<prompt>"...            a prompt against the forge's rules (exit 1 if broken)
    tools/forge reference <asset> --mesh <file.glb|.obj|.ply> [--up y|z] [--seed N]
                [--surface N] [--volume N] [--model NAME --version V]
                                              a reference mesh turned into samples
    tools/forge synth <asset> --program <dir> --field <module::fn> [--cell M]
                                              samples of a known program (a synthetic reference)
    tools/forge scramble <asset> --names A,B,... [--by F] [--seed N]
                                              the work copy's named literals moved off (a test)
    tools/forge fit <asset> [--stage NAME]... [--steps N] [--starts K] [--write] [--dry]
                                              the work copy's free literals fitted, coarse to fine
    tools/forge judge <asset> [--brute] [--of work|source]
                                              the asset's numbers against its reference
    tools/forge look <asset> --render <png> --concept <png>
                                              a render against a concept image, exposure matched
    tools/forge record <asset>                the provenance record, next to the source
    tools/forge replay <asset>                the chain run again from its record, and compared
    tools/forge test                          the forge's own checks (no GPU)

An asset's working material is in .forge/<asset>/ (git-ignored): its brief, prompts, concept
images, reference mesh and samples, the work package the fitter runs on (a copy of the asset's
source beside the samples it embeds), fit logs and scores. Nothing in game/ or lib/ reads it. What
ships is the .wrela file in game/, and its provenance record beside it (<file>.provenance.json).

The fitter is `wrela solve --fit` (language.md §23.9) over the work copy: the misses of a stage's
samples (lib/engine/judge/samples.wrela, `misses`) made small by Levenberg-Marquardt on the copy's
literals, which `wrela edit` writes back in the form they were written. `fit --write` copies the
fitted file over the source in game/, refusing if the source changed since the copy was taken.

Prompts never name another game, film, book, character or living artist, and never ask for a
style "of" anyone: they describe the thing itself (`lint`).

Exit status: 0 done; 1 a check failed or a step refused; 2 a usage error.
"""

import hashlib
import json
import math
import os
import re
import shutil
import struct
import subprocess
import sys
import tempfile
import time

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
FORGE = os.path.join(ROOT, ".forge")
WRELA = os.path.join(ROOT, "tools", "wrela")

MAGIC = b"WFS1"
HEAD = 32


def die(msg, code=1):
    print(f"forge: {msg}", file=sys.stderr)
    sys.exit(code)


def sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def now():
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


# ---- the workspace -------------------------------------------------------------------------------


def asset_dir(asset):
    if not re.fullmatch(r"[a-z][a-z0-9_]*", asset or ""):
        die(f"an asset's name is lower case letters, digits and _: `{asset}`", 2)
    return os.path.join(FORGE, asset)


def load_config(asset):
    p = os.path.join(asset_dir(asset), "forge.json")
    if not os.path.exists(p):
        die(f"no asset `{asset}`: make it with `tools/forge new {asset} ...`")
    with open(p) as f:
        return json.load(f)


def save_config(asset, cfg):
    with open(os.path.join(asset_dir(asset), "forge.json"), "w") as f:
        json.dump(cfg, f, indent=2)
        f.write("\n")


# The command line of the step running now (its options after the asset), kept in its record so
# `replay` can run it again.
RUNNING = {"command": None, "args": []}


def log_step(asset, step):
    """Appends a step to the asset's chain (its record's `chain`), with the command that made it."""
    cfg = load_config(asset)
    step = dict(step, at=now(), command=RUNNING["command"], args=RUNNING["args"])
    cfg.setdefault("chain", []).append(step)
    save_config(asset, cfg)


def cmd_new(args):
    asset = args.pop(0)
    opts = parse_opts(args, {"--source": 1, "--field": 1, "--size": 1, "--brief": 1, "--gold": 0})
    d = asset_dir(asset)
    if os.path.exists(os.path.join(d, "forge.json")):
        die(f"`{asset}` already exists in {d}")
    src = opts.get("--source") or die("give --source game/world/<file>.wrela", 2)
    if not os.path.exists(os.path.join(ROOT, src)):
        die(f"no source `{src}`")
    field = opts.get("--field") or die("give --field <fn>, the function that gives its shape", 2)
    size = [float(v) for v in (opts.get("--size") or die("give --size X,Y,Z (m)", 2)).split(",")]
    os.makedirs(d, exist_ok=True)
    brief = opts.get("--brief", "")
    with open(os.path.join(d, "brief.md"), "w") as f:
        f.write(brief.strip() + "\n")
    save_config(asset, {"asset": asset, "source": src, "field": field, "size": size,
                        "gold": "--gold" in opts, "chain": []})
    print(f"forge: {asset} in {os.path.relpath(d, ROOT)}")


# ---- prompts -------------------------------------------------------------------------------------

# A prompt says what the thing is. It never asks for a style of anyone or anything, and never
# names a work or a maker (AGENTS.md). The list catches the common forms;
# a name the list doesn't know is the author's to keep out, and the record keeps every prompt.
BANNED = [
    (r"\bin the style of\b", "asks for someone's style"),
    (r"\bstyle of\b", "asks for someone's style"),
    (r"\b(inspired by|reminiscent of|like in|as seen in|from the (?:game|film|movie|show|book|series))\b",
     "points at another work"),
    (r"\b(artstation|deviantart|unreal engine|octane|by greg|trending on)\b", "names a maker or a site"),
    (r"\b(harry potter|hogwarts|dumbledore|voldemort|clair obscur|expedition 33|lord of the rings|"
     r"skyrim|elden ring|dark souls|witcher|zelda|disney|pixar|marvel|warhammer)\b",
     "names another work or its characters"),
    (r"\b[A-Z][a-z]+ [A-Z][a-z]+'s\b", "credits a named person"),
]


def lint(prompt):
    """The rules `prompt` breaks, each with why."""
    out = []
    for pat, why in BANNED:
        flags = 0 if "[A-Z]" in pat else re.IGNORECASE
        m = re.search(pat, prompt, flags)
        if m:
            out.append(f"`{m.group(0)}`: {why}")
    return out


def cmd_lint(args):
    bad = 0
    for p in args:
        faults = lint(p)
        for f in faults:
            print(f"forge: lint: {f}")
        bad += bool(faults)
    sys.exit(1 if bad else 0)


VIEWS = [
    ("front", "seen straight from the front, at the height of its middle"),
    ("side", "seen straight from its right side, at the height of its middle"),
    ("top", "seen straight from above"),
    ("three_quarter", "seen from the front right and a little above, three-quarter view"),
    ("ornament", "a close-up of its carved ornament, filling the frame"),
]


def cmd_prompts(args):
    asset = args.pop(0)
    d = asset_dir(asset)
    brief = open(os.path.join(d, "brief.md")).read().strip()
    if not brief:
        die("the brief is empty: write .forge/<asset>/brief.md first")
    prompts = []
    for view, how in VIEWS:
        text = (f"{brief} Product photograph of the object alone, {how}, on a plain mid-grey "
                f"background, soft even studio light from all sides, no shadows on the background, "
                f"sharp focus, true colours, no text, no people.")
        faults = lint(text)
        if faults:
            die(f"the {view} prompt breaks the rules: " + "; ".join(faults))
        prompts.append({"view": view, "prompt": text})
    with open(os.path.join(d, "prompts.json"), "w") as f:
        json.dump(prompts, f, indent=2)
        f.write("\n")
    log_step(asset, {"step": "prompts", "count": len(prompts),
                     "prompts_sha256": sha256(os.path.join(d, "prompts.json"))})
    print(f"forge: {len(prompts)} prompts in {os.path.relpath(os.path.join(d, 'prompts.json'), ROOT)}")


# ---- meshes --------------------------------------------------------------------------------------


def np():
    import numpy
    return numpy


def load_mesh(path):
    """(vertices N×3, faces M×3, colours N×3 or None, uv N×2 or None, texture HxWx3 or None)."""
    ext = os.path.splitext(path)[1].lower()
    if ext == ".obj":
        return load_obj(path)
    if ext == ".ply":
        return load_ply(path)
    if ext in (".glb", ".gltf"):
        return load_glb(path)
    die(f"a reference mesh is .glb, .obj or .ply: `{path}`", 2)


def load_obj(path):
    n = np()
    vs, cs, fs = [], [], []
    with open(path) as f:
        for line in f:
            p = line.split()
            if not p:
                continue
            if p[0] == "v":
                vs.append([float(x) for x in p[1:4]])
                if len(p) >= 7:
                    cs.append([float(x) for x in p[4:7]])
            elif p[0] == "f":
                idx = [int(q.split("/")[0]) for q in p[1:]]
                idx = [i - 1 if i > 0 else len(vs) + i for i in idx]
                for k in range(1, len(idx) - 1):
                    fs.append([idx[0], idx[k], idx[k + 1]])
    col = n.array(cs, dtype=n.float64) if len(cs) == len(vs) and cs else None
    return n.array(vs, dtype=n.float64), n.array(fs, dtype=n.int64), col, None, None


def load_ply(path):
    n = np()
    with open(path, "rb") as f:
        header = []
        while True:
            line = f.readline().decode("ascii").strip()
            header.append(line)
            if line == "end_header":
                break
        fmt = next(h.split()[1] for h in header if h.startswith("format"))
        elems, cur = [], None
        for h in header:
            p = h.split()
            if p[0] == "element":
                cur = {"name": p[1], "count": int(p[2]), "props": []}
                elems.append(cur)
            elif p[0] == "property":
                cur["props"].append(p[1:])
        types = {"char": "b", "uchar": "B", "short": "h", "ushort": "H", "int": "i", "uint": "I",
                 "float": "f", "double": "d", "int8": "b", "uint8": "B", "int16": "h", "uint16": "H",
                 "int32": "i", "uint32": "I", "float32": "f", "float64": "d"}
        verts, faces = None, []
        if fmt == "ascii":
            data = f.read().decode("ascii").split()
            pos = 0
            for e in elems:
                rows = []
                for _ in range(e["count"]):
                    row = []
                    for pr in e["props"]:
                        if pr[0] == "list":
                            k = int(data[pos]); pos += 1
                            row.append([float(x) for x in data[pos:pos + k]]); pos += k
                        else:
                            row.append(float(data[pos])); pos += 1
                    rows.append(row)
                e["rows"] = rows
        else:
            endian = "<" if "little" in fmt else ">"
            for e in elems:
                rows = []
                for _ in range(e["count"]):
                    row = []
                    for pr in e["props"]:
                        if pr[0] == "list":
                            (k,) = struct.unpack(endian + types[pr[1]], f.read(struct.calcsize(types[pr[1]])))
                            t = types[pr[2]]
                            row.append(list(struct.unpack(endian + t * k, f.read(struct.calcsize(t) * k))))
                        else:
                            t = types[pr[0]]
                            (v,) = struct.unpack(endian + t, f.read(struct.calcsize(t)))
                            row.append(v)
                    rows.append(row)
                e["rows"] = rows
    for e in elems:
        names = [pr[-1] for pr in e["props"]]
        if e["name"] == "vertex":
            a = n.array(e["rows"], dtype=n.float64)
            verts = a[:, [names.index("x"), names.index("y"), names.index("z")]]
            col = None
            if "red" in names:
                col = a[:, [names.index("red"), names.index("green"), names.index("blue")]] / 255.0
        elif e["name"] == "face":
            for row in e["rows"]:
                idx = [int(i) for i in row[0]]
                for k in range(1, len(idx) - 1):
                    faces.append([idx[0], idx[k], idx[k + 1]])
    return verts, n.array(faces, dtype=n.int64), col, None, None


def load_glb(path):
    """A binary glTF's meshes, every primitive's node transforms applied: positions, triangles,
    vertex colours or the base colour texture and its coordinates (TRELLIS.2 writes these)."""
    n = np()
    raw = open(path, "rb").read()
    if raw[:4] != b"glTF":
        die(f"`{path}` isn't a binary glTF")
    off = 12
    js, binc = None, b""
    while off < len(raw):
        ln, kind = struct.unpack_from("<II", raw, off)
        chunk = raw[off + 8: off + 8 + ln]
        if kind == 0x4E4F534A:
            js = json.loads(chunk)
        elif kind == 0x004E4942:
            binc = chunk
        off += 8 + ln
    comp = {5120: "b", 5121: "B", 5122: "h", 5123: "H", 5125: "I", 5126: "f"}
    width = {"SCALAR": 1, "VEC2": 2, "VEC3": 3, "VEC4": 4, "MAT4": 16}

    def accessor(i):
        a = js["accessors"][i]
        bv = js["bufferViews"][a["bufferView"]]
        t = comp[a["componentType"]]
        k = width[a["type"]]
        start = bv.get("byteOffset", 0) + a.get("byteOffset", 0)
        stride = bv.get("byteStride", 0) or struct.calcsize(t) * k
        dt = n.dtype("<" + t)
        out = n.empty((a["count"], k), dtype=dt)
        for r in range(a["count"]):
            out[r] = n.frombuffer(binc, dtype=dt, count=k, offset=start + r * stride)
        if a.get("normalized"):
            out = out.astype(n.float64) / {"B": 255.0, "H": 65535.0, "b": 127.0, "h": 32767.0}.get(t, 1.0)
        return out

    def node_matrix(nd):
        if "matrix" in nd:
            return n.array(nd["matrix"], dtype=n.float64).reshape(4, 4).T
        m = n.eye(4)
        if "scale" in nd:
            m = n.diag(list(nd["scale"]) + [1.0]) @ m
        if "rotation" in nd:
            x, y, z, w = nd["rotation"]
            r = n.array([[1 - 2 * (y * y + z * z), 2 * (x * y - z * w), 2 * (x * z + y * w)],
                         [2 * (x * y + z * w), 1 - 2 * (x * x + z * z), 2 * (y * z - x * w)],
                         [2 * (x * z - y * w), 2 * (y * z + x * w), 1 - 2 * (x * x + y * y)]])
            rm = n.eye(4); rm[:3, :3] = r
            m = rm @ m
        if "translation" in nd:
            t = n.eye(4); t[:3, 3] = nd["translation"]
            m = t @ m
        return m

    verts, faces, cols, uvs, tex = [], [], [], [], None

    def visit(i, parent):
        nd = js["nodes"][i]
        m = parent @ node_matrix(nd)
        if "mesh" in nd:
            for prim in js["meshes"][nd["mesh"]]["primitives"]:
                if prim.get("mode", 4) != 4:
                    continue
                p = accessor(prim["attributes"]["POSITION"]).astype(n.float64)
                p = (n.c_[p, n.ones(len(p))] @ m.T)[:, :3]
                base = sum(len(v) for v in verts)
                idx = (accessor(prim["indices"]).reshape(-1) if "indices" in prim
                       else n.arange(len(p))).astype(n.int64)
                verts.append(p)
                faces.append(idx.reshape(-1, 3) + base)
                at = prim["attributes"]
                cols.append(accessor(at["COLOR_0"])[:, :3].astype(n.float64) if "COLOR_0" in at else None)
                uvs.append(accessor(at["TEXCOORD_0"]).astype(n.float64) if "TEXCOORD_0" in at else None)
                nonlocal tex
                if tex is None and "material" in prim:
                    pbr = js["materials"][prim["material"]].get("pbrMetallicRoughness", {})
                    if "baseColorTexture" in pbr:
                        img = js["images"][js["textures"][pbr["baseColorTexture"]["index"]]["source"]]
                        bv = js["bufferViews"][img["bufferView"]]
                        from io import BytesIO
                        from PIL import Image
                        data = binc[bv.get("byteOffset", 0): bv.get("byteOffset", 0) + bv["byteLength"]]
                        tex = n.asarray(Image.open(BytesIO(data)).convert("RGB"), dtype=n.float64) / 255.0
        for c in nd.get("children", []):
            visit(c, m)

    scene = js.get("scenes", [{"nodes": list(range(len(js.get("nodes", []))))}])[js.get("scene", 0)]
    for i in scene["nodes"]:
        visit(i, n.eye(4))
    v = n.concatenate(verts)
    f = n.concatenate(faces)
    col = n.concatenate(cols) if all(c is not None for c in cols) else None
    uv = n.concatenate(uvs) if all(u is not None for u in uvs) and tex is not None else None
    return v, f, col, uv, tex


def srgb_to_linear(c):
    n = np()
    return n.where(c <= 0.04045, c / 12.92, ((c + 0.055) / 1.055) ** 2.4)


def mesh_samples(v, f, col, uv, tex, surface, volume, seed):
    """Area-weighted surface samples with their faces' normals, colours where the mesh has them,
    and volume samples a little off the surface each side (their side from the normal), and some
    far outside."""
    n = np()
    rng = n.random.default_rng(seed)
    a, b, c = v[f[:, 0]], v[f[:, 1]], v[f[:, 2]]
    cr = n.cross(b - a, c - a)
    area2 = n.linalg.norm(cr, axis=1)
    keep = area2 > 1e-18
    f, a, b, c, cr, area2 = f[keep], a[keep], b[keep], c[keep], cr[keep], area2[keep]
    total = 0.5 * area2.sum()
    pick = rng.choice(len(f), size=surface, p=area2 / area2.sum())
    r1 = n.sqrt(rng.random(surface))
    r2 = rng.random(surface)
    w0, w1, w2 = 1 - r1, r1 * (1 - r2), r1 * r2
    pts = a[pick] * w0[:, None] + b[pick] * w1[:, None] + c[pick] * w2[:, None]
    nrm = cr[pick] / area2[pick][:, None]
    colours = None
    if col is not None:
        cc = col[f[pick]]
        colours = cc[:, 0] * w0[:, None] + cc[:, 1] * w1[:, None] + cc[:, 2] * w2[:, None]
    elif uv is not None and tex is not None:
        uu = uv[f[pick]]
        t = uu[:, 0] * w0[:, None] + uu[:, 1] * w1[:, None] + uu[:, 2] * w2[:, None]
        h, wd = tex.shape[:2]
        x = n.clip((t[:, 0] % 1.0) * (wd - 1), 0, wd - 1).astype(int)
        y = n.clip((t[:, 1] % 1.0) * (h - 1), 0, h - 1).astype(int)
        colours = srgb_to_linear(tex[y, x])
    spacing = math.sqrt(total / surface)
    # Volume: half near the surface each side (up to two spacings off, their side from the
    # normal), half through the whole box (their side from the mesh's own inside: `solid_grid`).
    near = volume // 2
    i = rng.integers(0, surface, size=near)
    off = spacing * (0.25 + 1.75 * rng.random(near))
    side = n.where(rng.random(near) < 0.5, -1.0, 1.0)
    vp = pts[i] + nrm[i] * (off * side)[:, None]
    lo, hi = pts.min(0), pts.max(0)
    ext = (hi - lo) * 0.1 + spacing
    bp = lo - ext + rng.random((volume - near, 3)) * (hi - lo + 2 * ext)
    solid, glo, gcell = solid_grid(v, f, lo - ext, hi + ext, 256)
    gi = n.clip(((bp - glo) / gcell).astype(int), 0, n.array(solid.shape) - 1)
    bside = n.where(solid[gi[:, 0], gi[:, 1], gi[:, 2]], -1.0, 1.0)
    bdist, bfacing, bplane = nearest_distance(bp, pts, nrm, spacing)
    # Within a cell and a half of the fill of the surface, its cells can't tell (a point and its
    # cell's middle can be either side): where the point lies over its nearest sample (within a
    # spacing of it along its plane), the sample's plane says which side.
    bside = n.where(bplane < 1.5 * gcell, bfacing, bside)
    vdist, _, _ = nearest_distance(vp, pts, nrm, spacing)
    vol = n.c_[n.r_[vp, bp], n.r_[side * vdist, bside * bdist]]
    return pts, nrm, colours, vol, spacing, total


def nearest_distance(q, pts, nrm, spacing):
    """Each of `q`'s distance from the surface its samples say: to the plane of its nearest
    sample, as far as half the spacing reaches along it (the judge's `to_sample`); which side of
    that sample's plane it is on (1 the side its normal points to); and how far from the plane
    it is where it lies over the sample (within a spacing of it along the plane; else infinite)."""
    n = np()
    out = n.empty(len(q))
    facing = n.empty(len(q))
    plane = n.empty(len(q))
    for a in range(0, len(q), 512):
        b = q[a:a + 512]
        d2 = ((b[:, None, :] - pts[None, :, :]) ** 2).sum(-1)
        k = d2.argmin(1)
        vv = b - pts[k]
        along = (vv * nrm[k]).sum(1)
        lateral = n.linalg.norm(vv - nrm[k] * along[:, None], axis=1)
        across = n.maximum(lateral - 0.5 * spacing, 0)
        out[a:a + 512] = n.sqrt(along ** 2 + across ** 2)
        facing[a:a + 512] = n.where(along < 0, -1.0, 1.0)
        plane[a:a + 512] = n.where(lateral < spacing, n.abs(along), n.inf)
    return out, facing, plane


def solid_grid(v, f, lo, hi, res):
    """Which cells of a grid over `lo`..`hi` (`res` along its longest side) lie inside the mesh:
    each column along z crossed by the triangles over it, the cells between an odd and an even
    crossing inside (the even-odd rule, as a scanline fills)."""
    n = np()
    size = hi - lo
    cell = size.max() / res
    dims = n.maximum(n.ceil(size / cell).astype(int), 1)
    a, b, c = v[f[:, 0]], v[f[:, 1]], v[f[:, 2]]
    # Each triangle's column centres in x, y it covers.
    tlo = n.minimum(n.minimum(a, b), c)[:, :2]
    thi = n.maximum(n.maximum(a, b), c)[:, :2]
    ilo = n.ceil((tlo - lo[:2]) / cell - 0.5).astype(int)
    ihi = n.floor((thi - lo[:2]) / cell - 0.5).astype(int)
    cols = {}
    span = n.maximum(ihi - ilo + 1, 0)
    for sx in range(int(span[:, 0].max(initial=0))):
        for sy in range(int(span[:, 1].max(initial=0))):
            m = (span[:, 0] > sx) & (span[:, 1] > sy)
            if not m.any():
                continue
            ix, iy = ilo[m, 0] + sx, ilo[m, 1] + sy
            px = lo[0] + (ix + 0.5) * cell
            py = lo[1] + (iy + 0.5) * cell
            A, B, C = a[m], b[m], c[m]
            # Barycentrics of (px, py) in the triangle's projection.
            d = (B[:, 1] - C[:, 1]) * (A[:, 0] - C[:, 0]) + (C[:, 0] - B[:, 0]) * (A[:, 1] - C[:, 1])
            ok = n.abs(d) > 1e-20
            d = n.where(ok, d, 1.0)
            l1 = ((B[:, 1] - C[:, 1]) * (px - C[:, 0]) + (C[:, 0] - B[:, 0]) * (py - C[:, 1])) / d
            l2 = ((C[:, 1] - A[:, 1]) * (px - C[:, 0]) + (A[:, 0] - C[:, 0]) * (py - C[:, 1])) / d
            l3 = 1 - l1 - l2
            hit = ok & (l1 >= 0) & (l2 >= 0) & (l3 > 0)
            z = l1 * A[:, 2] + l2 * B[:, 2] + l3 * C[:, 2]
            for x, y, zz in zip(ix[hit], iy[hit], z[hit]):
                if 0 <= x < dims[0] and 0 <= y < dims[1]:
                    cols.setdefault((int(x), int(y)), []).append(float(zz))
    solid = n.zeros(dims, dtype=bool)
    zc = lo[2] + (n.arange(dims[2]) + 0.5) * cell
    for (x, y), zs in cols.items():
        zs = sorted(zs)
        for k in range(0, len(zs) - 1, 2):
            solid[x, y, (zc >= zs[k]) & (zc <= zs[k + 1])] = True
    return solid, lo, cell


def write_samples(path, pts, nrm, vol, colours, spacing, cpts=None):
    n = np()
    nc = 0 if colours is None else len(colours)
    with open(path, "wb") as f:
        f.write(MAGIC + struct.pack("<IIIf", len(pts), len(vol), nc, spacing) + b"\0" * 12)
        f.write(n.c_[pts, nrm].astype("<f4").tobytes())
        f.write(n.asarray(vol).astype("<f4").tobytes())
        if nc:
            f.write(n.c_[pts if cpts is None else cpts, colours].astype("<f4").tobytes())


def read_samples(path):
    n = np()
    raw = open(path, "rb").read()
    if raw[:4] != MAGIC:
        die(f"`{path}` isn't a samples file")
    ns, nv, nc, spacing = struct.unpack_from("<IIIf", raw, 4)
    a = n.frombuffer(raw, dtype="<f4", count=ns * 6, offset=HEAD).reshape(ns, 6)
    b = n.frombuffer(raw, dtype="<f4", count=nv * 4, offset=HEAD + 24 * ns).reshape(nv, 4)
    c = n.frombuffer(raw, dtype="<f4", count=nc * 6, offset=HEAD + 24 * ns + 16 * nv).reshape(nc, 6)
    return a, b, c, spacing


def align(v, size, up):
    """The mesh in the asset's frame: up the y axis, its feet at y = 0 and its middle over the
    origin, scaled uniformly so its height is the brief's. Returns the vertices and the transform
    (scale, offset), applied as v * scale + offset after the axis swap."""
    n = np()
    if up == "z":
        v = v[:, [0, 2, 1]] * n.array([1.0, 1.0, -1.0])
    lo, hi = v.min(0), v.max(0)
    scale = size[1] / max(hi[1] - lo[1], 1e-12)
    mid = 0.5 * (lo + hi)
    offset = n.array([-mid[0] * scale, -lo[1] * scale, -mid[2] * scale])
    return v * scale + offset, float(scale), offset.tolist()


