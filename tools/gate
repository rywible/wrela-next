KEY_PATHS = ["lib", "game", "toolchain", "tools"]
KEY_SKIP = {"tools/gate.json"}


def run(cmd, **kw):
    return subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, **kw)


# Runs kept by what they ran (the doc's "A RUN IS KEPT BY WHAT IT RAN").
KEPT = {"on": True, "machine": None, "tools": None, "builds": {}, "taken": 0, "ran": 0, "build_now": None}


class Kept:
    """A kept run, as `subprocess.run` gives one."""

    def __init__(self, stdout):
        self.stdout = stdout
        self.returncode = 0
        self.kept = True


def file_hash(h, path):
    try:
        with open(path, "rb") as f:
            for block in iter(lambda: f.read(1 << 20), b""):
                h.update(block)
    except OSError:
        h.update(b"(missing)")


def tools_hash():
    """The bytes of what runs a build: the tools and the host."""
    if KEPT["tools"] is None:
        h = hashlib.sha256()
        for name in ("gpu", "audit", "bench", "gpulock.py", "wrela-host"):
            file_hash(h, os.path.join(TOOLS, name))
        file_hash(h, os.path.join(ROOT, "toolchain", "target", "release", "wrela-host"))
        KEPT["tools"] = h.hexdigest()
    return KEPT["tools"]


def build_hash(out):
    """The bytes of the build in `out`: its manifest and what the manifest names."""
    if out not in KEPT["builds"]:
        h = hashlib.sha256()
        try:
            with open(os.path.join(out, "manifest.json"), "rb") as f:
                raw = f.read()
            h.update(raw)
            m = json.loads(raw)
            names = sorted({p["shader"] for p in m.get("pipelines", [])} | {str(m.get("wasm"))})
            for name in names:
                h.update(name.encode())
                file_hash(h, os.path.join(out, name))
        except (OSError, ValueError, KeyError, TypeError):
            return None
        KEPT["builds"][out] = h.hexdigest()
    return KEPT["builds"][out]


def kept_path(key):
    base = os.environ.get("WRELA_GATE_RUNS") or os.path.expanduser("~/.wrela/gate-runs")
    return os.path.join(base, KEPT["machine"] or "any", key + ".json")


def run_kept(cmd, out, tmp, files=(), env=None, extra=""):
    """Runs `cmd` on the build in `out`, or takes what the same run printed before (and the
    `files` it wrote): the same build, tools, host and arguments (with `tmp`, where this gate's
    builds are, left out of them)."""
    bh = build_hash(out) if KEPT["on"] else None
    key = None
    if bh is not None:
        h = hashlib.sha256()
        h.update(bh.encode())
        h.update(tools_hash().encode())
        h.update(json.dumps([a.replace(tmp, "@") for a in cmd]).encode())
        h.update(extra.encode())
        key = h.hexdigest()[:40]
        try:
            with open(kept_path(key)) as f:
                rec = json.load(f)
            for path, text in zip(files, rec["files"]):
                with open(path, "w") as f:
                    f.write(text)
            KEPT["taken"] += 1
            return Kept(rec["stdout"])
        except (OSError, ValueError, KeyError):
            pass
    if KEPT["build_now"] is not None:
        KEPT["build_now"](out)
    p = run(cmd, env=env)
    KEPT["ran"] += 1
    if key is not None and p.returncode == 0:
        try:
            texts = []
            for path in files:
                with open(path) as f:
                    texts.append(f.read())
            os.makedirs(os.path.dirname(kept_path(key)), exist_ok=True)
            part = kept_path(key) + f".{os.getpid()}"
            with open(part, "w") as f:
                json.dump({"stdout": p.stdout, "files": texts, "cmd": cmd[1:]}, f)
            os.replace(part, kept_path(key))
        except OSError:
            pass
    return p


def say(msg):
    print(f"gate: {msg}", file=sys.stderr, flush=True)


# The builds: each a directory, the settings it is built with, and how its build went.


class Builds:
    def __init__(self):
        self.want = []  # (out, settings), in the order the steps use them
        self.failed = {}  # out -> why
        self.seconds = 0.0
        self.sources = None  # the sources' key (`known`)
        self.unbuilt = {}  # out -> settings, of builds taken as known
        self.made = []  # (out, settings) of builds made

    def add(self, out, settings):
        self.want.append((out, settings))

    def one(self, out, settings):
        cmd = [os.path.join(TOOLS, "wrela"), "build", os.path.join(ROOT, "game", "scenes"), "-o", out]
        for k, v in settings.items():
            cmd += ["--set", f"{k}={v}"]
        began = time.monotonic()
        p = run(cmd)
        took = time.monotonic() - began
        if p.returncode != 0:
            tail = "\n".join(l for l in p.stdout.splitlines() if l.startswith("error"))
            self.failed[out] = f"the build of {settings} failed:\n{tail or p.stdout[-2000:]}"
        self.made.append((out, settings))
        say(f"built {os.path.basename(out)} in {took:.0f} s" + (" (FAILED)" if out in self.failed else ""))

    def known(self):
        """Takes each wanted build's bytes' name from what the same sources and settings built
        before (the doc's "A RUN IS KEPT BY WHAT IT RAN"): such a build is not made, unless a run
        on it turns out not to be kept (`now`). The rest are left wanted."""
        if not KEPT["on"]:
            return
        try:
            listed = git("ls-files", "-c", "-o", "--exclude-standard", "-z", "--", "lib", "game", "toolchain").split("\0")
            files = sorted({f for f in listed if f and os.path.isfile(os.path.join(ROOT, f))})
            blobs = git("hash-object", "--stdin-paths", stdin="".join(f + "\n" for f in files)).split()
            self.sources = key_of(zip(files, blobs))
        except RuntimeError:
            return
        left = []
        for out, settings in self.want:
            try:
                with open(kept_path(self.memo(settings))) as f:
                    KEPT["builds"][out] = json.load(f)["hash"]
                self.unbuilt[out] = settings
            except (OSError, ValueError, KeyError):
                left.append((out, settings))
        self.want = left

    def memo(self, settings):
        return "build-" + hashlib.sha256((self.sources + json.dumps(settings, sort_keys=True)).encode()).hexdigest()[:34]

    def now(self, out):
        """Makes a build `known` took as known, a run on it not being kept."""
        settings = self.unbuilt.pop(out, None)
        if settings is not None:
            p = run([os.path.join(TOOLS, "built"), "wrela"])
            self.one(out, settings)

    def remember(self):
        """Keeps each build's bytes' name by its sources and settings."""
        if not KEPT["on"] or self.sources is None:
            return
        for out, settings in self.made:
            bh = build_hash(out)
            if bh is not None and out not in self.failed:
                try:
                    os.makedirs(os.path.dirname(kept_path("x")), exist_ok=True)
                    with open(kept_path(self.memo(settings)), "w") as f:
                        json.dump({"hash": bh}, f)
                except OSError:
                    pass

    def make(self, jobs):
        self.known()
        if not self.want:
            return
        began = time.monotonic()
        # Build one representative of each unique SCENE first (each uses all cores to populate the
        # pipeline cache without redundant misses across placements/views), then run the remaining
        # cache-hitting builds in parallel.
        seen_scenes = set()
        first_wave, rest_wave = [], []
        for item in self.want:
            scene = item[1].get("SCENE")
            if scene not in seen_scenes:
                seen_scenes.add(scene)
                first_wave.append(item)
            else:
                rest_wave.append(item)
        say(f"{len(self.want)} builds ({len(first_wave)} scenes sequentially to warm cache, then {len(rest_wave)} at {jobs} at a time)")
        # The toolchain first, once: a build is `tools/wrela`, which builds it when it is stale.
        p = run([os.path.join(TOOLS, "built"), "wrela"])
        if p.returncode != 0:
            for out, _ in self.want:
                self.failed[out] = "the toolchain didn't build:\n" + p.stdout[-2000:]
            return
        for item in first_wave:
            self.one(*item)
        if rest_wave:
            with concurrent.futures.ThreadPoolExecutor(max_workers=max(1, jobs)) as pool:
                list(pool.map(lambda w: self.one(*w), rest_wave))
        self.remember()
        self.seconds = time.monotonic() - began

    def need(self, out):
        """Raises why, if `out` didn't build."""
        if out in self.failed:
            raise RuntimeError(self.failed[out])


def audit_dir(tmp, what):
    return os.path.join(tmp, f"audit_{what}")


def sun_dir(tmp, scene, view, place, cell_px):
    return os.path.join(tmp, f"sun_{scene}_{view}_p{place}_c{cell_px}")


def pool_dir(tmp):
    return os.path.join(tmp, "pool")


def frame_dir(tmp, scene, place):
    return os.path.join(tmp, f"frame_{scene}_p{place}")


def moving_dir(tmp, scene, view, place):
    return os.path.join(tmp, f"moving_{scene}_{view}_p{place}")


def audits(opts):
    return ["small", "full"] if opts["full"] else ["small"]


def plan(builds, steps, opts, tmp):
    """Every build `steps` will run, in the steps' order."""
    if "audit" in steps:
        for what in audits(opts):
            builds.add(audit_dir(tmp, what), {"SCENE": 6, "AUDIT_EYES": AUDITS[what][0]})
    if "pool" in steps:
        builds.add(pool_dir(tmp), {"POOLJUDGE": "true"})
    if "sun" in steps:
        # One build and one run a view: its judgings (`SUN_RUNS`) one after another in it
        # (the scenes' `SUN_ROUND`).
        for scene, view in SUN_VIEWS:
            builds.add(sun_dir(tmp, scene, view, 0, 2.5),
                       {"SCENE": scene, "VIEW": view, "SUNJUDGE": "true", "SUN_ROUND": "true"})
    if "frames" in steps:
        for scene in FRAME_SCENES:
            for place in FRAME_PLACES:
                builds.add(frame_dir(tmp, scene, place), {"SCENE": scene, "PLACE": place})
        for scene, view in MOVING_VIEWS:
            for place in FRAME_PLACES:
                builds.add(moving_dir(tmp, scene, view, place),
                           {"SCENE": scene, "VIEW": view, "PLACE": place})


class Result:
    def __init__(self):
        self.rows = []
        self.failed = False
        self.measured = {}

    def row(self, what, base, now, ok, note=""):
        self.rows.append((what, base, now, ok, note))
        if not ok:
            self.failed = True

    def hold(self, key, what, now, base, kind, spread=""):
        """Holds the number `now` (lower is better) to `base` (None: no baseline yet); `spread`
        (the placements' own numbers) is noted beside it."""
        self.measured[key] = now if kind == "count" else round(now, 3)
        if base is None:
            self.row(what, "-", fmt(now, kind), True, "no baseline: --update writes one")
            return
        if kind == "count":
            limit = base + max(COUNT_SLACK[1], COUNT_SLACK[0] * base)
        else:
            limit = base + max(ABS_SLACK[kind], REL_SLACK * base)
        ok = now <= limit
        note = "" if ok else f"over its line of {fmt(limit, kind)}"
        if ok and now < base - (limit - base):
            note = "better: --update the baseline"
        if spread:
            note = f"{note} ({spread})" if note else f"({spread})"
        self.row(what, fmt(base, kind), fmt(now, kind), ok, note)


def fmt(x, kind):
    if kind == "count":
        return f"{int(x)}"
    return f"{x:.2f}"


def step_layers(res, base, opts, tmp, builds):
    p = run([sys.executable, os.path.join(TOOLS, "layers")])
    res.row("layers", "ok", "ok" if p.returncode == 0 else "broken", p.returncode == 0,
            "" if p.returncode == 0 else p.stdout.strip().splitlines()[-1][:120])


def step_tests(res, base, opts, tmp, builds):
    pkgs = ["lib/engine"] if opts["quick"] else ["lib/engine", "lib/kit", "game/world"]
    for pkg in pkgs:
        p = tests_kept(pkg)
        m = re.findall(r"(\d+) passed, (\d+) failed", p.stdout)
        passed, failed = (int(m[-1][0]), int(m[-1][1])) if m else (0, 1)
        ok = p.returncode == 0 and failed == 0 and passed > 0
        note = ""
        if not ok:
            bad = [l for l in p.stdout.splitlines() if l.startswith("FAILED") or l.startswith("error")]
            note = (bad[0] if bad else "the tests didn't run")[:120]
        res.row(f"tests {pkg}", "all pass", f"{passed} passed, {failed} failed", ok, note)


def JUDGE_ENV():
    """A judge's run: each readback answered the frame after it is asked (the host's
    `WRELA_READS_AFTER`), so its meshes settle in as few frames as their extractions take and the
    run is the same every time. (The frames' benches run as a game does: no such thing.)"""
    return dict(os.environ, WRELA_READS_AFTER="1")


# The readbacks' lateness the small audit is run again at: what a game's are, about (a mesh that
# trusts a readback to be the last run's is found only where it comes late: the citadel's floor).
LATE_READS = 4


def tests_kept(pkg):
    """A package's tests, or what they said of the same sources (every file under lib/, game/ and
    toolchain/, as git names its bytes) before."""
    key = None
    if KEPT["on"]:
        try:
            listed = git("ls-files", "-c", "-o", "--exclude-standard", "-z", "--", "lib", "game", "toolchain").split("\0")
            files = sorted({f for f in listed if f and os.path.isfile(os.path.join(ROOT, f))})
            blobs = git("hash-object", "--stdin-paths", stdin="".join(f + "\n" for f in files)).split()
            key = "tests-" + hashlib.sha256((pkg + key_of(zip(files, blobs))).encode()).hexdigest()[:34]
            with open(kept_path(key)) as f:
                rec = json.load(f)
            KEPT["taken"] += 1
            return Kept(rec["stdout"])
        except (OSError, ValueError, KeyError, RuntimeError):
            pass
    p = run([os.path.join(TOOLS, "wrela"), "test", os.path.join(ROOT, pkg)])
    KEPT["ran"] += 1
    if key is not None and p.returncode == 0:
        try:
            os.makedirs(os.path.dirname(kept_path(key)), exist_ok=True)
            with open(kept_path(key), "w") as f:
                json.dump({"stdout": p.stdout, "files": []}, f)
        except OSError:
            pass
    return p


AUDIT_FAIL = re.compile(r"^\s+- (?P<kind>.+?)(?:,|:) ")


def audit(res, base, what, tmp, builds, unit_fs=None, reads=None):
    eyes, size, timeout = AUDITS[what]
    out = audit_dir(tmp, what)
    builds.need(out)
    env = None
    if unit_fs is not None:
        env = dict(os.environ, WRELA_GPU_UNIT_FS=str(unit_fs))
        what = f"{what} at {unit_fs} fs"
    if reads is not None:
        env = dict(env or os.environ, WRELA_READS_AFTER=str(reads))
        what = f"{what}, readbacks {reads} frames late"
    say(f"hole audit, {what}")
    p = run_kept([os.path.join(TOOLS, "audit"), "--built", out, "--size", size, "--eyes", str(eyes),
                  "--timeout", str(timeout)], out, tmp, env=env, extra=f"{unit_fs} {reads}")
    kinds = sorted({m.group("kind") for l in p.stdout.splitlines() if (m := AUDIT_FAIL.match(l))})
    host_died = "host exited" in p.stdout or "error: GPU error" in p.stdout
    known = sorted((base or {}).get("failing", []))
    res.measured[f"audit.{what}"] = {"failing": kinds}
    if host_died or (p.returncode != 0 and not kinds):
        err = [l for l in p.stdout.splitlines() if l.startswith("error")]
        res.row(f"audit {what}", "passes", "did not run", False, (err[0] if err else p.stdout[-200:])[:140])
        return
    new = [k for k in kinds if k not in known]
    now = "passes" if not kinds else "fails: " + ", ".join(kinds)
    was = "passes" if not known else "fails: " + ", ".join(known)
    note = ""
    if new:
        note = "newly failing: " + ", ".join(new)
    elif kinds != known:
        note = "better: --update the baseline"
    elif kinds:
        note = "a debt the baseline names"
    res.row(f"audit {what}", was, now, not new, note)


def step_audit(res, base, opts, tmp, builds):
    b = base.get("audit", {})
    for what in audits(opts):
        try:
            audit(res, b.get(what), what, tmp, builds)
        except RuntimeError as e:
            res.row(f"audit {what}", "passes", "did not run", False, str(e).splitlines()[-1][:140])
    if (opts["machine"] or ("m4" if platform.system() == "Darwin" else "radeon")) != "radeon":
        try:
            audit(res, b.get(f"small at {SLOWEST_UNIT_FS} fs"), "small", tmp, builds, unit_fs=SLOWEST_UNIT_FS)
        except RuntimeError as e:
            res.row(f"audit small at {SLOWEST_UNIT_FS} fs", "passes", "did not run", False, str(e).splitlines()[-1][:140])
    late = f"small, readbacks {LATE_READS} frames late"
    try:
        audit(res, b.get(late), "small", tmp, builds, reads=LATE_READS)
    except RuntimeError as e:
        res.row(f"audit {late}", "passes", "did not run", False, str(e).splitlines()[-1][:140])


def step_pool(res, base, opts, tmp, builds):
    out = pool_dir(tmp)
    builds.need(out)
    say("the pool's judge")
    p = run_kept([os.path.join(TOOLS, "gpu"), "--timeout", "900", out, "--size", POOL_SIZE,
                  "--frames", str(POOL_FRAMES), "--until", "scene: done",
                  "--png", os.path.join(out, "pool.png")], out, tmp, env=JUDGE_ENV(), extra="reads 1")
    held = [l.split("wrela: ", 1)[-1] for l in p.stdout.splitlines() if "judge pool:" in l]
    m = POOL_HELD.search(p.stdout)
    if p.returncode != 0 or not m:
        err = [l for l in p.stdout.splitlines() if "panic" in l or "error" in l]
        res.row("pool judge", "every kind held", "not held", False,
                (err[0] if err else (held[-1] if held else "the judge said nothing"))[:200])
        return
    res.measured["pool.kinds"] = int(m.group(1))
    res.row("pool judge", "every kind held", f"{m.group(1)} kinds held", True, "")


SUN_LINE = re.compile(
    r"SUN SCENE (\d+) VIEW (\d+): judged (\d+) px.*?hard leaks (\d+); acne px \d+ \([^)]*\), "
    r"hard acne (\d+); mean \|err\| ([\d.]+)/255.*?p99 \|err\| (\d+)/255"
)


def step_sun(res, base, opts, tmp, builds):
    b = base.get("sun", {})
    for scene, view in SUN_VIEWS:
        key = f"{scene}/{view}"
        seen, untraced, failed = [], [], None
        out = sun_dir(tmp, scene, view, 0, 2.5)
        if out in builds.failed:
            failed = builds.failed[out].splitlines()[-1][:140]
        else:
            say(f"sun judge, SCENE {scene} VIEW {view}, {len(SUN_RUNS)} placements and cell widths")
            p = run_kept([os.path.join(TOOLS, "gpu"), "--timeout", "900", out, "--size", SUN_SIZE,
                          "--frames", str(SUN_FRAMES * len(SUN_RUNS)), "--until", "scene: done",
                          "--png", os.path.join(out, "sun.png")], out, tmp, env=JUDGE_ENV(), extra="reads 1")
            for m in SUN_LINE.finditer(p.stdout):
                seen.append((int(m.group(4)), int(m.group(5)), float(m.group(6)), float(m.group(7))))
            untraced = [int(u) for u in re.findall(r"fields untraced (\d+)", p.stdout)]
            if len(seen) != len(SUN_RUNS):
                err = [l for l in p.stdout.splitlines() if "error" in l]
                failed = (err[0] if err else f"the judge said {len(seen)} of its {len(SUN_RUNS)} judgings")[:140]
        if failed is not None:
            res.row(f"sun {key}", "judged", "no verdict", False, failed)
            continue
        was = b.get(key, {})
        for i, (name, what, kind) in enumerate([("hard_leaks", "hard leaks (px)", "count"),
                                                 ("hard_acne", "hard acne (px)", "count"),
                                                 ("mean_err", "mean error (/255)", "err"),
                                                 ("p99_err", "99th percentile error (/255)", "err")]):
            each = [s[i] for s in seen]
            mean = sum(each) / len(each)
            spread = " ".join(fmt(x, kind) for x in each)
            res.hold(f"sun.{key}.{name}", f"sun {key} {what}", round(mean, 1) if kind == "count" else mean,
                     was.get(name), "err" if kind == "err" else "count", spread=spread)
        errs = [s[2] for s in seen]
        res.hold(f"sun.{key}.mean_err_moves", f"sun {key} mean error's move (/255)",
                 max(errs) - min(errs), was.get("mean_err_moves"), "err")
        # Fields whose exact rays a frame left untraced for want of dispatches: their near band
        # was taken as open, an estimate. None past the baseline's (0 where it says none), at any
        # placement.
        if untraced:
            n, most = max(untraced), was.get("untraced", 0)
            res.measured[f"sun.{key}.untraced"] = n
            res.row(f"sun {key} fields untraced", str(most), str(n), n <= most,
                    "" if n <= most else "the exact rays left fields untraced")


COARSE_LINE = re.compile(r"coarse: SCENE (\d+) VIEW (\d+): ([\d.eE+-]+) levels coarser than the rule wants")


def coarse_of(stdout):
    """The levels a judged pixel of a run was drawn coarser than the rule wants, on average, in
    thousandths of a level (`MeshSight::count_coarse`: 0 where every pixel's cell is the rule's or
    finer, 1000 where each is twice it), or None if the run didn't say."""
    m = COARSE_LINE.search(stdout)
    if not m:
        return None
    return 1000.0 * float(m.group(3))


def step_frames(res, base, opts, tmp, builds):
    b = base.get("frames", {})
    bc = base.get("coarse", {})
    for scene in FRAME_SCENES:
        spans, coarse, failed = [], [], None
        for place in FRAME_PLACES:
            out = frame_dir(tmp, scene, place)
            if out in builds.failed:
                failed = builds.failed[out].splitlines()[-1][:140]
                break
            say(f"frame's span, SCENE {scene} at {FRAME_SIZE}, placement {place}")
            js = os.path.join(tmp, f"bench_{scene}_p{place}.json")
            p = run_kept([os.path.join(TOOLS, "bench"), out, "--size", FRAME_SIZE, "--frames", FRAME_RANGE,
                          "--runs", "1", "--no-passes", "--no-cpu", "--json", js, "--timeout", "600"],
                         out, tmp, files=[js])
            try:
                with open(js) as f:
                    spans.append(json.load(f)["span_runs"][0]["span"]["median"])
                c = coarse_of(p.stdout)
                if c is not None:
                    coarse.append(c)
            except (OSError, KeyError, IndexError, ValueError):
                err = [l for l in p.stdout.splitlines() if "error" in l]
                failed = (err[0] if err else p.stdout[-200:])[:140]
                break
        if failed is not None:
            res.row(f"frame SCENE {scene}", "runs", "did not run", False, failed)
            continue
        mean = sum(spans) / len(spans)
        res.hold(f"frames.{scene}", f"frame SCENE {scene} span (ms)", mean, b.get(str(scene)), "ms",
                 spread=" ".join(fmt(x, "ms") for x in spans))
        if coarse:
            res.hold(f"coarse.{scene}", f"frame SCENE {scene} levels a pixel is drawn coarser than the rule wants (/1000)",
                     sum(coarse) / len(coarse), bc.get(str(scene)), "err",
                     spread=" ".join(fmt(x, "err") for x in coarse))
    m = base.get("moving", {})
    late_re = re.compile(r"lateness: SCENE (\d+) VIEW (\d+): late_frames (\d+), max_streak (\d+)")
    again_re = re.compile(r"pool: SCENE (\d+) VIEW (\d+): resident bricks meshed again (\d+)")
    short_re = re.compile(r"watch: SCENE (\d+) VIEW (\d+): (\d+) of (\d+) runs short of their lists \((\d+) cells")
    for scene, view in MOVING_VIEWS:
        key = f"{scene}/{view}"
        medians, highs, late_frames, max_streaks, coarse, failed = [], [], [], [], [], None
        again, shorts, runs, unasked = [], [], [], []
        for place in FRAME_PLACES:
            out = moving_dir(tmp, scene, view, place)
            if out in builds.failed:
                failed = builds.failed[out].splitlines()[-1][:140]
                break
            say(f"frame's span with the eye moving, SCENE {scene} VIEW {view} at {FRAME_SIZE}, "
                f"placement {place}")
            js = os.path.join(tmp, f"bench_{scene}_{view}_p{place}.json")
            p = run_kept([os.path.join(TOOLS, "bench"), out, "--size", FRAME_SIZE, "--frames",
                          MOVING_RANGE, "--runs", "1", "--no-passes", "--no-cpu", "--json", js,
                          "--timeout", "600"], out, tmp, files=[js])
            try:
                with open(js) as f:
                    each = sorted(json.load(f)["span_runs"][0]["spans"])
                medians.append(each[len(each) // 2])
                # The span 19 frames in 20 are within.
                highs.append(each[max(0, -(-len(each) * 19 // 20) - 1)])
                c = coarse_of(p.stdout)
                if c is not None:
                    coarse.append(c)
                lm = late_re.search(p.stdout)
                if lm:
                    late_frames.append(int(lm.group(3)))
                    max_streaks.append(int(lm.group(4)))
                am = again_re.search(p.stdout)
                if am:
                    again.append(int(am.group(3)))
                sm = short_re.search(p.stdout)
                if sm:
                    shorts.append(int(sm.group(3)))
                    runs.append(int(sm.group(4)))
                    unasked.append(int(sm.group(5)))
            except (OSError, KeyError, IndexError, ValueError):
                err = [l for l in p.stdout.splitlines() if "error" in l]
                failed = (err[0] if err else p.stdout[-200:])[:140]
                break
        if failed is not None:
            res.row(f"moving SCENE {scene} VIEW {view}", "runs", "did not run", False, failed)
            continue
        was = m.get(key, {})
        res.hold(f"moving.{key}.median", f"moving SCENE {scene} VIEW {view} median span (ms)",
                 sum(medians) / len(medians), was.get("median"), "ms",
                 spread=" ".join(fmt(x, "ms") for x in medians))
        res.hold(f"moving.{key}.high", f"moving SCENE {scene} VIEW {view} span of 19 in 20 (ms)",
                 sum(highs) / len(highs), was.get("high"), "ms",
                 spread=" ".join(fmt(x, "ms") for x in highs))
        if coarse:
            res.hold(f"moving.{key}.coarse", f"moving SCENE {scene} VIEW {view} levels a pixel is drawn coarser than the rule wants (/1000)",
                     sum(coarse) / len(coarse), was.get("coarse"), "err",
                     spread=" ".join(fmt(x, "err") for x in coarse))
        if late_frames:
            lf, ms = max(late_frames), max(max_streaks)
            res.measured[f"moving.{key}.late_frames"] = lf
            res.measured[f"moving.{key}.max_late_streak"] = ms
            res.row(f"moving SCENE {scene} VIEW {view} lateness (frames/streak)", "0/0", f"{lf}/{ms}",
                    lf == 0, "" if lf == 0 else "drew coarser than wanted during motion")
        # The pool's promise (the plan's phase 3): no brick it holds is meshed again along a path.
        if len(again) == len(medians):
            n = max(again)
            res.measured[f"moving.{key}.meshed_again"] = n
            res.row(f"moving SCENE {scene} VIEW {view} resident bricks meshed again", "0", str(n),
                    n == 0, "" if n == 0 else "a pool let go bricks it then meshed again")
        else:
            res.row(f"moving SCENE {scene} VIEW {view} resident bricks meshed again", "0", "not said",
                    False, "the run didn't say its pools' count")
        # An outline's watch short of its lists draws its frame without the rest's exact cells.
        if len(shorts) == len(medians):
            n = max(shorts)
            res.measured[f"moving.{key}.short_runs"] = n
            res.row(f"moving SCENE {scene} VIEW {view} watch runs short of their lists", "0",
                    f"{n} of {max(runs)}", n == 0,
                    "" if n == 0 else f"{max(unasked)} cells unasked: frames drawn without their exact cells")
        else:
            res.row(f"moving SCENE {scene} VIEW {view} watch runs short of their lists", "0", "not said",
                    False, "the run didn't say its watches' count")


def nest(flat):
    """`a.b.c: v` keys as nested dicts (the baseline's shape)."""
    out = {}
    for key, v in flat.items():
        at = out
        parts = key.split(".")
        for part in parts[:-1]:
            at = at.setdefault(part, {})
        at[parts[-1]] = v
    return out


def merge(into, new):
    for k, v in new.items():
        if isinstance(v, dict) and isinstance(into.get(k), dict) and "failing" not in v:
            merge(into[k], v)
        else:
            into[k] = v


# What was seen: a result kept by a key of the files it measured.


def git(*args, stdin=None):
    p = subprocess.run(["git", "-C", ROOT, *args], stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                       text=True, input=stdin)
    if p.returncode != 0:
        raise RuntimeError(f"git {' '.join(args[:2])}: {p.stderr.strip()[:200]}")
    return p.stdout


def key_of(pairs):
    """The key of files as (path, the id git gives its bytes)."""
    h = hashlib.sha256()
    for path, blob in sorted(pairs):
        if path not in KEY_SKIP:
            h.update(f"{path}\0{blob}\n".encode())
    return h.hexdigest()[:32]


def commit_key(rev):
    """The key of the commit `rev`'s files."""
    pairs = []
    for rec in git("ls-tree", "-r", "-z", rev, "--", *KEY_PATHS).split("\0"):
        if rec:
            meta, path = rec.split("\t", 1)
            _, kind, blob = meta.split()
            if kind == "blob":
                pairs.append((path, blob))
    return key_of(pairs)


def tree_key():
    """The key of the files as they are on disk now: a commit's, when they are that commit's.
    Nothing is written to the repository."""
    listed = git("ls-files", "-c", "-o", "--exclude-standard", "-z", "--", *KEY_PATHS).split("\0")
    files = sorted({f for f in listed if f and os.path.isfile(os.path.join(ROOT, f))})
    blobs = git("hash-object", "--stdin-paths", stdin="".join(f + "\n" for f in files)).split()
    return key_of(zip(files, blobs))


def seen_dir(machine):
    base = os.environ.get("WRELA_GATE_SEEN") or os.path.expanduser("~/.wrela/gate")
    return os.path.join(base, machine)


def seen_read(machine, key):
    try:
        with open(os.path.join(seen_dir(machine), key + ".json")) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def seen_write(machine, key, res, steps, opts, times):
    """Keeps this run's result under `key`, over what an earlier run of the same files saw of
    the same things (a run of some steps adds to a run of the others)."""
    rec = seen_read(machine, key) or {"key": key, "machine": machine, "rows": [], "steps": [],
                                      "measured": {}, "times": {}}
    now = {r[0] for r in res.rows}
    rec["rows"] = [r for r in rec["rows"] if r[0] not in now] + [list(r) for r in res.rows]
    rec["steps"] = [s for s in STEPS if s in steps or s in rec["steps"]]
    rec["full"] = bool(opts["full"] or rec.get("full"))
    merge(rec["measured"], nest(res.measured))
    rec["times"].update({k: round(v, 1) for k, v in times.items() if k != "whole"})
    rec["passed"] = all(r[3] for r in rec["rows"])
    rec["when"] = time.strftime("%Y-%m-%d %H:%M")
    try:
        rec["commit"] = git("rev-parse", "--short", "HEAD").strip()
    except RuntimeError:
        rec["commit"] = "?"
    d = seen_dir(machine)
    os.makedirs(d, exist_ok=True)
    part = os.path.join(d, f".{key}.{os.getpid()}")
    with open(part, "w") as f:
        json.dump(rec, f, indent=1, sort_keys=True)
        f.write("\n")
    os.replace(part, os.path.join(d, key + ".json"))


def verdict(rec):
    if rec is None:
        return "not seen"
    what = "passed" if rec["passed"] else "FAILED"
    steps = "every step" if rec["steps"] == STEPS else "only " + ", ".join(rec["steps"])
    return f"{what} ({steps}{', full audit' if rec.get('full') else ''}; {rec['when']})"


def seen(machine, rev):
    """Prints what this machine's gate saw of `rev`, or of each commit in `A..B`."""
    try:
        if ".." in rev:
            code = 0
            for line in git("log", "--format=%h %s", rev).splitlines():
                short, subject = line.split(" ", 1)
                rec = seen_read(machine, commit_key(short))
                print(f"{short}  {verdict(rec):<58}  {subject[:60]}")
                if rec is None:
                    code = max(code, 3) if code != 1 else 1
                elif not rec["passed"]:
                    code = 1
            return code
        short = git("rev-parse", "--short", rev).strip()
        rec = seen_read(machine, commit_key(short))
    except RuntimeError as e:
        print(f"gate: {e}", file=sys.stderr)
        return 2
    print(f"gate on {machine}, {short}: {verdict(rec)}")
    if rec is None:
        return 3
    table(rec["rows"])
    print("gate: times: " + times_line({**rec["times"], "whole": sum(rec["times"].values())}))
    return 0 if rec["passed"] else 1


def table(rows):
    w = max(len(r[0]) for r in rows) if rows else 10
    for what, was, now, ok, note in rows:
        mark = "ok  " if ok else "FAIL"
        print(f"  {mark} {what:<{w}}  {str(was):>12} -> {str(now):<12} {note}")


def times_line(times):
    order = ["builds"] + STEPS + ["whole"]
    return ", ".join(f"{k} {times[k]:.0f} s" for k in order if k in times)


def main():
    opts = {"quick": False, "full": False, "update": False, "only": None, "machine": None,
            "keep": None, "seen": None, "fresh": False, "all": False}
    argv = sys.argv[1:]
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("-h", "--help"):
            print(__doc__)
            return 0
        if a in ("--quick", "--full", "--update", "--fresh", "--all"):
            opts[a[2:]] = True
        elif a in ("--only", "--machine", "--keep") and i + 1 < len(argv):
            i += 1
            opts[a[2:]] = argv[i]
        elif a == "--seen":
            opts["seen"] = "HEAD"
            if i + 1 < len(argv) and not argv[i + 1].startswith("--"):
                i += 1
                opts["seen"] = argv[i]
        else:
            print(f"gate: unknown argument `{a}`\n{__doc__}", file=sys.stderr)
            return 2
        i += 1
    machine = opts["machine"] or ("m4" if platform.system() == "Darwin" else "radeon")
    KEPT["machine"] = machine
    KEPT["on"] = not opts["fresh"]
    if opts["seen"] is not None:
        return seen(machine, opts["seen"])
    steps = STEPS if opts["only"] is None else opts["only"].split(",")
    for s in steps:
        if s not in STEPS:
            print(f"gate: no step `{s}` (the steps: {', '.join(STEPS)})", file=sys.stderr)
            return 2
    if opts["quick"] and opts["only"] is None:
        steps = ["layers", "tests", "audit", "pool"]
    try:
        with open(BASELINE) as f:
            baselines = json.load(f)
    except OSError:
        baselines = {}
    base = baselines.get(machine, {})

    began = time.monotonic()
    try:
        key = tree_key()
    except RuntimeError as e:
        say(f"this run won't be kept: {e}")
        key = None
    res = Result()
    fns = {"layers": step_layers, "tests": step_tests, "audit": step_audit, "pool": step_pool,
           "sun": step_sun, "frames": step_frames}
    tmp = opts["keep"] or tempfile.mkdtemp(prefix="wrela-gate-")
    os.makedirs(tmp, exist_ok=True)
    try:
        times = {}
        builds = Builds()
        KEPT["build_now"] = lambda out: (builds.now(out), builds.remember())
        plan(builds, steps, opts, tmp)
        try:
            jobs = int(os.environ.get("WRELA_GATE_JOBS", "3"))
        except ValueError:
            jobs = 3
        builds.make(jobs)
        if builds.want:
            times["builds"] = builds.seconds
        # The tests beside the GPU's steps (they use none of it), their rows put after `layers`'.
        tests_res, tests_job = Result(), None
        if "tests" in steps:
            def tests():
                t = time.monotonic()
                try:
                    step_tests(tests_res, base, opts, tmp, builds)
                except RuntimeError as e:
                    tests_res.row("tests", "run", "did not run", False, str(e).splitlines()[-1][:140])
                times["tests"] = time.monotonic() - t
            tests_job = concurrent.futures.ThreadPoolExecutor(max_workers=1).submit(tests)
        stopped = None
        for s in STEPS:
            if s in steps and s != "tests":
                if res.failed and not opts["all"] and not opts["update"]:
                    stopped = stopped or s
                    res.row(s, "runs", "not run", False, "an earlier step failed: --all runs every step")
                    continue
                step_began = time.monotonic()
                taken = KEPT["taken"]
                try:
                    fns[s](res, base, opts, tmp, builds)
                except RuntimeError as e:
                    res.row(s, "runs", "did not run", False, str(e).splitlines()[-1][:140])
                times[s] = time.monotonic() - step_began
                say(f"{s}: {times[s]:.0f} s" + (f" ({KEPT['taken'] - taken} runs kept)" if KEPT["taken"] > taken else ""))
        if tests_job is not None:
            tests_job.result()
            at = 1 if res.rows and res.rows[0][0] == "layers" else 0
            res.rows[at:at] = tests_res.rows
            res.failed = res.failed or tests_res.failed
            res.measured.update(tests_res.measured)
        times["whole"] = time.monotonic() - began
    finally:
        if not opts["keep"]:
            shutil.rmtree(tmp, ignore_errors=True)

    print(f"gate on {machine}:")
    table(res.rows)
    print("gate: times: " + times_line(times) + f"; {KEPT['ran']} runs made, {KEPT['taken']} taken as kept")
    if key is not None:
        try:
            still = tree_key() == key
        except RuntimeError:
            still = False
        if still:
            seen_write(machine, key, res, steps, opts, times)
        else:
            say("files under lib/, game/, toolchain/ or tools/ changed while the gate ran: this run is not kept")
    if opts["update"]:
        if res.failed and any(not ok and "did not run" in str(now) for _, _, now, ok, _ in res.rows):
            print("gate: not updating the baseline: something didn't run", file=sys.stderr)
            return 1
        merge(base, nest(res.measured))
        baselines[machine] = base
        with open(BASELINE, "w") as f:
            json.dump(baselines, f, indent=2, sort_keys=True)
            f.write("\n")
        print(f"gate: wrote {machine}'s baseline to tools/gate.json")
        return 0
    print("gate: " + ("FAILED" if res.failed else "passed"))
    return 1 if res.failed else 0


if __name__ == "__main__":
    sys.exit(main())
