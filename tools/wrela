#!/bin/bash
# This repository's own `wrela`, built first if stale (tools/built), with the arguments given.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
bin="$("$here/built" wrela)"
# One cache of computed constants for every package and checkout on the machine (the compiler's
# `WRELA_CONST_CACHE`; a key is all a value depends on): without it each worktree cooks the
# opening's baked solids again, a quarter of an hour or more each time.
export WRELA_CONST_CACHE="${WRELA_CONST_CACHE:-$HOME/.wrela/consts}"
mkdir -p "$WRELA_CONST_CACHE"
exec "$bin" "$@"
