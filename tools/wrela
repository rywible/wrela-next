#!/bin/bash
# This repository's own `wrela`, built first if stale (tools/built), with the arguments given.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
bin="$("$here/built" wrela)"
# One cache of computed constants for every package and checkout on the machine (the compiler's
# `WRELA_CONST_CACHE`; a key is all a value depends on): without it each worktree cooks the
# opening's baked solids again, a quarter of an hour or more each time.
export WRELA_CONST_CACHE="${WRELA_CONST_CACHE:-$HOME/.wrela/consts}"
mkdir -p "$WRELA_CONST_CACHE"
# Building a package under game/ proves the content's field contracts first (`*_are_sound`
# tests: each field's bound, steepness and ranges, by the compiler's intervals, the operation to
# blame named where one fails): a field that states what it isn't fails the build, not a frame.
# Once a tree of sources has passed with this compiler, it isn't asked again (a stamp keyed by
# both).
if [[ "${1:-}" == "build" && -n "${2:-}" && "${WRELA_SKIP_CONTRACTS:-}" != 1 ]]; then
  root="$(cd "$here/.." && pwd)"
  pkg="$(cd "$2" 2>/dev/null && pwd || true)"
  case "$pkg" in
    */game/*)
      game="${pkg%%/game/*}/game"
      key="$( (find "$game" "${pkg%%/game/*}/lib" -name '*.wrela' -not -path '*/build/*' -print0 \
        | sort -z | xargs -0 cat; cat "$bin") | shasum -a 256 | cut -c1-32)"
      stamps="$HOME/.wrela/contracts"
      if [[ ! -f "$stamps/$key" ]]; then
        echo "wrela: proving the content's field contracts ($game/world)" >&2
        if ! "$bin" test "$game/world" are_sound >&2; then
          echo "error: a field contract failed (above): the build stops here" >&2
          exit 1
        fi
        mkdir -p "$stamps"
        touch "$stamps/$key"
      fi
      ;;
  esac
fi
exec "$bin" "$@"
