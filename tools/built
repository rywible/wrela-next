#!/bin/bash
# Prints the path of this repository's own binary $1 (`wrela` or `wrela-host`), building both
# first (release, in toolchain/target) if anything they are built from is newer than the last
# build: a file under toolchain/ (not target/), lib/std or docs/spec, which the compiler embeds.
# Waits for any other cargo on the machine to finish first: one Rust build at a time.
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
name="${1:?usage: tools/built wrela|wrela-host}"
case "$name" in
  wrela | wrela-host) ;;
  *) echo "built: no binary \`$name\`" >&2; exit 2 ;;
esac
bin="$root/toolchain/target/release/$name"
stamp="$root/toolchain/target/release/.built"
stale=0
if [[ ! -x "$bin" || ! -f "$stamp" ]]; then
  stale=1
elif [[ -n "$(find "$root/toolchain" "$root/lib/std" "$root/docs/spec" \
      -path "$root/toolchain/target" -prune -o -type f -newer "$stamp" -print -quit)" ]]; then
  stale=1
fi
if [[ $stale == 1 ]]; then
  while pgrep -x cargo > /dev/null; do
    echo "built: waiting for another cargo to finish" >&2
    sleep 5
  done
  echo "built: building wrela and wrela-host (release)" >&2
  (cd "$root/toolchain" && cargo build --release --quiet -p wrela -p wrela-host) >&2
  touch "$stamp"
fi
echo "$bin"
