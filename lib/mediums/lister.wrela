// The lister of mediums, as a scene uses it: a medium (`form::kinds::Medium`: a point, to a
// density) and its look (`form::look::Haze`: how it takes and gives light), handed over once;
// each frame, marched into a layer of the frame's soft target, which the last pass lays over the
// ink (`frame::soft`). A scene names no pass:
//
//     var spray = mediums::lister::medium(spray_at(0.0), SprayLook {})      // once
//     spray.form = spray_at(t)                                              // each frame
//     spray.list(mut frame, "spray")                                        // after frame.begin
//
// Where it is marched: one ray a texel of the soft target (a texel each `frame.soft.scale`
// pixels across), over the rectangle of the screen its bound covers, from where the ray enters
// the bound to where it leaves. Its kernel is the one for as many steps as a ray can need this
// frame (a pipeline for each `Cap`), so the host's step guard (docs/rates.md) knows the most
// it can do; where that is more than one dispatch may do (`std::gpu::limits().step_work`: the
// eye inside or against a medium), the rectangle is marched in bands of rows, a dispatch each.
// A band is marched into a pair of the lister's own textures at their corner (a dispatch covers
// only its band's texels) and copied into the medium's layer where it belongs. The ray isn't stopped at the picture's surface: the last pass
// reads each texel's ramp at its own pixel's depth, which is what keeps it off a nearer outline.
// A medium its bound proves empty throughout (a spell between casts) isn't marched at all.

use form::kinds::Medium
use form::look::Haze
use frame::eye::Eye
use frame::light::{AllLit, Lit, OneLit, Unlit, lit_by}
use frame::picture::Frame
use frame::soft::{MOST_SOFT, far_along}
use march::{SEGMENT, Stepping, crossing, laid, march, step_at}
use std::derive::Box3
use std::gpu::{
    DepthTexture, GlobalId, GpuBuffer, Rgba16Float, Texels, Texture, buffer, copy_texture,
    dispatch, label, limits, read, writable_texture,
}
use std::io::Pending

/// How a medium is marched by default: a step two cones wide, or its finest detail long where
/// that is longer, and never under a centimetre; 512 steps and proofs at most a ray,
/// band-limited, skipping what its bound proves empty. (At 4K in the bar's eye a step a cone
/// wide cost the marches 0.74 ms against 0.42, for 0.39/255 against 0.55 on average.)
pub const MARCHED = Stepping {
    share: 2.0,
    least: 0.01,
    limit: 512,
    limited: 1,
    skip: 1,
    stops: 0,
}

/// A cap on a ray's steps and proofs the march's kernel is built for, as a type (a pipeline
/// each): a frame's march takes the least that covers what its rays can need, of 32, 64, 128,
/// 256 and 512 (`MARCHED`'s limit).
pub trait Cap {
    const MOST: u32
}

pub struct Cap32 {}

pub struct Cap64 {}

pub struct Cap128 {}

pub struct Cap256 {}

pub struct Cap512 {}

impl Cap for Cap32 {
    const MOST: u32 = 32
}

impl Cap for Cap64 {
    const MOST: u32 = 64
}

impl Cap for Cap128 {
    const MOST: u32 = 128
}

impl Cap for Cap256 {
    const MOST: u32 = 256
}

impl Cap for Cap512 {
    const MOST: u32 = 512
}

/// A step of the march's work as the compiler counts it (§18.11), with room: 2,685 for the
/// shore's spray, surf and glow (`wrela pipelines`), the medium's band-limited density and its
/// interval proof the most of it. How many rays a band of the march holds is worked out from it;
/// a medium whose step weighs more is refused by the host's step guard, which names it, until
/// this is raised.
pub const STEP_WORK: u32 = 3000

/// A medium handed to the lister: its form, its look, how it is marched, and the four numbers
/// its form takes on the GPU this frame (`Medium::lived`), which a kernel before its march may
/// write (`live`: zero until one does).
pub struct Mediums<M, H> {
    pub form: M,
    pub haze: H,
    pub steps: Stepping,
    pub live: GpuBuffer<vec4>,
    /// Where a band is marched before it's copied into its layer: colour and ramp, the soft
    /// target's size (made when it is first known).
    banded: (Texture<Rgba16Float>, Texture<Rgba16Float>),
}

/// `form` wearing `haze`, marched as `MARCHED` says.
pub fn medium<M: Medium, H: Haze>(form: M, haze: H) -> Mediums<M, H> {
    let banded = (writable_texture(width: 1, height: 1), writable_texture(width: 1, height: 1))
    Mediums { form, haze, steps: MARCHED, live: buffer(1), banded }
}

/// The rectangle of `eye`'s screen that `b` covers (px: x0, y0, x1, y1), the whole screen where
/// any of its corners is behind the eye's near plane, and empty (x1 ≤ x0) where it's off the
/// screen.
pub fn on_screen(eye: Eye, b: Box3) -> vec4 {
    var lo = vec2(1.0e9)
    var hi = vec2(-1.0e9)
    for i in 0..8 {
        let c = vec3(
            if (i & 1) == 0 { b.lo.x } else { b.hi.x },
            if (i & 2) == 0 { b.lo.y } else { b.hi.y },
            if (i & 4) == 0 { b.lo.z } else { b.hi.z },
        )
        let clip = eye.clip(c)
        if clip.w <= eye.near {
            return vec4(0.0, 0.0, eye.size.x, eye.size.y)
        }
        let ndc = clip.xy / clip.w
        let px = vec2((ndc.x + 1.0) * 0.5 * eye.size.x, (1.0 - ndc.y) * 0.5 * eye.size.y)
        lo = min(lo, px)
        hi = max(hi, px)
    }
    vec4(max(lo, vec2(0.0)), min(hi, eye.size))
}

/// The texels of a target `size` texels big, `scale` pixels a texel, that a march over `rect`
/// (px) writes: those under it and one more each way, so each pixel in it finds its four.
pub fn texels_over(rect: vec4, scale: f32, size: vec2) -> vec4 {
    let lo = max(floor(rect.xy / scale) - vec2(1.0), vec2(0.0))
    let hi = min(ceil(rect.zw / scale) + vec2(1.0), size)
    vec4(lo, hi)
}

/// Where a march is: the texels of the medium's layer it marches (x0, y0, x1, y1), where its
/// invocation (0, 0) is in them (`at`: the layer's corner, or a band's own), how many pixels
/// across a texel is, and the medium's bound. Invocation (x, y) marches texel `at` + (x, y), into
/// texel (x, y) of the textures it writes (the layer itself, or a band's own pair).
pub struct Over: Copy + GpuData {
    pub texels: vec4,
    pub at: vec2,
    pub bound: Box3,
    pub scale: f32,
}

/// How many steps and proofs a ray of a march over `b` from `eye` can take, `scale` pixels a
/// texel, through a medium whose finest detail is `finest`, as `s` steps: the longest chord
/// through the bound over the shortest step anywhere in it (`step_at` at its nearest), with the
/// proofs that skip or narrow a stretch (at most one for each `SEGMENT` steps, and as many
/// again), at most `s.limit`. What a ray takes is never more.
pub fn passes_needed(eye: Eye, b: Box3, scale: f32, finest: f32, s: Stepping) -> u32 {
    let chord = length(b.hi - b.lo)
    let nearest = length(max(max(b.lo - eye.at, eye.at - b.hi), vec3(0.0)))
    let step = step_at(nearest, scale * eye.pixel(), finest, s)
    let steps = chord / step + 2.0
    let passes = steps * (1.0 + 2.0 / f32(SEGMENT)) + 4.0
    if passes >= f32(s.limit) { s.limit } else { u32(passes) }
}

/// One texel of a medium's layer of the soft target: its ray marched through the medium's
/// bound, its light and cover into `colour`, its ramp into `ramp`. At most `passes` steps and
/// proofs a ray: a pipeline for each cap.
@compute(8, 8)
pub fn marched<M: Medium, H: Haze>(
    eye: Eye,
    light: frame::light::Lighting,
    medium: M,
    haze: H,
    over: Over,
    steps: Stepping,
    depth: DepthTexture,
    colour: mut Texels<Rgba16Float>,
    ramp: mut Texels<Rgba16Float>,
    id: GlobalId,
    lights: const u32,
    passes: const u32,
    live: [vec4],
) {
    let medium = medium.lived(live[0])
    let x = f32(id.x) + over.at.x
    let y = f32(id.y) + over.at.y
    if x < over.texels.x || y < over.texels.y || x >= over.texels.z || y >= over.texels.w {
        return
    }
    let px = (vec2(x, y) + vec2(0.5)) * over.scale
    let d = eye.ray(px)
    let span = crossing(over.bound, eye.at, d)
    var to = span.y
    if steps.stops != 0 {
        let sx = u32(min(px.x, eye.size.x - 1.0))
        let sy = u32(min(px.y, eye.size.y - 1.0))
        to = min(to, far_along(eye, vec2(f32(sx) + 0.5, f32(sy) + 0.5), depth.load(sx, sy)))
    }
    if span.x >= to {
        colour.store(id, vec4(0.0))
        ramp.store(id, vec4(0.0))
        return
    }
    let cone = over.scale * eye.pixel()
    let m = march(medium, haze, eye.at, d, span.x, to, cone, steps, most: passes)
    let (c, r) = laid(medium, m, light, eye.at, d, cone, lights)
    colour.store(id, c)
    ramp.store(id, vec4(r, 0.0, 0.0))
}

impl<M: Medium, H: Haze> Mediums<M, H> {
    /// Its live numbers (`live`) read back, to say them (a check: a read back parts the frame).
    pub fn live_read(self) -> Pending<vec4> {
        read(self.live.items())
    }

    /// Marched into a layer of `frame`'s soft target, labelled `name` in the timings: unless
    /// its bound proves it empty, it's off the screen, or every layer is taken.
    pub fn list(mut self, frame: mut Frame, name: str) {
        let size = frame.soft.size()
        if f32(self.banded.0.width()) != size.x || f32(self.banded.0.height()) != size.y {
            let (w, h) = (u32(size.x), u32(size.y))
            self.banded = (writable_texture(width: w, height: h), writable_texture(width: w, height: h))
        }
        let b = self.form.bound()
        if self.steps.skip != 0 && self.form.interval(b).hi <= 0.0 {
            return
        }
        let eye = frame.eye
        let rect = on_screen(eye, b)
        if rect.z <= rect.x || rect.w <= rect.y {
            return
        }
        let layer = frame.soft.claim(rect, length(0.5 * (b.lo + b.hi) - eye.at))
        if layer >= MOST_SOFT {
            return
        }
        let scale = f32(frame.soft.scale)
        let texels = texels_over(rect, scale, frame.soft.size())
        label(name)
        // (By its kernel for as many live lights as reach its bound: `frame::light::Lit`.)
        let lit = lit_by(frame.light.lights, b.lo, b.hi)
        let need = passes_needed(eye, b, scale, self.form.finest(), self.steps)
        if lit == 0 {
            self.lit_with(mut frame, b, texels, scale, layer, need, Unlit {})
        } else if lit == 1 {
            self.lit_with(mut frame, b, texels, scale, layer, need, OneLit {})
        } else {
            self.lit_with(mut frame, b, texels, scale, layer, need, AllLit {})
        }
    }

    /// [`marched_with`] by the kernel of the least `Cap` that covers `need`.
    fn lit_with<K: Lit>(
        mut self,
        frame: mut Frame,
        b: Box3,
        texels: vec4,
        scale: f32,
        layer: u32,
        need: u32,
        lit: K,
    ) {
        if need <= Cap32::MOST {
            self.marched_with(mut frame, b, texels, scale, layer, lit, Cap32 {})
        } else if need <= Cap64::MOST {
            self.marched_with(mut frame, b, texels, scale, layer, lit, Cap64 {})
        } else if need <= Cap128::MOST {
            self.marched_with(mut frame, b, texels, scale, layer, lit, Cap128 {})
        } else if need <= Cap256::MOST {
            self.marched_with(mut frame, b, texels, scale, layer, lit, Cap256 {})
        } else {
            self.marched_with(mut frame, b, texels, scale, layer, lit, Cap512 {})
        }
    }

    /// Marched into layer `layer` of `frame`'s soft target over `texels`, by its kernel for
    /// `K`'s live lights and at most `C`'s steps and proofs a ray: in bands of rows, each as
    /// much as one dispatch may do (one band but where the eye is in or against the medium).
    fn marched_with<K: Lit, C: Cap>(
        mut self,
        frame: mut Frame,
        b: Box3,
        texels: vec4,
        scale: f32,
        layer: u32,
        _lit: K,
        _cap: C,
    ) {
        // As many rays as one dispatch may march (`step_work` is in thousands).
        let rays = f32(limits().step_work) * 1000.0 / (f32(C::MOST) * f32(STEP_WORK))
        let (x1, y1) = ((u32(texels.z) + 7) / 8 * 8, (u32(texels.w) + 7) / 8 * 8)
        if f32(x1) * f32(y1) <= rays {
            // One dispatch from the layer's corner covers the rectangle: into the layer itself.
            self.march_into(
                mut frame,
                Over { texels, at: vec2(0.0), bound: b, scale },
                layer,
                (x1 / 8, y1 / 8),
                _lit,
                _cap,
            )
            return
        }
        // Else in bands of rows, a workgroup's 8 at least, each into the lister's own pair of
        // textures at their corner, copied into the layer.
        let wide = u32(texels.z - texels.x)
        let high = u32(texels.w - texels.y)
        let rows = max(u32(rays / f32(max(wide, 1))) / 8 * 8, 8)
        var y0: u32 = 0
        while y0 < high {
            let band = min(rows, high - y0)
            let (x, y) = (u32(texels.x), u32(texels.y) + y0)
            let over = Over {
                texels: vec4(texels.x, f32(y), texels.z, f32(y + band)),
                at: vec2(f32(x), f32(y)),
                bound: b,
                scale,
            }
            self.march_banded(mut frame, over, ((wide + 7) / 8, (band + 7) / 8), _lit, _cap)
            copy_texture(self.banded.0.level(0), frame.soft.colour.layer_mut(layer), width: wide, height: band, to_x: x, to_y: y)
            copy_texture(self.banded.1.level(0), frame.soft.ramp.layer_mut(layer), width: wide, height: band, to_x: x, to_y: y)
            y0 += band
        }
    }

    /// One dispatch of the march over `groups` workgroups into layer `layer` itself.
    fn march_into<K: Lit, C: Cap>(
        self,
        frame: mut Frame,
        over: Over,
        layer: u32,
        groups: (u32, u32),
        _lit: K,
        _cap: C,
    ) {
        dispatch(
            marched.bind(
                frame.eye,
                light: frame.light,
                medium: self.form,
                haze: self.haze,
                over: over,
                steps: self.steps,
                depth: frame.depth,
                colour: frame.soft.colour.layer_mut(layer),
                ramp: frame.soft.ramp.layer_mut(layer),
                lights: K::LIVE,
                passes: C::MOST,
                live: self.live.items(),
            ),
            groups: (groups.0, groups.1, 1),
        )
    }

    /// One dispatch of the march over `groups` workgroups into the lister's own pair.
    fn march_banded<K: Lit, C: Cap>(
        mut self,
        frame: mut Frame,
        over: Over,
        groups: (u32, u32),
        _lit: K,
        _cap: C,
    ) {
        dispatch(
            marched.bind(
                frame.eye,
                light: frame.light,
                medium: self.form,
                haze: self.haze,
                over: over,
                steps: self.steps,
                depth: frame.depth,
                colour: mut self.banded.0,
                ramp: mut self.banded.1,
                lights: K::LIVE,
                passes: C::MOST,
                live: self.live.items(),
            ),
            groups: (groups.0, groups.1, 1),
        )
    }
}
