// A medium marched along one ray: its light and cover from where the ray enters its bound to
// where it leaves (or meets the picture), and where along the ray that light comes from.
//
// Each step is the trapezoid of the density at its two ends, laid over as light that a medium
// both gives and takes away (the light of a step is its own times `1 - e^-τ`, τ its optical
// depth), the ray's transmittance carried through. Steps grow with the cone's width (a share of
// it: `Marching::share`), so a far medium costs no more steps than a near one, and are never so
// short that the stretch takes more than `most` of them. The density is read no finer than the
// cone is wide (`Medium::filtered`). Where its bound proves the density 0 over a stretch of
// `SEGMENT` steps (an interval over the stretch's box, by the compiler's derivation), the march
// skips the stretch.
//
// The light a medium scatters is worked out once a ray, where its light comes from (the
// weighted middle of what it hides), facing the way its density falls away there, read as wide
// as the light is spread along the ray: a soft thing's light is a calm shape, banded as a
// surface's is (`form::shade::scattered`). What it emits is added step by step.

use form::kinds::Medium
use form::look::{Haze, Mist}
use form::shade::{MOST_LIGHTS, scattered}
use frame::eye::Eye
use frame::light::Lighting
use std::derive::Box3

/// How many steps a stretch the march proves empty or not at once, and the most stretches one
/// proof may span (each stretch proved empty, the next is twice as long).
pub const SEGMENT: u32 = 8
pub const LONGEST: f32 = 64.0

/// Under this transmittance a ray is taken as hidden: the march stops.
pub const HIDDEN: f32 = 0.002

/// How a medium is marched: its step as a share of the cone's width there, or of half the
/// medium's finest detail where that is longer (`share`), and never shorter than `least` m (the
/// density read as wide as the cone, or `least` where that is wider); the most steps and proofs a ray takes (`limit`); whether the
/// density is read band-limited (`limited`); whether stretches its bound proves empty are
/// skipped (`skip`); and whether a ray stops where the picture's surface at its middle is
/// (`stops`: the plain way, which a texel's neighbours can't share).
pub struct Stepping: Copy + GpuData {
    pub share: f32,
    pub least: f32,
    pub limit: u32,
    pub limited: u32,
    pub skip: u32,
    pub stops: u32,
}

/// What a march gathered along a ray: the light it emits that reaches the eye (`light`), how
/// much of what is behind it hides (`cover`), and, weighted by each step's share of that cover,
/// the sums of its albedo, its forward lobe, the distance along the ray and its square.
pub struct Marched: Copy {
    pub light: vec3,
    pub cover: f32,
    pub albedo: vec3,
    pub forward: f32,
    pub first: f32,
    pub second: f32,
    /// How many steps it took, and how many proofs it asked for.
    pub steps: u32,
    pub proofs: u32,
}

/// Where the ray from `o` along `d` (a unit vector, its every component nonzero or not) crosses
/// `b`: from `x` to `y` m along it, `y` under `x` where it misses. From the eye on, never behind.
pub fn crossing(b: Box3, o: vec3, d: vec3) -> vec2 {
    let inv = vec3(1.0) / select_nonzero(d)
    let a = (b.lo - o) * inv
    let c = (b.hi - o) * inv
    let near = min(a, c)
    let far = max(a, c)
    let from = max(max(near.x, near.y), max(near.z, 0.0))
    let to = min(far.x, min(far.y, far.z))
    vec2(from, to)
}

/// `d` with each component kept off 0 (by a millionth, its sign kept), so its reciprocal is
/// finite.
fn select_nonzero(d: vec3) -> vec3 {
    vec3(off_zero(d.x), off_zero(d.y), off_zero(d.z))
}

fn off_zero(x: f32) -> f32 {
    if abs(x) < 1.0e-6 { if x < 0.0 { -1.0e-6 } else { 1.0e-6 } } else { x }
}

/// The box round the ray from `o` along `d` between `a` and `b` m along it, grown by `grow` m
/// each way.
pub fn stretch(o: vec3, d: vec3, a: f32, b: f32, grow: f32) -> Box3 {
    let p = o + d * a
    let q = o + d * b
    Box3 { lo: min(p, q) - vec3(grow), hi: max(p, q) + vec3(grow) }
}

/// A step's length `t` m along a ray whose cone is `cone` m wide a metre out, through a medium
/// whose finest detail is `finest` m: `share` of the cone's width there, or of half its finest
/// detail where that is longer (finer steps would find nothing more), and never under `least`.
pub fn step_at(t: f32, cone: f32, finest: f32, s: Stepping) -> f32 {
    max(s.share * max(cone * t, 0.5 * finest), s.least)
}

/// How wide a read `t` m along the ray sees: the cone, or the least step where that is wider.
pub fn footprint(t: f32, cone: f32, s: Stepping) -> f32 {
    max(cone * t, s.least)
}

/// The medium's density at `p` as a read `wide` m across sees it, or the point's own if the
/// reads aren't band-limited.
fn read<M: Medium>(medium: M, p: vec3, wide: f32, limited: u32) -> f32 {
    if limited != 0 { medium.filtered(p, wide) } else { medium.density(p) }
}

/// `medium`, wearing `haze`, marched along the ray from `o` along `d` (a unit vector) from
/// `from` to `to` m, its cone `cone` m wide a metre out.
///
/// Before each `SEGMENT` steps it asks whether its bound proves the stretch ahead empty (an
/// interval of the density over the stretch's box, grown by the cone): if so it skips it, and
/// asks next of a stretch twice as long (to `LONGEST` segments); if a long stretch isn't proved
/// empty it asks again of a quarter of it, and once a stretch of one segment isn't, it steps
/// through it. It takes at most `s.limit` steps and proofs, and at most `most`: a cap a kernel
/// gives as a constant (`passes`), so the compiler bounds the kernel's work (docs/rates.md).
pub fn march<M: Medium, H: Haze>(
    medium: M,
    haze: H,
    o: vec3,
    d: vec3,
    from: f32,
    to: f32,
    cone: f32,
    s: Stepping,
    most: u32 = 4294967295,
) -> Marched {
    var out = Marched {
        light: vec3(0.0),
        cover: 0.0,
        albedo: vec3(0.0),
        forward: 0.0,
        first: 0.0,
        second: 0.0,
        steps: 0,
        proofs: 0,
    }
    let finest = medium.finest()
    var t = from
    var through = 1.0
    var before = read(medium, o + d * t, footprint(t, cone, s), s.limited)
    // Steps left before the next stretch is proved empty or not, and how many segments long
    // the next stretch asked of is.
    var left = 0
    var reach = 1.0
    for _i in 0..min(s.limit, most) {
        if t >= to || through < HIDDEN {
            break
        }
        if s.skip != 0 && left == 0 {
            let end = min(t + f32(SEGMENT) * reach * step_at(t, cone, finest, s), to)
            let b = stretch(o, d, t, end, footprint(end, cone, s))
            out.proofs += 1
            if medium.interval(b).hi <= 0.0 {
                t = end
                before = 0.0
                reach = min(2.0 * reach, LONGEST)
                continue
            }
            if reach > 1.0 {
                reach = max(0.25 * reach, 1.0)
                continue
            }
            left = SEGMENT
        }
        let h = min(step_at(t, cone, finest, s), to - t)
        let mid = t + 0.5 * h
        let after = read(medium, o + d * (t + h), footprint(t + h, cone, s), s.limited)
        let rho = 0.5 * (before + after)
        if rho > 0.0 {
            let a = 1.0 - exp(-rho * h)
            let w = through * a
            let m: Mist = haze.mist(o + d * mid, rho)
            out.light += m.emits * w
            out.albedo += m.albedo * w
            out.forward += m.forward * w
            out.first += mid * w
            out.second += mid * mid * w
            through *= 1.0 - a
        }
        before = after
        t += h
        if left > 0 {
            left -= 1
        }
        out.steps += 1
    }
    out.cover = 1.0 - through
    out
}

/// Where along the ray a march's light comes from, as a ramp: its centre (the weighted mean
/// distance) and its half width (√3 times the weighted deviation: a flat stretch of that width
/// has the same mean and spread).
pub fn ramp_of(m: Marched) -> vec2 {
    if m.cover <= 0.0 {
        return vec2(0.0)
    }
    let centre = m.first / m.cover
    let spread = max(m.second / m.cover - centre * centre, 0.0)
    vec2(centre, sqrt(3.0 * spread))
}

/// The way `medium`'s density falls away at `p`, read `wide` m across (a unit vector; `away`
/// where it doesn't change): the medium's own normal, which its light is banded by. From four
/// reads at a tetrahedron's corners `wide / 2` out, whose weighted sum is the gradient's way
/// (four reads where central differences take six).
pub fn facing<M: Medium>(medium: M, p: vec3, wide: f32, away: vec3) -> vec3 {
    let e = 0.5 * wide
    let a = vec3(1.0, -1.0, -1.0)
    let b = vec3(-1.0, -1.0, 1.0)
    let c = vec3(-1.0, 1.0, -1.0)
    let d = vec3(1.0, 1.0, 1.0)
    let g = a * medium.filtered(p + a * e, wide) +
        b * medium.filtered(p + b * e, wide) +
        c * medium.filtered(p + c * e, wide) +
        d * medium.filtered(p + d * e, wide)
    let l = length(g)
    if l < 1.0e-6 { away } else { -g / l }
}

/// How much of the sun reaches `p`: the sun's picture will say. All of it, for now.
pub fn in_sun(p: vec3) -> f32 {
    1.0
}

/// How much of a medium's forward lobe comes through it, for each unit of what it hides, where
/// it hides `cover` of what is behind: light from behind it scattered once toward the eye is
/// τe^-τ of it through a stretch of optical depth τ, which is `cover` for a thin one and falls to
/// nothing in a thick one. So a thick plume seen toward the sun glows at its thin edges, not in
/// its body.
pub fn through(cover: f32) -> f32 {
    if cover < 1.0e-4 {
        return 1.0
    }
    let left = max(1.0 - cover, 1.0e-6)
    -left * log(left) / cover
}

/// What a march lays over its ray: its light (linear, premultiplied: what it emits, and what
/// it scatters, lit once where its light comes from) and its cover; and its ramp. The light it
/// scatters is read facing the way the density falls away there, as wide as the ramp (and no
/// finer than the cone), its forward lobe as much as comes `through` it.
pub fn laid<M: Medium>(
    medium: M,
    m: Marched,
    light: Lighting,
    o: vec3,
    d: vec3,
    cone: f32,
    lights: u32 = MOST_LIGHTS,
) -> (vec4, vec2) {
    if m.cover <= 0.0 {
        return (vec4(0.0), vec2(0.0))
    }
    let r = ramp_of(m)
    let at = o + d * r.x
    let n = facing(medium, at, max(cone * r.x, r.y), -d)
    let mist = Mist { albedo: m.albedo / m.cover, forward: m.forward / m.cover, emits: vec3(0.0) }
    let lit = scattered(
        light.style,
        mist,
        n,
        light.sun,
        -d,
        reach: in_sun(at),
        through: through(m.cover),
        around: light.lights.from(at),
        live: lights,
    )
    (vec4(m.light + lit * m.cover, m.cover), r)
}
