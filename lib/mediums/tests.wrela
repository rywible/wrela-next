// The lister's pure parts on the CPU: where a ray crosses a bound, a march of a medium worked out
// by hand (a slab of fog), the ramp its light makes, skipping what a bound proves empty, the
// forward lobe through a thick medium, the screen a bound covers, and the soft target's ramp.

use form::kinds::Medium
use form::look::{Haze, Mist}
use frame::eye::eye_at
use frame::soft::ramped
use lister::{on_screen, texels_over}
use march::{Stepping, crossing, march, ramp_of, step_at, through}
use std::derive::Box3
use std::io::print

/// Whether `got` is within `tol` of `want` (`want.x`; `want.y` the tolerance).
fn near(got: f32, want: vec2) -> bool {
    abs(got - want.x) <= want.y
}

/// Fog of density `rho` between z = 2 and z = 2 + `deep`, 4 m wide and high round the z axis.
struct Slab: Copy + GpuData {
    rho: f32,
    deep: f32,
}

impl Medium for Slab {
    fn density(self, p: vec3) -> f32 {
        if abs(p.x) <= 2.0 && abs(p.y) <= 2.0 && p.z >= 2.0 && p.z <= 2.0 + self.deep {
            self.rho
        } else {
            0.0
        }
    }

    fn bound(self) -> Box3 {
        Box3 { lo: vec3(-2.0, -2.0, 2.0), hi: vec3(2.0, 2.0, 2.0 + self.deep) }
    }
}

/// Two slabs of fog with an empty metre between them, in a bound that holds both: a march
/// through the gap must skip it, and find what it would have without skipping.
struct Two: Copy + GpuData {}

impl Medium for Two {
    fn density(self, p: vec3) -> f32 {
        let inside = abs(p.x) <= 2.0 && abs(p.y) <= 2.0
        if inside && ((p.z >= 2.0 && p.z <= 3.0) || (p.z >= 9.0 && p.z <= 10.0)) { 0.7 } else {
            0.0
        }
    }

    fn bound(self) -> Box3 {
        Box3 { lo: vec3(-2.0, -2.0, 2.0), hi: vec3(2.0, 2.0, 10.0) }
    }
}

/// A grey that gives off light of 1 a unit of density and scatters none.
struct Glowing: Copy + GpuData {}

impl Haze for Glowing {
    fn mist(self, at: vec3, density: f32) -> Mist {
        Mist { albedo: vec3(0.5), forward: 0.0, emits: vec3(1.0) }
    }
}

const FINE = Stepping { share: 0.25, least: 0.001, limit: 100000, limited: 1, skip: 1, stops: 0 }

@test
fn a_ray_crosses_a_box_where_its_faces_are() {
    let b = Box3 { lo: vec3(-1.0, -1.0, 4.0), hi: vec3(1.0, 1.0, 6.0) }
    let s = crossing(b, vec3(0.0), vec3(0.0, 0.0, 1.0))
    assert(near(s.x, vec2(4.0, 1.0e-5)) && near(s.y, vec2(6.0, 1.0e-5)), f"{s}")
    // From inside, it starts at the eye.
    let inside = crossing(b, vec3(0.0, 0.0, 5.0), vec3(0.0, 0.0, 1.0))
    assert(near(inside.x, vec2(0.0, 1.0e-6)) && near(inside.y, vec2(1.0, 1.0e-5)), f"{inside}")
    // A miss, and a box behind.
    let miss = crossing(b, vec3(0.0), normalize(vec3(1.0, 0.0, 1.0)))
    assert(miss.y < miss.x, f"{miss}")
    let behind = crossing(b, vec3(0.0), vec3(0.0, 0.0, -1.0))
    assert(behind.y < behind.x, f"{behind}")
}

/// Through a slab of fog of density ρ and depth L that gives off light 1 a unit: it hides
/// 1 - e^-ρL of what is behind and gives that much light; its light comes evenly from all of
/// it, so its ramp is centred on its middle and half as wide as it is deep, once it is thin.
@test
fn a_march_through_a_slab_gives_its_closed_form() {
    for k in 0..3 {
        let rho = [0.05, 0.6, 3.0][k]
        let slab = Slab { rho, deep: 2.0 }
        let o = vec3(0.0)
        let d = vec3(0.0, 0.0, 1.0)
        let s = crossing(slab.bound(), o, d)
        let m = march(slab, Glowing {}, o, d, s.x, s.y, 0.001, FINE)
        let cover = 1.0 - exp(-rho * 2.0)
        assert(near(m.cover, vec2(cover, 2.0e-3)), f"cover {m.cover} against {cover}")
        assert(near(m.light.x, vec2(cover, 2.0e-3)), f"light {m.light.x} against {cover}")
        let r = ramp_of(m)
        print(f"slab of density {rho}: cover {m.cover}, ramp centre {r.x} half {r.y}")
        if k == 0 {
            assert(near(r.x, vec2(3.0, 0.02)) && near(r.y, vec2(1.0, 0.02)), f"ramp {r}")
        } else {
            // Denser, its light comes from its near side.
            assert(r.x < 3.0 && r.y < 1.0, f"ramp {r}")
        }
    }
}

/// Skipping what the bound proves empty finds what stepping through it does (the closed form),
/// and takes fewer steps.
@test
fn a_march_skips_only_what_is_proved_empty() {
    let o = vec3(0.0)
    let d = vec3(0.0, 0.0, 1.0)
    let s = crossing(Two {}.bound(), o, d)
    var plain = FINE
    plain.skip = 0
    let a = march(Two {}, Glowing {}, o, d, s.x, s.y, 0.001, FINE)
    let b = march(Two {}, Glowing {}, o, d, s.x, s.y, 0.001, plain)
    print(
        f"two slabs: {a.steps} steps and {a.proofs} proofs skipping, {b.steps} steps without; cover {a.cover} against {b.cover}, light {a.light.x} against {b.light.x}",
    )
    // Both as the closed form has it, to the trapezoid's error across the slabs' sharp faces.
    let exact = 1.0 - exp(-1.4)
    assert(
        near(a.cover, vec2(exact, 1.0e-3)) && near(b.cover, vec2(exact, 1.0e-3)),
        "skipping changed it",
    )
    assert(a.steps < b.steps, "nothing skipped")
}

@test
fn steps_follow_the_cone_and_the_finest_detail() {
    let s = Stepping { share: 2.0, least: 0.01, limit: 512, limited: 1, skip: 1, stops: 0 }
    // The cone, where it is wider than half the finest detail.
    assert(near(step_at(100.0, cone: 0.001, finest: 0.1, s: s), vec2(0.2, 1.0e-6)), "the cone's")
    // Half the finest detail, where that is longer.
    assert(near(step_at(10.0, cone: 0.001, finest: 0.5, s: s), vec2(0.5, 1.0e-6)), "the detail's")
    // Never under the least.
    assert(near(step_at(0.1, cone: 0.001, finest: 0.0, s: s), vec2(0.01, 1.0e-6)), "the least")
}

/// The forward lobe through a medium: all of it through a thin one, τe^-τ over 1 - e^-τ through
/// one of optical depth τ, falling toward nothing.
@test
fn the_forward_lobe_comes_through_thin_medium_only() {
    assert(near(through(0.0), vec2(1.0, 1.0e-6)), "thin")
    var last = 1.0
    for i in 1..20 {
        let tau = 0.25 * f32(i)
        let cover = 1.0 - exp(-tau)
        let got = through(cover)
        assert(near(got, vec2(tau * exp(-tau) / cover, 1.0e-4)), f"at τ {tau}: {got}")
        assert(got < last, "not falling")
        last = got
    }
}

/// The screen a bound covers holds every point of it on the screen; a bound behind the eye's
/// near plane covers the whole screen.
@test
fn a_bounds_rectangle_holds_it() {
    let eye = eye_at(vec3(0.0, 2.0, 10.0), vec3(0.0, 1.0, 0.0), 0.75, width: 1920, height: 1080)
    let b = Box3 { lo: vec3(-3.0, 0.0, -5.0), hi: vec3(2.0, 3.0, -1.0) }
    let r = on_screen(eye, b)
    for i in 0..256 {
        let p = b.sample(5, i)
        let c = eye.clip(p)
        let px = vec2((c.x / c.w + 1.0) * 0.5 * 1920.0, (1.0 - c.y / c.w) * 0.5 * 1080.0)
        let on = px.x >= 0.0 && px.y >= 0.0 && px.x < 1920.0 && px.y < 1080.0
        assert(
            !on ||
                (px.x >= r.x - 1.0e-3 &&
                    px.x <= r.z + 1.0e-3 &&
                    px.y >= r.y - 1.0e-3 &&
                    px.y <= r.w + 1.0e-3),
            f"{px} outside {r}",
        )
    }
    let round = on_screen(eye, Box3 { lo: vec3(-1.0, 1.0, 9.0), hi: vec3(1.0, 3.0, 11.0) })
    assert(round.x == 0.0 && round.y == 0.0 && round.z == 1920.0 && round.w == 1080.0, f"{round}")
    // Its texels, a texel more each way, hold every pixel's four.
    let t = texels_over(r, 4.0, vec2(480.0, 270.0))
    assert(t.x <= floor(r.x / 4.0 - 0.5) && t.z >= ceil(r.z / 4.0 - 0.5) + 1.0, f"{t} for {r}")
}

/// A ramp's share is none nearer than its centre less its half, all past its centre and half,
/// evenly between; with no width, a step at its centre.
@test
fn a_ramps_share_is_even_between_its_ends() {
    let r = vec4(10.0, 2.0, 0.0, 0.0)
    assert(ramped(r, 7.9) == 0.0 && ramped(r, 12.1) == 1.0, "ends")
    assert(
        near(ramped(r, 10.0), vec2(0.5, 1.0e-6)) && near(ramped(r, 9.0), vec2(0.25, 1.0e-6)),
        "between",
    )
    let step = vec4(5.0, 0.0, 0.0, 0.0)
    assert(ramped(step, 4.99) == 0.0 && ramped(step, 5.0) == 1.0, "a step")
}
