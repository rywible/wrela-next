// A charted part of a creature: what an author declares, and how a pose makes it a `Limb`.
// From rywible/wrela's engine/chart.wrela at 7ae6711e.

use chain::{Chain, Change, JOINTS}
use limb::{Band, FOLDS, Fold, Limb, NO_FOLD, NO_STAY, Stay}
use radial::{Radial, round}

/// A charted part of a creature: the chain it's charted about; which of the creature's bones
/// the chain's bones are, in the chain's order, and the bone the chain hangs from (`root`: a
/// chest for an arm); its form at rest; how its form changes where each of its joints bends
/// (`changes[i]` is joint `i`'s; no change where it's nothing); the band of its chart it's
/// drawn over; and how its root is drawn under what covers it (`sunk`: by how far at its path's
/// start, m, and from how far along it not at all; `sunk_by`).
pub struct Part<const A: u32, const R: u32>: Copy {
    pub chain: Chain,
    pub bones: [u32; JOINTS],
    pub root: u32,
    pub form: Radial<A, R>,
    pub changes: [Change<A, R>; JOINTS],
    pub band: Band,
    pub sunk: vec2,
    /// Which of its joints are hinges it folds at (`Fold`: an elbow, a knee), by their place in
    /// its chain; 0 for none.
    pub folds: [u32; FOLDS] = [0; FOLDS],
    /// Where it closes to a point, at its path's start and at its end (`Limb::caps`).
    pub caps: vec2 = vec2(0.0, 0.0),
    /// How many faces it shows (`Limb::faces`): 2 for an open sheet whose inside is seen.
    pub faces: u32 = 1,
    /// The bone some of its side stays with, and what of it does (`Stay`'s `round` and `along`):
    /// none of it, unless said.
    pub stays_with: u32 = 0,
    pub stays: Stay = NO_STAY,
}

/// No change at a joint.
pub fn unchanged<const A: u32, const R: u32>() -> Change<A, R> {
    Change { by_angle: round(0.0), by_square: round(0.0) }
}

impl<const A: u32, const R: u32> Part<A, R> {
    /// It at rest.
    pub fn rest(self) -> Limb<A, R> {
        Limb {
            path: self.chain.rest(),
            form: self.form,
            caps: self.caps,
            band: self.band,
            faces: self.faces,
            stay: Stay { by: NO_STAY.by, ..self.stays },
        }
    }

    /// It as a pose has it (`palette`: each of the creature's bones' matrices, from the body at
    /// rest to where the pose has it): its path where its bones are, its form changed where
    /// its joints bend.
    pub fn posed(self, palette: [mat4; 64]) -> Limb<A, R> {
        var bones = [palette[self.root]; JOINTS]
        for i in 0..self.chain.count - 1 {
            bones[i] = palette[self.bones[i]]
        }
        let bends = self.chain.bends(bones)
        var form = self.form
        for i in 1..self.chain.count - 1 {
            form = form.bent(self.changes[i], bends[i])
        }
        let path = self.chain.posed(palette[self.root], bones)
        var folds = [NO_FOLD; FOLDS]
        for k in 0..FOLDS {
            let b = bends[self.folds[k]]
            // (A hinge bent less than a sixth of a turn has room for both its sides.)
            if self.folds[k] > 0 && b.angle > 1.0 {
                folds[k] = Fold {
                    at: b.at,
                    slope: 1.0 / tan(0.5 * min(b.angle, 3.0)),
                    toward: b.toward,
                    after: b.after,
                    reached: b.reached,
                    length: path.length(),
                }
            }
        }
        Limb {
            path,
            form,
            folds,
            caps: self.caps,
            band: self.band,
            faces: self.faces,
            stay: Stay { by: palette[self.stays_with], ..self.stays },
        }
    }

    /// How far under what covers it its side is drawn, `f` of the way along its path (m).
    pub fn sunk_at(self, f: f32) -> f32 {
        sunk_by(self.sunk, f)
    }
}

/// How far under what covers it a part's side is drawn `f` of the way along its path (m), for
/// the part's `sunk`: all of it over the first two fifths of the way to where it's none.
pub fn sunk_by(sunk: vec2, f: f32) -> f32 {
    sunk.x * (1.0 - smoothstep(0.4 * sunk.y, sunk.y, f))
}
