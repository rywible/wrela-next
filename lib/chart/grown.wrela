// A form that grows from another or lies on it: a thumb from a palm, a head from a neck, a
// jacket's collar on its body. What moves its side, and how its light leans to the other's.
// rywible/wrela's engine/chart.wrela at 7ae6711e applied it per vertex (`vertex_onto`,
// lines 1948-2042 there; `lit::vertex_onto` here); this is what moves a side.

/// How far a form's side is moved out where it meets the form it grows from: `d` from that
/// form's side (m; negative inside it), the two sides' outward normals `cos` apart (the cosine
/// of the angle between them). A fillet of radius `by`: the arc that touches both sides, which
/// two sides at right angles reach `by` from where they cross, and two that meet nearly flush
/// hardly at all (the side is moved `by · (1 − √(1 − tan²(φ/2)))` where they cross, φ the
/// angle between the normals). Two forms that only cross meet at a crease; skin doesn't.
pub fn fillet(d: f32, by: f32, cos: f32) -> f32 {
    let c = clamp(cos, -0.999, 0.999)
    let t = sqrt((1.0 - c) / (1.0 + c))
    let x = clamp(t - d / (max(by, 0.000001) * sqrt(1.0 - c * c)), 0.0, min(t, 1.0))
    by * (1.0 - sqrt(max(1.0 - x * x, 0.0)))
}

/// How a form grows from another, or lies on it. Its side starts on the other
/// form's and rises to its own by `rooted` of the way along its path (eased at both ends, and
/// slowest to leave: it lies along the other side before it lifts off it, as the ball of a
/// thumb leaves the heel of a hand; 0: it stands on the other form as it is, a finger on a
/// knuckle). And where its side nears the other's, a fillet of radius `fillet` (m), whole over
/// the first half of `reach` of its path and gone by `reach`, so a fingertip curled back to
/// the palm it grew from only touches it. Within the fillet's radius of the other side its
/// light leans to that side's (`leant`): two sides that meet nearly flush have next to no
/// fillet between them, and would still be lit as two.
///
/// A piece of a garment that lies on another piece (a shoulder on a jacket's body) is laid on
/// it: within `laid` (m) of the other form's side, either side of it, its side is put on that
/// side (`laid_at`), so the two are one surface where they overlap however they were posed,
/// and no edge of the one stands off the other. Only where the other form is: `cover` says
/// which of the covers the vertex is given is the other form's (`COVERLESS`: it has none).
pub struct Grown: Copy + GpuData {
    pub fillet: f32,
    pub reach: f32,
    pub rooted: f32 = 0.0,
    pub laid: f32 = 0.0,
    pub cover: u32 = COVERLESS,
    /// How far past the edge of the other form's cover (places) its light is still that
    /// form's, wholly: a piece that carries a surface on from where the other form stops (a
    /// collar's foot, on up a back from where the jacket's body ends) is one surface with it,
    /// and lit by its own form it showed as a panel set into the back. 0: its own light from
    /// the edge on.
    pub beyond: f32 = 0.0,
}

/// A form with no cover: it's everywhere on its chart.
pub const COVERLESS: u32 = 4294967295

/// How far under the form it grows from a rooted form's side starts (m), and how far over the
/// form it lies on a laid form's side is put.
pub const UNDER: f32 = 0.0002
pub const OVER: f32 = 0.0004

/// How many places inside its cover's edge the other form counts as wholly there, for a form
/// laid on it: nearer its edge the laid form comes away to its own side.
pub const THERE: f32 = 2.0

impl Grown {
    /// How much of the way to the other form's side its side is held, `f` of the way along.
    pub fn held(self, f: f32) -> f32 {
        if self.rooted <= 0.0 {
            return 0.0
        }
        let risen = smoothstep(0.0, self.rooted, f)
        1.0 - risen * risen
    }

    /// How far off the other form's side a point `d` off it (m; negative inside) is put, laid
    /// on it: `OVER` it from as far inside as half of `laid` to on it, rising to where it was
    /// by `laid` off it, and left where it was from `laid` inside. Where it was, if it isn't
    /// laid.
    pub fn laid_at(self, d: f32) -> f32 {
        if self.laid <= 0.0 {
            return d
        }
        if d >= OVER {
            return OVER + (d - OVER) * smoothstep(0.0, self.laid, d)
        }
        mix(d, OVER, smoothstep(-self.laid, -0.5 * self.laid, d))
    }

    /// How far a point of its side `f` of the way along is moved, and which way: `d` from the
    /// other form's side (m; negative inside), that side's way out `other`, its own `out`,
    /// and how much of the other form is `there` (0 at an opening in it: nothing to lie on or
    /// meet). Laid on the other side (`laid_at`); toward it by what it's held (and `UNDER`
    /// it, so the two don't lie in one another); and out by the fillet of what's left.
    pub fn moved(self, f: f32, d: f32, other: vec3, out: vec3, there: f32 = 1.0) -> vec3 {
        let on = mix(d, self.laid_at(d), there)
        let held = self.held(f) * there
        let across = self.fillet * there * (1.0 - smoothstep(0.5 * self.reach, self.reach, f))
        let up = (1.0 - held) * fillet((1.0 - held) * on, across, dot(out, other))
        out * up + other * (on - d - held * (max(on, 0.0) + UNDER))
    }

    /// How much of its light is the other form's, wholly, at a point `within` places inside
    /// the edge of that form's cover (negative: past the edge): all of it as far as `beyond`
    /// places past the edge, none `THERE` places further.
    pub fn lit_past(self, within: f32) -> f32 {
        if self.beyond <= 0.0 {
            return 0.0
        }
        saturate((within + self.beyond) / THERE)
    }

    /// How much of the other side's way out a point's normal takes, `f` of the way along and
    /// `d` off that side once it's moved (m): all of it on the side, none the fillet's radius
    /// off it, and none past the fillet's reach.
    pub fn leant(self, f: f32, d: f32) -> f32 {
        let across = 1.0 - smoothstep(0.5 * self.reach, self.reach, f)
        across * (1.0 - smoothstep(0.0, max(self.fillet, 0.000001), max(d, 0.0)))
    }
}
