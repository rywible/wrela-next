// Where on its chart a form is: a bit a place, and how far inside the edge each place is. From
// rywible/wrela's engine/chart.wrela at 7ae6711e.

use std::collections::Vec
use std::math::TAU

/// How many places along a path, and round it, a cover marks.
pub const COVER_ALONG: u32 = 96
pub const COVER_ROUND: u32 = 256

/// The words a cover's marks take: a bit a place.
pub const COVER_WORDS: u32 = 768

/// The places a cover marks.
pub const COVER_PLACES: u32 = COVER_ALONG * COVER_ROUND

/// How far from a cover's edge its places are told apart (places along its path): further in
/// or out than this, a place is this far.
pub const EDGE_REACH: f32 = 12.0

/// Where on its chart a form is: a garment's openings (a jacket's front, its armholes) are
/// where it isn't. A bit a place, `COVER_ALONG` along the path by `COVER_ROUND` round it from
/// angle 0, set where the form is. What's drawn reads how far inside the cover's edge a place
/// is (`edges`, then `inside`), between places, so
/// an opening's edge is a line and not a row of teeth a place wide.
pub struct Cover: Copy {
    pub words: [u32; COVER_WORDS],
}

impl Cover {
    /// Whether its form is at place (`i` along, `j` round, counted round the whole turn).
    pub fn at(self, i: u32, j: u32) -> bool {
        let k = min(i, COVER_ALONG - 1) * COVER_ROUND + j % COVER_ROUND
        (self.words[k / 32] >> (k % 32)) & 1 == 1
    }

    /// How far inside its edge each place is (`COVER_PLACES` numbers, in places along the
    /// path: under 0 where the form isn't, 0 on the edge, which runs midway between a place
    /// the form is at and one it isn't; held within `EDGE_REACH`). `round` is how long a
    /// place round the path is against a place along it. Made once, when a program loads:
    /// each place's distance from the nearest edge, carried from place to place over the
    /// grid twice each way (twice, since the grid closes on itself round the path).
    pub fn edges(self, round: f32) -> Vec<f32> {
        let far = 4.0 * EDGE_REACH
        let across = sqrt(1.0 + round * round)
        var d: Vec<f32> = Vec::new()
        // A place beside the edge starts half a step from it.
        for i in 0..COVER_ALONG {
            for j in 0..COVER_ROUND {
                let here = self.at(i, j)
                var least = far
                for di in 0..3 {
                    if i + di < 1 || i + di > COVER_ALONG {
                        continue
                    }
                    for dj in 0..3 {
                        if self.at(i + di - 1, j + dj + COVER_ROUND - 1) != here {
                            let step = if di == 1 { round } else if dj == 1 { 1.0 } else { across }
                            least = min(least, 0.5 * step)
                        }
                    }
                }
                d.push(least)
            }
        }
        for _ in 0..2 {
            // Down the path and round it, then back.
            for i in 0..COVER_ALONG {
                for j in 0..COVER_ROUND {
                    let k = i * COVER_ROUND + j
                    let before = i * COVER_ROUND + (j + COVER_ROUND - 1) % COVER_ROUND
                    var least = min(d[k], d[before] + round)
                    if i > 0 {
                        let up = k - COVER_ROUND
                        least = min(least, d[up] + 1.0)
                        least = min(least, d[before - COVER_ROUND] + across)
                        least = min(least, d[up - j + (j + 1) % COVER_ROUND] + across)
                    }
                    d[k] = least
                }
            }
            for ii in 0..COVER_ALONG {
                let i = COVER_ALONG - 1 - ii
                for jj in 0..COVER_ROUND {
                    let j = COVER_ROUND - 1 - jj
                    let k = i * COVER_ROUND + j
                    let after = i * COVER_ROUND + (j + 1) % COVER_ROUND
                    var least = min(d[k], d[after] + round)
                    if i + 1 < COVER_ALONG {
                        let down = k + COVER_ROUND
                        least = min(least, d[down] + 1.0)
                        least = min(least, d[after + COVER_ROUND] + across)
                        least = min(
                            least,
                            d[down - j + (j + COVER_ROUND - 1) % COVER_ROUND] + across,
                        )
                    }
                    d[k] = least
                }
            }
        }
        for i in 0..COVER_ALONG {
            for j in 0..COVER_ROUND {
                let k = i * COVER_ROUND + j
                let by = min(d[k], EDGE_REACH)
                d[k] = if self.at(i, j) { by } else { -by }
            }
        }
        // (Marks say which side of the edge a place is on, not where between two places the
        // edge runs, so the distances step as the marks do where an edge slants: evened over
        // each place's neighbours, twice, the steps are gone and a corner is rounded by about
        // a place.)
        for _ in 0..2 {
            var even: Vec<f32> = Vec::new()
            for i in 0..COVER_ALONG {
                let up = if i > 0 { i - 1 } else { i }
                let down = min(i + 1, COVER_ALONG - 1)
                for j in 0..COVER_ROUND {
                    let before = (j + COVER_ROUND - 1) % COVER_ROUND
                    let after = (j + 1) % COVER_ROUND
                    var sum = 0.0
                    for row in [up, i, i, down] {
                        let r = row * COVER_ROUND
                        sum += d[r + before] + 2.0 * d[r + j] + d[r + after]
                    }
                    even.push(sum / 16.0)
                }
            }
            d = take even
        }
        d
    }
}

/// How far inside a cover's edge the place `f` of the way along and at angle `theta` is, by
/// the cover's `edges` (places along the path; under 0 where the form isn't): read between
/// places. Where `edges` holds several covers' one after another, `at` says which.
pub fn inside(edges: [f32], f: f32, theta: f32, at: u32 = 0) -> f32 {
    let first = at * COVER_PLACES
    let x = clamp(f * f32(COVER_ALONG) - 0.5, 0.0, f32(COVER_ALONG - 1))
    let y = fract(theta / TAU + 1.0) * f32(COVER_ROUND) - 0.5 + f32(COVER_ROUND)
    let i = u32(x)
    let i1 = min(i + 1, COVER_ALONG - 1)
    let j = u32(y) % COVER_ROUND
    let j1 = (j + 1) % COVER_ROUND
    let fx = x - f32(i)
    let fy = y - floor(y)
    mix(
        mix(edges[first + i * COVER_ROUND + j], edges[first + i1 * COVER_ROUND + j], fx),
        mix(edges[first + i * COVER_ROUND + j1], edges[first + i1 * COVER_ROUND + j1], fx),
        fy,
    )
}

/// A cover from marks: `marks[i * COVER_ROUND + j]` says whether the form is at place `i`
/// along, `j` round.
pub fn cover_of(marks: [bool]) -> Cover {
    assert(marks.len() == COVER_ALONG * COVER_ROUND, "a cover has a mark a place")
    var words = [0; COVER_WORDS]
    for k in 0..marks.len() {
        if marks[k] {
            words[k / 32] = words[k / 32] | (1 << (k % 32))
        }
    }
    Cover { words }
}
