// The radius of a charted form at each place on its chart, and its algebra: forms add, turn,
// mirror, bend with a joint, resize, soften. From rywible/wrela's engine/chart.wrela at
// 7ae6711e.

use chain::{Bend, Change}
use fit::{Sample, fit}
use std::collections::Vec
use std::math::TAU

/// A radius over a chart, linear in its numbers: `A` control values along the path (uniform
/// cubic B-splines over the span from `from` to `to` of the path's length; held beyond it),
/// each a Fourier series round it of `R` terms (1, then a cosine and a sine a harmonic, so `R`
/// is odd).
pub struct Radial<const A: u32, const R: u32>: Copy + GpuData {
    pub from: f32,
    pub to: f32,
    pub coef: [[f32; R]; A],
}

/// The four spline weights at `u` (0 to 1) of the way through a segment, and their slopes.
pub(package) fn spline(u: f32) -> (vec4, vec4) {
    let u2 = u * u
    let u3 = u2 * u
    (
        vec4(
            (1.0 - 3.0 * u + 3.0 * u2 - u3) / 6.0,
            (3.0 * u3 - 6.0 * u2 + 4.0) / 6.0,
            (-3.0 * u3 + 3.0 * u2 + 3.0 * u + 1.0) / 6.0,
            u3 / 6.0,
        ),
        vec4(
            (-1.0 + 2.0 * u - u2) / 2.0,
            (3.0 * u2 - 4.0 * u) / 2.0,
            (-3.0 * u2 + 2.0 * u + 1.0) / 2.0,
            u2 / 2.0,
        ),
    )
}

/// A round form: radius `r` everywhere.
pub fn round<const A: u32, const R: u32>(r: f32) -> Radial<A, R> {
    var coef = [[0.0; R]; A]
    for i in 0..A {
        coef[i][0] = r
    }
    Radial { from: 0.0, to: 1.0, coef }
}

impl<const A: u32, const R: u32> Radial<A, R> {
    /// The first control value that weighs at `f` of the way along, how far through its segment
    /// `f` is, and how many segments one of path's length is.
    pub(package) fn segment(self, f: f32) -> (u32, f32, f32) {
        let segs = A - 3
        let per = f32(segs) / max(self.to - self.from, 0.000001)
        let x = clamp((f - self.from) * per, 0.0, f32(segs))
        let i = min(u32(x), segs - 1)
        (i, x - f32(i), per)
    }

    /// Its radius at `f` of the way along and angle `theta` (m), how fast it changes with `f`
    /// (per whole length), and with `theta` (per radian).
    pub fn radius_and_slopes(self, f: f32, theta: f32) -> vec3 {
        let (i, u, per) = self.segment(f)
        let (w, dw) = spline(u)
        // (Held past its span: no slope along.)
        let inside = if f > self.from && f < self.to { per } else { 0.0 }
        let c = cos(theta)
        let s = sin(theta)
        var ch = 1.0
        var sh = 0.0
        var out = vec3()
        for j in 0..R {
            // Term `j` round the path: 1, then cos and sin of each harmonic, and its slope.
            let h = (j + 1) / 2
            var term = 1.0
            var slope = 0.0
            if j % 2 == 1 {
                // (On to the next harmonic.)
                let next = vec2(ch * c - sh * s, sh * c + ch * s)
                ch = next.x
                sh = next.y
                term = ch
                slope = -f32(h) * sh
            } else if j > 0 {
                term = sh
                slope = f32(h) * ch
            }
            let k = w.x * self.coef[i][j] +
                w.y * self.coef[i + 1][j] +
                w.z * self.coef[i + 2][j] +
                w.w * self.coef[i + 3][j]
            let dk = dw.x * self.coef[i][j] +
                dw.y * self.coef[i + 1][j] +
                dw.z * self.coef[i + 2][j] +
                dw.w * self.coef[i + 3][j]
            out += vec3(k * term, dk * term * inside, k * slope)
        }
        out
    }

    /// Its radius at `f` of the way along and angle `theta` (m).
    pub fn radius(self, f: f32, theta: f32) -> f32 {
        self.radius_and_slopes(f, theta).x
    }

    /// It with `by` times `other` added: a change with the pose, a garment's thickness, the
    /// difference between two bodies.
    pub fn plus(self, other: Radial<A, R>, by: f32 = 1.0) -> Radial<A, R> {
        assert(
            abs(self.from - other.from) < 0.00001 && abs(self.to - other.to) < 0.00001,
            "forms that are added cover the same span of their path",
        )
        var coef = self.coef
        for i in 0..A {
            for j in 0..R {
                coef[i][j] += by * other.coef[i][j]
            }
        }
        Radial { coef, ..self }
    }

    /// It turned about its path by `angle` (toward the left): its radius at an angle is what
    /// it was `angle` before. A change with a joint's bend is written for a bend toward angle
    /// 0 and turned to where the bend is.
    pub fn turned(self, angle: f32) -> Radial<A, R> {
        var coef = self.coef
        for j in 0..(R - 1) / 2 {
            let k = f32(j + 1)
            let c = cos(k * angle)
            let s = sin(k * angle)
            for i in 0..A {
                let a = self.coef[i][2 * j + 1]
                let b = self.coef[i][2 * j + 2]
                coef[i][2 * j + 1] = a * c - b * s
                coef[i][2 * j + 2] = a * s + b * c
            }
        }
        Radial { coef, ..self }
    }

    /// Its mirror image: its radius at an angle is what it was at the angle's negative. A
    /// right limb's form is its left's, mirrored, about the left's chain mirrored.
    pub fn mirrored(self) -> Radial<A, R> {
        var coef = self.coef
        for j in 0..(R - 1) / 2 {
            for i in 0..A {
                coef[i][2 * j + 2] = -self.coef[i][2 * j + 2]
            }
        }
        Radial { coef, ..self }
    }

    /// It turned about its path, each control value along it by its own angle (`angles`, toward
    /// the left): a turn that changes along the path.
    pub fn turned_along(self, angles: [f32; A]) -> Radial<A, R> {
        var coef = self.coef
        for i in 0..A {
            for j in 0..(R - 1) / 2 {
                let k = f32(j + 1)
                let c = cos(k * angles[i])
                let s = sin(k * angles[i])
                let a = self.coef[i][2 * j + 1]
                let b = self.coef[i][2 * j + 2]
                coef[i][2 * j + 1] = a * c - b * s
                coef[i][2 * j + 2] = a * s + b * c
            }
        }
        Radial { coef, ..self }
    }

    /// Where control value `i` along the path weighs most (of the way along).
    pub fn place_of_control(self, i: u32) -> f32 {
        self.from + (self.to - self.from) * (f32(i) - 1.0) / f32(A - 3)
    }

    /// It as a joint's bend changes it: with `change`'s two forms added, each turned to where
    /// the bend's inside is along the path (`Bend::lean_at`), one times the bend's angle and
    /// one times its square.
    pub fn bent(self, change: Change<A, R>, bend: Bend) -> Radial<A, R> {
        if bend.angle <= 0.0 {
            return self
        }
        var angles = [0.0; A]
        for i in 0..A {
            angles[i] = bend.lean_at(change.by_angle.place_of_control(i))
        }
        let by = min(bend.angle, change.upto)
        self
            .plus(change.by_angle.turned_along(angles), by: by)
            .plus(change.by_square.turned_along(angles), by: by * by)
    }

    /// It in `A2` control values along and `R2` terms round: the form of that size nearest it
    /// (the same form, where `R2` is at least `R` and `A2` is `A`). A change solved small is
    /// made the size of the form it changes.
    pub fn resized<const A2: u32, const R2: u32>(self) -> Radial<A2, R2> {
        var samples: Vec<Sample> = Vec::new()
        let along = 4 * max(A, A2)
        let about = 4 * max(R, R2)
        for i in 0..along + 1 {
            for j in 0..about {
                let f = mix(self.from, self.to, f32(i) / f32(along))
                let theta = TAU * f32(j) / f32(about)
                samples.push(Sample { f, theta, r: self.radius(f, theta) })
            }
        }
        fit(samples, from: self.from, to: self.to, smooth: 0.0)
    }

    /// It with only its first `R2` terms round (`R2` no more than `R`, and odd: whole
    /// harmonics). A form softened for shading has next to nothing in its finer harmonics, and
    /// a pixel that reads it pays for every term: kept to what's left, it's the same light for
    /// less.
    pub fn kept<const R2: u32>(self) -> Radial<A, R2> {
        assert(
            R2 <= R && R2 % 2 == 1,
            "kept takes an odd count of terms, no more than the form has",
        )
        var out: Radial<A, R2> = Radial { from: self.from, to: self.to, coef: [[0.0; R2]; A] }
        for i in 0..A {
            for k in 0..R2 {
                out.coef[i][k] = self.coef[i][k]
            }
        }
        out
    }

    /// It with its finer detail round the path damped: each harmonic kept by
    /// 1 / (1 + (h / `detail`)⁸), so those under `detail` stay and those over it go.
    /// A form's shading reads its normal from this (`normal_at`): the small ripples a fit
    /// leaves are a fraction of a millimetre on the silhouette, but they tilt the surface
    /// enough to fray a cel's bands of light.
    pub fn softened(self, detail: f32) -> Radial<A, R> {
        var coef = self.coef
        for j in 0..(R - 1) / 2 {
            let x = f32(j + 1) / max(detail, 0.001)
            let x4 = x * x * x * x
            let keep = 1.0 / (1.0 + x4 * x4)
            for i in 0..A {
                coef[i][2 * j + 1] = keep * self.coef[i][2 * j + 1]
                coef[i][2 * j + 2] = keep * self.coef[i][2 * j + 2]
            }
        }
        Radial { coef, ..self }
    }
}
