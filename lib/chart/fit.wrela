// Fitting a radial form: one exact least-squares solve, from samples (`fit`) or from a rule
// (`of`). From rywible/wrela's engine/chart.wrela at 7ae6711e.

use radial::{Radial, spline}
use std::collections::Vec
use std::math::TAU

/// A radius read off a target: at `f` of the way along a path and angle `theta` round it, the
/// target's side is `r` from the path.
pub struct Sample: Copy {
    pub f: f32,
    pub theta: f32,
    pub r: f32,
}

/// The term round the path each of `R` numbers weighs at angle `theta`.
pub fn terms<const R: u32>(theta: f32) -> [f64; R] {
    var out = [0.0; R]
    out[0] = 1.0
    for j in 1..R {
        let h = f32((j + 1) / 2)
        out[j] = f64(if j % 2 == 1 { cos(h * theta) } else { sin(h * theta) })
    }
    out
}

/// The radial form over the span from `from` to `to` nearest `samples`, by least squares: one
/// exact solve (the normal equations, by their LDLᵀ factors), with no starting guess and no
/// other minimum to fall into. `smooth` weighs how much a control value may differ from the line
/// through its neighbours along the path (times the samples' count): a little carries the form
/// on evenly where no sample reaches.
pub fn fit<const A: u32, const R: u32>(
    samples: [Sample],
    from: f32 = 0.0,
    to: f32 = 1.0,
    smooth: f64 = 0.0001,
) -> Radial<A, R> {
    assert(A >= 4, "a radial form has four or more control values along its path")
    assert(R % 2 == 1, "a radial form has a cosine and a sine a harmonic")
    let n = A * R
    let shape: Radial<A, R> = Radial { from, to, coef: [[0.0; R]; A] }
    var m: Vec<f64> = Vec::filled(n * n, value: 0.0)
    var g: Vec<f64> = Vec::filled(n, value: 0.0)
    for s in samples {
        let (i, u, _) = shape.segment(s.f)
        let (w4, _) = spline(u)
        let w = [f64(w4.x), f64(w4.y), f64(w4.z), f64(w4.w)]
        let round: [f64; R] = terms(s.theta)
        for a1 in 0..4 {
            for j1 in 0..R {
                let k1 = (i + a1) * R + j1
                let v1 = w[a1] * round[j1]
                g[k1] += v1 * f64(s.r)
                // (The sums' upper half: the matrix is symmetric, and is filled out after.)
                for a2 in a1..4 {
                    let row = k1 * n + (i + a2) * R
                    let v = v1 * w[a2]
                    for j2 in (if a2 == a1 { j1 } else { 0 })..R {
                        m[row + j2] += v * round[j2]
                    }
                }
            }
        }
    }
    for x in 0..n {
        for y in x + 1..n {
            m[y * n + x] = m[x * n + y]
        }
    }
    // Each control value near the line through its neighbours along the path.
    let lam = smooth * f64(max(samples.len(), 1))
    for i in 1..A - 1 {
        for j in 0..R {
            let k = [(i - 1) * R + j, i * R + j, (i + 1) * R + j]
            let c = [1.0, -2.0, 1.0]
            for a in 0..3 {
                for b in 0..3 {
                    m[k[a] * n + k[b]] += lam * c[a] * c[b]
                }
            }
        }
    }
    for k in 0..n {
        m[k * n + k] += 0.000000001
    }
    let solved = solve_symmetric(take m, g, n)
    var coef = [[0.0; R]; A]
    for i in 0..A {
        for j in 0..R {
            coef[i][j] = f32(solved[i * R + j])
        }
    }
    Radial { from, to, coef }
}

/// `x` where the symmetric, positive definite `n` by `n` matrix `m` times `x` is `g`: by its
/// LDLᵀ factors (a unit lower triangle L below the diagonal, D on it).
pub fn solve_symmetric(m: take Vec<f64>, g: [f64], n: u32) -> Vec<f64> {
    var a = take m
    for p in 0..n {
        var dp = a[p * n + p]
        for t in 0..p {
            dp -= a[p * n + t] * a[p * n + t] * a[t * n + t]
        }
        assert(dp > 0.0, "a fit's normal equations aren't positive definite")
        a[p * n + p] = dp
        for q in p + 1..n {
            var v = a[q * n + p]
            for t in 0..p {
                v -= a[q * n + t] * a[p * n + t] * a[t * n + t]
            }
            a[q * n + p] = v / dp
        }
    }
    var y: Vec<f64> = Vec::filled(n, value: 0.0)
    for p in 0..n {
        var v = g[p]
        for t in 0..p {
            v -= a[p * n + t] * y[t]
        }
        y[p] = v
    }
    var x: Vec<f64> = Vec::filled(n, value: 0.0)
    var p = n
    while p > 0 {
        p -= 1
        var v = y[p] / a[p * n + p]
        for t in p + 1..n {
            v -= a[t * n + p] * x[t]
        }
        x[p] = v
    }
    x
}

/// The radial form nearest a radius written as a function of its place (`f` of the way along,
/// the angle round): a change with the pose or a garment's thickness written as a rule, put in
/// the same numbers as the form it changes. Sampled at 4 places a control value by 4 angles a
/// term.
pub fn of<const A: u32, const R: u32>(
    radius: fn(f32, f32) -> f32,
    from: f32 = 0.0,
    to: f32 = 1.0,
) -> Radial<A, R> {
    var samples: Vec<Sample> = Vec::new()
    let along = 4 * A
    let about = 4 * R
    for i in 0..along + 1 {
        for j in 0..about {
            let f = from + (to - from) * f32(i) / f32(along)
            let theta = TAU * f32(j) / f32(about)
            samples.push(Sample { f, theta, r: radius(f, theta) })
        }
    }
    fit(samples, from: from, to: to, smooth: 0.0)
}
