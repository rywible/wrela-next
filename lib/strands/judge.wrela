// The strands' own judge: `frame::judge`'s steps from moment to moment and its difference from
// the reference, counted only where strands are (where the reference's looks met a strand, this
// moment or the last, and the pixels beside them). The
// frame's judge counts every pixel, and the land's crest against the sky, which steps a pixel at
// a time (docs/heights.md), crawls more than the grass does.
//
// The reference's looks are drawn by the scene into a `frame::judge::Judge`'s look targets (its
// strands' normals with `w` 1); this judge sums them, a moment's mean, and counts:
//
//   0 pixels judged (strands near)       1 edge pixels among them (the reference's cover of
//                                          anything between a fiftieth and all but a fiftieth)
//   2 the pictures' difference, summed (of 255)   3 on edge pixels
//   4 picture steps over 15/255 a moment  5 the reference's
//   6 picture steps on edge pixels        7 the reference's
//   8 pixels where strands are this moment or the last (steps are counted over these)
//   9 the picture's mean brightness over them (of 255, summed)   10 the reference's
//   11 edge pixels where strands are this moment or the last

use form::ink::InkStyle
use form::kinds::Paint
use frame::eye::Eye
use frame::judge::{Judge, halton, shown}
use frame::last::cover
use frame::picture::{Frame, STRAND, kind_of}
use std::gpu::{
    Atomics, DepthTexture, FragCoord, GlobalId, GpuBuffer, R32Uint, Rgba16Float, Rgba32Float,
    Texture, begin_pass, begin_screen_pass, buffer_of, dispatch, draw, label, read, texture,
}
use std::io::{Pending, print}

/// How many numbers it counts.
pub const COUNTS: u32 = 12

/// One look added to the sum so far (`first` 1: none): its colour in `xyz`, and in `w` whether
/// it met a strand, each a `share` of the mean.
@fragment
pub fn summed(
    pixel: FragCoord,
    colour: Texture<Rgba16Float>,
    normal: Texture<Rgba16Float>,
    depth: DepthTexture,
    sofar: Texture<Rgba32Float>,
    first: u32,
    share: f32,
) -> vec4 {
    let x = u32(pixel.position.x)
    let y = u32(pixel.position.y)
    let strand = if depth.load(x, y) > 0.0 && normal.load(x, y).w > 0.5 { share } else { 0.0 }
    let look = vec4(colour.load(x, y).xyz * share, strand)
    if first != 0 { look } else { sofar.load(x, y) + look }
}

/// The sum, as a picture.
@fragment
pub fn meant(pixel: FragCoord, sum: Texture<Rgba32Float>) -> vec4 {
    sum.load(u32(pixel.position.x), u32(pixel.position.y))
}

/// Whether the picture's pixel shows a strand: 1 or 0 in `x`.
@fragment
pub fn strand_mask(pixel: FragCoord, ids: Texture<R32Uint>, depth: DepthTexture) -> vec4 {
    let x = u32(pixel.position.x)
    let y = u32(pixel.position.y)
    vec4(if depth.load(x, y) > 0.0 && kind_of(ids.load(x, y)) == STRAND { 1.0 } else {
        0.0
    }, 0.0, 0.0, 1.0)
}

fn luma(c: vec3) -> f32 {
    dot(saturate(c), vec3(0.2126, 0.7152, 0.0722))
}

/// Whether strands are at or beside pixel (`x`, `y`): where any of the reference's looks met
/// one (its mean's `w`). The reference's alone, so pictures drawn with any identity are counted
/// over the same pixels.
fn near_strands(mask: Texture<Rgba16Float>, mean: Texture<Rgba16Float>, x: u32, y: u32) -> bool {
    let w = mask.width()
    let h = mask.height()
    for k in 0..9 {
        let nx = u32(clamp(i32(x) + i32(k % 3) - 1, 0, i32(w) - 1))
        let ny = u32(clamp(i32(y) + i32(k / 3) - 1, 0, i32(h) - 1))
        if mean.load(nx, ny).w > 0.0 {
            return true
        }
    }
    false
}

/// A pixel's counts this moment (`moving` 1: there is a last).
@compute(8, 8)
pub fn counted_steps(
    picture: Texture<Rgba16Float>,
    mean: Texture<Rgba16Float>,
    mask: Texture<Rgba16Float>,
    last_picture: Texture<Rgba16Float>,
    last_mean: Texture<Rgba16Float>,
    last_mask: Texture<Rgba16Float>,
    cover_a: Texture<Rgba16Float>,
    cover_b: Texture<Rgba16Float>,
    which: u32,
    moving: u32,
    out: mut Atomics<u32>,
    id: GlobalId,
) {
    if id.x >= picture.width() || id.y >= picture.height() {
        return
    }
    let now = near_strands(mask, mean, id.x, id.y)
    let was = moving != 0 && near_strands(last_mask, last_mean, id.x, id.y)
    if !now && !was {
        return
    }
    let p = picture.load(id.x, id.y)
    let m = mean.load(id.x, id.y)
    let c = if which == 0 { cover_a.load(id.x, id.y).w } else { cover_b.load(id.x, id.y).w }
    let edge = c > 0.02 && c < 0.98
    let dc = abs(saturate(p.xyz) - saturate(m.xyz)) * 255.0
    let most = u32(max(dc.x, max(dc.y, dc.z)) + 0.5)
    if now {
        let _ = out.add(i: 0, value: 1)
        let _ = out.add(i: 2, value: most)
        let _ = out.add(i: 9, value: u32(luma(p.xyz) * 255.0 + 0.5))
        let _ = out.add(i: 10, value: u32(luma(m.xyz) * 255.0 + 0.5))
        if edge {
            let _ = out.add(i: 1, value: 1)
            let _ = out.add(i: 3, value: most)
        }
    }
    if moving != 0 {
        let _ = out.add(i: 8, value: 1)
        let stepped = abs(luma(p.xyz) - luma(last_picture.load(id.x, id.y).xyz)) * 255.0 > 15.0
        let ref_stepped = abs(luma(m.xyz) - luma(last_mean.load(id.x, id.y).xyz)) * 255.0 > 15.0
        if stepped {
            let _ = out.add(i: 4, value: 1)
        }
        if ref_stepped {
            let _ = out.add(i: 5, value: 1)
        }
        if edge {
            let _ = out.add(i: 11, value: 1)
        }
        if edge && stepped {
            let _ = out.add(i: 6, value: 1)
        }
        if edge && ref_stepped {
            let _ = out.add(i: 7, value: 1)
        }
    }
}

/// The coverage of anything by the reference's looks: `w` the share of looks that met
/// something.
@fragment
pub fn covering(
    pixel: FragCoord,
    depth: DepthTexture,
    sofar: Texture<Rgba16Float>,
    first: u32,
    share: f32,
) -> vec4 {
    let x = u32(pixel.position.x)
    let y = u32(pixel.position.y)
    let met = if depth.load(x, y) > 0.0 { share } else { 0.0 }
    if first != 0 { vec4(0.0, 0.0, 0.0, met) } else { sofar.load(x, y) + vec4(0.0, 0.0, 0.0, met) }
}

/// The strands' judge: looks a moment, moments, and its textures (each kept for this moment and
/// the last, by turns).
pub struct Judged {
    pub samples: u32,
    pub moments: u32,
    pic_a: Texture<Rgba16Float>,
    pic_b: Texture<Rgba16Float>,
    mask_a: Texture<Rgba16Float>,
    mask_b: Texture<Rgba16Float>,
    mean_a: Texture<Rgba16Float>,
    mean_b: Texture<Rgba16Float>,
    sum_a: Texture<Rgba32Float>,
    sum_b: Texture<Rgba32Float>,
    cover_a: Texture<Rgba16Float>,
    cover_b: Texture<Rgba16Float>,
    scores: GpuBuffer<u32>,
    heard: Option<Pending<u32>>,
    frames: u32,
}

pub fn judged(samples: u32, moments: u32) -> Judged {
    Judged {
        samples,
        moments,
        pic_a: texture(width: 1, height: 1),
        pic_b: texture(width: 1, height: 1),
        mask_a: texture(width: 1, height: 1),
        mask_b: texture(width: 1, height: 1),
        mean_a: texture(width: 1, height: 1),
        mean_b: texture(width: 1, height: 1),
        sum_a: texture(width: 1, height: 1),
        sum_b: texture(width: 1, height: 1),
        cover_a: texture(width: 1, height: 1),
        cover_b: texture(width: 1, height: 1),
        scores: buffer_of(Vec::filled(COUNTS, 0)),
        heard: None,
        frames: 0,
    }
}

impl Judged {
    pub fn moment(self) -> u32 {
        self.frames / self.samples
    }

    pub fn done(self) -> bool {
        self.moment() >= self.moments
    }

    /// The reference's eye this frame: `eye`, its rays moved within their pixels.
    pub fn looking(self, eye: Eye) -> Eye {
        var out = eye
        let k = self.frames % self.samples
        if k > 0 {
            out.jitter = vec2(halton(k, 2), halton(k, 3)) - vec2(0.5)
        }
        out
    }

    /// Its textures the size of `eye`'s screen.
    pub fn sized(mut self, eye: Eye) {
        let w = u32(eye.size.x)
        let h = u32(eye.size.y)
        if self.pic_a.width() == w && self.pic_a.height() == h {
            return
        }
        self.pic_a = texture(width: w, height: h)
        self.pic_b = texture(width: w, height: h)
        self.mask_a = texture(width: w, height: h)
        self.mask_b = texture(width: w, height: h)
        self.mean_a = texture(width: w, height: h)
        self.mean_b = texture(width: w, height: h)
        self.sum_a = texture(width: w, height: h)
        self.sum_b = texture(width: w, height: h)
        self.cover_a = texture(width: w, height: h)
        self.cover_b = texture(width: w, height: h)
    }

    /// `frame` ended into this moment's picture (on a moment's first look), and its strands'
    /// pixels marked.
    pub fn resolve<P: Paint>(mut self, frame: mut Frame, sky: P) {
        if self.frames % self.samples != 0 {
            return
        }
        if self.moment() % 2 == 0 {
            frame.end_into(sky, mut self.pic_a)
            label("judge")
            let p = begin_pass(mut self.mask_a, clear: vec4(0.0))
            draw(p, cover, strand_mask.bind(ids: frame.identity, depth: frame.depth), vertices: 3)
            p.end()
        } else {
            frame.end_into(sky, mut self.pic_b)
            label("judge")
            let p = begin_pass(mut self.mask_b, clear: vec4(0.0))
            draw(p, cover, strand_mask.bind(ids: frame.identity, depth: frame.depth), vertices: 3)
            p.end()
        }
    }

    /// After the reference's look (drawn into `targets`' look targets): added to the moment's
    /// sum; the mean and the counts once the moment's looks are in; the picture shown through
    /// `style`'s tone curve.
    pub fn after(mut self, targets: Judge, style: InkStyle) {
        let moment = self.moment()
        let look = self.frames % self.samples
        let even = moment % 2 == 0
        let w = self.pic_a.width()
        let h = self.pic_a.height()
        let first: u32 = if look == 0 { 1 } else { 0 }
        let part = 1.0 / f32(self.samples)
        label("judge")
        // (The sums by turns, each look's into the other.)
        let into_a = look % 2 == 0
        if into_a {
            let p = begin_pass(mut self.sum_a, clear: vec4(0.0))
            draw(
                p,
                cover,
                summed.bind(
                    colour: targets.look_colour,
                    normal: targets.look_normal,
                    depth: targets.look_depth,
                    sofar: self.sum_b,
                    first: first,
                    share: part,
                ),
                vertices: 3,
            )
            p.end()
            let q = begin_pass(mut self.cover_a, clear: vec4(0.0))
            draw(
                q,
                cover,
                covering.bind(
                    depth: targets.look_depth,
                    sofar: self.cover_b,
                    first: first,
                    share: part,
                ),
                vertices: 3,
            )
            q.end()
        } else {
            let p = begin_pass(mut self.sum_b, clear: vec4(0.0))
            draw(
                p,
                cover,
                summed.bind(
                    colour: targets.look_colour,
                    normal: targets.look_normal,
                    depth: targets.look_depth,
                    sofar: self.sum_a,
                    first: first,
                    share: part,
                ),
                vertices: 3,
            )
            p.end()
            let q = begin_pass(mut self.cover_b, clear: vec4(0.0))
            draw(
                q,
                cover,
                covering.bind(
                    depth: targets.look_depth,
                    sofar: self.cover_a,
                    first: first,
                    share: part,
                ),
                vertices: 3,
            )
            q.end()
        }
        if look == self.samples - 1 {
            {
                let p = if even { begin_pass(mut self.mean_a, clear: vec4(0.0)) } else {
                    begin_pass(mut self.mean_b, clear: vec4(0.0))
                }
                if into_a {
                    draw(p, cover, meant.bind(sum: self.sum_a), vertices: 3)
                } else {
                    draw(p, cover, meant.bind(sum: self.sum_b), vertices: 3)
                }
                p.end()
            }
            let moving: u32 = if moment > 0 { 1 } else { 0 }
            let which: u32 = if into_a { 0 } else { 1 }
            if even {
                dispatch(
                    counted_steps.bind(
                        picture: self.pic_a,
                        mean: self.mean_a,
                        mask: self.mask_a,
                        last_picture: self.pic_b,
                        last_mean: self.mean_b,
                        last_mask: self.mask_b,
                        cover_a: self.cover_a,
                        cover_b: self.cover_b,
                        which: which,
                        moving: moving,
                        out: mut self.scores,
                    ),
                    groups: ((w + 7) / 8, (h + 7) / 8, 1),
                )
            } else {
                dispatch(
                    counted_steps.bind(
                        picture: self.pic_b,
                        mean: self.mean_b,
                        mask: self.mask_b,
                        last_picture: self.pic_a,
                        last_mean: self.mean_a,
                        last_mask: self.mask_a,
                        cover_a: self.cover_a,
                        cover_b: self.cover_b,
                        which: which,
                        moving: moving,
                        out: mut self.scores,
                    ),
                    groups: ((w + 7) / 8, (h + 7) / 8, 1),
                )
            }
            if moment == self.moments - 1 {
                self.heard = Some(read(self.scores.items()))
            }
        }
        self.said()
        label("shown")
        let screen = begin_screen_pass(clear: vec4(0.0, 0.0, 0.0, 1.0))
        if even {
            draw(screen, cover, shown.bind(picture: self.pic_a, style: style), vertices: 3)
        } else {
            draw(screen, cover, shown.bind(picture: self.pic_b, style: style), vertices: 3)
        }
        screen.present()
        self.frames += 1
    }

    /// The counts said, once read back.
    pub fn said(mut self) {
        match mut self.heard {
            Some(p) => match p.poll() {
                Some(Ok(v)) => {
                    let n = max(f32(v[0]), 1.0)
                    let e = max(f32(v[1]), 1.0)
                    let s = max(f32(v[8]), 1.0)
                    let es = max(f32(v[11]), 1.0)
                    print(
                        f"strands judged: over {self.moments} moments of {self.samples} looks, {v[0]} pixels near strands ({v[1]} edge pixels): the picture differs from the reference's mean by {f32(v[2]) / n} of 255 a pixel, {f32(v[3]) / e} an edge pixel; mean brightness the picture {f32(v[9]) / n}, the reference {f32(v[10]) / n} of 255",
                    )
                    print(
                        f"strands judged: steps over 15 of 255 a moment, a thousand pixels near strands: the picture {1000.0 * f32(v[4]) / s}, the reference {1000.0 * f32(v[5]) / s}; a thousand edge pixels: the picture {1000.0 * f32(v[6]) / es}, the reference {1000.0 * f32(v[7]) / es} (of {v[8]} pixels, {v[11]} edge pixels)",
                    )
                    self.heard = None
                },
                _ => {},
            },
            None => {},
        }
    }
}
