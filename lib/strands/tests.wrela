// The strand lister's pure parts held to what they promise: the rule keeps the cover the copies
// give and lets each leave at its own distance without a jump; the blocks listed are those the
// eye can see within reach; the ribbons' corners; the segments' sag. Each check is also run on a
// broken rule or list (a mutant) and shown to catch it.

use blocks::{CELLS, SIDE, in_view, listed}
use form::kinds::Strand
use frame::eye::{Eye, eye_at}
use kept::{Rule, drawn, folded, length_kept, most_kept, rank_of, share, widened}
use place::sagging
use ribbon::{BATCH, ribbon_indices}
use std::io::print

const RULE = Rule { least: 1.5, fade: 0.3, fold_from: 20.0, fold_to: 40.0 }

/// A 1080p eye at 1.9 m, looking along +z.
fn eye() -> Eye {
    eye_at(vec3(0.0, 1.9, 0.0), vec3(0.0, 1.0, 10.0), 0.8, width: 1920, height: 1080)
}

/// The cover the copies of many cells give, `far` m off, each `width` m wide: the sum of each
/// kept one's width drawn times the length it keeps, over the cells, against their own widths.
fn cover_kept(rule: Rule, far: f32, width: f32, pixel: f32, keep: fn(f32, f32) -> f32) -> f32 {
    var kept = 0.0
    let n = 20000
    for k in 0..n {
        let r = rank_of(vec2i(i32(k % 300), i32(k / 300)))
        let w = widened(rule, far, width, pixel)
        kept += w * keep(r, share(rule, far, width, pixel))
    }
    kept / f32(n)
}

/// Widened and thinned, the copies cover what they did, within 3%, near and far; folded, what
/// the fold leaves. Broken (widened but not thinned), they cover far more.
@test
fn the_rule_keeps_the_cover() {
    let pixel = eye().pixel()
    let keep = |r: f32, sh: f32| length_kept(r, sh, RULE.fade)
    for far in [2.0, 8.0, 15.0, 19.0, 25.0, 30.0, 35.0, 39.0] {
        for width in [0.004, 0.0065, 0.008] {
            let c = cover_kept(RULE, far: far, width: width, pixel: pixel, keep: keep)
            let want = folded(RULE, far)
            assert(
                abs(c - want) < 0.03 + 0.03 * want,
                f"{far} m, {width} m wide: {c} against {want}",
            )
        }
    }
    let thick = |r: f32, sh: f32| if r < 1.0 { 1.0 } else { 0.0 }
    let broken = cover_kept(RULE, far: 15.0, width: 0.0065, pixel: pixel, keep: thick)
    print(f"widened and not thinned, at 15 m the copies cover {broken} of what they did")
    assert(broken > 1.5, f"{broken}")
}

/// A copy's length kept changes evenly with distance, never by a jump: walked out from the eye a
/// centimetre at a time, no copy's length steps by more than its fade's band allows. Broken (no
/// fade), copies leave whole.
@test
fn each_copy_leaves_at_its_own_distance() {
    let pixel = eye().pixel()
    var most = 0.0
    var broken = 0.0
    var left = 0
    for k in 0..500 {
        let r = rank_of(vec2i(i32(k), 7))
        var was = drawn(RULE, r, far: 0.5, width: 0.0065, pixel: pixel).length
        var hard_was = 1.0
        for step in 1..4500 {
            let far = 0.5 + f32(step) * 0.01
            let now = drawn(RULE, r, far: far, width: 0.0065, pixel: pixel).length
            most = max(most, abs(now - was))
            let hard = if r < share(RULE, far: far, width: 0.0065, pixel: pixel) { 1.0 } else {
                0.0
            }
            broken = max(broken, abs(hard - hard_was))
            if was > 0.0 && now == 0.0 {
                left += 1
            }
            was = now
            hard_was = hard
        }
        assert(was == 0.0, f"rank {r} still drawn past the fold")
    }
    print(
        f"500 copies walked out to 45 m: {left} left, the most a length stepped a centimetre {most}; with no fade, {broken}",
    )
    assert(most < 0.2 && broken == 1.0, f"{most}, {broken}")
}

/// No copy the rule draws is past `most_kept`: the cheap test before a copy is worked out never
/// drops one that would be drawn. Broken (the most as the share, no fade's band), it would.
@test
fn the_cheap_test_drops_none_drawn() {
    let pixel = eye().pixel()
    var dropped = 0
    var broken = 0
    for k in 0..20000 {
        let r = rank_of(vec2i(i32(k % 200), i32(k / 200) + 31))
        let far = 1.0 + f32(k % 431) * 0.1
        let width = 0.005 + 0.003 * f32(k % 17) / 16.0
        let d = drawn(RULE, r, far: far, width: width, pixel: pixel)
        if d.length > 0.0 && r >= most_kept(RULE, far: far, widest: 0.008, pixel: pixel) {
            dropped += 1
        }
        if d.length > 0.0 && r >= share(RULE, far: far, width: 0.008, pixel: pixel) {
            broken += 1
        }
    }
    print(f"copies drawn the cheap test would drop: {dropped}; with no fade's band, {broken}")
    assert(dropped == 0 && broken > 0, f"{dropped}, {broken}")
}

/// Ranks are spread evenly over [0, 1): each tenth holds a tenth of 40,000 cells, within 3%.
@test
fn ranks_are_even() {
    var bins = Vec::filled(10, value: 0)
    for k in 0..40000 {
        let r = rank_of(vec2i(i32(k % 200) - 100, i32(k / 200) - 100))
        assert(r >= 0.0 && r < 1.0, f"{r}")
        bins[u32(r * 10.0)] += 1
    }
    for b in bins {
        assert(abs(f32(b) - 4000.0) < 120.0, f"{b} in a tenth")
    }
}

/// A box is in view when any of it is: one ahead is, one behind or wholly off a side isn't.
@test
fn a_box_is_seen_when_any_of_it_is() {
    let e = eye()
    assert(in_view(e, vec3(-1.0, 0.0, 9.0), vec3(1.0, 1.0, 11.0)), "ahead")
    assert(!in_view(e, vec3(-1.0, 0.0, -11.0), vec3(1.0, 1.0, -9.0)), "behind")
    assert(!in_view(e, vec3(40.0, 0.0, 9.0), vec3(42.0, 1.0, 11.0)), "off to the side")
    assert(in_view(e, vec3(-60.0, 0.0, 9.0), vec3(60.0, 1.0, 11.0)), "across the view")
    assert(!in_view(e, vec3(-1.0, 30.0, 9.0), vec3(1.0, 31.0, 11.0)), "above")
}

/// The blocks listed hold every cell the eye can see within reach: of points over the ground in
/// view within reach, none falls outside the blocks listed. Broken (half the reach), many do.
@test
fn the_blocks_hold_what_the_eye_sees() {
    let e = eye()
    let ground = |p: vec2| 0.3 * sin(p.x * 0.1) + 0.2 * cos(p.y * 0.07)
    let cell = 0.05
    let side = cell * f32(SIDE)
    let bs = listed(e, cell, reach: 30.0, longest: 1.0, ground: ground)
    let half = listed(e, cell, reach: 15.0, longest: 1.0, ground: ground)
    var missed = 0
    var broken = 0
    var seen = 0
    for k in 0..20000 {
        let p = vec2(f32(k % 200) * 0.3 - 30.0, f32(k / 200) * 0.3 - 0.5)
        let w = vec3(p.x, ground(p) + 0.5, p.y)
        let v = w - e.at
        let z = dot(v, e.forward)
        let inside = z > e.near &&
            abs(dot(v, e.right)) < z * e.aspect / e.focal &&
            abs(dot(v, e.up)) < z / e.focal &&
            length(v) < 30.0
        if !inside {
            continue
        }
        seen += 1
        let c = vec2i(i32(floor(p.x / side)) * i32(SIDE), i32(floor(p.y / side)) * i32(SIDE))
        var found = false
        for b in bs {
            if b.cell == c {
                found = true
            }
        }
        var found_half = false
        for b in half {
            if b.cell == c {
                found_half = true
            }
        }
        if !found {
            missed += 1
        }
        if !found_half {
            broken += 1
        }
    }
    print(
        f"{bs.len()} blocks of {CELLS} cells listed; of {seen} places seen, {missed} outside them; at half the reach, {broken}",
    )
    assert(missed == 0 && broken > 0, f"{missed}, {broken}")
}

/// A ribbon's triangles: each of `BATCH` ribbons' 2 a segment, every corner one of its own
/// vertices, every vertex used.
@test
fn ribbons_are_their_own_triangles() {
    for segments in [2, 4, 8] {
        let ix = ribbon_indices(segments)
        let each = 2 * (segments + 1)
        assert(ix.len() == BATCH * segments * 6, f"{ix.len()}")
        var used = Vec::filled(BATCH * each, value: false)
        for t in 0..ix.len() / 3 {
            let r = ix[t * 3] / each
            for c in 0..3 {
                assert(ix[t * 3 + c] / each == r, "a triangle across two ribbons")
                used[ix[t * 3 + c]] = true
            }
        }
        for u in used {
            assert(u, "a vertex no triangle uses")
        }
    }
}

/// An arch: a quarter circle of radius 1 m.
struct Arch: Copy + GpuData {
    spare: f32,
}

impl Strand for Arch {
    fn at(self, t: f32) -> vec4 {
        let a = t * 1.5707963
        vec4(1.0 - cos(a), sin(a), 0.0, 0.001)
    }
}

/// The chords' sag of a quarter circle is the circle's own (1 - cos(half the angle a chord
/// spans)), within 1%, and falls as the square of the segments.
@test
fn the_sag_is_the_chords() {
    for n in [2, 4, 8] {
        let want = 1.0 - cos(1.5707963 / f32(n) / 2.0)
        let got = sagging(Arch { spare: 0.0 }, 1.0, n)
        assert(abs(got - want) < 0.01 * want, f"{n}: {got} against {want}")
    }
    let a = sagging(Arch { spare: 0.0 }, 1.0, 2)
    let b = sagging(Arch { spare: 0.0 }, 1.0, 4)
    print(f"a quarter circle's sag: 2 segments {a} m, 4 segments {b} m ({a / b} times)")
    assert(abs(a / b - 4.0) < 0.2, f"{a / b}")
}
