// Which copies of a strand are drawn, and how: the rule, a pure function of a copy's distance
// from the eye, its width at its root, and its own rank (a number in [0, 1) from its cell's
// hash, the order copies leave in).
//
// Near, every copy is drawn as it is. Where a copy's root would be narrower than `least` pixels,
// it is drawn `least` pixels wide and only one copy in as many as it was widened by is kept, so
// the share of the ground the copies cover is the same (after Cook, Halstead, Planck and Ryu,
// "Stochastic simplification of aggregate detail", 2007: a random order of the copies, a prefix
// kept, each kept one grown to hold the whole's area). Far off, over `fold_from` to `fold_to`,
// the share kept falls to none: the host's look holds the copies' colour there. A copy leaves
// when the share falls past its rank, and shrinks to nothing along its length as it does, over
// `fade` of the share either side of its rank: so each leaves at its own distance and none
// pops, and the length the kept copies keep is the share's on average.

/// The rule: the least width a copy is drawn (px), the band of the share a leaving copy shrinks
/// over (a share of the share), and the distances (m) over which the copies fold into their
/// host's look.
pub struct Rule: Copy + GpuData {
    pub least: f32,
    pub fade: f32,
    pub fold_from: f32,
    pub fold_to: f32,
}

/// What a copy's drawn as: how much wider than it is, and how much of its length it keeps (0:
/// it isn't drawn).
pub struct Drawn: Copy + GpuData {
    pub widen: f32,
    pub length: f32,
}

/// How much wider than it is a copy `width` m wide at its root is drawn `far` m from an eye
/// whose pixels are `pixel` m wide a metre off: so it is at least `rule.least` pixels.
pub fn widened(rule: Rule, far: f32, width: f32, pixel: f32) -> f32 {
    max(1.0, rule.least * pixel * far / max(width, 1.0e-6))
}

/// How much of the copies are kept `far` m off before they are widened: all of them within
/// `fold_from`, falling smoothly to none at `fold_to`.
pub fn folded(rule: Rule, far: f32) -> f32 {
    1.0 - smoothstep(rule.fold_from, rule.fold_to, far)
}

/// The share of copies `width` m wide kept `far` m off.
pub fn share(rule: Rule, far: f32, width: f32, pixel: f32) -> f32 {
    folded(rule, far) / widened(rule, far, width, pixel)
}

/// How much of its length a copy of rank `rank` keeps where `share` of the copies are kept: all
/// of it below `share` less half the fade's band, none above `share` plus half, evenly between.
pub fn length_kept(rank: f32, share: f32, fade: f32) -> f32 {
    let band = max(fade * share, 1.0e-9)
    saturate((share * (1.0 + 0.5 * fade) - rank) / band)
}

/// How a copy of rank `rank`, `width` m wide at its root and `far` m off, is drawn.
pub fn drawn(rule: Rule, rank: f32, far: f32, width: f32, pixel: f32) -> Drawn {
    let w = widened(rule, far, width, pixel)
    Drawn { widen: w, length: length_kept(rank, folded(rule, far) / w, rule.fade) }
}

/// The most of the copies that can be kept `far` m off, when none is wider than `widest` at its
/// root, counting the fade's band: a copy whose rank is past this isn't drawn, whatever it is.
pub fn most_kept(rule: Rule, far: f32, widest: f32, pixel: f32) -> f32 {
    share(rule, far, widest, pixel) * (1.0 + 0.5 * rule.fade)
}

/// A copy's rank: a number in [0, 1) from its cell, the lister's own (not the scatter's).
pub fn rank_of(cell: vec2i) -> f32 {
    let h = std::field::hash_u32(
        u32(cell.x).wrapping_mul(2654435761) ^ u32(cell.y).wrapping_mul(2246822519) ^ 0x5bd1e995,
    )
    f32(h >> 8) * (1.0 / 16777216.0)
}
