// The cells of ground listed round the eye, by distance and by what it can see: blocks of
// `SIDE` × `SIDE` cells, each kept if its box (its ground, up to the longest copy over it) is
// within reach and in the eye's view. Worked out on the CPU each frame, a block at a time;
// nothing is done per copy on the CPU.

use frame::eye::Eye

/// How many cells along a block's side.
pub const SIDE: u32 = 32

/// How many cells a block holds.
pub const CELLS: u32 = SIDE * SIDE

/// A block as the GPU reads it: its first cell, and its ground's height at its middle (m).
pub struct Block: Copy + GpuData {
    pub cell: vec2i,
    pub ground: f32,
    pub spare: f32,
}

/// Whether the box from `lo` to `hi` is in `eye`'s view: not wholly behind its near plane, nor
/// wholly past any side of its screen.
pub fn in_view(eye: Eye, lo: vec3, hi: vec3) -> bool {
    let tan_up = 1.0 / eye.focal
    let tan_across = eye.aspect / eye.focal
    // Each plane's count of corners outside it.
    var behind = 0
    var left = 0
    var right = 0
    var below = 0
    var above = 0
    for k in 0..8 {
        let c = vec3(
            if (k & 1) == 0 { lo.x } else { hi.x },
            if (k & 2) == 0 { lo.y } else { hi.y },
            if (k & 4) == 0 { lo.z } else { hi.z },
        )
        let v = c - eye.at
        let z = dot(v, eye.forward)
        let x = dot(v, eye.right)
        let y = dot(v, eye.up)
        if z < eye.near {
            behind += 1
        }
        if x < -z * tan_across {
            left += 1
        }
        if x > z * tan_across {
            right += 1
        }
        if y < -z * tan_up {
            below += 1
        }
        if y > z * tan_up {
            above += 1
        }
    }
    behind < 8 && left < 8 && right < 8 && below < 8 && above < 8
}

/// The nearest a box from `lo` to `hi` comes to `p` (m).
pub fn nearest(p: vec3, lo: vec3, hi: vec3) -> f32 {
    length(p - clamp(p, lo, hi))
}

/// How far a block's ground may stand off its height at its middle (m): the land's steepest
/// (0.5) over half a block's diagonal at 5 cm cells, and its bumps.
pub const GROUND_SPREAD: f32 = 0.7

/// The blocks of cells `cell` m wide within `reach` m of `eye` and in its view, whose ground's
/// height at a place `ground` gives, their copies standing at most `longest` m off it. A block
/// out of view by a box from its ground's lowest to its highest is never asked its ground.
pub fn listed(
    eye: Eye,
    cell: f32,
    reach: f32,
    longest: f32,
    ground: fn(vec2) -> f32,
) -> Vec<Block> {
    var out: Vec<Block> = Vec::new()
    let side = cell * f32(SIDE)
    let lo = vec2i(i32(floor((eye.at.x - reach) / side)), i32(floor((eye.at.z - reach) / side)))
    let hi = vec2i(i32(floor((eye.at.x + reach) / side)), i32(floor((eye.at.z + reach) / side)))
    for bz in lo.y..hi.y + 1 {
        for bx in lo.x..hi.x + 1 {
            let x0 = f32(bx) * side
            let z0 = f32(bz) * side
            let flat_lo = vec2(x0, z0)
            let flat_hi = vec2(x0 + side, z0 + side)
            // Within reach along the ground first: no height asked.
            let e = vec2(eye.at.x, eye.at.z)
            if length(e - clamp(e, flat_lo, flat_hi)) > reach {
                continue
            }
            let h = ground(vec2(x0 + 0.5 * side, z0 + 0.5 * side))
            let box_lo = vec3(x0, h - GROUND_SPREAD - longest, z0)
            let box_hi = vec3(x0 + side, h + GROUND_SPREAD + longest, z0 + side)
            if nearest(eye.at, box_lo, box_hi) > reach || !in_view(eye, box_lo, box_hi) {
                continue
            }
            out.push(Block { cell: vec2i(bx * i32(SIDE), bz * i32(SIDE)), ground: h, spare: 0.0 })
        }
    }
    out
}
