// What a scene hands the strand lister: where copies of a strand go (a scatter), and what they
// wear (a look of the strand's own).

use form::kinds::Strand
use form::look::{Place, Skin}

/// Where copies of a strand `S` stand on a ground: one copy or none in each cell of a grid of
/// `cell()` m over the ground's places (x, z), each copy a function of its cell. A meadow's
/// blades, reeds on a bank.
pub trait Scatter<S: Strand>: Copy + GpuData {
    /// How wide a cell is (m).
    fn cell(self) -> f32

    /// The copy in cell `cell` (its corner at `cell` times `cell()`), if one stands there.
    fn copy(self, cell: vec2i) -> Option<S>

    /// The normal of the ground copy `s` stands on (unit), which its light leans to.
    fn host(self, s: S) -> vec3

    /// How much of the most copies stand at `p` (x, z; 0 to 1): what the host's look takes the
    /// copies' colour by far off.
    fn cover(self, p: vec2) -> f32

    /// The ground's height at `p` (x, z; m): where the cells' copies stand, within a metre.
    fn ground(self, p: vec2) -> f32

    /// The widest a copy is at its root (m), and the farthest any of it is from its root (m).
    fn widest(self) -> f32
    fn longest(self) -> f32
}

/// What a strand `S` wears `t` along it (0 at its root, 1 at its tip), at `at`. As lib/form's
/// `Look`, but the strand's own numbers (its tint, how tall it is) are its look's too.
pub trait Wears<S: Strand>: Copy + GpuData {
    fn skin(self, s: S, t: f32, at: Place) -> Skin

    /// The copies' mean colour far off (what the host's look takes where they stand thick): a
    /// copy widened to stand for several thinner than a pixel is drawn toward it, as Cook et
    /// al. draw a simplified aggregate's kept elements toward their mean (`ribbon::corner_of`).
    /// Asked once a copy a frame, when it's placed.
    fn mean(self, s: S) -> vec3
}
