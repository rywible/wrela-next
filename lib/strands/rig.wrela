// The lister of strands on a rig, as a scene uses it: a few copies placed by a body each frame
// (locks of hair on a head's bone), their look handed over once; each frame the copies as the
// body's palette places them written from the CPU (a few, not a scatter), and drawn into the
// frame's picture as the scattered strands are: ribbons at least `least` pixels wide, on the
// finest segments, their light leant to their host's normal.
//
//     var hair = strands::rig::rig(HairLook { .. }, body: 3, room: 16)    // once
//     hair.place(locks, hosts)                                          // each frame
//     hair.ready(eye)                                                   // each frame
//     frame.draw(|d| { ...; hair.draw_into(d) })                        // each frame

use form::kinds::Strand
use frame::eye::{Eye, NEARER}
use frame::light::{AllLit, Lit, OneLit, Unlit, lit_by}
use frame::picture::{Drawing, STRAND, identity}
use kept::{Rule, widened}
use place::LEVELS
use ribbon::{BATCH, Laid, corner, ribbon_indices, shade}
use scatter::Wears
use std::gpu::{Cull, GpuBuffer, buffer, buffer_of, draw, write}

/// How far round a copy's root its ribbon may reach (m), for which live lights reach it.
const REACHED: f32 = 1.0

/// The lister: the look, the copies' body (their identity's), how far their light leans to
/// their host's normal, the least width they're drawn (px), the copies (their room, and how many
/// this frame), and their ribbons' corners.
pub struct Rig<S, L> {
    pub look: L,
    pub body: u32,
    /// The identity its pixels write: `STRAND`, its body, group 0; or its host's, where it's
    /// folded into its host for the ink (no line between it and its host: a meadow's blades).
    pub identity: u32,
    pub lean: f32,
    /// The least width (px) a ribbon writes the way to its nearer side at (its edge record), and
    /// how strong a line the ink draws there (0 to 1: 0, the record only antialiases).
    pub edged: f32,
    pub ink: f32,
    pub least: f32,
    laid: GpuBuffer<Laid<S>>,
    count: GpuBuffer<u32>,
    held: Vec<Laid<S>>,
    indices: GpuBuffer<u32>,
}

/// Copies wearing `look`, as body `body` of the strands, room for `room` of them.
pub fn rig<S: Strand, L: Wears<S>>(look: L, body: u32, room: u32) -> Rig<S, L> {
    Rig {
        look,
        body,
        identity: identity(STRAND, body, 0),
        lean: 0.5,
        edged: 0.0,
        ink: 1.0,
        least: 1.5,
        laid: buffer(room),
        count: buffer_of([0]),
        held: Vec::new(),
        indices: buffer_of(ribbon_indices(LEVELS[2])),
    }
}

impl<S: Strand, L: Wears<S>> Rig<S, L> {
    /// This frame's copies, `strands`, each standing on a host whose normal is `hosts`' of the
    /// same place.
    pub fn place(mut self, strands: [S], hosts: [vec3]) {
        self.held.clear()
        for k in 0..min(strands.len(), self.laid.len()) {
            self.held.push(
                Laid {
                    strand: strands[k],
                    host: hosts[k],
                    widen: 1.0,
                    mean: self.look.mean(strands[k]),
                    length: 1.0,
                    id: k,
                },
            )
        }
    }

    /// The copies made ready for `eye` (before any pass they're drawn in): each widened to
    /// `least` px where it's thinner (none is thinned out: they're few), and written.
    pub fn ready(mut self, eye: Eye) {
        let rule = Rule { least: self.least, fade: 0.0, fold_from: 1.0e9, fold_to: 2.0e9 }
        for k in 0..self.held.len() {
            let root = self.held[k].strand.at(0.0)
            self.held[k].widen = widened(
                rule,
                far: length(root.xyz - eye.at),
                width: 2.0 * root.w,
                pixel: eye.pixel(),
            )
        }
        write(mut self.laid, 0, self.held)
        write(mut self.count, 0, [self.held.len()])
    }

    /// The copies made ready (`ready`) drawn into the picture's pass (`Frame::draw`), by their
    /// pixels' pipeline for as many live lights as reach the box round their roots (`REACHED` m
    /// out: a lock is shorter).
    pub fn draw_into(self, d: Drawing) {
        if self.held.len() == 0 {
            return
        }
        var lo = vec3(1.0e30)
        var hi = vec3(-1.0e30)
        for h in self.held {
            let root = h.strand.at(0.0).xyz
            lo = min(lo, root - vec3(REACHED))
            hi = max(hi, root + vec3(REACHED))
        }
        let lit = lit_by(d.light.lights, lo, hi)
        if lit == 0 {
            self.drawn_with(d, Unlit {})
        } else if lit == 1 {
            self.drawn_with(d, OneLit {})
        } else {
            self.drawn_with(d, AllLit {})
        }
    }

    /// The copies drawn by their pixels' pipeline for `K`'s live lights.
    fn drawn_with<K: Lit>(self, d: Drawing, _lit: K) {
        draw(
            d.pass,
            corner.bind(
                d.eye,
                laid: self.laid.items(),
                count: self.count.items(),
                look: self.look,
                segments: LEVELS[2],
                own: 0,
                thinnest: self.least,
                lean: self.lean,
                contrast: 0.0,
            ),
            shade.bind(
                d.eye,
                light: d.light,
                id: self.identity,
                edged: self.edged,
                ink: self.ink,
                cover: 0,
                lights: K::LIVE,
            ),
            indices: self.indices,
            instances: (self.held.len() + BATCH - 1) / BATCH,
            cull: Cull::None,
            depth: NEARER,
        )
    }
}
