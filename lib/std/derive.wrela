// Gradients and interval bounds of functions, which the compiler derives from each function's
// body (language.md §14), and the ranges and boxes they work over. Any function that qualifies
// has them; nothing here is specific to fields.

use std::io::print
use std::stage::{Tape, Taped}

/// A closed range `[lo, hi]` of `f32` values.
pub struct Interval: Copy + GpuData {
    pub lo: f32,
    pub hi: f32,
}

impl Interval {
    /// Whether `x` is in the range, ends included.
    pub fn contains(self, x: f32) -> bool {
        self.lo <= x && x <= self.hi
    }

    /// `hi - lo`.
    pub fn width(self) -> f32 {
        self.hi - self.lo
    }

    /// Point `i` of a sequence that spreads evenly through the range: `seed` chooses the
    /// sequence. For checking a property at many points: `for i in 0..n { let x =
    /// range.sample(seed, i) ... }`. The same `seed` and `i` give the same point everywhere.
    /// The first 2ⁿ points split evenly when the range is halved, and halved again, up to n
    /// times (`sobol`).
    pub fn sample(self, seed: u32, i: u32) -> f32 {
        sample_component(self.lo, self.hi, sobol(seed, 0, i))
    }
}

/// An axis-aligned box in 2D.
pub struct Box2: Copy + GpuData {
    pub lo: vec2,
    pub hi: vec2,
}

/// An axis-aligned box in 3D.
pub struct Box3: Copy + GpuData {
    pub lo: vec3,
    pub hi: vec3,
}

impl Box2 {
    /// Its centre.
    pub fn center(self) -> vec2 {
        0.5 * (self.lo + self.hi)
    }

    /// Half its size along each axis.
    pub fn half(self) -> vec2 {
        0.5 * (self.hi - self.lo)
    }

    /// Whether `p` is in it, its edges included.
    pub fn contains(self, p: vec2) -> bool {
        self.lo.x <= p.x && p.x <= self.hi.x && self.lo.y <= p.y && p.y <= self.hi.y
    }

    /// Its four quarters, halved along each axis at its centre: lower x and y first, then x
    /// before y. Each quarter's corners are the box's own or its centre, so together they cover
    /// the box exactly, even one only an `f32` step wide.
    pub fn split(self) -> [Box2; 4] {
        let m = self.center()
        var out = [self; 4]
        for j in 0..4 {
            let (lx, hx) = if j & 1 == 0 { (self.lo.x, m.x) } else { (m.x, self.hi.x) }
            let (ly, hy) = if j & 2 == 0 { (self.lo.y, m.y) } else { (m.y, self.hi.y) }
            out[j] = Box2 { lo: vec2(lx, ly), hi: vec2(hx, hy) }
        }
        out
    }

    /// Point `i` of a sequence that spreads evenly through the box: `seed` chooses the sequence
    /// (`Interval::sample`).
    pub fn sample(self, seed: u32, i: u32) -> vec2 {
        let t = vec2(sobol(seed, 0, i), sobol(seed, 1, i))
        vec2(
            sample_component(self.lo.x, self.hi.x, t.x),
            sample_component(self.lo.y, self.hi.y, t.y),
        )
    }
}

impl Box3 {
    /// Its centre.
    pub fn center(self) -> vec3 {
        0.5 * (self.lo + self.hi)
    }

    /// Half its size along each axis.
    pub fn half(self) -> vec3 {
        0.5 * (self.hi - self.lo)
    }

    /// Whether `p` is in it, its faces included.
    pub fn contains(self, p: vec3) -> bool {
        self.lo.x <= p.x &&
            p.x <= self.hi.x &&
            self.lo.y <= p.y &&
            p.y <= self.hi.y &&
            self.lo.z <= p.z &&
            p.z <= self.hi.z
    }

    /// Its eight octants, halved along each axis at its centre: octant `j` is above the centre
    /// along x where bit 0 of `j` is set, along y where bit 1 is, and along z where bit 2 is.
    /// Each octant's corners are the box's own or its centre, so together they cover the box
    /// exactly, even one only an `f32` step wide.
    pub fn split(self) -> [Box3; 8] {
        let m = self.center()
        var out = [self; 8]
        for j in 0..8 {
            let (lx, hx) = if j & 1 == 0 { (self.lo.x, m.x) } else { (m.x, self.hi.x) }
            let (ly, hy) = if j & 2 == 0 { (self.lo.y, m.y) } else { (m.y, self.hi.y) }
            let (lz, hz) = if j & 4 == 0 { (self.lo.z, m.z) } else { (m.z, self.hi.z) }
            out[j] = Box3 { lo: vec3(lx, ly, lz), hi: vec3(hx, hy, hz) }
        }
        out
    }

    /// Point `i` of a sequence that spreads evenly through the box: `seed` chooses the sequence
    /// (`Interval::sample`). For checking a field at many points:
    ///
    /// ```wrela
    /// use std::derive::{Box3, gradient}
    /// use std::field::{Surface, sphere}
    ///
    /// fn gradients_are_unit() -> bool {
    ///     let ball = sphere(1.0)
    ///     let b = Box3 { lo: vec3(-2.0), hi: vec3(2.0) }
    ///     for i in 0..64 {
    ///         let p = b.sample(7, i)
    ///         if abs(length(gradient(|q: vec3| ball.distance(q), p)) - 1.0) > 1.0e-4 {
    ///             return false
    ///         }
    ///     }
    ///     true
    /// }
    /// ```
    pub fn sample(self, seed: u32, i: u32) -> vec3 {
        let t = vec3(sobol(seed, 0, i), sobol(seed, 1, i), sobol(seed, 2, i))
        vec3(
            sample_component(self.lo.x, self.hi.x, t.x),
            sample_component(self.lo.y, self.hi.y, t.y),
            sample_component(self.lo.z, self.hi.z, t.z),
        )
    }
}

/// Interpolates a sample without overflowing when finite endpoints span more than f32 holds.
fn sample_component(lo: f32, hi: f32, t: f32) -> f32 {
    let width = hi - lo
    if width == 1.0 / 0.0 {
        lo * (1.0 - t) + hi * t
    } else {
        lo + width * t
    }
}

/// Point `i` of Sobol's sequence on `axis` (0, 1 or 2), in [0, 1), with the axis shifted by
/// XOR with a hash of `seed` (a digital shift, which keeps how evenly the points spread). The
/// first 2ⁿ points split evenly among the cells of a box cut in halves along each axis, as
/// many times as the sequence allows: 4096 points put 8 in each of 8 × 8 × 8 cells. The same
/// bits on the CPU and the GPU.
fn sobol(seed: u32, axis: u32, i: u32) -> f32 {
    var x: u32 = 0
    // Direction number b is m(b) << (31 - b), m from the axis's primitive polynomial: none
    // (axis 0), x + 1 and x² + x + 1, with m(0) = 1 and m(1) = 3.
    var m1: u32 = 1
    var m2: u32 = 0
    for b in 0..32 {
        if i >> b == 0 {
            break
        }
        var m: u32 = 1
        if axis == 1 && b > 0 {
            m = (m1 << 1) ^ m1
        } else if axis == 2 && b == 1 {
            m = 3
        } else if axis == 2 && b > 1 {
            m = (m1 << 1) ^ (m2 << 2) ^ m2
        }
        m2 = m1
        m1 = m
        if (i >> b) & 1 == 1 {
            x = x ^ (if axis == 0 { 1 } else { m }) << (31 - b)
        }
    }
    f32((x ^ scramble(seed.wrapping_mul(4).wrapping_add(axis))) >> 8) * (1.0 / 16777216.0)
}

/// A 32-bit integer hash (`lowbias32`).
fn scramble(x: u32) -> u32 {
    var h = x ^ (x >> 16)
    h = h.wrapping_mul(2146121005)
    h = h ^ (h >> 15)
    h = h.wrapping_mul(2221713035)
    h ^ (h >> 16)
}

/// An axis-aligned box in 4D.
pub struct Box4: Copy + GpuData {
    pub lo: vec4,
    pub hi: vec4,
}

/// The largest magnitude an affine form may have and still represent a finite bound (`CAP` in
/// `ir::derive::affine`); past this, `valid()` is false and `lo()`/`hi()` are unbounded.
const AFFINE_CAP: f32 = 1.0e15
/// One f32 ulp at 1 (`2^-23`).
const AFFINE_EPS: f32 = 1.0 / 8388608.0
/// Smallest positive normal f32 (`> 2^-126`), covering GPU flush-to-zero subnormals.
const AFFINE_TINY: f32 = 1.2e-38

/// A 1D affine form `c + l * u ± e` over `u ∈ [-1, 1]`, produced by `affine_form` over an
/// `Interval`: for every `x` in the input interval, `f(x)` lies in `c + l * u ± e` for
/// `x = c_in + h_in * u + δ` (`|δ| ≤ 2·2⁻²³·|c_in| + 2·tiny`, `h_in = 0.5·(hi - lo)·(1 + 2·2⁻²³)`).
pub struct Affine1: Copy + GpuData {
    pub c: f32,
    pub l: f32,
    pub e: f32,
}

impl Affine1 {
    /// Whether this form holds a finite bound (`false` for NaN, infinite, or overflowed forms).
    pub fn valid(self) -> bool {
        let mag = abs(self.c) + abs(self.l) + self.e
        mag <= AFFINE_CAP && self.e >= 0.0
    }

    /// Sound lower bound over `u ∈ [-1, 1]`, rounded outward; `-∞` when not `valid()`.
    pub fn lo(self) -> f32 {
        let rad = abs(self.l) + self.e
        let mag = abs(self.c) + rad
        if !(mag <= AFFINE_CAP && self.e >= 0.0) {
            return -1.0 / 0.0
        }
        let margin = mag * (6.0 * AFFINE_EPS) + AFFINE_TINY
        self.c - (rad + margin)
    }

    /// Sound upper bound over `u ∈ [-1, 1]`, rounded outward; `+∞` when not `valid()`.
    pub fn hi(self) -> f32 {
        let rad = abs(self.l) + self.e
        let mag = abs(self.c) + rad
        if !(mag <= AFFINE_CAP && self.e >= 0.0) {
            return 1.0 / 0.0
        }
        let margin = mag * (6.0 * AFFINE_EPS) + AFFINE_TINY
        self.c + (rad + margin)
    }

    /// Sound `[lo, hi]` interval over `u ∈ [-1, 1]`.
    pub fn range(self) -> Interval {
        Interval { lo: self.lo(), hi: self.hi() }
    }

    /// Sound `[lo, hi]` interval over the sub-range `u ∈ [u_lo, u_hi] ⊆ [-1, 1]`.
    pub fn sub_range(self, u_lo: f32, u_hi: f32) -> Interval {
        if !self.valid() {
            return Interval { lo: -1.0 / 0.0, hi: 1.0 / 0.0 }
        }
        let a = self.l * u_lo
        let b = self.l * u_hi
        let lo0 = min(a, b)
        let hi0 = max(a, b)
        let mag = abs(self.c) + max(abs(a), abs(b)) + self.e
        let margin = mag * (8.0 * AFFINE_EPS) + 3.0 * AFFINE_TINY
        Interval { lo: (self.c + lo0) - (self.e + margin), hi: (self.c + hi0) + (self.e + margin) }
    }
}

/// A 2D affine form `c + dot(l, u) ± e` over `u ∈ [-1, 1]²`, produced by `affine_form` over a `Box2`.
pub struct Affine2: Copy + GpuData {
    pub c: f32,
    pub l: vec2,
    pub e: f32,
}

impl Affine2 {
    /// Whether this form holds a finite bound (`false` for NaN, infinite, or overflowed forms).
    pub fn valid(self) -> bool {
        let mag = abs(self.c) + abs(self.l.x) + abs(self.l.y) + self.e
        mag <= AFFINE_CAP && self.e >= 0.0
    }

    /// Sound lower bound over `u ∈ [-1, 1]²`, rounded outward; `-∞` when not `valid()`.
    pub fn lo(self) -> f32 {
        let rad = abs(self.l.x) + abs(self.l.y) + self.e
        let mag = abs(self.c) + rad
        if !(mag <= AFFINE_CAP && self.e >= 0.0) {
            return -1.0 / 0.0
        }
        let margin = mag * (8.0 * AFFINE_EPS) + AFFINE_TINY
        self.c - (rad + margin)
    }

    /// Sound upper bound over `u ∈ [-1, 1]²`, rounded outward; `+∞` when not `valid()`.
    pub fn hi(self) -> f32 {
        let rad = abs(self.l.x) + abs(self.l.y) + self.e
        let mag = abs(self.c) + rad
        if !(mag <= AFFINE_CAP && self.e >= 0.0) {
            return 1.0 / 0.0
        }
        let margin = mag * (8.0 * AFFINE_EPS) + AFFINE_TINY
        self.c + (rad + margin)
    }

    /// Sound `[lo, hi]` interval over `u ∈ [-1, 1]²`.
    pub fn range(self) -> Interval {
        Interval { lo: self.lo(), hi: self.hi() }
    }

    /// Sound `[lo, hi]` interval over the sub-box `u ∈ [u_lo, u_hi] ⊆ [-1, 1]²`.
    pub fn sub_range(self, u_lo: vec2, u_hi: vec2) -> Interval {
        if !self.valid() {
            return Interval { lo: -1.0 / 0.0, hi: 1.0 / 0.0 }
        }
        let a = self.l * u_lo
        let b = self.l * u_hi
        let mn = min(a, b)
        let mx = max(a, b)
        let am = max(abs(a), abs(b))
        let mag = abs(self.c) + am.x + am.y + self.e
        let margin = mag * (10.0 * AFFINE_EPS) + 4.0 * AFFINE_TINY
        Interval {
            lo: (self.c + mn.x + mn.y) - (self.e + margin),
            hi: (self.c + mx.x + mx.y) + (self.e + margin),
        }
    }
}

/// A 3D affine form `c + dot(l, u) ± e` over `u ∈ [-1, 1]³`, produced by `affine_form` over a `Box3`.
pub struct Affine3: Copy + GpuData {
    pub c: f32,
    pub l: vec3,
    pub e: f32,
}

impl Affine3 {
    /// Whether this form holds a finite bound (`false` for NaN, infinite, or overflowed forms).
    pub fn valid(self) -> bool {
        let mag = abs(self.c) + abs(self.l.x) + abs(self.l.y) + abs(self.l.z) + self.e
        mag <= AFFINE_CAP && self.e >= 0.0
    }

    /// Sound lower bound over `u ∈ [-1, 1]³`, rounded outward; `-∞` when not `valid()`.
    pub fn lo(self) -> f32 {
        let rad = abs(self.l.x) + abs(self.l.y) + abs(self.l.z) + self.e
        let mag = abs(self.c) + rad
        if !(mag <= AFFINE_CAP && self.e >= 0.0) {
            return -1.0 / 0.0
        }
        let margin = mag * (10.0 * AFFINE_EPS) + AFFINE_TINY
        self.c - (rad + margin)
    }

    /// Sound upper bound over `u ∈ [-1, 1]³`, rounded outward; `+∞` when not `valid()`.
    pub fn hi(self) -> f32 {
        let rad = abs(self.l.x) + abs(self.l.y) + abs(self.l.z) + self.e
        let mag = abs(self.c) + rad
        if !(mag <= AFFINE_CAP && self.e >= 0.0) {
            return 1.0 / 0.0
        }
        let margin = mag * (10.0 * AFFINE_EPS) + AFFINE_TINY
        self.c + (rad + margin)
    }

    /// Sound `[lo, hi]` interval over `u ∈ [-1, 1]³`.
    pub fn range(self) -> Interval {
        Interval { lo: self.lo(), hi: self.hi() }
    }

    /// Sound `[lo, hi]` interval over the sub-box `u ∈ [u_lo, u_hi] ⊆ [-1, 1]³`.
    pub fn sub_range(self, u_lo: vec3, u_hi: vec3) -> Interval {
        if !self.valid() {
            return Interval { lo: -1.0 / 0.0, hi: 1.0 / 0.0 }
        }
        let a = self.l * u_lo
        let b = self.l * u_hi
        let mn = min(a, b)
        let mx = max(a, b)
        let am = max(abs(a), abs(b))
        let mag = abs(self.c) + am.x + am.y + am.z + self.e
        let margin = mag * (12.0 * AFFINE_EPS) + 5.0 * AFFINE_TINY
        Interval {
            lo: (self.c + mn.x + mn.y + mn.z) - (self.e + margin),
            hi: (self.c + mx.x + mx.y + mx.z) + (self.e + margin),
        }
    }

    /// Sound `[lo, hi]` interval over octant `k` (`0..8`, matching `Box3::split`: bit 0 = +x,
    /// bit 1 = +y, bit 2 = +z) without re-evaluating the field.
    pub fn octant_range(self, k: u32) -> Interval {
        if !self.valid() {
            return Interval { lo: -1.0 / 0.0, hi: 1.0 / 0.0 }
        }
        let s = vec3(
            if (k & 1) == 0 { -0.5 } else { 0.5 },
            if (k & 2) == 0 { -0.5 } else { 0.5 },
            if (k & 4) == 0 { -0.5 } else { 0.5 },
        )
        let c_oct = self.c + self.l.x * s.x + self.l.y * s.y + self.l.z * s.z
        let half_l = 0.5 * (abs(self.l.x) + abs(self.l.y) + abs(self.l.z))
        let rad = half_l + self.e
        let mag = abs(self.c) + abs(self.l.x) + abs(self.l.y) + abs(self.l.z) + self.e
        let margin = mag * (12.0 * AFFINE_EPS) + 5.0 * AFFINE_TINY
        Interval { lo: c_oct - (rad + margin), hi: c_oct + (rad + margin) }
    }
}

/// A 4D affine form `c + dot(l, u) ± e` over `u ∈ [-1, 1]⁴`, produced by `affine_form` over a `Box4`.
pub struct Affine4: Copy + GpuData {
    pub c: f32,
    pub l: vec4,
    pub e: f32,
}

impl Affine4 {
    /// Whether this form holds a finite bound (`false` for NaN, infinite, or overflowed forms).
    pub fn valid(self) -> bool {
        let mag = abs(self.c) +
            abs(self.l.x) +
            abs(self.l.y) +
            abs(self.l.z) +
            abs(self.l.w) +
            self.e
        mag <= AFFINE_CAP && self.e >= 0.0
    }

    /// Sound lower bound over `u ∈ [-1, 1]⁴`, rounded outward; `-∞` when not `valid()`.
    pub fn lo(self) -> f32 {
        let rad = abs(self.l.x) + abs(self.l.y) + abs(self.l.z) + abs(self.l.w) + self.e
        let mag = abs(self.c) + rad
        if !(mag <= AFFINE_CAP && self.e >= 0.0) {
            return -1.0 / 0.0
        }
        let margin = mag * (12.0 * AFFINE_EPS) + AFFINE_TINY
        self.c - (rad + margin)
    }

    /// Sound upper bound over `u ∈ [-1, 1]⁴`, rounded outward; `+∞` when not `valid()`.
    pub fn hi(self) -> f32 {
        let rad = abs(self.l.x) + abs(self.l.y) + abs(self.l.z) + abs(self.l.w) + self.e
        let mag = abs(self.c) + rad
        if !(mag <= AFFINE_CAP && self.e >= 0.0) {
            return 1.0 / 0.0
        }
        let margin = mag * (12.0 * AFFINE_EPS) + AFFINE_TINY
        self.c + (rad + margin)
    }

    /// Sound `[lo, hi]` interval over `u ∈ [-1, 1]⁴`.
    pub fn range(self) -> Interval {
        Interval { lo: self.lo(), hi: self.hi() }
    }

    /// Sound `[lo, hi]` interval over the sub-box `u ∈ [u_lo, u_hi] ⊆ [-1, 1]⁴`.
    pub fn sub_range(self, u_lo: vec4, u_hi: vec4) -> Interval {
        if !self.valid() {
            return Interval { lo: -1.0 / 0.0, hi: 1.0 / 0.0 }
        }
        let a = self.l * u_lo
        let b = self.l * u_hi
        let mn = min(a, b)
        let mx = max(a, b)
        let am = max(abs(a), abs(b))
        let mag = abs(self.c) + am.x + am.y + am.z + am.w + self.e
        let margin = mag * (14.0 * AFFINE_EPS) + 6.0 * AFFINE_TINY
        Interval {
            lo: (self.c + mn.x + mn.y + mn.z + mn.w) - (self.e + margin),
            hi: (self.c + mx.x + mx.y + mx.z + mx.w) + (self.e + margin),
        }
    }
}

/// What a derived function can take: `f32` and the float vectors, each with its box and affine
/// form types.
pub trait Domain {
    type Box
    type Affine
}

impl Domain for f32 {
    type Box = Interval
    type Affine = Affine1
}

impl Domain for vec2 {
    type Box = Box2
    type Affine = Affine2
}

impl Domain for vec3 {
    type Box = Box3
    type Affine = Affine3
}

impl Domain for vec4 {
    type Box = Box4
    type Affine = Affine4
}

/// The gradient of `f` at `at`, by forward-mode differentiation of `f`'s body.
@intrinsic
pub fn gradient<X: Domain>(f: fn(X) -> f32, at: X) -> X {}

/// `f(at)` and its gradient, from one derived evaluation.
@intrinsic
pub fn value_and_gradient<X: Domain>(f: fn(X) -> f32, at: X) -> (f32, X) {}

/// `f(at)`'s value, its gradient, and the rest of what `f` returns, from one derived
/// evaluation: a field's channels beside its distance and normal, where computing them apart
/// would compute the distance twice. Only the value is differentiated.
@intrinsic
pub fn value_gradient_with<X: Domain, T>(f: fn(X) -> (f32, T), at: X) -> (f32, X, T) {}

/// A range that contains `f(x)` for every `x` in `over`, by interval arithmetic over `f`'s
/// body: an `Interval` for an `f32`, and a box for a vector, each component's range from one
/// derived function. On the GPU each operation widens its result outward by its error bound.
@intrinsic
pub fn interval<X: Domain, Y: Domain>(f: fn(X) -> Y, over: X::Box) -> Y::Box {}

/// A range that contains `f(x)` for every `x` in `over`, from `f`'s affine form over the box
/// (Stolfi and de Figueiredo's affine arithmetic), intersected with `interval(f, over)`'s, so
/// never looser than it. Supports both scalar `f32` (`-> Interval`) and float vector (`-> Box2`/
/// `Box3`/`Box4`) outputs. Where `f` is smooth over the box the form's range closes on the true
/// one as the box shrinks, by its square, where an interval's stays a multiple of its width:
/// `x - x` is 0 here. Sound as the target rounds, as the interval is.
@intrinsic
pub fn affine<X: Domain, Y: Domain>(f: fn(X) -> Y, over: X::Box) -> Y::Box {}

/// The affine form `c + dot(l, u) ± e` of `f` over `over` (`u ∈ [-1, 1]^n`), returned directly
/// without computing a redundant plain interval alongside it. Falls back to wrapping `interval`
/// only when `f` cannot be affine-derived. Sound as the target rounds.
@intrinsic
pub fn affine_form<X: Domain>(f: fn(X) -> f32, over: X::Box) -> X::Affine {}

/// A sound upper bound on `sup_{x ∈ over} ||∇f(x)||₂`, derived by hybrid Clarke-subdifferential
/// and exact interval-Jacobian propagation: preserves exact `1.0` bounds across orthogonal
/// rotations, `abs`, `min`, `max`, `clamp`, `smin`, `length`, and piecewise branches without
/// crease blowup, and pads upward for target rounding.
@intrinsic
pub fn lipschitz<X: Domain>(f: fn(X) -> f32, over: X::Box) -> f32 {}

/// For `wrela precision`: `interval(f, over)` twice, once widened as an `f32` rounds and once as
/// a half float rounds, each noting every operation's range (`precision_note`). It returns
/// nothing; `wrela precision` reads the notes and says where an `f16` twin would be safe. The
/// half walk isn't an interval in `f16`: it's the `f32` walk, widened by a half float's rounding
/// at each operation, so what it says is advice, not a bound. A measured twin is the proof.
@intrinsic
pub fn precision<X: Domain, Y: Domain>(f: fn(X) -> Y, over: X::Box) {}

/// One of `precision`'s notes, printed as a line: `precision`, then the walk (1 for the half
/// walk), the source file and byte where the operation is, whether its value is an integer, its
/// name in three little-endian words, and its range's ends as their bits.
pub fn precision_note(
    half: u32,
    file: u32,
    at: u32,
    int: u32,
    op0: u32,
    op1: u32,
    op2: u32,
    lo: f32,
    hi: f32,
) {
    print(
        f"precision {half} {file} {at} {int} {op0} {op1} {op2} {bitcast_u32(lo)} {bitcast_u32(hi)}",
    )
}

/// `f(at)` box-filtered over a footprint `width` wide along each of `at`'s components (a pixel's
/// spread in `f`'s input, say): each `fract`, `floor`, `ceil`, `round`, `trunc`, `step`, `sign`,
/// `abs`, `min`, `max`, `clamp`, `saturate`, `sin`, `cos`, `smoothstep`, and `value_noise` on the
/// input's path is replaced by its filtered average over the range its operand spans in the
/// footprint (to first order: the operand's derivative along each component, times the width there,
/// summed in size). Works for any value-returning `Y` (`f32`, vectors, structs such as `Substance`).
/// A point sample of stripes, rings, or noise finer than a pixel aliases; this fades them to their
/// mean. What a branch on the input chooses isn't filtered: write it with `step`, `smoothstep` or
/// `mix`. Each value is averaged alone, to first order: a product of patterns along different
/// components averages exactly, but `abs` of a difference of two averaged patterns doesn't (a
/// checker is best a product of its stripes).
@intrinsic
pub fn filtered<X: Domain, Y>(f: fn(X) -> Y, at: X, width: X) -> Y {}

/// The tape of `f` (`std::stage`): its body as a run of the tape's operations, built once, on
/// the CPU, for a GPU kernel or the CPU to interpret. What doesn't depend on the point (a part's
/// placement, a radius, a seed, a loop's count) is computed as `f` computes it, and reaches the
/// tape as constants; a branch on the point runs both sides and selects. A function a tape
/// can't hold (a loop that leaves on the point, an index into what depends on it) is E0709.
/// A tape past its capacity panics.
@intrinsic
pub fn tape(f: fn(vec3) -> f32) -> Tape {}

/// The tape of `f`'s value and the rest of what it returns, `T`'s floats (scalars and vectors
/// of them, in field order), in the tape's last `1 + n` registers: what `interpret_with` reads.
/// How a field's channels (a colour, a material's weights) travel with its distance.
@intrinsic
pub fn tape_with<T: GpuData>(f: fn(vec3) -> (f32, T)) -> Tape {}

/// The most work one call of `f` does as GPU code (language.md §18.11), a constant of the build:
/// `f` counted as the build's manifest counts an entry point (in units of about one 32-bit
/// operation: an operation on a component 1, a division or a transcendental 4, a buffer's read 8,
/// a texture's sample 16), knowing nothing of what it captures or is given, so a branch counts its
/// costlier side and a loop its most passes. The same number on the CPU and in GPU code, on every
/// machine and run: what a program weighs one way of asking against another by, never a time.
/// `UNBOUNDED_WORK` where the count has no bound (a loop with no sure end). `f` must be a function
/// GPU code could call.
@intrinsic
pub fn work<X, Y>(f: fn(X) -> Y) -> u32 {}

/// Whether `f`'s result depends on nothing but what it's given (language.md §14): none of the
/// values it captures (whatever they are: a captured value is an input), and nothing outside it
/// (a resource, a builtin input, the host). Found from `f`'s code as GPU code, data and control:
/// a value a branch on a capture chooses depends on the capture. A constant of the build, the
/// same on the CPU and in GPU code. Never true for a function whose result can change with
/// anything but its argument; it may be false for one that can't (a capture whose every use
/// cancels out).
@intrinsic
pub fn reads_only_input<X, Y>(f: fn(X) -> Y) -> bool {}

/// What `work` gives where the count has no bound.
pub const UNBOUNDED_WORK: u32 = 4294967295

/// `a + b` of two counts of `work`, held at `UNBOUNDED_WORK`.
pub fn plus_work(a: u32, b: u32) -> u32 {
    if a >= UNBOUNDED_WORK - b { UNBOUNDED_WORK } else { a + b }
}

/// `tape` into a `Taped` of another room (`Taped<N, K>`): what a tape too long for a `Tape`
/// needs, to be pruned.
@intrinsic
pub fn tape_sized<const N: u32, const K: u32>(f: fn(vec3) -> f32) -> Taped<N, K> {}

// ---- tests (the suite runs std's: `std_tests_pass`) --------------------------------------------

@test
fn a_gradient_carries_the_rest_of_the_result() {
    let p = vec3(0.3, -0.4, 1.2)
    let f = |q: vec3| (length(q) - 1.0, (q.x * q.y, vec2(q.z, 2.0)))
    let (d, g, rest) = value_gradient_with(f, p)
    let (d2, g2) = value_and_gradient(|q: vec3| length(q) - 1.0, p)
    assert(d == d2 && g == g2, "the value and gradient are value_and_gradient's")
    assert(rest.0 == p.x * p.y && rest.1 == vec2(p.z, 2.0), "the rest is the function's")
}

@test
fn samples_spread_evenly_through_their_box() {
    let b = Box3 { lo: vec3(-1.0, 2.0, 0.0), hi: vec3(3.0, 2.5, 10.0) }
    // 4096 points over 8 × 8 × 8 cells: exactly 8 in each (random points would vary by ±3).
    var cells = [0; 512]
    for i in 0..4096 {
        let p = b.sample(11, i)
        assert(p.x >= b.lo.x && p.y >= b.lo.y && p.z >= b.lo.z, "a sample is below the box")
        assert(p.x < b.hi.x && p.y < b.hi.y && p.z < b.hi.z, "a sample is above the box")
        let c = (p - b.lo) / (b.hi - b.lo) * 8.0
        cells[u32(c.x) + 8 * u32(c.y) + 64 * u32(c.z)] += 1
    }
    for k in 0..512 {
        assert(cells[k] == 8, f"cell {k}")
    }
    let (a, c) = (b.sample(seed: 11, i: 5), b.sample(seed: 12, i: 5))
    assert(a != c, "the seed doesn't change the sequence")
}

@test
fn samples_of_a_range_and_a_rectangle_stay_in_them() {
    let r = Interval { lo: -2.0, hi: 6.0 }
    let b = Box2 { lo: vec2(0.0, -1.0), hi: vec2(1.0, 1.0) }
    for i in 0..1024 {
        let x = r.sample(3, i)
        assert(r.lo <= x && x < r.hi, "a sample is outside its range")
        let p = b.sample(3, i)
        assert(p.x >= b.lo.x && p.y >= b.lo.y && p.x < b.hi.x && p.y < b.hi.y)
    }
}

@test
fn samples_stay_finite_when_their_ranges_span_large_values() {
    let r = Interval { lo: -2.0e38, hi: 2.0e38 }
    let b2 = Box2 { lo: vec2(r.lo), hi: vec2(r.hi) }
    let b3 = Box3 { lo: vec3(r.lo), hi: vec3(r.hi) }
    for i in 0..16 {
        assert(r.contains(r.sample(3, i)))
        let p2 = b2.sample(3, i)
        assert(r.contains(p2.x) && r.contains(p2.y))
        let p3 = b3.sample(3, i)
        assert(r.contains(p3.x) && r.contains(p3.y) && r.contains(p3.z))
    }
}

/// A field that moves with time `t`, for the nested intervals: each variable occurs once (and
/// `p.x` as a square), so an interval of it bounds its true range, up to rounding, however the
/// variables are split between the derivations.
fn swept(p: vec3, t: f32) -> f32 {
    p.x * p.x + sin(p.y) * t + p.z
}

/// An interval over time of an interval over space (§14.2): finite, holding every sample, and as
/// tight as the interval over both at once, within a few ulps. (On the CPU each bound passes a
/// guard that makes a NaN infinite, `b == b`; the outer interval decides it where `b`'s range is
/// finite.)
@test
fn a_nested_interval_is_as_tight_as_the_flat_one() {
    let space = Box3 { lo: vec3(-0.25, 0.5, 1.0), hi: vec3(0.5, 0.75, 1.125) }
    let time = Interval { lo: 0.5, hi: 1.5 }
    let lo = interval(|t: f32| interval(|p: vec3| swept(p, t), space).lo, time).lo
    let hi = interval(|t: f32| interval(|p: vec3| swept(p, t), space).hi, time).hi
    let both = Box4 { lo: vec4(space.lo, time.lo), hi: vec4(space.hi, time.hi) }
    let flat = interval(|q: vec4| swept(q.xyz, q.w), both)
    assert(abs(lo) < 1.0 / 0.0 && abs(hi) < 1.0 / 0.0, f"the nested interval is [{lo}, {hi}]")
    for i in 0..256 {
        let v = swept(space.sample(5, i), time.sample(6, i))
        assert(lo <= v && v <= hi, f"{v} is outside [{lo}, {hi}]")
    }
    assert(
        abs(lo - flat.lo) <= 2.0e-6 && abs(hi - flat.hi) <= 2.0e-6,
        f"nested [{lo}, {hi}], flat [{flat.lo}, {flat.hi}]",
    )
}

/// A footprint's mean of `f`, from `n` samples spread evenly across `[x - w/2, x + w/2]`.
fn mean_over(f: fn(f32) -> f32, x: f32, w: f32, n: u32) -> f32 {
    var s = 0.0
    for i in 0..n {
        s += f(x + w * ((f32(i) + 0.5) / f32(n) - 0.5))
    }
    s / f32(n)
}

/// Filtered stripes are near their footprint's mean, at every width: a point sample of stripes
/// finer than the footprint is all one or all the other, the filtered value a share between.
/// Over 64 points and widths from a thousandth of a stripe to many stripes, its error from a
/// 4096-sample mean is at most a fifth of a point sample's, and under 0.05 on average.
@test
fn filtered_stripes_are_near_their_footprints_mean() {
    let stripes = |u: f32| step(0.5, fract(u * 4.0))
    var filtered_error = 0.0
    var point_error = 0.0
    var n = 0
    for i in 0..64 {
        let x = Interval { lo: -3.0, hi: 3.0 }.sample(3, i)
        for w in [0.0005, 0.02, 0.1, 0.3, 1.0, 5.0] {
            let mean = mean_over(stripes, x, w, 4096)
            filtered_error += abs(filtered(stripes, x, w) - mean)
            point_error += abs(stripes(x) - mean)
            n += 1
        }
    }
    assert(filtered_error <= 0.2 * point_error, f"{filtered_error} against {point_error}")
    assert(filtered_error / f32(n) < 0.05, f"{filtered_error / f32(n)} on average")
}

/// A footprint of no width keeps the point's own value exactly; one wide over a checker of unit
/// squares gives about half. The checker is written as a product of its two axes' stripes,
/// which a box footprint averages exactly; `abs` of their difference would give 0 far off (each
/// stripe's mean is a half, and the difference of the means is 0).
@test
fn filtered_checkers_are_the_point_up_close_and_grey_far_off() {
    let checker = |p: vec2| {
        0.5 - 0.5 * (1.0 - 2.0 * step(0.5, fract(p.x))) * (1.0 - 2.0 * step(0.5, fract(p.y)))
    }
    for i in 0..32 {
        let p = Box2 { lo: vec2(-4.0), hi: vec2(4.0) }.sample(5, i)
        assert(filtered(checker, p, vec2(0.0)) == checker(p), "a point's footprint changed it")
        let far = filtered(checker, p, vec2(16.0))
        assert(abs(far - 0.5) < 0.1, f"a wide footprint of a checker gave {far}")
    }
}

fn near(got: f32, want: f32, what: str) {
    assert(abs(got - want) <= 1.0e-5, f"{what}: {got}, not {want}")
}

/// Each builtin `filtered` box-filters, over a footprint of `x` itself, against its average
/// worked out by hand: across a kink or a jump, beside one (a footprint that misses it keeps the
/// point's value exactly, however large `x`), and just past fract's jump with a footprint of a
/// few ulps (f32's own: `1 - 2⁻²⁴` and `2⁻¹⁹`, where `f + w/2 - 1` rounds). A clamp whose low
/// bound moves with `x` has no kink there.
@test
fn filtered_builtins_are_their_footprints_average() {
    let trunc_of = |u: f32| trunc(u)
    near(filtered(trunc_of, at: 0.0, width: 1.0), 0.0, "trunc across 0")
    near(filtered(trunc_of, at: 1.0, width: 1.0), 0.5, "trunc across 1")
    near(filtered(trunc_of, at: -1.0, width: 1.0), -0.5, "trunc across -1")
    near(filtered(trunc_of, at: -0.5, width: 1.0), 0.0, "trunc below 0")
    let floor_of = |u: f32| floor(u)
    near(filtered(floor_of, at: 0.0, width: 1.0), -0.5, "floor across 0")
    assert(filtered(floor_of, at: 2.5, width: 0.5) == 2.0, "floor beside no jump")
    let ceil_of = |u: f32| ceil(u)
    near(filtered(ceil_of, at: 0.0, width: 1.0), 0.5, "ceil across 0")
    let round_of = |u: f32| round(u)
    near(filtered(round_of, at: 0.5, width: 1.0), 0.5, "round across a half")
    let fract_of = |u: f32| fract(u)
    near(filtered(fract_of, at: 1000.25, width: 0.1), 0.25, "fract far off")
    near(filtered(fract_of, at: 0.0, width: 1.0), 0.5, "fract across 0")
    near(
        filtered(fract_of, at: 1.0 - 1.0 / 16777216.0, width: 1.0 / 524288.0),
        0.53124994,
        "fract by ulps",
    )
    let abs_of = |u: f32| abs(u)
    assert(filtered(abs_of, at: 1000000.0, width: 0.01) == 1000000.0, "abs far from its kink")
    near(filtered(abs_of, at: 0.0, width: 1.0), 0.25, "abs across 0")
    near(filtered(abs_of, at: 0.25, width: 1.0), 0.3125, "abs beside 0")
    let min_of = |u: f32| min(u, 0.0)
    let max_of = |u: f32| max(u, 0.0)
    assert(filtered(min_of, at: 1000000.0, width: 1.0) == 0.0, "min far from its kink")
    near(filtered(min_of, at: 0.0, width: 1.0), -0.125, "min across 0")
    near(filtered(max_of, at: 0.0, width: 1.0), 0.125, "max across 0")
    let saturate_of = |u: f32| saturate(u)
    assert(filtered(saturate_of, at: 1000000.0, width: 1.0) == 1.0, "saturate far from its kinks")
    near(filtered(saturate_of, at: 0.0, width: 1.0), 0.125, "saturate across 0")
    let clamp_of = |u: f32| clamp(u, -1.0, 1.0)
    near(filtered(clamp_of, at: 1.0, width: 1.0), 0.875, "clamp across its top")
    let moving = |u: f32| clamp(u, u - 0.25, 1.0)
    near(filtered(moving, at: 1.0, width: 1.0), 0.875, "a clamp whose low bound moves with x")
    let sign_of = |u: f32| sign(u)
    near(filtered(sign_of, at: 0.0, width: 1.0), 0.0, "sign across 0")
    near(filtered(sign_of, at: 0.25, width: 1.0), 0.5, "sign beside 0")
    let step_of = |u: f32| step(0.0, u)
    near(filtered(step_of, at: 0.25, width: 1.0), 0.75, "step beside 0")
}

struct FilteredSample: Copy {
    rgb: vec3,
    rough: f32,
    tag: u32,
}

@test
fn filtered_sin_cos_smoothstep_and_structs_match_box_integral() {
    let f_sin = |u: f32| sin(u * 6.0)
    let f_cos = |u: f32| cos(u * 5.0 + 0.3)
    let f_ss = |u: f32| smoothstep(0.2, 0.8, u)
    let f_ss_rev = |u: f32| smoothstep(0.8, 0.2, u)
    let f_ss_steep = |u: f32| smoothstep(0.0, 0.002, u)
    // Zero width keeps exact point value.
    assert(filtered(f_sin, at: 0.37, width: 0.0) == f_sin(0.37), "sin w=0")
    assert(filtered(f_cos, at: 0.37, width: 0.0) == f_cos(0.37), "cos w=0")
    assert(filtered(f_ss, at: 0.37, width: 0.0) == f_ss(0.37), "smoothstep w=0")
    assert(filtered(f_ss_rev, at: 0.37, width: 0.0) == f_ss_rev(0.37), "rev smoothstep w=0")
    // Analytic box integral matches 4096-sample mean across small and large widths.
    for x in [-0.7, 0.0, 0.25, 0.5, 0.9, 2.3] {
        for w in [0.005, 0.08, 0.5, 2.0, 7.0] {
            let ms = mean_over(f_sin, x, w, 4096)
            let mc = mean_over(f_cos, x, w, 4096)
            let mss = mean_over(f_ss, x, w, 4096)
            let msr = mean_over(f_ss_rev, x, w, 4096)
            let mst = mean_over(f_ss_steep, x, w, 4096)
            assert(abs(filtered(f_sin, x, w) - ms) < 2.0e-3, f"sin ({x}, {w})")
            assert(abs(filtered(f_cos, x, w) - mc) < 2.0e-3, f"cos ({x}, {w})")
            assert(abs(filtered(f_ss, x, w) - mss) < 2.0e-3, f"ss ({x}, {w})")
            assert(abs(filtered(f_ss_rev, x, w) - msr) < 2.0e-3, f"ss_rev ({x}, {w})")
            assert(abs(filtered(f_ss_steep, x, w) - mst) < 2.0e-3, f"ss_steep ({x}, {w})")
        }
    }
    // Arbitrary return types (vec3 and struct with non-float field).
    let f_vec = |p: vec2| vec3(sin(p.x * 20.0), cos(p.y * 20.0), smoothstep(0.0, 0.1, p.x))
    let v_far = filtered(f_vec, vec2(0.05, 0.05), vec2(10.0, 10.0))
    assert(abs(v_far.x) < 0.05 && abs(v_far.y) < 0.05 && abs(v_far.z - 0.5) < 0.02, f"vec3 {v_far}")
    let f_struct = |p: vec2| FilteredSample {
        rgb: vec3(0.5 + 0.5 * sin(p.x * 50.0), 0.4, 0.5 + 0.5 * cos(p.y * 50.0)),
        rough: 0.2 + 0.6 * step(0.5, fract(p.x * 10.0)),
        tag: 7,
    }
    let s_pt = filtered(f_struct, vec2(0.13, 0.27), vec2(0.0))
    let s_raw = f_struct(vec2(0.13, 0.27))
    assert(s_pt.rgb == s_raw.rgb && s_pt.rough == s_raw.rough && s_pt.tag == 7, "struct w=0")
    let s_far = filtered(f_struct, vec2(0.13, 0.27), vec2(4.0, 4.0))
    assert(
        abs(s_far.rgb.x - 0.5) < 0.05 &&
            abs(s_far.rgb.y - 0.4) < 1.0e-5 &&
            abs(s_far.rgb.z - 0.5) < 0.05 &&
            abs(s_far.rough - 0.5) < 0.05 &&
            s_far.tag == 7,
        f"struct far {s_far.rgb} {s_far.rough} {s_far.tag}",
    )
}

@test
fn a_box_splits_into_what_it_holds() {
    let b = Box3 { lo: vec3(-1.0, 0.0, 2.0), hi: vec3(1.0, 4.0, 3.0) }
    assert(b.center() == vec3(0.0, 2.0, 2.5))
    assert(b.half() == vec3(1.0, 2.0, 0.5))
    assert(b.contains(b.lo) && b.contains(b.hi) && b.contains(b.center()))
    assert(!b.contains(vec3(1.5, 2.0, 2.5)))
    var volume = 0.0
    for o in b.split() {
        assert(b.contains(o.lo) && b.contains(o.hi))
        let s = o.hi - o.lo
        volume += s.x * s.y * s.z
    }
    assert(volume == 8.0, f"the octants' volumes add to {volume}")
    let last = b.split()[7]
    assert(last.lo == b.center() && last.hi == b.hi)
    let q = Box2 { lo: vec2(0.0), hi: vec2(2.0, 4.0) }
    assert(q.center() == vec2(1.0, 2.0) && q.half() == vec2(1.0, 2.0))
    assert(q.split()[3].lo == q.center() && q.split()[0].hi == q.center())
    assert(q.contains(vec2(2.0, 4.0)) && !q.contains(vec2(-0.1, 0.0)))
}

@test
fn a_box_one_step_wide_splits_into_children_that_keep_its_ends() {
    // 1 and the next f32 up: halfway between them rounds to 1, so the upper half is the whole step.
    let next = bitcast_f32(bitcast_u32(1.0) + 1)
    let b = Box3 { lo: vec3(1.0, 0.0, 0.0), hi: vec3(next, 2.0, 2.0) }
    let octants = b.split()
    for j in 0..8 {
        let o = octants[j]
        assert(o.lo.x == if j & 1 == 0 { 1.0 } else { b.center().x }, "an octant's low x")
        assert(o.hi.x == if j & 1 == 0 { b.center().x } else { next }, "an octant's high x")
    }
    assert(octants[7].hi == b.hi && octants[0].lo == b.lo)
    let q = Box2 { lo: vec2(0.0, 1.0), hi: vec2(2.0, next) }
    let quarters = q.split()
    assert(quarters[3].hi == q.hi && quarters[2].hi.y == next && quarters[0].lo == q.lo)
}

@test
fn affine_form_bounds_match_samples_and_octants() {
    // 1D: f(t) = t * t - 2.0 * t + 0.5 over [0.5, 1.5]
    let iv = Interval { lo: 0.5, hi: 1.5 }
    let af1 = affine_form(|t: f32| t * t - 2.0 * t + 0.5, iv)
    assert(af1.valid(), "1D affine form should be valid")
    let r1 = af1.range()
    for i in 0..64 {
        let t = iv.sample(3, i)
        let v = t * t - 2.0 * t + 0.5
        assert(r1.contains(v), f"1D affine_form missed {v} outside [{r1.lo}, {r1.hi}]")
    }
    // Sub-range over left half u in [-1, 0] (t in [0.5, 1.0])
    let sub1 = af1.sub_range(u_lo: -1.0, u_hi: 0.0)
    for i in 0..32 {
        let t = Interval { lo: 0.5, hi: 1.0 }.sample(5, i)
        let v = t * t - 2.0 * t + 0.5
        assert(sub1.contains(v), f"1D sub_range missed {v} outside [{sub1.lo}, {sub1.hi}]")
    }

    // 3D: smooth nonlinear field over Box3 + octant_range check
    let b3 = Box3 { lo: vec3(0.4, -0.3, 0.2), hi: vec3(0.6, -0.1, 0.4) }
    let f3 = |p: vec3| length(p) - 0.5 + 0.1 * sin(p.x * 2.0 + p.y)
    let af3 = affine_form(f3, b3)
    assert(af3.valid(), "3D affine form should be valid")
    let r3 = af3.range()
    for i in 0..64 {
        let p = b3.sample(7, i)
        let v = f3(p)
        assert(r3.contains(v), f"3D affine_form missed {v} outside [{r3.lo}, {r3.hi}]")
    }
    let octs = b3.split()
    for k in 0..8 {
        let orng = af3.octant_range(k)
        for i in 0..16 {
            let p = octs[k].sample(9 + k, i)
            let v = f3(p)
            assert(orng.contains(v), f"octant {k} missed {v} outside [{orng.lo}, {orng.hi}]")
        }
    }

    // Unbounded quotient marks valid() == false and lo()/hi() == ±inf
    let bad = affine_form(|t: f32| 1.0 / t, Interval { lo: -1.0, hi: 1.0 })
    assert(!bad.valid(), "division across zero should not be valid")
    assert(bad.lo() == -1.0 / 0.0 && bad.hi() == 1.0 / 0.0)

    // Constant function has zero slope and zero error
    let cst = affine_form(|_p: vec3| 3.25, b3)
    assert(cst.valid() && cst.c == 3.25 && cst.l == vec3(0.0) && cst.e == 0.0)
}

@test
fn vector_affine_bounds_gradient_and_vectors() {
    let b = Box3 { lo: vec3(0.5, 0.2, -0.4), hi: vec3(0.7, 0.4, -0.2) }
    let g_fn = |q: vec3| gradient(|p: vec3| length(p) - 1.0, q)
    let ga = affine(g_fn, b)
    let gi = interval(g_fn, b)
    for i in 0..64 {
        let p = b.sample(13, i)
        let g = g_fn(p)
        assert(ga.contains(g), f"vector affine missed gradient {g} outside [{ga.lo}, {ga.hi}]")
    }
    // Affine bound is never looser than plain interval
    assert(
        ga.lo.x >= gi.lo.x &&
            ga.lo.y >= gi.lo.y &&
            ga.lo.z >= gi.lo.z &&
            ga.hi.x <= gi.hi.x &&
            ga.hi.y <= gi.hi.y &&
            ga.hi.z <= gi.hi.z,
        "vector affine should be at least as tight as plain interval",
    )
    // vec2 and vec4 outputs also work
    let b2 = Box2 { lo: vec2(0.1, 0.2), hi: vec2(0.3, 0.5) }
    let v2 = affine(|p: vec2| vec2(p.x - p.x + p.y, p.x * p.y), b2)
    assert(v2.lo.x >= 0.199 && v2.hi.x <= 0.501, f"vec2 cancellation failed: [{v2.lo}, {v2.hi}]")
    let v4 = affine(|t: f32| vec4(t, -t, t * t, 1.0 - t), Interval { lo: 0.25, hi: 0.75 })
    assert(v4.lo.x <= 0.25 && v4.hi.x >= 0.75 && v4.lo.z >= 0.0 && v4.hi.z <= 0.6)
}
