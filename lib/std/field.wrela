// Fields, functions over space: signed-distance surfaces, the combinators that join, cut, move
// and displace them, noise, channels such as colour, and measures and certified checks of a
// surface (language.md §20). A field's structure is its type and its numbers are data:
// `sphere(1.0).smooth_union(round_cone(...), k: 0.1)` has the type
// `SmoothUnion<Sphere, RoundCone>`, whose value is a few floats that reach the GPU as a uniform.
//
// A `Surface` is a signed distance. A `Field<C>` is a surface whose points also carry channels
// `C`, which the combinators blend where surfaces blend (`Blend`). A surface states a bound on
// its gradient near itself (`lipschitz`), so sphere tracing can step by it (`to_bound`); a
// closure of a point states none. A `Noise` states its range, its gradient's bound and its
// bandlimit.
//
// A surface's parts are the leaves of its tree of combinators (language.md §23): each knows
// which part decides its distance at a point (`part_at`), each part's own distance, and its
// name, so a tool can say what a point belongs to without knowing what made the surface.

use std::collections::Vec
use std::derive::{
    Affine3, Box3, Interval, affine, affine_form, filtered, gradient, interval, plus_work,
    reads_only_input, tape, value_and_gradient, work,
}
use std::stage::Tape
use std::quat::Quat
use std::hash::{Hasher, StateHash, canonical_bits, pcg, state_hash}
use std::mem::debug_build
use std::gpu::{R32Float, Texture3dHandle}

/// A signed distance over 3D space: negative inside, positive outside.
///
/// ```wrela
/// use std::field::{Surface, round_cone, sphere}
///
/// fn blob() -> Surface {
///     let cone = round_cone(vec3(), vec3(y: 1.0), r_top: 0.3, r_bottom: 0.1)
///     sphere(0.5).smooth_union(cone, k: 0.1)
/// }
///
/// assert(blob().distance(vec3(0.0, 0.5, 0.0)) < 0.0)    // inside
/// assert(blob().distance(vec3(2.0, 0.0, 0.0)) > 0.0)    // outside
/// ```
pub trait Surface: Copy + GpuData {
    /// Whether `skin_shape_hash` may be `Some`: a constant of the kind, true for `Skinned` and
    /// what forwards its hash (`Warp`, `With`, `WithAt`), so a kind that can't be skinned has no
    /// skinned path in the engine's extraction and draws, and a scene none of whose kinds can be,
    /// no skinned or deformed draw's pipeline. A kind that overrides `skin_shape_hash` says true;
    /// `engine::mesh` stops a skinned field whose kind says false.
    const MAY_SKIN: bool = false

    /// The signed distance from `p` to the surface.
    fn distance(self, p: vec3) -> f32

    /// The gradient of `distance`, derived by the compiler (§14): the surface normal, not
    /// normalized.
    fn gradient(self, p: vec3) -> vec3 {
        gradient(|q| self.distance(q), p)
    }

    /// The distance and its gradient, from one derived evaluation.
    fn sample(self, p: vec3) -> (f32, vec3) {
        value_and_gradient(|q| self.distance(q), p)
    }

    /// Its distance at `p` where that is below `most`, bit for bit as `distance` gives it, and
    /// elsewhere a number no less than `most` and no more than the distance: what a question
    /// that only asks what is within `most` of `p` reads (a grain's contact, say). What its
    /// bound shows is farther (`Bound::below`) isn't asked, so a union asks only the parts that
    /// can be that near. The default asks the bound, then the distance.
    fn distance_within(self, p: vec3, most: f32) -> f32 {
        let below = self.bound().below(p)
        if below >= most {
            return below
        }
        self.distance(p)
    }

    /// Its distance at `p` as something `footprint` wide sees it (a pixel's or a cell's span):
    /// detail finer than the footprint fades to its mean instead of aliasing. A displacement
    /// filters its noise (`Noise::filtered`), and every combinator passes the footprint on, so
    /// detail anywhere in a surface's tree is filtered. The default is the distance itself: a
    /// surface with no detail finer than the footprints it's seen at.
    fn filtered(self, p: vec3, footprint: f32) -> f32 {
        self.distance(p)
    }

    /// A sphere outside which its distance has a lower bound (`Bound::below`): what culling and
    /// sampling read to skip a surface that can't matter at a point, and LOD to size it by.
    /// Every surface states one (language.md §20.3): a surface that has none says so with
    /// `UNBOUNDED`, and why. A debug build checks it against the derived interval
    /// (`check_bound`) where the surface is stepped by (`to_bound`).
    fn bound(self) -> Bound

    /// A range holding every distance in `over`, derived by interval arithmetic.
    fn interval(self, over: Box3) -> Interval {
        interval(|q| self.distance(q), over)
    }

    /// Its distance as a tape (`std::derive::tape`): what a kernel interprets when the surface
    /// is built at run time, or chosen from many.
    fn to_tape(self) -> Tape {
        tape(|q| self.distance(q))
    }

    /// A bound on the length of `distance`'s gradient wherever |distance| < `near` (§20), so
    /// sphere tracing can step by it: primitives state theirs, combinators compose their parts'
    /// in ordinary code and pass the scope on. A consumer passes the scope it needs: a step of at
    /// most `near` (`to_bound`), or an interval test over a block that straddles the surface, at
    /// least the block's radius. A surface that states none (a closure of a point) is unbounded:
    /// infinite.
    fn lipschitz(self, near: f32) -> f32 {
        1.0 / 0.0
    }

    /// A range holding its distance over `b`: the derived interval, narrowed by the distance
    /// at `b`'s centre and the bound. The derived interval says how far from the surface `b` can
    /// be, which is the scope the bound needs; along the segment from the centre to any point of
    /// `b`, the distance then changes by at most the bound times the half-diagonal. Each narrows
    /// the other: a culling test keeps fewer boxes with both. A displacement narrows its
    /// surface's and adds its noise's range, which is tighter than its noise's steepness allows
    /// and needs no noise at the centre.
    ///
    /// A join or a move takes what holds both this and its parts' own, composed (`own_near`),
    /// each narrowed by its own bound: one part whose bound is unbounded (an ellipsoid with its
    /// centre in scope) or steep doesn't leave the rest at their derived intervals, which over
    /// large boxes may never leave 0 (a body's round cones', hundreds of metres away), so a
    /// search for where it can be would not close.
    fn interval_near(self, b: Box3) -> Interval {
        own_near(self, b, self.interval(b))
    }

    /// The distance, held within ±`near` and divided by `lipschitz(near)`: never more than the
    /// distance to the surface, so sphere tracing can step by it. A debug build checks the
    /// bound against the derived gradient first (`check_lipschitz`). An unbounded surface (a
    /// closure's, or an ellipsoid's with its centre in scope) gives 0: nothing a tracer can step
    /// by.
    fn to_bound(self, near: f32) -> ToBound<Self> {
        let l = self.lipschitz(near)
        if debug_build() {
            check_lipschitz(self, near, l)
            check_bound(self, self.bound())
        }
        ToBound { inner: self, near, scale: 1.0 / l }
    }

    /// Every point inside either surface: the smaller distance.
    fn union<B: Surface>(self, b: B) -> Union<Self, B> {
        Union { a: self, b }
    }

    /// A union whose seam is rounded over a width of about `k`.
    fn smooth_union<B: Surface>(self, b: B, k: f32) -> SmoothUnion<Self, B> {
        SmoothUnion { a: self, b, k }
    }

    /// Every point inside both surfaces: the larger distance.
    fn intersect<B: Surface>(self, b: B) -> Intersect<Self, B> {
        Intersect { a: self, b }
    }

    /// The same surface, moved by `by`.
    fn translate(self, by: vec3) -> Translate<Self> {
        Warp { inner: self, map: Shift { by } }
    }

    /// Adds `amp` times a noise to the distance: wrinkles, bark, terrain.
    fn displace<N: Noise>(self, noise: N, amp: f32) -> Displace<Self, N> {
        Displace { inner: self, noise, amp }
    }

    /// The same surface, every point of which carries the channels `value`.
    fn with<C: Copy + GpuData>(self, value: C) -> With<Self, C> {
        With { inner: self, value }
    }

    /// The same surface, whose channels at `p` are `at(p)`: `.with_at(|p| Tissue { albedo:
    /// dapple(p, seed), ..HIDE })`. The closure is stored in the field, so it captures values
    /// only (§6.7).
    fn with_at<C, F: Copy + GpuData + fn(vec3) -> C>(self, at: F) -> WithAt<Self, F> {
        WithAt { inner: self, at }
    }

    /// `a` with `b` cut out of it, the cut's edge rounded over a width of about `k`.
    fn smooth_subtract<B: Surface>(self, b: B, k: f32) -> SmoothSubtract<Self, B> {
        SmoothSubtract { a: self, b, k }
    }

    /// What `a` and `b` hold in common, the edge rounded over a width of about `k`.
    fn smooth_intersect<B: Surface>(self, b: B, k: f32) -> SmoothIntersect<Self, B> {
        SmoothIntersect { a: self, b, k }
    }

    /// The same surface, turned by `by` about the origin.
    fn rotate(self, by: Quat) -> Rotate<Self> {
        Warp { inner: self, map: Turn { to_local: by.inverse().to_mat3() } }
    }

    /// The same surface, `by` times the size, about the origin. `by` can be negative (which
    /// reflects through the origin), but zero has no signed-distance transform and panics.
    fn scale(self, by: f32) -> Scale<Self> {
        if by == 0.0 {
            panic("scale: the factor is zero")
        }
        Warp { inner: self, map: Size { by } }
    }

    /// The surface and its mirror image in the plane x = 0: what it is at `p`, it is at
    /// `(-p.x, p.y, p.z)`. Written for x ≥ 0, its parts are twice its own: those at x ≥ 0, then
    /// their images.
    fn mirror_x(self) -> Mirror<Self> {
        Mirror { inner: self }
    }

    /// The same surface, one part with a name: tools say where a point is by it (§23).
    fn named(self, name: Text) -> Named<Self> {
        Named { inner: self, name }
    }

    // ---- provenance (§23) ----

    /// How many parts it has: the leaves of its tree of combinators. A primitive, a closure
    /// and a `named` surface are one part each.
    fn parts(self) -> u32 {
        1
    }

    /// Its distance at `p` (the same as `distance`), and the part that decides it: through each
    /// combinator, the operand whose distance the result follows. For a union or a blend that's
    /// the nearer, for an intersection the farther, and for a cut the cutter where the cut is
    /// the surface. Parts are numbered from 0, in the order the tree's leaves are written.
    fn part_at(self, p: vec3) -> (f32, u32) {
        (self.distance(p), 0)
    }

    /// Part `i`'s own distance at `p`: that part as if it were the whole surface, moved, turned,
    /// scaled and displaced as the combinators above it move, turn, scale and displace it.
    fn part_distance(self, p: vec3, i: u32) -> f32 {
        self.distance(p)
    }

    /// Writes into `h` what part `i`'s own geometry and channels are made of (its own data and
    /// that of the combinators above it that move or change it, none of the other parts'), and
    /// says whether it can: where a part's hash is the same from one frame to the next, its
    /// cells are too (`MeshBatch` extracts again only the bricks of the parts whose hash moved).
    /// A surface std doesn't know the data of can't, and says so: its whole is hashed instead.
    fn part_state(self, i: u32, h: mut Hasher) -> bool {
        false
    }

    /// Part `i`'s bound, moved as the combinators above it move it: the whole surface's where a
    /// surface doesn't say.
    fn part_bound(self, i: u32) -> Bound {
        self.bound()
    }
    /// Part `i`'s name: empty where nothing names it.
    fn part_name(self, i: u32) -> PartName {
        unnamed()
    }

    /// The distance at `p` if part `i`'s own distance were `by` more: through each combinator,
    /// that operand raised and the others as they are. Where part `i` doesn't decide the
    /// distance (another part is nearer by more than the width of any blend between them) it's
    /// the distance itself; `part_share` is how much it changes.
    fn part_offset(self, p: vec3, i: u32, by: f32) -> f32 {
        self.distance(p) + by
    }

    // ---- over a box: the parts that can matter there (§20.4) ----

    /// The parts that can change its distance anywhere in `over` (§23's numbering): a part of
    /// a union, smooth or not, that no point of the box would miss is left out, and where it
    /// is, `distance_live` gives the distance as `distance` does, bit for bit. Every other part
    /// is live. Found from the ranges of each union's operands over the box, derived.
    fn live(self, over: Box3) -> Live {
        self.pruned(over, |q: vec3| q, 1.0, ALL_LIVE, 0).live
    }

    /// Its distance at `p`, asking only the parts `live` names: what `distance` gives, bit for
    /// bit, wherever `live` is what `live(over)` gave for a box holding `p`. A union asks no part
    /// of an operand whose parts are all left out; a surface that is no union asks all of
    /// itself.
    fn distance_live(self, p: vec3, live: Live) -> f32 {
        self.masked(p, live, 0)
    }

    /// `distance_live` of a surface whose first part is numbered `first` in the whole
    /// surface's numbering: what the combinators implement. The default asks all of it.
    fn masked(self, p: vec3, live: Live, first: u32) -> f32 {
        self.distance(p)
    }

    /// `live`'s work, for a surface whose first part is numbered `first`, asked at `at(q)` for
    /// each `q` of `over` (the maps of the combinators above it, which stretch lengths at most
    /// `stretch` times): `live` with the parts it can leave out cleared, and the range its
    /// distance takes over the box. The default leaves everything live and gives the derived
    /// range, narrowed by the distance at the box's centre and the stated bound on its gradient,
    /// as `interval_near` narrows.
    fn pruned<F: Copy + fn(vec3) -> vec3>(
        self,
        over: Box3,
        at: F,
        stretch: f32,
        live: Live,
        first: u32,
    ) -> Pruned {
        let x = interval(|q: vec3| self.distance(at(q)), over)
        let l = self.lipschitz(near_scope(x))
        if !(l < 1.0e30) {
            return Pruned { live, range: x }
        }
        // How far from the centre's distance the box's can be, and a margin for the rounding of
        // the two distances.
        let d = self.distance(at(over.center()))
        let r = l * stretch * 0.5 * length(over.hi - over.lo)
        let e = r * 1.0e-5 + abs(d) * 1.0e-6 + 1.0e-6
        Pruned { live, range: Interval { lo: max(x.lo, d - r - e), hi: min(x.hi, d + r + e) } }
    }

    /// A first-order enclosure of its distance over a box (`SlopeBox`): a plane the distance
    /// stays near, how near, and its range. A fact every surface has, as `pruned` is: what a
    /// certificate that the surface in a cell is a sheet reads (`slope_affine`).
    ///
    /// As `pruned` is asked: for a surface whose first part is numbered `first`, of
    /// `self.masked(at(q), live, first)` for each `q` of `over`, `at` the maps of the combinators
    /// above it. The enclosure is in the asker's box's own coordinates (`SlopeBox`). `to` says to
    /// first order where `at` takes the box (`MapBox`): what a surface that states its own
    /// enclosure, in its own space (`Slope3`), is asked over and turns its slopes back by
    /// (`MapBox::out`).
    ///
    /// The default is the compiler's own derivation for this surface alone: the affine form of
    /// its distance through the maps above it, over the box (`std::derive::affine_form`), its
    /// range the form's within the derived interval's. A combinator composes its operands'
    /// enclosures instead (a join by `slope_smin`; a map hands its own on in `at` and `to`), so
    /// a tree's enclosure costs the sum of its leaves' and not one form of the whole tree, and a
    /// leaf that knows its own shape states a tighter or cheaper one.
    fn slope_box<F: Copy + fn(vec3) -> vec3>(
        self,
        over: Box3,
        at: F,
        to: MapBox,
        live: Live,
        first: u32,
    ) -> SlopeBox {
        slope_of_form(
            affine_form(|q: vec3| self.masked(at(q), live, first), over),
            interval(|q: vec3| self.masked(at(q), live, first), over),
        )
    }

    /// `slope_box` of `distance_live(p, live)` over `over`, as an affine form over the box
    /// (`slope_to_affine`): what the engine's certificates read, for every kind.
    fn slope_affine(self, over: Box3, live: Live) -> Affine3 {
        slope_to_affine(self.slope_box(over, |q: vec3| q, MapBox::of(over), live, 0))
    }

    /// A rigid similarity transform `(R * s, t)` mapping this surface's local frame into world
    /// space when the surface is built from outer rigid `translate` / `rotate` / `scale` warps.
    /// Defaults to the identity transform.
    fn rigid_frame(self) -> Rigid {
        Rigid::identity()
    }

    /// A hash of this surface's geometry in its local frame (independent of outer rigid warps),
    /// or `None` when the surface cannot be factored into a local shape plus `rigid_frame()`.
    fn rigid_shape_hash(self) -> Option<u64> {
        None
    }

    /// Skinning template identity: `Some(hash)` when this surface is a `Skinned` rest-pose field
    /// (possibly wrapped in outer `Translate`/`Rotate`/`Scale`/`With`), `None` otherwise.
    fn skin_shape_hash(self) -> Option<u64> {
        None
    }

    /// Evaluates the rest-pose local distance at `p` (before skeletal deformation and outer rigid
    /// transforms). Used once when extracting a skinned surface's reusable rest-pose meshlet.
    fn rest_distance_live(self, p: vec3, live: Live) -> f32 {
        self.distance_live(p, live)
    }

    /// Interval-prunes the rest-pose local field over `over`.
    fn rest_pruned<F: Copy + fn(vec3) -> vec3>(
        self,
        over: Box3,
        at: F,
        stretch: f32,
        live: Live,
        first: u32,
    ) -> Pruned {
        self.pruned(over, at, stretch, live, first)
    }

    /// Bounding sphere of the rest-pose local field.
    fn rest_bound(self) -> Bound {
        self.bound()
    }

    /// Tight interval of the rest-pose local field over `b`.
    fn rest_interval_near(self, b: Box3) -> Interval {
        self.interval_near(b)
    }

    /// Auto-computed packed 4-bone indices (`x`) and 4 normalized 8-bit weights (`y`, summing to
    /// 255) at rest-pose local point `p`, derived from per-part signed distances.
    fn rest_skin_weights(self, p: vec3) -> vec2u {
        vec2u(0, 255)
    }

    /// Number of active bones in this surface's skinning palette (`0` when not skinned).
    fn skin_bone_count(self) -> u32 {
        0
    }

    /// Bone `i`'s current Dual Quaternion transform in the rest-pose field's local space.
    fn skin_bone(self, i: u32) -> DualQuat {
        DualQuat::identity()
    }

    /// Evaluates the exact posed field's distance in local space (before outer rigid warps) for
    /// exact analytical Newton projection of GPU-skinned hero vertices.
    fn posed_local_distance(self, p: vec3) -> f32 {
        self.distance(p)
    }

    /// Optional world-space dirty box modified since the previous edit epoch (e.g. a CSG cut),
    /// enabling persistent brick caches to re-extract only the affected bricks.
    fn dirty_region(self) -> Option<Box3> {
        None
    }

    /// Optional stable identity of the underlying base geometry before incremental edits, paired
    /// with `dirty_region()` to detect in-place incremental updates.
    fn edit_base_hash(self) -> Option<u64> {
        None
    }
}

/// Maximum bones supported in a single `Skinned` field's GPU Dual Quaternion palette.
pub const MAX_SKIN_BONES: u32 = 24

/// Maximum leaf parts mapped in `Skinned::part_bones` (packed 4 × u8 per `u32`).
pub const MAX_SKIN_PARTS: u32 = 32

/// Unit Dual Quaternion representing a 3D rigid transform `(q: Quat, t: vec3)` in 32 bytes
/// (Kavan et al., I3D 2007 / ACM TOG 2008): `real` is unit rotation quaternion `(qx, qy, qz, qw)`
/// and `dual = 0.5 * (tx, ty, tz, 0) * real`.
pub struct DualQuat: Copy + GpuData + Eq + StateHash {
    pub real: vec4,
    pub dual: vec4,
}

impl DualQuat {
    /// Identity rigid transform (no rotation, zero translation).
    pub fn identity() -> DualQuat {
        DualQuat { real: vec4(0.0, 0.0, 0.0, 1.0), dual: vec4(0.0) }
    }

    /// Builds a unit dual quaternion from unit rotation `q` and translation `t`.
    pub fn from_qt(q: Quat, t: vec3) -> DualQuat {
        let r = q.v
        let d = vec4(
            0.5 * (t.x * r.w + t.y * r.z - t.z * r.y),
            0.5 * (-t.x * r.z + t.y * r.w + t.z * r.x),
            0.5 * (t.x * r.y - t.y * r.x + t.z * r.w),
            -0.5 * (t.x * r.x + t.y * r.y + t.z * r.z),
        )
        DualQuat { real: r, dual: d }
    }

    /// Extracts a unit dual quaternion from a rigid 4×4 matrix `m` (with translation scaled by `s`,
    /// matching uniform skeleton scale `p_posed * s = R * (p_rest * s) + t * s`).
    pub fn from_mat4_scaled(m: mat4, s: f32) -> DualQuat {
        let q = Quat::from_mat3(mat3(m[0].xyz, m[1].xyz, m[2].xyz))
        DualQuat::from_qt(q, m[3].xyz * s)
    }

    /// Extracts a unit dual quaternion from a rigid 4×4 matrix `m`.
    pub fn from_mat4(m: mat4) -> DualQuat {
        DualQuat::from_mat4_scaled(m, 1.0)
    }

    /// Normalizes a blended dual quaternion by `1 / |real|`.
    pub fn normalized(self) -> DualQuat {
        let l2 = dot(self.real, self.real)
        let inv = if l2 > 1.0e-12 { 1.0 / sqrt(l2) } else { 1.0 }
        DualQuat { real: self.real * inv, dual: self.dual * inv }
    }

    /// Applies this unit dual quaternion's rigid transform to point `p`.
    pub fn apply_point(self, p: vec3) -> vec3 {
        let r = self.real
        let d = self.dual
        let t = 2.0 * (r.w * d.xyz - d.w * r.xyz + cross(r.xyz, d.xyz))
        let uv = 2.0 * cross(r.xyz, p)
        p + r.w * uv + cross(r.xyz, uv) + t
    }

    /// Rotates unit normal `n` by this unit dual quaternion's rotation part.
    pub fn apply_normal(self, n: vec3) -> vec3 {
        let r = self.real
        let uv = 2.0 * cross(r.xyz, n)
        let out = n + r.w * uv + cross(r.xyz, uv)
        let l2 = dot(out, out)
        if l2 > 1.0e-12 { out * (1.0 / sqrt(l2)) } else { n }
    }
}

/// Packs up to 32 per-part bone indices (`0..23`) into 8 `u32` words (4 × u8 per word).
pub fn pack_part_bones(bones: [u32; MAX_SKIN_PARTS]) -> [u32; 8] {
    var out = [0; 8]
    for w in 0..8 {
        let i = w * 4
        out[w] = (bones[i] & 255) |
            ((bones[i + 1] & 255) << 8) |
            ((bones[i + 2] & 255) << 16) |
            ((bones[i + 3] & 255) << 24)
    }
    out
}

/// Unpacks part `i`'s bone index from `packed`.
fn unpack_part_bone(packed: [u32; 8], i: u32) -> u32 {
    let idx = min(i, MAX_SKIN_PARTS - 1)
    let word = packed[idx >> 2]
    (word >> ((idx & 3) * 8)) & 255
}

/// Accumulates weight `w` for bone `bone` into a register-allocated top-4 `(b0..b3, w0..w3)` set.
struct Top4Weights: Copy {
    b0: u32,
    b1: u32,
    b2: u32,
    b3: u32,
    w0: f32,
    w1: f32,
    w2: f32,
    w3: f32,
}

impl Top4Weights {
    fn empty() -> Top4Weights {
        Top4Weights { b0: 0, b1: 0, b2: 0, b3: 0, w0: 0.0, w1: 0.0, w2: 0.0, w3: 0.0 }
    }

    fn add(mut self, bone: u32, w: f32) {
        if w <= 1.0e-6 {
            return
        }
        if self.w0 > 0.0 && self.b0 == bone {
            self.w0 += w
            return
        }
        if self.w1 > 0.0 && self.b1 == bone {
            self.w1 += w
            return
        }
        if self.w2 > 0.0 && self.b2 == bone {
            self.w2 += w
            return
        }
        if self.w3 > 0.0 && self.b3 == bone {
            self.w3 += w
            return
        }
        if self.w0 <= self.w1 && self.w0 <= self.w2 && self.w0 <= self.w3 {
            if w > self.w0 {
                self.b0 = bone
                self.w0 = w
            }
        } else if self.w1 <= self.w2 && self.w1 <= self.w3 {
            if w > self.w1 {
                self.b1 = bone
                self.w1 = w
            }
        } else if self.w2 <= self.w3 {
            if w > self.w2 {
                self.b2 = bone
                self.w2 = w
            }
        } else if w > self.w3 {
            self.b3 = bone
            self.w3 = w
        }
    }

    /// Normalizes and packs the top 4 bones into `(bones_u32, weights_u32)` with weights summing
    /// to 255 and the strongest bone in slot 0 (antipodal anchor for Dual Quaternion Skinning).
    fn pack(self) -> vec2u {
        var b0 = self.b0
        var b1 = self.b1
        var b2 = self.b2
        var b3 = self.b3
        var w0 = self.w0
        var w1 = self.w1
        var w2 = self.w2
        var w3 = self.w3
        // Place the largest weight in slot 0 so DQS antipodal sign alignment uses the dominant bone.
        if w1 > w0 {
            let tb = b0
            let tw = w0
            b0 = b1
            w0 = w1
            b1 = tb
            w1 = tw
        }
        if w2 > w0 {
            let tb = b0
            let tw = w0
            b0 = b2
            w0 = w2
            b2 = tb
            w2 = tw
        }
        if w3 > w0 {
            let tb = b0
            let tw = w0
            b0 = b3
            w0 = w3
            b3 = tb
            w3 = tw
        }
        let sum = w0 + w1 + w2 + w3
        if sum <= 1.0e-7 {
            return vec2u(b0 & 255, 255)
        }
        let inv = 255.0 / sum
        let q1 = u32(clamp(w1 * inv + 0.5, 0.0, 255.0))
        let q2 = u32(clamp(w2 * inv + 0.5, 0.0, 255.0))
        let q3 = u32(clamp(w3 * inv + 0.5, 0.0, 255.0))
        let rem = q1 + q2 + q3
        var q0: u32 = if rem < 255 { 255 - rem } else { 0 }
        var a1 = q1
        var a2 = q2
        var a3 = q3
        if rem > 255 {
            let over = rem - 255
            let d3 = min(a3, over)
            a3 -= d3
            let o2 = over - d3
            let d2 = min(a2, o2)
            a2 -= d2
            let o1 = o2 - d2
            a1 = if a1 > o1 { a1 - o1 } else { 0 }
            q0 = 255 - (a1 + a2 + a3)
        }
        let bones_u = (b0 & 255) | ((b1 & 255) << 8) | ((b2 & 255) << 16) | ((b3 & 255) << 24)
        let weights_u = (q0 & 255) | ((a1 & 255) << 8) | ((a2 & 255) << 16) | ((a3 & 255) << 24)
        vec2u(bones_u, weights_u)
    }
}

/// A skeletal/articulated pure field: `posed` gives the exact analytical distance and channels for
/// reference raymarching, probes, and SDF splatting, while `rest` + `bones` (`[DualQuat; 24]`) let
/// the engine extract the rest-pose meshlet ONCE with auto-computed per-vertex skin weights from
/// `rest.part_distance` and deform it every frame on the GPU via Dual Quaternion Skinning.
pub struct Skinned<S>: Copy + GpuData + Eq + StateHash {
    pub posed: S,
    pub rest: S,
    pub bones: [DualQuat; MAX_SKIN_BONES],
    pub joints: [vec4; MAX_SKIN_BONES],
    pub bone_count: u32,
    pub part_bones: [u32; 8],
    pub part_end_bones: [u32; 8],
    pub blend_k: f32,
    pub rest_key_lo: u32,
    pub rest_key_hi: u32,
    pub pad0: u32,
    pub pad1: u32,
}

/// Wraps an articulated pure field `posed` with its rest-pose template `rest`, per-bone Dual
/// Quaternions `bones`, rest-pose joint positions `joints`, per-part start/end bone mappings, and
/// smooth-union blend width `blend_k` for automatic GPU Dual Quaternion Skinning.
pub fn skinned<S: Surface + StateHash>(
    posed: S,
    rest: S,
    bones: [DualQuat; MAX_SKIN_BONES],
    joints: [vec4; MAX_SKIN_BONES],
    bone_count: u32,
    part_bones: [u32; 8],
    part_end_bones: [u32; 8],
    blend_k: f32,
) -> Skinned<S> {
    var h = Hasher::new()
    StateHash::state_hash(rest, mut h)
    StateHash::state_hash(bone_count, mut h)
    StateHash::state_hash(part_bones, mut h)
    StateHash::state_hash(part_end_bones, mut h)
    StateHash::state_hash(blend_k, mut h)
    // The joints split a two-bone part's weights (`rest_skin_weights`), which the template keeps.
    StateHash::state_hash(joints, mut h)
    let key = h.finish()
    Skinned {
        posed,
        rest,
        bones,
        joints,
        bone_count: min(bone_count, MAX_SKIN_BONES),
        part_bones,
        part_end_bones,
        blend_k,
        rest_key_lo: u32(key),
        rest_key_hi: u32(key >> 32),
        pad0: 0,
        pad1: 0,
    }
}

impl<S: Surface> Surface for Skinned<S> {
    const MAY_SKIN: bool = true

    fn distance(self, p: vec3) -> f32 {
        self.posed.distance(p)
    }

    fn masked(self, p: vec3, live: Live, first: u32) -> f32 {
        self.posed.masked(p, live, first)
    }

    /// Its posed body's.
    fn slope_box<F: Copy + fn(vec3) -> vec3>(
        self,
        over: Box3,
        at: F,
        to: MapBox,
        live: Live,
        first: u32,
    ) -> SlopeBox {
        self.posed.slope_box(over, at, to, live, first)
    }

    fn pruned<F: Copy + fn(vec3) -> vec3>(
        self,
        over: Box3,
        at: F,
        stretch: f32,
        live: Live,
        first: u32,
    ) -> Pruned {
        self.posed.pruned(over, at, stretch, live, first)
    }

    fn bound(self) -> Bound {
        self.posed.bound()
    }

    fn filtered(self, p: vec3, footprint: f32) -> f32 {
        self.posed.filtered(p, footprint)
    }

    fn part_offset(self, p: vec3, i: u32, by: f32) -> f32 {
        self.posed.part_offset(p, i, by)
    }

    fn parts(self) -> u32 {
        self.posed.parts()
    }

    fn part_at(self, p: vec3) -> (f32, u32) {
        self.posed.part_at(p)
    }

    fn part_distance(self, p: vec3, i: u32) -> f32 {
        self.posed.part_distance(p, i)
    }

    fn part_name(self, i: u32) -> PartName {
        self.posed.part_name(i)
    }

    fn lipschitz(self, near: f32) -> f32 {
        self.posed.lipschitz(near)
    }

    fn interval_near(self, b: Box3) -> Interval {
        self.posed.interval_near(b)
    }

    fn skin_shape_hash(self) -> Option<u64> {
        Some((u64(self.rest_key_hi) << 32) | u64(self.rest_key_lo))
    }

    fn rest_distance_live(self, p: vec3, live: Live) -> f32 {
        self.rest.distance_live(p, live)
    }

    fn rest_pruned<F: Copy + fn(vec3) -> vec3>(
        self,
        over: Box3,
        at: F,
        stretch: f32,
        live: Live,
        first: u32,
    ) -> Pruned {
        self.rest.pruned(over, at, stretch, live, first)
    }

    fn rest_bound(self) -> Bound {
        self.rest.bound()
    }

    fn rest_interval_near(self, b: Box3) -> Interval {
        self.rest.interval_near(b)
    }

    fn rest_skin_weights(self, p: vec3) -> vec2u {
        let n_parts = min(self.rest.parts(), MAX_SKIN_PARTS)
        if n_parts == 0 || self.bone_count == 0 {
            return vec2u(0, 255)
        }
        var d_min = 1.0e20
        var best_part: u32 = 0
        for i in 0..n_parts {
            let d = self.rest.part_distance(p, i)
            if d < d_min {
                d_min = d
                best_part = i
            }
        }
        let blend_w = max(self.blend_k * 1.5, 0.008)
        var top = Top4Weights::empty()
        for i in 0..n_parts {
            let d = self.rest.part_distance(p, i)
            let gap = max(d - d_min, 0.0)
            if gap < blend_w {
                let u = 1.0 - gap / blend_w
                let pw = u * u
                let ba = min(unpack_part_bone(self.part_bones, i), self.bone_count - 1)
                let bb = min(unpack_part_bone(self.part_end_bones, i), self.bone_count - 1)
                if ba == bb {
                    top.add(ba, pw)
                } else {
                    let ja = self.joints[ba].xyz
                    let jb = self.joints[bb].xyz
                    let seg = jb - ja
                    let l2 = max(dot(seg, seg), 1.0e-8)
                    let frac = clamp(dot(p - ja, seg) / l2, 0.0, 1.0)
                    top.add(ba, pw * (1.0 - frac))
                    top.add(bb, pw * frac)
                }
            }
        }
        if top.w0 <= 1.0e-6 {
            let ba = min(unpack_part_bone(self.part_bones, best_part), self.bone_count - 1)
            return vec2u(ba & 255, 255)
        }
        top.pack()
    }

    fn skin_bone_count(self) -> u32 {
        self.bone_count
    }

    fn skin_bone(self, i: u32) -> DualQuat {
        self.bones[min(i, MAX_SKIN_BONES - 1)]
    }

    /// Its posed body's distance, each part asked only where it can matter (`distance_within`
    /// with nothing asked of it beyond: bit for bit `distance`).
    fn posed_local_distance(self, p: vec3) -> f32 {
        self.posed.distance_within(p, EMPTY)
    }
}

impl<C, S: Field<C>> Field<C> for Skinned<S> {
    fn channels(self, p: vec3) -> C {
        self.posed.channels(p)
    }

    fn distance_and_channels(self, p: vec3) -> (f32, C) {
        self.posed.distance_and_channels(p)
    }

    fn has_constant_channels(self) -> bool {
        self.posed.has_constant_channels()
    }

    fn has_local_channels(self) -> bool {
        self.posed.has_local_channels()
    }

    fn rest_channels(self, p: vec3) -> C {
        self.rest.channels(p)
    }

    fn field_facts(self) -> FieldFacts {
        self.posed.field_facts()
    }
}

/// A 3D rigid similarity transform (`world(p) = s * R * p + t`, `s > 0`, `R` orthonormal) stored
/// as three `vec4` rows of the affine matrix plus `meta = (s, active_flag, 0, 0)` so vertex and
/// compute shaders apply points and normals with 3 dot products.
pub struct Rigid: Copy + GpuData + Eq + StateHash {
    pub row0: vec4,
    pub row1: vec4,
    pub row2: vec4,
    pub meta: vec4,
}

impl Rigid {
    /// Identity transform (`active = 0.0`, indicating no outer rigid warp).
    pub fn identity() -> Rigid {
        Rigid {
            row0: vec4(1.0, 0.0, 0.0, 0.0),
            row1: vec4(0.0, 1.0, 0.0, 0.0),
            row2: vec4(0.0, 0.0, 1.0, 0.0),
            meta: vec4(1.0, 0.0, 0.0, 0.0),
        }
    }

    /// Pure translation `world(p) = p + by`.
    pub fn translation(by: vec3) -> Rigid {
        Rigid {
            row0: vec4(1.0, 0.0, 0.0, by.x),
            row1: vec4(0.0, 1.0, 0.0, by.y),
            row2: vec4(0.0, 0.0, 1.0, by.z),
            meta: vec4(1.0, 1.0, 0.0, 0.0),
        }
    }

    /// Pure rotation from `Turn::to_local` (`local(p) = to_local * p`, so `world(q) = to_local^T * q`,
    /// whose rows are the columns of `to_local`).
    pub fn rotation(to_local: mat3) -> Rigid {
        Rigid {
            row0: vec4(to_local[0], 0.0),
            row1: vec4(to_local[1], 0.0),
            row2: vec4(to_local[2], 0.0),
            meta: vec4(1.0, 1.0, 0.0, 0.0),
        }
    }

    /// Pure positive uniform scale `world(p) = s * p`.
    pub fn uniform_scale(s: f32) -> Rigid {
        Rigid {
            row0: vec4(s, 0.0, 0.0, 0.0),
            row1: vec4(0.0, s, 0.0, 0.0),
            row2: vec4(0.0, 0.0, s, 0.0),
            meta: vec4(s, 1.0, 0.0, 0.0),
        }
    }

    /// Whether this transform came from at least one rigid warp (`translate`, `rotate`, `scale`).
    pub fn is_rigid(self) -> bool {
        self.meta.y > 0.5
    }

    /// Positive uniform scale factor.
    pub fn scale_factor(self) -> f32 {
        self.meta.x
    }

    /// Maps local point `p` to world space (`M * p + t`).
    pub fn apply_point(self, p: vec3) -> vec3 {
        vec3(
            dot(self.row0.xyz, p) + self.row0.w,
            dot(self.row1.xyz, p) + self.row1.w,
            dot(self.row2.xyz, p) + self.row2.w,
        )
    }

    /// Maps local unit normal `n` to world space (uniform positive scale preserves normal direction).
    pub fn apply_normal(self, n: vec3) -> vec3 {
        let v = vec3(
            dot(self.row0.xyz, n),
            dot(self.row1.xyz, n),
            dot(self.row2.xyz, n),
        )
        let l2 = dot(v, v)
        if l2 > 1.0e-12 { v * (1.0 / sqrt(l2)) } else { n }
    }

    /// Composes `self(inner(p))`.
    pub fn compose(self, inner: Rigid) -> Rigid {
        let c0 = vec3(inner.row0.x, inner.row1.x, inner.row2.x)
        let c1 = vec3(inner.row0.y, inner.row1.y, inner.row2.y)
        let c2 = vec3(inner.row0.z, inner.row1.z, inner.row2.z)
        let t = vec3(inner.row0.w, inner.row1.w, inner.row2.w)
        let nt = self.apply_point(t)
        Rigid {
            row0: vec4(
                dot(self.row0.xyz, c0),
                dot(self.row0.xyz, c1),
                dot(self.row0.xyz, c2),
                nt.x,
            ),
            row1: vec4(
                dot(self.row1.xyz, c0),
                dot(self.row1.xyz, c1),
                dot(self.row1.xyz, c2),
                nt.y,
            ),
            row2: vec4(
                dot(self.row2.xyz, c0),
                dot(self.row2.xyz, c1),
                dot(self.row2.xyz, c2),
                nt.z,
            ),
            meta: vec4(self.meta.x * inner.meta.x, max(self.meta.y, inner.meta.y), 0.0, 0.0),
        }
    }

    /// Exact inverse of `self` (`M^{-1} = (1 / s²) * M^T`, `t^{-1} = -M^{-1} * t`).
    pub fn inverse(self) -> Rigid {
        let s = max(self.meta.x, 1.0e-6)
        let inv_s2 = 1.0 / (s * s)
        let r0 = vec3(self.row0.x, self.row1.x, self.row2.x) * inv_s2
        let r1 = vec3(self.row0.y, self.row1.y, self.row2.y) * inv_s2
        let r2 = vec3(self.row0.z, self.row1.z, self.row2.z) * inv_s2
        let t = vec3(self.row0.w, self.row1.w, self.row2.w)
        Rigid {
            row0: vec4(r0, -dot(r0, t)),
            row1: vec4(r1, -dot(r1, t)),
            row2: vec4(r2, -dot(r2, t)),
            meta: vec4(1.0 / s, self.meta.y, 0.0, 0.0),
        }
    }

    /// Delta transform mapping vertices extracted at pose `extracted` into this pose (`self * inv(extracted)`).
    pub fn delta_from(self, extracted: Rigid) -> Rigid {
        self.compose(extracted.inverse())
    }
}

/// Combines two child surfaces' local shape hashes (and their internal relative transforms) with
/// an operator tag `tag` and blend width `k`.
fn pair_shape_hash<A: Surface, B: Surface>(tag: u32, a: A, b: B, k: f32) -> Option<u64> {
    match a.rigid_shape_hash() {
        Some(ha) => match b.rigid_shape_hash() {
            Some(hb) => {
                var h = Hasher::new()
                std::hash::StateHash::state_hash(tag, mut h)
                std::hash::StateHash::state_hash(ha, mut h)
                std::hash::StateHash::state_hash(a.rigid_frame(), mut h)
                std::hash::StateHash::state_hash(hb, mut h)
                std::hash::StateHash::state_hash(b.rigid_frame(), mut h)
                std::hash::StateHash::state_hash(k, mut h)
                Some(h.finish())
            },
            None => None,
        },
        None => None,
    }
}

/// The most a fold of `n` smooth unions of width `k` (`[..].smooth_union(k)`) lowers the least
/// of its parts' distances: one `smin` lowers it by at most `k / 4`, and each part folded after
/// lowers it again, the most where the distances are equal: L(1) = 0, L(i + 1) = L(i) +
/// (k - L(i))^2 / 4k, which rises to `k` (L(17) = 0.817 k). (By induction: the fold so far at
/// least its parts' least `m` less L, the next part `x`, `smin` lowers `min` by (k - |F - x|)^2 /
/// 4k; with `x` above the fold by `u` at most L, `min(m, x)` less the result is at most
/// u + (k - u)^2 / 4k, which rises with `u` to L(i + 1); any other `x` lowers it less. Equal
/// distances reach it, so a fold of equal parts is grown by exactly this.) It is `k` times
/// the same of `k = 1` (the recursion scales with `k`): a table the build computes, read at `n`
/// (past 128 parts, `k`, which bounds every fold), so no code a shader runs loops for it.
fn fold_lowering(n: u32, k: f32) -> f32 {
    k * (if n > 128 { 1.0 } else { FOLD_LOWERING[n] })
}

/// `fold_lowering` of `k = 1` for 0 to 128 parts.
const FOLD_LOWERING: [f32; 129] = fold_lowerings()

fn fold_lowerings() -> [f32; 129] {
    var out = [0.0; 129]
    var x = 0.0
    for i in 2..129 {
        x += 0.25 * (1.0 - x) * (1.0 - x)
        out[i] = x
    }
    out
}

/// Which parts of a surface an ask evaluates (`Surface::live`, `distance_live`): bit `i % 32` of
/// `words[i / 32]` for part `i`, in §23's numbering (the order a surface's leaves are written).
/// A part past the 128th is always asked.
pub struct Live: Copy + GpuData + Plain + Eq + StateHash {
    pub words: vec4u,
}

/// Every part asked.
pub const ALL_LIVE: Live = Live { words: vec4u(4294967295) }

impl Live {
    /// The parts a word names: bit `i` for part `i` of the first 32, and every part past them.
    pub fn from_word(w: u32) -> Live {
        Live { words: vec4u(w, 4294967295, 4294967295, 4294967295) }
    }

    /// The first 32 parts' bits, as `from_word` takes them.
    pub fn word(self) -> u32 {
        self.words.x
    }

    /// Whether part `i` is asked: a shift and an and of one word. Of the first 32 parts, the
    /// first word, read alone; past them, the word chosen by selects (no index into the four,
    /// which keeps them in memory where `i` isn't a constant).
    pub fn has(self, i: u32) -> bool {
        let w = if i < 32 { self.words.x } else { self.word_at(i >> 5) }
        i >= 128 || ((w >> (i & 31)) & 1) != 0
    }

    /// Word `w` of the four (0 to 3), chosen by selects.
    fn word_at(self, w: u32) -> u32 {
        let v = self.words
        select(
            if_false: select(if_false: v.x, if_true: v.y, cond: w == 1),
            if_true: select(if_false: v.z, if_true: v.w, cond: w == 3),
            cond: w >= 2,
        )
    }

    /// Whether any of the `count` parts from `first` on is asked: one part's bit, or each word
    /// and'ed with the span's bits in it (constants, where the span is).
    pub fn any(self, first: u32, count: u32) -> bool {
        if count == 1 {
            self.has(first)
        } else if first + count > 128 {
            count > 0
        } else {
            (self.words & spans(first, count)) != vec4u(0)
        }
    }

    /// The same, with the `count` parts from `first` on left out.
    pub fn without(self, first: u32, count: u32) -> Live {
        Live { words: self.words & (vec4u(4294967295) ^ spans(first, count)) }
    }

    /// The same, with the `count` parts from `first` on, all in one word of the mask (`(first &
    /// 31) + count <= 32`, `first < 128`), asked as `bits` says: its bit `i` for part `first +
    /// i`, as `leaf_bits` gives them. What a join of single parts writes its pruning back with:
    /// it clears a bit a part in its own loop, and builds the word's mask once.
    fn with_leaf_bits(self, first: u32, count: u32, bits: u32) -> Live {
        let ones = if count >= 32 { 4294967295 } else { (u32(1) << count) - 1 }
        let at = first & 31
        let keep = 4294967295 ^ (ones << at)
        let put = (bits & ones) << at
        let w = first >> 5
        let v = self.words
        Live { words: vec4u(
            if w == 0 { (v.x & keep) | put } else { v.x },
            if w == 1 { (v.y & keep) | put } else { v.y },
            if w == 2 { (v.z & keep) | put } else { v.z },
            if w == 3 { (v.w & keep) | put } else { v.w },
        ) }
    }

    /// How many of the first `parts` parts are asked.
    pub fn count(self, parts: u32) -> u32 {
        let w = self.words & spans(0, min(parts, 128))
        max(parts, 128) -
            128 +
            w.x.count_ones() +
            w.y.count_ones() +
            w.z.count_ones() +
            w.w.count_ones()
    }
}

/// The bits of each word that parts `first..first + count` take (of the first 128).
fn spans(first: u32, count: u32) -> vec4u {
    vec4u(
        span_bits(first, count, 0),
        span_bits(first, count, 1),
        span_bits(first, count, 2),
        span_bits(first, count, 3),
    )
}

/// The live bits among parts `first..first + count`, one word's (the span within it), shifted so
/// bit `i` is part `first + i`: a masked array of single parts walks these, clearing the lowest
/// each pass, so it asks only its live parts.
fn leaf_bits(live: Live, first: u32, count: u32) -> u32 {
    let w = if first < 32 { live.words.x } else { live.word_at(first >> 5) }
    let ones = if count >= 32 { 4294967295 } else { (u32(1) << count) - 1 }
    (w >> (first & 31)) & ones
}

/// The bits of word `w` (parts `32 w` to `32 w + 31`) that parts `first..first + count` take.
fn span_bits(first: u32, count: u32, w: u32) -> u32 {
    let lo = max(first, 32 * w)
    let hi = min(first + count, 32 * w + 32)
    let n = if hi > lo { hi - lo } else { 0 }
    let ones = if n >= 32 { 4294967295 } else { (u32(1) << n) - 1 }
    if n == 0 { 0 } else { ones << (lo - 32 * w) }
}

/// What `Surface::pruned` gives: the parts still live, and the surface's range over the box.
pub struct Pruned: Copy + GpuData {
    pub live: Live,
    pub range: Interval,
}

/// One f32 ulp at 1 (`2^-23`): what a `SlopeBox`'s bounds are rounded outward by, a part of
/// their size.
pub const SLOPE_EPS: f32 = 1.0 / 8388608.0
/// About the least positive normal f32: what a `SlopeBox`'s bounds are rounded outward by where
/// they are near nothing.
pub const SLOPE_TINY: f32 = 1.2e-38

/// A `SlopeBox`'s `e` where there is no bound: past what an affine form may hold
/// (`Affine3::valid`), so the form made of it says so.
pub const SLOPE_UNBOUNDED: f32 = 1.0e20

/// A first-order enclosure of a function `f` over a box `over`, in the box's own coordinates, as
/// `std::derive::affine_form` gives one, with a radius on each slope beside: with `(c_b, h, d) =
/// form_box(over)`, for every `q` of `over` and every `u` in `[-1, 1]^3` with `|q - (c_b + h u)|
/// <= d`, as the target computes `f(q)`,
///   1. `range.lo <= f(q) <= range.hi`
///   2. `|f(q) - (c + dot(l, u))| <= dot(r, abs(u)) + e`
/// With `r` 0 it is an affine form (`slope_to_affine`), and the compiler's own form of `f` is one
/// bit for bit (`slope_of_form`). It states an enclosure, nothing of `f`'s derivative: `c` need
/// not be `f` at the centre (it is within `e` of it), and `l` need not be a gradient. So what
/// composes two of them may use only that `f` lies between the two planes of (2), as
/// `slope_smin` does.
pub struct SlopeBox: Copy + GpuData {
    pub c: f32,
    pub l: vec3,
    pub r: vec3,
    pub e: f32,
    pub range: Interval,
}

/// An enclosure of a function stated in a surface's own space, a metre a unit: about a point
/// `at`, for every `x` within `rad` of it on each axis (the caller's `at` and `rad`),
///   1. `range.lo <= f(x) <= range.hi`
///   2. `|f(x) - (d_at + dot(g_mid, x - at))| <= dot(g_rad, abs(x - at)) + err`
/// What a surface that knows its own shape states; `MapBox::out` makes it the asker's
/// (`SlopeBox`).
pub struct Slope3: Copy + GpuData {
    pub d_at: f32,
    pub g_mid: vec3,
    pub g_rad: vec3,
    pub err: f32,
    pub range: Interval,
}

/// The box an affine form over `over` is taken over (`ir::derive::affine`'s `input_box`): its
/// centre `c`, its half-widths `h` and `delta`, with every `p` of `over` at `c + h * u + d` for
/// some `u` in `[-1, 1]^3` and `|d| <= delta`.
pub fn form_box(over: Box3) -> (vec3, vec3, vec3) {
    let hl = 0.5 * over.lo
    let hh = 0.5 * over.hi
    let c = hl + hh
    let h = (hh - hl) * (1.0 + 2.0 * SLOPE_EPS)
    let delta = abs(c) * (2.0 * SLOPE_EPS) + vec3(2.0 * SLOPE_TINY)
    (c, h, delta)
}

/// The enclosure of a function over a box that its affine form `af` there
/// (`std::derive::affine_form`) and its interval `x` there (`std::derive::interval`) are: the
/// form, bit for bit, its range the form's within the interval's. A form with no bound
/// (`!af.valid()`) leaves the interval alone.
pub fn slope_of_form(af: Affine3, x: Interval) -> SlopeBox {
    if !af.valid() {
        return SlopeBox { c: 0.0, l: vec3(0.0), r: vec3(0.0), e: SLOPE_UNBOUNDED, range: x }
    }
    SlopeBox {
        c: af.c,
        l: af.l,
        r: vec3(0.0),
        e: af.e,
        range: Interval { lo: max(af.lo(), x.lo), hi: min(af.hi(), x.hi) },
    }
}

/// How the points of a box reach a surface's own space through the maps of the combinators above
/// it (a move, a turn, a scale, a fold), to first order, in the box's own coordinates: what
/// `Surface::slope_box` hands down beside the maps themselves (`at`), so a leaf that states its
/// own enclosure knows the box it is asked over in its own space (`rad`) and how its slopes
/// there are the asker's (`out`).
///
/// With `(c_b, h, d) = form_box(over)`: for every `q` of the asker's box and every `u` in `[-1,
/// 1]^3` with `|q - (c_b + h u)| <= d`, the own-space point `x` the maps take `q` to, as the
/// target computes it, has on each axis `i`
///   `|x_i - at_i - dot(j_i, u)| <= dot(r_i, abs(u)) + e_i`
/// (`j_i` and `r_i` the rows `jx`, `jy`, `jz` and `rx`, `ry`, `rz`). `at` is the centre's own
/// image as the maps compute it.
pub struct MapBox: Copy + GpuData {
    pub at: vec3,
    pub jx: vec3,
    pub jy: vec3,
    pub jz: vec3,
    pub rx: vec3,
    pub ry: vec3,
    pub rz: vec3,
    pub e: vec3,
}

/// `|v.x| + |v.y| + |v.z|`.
fn sum_abs(v: vec3) -> f32 {
    abs(v.x) + abs(v.y) + abs(v.z)
}

impl MapBox {
    /// A box asked in the asker's own space (no map above): `q = c_b + h u`, give or take `d`.
    pub fn of(over: Box3) -> MapBox {
        let (c, h, delta) = form_box(over)
        MapBox {
            at: c,
            jx: vec3(h.x, 0.0, 0.0),
            jy: vec3(0.0, h.y, 0.0),
            jz: vec3(0.0, 0.0, h.z),
            rx: vec3(0.0),
            ry: vec3(0.0),
            rz: vec3(0.0),
            e: delta,
        }
    }

    /// Half-widths about `at` that hold every own-space point of the box, rounded outward.
    pub fn rad(self) -> vec3 {
        let r = vec3(
            sum_abs(self.jx) + sum_abs(self.rx),
            sum_abs(self.jy) + sum_abs(self.ry),
            sum_abs(self.jz) + sum_abs(self.rz),
        ) +
            self.e
        r * (1.0 + 8.0 * SLOPE_EPS) + vec3(4.0 * SLOPE_TINY)
    }

    /// The own-space box `at ± rad()`.
    pub fn own(self) -> Box3 {
        let r = self.rad()
        Box3 { lo: self.at - r, hi: self.at + r }
    }

    /// An enclosure stated in own space (about `at`, over `own()`), as the asker's: with `x - at
    /// = J u + p`, `|p| <= R |u| + e`, its plane's slopes are `J^T g`, and what `p` and the
    /// radii allow is radius (`R^T |g| + (|J| + R)^T g_rad`) and error (`dot(|g| + g_rad, e)`).
    pub fn out(self, s: Slope3) -> SlopeBox {
        let ga = abs(s.g_mid)
        let l = self.jx * s.g_mid.x + self.jy * s.g_mid.y + self.jz * s.g_mid.z
        let (ax, ay, az) = (abs(self.jx), abs(self.jy), abs(self.jz))
        let turned = ax * ga.x + ay * ga.y + az * ga.z
        let r = self.rx * ga.x +
            self.ry * ga.y +
            self.rz * ga.z +
            (ax + self.rx) * s.g_rad.x +
            (ay + self.ry) * s.g_rad.y +
            (az + self.rz) * s.g_rad.z
        SlopeBox {
            c: s.d_at,
            l,
            r: r + (turned + r) * (8.0 * SLOPE_EPS) + vec3(4.0 * SLOPE_TINY),
            e: s.err + dot(ga + s.g_rad, self.e) * (1.0 + 8.0 * SLOPE_EPS) + 4.0 * SLOPE_TINY,
            range: s.range,
        }
    }

    /// Through a move: `x - by`, which is `at` at the centre (the map's own image of it).
    pub fn moved(self, by: vec3, at: vec3) -> MapBox {
        let size = abs(self.at) + abs(by) + self.rad()
        MapBox { at, e: self.e + size * (4.0 * SLOPE_EPS) + vec3(4.0 * SLOPE_TINY), ..self }
    }

    /// Through a linear map whose rows are `x`, `y` and `z` (`x'_i = dot(row_i, x)`: a turn),
    /// whose image of the centre is `at`.
    pub fn turned(self, x: vec3, y: vec3, z: vec3, at: vec3) -> MapBox {
        let own = abs(self.at) + self.rad()
        let (jx, rx, ex) = self.row(x, own)
        let (jy, ry, ey) = self.row(y, own)
        let (jz, rz, ez) = self.row(z, own)
        MapBox { at, jx, jy, jz, rx, ry, rz, e: vec3(ex, ey, ez) }
    }

    /// One row of `turned`: the slopes, the radii and the error of `dot(m, x)`.
    fn row(self, m: vec3, own: vec3) -> (vec3, vec3, f32) {
        let a = abs(m)
        let j = self.jx * m.x + self.jy * m.y + self.jz * m.z
        let big = abs(self.jx) * a.x + abs(self.jy) * a.y + abs(self.jz) * a.z
        let r = self.rx * a.x + self.ry * a.y + self.rz * a.z
        (
            j,
            r + (big + r) * (8.0 * SLOPE_EPS) + vec3(4.0 * SLOPE_TINY),
            dot(a, self.e) + dot(a, own) * (8.0 * SLOPE_EPS) + 4.0 * SLOPE_TINY,
        )
    }

    /// Through a division by `by` (a scale), whose image of the centre is `at`.
    pub fn scaled(self, by: f32, at: vec3) -> MapBox {
        let s = 1.0 / by
        let m = abs(s)
        let own = abs(self.at) + self.rad()
        let wide = 1.0 + 8.0 * SLOPE_EPS
        let tiny = vec3(4.0 * SLOPE_TINY)
        MapBox {
            at,
            jx: self.jx * s,
            jy: self.jy * s,
            jz: self.jz * s,
            rx: (self.rx * m + abs(self.jx) * (m * 8.0 * SLOPE_EPS)) * wide + tiny,
            ry: (self.ry * m + abs(self.jy) * (m * 8.0 * SLOPE_EPS)) * wide + tiny,
            rz: (self.rz * m + abs(self.jz) * (m * 8.0 * SLOPE_EPS)) * wide + tiny,
            e: (self.e * m + own * (m * 8.0 * SLOPE_EPS)) * wide + tiny,
        }
    }

    /// Through a fold across the planes `across` names (1 for each of x, y and z folded, else
    /// 0): `|x_i|` on a folded axis. Where the box is on the far side of the plane the axis's
    /// row is turned over; where it crosses, `| |x| - |at| | <= |x - at|`, so the row's whole
    /// size is radius.
    pub fn folded(self, across: vec3) -> MapBox {
        let rad = self.rad()
        let (jx, rx, ax) = fold_row(self.jx, self.rx, self.at.x, rad.x, across.x > 0.5)
        let (jy, ry, ay) = fold_row(self.jy, self.ry, self.at.y, rad.y, across.y > 0.5)
        let (jz, rz, az) = fold_row(self.jz, self.rz, self.at.z, rad.z, across.z > 0.5)
        MapBox { at: vec3(ax, ay, az), jx, jy, jz, rx, ry, rz, e: self.e }
    }
}

/// One axis of `MapBox::folded`: its row, its radii and its centre's image.
fn fold_row(j: vec3, r: vec3, at: f32, rad: f32, folded: bool) -> (vec3, vec3, f32) {
    if !folded {
        (j, r, at)
    } else if at - rad >= 0.0 {
        (j, r, abs(at))
    } else if at + rad <= 0.0 {
        (-j, r, abs(at))
    } else {
        (vec3(0.0), abs(j) + r, abs(at))
    }
}

/// The enclosure of a constant `c`.
pub fn slope_const(c: f32) -> SlopeBox {
    SlopeBox { c, l: vec3(0.0), r: vec3(0.0), e: 0.0, range: Interval { lo: c, hi: c } }
}

/// The enclosure of a surface no part of which is asked: `EMPTY`, a constant.
pub fn slope_empty() -> SlopeBox {
    slope_const(EMPTY)
}

/// A ball of a bound `l` on the gradient's length about `d_at`, the distance at `at`: no slopes,
/// and as error `l` times the half-diagonal of `rad` (own space, `Slope3`).
pub fn slope_lip(d_at: f32, l: f32, rad: vec3) -> Slope3 {
    let r = l * length(rad)
    let e = r * 1.0e-5 + abs(d_at) * 1.0e-6 + 1.0e-6
    let err = r + e
    Slope3 {
        d_at,
        g_mid: vec3(0.0),
        g_rad: vec3(0.0),
        err,
        range: Interval { lo: d_at - err, hi: d_at + err },
    }
}

/// A `Slope3` from its plane, radii and error, its range what they allow within `rad`, rounded
/// outward.
pub fn slope_from_g(d_at: f32, g_mid: vec3, g_rad: vec3, err: f32, rad: vec3) -> Slope3 {
    let span = dot(abs(g_mid) + g_rad, rad) + err
    let margin = (abs(d_at) + span) * (10.0 * SLOPE_EPS) + 4.0 * SLOPE_TINY
    Slope3 {
        d_at,
        g_mid,
        g_rad,
        err,
        range: Interval { lo: d_at - (span + margin), hi: d_at + (span + margin) },
    }
}

/// The most the plane of an enclosure and its width about it come to over the box: what a
/// rounding margin of a sum of its terms is a few ulps of.
fn slope_reach(a: SlopeBox) -> f32 {
    abs(a.c) + sum_abs(a.l) + sum_abs(a.r) + a.e
}

/// How thick the slab about an enclosure's own plane that holds the function's zeros is, in the
/// box's coordinates: its width over the length of its slopes (no slopes: no slab).
fn slope_thick(a: SlopeBox) -> f32 {
    (sum_abs(a.r) + a.e) / max(length(a.l), SLOPE_TINY)
}

/// The range (2) of an enclosure gives over the box, rounded outward.
fn slope_span(a: SlopeBox) -> Interval {
    let span = sum_abs(a.l) + sum_abs(a.r) + a.e
    let margin = (abs(a.c) + span) * (10.0 * SLOPE_EPS) + 4.0 * SLOPE_TINY
    Interval { lo: a.c - (span + margin), hi: a.c + (span + margin) }
}

/// An enclosure as the affine form the engine's certificates read (`c + dot(l, u) ± e` over `u`
/// in `[-1, 1]^3`, as `std::derive::affine_form` gives one): the same plane, its radii at the
/// box's corners as error (none: the same form, bit for bit). Where the enclosure's range shows
/// the box clear of 0 and the form doesn't, the form is the range (a constant), so nothing the
/// range proves is lost.
pub fn slope_to_affine(sb: SlopeBox) -> Affine3 {
    let rr = sum_abs(sb.r)
    let e = if rr > 0.0 { (sb.e + rr) * (1.0 + 4.0 * SLOPE_EPS) + SLOPE_TINY } else { sb.e }
    let af = Affine3 { c: sb.c, l: sb.l, e }
    if (sb.range.lo > 0.0 && af.lo() <= 0.0) || (sb.range.hi < 0.0 && af.hi() >= 0.0) {
        let rmid = 0.5 * (sb.range.lo + sb.range.hi)
        let rhalf = 0.5 * (sb.range.hi - sb.range.lo)
        let rmag = abs(rmid) + rhalf
        // A range with an end past what a form may hold (a part nowhere near, `EMPTY`) is clear
        // of 0 all the same: its near end, and nothing wider.
        if !(rmag <= 1.0e15) {
            let near = if sb.range.lo > 0.0 { sb.range.lo } else { sb.range.hi }
            return Affine3 { c: clamp(near, -1.0e12, 1.0e12), l: vec3(0.0), e: 0.0 }
        }
        return Affine3 {
            c: rmid,
            l: vec3(0.0),
            e: rhalf + rmag * (8.0 * SLOPE_EPS) + 4.0 * SLOPE_TINY,
        }
    }
    af
}

/// What `smin(a, b, k)` takes from the mean of `a` and `b`, twice over, as a function of `d = a
/// - b`: `smin(a, b, k) = (a + b) / 2 - seam(a - b, k) / 2`, with `seam(d, k) = |d| + max(k -
/// |d|, 0)^2 / 2k`, which is `(d^2 + k^2) / 2k` within `k` of 0 and `|d|` past it (`|d|` for `k
/// = 0`: `min`). It is convex, and its slope `clamp(d / k, -1, 1)` never past ±1.
fn seam(d: f32, k: f32) -> f32 {
    let x = abs(d)
    if x >= k { x } else { (x * x + k * k) * (0.5 / k) }
}

/// `seam(d, k)` over `d` in `[lo, hi]`, between two lines of one slope `t`: `(t, m, q)` with
/// `seam(d) = t d + s` and `s` within `q` of `m`, each halved twice (`smin` takes half of
/// `seam`, and `m` is the middle of two intercepts). The seam is convex, so over `[lo, hi]` it
/// lies under its chord and over any tangent: `t` is the chord's slope (`|t| <= 1`), the
/// tangent of that slope touches at `d = t k` and is `t d + k (1 - t^2) / 2`, and the chord is
/// at most `t d + max(seam(lo) - t lo, seam(hi) - t hi)`. Any `t` in `[-1, 1]` is sound (the
/// intercepts are taken for the `t` used), so its rounding costs tightness alone.
fn seam_lines(lo: f32, hi: f32, k: f32) -> (f32, f32, f32) {
    let f_lo = seam(lo, k)
    let f_hi = seam(hi, k)
    let t = if hi > lo {
        clamp((f_hi - f_lo) / (hi - lo), -1.0, 1.0)
    } else {
        clamp(lo / max(k, SLOPE_TINY), -1.0, 1.0)
    }
    let s_lo = 0.5 * k * (1.0 - t * t)
    let s_hi = max(f_lo - t * lo, f_hi - t * hi)
    (t, 0.25 * (s_lo + s_hi), 0.25 * max(s_hi - s_lo, 0.0))
}

/// The enclosure of `smin(a(q), b(q), k)` (`min` for `k <= 0`) from its operands' enclosures.
///
/// An operand surely `k` above the other over the box changes nothing (`smin` is then the other,
/// bit for bit): by their ranges, or by the range `[lo, hi]` of `d = a - b` that the difference
/// of their planes gives, which cancels what slope they share. Else `seam` above is between two
/// lines of slope `t` over `d`'s range (`seam_lines`), `seam(d) = t d + s`, and
///   `smin = (a + b) / 2 - (t (a - b) + s) / 2 = wa a + wb b - s / 2`,
/// `wa = (1 - t) / 2` and `wb = (1 + t) / 2`: two weights that are at least 0 and sum to 1 (the
/// join's partials are such a pair everywhere, and these are the pair at the chord). `s / 2` is
/// its middle, moved into `c`, give or take a quarter of the gap between the lines, which is
/// error: 0 where the box is on one side of the seam and at most `(hi - lo) / 8`. Two ways to
/// carry the operands' own radii and errors, each sound; the one whose slab about its own plane
/// is the thinner is taken (`slope_thick`), and the range is what both allow:
///  - weighed as the planes are (`wa a.e + wb b.e`), `d`'s range being that of the whole
///    enclosures (planes, radii and errors): `wa a + wb b` holds for the functions themselves;
///  - the larger of the two (`max(a.e, b.e)`), `d`'s range being that of the planes alone: `smin`
///    never falls as an operand rises and changes by at most the larger change of the two, so
///    `smin(a, b)` is within the larger of the operands' widths of `smin` of their planes.
/// The first is narrower where one operand is much the wider (a ball beside a plane), the second
/// where both are as wide. The weights' rounding and the sums' are in the margin.
pub fn slope_smin(a: SlopeBox, b: SlopeBox, k: f32) -> SlopeBox {
    let kk = max(k, 0.0)
    if apart(b.range.lo, a.range.hi, kk) {
        return a
    }
    if apart(a.range.lo, b.range.hi, kk) {
        return b
    }
    let reach = slope_reach(a) + slope_reach(b)
    let d0 = a.c - b.c
    let w0 = sum_abs(a.l - b.l)
    let w = w0 + sum_abs(a.r) + sum_abs(b.r) + a.e + b.e
    let dm = (reach + w) * (8.0 * SLOPE_EPS) + 4.0 * SLOPE_TINY
    let rm = (abs(a.range.lo) + abs(a.range.hi) + abs(b.range.lo) + abs(b.range.hi)) *
        (2.0 * SLOPE_EPS) +
        SLOPE_TINY
    let lo = max(d0 - (w + dm), (a.range.lo - b.range.hi) - rm)
    let hi = min(d0 + (w + dm), (a.range.hi - b.range.lo) + rm)
    if apart(lo, 0.0, kk) {
        return b
    }
    if apart(0.0, hi, kk) {
        return a
    }
    let range = smin_range(a.range, b.range, kk)
    let margin = (reach + abs(lo) + abs(hi) + kk) * (16.0 * SLOPE_EPS) + 8.0 * SLOPE_TINY
    let lr = (abs(a.l) + abs(b.l) + a.r + b.r) * (4.0 * SLOPE_EPS) + vec3(2.0 * SLOPE_TINY)
    // Weighed: the whole enclosures' difference.
    let (t, m, q) = seam_lines(lo, hi, kk)
    let (wa, wb) = (0.5 * (1.0 - t), 0.5 * (1.0 + t))
    let weighed = SlopeBox {
        c: a.c * wa + b.c * wb - m,
        l: a.l * wa + b.l * wb,
        r: a.r * wa + b.r * wb + lr,
        e: a.e * wa + b.e * wb + q + margin,
        range,
    }
    // The larger: the planes' difference.
    let (t0, m0, q0) = seam_lines(d0 - (w0 + dm), d0 + (w0 + dm), kk)
    let (ua, ub) = (0.5 * (1.0 - t0), 0.5 * (1.0 + t0))
    let larger = SlopeBox {
        c: a.c * ua + b.c * ub - m0,
        l: a.l * ua + b.l * ub,
        r: max(a.r, b.r) + lr,
        e: max(a.e, b.e) + q0 + margin,
        range,
    }
    // The narrower about its own plane: its width over its slopes' length is how thick a slab
    // about that plane holds the surface, in the box's widths. The range keeps what either shows.
    let out = if slope_thick(larger) < slope_thick(weighed) { larger } else { weighed }
    SlopeBox { range: both(range, both(slope_span(larger), slope_span(weighed))), ..out }
}

/// The enclosure of `smax(a(q), b(q), k)` (`max` for `k <= 0`): `-smin(-a, -b, k)`, exactly.
pub fn slope_smax(a: SlopeBox, b: SlopeBox, k: f32) -> SlopeBox {
    slope_neg(slope_smin(slope_neg(a), slope_neg(b), k))
}

/// The enclosure of `min(a(q), b(q))` (`slope_smin` with no seam).
pub fn slope_min(a: SlopeBox, b: SlopeBox) -> SlopeBox {
    slope_smin(a, b, 0.0)
}

/// The enclosure of `max(a(q), b(q))`.
pub fn slope_max(a: SlopeBox, b: SlopeBox) -> SlopeBox {
    slope_smax(a, b, 0.0)
}

/// The enclosure of `-a(q)`.
pub fn slope_neg(a: SlopeBox) -> SlopeBox {
    SlopeBox { c: -a.c, l: -a.l, r: a.r, e: a.e, range: Interval { lo: -a.range.hi, hi: -a.range.lo } }
}

/// The enclosure of `s * a(q)` for a constant `s`.
pub fn slope_scale(a: SlopeBox, s: f32) -> SlopeBox {
    let m = abs(s)
    let rl = a.range.lo * s
    let rh = a.range.hi * s
    let size = max(abs(rl), abs(rh))
    let re = size * (4.0 * SLOPE_EPS) + 2.0 * SLOPE_TINY
    SlopeBox {
        c: a.c * s,
        l: a.l * s,
        r: a.r * m + (abs(a.l) + a.r) * (m * 4.0 * SLOPE_EPS) + vec3(2.0 * SLOPE_TINY),
        // The products' rounding, and that of the product the function computes at each point.
        e: a.e * m + (abs(a.c) * m + a.e * m + size) * (4.0 * SLOPE_EPS) + 2.0 * SLOPE_TINY,
        range: Interval { lo: min(rl, rh) - re, hi: max(rl, rh) + re },
    }
}

/// The enclosure of `a(q) + by`.
pub fn slope_shift(a: SlopeBox, by: f32) -> SlopeBox {
    let rl = a.range.lo + by
    let rh = a.range.hi + by
    let re = (abs(a.range.lo) + abs(a.range.hi) + abs(by)) * (2.0 * SLOPE_EPS) + SLOPE_TINY
    // The rounding of `c`'s sum, and of the sum the function itself computes at each point
    // (its operand's size there is within its range).
    let size = abs(a.c) + abs(by) + max(abs(a.range.lo), abs(a.range.hi))
    SlopeBox {
        c: a.c + by,
        e: a.e + size * (2.0 * SLOPE_EPS) + 2.0 * SLOPE_TINY,
        range: Interval { lo: rl - re, hi: rh + re },
        ..a,
    }
}

/// The enclosure of `a(q) + b(q)`: the planes' sum, the radii's and the errors'.
pub fn slope_add(a: SlopeBox, b: SlopeBox) -> SlopeBox {
    let reach = slope_reach(a) + slope_reach(b)
    let out = SlopeBox {
        c: a.c + b.c,
        l: a.l + b.l,
        r: a.r + b.r + (abs(a.l) + abs(b.l) + a.r + b.r) * (4.0 * SLOPE_EPS) + vec3(2.0 * SLOPE_TINY),
        e: a.e + b.e + reach * (8.0 * SLOPE_EPS) + 4.0 * SLOPE_TINY,
        range: Interval { lo: 0.0, hi: 0.0 },
    }
    let sum = outward(Interval { lo: a.range.lo + b.range.lo, hi: a.range.hi + b.range.hi })
    SlopeBox { range: both(sum, slope_span(out)), ..out }
}

/// The enclosure of `abs(a(q))`: `max(a, -a)`.
pub fn slope_abs(a: SlopeBox) -> SlopeBox {
    if a.range.lo >= 0.0 {
        return a
    }
    if a.range.hi <= 0.0 {
        return slope_neg(a)
    }
    slope_max(a, slope_neg(a))
}

/// The enclosure of `0.5 * (a(q) - b(q))`.
pub fn slope_sub_half(a: SlopeBox, b: SlopeBox) -> SlopeBox {
    let size = max(abs(a.range.lo), abs(a.range.hi)) + max(abs(b.range.lo), abs(b.range.hi))
    let lo = 0.5 * (a.range.lo - b.range.hi)
    let hi = 0.5 * (a.range.hi - b.range.lo)
    let re = (abs(a.range.lo) + abs(a.range.hi) + abs(b.range.lo) + abs(b.range.hi)) *
        (4.0 * SLOPE_EPS) +
        2.0 * SLOPE_TINY
    SlopeBox {
        c: 0.5 * (a.c - b.c),
        l: 0.5 * (a.l - b.l),
        r: 0.5 * (a.r + b.r) + (abs(a.l) + abs(b.l) + a.r + b.r) * (4.0 * SLOPE_EPS) + vec3(2.0 * SLOPE_TINY),
        e: 0.5 * (a.e + b.e) +
            (abs(a.c) + abs(b.c) + a.e + b.e + size) * (4.0 * SLOPE_EPS) +
            2.0 * SLOPE_TINY,
        range: Interval { lo: lo - re, hi: hi + re },
    }
}

/// `slope_box` of `a` and `b` joined by `smin` of width `k` (`min` for 0) as `pair_masked` joins
/// their distances: an operand none of whose parts is live isn't asked, and the other's is the
/// whole. Each operand written once.
pub fn pair_slope<A: Surface, B: Surface, F: Copy + fn(vec3) -> vec3>(
    a: A,
    b: B,
    over: Box3,
    at: F,
    to: MapBox,
    live: Live,
    first: u32,
    k: f32,
) -> SlopeBox {
    let n = a.parts()
    let la = live.any(first, n)
    let lb = live.any(first + n, b.parts())
    var sa = slope_empty()
    if la {
        sa = a.slope_box(over, at, to, live, first)
    }
    var sb = slope_empty()
    if lb {
        sb = b.slope_box(over, at, to, live, first + n)
    }
    if la && lb {
        slope_smin(sa, sb, k)
    } else if la {
        sa
    } else {
        sb
    }
}

/// `slope_box` of `parts` folded by `smin` of width `k` (`min` for 0) over the parts with a live
/// part, in order, as `array_masked` folds their distances.
fn array_slope<S: Surface, const N: u32, F: Copy + fn(vec3) -> vec3>(
    parts: [S; N],
    over: Box3,
    at: F,
    to: MapBox,
    live: Live,
    first: u32,
    k: f32,
) -> SlopeBox {
    var has = false
    var acc = slope_empty()
    var f = first
    for i in 0..N {
        let n = parts[i].parts()
        if live.any(f, n) {
            let v = parts[i].slope_box(over, at, to, live, f)
            if has {
                acc = slope_smin(acc, v, k)
            } else {
                acc = v
                has = true
            }
        }
        f += n
    }
    acc
}

/// Whether `a - b >= k` for every computed `a >= lo` and `b <= hi`, as the target subtracts
/// (rounding is monotone, so the real difference at least `k` is enough; the margin covers the
/// rounding of the test itself). Then `smin(b, a, k)` is `b`, exactly.
fn apart(lo: f32, hi: f32, k: f32) -> bool {
    if k <= 0.0 {
        return lo >= hi
    }
    lo - hi >= k * 1.000001 + 1.0e-30
}

/// A range's ends moved out by a few units in the last place: what a sum of two ranges' ends
/// needs to hold the computed sum.
fn outward(r: Interval) -> Interval {
    Interval { lo: r.lo - abs(r.lo) * 4.0e-7 - 1.0e-37, hi: r.hi + abs(r.hi) * 4.0e-7 + 1.0e-37 }
}

/// The scope `interval_near` asks a bound over: as far from the surface as `x` says the box can be.
fn near_scope(x: Interval) -> f32 {
    max(abs(x.lo), abs(x.hi)) * 1.001 + 0.000001
}

/// `x`, `s`'s derived interval over `b`, narrowed by `s`'s bound `l` there and its distance at
/// `b`'s centre (`Surface::interval_near`).
fn narrowed<S: Surface>(s: S, b: Box3, x: Interval, l: f32) -> Interval {
    let r = l * 0.5 * length(b.hi - b.lo)
    let d = s.distance(b.center())
    Interval { lo: max(x.lo, d - r), hi: min(x.hi, d + r) }
}

/// Any surface's `interval_near` (`Surface::interval_near`) from `x`, its derived interval over
/// `b`: narrowed by its bound where it has one. A join or a move takes what holds both this and
/// its parts' own, composed: never looser than either (each part's bound is at most the
/// join's), and closed where a part's bound is unbounded or steep.
fn own_near<S: Surface>(s: S, b: Box3, x: Interval) -> Interval {
    let l = s.lipschitz(near_scope(x))
    if l >= 1.0e30 {
        return x
    }
    narrowed(s, b, x, l)
}

/// What both intervals hold.
fn both(x: Interval, y: Interval) -> Interval {
    Interval { lo: max(x.lo, y.lo), hi: min(x.hi, y.hi) }
}

/// The range of `-v` for `v` in `x`.
fn negated(x: Interval) -> Interval {
    Interval { lo: -x.hi, hi: -x.lo }
}

/// A range of `smax(a, b, k)` (`max` for `k <= 0`) for `a` in `x`, `b` in `y`: `smin_range`'s,
/// negated.
fn smax_range(x: Interval, y: Interval, k: f32) -> Interval {
    negated(smin_range(negated(x), negated(y), k))
}

/// A range holding `smin(a, b, k)` for `a` in `x` and `b` in `y`, as the target computes it:
/// at most the smaller (it takes a non-negative amount from it), at least the smaller less
/// `k / 4` (and that amount's rounding). With `k` 0, `min`'s, exactly.
fn smin_range(x: Interval, y: Interval, k: f32) -> Interval {
    let lo = min(x.lo, y.lo)
    let hi = min(x.hi, y.hi)
    if k <= 0.0 {
        return Interval { lo, hi }
    }
    let l = lo - 0.25 * k * 1.000001
    Interval { lo: l - abs(l) * 4.0e-7 - 1.0e-37, hi }
}

/// Two operands joined by `smin` of width `k` (`min` for 0), parts `first..first + na` the
/// first's and the next `nb` the second's: `b.live` is both operands' pruning, `a` the first's
/// range. An operand at least `k` above the other over the box is left out.
fn joined(a: Interval, b: Pruned, first: u32, na: u32, nb: u32, k: f32) -> Pruned {
    let kk = max(k, 0.0)
    if apart(b.range.lo, a.hi, kk) {
        return Pruned { live: b.live.without(first + na, nb), range: a }
    }
    if apart(a.lo, b.range.hi, kk) {
        return Pruned { live: b.live.without(first, na), range: b.range }
    }
    Pruned { live: b.live, range: smin_range(a, b.range, kk) }
}

/// Where a surface is: a sphere, and how fast its distance grows outside it. Its distance at
/// `p` is at least `slope` times `p`'s distance from the sphere: exactly so for a surface whose
/// distance is exact (slope 1); for one whose distance is a bound, `slope` is what the surface
/// states (the ellipsoid's 0.5 is an assumption, not a proof).
pub struct Bound: Copy + GpuData {
    pub centre: vec3,
    pub radius: f32,
    pub slope: f32,
}

/// A bound that holds nothing out: everywhere is inside it.
pub const UNBOUNDED: Bound = Bound { centre: vec3(), radius: 1.0e30, slope: 1.0 }

impl Bound {
    /// The least the surface's distance can be at `p`.
    pub fn below(self, p: vec3) -> f32 {
        self.slope * (length(p - self.centre) - self.radius)
    }

    /// A bound holding both, with the smaller slope.
    pub fn and(self, other: Bound) -> Bound {
        if self.radius >= 1.0e30 || other.radius >= 1.0e30 {
            return UNBOUNDED
        }
        let d = length(other.centre - self.centre)
        if d + other.radius <= self.radius {
            return Bound { slope: min(self.slope, other.slope), ..self }
        }
        if d + self.radius <= other.radius {
            return Bound { slope: min(self.slope, other.slope), ..other }
        }
        let r = 0.5 * (d + self.radius + other.radius)
        let centre = self.centre +
            (other.centre - self.centre) * ((r - self.radius) / max(d, 1.0e-30))
        Bound { centre, radius: r, slope: min(self.slope, other.slope) }
    }

    /// The bound grown so the distance may be `by` lower anywhere (a blend's seam, a
    /// displacement).
    pub fn lowered(self, by: f32) -> Bound {
        Bound { radius: self.radius + abs(by) / max(self.slope, 1.0e-30), ..self }
    }

    /// Moved by `by`.
    pub fn moved(self, by: vec3) -> Bound {
        Bound { centre: self.centre + by, ..self }
    }
}

/// How much part `i` decides `field`'s distance at `p`: how much the distance changes where
/// the part's own distance does (`part_offset`, by 0.1 mm), from 0 (another part decides it:
/// the part can change without moving the surface there) to 1 (the part alone decides it), and
/// between in a blend.
pub fn part_share<S: Surface>(field: S, p: vec3, i: u32) -> f32 {
    (field.part_offset(p, i, by: 0.0001) - field.distance(p)) / 0.0001
}

// ---- measures (§23) ----------------------------------------------------------------------
//
// Where a surface is, as numbers a spec can hold it to (std::lift's `Checks`). Each searches
// with values, then takes one Newton step along its ray, so its derivative by anything the
// field reads (a lifted literal, `std::lift::gradient`) is the exact one: the search's own
// change cancels in the step.

/// How far along the ray from `o` in direction `dir` (a unit vector) it first meets `field`'s
/// surface, within `far`; -1 if it doesn't.
pub fn hit<S: Surface>(field: S, o: vec3, dir: vec3, far: f32 = 10.0) -> f32 {
    var t = 0.0
    var found = false
    for _ in 0..512 {
        let d = field.distance(o + dir * t)
        if abs(d) < 0.00005 {
            found = true
            break
        }
        // From inside, `d` is negative but its magnitude is still the conservative step to
        // the surface. Advancing by a fixed epsilon alone cannot leave a body more than 25.6
        // mm thick before this search's 512-step limit.
        t += max(abs(d) * 0.8, 0.00005)
        if t > far {
            break
        }
    }
    if !found {
        return -1.0
    }
    // One Newton step: the root's derivative, from the slope along the ray.
    let h = 0.0001
    let p = o + dir * t
    let slope = (field.distance(p + dir * h) - field.distance(p - dir * h)) / (2.0 * h)
    if abs(slope) < 0.05 {
        return t
    }
    t - field.distance(p) / slope
}

/// The height of the surface's top above the ground point (`x`, `z`): where a ray from 10 m
/// up meets it, going down; 0 if nothing is above that point.
pub fn top<S: Surface>(field: S, x: f32, z: f32) -> f32 {
    let t = hit(field, vec3(x, 10.0, z), vec3(0.0, -1.0, 0.0), far: 20.0)
    if t < 0.0 { 0.0 } else { 10.0 - t }
}

/// The height of the surface's underside above the ground point (`x`, `z`): where a ray from
/// 10 m down meets it, going up; 0 if nothing is there.
pub fn bottom<S: Surface>(field: S, x: f32, z: f32) -> f32 {
    let t = hit(field, vec3(x, -10.0, z), vec3(0.0, 1.0, 0.0), far: 20.0)
    if t < 0.0 { 0.0 } else { t - 10.0 }
}

/// How wide the surface is across x along the line at height `y` and depth `z`: from where
/// a ray from the left meets it to where one from the right does; 0 if neither does.
pub fn width<S: Surface>(field: S, y: f32, z: f32) -> f32 {
    let a = hit(field, vec3(10.0, y, z), vec3(-1.0, 0.0, 0.0), far: 20.0)
    let b = hit(field, vec3(-10.0, y, z), vec3(1.0, 0.0, 0.0), far: 20.0)
    if a < 0.0 || b < 0.0 { 0.0 } else { (10.0 - a) - (b - 10.0) }
}

/// The surface's front along z at height `y`, `x` from the middle: where a ray from 10 m in
/// front (+z) meets it, going back; -10 if nothing is there.
pub fn front<S: Surface>(field: S, x: f32, y: f32) -> f32 {
    let t = hit(field, vec3(x, y, 10.0), vec3(0.0, 0.0, -1.0), far: 20.0)
    if t < 0.0 { -10.0 } else { 10.0 - t }
}

/// The surface's back along z at height `y`, `x` from the middle (`front`, from behind); 10
/// if nothing is there.
pub fn back<S: Surface>(field: S, x: f32, y: f32) -> f32 {
    let t = hit(field, vec3(x, y, -10.0), vec3(0.0, 0.0, 1.0), far: 20.0)
    if t < 0.0 { 10.0 } else { t - 10.0 }
}

/// How far the surface reaches in direction `dir` (a unit vector) within `region`: the
/// largest p · dir over the surface there. Rays along −dir sweep the region's cross-section,
/// 16 by 16, then twice more 8 by 8 around the best, each from where it enters the region, so
/// the surface outside it hides nothing. The measure is the best ray's hit, so its derivative
/// is that point's; where the surface fills the region's edge, it's the edge. -10⁹ if the
/// region holds no surface.
pub fn farthest<S: Surface>(field: S, dir: vec3, region: Box3) -> f32 {
    let c = region.center()
    let e = region.hi - region.lo
    let reach = length(e)
    // Two axes across `dir`.
    let helper = if abs(dir.y) < 0.9 { vec3(0.0, 1.0, 0.0) } else { vec3(1.0, 0.0, 0.0) }
    let u = normalize(cross(helper, dir))
    let v = cross(dir, u)
    // The rays' way, and its inverse for the region's slabs.
    let w = -dir
    let inv = vec3(slab_inverse(w.x), slab_inverse(w.y), slab_inverse(w.z))
    var centre = vec2(0.0)
    var half = 0.5 * reach
    var best = -1.0e9
    for round in 0..3 {
        let n = if round == 0 { 16 } else { 8 }
        var found = centre
        for i in 0..n {
            for j in 0..n {
                let a = centre +
                    vec2((f32(i) + 0.5) / f32(n) * 2.0 - 1.0, (f32(j) + 0.5) / f32(n) * 2.0 - 1.0) *
                        half
                let o = c + u * a.x + v * a.y + dir * reach
                // Where the ray enters the region and leaves it.
                let t_lo = (region.lo - o) * inv
                let t_hi = (region.hi - o) * inv
                let near = min(t_lo, t_hi)
                let far = max(t_lo, t_hi)
                let t0 = max(max(near.x, near.y), max(near.z, 0.0))
                let t1 = min(far.x, min(far.y, far.z))
                if t0 < t1 {
                    let p0 = o + w * t0
                    var m = -1.0e9
                    if field.distance(p0) <= 0.0 {
                        m = dot(p0, dir)
                    } else {
                        let t = hit(field, p0, w, far: t1 - t0)
                        if t >= 0.0 {
                            m = dot(p0 + w * t, dir)
                        }
                    }
                    if m > best {
                        best = m
                        found = a
                    }
                }
            }
        }
        centre = found
        half = half * 2.5 / f32(n)
    }
    best
}

/// 1 / x for a ray's slab test, large and finite where x is 0, so no NaN comes of 0 / 0.
fn slab_inverse(x: f32) -> f32 {
    if abs(x) < 0.000001 { 1.0e6 } else { 1.0 / x }
}

/// The index of the part named `name` (`part_name(i).name`): the first, if several share it,
/// and `parts()` if none does.
pub fn part_named<S: Surface>(field: S, name: str) -> u32 {
    for i in 0..field.parts() {
        if field.part_name(i).name == name {
            return i
        }
    }
    field.parts()
}

/// Part `i`'s family: the first part with its name in its group, so a part and its mirror
/// image are one family. An unnamed part is its own.
pub fn part_family<S: Surface>(field: S, i: u32) -> u32 {
    let a = field.part_name(i)
    if a.name.len() == 0 {
        return i
    }
    for j in 0..i {
        let b = field.part_name(j)
        if b.name == a.name && b.group == a.group {
            return j
        }
    }
    i
}

/// Each part's family (`part_family`), by index.
pub fn part_families<S: Surface>(field: S) -> Vec<u32> {
    Vec::from_fn(field.parts(), |i| part_family(field, i))
}

/// Part `i`'s mirror image: the part with its name in its group, mirrored the other way; `i`
/// itself if it has none, or no name.
pub fn part_image<S: Surface>(field: S, i: u32) -> u32 {
    let a = field.part_name(i)
    if a.name.len() == 0 {
        return i
    }
    for j in 0..field.parts() {
        let b = field.part_name(j)
        if j != i && b.name == a.name && b.group == a.group && b.mirrored != a.mirrored {
            return j
        }
    }
    i
}

// ---- certified checks (§23) ------------------------------------------------------------

/// What a certified check of a region found: the property holds at every point of it (proved by
/// derived intervals, §14), it fails at a point (a counterexample), or the intervals couldn't
/// tell within the depth asked, first in the box given.
pub enum Certified: Copy {
    Holds,
    Fails(vec3),
    Unknown(Box3),
}

impl Certified {
    /// Whether the check proved the property: `Holds`.
    pub fn holds(self) -> bool {
        match self {
            Certified::Holds => true,
            _ => false,
        }
    }
}

/// Whether `f` is positive everywhere in `region`: its derived interval over each box (the
/// region, then its octree, `depth` levels at most) is above 0 there, or a point where it isn't.
/// Each box is checked at its centre too, so a failure is found as a point, not just a box.
///
/// ```wrela
/// use std::derive::Box3
/// use std::field::{Surface, certify_positive, sphere}
///
/// let s = sphere(0.5).translate(vec3(0.0, 0.6, 0.0))
/// let below = Box3 { lo: vec3(-2.0, -1.0, -2.0), hi: vec3(2.0, 0.0, 2.0) }
/// assert(certify_positive(|p: vec3| s.distance(p), below, depth: 6).holds())
/// ```
pub fn certify_positive(f: fn(vec3) -> f32, region: Box3, depth: u32) -> Certified {
    var stack: Vec<(Box3, u32)> = Vec::new()
    stack.push((region, 0))
    var unknown: Option<Box3> = None
    while let Some((b, d)) = stack.pop() {
        let r = interval(f, b)
        if r.lo > 0.0 {
            continue
        }
        let c = b.center()
        if r.hi <= 0.0 || !(f(c) > 0.0) {
            return Certified::Fails(c)
        }
        if d >= depth {
            if unknown.is_none() {
                unknown = Some(b)
            }
            continue
        }
        for o in b.split() {
            stack.push((o, d + 1))
        }
    }
    match unknown {
        Some(b) => Certified::Unknown(b),
        None => Certified::Holds,
    }
}

/// Whether nothing of `field`'s inside is in `region` (its distance is positive everywhere
/// there): for example, nothing below the ground.
pub fn certify_clear<S: Surface>(field: S, region: Box3, depth: u32) -> Certified {
    certify_positive(|p: vec3| field.distance(p), region, depth)
}

/// Whether parts `a` and `b` of `field` don't overlap anywhere in `region`: at every point at
/// least one of them is outside (the larger of their own distances is positive).
pub fn certify_apart<S: Surface>(field: S, a: u32, b: u32, region: Box3, depth: u32) -> Certified {
    certify_positive(
        |p: vec3| max(field.part_distance(p, a), field.part_distance(p, b)),
        region,
        depth,
    )
}

/// A part's name, for tools (§23): the name its author gave it, the name of the group it's in,
/// the name of the space it's placed in (an engine's creature places parts on bones), and
/// whether it's the mirror image of the part as written. Each name is empty where nothing gives
/// one.
pub struct PartName: Copy {
    pub name: Text,
    pub group: Text,
    pub frame: Text,
    pub mirrored: bool,
}

/// A part with no name.
pub fn unnamed() -> PartName {
    PartName { name: "", group: "", frame: "", mirrored: false }
}

/// A scalar function over 3D space, used to displace surfaces.
pub trait Noise: Copy + GpuData {
    /// Writes what the noise is made of into `h`, and says whether it can (`Surface::part_state`):
    /// a noise std doesn't know can't.
    fn noise_state(self, h: mut Hasher) -> bool {
        false
    }

    /// The noise's value at `p`.
    fn value(self, p: vec3) -> f32

    /// Every value it takes.
    fn range(self) -> Interval

    /// A bound on its gradient's length, everywhere.
    fn lipschitz(self) -> f32

    /// Its highest frequency, in cycles per unit: detail finer than `1 / bandlimit()` is all
    /// there is above it.
    fn bandlimit(self) -> f32

    /// Its value averaged over the box `p ± footprint / 2`, each component a width (0 samples
    /// that axis): what a pixel whose footprint spans that box sees. Detail finer than the
    /// footprint fades to its mean instead of aliasing. The default is the value itself,
    /// which is right for a noise with no detail finer than the footprints it's seen at.
    fn filtered(self, p: vec3, footprint: vec3) -> f32 {
        self.value(p)
    }
}

// ---- primitives ---------------------------------------------------------------------------------

/// A closure or function of a point is a surface too, its value the distance: `|p| length(p)
/// - r`, written where it's used (§6.7). Its gradient and interval are derived as any
/// surface's are; it has no Lipschitz bound of its own (§14).
impl<F: Copy + GpuData + fn(vec3) -> f32> Surface for F {
    fn distance(self, p: vec3) -> f32 {
        self(p)
    }

    /// A closure states nothing of where it is: unbounded. A surface culling should skip is
    /// built from primitives, which state theirs.
    fn bound(self) -> Bound {
        UNBOUNDED
    }
}

/// A sphere centred at the origin. Exact.
pub struct Sphere: Copy + GpuData + Eq + StateHash {
    pub radius: f32,
}

/// A sphere of radius `radius`, centred at the origin.
pub fn sphere(radius: f32) -> Sphere {
    Sphere { radius }
}

impl Surface for Sphere {
    fn part_state(self, i: u32, h: mut Hasher) -> bool {
        self.state_hash(mut h)
        true
    }

    fn distance(self, p: vec3) -> f32 {
        length(p) - self.radius
    }

    fn bound(self) -> Bound {
        Bound { centre: vec3(), radius: self.radius, slope: 1.0 }
    }

    /// Exact: its gradient is a unit vector.
    fn lipschitz(self, near: f32) -> f32 {
        1.0
    }

    fn rigid_shape_hash(self) -> Option<u64> {
        Some(state_hash(self))
    }
}

/// A surface whose distance is a texture's data (language.md §20.3): a 3D texture of distances,
/// texel (`i`, `j`, `k`) the distance at `origin + (vec3(i, j, k) + 0.5) × voxel`, read between
/// the eight texels round a point (trilinear). GPU code reads it; the texture is bound beside the
/// value wherever an entry point takes one (a `Texture3dHandle`), so a march generic over
/// `Surface` takes it as it takes an analytic field. Past the grid, its distance is the
/// distance to the grid's box added to the distance where the point meets it, which a sphere
/// tracer may step by.
pub struct Sampled3d: Copy + GpuData {
    /// The distances.
    pub texels: Texture3dHandle<R32Float>,
    /// The grid's corner, the first texel's outer corner.
    pub origin: vec3,
    /// A texel's side.
    pub voxel: f32,
}

/// A surface of the distances `texels` holds, the grid's corner at `origin` and each texel
/// `voxel` on a side.
pub fn sampled3d(texels: Texture3dHandle<R32Float>, origin: vec3, voxel: f32) -> Sampled3d {
    Sampled3d { texels, origin, voxel }
}

impl Sampled3d {
    /// The grid's size in texels.
    fn dims(self) -> vec3u {
        vec3u(self.texels.width(), self.texels.height(), self.texels.depth())
    }

    /// The distance between the texels round grid point `q` (in texels, centres at `i + 0.5`),
    /// clamped to the texel centres, and its gradient in texels: zero along an axis the clamp
    /// holds, where the distance doesn't change with `q`.
    fn trilinear(self, q: vec3) -> (f32, vec3) {
        let hi = vec3(self.dims()) - vec3(1.0)
        let u = q - vec3(0.5)
        let c = clamp(u, vec3(0.0), hi)
        let free = vec3(f32(u.x == c.x), f32(u.y == c.y), f32(u.z == c.z))
        let lo = min(floor(c), max(hi - vec3(1.0), vec3(0.0)))
        let f = c - lo
        let i = vec3u(lo)
        let n = min(i + vec3u(1), vec3u(hi))
        let t = self.texels
        let d000 = t.load(x: i.x, y: i.y, z: i.z)
        let d100 = t.load(x: n.x, y: i.y, z: i.z)
        let d010 = t.load(x: i.x, y: n.y, z: i.z)
        let d110 = t.load(x: n.x, y: n.y, z: i.z)
        let d001 = t.load(x: i.x, y: i.y, z: n.z)
        let d101 = t.load(x: n.x, y: i.y, z: n.z)
        let d011 = t.load(x: i.x, y: n.y, z: n.z)
        let d111 = t.load(x: n.x, y: n.y, z: n.z)
        let x00 = mix(d000, d100, f.x)
        let x10 = mix(d010, d110, f.x)
        let x01 = mix(d001, d101, f.x)
        let x11 = mix(d011, d111, f.x)
        let y0 = mix(x00, x10, f.y)
        let y1 = mix(x01, x11, f.y)
        let d = mix(y0, y1, f.z)
        // The trilinear's derivative along each axis, from the same eight.
        let dx = mix(mix(d100 - d000, d110 - d010, f.y), mix(d101 - d001, d111 - d011, f.y), f.z)
        let dy = mix(x10 - x00, x11 - x01, f.z)
        let dz = y1 - y0
        (d, vec3(dx, dy, dz) * free)
    }

    /// `p`'s distance from the grid's box (0 inside), and the point of the box nearest it.
    fn outside(self, p: vec3) -> (f32, vec3) {
        let top = self.origin + vec3(self.dims()) * self.voxel
        let near = clamp(p, self.origin, top)
        (length(p - near), near)
    }
}

impl Surface for Sampled3d {
    fn distance(self, p: vec3) -> f32 {
        let (out, near) = self.outside(p)
        let (d, _) = self.trilinear((near - self.origin) / self.voxel)
        d + out
    }

    /// The trilinear's own gradient (inside the grid), from the eight texels it reads.
    fn gradient(self, p: vec3) -> vec3 {
        let (_, g) = self.sample(p)
        g
    }

    /// Past the grid: the box's distance's gradient, and the trilinear's along each axis that
    /// `p` is within the box on (the point where `p` meets the box moves with `p` there).
    fn sample(self, p: vec3) -> (f32, vec3) {
        let (out, near) = self.outside(p)
        let (d, g) = self.trilinear((near - self.origin) / self.voxel)
        if out > 0.0 {
            let along = vec3(f32(near.x == p.x), f32(near.y == p.y), f32(near.z == p.z))
            return (d + out, g / self.voxel * along + (p - near) / out)
        }
        (d, g / self.voxel)
    }
    /// Unbounded: the texels may hold distances below zero at the grid's edge, which reach
    /// past it, so the sphere round the grid holds nothing out.
    fn bound(self) -> Bound {
        UNBOUNDED
    }
}

/// An ellipsoid centred at the origin. No exact distance exists; this is the usual bound.
pub struct Ellipsoid: Copy + GpuData + Eq + StateHash {
    pub radii: vec3,
}

/// An ellipsoid with half-axes `radii`, centred at the origin.
pub fn ellipsoid(radii: vec3) -> Ellipsoid {
    Ellipsoid { radii }
}

impl Surface for Ellipsoid {
    fn part_state(self, i: u32, h: mut Hasher) -> bool {
        self.state_hash(mut h)
        true
    }

    fn distance(self, p: vec3) -> f32 {
        let k0 = length(p / self.radii)
        let k1 = length(p / (self.radii * self.radii))
        // The usual bound, k0 (k0 - 1) / k1, written as (k0 - 1) times k0 / k1, which always
        // lies between the smallest and the largest radius. Held there, it's the same value
        // everywhere but the centre, where it's 0 / 0 and the distance is minus the smallest
        // radius; and its interval never reaches 0 inside the body. (Spike 13's certificate
        // found the zero that k0 (k0 - 1) / k1's interval had at the centre.)
        let shortest = min(self.radii.x, min(self.radii.y, self.radii.z))
        let longest = max(self.radii.x, max(self.radii.y, self.radii.z))
        (k0 - 1.0) * clamp(k0 / max(k1, 0.000000001), shortest, longest)
    }

    fn bound(self) -> Bound {
        // The usual bound's distance, assumed to fall off at least half as fast as the true
        // distance does.
        Bound {
            centre: vec3(),
            radius: max(self.radii.x, max(self.radii.y, self.radii.z)),
            slope: 0.5,
        }
    }

    /// The bound k0 (k0 − 1) / k1, with k0 = |p / r| and k1 = |p / r²|, has a gradient that
    /// grows without bound at the centre. Where |distance| < near, |k0 − 1| < e = near /
    /// min(r), and its gradient is at most max(2 − 1 / (1 + e), 1 / (1 − e) − 2) +
    /// e (max(r) / min(r))² / (1 − e). Infinite from e = 1 on, where the centre is in scope.
    fn lipschitz(self, near: f32) -> f32 {
        let lo = min(self.radii.x, min(self.radii.y, self.radii.z))
        let hi = max(self.radii.x, max(self.radii.y, self.radii.z))
        let e = max(near, 0.0) / lo
        if e >= 1.0 {
            return 1.0 / 0.0
        }
        let first = max(2.0 - 1.0 / (1.0 + e), 1.0 / (1.0 - e) - 2.0)
        let r = hi / lo
        (first + e * r * r / (1.0 - e)) * 1.001
    }

    fn rigid_shape_hash(self) -> Option<u64> {
        Some(state_hash(self))
    }
}

/// An ellipsoid whose distance stays well behaved: outside it's `Ellipsoid`'s, which is near
/// the true distance; inside it's (k0 − 1) times the smallest radius, whose gradient is never
/// more than 1, where `Ellipsoid`'s grows without bound towards the centre (3 to 25 in thin or
/// blended ellipsoids). The surface is the same. Prefer it for parts that blend.
pub struct Oval: Copy + GpuData + Eq + StateHash {
    pub radii: vec3,
}

/// An oval with half-axes `radii`, centred at the origin (`Oval`).
pub fn oval(radii: vec3) -> Oval {
    Oval { radii }
}

impl Surface for Oval {
    fn part_state(self, i: u32, h: mut Hasher) -> bool {
        self.state_hash(mut h)
        true
    }

    fn distance(self, p: vec3) -> f32 {
        let k0 = length(p / self.radii)
        if k0 < 1.0 {
            return (k0 - 1.0) * min(self.radii.x, min(self.radii.y, self.radii.z))
        }
        let k1 = length(p / (self.radii * self.radii))
        k0 * (k0 - 1.0) / max(k1, 0.000000001)
    }

    fn bound(self) -> Bound {
        ellipsoid(self.radii).bound()
    }

    /// Inside, 1. Outside, within `near` (e = near / min(r)): the first term of `Ellipsoid`'s
    /// gradient is at most 2 − 1 / (1 + e), and the second, from k1's change, e (max(r) /
    /// min(r))² / (1 + e).
    fn lipschitz(self, near: f32) -> f32 {
        let lo = min(self.radii.x, min(self.radii.y, self.radii.z))
        let hi = max(self.radii.x, max(self.radii.y, self.radii.z))
        let e = max(near, 0.0) / lo
        let r = hi / lo
        max(1.0, 2.0 - 1.0 / (1.0 + e) + e * r * r / (1.0 + e)) * 1.001
    }

    fn rigid_shape_hash(self) -> Option<u64> {
        Some(state_hash(self))
    }
}

/// Round cones through `points`, each `radii` thick there, joined end to end: a limb, a neck
/// or a tail that bends at its points. Consecutive cones share the sphere at their joint, so
/// their union is smooth there and swells nothing (a smooth seam between segments bulges by a
/// quarter of its width). Exact.
pub struct Tube<const N: u32>: Copy + GpuData + Eq + StateHash {
    pub points: [vec3; N],
    pub radii: [f32; N],
}

/// A tube through `points`, `radii` thick at each (`Tube`).
pub fn tube<const N: u32>(points: [vec3; N], radii: [f32; N]) -> Tube<N> {
    Tube { points, radii }
}

impl<const N: u32> Surface for Tube<N> {
    fn part_state(self, i: u32, h: mut Hasher) -> bool {
        self.state_hash(mut h)
        true
    }

    fn distance(self, p: vec3) -> f32 {
        var d = length(p - self.points[0]) - self.radii[0]
        for i in 1..N {
            let c = round_cone(
                self.points[i - 1],
                self.points[i],
                r_top: self.radii[i - 1],
                r_bottom: self.radii[i],
            )
            d = min(d, c.distance(p))
        }
        d
    }

    /// Its cones' bounds, joined.
    fn bound(self) -> Bound {
        var b = Bound { centre: self.points[0], radius: self.radii[0], slope: 1.0 }
        for i in 1..N {
            let c = round_cone(
                self.points[i - 1],
                self.points[i],
                r_top: self.radii[i - 1],
                r_bottom: self.radii[i],
            )
            b = b.and(c.bound())
        }
        b
    }

    /// A union of exact distances: 1.
    fn lipschitz(self, near: f32) -> f32 {
        1.0
    }

    fn rigid_shape_hash(self) -> Option<u64> {
        Some(state_hash(self))
    }
}

/// The hull of two spheres, centred at `a` with radius `r1` and at `b` with radius `r2`.
/// Exact, also where one sphere holds the other (the hull is then the larger sphere).
pub struct RoundCone: Copy + GpuData + Eq + StateHash {
    pub a: vec3,
    pub b: vec3,
    pub r1: f32,
    pub r2: f32,
    /// What `round_cone` works out once from those, where the cone is made, not at each point it
    /// is asked at (a GPU invocation would compute them again, the same for all): the axis's
    /// direction `u` and length `l`, the radii's difference per unit of it `q`, and `√(1 - q²)`;
    /// `u` and `q` 0 where one sphere holds the other.
    u: vec3,
    l: f32,
    q: f32,
    side: f32,
}

/// The hull of a sphere of radius `r_top` at `a` and one of radius `r_bottom` at `b`.
pub fn round_cone(a: vec3, b: vec3, r_top: f32, r_bottom: f32) -> RoundCone {
    let ba = b - a
    let l = length(ba)
    let rr = r_top - r_bottom
    let holds = l <= abs(rr)
    let u = if holds { vec3(0.0) } else { ba / l }
    let q = if holds { 0.0 } else { rr / l }
    RoundCone { a, b, r1: r_top, r2: r_bottom, u, l, q, side: sqrt(1.0 - q * q) }
}

impl Surface for RoundCone {
    fn part_state(self, i: u32, h: mut Hasher) -> bool {
        self.state_hash(mut h)
        true
    }

    fn distance(self, p: vec3) -> f32 {
        let l = self.l
        let rr = self.r1 - self.r2
        // Where |r1 - r2| >= |b - a| (a == b too), one sphere holds the other, and the hull is
        // the larger one.
        if l <= abs(rr) {
            length(p - select(if_false: self.b, if_true: self.a, cond: rr >= 0.0)) -
                max(self.r1, self.r2)
        } else {
            // Inigo Quilez's round cone, written with the axis's direction u and q, the radii's
            // difference per unit of length: each term is about |p - a|². (The usual form's
            // terms grow as |b - a|⁶, and leave f32's range for ends closer than about 10⁻⁷.)
            let u = self.u
            let q = self.q
            let a2 = 1.0 - q * q
            let pa = p - self.a
            let y = dot(pa, u)
            let z = y - l
            let xv = pa - u * y
            let x2 = dot(xv, xv)
            let k = abs(q) * q * x2
            // Past `b`'s end its sphere, past `a`'s end its sphere, else the cone's side: the
            // exact distance in each region, so they meet where a region ends.
            if meets(a2 * (abs(z) * z) - k) {
                length(p - self.b) - self.r2
            } else if meets(k - a2 * (abs(y) * y)) {
                length(p - self.a) - self.r1
            } else {
                length(xv) * self.side + y * q - self.r1
            }
        }
    }

    fn bound(self) -> Bound {
        let half = 0.5 * length(self.b - self.a)
        Bound { centre: 0.5 * (self.a + self.b), radius: half + max(self.r1, self.r2), slope: 1.0 }
    }

    /// Exact.
    fn lipschitz(self, near: f32) -> f32 {
        1.0
    }

    fn rigid_shape_hash(self) -> Option<u64> {
        Some(state_hash(self))
    }
}

/// A box centred at the origin, with half-extents `half`. Exact.
pub struct Cuboid: Copy + GpuData + Eq + StateHash {
    pub half: vec3,
}

/// A box with half-extents `half`, centred at the origin.
pub fn cuboid(half: vec3) -> Cuboid {
    Cuboid { half }
}

impl Surface for Cuboid {
    fn part_state(self, i: u32, h: mut Hasher) -> bool {
        self.state_hash(mut h)
        true
    }

    /// Outside an edge or corner (at least two components of `q` positive), the Euclidean distance
    /// to it; on every face and throughout the interior (at most one component positive), simply the
    /// largest component `m`. Branching on the median (`second > 0.0`) avoids `sqrt(0)` and sign
    /// straddling on faces, keeping affine bounds and gradients exact there.
    fn distance(self, p: vec3) -> f32 {
        box_distance(p, vec3(0.0), self.half)
    }

    fn bound(self) -> Bound {
        Bound { centre: vec3(), radius: length(self.half), slope: 1.0 }
    }

    /// Exact.
    fn lipschitz(self, near: f32) -> f32 {
        1.0
    }

    fn rigid_shape_hash(self) -> Option<u64> {
        Some(state_hash(self))
    }
}

/// Everything on the negative side of a plane: `dot(p, normal) < offset`. The distance is
/// exact when `normal` is a unit vector, as `half_space` makes it.
pub struct HalfSpace: Copy + GpuData + Eq + StateHash {
    pub normal: vec3,
    pub offset: f32,
}

/// The half-space `dot(p, normal) < offset`, for a nonzero `normal` of any length: both are
/// divided by its length, which leaves the same half-space.
pub fn half_space(normal: vec3, offset: f32) -> HalfSpace {
    // Scaled by its largest component first, so its length neither overflows nor underflows.
    let m = max(max(abs(normal.x), abs(normal.y)), abs(normal.z))
    let n = normal / m
    let l = length(n)
    HalfSpace { normal: n / l, offset: offset / m / l }
}

impl Surface for HalfSpace {
    fn part_state(self, i: u32, h: mut Hasher) -> bool {
        self.state_hash(mut h)
        true
    }

    fn distance(self, p: vec3) -> f32 {
        dot(p, self.normal) - self.offset
    }

    /// Unbounded: it reaches to infinity.
    fn bound(self) -> Bound {
        UNBOUNDED
    }

    /// Exact: `half_space` makes its normal a unit vector.
    fn lipschitz(self, near: f32) -> f32 {
        1.0
    }
}

// ---- combinators --------------------------------------------------------------------------------

/// The exact distance from `p` to the box centred at `centre` with half-widths `half`: past
/// two faces at once (the second largest of `|p - centre| - half` above 0) to the nearest edge or
/// corner, else to the nearest face. Its branch `meets` where that second largest is 0: there
/// the one positive part is the largest, and both are it.
pub fn box_distance(p: vec3, centre: vec3, half: vec3) -> f32 {
    let q = abs(p - centre) - half
    let xy_hi = max(q.x, q.y)
    let xy_lo = min(q.x, q.y)
    let second = max(xy_lo, min(xy_hi, q.z))
    if meets(second) { length(max(q, vec3(0.0))) } else { max(xy_hi, q.z) }
}

/// The exact distance from `p` to the upright cylinder round `(centre.x, centre.y)` in x and z,
/// from `y_lo` to `y_hi`, of radius `r`: past its side and an end at once to the rim, else to
/// the nearer of side and end. Its branch `meets` where the lesser of the two is 0: there the
/// other is the rim's distance, and both are it.
pub fn cylinder_distance(p: vec3, centre: vec2, y_lo: f32, y_hi: f32, r: f32) -> f32 {
    let dr = length(vec2(p.x - centre.x, p.z - centre.y)) - r
    let dy = max(p.y - y_hi, y_lo - p.y)
    if meets(min(dr, dy)) { length(vec2(dr, dy)) } else { max(dr, dy) }
}

/// `at > 0`: the condition of a branch on the point whose two sides are one continuous function,
/// agreeing wherever `at` is 0 (an exact distance's two regions, say: a box's past an edge and
/// past a face). What it adds to `at > 0` is what `std::derive::lipschitz` may assume: a branch
/// on the point is otherwise taken to jump where it switches (no bound across it, since two sides
/// need not meet), but across `if meets(at) { .. } else { .. }` the bound is the steeper side's.
/// Use it as the condition itself. A `meets` whose sides don't agree where `at` is 0 is a wrong
/// bound: say in a comment why they do.
pub fn meets(at: f32) -> bool {
    at > 0.0
}

/// The smooth minimum of two distances: where they're `k` or more apart it's exactly the
/// smaller. With `k <= 0` it's `min(a, b)`.
///
/// This is the usual polynomial blend, `mix(b, a, h) - k h (1 - h)` with
/// `h = clamp(0.5 + 0.5 (b - a) / k, 0, 1)`, rearranged (it's the same function, up to
/// rounding) so that what the compiler derives from it is cheap: its gradient doesn't carry
/// terms that cancel, and its interval is the smaller distance's, less at most `k / 4`. It
/// chooses the smaller distance once, with one branch, so an interval that can't decide which
/// runs each side knowing it, and the interval of its gradient stays between its parts' on a
/// blend's seam.
pub fn smin(a: f32, b: f32, k: f32) -> f32 {
    // The smallest normal f32 keeps `0.25 / k` finite, and `m` is 0 for `k <= 0`. `m` times
    // at most a quarter doesn't overflow where `m * m` would. (A derived interval with `k = 0`
    // can multiply that huge `s` into an infinity, and the infinity by 0: a caller whose `k`
    // can be 0 chooses `min` itself, as the engine's seams do. A branch here would cost a
    // derived gradient a sixth of its speed: the grazer's, `grazer.rs`.)
    let s = 0.25 / max(k, 1.1754944e-38)
    let d = b - a
    if d > 0.0 {
        let m = max(k - d, 0.0)
        a - m * (m * s)
    } else {
        // `k + d` is `k - |a - b|` here, and at a tie it still carries `d`'s derivative, so
        // the seam's gradient is half each side's. Two equal infinite distances (an empty
        // surface's) are 0 apart, though their difference is NaN; a NaN still makes a NaN.
        // (The test asks no ordered `==`: numbers whose difference is NaN are infinities of one
        // sign, which is `a == b` with a NaN difference, and each `x == x` is `isnan`, which a
        // shader writes as it is: the NaN-safe `==` it would need cost the masked march 4%.)
        let m = max(k + select(if_false: d, if_true: 0.0, cond: d != d && a == a && b == b), 0.0)
        b - m * (m * s)
    }
}

// Provenance (§23) through a combinator of two surfaces, whose parts are `a`'s then `b`'s, and
// through one of an array of surfaces: what the combinators share. Each has its own `part_at`.

/// The distances of `a` and `b` at `p`, part `i` of the two raised by `by` (`part_offset`).
fn pair_offsets<A: Surface, B: Surface>(a: A, b: B, p: vec3, i: u32, by: f32) -> (f32, f32) {
    let n = a.parts()
    if i < n { (a.part_offset(p, i, by), b.distance(p)) } else {
        (a.distance(p), b.part_offset(p, i - n, by))
    }
}

fn pair_parts<A: Surface, B: Surface>(a: A, b: B) -> u32 {
    a.parts() + b.parts()
}

fn pair_part_distance<A: Surface, B: Surface>(a: A, b: B, p: vec3, i: u32) -> f32 {
    let n = a.parts()
    if i < n { a.part_distance(p, i) } else { b.part_distance(p, i - n) }
}

fn pair_part_state<A: Surface, B: Surface>(a: A, b: B, i: u32, h: mut Hasher) -> bool {
    let n = a.parts()
    if i < n { a.part_state(i, mut h) } else { b.part_state(i - n, mut h) }
}

fn pair_part_bound<A: Surface, B: Surface>(a: A, b: B, i: u32) -> Bound {
    let n = a.parts()
    if i < n { a.part_bound(i) } else { b.part_bound(i - n) }
}

/// How far a smooth join of width `k` (`smin`, `smax`) lets an operand reach the joined surface:
/// where the join is 0, an operand that changes it is below `1.25 k`. (`smin(a, b, k)` is `a`
/// where `b >= a + k`, and at least `min(a, b) - k / 4`: with the join at 0, `b <= a` puts `b`
/// at most `k / 4`, and `a < b < a + k` puts `a` at most `k / 4` and `b` below `1.25 k`; `smax`
/// is `-smin` of the negated.) A part's bound in a join is lowered by this
/// (`Surface::part_bound`): what of the joined surface a moving part changes is in it.
fn smooth_reach(k: f32) -> f32 {
    1.25 * max(k, 0.0)
}

fn pair_part_name<A: Surface, B: Surface>(a: A, b: B, i: u32) -> PartName {
    let n = a.parts()
    if i < n { a.part_name(i) } else { b.part_name(i - n) }
}

/// `masked` of `a` and `b` joined by `join`: an operand none of whose parts is live isn't
/// asked; when only one operand has live parts it is returned directly without invoking `join`
/// against `EMPTY` (which exceeds affine arithmetic's finite cap). One exit, each operand written
/// once.
pub fn pair_masked<A: Surface, B: Surface, J: Copy + fn(f32, f32) -> f32>(
    a: A,
    b: B,
    p: vec3,
    live: Live,
    first: u32,
    join: J,
) -> f32 {
    let n = a.parts()
    let la = live.any(first, n)
    let lb = live.any(first + n, b.parts())
    let da = if la { a.masked(p, live, first) } else { 0.0 }
    let db = if lb { b.masked(p, live, first + n) } else { 0.0 }
    if la && lb {
        join(da, db)
    } else if la {
        da
    } else if lb {
        db
    } else {
        EMPTY
    }
}

/// `pruned` of `a` and `b` joined by `smin` of width `k` (`min` for 0): each operand's, then
/// `joined`'s.
pub fn pair_pruned<A: Surface, B: Surface, F: Copy + fn(vec3) -> vec3>(
    a: A,
    b: B,
    over: Box3,
    at: F,
    stretch: f32,
    live: Live,
    first: u32,
    k: f32,
) -> Pruned {
    let n = a.parts()
    let ra = a.pruned(over, at, stretch, live, first)
    let rb = b.pruned(over, at, stretch, ra.live, first + n)
    joined(ra.range, rb, first, n, b.parts(), k)
}

/// Which of `parts` holds part `i` of them all, and its number there; `N` where none does.
fn locate<S: Surface, const N: u32>(parts: [S; N], i: u32) -> (u32, u32) {
    var first = 0
    for k in 0..N {
        let n = parts[k].parts()
        if i < first + n {
            return (k, i - first)
        }
        first += n
    }
    (N, 0)
}

fn array_parts<S: Surface, const N: u32>(parts: [S; N]) -> u32 {
    var n = 0
    for i in 0..N {
        n += parts[i].parts()
    }
    n
}

fn array_part_distance<S: Surface, const N: u32>(parts: [S; N], p: vec3, i: u32) -> f32 {
    let (k, j) = locate(parts, i)
    if k < N { parts[k].part_distance(p, j) } else { EMPTY }
}

fn array_part_name<S: Surface, const N: u32>(parts: [S; N], i: u32) -> PartName {
    let (k, j) = locate(parts, i)
    if k < N { parts[k].part_name(j) } else { unnamed() }
}

/// Whether each of `parts` is one part and all of them, numbered from `first`, are in one word
/// of a `Live`: then part `i`'s bit is `leaf_bits`' bit `i`.
fn leaves_in_a_word<S: Surface, const N: u32>(parts: [S; N], first: u32) -> bool {
    array_parts(parts) == N && (first & 31) + N <= 32 && first < 128
}

/// `masked` of `parts` folded by `join` over the parts with a live part, seeded from the first
/// live part (never `EMPTY`, which exceeds affine arithmetic's finite cap); returns `EMPTY` only
/// when no part is live. Where each part is one part and all are in one word of the mask, walks
/// its set bits, lowest first (`leaf_bits`): the parts in the same order, so the same fold, in at
/// most `N` passes, as many as the live parts.
fn array_masked<S: Surface, const N: u32, J: Copy + fn(f32, f32) -> f32>(
    parts: [S; N],
    p: vec3,
    live: Live,
    first: u32,
    join: J,
) -> f32 {
    var has = false
    var d = 0.0
    if leaves_in_a_word(parts, first) {
        var bits = leaf_bits(live, first, N)
        for _ in 0..N {
            if bits == 0 {
                break
            }
            let i = bits.trailing_zeros()
            let v = parts[i].masked(p, live, first + i)
            if has {
                d = join(d, v)
            } else {
                d = v
                has = true
            }
            bits = bits & (bits - 1)
        }
        return if has { d } else { EMPTY }
    }
    var f = first
    for i in 0..N {
        let n = parts[i].parts()
        if live.any(f, n) {
            let v = parts[i].masked(p, live, f)
            if has {
                d = join(d, v)
            } else {
                d = v
                has = true
            }
        }
        f += n
    }
    if has { d } else { EMPTY }
}

/// Two surfaces joined: `a.union(b)`.
pub struct Union<A, B>: Copy + GpuData + Eq + StateHash {
    pub a: A,
    pub b: B,
}

impl<A: Surface, B: Surface> Surface for Union<A, B> {
    /// Its operands' enclosures, joined by `min` (`slope_smin`).
    fn slope_box<F: Copy + fn(vec3) -> vec3>(
        self,
        over: Box3,
        at: F,
        to: MapBox,
        live: Live,
        first: u32,
    ) -> SlopeBox {
        pair_slope(self.a, self.b, over, at, to, live, first, 0.0)
    }

    fn part_state(self, i: u32, h: mut Hasher) -> bool {
        
        pair_part_state(self.a, self.b, i, mut h)
    }

    fn part_bound(self, i: u32) -> Bound {
        pair_part_bound(self.a, self.b, i)
    }

    /// Its operands' own, joined by `min`, within its own (`own_near`).
    fn interval_near(self, b: Box3) -> Interval {
        let x = self.interval(b)
        both(
            own_near(self, b, x),
            smin_range(self.a.interval_near(b), self.b.interval_near(b), 0.0),
        )
    }

    fn distance(self, p: vec3) -> f32 {
        min(self.a.distance(p), self.b.distance(p))
    }

    /// Each operand asked within the nearer of `most` and what the other gave: one past them
    /// both is past the `min`, so only what is nearer than everything before it is asked.
    fn distance_within(self, p: vec3, most: f32) -> f32 {
        let a = self.a.distance_within(p, most)
        let b = self.b.distance_within(p, min(most, a))
        min(a, b)
    }

    /// An operand none of whose parts is live isn't asked: it counts as `EMPTY`, and `min` of
    /// the other and `EMPTY` is the other.
    fn masked(self, p: vec3, live: Live, first: u32) -> f32 {
        pair_masked(self.a, self.b, p, live, first, |x: f32, y: f32| min(x, y))
    }

    /// An operand never below the other over the box changes nothing there.
    fn pruned<F: Copy + fn(vec3) -> vec3>(
        self,
        over: Box3,
        at: F,
        stretch: f32,
        live: Live,
        first: u32,
    ) -> Pruned {
        pair_pruned(self.a, self.b, over, at, stretch, live, first, 0.0)
    }

    fn bound(self) -> Bound {
        self.a.bound().and(self.b.bound())
    }

    fn filtered(self, p: vec3, footprint: f32) -> f32 {
        min(self.a.filtered(p, footprint), self.b.filtered(p, footprint))
    }

    fn part_offset(self, p: vec3, i: u32, by: f32) -> f32 {
        let (da, db) = pair_offsets(self.a, self.b, p, i, by)
        min(da, db)
    }

    fn parts(self) -> u32 {
        pair_parts(self.a, self.b)
    }

    /// The nearer operand's part; a tie takes `a`'s.
    fn part_at(self, p: vec3) -> (f32, u32) {
        let (da, ia) = self.a.part_at(p)
        let (db, ib) = self.b.part_at(p)
        (min(da, db), if da <= db { ia } else { self.a.parts() + ib })
    }

    fn part_distance(self, p: vec3, i: u32) -> f32 {
        pair_part_distance(self.a, self.b, p, i)
    }

    fn part_name(self, i: u32) -> PartName {
        pair_part_name(self.a, self.b, i)
    }

    /// The smaller distance's: where it's within `near`, so is the part's.
    fn lipschitz(self, near: f32) -> f32 {
        max(self.a.lipschitz(near), self.b.lipschitz(near))
    }

    fn rigid_shape_hash(self) -> Option<u64> {
        pair_shape_hash(1, self.a, self.b, 0.0)
    }
}

/// Two surfaces joined by a rounded seam: `a.smooth_union(b, k)`.
pub struct SmoothUnion<A, B>: Copy + GpuData + Eq + StateHash {
    pub a: A,
    pub b: B,
    pub k: f32,
}

impl<A: Surface, B: Surface> Surface for SmoothUnion<A, B> {
    /// Its operands' enclosures, joined by `smin` (`slope_smin`): their planes weighed as the
    /// seam weighs its operands across the box, lowered by the seam's depth there.
    fn slope_box<F: Copy + fn(vec3) -> vec3>(
        self,
        over: Box3,
        at: F,
        to: MapBox,
        live: Live,
        first: u32,
    ) -> SlopeBox {
        pair_slope(self.a, self.b, over, at, to, live, first, self.k)
    }

    fn part_state(self, i: u32, h: mut Hasher) -> bool {
        h.write_u32(canonical_bits(self.k))
        pair_part_state(self.a, self.b, i, mut h)
    }

    /// Its operand's part's bound lowered by how far the seam lets it reach (`smooth_reach`).
    fn part_bound(self, i: u32) -> Bound {
        pair_part_bound(self.a, self.b, i).lowered(smooth_reach(self.k))
    }

    /// Its operands' own, joined by `smin` (which never falls as either rises), within its own
    /// (`own_near`).
    fn interval_near(self, b: Box3) -> Interval {
        let x = self.interval(b)
        both(
            own_near(self, b, x),
            smin_range(self.a.interval_near(b), self.b.interval_near(b), self.k),
        )
    }

    fn distance(self, p: vec3) -> f32 {
        smin(self.a.distance(p), self.b.distance(p), self.k)
    }

    /// `a` asked within `k` past `most`, then `b` only within `k` of it: `smin` is `a` exactly
    /// where `b` is `k` or more above it, and below `a` by at most `k`, so this is `distance` bit
    /// for bit wherever it is below `most`.
    fn distance_within(self, p: vec3, most: f32) -> f32 {
        let a = self.a.distance_within(p, most + max(self.k, 0.0))
        smin(a, self.b.distance_within(p, a + max(self.k, 0.0)), self.k)
    }

    /// As `Union`'s: an operand none of whose parts is live isn't asked, and counts as `EMPTY`
    /// (`smin(d, EMPTY, k)` and `smin(EMPTY, d, k)` are `d`, bit for bit).
    fn masked(self, p: vec3, live: Live, first: u32) -> f32 {
        let k = self.k
        pair_masked(self.a, self.b, p, live, first, |x: f32, y: f32| smin(x, y, k))
    }

    /// An operand at least `k` above the other everywhere in the box changes nothing there:
    /// `smin` is then exactly the other (its seam is narrower than `k`).
    fn pruned<F: Copy + fn(vec3) -> vec3>(
        self,
        over: Box3,
        at: F,
        stretch: f32,
        live: Live,
        first: u32,
    ) -> Pruned {
        pair_pruned(self.a, self.b, over, at, stretch, live, first, self.k)
    }

    fn bound(self) -> Bound {
        self.a.bound().and(self.b.bound()).lowered(0.25 * max(self.k, 0.0))
    }

    fn filtered(self, p: vec3, footprint: f32) -> f32 {
        smin(self.a.filtered(p, footprint), self.b.filtered(p, footprint), self.k)
    }

    fn part_offset(self, p: vec3, i: u32, by: f32) -> f32 {
        let (da, db) = pair_offsets(self.a, self.b, p, i, by)
        smin(da, db, self.k)
    }

    fn parts(self) -> u32 {
        pair_parts(self.a, self.b)
    }

    /// The nearer operand's part: the one whose distance the blend follows most.
    fn part_at(self, p: vec3) -> (f32, u32) {
        let (da, ia) = self.a.part_at(p)
        let (db, ib) = self.b.part_at(p)
        (smin(da, db, self.k), if da <= db { ia } else { self.a.parts() + ib })
    }

    fn part_distance(self, p: vec3, i: u32) -> f32 {
        pair_part_distance(self.a, self.b, p, i)
    }

    fn part_name(self, i: u32) -> PartName {
        pair_part_name(self.a, self.b, i)
    }

    /// `smin`'s gradient mixes its parts' with weights that add up to 1. Where it's within
    /// `near`, the parts are within `near + 1.25 k`: the smaller is at most `k / 4` above it,
    /// and they blend only where they're less than `k` apart.
    fn lipschitz(self, near: f32) -> f32 {
        let scope = near + 1.25 * max(self.k, 0.0)
        max(self.a.lipschitz(scope), self.b.lipschitz(scope))
    }

    fn rigid_shape_hash(self) -> Option<u64> {
        pair_shape_hash(2, self.a, self.b, self.k)
    }
}

/// The parts of a fixed array of surfaces of one type, joined (§20): `legs.union()`,
/// `legs.smooth_union(k: 6cm)`. Each folds the parts in order, so `[a, b, c].union()` is
/// `a.union(b).union(c)`.
impl<S: Surface, const N: u32> [S; N] {
    /// The parts joined.
    pub fn union(self) -> UnionAll<S, N> {
        UnionAll { parts: self }
    }

    /// A union whose seams are rounded over a width of about `k`.
    pub fn smooth_union(self, k: f32) -> SmoothUnionAll<S, N> {
        SmoothUnionAll { parts: self, k }
    }
}

/// A fixed array of surfaces joined: `parts.union()`.
pub struct UnionAll<S, const N: u32>: Copy + GpuData + Eq + StateHash {
    pub parts: [S; N],
}

impl<S: Surface, const N: u32> Surface for UnionAll<S, N> {
    /// Its live parts' enclosures, folded by `min` in order (`slope_smin`).
    fn slope_box<F: Copy + fn(vec3) -> vec3>(
        self,
        over: Box3,
        at: F,
        to: MapBox,
        live: Live,
        first: u32,
    ) -> SlopeBox {
        array_slope(self.parts, over, at, to, live, first, 0.0)
    }

    fn part_state(self, i: u32, h: mut Hasher) -> bool {
        
        var first: u32 = 0
        for j in 0..N {
            let n = self.parts[j].parts()
            if i < first + n {
                return self.parts[j].part_state(i - first, mut h)
            }
            first += n
        }
        false
    }

    fn part_bound(self, i: u32) -> Bound {
        var first: u32 = 0
        for j in 0..N {
            let n = self.parts[j].parts()
            if i < first + n {
                return self.parts[j].part_bound(i - first)
            }
            first += n
        }
        self.bound()
    }

    /// Its parts' own, joined by `min`, within its own (`own_near`).
    fn interval_near(self, b: Box3) -> Interval {
        let x = self.interval(b)
        var v = Interval { lo: EMPTY, hi: EMPTY }
        for i in 0..N {
            v = smin_range(v, self.parts[i].interval_near(b), 0.0)
        }
        both(own_near(self, b, x), v)
    }

    /// The nearest part's distance; with no parts, nowhere near (`EMPTY`).
    fn distance(self, p: vec3) -> f32 {
        if N == 0 {
            return EMPTY
        }
        var d = self.parts[0].distance(p)
        for i in 1..N {
            d = min(d, self.parts[i].distance(p))
        }
        d
    }

    /// Each part asked within the nearest so far (`Union::distance_within`'s rule).
    fn distance_within(self, p: vec3, most: f32) -> f32 {
        var d = EMPTY
        for i in 0..N {
            d = min(d, self.parts[i].distance_within(p, min(most, d)))
        }
        d
    }

    /// The same `min`s, over the parts with a live part (`array_masked`).
    fn masked(self, p: vec3, live: Live, first: u32) -> f32 {
        array_masked(self.parts, p, live, first, |x: f32, y: f32| min(x, y))
    }

    /// A part that is nowhere in the box below the part whose range tops out lowest changes
    /// nothing there.
    fn pruned<F: Copy + fn(vec3) -> vec3>(
        self,
        over: Box3,
        at: F,
        stretch: f32,
        live: Live,
        first: u32,
    ) -> Pruned {
        var out = live
        var ranges = [Interval { lo: EMPTY, hi: EMPTY }; N]
        var firsts = [first; N]
        var f = first
        var best: u32 = 0
        for i in 0..N {
            let r = self.parts[i].pruned(over, at, stretch, out, f)
            out = r.live
            ranges[i] = r.range
            firsts[i] = f
            f += self.parts[i].parts()
            if ranges[i].hi < ranges[best].hi {
                best = i
            }
        }
        var range = Interval { lo: EMPTY, hi: EMPTY }
        if leaves_in_a_word(self.parts, first) {
            // Each part one part, all in one word of the mask: a bit a part, cleared by a shift
            // of the loop's counter (a mask of spans a pass is work every invocation would do
            // alike, which a shader can't hold: §18.13).
            var bits = leaf_bits(out, first, N)
            for i in 0..N {
                if i != best && apart(ranges[i].lo, ranges[best].hi, 0.0) {
                    bits = bits & (4294967295 ^ (u32(1) << i))
                } else {
                    range = Interval {
                        lo: min(range.lo, ranges[i].lo),
                        hi: min(range.hi, ranges[i].hi),
                    }
                }
            }
            return Pruned { live: out.with_leaf_bits(first, N, bits), range }
        }
        for i in 0..N {
            if i != best && apart(ranges[i].lo, ranges[best].hi, 0.0) {
                out = out.without(firsts[i], self.parts[i].parts())
            } else {
                range = Interval {
                    lo: min(range.lo, ranges[i].lo),
                    hi: min(range.hi, ranges[i].hi),
                }
            }
        }
        Pruned { live: out, range }
    }

    /// Its parts' bounds, joined (with no parts, unbounded: nothing to say where it is).
    fn bound(self) -> Bound {
        if N == 0 {
            return UNBOUNDED
        }
        var b = self.parts[0].bound()
        for i in 1..N {
            b = b.and(self.parts[i].bound())
        }
        b
    }

    fn filtered(self, p: vec3, footprint: f32) -> f32 {
        if N == 0 {
            return EMPTY
        }
        var d = self.parts[0].filtered(p, footprint)
        for i in 1..N {
            d = min(d, self.parts[i].filtered(p, footprint))
        }
        d
    }

    fn part_offset(self, p: vec3, i: u32, by: f32) -> f32 {
        let (m, j) = locate(self.parts, i)
        var d = EMPTY
        for k in 0..N {
            let dk = if k == m { self.parts[k].part_offset(p, j, by) } else {
                self.parts[k].distance(p)
            }
            d = min(d, dk)
        }
        d
    }

    fn parts(self) -> u32 {
        array_parts(self.parts)
    }

    /// The nearest operand's part; a tie takes the earlier's.
    fn part_at(self, p: vec3) -> (f32, u32) {
        var d = EMPTY
        var part = 0
        var first = 0
        for i in 0..N {
            let (di, pi) = self.parts[i].part_at(p)
            if di < d {
                part = first + pi
            }
            d = min(d, di)
            first += self.parts[i].parts()
        }
        (d, part)
    }

    fn part_distance(self, p: vec3, i: u32) -> f32 {
        array_part_distance(self.parts, p, i)
    }

    fn part_name(self, i: u32) -> PartName {
        array_part_name(self.parts, i)
    }

    fn lipschitz(self, near: f32) -> f32 {
        var l = 0.0
        for i in 0..N {
            l = max(l, self.parts[i].lipschitz(near))
        }
        l
    }
}

/// A fixed array of surfaces joined by rounded seams: `parts.smooth_union(k)`.
pub struct SmoothUnionAll<S, const N: u32>: Copy + GpuData + Eq + StateHash {
    pub parts: [S; N],
    pub k: f32,
}

impl<S: Surface, const N: u32> Surface for SmoothUnionAll<S, N> {
    /// Its live parts' enclosures, folded by `smin` in the order its distance folds them
    /// (`slope_smin`): each fold's error is its own seam's, so a fold of `N` parts is lowered at
    /// most as `fold_lowering` says, never `N - 1` quarters of `k`.
    fn slope_box<F: Copy + fn(vec3) -> vec3>(
        self,
        over: Box3,
        at: F,
        to: MapBox,
        live: Live,
        first: u32,
    ) -> SlopeBox {
        array_slope(self.parts, over, at, to, live, first, self.k)
    }

    fn part_state(self, i: u32, h: mut Hasher) -> bool {
        h.write_u32(canonical_bits(self.k))
        var first: u32 = 0
        for j in 0..N {
            let n = self.parts[j].parts()
            if i < first + n {
                return self.parts[j].part_state(i - first, mut h)
            }
            first += n
        }
        false
    }

    /// Its part's bound lowered by how far the fold lets it reach: the fold `F` takes part `j`
    /// at step `max(j, 1)` (`F_q = smin(F_q-1, d_q, k)`), where it changes `F` only below
    /// `smooth_reach` of it, and each later step changes the fold only where it was below
    /// `1.25 k` over the step's result (`F_q-1 < d_q + k`, and `F_q` at least the least of the
    /// two less `k / 4`), so where the whole is 0, part `j` reaches it from below
    /// `1.25 k (N - max(j, 1))`.
    fn part_bound(self, i: u32) -> Bound {
        var first: u32 = 0
        for j in 0..N {
            let n = self.parts[j].parts()
            if i < first + n {
                let steps = N - max(j, 1)
                return self.parts[j].part_bound(i - first).lowered(smooth_reach(self.k) * f32(steps))
            }
            first += n
        }
        self.bound()
    }

    /// Its parts' own, folded by `smin` as its distance is, within its own
    /// (`own_near`).
    fn interval_near(self, b: Box3) -> Interval {
        let x = self.interval(b)
        if N == 0 {
            return x
        }
        var v = self.parts[0].interval_near(b)
        for i in 1..N {
            v = smin_range(v, self.parts[i].interval_near(b), self.k)
        }
        both(own_near(self, b, x), v)
    }

    fn distance(self, p: vec3) -> f32 {
        if N == 0 {
            return EMPTY
        }
        var d = self.parts[0].distance(p)
        for i in 1..N {
            d = smin(d, self.parts[i].distance(p), self.k)
        }
        d
    }

    /// The same fold, each part after the first asked only within `k` of what is folded before
    /// it (`smin` gives what was folded, exactly, for a part `k` or more above it): `distance` bit
    /// for bit, its far parts left unasked.
    fn distance_within(self, p: vec3, most: f32) -> f32 {
        if N == 0 {
            return EMPTY
        }
        var d = self.parts[0].distance_within(p, EMPTY)
        for i in 1..N {
            d = smin(d, self.parts[i].distance_within(p, d + max(self.k, 0.0)), self.k)
        }
        d
    }

    /// The same fold over the parts with a live part, from `EMPTY` (`smin(EMPTY, d, k)` is `d`
    /// exactly, for any distance short of `EMPTY`; `array_masked`).
    fn masked(self, p: vec3, live: Live, first: u32) -> f32 {
        let k = self.k
        array_masked(self.parts, p, live, first, |x: f32, y: f32| smin(x, y, k))
    }

    /// The fold's own rules, over the box: a part at least `k` above everything folded before
    /// it changes nothing (`smin` gives what was folded), and a part at least `k` below
    /// everything folded before it starts the fold afresh (`smin` gives the part), so every
    /// part before it changes nothing. What's left folds as the whole does, bit for bit.
    fn pruned<F: Copy + fn(vec3) -> vec3>(
        self,
        over: Box3,
        at: F,
        stretch: f32,
        live: Live,
        first: u32,
    ) -> Pruned {
        if N == 0 {
            return Pruned { live, range: Interval { lo: EMPTY, hi: EMPTY } }
        }
        let k = max(self.k, 0.0)
        var out = live
        var ranges = [Interval { lo: EMPTY, hi: EMPTY }; N]
        var firsts = [first; N]
        var f = first
        for i in 0..N {
            let r = self.parts[i].pruned(over, at, stretch, out, f)
            out = r.live
            ranges[i] = r.range
            firsts[i] = f
            f += self.parts[i].parts()
        }
        var acc = ranges[0]
        if leaves_in_a_word(self.parts, first) {
            // As `UnionAll::pruned`'s: a bit a part; a part that starts the fold afresh clears
            // every bit below its own.
            var bits = leaf_bits(out, first, N)
            for j in 1..N {
                let r = ranges[j]
                if apart(r.lo, acc.hi, k) {
                    bits = bits & (4294967295 ^ (u32(1) << j))
                } else if apart(acc.lo, r.hi, k) {
                    bits = bits & (4294967295 ^ ((u32(1) << j) - 1))
                    acc = r
                } else {
                    acc = smin_range(acc, r, k)
                }
            }
            return Pruned { live: out.with_leaf_bits(first, N, bits), range: acc }
        }
        for j in 1..N {
            let r = ranges[j]
            if apart(r.lo, acc.hi, k) {
                out = out.without(firsts[j], self.parts[j].parts())
            } else if apart(acc.lo, r.hi, k) {
                out = out.without(first, firsts[j] - first)
                acc = r
            } else {
                acc = smin_range(acc, r, k)
            }
        }
        Pruned { live: out, range: acc }
    }

    /// Its parts' bounds, joined, and lowered once by the fold's whole lowering
    /// (`fold_lowering`: at most `k`, where a quarter of `k` a seam was `(N - 1) k / 4`). Where
    /// the fold is at most 0, some part's distance is at most that lowering, so the part's bound
    /// grown by it holds the point, and the joined bound grown by it holds that.
    fn bound(self) -> Bound {
        if N == 0 {
            return UNBOUNDED
        }
        var b = self.parts[0].bound()
        for i in 1..N {
            b = b.and(self.parts[i].bound())
        }
        b.lowered(fold_lowering(N, max(self.k, 0.0)))
    }

    fn filtered(self, p: vec3, footprint: f32) -> f32 {
        if N == 0 {
            return EMPTY
        }
        var d = self.parts[0].filtered(p, footprint)
        for i in 1..N {
            d = smin(d, self.parts[i].filtered(p, footprint), self.k)
        }
        d
    }

    fn part_offset(self, p: vec3, i: u32, by: f32) -> f32 {
        let (m, j) = locate(self.parts, i)
        var d = EMPTY
        for k in 0..N {
            let dk = if k == m { self.parts[k].part_offset(p, j, by) } else {
                self.parts[k].distance(p)
            }
            d = if k == 0 { dk } else { smin(d, dk, self.k) }
        }
        d
    }

    fn parts(self) -> u32 {
        array_parts(self.parts)
    }

    /// The part selected by the binary smooth unions folded in order.
    fn part_at(self, p: vec3) -> (f32, u32) {
        if N == 0 {
            return (EMPTY, 0)
        }
        let (d0, p0) = self.parts[0].part_at(p)
        var d = d0
        var part = p0
        var first = self.parts[0].parts()
        for i in 1..N {
            let (di, pi) = self.parts[i].part_at(p)
            if di < d {
                part = first + pi
            }
            d = smin(d, di, self.k)
            first += self.parts[i].parts()
        }
        (d, part)
    }

    fn part_distance(self, p: vec3, i: u32) -> f32 {
        array_part_distance(self.parts, p, i)
    }

    fn part_name(self, i: u32) -> PartName {
        array_part_name(self.parts, i)
    }

    /// As `SmoothUnion`'s, with the scope widened by `1.25 k` for each `smin` a part goes
    /// through: at most `N - 1`.
    fn lipschitz(self, near: f32) -> f32 {
        let scope = near + 1.25 * max(self.k, 0.0) * f32(max(N, 1) - 1)
        var l = 0.0
        for i in 0..N {
            l = max(l, self.parts[i].lipschitz(scope))
        }
        l
    }
}

/// The distance of a union of no parts: farther than anything a scene holds.
pub const EMPTY: f32 = 1.0e30

/// What two surfaces hold in common: `a.intersect(b)`.
pub struct Intersect<A, B>: Copy + GpuData + Eq + StateHash {
    pub a: A,
    pub b: B,
}

impl<A: Surface, B: Surface> Surface for Intersect<A, B> {
    /// Its operands' enclosures, joined by `max` (`slope_smax`). It asks all of both (its
    /// `masked` is its distance), so each operand's is of all its parts.
    fn slope_box<F: Copy + fn(vec3) -> vec3>(
        self,
        over: Box3,
        at: F,
        to: MapBox,
        live: Live,
        first: u32,
    ) -> SlopeBox {
        slope_smax(
            self.a.slope_box(over, at, to, ALL_LIVE, 0),
            self.b.slope_box(over, at, to, ALL_LIVE, 0),
            0.0,
        )
    }

    fn part_state(self, i: u32, h: mut Hasher) -> bool {
        
        pair_part_state(self.a, self.b, i, mut h)
    }

    fn part_bound(self, i: u32) -> Bound {
        pair_part_bound(self.a, self.b, i)
    }

    /// Its operands' own, joined by `max`, within its own (`own_near`).
    fn interval_near(self, b: Box3) -> Interval {
        let x = self.interval(b)
        both(
            own_near(self, b, x),
            smax_range(self.a.interval_near(b), self.b.interval_near(b), 0.0),
        )
    }

    fn distance(self, p: vec3) -> f32 {
        max(self.a.distance(p), self.b.distance(p))
    }

    fn bound(self) -> Bound {
        // Its distance is at least each operand's: the tighter bound holds.
        let (a, b) = (self.a.bound(), self.b.bound())
        if a.radius <= b.radius { a } else { b }
    }

    fn filtered(self, p: vec3, footprint: f32) -> f32 {
        max(self.a.filtered(p, footprint), self.b.filtered(p, footprint))
    }

    fn part_offset(self, p: vec3, i: u32, by: f32) -> f32 {
        let (da, db) = pair_offsets(self.a, self.b, p, i, by)
        max(da, db)
    }

    fn parts(self) -> u32 {
        pair_parts(self.a, self.b)
    }

    /// The farther operand's part; a tie takes `a`'s.
    fn part_at(self, p: vec3) -> (f32, u32) {
        let (da, ia) = self.a.part_at(p)
        let (db, ib) = self.b.part_at(p)
        (max(da, db), if da >= db { ia } else { self.a.parts() + ib })
    }

    fn part_distance(self, p: vec3, i: u32) -> f32 {
        pair_part_distance(self.a, self.b, p, i)
    }

    fn part_name(self, i: u32) -> PartName {
        pair_part_name(self.a, self.b, i)
    }

    fn lipschitz(self, near: f32) -> f32 {
        max(self.a.lipschitz(near), self.b.lipschitz(near))
    }

    fn rigid_shape_hash(self) -> Option<u64> {
        pair_shape_hash(3, self.a, self.b, 0.0)
    }
}

/// How a warp takes a point into its surface's own space (`translate`, `rotate`, `scale`), and
/// its distances back: what each combinator that moves the point does, while the warp passes
/// every method of the surface on through it, once for all of them.
pub trait PointMap: Copy + GpuData {
    /// Writes what the map is made of into `h`, and says whether it can (`Surface::part_state`):
    /// a map std doesn't know can't.
    fn map_state(self, h: mut Hasher) -> bool {
        false
    }

    /// `p` in the surface's own space.
    fn local(self, p: vec3) -> vec3

    /// A distance in the surface's own space, in this one.
    fn distance_out(self, d: f32) -> f32 {
        d
    }

    /// A distance in this space, in the surface's own.
    fn distance_in(self, d: f32) -> f32 {
        d
    }

    /// A length in this space (a footprint, a bound's scope), in the surface's own.
    fn length_in(self, x: f32) -> f32 {
        x
    }

    /// The surface's bound (`Surface::bound`), in this space. Every map states it, as every
    /// surface does.
    fn bound(self, b: Bound) -> Bound

    /// A box holding `local(p)` for every `p` in `b`: what a join's range is asked over in the
    /// surface's own space (`Surface::interval_near`). Every map states it.
    fn box_in(self, b: Box3) -> Box3

    /// If this map is an orientation-preserving rigid similarity (`s > 0`), its local-to-world
    /// matrix; `None` otherwise.
    fn rigid(self) -> Option<Rigid> {
        None
    }

    /// Where the maps above take a box, to first order (`MapBox`), with this map after them:
    /// what `Surface::slope_box` hands the surface. Every map states it.
    fn through(self, to: MapBox) -> MapBox

    /// An enclosure of the surface's distance, as one of `distance_out` of it. A map whose
    /// `distance_out` is not the distance itself states it.
    fn slope_out(self, sb: SlopeBox) -> SlopeBox {
        sb
    }
}

/// A surface whose points are moved before it's asked about them: `s.translate(by)`,
/// `s.rotate(by)` and `s.scale(by)`, each a `PointMap`.
pub struct Warp<S, M>: Copy + GpuData + Eq + StateHash {
    pub inner: S,
    pub map: M,
}

impl<S: Surface, M: PointMap> Surface for Warp<S, M> {
    const MAY_SKIN: bool = S::MAY_SKIN

    /// Its surface's enclosure through its map too (`PointMap::through`), as a distance in
    /// this space (`PointMap::slope_out`).
    fn slope_box<F: Copy + fn(vec3) -> vec3>(
        self,
        over: Box3,
        at: F,
        to: MapBox,
        live: Live,
        first: u32,
    ) -> SlopeBox {
        let map = self.map
        map.slope_out(
            self.inner.slope_box(over, |q: vec3| map.local(at(q)), map.through(to), live, first),
        )
    }

    fn part_state(self, i: u32, h: mut Hasher) -> bool {
        self.map.map_state(mut h) && self.inner.part_state(i, mut h)
    }

    fn part_bound(self, i: u32) -> Bound {
        self.map.bound(self.inner.part_bound(i))
    }

    /// Its surface's own over the box moved in (`PointMap::box_in`), moved out, within its own
    /// (`own_near`).
    fn interval_near(self, b: Box3) -> Interval {
        let x = self.interval(b)
        let v = self.inner.interval_near(self.map.box_in(b))
        let (lo, hi) = (self.map.distance_out(v.lo), self.map.distance_out(v.hi))
        both(own_near(self, b, x), Interval { lo: min(lo, hi), hi: max(lo, hi) })
    }

    fn distance(self, p: vec3) -> f32 {
        self.map.distance_out(self.inner.distance(self.map.local(p)))
    }

    fn masked(self, p: vec3, live: Live, first: u32) -> f32 {
        self.map.distance_out(self.inner.masked(self.map.local(p), live, first))
    }

    /// The inner surface's, asked where the map takes each point; its range in this space
    /// (`distance_out` rises with the distance, and so does its rounding).
    fn pruned<F: Copy + fn(vec3) -> vec3>(
        self,
        over: Box3,
        at: F,
        stretch: f32,
        live: Live,
        first: u32,
    ) -> Pruned {
        let map = self.map
        let r = self.inner.pruned(
            over,
            |q: vec3| map.local(at(q)),
            map.length_in(stretch),
            live,
            first,
        )
        Pruned {
            live: r.live,
            range: Interval { lo: map.distance_out(r.range.lo), hi: map.distance_out(r.range.hi) },
        }
    }

    fn bound(self) -> Bound {
        self.map.bound(self.inner.bound())
    }

    fn filtered(self, p: vec3, footprint: f32) -> f32 {
        self.map.distance_out(self.inner.filtered(self.map.local(p), self.map.length_in(footprint)))
    }

    /// `by` is in this surface's units: the inner surface's part is raised by as much in its
    /// own.
    fn part_offset(self, p: vec3, i: u32, by: f32) -> f32 {
        self.map.distance_out(
            self.inner.part_offset(self.map.local(p), i, self.map.distance_in(by)),
        )
    }

    fn parts(self) -> u32 {
        self.inner.parts()
    }

    fn part_at(self, p: vec3) -> (f32, u32) {
        let (d, i) = self.inner.part_at(self.map.local(p))
        (self.map.distance_out(d), i)
    }

    fn part_distance(self, p: vec3, i: u32) -> f32 {
        self.map.distance_out(self.inner.part_distance(self.map.local(p), i))
    }

    fn part_name(self, i: u32) -> PartName {
        self.inner.part_name(i)
    }

    /// Moving, turning and scaling keep a gradient's length; the scope is the inner surface's.
    fn lipschitz(self, near: f32) -> f32 {
        self.inner.lipschitz(self.map.length_in(near))
    }

    fn rigid_frame(self) -> Rigid {
        match self.map.rigid() {
            Some(outer) => outer.compose(self.inner.rigid_frame()),
            None => Rigid::identity(),
        }
    }

    fn rigid_shape_hash(self) -> Option<u64> {
        match self.map.rigid() {
            Some(_) => self.inner.rigid_shape_hash(),
            None => None,
        }
    }

    fn skin_shape_hash(self) -> Option<u64> {
        match self.map.rigid() {
            Some(_) => self.inner.skin_shape_hash(),
            None => None,
        }
    }

    fn rest_distance_live(self, p: vec3, live: Live) -> f32 {
        self.inner.rest_distance_live(p, live)
    }

    fn rest_pruned<F: Copy + fn(vec3) -> vec3>(
        self,
        over: Box3,
        at: F,
        stretch: f32,
        live: Live,
        first: u32,
    ) -> Pruned {
        self.inner.rest_pruned(over, at, stretch, live, first)
    }

    fn rest_bound(self) -> Bound {
        self.inner.rest_bound()
    }

    fn rest_interval_near(self, b: Box3) -> Interval {
        self.inner.rest_interval_near(b)
    }

    fn rest_skin_weights(self, p: vec3) -> vec2u {
        self.inner.rest_skin_weights(p)
    }

    fn skin_bone_count(self) -> u32 {
        self.inner.skin_bone_count()
    }

    fn skin_bone(self, i: u32) -> DualQuat {
        self.inner.skin_bone(i)
    }

    fn posed_local_distance(self, p: vec3) -> f32 {
        self.inner.posed_local_distance(p)
    }
}

/// A surface moved by `by`: `s.translate(by)`.
pub type Translate<S> = Warp<S, Shift>

/// A surface turned about the origin: `s.rotate(by)`.
pub type Rotate<S> = Warp<S, Turn>

/// A surface scaled about the origin: `s.scale(by)`. Distances scale with it, so a distance
/// stays a distance. The scale is nonzero; `Surface::scale` enforces that invariant.
pub type Scale<S> = Warp<S, Size>

/// Moved by `by`.
pub struct Shift: Copy + GpuData + Eq + StateHash {
    pub by: vec3,
}

impl PointMap for Shift {
    fn map_state(self, h: mut Hasher) -> bool {
        self.state_hash(mut h)
        true
    }

    fn local(self, p: vec3) -> vec3 {
        p - self.by
    }

    fn bound(self, b: Bound) -> Bound {
        b.moved(self.by)
    }

    /// Moved: `local` is monotone in each axis, so the corners' images hold the rest.
    fn box_in(self, b: Box3) -> Box3 {
        Box3 { lo: self.local(b.lo), hi: self.local(b.hi) }
    }

    fn rigid(self) -> Option<Rigid> {
        Some(Rigid::translation(self.by))
    }

    fn through(self, to: MapBox) -> MapBox {
        to.moved(self.by, self.local(to.at))
    }
}

/// Turned about the origin: `to_local` takes a point into the surface's own space.
pub struct Turn: Copy + GpuData + Eq + StateHash {
    pub to_local: mat3,
}

impl PointMap for Turn {
    fn map_state(self, h: mut Hasher) -> bool {
        self.state_hash(mut h)
        true
    }

    /// Column by column, as a derived interval needs (it has no matrix arithmetic).
    fn local(self, p: vec3) -> vec3 {
        let m = self.to_local
        m[0] * p.x + m[1] * p.y + m[2] * p.z
    }

    /// Its centre turned back: `to_local` is a rotation, so its inverse is its transpose, and
    /// the radius and slope stay.
    fn bound(self, b: Bound) -> Bound {
        let m = self.to_local
        Bound { centre: vec3(dot(m[0], b.centre), dot(m[1], b.centre), dot(m[2], b.centre)), ..b }
    }

    /// Its centre turned, its half-widths by the turn's entries' sizes, widened by the rounding
    /// of `local`'s sums and of this one's (each a few ulps of the sizes it sums: 2e-6 of them).
    fn box_in(self, b: Box3) -> Box3 {
        let m = self.to_local
        let h = 0.5 * (b.hi - b.lo)
        let o = 0.5 * (b.lo + b.hi)
        let c = self.local(o)
        let w = abs(m[0]) * h.x + abs(m[1]) * h.y + abs(m[2]) * h.z
        let size = abs(m[0]) * (abs(o.x) + h.x) +
            abs(m[1]) * (abs(o.y) + h.y) +
            abs(m[2]) * (abs(o.z) + h.z)
        let e = size * 2.0e-6 + vec3(1.0e-30)
        Box3 { lo: c - w - e, hi: c + w + e }
    }

    fn rigid(self) -> Option<Rigid> {
        Some(Rigid::rotation(self.to_local))
    }

    /// `local`'s rows: its columns' components.
    fn through(self, to: MapBox) -> MapBox {
        let m = self.to_local
        to.turned(
            vec3(m[0].x, m[1].x, m[2].x),
            vec3(m[0].y, m[1].y, m[2].y),
            vec3(m[0].z, m[1].z, m[2].z),
            self.local(to.at),
        )
    }
}

/// Scaled by `by` about the origin.
pub struct Size: Copy + GpuData + Eq + StateHash {
    by: f32,
}

impl PointMap for Size {
    fn map_state(self, h: mut Hasher) -> bool {
        self.state_hash(mut h)
        true
    }

    fn local(self, p: vec3) -> vec3 {
        p / self.by
    }

    fn distance_out(self, d: f32) -> f32 {
        d * abs(self.by)
    }

    fn distance_in(self, d: f32) -> f32 {
        d / abs(self.by)
    }

    fn length_in(self, x: f32) -> f32 {
        x / abs(self.by)
    }

    /// Scaled with it; an unbounded surface stays unbounded (its radius isn't a size).
    fn bound(self, b: Bound) -> Bound {
        if b.radius >= 1.0e30 {
            return UNBOUNDED
        }
        Bound { centre: b.centre * self.by, radius: b.radius * abs(self.by), slope: b.slope }
    }

    /// Divided by the factor: its corners' images, ordered (a negative factor swaps them).
    fn box_in(self, b: Box3) -> Box3 {
        let (u, v) = (self.local(b.lo), self.local(b.hi))
        Box3 { lo: min(u, v), hi: max(u, v) }
    }

    fn rigid(self) -> Option<Rigid> {
        if self.by > 0.0 {
            Some(Rigid::uniform_scale(self.by))
        } else {
            None
        }
    }

    fn through(self, to: MapBox) -> MapBox {
        to.scaled(self.by, self.local(to.at))
    }

    fn slope_out(self, sb: SlopeBox) -> SlopeBox {
        slope_scale(sb, abs(self.by))
    }
}

/// A surface with noise added to its distance: `s.displace(noise, amp)`.
pub struct Displace<S, N>: Copy + GpuData + Eq + StateHash {
    pub inner: S,
    pub noise: N,
    pub amp: f32,
}

impl<S, N: Noise> Displace<S, N> {
    /// The most the displacement moves the distance, either way.
    fn reach(self) -> f32 {
        let r = self.noise.range()
        abs(self.amp) * max(abs(r.lo), abs(r.hi))
    }
}

impl<S: Surface, N: Noise> Surface for Displace<S, N> {
    fn part_state(self, i: u32, h: mut Hasher) -> bool {
        h.write_u32(canonical_bits(self.amp))
        self.noise.noise_state(mut h) && self.inner.part_state(i, mut h)
    }

    fn part_bound(self, i: u32) -> Bound {
        self.inner.part_bound(i).lowered(self.reach())
    }

    fn distance(self, p: vec3) -> f32 {
        self.inner.distance(p) + self.amp * self.noise.value(p)
    }

    fn masked(self, p: vec3, live: Live, first: u32) -> f32 {
        self.inner.masked(p, live, first) + self.amp * self.noise.value(p)
    }

    /// Its surface's enclosure plus its displacement's: the compiler's form of `amp` times the
    /// noise over the box (`slope_of_form`), which keeps the noise's slopes where its range and
    /// its steepness alone would be a ball about its value (no tighter than its interval, which
    /// the form's range is held within).
    fn slope_box<F: Copy + fn(vec3) -> vec3>(
        self,
        over: Box3,
        at: F,
        to: MapBox,
        live: Live,
        first: u32,
    ) -> SlopeBox {
        let s = self.inner.slope_box(over, at, to, live, first)
        let (noise, amp) = (self.noise, self.amp)
        let n = slope_of_form(
            affine_form(|q: vec3| amp * noise.value(at(q)), over),
            interval(|q: vec3| amp * noise.value(at(q)), over),
        )
        slope_add(s, n)
    }

    /// The inner surface's (a displacement moves every operand of a union inside it alike),
    /// and its range plus the displacement's.
    fn pruned<F: Copy + fn(vec3) -> vec3>(
        self,
        over: Box3,
        at: F,
        stretch: f32,
        live: Live,
        first: u32,
    ) -> Pruned {
        let r = self.inner.pruned(over, at, stretch, live, first)
        let (noise, amp) = (self.noise, self.amp)
        let n = interval(|q: vec3| amp * noise.value(at(q)), over)
        Pruned {
            live: r.live,
            range: outward(Interval { lo: r.range.lo + n.lo, hi: r.range.hi + n.hi }),
        }
    }

    fn bound(self) -> Bound {
        self.inner.bound().lowered(self.reach())
    }

    fn filtered(self, p: vec3, footprint: f32) -> f32 {
        self.inner.filtered(p, footprint) + self.amp * self.noise.filtered(p, vec3(footprint))
    }

    fn part_offset(self, p: vec3, i: u32, by: f32) -> f32 {
        self.inner.part_offset(p, i, by) + self.amp * self.noise.value(p)
    }

    fn parts(self) -> u32 {
        self.inner.parts()
    }

    fn part_at(self, p: vec3) -> (f32, u32) {
        let (d, i) = self.inner.part_at(p)
        (d + self.amp * self.noise.value(p), i)
    }

    fn part_distance(self, p: vec3, i: u32) -> f32 {
        self.inner.part_distance(p, i) + self.amp * self.noise.value(p)
    }

    fn part_name(self, i: u32) -> PartName {
        self.inner.part_name(i)
    }

    /// The inner surface's bound, where it's within `near` plus the displacement's reach, and
    /// the noise's, scaled by the amplitude.
    fn lipschitz(self, near: f32) -> f32 {
        self.inner.lipschitz(near + self.reach()) + abs(self.amp) * self.noise.lipschitz()
    }

    /// The inner surface's, plus the noise's range scaled by the amplitude: no noise evaluated,
    /// and narrower than the noise's steepness allows. Widened by the rounding of the noise's
    /// sum and of this one.
    fn interval_near(self, b: Box3) -> Interval {
        let x = self.inner.interval_near(b)
        let r = self.noise.range()
        let e = 1.0e-5 * max(abs(r.lo), abs(r.hi))
        let (a, c) = (self.amp * (r.lo - e), self.amp * (r.hi + e))
        let lo = x.lo + min(a, c)
        let hi = x.hi + max(a, c)
        Interval { lo: lo - 1.0e-6 * abs(lo), hi: hi + 1.0e-6 * abs(hi) }
    }
}

/// The smooth maximum of two distances: `-smin(-a, -b, k)`. Where they're `k` or more apart
/// it's exactly the larger; with `k <= 0` it's `max(a, b)`.
///
/// Written as that, with no negation: negating is exact and rounding to nearest is symmetric,
/// so `-(-a - p)` and `a + p` are the same bits, but the M4's shader compiler folds the
/// negations of `-smin(-a, -b, k)` into a sum and fuses it into one rounding in a strict kernel
/// whatever its contraction is set to (`fp contract(off)`): SCENE 6's CSG-cut column had 10 of
/// 32,768 strict corners a bit off the CPU's (`judge::bits`), and a probe 6,192 of 262,144.
pub fn smax(a: f32, b: f32, k: f32) -> f32 {
    let s = 0.25 / max(k, 1.1754944e-38)
    let d = a - b
    if d > 0.0 {
        let m = max(k - d, 0.0)
        a + m * (m * s)
    } else {
        // As `smin`'s tie: at a tie it carries `d`'s derivative, and two equal infinite
        // distances are 0 apart; a NaN still makes a NaN.
        let m = max(k + select(if_false: d, if_true: 0.0, cond: d != d && a == a && b == b), 0.0)
        b + m * (m * s)
    }
}

/// `(v / max(|v|, r0))^n` as a complex number: the cosine and sine of `n` times `v`'s angle about
/// the origin, faded toward it as `(|v| / r0)^n` inside `r0`, so it has no singularity there
/// (flutes, gadroons, a rosette's petals: `n` of them round a circle). By squaring, so a wave of
/// `n` takes about `2 log2 n` complex products.
fn wave(v: vec2, r0: f32, n: u32) -> vec2 {
    let z = clamp(v / max(length(v), r0), vec2(-1.0), vec2(1.0))
    var acc = vec2(1.0, 0.0)
    var base = z
    var k = n
    for _ in 0..32 {
        if k == 0 {
            break
        }
        if (k & 1) != 0 {
            acc = vec2(acc.x * base.x - acc.y * base.y, acc.x * base.y + acc.y * base.x)
        }
        base = vec2(base.x * base.x - base.y * base.y, 2.0 * base.x * base.y)
        k = k >> 1
    }
    acc
}

/// The real part of `wave(v, r0, n)`: `cos(n θ)`, faded inside `r0`. Its gradient is no longer
/// than `n / r0` times `v`'s, which the compiler's steepness of it knows (`ir::Known::WaveCos`).
pub fn wave_cos(v: vec2, r0: f32, n: u32) -> f32 {
    wave(v, r0, n).x
}

/// The imaginary part of `wave(v, r0, n)`: `sin(n θ)`, faded inside `r0` (`wave_cos`'s).
pub fn wave_sin(v: vec2, r0: f32, n: u32) -> f32 {
    wave(v, r0, n).y
}

/// `a` with `b` cut out of it: `a.smooth_subtract(b, k)`.
pub struct SmoothSubtract<A, B>: Copy + GpuData + Eq + StateHash {
    pub a: A,
    pub b: B,
    pub k: f32,
}

impl<A: Surface, B: Surface> Surface for SmoothSubtract<A, B> {
    /// `a`'s enclosure joined by `smax` with `b`'s negated (`slope_smax`, which is `slope_smin`
    /// of the negated operands, negated). It asks all of both.
    fn slope_box<F: Copy + fn(vec3) -> vec3>(
        self,
        over: Box3,
        at: F,
        to: MapBox,
        live: Live,
        first: u32,
    ) -> SlopeBox {
        slope_smax(
            self.a.slope_box(over, at, to, ALL_LIVE, 0),
            slope_neg(self.b.slope_box(over, at, to, ALL_LIVE, 0)),
            self.k,
        )
    }

    fn part_state(self, i: u32, h: mut Hasher) -> bool {
        h.write_u32(canonical_bits(self.k))
        pair_part_state(self.a, self.b, i, mut h)
    }

    /// Its operand's part's bound lowered by how far the seam lets it reach (`smooth_reach`).
    fn part_bound(self, i: u32) -> Bound {
        pair_part_bound(self.a, self.b, i).lowered(smooth_reach(self.k))
    }

    /// Its operands' own, `a`'s joined by `smax` with `b`'s negated, within its own
    /// (`own_near`).
    fn interval_near(self, b: Box3) -> Interval {
        let x = self.interval(b)
        let cut = negated(self.b.interval_near(b))
        both(own_near(self, b, x), smax_range(self.a.interval_near(b), cut, self.k))
    }

    fn distance(self, p: vec3) -> f32 {
        smax(self.a.distance(p), -self.b.distance(p), self.k)
    }

    /// `a`'s: the smooth maximum is at least the larger, so at least `a`'s distance.
    fn bound(self) -> Bound {
        self.a.bound()
    }

    fn filtered(self, p: vec3, footprint: f32) -> f32 {
        smax(self.a.filtered(p, footprint), -self.b.filtered(p, footprint), self.k)
    }

    fn part_offset(self, p: vec3, i: u32, by: f32) -> f32 {
        let (da, db) = pair_offsets(self.a, self.b, p, i, by)
        smax(da, -db, self.k)
    }

    fn parts(self) -> u32 {
        pair_parts(self.a, self.b)
    }

    /// The cutter's part where the cut is the surface (inside `b`, farther than `a`), else
    /// `a`'s.
    fn part_at(self, p: vec3) -> (f32, u32) {
        let (da, ia) = self.a.part_at(p)
        let (db, ib) = self.b.part_at(p)
        (smax(da, -db, self.k), if da >= -db { ia } else { self.a.parts() + ib })
    }

    fn part_distance(self, p: vec3, i: u32) -> f32 {
        pair_part_distance(self.a, self.b, p, i)
    }

    fn part_name(self, i: u32) -> PartName {
        pair_part_name(self.a, self.b, i)
    }

    /// A smooth maximum's gradient is a weighted mean of its operands', so the larger bound.
    /// Where it's within `near`, its operands are within `near + 1.25 k`: it can be `k / 4`
    /// above the larger, and the smaller contributes while they're less than `k` apart.
    fn lipschitz(self, near: f32) -> f32 {
        let scope = near + 1.25 * max(self.k, 0.0)
        max(self.a.lipschitz(scope), self.b.lipschitz(scope))
    }

    fn rigid_shape_hash(self) -> Option<u64> {
        pair_shape_hash(4, self.a, self.b, self.k)
    }
}

/// What two surfaces hold in common, rounded: `a.smooth_intersect(b, k)`.
pub struct SmoothIntersect<A, B>: Copy + GpuData + Eq + StateHash {
    pub a: A,
    pub b: B,
    pub k: f32,
}

impl<A: Surface, B: Surface> Surface for SmoothIntersect<A, B> {
    /// Its operands' enclosures, joined by `smax` (`slope_smax`). It asks all of both.
    fn slope_box<F: Copy + fn(vec3) -> vec3>(
        self,
        over: Box3,
        at: F,
        to: MapBox,
        live: Live,
        first: u32,
    ) -> SlopeBox {
        slope_smax(
            self.a.slope_box(over, at, to, ALL_LIVE, 0),
            self.b.slope_box(over, at, to, ALL_LIVE, 0),
            self.k,
        )
    }

    fn part_state(self, i: u32, h: mut Hasher) -> bool {
        h.write_u32(canonical_bits(self.k))
        pair_part_state(self.a, self.b, i, mut h)
    }

    /// Its operand's part's bound lowered by how far the seam lets it reach (`smooth_reach`).
    fn part_bound(self, i: u32) -> Bound {
        pair_part_bound(self.a, self.b, i).lowered(smooth_reach(self.k))
    }

    /// Its operands' own, joined by `smax`, within its own (`own_near`).
    fn interval_near(self, b: Box3) -> Interval {
        let x = self.interval(b)
        both(
            own_near(self, b, x),
            smax_range(self.a.interval_near(b), self.b.interval_near(b), self.k),
        )
    }

    fn distance(self, p: vec3) -> f32 {
        smax(self.a.distance(p), self.b.distance(p), self.k)
    }

    /// The tighter operand's: the smooth maximum is at least each distance.
    fn bound(self) -> Bound {
        let (a, b) = (self.a.bound(), self.b.bound())
        if a.radius <= b.radius { a } else { b }
    }

    fn filtered(self, p: vec3, footprint: f32) -> f32 {
        smax(self.a.filtered(p, footprint), self.b.filtered(p, footprint), self.k)
    }

    fn part_offset(self, p: vec3, i: u32, by: f32) -> f32 {
        let (da, db) = pair_offsets(self.a, self.b, p, i, by)
        smax(da, db, self.k)
    }

    fn parts(self) -> u32 {
        pair_parts(self.a, self.b)
    }

    /// The farther operand's part; a tie takes `a`'s.
    fn part_at(self, p: vec3) -> (f32, u32) {
        let (da, ia) = self.a.part_at(p)
        let (db, ib) = self.b.part_at(p)
        (smax(da, db, self.k), if da >= db { ia } else { self.a.parts() + ib })
    }

    fn part_distance(self, p: vec3, i: u32) -> f32 {
        pair_part_distance(self.a, self.b, p, i)
    }

    fn part_name(self, i: u32) -> PartName {
        pair_part_name(self.a, self.b, i)
    }

    fn lipschitz(self, near: f32) -> f32 {
        let scope = near + 1.25 * max(self.k, 0.0)
        max(self.a.lipschitz(scope), self.b.lipschitz(scope))
    }

    fn rigid_shape_hash(self) -> Option<u64> {
        pair_shape_hash(5, self.a, self.b, self.k)
    }
}

/// A surface and its mirror image in x = 0: `s.mirror_x()`.
pub struct Mirror<S>: Copy + GpuData + Eq + StateHash {
    pub inner: S,
}

/// `p` reflected into x ≥ 0, where a mirrored surface is written.
fn mirrored(p: vec3) -> vec3 {
    vec3(abs(p.x), p.y, p.z)
}

/// A point's image in x = 0.
fn mirrored_centre(c: vec3) -> vec3 {
    vec3(-c.x, c.y, c.z)
}

impl<S: Surface> Surface for Mirror<S> {
    /// Its surface's enclosure through the fold into x >= 0 too (`MapBox::folded`). It asks all
    /// of its surface.
    fn slope_box<F: Copy + fn(vec3) -> vec3>(
        self,
        over: Box3,
        at: F,
        to: MapBox,
        live: Live,
        first: u32,
    ) -> SlopeBox {
        self.inner.slope_box(
            over,
            |q: vec3| mirrored(at(q)),
            to.folded(vec3(1.0, 0.0, 0.0)),
            ALL_LIVE,
            0,
        )
    }

    fn part_state(self, i: u32, h: mut Hasher) -> bool {
        self.inner.part_state(i, mut h)
    }

    fn part_bound(self, i: u32) -> Bound {
        let b = self.inner.part_bound(i)
        b.and(Bound { centre: mirrored_centre(b.centre), ..b })
    }

    /// Its surface's own over the box mirrored into x >= 0, within its own
    /// (`own_near`).
    fn interval_near(self, b: Box3) -> Interval {
        let x = self.interval(b)
        let ax = if b.lo.x >= 0.0 { vec2(b.lo.x, b.hi.x) } else if b.hi.x <= 0.0 {
            vec2(-b.hi.x, -b.lo.x)
        } else { vec2(0.0, max(-b.lo.x, b.hi.x)) }
        let m = Box3 { lo: vec3(ax.x, b.lo.y, b.lo.z), hi: vec3(ax.y, b.hi.y, b.hi.z) }
        both(own_near(self, b, x), self.inner.interval_near(m))
    }

    fn distance(self, p: vec3) -> f32 {
        self.inner.distance(mirrored(p))
    }

    /// The surface's bound and its image's, joined.
    fn bound(self) -> Bound {
        let b = self.inner.bound()
        b.and(Bound { centre: mirrored_centre(b.centre), ..b })
    }

    fn filtered(self, p: vec3, footprint: f32) -> f32 {
        self.inner.filtered(mirrored(p), footprint)
    }

    /// A part as written decides at x ≥ 0, its image at x < 0 (as `part_at` has it).
    fn part_offset(self, p: vec3, i: u32, by: f32) -> f32 {
        let n = self.inner.parts()
        let image = p.x < 0.0
        if (i < n) != image {
            self.inner.part_offset(mirrored(p), i % n, by)
        } else {
            self.inner.distance(mirrored(p))
        }
    }

    /// Its own parts, as written (at x ≥ 0), then their images.
    fn parts(self) -> u32 {
        2 * self.inner.parts()
    }

    fn part_at(self, p: vec3) -> (f32, u32) {
        let (d, i) = self.inner.part_at(mirrored(p))
        (d, if p.x < 0.0 { self.inner.parts() + i } else { i })
    }

    fn part_distance(self, p: vec3, i: u32) -> f32 {
        let n = self.inner.parts()
        if i < n {
            self.inner.part_distance(p, i)
        } else {
            self.inner.part_distance(vec3(-p.x, p.y, p.z), i - n)
        }
    }

    fn part_name(self, i: u32) -> PartName {
        let n = self.inner.parts()
        if i < n {
            self.inner.part_name(i)
        } else {
            var name = self.inner.part_name(i - n)
            name.mirrored = !name.mirrored
            name
        }
    }

    fn lipschitz(self, near: f32) -> f32 {
        self.inner.lipschitz(near)
    }
}

/// A surface that is one part, named: `s.named(name)`.
pub struct Named<S>: Copy + GpuData + Eq + StateHash {
    pub inner: S,
    pub name: Text,
}

impl<S: Surface> Surface for Named<S> {
    /// Its surface's. It is one part and asks all of its surface.
    fn slope_box<F: Copy + fn(vec3) -> vec3>(
        self,
        over: Box3,
        at: F,
        to: MapBox,
        live: Live,
        first: u32,
    ) -> SlopeBox {
        self.inner.slope_box(over, at, to, ALL_LIVE, 0)
    }

    fn part_state(self, i: u32, h: mut Hasher) -> bool {
        self.inner.part_state(i, mut h)
    }

    fn part_bound(self, i: u32) -> Bound {
        self.inner.part_bound(i)
    }

    fn distance(self, p: vec3) -> f32 {
        self.inner.distance(p)
    }

    fn bound(self) -> Bound {
        self.inner.bound()
    }

    fn filtered(self, p: vec3, footprint: f32) -> f32 {
        self.inner.filtered(p, footprint)
    }

    fn part_name(self, i: u32) -> PartName {
        PartName { name: self.name, group: "", frame: "", mirrored: false }
    }

    fn lipschitz(self, near: f32) -> f32 {
        self.inner.lipschitz(near)
    }

    fn interval_near(self, b: Box3) -> Interval {
        self.inner.interval_near(b)
    }
}

// ---- noise --------------------------------------------------------------------------------------

/// A 32-bit integer hash (PCG-style, `std::hash::pcg` of an advanced state), the same bits on the
/// CPU and the GPU.
pub fn hash_u32(x: u32) -> u32 {
    pcg(x.wrapping_mul(747796405).wrapping_add(2891336453))
}

/// `i32(x)` for a whole number `x`, wrapped to 32 bits as the lattice's hash wraps its
/// coordinates: `x`'s low 32 bits beyond the i32 range, and 0 for inf or NaN.
pub fn lattice_coord(x: f32) -> i32 {
    if abs(x) < 2147483648.0 {
        return i32(x)
    }
    // Exact: at |x| >= 2^31 an f32 is a multiple of 2^8, and so is this, which is below 2^32.
    let low = x - 4294967296.0 * floor(x / 4294967296.0)
    if low == low {
        i32(u32(low))
    } else {
        0
    }
}

/// A pseudo-random value in [-1, 1] for an integer lattice point.
pub fn lattice(x: i32, y: i32, z: i32) -> f32 {
    let h = hash_u32(u32(x).wrapping_add(hash_u32(u32(y).wrapping_add(hash_u32(u32(z))))))
    f32(h) * (2.0 / 4294967295.0) - 1.0
}

/// Value noise with a quintic fade: in [-1, 1], smooth, one lattice cell per unit. NaN where a
/// coordinate is infinite or NaN.
pub fn value_noise(p: vec3) -> f32 {
    let fl = floor(p)
    let ix = lattice_coord(fl.x)
    let iy = lattice_coord(fl.y)
    let iz = lattice_coord(fl.z)
    let f = p - fl
    // `saturate` changes no value (the fade maps [0, 1] onto itself), but it tells an interval
    // the fade stays in [0, 1] even across a cell boundary, where `f` alone can't.
    let u = saturate(f * f * f * (f * (f * 6.0 - 15.0) + 10.0))
    let (jx, jy, jz) = (ix.wrapping_add(1), iy.wrapping_add(1), iz.wrapping_add(1))
    let a = lattice(ix, iy, iz)
    let b = lattice(jx, iy, iz)
    let c = lattice(ix, jy, iz)
    let d = lattice(jx, jy, iz)
    let e = lattice(ix, iy, jz)
    let f1 = lattice(jx, iy, jz)
    let g = lattice(ix, jy, jz)
    let h = lattice(jx, jy, jz)
    mix(mix(mix(a, b, u.x), mix(c, d, u.x), u.y), mix(mix(e, f1, u.x), mix(g, h, u.x), u.y), u.z)
}

/// The integral of value noise's interpolation kernel, K(t) = fade(1 − |t|), from 0 to t: odd,
/// and ±1/2 from |t| = 1 on. With U(v) = v⁶ − 3v⁵ + 5/2 v⁴, the quintic fade's antiderivative,
/// it's U(1) − U(1 − |t|).
fn kernel_integral(t: f32) -> f32 {
    let v = 1.0 - min(abs(t), 1.0)
    let g = 0.5 - v * v * v * v * (v * (v - 3.0) + 2.5)
    if t < 0.0 { -g } else { g }
}

/// The weight lattice coordinate `i` gives the average of value noise over `[x − h, x + h]` on
/// one axis: its kernel's integral over the interval, divided by its width; for `h` = 0, the
/// kernel's value at `x`.
fn box_weight(x: f32, h: f32, i: f32) -> f32 {
    if h <= 0.0 {
        let t = 1.0 - min(abs(x - i), 1.0)
        t * t * t * (t * (t * 6.0 - 15.0) + 10.0)
    } else {
        (kernel_integral(x + h - i) - kernel_integral(x - h - i)) / (2.0 * h)
    }
}

/// Value noise averaged over the box `p ± half`, exactly (up to rounding): each axis's half
/// width may be 0, which samples it. Value noise is a sum of lattice values, each times a
/// kernel that's a product over the axes, so its average is a sum over the lattice points the
/// box reaches, each times its kernel's average on each axis.
pub fn value_noise_box(p: vec3, half: vec3) -> f32 {
    let h = abs(half)
    // Work relative to p's cell, so adding one lattice step does not round back to the same
    // coordinate where |p| is at least 2^24.
    let cell = floor(p)
    let f = p - cell
    let lo = floor(f - h)
    let n = floor(f + h) - lo + 2.0
    let (nx, ny, nz) = (u32(n.x), u32(n.y), u32(n.z))
    let (ix, iy, iz) = (
        lattice_coord(cell.x).wrapping_add(lattice_coord(lo.x)),
        lattice_coord(cell.y).wrapping_add(lattice_coord(lo.y)),
        lattice_coord(cell.z).wrapping_add(lattice_coord(lo.z)),
    )
    let local = f - lo
    var s = 0.0
    for k in 0..nz {
        let wz = box_weight(local.z, h.z, f32(k))
        if wz != 0.0 {
            for j in 0..ny {
                let wyz = wz * box_weight(local.y, h.y, f32(j))
                if wyz != 0.0 {
                    for i in 0..nx {
                        let w = wyz * box_weight(local.x, h.x, f32(i))
                        let v = lattice(
                            ix.wrapping_add(i32(i)),
                            iy.wrapping_add(i32(j)),
                            iz.wrapping_add(i32(k)),
                        )
                        s += w * v
                    }
                }
            }
        }
    }
    s
}

/// `value_noise_box(p, half)` for a box that reaches at most `MOST_BOX_SIDE` lattice points on an
/// axis (about six cells wide), and the noise's mean, 0, for a wider one, which averages to
/// about that: its loops have a length the compiler sees, so a GPU kernel that calls it has a
/// bound (docs/rates.md). (`value_noise_box` is the same within that, its loops unbounded; it
/// becomes this when the baked solids that call it are next cooked again, so they aren't
/// cooked again for it alone.)
pub fn value_noise_box_near(p: vec3, half: vec3) -> f32 {
    let h = abs(half)
    let cell = floor(p)
    let f = p - cell
    let lo = floor(f - h)
    let n = floor(f + h) - lo + 2.0
    if !(max(n.x, max(n.y, n.z)) <= f32(MOST_BOX_SIDE)) {
        return 0.0
    }
    let (nx, ny, nz) = (
        min(u32(n.x), MOST_BOX_SIDE),
        min(u32(n.y), MOST_BOX_SIDE),
        min(u32(n.z), MOST_BOX_SIDE),
    )
    let (ix, iy, iz) = (
        lattice_coord(cell.x).wrapping_add(lattice_coord(lo.x)),
        lattice_coord(cell.y).wrapping_add(lattice_coord(lo.y)),
        lattice_coord(cell.z).wrapping_add(lattice_coord(lo.z)),
    )
    let local = f - lo
    var s = 0.0
    for k in 0..nz {
        let wz = box_weight(local.z, h.z, f32(k))
        if wz != 0.0 {
            for j in 0..ny {
                let wyz = wz * box_weight(local.y, h.y, f32(j))
                if wyz != 0.0 {
                    for i in 0..nx {
                        let w = wyz * box_weight(local.x, h.x, f32(i))
                        let v = lattice(
                            ix.wrapping_add(i32(i)),
                            iy.wrapping_add(i32(j)),
                            iz.wrapping_add(i32(k)),
                        )
                        s += w * v
                    }
                }
            }
        }
    }
    s
}

/// The most lattice points `value_noise_box_near` reads on an axis.
pub const MOST_BOX_SIDE: u32 = 8

/// The most octaves a fractal noise sums (16: 2^16 times its frequency, past what an f32 point
/// resolves): its loop's bound, so GPU code that reads a noise's octaves from a value has one.
pub const FBM_OCTAVES: u32 = 16

/// Fractal noise: `octaves` layers of value noise (at most `FBM_OCTAVES`), each at twice the
/// frequency and half the amplitude of the last, sampled at `p + offset`.
pub struct Fbm: Copy + GpuData + Eq + StateHash {
    pub freq: f32,
    pub octaves: u32,
    pub offset: vec3,
}

/// Fractal noise at base frequency `freq`, with `octaves` layers, sampled at `p + offset`.
pub fn fbm(freq: f32, octaves: u32, offset: vec3 = vec3()) -> Fbm {
    Fbm { freq, octaves, offset }
}

impl Noise for Fbm {
    fn noise_state(self, h: mut Hasher) -> bool {
        self.state_hash(mut h)
        true
    }

    fn value(self, p: vec3) -> f32 {
        let q = p + self.offset
        var s = 0.0
        var a = 1.0
        var fr = self.freq
        for o in 0..min(self.octaves, FBM_OCTAVES) {
            s += a * value_noise(q * fr + f32(o) * 17.0)
            a *= 0.5
            fr *= 2.0
        }
        s
    }

    /// The sum of the octaves' amplitudes, each way: 2 − 2^(1 − octaves).
    /// Closed form, rather than a loop over the octaves: every invocation that bounds a
    /// displaced surface computes it, alike (§18.13), and a loop's passes have no bound here.
    fn range(self) -> Interval {
        let r = 2.0 - exp2(1.0 - f32(self.octaves))
        Interval { lo: -r, hi: r }
    }

    /// Each octave's gradient is at most its amplitude times its frequency (which is `freq`
    /// for every octave) times value noise's bound.
    fn lipschitz(self) -> f32 {
        f32(self.octaves) * abs(self.freq) * VALUE_NOISE_LIPSCHITZ
    }

    /// The finest octave's lattice frequency.
    fn bandlimit(self) -> f32 {
        if self.octaves == 0 { 0.0 } else { abs(self.freq) * exp2(f32(self.octaves - 1)) }
    }

    /// Each octave by its size against the footprint: sampled where its cells are 16 or more
    /// footprints across, averaged over the footprint exactly (`value_noise_box`) where they're
    /// down to a quarter of one, and its mean, 0, where they're finer still.
    fn filtered(self, p: vec3, footprint: vec3) -> f32 {
        let q = p + self.offset
        var s = 0.0
        var a = 1.0
        var fr = self.freq
        for o in 0..min(self.octaves, FBM_OCTAVES) {
            let half = abs(footprint) * (0.5 * abs(fr))
            let r = 2.0 * max(half.x, max(half.y, half.z))
            let at = q * fr + f32(o) * 17.0
            if r < 0.0625 {
                s += a * value_noise(at)
            } else if r <= 4.0 {
                s += a * value_noise_box(at, half)
            }
            a *= 0.5
            fr *= 2.0
        }
        s
    }
}

/// A bound on value noise's gradient: the quintic fade's slope is at most 30/16, the lattice
/// values differ by at most 2, so each component is at most 3.75, and the length at most
/// 3.75 √3 (with room for rounding).
pub const VALUE_NOISE_LIPSCHITZ: f32 = 6.5

// ---- Lipschitz bounds ---------------------------------------------------------------------------

/// A surface divided by its Lipschitz bound: `.to_bound(near)`.
pub struct ToBound<S>: Copy + GpuData + Eq + StateHash {
    pub inner: S,
    pub near: f32,
    pub scale: f32,
}

impl<S: Surface> Surface for ToBound<S> {
    fn part_state(self, i: u32, h: mut Hasher) -> bool {
        h.write_u32(canonical_bits(self.near))
        h.write_u32(canonical_bits(self.scale))
        self.inner.part_state(i, mut h)
    }

    fn distance(self, p: vec3) -> f32 {
        clamp(self.inner.distance(p), -self.near, self.near) * self.scale
    }

    fn masked(self, p: vec3, live: Live, first: u32) -> f32 {
        clamp(self.inner.masked(p, live, first), -self.near, self.near) * self.scale
    }

    /// Its surface's enclosure held within ±`near` (a `min` and a `max` with constants,
    /// `slope_smin`), times its scale.
    fn slope_box<F: Copy + fn(vec3) -> vec3>(
        self,
        over: Box3,
        at: F,
        to: MapBox,
        live: Live,
        first: u32,
    ) -> SlopeBox {
        let s = self.inner.slope_box(over, at, to, live, first)
        let held = slope_max(slope_min(s, slope_const(self.near)), slope_const(-self.near))
        slope_scale(held, self.scale)
    }

    fn pruned<F: Copy + fn(vec3) -> vec3>(
        self,
        over: Box3,
        at: F,
        stretch: f32,
        live: Live,
        first: u32,
    ) -> Pruned {
        let r = self.inner.pruned(over, at, stretch, live, first)
        let lo = clamp(r.range.lo, -self.near, self.near) * self.scale
        let hi = clamp(r.range.hi, -self.near, self.near) * self.scale
        Pruned { live: r.live, range: Interval { lo: min(lo, hi), hi: max(lo, hi) } }
    }

    /// Unbounded: held within ±`near`, its distance stops growing, which no sphere's bound
    /// (growing without end) holds. Cull by the surface it bounds (`inner.bound()`).
    fn bound(self) -> Bound {
        UNBOUNDED
    }

    fn filtered(self, p: vec3, footprint: f32) -> f32 {
        clamp(self.inner.filtered(p, footprint), -self.near, self.near) * self.scale
    }

    fn part_offset(self, p: vec3, i: u32, by: f32) -> f32 {
        clamp(self.inner.part_offset(p, i, by / self.scale), -self.near, self.near) * self.scale
    }

    fn parts(self) -> u32 {
        self.inner.parts()
    }

    fn part_at(self, p: vec3) -> (f32, u32) {
        let (d, i) = self.inner.part_at(p)
        (clamp(d, -self.near, self.near) * self.scale, i)
    }

    fn part_distance(self, p: vec3, i: u32) -> f32 {
        clamp(self.inner.part_distance(p, i), -self.near, self.near) * self.scale
    }

    fn part_name(self, i: u32) -> PartName {
        self.inner.part_name(i)
    }

    fn lipschitz(self, near: f32) -> f32 {
        1.0
    }
}

impl<C, S: Field<C>> Field<C> for ToBound<S> {
    fn channels(self, p: vec3) -> C {
        self.inner.channels(p)
    }

    fn distance_and_channels(self, p: vec3) -> (f32, C) {
        let (d, c) = self.inner.distance_and_channels(p)
        (clamp(d, -self.near, self.near) * self.scale, c)
    }

    fn field_facts(self) -> FieldFacts {
        let f = self.inner.field_facts()
        FieldFacts::asserted(
            1.0,
            f.may_transmit,
            f.may_emit,
            f.may_coat,
            f.may_subsurface,
            f.may_micro,
            f.channels_proven,
            f.may_bump,
        )
    }
}

/// A debug build's check of a stated bound (§14): over the boxes in [-16, 16]³ where the
/// distance can be within ±`near`, refined to boxes about `near` wide, the derived gradient's
/// interval must allow a gradient no longer than `l`. A box whose every gradient is longer
/// panics: `l` understates the gradient there. (A box can only prove a bound wrong, not right,
/// so a bound that's wrong only between the boxes' samples can pass.)
pub fn check_lipschitz<S: Surface>(s: S, near: f32, l: f32) {
    var stack: Vec<Box3> = Vec::new()
    stack.push(Box3 { lo: vec3(-16.0), hi: vec3(16.0) })
    var visited = 0
    while stack.len() > 0 && visited < 20000 {
        visited += 1
        let b = stack.pop().unwrap()
        let d = interval(|q| s.distance(q), b)
        if d.lo >= near || d.hi <= -near {
            continue
        }
        let size = b.hi.x - b.lo.x
        if size > max(near, 1.0 / 64.0) {
            let mid = (b.lo + b.hi) * 0.5
            for i in 0..8 {
                let lo = vec3(
                    if i & 1 == 0 { b.lo.x } else { mid.x },
                    if i & 2 == 0 { b.lo.y } else { mid.y },
                    if i & 4 == 0 { b.lo.z } else { mid.z },
                )
                stack.push(Box3 { lo, hi: lo + (mid - b.lo) })
            }
            continue
        }
        let gx = interval(|q| gradient(|r| s.distance(r), q).x, b)
        let gy = interval(|q| gradient(|r| s.distance(r), q).y, b)
        let gz = interval(|q| gradient(|r| s.distance(r), q).z, b)
        let least = vec3(least_abs(gx), least_abs(gy), least_abs(gz))
        let g = length(least)
        if g > l * 1.001 + 1.0e-6 {
            panic(
                f"a Lipschitz bound of {l} for |distance| < {near} is too small: the derived gradient is at least {g} over the box from ({b.lo.x}, {b.lo.y}, {b.lo.z}) to ({b.hi.x}, {b.hi.y}, {b.hi.z})",
            )
        }
    }
}

/// A debug build's check of a stated bound (`Surface::bound`): over the boxes round the
/// bound's sphere (out to twice its radius and a unit more), refined where the derived interval
/// can't settle it to boxes about a 32nd of its radius wide, a box whose every distance (the derived interval) is below the least the bound
/// allows anywhere in the box panics: the bound claims more room than the surface leaves. (As
/// `check_lipschitz`, a box can only prove a bound wrong, not right.)
pub fn check_bound<S: Surface>(s: S, b: Bound) {
    match bound_broken(s, b) {
        Some((x, most, least)) => panic(
            f"a bound of radius {b.radius} round ({b.centre.x}, {b.centre.y}, {b.centre.z}) is too large: the distance is at most {most} over the box from ({x.lo.x}, {x.lo.y}, {x.lo.z}) to ({x.hi.x}, {x.hi.y}, {x.hi.z}), where the bound says at least {least}",
        ),
        None => {},
    }
}

/// `check_bound`'s search: a box that proves `b` wrong, the most distance there and the least
/// the bound allows, if it finds one.
pub fn bound_broken<S: Surface>(s: S, b: Bound) -> Option<(Box3, f32, f32)> {
    if b.radius >= 1.0e30 {
        return None
    }
    let reach = 2.0 * b.radius + 1.0
    let fine = max(b.radius / 32.0, 1.0 / 64.0)
    var stack: Vec<Box3> = Vec::new()
    stack.push(Box3 { lo: b.centre - vec3(reach), hi: b.centre + vec3(reach) })
    var visited = 0
    while stack.len() > 0 && visited < 20000 {
        visited += 1
        let x = stack.pop().unwrap()
        // The box's nearest and farthest points from the bound's centre.
        let nearest = length(clamp(b.centre, x.lo, x.hi) - b.centre)
        let farthest = length(max(abs(x.lo - b.centre), abs(x.hi - b.centre)))
        if farthest <= b.radius {
            continue
        }
        if nearest > b.radius {
            let least = b.slope * (nearest - b.radius)
            let room = 1.0e-4 * (1.0 + abs(least))
            let d = s.interval(x)
            // Every distance in the box is at least the bound's: it holds there.
            if d.lo >= least - room {
                continue
            }
            if d.hi < least - room {
                return Some((x, d.hi, least))
            }
        }
        if x.hi.x - x.lo.x > fine {
            let mid = (x.lo + x.hi) * 0.5
            for i in 0..8 {
                let lo = vec3(
                    if i & 1 == 0 { x.lo.x } else { mid.x },
                    if i & 2 == 0 { x.lo.y } else { mid.y },
                    if i & 4 == 0 { x.lo.z } else { mid.z },
                )
                stack.push(Box3 { lo, hi: lo + (mid - x.lo) })
            }
        }
    }
    None
}

/// The least |x| for x in `i`.
fn least_abs(i: Interval) -> f32 {
    if i.lo > 0.0 { i.lo } else if i.hi < 0.0 { -i.hi } else { 0.0 }
}

// ---- channels -----------------------------------------------------------------------------------

/// What a field's shading may leave out, returned by `Field::field_facts(self)` from a constant,
/// so the IR optimizer folds it into every shader of the field: a solver's affine path, a
/// transmissive discard on an opaque field, an unused lobe, the range guards of channels in range.
/// Proven at build by `engine::matter::verify::prove_field_facts` from the compiler's own bounds,
/// or stated (`FieldFacts::asserted`); `unknown()` leaves nothing out.
pub struct FieldFacts: Copy {
    pub lip: f32,
    pub may_transmit: bool,
    pub may_emit: bool,
    pub may_coat: bool,
    pub may_subsurface: bool,
    pub may_micro: bool,
    pub may_bump: bool,
    /// True only when build-time zero-sample affine verification proved every channel finite and
    /// within physical PBR ranges across the surface, allowing runtime NaN/range guards to erase.
    pub channels_proven: bool,
    /// Compiler-measured upper bound (`std::derive::work`) on `distance(p)` ALU work, 0 if unrecorded.
    pub distance_work: u32,
    /// Compiler-measured upper bound (`std::derive::work`) on `channels(p)` ALU work, 0 if unrecorded.
    pub channels_work: u32,
    seal: (),
}

impl FieldFacts {
    /// Conservative unknown facts (unbounded Lipschitz, all material features potentially active,
    /// runtime NaN/range sanitization active).
    pub fn unknown() -> FieldFacts {
        FieldFacts {
            lip: 1.0 / 0.0,
            may_transmit: true,
            may_emit: true,
            may_coat: true,
            may_subsurface: true,
            may_micro: true,
            may_bump: true,
            channels_proven: false,
            distance_work: 0,
            channels_work: 0,
            seal: (),
        }
    }

    /// Facts as stated. Each `may_*` that is false erases that channel's shading from every
    /// shader of the field, `channels_proven` erases its range guards, and a finite `lip` its
    /// solvers' affine path: a false fact is a wrong picture, not a guarded one.
    /// `engine::matter::verify::prove_field_facts` states them from the compiler's own bounds; a
    /// combinator passes on its parts'; anything else that states them says why in a comment.
    pub fn asserted(
        lip: f32,
        may_transmit: bool,
        may_emit: bool,
        may_coat: bool,
        may_subsurface: bool,
        may_micro: bool,
        channels_proven: bool = false,
        may_bump: bool = false,
        distance_work: u32 = 0,
        channels_work: u32 = 0,
    ) -> FieldFacts {
        FieldFacts {
            lip,
            may_transmit,
            may_emit,
            may_coat,
            may_subsurface,
            may_micro,
            may_bump,
            channels_proven,
            distance_work,
            channels_work,
            seal: (),
        }
    }

    /// Conservative join of two fields' static facts (for `Union`, `SmoothUnion`, `Intersect`).
    pub fn join(self, other: FieldFacts) -> FieldFacts {
        FieldFacts {
            lip: max(self.lip, other.lip),
            may_transmit: self.may_transmit || other.may_transmit,
            may_emit: self.may_emit || other.may_emit,
            may_coat: self.may_coat || other.may_coat,
            may_subsurface: self.may_subsurface || other.may_subsurface,
            may_micro: self.may_micro || other.may_micro,
            may_bump: self.may_bump || other.may_bump,
            channels_proven: self.channels_proven && other.channels_proven,
            distance_work: plus_work(self.distance_work, other.distance_work),
            channels_work: plus_work(self.channels_work, other.channels_work),
            seal: (),
        }
    }
}

/// A surface whose points carry channels `C` besides their distance: what a point knows
/// about itself, such as its colour or its density. `.with(...)` and `.with_at(...)` give a
/// surface channels, and the combinators blend them where they blend the surfaces.
pub trait Field<C>: Surface {
    /// The channels at `p`.
    fn channels(self, p: vec3) -> C

    /// The distance and the channels at `p` together, with each part of the field evaluated
    /// once: std's combinators blend their parts' channels by their distances, so they compute
    /// both here, and their `channels` is this one's second half. The distance is the same as
    /// `distance(p)`, bit for bit.
    fn distance_and_channels(self, p: vec3) -> (f32, C) {
        (self.distance(p), self.channels(p))
    }

    /// True when `channels(p)` is independent of `p` (e.g. `With<S, C>` or a rigid warp of one).
    fn has_constant_channels(self) -> bool {
        false
    }

    /// True when `channels(p)` depends only on local coordinates in `rigid_frame()`'s local space
    /// and is completely determined by `rigid_shape_hash()`.
    fn has_local_channels(self) -> bool {
        false
    }

    /// Evaluates channels at rest-pose local point `p` for skinned fields (falling back to
    /// `channels(p)` for non-skinned fields).
    fn rest_channels(self, p: vec3) -> C {
        self.channels(p)
    }

    /// Build-time proven static facts about this field (Lipschitz bound, transmission, emission,
    /// coat, subsurface, micro-detail, bump). Override to return a `const` witness so the compiler
    /// erases dead branches and verifiers at build time.
    fn field_facts(self) -> FieldFacts {
        FieldFacts::unknown()
    }

    /// True when this field overrides `kept` / `channels_kept` so the mesher should run
    /// `keep_verts` and the visibility resolve should shade via `channels_kept`; false by default
    /// so fields without per-vertex kept data pay zero memory, dispatch, or register overhead.
    fn uses_kept(self) -> bool {
        false
    }

    /// What the field keeps at a point `p` of its surface where the engine makes a mesh of it,
    /// `part` being the part there (`part_at`): four numbers in [0, 1] that change slowly across
    /// the surface (how worn a point is, how deep a cut, from the shape that made it), worked out
    /// once, at each vertex, and blended across each triangle, so a pixel need not work them out
    /// again (`channels_kept`). None by default.
    fn kept(self, p: vec3, part: u32) -> vec4 {
        vec4(0.0)
    }

    /// The channels at `p`, `part` being the part it is on (as the mesh keeps it, the part at the
    /// triangle's first vertex) and `kept` what `kept` gave there, blended: what a pixel asks. A
    /// union asks only the part, not every part; a field that keeps what it would otherwise work
    /// out again at every pixel answers from it. By default, `channels(p)`.
    fn channels_kept(self, p: vec3, part: u32, kept: vec4) -> C {
        self.channels(p)
    }

    /// Like `channels_kept`, when `kept` was evaluated at the exact point `p` (via `kept_at(p)`)
    /// rather than interpolated from coarse triangle vertices, so a field can evaluate its
    /// material directly without re-evaluating per-pixel geometric detail motifs already captured
    /// in `kept`. Defaults to `channels_kept`.
    fn channels_kept_exact(self, p: vec3, part: u32, kept: vec4) -> C {
        self.channels_kept(p, part, kept)
    }

    /// The distance at `p`, the part there (`part_at`) and what the field keeps there (`kept`),
    /// from one evaluation where a field can give them so: what the engine asks of each vertex
    /// of its mesh.
    fn kept_at(self, p: vec3) -> (f32, u32, vec4) {
        let (d, i) = self.part_at(p)
        (d, i, self.kept(p, i))
    }
}

/// How channels mix where surfaces blend. A channel struct declares it and gets it field by
/// field, so each member's type decides how it mixes.
@fieldwise
pub trait Blend {
    /// `self` where `t` is 0, `other` where it's 1, and a mix between.
    fn blend(self, other: Self, t: f32) -> Self
}

impl Blend for f32 {
    fn blend(self, other: f32, t: f32) -> f32 {
        mix(self, other, t)
    }
}

impl Blend for vec2 {
    fn blend(self, other: vec2, t: f32) -> vec2 {
        mix(self, other, vec2(t))
    }
}

impl Blend for vec3 {
    fn blend(self, other: vec3, t: f32) -> vec3 {
        mix(self, other, vec3(t))
    }
}

impl Blend for vec4 {
    fn blend(self, other: vec4, t: f32) -> vec4 {
        mix(self, other, vec4(t))
    }
}

impl Blend for Quat {
    fn blend(self, other: Quat, t: f32) -> Quat {
        self.nlerp(other, t)
    }
}

/// A colour in linear RGB, which blends linearly.
pub struct Color: Copy + GpuData + Blend + StateHash {
    pub r: f32,
    pub g: f32,
    pub b: f32,
}

/// A colour from linear RGB.
pub fn rgb(r: f32, g: f32, b: f32) -> Color {
    Color { r, g, b }
}

/// A direction, which blends along the sphere: mixed, then made unit length again.
pub struct UnitVec3: Copy + GpuData + StateHash {
    pub v: vec3,
}

/// `v`'s direction.
pub fn unit_vec3(v: vec3) -> UnitVec3 {
    UnitVec3 { v: normalize(v) }
}

impl Blend for UnitVec3 {
    fn blend(self, other: UnitVec3, t: f32) -> UnitVec3 {
        let m = mix(self.v, other.v, vec3(t))
        // Opposite directions mixed half and half cancel: keep the nearer one.
        if dot(m, m) < 1.0e-12 {
            if t < 0.5 { self } else { other }
        } else {
            UnitVec3 { v: normalize(m) }
        }
    }
}

/// A categorical channel, such as a material: never averaged, but taken whole from whichever
/// surface weighs more where two blend.
pub struct Cat<T>: Copy + GpuData + StateHash {
    pub value: T,
}

/// `value` as a categorical channel.
pub fn cat<T: Copy>(value: T) -> Cat<T> {
    Cat { value }
}

impl<T: Copy> Blend for Cat<T> {
    fn blend(self, other: Cat<T>, t: f32) -> Cat<T> {
        if t <= 0.5 { self } else { other }
    }
}

/// A surface whose points all carry the channels `value`: `.with(...)`.
pub struct With<S, C>: Copy + GpuData + Eq + StateHash {
    pub inner: S,
    pub value: C,
}

impl<S: Surface, C: Copy + GpuData> Surface for With<S, C> {
    const MAY_SKIN: bool = S::MAY_SKIN

    fn slope_box<F: Copy + fn(vec3) -> vec3>(
        self,
        over: Box3,
        at: F,
        to: MapBox,
        live: Live,
        first: u32,
    ) -> SlopeBox {
        self.inner.slope_box(over, at, to, live, first)
    }

    /// The material isn't hashed: where only it changes, every part's state is the same and
    /// the whole field's hash, which moved, rebuilds the batch.
    fn part_state(self, i: u32, h: mut Hasher) -> bool {
        self.inner.part_state(i, mut h)
    }

    fn part_bound(self, i: u32) -> Bound {
        self.inner.part_bound(i)
    }

    fn distance(self, p: vec3) -> f32 {
        self.inner.distance(p)
    }

    fn distance_within(self, p: vec3, most: f32) -> f32 {
        self.inner.distance_within(p, most)
    }

    fn masked(self, p: vec3, live: Live, first: u32) -> f32 {
        self.inner.masked(p, live, first)
    }

    fn pruned<F: Copy + fn(vec3) -> vec3>(
        self,
        over: Box3,
        at: F,
        stretch: f32,
        live: Live,
        first: u32,
    ) -> Pruned {
        self.inner.pruned(over, at, stretch, live, first)
    }

    fn bound(self) -> Bound {
        self.inner.bound()
    }

    fn filtered(self, p: vec3, footprint: f32) -> f32 {
        self.inner.filtered(p, footprint)
    }

    fn part_offset(self, p: vec3, i: u32, by: f32) -> f32 {
        self.inner.part_offset(p, i, by)
    }

    fn parts(self) -> u32 {
        self.inner.parts()
    }

    fn part_at(self, p: vec3) -> (f32, u32) {
        self.inner.part_at(p)
    }

    fn part_distance(self, p: vec3, i: u32) -> f32 {
        self.inner.part_distance(p, i)
    }

    fn part_name(self, i: u32) -> PartName {
        self.inner.part_name(i)
    }

    fn lipschitz(self, near: f32) -> f32 {
        self.inner.lipschitz(near)
    }

    fn interval_near(self, b: Box3) -> Interval {
        self.inner.interval_near(b)
    }

    fn rigid_frame(self) -> Rigid {
        self.inner.rigid_frame()
    }

    fn rigid_shape_hash(self) -> Option<u64> {
        self.inner.rigid_shape_hash()
    }

    fn skin_shape_hash(self) -> Option<u64> {
        self.inner.skin_shape_hash()
    }

    fn rest_distance_live(self, p: vec3, live: Live) -> f32 {
        self.inner.rest_distance_live(p, live)
    }

    fn rest_pruned<F: Copy + fn(vec3) -> vec3>(
        self,
        over: Box3,
        at: F,
        stretch: f32,
        live: Live,
        first: u32,
    ) -> Pruned {
        self.inner.rest_pruned(over, at, stretch, live, first)
    }

    fn rest_bound(self) -> Bound {
        self.inner.rest_bound()
    }

    fn rest_interval_near(self, b: Box3) -> Interval {
        self.inner.rest_interval_near(b)
    }

    fn rest_skin_weights(self, p: vec3) -> vec2u {
        self.inner.rest_skin_weights(p)
    }

    fn skin_bone_count(self) -> u32 {
        self.inner.skin_bone_count()
    }

    fn skin_bone(self, i: u32) -> DualQuat {
        self.inner.skin_bone(i)
    }

    fn posed_local_distance(self, p: vec3) -> f32 {
        self.inner.posed_local_distance(p)
    }
}

impl<S: Surface, C: Copy + GpuData> Field<C> for With<S, C> {
    fn channels(self, p: vec3) -> C {
        self.value
    }

    fn distance_and_channels(self, p: vec3) -> (f32, C) {
        (self.inner.distance(p), self.value)
    }

    fn has_constant_channels(self) -> bool {
        true
    }

    fn rest_channels(self, p: vec3) -> C {
        self.value
    }
}

/// A surface whose channels a function computes at each point: `.with_at(...)`.
pub struct WithAt<S, F>: Copy + GpuData + Eq + StateHash {
    pub inner: S,
    pub at: F,
}

impl<S: Surface, F: Copy + GpuData> Surface for WithAt<S, F> {
    const MAY_SKIN: bool = S::MAY_SKIN

    fn slope_box<G: Copy + fn(vec3) -> vec3>(
        self,
        over: Box3,
        at: G,
        to: MapBox,
        live: Live,
        first: u32,
    ) -> SlopeBox {
        self.inner.slope_box(over, at, to, live, first)
    }

    fn distance(self, p: vec3) -> f32 {
        self.inner.distance(p)
    }

    /// Its surface's: a skinned surface's rest pose (`skin_shape_hash`, the `rest_` asks, all
    /// passed on) is in this frame's local space, and is drawn moved by it.
    fn rigid_frame(self) -> Rigid {
        self.inner.rigid_frame()
    }

    fn masked(self, p: vec3, live: Live, first: u32) -> f32 {
        self.inner.masked(p, live, first)
    }

    fn pruned<G: Copy + fn(vec3) -> vec3>(
        self,
        over: Box3,
        at: G,
        stretch: f32,
        live: Live,
        first: u32,
    ) -> Pruned {
        self.inner.pruned(over, at, stretch, live, first)
    }

    fn bound(self) -> Bound {
        self.inner.bound()
    }

    fn filtered(self, p: vec3, footprint: f32) -> f32 {
        self.inner.filtered(p, footprint)
    }

    fn part_offset(self, p: vec3, i: u32, by: f32) -> f32 {
        self.inner.part_offset(p, i, by)
    }

    fn parts(self) -> u32 {
        self.inner.parts()
    }

    fn part_at(self, p: vec3) -> (f32, u32) {
        self.inner.part_at(p)
    }

    fn part_distance(self, p: vec3, i: u32) -> f32 {
        self.inner.part_distance(p, i)
    }

    fn part_name(self, i: u32) -> PartName {
        self.inner.part_name(i)
    }

    fn lipschitz(self, near: f32) -> f32 {
        self.inner.lipschitz(near)
    }

    fn interval_near(self, b: Box3) -> Interval {
        self.inner.interval_near(b)
    }

    fn skin_shape_hash(self) -> Option<u64> {
        self.inner.skin_shape_hash()
    }

    fn rest_distance_live(self, p: vec3, live: Live) -> f32 {
        self.inner.rest_distance_live(p, live)
    }

    fn rest_pruned<G: Copy + fn(vec3) -> vec3>(
        self,
        over: Box3,
        at: G,
        stretch: f32,
        live: Live,
        first: u32,
    ) -> Pruned {
        self.inner.rest_pruned(over, at, stretch, live, first)
    }

    fn rest_bound(self) -> Bound {
        self.inner.rest_bound()
    }

    fn rest_interval_near(self, b: Box3) -> Interval {
        self.inner.rest_interval_near(b)
    }

    fn rest_skin_weights(self, p: vec3) -> vec2u {
        self.inner.rest_skin_weights(p)
    }

    fn skin_bone_count(self) -> u32 {
        self.inner.skin_bone_count()
    }

    fn skin_bone(self, i: u32) -> DualQuat {
        self.inner.skin_bone(i)
    }

    fn posed_local_distance(self, p: vec3) -> f32 {
        self.inner.posed_local_distance(p)
    }
}

impl<S: Surface, C, F: Copy + GpuData + fn(vec3) -> C> Field<C> for WithAt<S, F> {
    fn channels(self, p: vec3) -> C {
        (self.at)(p)
    }

    fn rest_channels(self, p: vec3) -> C {
        (self.at)(p)
    }
}

/// How much of `b` a smooth union of distances `a` and `b` takes, from 0 to 1: the weight
/// `smin`'s gradient gives `b`'s, which a field's channels blend by too.
pub fn smin_weight(a: f32, b: f32, k: f32) -> f32 {
    let m = max(k - select(if_false: abs(a - b), if_true: 0.0, cond: a == b), 0.0)
    let w = m * (0.5 / max(k, 1.1754944e-38))
    if a < b { w } else { 1.0 - w }
}

/// `smin(a, b, k)` and `smin_weight(a, b, k)` at once: the two share `max(k - |a - b|, 0)`.
/// The same numbers as theirs, bit for bit: for `k` up to 2^124, `0.5 / k` is exactly twice
/// `0.25 / k`.
pub fn smin_and_weight(a: f32, b: f32, k: f32) -> (f32, f32) {
    let s = 0.25 / max(k, 1.1754944e-38)
    let d = b - a
    if d > 0.0 {
        let m = max(k - d, 0.0)
        (a - m * (m * s), m * (2.0 * s))
    } else {
        let m = max(k + select(if_false: d, if_true: 0.0, cond: d != d && a == a && b == b), 0.0)
        (b - m * (m * s), 1.0 - m * (2.0 * s))
    }
}

// The combinators evaluate each part once, for its distance and its channels together: asking
// each part for its channels after its distance would evaluate a chain of n blended parts
// O(n²) times.

impl<C: Blend, A: Field<C>, B: Field<C>> Field<C> for Union<A, B> {
    fn channels(self, p: vec3) -> C {
        self.distance_and_channels(p).1
    }

    /// The part's own operand's.
    fn kept(self, p: vec3, part: u32) -> vec4 {
        let n = self.a.parts()
        if part < n { self.a.kept(p, part) } else { self.b.kept(p, part - n) }
    }

    /// The part's own operand's, the other not asked.
    fn channels_kept(self, p: vec3, part: u32, kept: vec4) -> C {
        let n = self.a.parts()
        if part < n { self.a.channels_kept(p, part, kept) } else {
            self.b.channels_kept(p, part - n, kept)
        }
    }

    fn channels_kept_exact(self, p: vec3, part: u32, kept: vec4) -> C {
        let n = self.a.parts()
        if part < n { self.a.channels_kept_exact(p, part, kept) } else {
            self.b.channels_kept_exact(p, part - n, kept)
        }
    }

    /// The nearer operand's; a tie takes `a`'s.
    fn kept_at(self, p: vec3) -> (f32, u32, vec4) {
        let (da, ia, ka) = self.a.kept_at(p)
        let (db, ib, kb) = self.b.kept_at(p)
        if da <= db { (da, ia, ka) } else { (db, self.a.parts() + ib, kb) }
    }

    /// The nearer part's channels; a tie takes `a`'s.
    fn distance_and_channels(self, p: vec3) -> (f32, C) {
        let (da, ca) = self.a.distance_and_channels(p)
        let (db, cb) = self.b.distance_and_channels(p)
        (min(da, db), if da <= db { ca } else { cb })
    }

    fn field_facts(self) -> FieldFacts {
        self.a.field_facts().join(self.b.field_facts())
    }

    fn uses_kept(self) -> bool {
        self.a.uses_kept() || self.b.uses_kept()
    }
}

impl<C: Blend, A: Field<C>, B: Field<C>> Field<C> for SmoothUnion<A, B> {
    fn channels(self, p: vec3) -> C {
        self.distance_and_channels(p).1
    }

    /// The parts' channels blended by `smin_weight`.
    fn distance_and_channels(self, p: vec3) -> (f32, C) {
        let (da, ca) = self.a.distance_and_channels(p)
        let (db, cb) = self.b.distance_and_channels(p)
        let (d, w) = smin_and_weight(da, db, self.k)
        (d, ca.blend(cb, w))
    }

    fn field_facts(self) -> FieldFacts {
        self.a.field_facts().join(self.b.field_facts())
    }
}

impl<C: Blend, A: Field<C>, B: Field<C>> Field<C> for Intersect<A, B> {
    fn channels(self, p: vec3) -> C {
        self.distance_and_channels(p).1
    }

    /// The farther part's channels; a tie takes `a`'s.
    fn distance_and_channels(self, p: vec3) -> (f32, C) {
        let (da, ca) = self.a.distance_and_channels(p)
        let (db, cb) = self.b.distance_and_channels(p)
        (max(da, db), if da >= db { ca } else { cb })
    }

    fn field_facts(self) -> FieldFacts {
        self.a.field_facts().join(self.b.field_facts())
    }
}

impl<C, S: Field<C>, M: PointMap> Field<C> for Warp<S, M> {
    fn channels(self, p: vec3) -> C {
        self.inner.channels(self.map.local(p))
    }

    fn kept(self, p: vec3, part: u32) -> vec4 {
        self.inner.kept(self.map.local(p), part)
    }

    fn channels_kept(self, p: vec3, part: u32, kept: vec4) -> C {
        self.inner.channels_kept(self.map.local(p), part, kept)
    }

    fn channels_kept_exact(self, p: vec3, part: u32, kept: vec4) -> C {
        self.inner.channels_kept_exact(self.map.local(p), part, kept)
    }

    fn kept_at(self, p: vec3) -> (f32, u32, vec4) {
        let (d, i, k) = self.inner.kept_at(self.map.local(p))
        (self.map.distance_out(d), i, k)
    }

    fn distance_and_channels(self, p: vec3) -> (f32, C) {
        let (d, c) = self.inner.distance_and_channels(self.map.local(p))
        (self.map.distance_out(d), c)
    }

    fn has_constant_channels(self) -> bool {
        self.inner.has_constant_channels()
    }

    fn has_local_channels(self) -> bool {
        self.inner.has_local_channels()
    }

    fn rest_channels(self, p: vec3) -> C {
        self.inner.rest_channels(p)
    }

    fn field_facts(self) -> FieldFacts {
        self.inner.field_facts()
    }

    fn uses_kept(self) -> bool {
        self.inner.uses_kept()
    }
}

impl<C, S: Field<C>, N: Noise> Field<C> for Displace<S, N> {
    fn channels(self, p: vec3) -> C {
        self.inner.channels(p)
    }

    fn distance_and_channels(self, p: vec3) -> (f32, C) {
        let (d, c) = self.inner.distance_and_channels(p)
        (d + self.amp * self.noise.value(p), c)
    }

    fn field_facts(self) -> FieldFacts {
        let f = self.inner.field_facts()
        FieldFacts::asserted(
            f.lip + abs(self.amp) * self.noise.lipschitz(),
            f.may_transmit,
            f.may_emit,
            f.may_coat,
            f.may_subsurface,
            f.may_micro,
            f.channels_proven,
            f.may_bump,
        )
    }
}

/// The nearest part's channels; a tie takes the earlier part's, as `a.union(b)` does. A union
/// of no parts has no channels: asking for them indexes past the end (§11).
impl<C: Blend, S: Field<C>, const N: u32> Field<C> for UnionAll<S, N> {
    fn uses_kept(self) -> bool {
        if N == 0 {
            return false
        }
        self.parts[0].uses_kept()
    }

    fn channels(self, p: vec3) -> C {
        self.distance_and_channels(p).1
    }

    /// The part's own element's, its parts numbered after the elements' before it.
    fn kept(self, p: vec3, part: u32) -> vec4 {
        var first: u32 = 0
        var k = vec4(0.0)
        for i in 0..N {
            let n = self.parts[i].parts()
            if part >= first && part < first + n {
                k = self.parts[i].kept(p, part - first)
            }
            first += n
        }
        k
    }

    /// The part's own element's, no other asked.
    fn channels_kept(self, p: vec3, part: u32, kept: vec4) -> C {
        var first: u32 = 0
        var at: u32 = 0
        var local: u32 = 0
        for i in 0..N {
            let n = self.parts[i].parts()
            if part >= first && part < first + n {
                at = i
                local = part - first
            }
            first += n
        }
        self.parts[at].channels_kept(p, local, kept)
    }

    fn channels_kept_exact(self, p: vec3, part: u32, kept: vec4) -> C {
        var first: u32 = 0
        var at: u32 = 0
        var local: u32 = 0
        for i in 0..N {
            let n = self.parts[i].parts()
            if part >= first && part < first + n {
                at = i
                local = part - first
            }
            first += n
        }
        self.parts[at].channels_kept_exact(p, local, kept)
    }

    fn distance_and_channels(self, p: vec3) -> (f32, C) {
        let (d0, c0) = self.parts[0].distance_and_channels(p)
        // The same `min`s, in the same order, as `distance`.
        var d = d0
        var c = take c0
        for i in 1..N {
            let (di, ci) = self.parts[i].distance_and_channels(p)
            if di < d {
                c = take ci
            }
            d = min(d, di)
        }
        (d, c)
    }

    fn field_facts(self) -> FieldFacts {
        if N == 0 {
            return FieldFacts::unknown()
        }
        var f = self.parts[0].field_facts()
        for i in 1..N {
            f = f.join(self.parts[i].field_facts())
        }
        f
    }
}

/// The parts' channels blended in order, each by `smin_weight`, as `a.smooth_union(b, k)
/// .smooth_union(c, k)` blends them. A union of no parts has no channels: asking for them
/// indexes past the end (§11).
impl<C: Blend, S: Field<C>, const N: u32> Field<C> for SmoothUnionAll<S, N> {
    fn channels(self, p: vec3) -> C {
        self.distance_and_channels(p).1
    }

    fn distance_and_channels(self, p: vec3) -> (f32, C) {
        let (d0, c0) = self.parts[0].distance_and_channels(p)
        var d = d0
        var c = take c0
        for i in 1..N {
            let (di, ci) = self.parts[i].distance_and_channels(p)
            let (dn, w) = smin_and_weight(d, di, self.k)
            c = c.blend(ci, w)
            d = dn
        }
        (d, c)
    }

    fn field_facts(self) -> FieldFacts {
        if N == 0 {
            return FieldFacts::unknown()
        }
        var f = self.parts[0].field_facts()
        for i in 1..N {
            f = f.join(self.parts[i].field_facts())
        }
        f
    }
}

/// `a`'s channels: the cut takes away, and its face is `a`'s.
impl<C, A: Field<C>, B: Surface> Field<C> for SmoothSubtract<A, B> {
    fn channels(self, p: vec3) -> C {
        self.a.channels(p)
    }

    fn distance_and_channels(self, p: vec3) -> (f32, C) {
        let (da, ca) = self.a.distance_and_channels(p)
        (smax(da, -self.b.distance(p), self.k), ca)
    }

    fn field_facts(self) -> FieldFacts {
        let f = self.a.field_facts()
        FieldFacts::asserted(
            max(f.lip, self.b.lipschitz(1.0e6)),
            f.may_transmit,
            f.may_emit,
            f.may_coat,
            f.may_subsurface,
            f.may_micro,
            f.channels_proven,
            f.may_bump,
        )
    }
}

/// The operands' channels blended as the smooth maximum weighs them.
impl<C: Blend, A: Field<C>, B: Field<C>> Field<C> for SmoothIntersect<A, B> {
    fn channels(self, p: vec3) -> C {
        self.distance_and_channels(p).1
    }

    fn distance_and_channels(self, p: vec3) -> (f32, C) {
        let (da, ca) = self.a.distance_and_channels(p)
        let (db, cb) = self.b.distance_and_channels(p)
        (smax(da, db, self.k), ca.blend(cb, smin_weight(-da, -db, self.k)))
    }

    fn field_facts(self) -> FieldFacts {
        self.a.field_facts().join(self.b.field_facts())
    }
}

impl<C, S: Field<C>> Field<C> for Mirror<S> {
    fn uses_kept(self) -> bool {
        self.inner.uses_kept()
    }

    fn channels(self, p: vec3) -> C {
        self.inner.channels(mirrored(p))
    }

    /// A part as written or its image (`parts`): the part's own, at the point mirrored.
    fn kept(self, p: vec3, part: u32) -> vec4 {
        self.inner.kept(mirrored(p), part % self.inner.parts())
    }

    fn channels_kept(self, p: vec3, part: u32, kept: vec4) -> C {
        self.inner.channels_kept(mirrored(p), part % self.inner.parts(), kept)
    }

    fn channels_kept_exact(self, p: vec3, part: u32, kept: vec4) -> C {
        self.inner.channels_kept_exact(mirrored(p), part % self.inner.parts(), kept)
    }

    fn distance_and_channels(self, p: vec3) -> (f32, C) {
        self.inner.distance_and_channels(mirrored(p))
    }

    fn field_facts(self) -> FieldFacts {
        self.inner.field_facts()
    }
}

impl<C, S: Field<C>> Field<C> for Named<S> {
    fn uses_kept(self) -> bool {
        self.inner.parts() == 1 && self.inner.uses_kept()
    }
    fn channels(self, p: vec3) -> C {
        self.inner.channels(p)
    }

    /// Its inner field's, where that is one part; one named part of several parts can't say which
    /// of them a point is on, so it keeps nothing and a pixel asks the whole.
    fn kept(self, p: vec3, part: u32) -> vec4 {
        if self.inner.parts() == 1 { self.inner.kept(p, 0) } else { vec4(0.0) }
    }

    fn channels_kept(self, p: vec3, part: u32, kept: vec4) -> C {
        if self.inner.parts() == 1 { self.inner.channels_kept(p, 0, kept) } else {
            self.inner.channels(p)
        }
    }

    fn channels_kept_exact(self, p: vec3, part: u32, kept: vec4) -> C {
        if self.inner.parts() == 1 { self.inner.channels_kept_exact(p, 0, kept) } else {
            self.inner.channels(p)
        }
    }

    fn distance_and_channels(self, p: vec3) -> (f32, C) {
        self.inner.distance_and_channels(p)
    }

    fn field_facts(self) -> FieldFacts {
        self.inner.field_facts()
    }
}

// ---- tests (the suite runs std's: `std_tests_pass`) --------------------------------------------

@test
fn dual_quat_matches_rigid_matrix() {
    let q = Quat::axis_angle(vec3(0.3, 0.8, -0.5), 1.23)
    let r = q.to_mat3()
    let t = vec3(1.4, -0.7, 2.2)
    let m = mat4(vec4(r[0], 0.0), vec4(r[1], 0.0), vec4(r[2], 0.0), vec4(t, 1.0))
    let s = 0.6
    let dq = DualQuat::from_mat4_scaled(m, s)
    let p = vec3(0.4, 1.1, -0.3)
    let expected = (m * vec4(p, 1.0)).xyz * s
    let got = dq.apply_point(p * s)
    assert(length(got - expected) < 0.0001)
    let n = normalize(vec3(-0.2, 0.9, 0.4))
    let n_exp = normalize(r * n)
    assert(length(dq.apply_normal(n) - n_exp) < 0.0001)
}

@test
fn a_hit_can_start_inside_the_surface() {
    let t = hit(sphere(1.0), vec3(), vec3(1.0, 0.0, 0.0))
    assert(abs(t - 1.0) < 0.0001)
}

@test
fn a_negative_scale_keeps_inside_negative() {
    let s = sphere(0.5).translate(vec3(1.0, 0.0, 0.0)).scale(-2.0)
    assert(abs(s.distance(vec3(-2.0, 0.0, 0.0)) + 1.0) < 0.00001)
    assert(abs(s.distance(vec3(0.0, 0.0, 0.0)) - 1.0) < 0.00001)
}

/// A blob of every primitive, smooth-unioned, and displaced by noise: what std's field tests
/// check.
fn test_blob() -> Surface {
    let body = ellipsoid(vec3(1.0, 0.6, 0.8))
    let limb = round_cone(vec3(0.5, -0.2, 0.0), vec3(1.4, 0.6, 0.2), r_top: 0.15, r_bottom: 0.3)
    let block = cuboid(vec3(0.3)).translate(vec3(-0.9, 0.4, 0.1))
    body.smooth_union(limb, k: 0.2).smooth_union(block, k: 0.1).displace(fbm(4.0, 3), amp: 0.01)
}

/// A test surface whose distance falls 100 times as fast past -1. It has one surface, at x = 0,
/// so its Lipschitz bound is 1 within one unit of that surface and 100 any farther inside.
struct SteepInside: Copy + GpuData {}

impl Surface for SteepInside {
    fn distance(self, p: vec3) -> f32 {
        if p.x < -1.0 { 100.0 * (p.x + 1.0) - 1.0 } else { p.x }
    }

    /// Unbounded: a plane.
    fn bound(self) -> Bound {
        UNBOUNDED
    }

    fn lipschitz(self, near: f32) -> f32 {
        if near <= 1.0 { 1.0 } else { 100.0 }
    }
}

@test
fn derived_gradients_agree_with_finite_differences() {
    let f = test_blob()
    let b = Box3 { lo: vec3(-2.0), hi: vec3(2.0) }
    let h = 1.0e-3
    for i in 0..256 {
        let p = b.sample(1, i)
        let g = gradient(|q: vec3| f.distance(q), p)
        let dx = f.distance(p + vec3(x: h)) - f.distance(p - vec3(x: h))
        let dy = f.distance(p + vec3(y: h)) - f.distance(p - vec3(y: h))
        let dz = f.distance(p + vec3(z: h)) - f.distance(p - vec3(z: h))
        let off = length(g - vec3(dx, dy, dz) / (2.0 * h))
        assert(off < 0.02, f"at ({p.x}, {p.y}, {p.z})")
    }
}

@test
fn derived_intervals_enclose_the_distances_in_their_boxes() {
    let f = test_blob()
    let space = Box3 { lo: vec3(-2.0), hi: vec3(2.0) }
    for i in 0..64 {
        let c = space.sample(2, i)
        let b = Box3 { lo: c - vec3(0.1), hi: c + vec3(0.1) }
        let r = interval(|q: vec3| f.distance(q), b)
        for j in 0..16 {
            let d = f.distance(b.sample(3, j))
            assert(r.lo <= d && d <= r.hi, f"a box at ({c.x}, {c.y}, {c.z})")
        }
    }
}

@test
fn narrowed_intervals_enclose_the_distances_and_narrow_the_derived() {
    let blob = test_blob().translate(vec3(0.1, 0.0, 0.0))
    let plain = round_cone(vec3(0.5, -0.2, 0.0), vec3(1.4, 0.6, 0.2), r_top: 0.15, r_bottom: 0.3)
    let space = Box3 { lo: vec3(-2.0), hi: vec3(2.0) }
    var narrower = 0
    for i in 0..64 {
        let c = space.sample(6, i)
        let b = Box3 { lo: c - vec3(0.1), hi: c + vec3(0.1) }
        let r = blob.interval_near(b)
        let s = plain.interval_near(b)
        for j in 0..16 {
            let p = b.sample(7, j)
            let d = blob.distance(p)
            assert(r.lo <= d && d <= r.hi, f"the blob, a box at ({c.x}, {c.y}, {c.z})")
            let e = plain.distance(p)
            assert(s.lo <= e && e <= s.hi, f"the plain blob, a box at ({c.x}, {c.y}, {c.z})")
        }
        // A round cone's derived interval is loose; its distance at the centre, which changes
        // by at most 1 a unit, narrows it.
        let x = interval(|q: vec3| plain.distance(q), b)
        if s.hi - s.lo < 0.9 * (x.hi - x.lo) {
            narrower += 1
        }
    }
    assert(narrower > 8, f"only {narrower} of 64 boxes narrowed")
}

/// A body like the engine's creature: seventeen round cones in a smooth fold, a wand joined to
/// them, the whole moved: eighteen parts.
fn parted_body() -> Warp<SmoothUnion<SmoothUnionAll<RoundCone, 17>, RoundCone>, Shift> {
    var parts = [round_cone(vec3(), vec3(0.0, 1.0, 0.0), r_top: 0.05, r_bottom: 0.1); 17]
    for i in 0..17 {
        let a = f32(i) * 0.37
        parts[i] = round_cone(
            vec3(0.12 * cos(a), 0.06 * f32(i), 0.12 * sin(a)),
            vec3(0.25 * cos(a), 0.06 * f32(i) + 0.12, 0.25 * sin(a)),
            r_top: 0.03,
            r_bottom: 0.045,
        )
    }
    let wand = round_cone(
        vec3(-0.42, 0.87, -0.04),
        vec3(-0.5, 1.05, 0.26),
        r_top: 0.005,
        r_bottom: 0.005,
    )
    parts.smooth_union(k: 0.03).smooth_union(wand, k: 0.004).translate(vec3(1.0, 0.0, -2.0))
}

/// The box sides `affine`'s soundness is checked at on std's surfaces: a metre, the engine's
/// middle level, and the two finest a march asks.
const RANGE_SIDES: [f32; 4] = [1.0, 0.12, 0.008, 0.001]

/// Checks `affine`'s range of `s`'s distance over boxes of each of `RANGE_SIDES` centred on
/// `s`'s surface (points of space walked onto it by two Newton steps): every box's corners and
/// 56 more samples are inside it, and it is never wider than the plain interval. How many of the
/// 48 boxes 8 mm and smaller it is within a quarter again of the samples' own spread on.
fn affine_holds<S: Surface>(s: S, space: Box3, name: Text) -> u32 {
    var narrower = 0
    for side in RANGE_SIDES {
        for i in 0..24 {
            var c = space.sample(11, i)
            for step in 0..2 {
                let (d, g) = value_and_gradient(|q: vec3| s.distance(q), c)
                c = c - g * (d / max(dot(g, g), 1.0e-6))
            }
            let b = Box3 { lo: c - vec3(0.5 * side), hi: c + vec3(0.5 * side) }
            let r = affine(|q: vec3| s.distance(q), b)
            let x = interval(|q: vec3| s.distance(q), b)
            assert(x.lo <= r.lo && r.hi <= x.hi, f"{name}: wider than the interval, side {side}")
            var least = 1.0e30
            var most = -1.0e30
            for j in 0..64 {
                let p = if j < 8 {
                    vec3(
                        if (j & 1) == 0 { b.lo.x } else { b.hi.x },
                        if (j & 2) == 0 { b.lo.y } else { b.hi.y },
                        if (j & 4) == 0 { b.lo.z } else { b.hi.z },
                    )
                } else {
                    b.sample(13, j + 64 * i)
                }
                let d = s.distance(p)
                least = min(least, d)
                most = max(most, d)
                assert(
                    r.lo <= d && d <= r.hi,
                    f"{name}: {d} outside [{r.lo}, {r.hi}], side {side}, at ({p.x}, {p.y}, {p.z})",
                )
            }
            if side < 0.01 && r.hi - r.lo <= 1.25 * (most - least) {
                narrower += 1
            }
        }
    }
    narrower
}

/// `affine`'s range of a distance, the affine form intersected with the interval, holds every
/// sample of its box for each std kind alone and for the blob and the body, at every side; and
/// on the smooth kinds, at 8 mm and 1 mm, it is within a quarter again of the samples' spread on
/// most boxes (where the round cone's plain interval is not).
@test
fn affine_ranges_hold_every_sample_for_each_kind() {
    let space = Box3 { lo: vec3(-1.0), hi: vec3(1.0) }
    let q = Quat::axis_angle(normalize(vec3(1.0, 2.0, 0.5)), 0.7)
    let cone = round_cone(vec3(-0.6, -0.3, 0.1), vec3(0.1, 0.4, -0.2), r_top: 0.15, r_bottom: 0.35)
    let box = cuboid(vec3(0.4, 0.3, 0.2))
    let egg = ellipsoid(vec3(0.3, 0.5, 0.4))
    let n_sphere = affine_holds(sphere(0.6), space, "sphere")
    let n_egg = affine_holds(egg, space, "ellipsoid")
    let n_cone = affine_holds(cone, space, "round cone")
    affine_holds(box, space, "cuboid")
    affine_holds(half_space(normalize(vec3(0.1, 1.0, 0.05)), 0.7), space, "half space")
    affine_holds(sphere(0.6).translate(vec3(0.5, 0.0, 0.0)), space, "translate")
    affine_holds(box.rotate(q), space, "rotate")
    affine_holds(egg.scale(1.5), space, "scale")
    affine_holds(sphere(0.6).union(cone), space, "union")
    affine_holds(box.intersect(sphere(0.45)), space, "intersect")
    let n_smooth = affine_holds(sphere(0.6).smooth_union(cone, k: 0.3), space, "smooth union")
    affine_holds(cone.smooth_subtract(box, k: 0.1), space, "smooth subtract")
    affine_holds(egg.smooth_intersect(sphere(0.4), k: 0.05), space, "smooth intersect")
    let n_noise = affine_holds(sphere(0.6).displace(fbm(4.0, 3), amp: 0.02), space, "displace")
    affine_holds(test_blob(), space, "the blob")
    let body = parted_body()
    let bb = body.bound()
    let near = Box3 { lo: bb.centre - vec3(bb.radius), hi: bb.centre + vec3(bb.radius) }
    affine_holds(body, near, "the body")
    for (n, name) in [
        (n_sphere, "sphere"),
        (n_egg, "ellipsoid"),
        (n_cone, "round cone"),
        (n_smooth, "smooth union"),
        (n_noise, "displace"),
    ] {
        assert(n >= 36, f"{name}: only {n} of 48 small boxes as tight as their samples")
    }
}

/// A box's distance's gradient interval over boxes at its faces, edges and corners, where
/// `max(q, 0)` can be the zero vector (its `length`'s `normalize` asked over 0): no NaN is made
/// (a debug build traps one, and this test runs as one), and every sampled gradient lies within.
@test
fn a_boxs_gradient_interval_holds_where_its_outside_part_can_be_zero() {
    let b = cuboid(vec3(1.0, 0.5, 0.75)).translate(vec3(0.2, -0.1, 0.3))
    for k in 0..27 {
        // Each corner, edge and face of the box, and its middle; boxes of three sizes.
        let at = vec3(f32(k % 3), f32((k / 3) % 3), f32(k / 9)) - vec3(1.0)
        let c = vec3(0.2, -0.1, 0.3) + at * vec3(1.0, 0.5, 0.75)
        for h in [0.3, 0.01, 0.0001] {
            let over = Box3 { lo: c - vec3(h), hi: c + vec3(h) }
            let g = interval(|q: vec3| gradient(|x: vec3| b.distance(x), q), over)
            for i in 0..5 {
                for j in 0..5 {
                    for l in 0..5 {
                        let q = over.lo + (over.hi - over.lo) * vec3(f32(i), f32(j), f32(l)) / 4.0
                        let d = gradient(|x: vec3| b.distance(x), q)
                        assert(
                            d.x >= g.lo.x &&
                                d.x <= g.hi.x &&
                                d.y >= g.lo.y &&
                                d.y <= g.hi.y &&
                                d.z >= g.lo.z &&
                                d.z <= g.hi.z,
                            f"box {k} h {h}: the gradient at ({q.x}, {q.y}, {q.z}) outside its interval",
                        )
                    }
                }
            }
        }
    }
}

/// `smoothstep`'s interval with its edges reversed (a fade out, as `smoothstep(8.0, 0.0, |d|)`)
/// holds every sample of its box and is within an ulp's widening of the samples' ends, as with
/// its edges in order; with the edges' ranges crossing it is [0, 1].
@test
fn a_reversed_smoothsteps_interval_holds_and_is_tight() {
    for i in 0..64 {
        let c = -2.0 + 12.0 * f32(i) / 64.0
        for w in [0.001, 0.1, 3.0] {
            let b = Interval { lo: c - w, hi: c + w }
            let r = interval(|x: f32| smoothstep(8.0, 0.0, x), b)
            let f = interval(|x: f32| smoothstep(0.0, 8.0, x), b)
            var least = 2.0
            var most = -1.0
            for j in 0..65 {
                let x = b.lo + (b.hi - b.lo) * f32(j) / 64.0
                let v = smoothstep(8.0, 0.0, x)
                assert(r.lo <= v && v <= r.hi, f"at {x}: {v} outside [{r.lo}, {r.hi}]")
                least = min(least, v)
                most = max(most, v)
            }
            assert(
                r.hi - r.lo <= most - least + 1.0e-5,
                f"[{b.lo}, {b.hi}]: [{r.lo}, {r.hi}] against the samples' [{least}, {most}]",
            )
            assert(
                abs((r.hi - r.lo) - (f.hi - f.lo)) <= 1.0e-5,
                "the fade out's width isn't the fade in's",
            )
        }
    }
    let crossing = interval(|e: f32| smoothstep(e, 1.0, 0.5), Interval { lo: 0.0, hi: 2.0 })
    assert(crossing.lo <= 0.0 && crossing.hi >= 1.0, "edges whose ranges cross")
}

@test
fn stated_bounds_hold_near_the_surface() {
    let f = test_blob()
    let near = 0.1
    let l = f.lipschitz(near)
    let b = Box3 { lo: vec3(-2.0), hi: vec3(2.0) }
    var checked = 0
    for i in 0..4096 {
        let p = b.sample(4, i)
        if abs(f.distance(p)) < near {
            checked += 1
            let g = length(gradient(|q: vec3| f.distance(q), p))
            assert(g <= l, f"at ({p.x}, {p.y}, {p.z})")
        }
    }
    assert(checked > 50, "too few samples near the surface")
}

/// `s`'s stated bound holds: at sampled points, and where `check_bound` looks.
fn bound_holds<S: Surface>(s: S) {
    let b = s.bound()
    assert(b.radius < 1.0e30, "bounded")
    let r = 2.0 * b.radius + 1.0
    let around = Box3 { lo: b.centre - vec3(r), hi: b.centre + vec3(r) }
    for i in 0..2048 {
        let p = around.sample(7, i)
        let d = s.distance(p)
        let below = b.below(p)
        // (Inside its sphere the bound says nothing.)
        assert(
            below <= 0.0 || d >= below - 1.0e-4 * (1.0 + abs(below)),
            f"at ({p.x}, {p.y}, {p.z}): {d} < {below}",
        )
    }
    assert(bound_broken(s, b).is_none(), "check_bound finds no box against it")
}

@test
fn every_stated_bound_holds_outside_its_sphere() {
    let a = round_cone(vec3(0.5, -0.2, 0.0), vec3(1.4, 0.6, 0.2), r_top: 0.15, r_bottom: 0.3)
    let c = cuboid(vec3(0.3)).translate(vec3(-0.9, 0.4, 0.1))
    bound_holds(test_blob())
    bound_holds(tube([vec3(), vec3(0.0, 1.0, 0.0), vec3(0.5, 1.5, 0.0)], [0.2, 0.15, 0.1]))
    bound_holds([sphere(0.3).translate(vec3()), sphere(0.5).translate(vec3(1.0, 0.0, 0.0))].union())
    bound_holds([a.translate(vec3()), a.translate(vec3(0.0, 0.0, 0.5))].smooth_union(k: 0.3))
    // Seventeen equal parts: the fold lowers them by all of `fold_lowering`, its bound's edge.
    bound_holds([sphere(0.3).translate(vec3()); 17].smooth_union(k: 0.3))
    bound_holds(ellipsoid(vec3(1.0, 0.6, 0.8)).smooth_subtract(sphere(0.5), k: 0.2))
    bound_holds(ellipsoid(vec3(1.0, 0.6, 0.8)).smooth_intersect(c, k: 0.2))
    bound_holds(a.mirror_x())
    bound_holds(
        oval(vec3(0.4, 0.2, 0.3)).scale(1.5).rotate(Quat::axis_angle(vec3(0.0, 1.0, 0.0), 0.7)),
    )
}

@test
fn a_bound_claiming_more_room_than_the_surface_leaves_is_found() {
    let s = sphere(1.0).translate(vec3(0.5, 0.0, 0.0))
    assert(bound_broken(s, s.bound()).is_none())
    assert(
        bound_broken(s, Bound { centre: vec3(0.5, 0.0, 0.0), radius: 0.6, slope: 1.0 }).is_some(),
    )
    assert(bound_broken(s, Bound { centre: vec3(), radius: 1.0, slope: 1.0 }).is_some())
}

@test
fn an_unbounded_surface_stays_unbounded_through_its_maps() {
    let h = half_space(vec3(0.0, 1.0, 0.0), 0.0)
    assert(h.scale(0.5).bound().radius >= 1.0e30)
    assert(
        h.translate(vec3(1.0)).rotate(Quat::axis_angle(vec3(1.0, 0.0, 0.0), 0.3)).bound().radius >=
            1.0e30,
    )
    assert(sphere(1.0).union(h.scale(0.5)).bound().radius >= 1.0e30)
}

@test
fn smooth_max_bounds_include_an_operand_far_inside_its_surface() {
    // A plane smoothly intersects SteepInside so a point 1.44 units inside that operand is on
    // the result's surface. Looking only k / 4 from either operand's surface misses its slope.
    let a = SteepInside {}
    let p = vec3(x: -1.0044)
    let b = half_space(vec3(x: 1.0), -0.9585)
    let k = 2.0
    let near = 0.0001
    let s = a.smooth_intersect(b, k)
    let g = length(gradient(|q: vec3| s.distance(q), p))
    let old_scope = near + 0.25 * k
    let too_narrow = max(a.lipschitz(old_scope), b.lipschitz(old_scope))
    assert(abs(s.distance(p)) < near)
    assert(g > 10.0 * too_narrow)
    assert(g <= s.lipschitz(near))

    // Subtraction is the same smooth maximum with the cutter's distance negated.
    let cut = half_space(vec3(x: -1.0), 0.9585)
    let subtracted = a.smooth_subtract(cut, k)
    let cut_g = length(gradient(|q: vec3| subtracted.distance(q), p))
    assert(abs(subtracted.distance(p)) < near && cut_g <= subtracted.lipschitz(near))
}

/// A body, a knob and its mirror image, and a cut: four parts, each found where it decides the
/// distance, with the distance `distance` gives.
fn test_parts() -> Surface {
    let knob = sphere(0.2).translate(vec3(0.6, 0.0, 0.0)).named("knob").mirror_x()
    sphere(0.5)
        .named("body")
        .smooth_union(knob, k: 0.05)
        .smooth_subtract(
            cuboid(half: vec3(0.1)).translate(vec3(0.0, 0.5, 0.0)).named("notch"),
            k: 0.02,
        )
}

@test
fn each_part_is_found_where_it_decides_the_distance() {
    let s = test_parts()
    assert(s.parts() == 4)
    let at = |p: vec3| s.part_at(p).1
    assert(at(vec3(0.0, -0.3, 0.0)) == 0)
    assert(at(vec3(0.7, 0.0, 0.0)) == 1)
    assert(at(vec3(-0.7, 0.0, 0.0)) == 2)
    assert(at(vec3(0.0, 0.45, 0.0)) == 3)
    assert(s.part_name(1).name == "knob" && !s.part_name(1).mirrored)
    assert(s.part_name(2).name == "knob" && s.part_name(2).mirrored)
    assert(s.part_name(3).name == "notch")
    // The image's own distance is the knob's, reflected.
    let p = vec3(-0.75, 0.1, 0.05)
    assert(abs(s.part_distance(p, 2) - s.part_distance(vec3(0.75, 0.1, 0.05), 1)) < 1.0e-6)
    let b = Box3 { lo: vec3(-1.0), hi: vec3(1.0) }
    for i in 0..1024 {
        let q = b.sample(5, i)
        assert(s.part_at(q).0 == s.distance(q), f"at ({q.x}, {q.y}, {q.z})")
    }
}

@test
fn array_blend_provenance_matches_the_binary_fold() {
    let a = sphere(1.0).named("a")
    let b = sphere(1.0).named("b")
    let c = sphere(1.1).named("c")
    let folded = a.smooth_union(b, k: 1.0).smooth_union(c, k: 1.0)
    let array = [a, b, c].smooth_union(k: 1.0)
    let p = vec3(0.0)
    assert(folded.part_at(p).1 == 0)
    assert(array.part_at(p).1 == folded.part_at(p).1)
    assert(array.part_at(p).0 == folded.part_at(p).0)
}

@test
fn value_noise_intervals_hold_every_sample_and_are_exact_within_two_cells() {
    // Boxes across 0, 1 or 2 lattice planes on each axis, some at large coordinates. Each holds
    // every value at a grid through the box and at its lattice planes; one that crosses at
    // most one plane on each axis is as wide as the values at those points (its corners and
    // its planes'), give or take the rounding allowance.
    for k in 0..240 {
        let w = [0.003, 0.04, 0.3, 0.97, 1.6, 2.5][k % 6]
        let lo = vec3(
            f32(k) * 0.731 - 80.0,
            f32(k % 7) * 1.37 - 4.0,
            f32(k % 11) * 0.913 + if k % 5 == 0 { 3000000.0 } else { 0.0 },
        )
        let b = Box3 { lo, hi: lo + vec3(w, 0.5 * w, w) }
        let r = interval(|q: vec3| value_noise(q), b)
        var slo = 1.0e9
        var shi = -1.0e9
        for i in 0..9 {
            for j in 0..9 {
                for l in 0..9 {
                    let t = vec3(f32(i), f32(j), f32(l)) / 8.0
                    var q = mix(b.lo, b.hi, t)
                    // A lattice plane inside the box, on each axis that has one.
                    let plane = floor(b.lo) + 1.0
                    if i == 4 && plane.x < b.hi.x { q.x = plane.x }
                    if j == 4 && plane.y < b.hi.y { q.y = plane.y }
                    if l == 4 && plane.z < b.hi.z { q.z = plane.z }
                    let v = value_noise(q)
                    assert(r.lo <= v && v <= r.hi, f"box {k}: {v} outside [{r.lo}, {r.hi}]")
                    slo = min(slo, v)
                    shi = max(shi, v)
                }
            }
        }
        let crossings = floor(b.hi) - floor(b.lo)
        if max(crossings.x, max(crossings.y, crossings.z)) <= 1.0 {
            let excess = (r.hi - r.lo) - (shi - slo)
            assert(excess < 0.0001, f"box {k}: interval wider than its values by {excess}")
        }
    }
}

@test
fn noise_boxes_keep_lattice_steps_at_large_coordinates() {
    for x in [16777216.0, 33554432.0, -33554432.0] {
        let p = vec3(x, 0.0, 0.0)
        assert(value_noise_box(p, vec3(0.0)) == value_noise(p))
        let i = lattice_coord(x)
        let want = 0.25 * lattice(i.wrapping_sub(1), y: 0, z: 0) +
            0.5 * lattice(i, y: 0, z: 0) +
            0.25 * lattice(i.wrapping_add(1), y: 0, z: 0)
        assert(abs(value_noise_box(p, vec3(1.0, 0.0, 0.0)) - want) < 0.000001)
    }
}

@test
fn a_part_shares_the_distance_where_it_decides_it_and_in_its_blends() {
    let s = test_parts()
    // On the body, away from the knobs and the notch: the body alone.
    let low = vec3(0.0, -0.5, 0.0)
    assert(abs(part_share(s, low, 0) - 1.0) < 1.0e-3)
    for i in 1..4 {
        assert(part_share(s, low, i) == 0.0, f"part {i}")
    }
    // The knob as written decides at x > 0, its image at x < 0.
    let knob = vec3(0.8, 0.0, 0.0)
    assert(abs(part_share(s, knob, 1) - 1.0) < 1.0e-3)
    assert(part_share(s, knob, 2) == 0.0)
    assert(part_share(s, vec3(-0.8, 0.0, 0.0), 2) > 0.999)
    // Where the knob meets the body (the circle where both spheres' surfaces cross), within
    // the blend's width, both share it.
    let seam = vec3(0.475, 0.156, 0.0)
    let (a, k) = (part_share(s, seam, 0), part_share(s, seam, 1))
    assert(a > 0.0 && a < 1.0 && k > 0.0 && k < 1.0, f"body {a}, knob {k}")
    assert(abs(a + k - 1.0) < 1.0e-2)
    // Raising a part where it decides raises the distance as much.
    assert(abs(s.part_offset(low, 0, by: 0.01) - (s.distance(low) + 0.01)) < 1.0e-6)
    // Scaled, an offset is in the scaled surface's units.
    let big = s.scale(2.0)
    assert(abs(big.part_offset(2.0 * low, 0, by: 0.01) - (big.distance(2.0 * low) + 0.01)) < 1.0e-6)
}

@test
fn certified_checks_prove_what_holds_and_find_what_fails() {
    let below = Box3 { lo: vec3(-2.0, -1.0, -2.0), hi: vec3(2.0, 0.0, 2.0) }
    // Clear of the ground: proved.
    let up = sphere(0.5).translate(vec3(0.0, 0.6, 0.0))
    assert(certify_clear(up, below, depth: 6).holds())
    // Sunk 10 cm: a point below the ground inside it.
    let sunk = sphere(0.5).translate(vec3(0.0, 0.4, 0.0))
    match certify_clear(sunk, below, depth: 6) {
        Certified::Fails(p) => assert(
            p.y <= 0.0 && sunk.distance(p) <= 0.0,
            f"at ({p.x}, {p.y}, {p.z})",
        ),
        _ => assert(false, "a sunk sphere is found"),
    }
    // Touching the ground at a point: no interval can prove it clear, and no point fails.
    let touching = sphere(0.5).translate(vec3(0.0, 0.5, 0.0))
    match certify_clear(touching, below, depth: 5) {
        Certified::Unknown(b) => assert(
            b.lo.y < 0.0001 && b.hi.y > -0.5,
            "the box is at the touch",
        ),
        Certified::Holds => assert(false, "a touching sphere isn't proved clear"),
        Certified::Fails(p) => assert(false, f"no point is inside: ({p.x}, {p.y}, {p.z})"),
    }
    // Two parts apart, and two that overlap.
    let pair = sphere(0.3).named("a").union(sphere(0.3).translate(vec3(1.0, 0.0, 0.0)).named("b"))
    let around = Box3 { lo: vec3(-1.0), hi: vec3(2.0, 1.0, 1.0) }
    assert(certify_apart(pair, a: 0, b: 1, region: around, depth: 6).holds())
    let close = sphere(0.3).named("a").union(sphere(0.3).translate(vec3(0.5, 0.0, 0.0)).named("b"))
    match certify_apart(close, a: 0, b: 1, region: around, depth: 6) {
        Certified::Fails(p) => assert(
            close.part_distance(p, 0) <= 0.0 && close.part_distance(p, 1) <= 0.0,
        ),
        _ => assert(false, "overlapping parts are found"),
    }
}

/// std's shapes and joins are `Eq` and `StateHash` (field by field, so their padding is never
/// read): a thing's field compared with last frame's says whether it changed, exactly, and a
/// hash of it keys what was made from it. A join holding an author's closure is neither.
@test
fn a_field_equals_last_frames_until_a_part_of_it_moves() {
    let cones = [
        round_cone(vec3(0.0, 0.57, -0.03), vec3(0.0, 0.79, 0.0), r_top: 0.1, r_bottom: 0.096),
        round_cone(vec3(0.0, 0.79, 0.0), vec3(0.0, 0.91, -0.02), r_top: 0.096, r_bottom: 0.06),
    ]
    let turn = Quat::axis_angle(normalize(vec3(1.0, 2.0, 0.5)), 0.7)
    let body = cones
        .smooth_union(k: 0.03)
        .with(vec3(0.4))
        .smooth_union(sphere(0.1).rotate(turn).named("head"), k: 0.004)
    let same = cones
        .smooth_union(k: 0.03)
        .with(vec3(0.4))
        .smooth_union(sphere(0.1).rotate(turn).named("head"), k: 0.004)
    assert(body == same && state_hash(body) == state_hash(same))
    var moved = cones
    moved[1] = round_cone(
        vec3(0.0, 0.79, 0.0),
        vec3(0.0, 0.91, -0.021),
        r_top: 0.096,
        r_bottom: 0.06,
    )
    let walked = moved
        .smooth_union(k: 0.03)
        .with(vec3(0.4))
        .smooth_union(sphere(0.1).rotate(turn).named("head"), k: 0.004)
    assert(body != walked && state_hash(body) != state_hash(walked), "a part moved")
    let turned = cones
        .smooth_union(k: 0.03)
        .with(vec3(0.4))
        .smooth_union(
            sphere(0.1).rotate(Quat::axis_angle(vec3(0.0, 1.0, 0.0), 0.1)).named("head"),
            k: 0.004,
        )
    assert(body != turned && state_hash(body) != state_hash(turned), "a part turned")
}

/// A surface whose numbers are its own code's: what can't change between frames.
struct BuiltBall: Copy + GpuData {}

impl Surface for BuiltBall {
    fn distance(self, p: vec3) -> f32 {
        sphere(1.0).translate(vec3(0.0, 2.0, 0.0)).distance(p)
    }

    fn bound(self) -> Bound {
        sphere(1.0).translate(vec3(0.0, 2.0, 0.0)).bound()
    }
}

/// `reads_only_input` (§14): what a function's result depends on, besides its argument. A
/// captured value is an input however it was made; a number written in the code isn't.
@test
fn a_field_reads_only_the_point_where_its_numbers_are_its_code() {
    let s = sphere(1.0)
    let time = 0.5
    assert(!reads_only_input(|p: vec3| s.distance(p)), "a shape held as a value")
    assert(
        reads_only_input(|p: vec3| sphere(1.0).translate(vec3(0.0, 2.0, 0.0)).distance(p)),
        "built inside",
    )
    assert(
        !reads_only_input(|p: vec3| sphere(1.0 + sin(time)).distance(p)),
        "a field that reads the time",
    )
    assert(!reads_only_input(|p: vec3| if time > 0.0 { length(p) } else {
        length(p) - 1.0
    }), "a branch on a capture")
    assert(reads_only_input(|p: vec3| length(p) - 1.0), "a closure of the point alone")
    assert(reads_only_input(check_bound_scope), "a named function")
    assert(reads_only_input(|a: (Sphere, vec3)| a.0.distance(a.1)), "a field given with its point")
    assert(
        !reads_only_input(|a: (Sphere, vec3)| sphere(a.0.radius + time).distance(a.1)),
        "the same that reads the time",
    )
    let joined = s.union(sphere(2.0))
    assert(!reads_only_input(|p: vec3| joined.distance(p)), "std's joins held as values")
    assert(
        reads_only_input(|p: vec3| BuiltBall {}.distance(p)) &&
            reads_only_input(|p: vec3| BuiltBall {}.union(BuiltBall {}).distance(p)),
        "a surface whose numbers are its code, and a join of two",
    )
}

fn check_bound_scope(p: vec3) -> f32 {
    max(abs(p.x), abs(p.y))
}

/// The engine's search for where a surface can be, in small (wrela-notes/engine,
/// `derived_bound`): boxes over 1024 m each way from the origin, halved where `interval_near`
/// holds 0, until a box is an eighth of what is found so far; the widest half of what is found,
/// 0 where nothing is, or -1 where the search doesn't close (a range not a number, or what is
/// found over a quarter of the space searched).
fn searched_radius<S: Surface>(s: S) -> f32 {
    let world = 1024.0
    var boxes: Vec<Box3> = Vec::new()
    boxes.push(Box3 { lo: vec3(-world), hi: vec3(world) })
    var lo = vec3(1.0e30)
    var hi = vec3(-1.0e30)
    var found = 2.0 * world
    var level: u32 = 0
    while boxes.len() > 0 && level < 24 {
        var next: Vec<Box3> = Vec::new()
        var all_lo = lo
        var all_hi = hi
        for b in boxes {
            let v = s.interval_near(b)
            if !(abs(v.lo) < 1.0e38 && abs(v.hi) < 1.0e38) {
                return -1.0
            }
            if v.lo > 0.0 {
                continue
            }
            all_lo = min(all_lo, b.lo)
            all_hi = max(all_hi, b.hi)
            if v.hi >= 0.0 && b.hi.x - b.lo.x > 0.125 * found && next.len() + 8 <= 4096 {
                for c in b.split() {
                    next.push(c)
                }
            } else {
                lo = min(lo, b.lo)
                hi = max(hi, b.hi)
            }
        }
        found = max(max(all_hi.x - all_lo.x, all_hi.y - all_lo.y), all_hi.z - all_lo.z)
        boxes = take next
        level += 1
    }
    for b in boxes {
        lo = min(lo, b.lo)
        hi = max(hi, b.hi)
    }
    if hi.x < lo.x {
        return 0.0
    }
    let r = 0.5 * max(max(hi.x - lo.x, hi.y - lo.y), hi.z - lo.z)
    if r > 0.25 * world { -1.0 } else { r }
}

/// A body like the engine's creature: seven round cones in a smooth union, whose derived
/// ranges alone reach below 0 hundreds of metres away (its search closes by their bounds).
fn coned_body() -> SmoothUnionAll<RoundCone, 7> {
    var cones = [round_cone(vec3(), vec3(0.0, 1.0, 0.0), r_top: 0.05, r_bottom: 0.1); 7]
    for i in 0..7 {
        let a = f32(i) * 0.37
        cones[i] = round_cone(
            vec3(0.12 * cos(a), 0.06 * f32(i), 0.12 * sin(a)),
            vec3(0.25 * cos(a), 0.06 * f32(i) + 0.12, 0.25 * sin(a)),
            r_top: 0.03,
            r_bottom: 0.045,
        )
    }
    cones.smooth_union(0.02)
}

/// `s`'s search closes within `most` m.
fn closes_within<S: Surface>(s: S, most: f32, what: str) {
    let r = searched_radius(s)
    assert(r > 0.0 && r <= most, f"{what}: where it can be is searched to {r} m")
}

/// `p`, moved onto the body (the middle of its first cone), closes alone and joined with it
/// every way.
fn closes_joined<P: Surface>(p: P, what: str) {
    let body = coned_body()
    let at = p.translate(vec3(0.185, 0.06, 0.0))
    closes_within(at, 0.25, what)
    closes_within(body.union(at), 1.0, f"{what}, a union")
    closes_within(body.smooth_union(at, 0.02), 1.0, f"{what}, a smooth union")
    closes_within(body.intersect(at), 1.0, f"{what}, an intersection")
    closes_within(body.smooth_intersect(at, 0.02), 1.0, f"{what}, a smooth intersection")
    closes_within(body.smooth_subtract(at, 0.02), 1.0, f"{what}, a smooth subtraction")
    let two = [at, p.translate(vec3(0.0, 0.3, 0.1))]
    closes_within(body.union(two.union()), 1.0, f"{what}, two in a union of many")
    closes_within(
        body.smooth_union(two.smooth_union(0.02), 0.02),
        1.0,
        f"{what}, two in a smooth union of many",
    )
}

/// Every std surface's search for where it can be (the engine's) closes near it, alone and
/// joined to a body every way, moved, turned, scaled and mirrored; a half-space, which has no
/// such place, says so (`UNBOUNDED`). An ellipsoid's bound is unbounded with its centre in
/// scope, which left every join holding one to its derived interval, and a body's never closes
/// so (2026-11-19: the engine's SCENE 9, a body joined with a sphere and an ellipsoid, 18 of 32
/// things refused): a join composes its parts' own where its bound is unbounded.
@test
fn every_surface_s_search_for_where_it_can_be_closes() {
    closes_within(coned_body(), 1.0, "the body")
    closes_joined(sphere(0.06), "a sphere")
    closes_joined(ellipsoid(vec3(0.05, 0.035, 0.06)), "an ellipsoid")
    closes_joined(oval(vec3(0.06, 0.078, 0.048)), "an oval")
    closes_joined(
        round_cone(vec3(), vec3(0.06, 0.06, 0.0), r_top: 0.036, r_bottom: 0.018),
        "a round cone",
    )
    closes_joined(cuboid(vec3(0.06, 0.048, 0.036)), "a cuboid")
    closes_joined(
        tube([vec3(), vec3(0.06, 0.06, 0.0), vec3(0.1, 0.0, 0.0)], [0.03, 0.02, 0.025]),
        "a tube",
    )
    // The engine's SCENE 9, a body joined with a sphere and an ellipsoid, then moved, turned,
    // scaled and mirrored.
    let e = ellipsoid(vec3(0.05, 0.035, 0.06)).translate(vec3(-0.15, 0.6, 0.05))
    let joined = coned_body()
        .smooth_union(sphere(0.06).translate(vec3(0.15, 0.9, 0.05)), 0.02)
        .smooth_union(e, 0.02)
    closes_within(joined, 1.0, "scene 9's body")
    closes_within(joined.translate(vec3(4.5, 0.0, -6.3)), 1.0, "scene 9's body, moved")
    closes_within(
        joined.rotate(Quat::axis_angle(vec3(0.3, 1.0, 0.2), 0.8)),
        1.5,
        "scene 9's body, turned",
    )
    closes_within(joined.scale(2.5), 2.5, "scene 9's body, scaled")
    closes_within(joined.translate(vec3(0.5, 0.0, 0.0)).mirror_x(), 1.5, "scene 9's body, mirrored")
    // A half-space has no place it's within: it says so, and its search doesn't close.
    let h = half_space(vec3(0.0, 1.0, 0.0), 0.0)
    assert(h.bound().radius >= 1.0e30, "a half-space states no bound")
    assert(searched_radius(h) < 0.0, "a half-space's search doesn't close")
}

@test
fn filtered_value_noise_keeps_point_and_fades_past_nyquist() {
    let f = |p: vec3| value_noise(p * 10.0)
    let p = vec3(1.23, -0.47, 2.81)
    assert(filtered(f, p, vec3(0.0)) == f(p), "value_noise w=0 must be exact")
    // Wide footprint (20 lattice cells) must attenuate completely to the analytic mean 0.0.
    let far = filtered(f, p, vec3(2.0, 2.0, 2.0))
    assert(abs(far) < 1.0e-5, f"value_noise far gave {far}, expected 0")
    // Anisotropic grazing footprint (wide on x only) must also fade cleanly to 0.0.
    let grazing = filtered(f, p, vec3(2.0, 0.01, 0.01))
    assert(abs(grazing) < 1.0e-5, f"value_noise grazing gave {grazing}, expected 0")
    // Composed wood-ring-like pattern: sin(r * 200 + value_noise(p * 20)) fades cleanly past Nyquist.
    let rings = |uv: vec2| {
        let q = vec3(uv.x, 0.25, uv.y)
        let warp = 0.03 * value_noise(q * 20.0)
        0.5 + 0.5 * sin((length(q.xz) + warp) * 200.0)
    }
    let pt = filtered(rings, vec2(0.4, 0.3), vec2(0.0))
    assert(pt == rings(vec2(0.4, 0.3)), "composed rings w=0 must be exact")
    let avg = filtered(rings, vec2(0.4, 0.3), vec2(0.2, 0.2))
    assert(abs(avg - 0.5) < 0.06, f"composed rings far gave {avg}, expected ~0.5")
}
