// Fields, functions over space: signed-distance surfaces, the combinators that join, cut, move
// and displace them, noise, channels such as colour, and measures and certified checks of a
// surface (language.md §20). A field's structure is its type and its numbers are data:
// `sphere(1.0).smooth_union(round_cone(...), k: 0.1)` has the type
// `SmoothUnion<Sphere, RoundCone>`, whose value is a few floats that reach the GPU as a uniform.
//
// A `Surface` is a signed distance. A `Field<C>` is a surface whose points also carry channels
// `C`, which the combinators blend where surfaces blend (`Blend`). A surface states a bound on
// its gradient near itself (`lipschitz`), so sphere tracing can step by it (`to_bound`); a
// closure of a point states none. A `Noise` states its range, its gradient's bound and its
// bandlimit.
//
// A surface's parts are the leaves of its tree of combinators (language.md §23): each knows
// which part decides its distance at a point (`part_at`), each part's own distance, and its
// name, so a tool can say what a point belongs to without knowing what made the surface.

use std::collections::Vec
use std::derive::{Box3, Interval, UNBOUNDED_WORK, affine, gradient, interval, plus_work, reads_only_input, tape, value_and_gradient, work}
use std::stage::Tape
use std::quat::Quat
use std::hash::{StateHash, pcg, state_hash}
use std::mem::debug_build
use std::gpu::{R32Float, Texture3dHandle}

/// A signed distance over 3D space: negative inside, positive outside.
///
/// ```wrela
/// use std::field::{Surface, round_cone, sphere}
///
/// fn blob() -> Surface {
///     let cone = round_cone(vec3(), vec3(y: 1.0), r_top: 0.3, r_bottom: 0.1)
///     sphere(0.5).smooth_union(cone, k: 0.1)
/// }
///
/// assert(blob().distance(vec3(0.0, 0.5, 0.0)) < 0.0)    // inside
/// assert(blob().distance(vec3(2.0, 0.0, 0.0)) > 0.0)    // outside
/// ```
pub trait Surface: Copy + GpuData {
    /// The signed distance from `p` to the surface.
    fn distance(self, p: vec3) -> f32

    /// The gradient of `distance`, derived by the compiler (§14): the surface normal, not
    /// normalized.
    fn gradient(self, p: vec3) -> vec3 {
        gradient(|q| self.distance(q), p)
    }

    /// The distance and its gradient, from one derived evaluation.
    fn sample(self, p: vec3) -> (f32, vec3) {
        value_and_gradient(|q| self.distance(q), p)
    }

    /// Its distance at `p` as something `footprint` wide sees it (a pixel's or a cell's span):
    /// detail finer than the footprint fades to its mean instead of aliasing. A displacement
    /// filters its noise (`Noise::filtered`), and every combinator passes the footprint on, so
    /// detail anywhere in a surface's tree is filtered. The default is the distance itself: a
    /// surface with no detail finer than the footprints it's seen at.
    fn filtered(self, p: vec3, footprint: f32) -> f32 {
        self.distance(p)
    }

    /// A sphere outside which its distance has a lower bound (`Bound::below`): what culling and
    /// sampling read to skip a surface that can't matter at a point, and LOD to size it by.
    /// Every surface states one (language.md §20.3): a surface that has none says so with
    /// `UNBOUNDED`, and why. A debug build checks it against the derived interval
    /// (`check_bound`) where the surface is stepped by (`to_bound`).
    fn bound(self) -> Bound

    /// A range holding every distance in `over`, derived by interval arithmetic.
    fn interval(self, over: Box3) -> Interval {
        interval(|q| self.distance(q), over)
    }

    /// Its distance as a tape (`std::derive::tape`): what a kernel interprets when the surface
    /// is built at run time, or chosen from many.
    fn to_tape(self) -> Tape {
        tape(|q| self.distance(q))
    }

    /// A bound on the length of `distance`'s gradient wherever |distance| < `near` (§20), so
    /// sphere tracing can step by it: primitives state theirs, combinators compose their parts'
    /// in ordinary code and pass the scope on. A consumer passes the scope it needs: a step of at
    /// most `near` (`to_bound`), or an interval test over a block that straddles the surface, at
    /// least the block's radius. A surface that states none (a closure of a point) is unbounded:
    /// infinite.
    fn lipschitz(self, near: f32) -> f32 {
        1.0 / 0.0
    }

    /// A range holding its distance over `b`: the derived interval, narrowed by the distance
    /// at `b`'s centre and the bound. The derived interval says how far from the surface `b` can
    /// be, which is the scope the bound needs; along the segment from the centre to any point of
    /// `b`, the distance then changes by at most the bound times the half-diagonal. Each narrows
    /// the other: a culling test keeps fewer boxes with both. A displacement narrows its
    /// surface's and adds its noise's range, which is tighter than its noise's steepness allows
    /// and needs no noise at the centre.
    fn interval_near(self, b: Box3) -> Interval {
        let x = self.interval(b)
        let l = self.lipschitz(max(abs(x.lo), abs(x.hi)) * 1.001 + 0.000001)
        if l >= 1.0e30 {
            return x
        }
        let r = l * 0.5 * length(b.hi - b.lo)
        let d = self.distance(b.center())
        Interval { lo: max(x.lo, d - r), hi: min(x.hi, d + r) }
    }

    /// The distance, held within ±`near` and divided by `lipschitz(near)`: never more than the
    /// distance to the surface, so sphere tracing can step by it. A debug build checks the
    /// bound against the derived gradient first (`check_lipschitz`). An unbounded surface (a
    /// closure's, or an ellipsoid's with its centre in scope) gives 0: nothing a tracer can step
    /// by.
    fn to_bound(self, near: f32) -> ToBound<Self> {
        let l = self.lipschitz(near)
        if debug_build() {
            check_lipschitz(self, near, l)
            check_bound(self, self.bound())
        }
        ToBound { inner: self, near, scale: 1.0 / l }
    }

    /// Every point inside either surface: the smaller distance.
    fn union<B: Surface>(self, b: B) -> Union<Self, B> {
        Union { a: self, b }
    }

    /// A union whose seam is rounded over a width of about `k`.
    fn smooth_union<B: Surface>(self, b: B, k: f32) -> SmoothUnion<Self, B> {
        SmoothUnion { a: self, b, k }
    }

    /// Every point inside both surfaces: the larger distance.
    fn intersect<B: Surface>(self, b: B) -> Intersect<Self, B> {
        Intersect { a: self, b }
    }

    /// The same surface, moved by `by`.
    fn translate(self, by: vec3) -> Translate<Self> {
        Warp { inner: self, map: Shift { by } }
    }

    /// Adds `amp` times a noise to the distance: wrinkles, bark, terrain.
    fn displace<N: Noise>(self, noise: N, amp: f32) -> Displace<Self, N> {
        Displace { inner: self, noise, amp }
    }

    /// The same surface, every point of which carries the channels `value`.
    fn with<C: Copy + GpuData>(self, value: C) -> With<Self, C> {
        With { inner: self, value }
    }

    /// The same surface, whose channels at `p` are `at(p)`: `.with_at(|p| Tissue { albedo:
    /// dapple(p, seed), ..HIDE })`. The closure is stored in the field, so it captures values
    /// only (§6.7).
    fn with_at<C, F: Copy + GpuData + fn(vec3) -> C>(self, at: F) -> WithAt<Self, F> {
        WithAt { inner: self, at }
    }

    /// `a` with `b` cut out of it, the cut's edge rounded over a width of about `k`.
    fn smooth_subtract<B: Surface>(self, b: B, k: f32) -> SmoothSubtract<Self, B> {
        SmoothSubtract { a: self, b, k }
    }

    /// What `a` and `b` hold in common, the edge rounded over a width of about `k`.
    fn smooth_intersect<B: Surface>(self, b: B, k: f32) -> SmoothIntersect<Self, B> {
        SmoothIntersect { a: self, b, k }
    }

    /// The same surface, turned by `by` about the origin.
    fn rotate(self, by: Quat) -> Rotate<Self> {
        Warp { inner: self, map: Turn { to_local: by.inverse().to_mat3() } }
    }

    /// The same surface, `by` times the size, about the origin. `by` can be negative (which
    /// reflects through the origin), but zero has no signed-distance transform and panics.
    fn scale(self, by: f32) -> Scale<Self> {
        if by == 0.0 {
            panic("scale: the factor is zero")
        }
        Warp { inner: self, map: Size { by } }
    }

    /// The surface and its mirror image in the plane x = 0: what it is at `p`, it is at
    /// `(-p.x, p.y, p.z)`. Written for x ≥ 0, its parts are twice its own: those at x ≥ 0, then
    /// their images.
    fn mirror_x(self) -> Mirror<Self> {
        Mirror { inner: self }
    }

    /// The same surface, one part with a name: tools say where a point is by it (§23).
    fn named(self, name: Text) -> Named<Self> {
        Named { inner: self, name }
    }

    // ---- provenance (§23) ----

    /// How many parts it has: the leaves of its tree of combinators. A primitive, a closure
    /// and a `named` surface are one part each.
    fn parts(self) -> u32 {
        1
    }

    /// Its distance at `p` (the same as `distance`), and the part that decides it: through each
    /// combinator, the operand whose distance the result follows. For a union or a blend that's
    /// the nearer, for an intersection the farther, and for a cut the cutter where the cut is
    /// the surface. Parts are numbered from 0, in the order the tree's leaves are written.
    fn part_at(self, p: vec3) -> (f32, u32) {
        (self.distance(p), 0)
    }

    /// Part `i`'s own distance at `p`: that part as if it were the whole surface, moved, turned,
    /// scaled and displaced as the combinators above it move, turn, scale and displace it.
    fn part_distance(self, p: vec3, i: u32) -> f32 {
        self.distance(p)
    }

    /// Part `i`'s name: empty where nothing names it.
    fn part_name(self, i: u32) -> PartName {
        unnamed()
    }

    /// The distance at `p` if part `i`'s own distance were `by` more: through each combinator,
    /// that operand raised and the others as they are. Where part `i` doesn't decide the
    /// distance (another part is nearer by more than the width of any blend between them) it's
    /// the distance itself; `part_share` is how much it changes.
    fn part_offset(self, p: vec3, i: u32, by: f32) -> f32 {
        self.distance(p) + by
    }

    // ---- over a box: its range, and the parts that can matter there (§20.4) ----

    /// The range of its distance over `over`, and of its gradient's components: both derived
    /// by the compiler from the surface as written, so nothing is stated by hand. The distance's
    /// is its affine form's range intersected with its interval's (`std::derive::affine`), which
    /// closes on the true range as the box shrinks; the gradient's is the interval of the
    /// gradient (`std::derive::interval` nested with `gradient`). Sound as the target rounds.
    fn range(self, over: Box3) -> FieldRange {
        FieldRange {
            value: affine(|q: vec3| self.distance(q), over),
            gradient: interval(|q: vec3| gradient(|r: vec3| self.distance(r), q), over),
        }
    }

    /// The parts that can change its distance anywhere in `over` (§23's numbering): a part of
    /// a union, smooth or not, that no point of the box would miss is left out, and where it
    /// is, `distance_live` gives the distance as `distance` does, bit for bit. Every other part
    /// is live. Found from the ranges of each union's operands over the box, derived.
    fn live(self, over: Box3) -> Live {
        self.pruned(over, |q: vec3| q, 1.0, ALL_LIVE, 0).live
    }

    /// Where part `i` (§23's numbering) can be, in the whole surface's frame: within `r` of the
    /// segment from `a` to `b`, and how far the joins above it can carry its effect past that
    /// (`reach`, a distance): a part whose bound a ray passes farther than `r + reach` from
    /// changes the distance nowhere on the ray the surface can be (`live_along`). The default is
    /// the whole surface's bound sphere, for every part: sound for any surface, and it leaves out
    /// nothing a ray can come near.
    fn part_bound(self, i: u32) -> PartBound {
        let b = self.bound()
        PartBound { a: b.centre, r: b.radius, b: b.centre, reach: 0.0, lowers: 0.0 }
    }

    /// Its distance at `p`, asking only the parts `live` names: what `distance` gives, bit for
    /// bit, wherever `live` is what `live(over)` gave for a box holding `p`. A union asks no part
    /// of an operand whose parts are all left out; a surface that is no union asks all of
    /// itself.
    fn distance_live(self, p: vec3, live: Live) -> f32 {
        self.masked(p, live, 0)
    }

    /// `distance_live` of a surface whose first part is numbered `first` in the whole
    /// surface's numbering: what the combinators implement. The default asks all of it.
    fn masked(self, p: vec3, live: Live, first: u32) -> f32 {
        self.distance(p)
    }

    /// `live`'s work, for a surface whose first part is numbered `first`, asked at `at(q)` for
    /// each `q` of `over` (the maps of the combinators above it, which stretch lengths at most
    /// `stretch` times): `live` with the parts it can leave out cleared, and the range its
    /// distance takes over the box. The default leaves everything live and gives the derived
    /// range, narrowed by the distance at the box's centre and the stated bound on its gradient,
    /// as `interval_near` narrows.
    fn pruned<F: Copy + fn(vec3) -> vec3>(self, over: Box3, at: F, stretch: f32, live: Live, first: u32) -> Pruned {
        let x = interval(|q: vec3| self.distance(at(q)), over)
        let l = self.lipschitz(max(abs(x.lo), abs(x.hi)) * 1.001 + 0.000001)
        if !(l < 1.0e30) {
            return Pruned { live, range: x }
        }
        // How far from the centre's distance the box's can be, and a margin for the rounding of
        // the two distances.
        let d = self.distance(at(over.center()))
        let r = l * stretch * 0.5 * length(over.hi - over.lo)
        let e = r * 1.0e-5 + abs(d) * 1.0e-6 + 1.0e-6
        Pruned { live, range: Interval { lo: max(x.lo, d - r - e), hi: min(x.hi, d + r + e) } }
    }

    // ---- what an ask costs (§20.4): the compiler's count, `std::derive::work` ----

    /// The most work one ask of its distance does as GPU code (`work` of `distance`, §18.11): a
    /// constant of the build, the same on every machine and run.
    fn ask_work(self) -> u32 {
        work(|q: vec3| self.distance(q))
    }

    /// Part `i`'s own ask, in §23's numbering: the code a masked ask leaves out where `i` isn't
    /// live, which is the largest piece of the surface holding part `i` and no other (its leaf,
    /// with what moves, turns or displaces it alone), asked as `distance_live` asks it. A union
    /// gives its operands'; a surface of one part, its whole masked ask; a surface of several
    /// that is no union (an intersection, a cut, a mirror) asks all of itself wherever any part
    /// is live, so its parts' are 0 and it is all base.
    fn part_work(self, i: u32) -> u32 {
        if self.parts() == 1 { masked_work(self) } else { 0 }
    }

    /// What `distance_live` does beyond the parts it asks: each union's tests of the mask and
    /// its joins, and the code of what moves, turns or displaces several parts at once. It is
    /// the compiler's count of a masked ask with every part live (`work` of `distance_live`, the
    /// mask unknown to it), less every part's `part_work`.
    fn base_work(self) -> u32 {
        let all = masked_work(self)
        var parts: u32 = 0
        for i in 0..min(self.parts(), 4096) {
            parts = plus_work(parts, self.part_work(i))
        }
        if all == UNBOUNDED_WORK { UNBOUNDED_WORK } else if parts >= all { 0 } else { all - parts }
    }

    /// The most work `distance_live(p, live)` does: `base_work` and each live part's
    /// `part_work`, an upper bound on the compiler's count of the ask with `live` known. Every
    /// part live, it is that count exactly; a part left out takes off exactly the code skipped
    /// for it, but not the tests and joins the skip saves (a few operations a union). The parts
    /// past the 4096th are counted live.
    fn live_work(self, live: Live) -> u32 {
        var w = self.base_work()
        for i in 0..min(self.parts(), 4096) {
            if live.has(i) {
                w = plus_work(w, self.part_work(i))
            }
        }
        w
    }

    /// Whether its distance reads nothing but the point (`std::derive::reads_only_input` of
    /// `distance`), a constant of the build: true for a surface whose numbers are written in its
    /// own code (built inside from constants), false for one that holds them as a value, which
    /// may be different each time it is asked (a std shape holds its numbers: `sphere(1.0)` read
    /// through a value is false). What can't change between frames is what reads only the point.
    fn reads_only_point(self) -> bool {
        reads_only_input(|q: vec3| self.distance(q))
    }

    // ---- where a ray can meet it (§20.5) ----

    /// Whether `meets` is exact for every value of this type and every ray (`near` the hit, no
    /// march), a constant of the build: true for std's shapes, their sharp unions and what moves
    /// them or names them, false through a smooth union, a displacement, a cut, a mirror, an
    /// intersection (exact only where both sides are one piece along the ray) and any surface
    /// that doesn't say. Code that asks `meets` only where this holds carries none where it doesn't.
    const EXACT_MEETS: bool = false

    /// Where the ray `o + t d` (t >= 0; any nonzero `d`, `t` in its units) can be inside or on
    /// the surface: a stretch of `t` outside which its distance is above 0 all along the ray,
    /// and a `t` by which it has surely met it (`first`). std's shapes answer exactly, and their
    /// sharp unions too, so `near` is where the ray first meets it (`Meets::exact`); a smooth
    /// union, a displacement and a surface std can't see into answer a stretch that holds the
    /// surface, from which a march starts, and the hit is in `near..first`.
    fn meets(self, o: vec3, d: vec3) -> Meets {
        let m = self.meets_grown(o, d, grow: 0.0, inner: 0.0)
        if m.exact() && !m.is_empty() { Meets { first: min(m.first, m.near), ..m } } else { m }
    }

    /// `meets` of the surface grown by `grow` (at least 0): `near` and `far` where its distance
    /// can be at most `grow`, and `first` a `t` by which the ray has met it grown by `inner`
    /// (at most `grow`, at most 0: a displacement above shrinks it), `EMPTY` where nothing says.
    /// What the combinators implement. The default is the bound's sphere, grown by `grow` over
    /// the bound's slope: it holds wherever the bound holds, never exact, and says no `first`.
    fn meets_grown(self, o: vec3, d: vec3, grow: f32, inner: f32) -> Meets {
        bound_meets(self.bound(), o, d, grow)
    }

    /// Whether `passes` is exact for every value of this type and every ray, a constant of the
    /// build (as `EXACT_MEETS`): true for std's shapes, their sharp unions and what moves
    /// (`PointMap::SIMILAR`), names or colours them; false through a smooth join, a
    /// displacement, and any surface that doesn't say.
    const EXACT_PASSES: bool = false

    /// The least the surface's distance comes to along the ray `o + t d` (t >= 0; any nonzero
    /// `d`, `t` in its units), on both sides of its outline: above 0 how near a ray that misses
    /// passes, at or below 0 how deep one that goes in goes (the deepest value along its chord;
    /// a half-space a ray goes into: `-EMPTY`); and a `t` where it is (`Pass`). The true least
    /// is always within `low..high`. std's shapes answer exactly in closed form (`exact()`:
    /// `low`, `distance` and `high` the least, to rounding), and their sharp unions (the least
    /// of their parts': exact). A smooth join answers its parts' least less its lowering as
    /// `low`, and as `high` and `distance` the less of its parts' least and its own distance
    /// asked once where they pass: the true least within its lowering of `high` (a fold of `n`,
    /// `fold_lowering`; two, `k / 4`), which `Pass::refined` tightens with four more asks. A
    /// displacement answers its inner surface's within its reach either way, asked once so too
    /// (`high` within twice its reach). Anything else: its bound's pass as `low`, its distance
    /// asked there as `high`.
    fn passes(self, o: vec3, d: vec3) -> Pass {
        bound_pass_asked(self, o, d)
    }
}

/// Where a ray can meet a surface (`Surface::meets`): the stretch `near..far` of the ray's
/// `t` outside which it is nowhere inside or on the surface (empty where `near > far`), and
/// `first`, a `t` by which it has surely met it (`EMPTY` where nothing says): the hit is in
/// `near..first`, so a march from `near` that reaches `first` has its answer there.
pub struct Meets: Copy + GpuData {
    pub near: f32,
    pub far: f32,
    pub first: f32,
    /// `MEETS_EXACT` and `MEETS_WHOLE`, as they hold.
    pub flags: u32,
}

/// `Meets`'s flag: `near` is the first `t >= 0` where the distance is at most 0 (to rounding:
/// 0 where the ray starts inside), so no march is needed.
pub const MEETS_EXACT: u32 = 1

/// `Meets`'s flag: every `t` of the stretch is inside or on the surface (one convex piece
/// along the ray).
pub const MEETS_WHOLE: u32 = 2

/// A ray that meets nothing, exactly.
pub const NEVER: Meets = Meets { near: EMPTY, far: -EMPTY, first: EMPTY, flags: 3 }

/// A ray inside everywhere along it.
const EVERYWHERE: Meets = Meets { near: -EMPTY, far: EMPTY, first: EMPTY, flags: 3 }

impl Meets {
    /// Whether the ray can't meet it at all.
    pub fn is_empty(self) -> bool {
        !(self.near <= self.far)
    }

    /// Whether `near` is where the ray first meets it.
    pub fn exact(self) -> bool {
        (self.flags & MEETS_EXACT) != 0
    }

    /// Whether every `t` of the stretch is inside or on it.
    pub fn whole(self) -> bool {
        (self.flags & MEETS_WHOLE) != 0
    }

    /// Where a ray can meet either (a union): the nearer start and the farther end, exact if
    /// both are; met by the earlier of their `first`s.
    pub fn or(self, b: Meets) -> Meets {
        if self.is_empty() {
            return Meets { first: min(self.first, b.first), ..b }
        }
        if b.is_empty() {
            return Meets { first: min(self.first, b.first), ..self }
        }
        let overlap = self.near <= b.far && b.near <= self.far
        let exact = self.flags & b.flags & MEETS_EXACT
        let whole = if overlap { self.flags & b.flags & MEETS_WHOLE } else { 0 }
        Meets { near: min(self.near, b.near), far: max(self.far, b.far), first: min(self.first, b.first), flags: exact | whole }
    }

    /// Where a ray can meet both (an intersection): the farther start and the nearer end,
    /// exact where both are whole. No `first`: neither's says where both are.
    pub fn and(self, b: Meets) -> Meets {
        if self.is_empty() || b.is_empty() {
            return NEVER
        }
        let near = max(self.near, b.near)
        let far = min(self.far, b.far)
        if near > far {
            return NEVER
        }
        let flags = if self.whole() && b.whole() { MEETS_EXACT | MEETS_WHOLE } else { 0 }
        Meets { near, far, first: EMPTY, flags }
    }

    /// The same, where it can still hold a surface: no longer exact or whole (`first` still
    /// holds).
    pub fn loose(self) -> Meets {
        if self.is_empty() { Meets { first: self.first, ..NEVER } } else { Meets { flags: 0, ..self } }
    }

    /// The same, with no longer anything known of where it is met.
    pub fn unsure(self) -> Meets {
        if self.is_empty() { NEVER } else { Meets { flags: 0, first: EMPTY, ..self } }
    }

    /// Its part at `t >= 0`: where the ray starts inside a whole stretch, `near` is 0, still
    /// exact; inside one that isn't whole, the first point inside isn't known.
    pub fn ahead(self) -> Meets {
        if self.is_empty() || self.far < 0.0 {
            return Meets { first: self.first, ..NEVER }
        }
        if self.near >= 0.0 {
            return self
        }
        let flags = if self.whole() { self.flags } else { self.flags & !MEETS_EXACT }
        Meets { near: 0.0, far: self.far, first: self.first, flags }
    }

    /// The same, met by the time `inner` (the surface grown by less) is first met, where `inner`
    /// says so exactly.
    fn met_by(self, inner: Meets) -> Meets {
        let f = if !inner.is_empty() && inner.exact() { inner.near } else { EMPTY }
        Meets { first: min(self.first, f), ..self }
    }
}

/// Where the ray `o + t d` (for every `t`, before `ahead`) meets the ball of radius `r` about
/// `c`: its two roots, found so that neither loses its digits to the other's (the root of larger
/// size first, the other from their product).
fn ball_meets(o: vec3, d: vec3, c: vec3, r: f32) -> Meets {
    if !(r >= 0.0) {
        return NEVER
    }
    let oc = o - c
    let a = dot(d, d)
    let b = dot(oc, d)
    let q = dot(oc, oc) - r * r
    let h = b * b - a * q
    if !(h >= 0.0) || !(a > 0.0) {
        return NEVER
    }
    let s = sqrt(h)
    let k = if b >= 0.0 { -b - s } else { -b + s }
    if k == 0.0 {
        return Meets { near: 0.0, far: 0.0, first: EMPTY, flags: 3 }
    }
    let t0 = k / a
    let t1 = q / k
    Meets { near: min(t0, t1), far: max(t0, t1), first: EMPTY, flags: 3 }
}

/// Where `o + t d` along one axis is within `h` of 0: every `t`, or none, where `d` is 0.
fn slab(o: f32, d: f32, h: f32) -> vec2 {
    if d == 0.0 {
        if abs(o) <= h { vec2(-EMPTY, EMPTY) } else { vec2(EMPTY, -EMPTY) }
    } else {
        let a = (-h - o) / d
        let b = (h - o) / d
        vec2(min(a, b), max(a, b))
    }
}

/// Where the ray meets the box of half-extents `h` about the origin (the slabs' common part).
fn box_meets(o: vec3, d: vec3, h: vec3) -> Meets {
    if !(min(h.x, min(h.y, h.z)) >= 0.0) {
        return NEVER
    }
    let x = slab(o.x, d.x, h.x)
    let y = slab(o.y, d.y, h.y)
    let z = slab(o.z, d.z, h.z)
    let near = max(x.x, max(y.x, z.x))
    let far = min(x.y, min(y.y, z.y))
    if near > far { NEVER } else { Meets { near, far, first: EMPTY, flags: 3 } }
}

/// Where the ray meets the hull of the ball of radius `ra + grow` about `pa` and that of
/// `rb + grow` about `pb` (a round cone; Inigo Quilez's intersection of a rounded cone, entry and
/// exit), met by the same hull of radii `+ inner` where those stay at least 0 (shrunk further, a
/// round cone's erosion isn't a round cone, and nothing is said). The hull is the two balls and
/// the cone between the circles where it touches them, and it is convex: so the ray is inside
/// from its first crossing of any of them to its last. The two hulls share their setup, and
/// both are found on every call with no branch between: what they compute from the ray's origin
/// alone is the same for every invocation where the origin is, and moves onto the CPU (§18.13).
fn round_cone_meets(o: vec3, d: vec3, pa: vec3, pb: vec3, ra: f32, rb: f32, grow: f32, inner: f32) -> Meets {
    let ba = pb - pa
    let m0 = dot(ba, ba)
    let rr = ra - rb
    if m0 <= rr * rr {
        // One ball holds the other.
        let (c, r) = if rr >= 0.0 { (pa, ra) } else { (pb, rb) }
        let m = ball_meets(o, d, c, r + grow).ahead()
        return if r + inner >= 0.0 { m.met_by(ball_meets(o, d, c, r + inner).ahead()) } else { m }
    }
    let len = length(d)
    if !(len > 0.0) {
        return NEVER
    }
    let rd = d / len
    // First the ball that holds it all: most rays that miss a part miss that.
    let mid = 0.5 * (pa + pb)
    let oc = o - mid
    let b = dot(oc, rd)
    let around = 0.5 * sqrt(m0) + max(ra, rb) + grow
    if b * b - (dot(oc, oc) - around * around) < 0.0 || (b > 0.0 && dot(oc, oc) > around * around) {
        return NEVER
    }
    let oa = o - pa
    let m1 = dot(ba, oa)
    let m2 = dot(ba, rd)
    let m3 = dot(rd, oa)
    let m5 = dot(oa, oa)
    let d2 = m0 - rr * rr
    let k2 = d2 - m2 * m2
    let m = cone_crossings(o, rd, pa, pb, ra + grow, rb + grow, m0, m1, m2, m3, m5, d2, k2, rr)
    if m.is_empty() {
        return NEVER
    }
    let n = cone_crossings(o, rd, pa, pb, ra + inner, rb + inner, m0, m1, m2, m3, m5, d2, k2, rr)
    let outer = Meets { near: m.near / len, far: m.far / len, first: EMPTY, flags: 3 }.ahead()
    if min(ra, rb) + inner < 0.0 || n.is_empty() {
        return outer
    }
    outer.met_by(Meets { near: n.near / len, far: n.far / len, first: EMPTY, flags: 3 }.ahead())
}

/// The ray's crossings (`t` along the unit `rd`) of the round cone of radii `ra`, `rb` (their
/// difference `rr`) and the dot products its setup made: its two balls' and its cone's between
/// the circles where it touches them.
fn cone_crossings(o: vec3, rd: vec3, pa: vec3, pb: vec3, ra: f32, rb: f32, m0: f32, m1: f32, m2: f32, m3: f32, m5: f32, d2: f32, k2: f32, rr: f32) -> Meets {
    var m = ball_meets(o, rd, pa, ra).or(ball_meets(o, rd, pb, rb))
    let k1 = d2 * m3 - m1 * m2 + m2 * rr * ra
    let k0 = d2 * m5 - m1 * m1 + m1 * rr * ra * 2.0 - m0 * ra * ra
    let h = k1 * k1 - k0 * k2
    if h >= 0.0 && k2 != 0.0 {
        let s = sqrt(h)
        let ta = (-k1 - s) / k2
        let ya = m1 - ra * rr + ta * m2
        if ya > 0.0 && ya < d2 {
            m = m.or(Meets { near: ta, far: ta, first: EMPTY, flags: 3 })
        }
        let tb = (-k1 + s) / k2
        let yb = m1 - ra * rr + tb * m2
        if yb > 0.0 && yb < d2 {
            m = m.or(Meets { near: tb, far: tb, first: EMPTY, flags: 3 })
        }
    }
    m
}

/// Where the ray is on the side of a plane `dot(p, n) <= c`.
fn side_meets(o: vec3, d: vec3, n: vec3, c: f32) -> Meets {
    let dn = dot(d, n)
    let e = c - dot(o, n)
    if dn == 0.0 {
        return if e >= 0.0 { EVERYWHERE.ahead() } else { NEVER }
    }
    let t = e / dn
    if dn > 0.0 { Meets { near: -EMPTY, far: t, first: EMPTY, flags: 3 }.ahead() } else { Meets { near: t, far: EMPTY, first: EMPTY, flags: 3 }.ahead() }
}

/// A bound's sphere, grown by `grow` over its slope (`Surface::meets_grown`'s default).
fn bound_meets(b: Bound, o: vec3, d: vec3, grow: f32) -> Meets {
    if b.radius >= 1.0e30 || !(b.slope > 0.0) {
        return Meets { near: 0.0, far: EMPTY, first: EMPTY, flags: 0 }
    }
    ball_meets(o, d, b.centre, b.radius + max(grow, 0.0) / b.slope).ahead().unsure()
}

/// Where a ray passes nearest a surface, or goes deepest into it (`Surface::passes`): the least
/// its distance comes to along the ray (`t >= 0`), a `t` where it does, and `low..high`, which
/// holds the true least. `PASS_EXACT`: `distance` is that least, to rounding (`low`, `high` the
/// same), and the distance at `t`; else `distance` is `high`, the least known value at or above
/// the true least, and the surface's distance at `t` is at most it (it was asked there, or a
/// part's was, which a join only lowers). At most 0: the ray meets the surface. Through a union, the next
/// nearest member's pass too (`other`, its `t`, and `other_distance`, lowered as `distance` is;
/// `EMPTY` where there's none), and the widest smooth join that lowered it (`blend`, its `k`):
/// where the two nearest are within `blend` of each other the true least can lie between them
/// (a seam), which `refined` asks.
pub struct Pass: Copy + GpuData {
    pub t: f32,
    pub distance: f32,
    /// The true least is at least `low` and at most `high` (both `distance` where exact).
    pub low: f32,
    pub high: f32,
    pub flags: u32,
    pub other: f32,
    pub other_distance: f32,
    pub blend: f32,
}

/// `Pass`'s flag: `distance` is the least along the ray, to rounding.
pub const PASS_EXACT: u32 = 1

impl Pass {
    /// Whether `distance` is the least along the ray, to rounding.
    pub fn exact(self) -> bool {
        (self.flags & PASS_EXACT) != 0
    }

    /// Whether the ray meets the surface.
    pub fn meets(self) -> bool {
        self.distance <= 0.0
    }

    /// The nearer of two surfaces' passes (a union's): exact if both are; the other's nearest
    /// kept as `other` where it is nearer than the nearer's own.
    pub fn or(self, b: Pass) -> Pass {
        let flags = self.flags & b.flags
        let blend = max(self.blend, b.blend)
        let (low, high) = (min(self.low, b.low), min(self.high, b.high))
        let w = if b.distance < self.distance { b } else { self }
        let l = if b.distance < self.distance { self } else { b }
        if l.distance < w.other_distance {
            Pass { t: w.t, distance: w.distance, low, high, flags, other: l.t, other_distance: l.distance, blend }
        } else {
            Pass { flags, blend, low, high, ..w }
        }
    }

    /// The same, lowered by up to `by` (a smooth join of width `k`, its lowering): `low` less
    /// `by`, `high` as it was (a join only lowers), `distance` its low until asked.
    pub fn lowered(self, by: f32, k: f32) -> Pass {
        Pass {
            t: self.t,
            distance: self.low - by,
            low: self.low - by,
            high: self.high,
            flags: 0,
            other: self.other,
            other_distance: self.other_distance - by,
            blend: max(self.blend, k),
        }
    }

    /// A bound made nearly the least: `f` (the surface's distance, or its live parts') asked
    /// four times along the ray: three evenly spaced, then one where the parabola through them
    /// is least; the least asked, and where (`distance`, `high`; `low` as it was). Round `t`, `h` apart (a length, m); in a seam (the
    /// next nearest within `blend` of the nearest), from `t` to `other`. Not a bound any more:
    /// at least the true least, by little where `f` is smooth there (std's tests and the
    /// toolchain's `passes` fixture measure how little). An exact pass is returned as it is.
    pub fn refined<F: Copy + fn(vec3) -> f32>(self, o: vec3, d: vec3, f: F, h: f32) -> Pass {
        if self.exact() {
            return self
        }
        let seam = self.other_distance - self.distance < self.blend
        let centre = if seam { 0.5 * (self.t + self.other) } else { self.t }
        let k = max(if seam { 0.5 * abs(self.other - self.t) } else { 0.0 }, h / length(d))
        let t1 = max(centre, k)
        let t0 = t1 - k
        let t2 = t1 + k
        let f0 = f(o + d * t0)
        let f1 = f(o + d * t1)
        let f2 = f(o + d * t2)
        let den = f0 - 2.0 * f1 + f2
        let tv = if den > 0.0 { max(t1 + 0.5 * k * (f0 - f2) / den, 0.0) } else { if f0 < f2 { t0 } else { t2 } }
        let fv = f(o + d * tv)
        var at = t1
        var least = f1
        if f0 < least {
            at = t0
            least = f0
        }
        if f2 < least {
            at = t2
            least = f2
        }
        if fv < least {
            at = tv
            least = fv
        }
        self.asked(at, least)
    }

    /// The same, with the surface's distance asked at `t` and found `f`: where that is less than
    /// `high`, it is `high` and `distance` and `t` is there (`low` no more than it).
    pub fn asked(self, t: f32, f: f32) -> Pass {
        if f < self.high {
            Pass { t, distance: f, low: min(self.low, f), high: f, flags: 0, ..self }
        } else {
            Pass { distance: self.high, flags: 0, ..self }
        }
    }
}

/// A pass at `t`, `distance` away, of one surface (no other member's, no blend).
fn pass_at(t: f32, distance: f32, flags: u32) -> Pass {
    let high = if (flags & PASS_EXACT) != 0 { distance } else { EMPTY }
    Pass { t, distance, low: distance, high, flags, other: t, other_distance: EMPTY, blend: 0.0 }
}

/// Where the ray passes nearest the ball of radius `r` about `c`: the nearest point of the ray
/// to `c`. Exact.
fn ball_passes(o: vec3, d: vec3, c: vec3, r: f32) -> Pass {
    let t = max(dot(c - o, d) / dot(d, d), 0.0)
    pass_at(t, length(o + d * t - c) - r, PASS_EXACT)
}

/// A bound's pass, at most the least of the distance of what it bounds: its ball's, times its
/// slope outside the ball; inside it, the ball's own (a distance exact or below the true one in
/// size is no deeper than the ball is). Where it bounds nothing, it says nothing.
fn bound_passes(b: Bound, o: vec3, d: vec3) -> Pass {
    if b.radius >= 1.0e30 || !(b.slope > 0.0) {
        return pass_at(0.0, -EMPTY, 0)
    }
    let p = ball_passes(o, d, b.centre, b.radius)
    pass_at(p.t, if p.distance < 0.0 { max(b.slope, 1.0) * p.distance } else { b.slope * p.distance }, 0)
}

/// A surface's bound's pass as `low`, and its distance asked there as `high` and `distance`.
fn bound_pass_asked<S: Surface>(s: S, o: vec3, d: vec3) -> Pass {
    let p = bound_passes(s.bound(), o, d)
    p.asked(p.t, s.distance(o + d * p.t))
}

/// Where the ray passes nearest the box of half-extents `h` about the origin. The squared
/// distance from the ray's point to the box, `g(t)`, is convex: on each axis the point is
/// outside the box's slab before the ray enters it (at `a`) and after it leaves (at `b`), and
/// half `g`'s slope is the sum over the axes of `d^2 (t - clamp(t, a, b))`: continuous,
/// piecewise linear and rising, with a corner at each `a` and `b`. Where the ray is in every
/// slab at once (the most `a` at most the least `b`), it meets the box there. Else the least on
/// `t >= 0` is at 0 where the slope is at least 0 there, or where the slope crosses 0, between
/// the last corner where it is below 0 and the first where it is at least 0 (or past the last
/// corner): no corner lies between, so the slope is a line there. An axis the ray runs along
/// has no corner and no slope. Exact.
fn box_passes(o: vec3, d: vec3, h: vec3) -> Pass {
    let w = d * d
    let sx = pass_slab(o.x, d.x, h.x)
    let sy = pass_slab(o.y, d.y, h.y)
    let sz = pass_slab(o.z, d.z, h.z)
    let a = vec3(sx.x, sy.x, sz.x)
    let b = vec3(sx.y, sy.y, sz.y)
    let enter = max(a.x, max(a.y, a.z))
    let exit = min(b.x, min(b.y, b.z))
    let s0 = box_slope(w, a, b, 0.0)
    var t = 0.0
    if enter <= exit && exit >= 0.0 {
        // In every slab at once: in the box, unless an axis the ray doesn't move along is
        // outside its slab (that slab is everywhere, for this test), where the deepest is above 0.
        let deep = box_deepest(o, d, h)
        if deep.distance <= 0.0 {
            return deep
        }
    }
    if s0 < 0.0 {
        // (lo, its slope, hi, its slope): the last corner below 0 and the first at or above it.
        var k = vec4(0.0, s0, EMPTY, 0.0)
        k = box_bracket(k, max(a.x, 0.0), w, a, b)
        k = box_bracket(k, max(a.y, 0.0), w, a, b)
        k = box_bracket(k, max(a.z, 0.0), w, a, b)
        k = box_bracket(k, max(b.x, 0.0), w, a, b)
        k = box_bracket(k, max(b.y, 0.0), w, a, b)
        k = box_bracket(k, max(b.z, 0.0), w, a, b)
        if k.z == EMPTY {
            // Past the last corner: the slope's line from `lo`.
            let rise = box_slope(w, a, b, k.x + 1.0) - k.y
            t = if rise > 0.0 { k.x - k.y / rise } else { k.x }
        } else {
            t = k.x - k.y * (k.z - k.x) / (k.w - k.y)
        }
    }
    let q = abs(o + d * t) - h
    let m = max(q.x, max(q.y, q.z))
    pass_at(t, if m > 0.0 { length(max(q, vec3(0.0))) } else { m }, PASS_EXACT)
}

/// The deepest the box's distance goes along a ray that goes into it (`t >= 0`). Inside, it is
/// `max(|x| - h)` over the axes: the most of six lines in `t`, on each axis the ray moves along
/// one rising (`|d| t + a`) and one falling (`-|d| t + b`), and on an axis it doesn't, a constant
/// `|o| - h`. The least of the most of lines is where the rising ones' upper envelope crosses the
/// falling ones' (or at `t = 0`, where they cross behind the ray), which is the most over each
/// rising and falling pair of where those two cross: nine pairs, three at a time. Exact.
fn box_deepest(o: vec3, d: vec3, h: vec3) -> Pass {
    let s = sign(d)
    let w = abs(d)
    let a = s * o - h
    let b = -s * o - h
    // 1 on an axis the ray moves along, 0 on one it doesn't.
    let moving = sign(w)
    let still = (abs(o) - h) * (vec3(1.0) - moving) - moving * EMPTY
    let x = box_crossings(a.x, w.x, b, w, moving)
    let y = box_crossings(a.y, w.y, b, w, moving)
    let z = box_crossings(a.z, w.z, b, w, moving)
    let xy = if y.x > x.x { y } else { x }
    let m = if z.x > xy.x { z } else { xy }
    let least = m.x
    let t = m.y
    pass_at(t, max(least, max(still.x, max(still.y, still.z))), PASS_EXACT)
}

/// `box_deepest`'s rising line `wi t + ai` against each falling one (`-w t + b`, on the axes
/// `moving` says): the most where they cross (or at `t = 0`), and there `t`; `-EMPTY` where the
/// rising line's axis doesn't move.
fn box_crossings(ai: f32, wi: f32, b: vec3, w: vec3, moving: vec3) -> vec2 {
    if !(wi > 0.0) {
        return vec2(-EMPTY, 0.0)
    }
    let at = max((b - vec3(ai)) / (vec3(wi) + w), vec3(0.0))
    let v = (vec3(ai) + at * wi) * moving - (vec3(1.0) - moving) * EMPTY
    let xy = if v.y > v.x { vec2(v.y, at.y) } else { vec2(v.x, at.x) }
    if v.z > xy.x { vec2(v.z, at.z) } else { xy }
}

/// Where a ray (`o` and `d` an axis's) enters and leaves the slab `-h..h` of that axis; along it,
/// everywhere (it has no corner there).
fn pass_slab(o: f32, d: f32, h: f32) -> vec2 {
    if d == 0.0 {
        return vec2(-EMPTY, EMPTY)
    }
    let n = (-h - o) / d
    let f = (h - o) / d
    vec2(min(n, f), max(n, f))
}

/// Half the slope of `box_passes`'s `g` at `t`: `w` the ray's squared components, `a` and `b`
/// where it enters and leaves each axis's slab.
fn box_slope(w: vec3, a: vec3, b: vec3, t: f32) -> f32 {
    dot(w, vec3(t) - clamp(vec3(t), a, b))
}

/// `box_passes`'s bracket `k` (lo, its slope, hi, its slope) with the corner at `c` taken in.
fn box_bracket(k: vec4, c: f32, w: vec3, a: vec3, b: vec3) -> vec4 {
    let g = box_slope(w, a, b, c)
    let lo = g < 0.0 && c > k.x
    let hi = g >= 0.0 && c < k.z
    vec4(if lo { c } else { k.x }, if lo { g } else { k.y }, if hi { c } else { k.z }, if hi { g } else { k.w })
}

/// Where the ray passes nearest the round cone `c`. The hull of two balls is the union of the
/// balls between them, centred at `a + s (b - a)` with radius `r1 + s (r2 - r1)` for `s` in
/// 0..1 (a mix of two balls is a ball), so the least over the ray's line of the distance is the
/// least over `s` of the ball's centre's distance from the line less its radius: across the
/// ray, the distance from a point to a segment less a radius that changes along it, convex in
/// `s`, least where its slope is 0 (a quadratic's root, clamped to 0..1). Along the ray, its
/// nearest point to that centre; where that is behind the ray's start, the least on `t >= 0`
/// is at the start (the distance is convex along the ray). Exact.
fn round_cone_passes(o: vec3, d: vec3, c: RoundCone) -> Pass {
    let e = c.b - c.a
    let l = length(e)
    let rr = c.r1 - c.r2
    if l <= abs(rr) {
        return ball_passes(o, d, select(if_false: c.b, if_true: c.a, cond: rr >= 0.0), max(c.r1, c.r2))
    }
    let dd = dot(d, d)
    let oa = o - c.a
    // Across the ray: `o - a` and `b - a` less their parts along it.
    let u = oa - d * (dot(oa, d) / dd)
    let v = e - d * (dot(e, d) / dd)
    let delta = c.r2 - c.r1
    let w = dot(v, v)
    let beta = dot(u, v)
    var s = 0.0
    if w > delta * delta {
        let across = length(u - v * (beta / w))
        s = clamp(beta / w + delta * across / sqrt(w * (w - delta * delta)), 0.0, 1.0)
    } else if delta != 0.0 {
        // The segment across the ray is shorter than the radii's difference: the larger end.
        s = if delta > 0.0 { 1.0 } else { 0.0 }
    } else {
        // Along the ray, a cylinder's sides: every `s` alike; the end farther along the ray.
        s = if dot(e, d) > 0.0 { 1.0 } else { 0.0 }
    }
    let t = dot(c.a + e * s - o, d) / dd
    if t >= 0.0 {
        pass_at(t, length(v * s - u) - (c.r1 + delta * s), PASS_EXACT)
    } else {
        pass_at(0.0, c.distance(o), PASS_EXACT)
    }
}

/// The most a fold of `n` smooth unions of width `k` (`[..].smooth_union(k)`) lowers the least
/// of its parts' distances: one `smin` lowers it by at most `k / 4`, and each part folded after
/// lowers it again, the most where the distances are equal: L(1) = 0, L(i + 1) = L(i) +
/// (k - L(i))^2 / 4k, which rises to `k` (L(17) = 0.817 k). (By induction: the fold so far at
/// least its parts' least `m` less L, the next part `x`, `smin` lowers `min` by (k - |F - x|)^2 /
/// 4k; with `x` above the fold by `u` at most L, `min(m, x)` less the result is at most
/// u + (k - u)^2 / 4k, which rises with `u` to L(i + 1); any other `x` lowers it less. Equal
/// distances reach it, so a fold of equal parts is grown by exactly this.) It is `k` times
/// the same of `k = 1` (the recursion scales with `k`): a table the build computes, read at `n`
/// (past 128 parts, `k`, which bounds every fold), so no code a shader runs loops for it.
fn fold_lowering(n: u32, k: f32) -> f32 {
    k * (if n > 128 { 1.0 } else { FOLD_LOWERING[n] })
}

/// The join of two parts at `p`, or of three (`smin` of their distances, `k` wide): a fold's
/// seam, as its `passes` models it.
fn seam_at<S: Surface>(a: S, b: S, c: S, three: bool, p: vec3, k: f32) -> f32 {
    let ab = smin(a.distance(p), b.distance(p), k)
    if three { smin(ab, c.distance(p), k) } else { ab }
}

/// How many even samples a fold's `passes` takes of a seam before its search.
const SEAM_SAMPLES: u32 = 5

/// How many steps a fold's `passes` takes in a seam (`SmoothUnionAll::passes`): each narrows
/// the stretch by 0.618 and asks three parts' distances once.
const SEAM_STEPS: u32 = 6

/// `fold_lowering` of `k = 1` for 0 to 128 parts.
const FOLD_LOWERING: [f32; 129] = fold_lowerings()

fn fold_lowerings() -> [f32; 129] {
    var out = [0.0; 129]
    var x = 0.0
    for i in 2..129 {
        x += 0.25 * (1.0 - x) * (1.0 - x)
        out[i] = x
    }
    out
}

/// `work` of `s`'s masked ask (`distance_live`), the mask unknown to the count: what it costs
/// with every part live.
fn masked_work<S: Surface>(s: S) -> u32 {
    let live = ALL_LIVE
    work(|q: vec3| s.distance_live(q, live))
}

/// A surface's ranges over a box (`Surface::range`): its distance's, and each component of its
/// gradient's.
pub struct FieldRange: Copy + GpuData {
    pub value: Interval,
    pub gradient: Box3,
}

/// Which parts of a surface an ask evaluates (`Surface::live`, `distance_live`): bit `i % 32` of
/// `words[i / 32]` for part `i`, in §23's numbering (the order a surface's leaves are written).
/// A part past the 128th is always asked.
pub struct Live: Copy + GpuData + Plain + Eq + StateHash {
    pub words: vec4u,
}

/// Every part asked.
pub const ALL_LIVE: Live = Live { words: vec4u(4294967295) }

impl Live {
    /// The parts a word names: bit `i` for part `i` of the first 32, and every part past them.
    pub fn from_word(w: u32) -> Live {
        Live { words: vec4u(w, 4294967295, 4294967295, 4294967295) }
    }

    /// The first 32 parts' bits, as `from_word` takes them.
    pub fn word(self) -> u32 {
        self.words.x
    }

    /// Whether part `i` is asked: a shift and an and of one word. Of the first 32 parts, the
    /// first word, read alone; past them, the word chosen by selects (no index into the four,
    /// which keeps them in memory where `i` isn't a constant).
    pub fn has(self, i: u32) -> bool {
        let w = if i < 32 { self.words.x } else { self.word_at(i >> 5) }
        i >= 128 || ((w >> (i & 31)) & 1) != 0
    }

    /// Word `w` of the four (0 to 3), chosen by selects.
    fn word_at(self, w: u32) -> u32 {
        let v = self.words
        select(
            if_false: select(if_false: v.x, if_true: v.y, cond: w == 1),
            if_true: select(if_false: v.z, if_true: v.w, cond: w == 3),
            cond: w >= 2,
        )
    }

    /// Whether any of the `count` parts from `first` on is asked: one part's bit, or each word
    /// and'ed with the span's bits in it (constants, where the span is).
    pub fn any(self, first: u32, count: u32) -> bool {
        if count == 1 {
            self.has(first)
        } else if first + count > 128 {
            count > 0
        } else {
            (self.words & spans(first, count)) != vec4u(0)
        }
    }

    /// The same, with the `count` parts from `first` on left out.
    pub fn without(self, first: u32, count: u32) -> Live {
        Live { words: self.words & (vec4u(4294967295) ^ spans(first, count)) }
    }

    /// How many of the first `parts` parts are asked.
    pub fn count(self, parts: u32) -> u32 {
        let w = self.words & spans(0, min(parts, 128))
        max(parts, 128) - 128 + w.x.count_ones() + w.y.count_ones() + w.z.count_ones() + w.w.count_ones()
    }
}

/// The bits of each word that parts `first..first + count` take (of the first 128).
fn spans(first: u32, count: u32) -> vec4u {
    vec4u(span_bits(first, count, 0), span_bits(first, count, 1), span_bits(first, count, 2), span_bits(first, count, 3))
}

/// The live bits among parts `first..first + count`, one word's (the span within it), shifted so
/// bit `i` is part `first + i`: a masked array of single parts walks these, clearing the lowest
/// each pass, so it asks only its live parts.
fn leaf_bits(live: Live, first: u32, count: u32) -> u32 {
    let w = if first < 32 { live.words.x } else { live.word_at(first >> 5) }
    let ones = if count >= 32 { 4294967295 } else { (u32(1) << count) - 1 }
    (w >> (first & 31)) & ones
}

/// The bits of word `w` (parts `32 w` to `32 w + 31`) that parts `first..first + count` take.
fn span_bits(first: u32, count: u32, w: u32) -> u32 {
    let lo = max(first, 32 * w)
    let hi = min(first + count, 32 * w + 32)
    let n = if hi > lo { hi - lo } else { 0 }
    let ones = if n >= 32 { 4294967295 } else { (u32(1) << n) - 1 }
    if n == 0 { 0 } else { ones << (lo - 32 * w) }
}

/// Where a part of a surface can be (`Surface::part_bound`): within `r` of the segment from `a` to
/// `b` (a sphere where they're one point), how far the joins above it can carry its effect past
/// that (`reach`), and of that, how far they lower the distance (`lowers`): the whole surface lies
/// within some part's `r + lowers` of its segment (where the whole is at most 0, a part's own
/// distance is at most what the joins above it lower it by), so a march for the surface needs only
/// `lowers`; a part's effect on the distance, `reach` (`live_along`). A smooth join of width `k`
/// adds `k` and its lowering to `reach`, its lowering alone to `lowers`.
pub struct PartBound: Copy + GpuData {
    pub a: vec3,
    pub r: f32,
    pub b: vec3,
    pub reach: f32,
    pub lowers: f32,
}

/// The parts of `s` a segment from `a` to `b` can come near: those whose bound
/// (`Surface::part_bound`) it passes within the part's `r`, its `reach` and `widen` of. A part
/// left out is farther than its reach from every point of the segment: there it changes the
/// distance nowhere the surface can be (a smooth join of width `k` changes the distance only
/// within `k` of where its operands meet, and lowers the rest by at most its lowering, which the
/// reach adds), so `distance_live` with these parts is the distance wherever the surface can be
/// on the segment, and a bound elsewhere: a march along it meets what the whole surface meets.
/// Parts past the 128th are always asked. It asks each part's bound once: for the engine's
/// creature (18 parts), 18 bounds and 18 segment distances, once a ray.
pub fn live_along<S: Surface>(s: S, a: vec3, b: vec3, widen: f32) -> Live {
    var w = vec4u(0)
    for i in 0..min(s.parts(), 128) {
        let c = s.part_bound(i)
        if segments_apart(a, b, c.a, c.b) <= c.r + c.reach + widen {
            let bit = u32(1) << (i & 31)
            let k = i >> 5
            if k == 0 {
                w.x = w.x | bit
            } else if k == 1 {
                w.y = w.y | bit
            } else if k == 2 {
                w.z = w.z | bit
            } else {
                w.w = w.w | bit
            }
        }
    }
    Live { words: w }
}

/// The least distance between the segments from `p0` to `p1` and from `q0` to `q1` (the closest
/// points of two segments, as Ericson's Real-Time Collision Detection §5.1.9 finds them).
pub fn segments_apart(p0: vec3, p1: vec3, q0: vec3, q1: vec3) -> f32 {
    let d1 = p1 - p0
    let d2 = q1 - q0
    let r = p0 - q0
    let a = dot(d1, d1)
    let e = dot(d2, d2)
    let f = dot(d2, r)
    if a <= 1.0e-12 && e <= 1.0e-12 {
        return length(r)
    }
    var s = 0.0
    var t = 0.0
    if a <= 1.0e-12 {
        t = clamp(f / e, 0.0, 1.0)
    } else {
        let c = dot(d1, r)
        if e <= 1.0e-12 {
            s = clamp(-c / a, 0.0, 1.0)
        } else {
            let bb = dot(d1, d2)
            let den = a * e - bb * bb
            s = if den > 1.0e-12 { clamp((bb * f - c * e) / den, 0.0, 1.0) } else { 0.0 }
            t = (bb * s + f) / e
            if t < 0.0 {
                t = 0.0
                s = clamp(-c / a, 0.0, 1.0)
            } else if t > 1.0 {
                t = 1.0
                s = clamp((bb - c) / a, 0.0, 1.0)
            }
        }
    }
    length(p0 + d1 * s - (q0 + d2 * t))
}

/// Part `i` of an array of surfaces: which element, and which of its parts (`locate`, at once
/// where every element is one part).
fn part_of<S: Surface, const N: u32>(parts: [S; N], i: u32) -> (u32, u32) {
    if array_parts(parts) == N { (min(i, N - 1), 0) } else { locate(parts, i) }
}

/// What `Surface::pruned` gives: the parts still live, and the surface's range over the box.
pub struct Pruned: Copy + GpuData {
    pub live: Live,
    pub range: Interval,
}

/// Whether `a - b >= k` for every computed `a >= lo` and `b <= hi`, as the target subtracts
/// (rounding is monotone, so the real difference at least `k` is enough; the margin covers the
/// rounding of the test itself). Then `smin(b, a, k)` is `b`, exactly.
fn apart(lo: f32, hi: f32, k: f32) -> bool {
    if k <= 0.0 {
        return lo >= hi
    }
    lo - hi >= k * 1.000001 + 1.0e-30
}

/// A range's ends moved out by a few units in the last place: what a sum of two ranges' ends
/// needs to hold the computed sum.
fn outward(r: Interval) -> Interval {
    Interval { lo: r.lo - abs(r.lo) * 4.0e-7 - 1.0e-37, hi: r.hi + abs(r.hi) * 4.0e-7 + 1.0e-37 }
}

/// A range holding `smin(a, b, k)` for `a` in `x` and `b` in `y`, as the target computes it:
/// at most the smaller (it takes a non-negative amount from it), at least the smaller less
/// `k / 4` (and that amount's rounding). With `k` 0, `min`'s, exactly.
fn smin_range(x: Interval, y: Interval, k: f32) -> Interval {
    let lo = min(x.lo, y.lo)
    let hi = min(x.hi, y.hi)
    if k <= 0.0 {
        return Interval { lo, hi }
    }
    let l = lo - 0.25 * k * 1.000001
    Interval { lo: l - abs(l) * 4.0e-7 - 1.0e-37, hi }
}

/// Two operands joined by `smin` of width `k` (`min` for 0), parts `first..first + na` the
/// first's and the next `nb` the second's: `b.live` is both operands' pruning, `a` the first's
/// range. An operand at least `k` above the other over the box is left out.
fn joined(a: Interval, b: Pruned, first: u32, na: u32, nb: u32, k: f32) -> Pruned {
    let kk = max(k, 0.0)
    if apart(b.range.lo, a.hi, kk) {
        return Pruned { live: b.live.without(first + na, nb), range: a }
    }
    if apart(a.lo, b.range.hi, kk) {
        return Pruned { live: b.live.without(first, na), range: b.range }
    }
    Pruned { live: b.live, range: smin_range(a, b.range, kk) }
}

/// Where a surface is: a sphere, and how fast its distance grows outside it. Its distance at
/// `p` is at least `slope` times `p`'s distance from the sphere: exactly so for a surface whose
/// distance is exact (slope 1); for one whose distance is a bound, `slope` is what the surface
/// states (the ellipsoid's 0.5 is an assumption, not a proof).
pub struct Bound: Copy + GpuData {
    pub centre: vec3,
    pub radius: f32,
    pub slope: f32,
}

/// A bound that holds nothing out: everywhere is inside it.
pub const UNBOUNDED: Bound = Bound { centre: vec3(), radius: 1.0e30, slope: 1.0 }

impl Bound {
    /// The least the surface's distance can be at `p`.
    pub fn below(self, p: vec3) -> f32 {
        self.slope * (length(p - self.centre) - self.radius)
    }

    /// A bound holding both, with the smaller slope.
    pub fn and(self, other: Bound) -> Bound {
        if self.radius >= 1.0e30 || other.radius >= 1.0e30 {
            return UNBOUNDED
        }
        let d = length(other.centre - self.centre)
        if d + other.radius <= self.radius {
            return Bound { slope: min(self.slope, other.slope), ..self }
        }
        if d + self.radius <= other.radius {
            return Bound { slope: min(self.slope, other.slope), ..other }
        }
        let r = 0.5 * (d + self.radius + other.radius)
        let centre = self.centre +
            (other.centre - self.centre) * ((r - self.radius) / max(d, 1.0e-30))
        Bound { centre, radius: r, slope: min(self.slope, other.slope) }
    }

    /// The bound grown so the distance may be `by` lower anywhere (a blend's seam, a
    /// displacement).
    pub fn lowered(self, by: f32) -> Bound {
        Bound { radius: self.radius + abs(by) / max(self.slope, 1.0e-30), ..self }
    }

    /// Moved by `by`.
    pub fn moved(self, by: vec3) -> Bound {
        Bound { centre: self.centre + by, ..self }
    }
}

/// How much part `i` decides `field`'s distance at `p`: how much the distance changes where
/// the part's own distance does (`part_offset`, by 0.1 mm), from 0 (another part decides it:
/// the part can change without moving the surface there) to 1 (the part alone decides it), and
/// between in a blend.
pub fn part_share<S: Surface>(field: S, p: vec3, i: u32) -> f32 {
    (field.part_offset(p, i, by: 0.0001) - field.distance(p)) / 0.0001
}

// ---- measures (§23) ----------------------------------------------------------------------
//
// Where a surface is, as numbers a spec can hold it to (std::lift's `Checks`). Each searches
// with values, then takes one Newton step along its ray, so its derivative by anything the
// field reads (a lifted literal, `std::lift::gradient`) is the exact one: the search's own
// change cancels in the step.

/// How far along the ray from `o` in direction `dir` (a unit vector) it first meets `field`'s
/// surface, within `far`; -1 if it doesn't.
pub fn hit<S: Surface>(field: S, o: vec3, dir: vec3, far: f32 = 10.0) -> f32 {
    var t = 0.0
    var found = false
    for _ in 0..512 {
        let d = field.distance(o + dir * t)
        if abs(d) < 0.00005 {
            found = true
            break
        }
        // From inside, `d` is negative but its magnitude is still the conservative step to
        // the surface. Advancing by a fixed epsilon alone cannot leave a body more than 25.6
        // mm thick before this search's 512-step limit.
        t += max(abs(d) * 0.8, 0.00005)
        if t > far {
            break
        }
    }
    if !found {
        return -1.0
    }
    // One Newton step: the root's derivative, from the slope along the ray.
    let h = 0.0001
    let p = o + dir * t
    let slope = (field.distance(p + dir * h) - field.distance(p - dir * h)) / (2.0 * h)
    if abs(slope) < 0.05 {
        return t
    }
    t - field.distance(p) / slope
}

/// The height of the surface's top above the ground point (`x`, `z`): where a ray from 10 m
/// up meets it, going down; 0 if nothing is above that point.
pub fn top<S: Surface>(field: S, x: f32, z: f32) -> f32 {
    let t = hit(field, vec3(x, 10.0, z), vec3(0.0, -1.0, 0.0), far: 20.0)
    if t < 0.0 { 0.0 } else { 10.0 - t }
}

/// The height of the surface's underside above the ground point (`x`, `z`): where a ray from
/// 10 m down meets it, going up; 0 if nothing is there.
pub fn bottom<S: Surface>(field: S, x: f32, z: f32) -> f32 {
    let t = hit(field, vec3(x, -10.0, z), vec3(0.0, 1.0, 0.0), far: 20.0)
    if t < 0.0 { 0.0 } else { t - 10.0 }
}

/// How wide the surface is across x along the line at height `y` and depth `z`: from where
/// a ray from the left meets it to where one from the right does; 0 if neither does.
pub fn width<S: Surface>(field: S, y: f32, z: f32) -> f32 {
    let a = hit(field, vec3(10.0, y, z), vec3(-1.0, 0.0, 0.0), far: 20.0)
    let b = hit(field, vec3(-10.0, y, z), vec3(1.0, 0.0, 0.0), far: 20.0)
    if a < 0.0 || b < 0.0 { 0.0 } else { (10.0 - a) - (b - 10.0) }
}

/// The surface's front along z at height `y`, `x` from the middle: where a ray from 10 m in
/// front (+z) meets it, going back; -10 if nothing is there.
pub fn front<S: Surface>(field: S, x: f32, y: f32) -> f32 {
    let t = hit(field, vec3(x, y, 10.0), vec3(0.0, 0.0, -1.0), far: 20.0)
    if t < 0.0 { -10.0 } else { 10.0 - t }
}

/// The surface's back along z at height `y`, `x` from the middle (`front`, from behind); 10
/// if nothing is there.
pub fn back<S: Surface>(field: S, x: f32, y: f32) -> f32 {
    let t = hit(field, vec3(x, y, -10.0), vec3(0.0, 0.0, 1.0), far: 20.0)
    if t < 0.0 { 10.0 } else { t - 10.0 }
}

/// How far the surface reaches in direction `dir` (a unit vector) within `region`: the
/// largest p · dir over the surface there. Rays along −dir sweep the region's cross-section,
/// 16 by 16, then twice more 8 by 8 around the best, each from where it enters the region, so
/// the surface outside it hides nothing. The measure is the best ray's hit, so its derivative
/// is that point's; where the surface fills the region's edge, it's the edge. -10⁹ if the
/// region holds no surface.
pub fn farthest<S: Surface>(field: S, dir: vec3, region: Box3) -> f32 {
    let c = region.center()
    let e = region.hi - region.lo
    let reach = length(e)
    // Two axes across `dir`.
    let helper = if abs(dir.y) < 0.9 { vec3(0.0, 1.0, 0.0) } else { vec3(1.0, 0.0, 0.0) }
    let u = normalize(cross(helper, dir))
    let v = cross(dir, u)
    // The rays' way, and its inverse for the region's slabs.
    let w = -dir
    let inv = vec3(slab_inverse(w.x), slab_inverse(w.y), slab_inverse(w.z))
    var centre = vec2(0.0)
    var half = 0.5 * reach
    var best = -1.0e9
    for round in 0..3 {
        let n = if round == 0 { 16 } else { 8 }
        var found = centre
        for i in 0..n {
            for j in 0..n {
                let a = centre +
                    vec2((f32(i) + 0.5) / f32(n) * 2.0 - 1.0, (f32(j) + 0.5) / f32(n) * 2.0 - 1.0) *
                        half
                let o = c + u * a.x + v * a.y + dir * reach
                // Where the ray enters the region and leaves it.
                let t_lo = (region.lo - o) * inv
                let t_hi = (region.hi - o) * inv
                let near = min(t_lo, t_hi)
                let far = max(t_lo, t_hi)
                let t0 = max(max(near.x, near.y), max(near.z, 0.0))
                let t1 = min(far.x, min(far.y, far.z))
                if t0 < t1 {
                    let p0 = o + w * t0
                    var m = -1.0e9
                    if field.distance(p0) <= 0.0 {
                        m = dot(p0, dir)
                    } else {
                        let t = hit(field, p0, w, far: t1 - t0)
                        if t >= 0.0 {
                            m = dot(p0 + w * t, dir)
                        }
                    }
                    if m > best {
                        best = m
                        found = a
                    }
                }
            }
        }
        centre = found
        half = half * 2.5 / f32(n)
    }
    best
}

/// 1 / x for a ray's slab test, large and finite where x is 0, so no NaN comes of 0 / 0.
fn slab_inverse(x: f32) -> f32 {
    if abs(x) < 0.000001 { 1.0e6 } else { 1.0 / x }
}

/// The index of the part named `name` (`part_name(i).name`): the first, if several share it,
/// and `parts()` if none does.
pub fn part_named<S: Surface>(field: S, name: str) -> u32 {
    for i in 0..field.parts() {
        if field.part_name(i).name == name {
            return i
        }
    }
    field.parts()
}

/// Part `i`'s family: the first part with its name in its group, so a part and its mirror
/// image are one family. An unnamed part is its own.
pub fn part_family<S: Surface>(field: S, i: u32) -> u32 {
    let a = field.part_name(i)
    if a.name.len() == 0 {
        return i
    }
    for j in 0..i {
        let b = field.part_name(j)
        if b.name == a.name && b.group == a.group {
            return j
        }
    }
    i
}

/// Each part's family (`part_family`), by index.
pub fn part_families<S: Surface>(field: S) -> Vec<u32> {
    Vec::from_fn(field.parts(), |i| part_family(field, i))
}

/// Part `i`'s mirror image: the part with its name in its group, mirrored the other way; `i`
/// itself if it has none, or no name.
pub fn part_image<S: Surface>(field: S, i: u32) -> u32 {
    let a = field.part_name(i)
    if a.name.len() == 0 {
        return i
    }
    for j in 0..field.parts() {
        let b = field.part_name(j)
        if j != i && b.name == a.name && b.group == a.group && b.mirrored != a.mirrored {
            return j
        }
    }
    i
}

// ---- certified checks (§23) ------------------------------------------------------------

/// What a certified check of a region found: the property holds at every point of it (proved by
/// derived intervals, §14), it fails at a point (a counterexample), or the intervals couldn't
/// tell within the depth asked, first in the box given.
pub enum Certified: Copy {
    Holds,
    Fails(vec3),
    Unknown(Box3),
}

impl Certified {
    /// Whether the check proved the property: `Holds`.
    pub fn holds(self) -> bool {
        match self {
            Certified::Holds => true,
            _ => false,
        }
    }
}

/// Whether `f` is positive everywhere in `region`: its derived interval over each box (the
/// region, then its octree, `depth` levels at most) is above 0 there, or a point where it isn't.
/// Each box is checked at its centre too, so a failure is found as a point, not just a box.
///
/// ```wrela
/// use std::derive::Box3
/// use std::field::{Surface, certify_positive, sphere}
///
/// let s = sphere(0.5).translate(vec3(0.0, 0.6, 0.0))
/// let below = Box3 { lo: vec3(-2.0, -1.0, -2.0), hi: vec3(2.0, 0.0, 2.0) }
/// assert(certify_positive(|p: vec3| s.distance(p), below, depth: 6).holds())
/// ```
pub fn certify_positive(f: fn(vec3) -> f32, region: Box3, depth: u32) -> Certified {
    var stack: Vec<(Box3, u32)> = Vec::new()
    stack.push((region, 0))
    var unknown: Option<Box3> = None
    while let Some((b, d)) = stack.pop() {
        let r = interval(f, b)
        if r.lo > 0.0 {
            continue
        }
        let c = b.center()
        if r.hi <= 0.0 || !(f(c) > 0.0) {
            return Certified::Fails(c)
        }
        if d >= depth {
            if unknown.is_none() {
                unknown = Some(b)
            }
            continue
        }
        for o in b.split() {
            stack.push((o, d + 1))
        }
    }
    match unknown {
        Some(b) => Certified::Unknown(b),
        None => Certified::Holds,
    }
}

/// Whether nothing of `field`'s inside is in `region` (its distance is positive everywhere
/// there): for example, nothing below the ground.
pub fn certify_clear<S: Surface>(field: S, region: Box3, depth: u32) -> Certified {
    certify_positive(|p: vec3| field.distance(p), region, depth)
}

/// Whether parts `a` and `b` of `field` don't overlap anywhere in `region`: at every point at
/// least one of them is outside (the larger of their own distances is positive).
pub fn certify_apart<S: Surface>(field: S, a: u32, b: u32, region: Box3, depth: u32) -> Certified {
    certify_positive(
        |p: vec3| max(field.part_distance(p, a), field.part_distance(p, b)),
        region,
        depth,
    )
}

/// A part's name, for tools (§23): the name its author gave it, the name of the group it's in,
/// the name of the space it's placed in (an engine's creature places parts on bones), and
/// whether it's the mirror image of the part as written. Each name is empty where nothing gives
/// one.
pub struct PartName: Copy {
    pub name: Text,
    pub group: Text,
    pub frame: Text,
    pub mirrored: bool,
}

/// A part with no name.
pub fn unnamed() -> PartName {
    PartName { name: "", group: "", frame: "", mirrored: false }
}

/// A scalar function over 3D space, used to displace surfaces.
pub trait Noise: Copy + GpuData {
    /// The noise's value at `p`.
    fn value(self, p: vec3) -> f32

    /// Every value it takes.
    fn range(self) -> Interval

    /// A bound on its gradient's length, everywhere.
    fn lipschitz(self) -> f32

    /// Its highest frequency, in cycles per unit: detail finer than `1 / bandlimit()` is all
    /// there is above it.
    fn bandlimit(self) -> f32

    /// Its value averaged over the box `p ± footprint / 2`, each component a width (0 samples
    /// that axis): what a pixel whose footprint spans that box sees. Detail finer than the
    /// footprint fades to its mean instead of aliasing. The default is the value itself,
    /// which is right for a noise with no detail finer than the footprints it's seen at.
    fn filtered(self, p: vec3, footprint: vec3) -> f32 {
        self.value(p)
    }
}

// ---- primitives ---------------------------------------------------------------------------------

/// A closure or function of a point is a surface too, its value the distance: `|p| length(p)
/// - r`, written where it's used (§6.7). Its gradient and interval are derived as any
/// surface's are; it has no Lipschitz bound of its own (§14).
impl<F: Copy + GpuData + fn(vec3) -> f32> Surface for F {
    fn distance(self, p: vec3) -> f32 {
        self(p)
    }

    /// A closure states nothing of where it is: unbounded. A surface culling should skip is
    /// built from primitives, which state theirs.
    fn bound(self) -> Bound {
        UNBOUNDED
    }
}

/// A sphere centred at the origin. Exact.
pub struct Sphere: Copy + GpuData + Eq + StateHash {
    pub radius: f32,
}

/// A sphere of radius `radius`, centred at the origin.
pub fn sphere(radius: f32) -> Sphere {
    Sphere { radius }
}

impl Surface for Sphere {
    fn part_bound(self, i: u32) -> PartBound {
        PartBound { a: vec3(), r: abs(self.radius), b: vec3(), reach: 0.0, lowers: 0.0 }
    }

    const EXACT_MEETS: bool = true
    const EXACT_PASSES: bool = true

    fn distance(self, p: vec3) -> f32 {
        length(p) - self.radius
    }

    /// Exact: the ray's nearest point to its centre.
    fn passes(self, o: vec3, d: vec3) -> Pass {
        ball_passes(o, d, vec3(), self.radius)
    }

    /// Exact: the ball of radius `radius + grow`.
    fn meets_grown(self, o: vec3, d: vec3, grow: f32, inner: f32) -> Meets {
        let m = ball_meets(o, d, vec3(), self.radius + grow).ahead()
        if m.is_empty() || inner == grow { m.met_by(m) } else { m.met_by(ball_meets(o, d, vec3(), self.radius + inner).ahead()) }
    }

    fn bound(self) -> Bound {
        Bound { centre: vec3(), radius: self.radius, slope: 1.0 }
    }

    /// Exact: its gradient is a unit vector.
    fn lipschitz(self, near: f32) -> f32 {
        1.0
    }
}

/// A surface whose distance is a texture's data (language.md §20.3): a 3D texture of distances,
/// texel (`i`, `j`, `k`) the distance at `origin + (vec3(i, j, k) + 0.5) × voxel`, read between
/// the eight texels round a point (trilinear). GPU code reads it; the texture is bound beside the
/// value wherever an entry point takes one (a `Texture3dHandle`), so a march generic over
/// `Surface` takes it as it takes an analytic field. Past the grid, its distance is the
/// distance to the grid's box added to the distance where the point meets it, which a sphere
/// tracer may step by.
pub struct Sampled3d: Copy + GpuData {
    /// The distances.
    pub texels: Texture3dHandle<R32Float>,
    /// The grid's corner, the first texel's outer corner.
    pub origin: vec3,
    /// A texel's side.
    pub voxel: f32,
}

/// A surface of the distances `texels` holds, the grid's corner at `origin` and each texel
/// `voxel` on a side.
pub fn sampled3d(texels: Texture3dHandle<R32Float>, origin: vec3, voxel: f32) -> Sampled3d {
    Sampled3d { texels, origin, voxel }
}

impl Sampled3d {
    /// The grid's size in texels.
    fn dims(self) -> vec3u {
        vec3u(self.texels.width(), self.texels.height(), self.texels.depth())
    }

    /// The distance between the texels round grid point `q` (in texels, centres at `i + 0.5`),
    /// clamped to the texel centres, and its gradient in texels: zero along an axis the clamp
    /// holds, where the distance doesn't change with `q`.
    fn trilinear(self, q: vec3) -> (f32, vec3) {
        let hi = vec3(self.dims()) - vec3(1.0)
        let u = q - vec3(0.5)
        let c = clamp(u, vec3(0.0), hi)
        let free = vec3(f32(u.x == c.x), f32(u.y == c.y), f32(u.z == c.z))
        let lo = min(floor(c), max(hi - vec3(1.0), vec3(0.0)))
        let f = c - lo
        let i = vec3u(lo)
        let n = min(i + vec3u(1), vec3u(hi))
        let t = self.texels
        let d000 = t.load(x: i.x, y: i.y, z: i.z)
        let d100 = t.load(x: n.x, y: i.y, z: i.z)
        let d010 = t.load(x: i.x, y: n.y, z: i.z)
        let d110 = t.load(x: n.x, y: n.y, z: i.z)
        let d001 = t.load(x: i.x, y: i.y, z: n.z)
        let d101 = t.load(x: n.x, y: i.y, z: n.z)
        let d011 = t.load(x: i.x, y: n.y, z: n.z)
        let d111 = t.load(x: n.x, y: n.y, z: n.z)
        let x00 = mix(d000, d100, f.x)
        let x10 = mix(d010, d110, f.x)
        let x01 = mix(d001, d101, f.x)
        let x11 = mix(d011, d111, f.x)
        let y0 = mix(x00, x10, f.y)
        let y1 = mix(x01, x11, f.y)
        let d = mix(y0, y1, f.z)
        // The trilinear's derivative along each axis, from the same eight.
        let dx = mix(mix(d100 - d000, d110 - d010, f.y), mix(d101 - d001, d111 - d011, f.y), f.z)
        let dy = mix(x10 - x00, x11 - x01, f.z)
        let dz = y1 - y0
        (d, vec3(dx, dy, dz) * free)
    }

    /// `p`'s distance from the grid's box (0 inside), and the point of the box nearest it.
    fn outside(self, p: vec3) -> (f32, vec3) {
        let top = self.origin + vec3(self.dims()) * self.voxel
        let near = clamp(p, self.origin, top)
        (length(p - near), near)
    }
}

impl Surface for Sampled3d {
    fn distance(self, p: vec3) -> f32 {
        let (out, near) = self.outside(p)
        let (d, _) = self.trilinear((near - self.origin) / self.voxel)
        d + out
    }

    /// The trilinear's own gradient (inside the grid), from the eight texels it reads.
    fn gradient(self, p: vec3) -> vec3 {
        let (_, g) = self.sample(p)
        g
    }

    /// Past the grid: the box's distance's gradient, and the trilinear's along each axis that
    /// `p` is within the box on (the point where `p` meets the box moves with `p` there).
    fn sample(self, p: vec3) -> (f32, vec3) {
        let (out, near) = self.outside(p)
        let (d, g) = self.trilinear((near - self.origin) / self.voxel)
        if out > 0.0 {
            let along = vec3(f32(near.x == p.x), f32(near.y == p.y), f32(near.z == p.z))
            return (d + out, g / self.voxel * along + (p - near) / out)
        }
        (d, g / self.voxel)
    }
    /// Unbounded: the texels may hold distances below zero at the grid's edge, which reach
    /// past it, so the sphere round the grid holds nothing out.
    fn bound(self) -> Bound {
        UNBOUNDED
    }
}

/// An ellipsoid centred at the origin. No exact distance exists; this is the usual bound.
pub struct Ellipsoid: Copy + GpuData + Eq + StateHash {
    pub radii: vec3,
}

/// An ellipsoid with half-axes `radii`, centred at the origin.
pub fn ellipsoid(radii: vec3) -> Ellipsoid {
    Ellipsoid { radii }
}

impl Surface for Ellipsoid {
    fn distance(self, p: vec3) -> f32 {
        let k0 = length(p / self.radii)
        let k1 = length(p / (self.radii * self.radii))
        // The usual bound, k0 (k0 - 1) / k1, written as (k0 - 1) times k0 / k1, which always
        // lies between the smallest and the largest radius. Held there, it's the same value
        // everywhere but the centre, where it's 0 / 0 and the distance is minus the smallest
        // radius; and its interval never reaches 0 inside the body. (Spike 13's certificate
        // found the zero that k0 (k0 - 1) / k1's interval had at the centre.)
        let shortest = min(self.radii.x, min(self.radii.y, self.radii.z))
        let longest = max(self.radii.x, max(self.radii.y, self.radii.z))
        (k0 - 1.0) * clamp(k0 / max(k1, 0.000000001), shortest, longest)
    }

    fn bound(self) -> Bound {
        // The usual bound's distance, assumed to fall off at least half as fast as the true
        // distance does.
        Bound {
            centre: vec3(),
            radius: max(self.radii.x, max(self.radii.y, self.radii.z)),
            slope: 0.5,
        }
    }

    /// The bound k0 (k0 − 1) / k1, with k0 = |p / r| and k1 = |p / r²|, has a gradient that
    /// grows without bound at the centre. Where |distance| < near, |k0 − 1| < e = near /
    /// min(r), and its gradient is at most max(2 − 1 / (1 + e), 1 / (1 − e) − 2) +
    /// e (max(r) / min(r))² / (1 − e). Infinite from e = 1 on, where the centre is in scope.
    fn lipschitz(self, near: f32) -> f32 {
        let lo = min(self.radii.x, min(self.radii.y, self.radii.z))
        let hi = max(self.radii.x, max(self.radii.y, self.radii.z))
        let e = max(near, 0.0) / lo
        if e >= 1.0 {
            return 1.0 / 0.0
        }
        let first = max(2.0 - 1.0 / (1.0 + e), 1.0 / (1.0 - e) - 2.0)
        let r = hi / lo
        (first + e * r * r / (1.0 - e)) * 1.001
    }
}

/// An ellipsoid whose distance stays well behaved: outside it's `Ellipsoid`'s, which is near
/// the true distance; inside it's (k0 − 1) times the smallest radius, whose gradient is never
/// more than 1, where `Ellipsoid`'s grows without bound towards the centre (3 to 25 in thin or
/// blended ellipsoids). The surface is the same. Prefer it for parts that blend.
pub struct Oval: Copy + GpuData + Eq + StateHash {
    pub radii: vec3,
}

/// An oval with half-axes `radii`, centred at the origin (`Oval`).
pub fn oval(radii: vec3) -> Oval {
    Oval { radii }
}

impl Surface for Oval {
    fn distance(self, p: vec3) -> f32 {
        let k0 = length(p / self.radii)
        if k0 < 1.0 {
            return (k0 - 1.0) * min(self.radii.x, min(self.radii.y, self.radii.z))
        }
        let k1 = length(p / (self.radii * self.radii))
        k0 * (k0 - 1.0) / max(k1, 0.000000001)
    }

    fn bound(self) -> Bound {
        ellipsoid(self.radii).bound()
    }

    /// Inside, 1. Outside, within `near` (e = near / min(r)): the first term of `Ellipsoid`'s
    /// gradient is at most 2 − 1 / (1 + e), and the second, from k1's change, e (max(r) /
    /// min(r))² / (1 + e).
    fn lipschitz(self, near: f32) -> f32 {
        let lo = min(self.radii.x, min(self.radii.y, self.radii.z))
        let hi = max(self.radii.x, max(self.radii.y, self.radii.z))
        let e = max(near, 0.0) / lo
        let r = hi / lo
        max(1.0, 2.0 - 1.0 / (1.0 + e) + e * r * r / (1.0 + e)) * 1.001
    }
}

/// Round cones through `points`, each `radii` thick there, joined end to end: a limb, a neck
/// or a tail that bends at its points. Consecutive cones share the sphere at their joint, so
/// their union is smooth there and swells nothing (a smooth seam between segments bulges by a
/// quarter of its width). Exact.
pub struct Tube<const N: u32>: Copy + GpuData + Eq + StateHash {
    pub points: [vec3; N],
    pub radii: [f32; N],
}

/// A tube through `points`, `radii` thick at each (`Tube`).
pub fn tube<const N: u32>(points: [vec3; N], radii: [f32; N]) -> Tube<N> {
    Tube { points, radii }
}

impl<const N: u32> Surface for Tube<N> {
    fn distance(self, p: vec3) -> f32 {
        var d = length(p - self.points[0]) - self.radii[0]
        for i in 1..N {
            let c = round_cone(
                self.points[i - 1],
                self.points[i],
                r_top: self.radii[i - 1],
                r_bottom: self.radii[i],
            )
            d = min(d, c.distance(p))
        }
        d
    }

    /// Its cones' bounds, joined.
    fn bound(self) -> Bound {
        var b = Bound { centre: self.points[0], radius: self.radii[0], slope: 1.0 }
        for i in 1..N {
            let c = round_cone(
                self.points[i - 1],
                self.points[i],
                r_top: self.radii[i - 1],
                r_bottom: self.radii[i],
            )
            b = b.and(c.bound())
        }
        b
    }

    /// A union of exact distances: 1.
    fn lipschitz(self, near: f32) -> f32 {
        1.0
    }
}

/// The hull of two spheres, centred at `a` with radius `r1` and at `b` with radius `r2`.
/// Exact, also where one sphere holds the other (the hull is then the larger sphere).
pub struct RoundCone: Copy + GpuData + Eq + StateHash {
    pub a: vec3,
    pub b: vec3,
    pub r1: f32,
    pub r2: f32,
}

/// The hull of a sphere of radius `r_top` at `a` and one of radius `r_bottom` at `b`.
pub fn round_cone(a: vec3, b: vec3, r_top: f32, r_bottom: f32) -> RoundCone {
    RoundCone { a, b, r1: r_top, r2: r_bottom }
}

impl Surface for RoundCone {
    /// Its segment, at its larger radius.
    fn part_bound(self, i: u32) -> PartBound {
        PartBound { a: self.a, r: max(self.r1, self.r2), b: self.b, reach: 0.0, lowers: 0.0 }
    }

    const EXACT_MEETS: bool = true
    const EXACT_PASSES: bool = true

    fn distance(self, p: vec3) -> f32 {
        let ba = self.b - self.a
        let l = length(ba)
        let rr = self.r1 - self.r2
        // Where |r1 - r2| >= |b - a| (a == b too), one sphere holds the other, and the hull is
        // the larger one.
        if l <= abs(rr) {
            length(p - select(if_false: self.b, if_true: self.a, cond: rr >= 0.0)) -
                max(self.r1, self.r2)
        } else {
            // Inigo Quilez's round cone, written with the axis's direction u and q, the radii's
            // difference per unit of length: each term is about |p - a|². (The usual form's
            // terms grow as |b - a|⁶, and leave f32's range for ends closer than about 10⁻⁷.)
            let u = ba / l
            let q = rr / l
            let a2 = 1.0 - q * q
            let pa = p - self.a
            let y = dot(pa, u)
            let z = y - l
            let xv = pa - u * y
            let x2 = dot(xv, xv)
            let k = sign(q) * q * q * x2
            if sign(z) * a2 * z * z > k {
                sqrt(x2 + z * z) - self.r2
            } else if sign(y) * a2 * y * y < k {
                sqrt(x2 + y * y) - self.r1
            } else {
                sqrt(x2 * a2) + y * q - self.r1
            }
        }
    }

    /// Exact, in closed form (`round_cone_passes`).
    fn passes(self, o: vec3, d: vec3) -> Pass {
        round_cone_passes(o, d, self)
    }

    /// Exact: the hull of its two balls, each grown by `grow`.
    /// Met by `inner`'s hull, where its radii stay at least 0 (shrunk further, a round cone's
    /// erosion isn't a round cone, and nothing is said).
    /// (Both hulls are asked on every call, with no branch between: what each computes from the
    /// ray's origin alone is then the same for every invocation where the origin is, and moves
    /// onto the CPU with the rest, §18.13.)
    fn meets_grown(self, o: vec3, d: vec3, grow: f32, inner: f32) -> Meets {
        round_cone_meets(o, d, self.a, self.b, self.r1, self.r2, grow, inner)
    }

    fn bound(self) -> Bound {
        let half = 0.5 * length(self.b - self.a)
        Bound { centre: 0.5 * (self.a + self.b), radius: half + max(self.r1, self.r2), slope: 1.0 }
    }

    /// Exact.
    fn lipschitz(self, near: f32) -> f32 {
        1.0
    }
}

/// A box centred at the origin, with half-extents `half`. Exact.
pub struct Cuboid: Copy + GpuData + Eq + StateHash {
    pub half: vec3,
}

/// A box with half-extents `half`, centred at the origin.
pub fn cuboid(half: vec3) -> Cuboid {
    Cuboid { half }
}

impl Surface for Cuboid {
    fn part_bound(self, i: u32) -> PartBound {
        PartBound { a: vec3(), r: length(self.half), b: vec3(), reach: 0.0, lowers: 0.0 }
    }

    const EXACT_MEETS: bool = true
    const EXACT_PASSES: bool = true

    /// Outside, the distance to the nearest point of the box; inside, minus the distance to
    /// the nearest face. One branch on which, so what's derived from it knows the side: on a
    /// face, the interval of the gradient is the face's normal.
    fn distance(self, p: vec3) -> f32 {
        let q = abs(p) - self.half
        let m = max(q.x, max(q.y, q.z))
        if m > 0.0 { length(max(q, vec3(0.0))) } else { m }
    }

    /// Exact, in closed form (`box_passes`).
    fn passes(self, o: vec3, d: vec3) -> Pass {
        box_passes(o, d, self.half)
    }

    /// Exact: where the ray is between each pair of faces. Grown, the box grown by `grow` along
    /// each axis holds it (its edges and corners are rounded inside that box): not exact.
    fn meets_grown(self, o: vec3, d: vec3, grow: f32, inner: f32) -> Meets {
        let m = box_meets(o, d, self.half + vec3(grow)).ahead()
        let n = if grow > 0.0 { m.loose() } else { m }
        // Shrunk (or as it is), the box moved in by `inner` is the surface grown by it exactly.
        if n.is_empty() || inner > 0.0 { n } else if inner == grow { n.met_by(n) } else { n.met_by(box_meets(o, d, self.half + vec3(inner)).ahead()) }
    }

    fn bound(self) -> Bound {
        Bound { centre: vec3(), radius: length(self.half), slope: 1.0 }
    }

    /// Exact.
    fn lipschitz(self, near: f32) -> f32 {
        1.0
    }
}

/// Everything on the negative side of a plane: `dot(p, normal) < offset`. The distance is
/// exact when `normal` is a unit vector, as `half_space` makes it.
pub struct HalfSpace: Copy + GpuData + Eq + StateHash {
    pub normal: vec3,
    pub offset: f32,
}

/// The half-space `dot(p, normal) < offset`, for a nonzero `normal` of any length: both are
/// divided by its length, which leaves the same half-space.
pub fn half_space(normal: vec3, offset: f32) -> HalfSpace {
    // Scaled by its largest component first, so its length neither overflows nor underflows.
    let m = max(max(abs(normal.x), abs(normal.y)), abs(normal.z))
    let n = normal / m
    let l = length(n)
    HalfSpace { normal: n / l, offset: offset / m / l }
}

impl Surface for HalfSpace {
    const EXACT_MEETS: bool = true
    const EXACT_PASSES: bool = true

    fn distance(self, p: vec3) -> f32 {
        dot(p, self.normal) - self.offset
    }

    /// Exact: at the start where the ray doesn't go down into it; else it meets it, where it
    /// crosses the plane.
    fn passes(self, o: vec3, d: vec3) -> Pass {
        let f = self.distance(o)
        let dn = dot(d, self.normal)
        // Going in, the ray goes deeper for ever.
        if dn >= 0.0 { pass_at(0.0, f, PASS_EXACT) } else { pass_at(max(f / -dn, 0.0), -EMPTY, PASS_EXACT) }
    }

    /// Exact: one side of the plane moved by `grow`.
    fn meets_grown(self, o: vec3, d: vec3, grow: f32, inner: f32) -> Meets {
        let m = side_meets(o, d, self.normal, self.offset + grow)
        if m.is_empty() { m } else { m.met_by(side_meets(o, d, self.normal, self.offset + inner)) }
    }

    /// Unbounded: it reaches to infinity.
    fn bound(self) -> Bound {
        UNBOUNDED
    }

    /// Exact: `half_space` makes its normal a unit vector.
    fn lipschitz(self, near: f32) -> f32 {
        1.0
    }
}

// ---- combinators --------------------------------------------------------------------------------

/// The smooth minimum of two distances: where they're `k` or more apart it's exactly the
/// smaller. With `k <= 0` it's `min(a, b)`.
///
/// This is the usual polynomial blend, `mix(b, a, h) - k h (1 - h)` with
/// `h = clamp(0.5 + 0.5 (b - a) / k, 0, 1)`, rearranged (it's the same function, up to
/// rounding) so that what the compiler derives from it is cheap: its gradient doesn't carry
/// terms that cancel, and its interval is the smaller distance's, less at most `k / 4`. It
/// chooses the smaller distance once, with one branch, so an interval that can't decide which
/// runs each side knowing it, and the interval of its gradient stays between its parts' on a
/// blend's seam.
pub fn smin(a: f32, b: f32, k: f32) -> f32 {
    // The smallest normal f32 keeps `0.25 / k` finite, and `m` is 0 for `k <= 0`. `m` times
    // at most a quarter doesn't overflow where `m * m` would. (A derived interval with `k = 0`
    // can multiply that huge `s` into an infinity, and the infinity by 0: a caller whose `k`
    // can be 0 chooses `min` itself, as the engine's seams do. A branch here would cost a
    // derived gradient a sixth of its speed: the grazer's, `grazer.rs`.)
    let s = 0.25 / max(k, 1.1754944e-38)
    let d = b - a
    if d > 0.0 {
        let m = max(k - d, 0.0)
        a - m * (m * s)
    } else {
        // `k + d` is `k - |a - b|` here, and at a tie it still carries `d`'s derivative, so
        // the seam's gradient is half each side's. Two equal infinite distances (an empty
        // surface's) are 0 apart, though their difference is NaN; a NaN still makes a NaN.
        // (The test asks no ordered `==`: numbers whose difference is NaN are infinities of one
        // sign, which is `a == b` with a NaN difference, and each `x == x` is `isnan`, which a
        // shader writes as it is: the NaN-safe `==` it would need cost the masked march 4%.)
        let m = max(k + select(if_false: d, if_true: 0.0, cond: d != d && a == a && b == b), 0.0)
        b - m * (m * s)
    }
}

// Provenance (§23) through a combinator of two surfaces, whose parts are `a`'s then `b`'s, and
// through one of an array of surfaces: what the combinators share. Each has its own `part_at`.

/// The distances of `a` and `b` at `p`, part `i` of the two raised by `by` (`part_offset`).
fn pair_offsets<A: Surface, B: Surface>(a: A, b: B, p: vec3, i: u32, by: f32) -> (f32, f32) {
    let n = a.parts()
    if i < n { (a.part_offset(p, i, by), b.distance(p)) } else {
        (a.distance(p), b.part_offset(p, i - n, by))
    }
}

fn pair_parts<A: Surface, B: Surface>(a: A, b: B) -> u32 {
    a.parts() + b.parts()
}

fn pair_part_distance<A: Surface, B: Surface>(a: A, b: B, p: vec3, i: u32) -> f32 {
    let n = a.parts()
    if i < n { a.part_distance(p, i) } else { b.part_distance(p, i - n) }
}

fn pair_part_name<A: Surface, B: Surface>(a: A, b: B, i: u32) -> PartName {
    let n = a.parts()
    if i < n { a.part_name(i) } else { b.part_name(i - n) }
}

/// Which of `parts` holds part `i` of them all, and its number there; `N` where none does.
fn locate<S: Surface, const N: u32>(parts: [S; N], i: u32) -> (u32, u32) {
    var first = 0
    for k in 0..N {
        let n = parts[k].parts()
        if i < first + n {
            return (k, i - first)
        }
        first += n
    }
    (N, 0)
}

fn array_parts<S: Surface, const N: u32>(parts: [S; N]) -> u32 {
    var n = 0
    for i in 0..N {
        n += parts[i].parts()
    }
    n
}

fn array_part_distance<S: Surface, const N: u32>(parts: [S; N], p: vec3, i: u32) -> f32 {
    let (k, j) = locate(parts, i)
    if k < N { parts[k].part_distance(p, j) } else { EMPTY }
}

fn array_part_name<S: Surface, const N: u32>(parts: [S; N], i: u32) -> PartName {
    let (k, j) = locate(parts, i)
    if k < N { parts[k].part_name(j) } else { unnamed() }
}

/// Two surfaces joined: `a.union(b)`.
pub struct Union<A, B>: Copy + GpuData + Eq + StateHash {
    pub a: A,
    pub b: B,
}

impl<A: Surface, B: Surface> Surface for Union<A, B> {
    /// Its operand's: a sharp join reaches no farther than its operands.
    fn part_bound(self, i: u32) -> PartBound {
        let n = self.a.parts()
        if i < n { self.a.part_bound(i) } else { self.b.part_bound(i - n) }
    }

    const EXACT_MEETS: bool = A::EXACT_MEETS && B::EXACT_MEETS
    const EXACT_PASSES: bool = A::EXACT_PASSES && B::EXACT_PASSES

    fn distance(self, p: vec3) -> f32 {
        min(self.a.distance(p), self.b.distance(p))
    }

    /// The nearer of its operands': exact where both are.
    fn passes(self, o: vec3, d: vec3) -> Pass {
        self.a.passes(o, d).or(self.b.passes(o, d))
    }

    /// The nearer of its operands': exact where both are.
    fn meets_grown(self, o: vec3, d: vec3, grow: f32, inner: f32) -> Meets {
        self.a.meets_grown(o, d, grow, inner).or(self.b.meets_grown(o, d, grow, inner))
    }

    /// An operand none of whose parts is live isn't asked: it counts as `EMPTY`, and `min` of
    /// the other and `EMPTY` is the other. One exit, each operand written once.
    fn masked(self, p: vec3, live: Live, first: u32) -> f32 {
        let n = self.a.parts()
        let a = if live.any(first, n) { self.a.masked(p, live, first) } else { EMPTY }
        let b = if live.any(first + n, self.b.parts()) { self.b.masked(p, live, first + n) } else { EMPTY }
        min(a, b)
    }

    /// Its operands' parts'; a `b` of one part takes the join too, which a masked ask skips
    /// with it.
    fn part_work(self, i: u32) -> u32 {
        let n = self.a.parts()
        if i < n {
            self.a.part_work(i)
        } else if self.b.parts() == 1 {
            plus_work(self.b.part_work(0), work(|x: vec2| min(x.x, x.y)))
        } else {
            self.b.part_work(i - n)
        }
    }

    /// An operand never below the other over the box changes nothing there.
    fn pruned<F: Copy + fn(vec3) -> vec3>(self, over: Box3, at: F, stretch: f32, live: Live, first: u32) -> Pruned {
        let n = self.a.parts()
        let a = self.a.pruned(over, at, stretch, live, first)
        let b = self.b.pruned(over, at, stretch, a.live, first + n)
        joined(a.range, b, first, n, self.b.parts(), 0.0)
    }

    fn bound(self) -> Bound {
        self.a.bound().and(self.b.bound())
    }

    fn filtered(self, p: vec3, footprint: f32) -> f32 {
        min(self.a.filtered(p, footprint), self.b.filtered(p, footprint))
    }

    fn part_offset(self, p: vec3, i: u32, by: f32) -> f32 {
        let (da, db) = pair_offsets(self.a, self.b, p, i, by)
        min(da, db)
    }

    fn parts(self) -> u32 {
        pair_parts(self.a, self.b)
    }

    /// The nearer operand's part; a tie takes `a`'s.
    fn part_at(self, p: vec3) -> (f32, u32) {
        let (da, ia) = self.a.part_at(p)
        let (db, ib) = self.b.part_at(p)
        (min(da, db), if da <= db { ia } else { self.a.parts() + ib })
    }

    fn part_distance(self, p: vec3, i: u32) -> f32 {
        pair_part_distance(self.a, self.b, p, i)
    }

    fn part_name(self, i: u32) -> PartName {
        pair_part_name(self.a, self.b, i)
    }

    /// The smaller distance's: where it's within `near`, so is the part's.
    fn lipschitz(self, near: f32) -> f32 {
        max(self.a.lipschitz(near), self.b.lipschitz(near))
    }
}

/// Two surfaces joined by a rounded seam: `a.smooth_union(b, k)`.
pub struct SmoothUnion<A, B>: Copy + GpuData + Eq + StateHash {
    pub a: A,
    pub b: B,
    pub k: f32,
}

impl<A: Surface, B: Surface> Surface for SmoothUnion<A, B> {
    /// Its operand's, reaching `k` farther (where its operands are within `k` of each other the
    /// blend can move) and a quarter of `k` more (the most it lowers the other's distance), which
    /// it lowers by too.
    fn part_bound(self, i: u32) -> PartBound {
        let n = self.a.parts()
        var c = if i < n { self.a.part_bound(i) } else { self.b.part_bound(i - n) }
        let k = max(self.k, 0.0)
        c.reach += k + 0.25 * k
        c.lowers += 0.25 * k
        c
    }

    fn distance(self, p: vec3) -> f32 {
        smin(self.a.distance(p), self.b.distance(p), self.k)
    }

    /// The nearer of its operands' less the most the blend lowers it (a quarter of `k`): a
    /// bound, at the nearer's `t`.
    fn passes(self, o: vec3, d: vec3) -> Pass {
        // Asked once where its nearer operand passes.
        let k = max(self.k, 0.0)
        let p = self.a.passes(o, d).or(self.b.passes(o, d)).lowered(0.25 * k, k)
        p.asked(p.t, self.distance(o + d * p.t))
    }

    /// Its operands', each grown by `k / 4`, which is the most `smin` lowers the smaller
    /// distance: the blend is inside that, and the stretch holds it, not exactly.
    /// Met by the earlier of its operands' own hits: `smin` is at most the smaller distance, so
    /// the blend holds each operand.
    fn meets_grown(self, o: vec3, d: vec3, grow: f32, inner: f32) -> Meets {
        let g = grow + 0.25 * max(self.k, 0.0)
        self.a.meets_grown(o, d, g, inner).or(self.b.meets_grown(o, d, g, inner)).loose()
    }

    /// As `Union`'s: an operand none of whose parts is live isn't asked, and counts as `EMPTY`
    /// (`smin(d, EMPTY, k)` and `smin(EMPTY, d, k)` are `d`, bit for bit).
    fn masked(self, p: vec3, live: Live, first: u32) -> f32 {
        let n = self.a.parts()
        let a = if live.any(first, n) { self.a.masked(p, live, first) } else { EMPTY }
        let b = if live.any(first + n, self.b.parts()) { self.b.masked(p, live, first + n) } else { EMPTY }
        smin(a, b, self.k)
    }

    /// Its operands' parts'; a `b` of one part takes the join too, which a masked ask skips
    /// with it.
    fn part_work(self, i: u32) -> u32 {
        let n = self.a.parts()
        if i < n {
            self.a.part_work(i)
        } else if self.b.parts() == 1 {
            let k = self.k
            plus_work(self.b.part_work(0), work(|x: vec2| smin(x.x, x.y, k)))
        } else {
            self.b.part_work(i - n)
        }
    }

    /// An operand at least `k` above the other everywhere in the box changes nothing there:
    /// `smin` is then exactly the other (its seam is narrower than `k`).
    fn pruned<F: Copy + fn(vec3) -> vec3>(self, over: Box3, at: F, stretch: f32, live: Live, first: u32) -> Pruned {
        let n = self.a.parts()
        let a = self.a.pruned(over, at, stretch, live, first)
        let b = self.b.pruned(over, at, stretch, a.live, first + n)
        joined(a.range, b, first, n, self.b.parts(), self.k)
    }

    fn bound(self) -> Bound {
        self.a.bound().and(self.b.bound()).lowered(0.25 * max(self.k, 0.0))
    }

    fn filtered(self, p: vec3, footprint: f32) -> f32 {
        smin(self.a.filtered(p, footprint), self.b.filtered(p, footprint), self.k)
    }

    fn part_offset(self, p: vec3, i: u32, by: f32) -> f32 {
        let (da, db) = pair_offsets(self.a, self.b, p, i, by)
        smin(da, db, self.k)
    }

    fn parts(self) -> u32 {
        pair_parts(self.a, self.b)
    }

    /// The nearer operand's part: the one whose distance the blend follows most.
    fn part_at(self, p: vec3) -> (f32, u32) {
        let (da, ia) = self.a.part_at(p)
        let (db, ib) = self.b.part_at(p)
        (smin(da, db, self.k), if da <= db { ia } else { self.a.parts() + ib })
    }

    fn part_distance(self, p: vec3, i: u32) -> f32 {
        pair_part_distance(self.a, self.b, p, i)
    }

    fn part_name(self, i: u32) -> PartName {
        pair_part_name(self.a, self.b, i)
    }

    /// `smin`'s gradient mixes its parts' with weights that add up to 1. Where it's within
    /// `near`, the parts are within `near + 1.25 k`: the smaller is at most `k / 4` above it,
    /// and they blend only where they're less than `k` apart.
    fn lipschitz(self, near: f32) -> f32 {
        let scope = near + 1.25 * max(self.k, 0.0)
        max(self.a.lipschitz(scope), self.b.lipschitz(scope))
    }
}

/// The parts of a fixed array of surfaces of one type, joined (§20): `legs.union()`,
/// `legs.smooth_union(k: 6cm)`. Each folds the parts in order, so `[a, b, c].union()` is
/// `a.union(b).union(c)`.
impl<S: Surface, const N: u32> [S; N] {
    /// The parts joined.
    pub fn union(self) -> UnionAll<S, N> {
        UnionAll { parts: self }
    }

    /// A union whose seams are rounded over a width of about `k`.
    pub fn smooth_union(self, k: f32) -> SmoothUnionAll<S, N> {
        SmoothUnionAll { parts: self, k }
    }
}

/// A fixed array of surfaces joined: `parts.union()`.
pub struct UnionAll<S, const N: u32>: Copy + GpuData + Eq + StateHash {
    pub parts: [S; N],
}

impl<S: Surface, const N: u32> Surface for UnionAll<S, N> {
    fn part_bound(self, i: u32) -> PartBound {
        if N == 0 {
            return PartBound { a: vec3(), r: EMPTY, b: vec3(), reach: 0.0, lowers: 0.0 }
        }
        let (k, j) = part_of(self.parts, i)
        self.parts[k].part_bound(j)
    }

    const EXACT_MEETS: bool = S::EXACT_MEETS
    const EXACT_PASSES: bool = S::EXACT_PASSES

    /// The nearest part's distance; with no parts, nowhere near (`EMPTY`).
    fn distance(self, p: vec3) -> f32 {
        var d = EMPTY
        for i in 0..N {
            d = min(d, self.parts[i].distance(p))
        }
        d
    }

    /// The nearest of its parts': exact where every part's is. A part whose bound's pass is no
    /// nearer than the nearest yet isn't asked.
    fn passes(self, o: vec3, d: vec3) -> Pass {
        var p = pass_at(0.0, EMPTY, PASS_EXACT)
        for i in 0..N {
            if bound_passes(self.parts[i].bound(), o, d).distance < p.distance {
                p = p.or(self.parts[i].passes(o, d))
            }
        }
        p
    }

    /// The nearest of its parts': exact where every part's is.
    fn meets_grown(self, o: vec3, d: vec3, grow: f32, inner: f32) -> Meets {
        var m = NEVER
        for i in 0..N {
            m = m.or(self.parts[i].meets_grown(o, d, grow, inner))
        }
        m
    }

    /// The same `min`s, over the parts with a live part. Where each part is one part and all
    /// are in one word of the mask, over its set bits, lowest first (`leaf_bits`): at most `N`
    /// passes, as many as the live parts.
    fn masked(self, p: vec3, live: Live, first: u32) -> f32 {
        var d = EMPTY
        if array_parts(self.parts) == N && (first & 31) + N <= 32 && first < 128 {
            var bits = leaf_bits(live, first, N)
            for _ in 0..N {
                if bits == 0 {
                    break
                }
                let i = bits.trailing_zeros()
                d = min(d, self.parts[i].masked(p, live, first + i))
                bits = bits & (bits - 1)
            }
            return d
        }
        var f = first
        for i in 0..N {
            let n = self.parts[i].parts()
            if live.any(f, n) {
                d = min(d, self.parts[i].masked(p, live, f))
            }
            f += n
        }
        d
    }

    /// Its parts' parts'; a part of one part takes its join too, which a masked ask skips
    /// with it.
    fn part_work(self, i: u32) -> u32 {
        if N == 1 {
            return masked_work(self)
        }
        let (k, j) = locate(self.parts, i)
        if k >= N {
            return 0
        }
        let w = self.parts[k].part_work(j)
        if self.parts[k].parts() == 1 {
            plus_work(w, work(|x: vec2| min(x.x, x.y)))
        } else {
            w
        }
    }

    /// A part that is nowhere in the box below the part whose range tops out lowest changes
    /// nothing there.
    fn pruned<F: Copy + fn(vec3) -> vec3>(self, over: Box3, at: F, stretch: f32, live: Live, first: u32) -> Pruned {
        var out = live
        var ranges = [Interval { lo: EMPTY, hi: EMPTY }; N]
        var firsts = [first; N]
        var f = first
        var best: u32 = 0
        for i in 0..N {
            let r = self.parts[i].pruned(over, at, stretch, out, f)
            out = r.live
            ranges[i] = r.range
            firsts[i] = f
            f += self.parts[i].parts()
            if ranges[i].hi < ranges[best].hi {
                best = i
            }
        }
        var range = Interval { lo: EMPTY, hi: EMPTY }
        for i in 0..N {
            if i != best && apart(ranges[i].lo, ranges[best].hi, 0.0) {
                out = out.without(firsts[i], self.parts[i].parts())
            } else {
                range = Interval { lo: min(range.lo, ranges[i].lo), hi: min(range.hi, ranges[i].hi) }
            }
        }
        Pruned { live: out, range }
    }

    /// Its parts' bounds, joined (with no parts, unbounded: nothing to say where it is).
    fn bound(self) -> Bound {
        if N == 0 {
            return UNBOUNDED
        }
        var b = self.parts[0].bound()
        for i in 1..N {
            b = b.and(self.parts[i].bound())
        }
        b
    }

    fn filtered(self, p: vec3, footprint: f32) -> f32 {
        var d = EMPTY
        for i in 0..N {
            d = min(d, self.parts[i].filtered(p, footprint))
        }
        d
    }

    fn part_offset(self, p: vec3, i: u32, by: f32) -> f32 {
        let (m, j) = locate(self.parts, i)
        var d = EMPTY
        for k in 0..N {
            let dk = if k == m { self.parts[k].part_offset(p, j, by) } else {
                self.parts[k].distance(p)
            }
            d = min(d, dk)
        }
        d
    }

    fn parts(self) -> u32 {
        array_parts(self.parts)
    }

    /// The nearest operand's part; a tie takes the earlier's.
    fn part_at(self, p: vec3) -> (f32, u32) {
        var d = EMPTY
        var part = 0
        var first = 0
        for i in 0..N {
            let (di, pi) = self.parts[i].part_at(p)
            if di < d {
                part = first + pi
            }
            d = min(d, di)
            first += self.parts[i].parts()
        }
        (d, part)
    }

    fn part_distance(self, p: vec3, i: u32) -> f32 {
        array_part_distance(self.parts, p, i)
    }

    fn part_name(self, i: u32) -> PartName {
        array_part_name(self.parts, i)
    }

    fn lipschitz(self, near: f32) -> f32 {
        var l = 0.0
        for i in 0..N {
            l = max(l, self.parts[i].lipschitz(near))
        }
        l
    }
}

/// A fixed array of surfaces joined by rounded seams: `parts.smooth_union(k)`.
pub struct SmoothUnionAll<S, const N: u32>: Copy + GpuData + Eq + StateHash {
    pub parts: [S; N],
    pub k: f32,
}

impl<S: Surface, const N: u32> Surface for SmoothUnionAll<S, N> {
    /// Its element's, reaching `k` farther and the fold's whole lowering more
    /// (`fold_lowering`, at most `k`: 0.817 k for 17 parts), which it lowers by too.
    fn part_bound(self, i: u32) -> PartBound {
        if N == 0 {
            return PartBound { a: vec3(), r: EMPTY, b: vec3(), reach: 0.0, lowers: 0.0 }
        }
        let (e, j) = part_of(self.parts, i)
        var c = self.parts[e].part_bound(j)
        let k = max(self.k, 0.0)
        let l = fold_lowering(N, k)
        c.reach += k + l
        c.lowers += l
        c
    }

    fn distance(self, p: vec3) -> f32 {
        if N == 0 {
            return EMPTY
        }
        var d = self.parts[0].distance(p)
        for i in 1..N {
            d = smin(d, self.parts[i].distance(p), self.k)
        }
        d
    }

    /// The nearest of its parts' less the fold's whole lowering (`fold_lowering`): a bound. Its
    /// `t`: the nearest part's; in a seam near the surface (the nearest part within the fold's
    /// lowering and a quarter of `k` of the ray, so the surface can be within a quarter of `k` of
    /// it; the next nearest within `k` of it), where the join of
    /// the three nearest parts along the ray (`smin` of their distances) is least, found over
    /// the stretch their passes span (and a quarter more each way) by `SEAM_SAMPLES` even samples
    /// and a golden-section search of `SEAM_STEPS` round the least (three parts' distances a
    /// step, no ask of the whole), where that is less than theirs at the nearest's `t`; so
    /// `refined` asks round it.
    fn passes(self, o: vec3, d: vec3) -> Pass {
        var p = pass_at(0.0, EMPTY, PASS_EXACT)
        // The three nearest parts, and their passes' `t` and distance.
        var a: u32 = 0
        var b: u32 = 0
        var c: u32 = 0
        var ta = 0.0
        var tb = 0.0
        var tc = 0.0
        var db = EMPTY
        var dc = EMPTY
        for i in 0..N {
            // A part whose bound's pass is no nearer than the third nearest yet can't be among the
            // three, nor the nearest: its own pass isn't asked.
            if bound_passes(self.parts[i].bound(), o, d).distance >= dc {
                continue
            }
            let q = self.parts[i].passes(o, d)
            if q.distance < p.distance {
                c = b
                tc = tb
                dc = db
                b = a
                tb = ta
                db = p.distance
                a = i
                ta = q.t
            } else if q.distance < db {
                c = b
                tc = tb
                dc = db
                b = i
                tb = q.t
                db = q.distance
            } else if q.distance < dc {
                c = i
                tc = q.t
                dc = q.distance
            }
            p = p.or(q)
        }
        let k = max(self.k, 0.0)
        if N > 1 && db - p.distance < k && p.distance < fold_lowering(N, k) + 0.25 * k {
            let pa = self.parts[a]
            let pb = self.parts[b]
            let three = N > 2 && dc - p.distance < k
            let pc = self.parts[if three { c } else { b }]
            let first = min(ta, if three { min(tb, tc) } else { tb })
            let last = max(ta, if three { max(tb, tc) } else { tb })
            // Even samples over the stretch (and a quarter more each way), then a golden-section
            // search round the least of them: a join of three can hold two hollows.
            let w = last - first
            let start = max(first - 0.25 * w, 0.0)
            let step = (last + 0.25 * w - start) / f32(SEAM_SAMPLES - 1)
            var best = start
            var least = EMPTY
            for i in 0..SEAM_SAMPLES {
                let x = start + step * f32(i)
                let f = seam_at(pa, pb, pc, three, o + d * x, k)
                if f < least {
                    least = f
                    best = x
                }
            }
            var lo = max(best - step, 0.0)
            var hi = best + step
            let g = 0.618034
            var x1 = hi - g * (hi - lo)
            var x2 = lo + g * (hi - lo)
            var f1 = seam_at(pa, pb, pc, three, o + d * x1, k)
            var f2 = seam_at(pa, pb, pc, three, o + d * x2, k)
            for i in 0..SEAM_STEPS {
                if f1 < f2 {
                    hi = x2
                    x2 = x1
                    f2 = f1
                    x1 = hi - g * (hi - lo)
                    f1 = seam_at(pa, pb, pc, three, o + d * x1, k)
                } else {
                    lo = x1
                    x1 = x2
                    f1 = f2
                    x2 = lo + g * (hi - lo)
                    f2 = seam_at(pa, pb, pc, three, o + d * x2, k)
                }
            }
            let f0 = seam_at(pa, pb, pc, three, o + d * ta, k)
            let t = if min(f1, f2) >= min(f0, least) { if f0 <= least { ta } else { best } } else if f1 < f2 { x1 } else { x2 }
            p = Pass { t, other: t, other_distance: EMPTY, ..p }
        }
        // Asked once where the search found the least.
        let q = p.lowered(fold_lowering(N, k), k)
        q.asked(q.t, self.distance(o + d * q.t))
    }

    /// Its parts', each grown by the fold's whole lowering (`fold_lowering`): not exact.
    fn meets_grown(self, o: vec3, d: vec3, grow: f32, inner: f32) -> Meets {
        let g = grow + fold_lowering(N, max(self.k, 0.0))
        var m = NEVER
        for i in 0..N {
            m = m.or(self.parts[i].meets_grown(o, d, g, inner))
        }
        m.loose()
    }

    /// The same fold over the parts with a live part, from `EMPTY` (`smin(EMPTY, d, k)` is `d`
    /// exactly, for any distance short of `EMPTY`). Where each part is one part and all are in
    /// one word of the mask, over its set bits, lowest first (`leaf_bits`): the parts in the same
    /// order, so the same fold, in at most `N` passes, as many as the live parts.
    fn masked(self, p: vec3, live: Live, first: u32) -> f32 {
        var d = EMPTY
        if array_parts(self.parts) == N && (first & 31) + N <= 32 && first < 128 {
            var bits = leaf_bits(live, first, N)
            for _ in 0..N {
                if bits == 0 {
                    break
                }
                let i = bits.trailing_zeros()
                d = smin(d, self.parts[i].masked(p, live, first + i), self.k)
                bits = bits & (bits - 1)
            }
            return d
        }
        var f = first
        for i in 0..N {
            let n = self.parts[i].parts()
            if live.any(f, n) {
                d = smin(d, self.parts[i].masked(p, live, f), self.k)
            }
            f += n
        }
        d
    }

    /// Its parts' parts'; a part of one part takes its join too, which a masked ask skips
    /// with it.
    fn part_work(self, i: u32) -> u32 {
        if N == 1 {
            return masked_work(self)
        }
        let (k, j) = locate(self.parts, i)
        if k >= N {
            return 0
        }
        let w = self.parts[k].part_work(j)
        if self.parts[k].parts() == 1 {
            let k = self.k
            plus_work(w, work(|x: vec2| smin(x.x, x.y, k)))
        } else {
            w
        }
    }

    /// The fold's own rules, over the box: a part at least `k` above everything folded before
    /// it changes nothing (`smin` gives what was folded), and a part at least `k` below
    /// everything folded before it starts the fold afresh (`smin` gives the part), so every
    /// part before it changes nothing. What's left folds as the whole does, bit for bit.
    fn pruned<F: Copy + fn(vec3) -> vec3>(self, over: Box3, at: F, stretch: f32, live: Live, first: u32) -> Pruned {
        if N == 0 {
            return Pruned { live, range: Interval { lo: EMPTY, hi: EMPTY } }
        }
        let k = max(self.k, 0.0)
        var out = live
        var ranges = [Interval { lo: EMPTY, hi: EMPTY }; N]
        var firsts = [first; N]
        var f = first
        for i in 0..N {
            let r = self.parts[i].pruned(over, at, stretch, out, f)
            out = r.live
            ranges[i] = r.range
            firsts[i] = f
            f += self.parts[i].parts()
        }
        var acc = ranges[0]
        for j in 1..N {
            let r = ranges[j]
            if apart(r.lo, acc.hi, k) {
                out = out.without(firsts[j], self.parts[j].parts())
            } else if apart(acc.lo, r.hi, k) {
                out = out.without(first, firsts[j] - first)
                acc = r
            } else {
                acc = smin_range(acc, r, k)
            }
        }
        Pruned { live: out, range: acc }
    }

    /// Its parts' bounds, joined, and lowered once by the fold's whole lowering
    /// (`fold_lowering`: at most `k`, where a quarter of `k` a seam was `(N - 1) k / 4`). Where
    /// the fold is at most 0, some part's distance is at most that lowering, so the part's bound
    /// grown by it holds the point, and the joined bound grown by it holds that.
    fn bound(self) -> Bound {
        if N == 0 {
            return UNBOUNDED
        }
        var b = self.parts[0].bound()
        for i in 1..N {
            b = b.and(self.parts[i].bound())
        }
        b.lowered(fold_lowering(N, max(self.k, 0.0)))
    }

    fn filtered(self, p: vec3, footprint: f32) -> f32 {
        if N == 0 {
            return EMPTY
        }
        var d = self.parts[0].filtered(p, footprint)
        for i in 1..N {
            d = smin(d, self.parts[i].filtered(p, footprint), self.k)
        }
        d
    }

    fn part_offset(self, p: vec3, i: u32, by: f32) -> f32 {
        let (m, j) = locate(self.parts, i)
        var d = EMPTY
        for k in 0..N {
            let dk = if k == m { self.parts[k].part_offset(p, j, by) } else {
                self.parts[k].distance(p)
            }
            d = if k == 0 { dk } else { smin(d, dk, self.k) }
        }
        d
    }

    fn parts(self) -> u32 {
        array_parts(self.parts)
    }

    /// The part selected by the binary smooth unions folded in order.
    fn part_at(self, p: vec3) -> (f32, u32) {
        if N == 0 {
            return (EMPTY, 0)
        }
        let (d0, p0) = self.parts[0].part_at(p)
        var d = d0
        var part = p0
        var first = self.parts[0].parts()
        for i in 1..N {
            let (di, pi) = self.parts[i].part_at(p)
            if di < d {
                part = first + pi
            }
            d = smin(d, di, self.k)
            first += self.parts[i].parts()
        }
        (d, part)
    }

    fn part_distance(self, p: vec3, i: u32) -> f32 {
        array_part_distance(self.parts, p, i)
    }

    fn part_name(self, i: u32) -> PartName {
        array_part_name(self.parts, i)
    }

    /// As `SmoothUnion`'s, with the scope widened by `1.25 k` for each `smin` a part goes
    /// through: at most `N - 1`.
    fn lipschitz(self, near: f32) -> f32 {
        let scope = near + 1.25 * max(self.k, 0.0) * f32(max(N, 1) - 1)
        var l = 0.0
        for i in 0..N {
            l = max(l, self.parts[i].lipschitz(scope))
        }
        l
    }
}

/// The distance of a union of no parts: farther than anything a scene holds.
pub const EMPTY: f32 = 1.0e30

/// What two surfaces hold in common: `a.intersect(b)`.
pub struct Intersect<A, B>: Copy + GpuData + Eq + StateHash {
    pub a: A,
    pub b: B,
}

impl<A: Surface, B: Surface> Surface for Intersect<A, B> {
    fn distance(self, p: vec3) -> f32 {
        max(self.a.distance(p), self.b.distance(p))
    }

    /// Where both can be met: exact where both are one piece along the ray.
    fn meets_grown(self, o: vec3, d: vec3, grow: f32, inner: f32) -> Meets {
        let m = self.a.meets_grown(o, d, grow, inner).and(self.b.meets_grown(o, d, grow, inner))
        if m.exact() && grow == inner { Meets { first: m.near, ..m } } else { m }
    }

    fn bound(self) -> Bound {
        // Its distance is at least each operand's: the tighter bound holds.
        let (a, b) = (self.a.bound(), self.b.bound())
        if a.radius <= b.radius { a } else { b }
    }

    fn filtered(self, p: vec3, footprint: f32) -> f32 {
        max(self.a.filtered(p, footprint), self.b.filtered(p, footprint))
    }

    fn part_offset(self, p: vec3, i: u32, by: f32) -> f32 {
        let (da, db) = pair_offsets(self.a, self.b, p, i, by)
        max(da, db)
    }

    fn parts(self) -> u32 {
        pair_parts(self.a, self.b)
    }

    /// The farther operand's part; a tie takes `a`'s.
    fn part_at(self, p: vec3) -> (f32, u32) {
        let (da, ia) = self.a.part_at(p)
        let (db, ib) = self.b.part_at(p)
        (max(da, db), if da >= db { ia } else { self.a.parts() + ib })
    }

    fn part_distance(self, p: vec3, i: u32) -> f32 {
        pair_part_distance(self.a, self.b, p, i)
    }

    fn part_name(self, i: u32) -> PartName {
        pair_part_name(self.a, self.b, i)
    }

    fn lipschitz(self, near: f32) -> f32 {
        max(self.a.lipschitz(near), self.b.lipschitz(near))
    }
}

/// How a warp takes a point into its surface's own space (`translate`, `rotate`, `scale`), and
/// its distances back: what each combinator that moves the point does, while the warp passes
/// every method of the surface on through it, once for all of them.
pub trait PointMap: Copy + GpuData {
    /// Whether it keeps shapes (a move, a turn, a scale by one factor): a segment maps to the
    /// segment between its ends' maps, and a distance scales as a length does. The default
    /// claims nothing.
    const SIMILAR: bool = false

    /// `p` in the surface's own space.
    fn local(self, p: vec3) -> vec3

    /// A direction (a difference of two points) in the surface's own space: the map's linear
    /// part. The default takes the map of the origin from the map of `d`.
    fn local_direction(self, d: vec3) -> vec3 {
        self.local(d) - self.local(vec3())
    }

    /// A distance in the surface's own space, in this one.
    fn distance_out(self, d: f32) -> f32 {
        d
    }

    /// A distance in this space, in the surface's own.
    fn distance_in(self, d: f32) -> f32 {
        d
    }

    /// A length in this space (a footprint, a bound's scope), in the surface's own.
    fn length_in(self, x: f32) -> f32 {
        x
    }

    /// The surface's bound (`Surface::bound`), in this space. Every map states it, as every
    /// surface does.
    fn bound(self, b: Bound) -> Bound
}

/// A surface whose points are moved before it's asked about them: `s.translate(by)`,
/// `s.rotate(by)` and `s.scale(by)`, each a `PointMap`.
pub struct Warp<S, M>: Copy + GpuData + Eq + StateHash {
    pub inner: S,
    pub map: M,
}

/// A part's bound as a similar map takes it out: its segment's ends through the map, its radius
/// and reach scaled out.
fn mapped_part_bound<M: PointMap>(m: M, c: PartBound) -> PartBound {
    let a = m.bound(Bound { centre: c.a, radius: c.r, slope: 1.0 })
    let b = m.bound(Bound { centre: c.b, radius: c.r, slope: 1.0 })
    PartBound { a: a.centre, r: max(a.radius, b.radius), b: b.centre, reach: m.distance_out(c.reach), lowers: m.distance_out(c.lowers) }
}

impl<S: Surface, M: PointMap> Surface for Warp<S, M> {
    /// Its surface's, moved by a map that keeps shapes (`PointMap::SIMILAR`: a capsule's ends
    /// map as points, its radius, reach and lowering as lengths); by any other, its whole bound.
    fn part_bound(self, i: u32) -> PartBound {
        if !M::SIMILAR {
            let b = self.bound()
            return PartBound { a: b.centre, r: b.radius, b: b.centre, reach: 0.0, lowers: 0.0 }
        }
        mapped_part_bound(self.map, self.inner.part_bound(i))
    }

    const EXACT_MEETS: bool = S::EXACT_MEETS
    const EXACT_PASSES: bool = S::EXACT_PASSES && M::SIMILAR

    fn distance(self, p: vec3) -> f32 {
        self.map.distance_out(self.inner.distance(self.map.local(p)))
    }

    /// The inner surface's, the ray taken into its space (`t` kept), where the map keeps shapes
    /// (`PointMap::SIMILAR`: its distances scale as lengths do); by any other, its bound's.
    fn passes(self, o: vec3, d: vec3) -> Pass {
        if !M::SIMILAR {
            return bound_pass_asked(self, o, d)
        }
        let p = self.inner.passes(self.map.local(o), self.map.local_direction(d))
        Pass {
            distance: self.map.distance_out(p.distance),
            low: self.map.distance_out(p.low),
            high: self.map.distance_out(p.high),
            other_distance: self.map.distance_out(p.other_distance),
            blend: self.map.distance_out(p.blend),
            ..p
        }
    }

    /// The inner surface's, the ray taken into its space (the map is affine, so `t` is kept)
    /// and `grow` with it.
    fn meets_grown(self, o: vec3, d: vec3, grow: f32, inner: f32) -> Meets {
        self.inner.meets_grown(self.map.local(o), self.map.local_direction(d), self.map.distance_in(grow), self.map.distance_in(inner))
    }

    fn masked(self, p: vec3, live: Live, first: u32) -> f32 {
        self.map.distance_out(self.inner.masked(self.map.local(p), live, first))
    }

    /// Of one part, its whole masked ask, this surface's own code included; else its inner
    /// surface's part's.
    fn part_work(self, i: u32) -> u32 {
        if self.parts() == 1 { masked_work(self) } else { self.inner.part_work(i) }
    }

    /// The inner surface's, asked where the map takes each point; its range in this space
    /// (`distance_out` rises with the distance, and so does its rounding).
    fn pruned<F: Copy + fn(vec3) -> vec3>(self, over: Box3, at: F, stretch: f32, live: Live, first: u32) -> Pruned {
        let map = self.map
        let r = self.inner.pruned(over, |q: vec3| map.local(at(q)), map.length_in(stretch), live, first)
        Pruned { live: r.live, range: Interval { lo: map.distance_out(r.range.lo), hi: map.distance_out(r.range.hi) } }
    }

    fn bound(self) -> Bound {
        self.map.bound(self.inner.bound())
    }

    fn filtered(self, p: vec3, footprint: f32) -> f32 {
        self.map.distance_out(self.inner.filtered(self.map.local(p), self.map.length_in(footprint)))
    }

    /// `by` is in this surface's units: the inner surface's part is raised by as much in its
    /// own.
    fn part_offset(self, p: vec3, i: u32, by: f32) -> f32 {
        self.map.distance_out(
            self.inner.part_offset(self.map.local(p), i, self.map.distance_in(by)),
        )
    }

    fn parts(self) -> u32 {
        self.inner.parts()
    }

    fn part_at(self, p: vec3) -> (f32, u32) {
        let (d, i) = self.inner.part_at(self.map.local(p))
        (self.map.distance_out(d), i)
    }

    fn part_distance(self, p: vec3, i: u32) -> f32 {
        self.map.distance_out(self.inner.part_distance(self.map.local(p), i))
    }

    fn part_name(self, i: u32) -> PartName {
        self.inner.part_name(i)
    }

    /// Moving, turning and scaling keep a gradient's length; the scope is the inner surface's.
    fn lipschitz(self, near: f32) -> f32 {
        self.inner.lipschitz(self.map.length_in(near))
    }
}

/// A surface moved by `by`: `s.translate(by)`.
pub type Translate<S> = Warp<S, Shift>

/// A surface turned about the origin: `s.rotate(by)`.
pub type Rotate<S> = Warp<S, Turn>

/// A surface scaled about the origin: `s.scale(by)`. Distances scale with it, so a distance
/// stays a distance. The scale is nonzero; `Surface::scale` enforces that invariant.
pub type Scale<S> = Warp<S, Size>

/// Moved by `by`.
pub struct Shift: Copy + GpuData + Eq + StateHash {
    pub by: vec3,
}

impl PointMap for Shift {
    const SIMILAR: bool = true

    fn local(self, p: vec3) -> vec3 {
        p - self.by
    }

    /// A move leaves a direction as it is.
    fn local_direction(self, d: vec3) -> vec3 {
        d
    }

    fn bound(self, b: Bound) -> Bound {
        b.moved(self.by)
    }
}

/// Turned about the origin: `to_local` takes a point into the surface's own space.
pub struct Turn: Copy + GpuData + Eq + StateHash {
    pub to_local: mat3,
}

impl PointMap for Turn {
    const SIMILAR: bool = true

    /// Column by column, as a derived interval needs (it has no matrix arithmetic).
    fn local(self, p: vec3) -> vec3 {
        let m = self.to_local
        m[0] * p.x + m[1] * p.y + m[2] * p.z
    }

    /// Its centre turned back: `to_local` is a rotation, so its inverse is its transpose, and
    /// the radius and slope stay.
    fn bound(self, b: Bound) -> Bound {
        let m = self.to_local
        Bound { centre: vec3(dot(m[0], b.centre), dot(m[1], b.centre), dot(m[2], b.centre)), ..b }
    }
}

/// Scaled by `by` about the origin.
pub struct Size: Copy + GpuData + Eq + StateHash {
    by: f32,
}

impl PointMap for Size {
    const SIMILAR: bool = true

    fn local(self, p: vec3) -> vec3 {
        p / self.by
    }

    fn distance_out(self, d: f32) -> f32 {
        d * abs(self.by)
    }

    fn distance_in(self, d: f32) -> f32 {
        d / abs(self.by)
    }

    fn length_in(self, x: f32) -> f32 {
        x / abs(self.by)
    }

    /// Scaled with it; an unbounded surface stays unbounded (its radius isn't a size).
    fn bound(self, b: Bound) -> Bound {
        if b.radius >= 1.0e30 {
            return UNBOUNDED
        }
        Bound { centre: b.centre * self.by, radius: b.radius * abs(self.by), slope: b.slope }
    }
}

// ---- fields written while the program runs (language.md §14.4) ----

/// The most nodes a `Written` holds, and the deepest its evaluation goes (its stack).
pub const WRITTEN_NODES: u32 = 64
/// The deepest a `Written`'s evaluation goes: its stack.
pub const WRITTEN_DEPTH: u32 = 16

// A `WrittenNode`'s kinds. Leaves, their numbers in `p` and `q`:
/// A ball of radius `p.x` about the origin.
pub const W_SPHERE: u32 = 1
/// An ellipsoid of radii `p.xyz`.
pub const W_ELLIPSOID: u32 = 2
/// A round cone: top `p.xyz` of radius `p.w`, bottom `q.xyz` of radius `q.w`.
pub const W_ROUND_CONE: u32 = 3
/// A box of half-extents `p.xyz`.
pub const W_CUBOID: u32 = 4
/// A half-space: the unit normal `p.xyz`, its offset `p.w`.
pub const W_HALF_SPACE: u32 = 5
// Maps of node `a`:
/// Moved by `p.xyz`.
pub const W_TRANSLATE: u32 = 16
/// Turned by the unit quaternion `p` (x, y, z, w).
pub const W_ROTATE: u32 = 17
/// Scaled by `p.x` (nonzero).
pub const W_SCALE: u32 = 18
// Joins of nodes `a` and `b`, `k` = `p.x`:
/// The union of `a` and `b` (their least).
pub const W_UNION: u32 = 32
/// `a` and `b` joined smoothly over `k`.
pub const W_SMOOTH_UNION: u32 = 33
/// The intersection of `a` and `b` (their most).
pub const W_INTERSECT: u32 = 34
/// `a` with `b` cut out, smoothly over `k`.
pub const W_SMOOTH_SUBTRACT: u32 = 35
/// `a` and `b` intersected smoothly over `k`.
pub const W_SMOOTH_INTERSECT: u32 = 36
/// Node `a` displaced by fractal noise: amplitude `p.x`, frequency `p.y`, octaves `p.z` (1 to
/// 6), its offset `q.xyz`.
pub const W_DISPLACE: u32 = 48
/// Reserved: the rates in time of the map node before it (not written yet; refused).
pub const W_RATES: u32 = 64

/// A node of a `Written`: its kind, its operands (earlier nodes), a leaf's matter (what the game's
/// look reads), and its numbers.
pub struct WrittenNode: Copy + GpuData + Eq + StateHash {
    pub kind: u32,
    pub a: u32,
    pub b: u32,
    pub matter: u32,
    pub p: vec4,
    pub q: vec4,
}

/// A field written while the program runs, as data: up to `WRITTEN_NODES` of std's own kinds in
/// post-order (each node after its operands; the last the root), made by `Writing` and checked
/// once (`Writing::done`). Every answer comes from each node's own kind's code: its distance is
/// the compiled tree's of the same kinds, to the bit on the CPU. A `Written` is `GpuData`, so it
/// passes to a shader as a uniform (about 6.5 KB).
pub struct Written: Copy + GpuData {
    nodes: [WrittenNode; 64],
    len: u32,
    /// Each node's nearest map above it (`WRITTEN_NODES` for none): the maps its point passes.
    up: [u32; 64],
    /// Each node's operator, the node it is an operand of (`WRITTEN_NODES` for the root).
    parent: [u32; 64],
    /// Each node's place in the tree (`W_UNDER_CUT`, `W_UNDER_UNION`), made at the door.
    under: [u32; 64],
    /// A rotation's matrix into its operand's space, made from its quaternion at the door.
    turns: [mat3; 64],
    /// The whole's bound, made once at the door.
    whole: Bound,
    leaves: u32,
}

/// Builds a `Written`: each method adds a node and gives its index; the last added is the root.
pub struct Writing {
    nodes: [WrittenNode; 64],
    len: u32,
    full: bool,
}

/// An empty `Writing`, to build a `Written` with.
pub fn writing() -> Writing {
    Writing { nodes: [WrittenNode { kind: 0, a: 0, b: 0, matter: 0, p: vec4(0.0), q: vec4(0.0) }; 64], len: 0, full: false }
}

impl Writing {
    fn add(mut self, n: WrittenNode) -> u32 {
        if self.len >= WRITTEN_NODES {
            self.full = true
            return self.len
        }
        self.nodes[self.len] = n
        self.len += 1
        self.len - 1
    }

    fn leaf(mut self, kind: u32, p: vec4, q: vec4, matter: u32) -> u32 {
        self.add(WrittenNode { kind, a: 0, b: 0, matter, p, q })
    }

    /// A ball of `radius` about the origin.
    pub fn sphere(mut self, radius: f32, matter: u32 = 0) -> u32 { self.leaf(W_SPHERE, vec4(radius, 0.0, 0.0, 0.0), vec4(0.0), matter) }
    /// An ellipsoid of `radii` about the origin.
    pub fn ellipsoid(mut self, radii: vec3, matter: u32 = 0) -> u32 { self.leaf(W_ELLIPSOID, vec4(radii, 0.0), vec4(0.0), matter) }
    /// The hull of a ball of `r_top` at `a` and one of `r_bottom` at `b`.
    pub fn round_cone(mut self, a: vec3, b: vec3, r_top: f32, r_bottom: f32, matter: u32 = 0) -> u32 { self.leaf(W_ROUND_CONE, vec4(a, r_top), vec4(b, r_bottom), matter) }
    /// A box of half-extents `half` about the origin.
    pub fn cuboid(mut self, half: vec3, matter: u32 = 0) -> u32 { self.leaf(W_CUBOID, vec4(half, 0.0), vec4(0.0), matter) }
    /// The half-space below the plane of unit `normal` at `offset`.
    pub fn half_space(mut self, normal: vec3, offset: f32, matter: u32 = 0) -> u32 { self.leaf(W_HALF_SPACE, vec4(normal, offset), vec4(0.0), matter) }

    fn of(mut self, kind: u32, a: u32, b: u32, p: vec4, q: vec4) -> u32 {
        self.add(WrittenNode { kind, a, b, matter: 0, p, q })
    }

    /// Node `a` moved by `by`.
    pub fn translate(mut self, a: u32, by: vec3) -> u32 { self.of(W_TRANSLATE, a, 0, vec4(by, 0.0), vec4(0.0)) }
    /// Node `a` turned by `by`.
    pub fn rotate(mut self, a: u32, by: Quat) -> u32 { self.of(W_ROTATE, a, 0, by.v, vec4(0.0)) }
    /// Node `a` scaled by `by` (nonzero) about the origin.
    pub fn scale(mut self, a: u32, by: f32) -> u32 { self.of(W_SCALE, a, 0, vec4(by, 0.0, 0.0, 0.0), vec4(0.0)) }
    /// The union of nodes `a` and `b`.
    pub fn union(mut self, a: u32, b: u32) -> u32 { self.of(W_UNION, a, b, vec4(0.0), vec4(0.0)) }
    /// Nodes `a` and `b` joined smoothly over `k`.
    pub fn smooth_union(mut self, a: u32, b: u32, k: f32) -> u32 { self.of(W_SMOOTH_UNION, a, b, vec4(k, 0.0, 0.0, 0.0), vec4(0.0)) }
    /// The intersection of nodes `a` and `b`.
    pub fn intersect(mut self, a: u32, b: u32) -> u32 { self.of(W_INTERSECT, a, b, vec4(0.0), vec4(0.0)) }
    /// Node `a` with node `b` cut out, smoothly over `k`.
    pub fn smooth_subtract(mut self, a: u32, b: u32, k: f32) -> u32 { self.of(W_SMOOTH_SUBTRACT, a, b, vec4(k, 0.0, 0.0, 0.0), vec4(0.0)) }
    /// Nodes `a` and `b` intersected smoothly over `k`.
    pub fn smooth_intersect(mut self, a: u32, b: u32, k: f32) -> u32 { self.of(W_SMOOTH_INTERSECT, a, b, vec4(k, 0.0, 0.0, 0.0), vec4(0.0)) }
    /// Node `a` displaced by fractal noise of `octaves` (1 to 6) at `freq`, `amp` high.
    pub fn displace(mut self, a: u32, amp: f32, freq: f32, octaves: u32, offset: vec3 = vec3()) -> u32 {
        self.of(W_DISPLACE, a, 0, vec4(amp, freq, f32(octaves), 0.0), vec4(offset, 0.0))
    }

    /// The field written, checked: at most `WRITTEN_NODES` nodes, its evaluation no deeper than
    /// `WRITTEN_DEPTH`, each node's operands the ones just before it in post-order, every number
    /// finite and in its kind's range; or why not.
    pub fn done(self) -> Result<Written, String> {
        written_of(self.nodes, self.len, self.full)
    }
}

/// Whether `x` is finite and within `lo..hi`.
fn within(x: f32, lo: f32, hi: f32) -> bool {
    x >= lo && x <= hi
}

/// The door: `nodes[..len]` checked and made a `Written` (its maps' chains, its rotations'
/// matrices, its bound), or why not. Bytes that came from anywhere pass through here.
pub fn written_of(nodes: [WrittenNode; 64], len: u32, full: bool) -> Result<Written, String> {
    if full || len == 0 || len > WRITTEN_NODES {
        return Err(f"a written field holds 1 to {WRITTEN_NODES} nodes")
    }
    var stack = [0; 16]
    var top: u32 = 0
    var parent = [WRITTEN_NODES; 64]
    var leaves: u32 = 0
    var turns = [mat3(vec3(0.0), vec3(0.0), vec3(0.0)); 64]
    for i in 0..len {
        let n = nodes[i]
        let k = n.kind
        let fin = within(n.p.x, lo: -1.0e6, hi: 1.0e6) && within(n.p.y, lo: -1.0e6, hi: 1.0e6) && within(n.p.z, lo: -1.0e6, hi: 1.0e6) && within(n.p.w, lo: -1.0e6, hi: 1.0e6) && within(n.q.x, lo: -1.0e6, hi: 1.0e6) && within(n.q.y, lo: -1.0e6, hi: 1.0e6) && within(n.q.z, lo: -1.0e6, hi: 1.0e6) && within(n.q.w, lo: -1.0e6, hi: 1.0e6)
        if !fin {
            return Err(f"node {i}: a number not finite or past a million")
        }
        if k >= W_SPHERE && k <= W_HALF_SPACE {
            let ok = if k == W_SPHERE { within(n.p.x, lo: 1.0e-3, hi: 50.0) } else if k == W_ELLIPSOID { within(n.p.x, lo: 1.0e-3, hi: 50.0) && within(n.p.y, lo: 1.0e-3, hi: 50.0) && within(n.p.z, lo: 1.0e-3, hi: 50.0) } else if k == W_ROUND_CONE { within(n.p.w, lo: 1.0e-3, hi: 50.0) && within(n.q.w, lo: 1.0e-3, hi: 50.0) && length(n.q.xyz - n.p.xyz) <= 100.0 } else if k == W_CUBOID { within(n.p.x, lo: 1.0e-3, hi: 50.0) && within(n.p.y, lo: 1.0e-3, hi: 50.0) && within(n.p.z, lo: 1.0e-3, hi: 50.0) } else { abs(length(n.p.xyz) - 1.0) <= 1.0e-3 && within(n.p.w, lo: -100.0, hi: 100.0) }
            if !ok {
                return Err(f"node {i}: a leaf's number out of its range")
            }
            if top >= WRITTEN_DEPTH {
                return Err(f"node {i}: deeper than {WRITTEN_DEPTH}")
            }
            stack[top] = i
            top += 1
            leaves += 1
        } else if k == W_TRANSLATE || k == W_ROTATE || k == W_SCALE || k == W_DISPLACE {
            if top == 0 || stack[top - 1] != n.a {
                return Err(f"node {i}: its operand isn't the node just before it")
            }
            let ok = if k == W_TRANSLATE { length(n.p.xyz) <= 1000.0 } else if k == W_ROTATE { abs(length(n.p) - 1.0) <= 1.0e-3 } else if k == W_SCALE { within(abs(n.p.x), lo: 1.0e-3, hi: 1000.0) } else { within(abs(n.p.x), lo: 0.0, hi: 1.0) && within(n.p.y, lo: 0.0, hi: 100.0) && n.p.z == floor(n.p.z) && within(n.p.z, lo: 1.0, hi: 6.0) }
            if !ok {
                return Err(f"node {i}: a number out of its range")
            }
            parent[n.a] = i
            stack[top - 1] = i
            if k == W_ROTATE {
                turns[i] = Quat { v: n.p }.inverse().to_mat3()
            }
        } else if k >= W_UNION && k <= W_SMOOTH_INTERSECT {
            if top < 2 || stack[top - 1] != n.b || stack[top - 2] != n.a {
                return Err(f"node {i}: its operands aren't the two nodes before it")
            }
            if !within(n.p.x, lo: 0.0, hi: 2.0) {
                return Err(f"node {i}: a join's width out of 0..2 m")
            }
            parent[n.a] = i
            parent[n.b] = i
            top -= 1
            stack[top - 1] = i
        } else {
            return Err(f"node {i}: kind {k} isn't one a written field holds (W_RATES is reserved)")
        }
    }
    if top != 1 {
        return Err(f"more than one root: every node but the last must be an operand")
    }
    // Each node's nearest map above it, from the root down.
    var up = [WRITTEN_NODES; 64]
    var i = len
    while i > 0 {
        i -= 1
        let pa = parent[i]
        if pa < WRITTEN_NODES {
            let pk = nodes[pa].kind
            up[i] = if pk == W_TRANSLATE || pk == W_ROTATE || pk == W_SCALE { pa } else { up[pa] }
        }
    }
    // Which nodes an intersection or a cut holds (asked whole: nothing prunes in them), and
    // which have a union, smooth or not, above them.
    var under = [0; 64]
    var i2 = len
    while i2 > 0 {
        i2 -= 1
        let pa = parent[i2]
        if pa < WRITTEN_NODES {
            let pk = nodes[pa].kind
            let cut = if pk == W_INTERSECT || pk == W_SMOOTH_SUBTRACT || pk == W_SMOOTH_INTERSECT { W_UNDER_CUT } else { 0 }
            let union = if pk == W_UNION || pk == W_SMOOTH_UNION { W_UNDER_UNION } else { 0 }
            under[i2] = under[pa] | cut | union
        }
    }
    var w = Written { nodes, len, up, parent, under, turns, whole: UNBOUNDED, leaves }
    w.whole = w.bound_of()
    Ok(w)
}

/// `Written::under`'s flag: an intersection or a cut is above the node.
const W_UNDER_CUT: u32 = 1
/// `Written::under`'s flag: a union or a smooth union is above the node.
const W_UNDER_UNION: u32 = 2

/// A ray, a growth and an inner as a written field's node is asked them (`Written::ray_at`).
struct WrittenRay: Copy {
    o: vec3,
    d: vec3,
    grow: f32,
    inner: f32,
}

impl Written {
    /// `p` taken through node `i`'s maps, the outermost first, as the compiled tree takes it.
    fn local_at(self, i: u32, p: vec3) -> vec3 {
        self.local_within(i, WRITTEN_NODES, p)
    }

    /// `p` taken through those of node `i`'s maps that are in node `top`'s subtree (`top` itself
    /// included), the outermost first: a point in `top`'s own space taken to `i`'s.
    fn local_within(self, i: u32, top: u32, p: vec3) -> vec3 {
        var chain = [0; 16]
        var n: u32 = 0
        var j = self.up[i]
        for k in 0..WRITTEN_DEPTH {
            if j >= WRITTEN_NODES || j > top {
                break
            }
            chain[n] = j
            n += 1
            j = self.up[j]
        }
        var x = p
        for k in 0..WRITTEN_DEPTH {
            if k >= n {
                break
            }
            let c = n - 1 - k
            let m = self.nodes[chain[c]]
            x = if m.kind == W_TRANSLATE { Shift { by: m.p.xyz }.local(x) } else if m.kind == W_ROTATE { Turn { to_local: self.turns[chain[c]] }.local(x) } else { Size { by: m.p.x }.local(x) }
        }
        x
    }

    /// Leaf `i`'s own distance at `x` (in its own space).
    fn leaf_distance(self, i: u32, x: vec3) -> f32 {
        let n = self.nodes[i]
        let k = n.kind
        // (Round cones first: a body is mostly them.)
        if k == W_ROUND_CONE { round_cone(n.p.xyz, n.q.xyz, r_top: n.p.w, r_bottom: n.q.w).distance(x) } else if k == W_SPHERE { sphere(n.p.x).distance(x) } else if k == W_CUBOID { cuboid(n.p.xyz).distance(x) } else if k == W_ELLIPSOID { ellipsoid(n.p.xyz).distance(x) } else { half_space(n.p.xyz, n.p.w).distance(x) }
    }

    fn leaf_bound(self, i: u32) -> Bound {
        let n = self.nodes[i]
        let k = n.kind
        if k == W_SPHERE { sphere(n.p.x).bound() } else if k == W_ELLIPSOID { ellipsoid(n.p.xyz).bound() } else if k == W_ROUND_CONE { round_cone(n.p.xyz, n.q.xyz, r_top: n.p.w, r_bottom: n.q.w).bound() } else if k == W_CUBOID { cuboid(n.p.xyz).bound() } else { half_space(n.p.xyz, n.p.w).bound() }
    }

    fn leaf_lipschitz(self, i: u32, near: f32) -> f32 {
        let n = self.nodes[i]
        let k = n.kind
        if k == W_SPHERE { sphere(n.p.x).lipschitz(near) } else if k == W_ELLIPSOID { ellipsoid(n.p.xyz).lipschitz(near) } else if k == W_ROUND_CONE { round_cone(n.p.xyz, n.q.xyz, r_top: n.p.w, r_bottom: n.q.w).lipschitz(near) } else if k == W_CUBOID { cuboid(n.p.xyz).lipschitz(near) } else { half_space(n.p.xyz, n.p.w).lipschitz(near) }
    }

    fn noise_of(n: WrittenNode) -> Fbm {
        fbm(n.p.y, u32(n.p.z), n.q.xyz)
    }

    /// The bound, node by node as each kind's own `bound` combines its operands' (made once).
    fn bound_of(self) -> Bound {
        if self.len == 0 {
            return UNBOUNDED
        }
        self.bound_within(min(self.len, WRITTEN_NODES) - 1)
    }

    /// The first node of node `top`'s subtree: its nodes are that one to `top`, in post-order.
    fn first_of(self, top: u32) -> u32 {
        var j = top
        for k in 0..WRITTEN_NODES {
            if self.nodes[j].kind <= W_HALF_SPACE {
                break
            }
            j = self.nodes[j].a
        }
        j
    }

    /// Node `top`'s own surface's bound, in its own space.
    fn bound_within(self, top: u32) -> Bound {
        var st = [UNBOUNDED; 16]
        var depth: u32 = 0
        let first = self.first_of(top)
        for s_ in 0..WRITTEN_NODES {
            let i = first + s_
            if i > top {
                break
            }
            let n = self.nodes[i]
            let k = n.kind
            if k <= W_HALF_SPACE {
                st[depth] = self.leaf_bound(i)
                depth += 1
            } else if k == W_TRANSLATE {
                st[depth - 1] = Shift { by: n.p.xyz }.bound(st[depth - 1])
            } else if k == W_ROTATE {
                st[depth - 1] = Turn { to_local: self.turns[i] }.bound(st[depth - 1])
            } else if k == W_SCALE {
                st[depth - 1] = Size { by: n.p.x }.bound(st[depth - 1])
            } else if k == W_DISPLACE {
                let r = Written::noise_of(n).range()
                st[depth - 1] = st[depth - 1].lowered(abs(n.p.x) * max(abs(r.lo), abs(r.hi)))
            } else {
                let (a, b) = (st[depth - 2], st[depth - 1])
                depth -= 1
                st[depth - 1] = if k == W_UNION { a.and(b) } else if k == W_SMOOTH_UNION { a.and(b).lowered(0.25 * max(n.p.x, 0.0)) } else if k == W_SMOOTH_SUBTRACT { a } else if a.radius <= b.radius { a } else { b }
            }
        }
        st[0]
    }

    /// Node `top`'s own surface's distance at `x`, in its own space: its subtree, node by node
    /// as `distance` takes the whole (what a smooth join and a displacement ask where a ray
    /// passes).
    fn distance_within(self, top: u32, x: vec3) -> f32 {
        var st = [0.0; 16]
        var depth: u32 = 0
        let first = self.first_of(top)
        for s_ in 0..WRITTEN_NODES {
            let i = first + s_
            if i > top {
                break
            }
            let n = self.nodes[i]
            let k = n.kind
            if k <= W_HALF_SPACE {
                st[depth] = self.leaf_distance(i, self.local_within(i, top, x))
                depth += 1
            } else if k == W_SCALE {
                st[depth - 1] = Size { by: n.p.x }.distance_out(st[depth - 1])
            } else if k == W_DISPLACE {
                st[depth - 1] = st[depth - 1] + n.p.x * Written::noise_of(n).value(self.local_within(i, top, x))
            } else if k >= W_UNION {
                let (a, b) = (st[depth - 2], st[depth - 1])
                depth -= 1
                st[depth - 1] = if k == W_UNION { min(a, b) } else if k == W_SMOOTH_UNION { smin(a, b, n.p.x) } else if k == W_INTERSECT { max(a, b) } else if k == W_SMOOTH_SUBTRACT { smax(a, -b, n.p.x) } else { smax(a, b, n.p.x) }
            }
        }
        st[0]
    }

    /// The ray `o + t d`, a growth and an inner (`Surface::meets_grown`'s), as node `i`'s own
    /// surface is asked them: taken down from the root through each node above it, as that kind
    /// passes them to its operands (a map moves the ray and scales the lengths in, a smooth union
    /// grows by a quarter of its width, a displacement by its reach either way).
    fn ray_at(self, i: u32, o: vec3, d: vec3, grow: f32, inner: f32) -> WrittenRay {
        var chain = [0; 64]
        var n: u32 = 0
        var j = self.parent[i]
        for k in 0..WRITTEN_NODES {
            if j >= WRITTEN_NODES {
                break
            }
            chain[n] = j
            n += 1
            j = self.parent[j]
        }
        var r = WrittenRay { o, d, grow, inner }
        for k in 0..WRITTEN_NODES {
            if k >= n {
                break
            }
            let a = chain[n - 1 - k]
            let m = self.nodes[a]
            if m.kind == W_TRANSLATE {
                let s = Shift { by: m.p.xyz }
                r = WrittenRay { o: s.local(r.o), d: s.local_direction(r.d), grow: s.distance_in(r.grow), inner: s.distance_in(r.inner) }
            } else if m.kind == W_ROTATE {
                let s = Turn { to_local: self.turns[a] }
                r = WrittenRay { o: s.local(r.o), d: s.local_direction(r.d), grow: s.distance_in(r.grow), inner: s.distance_in(r.inner) }
            } else if m.kind == W_SCALE {
                let s = Size { by: m.p.x }
                r = WrittenRay { o: s.local(r.o), d: s.local_direction(r.d), grow: s.distance_in(r.grow), inner: s.distance_in(r.inner) }
            } else if m.kind == W_SMOOTH_UNION {
                r.grow = r.grow + 0.25 * max(m.p.x, 0.0)
            } else if m.kind == W_DISPLACE {
                let nr = Written::noise_of(m).range()
                let reach = abs(m.p.x) * max(abs(nr.lo), abs(nr.hi))
                r.grow = r.grow + reach
                r.inner = r.inner - reach
            }
        }
        r
    }

    /// Leaf `i`'s own `part_bound`, in its own space.
    fn leaf_part_bound(self, i: u32) -> PartBound {
        let n = self.nodes[i]
        let k = n.kind
        if k == W_ROUND_CONE { round_cone(n.p.xyz, n.q.xyz, r_top: n.p.w, r_bottom: n.q.w).part_bound(0) } else if k == W_SPHERE { sphere(n.p.x).part_bound(0) } else if k == W_CUBOID { cuboid(n.p.xyz).part_bound(0) } else if k == W_ELLIPSOID { ellipsoid(n.p.xyz).part_bound(0) } else { half_space(n.p.xyz, n.p.w).part_bound(0) }
    }

    /// The node of part `i`: the `i`th leaf, in post-order (`WRITTEN_NODES` past the last).
    fn leaf_of(self, i: u32) -> u32 {
        var seen: u32 = 0
        for j in 0..min(self.len, WRITTEN_NODES) {
            if self.nodes[j].kind <= W_HALF_SPACE {
                if seen == i {
                    return j
                }
                seen += 1
            }
        }
        WRITTEN_NODES
    }

    /// Leaf `i`'s own `meets_grown`, in its own space.
    fn leaf_meets(self, i: u32, r: WrittenRay) -> Meets {
        let n = self.nodes[i]
        let k = n.kind
        if k == W_ROUND_CONE { round_cone(n.p.xyz, n.q.xyz, r_top: n.p.w, r_bottom: n.q.w).meets_grown(r.o, r.d, r.grow, r.inner) } else if k == W_SPHERE { sphere(n.p.x).meets_grown(r.o, r.d, r.grow, r.inner) } else if k == W_CUBOID { cuboid(n.p.xyz).meets_grown(r.o, r.d, r.grow, r.inner) } else if k == W_ELLIPSOID { ellipsoid(n.p.xyz).meets_grown(r.o, r.d, r.grow, r.inner) } else { half_space(n.p.xyz, n.p.w).meets_grown(r.o, r.d, r.grow, r.inner) }
    }

    /// Leaf `i`'s own `passes`, in its own space.
    fn leaf_passes(self, i: u32, r: WrittenRay) -> Pass {
        let n = self.nodes[i]
        let k = n.kind
        if k == W_ROUND_CONE { round_cone(n.p.xyz, n.q.xyz, r_top: n.p.w, r_bottom: n.q.w).passes(r.o, r.d) } else if k == W_SPHERE { sphere(n.p.x).passes(r.o, r.d) } else if k == W_CUBOID { cuboid(n.p.xyz).passes(r.o, r.d) } else if k == W_ELLIPSOID { ellipsoid(n.p.xyz).passes(r.o, r.d) } else { half_space(n.p.xyz, n.p.w).passes(r.o, r.d) }
    }

    /// Node `top`'s own surface's `lipschitz(near)`: the scope each node passes its operands (as
    /// each kind does), then each leaf's own, combined as each kind combines its operands'.
    fn lipschitz_within(self, top: u32, near: f32) -> f32 {
        var scope = [0.0; 64]
        let first = self.first_of(top)
        scope[top] = near
        var i = top + 1
        for _pass in 0..WRITTEN_NODES {
            if i <= first {
                break
            }
            i -= 1
            let n = self.nodes[i]
            let k = n.kind
            let sc = scope[i]
            if k == W_TRANSLATE || k == W_ROTATE {
                scope[n.a] = sc
            } else if k == W_SCALE {
                scope[n.a] = Size { by: n.p.x }.length_in(sc)
            } else if k == W_DISPLACE {
                let r = Written::noise_of(n).range()
                scope[n.a] = sc + abs(n.p.x) * max(abs(r.lo), abs(r.hi))
            } else if k >= W_UNION {
                let s2 = if k == W_UNION || k == W_INTERSECT { sc } else { sc + 1.25 * max(n.p.x, 0.0) }
                scope[n.a] = s2
                scope[n.b] = s2
            }
        }
        var st = [0.0; 16]
        var depth: u32 = 0
        for s_ in 0..WRITTEN_NODES {
            let j = first + s_
            if j > top {
                break
            }
            let n = self.nodes[j]
            let k = n.kind
            if k <= W_HALF_SPACE {
                st[depth] = self.leaf_lipschitz(j, scope[j])
                depth += 1
            } else if k == W_DISPLACE {
                st[depth - 1] = st[depth - 1] + abs(n.p.x) * Written::noise_of(n).lipschitz()
            } else if k >= W_UNION {
                let (a, b) = (st[depth - 2], st[depth - 1])
                depth -= 1
                st[depth - 1] = max(a, b)
            }
        }
        st[0]
    }

    /// The stretch `stretch` becomes in leaf `i`'s space: through each map above it, the
    /// outermost first, as each passes lengths in.
    fn stretch_at(self, i: u32, stretch: f32) -> f32 {
        var chain = [0; 16]
        var n: u32 = 0
        var j = self.up[i]
        for k in 0..WRITTEN_DEPTH {
            if j >= WRITTEN_NODES {
                break
            }
            chain[n] = j
            n += 1
            j = self.up[j]
        }
        var s = stretch
        for k in 0..WRITTEN_DEPTH {
            if k >= n {
                break
            }
            let m = self.nodes[chain[n - 1 - k]]
            if m.kind == W_SCALE {
                s = Size { by: m.p.x }.length_in(s)
            }
        }
        s
    }

    /// The default `pruned`'s range for node `i`'s own surface, asked at `self.local_at(i,
    /// at(q))` for `q` in `over`: its derived interval narrowed by its distance at the box's
    /// centre and its steepness, as `Surface::pruned` narrows.
    fn node_range<F: Copy + fn(vec3) -> vec3>(self, i: u32, over: Box3, at: F, stretch: f32) -> Interval {
        let w = self
        let x = interval(|q: vec3| w.distance_within(i, w.local_at(i, at(q))), over)
        let l = self.lipschitz_within(i, max(abs(x.lo), abs(x.hi)) * 1.001 + 0.000001)
        if !(l < 1.0e30) {
            return x
        }
        let d = self.distance_within(i, self.local_at(i, at(over.center())))
        let r = l * self.stretch_at(i, stretch) * 0.5 * length(over.hi - over.lo)
        let e = r * 1.0e-5 + abs(d) * 1.0e-6 + 1.0e-6
        Interval { lo: max(x.lo, d - r - e), hi: min(x.hi, d + r + e) }
    }

    /// How many nodes it holds.
    pub fn len(self) -> u32 {
        self.len
    }

    /// Its nodes' hash (`state_hash` of what it was written as: the key for its caches).
    pub fn hash(self) -> u64 {
        var h: u64 = state_hash(self.len)
        for i in 0..min(self.len, WRITTEN_NODES) {
            // (Wrapping: a hash's sum overflows as often as not.)
            h = h ^ state_hash(self.nodes[i]).wrapping_add(0x9E3779B97F4A7C15).wrapping_add(h << 6).wrapping_add(h >> 2)
        }
        h
    }

    /// Which matter the leaf whose own surface is nearest `p` is (what a leaf was written with):
    /// at a point of the surface, the leaf that made it there; where two leaves tie, the first.
    pub fn matter_at(self, p: vec3) -> u32 {
        var best = EMPTY
        var m: u32 = 0
        for i in 0..min(self.len, WRITTEN_NODES) {
            let n = self.nodes[i]
            if n.kind <= W_HALF_SPACE {
                let d = abs(self.leaf_distance(i, self.local_at(i, p)))
                if d < best {
                    best = d
                    m = n.matter
                }
            }
        }
        m
    }
}

impl Surface for Written {
    /// Node by node, each its own kind's code, in post-order on a stack (`WRITTEN_DEPTH` deep):
    /// a leaf at its point taken through its maps; a map gives its operand's (scaled out by a
    /// scale); a join, its kind's join of its operands; a displacement adds its noise at its own
    /// point.
    fn distance(self, p: vec3) -> f32 {
        // The stack's top two in `x0` (the top) and `x1`, the rest in `st`: a tree no deeper
        // than 2 (a fold of joins) never touches the array, which GPU code keeps in memory.
        var st = [0.0; 16]
        var top: u32 = 0
        var x0 = 0.0
        var x1 = 0.0
        for i in 0..min(self.len, WRITTEN_NODES) {
            let n = self.nodes[i]
            let k = n.kind
            if k == W_SMOOTH_UNION {
                // (The commonest join first: a body is a fold of them.)
                x0 = smin(x1, x0, n.p.x)
                top -= 1
                if top >= 2 {
                    x1 = st[top - 2]
                }
            } else if k <= W_HALF_SPACE {
                // (A leaf with no map above it is asked at `p` itself.)
                let x = if self.up[i] >= WRITTEN_NODES { p } else { self.local_at(i, p) }
                let v = self.leaf_distance(i, x)
                if top >= 2 {
                    st[top - 2] = x1
                }
                x1 = x0
                x0 = v
                top += 1
            } else if k == W_SCALE {
                x0 = Size { by: n.p.x }.distance_out(x0)
            } else if k == W_DISPLACE {
                x0 = x0 + n.p.x * Written::noise_of(n).value(self.local_at(i, p))
            } else if k >= W_UNION {
                let (a, b) = (x1, x0)
                x0 = if k == W_UNION { min(a, b) } else if k == W_SMOOTH_UNION { smin(a, b, n.p.x) } else if k == W_INTERSECT { max(a, b) } else if k == W_SMOOTH_SUBTRACT { smax(a, -b, n.p.x) } else { smax(a, b, n.p.x) }
                top -= 1
                if top >= 2 {
                    x1 = st[top - 2]
                }
            }
        }
        x0
    }

    /// Made once at the door, node by node as each kind combines its operands'.
    fn bound(self) -> Bound {
        self.whole
    }

    /// Its leaf's own, taken up through each node above it as that kind takes its operand's: a
    /// map moves it, a smooth union reaches farther by its width and a quarter (and lowers by the
    /// quarter), a union passes it on; an intersection, a cut and a displacement state their
    /// whole bound instead (`Surface::part_bound`'s default). The compiled tree's, to the bit.
    fn part_bound(self, i: u32) -> PartBound {
        let leaf = self.leaf_of(i)
        if leaf >= WRITTEN_NODES {
            let b = self.whole
            return PartBound { a: b.centre, r: b.radius, b: b.centre, reach: 0.0, lowers: 0.0 }
        }
        var c = self.leaf_part_bound(leaf)
        var j = self.parent[leaf]
        for k in 0..WRITTEN_NODES {
            if j >= WRITTEN_NODES {
                break
            }
            let m = self.nodes[j]
            let kind = m.kind
            if kind == W_TRANSLATE || kind == W_ROTATE || kind == W_SCALE {
                c = if kind == W_TRANSLATE { mapped_part_bound(Shift { by: m.p.xyz }, c) } else if kind == W_ROTATE { mapped_part_bound(Turn { to_local: self.turns[j] }, c) } else { mapped_part_bound(Size { by: m.p.x }, c) }
            } else if kind == W_SMOOTH_UNION {
                let kk = max(m.p.x, 0.0)
                c.reach += kk + 0.25 * kk
                c.lowers += 0.25 * kk
            } else if kind != W_UNION {
                let b = self.bound_within(j)
                c = PartBound { a: b.centre, r: b.radius, b: b.centre, reach: 0.0, lowers: 0.0 }
            }
            j = self.parent[j]
        }
        c
    }

    /// Part `i`'s own distance at `p`: its leaf's at its point, taken up through each node above
    /// it (a scale's lengths out, a displacement's noise added at its own point). The compiled
    /// tree's, to the bit.
    fn part_distance(self, p: vec3, i: u32) -> f32 {
        let leaf = self.leaf_of(i)
        if leaf >= WRITTEN_NODES {
            return self.distance(p)
        }
        var d = self.leaf_distance(leaf, self.local_at(leaf, p))
        var j = self.parent[leaf]
        for k in 0..WRITTEN_NODES {
            if j >= WRITTEN_NODES {
                break
            }
            let m = self.nodes[j]
            if m.kind == W_SCALE {
                d = Size { by: m.p.x }.distance_out(d)
            } else if m.kind == W_DISPLACE {
                d = d + m.p.x * Written::noise_of(m).value(self.local_at(j, p))
            }
            j = self.parent[j]
        }
        d
    }

    /// Its distance at `p` and the part that decides it, node by node as each kind decides: a
    /// union and a smooth union the nearer operand's (a tie `a`'s), an intersection and a smooth
    /// intersection the farther's, a cut the cutter's where the cut is the surface. The compiled
    /// tree's, to the bit.
    fn part_at(self, p: vec3) -> (f32, u32) {
        var ds = [0.0; 16]
        var ps = [0; 16]
        var top: u32 = 0
        var part: u32 = 0
        for i in 0..min(self.len, WRITTEN_NODES) {
            let n = self.nodes[i]
            let k = n.kind
            if k <= W_HALF_SPACE {
                ds[top] = self.leaf_distance(i, self.local_at(i, p))
                ps[top] = part
                top += 1
                part += 1
            } else if k == W_SCALE {
                ds[top - 1] = Size { by: n.p.x }.distance_out(ds[top - 1])
            } else if k == W_DISPLACE {
                ds[top - 1] = ds[top - 1] + n.p.x * Written::noise_of(n).value(self.local_at(i, p))
            } else if k >= W_UNION {
                let (da, db) = (ds[top - 2], ds[top - 1])
                let (ia, ib) = (ps[top - 2], ps[top - 1])
                top -= 1
                if k == W_UNION {
                    ds[top - 1] = min(da, db)
                    ps[top - 1] = if da <= db { ia } else { ib }
                } else if k == W_SMOOTH_UNION {
                    ds[top - 1] = smin(da, db, n.p.x)
                    ps[top - 1] = if da <= db { ia } else { ib }
                } else if k == W_INTERSECT {
                    ds[top - 1] = max(da, db)
                    ps[top - 1] = if da >= db { ia } else { ib }
                } else if k == W_SMOOTH_SUBTRACT {
                    ds[top - 1] = smax(da, -db, n.p.x)
                    ps[top - 1] = if da >= -db { ia } else { ib }
                } else {
                    ds[top - 1] = smax(da, db, n.p.x)
                    ps[top - 1] = if da >= db { ia } else { ib }
                }
            }
        }
        (ds[0], ps[0])
    }

    /// Node by node as each kind's own `pruned` does, `live` passed from each operand to the
    /// next as the compiled tree passes it: a leaf's range is its derived interval narrowed by
    /// its steepness (`Surface::pruned`'s default) through the maps above it; a scale's is its
    /// operand's scaled out, a displacement's its operand's and its noise's; a union and a
    /// smooth union leave out an operand the other is surely below (`joined`); an intersection
    /// and a cut take the default over themselves, leaving their parts as they are. Its ranges and
    /// mask are the compiled tree's of the same kinds, to the bit on the CPU.
    fn pruned<F: Copy + fn(vec3) -> vec3>(self, over: Box3, at: F, stretch: f32, live: Live, first: u32) -> Pruned {
        var ranges = [Interval { lo: 0.0, hi: 0.0 }; 16]
        var firsts = [0; 16]
        var counts = [0; 16]
        var top: u32 = 0
        var cur = live
        var part = first
        for i in 0..min(self.len, WRITTEN_NODES) {
            let n = self.nodes[i]
            let k = n.kind
            let cut = (self.under[i] & W_UNDER_CUT) != 0
            // The default's range, for a leaf and for an intersection or a cut, asked from one
            // place (a derived interval of the evaluator is big GPU code: one copy of it).
            let own = !cut && (k <= W_HALF_SPACE || k > W_SMOOTH_UNION && k <= W_SMOOTH_INTERSECT)
            let r0 = if own { self.node_range(i, over, at, stretch) } else { Interval { lo: 0.0, hi: 0.0 } }
            if k <= W_HALF_SPACE {
                ranges[top] = r0
                firsts[top] = part
                counts[top] = 1
                top += 1
                part += 1
            } else if cut {
                if k >= W_UNION {
                    top -= 1
                    counts[top - 1] = counts[top - 1] + counts[top]
                }
            } else if k == W_SCALE {
                let sz = Size { by: n.p.x }
                let r = ranges[top - 1]
                ranges[top - 1] = Interval { lo: sz.distance_out(r.lo), hi: sz.distance_out(r.hi) }
            } else if k == W_DISPLACE {
                let w = self
                let amp = n.p.x
                let noise = Written::noise_of(n)
                let x = interval(|q: vec3| amp * noise.value(w.local_at(i, at(q))), over)
                let r = ranges[top - 1]
                ranges[top - 1] = outward(Interval { lo: r.lo + x.lo, hi: r.hi + x.hi })
            } else if k == W_UNION || k == W_SMOOTH_UNION {
                let kk = if k == W_UNION { 0.0 } else { n.p.x }
                let j = joined(ranges[top - 2], Pruned { live: cur, range: ranges[top - 1] }, firsts[top - 2], counts[top - 2], counts[top - 1], kk)
                cur = j.live
                top -= 1
                ranges[top - 1] = j.range
                counts[top - 1] = counts[top - 1] + counts[top]
            } else if k >= W_UNION {
                top -= 1
                ranges[top - 1] = r0
                counts[top - 1] = counts[top - 1] + counts[top]
            }
        }
        Pruned { live: cur, range: ranges[0] }
    }

    /// Node by node as `distance`, asking only what the compiled tree's `masked` asks: an
    /// operand of a union or a smooth union none of whose parts is live counts as `EMPTY`; what
    /// an intersection or a cut holds is asked whole. A leaf is asked only where that could
    /// matter. The compiled tree's of the same kinds, to the bit on the CPU.
    fn masked(self, p: vec3, live: Live, first: u32) -> f32 {
        var st = [0.0; 16]
        var firsts = [0; 16]
        var counts = [0; 16]
        var top: u32 = 0
        var part = first
        for i in 0..min(self.len, WRITTEN_NODES) {
            let n = self.nodes[i]
            let k = n.kind
            if k <= W_HALF_SPACE {
                // A dead leaf below a union and no cut is left out at its nearest union, which
                // its operand is to it alone (with what moves or displaces it).
                let u = self.under[i]
                let asked = live.has(part) || (u & W_UNDER_CUT) != 0 || (u & W_UNDER_UNION) == 0
                st[top] = if asked { self.leaf_distance(i, self.local_at(i, p)) } else { EMPTY }
                firsts[top] = part
                counts[top] = 1
                top += 1
                part += 1
            } else if k == W_SCALE {
                st[top - 1] = Size { by: n.p.x }.distance_out(st[top - 1])
            } else if k == W_DISPLACE {
                st[top - 1] = st[top - 1] + n.p.x * Written::noise_of(n).value(self.local_at(i, p))
            } else if k >= W_UNION {
                var a = st[top - 2]
                var b = st[top - 1]
                let cut = (self.under[i] & W_UNDER_CUT) != 0
                if (k == W_UNION || k == W_SMOOTH_UNION) && !cut {
                    if !live.any(firsts[top - 2], counts[top - 2]) {
                        a = EMPTY
                    }
                    if !live.any(firsts[top - 1], counts[top - 1]) {
                        b = EMPTY
                    }
                }
                top -= 1
                st[top - 1] = if k == W_UNION { min(a, b) } else if k == W_SMOOTH_UNION { smin(a, b, n.p.x) } else if k == W_INTERSECT { max(a, b) } else if k == W_SMOOTH_SUBTRACT { smax(a, -b, n.p.x) } else { smax(a, b, n.p.x) }
                counts[top - 1] = counts[top - 1] + counts[top]
            }
        }
        st[0]
    }

    /// Node by node as each kind's own `meets_grown` combines its operands': each leaf's, asked
    /// the ray, growth and inner its ancestors pass it (`ray_at`); a union the nearer, an
    /// intersection both, a smooth join and a displacement loosened, a cut its kept side's. Exact
    /// wherever the compiled tree of the same kinds is (`Meets::exact`), to the bit on the CPU.
    fn meets_grown(self, o: vec3, d: vec3, grow: f32, inner: f32) -> Meets {
        var st = [bound_meets(UNBOUNDED, o, d, grow); 16]
        var top: u32 = 0
        for i in 0..min(self.len, WRITTEN_NODES) {
            let n = self.nodes[i]
            let k = n.kind
            if k <= W_HALF_SPACE {
                st[top] = self.leaf_meets(i, self.ray_at(i, o, d, grow: grow, inner: inner))
                top += 1
            } else if k == W_DISPLACE {
                st[top - 1] = st[top - 1].loose()
            } else if k >= W_UNION {
                let (a, b) = (st[top - 2], st[top - 1])
                top -= 1
                st[top - 1] = if k == W_UNION {
                    a.or(b)
                } else if k == W_SMOOTH_UNION {
                    a.or(b).loose()
                } else if k == W_INTERSECT {
                    let m = a.and(b)
                    let r = self.ray_at(i, o, d, grow: grow, inner: inner)
                    if m.exact() && r.grow == r.inner { Meets { first: m.near, ..m } } else { m }
                } else if k == W_SMOOTH_SUBTRACT {
                    a.unsure()
                } else {
                    a.and(b).unsure()
                }
            }
        }
        st[0]
    }

    /// Node by node as each kind's own `passes` combines its operands': each leaf's on the ray in
    /// its own space, a scale's lengths out, a union the nearer, a smooth union its operands'
    /// lowered and asked once where they pass, a displacement its operand's within its reach and
    /// asked once, an intersection and a cut their bound's pass asked once. Exact wherever the
    /// compiled tree of the same kinds is, to the bit on the CPU.
    fn passes(self, o: vec3, d: vec3) -> Pass {
        var st = [bound_passes(UNBOUNDED, o, d); 16]
        var top: u32 = 0
        for i in 0..min(self.len, WRITTEN_NODES) {
            let n = self.nodes[i]
            let k = n.kind
            if k <= W_HALF_SPACE {
                st[top] = self.leaf_passes(i, self.ray_at(i, o, d, grow: 0.0, inner: 0.0))
                top += 1
            } else if k == W_SCALE {
                let s = Size { by: n.p.x }
                let p = st[top - 1]
                st[top - 1] = Pass {
                    distance: s.distance_out(p.distance),
                    low: s.distance_out(p.low),
                    high: s.distance_out(p.high),
                    other_distance: s.distance_out(p.other_distance),
                    blend: s.distance_out(p.blend),
                    ..p
                }
            } else if k == W_DISPLACE {
                let nr = Written::noise_of(n).range()
                let reach = abs(n.p.x) * max(abs(nr.lo), abs(nr.hi))
                let p = st[top - 1]
                let q = Pass { high: p.high + reach, ..p.lowered(reach, 0.0) }
                let r = self.ray_at(i, o, d, grow: 0.0, inner: 0.0)
                st[top - 1] = q.asked(q.t, self.distance_within(i, r.o + r.d * q.t))
            } else if k >= W_UNION {
                let (a, b) = (st[top - 2], st[top - 1])
                top -= 1
                st[top - 1] = if k == W_UNION {
                    a.or(b)
                } else if k == W_SMOOTH_UNION {
                    let kk = max(n.p.x, 0.0)
                    let p = a.or(b).lowered(0.25 * kk, kk)
                    let r = self.ray_at(i, o, d, grow: 0.0, inner: 0.0)
                    p.asked(p.t, self.distance_within(i, r.o + r.d * p.t))
                } else {
                    let r = self.ray_at(i, o, d, grow: 0.0, inner: 0.0)
                    let p = bound_passes(self.bound_within(i), r.o, r.d)
                    p.asked(p.t, self.distance_within(i, r.o + r.d * p.t))
                }
            }
        }
        st[0]
    }

    /// Node by node: the scope each node passes its operands (as each kind does), then each
    /// leaf's own, combined as each kind combines its operands'.
    fn lipschitz(self, near: f32) -> f32 {
        if self.len == 0 {
            return 1.0
        }
        self.lipschitz_within(min(self.len, WRITTEN_NODES) - 1, near)
    }

    /// Each leaf a part, in order.
    fn parts(self) -> u32 {
        self.leaves
    }
}

/// A surface with noise added to its distance: `s.displace(noise, amp)`.
pub struct Displace<S, N>: Copy + GpuData + Eq + StateHash {
    pub inner: S,
    pub noise: N,
    pub amp: f32,
}

impl<S: Surface, N: Noise> Surface for Displace<S, N> {
    fn distance(self, p: vec3) -> f32 {
        self.inner.distance(p) + self.amp * self.noise.value(p)
    }

    /// The inner surface's grown by the most the displacement can lower it: not exact.
    /// Met by its surface's shrunk by as much: there the displacement can't lift it above 0.
    fn meets_grown(self, o: vec3, d: vec3, grow: f32, inner: f32) -> Meets {
        let r = self.noise.range()
        let a = abs(self.amp) * max(abs(r.lo), abs(r.hi))
        self.inner.meets_grown(o, d, grow + a, inner - a).loose()
    }

    /// The inner surface's, less the most the displacement lowers it: a bound (the displaced
    /// distance is the inner one less at most that), at the inner pass's `t`, which `refined`
    /// makes nearly the least with asks of the displaced distance.
    fn passes(self, o: vec3, d: vec3) -> Pass {
        let r = self.noise.range()
        let a = abs(self.amp) * max(abs(r.lo), abs(r.hi))
        // Within its reach of its inner surface's, either way; asked once where that passes.
        let p = self.inner.passes(o, d)
        let q = Pass { high: p.high + a, ..p.lowered(a, 0.0) }
        q.asked(q.t, self.distance(o + d * q.t))
    }

    fn masked(self, p: vec3, live: Live, first: u32) -> f32 {
        self.inner.masked(p, live, first) + self.amp * self.noise.value(p)
    }

    /// Of one part, its whole masked ask, this surface's own code included; else its inner
    /// surface's part's.
    fn part_work(self, i: u32) -> u32 {
        if self.parts() == 1 { masked_work(self) } else { self.inner.part_work(i) }
    }

    /// The inner surface's (a displacement moves every operand of a union inside it alike),
    /// and its range plus the displacement's.
    fn pruned<F: Copy + fn(vec3) -> vec3>(self, over: Box3, at: F, stretch: f32, live: Live, first: u32) -> Pruned {
        let r = self.inner.pruned(over, at, stretch, live, first)
        let (noise, amp) = (self.noise, self.amp)
        let n = interval(|q: vec3| amp * noise.value(at(q)), over)
        Pruned { live: r.live, range: outward(Interval { lo: r.range.lo + n.lo, hi: r.range.hi + n.hi }) }
    }

    fn bound(self) -> Bound {
        let r = self.noise.range()
        self.inner.bound().lowered(abs(self.amp) * max(abs(r.lo), abs(r.hi)))
    }

    fn filtered(self, p: vec3, footprint: f32) -> f32 {
        self.inner.filtered(p, footprint) + self.amp * self.noise.filtered(p, vec3(footprint))
    }

    fn part_offset(self, p: vec3, i: u32, by: f32) -> f32 {
        self.inner.part_offset(p, i, by) + self.amp * self.noise.value(p)
    }

    fn parts(self) -> u32 {
        self.inner.parts()
    }

    fn part_at(self, p: vec3) -> (f32, u32) {
        let (d, i) = self.inner.part_at(p)
        (d + self.amp * self.noise.value(p), i)
    }

    fn part_distance(self, p: vec3, i: u32) -> f32 {
        self.inner.part_distance(p, i) + self.amp * self.noise.value(p)
    }

    fn part_name(self, i: u32) -> PartName {
        self.inner.part_name(i)
    }

    /// The inner surface's bound, where it's within `near` plus the displacement's reach, and
    /// the noise's, scaled by the amplitude.
    fn lipschitz(self, near: f32) -> f32 {
        let r = self.noise.range()
        let reach = abs(self.amp) * max(abs(r.lo), abs(r.hi))
        self.inner.lipschitz(near + reach) + abs(self.amp) * self.noise.lipschitz()
    }

    /// The inner surface's, plus the noise's range scaled by the amplitude: no noise evaluated,
    /// and narrower than the noise's steepness allows. Widened by the rounding of the noise's
    /// sum and of this one.
    fn interval_near(self, b: Box3) -> Interval {
        let x = self.inner.interval_near(b)
        let r = self.noise.range()
        let e = 1.0e-5 * max(abs(r.lo), abs(r.hi))
        let (a, c) = (self.amp * (r.lo - e), self.amp * (r.hi + e))
        let lo = x.lo + min(a, c)
        let hi = x.hi + max(a, c)
        Interval { lo: lo - 1.0e-6 * abs(lo), hi: hi + 1.0e-6 * abs(hi) }
    }
}

/// The smooth maximum of two distances: `-smin(-a, -b, k)`. Where they're `k` or more apart
/// it's exactly the larger; with `k <= 0` it's `max(a, b)`.
pub fn smax(a: f32, b: f32, k: f32) -> f32 {
    -smin(-a, -b, k)
}

/// `a` with `b` cut out of it: `a.smooth_subtract(b, k)`.
pub struct SmoothSubtract<A, B>: Copy + GpuData + Eq + StateHash {
    pub a: A,
    pub b: B,
    pub k: f32,
}

impl<A: Surface, B: Surface> Surface for SmoothSubtract<A, B> {
    fn distance(self, p: vec3) -> f32 {
        smax(self.a.distance(p), -self.b.distance(p), self.k)
    }

    /// Within `a`'s: its distance is at least `a`'s (`smax` is at least the larger). Not exact.
    fn meets_grown(self, o: vec3, d: vec3, grow: f32, inner: f32) -> Meets {
        self.a.meets_grown(o, d, grow, inner).unsure()
    }

    /// `a`'s: the smooth maximum is at least the larger, so at least `a`'s distance.
    fn bound(self) -> Bound {
        self.a.bound()
    }

    fn filtered(self, p: vec3, footprint: f32) -> f32 {
        smax(self.a.filtered(p, footprint), -self.b.filtered(p, footprint), self.k)
    }

    fn part_offset(self, p: vec3, i: u32, by: f32) -> f32 {
        let (da, db) = pair_offsets(self.a, self.b, p, i, by)
        smax(da, -db, self.k)
    }

    fn parts(self) -> u32 {
        pair_parts(self.a, self.b)
    }

    /// The cutter's part where the cut is the surface (inside `b`, farther than `a`), else
    /// `a`'s.
    fn part_at(self, p: vec3) -> (f32, u32) {
        let (da, ia) = self.a.part_at(p)
        let (db, ib) = self.b.part_at(p)
        (smax(da, -db, self.k), if da >= -db { ia } else { self.a.parts() + ib })
    }

    fn part_distance(self, p: vec3, i: u32) -> f32 {
        pair_part_distance(self.a, self.b, p, i)
    }

    fn part_name(self, i: u32) -> PartName {
        pair_part_name(self.a, self.b, i)
    }

    /// A smooth maximum's gradient is a weighted mean of its operands', so the larger bound.
    /// Where it's within `near`, its operands are within `near + 1.25 k`: it can be `k / 4`
    /// above the larger, and the smaller contributes while they're less than `k` apart.
    fn lipschitz(self, near: f32) -> f32 {
        let scope = near + 1.25 * max(self.k, 0.0)
        max(self.a.lipschitz(scope), self.b.lipschitz(scope))
    }
}

/// What two surfaces hold in common, rounded: `a.smooth_intersect(b, k)`.
pub struct SmoothIntersect<A, B>: Copy + GpuData + Eq + StateHash {
    pub a: A,
    pub b: B,
    pub k: f32,
}

impl<A: Surface, B: Surface> Surface for SmoothIntersect<A, B> {
    fn distance(self, p: vec3) -> f32 {
        smax(self.a.distance(p), self.b.distance(p), self.k)
    }

    /// Within both's: its distance is at least each's. Not exact.
    fn meets_grown(self, o: vec3, d: vec3, grow: f32, inner: f32) -> Meets {
        self.a.meets_grown(o, d, grow, inner).and(self.b.meets_grown(o, d, grow, inner)).unsure()
    }

    /// The tighter operand's: the smooth maximum is at least each distance.
    fn bound(self) -> Bound {
        let (a, b) = (self.a.bound(), self.b.bound())
        if a.radius <= b.radius { a } else { b }
    }

    fn filtered(self, p: vec3, footprint: f32) -> f32 {
        smax(self.a.filtered(p, footprint), self.b.filtered(p, footprint), self.k)
    }

    fn part_offset(self, p: vec3, i: u32, by: f32) -> f32 {
        let (da, db) = pair_offsets(self.a, self.b, p, i, by)
        smax(da, db, self.k)
    }

    fn parts(self) -> u32 {
        pair_parts(self.a, self.b)
    }

    /// The farther operand's part; a tie takes `a`'s.
    fn part_at(self, p: vec3) -> (f32, u32) {
        let (da, ia) = self.a.part_at(p)
        let (db, ib) = self.b.part_at(p)
        (smax(da, db, self.k), if da >= db { ia } else { self.a.parts() + ib })
    }

    fn part_distance(self, p: vec3, i: u32) -> f32 {
        pair_part_distance(self.a, self.b, p, i)
    }

    fn part_name(self, i: u32) -> PartName {
        pair_part_name(self.a, self.b, i)
    }

    fn lipschitz(self, near: f32) -> f32 {
        let scope = near + 1.25 * max(self.k, 0.0)
        max(self.a.lipschitz(scope), self.b.lipschitz(scope))
    }
}

/// A surface and its mirror image in x = 0: `s.mirror_x()`.
pub struct Mirror<S>: Copy + GpuData + Eq + StateHash {
    pub inner: S,
}

/// `p` reflected into x ≥ 0, where a mirrored surface is written.
fn mirrored(p: vec3) -> vec3 {
    vec3(abs(p.x), p.y, p.z)
}

/// A point's image in x = 0.
fn mirrored_centre(c: vec3) -> vec3 {
    vec3(-c.x, c.y, c.z)
}

impl<S: Surface> Surface for Mirror<S> {
    fn distance(self, p: vec3) -> f32 {
        self.inner.distance(mirrored(p))
    }

    /// Within its surface's and that one's image in x = 0: not exact.
    fn meets_grown(self, o: vec3, d: vec3, grow: f32, inner: f32) -> Meets {
        let a = self.inner.meets_grown(o, d, grow, inner)
        let b = self.inner.meets_grown(mirrored_centre(o), mirrored_centre(d), grow, inner)
        a.or(b).unsure()
    }

    /// The surface's bound and its image's, joined.
    fn bound(self) -> Bound {
        let b = self.inner.bound()
        b.and(Bound { centre: mirrored_centre(b.centre), ..b })
    }

    fn filtered(self, p: vec3, footprint: f32) -> f32 {
        self.inner.filtered(mirrored(p), footprint)
    }

    /// A part as written decides at x ≥ 0, its image at x < 0 (as `part_at` has it).
    fn part_offset(self, p: vec3, i: u32, by: f32) -> f32 {
        let n = self.inner.parts()
        let image = p.x < 0.0
        if (i < n) != image {
            self.inner.part_offset(mirrored(p), i % n, by)
        } else {
            self.inner.distance(mirrored(p))
        }
    }

    /// Its own parts, as written (at x ≥ 0), then their images.
    fn parts(self) -> u32 {
        2 * self.inner.parts()
    }

    fn part_at(self, p: vec3) -> (f32, u32) {
        let (d, i) = self.inner.part_at(mirrored(p))
        (d, if p.x < 0.0 { self.inner.parts() + i } else { i })
    }

    fn part_distance(self, p: vec3, i: u32) -> f32 {
        let n = self.inner.parts()
        if i < n {
            self.inner.part_distance(p, i)
        } else {
            self.inner.part_distance(vec3(-p.x, p.y, p.z), i - n)
        }
    }

    fn part_name(self, i: u32) -> PartName {
        let n = self.inner.parts()
        if i < n {
            self.inner.part_name(i)
        } else {
            var name = self.inner.part_name(i - n)
            name.mirrored = !name.mirrored
            name
        }
    }

    fn lipschitz(self, near: f32) -> f32 {
        self.inner.lipschitz(near)
    }
}

/// A surface that is one part, named: `s.named(name)`.
pub struct Named<S>: Copy + GpuData + Eq + StateHash {
    pub inner: S,
    pub name: Text,
}

impl<S: Surface> Surface for Named<S> {
    const EXACT_MEETS: bool = S::EXACT_MEETS
    const EXACT_PASSES: bool = S::EXACT_PASSES

    fn distance(self, p: vec3) -> f32 {
        self.inner.distance(p)
    }

    fn passes(self, o: vec3, d: vec3) -> Pass {
        self.inner.passes(o, d)
    }

    fn meets_grown(self, o: vec3, d: vec3, grow: f32, inner: f32) -> Meets {
        self.inner.meets_grown(o, d, grow, inner)
    }

    fn bound(self) -> Bound {
        self.inner.bound()
    }

    fn filtered(self, p: vec3, footprint: f32) -> f32 {
        self.inner.filtered(p, footprint)
    }

    fn part_name(self, i: u32) -> PartName {
        PartName { name: self.name, group: "", frame: "", mirrored: false }
    }

    fn lipschitz(self, near: f32) -> f32 {
        self.inner.lipschitz(near)
    }

    fn interval_near(self, b: Box3) -> Interval {
        self.inner.interval_near(b)
    }
}

// ---- noise --------------------------------------------------------------------------------------

/// A 32-bit integer hash (PCG-style, `std::hash::pcg` of an advanced state), the same bits on the
/// CPU and the GPU.
pub fn hash_u32(x: u32) -> u32 {
    pcg(x.wrapping_mul(747796405).wrapping_add(2891336453))
}

/// `i32(x)` for a whole number `x`, wrapped to 32 bits as the lattice's hash wraps its
/// coordinates: `x`'s low 32 bits beyond the i32 range, and 0 for inf or NaN.
pub fn lattice_coord(x: f32) -> i32 {
    if abs(x) < 2147483648.0 {
        return i32(x)
    }
    // Exact: at |x| >= 2^31 an f32 is a multiple of 2^8, and so is this, which is below 2^32.
    let low = x - 4294967296.0 * floor(x / 4294967296.0)
    if low == low {
        i32(u32(low))
    } else {
        0
    }
}

/// A pseudo-random value in [-1, 1] for an integer lattice point.
pub fn lattice(x: i32, y: i32, z: i32) -> f32 {
    let h = hash_u32(u32(x).wrapping_add(hash_u32(u32(y).wrapping_add(hash_u32(u32(z))))))
    f32(h) * (2.0 / 4294967295.0) - 1.0
}

/// Value noise with a quintic fade: in [-1, 1], smooth, one lattice cell per unit. NaN where a
/// coordinate is infinite or NaN.
pub fn value_noise(p: vec3) -> f32 {
    let fl = floor(p)
    let ix = lattice_coord(fl.x)
    let iy = lattice_coord(fl.y)
    let iz = lattice_coord(fl.z)
    let f = p - fl
    // `saturate` changes no value (the fade maps [0, 1] onto itself), but it tells an interval
    // the fade stays in [0, 1] even across a cell boundary, where `f` alone can't.
    let u = saturate(f * f * f * (f * (f * 6.0 - 15.0) + 10.0))
    let (jx, jy, jz) = (ix.wrapping_add(1), iy.wrapping_add(1), iz.wrapping_add(1))
    let a = lattice(ix, iy, iz)
    let b = lattice(jx, iy, iz)
    let c = lattice(ix, jy, iz)
    let d = lattice(jx, jy, iz)
    let e = lattice(ix, iy, jz)
    let f1 = lattice(jx, iy, jz)
    let g = lattice(ix, jy, jz)
    let h = lattice(jx, jy, jz)
    mix(mix(mix(a, b, u.x), mix(c, d, u.x), u.y), mix(mix(e, f1, u.x), mix(g, h, u.x), u.y), u.z)
}

/// The integral of value noise's interpolation kernel, K(t) = fade(1 − |t|), from 0 to t: odd,
/// and ±1/2 from |t| = 1 on. With U(v) = v⁶ − 3v⁵ + 5/2 v⁴, the quintic fade's antiderivative,
/// it's U(1) − U(1 − |t|).
fn kernel_integral(t: f32) -> f32 {
    let v = 1.0 - min(abs(t), 1.0)
    let g = 0.5 - v * v * v * v * (v * (v - 3.0) + 2.5)
    if t < 0.0 { -g } else { g }
}

/// The weight lattice coordinate `i` gives the average of value noise over `[x − h, x + h]` on
/// one axis: its kernel's integral over the interval, divided by its width; for `h` = 0, the
/// kernel's value at `x`.
fn box_weight(x: f32, h: f32, i: f32) -> f32 {
    if h <= 0.0 {
        let t = 1.0 - min(abs(x - i), 1.0)
        t * t * t * (t * (t * 6.0 - 15.0) + 10.0)
    } else {
        (kernel_integral(x + h - i) - kernel_integral(x - h - i)) / (2.0 * h)
    }
}

/// Value noise averaged over the box `p ± half`, exactly (up to rounding): each axis's half
/// width may be 0, which samples it. Value noise is a sum of lattice values, each times a
/// kernel that's a product over the axes, so its average is a sum over the lattice points the
/// box reaches, each times its kernel's average on each axis.
pub fn value_noise_box(p: vec3, half: vec3) -> f32 {
    let h = abs(half)
    // Work relative to p's cell, so adding one lattice step does not round back to the same
    // coordinate where |p| is at least 2^24.
    let cell = floor(p)
    let f = p - cell
    let lo = floor(f - h)
    let n = floor(f + h) - lo + 2.0
    let (nx, ny, nz) = (u32(n.x), u32(n.y), u32(n.z))
    let (ix, iy, iz) = (
        lattice_coord(cell.x).wrapping_add(lattice_coord(lo.x)),
        lattice_coord(cell.y).wrapping_add(lattice_coord(lo.y)),
        lattice_coord(cell.z).wrapping_add(lattice_coord(lo.z)),
    )
    let local = f - lo
    var s = 0.0
    for k in 0..nz {
        let wz = box_weight(local.z, h.z, f32(k))
        if wz != 0.0 {
            for j in 0..ny {
                let wyz = wz * box_weight(local.y, h.y, f32(j))
                if wyz != 0.0 {
                    for i in 0..nx {
                        let w = wyz * box_weight(local.x, h.x, f32(i))
                        let v = lattice(
                            ix.wrapping_add(i32(i)),
                            iy.wrapping_add(i32(j)),
                            iz.wrapping_add(i32(k)),
                        )
                        s += w * v
                    }
                }
            }
        }
    }
    s
}

/// `value_noise_box(p, half)` for a box that reaches at most `MOST_BOX_SIDE` lattice points on an
/// axis (about six cells wide), and the noise's mean, 0, for a wider one, which averages to
/// about that: its loops have a length the compiler sees, so a GPU kernel that calls it has a
/// bound (docs/rates.md). (`value_noise_box` is the same within that, its loops unbounded; it
/// becomes this when the baked solids that call it are next cooked again, so they aren't
/// cooked again for it alone.)
pub fn value_noise_box_near(p: vec3, half: vec3) -> f32 {
    let h = abs(half)
    let cell = floor(p)
    let f = p - cell
    let lo = floor(f - h)
    let n = floor(f + h) - lo + 2.0
    if !(max(n.x, max(n.y, n.z)) <= f32(MOST_BOX_SIDE)) {
        return 0.0
    }
    let (nx, ny, nz) = (
        min(u32(n.x), MOST_BOX_SIDE),
        min(u32(n.y), MOST_BOX_SIDE),
        min(u32(n.z), MOST_BOX_SIDE),
    )
    let (ix, iy, iz) = (
        lattice_coord(cell.x).wrapping_add(lattice_coord(lo.x)),
        lattice_coord(cell.y).wrapping_add(lattice_coord(lo.y)),
        lattice_coord(cell.z).wrapping_add(lattice_coord(lo.z)),
    )
    let local = f - lo
    var s = 0.0
    for k in 0..nz {
        let wz = box_weight(local.z, h.z, f32(k))
        if wz != 0.0 {
            for j in 0..ny {
                let wyz = wz * box_weight(local.y, h.y, f32(j))
                if wyz != 0.0 {
                    for i in 0..nx {
                        let w = wyz * box_weight(local.x, h.x, f32(i))
                        let v = lattice(
                            ix.wrapping_add(i32(i)),
                            iy.wrapping_add(i32(j)),
                            iz.wrapping_add(i32(k)),
                        )
                        s += w * v
                    }
                }
            }
        }
    }
    s
}

/// The most lattice points `value_noise_box_near` reads on an axis.
pub const MOST_BOX_SIDE: u32 = 8

/// The most octaves a fractal noise sums (16: 2^16 times its frequency, past what an f32 point
/// resolves): its loop's bound, so GPU code that reads a noise's octaves from a value has one.
pub const FBM_OCTAVES: u32 = 16

/// Fractal noise: `octaves` layers of value noise (at most `FBM_OCTAVES`), each at twice the
/// frequency and half the amplitude of the last, sampled at `p + offset`.
pub struct Fbm: Copy + GpuData + Eq + StateHash {
    pub freq: f32,
    pub octaves: u32,
    pub offset: vec3,
}

/// Fractal noise at base frequency `freq`, with `octaves` layers, sampled at `p + offset`.
pub fn fbm(freq: f32, octaves: u32, offset: vec3 = vec3()) -> Fbm {
    Fbm { freq, octaves, offset }
}

impl Noise for Fbm {
    fn value(self, p: vec3) -> f32 {
        let q = p + self.offset
        var s = 0.0
        var a = 1.0
        var fr = self.freq
        for o in 0..min(self.octaves, FBM_OCTAVES) {
            s += a * value_noise(q * fr + f32(o) * 17.0)
            a *= 0.5
            fr *= 2.0
        }
        s
    }

    /// The sum of the octaves' amplitudes, each way: 2 − 2^(1 − octaves).
    /// Closed form, rather than a loop over the octaves: every invocation that bounds a
    /// displaced surface computes it, alike (§18.13), and a loop's passes have no bound here.
    fn range(self) -> Interval {
        let r = 2.0 - exp2(1.0 - f32(self.octaves))
        Interval { lo: -r, hi: r }
    }

    /// Each octave's gradient is at most its amplitude times its frequency (which is `freq`
    /// for every octave) times value noise's bound.
    fn lipschitz(self) -> f32 {
        f32(self.octaves) * abs(self.freq) * VALUE_NOISE_LIPSCHITZ
    }

    /// The finest octave's lattice frequency.
    fn bandlimit(self) -> f32 {
        if self.octaves == 0 { 0.0 } else { abs(self.freq) * exp2(f32(self.octaves - 1)) }
    }

    /// Each octave by its size against the footprint: sampled where its cells are 16 or more
    /// footprints across, averaged over the footprint exactly (`value_noise_box`) where they're
    /// down to a quarter of one, and its mean, 0, where they're finer still.
    fn filtered(self, p: vec3, footprint: vec3) -> f32 {
        let q = p + self.offset
        var s = 0.0
        var a = 1.0
        var fr = self.freq
        for o in 0..min(self.octaves, FBM_OCTAVES) {
            let half = abs(footprint) * (0.5 * abs(fr))
            let r = 2.0 * max(half.x, max(half.y, half.z))
            let at = q * fr + f32(o) * 17.0
            if r < 0.0625 {
                s += a * value_noise(at)
            } else if r <= 4.0 {
                s += a * value_noise_box(at, half)
            }
            a *= 0.5
            fr *= 2.0
        }
        s
    }
}

/// A bound on value noise's gradient: the quintic fade's slope is at most 30/16, the lattice
/// values differ by at most 2, so each component is at most 3.75, and the length at most
/// 3.75 √3 (with room for rounding).
pub const VALUE_NOISE_LIPSCHITZ: f32 = 6.5

// ---- Lipschitz bounds ---------------------------------------------------------------------------

/// A surface divided by its Lipschitz bound: `.to_bound(near)`.
pub struct ToBound<S>: Copy + GpuData + Eq + StateHash {
    pub inner: S,
    pub near: f32,
    pub scale: f32,
}

impl<S: Surface> Surface for ToBound<S> {
    const EXACT_MEETS: bool = S::EXACT_MEETS
    const EXACT_PASSES: bool = S::EXACT_PASSES

    fn distance(self, p: vec3) -> f32 {
        clamp(self.inner.distance(p), -self.near, self.near) * self.scale
    }

    /// The inner surface's, clamped and scaled as its distance is.
    fn passes(self, o: vec3, d: vec3) -> Pass {
        let p = self.inner.passes(o, d)
        let f = |x: f32| clamp(x, -self.near, self.near) * self.scale
        Pass { distance: f(p.distance), low: f(p.low), high: f(p.high), ..p }
    }

    /// The inner surface's, where `grow` is within `near` in its units; past that, every point.
    fn meets_grown(self, o: vec3, d: vec3, grow: f32, inner: f32) -> Meets {
        let g = grow / self.scale
        if g < self.near { self.inner.meets_grown(o, d, g, inner / self.scale) } else { EVERYWHERE.ahead() }
    }

    fn masked(self, p: vec3, live: Live, first: u32) -> f32 {
        clamp(self.inner.masked(p, live, first), -self.near, self.near) * self.scale
    }

    /// Of one part, its whole masked ask, this surface's own code included; else its inner
    /// surface's part's.
    fn part_work(self, i: u32) -> u32 {
        if self.parts() == 1 { masked_work(self) } else { self.inner.part_work(i) }
    }

    fn pruned<F: Copy + fn(vec3) -> vec3>(self, over: Box3, at: F, stretch: f32, live: Live, first: u32) -> Pruned {
        let r = self.inner.pruned(over, at, stretch, live, first)
        let lo = clamp(r.range.lo, -self.near, self.near) * self.scale
        let hi = clamp(r.range.hi, -self.near, self.near) * self.scale
        Pruned { live: r.live, range: Interval { lo: min(lo, hi), hi: max(lo, hi) } }
    }

    /// Unbounded: held within ±`near`, its distance stops growing, which no sphere's bound
    /// (growing without end) holds. Cull by the surface it bounds (`inner.bound()`).
    fn bound(self) -> Bound {
        UNBOUNDED
    }

    fn filtered(self, p: vec3, footprint: f32) -> f32 {
        clamp(self.inner.filtered(p, footprint), -self.near, self.near) * self.scale
    }

    fn part_offset(self, p: vec3, i: u32, by: f32) -> f32 {
        clamp(self.inner.part_offset(p, i, by / self.scale), -self.near, self.near) * self.scale
    }

    fn parts(self) -> u32 {
        self.inner.parts()
    }

    fn part_at(self, p: vec3) -> (f32, u32) {
        let (d, i) = self.inner.part_at(p)
        (clamp(d, -self.near, self.near) * self.scale, i)
    }

    fn part_distance(self, p: vec3, i: u32) -> f32 {
        clamp(self.inner.part_distance(p, i), -self.near, self.near) * self.scale
    }

    fn part_name(self, i: u32) -> PartName {
        self.inner.part_name(i)
    }

    fn lipschitz(self, near: f32) -> f32 {
        1.0
    }
}

impl<C, S: Field<C>> Field<C> for ToBound<S> {
    fn channels(self, p: vec3) -> C {
        self.inner.channels(p)
    }

    fn distance_and_channels(self, p: vec3) -> (f32, C) {
        let (d, c) = self.inner.distance_and_channels(p)
        (clamp(d, -self.near, self.near) * self.scale, c)
    }
}

/// A debug build's check of a stated bound (§14): over the boxes in [-16, 16]³ where the
/// distance can be within ±`near`, refined to boxes about `near` wide, the derived gradient's
/// interval must allow a gradient no longer than `l`. A box whose every gradient is longer
/// panics: `l` understates the gradient there. (A box can only prove a bound wrong, not right,
/// so a bound that's wrong only between the boxes' samples can pass.)
pub fn check_lipschitz<S: Surface>(s: S, near: f32, l: f32) {
    var stack: Vec<Box3> = Vec::new()
    stack.push(Box3 { lo: vec3(-16.0), hi: vec3(16.0) })
    var visited = 0
    while stack.len() > 0 && visited < 20000 {
        visited += 1
        let b = stack.pop().unwrap()
        let d = interval(|q| s.distance(q), b)
        if d.lo >= near || d.hi <= -near {
            continue
        }
        let size = b.hi.x - b.lo.x
        if size > max(near, 1.0 / 64.0) {
            let mid = (b.lo + b.hi) * 0.5
            for i in 0..8 {
                let lo = vec3(
                    if i & 1 == 0 { b.lo.x } else { mid.x },
                    if i & 2 == 0 { b.lo.y } else { mid.y },
                    if i & 4 == 0 { b.lo.z } else { mid.z },
                )
                stack.push(Box3 { lo, hi: lo + (mid - b.lo) })
            }
            continue
        }
        let gx = interval(|q| gradient(|r| s.distance(r), q).x, b)
        let gy = interval(|q| gradient(|r| s.distance(r), q).y, b)
        let gz = interval(|q| gradient(|r| s.distance(r), q).z, b)
        let least = vec3(least_abs(gx), least_abs(gy), least_abs(gz))
        let g = length(least)
        if g > l * 1.001 + 1.0e-6 {
            panic(
                f"a Lipschitz bound of {l} for |distance| < {near} is too small: the derived gradient is at least {g} over the box from ({b.lo.x}, {b.lo.y}, {b.lo.z}) to ({b.hi.x}, {b.hi.y}, {b.hi.z})",
            )
        }
    }
}

/// A debug build's check of a stated bound (`Surface::bound`): over the boxes round the
/// bound's sphere (out to twice its radius and a unit more), refined where the derived interval
/// can't settle it to boxes about a 32nd of its radius wide, a box whose every distance (the derived interval) is below the least the bound
/// allows anywhere in the box panics: the bound claims more room than the surface leaves. (As
/// `check_lipschitz`, a box can only prove a bound wrong, not right.)
pub fn check_bound<S: Surface>(s: S, b: Bound) {
    match bound_broken(s, b) {
        Some((x, most, least)) => panic(
            f"a bound of radius {b.radius} round ({b.centre.x}, {b.centre.y}, {b.centre.z}) is too large: the distance is at most {most} over the box from ({x.lo.x}, {x.lo.y}, {x.lo.z}) to ({x.hi.x}, {x.hi.y}, {x.hi.z}), where the bound says at least {least}",
        ),
        None => {},
    }
}

/// `check_bound`'s search: a box that proves `b` wrong, the most distance there and the least
/// the bound allows, if it finds one.
pub fn bound_broken<S: Surface>(s: S, b: Bound) -> Option<(Box3, f32, f32)> {
    if b.radius >= 1.0e30 {
        return None
    }
    let reach = 2.0 * b.radius + 1.0
    let fine = max(b.radius / 32.0, 1.0 / 64.0)
    var stack: Vec<Box3> = Vec::new()
    stack.push(Box3 { lo: b.centre - vec3(reach), hi: b.centre + vec3(reach) })
    var visited = 0
    while stack.len() > 0 && visited < 20000 {
        visited += 1
        let x = stack.pop().unwrap()
        // The box's nearest and farthest points from the bound's centre.
        let nearest = length(clamp(b.centre, x.lo, x.hi) - b.centre)
        let farthest = length(max(abs(x.lo - b.centre), abs(x.hi - b.centre)))
        if farthest <= b.radius {
            continue
        }
        if nearest > b.radius {
            let least = b.slope * (nearest - b.radius)
            let room = 1.0e-4 * (1.0 + abs(least))
            let d = s.interval(x)
            // Every distance in the box is at least the bound's: it holds there.
            if d.lo >= least - room {
                continue
            }
            if d.hi < least - room {
                return Some((x, d.hi, least))
            }
        }
        if x.hi.x - x.lo.x > fine {
            let mid = (x.lo + x.hi) * 0.5
            for i in 0..8 {
                let lo = vec3(
                    if i & 1 == 0 { x.lo.x } else { mid.x },
                    if i & 2 == 0 { x.lo.y } else { mid.y },
                    if i & 4 == 0 { x.lo.z } else { mid.z },
                )
                stack.push(Box3 { lo, hi: lo + (mid - x.lo) })
            }
        }
    }
    None
}

/// The least |x| for x in `i`.
fn least_abs(i: Interval) -> f32 {
    if i.lo > 0.0 { i.lo } else if i.hi < 0.0 { -i.hi } else { 0.0 }
}

// ---- channels -----------------------------------------------------------------------------------

/// A surface whose points carry channels `C` besides their distance: what a point knows
/// about itself, such as its colour or its density. `.with(...)` and `.with_at(...)` give a
/// surface channels, and the combinators blend them where they blend the surfaces.
pub trait Field<C>: Surface {
    /// The channels at `p`.
    fn channels(self, p: vec3) -> C

    /// The distance and the channels at `p` together, with each part of the field evaluated
    /// once: std's combinators blend their parts' channels by their distances, so they compute
    /// both here, and their `channels` is this one's second half. The distance is the same as
    /// `distance(p)`, bit for bit.
    fn distance_and_channels(self, p: vec3) -> (f32, C) {
        (self.distance(p), self.channels(p))
    }
}

/// How channels mix where surfaces blend. A channel struct declares it and gets it field by
/// field, so each member's type decides how it mixes.
@fieldwise
pub trait Blend {
    /// `self` where `t` is 0, `other` where it's 1, and a mix between.
    fn blend(self, other: Self, t: f32) -> Self
}

impl Blend for f32 {
    fn blend(self, other: f32, t: f32) -> f32 {
        mix(self, other, t)
    }
}

impl Blend for vec2 {
    fn blend(self, other: vec2, t: f32) -> vec2 {
        mix(self, other, vec2(t))
    }
}

impl Blend for vec3 {
    fn blend(self, other: vec3, t: f32) -> vec3 {
        mix(self, other, vec3(t))
    }
}

impl Blend for vec4 {
    fn blend(self, other: vec4, t: f32) -> vec4 {
        mix(self, other, vec4(t))
    }
}

impl Blend for Quat {
    fn blend(self, other: Quat, t: f32) -> Quat {
        self.nlerp(other, t)
    }
}

/// A colour in linear RGB, which blends linearly.
pub struct Color: Copy + GpuData + Blend + StateHash {
    pub r: f32,
    pub g: f32,
    pub b: f32,
}

/// A colour from linear RGB.
pub fn rgb(r: f32, g: f32, b: f32) -> Color {
    Color { r, g, b }
}

/// A direction, which blends along the sphere: mixed, then made unit length again.
pub struct UnitVec3: Copy + GpuData + StateHash {
    pub v: vec3,
}

/// `v`'s direction.
pub fn unit_vec3(v: vec3) -> UnitVec3 {
    UnitVec3 { v: normalize(v) }
}

impl Blend for UnitVec3 {
    fn blend(self, other: UnitVec3, t: f32) -> UnitVec3 {
        let m = mix(self.v, other.v, vec3(t))
        // Opposite directions mixed half and half cancel: keep the nearer one.
        if dot(m, m) < 1.0e-12 {
            if t < 0.5 { self } else { other }
        } else {
            UnitVec3 { v: normalize(m) }
        }
    }
}

/// A categorical channel, such as a material: never averaged, but taken whole from whichever
/// surface weighs more where two blend.
pub struct Cat<T>: Copy + GpuData + StateHash {
    pub value: T,
}

/// `value` as a categorical channel.
pub fn cat<T: Copy>(value: T) -> Cat<T> {
    Cat { value }
}

impl<T: Copy> Blend for Cat<T> {
    fn blend(self, other: Cat<T>, t: f32) -> Cat<T> {
        if t <= 0.5 { self } else { other }
    }
}

/// A surface whose points all carry the channels `value`: `.with(...)`.
pub struct With<S, C>: Copy + GpuData + Eq + StateHash {
    pub inner: S,
    pub value: C,
}

impl<S: Surface, C: Copy + GpuData> Surface for With<S, C> {
    fn part_bound(self, i: u32) -> PartBound {
        self.inner.part_bound(i)
    }

    const EXACT_MEETS: bool = S::EXACT_MEETS
    const EXACT_PASSES: bool = S::EXACT_PASSES

    fn distance(self, p: vec3) -> f32 {
        self.inner.distance(p)
    }

    fn passes(self, o: vec3, d: vec3) -> Pass {
        self.inner.passes(o, d)
    }

    fn meets_grown(self, o: vec3, d: vec3, grow: f32, inner: f32) -> Meets {
        self.inner.meets_grown(o, d, grow, inner)
    }

    fn masked(self, p: vec3, live: Live, first: u32) -> f32 {
        self.inner.masked(p, live, first)
    }

    /// Of one part, its whole masked ask, this surface's own code included; else its inner
    /// surface's part's.
    fn part_work(self, i: u32) -> u32 {
        if self.parts() == 1 { masked_work(self) } else { self.inner.part_work(i) }
    }

    fn pruned<F: Copy + fn(vec3) -> vec3>(self, over: Box3, at: F, stretch: f32, live: Live, first: u32) -> Pruned {
        self.inner.pruned(over, at, stretch, live, first)
    }

    fn bound(self) -> Bound {
        self.inner.bound()
    }

    fn filtered(self, p: vec3, footprint: f32) -> f32 {
        self.inner.filtered(p, footprint)
    }

    fn part_offset(self, p: vec3, i: u32, by: f32) -> f32 {
        self.inner.part_offset(p, i, by)
    }

    fn parts(self) -> u32 {
        self.inner.parts()
    }

    fn part_at(self, p: vec3) -> (f32, u32) {
        self.inner.part_at(p)
    }

    fn part_distance(self, p: vec3, i: u32) -> f32 {
        self.inner.part_distance(p, i)
    }

    fn part_name(self, i: u32) -> PartName {
        self.inner.part_name(i)
    }

    fn lipschitz(self, near: f32) -> f32 {
        self.inner.lipschitz(near)
    }

    fn interval_near(self, b: Box3) -> Interval {
        self.inner.interval_near(b)
    }
}

impl<S: Surface, C: Copy + GpuData> Field<C> for With<S, C> {
    fn channels(self, p: vec3) -> C {
        self.value
    }

    fn distance_and_channels(self, p: vec3) -> (f32, C) {
        (self.inner.distance(p), self.value)
    }
}

/// A surface whose channels a function computes at each point: `.with_at(...)`.
pub struct WithAt<S, F>: Copy + GpuData + Eq + StateHash {
    pub inner: S,
    pub at: F,
}

impl<S: Surface, F: Copy + GpuData> Surface for WithAt<S, F> {
    const EXACT_MEETS: bool = S::EXACT_MEETS
    const EXACT_PASSES: bool = S::EXACT_PASSES

    fn distance(self, p: vec3) -> f32 {
        self.inner.distance(p)
    }

    fn passes(self, o: vec3, d: vec3) -> Pass {
        self.inner.passes(o, d)
    }

    fn meets_grown(self, o: vec3, d: vec3, grow: f32, inner: f32) -> Meets {
        self.inner.meets_grown(o, d, grow, inner)
    }

    fn masked(self, p: vec3, live: Live, first: u32) -> f32 {
        self.inner.masked(p, live, first)
    }

    /// Of one part, its whole masked ask, this surface's own code included; else its inner
    /// surface's part's.
    fn part_work(self, i: u32) -> u32 {
        if self.parts() == 1 { masked_work(self) } else { self.inner.part_work(i) }
    }

    fn pruned<G: Copy + fn(vec3) -> vec3>(self, over: Box3, at: G, stretch: f32, live: Live, first: u32) -> Pruned {
        self.inner.pruned(over, at, stretch, live, first)
    }

    fn bound(self) -> Bound {
        self.inner.bound()
    }

    fn filtered(self, p: vec3, footprint: f32) -> f32 {
        self.inner.filtered(p, footprint)
    }

    fn part_offset(self, p: vec3, i: u32, by: f32) -> f32 {
        self.inner.part_offset(p, i, by)
    }

    fn parts(self) -> u32 {
        self.inner.parts()
    }

    fn part_at(self, p: vec3) -> (f32, u32) {
        self.inner.part_at(p)
    }

    fn part_distance(self, p: vec3, i: u32) -> f32 {
        self.inner.part_distance(p, i)
    }

    fn part_name(self, i: u32) -> PartName {
        self.inner.part_name(i)
    }

    fn lipschitz(self, near: f32) -> f32 {
        self.inner.lipschitz(near)
    }

    fn interval_near(self, b: Box3) -> Interval {
        self.inner.interval_near(b)
    }
}

impl<S: Surface, C, F: Copy + GpuData + fn(vec3) -> C> Field<C> for WithAt<S, F> {
    fn channels(self, p: vec3) -> C {
        (self.at)(p)
    }
}

/// How much of `b` a smooth union of distances `a` and `b` takes, from 0 to 1: the weight
/// `smin`'s gradient gives `b`'s, which a field's channels blend by too.
pub fn smin_weight(a: f32, b: f32, k: f32) -> f32 {
    let m = max(k - select(if_false: abs(a - b), if_true: 0.0, cond: a == b), 0.0)
    let w = m * (0.5 / max(k, 1.1754944e-38))
    if a < b { w } else { 1.0 - w }
}

/// `smin(a, b, k)` and `smin_weight(a, b, k)` at once: the two share `max(k - |a - b|, 0)`.
/// The same numbers as theirs, bit for bit: for `k` up to 2^124, `0.5 / k` is exactly twice
/// `0.25 / k`.
pub fn smin_and_weight(a: f32, b: f32, k: f32) -> (f32, f32) {
    let s = 0.25 / max(k, 1.1754944e-38)
    let d = b - a
    if d > 0.0 {
        let m = max(k - d, 0.0)
        (a - m * (m * s), m * (2.0 * s))
    } else {
        let m = max(k + select(if_false: d, if_true: 0.0, cond: d != d && a == a && b == b), 0.0)
        (b - m * (m * s), 1.0 - m * (2.0 * s))
    }
}

// The combinators evaluate each part once, for its distance and its channels together: asking
// each part for its channels after its distance would evaluate a chain of n blended parts
// O(n²) times.

impl<C: Blend, A: Field<C>, B: Field<C>> Field<C> for Union<A, B> {
    fn channels(self, p: vec3) -> C {
        self.distance_and_channels(p).1
    }

    /// The nearer part's channels; a tie takes `a`'s.
    fn distance_and_channels(self, p: vec3) -> (f32, C) {
        let (da, ca) = self.a.distance_and_channels(p)
        let (db, cb) = self.b.distance_and_channels(p)
        (min(da, db), if da <= db { ca } else { cb })
    }
}

impl<C: Blend, A: Field<C>, B: Field<C>> Field<C> for SmoothUnion<A, B> {
    fn channels(self, p: vec3) -> C {
        self.distance_and_channels(p).1
    }

    /// The parts' channels blended by `smin_weight`.
    fn distance_and_channels(self, p: vec3) -> (f32, C) {
        let (da, ca) = self.a.distance_and_channels(p)
        let (db, cb) = self.b.distance_and_channels(p)
        let (d, w) = smin_and_weight(da, db, self.k)
        (d, ca.blend(cb, w))
    }
}

impl<C: Blend, A: Field<C>, B: Field<C>> Field<C> for Intersect<A, B> {
    fn channels(self, p: vec3) -> C {
        self.distance_and_channels(p).1
    }

    /// The farther part's channels; a tie takes `a`'s.
    fn distance_and_channels(self, p: vec3) -> (f32, C) {
        let (da, ca) = self.a.distance_and_channels(p)
        let (db, cb) = self.b.distance_and_channels(p)
        (max(da, db), if da >= db { ca } else { cb })
    }
}

impl<C, S: Field<C>, M: PointMap> Field<C> for Warp<S, M> {
    fn channels(self, p: vec3) -> C {
        self.inner.channels(self.map.local(p))
    }

    fn distance_and_channels(self, p: vec3) -> (f32, C) {
        let (d, c) = self.inner.distance_and_channels(self.map.local(p))
        (self.map.distance_out(d), c)
    }
}

impl<C, S: Field<C>, N: Noise> Field<C> for Displace<S, N> {
    fn channels(self, p: vec3) -> C {
        self.inner.channels(p)
    }

    fn distance_and_channels(self, p: vec3) -> (f32, C) {
        let (d, c) = self.inner.distance_and_channels(p)
        (d + self.amp * self.noise.value(p), c)
    }
}

/// The nearest part's channels; a tie takes the earlier part's, as `a.union(b)` does. A union
/// of no parts has no channels: asking for them indexes past the end (§11).
impl<C: Blend, S: Field<C>, const N: u32> Field<C> for UnionAll<S, N> {
    fn channels(self, p: vec3) -> C {
        self.distance_and_channels(p).1
    }

    fn distance_and_channels(self, p: vec3) -> (f32, C) {
        let (d0, c0) = self.parts[0].distance_and_channels(p)
        // The same `min`s, in the same order, as `distance`.
        var d = min(EMPTY, d0)
        var c = take c0
        for i in 1..N {
            let (di, ci) = self.parts[i].distance_and_channels(p)
            if di < d {
                c = take ci
            }
            d = min(d, di)
        }
        (d, c)
    }
}

/// The parts' channels blended in order, each by `smin_weight`, as `a.smooth_union(b, k)
/// .smooth_union(c, k)` blends them. A union of no parts has no channels: asking for them
/// indexes past the end (§11).
impl<C: Blend, S: Field<C>, const N: u32> Field<C> for SmoothUnionAll<S, N> {
    fn channels(self, p: vec3) -> C {
        self.distance_and_channels(p).1
    }

    fn distance_and_channels(self, p: vec3) -> (f32, C) {
        let (d0, c0) = self.parts[0].distance_and_channels(p)
        var d = d0
        var c = take c0
        for i in 1..N {
            let (di, ci) = self.parts[i].distance_and_channels(p)
            let (dn, w) = smin_and_weight(d, di, self.k)
            c = c.blend(ci, w)
            d = dn
        }
        (d, c)
    }
}

/// `a`'s channels: the cut takes away, and its face is `a`'s.
impl<C, A: Field<C>, B: Surface> Field<C> for SmoothSubtract<A, B> {
    fn channels(self, p: vec3) -> C {
        self.a.channels(p)
    }

    fn distance_and_channels(self, p: vec3) -> (f32, C) {
        let (da, ca) = self.a.distance_and_channels(p)
        (smax(da, -self.b.distance(p), self.k), ca)
    }
}

/// The operands' channels blended as the smooth maximum weighs them.
impl<C: Blend, A: Field<C>, B: Field<C>> Field<C> for SmoothIntersect<A, B> {
    fn channels(self, p: vec3) -> C {
        self.distance_and_channels(p).1
    }

    fn distance_and_channels(self, p: vec3) -> (f32, C) {
        let (da, ca) = self.a.distance_and_channels(p)
        let (db, cb) = self.b.distance_and_channels(p)
        (smax(da, db, self.k), ca.blend(cb, smin_weight(-da, -db, self.k)))
    }
}

impl<C, S: Field<C>> Field<C> for Mirror<S> {
    fn channels(self, p: vec3) -> C {
        self.inner.channels(mirrored(p))
    }

    fn distance_and_channels(self, p: vec3) -> (f32, C) {
        self.inner.distance_and_channels(mirrored(p))
    }
}

impl<C, S: Field<C>> Field<C> for Named<S> {
    fn channels(self, p: vec3) -> C {
        self.inner.channels(p)
    }

    fn distance_and_channels(self, p: vec3) -> (f32, C) {
        self.inner.distance_and_channels(p)
    }
}

// ---- tests (the suite runs std's: `std_tests_pass`) --------------------------------------------

@test
fn a_hit_can_start_inside_the_surface() {
    let t = hit(sphere(1.0), vec3(), vec3(1.0, 0.0, 0.0))
    assert(abs(t - 1.0) < 0.0001)
}

@test
fn a_negative_scale_keeps_inside_negative() {
    let s = sphere(0.5).translate(vec3(1.0, 0.0, 0.0)).scale(-2.0)
    assert(abs(s.distance(vec3(-2.0, 0.0, 0.0)) + 1.0) < 0.00001)
    assert(abs(s.distance(vec3(0.0, 0.0, 0.0)) - 1.0) < 0.00001)
}

/// A blob of every primitive, smooth-unioned, and displaced by noise: what std's field tests
/// check.
fn test_blob() -> Surface {
    let body = ellipsoid(vec3(1.0, 0.6, 0.8))
    let limb = round_cone(vec3(0.5, -0.2, 0.0), vec3(1.4, 0.6, 0.2), r_top: 0.15, r_bottom: 0.3)
    let block = cuboid(vec3(0.3)).translate(vec3(-0.9, 0.4, 0.1))
    body.smooth_union(limb, k: 0.2).smooth_union(block, k: 0.1).displace(fbm(4.0, 3), amp: 0.01)
}

/// A test surface whose distance falls 100 times as fast past -1. It has one surface, at x = 0,
/// so its Lipschitz bound is 1 within one unit of that surface and 100 any farther inside.
struct SteepInside: Copy + GpuData {}

impl Surface for SteepInside {
    fn distance(self, p: vec3) -> f32 {
        if p.x < -1.0 { 100.0 * (p.x + 1.0) - 1.0 } else { p.x }
    }

    /// Unbounded: a plane.
    fn bound(self) -> Bound {
        UNBOUNDED
    }

    fn lipschitz(self, near: f32) -> f32 {
        if near <= 1.0 { 1.0 } else { 100.0 }
    }
}

@test
fn derived_gradients_agree_with_finite_differences() {
    let f = test_blob()
    let b = Box3 { lo: vec3(-2.0), hi: vec3(2.0) }
    let h = 1.0e-3
    for i in 0..256 {
        let p = b.sample(1, i)
        let g = gradient(|q: vec3| f.distance(q), p)
        let dx = f.distance(p + vec3(x: h)) - f.distance(p - vec3(x: h))
        let dy = f.distance(p + vec3(y: h)) - f.distance(p - vec3(y: h))
        let dz = f.distance(p + vec3(z: h)) - f.distance(p - vec3(z: h))
        let off = length(g - vec3(dx, dy, dz) / (2.0 * h))
        assert(off < 0.02, f"at ({p.x}, {p.y}, {p.z})")
    }
}

@test
fn derived_intervals_enclose_the_distances_in_their_boxes() {
    let f = test_blob()
    let space = Box3 { lo: vec3(-2.0), hi: vec3(2.0) }
    for i in 0..64 {
        let c = space.sample(2, i)
        let b = Box3 { lo: c - vec3(0.1), hi: c + vec3(0.1) }
        let r = interval(|q: vec3| f.distance(q), b)
        for j in 0..16 {
            let d = f.distance(b.sample(3, j))
            assert(r.lo <= d && d <= r.hi, f"a box at ({c.x}, {c.y}, {c.z})")
        }
    }
}

@test
fn narrowed_intervals_enclose_the_distances_and_narrow_the_derived() {
    let blob = test_blob().translate(vec3(0.1, 0.0, 0.0))
    let plain = round_cone(vec3(0.5, -0.2, 0.0), vec3(1.4, 0.6, 0.2), r_top: 0.15, r_bottom: 0.3)
    let space = Box3 { lo: vec3(-2.0), hi: vec3(2.0) }
    var narrower = 0
    for i in 0..64 {
        let c = space.sample(6, i)
        let b = Box3 { lo: c - vec3(0.1), hi: c + vec3(0.1) }
        let r = blob.interval_near(b)
        let s = plain.interval_near(b)
        for j in 0..16 {
            let p = b.sample(7, j)
            let d = blob.distance(p)
            assert(r.lo <= d && d <= r.hi, f"the blob, a box at ({c.x}, {c.y}, {c.z})")
            let e = plain.distance(p)
            assert(s.lo <= e && e <= s.hi, f"the plain blob, a box at ({c.x}, {c.y}, {c.z})")
        }
        // A round cone's derived interval is loose; its distance at the centre, which changes
        // by at most 1 a unit, narrows it.
        let x = interval(|q: vec3| plain.distance(q), b)
        if s.hi - s.lo < 0.9 * (x.hi - x.lo) {
            narrower += 1
        }
    }
    assert(narrower > 8, f"only {narrower} of 64 boxes narrowed")
}

/// A body like the engine's creature: seventeen round cones in a smooth fold, a wand joined to
/// them, the whole moved: eighteen parts.
fn parted_body() -> Warp<SmoothUnion<SmoothUnionAll<RoundCone, 17>, RoundCone>, Shift> {
    var parts = [round_cone(vec3(), vec3(0.0, 1.0, 0.0), r_top: 0.05, r_bottom: 0.1); 17]
    for i in 0..17 {
        let a = f32(i) * 0.37
        parts[i] = round_cone(
            vec3(0.12 * cos(a), 0.06 * f32(i), 0.12 * sin(a)),
            vec3(0.25 * cos(a), 0.06 * f32(i) + 0.12, 0.25 * sin(a)),
            r_top: 0.03,
            r_bottom: 0.045,
        )
    }
    let wand = round_cone(vec3(-0.42, 0.87, -0.04), vec3(-0.5, 1.05, 0.26), r_top: 0.005, r_bottom: 0.005)
    parts.smooth_union(k: 0.03).smooth_union(wand, k: 0.004).translate(vec3(1.0, 0.0, -2.0))
}

/// The box sides `range`'s soundness is checked at: a metre, the engine's middle level, and
/// the two finest a march asks.
const RANGE_SIDES: [f32; 4] = [1.0, 0.12, 0.008, 0.001]

/// Checks `range`'s distance range on `s` over boxes of each of `RANGE_SIDES` centred on
/// `s`'s surface (points of space walked onto it by two Newton steps): every box's corners and
/// 56 more samples are inside it, and it is never wider than the plain interval. How many of the
/// 48 boxes 8 mm and smaller it is within a quarter again of the samples' own spread on.
fn affine_holds<S: Surface>(s: S, space: Box3, name: Text) -> u32 {
    var narrower = 0
    for side in RANGE_SIDES {
        for i in 0..24 {
            var c = space.sample(11, i)
            for step in 0..2 {
                let (d, g) = value_and_gradient(|q: vec3| s.distance(q), c)
                c = c - g * (d / max(dot(g, g), 1.0e-6))
            }
            let b = Box3 { lo: c - vec3(0.5 * side), hi: c + vec3(0.5 * side) }
            let r = s.range(b).value
            let x = interval(|q: vec3| s.distance(q), b)
            assert(x.lo <= r.lo && r.hi <= x.hi, f"{name}: wider than the interval, side {side}")
            var least = 1.0e30
            var most = -1.0e30
            for j in 0..64 {
                let p = if j < 8 {
                    vec3(
                        if (j & 1) == 0 { b.lo.x } else { b.hi.x },
                        if (j & 2) == 0 { b.lo.y } else { b.hi.y },
                        if (j & 4) == 0 { b.lo.z } else { b.hi.z },
                    )
                } else {
                    b.sample(13, j + 64 * i)
                }
                let d = s.distance(p)
                least = min(least, d)
                most = max(most, d)
                assert(
                    r.lo <= d && d <= r.hi,
                    f"{name}: {d} outside [{r.lo}, {r.hi}], side {side}, at ({p.x}, {p.y}, {p.z})",
                )
            }
            if side < 0.01 && r.hi - r.lo <= 1.25 * (most - least) {
                narrower += 1
            }
        }
    }
    narrower
}

/// `range`'s distance range, the affine form intersected with the interval, holds every sample
/// of its box for each std kind alone and for the blob and the body, at every side; and on the
/// smooth kinds, at 8 mm and 1 mm, it is within a quarter again of the samples' spread on most
/// boxes (where the round cone's plain interval is not).
@test
fn affine_ranges_hold_every_sample_for_each_kind() {
    let space = Box3 { lo: vec3(-1.0), hi: vec3(1.0) }
    let q = Quat::axis_angle(normalize(vec3(1.0, 2.0, 0.5)), 0.7)
    let cone = round_cone(vec3(-0.6, -0.3, 0.1), vec3(0.1, 0.4, -0.2), r_top: 0.15, r_bottom: 0.35)
    let box = cuboid(vec3(0.4, 0.3, 0.2))
    let egg = ellipsoid(vec3(0.3, 0.5, 0.4))
    let n_sphere = affine_holds(sphere(0.6), space, "sphere")
    let n_egg = affine_holds(egg, space, "ellipsoid")
    let n_cone = affine_holds(cone, space, "round cone")
    affine_holds(box, space, "cuboid")
    affine_holds(half_space(normalize(vec3(0.1, 1.0, 0.05)), 0.7), space, "half space")
    affine_holds(sphere(0.6).translate(vec3(0.5, 0.0, 0.0)), space, "translate")
    affine_holds(box.rotate(q), space, "rotate")
    affine_holds(egg.scale(1.5), space, "scale")
    affine_holds(sphere(0.6).union(cone), space, "union")
    affine_holds(box.intersect(sphere(0.45)), space, "intersect")
    let n_smooth = affine_holds(sphere(0.6).smooth_union(cone, k: 0.3), space, "smooth union")
    affine_holds(cone.smooth_subtract(box, k: 0.1), space, "smooth subtract")
    affine_holds(egg.smooth_intersect(sphere(0.4), k: 0.05), space, "smooth intersect")
    let n_noise = affine_holds(sphere(0.6).displace(fbm(4.0, 3), amp: 0.02), space, "displace")
    affine_holds(test_blob(), space, "the blob")
    let body = parted_body()
    let bb = body.bound()
    let near = Box3 { lo: bb.centre - vec3(bb.radius), hi: bb.centre + vec3(bb.radius) }
    affine_holds(body, near, "the body")
    for (n, name) in [(n_sphere, "sphere"), (n_egg, "ellipsoid"), (n_cone, "round cone"), (n_smooth, "smooth union"), (n_noise, "displace")] {
        assert(n >= 36, f"{name}: only {n} of 48 small boxes as tight as their samples")
    }
}

/// Along a segment, the parts it can come near (`live_along`) give a distance never below the
/// whole's, and the whole's wherever the surface can be; and a segment that passes far from the
/// body leaves every part out.
@test
fn a_segments_live_parts_give_its_distance_where_the_surface_can_be() {
    let s = parted_body()
    let b = s.bound()
    let around = Box3 { lo: b.centre - vec3(b.radius * 1.5), hi: b.centre + vec3(b.radius * 1.5) }
    var kept = 0
    var near = 0
    for i in 0..300 {
        // Through the body's middle, give or take a third of its size, so many points are near.
        let a = around.sample(5, i)
        let e = b.centre * 2.0 - a + (around.sample(7, i + 300) - b.centre) * 0.3
        let live = live_along(s, a, e, 0.0)
        kept += live.count(18)
        for k in 0..48 {
            let p = a + (e - a) * (f32(k) / 47.0)
            let d = s.distance(p)
            let dl = s.distance_live(p, live)
            assert(dl >= d - 1.0e-5 * (1.0 + abs(d)), f"below the distance at ({p.x}, {p.y}, {p.z}): {dl} < {d}")
            if d <= 0.002 {
                near += 1
                assert(abs(dl - d) <= 1.0e-5, f"not the distance near the surface: {dl} against {d}")
            }
        }
    }
    assert(near > 100, f"only {near} points near the surface")
    assert(kept < 300 * 18, "every segment kept every part")
    let far = live_along(s, b.centre + vec3(5.0 * b.radius, 0.0, 0.0), b.centre + vec3(5.0 * b.radius, 1.0, 0.0), 0.0)
    assert(far.count(18) == 0, "a far segment kept parts")
}

/// Each part's lowering is its joins' alone (here a fold of 17 at `k` 0.03, then a join at 0.004),
/// less than its reach; and every point inside the surface is within some part's `r + lowers` of
/// its segment, some only so (inside, but outside every part's own bound).
@test
fn the_surface_is_within_its_parts_lowering() {
    let s = parted_body()
    let cone = s.part_bound(3)
    let wand = s.part_bound(17)
    let fold = fold_lowering(17, 0.03) + 0.001
    assert(abs(cone.lowers - fold) <= 1.0e-6, f"a cone lowers by {cone.lowers}, not {fold}")
    assert(abs(wand.lowers - 0.001) <= 1.0e-6, f"the wand lowers by {wand.lowers}")
    assert(abs(cone.reach - (0.034 + fold)) <= 1.0e-6, f"a cone reaches {cone.reach}")
    // Points in the seams between neighbouring cones, where the fold lowers the distance most.
    var inside = 0
    var lowered = 0
    for i in 0..17 {
        let c = s.part_bound(i)
        let n = s.part_bound((i + 1) % 17)
        for u in 0..24 {
            for v in 0..24 {
                let t = f32(u) / 23.0
                let q = c.a + (c.b - c.a) * t
                let m = n.a + (n.b - n.a) * t
                let p = q + (m - q) * (0.2 + 0.6 * f32(v) / 23.0)
                if s.distance(p) > 0.0 {
                    continue
                }
                inside += 1
                var least = 1.0e9
                var own = 1.0e9
                for k in 0..18 {
                    let e = s.part_bound(k)
                    least = min(least, segments_apart(p, p, e.a, e.b) - e.r - e.lowers)
                    own = min(own, segments_apart(p, p, e.a, e.b) - e.r)
                }
                assert(least <= 1.0e-5, f"({p.x}, {p.y}, {p.z}) inside, {least} past every part's lowering")
                if own > 0.0 {
                    lowered += 1
                }
            }
        }
    }
    assert(inside > 200, f"only {inside} points inside")
    assert(lowered > 0, "no point inside needed a part's lowering")
}

/// The least of `s`'s distance along the ray `o + t d` for `t` in 0..`far` (`d` a unit vector),
/// found by a march of `n` even samples and then a golden-section search round the least of
/// them: what `passes` is checked against.
fn marched_pass<S: Surface>(s: S, o: vec3, d: vec3, far: f32, n: u32) -> Pass {
    let step = far / f32(n)
    var best = 0.0
    var least = EMPTY
    for i in 0..(n + 1) {
        let t = f32(i) * step
        let v = s.distance(o + d * t)
        if v < least {
            least = v
            best = t
        }
    }
    var a = max(best - step, 0.0)
    var b = best + step
    let g = 0.381966
    for i in 0..60 {
        let x = a + g * (b - a)
        let y = b - g * (b - a)
        if s.distance(o + d * x) < s.distance(o + d * y) { b = y } else { a = x }
    }
    let t = 0.5 * (a + b)
    let v = s.distance(o + d * t)
    if v < least { pass_at(t, v, 0) } else { pass_at(best, least, 0) }
}

/// The engine's stage's shapes and round cones (thin, fat, one holding the other, a cylinder),
/// each and joined sharply: `passes` is exact (within 1e-4 m of a fine march's least, never
/// farther by more than rounding) on rays from all round that pass near them, and says where the
/// ray meets it.
@test
fn passes_of_std_shapes_are_the_least_along_the_ray() {
    let ground = cuboid(vec3(8.0, 0.25, 8.0)).translate(vec3(0.0, -0.25, 0.0))
    let wall = cuboid(vec3(3.0, 1.5, 0.1)).translate(vec3(0.0, 1.5, 0.0))
    let ball = sphere(1.0).translate(vec3(-4.5, 1.0, 3.0))
    let cone = round_cone(vec3(1.0, 0.5, 2.0), vec3(1.6, 1.4, 2.3), r_top: 0.12, r_bottom: 0.03)
    let held = round_cone(vec3(-1.0, 0.5, 2.0), vec3(-1.02, 0.52, 2.0), r_top: 0.3, r_bottom: 0.05)
    let rod = round_cone(vec3(2.0, 0.3, -1.0), vec3(2.0, 1.8, -1.0), r_top: 0.04, r_bottom: 0.04)
    let stage = ground.union(wall).union(ball)
    let cones = cone.union(held).union(rod)
    let plane = half_space(vec3(0.1, 1.0, 0.05), 0.2)
    var near = 0
    var met = 0
    var worst = 0.0
    for i in 0..1200 {
        let k = i % 6
        // From 3 to 15 m away, toward a point near one of them.
        let from = Box3 { lo: vec3(-12.0, 0.5, -12.0), hi: vec3(12.0, 9.0, 12.0) }.sample(3, i)
        let target = if k == 0 { vec3(0.0, 1.5, 0.0) } else if k == 1 { vec3(-4.5, 1.0, 3.0) } else if k == 2 { vec3(1.3, 0.95, 2.15) } else if k == 3 { vec3(-1.0, 0.5, 2.0) } else if k == 4 { vec3(2.0, 1.0, -1.0) } else { vec3(0.0, 0.0, 0.0) }
        let jitter = (Box3 { lo: vec3(-1.0), hi: vec3(1.0) }.sample(5, i)) * (if k == 0 || k == 1 || k == 5 { 1.6 } else { 0.25 })
        let d = normalize(target + jitter - from)
        for c in 0..3 {
            let p = if c == 0 { stage.passes(from, d) } else if c == 1 { cones.passes(from, d) } else { plane.passes(from, d) }
            let m = if c == 0 { marched_pass(stage, from, d, 40.0, 4000) } else if c == 1 { marched_pass(cones, from, d, 40.0, 4000) } else { marched_pass(plane, from, d, 400.0, 4000) }
            assert(p.exact(), "a std shape's pass not exact")
            if c == 2 && p.meets() && p.t > 360.0 {
                // Past the march's reach: met where it crosses the plane.
                assert(abs(plane.distance(from + d * p.t)) <= 1.0e-3 * p.t, f"ray {i}: not on the plane at {p.t}")
            } else if m.distance <= 0.0 {
                met += 1
                assert(p.distance <= 1.0e-4, f"case {c} ray {i}: the march meets it, the pass is {p.distance} away")
                // As deep as the ray goes (a half-space: for ever, where it goes in).
                if c == 2 {
                    assert(p.distance <= m.distance + 1.0e-5 * (1.0 + abs(m.distance)), f"ray {i}: the plane's pass {p.distance} above the march's {m.distance}")
                } else {
                    assert(abs(p.distance - m.distance) <= 1.0e-4, f"case {c} ray {i}: in as deep as {p.distance}, the march {m.distance}")
                }
            } else {
                near += if m.distance < 0.05 { 1 } else { 0 }
                let off = p.distance - m.distance
                worst = max(worst, abs(off))
                assert(off <= 1.0e-5 * (1.0 + m.distance), f"case {c} ray {i}: the pass {p.distance} farther than the march's {m.distance}")
                assert(abs(off) <= 1.0e-4, f"case {c} ray {i}: the pass {p.distance} at {p.t}, the march {m.distance} at {m.t}")
                let at = if c == 0 { stage.distance(from + d * p.t) } else if c == 1 { cones.distance(from + d * p.t) } else { plane.distance(from + d * p.t) }
                assert(abs(at - p.distance) <= 1.0e-4, f"case {c} ray {i}: the distance at its t is {at}, not {p.distance}")
            }
        }
    }
    assert(near > 100 && met > 100, f"{near} near, {met} met")
}

/// `s`'s pass against a brute-force least (`marched_pass`: 2,000 even samples over `far` m and a
/// refine) on 600 rays from round `c` (from up to `size` m off it, a third toward it and the rest
/// anywhere, many from inside), both sides of its outline: within `low..high` (to `slack`), and
/// within `gap` of it at `high`. Exact (`exact`): `low`, `distance` and `high` the same and within
/// 1e-4 m of the least, never farther past rounding. (rays inside, rays outside, the most
/// `high` was above the least in 1e-6 m.)
fn passes_both_sides<S: Surface>(s: S, c: vec3, size: f32, far: f32, exact: bool, gap: f32) -> vec3u {
    let slack = 1.0e-5
    var inside: u32 = 0
    var outside: u32 = 0
    var worst = 0.0
    for i in 0..600 {
        let from = c + Box3 { lo: vec3(-size), hi: vec3(size) }.sample(13, i)
        let toward = c + Box3 { lo: vec3(-0.3 * size), hi: vec3(0.3 * size) }.sample(17, i)
        let any = Box3 { lo: vec3(-1.0), hi: vec3(1.0) }.sample(19, i) + vec3(0.0, 0.001, 0.0)
        let d = normalize(if i % 3 == 0 { toward - from + vec3(0.0, 0.0, 1.0e-3) } else { any })
        let p = s.passes(from, d)
        let m = marched_pass(s, from, d, far, 2000)
        assert(p.exact() == exact, f"ray {i}: exact {p.exact()}")
        assert(p.low <= p.distance && p.distance <= p.high, f"ray {i}: {p.low} {p.distance} {p.high} out of order")
        assert(p.low <= m.distance + slack * (1.0 + abs(m.distance)), f"ray {i}: low {p.low} above the least {m.distance}")
        if exact {
            assert(p.low == p.high, f"ray {i}: exact, low {p.low} and high {p.high}")
            assert(abs(p.distance - m.distance) <= 1.0e-4, f"ray {i}: {p.distance} at {p.t}, the least {m.distance} at {m.t}")
            assert(abs(s.distance(from + d * p.t) - p.distance) <= 1.0e-4, f"ray {i}: not {p.distance} at its t")
        } else {
            assert(p.high >= m.distance - slack * (1.0 + abs(m.distance)), f"ray {i}: high {p.high} below the least {m.distance}")
            assert(p.high - m.distance <= gap + slack, f"ray {i}: high {p.high} above the least {m.distance} by more than {gap}")
            assert(s.distance(from + d * p.t) <= p.distance + slack, f"ray {i}: above {p.distance} at its t")
        }
        worst = max(worst, p.high - m.distance)
        inside += if m.distance < -1.0e-3 { 1 } else { 0 }
        outside += if m.distance > 1.0e-3 { 1 } else { 0 }
    }
    vec3u(inside, outside, u32(max(worst, 0.0) * 1.0e6))
}

/// std's shapes (a ball, round cones thin, fat and one holding the other, a cylinder, a box
/// turned), and a sharp union of them: exact on both sides, from inside and out.
@test
fn passes_of_std_shapes_are_the_least_along_the_ray_on_both_sides() {
    let turn = Quat::axis_angle(normalize(vec3(1.0, 2.0, 0.5)), 0.7)
    let ball = sphere(0.8).translate(vec3(0.3, -0.2, 0.1))
    let cone = round_cone(vec3(-0.5, -0.4, 0.2), vec3(0.4, 0.6, -0.3), r_top: 0.15, r_bottom: 0.4)
    let held = round_cone(vec3(0.1, 0.0, 0.0), vec3(0.12, 0.03, 0.0), r_top: 0.6, r_bottom: 0.1)
    let rod = round_cone(vec3(0.0, -0.8, 0.0), vec3(0.0, 0.8, 0.0), r_top: 0.3, r_bottom: 0.3)
    let block = cuboid(vec3(0.9, 0.4, 0.6)).rotate(turn).translate(vec3(0.2, 0.1, -0.1))
    let all = ball.translate(vec3(1.2, 0.0, 0.0)).union(cone).union(block.translate(vec3(-1.0, 0.3, 0.4)))
    let r0 = passes_both_sides(ball, vec3(0.3, -0.2, 0.1), size: 1.6, far: 8.0, exact: true, gap: 0.0)
    let r1 = passes_both_sides(cone, vec3(), size: 1.2, far: 8.0, exact: true, gap: 0.0)
    let r2 = passes_both_sides(held, vec3(0.1, 0.0, 0.0), size: 1.0, far: 8.0, exact: true, gap: 0.0)
    let r3 = passes_both_sides(rod, vec3(), size: 1.2, far: 8.0, exact: true, gap: 0.0)
    let r4 = passes_both_sides(block, vec3(0.2, 0.1, -0.1), size: 1.4, far: 8.0, exact: true, gap: 0.0)
    let r5 = passes_both_sides(all, vec3(), size: 2.2, far: 12.0, exact: true, gap: 0.0)
    for r in [r0, r1, r2, r3, r4, r5] {
        assert(r.x > 60 && r.y > 60, f"{r.x} rays went in, {r.y} passed")
    }
    // Rays along a box's axes, from inside it and out: on the axes a ray doesn't move along, the
    // box's distance is a constant.
    let plain = cuboid(vec3(0.9, 0.4, 0.6))
    for i in 0..120 {
        let from = Box3 { lo: vec3(-1.3), hi: vec3(1.3) }.sample(23, i)
        let e = i % 3
        let along = if e == 0 { vec3(1.0, 0.0, 0.0) } else if e == 1 { vec3(0.0, 1.0, 0.0) } else { vec3(0.0, 0.0, 1.0) }
        let d = if (i / 3) % 2 == 0 { along } else { -along }
        let p = plain.passes(from, d)
        let m = marched_pass(plain, from, d, 8.0, 2000)
        assert(abs(p.distance - m.distance) <= 1.0e-4, f"axis ray {i}: {p.distance} at {p.t}, the least {m.distance} at {m.t}")
        assert(abs(plain.distance(from + d * p.t) - p.distance) <= 1.0e-4, f"axis ray {i}: not {p.distance} at its t")
    }
    // A half-space: out as far as a ray going out is, in for ever.
    let plane = half_space(normalize(vec3(0.1, 1.0, 0.05)), 0.2)
    for i in 0..200 {
        let from = Box3 { lo: vec3(-3.0), hi: vec3(3.0) }.sample(13, i)
        let d = normalize(Box3 { lo: vec3(-1.0), hi: vec3(1.0) }.sample(19, i) + vec3(0.0, 0.001, 0.0))
        let p = plane.passes(from, d)
        let m = marched_pass(plane, from, d, 8.0, 2000)
        assert(p.exact() && p.low == p.high, "a half-space's pass not exact")
        if dot(d, plane.normal) < 0.0 {
            assert(p.distance == -EMPTY, f"ray {i}: going in, {p.distance}")
        } else {
            assert(abs(p.distance - m.distance) <= 1.0e-4, f"ray {i}: {p.distance} against {m.distance}")
        }
    }
}

/// A smooth join (two shapes, and a fold of three balls) and a displaced ball, on both sides:
/// the least along the ray within `low..high`, and `high` (four asks of its own distance) within
/// the join's lowering of it (a displacement: twice its reach).
@test
fn passes_of_smooth_and_displaced_surfaces_hold_the_least_on_both_sides() {
    let k = 0.3
    let ball = sphere(0.6).translate(vec3(0.5, 0.0, 0.0))
    let cone = round_cone(vec3(-0.6, -0.3, 0.1), vec3(0.1, 0.4, -0.2), r_top: 0.15, r_bottom: 0.35)
    let pair = ball.smooth_union(cone, k: k)
    let three = [sphere(0.4).translate(vec3(-0.5, 0.0, 0.0)), sphere(0.35).translate(vec3(0.2, 0.3, 0.0)), sphere(0.45).translate(vec3(0.3, -0.4, 0.2))].smooth_union(k)
    let r = fbm(4.0, 3).range()
    let reach = 0.02 * max(abs(r.lo), abs(r.hi))
    let bumpy = sphere(1.0).displace(fbm(4.0, 3), amp: 0.02)
    let a = passes_both_sides(pair, vec3(), size: 1.4, far: 8.0, exact: false, gap: 0.25 * k)
    let b = passes_both_sides(three, vec3(), size: 1.2, far: 8.0, exact: false, gap: fold_lowering(3, k))
    let c = passes_both_sides(bumpy, vec3(), size: 2.0, far: 8.0, exact: false, gap: 2.0 * reach)
    for q in [a, b, c] {
        assert(q.x > 60 && q.y > 60, f"{q.x} rays went in, {q.y} passed")
    }
}

/// The rays of `a_smooth_unions_pass_refined_*` seen from `away` m: how many pass within a
/// footprint of the body (a fine march's least in 0..one footprint), and how many of those its
/// pass refined by four asks a footprint's scale apart puts within a twentieth of one; the
/// march's least within the pass's `low..high`.
fn refined_passes(away: f32, rays: u32) -> vec2u {
    let s = parted_body()
    let pixel = 2.0 / (1080.0 * (1.0 / tan(0.3)))
    let foot = pixel * away
    var within: u32 = 0
    var good: u32 = 0
    for i in 0..rays {
        // A point of the surface (near a part, taken onto it along the gradient), and a ray
        // along the surface there, lifted off it by up to a footprint (or into it a little).
        let part = s.part_bound(i % 18)
        var q = part.a + (part.b - part.a) * fract(f32(i) * 0.618034) + normalize(Box3 { lo: vec3(-1.0), hi: vec3(1.0) }.sample(7, i) + vec3(0.0, 0.0, 0.01)) * part.r
        for k in 0..6 {
            let g = gradient(|x: vec3| s.distance(x), q)
            q = q - g * (s.distance(q) / max(dot(g, g), 1.0e-12))
        }
        let n = normalize(gradient(|x: vec3| s.distance(x), q))
        let d = normalize(cross(n, Box3 { lo: vec3(-1.0), hi: vec3(1.0) }.sample(11, i) + vec3(0.01, 0.0, 0.0)))
        let from = q + n * (foot * (1.2 * fract(f32(i) * 0.414214) - 0.1)) - d * away
        let p = s.passes(from, d)
        let m = marched_pass(s, from, d, away + 1.0, 2000)
        assert(p.low <= m.distance + 1.0e-6, f"ray {i}: low {p.low} farther than the march's {m.distance}")
        assert(p.high >= m.distance - 1.0e-6, f"ray {i}: high {p.high} nearer than the march's {m.distance}")
        if m.distance > 0.0 && m.distance <= foot {
            within += 1
            let r = p.refined(from, d, |q: vec3| s.distance(q), 0.5 * foot)
            assert(r.distance >= m.distance - 1.0e-6, f"ray {i}: refined {r.distance} nearer than the march's {m.distance}")
            good += if r.distance - m.distance <= foot / 20.0 { 1 } else { 0 }
        }
    }
    vec2u(within, good)
}

/// A creature-like body (`parted_body`) seen from 1.5 m (the engine's near body eye): its pass
/// holds the least, and refined by four asks it is within a twentieth of a pixel's footprint (the
/// engine's camera: 0.6 rad high at 1080 rows, 0.57 mm a metre) of the true least on 99% of the
/// rays that pass within a footprint.
@test
fn a_smooth_unions_pass_refined_is_within_a_twentieth_of_a_footprint_near() {
    let r = refined_passes(1.5, 700)
    assert(r.x > 100, f"only {r.x} rays within a footprint")
    assert(r.y * 100 >= r.x * 99, f"{r.y} of {r.x} within a twentieth")
}

/// The same from 6 m (the engine's far body eye).
@test
fn a_smooth_unions_pass_refined_is_within_a_twentieth_of_a_footprint_far() {
    let r = refined_passes(6.0, 700)
    assert(r.x > 100, f"only {r.x} rays within a footprint")
    assert(r.y * 100 >= r.x * 99, f"{r.y} of {r.x} within a twentieth")
}

/// A displaced ball: its pass's `low` is never farther than a fine march's least, and within twice
/// the displacement's reach of it; refined by four asks, never nearer.
@test
fn a_displaced_surfaces_pass_is_its_inner_ones_less_its_reach() {
    let s = sphere(1.0).displace(fbm(4.0, 3), amp: 0.02)
    let r = fbm(4.0, 3).range()
    let reach = 0.02 * max(abs(r.lo), abs(r.hi))
    var raw = 0.0
    var refined = 0.0
    var counted = 0
    for i in 0..60 {
        let from = Box3 { lo: vec3(-4.0, -4.0, 3.0), hi: vec3(4.0, 4.0, 4.0) }.sample(3, i)
        let toward = Box3 { lo: vec3(-1.15), hi: vec3(1.15) }.sample(5, i)
        let d = normalize(toward - from)
        let m = marched_pass(s, from, d, 12.0, 3000)
        let p = s.passes(from, d)
        assert(!p.exact(), "a displaced surface's pass claims exact")
        if m.distance > 0.0 {
            assert(p.low <= m.distance + 1.0e-5, f"ray {i}: low {p.low} farther than the march's {m.distance}")
            assert(m.distance - p.low <= 2.0 * reach + 1.0e-4, f"ray {i}: {p.low} against {m.distance}, reach {reach}")
            let q = p.refined(from, d, |x: vec3| s.distance(x), 0.005)
            assert(q.distance >= m.distance - 1.0e-5, f"ray {i}: refined {q.distance} nearer than the march's {m.distance}")
            raw += m.distance - p.low
            refined += q.distance - m.distance
            counted += 1
        }
    }
    assert(counted > 20, f"only {counted} rays pass it")
}

/// A box's distance's gradient interval over boxes at its faces, edges and corners, where
/// `max(q, 0)` can be the zero vector (its `length`'s `normalize` asked over 0): no NaN is made
/// (a debug build traps one, and this test runs as one), and every sampled gradient lies within.
@test
fn a_boxs_gradient_interval_holds_where_its_outside_part_can_be_zero() {
    let b = cuboid(vec3(1.0, 0.5, 0.75)).translate(vec3(0.2, -0.1, 0.3))
    for k in 0..27 {
        // Each corner, edge and face of the box, and its middle; boxes of three sizes.
        let at = vec3(f32(k % 3), f32((k / 3) % 3), f32(k / 9)) - vec3(1.0)
        let c = vec3(0.2, -0.1, 0.3) + at * vec3(1.0, 0.5, 0.75)
        for h in [0.3, 0.01, 0.0001] {
            let over = Box3 { lo: c - vec3(h), hi: c + vec3(h) }
            let g = interval(|q: vec3| gradient(|x: vec3| b.distance(x), q), over)
            for i in 0..5 {
                for j in 0..5 {
                    for l in 0..5 {
                        let q = over.lo + (over.hi - over.lo) * vec3(f32(i), f32(j), f32(l)) / 4.0
                        let d = gradient(|x: vec3| b.distance(x), q)
                        assert(d.x >= g.lo.x && d.x <= g.hi.x && d.y >= g.lo.y && d.y <= g.hi.y && d.z >= g.lo.z && d.z <= g.hi.z, f"box {k} h {h}: the gradient at ({q.x}, {q.y}, {q.z}) outside its interval")
                    }
                }
            }
        }
    }
}

/// A field written while the program runs (`Writing`) with every leaf kind, every map and join
/// and a displacement, against the compiled tree of the same kinds: its distance the same to the
/// bit at 2,000 points, its bound and steepness the same, its parts its leaves.
@test
fn a_written_field_is_its_compiled_tree_to_the_bit() {
    let q = Quat::axis_angle(normalize(vec3(1.0, 2.0, 0.5)), 0.7)
    var w = writing()
    let a = w.sphere(0.6, matter: 1)
    let a1 = w.translate(a, vec3(0.5, 0.0, 0.0))
    let b = w.round_cone(vec3(-0.6, -0.3, 0.1), vec3(0.1, 0.4, -0.2), r_top: 0.15, r_bottom: 0.35, matter: 2)
    let ab = w.smooth_union(a1, b, 0.3)
    let c = w.cuboid(vec3(0.4, 0.3, 0.2), matter: 3)
    let c1 = w.rotate(c, q)
    let c2 = w.translate(c1, vec3(0.2, 0.5, 0.3))
    let abc = w.smooth_subtract(ab, c2, 0.1)
    let e = w.ellipsoid(vec3(0.3, 0.5, 0.4), matter: 4)
    let e1 = w.scale(e, 1.5)
    let all = w.union(abc, e1)
    let h = w.half_space(normalize(vec3(0.1, 1.0, 0.05)), 0.7, matter: 5)
    let cut = w.smooth_intersect(all, h, 0.05)
    let d = w.displace(cut, amp: 0.02, freq: 4.0, octaves: 3)
    let written = w.done().unwrap()
    let compiled = sphere(0.6).translate(vec3(0.5, 0.0, 0.0))
        .smooth_union(round_cone(vec3(-0.6, -0.3, 0.1), vec3(0.1, 0.4, -0.2), r_top: 0.15, r_bottom: 0.35), k: 0.3)
        .smooth_subtract(cuboid(vec3(0.4, 0.3, 0.2)).rotate(q).translate(vec3(0.2, 0.5, 0.3)), k: 0.1)
        .union(ellipsoid(vec3(0.3, 0.5, 0.4)).scale(1.5))
        .smooth_intersect(half_space(normalize(vec3(0.1, 1.0, 0.05)), 0.7), k: 0.05)
        .displace(fbm(4.0, 3), amp: 0.02)
    for i in 0..2000 {
        let p = Box3 { lo: vec3(-2.0), hi: vec3(2.0) }.sample(3, i)
        let (x, y) = (written.distance(p), compiled.distance(p))
        assert(x == y, f"at ({p.x}, {p.y}, {p.z}): written {x}, compiled {y}")
    }
    let (bw, bc) = (written.bound(), compiled.bound())
    assert(bw.centre == bc.centre && bw.radius == bc.radius && bw.slope == bc.slope, "the bounds differ")
    for near in [0.0, 0.1, 1.0] {
        assert(written.lipschitz(near) == compiled.lipschitz(near), f"the steepness within {near} differs")
    }
    assert(written.parts() == 5)
    // Its hash (each node's mixed in, the sums wrapping) is the same each time it's asked, and
    // another field's differs.
    assert(written.hash() == written.hash(), "the hash changed")
    var other = writing()
    let o1 = other.sphere(0.61)
    assert(other.done().unwrap().hash() != written.hash(), "two fields hash alike")
    // The matter of the nearest leaf.
    assert(written.matter_at(vec3(1.1, 0.0, 0.0)) == 1)
    assert(written.matter_at(vec3(-0.6, -0.45, 0.1)) == 2)
}

/// A written field's range over a box is its compiled tree's, to the bit: `range`'s value
/// (the affine form within the interval) and the plain interval, derived through its evaluator
/// as through the tree, at boxes from 1 m to 8 mm.
@test
fn a_written_fields_range_is_its_compiled_trees() {
    let q = Quat::axis_angle(normalize(vec3(1.0, 2.0, 0.5)), 0.7)
    var w = writing()
    let a = w.sphere(0.6, matter: 1)
    let a1 = w.translate(a, vec3(0.5, 0.0, 0.0))
    let b = w.round_cone(vec3(-0.6, -0.3, 0.1), vec3(0.1, 0.4, -0.2), r_top: 0.15, r_bottom: 0.35, matter: 2)
    let ab = w.smooth_union(a1, b, 0.3)
    let c = w.cuboid(vec3(0.4, 0.3, 0.2), matter: 3)
    let c1 = w.rotate(c, q)
    let c2 = w.translate(c1, vec3(0.2, 0.5, 0.3))
    let abc = w.smooth_subtract(ab, c2, 0.1)
    let e = w.ellipsoid(vec3(0.3, 0.5, 0.4), matter: 4)
    let e1 = w.scale(e, 1.5)
    let all = w.union(abc, e1)
    let d = w.displace(all, amp: 0.02, freq: 4.0, octaves: 3)
    let written = w.done().unwrap()
    let compiled = sphere(0.6).translate(vec3(0.5, 0.0, 0.0))
        .smooth_union(round_cone(vec3(-0.6, -0.3, 0.1), vec3(0.1, 0.4, -0.2), r_top: 0.15, r_bottom: 0.35), k: 0.3)
        .smooth_subtract(cuboid(vec3(0.4, 0.3, 0.2)).rotate(q).translate(vec3(0.2, 0.5, 0.3)), k: 0.1)
        .union(ellipsoid(vec3(0.3, 0.5, 0.4)).scale(1.5))
        .displace(fbm(4.0, 3), amp: 0.02)
    for side in [1.0, 0.12, 0.008] {
        for i in 0..16 {
            let c = Box3 { lo: vec3(-1.0), hi: vec3(1.0) }.sample(5, i)
            let bx = Box3 { lo: c - vec3(0.5 * side), hi: c + vec3(0.5 * side) }
            let (x, y) = (written.range(bx).value, compiled.range(bx).value)
            assert(x.lo == y.lo && x.hi == y.hi, f"side {side}, box {i}: written [{x.lo}, {x.hi}], compiled [{y.lo}, {y.hi}]")
            let (u, v) = (interval(|p: vec3| written.distance(p), bx), interval(|p: vec3| compiled.distance(p), bx))
            assert(u.lo == v.lo && u.hi == v.hi, f"side {side}, box {i}: the plain intervals differ")
        }
    }
}

/// A written field's `meets` and `passes` are its compiled tree's, to the bit, on rays from all
/// round it toward points within it: each leaf asked as the tree asks it, combined node by node
/// as each kind combines its operands'.
@test
fn a_written_fields_meets_and_passes_are_its_compiled_trees() {
    let q = Quat::axis_angle(normalize(vec3(1.0, 2.0, 0.5)), 0.7)
    var w = writing()
    let a = w.sphere(0.6, matter: 1)
    let a1 = w.translate(a, vec3(0.5, 0.0, 0.0))
    let b = w.round_cone(vec3(-0.6, -0.3, 0.1), vec3(0.1, 0.4, -0.2), r_top: 0.15, r_bottom: 0.35, matter: 2)
    let ab = w.smooth_union(a1, b, 0.3)
    let c = w.cuboid(vec3(0.4, 0.3, 0.2), matter: 3)
    let c1 = w.rotate(c, q)
    let c2 = w.translate(c1, vec3(0.2, 0.5, 0.3))
    let abc = w.smooth_subtract(ab, c2, 0.1)
    let e = w.ellipsoid(vec3(0.3, 0.5, 0.4), matter: 4)
    let e1 = w.scale(e, 1.5)
    let all = w.union(abc, e1)
    let h = w.half_space(normalize(vec3(0.1, 1.0, 0.05)), 0.7, matter: 5)
    let cut = w.smooth_intersect(all, h, 0.05)
    let s1 = w.sphere(0.3, matter: 6)
    let s2 = w.translate(s1, vec3(0.0, -1.0, 0.0))
    let s3 = w.cuboid(vec3(0.2), matter: 7)
    let s4 = w.scale(s3, 0.8)
    let sharp = w.union(s2, s4)
    let s5 = w.sphere(0.3, matter: 8)
    let both = w.intersect(sharp, s5)
    let top = w.union(cut, both)
    let d = w.displace(top, amp: 0.02, freq: 4.0, octaves: 3)
    let written = w.done().unwrap()
    let sharp_c = sphere(0.3).translate(vec3(0.0, -1.0, 0.0)).union(cuboid(vec3(0.2)).scale(0.8)).intersect(sphere(0.3))
    let undisplaced = sphere(0.6).translate(vec3(0.5, 0.0, 0.0))
        .smooth_union(round_cone(vec3(-0.6, -0.3, 0.1), vec3(0.1, 0.4, -0.2), r_top: 0.15, r_bottom: 0.35), k: 0.3)
        .smooth_subtract(cuboid(vec3(0.4, 0.3, 0.2)).rotate(q).translate(vec3(0.2, 0.5, 0.3)), k: 0.1)
        .union(ellipsoid(vec3(0.3, 0.5, 0.4)).scale(1.5))
        .smooth_intersect(half_space(normalize(vec3(0.1, 1.0, 0.05)), 0.7), k: 0.05)
        .union(sharp_c)
    let compiled = undisplaced.displace(fbm(4.0, 3), amp: 0.02)
    for i in 0..500 {
        let o = Box3 { lo: vec3(-3.0), hi: vec3(3.0) }.sample(7, i)
        let to = Box3 { lo: vec3(-1.0), hi: vec3(1.0) }.sample(9, i)
        let dir = to - o
        let (x, y) = (written.meets(o, dir), compiled.meets(o, dir))
        assert(x.near == y.near && x.far == y.far && x.first == y.first && x.flags == y.flags, f"ray {i}: meets differ: written [{x.near}, {x.far}] first {x.first}, compiled [{y.near}, {y.far}] first {y.first}")
        let (u, v) = (written.passes(o, dir), compiled.passes(o, dir))
        assert(u.t == v.t && u.distance == v.distance && u.low == v.low && u.high == v.high && u.flags == v.flags && u.other == v.other && u.other_distance == v.other_distance && u.blend == v.blend, f"ray {i}: passes differ: written t {u.t} [{u.low}, {u.high}] {u.distance}, compiled t {v.t} [{v.low}, {v.high}] {v.distance}")
        let (m, n) = (written.meets_grown(o, dir, grow: 0.1, inner: -0.05), undisplaced.displace(fbm(4.0, 3), amp: 0.02).meets_grown(o, dir, grow: 0.1, inner: -0.05))
        assert(m.near == n.near && m.far == n.far && m.first == n.first && m.flags == n.flags, f"ray {i}: grown meets differ")
    }
}

/// A written field's `live` masks, `pruned` ranges and `distance_live` are its compiled tree's,
/// to the bit: a fold of seventeen smooth unions with a wand (the body), and the tree of every
/// kind, at boxes from 1 m to 3 cm.
@test
fn a_written_fields_live_parts_are_its_compiled_trees() {
    // Six cones in a chain of smooth unions, a wand, the whole moved (the body's shape, written
    // out: the compiled n-ary fold prunes by its own rule).
    let cone = |i: u32| {
        let a = f32(i) * 0.37
        round_cone(vec3(0.12 * cos(a), 0.06 * f32(i), 0.12 * sin(a)), vec3(0.25 * cos(a), 0.06 * f32(i) + 0.12, 0.25 * sin(a)), r_top: 0.03, r_bottom: 0.045)
    }
    var w = writing()
    for i in 0..6 {
        let a = f32(i) * 0.37
        let n = w.round_cone(vec3(0.12 * cos(a), 0.06 * f32(i), 0.12 * sin(a)), vec3(0.25 * cos(a), 0.06 * f32(i) + 0.12, 0.25 * sin(a)), r_top: 0.03, r_bottom: 0.045, matter: 1)
        if i > 0 {
            let u = w.smooth_union(n - 1, n, 0.03)
        }
    }
    let wand = w.round_cone(vec3(-0.42, 0.87, -0.04), vec3(-0.5, 1.05, 0.26), r_top: 0.005, r_bottom: 0.005, matter: 2)
    let all = w.smooth_union(wand - 1, wand, 0.004)
    let moved = w.translate(all, vec3(1.0, 0.0, -2.0))
    let written = w.done().unwrap()
    let compiled = cone(0).smooth_union(cone(1), k: 0.03).smooth_union(cone(2), k: 0.03).smooth_union(cone(3), k: 0.03)
        .smooth_union(cone(4), k: 0.03).smooth_union(cone(5), k: 0.03)
        .smooth_union(round_cone(vec3(-0.42, 0.87, -0.04), vec3(-0.5, 1.05, 0.26), r_top: 0.005, r_bottom: 0.005), k: 0.004)
        .translate(vec3(1.0, 0.0, -2.0))
    let q = Quat::axis_angle(normalize(vec3(1.0, 2.0, 0.5)), 0.7)
    var v = writing()
    let a = v.sphere(0.6, matter: 1)
    let a1 = v.translate(a, vec3(0.5, 0.0, 0.0))
    let b = v.round_cone(vec3(-0.6, -0.3, 0.1), vec3(0.1, 0.4, -0.2), r_top: 0.15, r_bottom: 0.35, matter: 2)
    let ab = v.smooth_union(a1, b, 0.3)
    let c = v.cuboid(vec3(0.4, 0.3, 0.2), matter: 3)
    let c1 = v.rotate(c, q)
    let c2 = v.translate(c1, vec3(0.2, 0.5, 0.3))
    let abc = v.smooth_subtract(ab, c2, 0.1)
    let e = v.ellipsoid(vec3(0.3, 0.5, 0.4), matter: 4)
    let e1 = v.scale(e, 1.5)
    let all2 = v.union(abc, e1)
    let s1 = v.sphere(0.25, matter: 5)
    let s2 = v.translate(s1, vec3(0.0, -0.9, 0.0))
    let all3 = v.union(all2, s2)
    let d = v.displace(all3, amp: 0.02, freq: 4.0, octaves: 3)
    let every = v.done().unwrap()
    let every_c = sphere(0.6).translate(vec3(0.5, 0.0, 0.0))
        .smooth_union(round_cone(vec3(-0.6, -0.3, 0.1), vec3(0.1, 0.4, -0.2), r_top: 0.15, r_bottom: 0.35), k: 0.3)
        .smooth_subtract(cuboid(vec3(0.4, 0.3, 0.2)).rotate(q).translate(vec3(0.2, 0.5, 0.3)), k: 0.1)
        .union(ellipsoid(vec3(0.3, 0.5, 0.4)).scale(1.5))
        .union(sphere(0.25).translate(vec3(0.0, -0.9, 0.0)))
        .displace(fbm(4.0, 3), amp: 0.02)
    let bb = compiled.bound()
    var differing = 0
    var left_out = 0
    for side in [1.0, 0.3, 0.1, 0.03] {
        for i in 0..24 {
            let c = Box3 { lo: bb.centre - vec3(0.8 * bb.radius), hi: bb.centre + vec3(0.8 * bb.radius) }.sample(3, i)
            let bx = Box3 { lo: c - vec3(0.5 * side), hi: c + vec3(0.5 * side) }
            let (x, y) = (written.pruned(bx, |p: vec3| p, 1.0, ALL_LIVE, 0), compiled.pruned(bx, |p: vec3| p, 1.0, ALL_LIVE, 0))
            assert(x.live.words == y.live.words && x.range.lo == y.range.lo && x.range.hi == y.range.hi, f"the body, side {side}, box {i}: written [{x.range.lo}, {x.range.hi}], compiled [{y.range.lo}, {y.range.hi}]")
            left_out += 7 - x.live.count(7)
            for j in 0..8 {
                let p = bx.sample(4, j + 8 * i)
                assert(written.distance_live(p, x.live) == compiled.distance_live(p, y.live), f"the body's masked ask, side {side}, box {i}")
            }
            let c2_ = Box3 { lo: vec3(-1.0), hi: vec3(1.0) }.sample(6, i)
            let by = Box3 { lo: c2_ - vec3(0.5 * side), hi: c2_ + vec3(0.5 * side) }
            let (u, t) = (every.pruned(by, |p: vec3| p, 1.0, ALL_LIVE, 0), every_c.pruned(by, |p: vec3| p, 1.0, ALL_LIVE, 0))
            assert(u.live.words == t.live.words && u.range.lo == t.range.lo && u.range.hi == t.range.hi, f"every kind, side {side}, box {i}: written [{u.range.lo}, {u.range.hi}], compiled [{t.range.lo}, {t.range.hi}]")
            for j in 0..8 {
                let p = by.sample(4, j + 8 * i)
                assert(every.distance_live(p, u.live) == every_c.distance_live(p, t.live), f"every kind's masked ask, side {side}, box {i}")
            }
        }
    }
    assert(left_out > 40, f"only {left_out} parts left out in all")
}

/// A written field's parts are its compiled tree's, to the bit: each part's bound and own
/// distance, and the part that decides the distance, on the tree of every kind.
@test
fn a_written_fields_parts_are_its_compiled_trees() {
    let q = Quat::axis_angle(normalize(vec3(1.0, 2.0, 0.5)), 0.7)
    var v = writing()
    let a = v.sphere(0.6, matter: 1)
    let a1 = v.translate(a, vec3(0.5, 0.0, 0.0))
    let b = v.round_cone(vec3(-0.6, -0.3, 0.1), vec3(0.1, 0.4, -0.2), r_top: 0.15, r_bottom: 0.35, matter: 2)
    let ab = v.smooth_union(a1, b, 0.3)
    let c = v.cuboid(vec3(0.4, 0.3, 0.2), matter: 3)
    let c1 = v.rotate(c, q)
    let c2 = v.translate(c1, vec3(0.2, 0.5, 0.3))
    let abc = v.smooth_subtract(ab, c2, 0.1)
    let e = v.ellipsoid(vec3(0.3, 0.5, 0.4), matter: 4)
    let e1 = v.scale(e, 1.5)
    let all = v.union(abc, e1)
    let h = v.half_space(normalize(vec3(0.1, 1.0, 0.05)), 0.7, matter: 5)
    let cut = v.smooth_intersect(all, h, 0.05)
    let s1 = v.round_cone(vec3(0.0, -1.2, 0.0), vec3(0.3, -0.8, 0.1), r_top: 0.05, r_bottom: 0.1, matter: 6)
    let s2 = v.scale(s1, 0.9)
    let s3 = v.sphere(0.2, matter: 7)
    let s4 = v.intersect(s2, s3)
    let top = v.smooth_union(cut, s4, 0.1)
    let s5 = v.round_cone(vec3(0.8, 0.8, 0.0), vec3(1.0, 1.1, 0.2), r_top: 0.04, r_bottom: 0.08, matter: 8)
    let s6 = v.rotate(s5, q)
    let top2 = v.union(top, s6)
    let d = v.displace(top2, amp: 0.02, freq: 4.0, octaves: 3)
    let written = v.done().unwrap()
    let compiled = sphere(0.6).translate(vec3(0.5, 0.0, 0.0))
        .smooth_union(round_cone(vec3(-0.6, -0.3, 0.1), vec3(0.1, 0.4, -0.2), r_top: 0.15, r_bottom: 0.35), k: 0.3)
        .smooth_subtract(cuboid(vec3(0.4, 0.3, 0.2)).rotate(q).translate(vec3(0.2, 0.5, 0.3)), k: 0.1)
        .union(ellipsoid(vec3(0.3, 0.5, 0.4)).scale(1.5))
        .smooth_intersect(half_space(normalize(vec3(0.1, 1.0, 0.05)), 0.7), k: 0.05)
        .smooth_union(round_cone(vec3(0.0, -1.2, 0.0), vec3(0.3, -0.8, 0.1), r_top: 0.05, r_bottom: 0.1).scale(0.9).intersect(sphere(0.2)), k: 0.1)
        .union(round_cone(vec3(0.8, 0.8, 0.0), vec3(1.0, 1.1, 0.2), r_top: 0.04, r_bottom: 0.08).rotate(q))
        .displace(fbm(4.0, 3), amp: 0.02)
    assert(written.parts() == compiled.parts(), "the part counts differ")
    for i in 0..written.parts() {
        let (x, y) = (written.part_bound(i), compiled.part_bound(i))
        assert(x.a == y.a && x.b == y.b && x.r == y.r && x.reach == y.reach && x.lowers == y.lowers, f"part {i}'s bound differs: written r {x.r} reach {x.reach}, compiled r {y.r} reach {y.reach}")
    }
    for j in 0..400 {
        let p = Box3 { lo: vec3(-1.5), hi: vec3(1.5) }.sample(8, j)
        let (dw, pw) = written.part_at(p)
        let (dc, pc) = compiled.part_at(p)
        assert(dw == dc && pw == pc, f"at ({p.x}, {p.y}, {p.z}): written part {pw} at {dw}, compiled part {pc} at {dc}")
        for i in 0..written.parts() {
            assert(written.part_distance(p, i) == compiled.part_distance(p, i), f"part {i}'s distance at ({p.x}, {p.y}, {p.z}) differs")
        }
    }
}

/// `smoothstep`'s interval with its edges reversed (a fade out, as `smoothstep(8.0, 0.0, |d|)`)
/// holds every sample of its box and is within an ulp's widening of the samples' ends, as with
/// its edges in order; with the edges' ranges crossing it is [0, 1].
@test
fn a_reversed_smoothsteps_interval_holds_and_is_tight() {
    for i in 0..64 {
        let c = -2.0 + 12.0 * f32(i) / 64.0
        for w in [0.001, 0.1, 3.0] {
            let b = Interval { lo: c - w, hi: c + w }
            let r = interval(|x: f32| smoothstep(8.0, 0.0, x), b)
            let f = interval(|x: f32| smoothstep(0.0, 8.0, x), b)
            var least = 2.0
            var most = -1.0
            for j in 0..65 {
                let x = b.lo + (b.hi - b.lo) * f32(j) / 64.0
                let v = smoothstep(8.0, 0.0, x)
                assert(r.lo <= v && v <= r.hi, f"at {x}: {v} outside [{r.lo}, {r.hi}]")
                least = min(least, v)
                most = max(most, v)
            }
            assert(r.hi - r.lo <= most - least + 1.0e-5, f"[{b.lo}, {b.hi}]: [{r.lo}, {r.hi}] against the samples' [{least}, {most}]")
            assert(abs((r.hi - r.lo) - (f.hi - f.lo)) <= 1.0e-5, "the fade out's width isn't the fade in's")
        }
    }
    let crossing = interval(|e: f32| smoothstep(e, 1.0, 0.5), Interval { lo: 0.0, hi: 2.0 })
    assert(crossing.lo <= 0.0 && crossing.hi >= 1.0, "edges whose ranges cross")
}

/// The door refuses what isn't a field: operands not the nodes before, a leaf out of range, a
/// number not finite, the reserved rates node, more than one root, too many nodes.
@test
fn a_written_field_is_checked_at_the_door() {
    var w = writing()
    let a = w.sphere(1.0)
    let b = w.sphere(2.0)
    assert(w.done().is_err(), "two roots")
    var x = writing()
    let s = x.sphere(0.0)
    assert(x.done().is_err(), "a radius of 0")
    var y = writing()
    let s1 = y.sphere(1.0)
    let t = y.translate(s1, vec3(2.0e6, 0.0, 0.0))
    assert(y.done().is_err(), "a number past a million")
    var z = writing()
    let s2 = z.sphere(1.0)
    let s3 = z.sphere(1.0)
    let u = z.union(s3, s2)
    assert(z.done().is_err(), "operands out of order")
    var r = writing()
    let s4 = r.sphere(1.0)
    let rr = r.of(W_RATES, s4, 0, vec4(0.0), vec4(0.0))
    assert(r.done().is_err(), "the reserved rates")
    var f = writing()
    var last = f.sphere(1.0)
    for i in 0..70 {
        last = f.translate(last, vec3(0.1, 0.0, 0.0))
    }
    assert(f.done().is_err(), "too many nodes")
    var ok = writing()
    let o = ok.sphere(1.0)
    assert(ok.done().is_ok())
}

/// A surface with no bounds of its own for its parts (a cut) gives each the whole surface's: a
/// segment through it keeps every part.
@test
fn a_part_with_no_bound_of_its_own_is_the_wholes() {
    let s = sphere(1.0).smooth_subtract(sphere(0.5).translate(vec3(0.5, 0.0, 0.0)), k: 0.1)
    let live = live_along(s, vec3(-2.0, 0.0, 0.0), vec3(2.0, 0.0, 0.0), 0.0)
    assert(live.count(s.parts()) == s.parts())
}

@test
fn stated_bounds_hold_near_the_surface() {
    let f = test_blob()
    let near = 0.1
    let l = f.lipschitz(near)
    let b = Box3 { lo: vec3(-2.0), hi: vec3(2.0) }
    var checked = 0
    for i in 0..4096 {
        let p = b.sample(4, i)
        if abs(f.distance(p)) < near {
            checked += 1
            let g = length(gradient(|q: vec3| f.distance(q), p))
            assert(g <= l, f"at ({p.x}, {p.y}, {p.z})")
        }
    }
    assert(checked > 50, "too few samples near the surface")
}

/// `s`'s stated bound holds: at sampled points, and where `check_bound` looks.
fn bound_holds<S: Surface>(s: S) {
    let b = s.bound()
    assert(b.radius < 1.0e30, "bounded")
    let r = 2.0 * b.radius + 1.0
    let around = Box3 { lo: b.centre - vec3(r), hi: b.centre + vec3(r) }
    for i in 0..2048 {
        let p = around.sample(7, i)
        let d = s.distance(p)
        let below = b.below(p)
        // (Inside its sphere the bound says nothing.)
        assert(
            below <= 0.0 || d >= below - 1.0e-4 * (1.0 + abs(below)),
            f"at ({p.x}, {p.y}, {p.z}): {d} < {below}",
        )
    }
    assert(bound_broken(s, b).is_none(), "check_bound finds no box against it")
}

@test
fn every_stated_bound_holds_outside_its_sphere() {
    let a = round_cone(vec3(0.5, -0.2, 0.0), vec3(1.4, 0.6, 0.2), r_top: 0.15, r_bottom: 0.3)
    let c = cuboid(vec3(0.3)).translate(vec3(-0.9, 0.4, 0.1))
    bound_holds(test_blob())
    bound_holds(tube([vec3(), vec3(0.0, 1.0, 0.0), vec3(0.5, 1.5, 0.0)], [0.2, 0.15, 0.1]))
    bound_holds([sphere(0.3).translate(vec3()), sphere(0.5).translate(vec3(1.0, 0.0, 0.0))].union())
    bound_holds([a.translate(vec3()), a.translate(vec3(0.0, 0.0, 0.5))].smooth_union(k: 0.3))
    // Seventeen equal parts: the fold lowers them by all of `fold_lowering`, its bound's edge.
    bound_holds([sphere(0.3).translate(vec3()); 17].smooth_union(k: 0.3))
    bound_holds(ellipsoid(vec3(1.0, 0.6, 0.8)).smooth_subtract(sphere(0.5), k: 0.2))
    bound_holds(ellipsoid(vec3(1.0, 0.6, 0.8)).smooth_intersect(c, k: 0.2))
    bound_holds(a.mirror_x())
    bound_holds(
        oval(vec3(0.4, 0.2, 0.3)).scale(1.5).rotate(Quat::axis_angle(vec3(0.0, 1.0, 0.0), 0.7)),
    )
}

@test
fn a_bound_claiming_more_room_than_the_surface_leaves_is_found() {
    let s = sphere(1.0).translate(vec3(0.5, 0.0, 0.0))
    assert(bound_broken(s, s.bound()).is_none())
    assert(
        bound_broken(s, Bound { centre: vec3(0.5, 0.0, 0.0), radius: 0.6, slope: 1.0 }).is_some(),
    )
    assert(bound_broken(s, Bound { centre: vec3(), radius: 1.0, slope: 1.0 }).is_some())
}

@test
fn an_unbounded_surface_stays_unbounded_through_its_maps() {
    let h = half_space(vec3(0.0, 1.0, 0.0), 0.0)
    assert(h.scale(0.5).bound().radius >= 1.0e30)
    assert(
        h.translate(vec3(1.0)).rotate(Quat::axis_angle(vec3(1.0, 0.0, 0.0), 0.3)).bound().radius >=
            1.0e30,
    )
    assert(sphere(1.0).union(h.scale(0.5)).bound().radius >= 1.0e30)
}

@test
fn smooth_max_bounds_include_an_operand_far_inside_its_surface() {
    // A plane smoothly intersects SteepInside so a point 1.44 units inside that operand is on
    // the result's surface. Looking only k / 4 from either operand's surface misses its slope.
    let a = SteepInside {}
    let p = vec3(x: -1.0044)
    let b = half_space(vec3(x: 1.0), -0.9585)
    let k = 2.0
    let near = 0.0001
    let s = a.smooth_intersect(b, k)
    let g = length(gradient(|q: vec3| s.distance(q), p))
    let old_scope = near + 0.25 * k
    let too_narrow = max(a.lipschitz(old_scope), b.lipschitz(old_scope))
    assert(abs(s.distance(p)) < near)
    assert(g > 10.0 * too_narrow)
    assert(g <= s.lipschitz(near))

    // Subtraction is the same smooth maximum with the cutter's distance negated.
    let cut = half_space(vec3(x: -1.0), 0.9585)
    let subtracted = a.smooth_subtract(cut, k)
    let cut_g = length(gradient(|q: vec3| subtracted.distance(q), p))
    assert(abs(subtracted.distance(p)) < near && cut_g <= subtracted.lipschitz(near))
}

/// A body, a knob and its mirror image, and a cut: four parts, each found where it decides the
/// distance, with the distance `distance` gives.
fn test_parts() -> Surface {
    let knob = sphere(0.2).translate(vec3(0.6, 0.0, 0.0)).named("knob").mirror_x()
    sphere(0.5)
        .named("body")
        .smooth_union(knob, k: 0.05)
        .smooth_subtract(
            cuboid(half: vec3(0.1)).translate(vec3(0.0, 0.5, 0.0)).named("notch"),
            k: 0.02,
        )
}

@test
fn each_part_is_found_where_it_decides_the_distance() {
    let s = test_parts()
    assert(s.parts() == 4)
    let at = |p: vec3| s.part_at(p).1
    assert(at(vec3(0.0, -0.3, 0.0)) == 0)
    assert(at(vec3(0.7, 0.0, 0.0)) == 1)
    assert(at(vec3(-0.7, 0.0, 0.0)) == 2)
    assert(at(vec3(0.0, 0.45, 0.0)) == 3)
    assert(s.part_name(1).name == "knob" && !s.part_name(1).mirrored)
    assert(s.part_name(2).name == "knob" && s.part_name(2).mirrored)
    assert(s.part_name(3).name == "notch")
    // The image's own distance is the knob's, reflected.
    let p = vec3(-0.75, 0.1, 0.05)
    assert(abs(s.part_distance(p, 2) - s.part_distance(vec3(0.75, 0.1, 0.05), 1)) < 1.0e-6)
    let b = Box3 { lo: vec3(-1.0), hi: vec3(1.0) }
    for i in 0..1024 {
        let q = b.sample(5, i)
        assert(s.part_at(q).0 == s.distance(q), f"at ({q.x}, {q.y}, {q.z})")
    }
}

@test
fn array_blend_provenance_matches_the_binary_fold() {
    let a = sphere(1.0).named("a")
    let b = sphere(1.0).named("b")
    let c = sphere(1.1).named("c")
    let folded = a.smooth_union(b, k: 1.0).smooth_union(c, k: 1.0)
    let array = [a, b, c].smooth_union(k: 1.0)
    let p = vec3(0.0)
    assert(folded.part_at(p).1 == 0)
    assert(array.part_at(p).1 == folded.part_at(p).1)
    assert(array.part_at(p).0 == folded.part_at(p).0)
}

@test
fn value_noise_intervals_hold_every_sample_and_are_exact_within_two_cells() {
    // Boxes across 0, 1 or 2 lattice planes on each axis, some at large coordinates. Each holds
    // every value at a grid through the box and at its lattice planes; one that crosses at
    // most one plane on each axis is as wide as the values at those points (its corners and
    // its planes'), give or take the rounding allowance.
    for k in 0..240 {
        let w = [0.003, 0.04, 0.3, 0.97, 1.6, 2.5][k % 6]
        let lo = vec3(
            f32(k) * 0.731 - 80.0,
            f32(k % 7) * 1.37 - 4.0,
            f32(k % 11) * 0.913 + if k % 5 == 0 { 3000000.0 } else { 0.0 },
        )
        let b = Box3 { lo, hi: lo + vec3(w, 0.5 * w, w) }
        let r = interval(|q: vec3| value_noise(q), b)
        var slo = 1.0e9
        var shi = -1.0e9
        for i in 0..9 {
            for j in 0..9 {
                for l in 0..9 {
                    let t = vec3(f32(i), f32(j), f32(l)) / 8.0
                    var q = mix(b.lo, b.hi, t)
                    // A lattice plane inside the box, on each axis that has one.
                    let plane = floor(b.lo) + 1.0
                    if i == 4 && plane.x < b.hi.x { q.x = plane.x }
                    if j == 4 && plane.y < b.hi.y { q.y = plane.y }
                    if l == 4 && plane.z < b.hi.z { q.z = plane.z }
                    let v = value_noise(q)
                    assert(r.lo <= v && v <= r.hi, f"box {k}: {v} outside [{r.lo}, {r.hi}]")
                    slo = min(slo, v)
                    shi = max(shi, v)
                }
            }
        }
        let crossings = floor(b.hi) - floor(b.lo)
        if max(crossings.x, max(crossings.y, crossings.z)) <= 1.0 {
            let excess = (r.hi - r.lo) - (shi - slo)
            assert(excess < 0.0001, f"box {k}: interval wider than its values by {excess}")
        }
    }
}

@test
fn noise_boxes_keep_lattice_steps_at_large_coordinates() {
    for x in [16777216.0, 33554432.0, -33554432.0] {
        let p = vec3(x, 0.0, 0.0)
        assert(value_noise_box(p, vec3(0.0)) == value_noise(p))
        let i = lattice_coord(x)
        let want = 0.25 * lattice(i.wrapping_sub(1), y: 0, z: 0) +
            0.5 * lattice(i, y: 0, z: 0) +
            0.25 * lattice(i.wrapping_add(1), y: 0, z: 0)
        assert(abs(value_noise_box(p, vec3(1.0, 0.0, 0.0)) - want) < 0.000001)
    }
}

@test
fn a_part_shares_the_distance_where_it_decides_it_and_in_its_blends() {
    let s = test_parts()
    // On the body, away from the knobs and the notch: the body alone.
    let low = vec3(0.0, -0.5, 0.0)
    assert(abs(part_share(s, low, 0) - 1.0) < 1.0e-3)
    for i in 1..4 {
        assert(part_share(s, low, i) == 0.0, f"part {i}")
    }
    // The knob as written decides at x > 0, its image at x < 0.
    let knob = vec3(0.8, 0.0, 0.0)
    assert(abs(part_share(s, knob, 1) - 1.0) < 1.0e-3)
    assert(part_share(s, knob, 2) == 0.0)
    assert(part_share(s, vec3(-0.8, 0.0, 0.0), 2) > 0.999)
    // Where the knob meets the body (the circle where both spheres' surfaces cross), within
    // the blend's width, both share it.
    let seam = vec3(0.475, 0.156, 0.0)
    let (a, k) = (part_share(s, seam, 0), part_share(s, seam, 1))
    assert(a > 0.0 && a < 1.0 && k > 0.0 && k < 1.0, f"body {a}, knob {k}")
    assert(abs(a + k - 1.0) < 1.0e-2)
    // Raising a part where it decides raises the distance as much.
    assert(abs(s.part_offset(low, 0, by: 0.01) - (s.distance(low) + 0.01)) < 1.0e-6)
    // Scaled, an offset is in the scaled surface's units.
    let big = s.scale(2.0)
    assert(abs(big.part_offset(2.0 * low, 0, by: 0.01) - (big.distance(2.0 * low) + 0.01)) < 1.0e-6)
}

@test
fn certified_checks_prove_what_holds_and_find_what_fails() {
    let below = Box3 { lo: vec3(-2.0, -1.0, -2.0), hi: vec3(2.0, 0.0, 2.0) }
    // Clear of the ground: proved.
    let up = sphere(0.5).translate(vec3(0.0, 0.6, 0.0))
    assert(certify_clear(up, below, depth: 6).holds())
    // Sunk 10 cm: a point below the ground inside it.
    let sunk = sphere(0.5).translate(vec3(0.0, 0.4, 0.0))
    match certify_clear(sunk, below, depth: 6) {
        Certified::Fails(p) => assert(
            p.y <= 0.0 && sunk.distance(p) <= 0.0,
            f"at ({p.x}, {p.y}, {p.z})",
        ),
        _ => assert(false, "a sunk sphere is found"),
    }
    // Touching the ground at a point: no interval can prove it clear, and no point fails.
    let touching = sphere(0.5).translate(vec3(0.0, 0.5, 0.0))
    match certify_clear(touching, below, depth: 5) {
        Certified::Unknown(b) => assert(
            b.lo.y < 0.0001 && b.hi.y > -0.5,
            "the box is at the touch",
        ),
        Certified::Holds => assert(false, "a touching sphere isn't proved clear"),
        Certified::Fails(p) => assert(false, f"no point is inside: ({p.x}, {p.y}, {p.z})"),
    }
    // Two parts apart, and two that overlap.
    let pair = sphere(0.3).named("a").union(sphere(0.3).translate(vec3(1.0, 0.0, 0.0)).named("b"))
    let around = Box3 { lo: vec3(-1.0), hi: vec3(2.0, 1.0, 1.0) }
    assert(certify_apart(pair, a: 0, b: 1, region: around, depth: 6).holds())
    let close = sphere(0.3).named("a").union(sphere(0.3).translate(vec3(0.5, 0.0, 0.0)).named("b"))
    match certify_apart(close, a: 0, b: 1, region: around, depth: 6) {
        Certified::Fails(p) => assert(
            close.part_distance(p, 0) <= 0.0 && close.part_distance(p, 1) <= 0.0,
        ),
        _ => assert(false, "overlapping parts are found"),
    }
}

/// Whether `s.live_work(ALL_LIVE)`, its base and every part's, is the compiler's own count of
/// its masked ask with the mask unknown to it.
fn counted_exactly<S: Surface>(s: S) -> bool {
    let live = ALL_LIVE
    s.live_work(ALL_LIVE) == work(|q: vec3| s.distance_live(q, live))
}

/// Two masks for `a_masked_ask_costs_its_base_and_its_live_parts`: parts 0, 2 and 5; parts 1
/// and 4. (Constants, which the count follows through a shift: a bare literal it doesn't yet.)
const MASK_A: u32 = 37
const MASK_B: u32 = 18

/// What std counts a masked ask to cost (`live_work`): with every part live, the compiler's
/// count exactly; with a mask, never less than the compiler's count of code asking only the
/// live parts (here a mask written as a constant the count can follow, so the parts left out
/// are counted as not run).
@test
fn a_masked_ask_costs_its_base_and_its_live_parts() {
    let cones = [
        round_cone(vec3(0.0, 0.57, -0.03), vec3(0.0, 0.79, 0.0), r_top: 0.1, r_bottom: 0.096),
        round_cone(vec3(0.0, 0.79, 0.0), vec3(0.0, 0.91, -0.02), r_top: 0.096, r_bottom: 0.06),
        round_cone(vec3(0.13, 0.87, -0.04), vec3(0.28, 0.87, -0.04), r_top: 0.039, r_bottom: 0.035),
        round_cone(vec3(-0.13, 0.87, -0.04), vec3(-0.28, 0.87, -0.04), r_top: 0.039, r_bottom: 0.035),
        round_cone(vec3(0.07, 0.58, -0.02), vec3(0.07, 0.33, -0.02), r_top: 0.054, r_bottom: 0.043),
        round_cone(vec3(-0.07, 0.58, -0.02), vec3(-0.07, 0.33, -0.02), r_top: 0.054, r_bottom: 0.043),
    ]
    let smooth = cones.smooth_union(k: 0.03)
    let sharp = cones.union()
    let turn = Quat::axis_angle(normalize(vec3(1.0, 2.0, 0.5)), 0.7)
    let head = sphere(0.15).translate(vec3(0.0, 1.05, 0.0)).smooth_union(cones[2], k: 0.05).union(cones[3])
    let block = cuboid(vec3(0.2, 0.1, 0.1)).translate(vec3(0.3, 0.2, 0.0)).displace(fbm(4.0, 3), amp: 0.01)
    let tree = [cones[4], cones[5]].smooth_union(k: 0.02).rotate(turn).scale(1.3)
        .union(cones[0].smooth_union(cones[1], k: 0.04).with(vec3(1.0)).union(head))
        .smooth_union(block, k: 0.03)
    // (Made as `to_bound` makes it, without its debug build's check of a stated steepness.)
    let bounded = ToBound { inner: tree, near: 0.5, scale: 1.0 }
    assert(counted_exactly(smooth), "a smooth fold")
    assert(counted_exactly(sharp), "a sharp fold")
    assert(counted_exactly(tree), "a tree of every union under moves, channels and a displacement")
    assert(counted_exactly(bounded), "the tree held to a bound")
    assert(counted_exactly(sphere(1.0)), "one part")
    let a = work(|q: vec3| {
        var d = EMPTY
        for i in 0..6 {
            if ((MASK_A >> i) & 1) != 0 {
                d = smin(d, cones[i].distance(q), 0.03)
            }
        }
        d
    })
    assert(smooth.live_work(Live::from_word(MASK_A)) >= a, f"smooth, mask A: {smooth.live_work(Live::from_word(MASK_A))} under {a}")
    let b = work(|q: vec3| {
        var d = EMPTY
        for i in 0..6 {
            if ((MASK_B >> i) & 1) != 0 {
                d = min(d, cones[i].distance(q))
            }
        }
        d
    })
    assert(sharp.live_work(Live::from_word(MASK_B)) >= b, f"sharp, mask B: {sharp.live_work(Live::from_word(MASK_B))} under {b}")
    // A part left out takes off what it alone costs.
    assert(smooth.live_work(Live::from_word(MASK_A)) < smooth.live_work(ALL_LIVE))
    assert(tree.part_work(0) > 0 && tree.base_work() > 0)
}

/// `EXACT_MEETS` (§20.5): std's shapes and their sharp joins, moved and named, say exact; a blend,
/// a displacement and an author's surface don't.
@test
fn which_surfaces_meet_a_ray_exactly_is_a_constant_of_their_type() {
    let ball = sphere(1.0).translate(vec3(0.0, 1.0, 0.0)).with(vec3(1.0))
    let stage = cuboid(vec3(1.0)).union(ball).union(round_cone(vec3(0.0), vec3(1.0), r_top: 0.1, r_bottom: 0.2).named("arm"))
    assert(exact_meets(stage) && exact_meets([ball, ball].union()) && exact_meets(half_space(vec3(0.0, 1.0, 0.0), 0.0)))
    assert(!exact_meets(ball.smooth_union(ball, k: 0.1)) && !exact_meets([ball, ball].smooth_union(k: 0.1)))
    assert(!exact_meets(ball.displace(fbm(4.0, 3), amp: 0.01)) && !exact_meets(BuiltBall {}) && !exact_meets(ellipsoid(vec3(1.0, 2.0, 3.0))))
    // Where it says so, `meets` is exact for a ray that meets it and one that misses.
    assert(stage.meets(vec3(0.0, 0.0, 5.0), vec3(0.0, 0.0, -1.0)).exact() && stage.meets(vec3(0.0, 9.0, 5.0), vec3(0.0, 0.0, -1.0)).exact())
}

fn exact_meets<S: Surface>(s: S) -> bool {
    S::EXACT_MEETS
}

/// std's shapes and joins are `Eq` and `StateHash` (field by field, so their padding is never
/// read): a thing's field compared with last frame's says whether it changed, exactly, and a
/// hash of it keys what was made from it. A join holding an author's closure is neither.
@test
fn a_field_equals_last_frames_until_a_part_of_it_moves() {
    let cones = [
        round_cone(vec3(0.0, 0.57, -0.03), vec3(0.0, 0.79, 0.0), r_top: 0.1, r_bottom: 0.096),
        round_cone(vec3(0.0, 0.79, 0.0), vec3(0.0, 0.91, -0.02), r_top: 0.096, r_bottom: 0.06),
    ]
    let turn = Quat::axis_angle(normalize(vec3(1.0, 2.0, 0.5)), 0.7)
    let body = cones.smooth_union(k: 0.03).with(vec3(0.4)).smooth_union(sphere(0.1).rotate(turn).named("head"), k: 0.004)
    let same = cones.smooth_union(k: 0.03).with(vec3(0.4)).smooth_union(sphere(0.1).rotate(turn).named("head"), k: 0.004)
    assert(body == same && state_hash(body) == state_hash(same))
    var moved = cones
    moved[1] = round_cone(vec3(0.0, 0.79, 0.0), vec3(0.0, 0.91, -0.021), r_top: 0.096, r_bottom: 0.06)
    let walked = moved.smooth_union(k: 0.03).with(vec3(0.4)).smooth_union(sphere(0.1).rotate(turn).named("head"), k: 0.004)
    assert(body != walked && state_hash(body) != state_hash(walked), "a part moved")
    let turned = cones.smooth_union(k: 0.03).with(vec3(0.4)).smooth_union(sphere(0.1).rotate(Quat::axis_angle(vec3(0.0, 1.0, 0.0), 0.1)).named("head"), k: 0.004)
    assert(body != turned && state_hash(body) != state_hash(turned), "a part turned")
}

/// A surface whose numbers are its own code's: what can't change between frames.
struct BuiltBall: Copy + GpuData {}

impl Surface for BuiltBall {
    fn distance(self, p: vec3) -> f32 {
        sphere(1.0).translate(vec3(0.0, 2.0, 0.0)).distance(p)
    }

    fn bound(self) -> Bound {
        sphere(1.0).translate(vec3(0.0, 2.0, 0.0)).bound()
    }
}

/// `reads_only_input` (§14): what a function's result depends on, besides its argument. A
/// captured value is an input however it was made; a number written in the code isn't.
@test
fn a_field_reads_only_the_point_where_its_numbers_are_its_code() {
    let s = sphere(1.0)
    let time = 0.5
    assert(!reads_only_input(|p: vec3| s.distance(p)), "a shape held as a value")
    assert(reads_only_input(|p: vec3| sphere(1.0).translate(vec3(0.0, 2.0, 0.0)).distance(p)), "built inside")
    assert(!reads_only_input(|p: vec3| sphere(1.0 + sin(time)).distance(p)), "a field that reads the time")
    assert(!reads_only_input(|p: vec3| if time > 0.0 { length(p) } else { length(p) - 1.0 }), "a branch on a capture")
    assert(reads_only_input(|p: vec3| length(p) - 1.0), "a closure of the point alone")
    assert(reads_only_input(check_bound_scope), "a named function")
    assert(reads_only_input(|a: (Sphere, vec3)| a.0.distance(a.1)), "a field given with its point")
    assert(!reads_only_input(|a: (Sphere, vec3)| sphere(a.0.radius + time).distance(a.1)), "the same that reads the time")
    assert(!s.reads_only_point() && !s.union(sphere(2.0)).reads_only_point(), "std's shapes and joins held as values")
    assert(BuiltBall {}.reads_only_point() && BuiltBall {}.union(BuiltBall {}).reads_only_point(), "a surface whose numbers are its code, and a join of two")
}

fn check_bound_scope(p: vec3) -> f32 {
    max(abs(p.x), abs(p.y))
}
