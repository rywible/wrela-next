// Trigonometric, hyperbolic, exponential and logarithmic functions, their inverses and powers,
// with the constants π and 2π: the built-in transcendentals' code on the CPU, and in a strict GPU
// kernel (`@strict`, language.md §11.3), from this one source. They are compiled with the
// program, never taken from the host or the driver, so every host and every GPU that passes the
// hardware test of the safe operations computes the same bits.
//
// Each f32 function computes in f32 alone, with only what IEEE 754 rounds correctly or computes
// exactly: `+`, `-`, `*`, `/` and `sqrt` of f32s, comparisons, `floor`, `round`, `abs`,
// conversions between integers and floats, integer arithmetic and a float's bits. Nothing is
// contracted into a fused multiply-add. So the same arguments give the same bits on the CPU
// (WASM), in a strict Metal kernel (safe math, no contraction) and in a strict SPIR-V kernel
// (`NoContraction`), and a test of the function on the CPU is a test of it on every such GPU.
// Their errors, against an f64 reference for every f32 argument, are `STRICT_ULPS`.
//
// The polynomials' coefficients are the project's own fits (weighted least squares iterated
// toward the least greatest relative error, over each kernel's interval). The range reduction
// of a large sine's argument is Payne and Hanek's, with 2/π's bits.

/// π, to f32's precision.
pub const PI: f32 = 3.14159265

/// 2π, to f32's precision.
pub const TAU: f32 = 6.28318531

const F32_MAX: f32 = 340282346638528859811704183484516925440.0

fn is_nan(x: f32) -> bool {
    x != x
}

fn is_inf(x: f32) -> bool {
    abs(x) > F32_MAX
}

/// Whether `x` is a number and not an infinity.
pub fn is_finite(x: f32) -> bool {
    abs(x) <= F32_MAX
}

/// The most error, in units in the last place of the true value rounded to f32, of each f32
/// function here for any argument: `sin`, `cos`, `tan`, `exp`, `exp2`, `log`, `log2`, `sinh`,
/// `cosh`, `tanh`, `atan`, `asin`, `acos`, `atan2` and `pow`, in that order. Each one-argument
/// function's was measured on the CPU for every one of its 2³² arguments against the f64
/// functions below (`toolchain/tests`' `every_argument_is_within_its_error`, 2026-11-25: 1.072,
/// 1.072, 2.702, 1.101, 1.227, 0.860, 0.501, 2.376, 1.533, 2.668, 0.967, 2.537, 2.283), and is
/// stated here rounded up. `atan2`'s is bounded by its parts (a division's half ulp through
/// atan, whose slope is at most 1, atan's 0.967, and the sum with π's half ulp: under 2) and
/// measured at most 1.498 over 2³² pairs; `pow`'s by its parts (its log in two floats, within
/// 2⁻⁴⁰ relatively, times y, and exp2's 1.227) and measured at most 1.332 over 2³² pairs.
pub const STRICT_ULPS: [f32; 15] = [
    1.125, 1.125, 2.75, 1.125, 1.25, 0.875, 0.75, 2.5, 1.75, 2.75, 1.0, 2.75, 2.5, 2.0, 2.0,
]

/// A float from its bits.
fn f(bits: u32) -> f32 {
    bitcast_f32(bits)
}

/// `a + b` and its rounding error, exactly (Knuth's two-sum).
fn two_sum(a: f32, b: f32) -> (f32, f32) {
    let s = a + b
    let bb = s - a
    (s, (a - (s - bb)) + (b - bb))
}

/// `a`'s high and low halves of 12 significant bits each (Veltkamp's split).
fn split12(a: f32) -> (f32, f32) {
    let c = 4097.0 * a
    let hi = c - (c - a)
    (hi, a - hi)
}

/// `a * b` and its rounding error, exactly (Dekker's product), for a product far from
/// overflow.
fn two_product(a: f32, b: f32) -> (f32, f32) {
    let p = a * b
    let (ah, al) = split12(a)
    let (bh, bl) = split12(b)
    (p, ((ah * bh - p) + ah * bl + al * bh) + al * bl)
}

/// 2ⁿ for -126 <= n <= 127.
fn pow2i(n: i32) -> f32 {
    bitcast_f32(u32(n + 127) << 23)
}

/// `p * 2ⁿ` for -152 <= n <= 128, in two exact steps and one rounding.
fn scaled(p: f32, n: i32) -> f32 {
    let n1 = clamp(n, -126, 127)
    let n2 = clamp(n - n1, -126, 127)
    (p * pow2i(n1)) * pow2i(n2)
}

/// `r`, a magnitude, with the sign of `x`.
fn with_sign_of(r: f32, x: f32) -> f32 {
    if (bitcast_u32(x) >> 31) == 1 { -r } else { r }
}

// ---- sine and cosine ---------------------------------------------------------------------------

/// 2/π's first 256 bits, from the point, a word at a time.
const TWO_OVER_PI_BITS: [u32; 8] = [
    0xa2f9836e, 0x4e441529, 0xfc2757d1, 0xf534ddc0, 0xdb629599, 0x3c439041, 0xfe5163ab, 0xdebbc561,
]

/// The high and low words of the 64-bit product of two words.
fn mul_wide(a: u32, b: u32) -> (u32, u32) {
    let (al, ah) = (a & 0xffff, a >> 16)
    let (bl, bh) = (b & 0xffff, b >> 16)
    let ll = al * bl
    let lh = al * bh
    let hl = ah * bl
    let hh = ah * bh
    let mid = (ll >> 16) + (lh & 0xffff) + (hl & 0xffff)
    (hh + (lh >> 16) + (hl >> 16) + (mid >> 16), (ll & 0xffff) | ((mid & 0xffff) << 16))
}

/// 32 bits of 2/π from bit `s` after the point (1 the first), `s` from 1 to 160.
fn two_over_pi_at(s: u32) -> u32 {
    let k = (s - 1) / 32
    let o = (s - 1) % 32
    let a = TWO_OVER_PI_BITS[k]
    if o == 0 { a } else { (a << o) | (TWO_OVER_PI_BITS[k + 1] >> (32 - o)) }
}

/// `x` reduced by π/2 for |x| >= 6000 (Payne and Hanek): `y` as two floats, `y_hi + y_lo` within
/// 2⁻⁴⁰ of `x - qπ/2` relatively, |y| <= π/4, and `q`'s last two bits. `x` times the 96 bits of
/// 2/π that matter at its exponent (the bits before them give multiples of 4, those after less
/// than 2⁻⁷⁰), in integer arithmetic.
fn reduce_large(x: f32) -> (f32, f32, u32) {
    let xi = bitcast_u32(x) & 0x7fffffff
    let e = i32(xi >> 23) - 127
    let m = (xi & 0x7fffff) | 0x800000
    // The window starts at bit e - 25; below bit 1, zeros lead it.
    let s = max(e - 25, 1)
    var w0 = two_over_pi_at(u32(s))
    var w1 = two_over_pi_at(u32(s + 32))
    var w2 = two_over_pi_at(u32(s + 64))
    let lead = u32(max(26 - e, 0))
    if lead > 0 {
        w2 = (w2 >> lead) | (w1 << (32 - lead))
        w1 = (w1 >> lead) | (w0 << (32 - lead))
        w0 = w0 >> lead
    }
    let (h2, l2) = mul_wide(m, w2)
    let (h1, l1) = mul_wide(m, w1)
    let l0 = m.wrapping_mul(w0)
    let word1 = h2.wrapping_add(l1)
    let carry = if word1 < h2 { 1 } else { 0 }
    let word2 = h1.wrapping_add(l0).wrapping_add(carry)
    // The quadrant is bits 93 and 94 of the product; below them, the fraction, rounded to the
    // nearest quadrant: a fraction of a half or more is a negative one of the next.
    var q = (word2 >> 29) & 3
    var a = (word2 << 3) | (word1 >> 29)
    var b = (word1 << 3) | (l2 >> 29)
    var c = l2 << 3
    let neg = (a >> 31) == 1
    if neg {
        q = (q + 1) & 3
        // The magnitude: the 96 bits negated.
        let c0 = c
        c = (c ^ 0xffffffff).wrapping_add(1)
        let cb = if c0 == 0 { 1 } else { 0 }
        let b0 = b
        b = (b ^ 0xffffffff).wrapping_add(cb)
        let ca = if c0 == 0 && b0 == 0 { 1 } else { 0 }
        a = (a ^ 0xffffffff).wrapping_add(ca)
    }
    // Three exact pieces of 24 bits, in quadrants, summed into two floats.
    let a1 = f32(a >> 8)
    let a2 = f32(((a & 0xff) << 16) | (b >> 16))
    let a3 = f32(((b & 0xffff) << 8) | (c >> 24))
    var vh = a1 * f(0x33800000)
    var vl = a2 * f(0x27800000) + a3 * f(0x1b800000)
    let t = vh + vl
    vl = vl - (t - vh)
    vh = t
    if neg {
        vh = -vh
        vl = -vl
    }
    // Times π/2, in two floats.
    let (p, pe) = two_product(vh, f(0x3fc90fdb))
    let lo = pe + (vh * f(0xb33bbd2e) + vl * f(0x3fc90fdb))
    let yh = p + lo
    let yl = lo - (yh - p)
    if (bitcast_u32(x) >> 31) == 1 { (-yh, -yl, (4 - q) & 3) } else { (yh, yl, q) }
}

/// `x` reduced by π/2: `y_hi + y_lo`, |y| <= π/4 (and a rounding), within an f32's rounding
/// of `x - qπ/2` relatively, and `q`'s last two bits. For |x| < 6000 (q < 4096) by π/2 in four
/// parts of 12 bits, each times q exact, and the rest; beyond it, `reduce_large`.
fn reduce(x: f32) -> (f32, f32, u32) {
    if abs(x) >= 6000.0 {
        return reduce_large(x)
    }
    let n = round(x * f(0x3f22f983))
    let r = x - n * f(0x3fc90000)
    let (s1, e1) = two_sum(r, -(n * f(0x39fda000)))
    let (s2, e2) = two_sum(s1, -(n * f(0x33a22000)))
    let (s3, e3) = two_sum(s2, -(n * f(0x2c346000)))
    let t = ((e1 + e2) + e3) - n * f(0x248d3132)
    let yh = s3 + t
    (yh, t - (yh - s3), u32(i32(n)) & 3)
}

/// sin(y + y_lo) for |y| <= π/4.
fn sin_kernel(y: f32, y_lo: f32) -> f32 {
    let z = y * y
    let p = (f(0xb94ca219) * z + f(0x3c08839e)) * z + f(0xbe2aaaa3)
    y + (y_lo + (y * z) * p)
}

/// cos(y + y_lo) for |y| <= π/4.
fn cos_kernel(y: f32, y_lo: f32) -> f32 {
    let z = y * y
    let hz = 0.5 * z
    let w = 1.0 - hz
    let q = (f(0x37ccf5e5) * z + f(0xbab6061a)) * z + f(0x3d2aaaa5)
    w + ((((1.0 - w) - hz) - y * y_lo) + (z * z) * q)
}

/// sin of a reduced argument in quadrant `q`.
fn sin_quadrant(y: f32, y_lo: f32, q: u32) -> f32 {
    if q == 0 {
        sin_kernel(y, y_lo)
    } else if q == 1 {
        cos_kernel(y, y_lo)
    } else if q == 2 {
        -sin_kernel(y, y_lo)
    } else {
        -cos_kernel(y, y_lo)
    }
}

/// The sine of `x`, in radians.
pub fn sin(x: f32) -> f32 {
    if is_nan(x) || is_inf(x) {
        return x - x
    }
    // sin(x) rounds to x, keeping -0's sign.
    if abs(x) < f(0x39800000) {
        return x
    }
    if abs(x) <= f(0x3f490fdb) {
        return sin_kernel(x, 0.0)
    }
    let (y, y_lo, q) = reduce(x)
    sin_quadrant(y, y_lo, q)
}

/// The cosine of `x`, in radians.
pub fn cos(x: f32) -> f32 {
    if is_nan(x) || is_inf(x) {
        return x - x
    }
    if abs(x) <= f(0x3f490fdb) {
        return cos_kernel(x, 0.0)
    }
    let (y, y_lo, q) = reduce(x)
    sin_quadrant(y, y_lo, (q + 1) & 3)
}

/// The tangent of `x`, in radians: the sine over the cosine of the reduced argument.
pub fn tan(x: f32) -> f32 {
    if is_nan(x) || is_inf(x) {
        return x - x
    }
    if abs(x) < f(0x39800000) {
        return x
    }
    let (y, y_lo, q) = if abs(x) <= f(0x3f490fdb) { (x, 0.0, 0) } else { reduce(x) }
    let s = sin_kernel(y, y_lo)
    let c = cos_kernel(y, y_lo)
    if (q & 1) == 1 { -c / s } else { s / c }
}

// ---- exponentials and logarithms ----------------------------------------------------------------

/// (e^r - 1 - r) / r² for |r| <= ln(2)/2.
fn exp_tail(r: f32) -> f32 {
    var p = f(0x3ab51204)
    p = p * r + f(0x3c091ce3)
    p = p * r + f(0x3d2aac79)
    p = p * r + f(0x3e2aaa49)
    p * r + f(0x3efffffe)
}

/// e^r - 1 for |r| <= ln(2)/2.
fn expm1_kernel(r: f32) -> f32 {
    r + (r * r) * exp_tail(r)
}

/// `x` as `n ln 2 + r`, |r| <= ln(2)/2 and a rounding: ln 2 in three parts, the first two of
/// which times n are exact for |n| < 512.
fn reduce_ln2(x: f32) -> (f32, f32) {
    let n = round(x * f(0x3fb8aa3b))
    ((x - n * f(0x3f317000)) - n * f(0x3805fc00) - n * f(0x30fa39ef), n)
}

/// e to the power `x`.
pub fn exp(x: f32) -> f32 {
    if is_nan(x) {
        return x
    }
    if x > f(0x42b17218) {
        return 1.0 / 0.0
    }
    if x < -104.0 {
        return 0.0
    }
    let (r, n) = reduce_ln2(x)
    scaled(1.0 + expm1_kernel(r), i32(n))
}

/// e^x - 1, without the cancellation of `exp(x) - 1` near 0: 2ⁿ(e^r - 1) + (2ⁿ - 1).
fn expm1(x: f32) -> f32 {
    if abs(x) <= f(0x3eb17218) {
        return expm1_kernel(x)
    }
    if x > f(0x42b17218) {
        return 1.0 / 0.0
    }
    if x < -30.0 {
        return -1.0
    }
    let (r, n) = reduce_ln2(x)
    let ni = i32(n)
    let two_n = pow2i(ni)
    two_n * expm1_kernel(r) + (two_n - 1.0)
}

/// 2 to the power `x`.
pub fn exp2(x: f32) -> f32 {
    if is_nan(x) {
        return x
    }
    if x >= 128.0 {
        return 1.0 / 0.0
    }
    if x < -150.0 {
        return 0.0
    }
    let n = round(x)
    exp2_parts(x - n, 0.0, i32(n))
}

/// 2^(r + r_lo) · 2ⁿ for |r| <= 1/2.
fn exp2_parts(r: f32, r_lo: f32, n: i32) -> f32 {
    var q = f(0x3920fdc2)
    q = q * r + f(0x3aaf9f21)
    q = q * r + f(0x3c1d96a7)
    q = q * r + f(0x3d635774)
    q = q * r + f(0x3e75fdee)
    q = q * r + f(0x3f317218)
    // 2^r_lo = 1 + r_lo ln 2, to first order: r_lo is under an f32's rounding of r.
    scaled(1.0 + (r * q + r_lo * f(0x3f317218)), n)
}

/// A positive, finite `x` as `2^e · (1 + f)`, √½ <= 1 + f < √2: `f` (exact) and `e`.
fn log_parts(x: f32) -> (f32, i32) {
    var xs = x
    var e: i32 = 0
    if bitcast_u32(x) < 0x800000 {
        // A subnormal: made normal first.
        xs = x * 8388608.0
        e = -23
    }
    let bits = bitcast_u32(xs)
    e += i32(bits >> 23) - 127
    var m = bitcast_f32((bits & 0x7fffff) | 0x3f800000)
    if m > f(0x3fb504f3) {
        m = m * 0.5
        e += 1
    }
    (m - 1.0, e)
}

/// (log(1 + f) - f + f²/2) / f³ for √½ - 1 <= f <= √2 - 1.
fn log_tail(x: f32) -> f32 {
    var p = f(0xbd9c59d3)
    p = p * x + f(0x3e02ad0f)
    p = p * x + f(0xbe06c27f)
    p = p * x + f(0x3e116d23)
    p = p * x + f(0xbe2a3928)
    p = p * x + f(0x3e4cd003)
    p = p * x + f(0xbe800113)
    p * x + f(0x3eaaaaaa)
}

/// What `log` and `log2` give at an argument that isn't positive and finite, or `None`.
fn log_edge(x: f32) -> Option<f32> {
    if is_nan(x) || x < 0.0 {
        return Some((x - x) / (x - x))
    }
    if x == 0.0 {
        return Some(-1.0 / 0.0)
    }
    if is_inf(x) {
        return Some(x)
    }
    None
}

/// The natural logarithm of `x`: minus infinity at 0, and NaN below 0.
pub fn log(x: f32) -> f32 {
    match log_edge(x) {
        Some(v) => return v,
        None => {},
    }
    let (fr, e) = log_parts(x)
    let z = fr * fr
    let y = (fr * z) * log_tail(fr)
    let ef = f32(e)
    let hz = 0.5 * z
    ef * f(0x3f317000) + (fr - (hz - (y + ef * (f(0x3805fc00) + f(0x30fa39ef)))))
}

/// `(a_hi + a_lo) · b` in two floats.
fn times(a_hi: f32, a_lo: f32, b: f32) -> (f32, f32) {
    let (p, pe) = two_product(a_hi, b)
    let lo = pe + a_lo * b
    let hi = p + lo
    (hi, lo - (hi - p))
}

/// `(a_hi + a_lo) + (b_hi + b_lo)` in two floats.
fn plus(a_hi: f32, a_lo: f32, b_hi: f32, b_lo: f32) -> (f32, f32) {
    let (s, e) = two_sum(a_hi, b_hi)
    let lo = e + (a_lo + b_lo)
    let hi = s + lo
    (hi, lo - (hi - s))
}

/// log2(x) as two floats, `hi + lo`, within about 2⁻⁴⁰ of it relatively, for a positive, finite
/// `x`: e + 2 atanh(s) log2(e), s = f / (2 + f), its first two terms and the products carried in
/// two floats (what `pow` needs: its error is y times this).
fn log2_parts(x: f32) -> (f32, f32) {
    let (fr, e) = log_parts(x)
    // s = f / (2 + f) in two floats: 2 + f's rounding, then the quotient's.
    let d = 2.0 + fr
    let d_lo = (2.0 - d) + fr
    let s = fr / d
    let (p, pe) = two_product(s, d)
    let s_lo = (((fr - p) - pe) - s * d_lo) / d
    // 2 atanh(s) = 2s + (2/3) s³ + 2 s⁵ (1/5 + s²/7 + s⁴/9 + s⁶/11 + s⁸/13).
    let (s2, s2_lo) = two_product(s, s)
    let (s3, s3_l) = times(s2, s2_lo + 2.0 * s * s_lo, s)
    let s3_lo = s3_l + s2 * s_lo
    let (t3, t3_lo) = times(s3, s3_lo, f(0x3f2aaaab))
    let z = s2
    var q = f(0x3d9d89d9)
    q = q * z + f(0x3dba2e8c)
    q = q * z + f(0x3de38e39)
    q = q * z + f(0x3e124925)
    q = q * z + f(0x3e4ccccd)
    let t5 = 2.0 * ((s3 * s2) * q)
    let (a, a_lo) = plus(2.0 * s, 2.0 * s_lo, t3, t3_lo + f(0xb2aaaaab) * s3)
    let (ln, ln_lo) = plus(a, a_lo, t5, 0.0)
    // Times log2(e), in two floats.
    let (p2, p2_lo) = two_product(ln, f(0x3fb8aa3b))
    let lo = p2_lo + (ln * f(0x32a57060) + ln_lo * f(0x3fb8aa3b))
    // Plus e.
    plus(f32(e), 0.0, p2, lo)
}

/// The base-2 logarithm of `x`: minus infinity at 0, and NaN below 0.
pub fn log2(x: f32) -> f32 {
    match log_edge(x) {
        Some(v) => return v,
        None => {},
    }
    let (hi, lo) = log2_parts(x)
    hi + lo
}

/// Whether `y` is an odd integer (every f32 of magnitude 2^24 or more is even).
fn is_odd(y: f32) -> bool {
    abs(y) < 16777216.0 && floor(y) == y && (i32(y) & 1) == 1
}

/// `x` to the power `y`, with the values C and IEEE 754 give at zeros, infinities and NaNs:
/// 2^(y log2 |x|), the logarithm and the product carried in two floats.
pub fn pow(x: f32, y: f32) -> f32 {
    if y == 0.0 || x == 1.0 {
        return 1.0
    }
    if is_nan(x) || is_nan(y) {
        return x + y
    }
    let inf = 1.0 / 0.0
    if is_inf(y) {
        if x == -1.0 {
            return 1.0
        }
        // |x| < 1 goes to 0 as y goes to +inf, and |x| > 1 to inf; the other way for -inf.
        return if (abs(x) < 1.0) == (y > 0.0) { 0.0 } else { inf }
    }
    // A negative base (-0 too) gives an odd power its sign.
    let neg = (bitcast_u32(x) >> 31) == 1 && is_odd(y)
    if x == 0.0 || is_inf(x) {
        let r = if (x == 0.0) == (y > 0.0) { 0.0 } else { inf }
        return if neg { -r } else { r }
    }
    if x < 0.0 && floor(y) != y {
        return (x - x) / (x - x)
    }
    if abs(x) == 1.0 {
        // -1 to a finite power: ±1 (and y's split below could overflow).
        return if neg { -1.0 } else { 1.0 }
    }
    let (lh, ll) = log2_parts(abs(x))
    // y · log2|x| in two floats; its size alone decides an overflow or an underflow (|log2|x||
    // is at least 2⁻²³ here, so a |y| past 2⁶⁴, whose split would overflow, is decided by it).
    let ph = y * lh
    var r: f32 = 0.0
    if ph >= 129.0 {
        r = inf
    } else if ph < -151.0 {
        r = 0.0
    } else {
        let (p, p_lo) = two_product(y, lh)
        let lo = p_lo + y * ll
        let n = round(p)
        let (fr, fr_lo) = two_sum(p - n, lo)
        r = exp2_parts(fr, fr_lo, i32(n))
    }
    if neg { -r } else { r }
}

// ---- hyperbolic functions -----------------------------------------------------------------------

/// e^a / 2 for 88 < a <= 89.5, where e^a alone would overflow: 2ⁿ⁻¹ e^r.
fn half_exp(a: f32) -> f32 {
    let (r, n) = reduce_ln2(a)
    scaled(1.0 + expm1_kernel(r), i32(n) - 1)
}

/// The hyperbolic sine of `x`, (e^x - e^-x) / 2.
pub fn sinh(x: f32) -> f32 {
    if is_nan(x) {
        return x
    }
    // Odd: from |x|, then x's sign (by its bit, so -0 stays -0).
    let a = abs(x)
    if a > 89.5 {
        return with_sign_of(1.0 / 0.0, x)
    }
    if a > 88.0 {
        // e^a / 2 would overflow before the half: 2ⁿ⁻¹ e^r.
        return with_sign_of(half_exp(a), x)
    }
    // With E = e^a - 1, e^a - e^-a = E + E / (E + 1): no cancellation near 0.
    let e = expm1(a)
    with_sign_of(0.5 * (e + e / (e + 1.0)), x)
}

/// The hyperbolic cosine of `x`, (e^x + e^-x) / 2.
pub fn cosh(x: f32) -> f32 {
    if is_nan(x) {
        return abs(x)
    }
    let a = abs(x)
    if a > 89.5 {
        return 1.0 / 0.0
    }
    if a > 88.0 {
        return half_exp(a)
    }
    let e = exp(a)
    0.5 * e + 0.5 / e
}

/// The hyperbolic tangent of `x`, sinh(x) / cosh(x), in [-1, 1].
pub fn tanh(x: f32) -> f32 {
    if is_nan(x) {
        return x
    }
    // Odd: from |x|, then x's sign. Past 9.1 it's 1 to within f32's precision.
    let a = abs(x)
    if a > 9.1 {
        return with_sign_of(1.0, x)
    }
    // With E = e^(2a) - 1, (e^(2a) - 1) / (e^(2a) + 1) = E / (E + 2).
    let e = expm1(2.0 * a)
    with_sign_of(e / (e + 2.0), x)
}

// ---- inverse trigonometric functions ------------------------------------------------------------

/// atan of a non-negative `a`, by a reduction to |t| < 7/16 (fdlibm's) and an odd polynomial.
fn atan_positive(a: f32) -> f32 {
    if a > 67108864.0 {
        return f(0x3fc90fdb) + f(0xb33bbd2e)
    }
    // The table: atan of 0.5, 1, 1.5 and ∞, each in two floats.
    var hi: f32 = 0.0
    var lo: f32 = 0.0
    var t = a
    var reduced = true
    if a < 0.4375 {
        reduced = false
    } else if a < 0.6875 {
        hi = f(0x3eed6338)
        lo = f(0x31ac376a)
        t = (2.0 * a - 1.0) / (2.0 + a)
    } else if a < 1.1875 {
        hi = f(0x3f490fdb)
        lo = f(0xb2bbbd2e)
        t = (a - 1.0) / (a + 1.0)
    } else if a < 2.4375 {
        hi = f(0x3f7b985f)
        lo = f(0xb2d7e096)
        t = (a - 1.5) / (1.0 + 1.5 * a)
    } else {
        hi = f(0x3fc90fdb)
        lo = f(0xb33bbd2e)
        t = -1.0 / a
    }
    let z = t * t
    var p = f(0x3d6e5a68)
    p = p * z + f(0xbdd6da32)
    p = p * z + f(0x3e11b602)
    p = p * z + f(0xbe4cc6df)
    p = p * z + f(0x3eaaaaa1)
    let tail = (t * z) * p
    if reduced { hi + ((t - tail) + lo) } else { t - tail }
}

/// The angle whose tangent is `x`, in [-π/2, π/2].
pub fn atan(x: f32) -> f32 {
    if is_nan(x) {
        return x
    }
    with_sign_of(atan_positive(abs(x)), x)
}

/// The angle from the positive x axis to the point `(x, y)`, in [-π, π].
pub fn atan2(y: f32, x: f32) -> f32 {
    if is_nan(x) || is_nan(y) {
        return x + y
    }
    let x_neg = (bitcast_u32(x) >> 31) == 1
    if y == 0.0 {
        return if x_neg { with_sign_of(f(0x40490fdb), y) } else { y }
    }
    if x == 0.0 {
        return with_sign_of(f(0x3fc90fdb), y)
    }
    var t: f32 = 0.0
    if is_inf(x) && is_inf(y) {
        t = f(0x3f490fdb)
    } else if is_inf(x) {
        t = 0.0
    } else if is_inf(y) {
        t = f(0x3fc90fdb)
    } else {
        // |y / x| without an overflow or an underflow that the angle would show.
        let ay = abs(y)
        let ax = abs(x)
        if ay > ax * 67108864.0 {
            t = f(0x3fc90fdb)
        } else {
            t = atan_positive(ay / ax)
        }
    }
    let r = if x_neg { (f(0x40490fdb) - t) + f(0xb3bbbd2e) } else { t }
    with_sign_of(r, y)
}

/// The angle whose sine is `x`, in [-π/2, π/2]; NaN outside [-1, 1].
pub fn asin(x: f32) -> f32 {
    if is_nan(x) || abs(x) > 1.0 {
        return (x - x) / (x - x)
    }
    atan2(x, sqrt((1.0 - x) * (1.0 + x)))
}

/// The angle whose cosine is `x`, in [0, π]; NaN outside [-1, 1].
pub fn acos(x: f32) -> f32 {
    if is_nan(x) || abs(x) > 1.0 {
        return (x - x) / (x - x)
    }
    atan2(sqrt((1.0 - x) * (1.0 + x)), x)
}

// ---- the square root and the remainder of a strict kernel ---------------------------------------

/// The correctly rounded square root of `x`: what `sqrt` is in a strict kernel, whose GPU's own
/// isn't correctly rounded (the M4's differs in 605,737,168 of the 2³² arguments by an ulp,
/// `toolchain/host`'s `the_gpu_rounds_the_safe_operations_as_the_cpu_does`, which holds each
/// machine's to within one ulp): the GPU's root, set right by `sqrt_from`. A subnormal is a zero
/// of its sign, as the strict model takes it. The CPU's `sqrt` gives the same bits for every
/// other argument.
pub fn sqrt_rounded(x: f32) -> f32 {
    let bits = bitcast_u32(x)
    let mag = bits & 0x7fffffff
    if mag < 0x800000 {
        // A zero or a subnormal: a zero of its sign.
        return bitcast_f32(bits & 0x80000000)
    }
    if (bits >> 31) == 1 || mag >= 0x7f800000 {
        // Below zero (a NaN), an infinity or a NaN: the root's own.
        return sqrt(x)
    }
    sqrt_from(x, sqrt(x))
}

/// The correctly rounded square root of `x`, a positive normal f32, from `r`, a root of it
/// within one ulp: `r`, or its neighbour where the root is past the midpoint between them.
///
/// With R the 24 bits of r's significand and u its ulp, 4x/u² is an integer and a midpoint's
/// square times 4/u² is (2R ± 1)². They differ by less than 2²⁸ (the root is within 1.5 u of
/// the midpoint), so their difference's low 32 bits, a wrapping subtraction of a wrapping
/// square, are the whole of it, and its sign says on which side the root is; a root is never at
/// a midpoint. Below a power of two the neighbour is u/2 away and the midpoint r - u/4: 4x/u²
/// at most 4R² - 2R. The answer is `r`'s bits plus or minus one, with no branch. Every x with
/// each of its root's two neighbours as `r`: `toolchain/tests`'
/// `every_root_is_set_right_from_a_neighbour`.
pub fn sqrt_from(x: f32, r: f32) -> f32 {
    let rb = bitcast_u32(r)
    let er = rb >> 23
    let big_r = (rb & 0x7fffff) | 0x800000
    let xb = bitcast_u32(x)
    let big_x = (xb & 0x7fffff) | 0x800000
    // 4x / u², u = 2^(er - 150) with er biased: its low 32 bits.
    let xl = big_x << (((xb >> 23) + 152 - 2 * er) & 31)
    // Past the midpoint above: (2R + 1)² < 4x/u².
    let c = 2 * big_r + 1
    let up = xl.wrapping_sub(c.wrapping_mul(c))
    let above = up != 0 && up < 0x80000000
    // Below the midpoint below: 4x/u² < (2R - 1)², or under a power of two (R = 2²³), where
    // the neighbour is u/2 away, 4x/u² < 4R² - 2R + 1 (its midpoint r - u/4).
    let k = if big_r == 0x800000 { 2 * big_r } else { 4 * big_r }
    let two_r = 2 * big_r
    let low = xl.wrapping_sub(two_r.wrapping_mul(two_r).wrapping_sub(k).wrapping_add(1))
    let below = low >= 0x80000000
    // A neighbour is the next bits up or down, across a power of two too.
    bitcast_f32((rb + if above { 1 } else { 0 }) - if below { 1 } else { 0 })
}

/// `a / b` as the strict model has it (`toolchain/host`'s `strict_model`): IEEE 754's correctly
/// rounded quotient, with a subnormal operand a zero of its sign and a zero of the quotient's
/// sign where the exact quotient is below the least normal f32. What `/` of f32s is in a strict
/// kernel on a target whose GPU doesn't round its division (`wrela_abi::Target::rounds_div`: the
/// Radeon's driver multiplies by a reciprocal, and 1,813,385 of 16,781,060 quotients differed by
/// an ulp, 2026-11-26). The GPU's own division is asked only for the quotient of the two
/// significands, each in [1, 2), where no GPU overflows or flushes; `div_from` sets it right.
pub fn div_rounded(a: f32, b: f32) -> f32 {
    let sa = bitcast_f32((bitcast_u32(a) & 0x7fffff) | 0x3f800000)
    let sb = bitcast_f32((bitcast_u32(b) & 0x7fffff) | 0x3f800000)
    div_from(a, b, sa / sb)
}

/// `a / b` as the strict model has it (`div_rounded`), from `r`: the quotient of `a`'s
/// significand by `b`'s (each in [1, 2)) to within four ulps of the quotient, where Vulkan
/// allows a division two and a half.
///
/// With A and B the 24 bits of the significands and n = A, or 2A where A < B, n / B is in
/// [1, 2) and the quotient's significand is F = floor(n · 2²³ / B), 24 bits, with a remainder
/// R = n · 2²³ - F · B in [0, B). `r` scaled to an integer is F to within 4, so the remainder
/// taken from it is within 5B of R: less than 2²⁷, so its low 32 bits, a wrapping subtraction of
/// a wrapping product, are the whole of it, and comparing it with B's multiples says how far
/// the estimate is from F. Then F is rounded to nearest, a tie to even, by twice R against B;
/// a carry out of its 24 bits runs into the exponent as the bits are added. Every special case
/// (a NaN, an infinity, a zero, a subnormal operand, overflow, a quotient below the least
/// normal) is decided from the bits. `toolchain/tests`'
/// `every_quotient_is_set_right_from_an_estimate` holds it to the CPU's division.
pub fn div_from(a: f32, b: f32, r: f32) -> f32 {
    let ab = bitcast_u32(a)
    let bb = bitcast_u32(b)
    let sign = (ab ^ bb) & 0x80000000
    let ea = (ab >> 23) & 0xff
    let eb = (bb >> 23) & 0xff
    // A zero or a subnormal (a zero to the strict model), and an infinity or a NaN.
    let a_none = ea == 0
    let b_none = eb == 0
    let a_big = ea == 0xff
    let b_big = eb == 0xff
    if a_none || b_none || a_big || b_big {
        let a_nan = a_big && (ab & 0x7fffff) != 0
        let b_nan = b_big && (bb & 0x7fffff) != 0
        if a_nan || b_nan || (a_big && b_big) || (a_none && b_none) {
            return bitcast_f32(0x7fc00000)
        }
        if a_big || b_none {
            return bitcast_f32(sign | 0x7f800000)
        }
        return bitcast_f32(sign)
    }
    let big_a = (ab & 0x7fffff) | 0x800000
    let big_b = (bb & 0x7fffff) | 0x800000
    let low: u32 = if big_a < big_b { 1 } else { 0 }
    let n = big_a << low
    // The quotient's biased exponent before rounding: it is (n / B) · 2^(e - 127).
    let e = i32(ea) - i32(eb) - i32(low) + 127
    // `r` is n / B halved where A < B: either way an integer once scaled, about F.
    let est = u32(r * (if low == 1 { 16777216.0 } else { 8388608.0 }))
    // The remainder from the estimate: its low 32 bits, read as a signed number (the high bit
    // its sign).
    let rem = (n << 23).wrapping_sub(est.wrapping_mul(big_b))
    let under = rem >= 0x80000000
    // How many B the remainder is from [0, B): the estimate's distance from F.
    let up: u32 = (if !under && rem >= big_b { 1 } else { 0 }) +
        (if !under && rem >= 2 * big_b { 1 } else { 0 }) +
        (if !under && rem >= 3 * big_b { 1 } else { 0 }) +
        (if !under && rem >= 4 * big_b { 1 } else { 0 })
    let down: u32 = (if under { 1 } else { 0 }) +
        (if under && rem < (0).wrapping_sub(big_b) { 1 } else { 0 }) +
        (if under && rem < (0).wrapping_sub(2 * big_b) { 1 } else { 0 }) +
        (if under && rem < (0).wrapping_sub(3 * big_b) { 1 } else { 0 })
    let step = up.wrapping_sub(down)
    let f = est.wrapping_add(step)
    let left = rem.wrapping_sub(step.wrapping_mul(big_b))
    // To nearest, a tie to even.
    let twice = 2 * left
    let more: u32 = if twice > big_b || (twice == big_b && (f & 1) == 1) { 1 } else { 0 }
    let m = f + more
    if e <= 0 {
        // Below the least normal before rounding: a zero.
        return bitcast_f32(sign)
    }
    if e + i32(m >> 24) >= 255 {
        return bitcast_f32(sign | 0x7f800000)
    }
    // A significand of 2²⁴ carries into the exponent.
    bitcast_f32(sign | ((u32(e) << 23) + (m - 0x800000)))
}

/// `a % b` of f32s as the CPU computes it, exactly: `a - b·trunc(a/b)` with no rounding, `a`'s
/// sign (C's `fmod`), a NaN where `a` is infinite or `b` is 0 or either is a NaN. What a strict
/// kernel's `%` of floats is: a GPU's rounds at each step. From the bits, by shifts and integer
/// subtraction (musl's `fmodf`, MIT licence).
pub fn rem_exact(a: f32, b: f32) -> f32 {
    var ux = bitcast_u32(a)
    var uy = bitcast_u32(b)
    var ex = i32((ux >> 23) & 0xff)
    var ey = i32((uy >> 23) & 0xff)
    let sx = ux & 0x80000000
    if (uy << 1) == 0 || is_nan(b) || ex == 0xff {
        return (a * b) / (a * b)
    }
    if (ux << 1) <= (uy << 1) {
        if (ux << 1) == (uy << 1) {
            return 0.0 * a
        }
        return a
    }
    // Each mantissa with its leading one, normalized where subnormal (its leading zeros counted).
    if ex == 0 {
        let lead = i32((ux << 9).leading_zeros())
        ex -= lead
        ux = ux << u32(1 - ex)
    } else {
        ux = (ux & 0x7fffff) | 0x800000
    }
    if ey == 0 {
        let lead = i32((uy << 9).leading_zeros())
        ey -= lead
        uy = uy << u32(1 - ey)
    } else {
        uy = (uy & 0x7fffff) | 0x800000
    }
    // x mod y, a bit at a time: at most 277 steps (the exponents' widest difference), a bound the
    // work count sees.
    for _ in 0..277 {
        if ex <= ey {
            break
        }
        let i = ux.wrapping_sub(uy)
        if (i >> 31) == 0 {
            if i == 0 {
                return 0.0 * a
            }
            ux = i
        }
        ux = ux << 1
        ex -= 1
    }
    let i = ux.wrapping_sub(uy)
    if (i >> 31) == 0 {
        if i == 0 {
            return 0.0 * a
        }
        ux = i
    }
    // Normalized again: shifted up past its leading zeros.
    let lead = ux.leading_zeros() - 8
    ux = ux << lead
    ex -= i32(lead)
    // The result, its exponent restored (a subnormal shifted down).
    if ex > 0 {
        ux = (ux - 0x800000) | (u32(ex) << 23)
    } else {
        ux = ux >> u32(1 - ex)
    }
    bitcast_f32(ux | sx)
}

// ---- f64 helpers ------------------------------------------------------------------------------

// atan's table (atan of 0.5, 1, 1.5 and ∞, each in two parts) and polynomial, for f32's and
// f64's.
const ATAN_HI: [f64; 4] = [
    0.463647609000806093515,
    0.785398163397448278999,
    0.982793723247329054082,
    1.57079632679489655800,
]
const ATAN_LO: [f64; 4] = [
    0.0000000000000000226987774529616870924,
    0.0000000000000000306161699786838301793,
    0.0000000000000000139033110312309984516,
    0.0000000000000000612323399573676603587,
]
const AT: [f64; 11] = [
    0.333333333333329318027,
    -0.199999999998764832476,
    0.142857142725034663711,
    -0.111111104054623557880,
    0.0909088713343650656196,
    -0.0769187620504482999495,
    0.0666107313738753120669,
    -0.0583357013379057348645,
    0.0497687799461593236017,
    -0.0365315727442169155270,
    0.0162858201153657823623,
]

/// atan of an f64, by a reduction to |a| < 7/16 and an odd polynomial.
fn wide_atan(x: f64) -> f64 {
    if x != x {
        return x
    }
    let neg = x < 0.0
    var a = abs(x)
    if a > 100000000000000000000.0 {
        return if neg { -ATAN_HI[3] } else { ATAN_HI[3] }
    }
    var id: i32 = -1
    if a >= 0.4375 {
        if a < 0.6875 {
            id = 0
            a = (2.0 * a - 1.0) / (2.0 + a)
        } else if a < 1.1875 {
            id = 1
            a = (a - 1.0) / (a + 1.0)
        } else if a < 2.4375 {
            id = 2
            a = (a - 1.5) / (1.0 + 1.5 * a)
        } else {
            id = 3
            a = -1.0 / a
        }
    }
    let z = a * a
    let w = z * z
    let s1 = z * (AT[0] + w * (AT[2] + w * (AT[4] + w * (AT[6] + w * (AT[8] + w * AT[10])))))
    let s2 = w * (AT[1] + w * (AT[3] + w * (AT[5] + w * (AT[7] + w * AT[9]))))
    let r = if id < 0 {
        a - a * (s1 + s2)
    } else {
        ATAN_HI[u32(id)] - ((a * (s1 + s2) - ATAN_LO[u32(id)]) - a)
    }
    if neg {
        -r
    } else {
        r
    }
}

/// Whether an f64's sign bit is set (true for -0.0).
fn sign_bit(x: f64) -> bool {
    (bitcast_u64(x) >> 63) == 1
}

// ---- f64 ----------------------------------------------------------------------------------
//
// The same functions of f64s, for CPU code that measures in f64 (a tool's spectra, a mesh's
// rays): `sin_f64`, `cos_f64`, `atan_f64`, `atan2_f64`, `exp_f64`, `log_f64`, `log10_f64`,
// `log2_f64` and `pow_f64`, with `PI_F64` and `TAU_F64`. The built-in transcendentals of an f64
// are E0702 (§11.4); these are ordinary functions, over the ranges they say: `sin_f64` and
// `cos_f64` of |x| below 2^20·π/2, `pow_f64` of a positive, finite base. Each is within an ulp
// of libm where sampled (300,000 points of each against macOS's libm, outside the repository,
// and the points in `LIBM`), but `pow_f64` near overflow, within two; `pow_f64` is an infinity
// or 0 past f64's range, and exact where a correctly rounded libm is (x¹, x², x⁻¹, √x and 2ⁿ),
// and `log10_f64` and `log2_f64` at the powers of their bases.
//
// Credit (MIT licence): the algorithms and coefficients follow musl's libm (FreeBSD msun, and
// Sun's fdlibm before it): __sin and __cos, __rem_pio2's medium range reduction, atan and
// atan2, exp and log. `pow` is e^(y·log x) with log x and the product carried in two f64s
// (Dekker's products), so its error is exp's; x¹, x², x⁻¹, √x and 2ⁿ are exact, as a correctly
// rounded libm's are.

// π/2's reduction (__rem_pio2): 1.5 / f64's epsilon rounds to an integer when added and taken
// away; 2/π; π/2 in three parts of 33 bits, each with the rest after it; π/4.
const D_TOINT: f64 = 6755399441055744.0
const D_INV_PIO2: f64 = bitcast_f64(u64(0x3FE45F306DC9C883))
const D_PIO2_1: f64 = bitcast_f64(u64(0x3FF921FB54400000))
const D_PIO2_1T: f64 = bitcast_f64(u64(0x3DD0B4611A626331))
const D_PIO2_2: f64 = bitcast_f64(u64(0x3DD0B4611A600000))
const D_PIO2_2T: f64 = bitcast_f64(u64(0x3BA3198A2E037073))
const D_PIO2_3: f64 = bitcast_f64(u64(0x3BA3198A2E000000))
const D_PIO2_3T: f64 = bitcast_f64(u64(0x397B839A252049C1))
const D_PIO4: f64 = bitcast_f64(u64(0x3FE921FB54442D18))

/// π, and the rest of it past an f64.
pub const PI_F64: f64 = bitcast_f64(u64(0x400921FB54442D18))
const D_PI_LO: f64 = bitcast_f64(u64(0x3CA1A62633145C07))

/// 2π.
pub const TAU_F64: f64 = bitcast_f64(u64(0x401921FB54442D18))

// __sin's and __cos's polynomials.
const D_S1: f64 = bitcast_f64(u64(0xBFC5555555555549))
const D_S2: f64 = bitcast_f64(u64(0x3F8111111110F8A6))
const D_S3: f64 = bitcast_f64(u64(0xBF2A01A019C161D5))
const D_S4: f64 = bitcast_f64(u64(0x3EC71DE357B1FE7D))
const D_S5: f64 = bitcast_f64(u64(0xBE5AE5E68A2B9CEB))
const D_S6: f64 = bitcast_f64(u64(0x3DE5D93A5ACFD57C))
const D_C1: f64 = bitcast_f64(u64(0x3FA555555555554C))
const D_C2: f64 = bitcast_f64(u64(0xBF56C16C16C15177))
const D_C3: f64 = bitcast_f64(u64(0x3EFA01A019CB1590))
const D_C4: f64 = bitcast_f64(u64(0xBE927E4F809C52AD))
const D_C5: f64 = bitcast_f64(u64(0x3E21EE9EBDB4B1C4))
const D_C6: f64 = bitcast_f64(u64(0xBDA8FAE9BE8838D4))

// exp's and log's: ln 2 in two parts (the first with 32 bits to spare), 1/ln 2, and their
// polynomials.
const D_LN2_HI: f64 = bitcast_f64(u64(0x3FE62E42FEE00000))
const D_LN2_LO: f64 = bitcast_f64(u64(0x3DEA39EF35793C76))
const D_INV_LN2: f64 = bitcast_f64(u64(0x3FF71547652B82FE))
const D_INV_LN2_LO: f64 = bitcast_f64(u64(0x3C7777D0FFDA0D24))

// 1/ln 10, in two parts.
const D_INV_LN10: f64 = bitcast_f64(u64(0x3FDBCB7B1526E50E))
const D_INV_LN10_LO: f64 = bitcast_f64(u64(0x3C695355BAAAFAD3))
const D_P1: f64 = bitcast_f64(u64(0x3FC555555555553E))
const D_P2: f64 = bitcast_f64(u64(0xBF66C16C16BEBD93))
const D_P3: f64 = bitcast_f64(u64(0x3F11566AAF25DE2C))
const D_P4: f64 = bitcast_f64(u64(0xBEBBBD41C5D26BF1))
const D_P5: f64 = bitcast_f64(u64(0x3E66376972BEA4D0))
const D_LG1: f64 = bitcast_f64(u64(0x3FE5555555555593))
const D_LG2: f64 = bitcast_f64(u64(0x3FD999999997FA04))
const D_LG3: f64 = bitcast_f64(u64(0x3FD2492494229359))
const D_LG4: f64 = bitcast_f64(u64(0x3FCC71C51D8E78AF))
const D_LG5: f64 = bitcast_f64(u64(0x3FC7466496CB03DE))
const D_LG6: f64 = bitcast_f64(u64(0x3FC39A09D078C69F))
const D_LG7: f64 = bitcast_f64(u64(0x3FC2F112DF3E5244))

/// The high 32 bits of `x`'s magnitude.
fn d_high(x: f64) -> u32 {
    u32((bitcast_u64(x) >> 32) & 0x7fffffff)
}

fn d_sin_kernel(x: f64, y: f64, tail: bool) -> f64 {
    let z = x * x
    let w = z * z
    let r = D_S2 + z * (D_S3 + z * D_S4) + z * w * (D_S5 + z * D_S6)
    let v = z * x
    if !tail {
        x + v * (D_S1 + z * r)
    } else {
        x - ((z * (0.5 * y - v * r) - y) - v * D_S1)
    }
}

fn d_cos_kernel(x: f64, y: f64) -> f64 {
    let z = x * x
    let w = z * z
    let r = z * (D_C1 + z * (D_C2 + z * D_C3)) + w * w * (D_C4 + z * (D_C5 + z * D_C6))
    let hz = 0.5 * z
    let one = 1.0 - hz
    one + (((1.0 - one) - hz) + (z * r - x * y))
}

/// `x` less the nearest multiple `n` of π/2, as two f64s (y0 + y1, |y0| <= π/4 about), and
/// `n`: __rem_pio2's reduction for |x| < 2^20·π/2.
fn d_reduce(x: f64) -> (f64, f64, i32) {
    assert(d_high(x) < 0x413921fb, f"sin_f64 and cos_f64 take |x| < 2^20·π/2, not {x}")
    var fn_ = x * D_INV_PIO2 + D_TOINT - D_TOINT
    var n = i32(fn_)
    var r = x - fn_ * D_PIO2_1
    var w = fn_ * D_PIO2_1T
    if r - w < -D_PIO4 {
        n -= 1
        fn_ -= 1.0
        r = x - fn_ * D_PIO2_1
        w = fn_ * D_PIO2_1T
    } else if r - w > D_PIO4 {
        n += 1
        fn_ += 1.0
        r = x - fn_ * D_PIO2_1
        w = fn_ * D_PIO2_1T
    }
    var y0 = r - w
    let ex = d_high(x) >> 20
    var ey = u32((bitcast_u64(y0) >> 52) & 0x7ff)
    if ex > ey + 16 {
        var t = r
        w = fn_ * D_PIO2_2
        r = t - w
        w = fn_ * D_PIO2_2T - ((t - r) - w)
        y0 = r - w
        ey = u32((bitcast_u64(y0) >> 52) & 0x7ff)
        if ex > ey + 49 {
            t = r
            w = fn_ * D_PIO2_3
            r = t - w
            w = fn_ * D_PIO2_3T - ((t - r) - w)
            y0 = r - w
        }
    }
    (y0, (r - y0) - w, n)
}

/// The sine of `x`, in radians, |x| < 2^20·π/2.
pub fn sin_f64(x: f64) -> f64 {
    if d_high(x) <= 0x3fe921fb {
        if d_high(x) < 0x3e500000 {
            return x
        }
        return d_sin_kernel(x, 0.0, tail: false)
    }
    let (a, b, n) = d_reduce(x)
    let q = n & 3
    if q == 0 {
        d_sin_kernel(a, b, tail: true)
    } else if q == 1 {
        d_cos_kernel(a, b)
    } else if q == 2 {
        -d_sin_kernel(a, b, tail: true)
    } else {
        -d_cos_kernel(a, b)
    }
}

/// The cosine of `x`, in radians, |x| < 2^20·π/2.
pub fn cos_f64(x: f64) -> f64 {
    if d_high(x) <= 0x3fe921fb {
        if d_high(x) < 0x3e46a09e {
            return 1.0
        }
        return d_cos_kernel(x, 0.0)
    }
    let (a, b, n) = d_reduce(x)
    let q = n & 3
    if q == 0 {
        d_cos_kernel(a, b)
    } else if q == 1 {
        -d_sin_kernel(a, b, tail: true)
    } else if q == 2 {
        -d_cos_kernel(a, b)
    } else {
        d_sin_kernel(a, b, tail: true)
    }
}

/// The angle whose tangent is `x`, in [-π/2, π/2].
pub fn atan_f64(x: f64) -> f64 {
    // Keeps -0's sign.
    if x == 0.0 {
        return x
    }
    wide_atan(x)
}

/// The angle from the positive x axis to the point (`x`, `y`), in [-π, π].
pub fn atan2_f64(y: f64, x: f64) -> f64 {
    if x != x || y != y {
        return x + y
    }
    if x == 1.0 {
        return atan_f64(y)
    }
    if y == 0.0 {
        if !sign_bit(x) {
            return y
        }
        return if sign_bit(y) { -PI_F64 } else { PI_F64 }
    }
    if x == 0.0 {
        return if y > 0.0 { 0.5 * PI_F64 } else { -0.5 * PI_F64 }
    }
    let inf = 1.0 / 0.0
    if abs(x) == inf {
        if abs(y) == inf {
            let q = if x > 0.0 { 0.25 * PI_F64 } else { 0.75 * PI_F64 }
            return if y > 0.0 { q } else { -q }
        }
        let q = if x > 0.0 { 0.0 } else { PI_F64 }
        return if y > 0.0 { q } else { -q }
    }
    if abs(y) == inf {
        return if y > 0.0 { 0.5 * PI_F64 } else { -0.5 * PI_F64 }
    }
    let ex = d_high(x) >> 20
    let ey = d_high(y) >> 20
    // |y/x| past 2^60, or below 2^-60 with x < 0: atan's own limits.
    let z = if ey > ex + 60 {
        0.5 * PI_F64 + 0.5 * D_PI_LO
    } else if x < 0.0 && ex > ey + 60 {
        0.0
    } else {
        atan_f64(abs(y / x))
    }
    if x > 0.0 {
        return if y > 0.0 { z } else { -z }
    }
    if y > 0.0 {
        PI_F64 - (z - D_PI_LO)
    } else {
        (z - D_PI_LO) - PI_F64
    }
}

/// `y` times 2^`n`.
fn d_scaled(y: f64, n: i32) -> f64 {
    var v = y
    var k = n
    if k > 1023 {
        v *= bitcast_f64(u64(0x7FE0000000000000))
        k -= 1023
        if k > 1023 {
            v *= bitcast_f64(u64(0x7FE0000000000000))
            k = min(k - 1023, 1023)
        }
    } else if k < -1022 {
        // 2^-1022 · 2^53, so a subnormal result is rounded once.
        v *= bitcast_f64(u64(0x0360000000000000))
        k += 969
        if k < -1022 {
            v *= bitcast_f64(u64(0x0360000000000000))
            k = max(k + 969, -1022)
        }
    }
    v * bitcast_f64(u64(k + 1023) << 52)
}

/// e to the power `x`.
pub fn exp_f64(x: f64) -> f64 {
    if x != x {
        return x
    }
    if x > 709.782712893383973096 {
        return 1.0 / 0.0
    }
    if x < -745.13321910194110842 {
        return 0.0
    }
    let ax = abs(x)
    var k: i32 = 0
    var hi = x
    var lo = 0.0
    var r = x
    if ax > 0.5 * 0.693147180559945286227 {
        if ax >= 1.5 * 0.693147180559945286227 {
            k = i32(D_INV_LN2 * x + if x < 0.0 { -0.5 } else { 0.5 })
        } else {
            k = if x < 0.0 { -1 } else { 1 }
        }
        hi = x - f64(k) * D_LN2_HI
        lo = f64(k) * D_LN2_LO
        r = hi - lo
    } else if ax <= 0.0000000037252902984619141 {
        return 1.0 + x
    }
    let xx = r * r
    let c = r - xx * (D_P1 + xx * (D_P2 + xx * (D_P3 + xx * (D_P4 + xx * D_P5))))
    let y = 1.0 + (r * c / (2.0 - c) - lo + hi)
    if k == 0 {
        y
    } else {
        d_scaled(y, k)
    }
}

/// `a` as two halves of 26 bits (Veltkamp's split), for exact products.
fn d_split(a: f64) -> (f64, f64) {
    let c = 134217729.0 * a
    let hi = c - (c - a)
    (hi, a - hi)
}

/// `a * b`, and its rounding error: the two sum to the exact product (Dekker).
fn d_two_product(a: f64, b: f64) -> (f64, f64) {
    let p = a * b
    let (ah, al) = d_split(a)
    let (bh, bl) = d_split(b)
    (p, ((ah * bh - p) + ah * bl + al * bh) + al * bl)
}

/// `a + b`, and its rounding error (Knuth).
fn d_two_sum(a: f64, b: f64) -> (f64, f64) {
    let s = a + b
    let bb = s - a
    (s, (a - (s - bb)) + (b - bb))
}

/// The natural logarithm of a positive, finite `x`, as two f64s whose sum is within about 2^-62
/// of it, relatively: log's reduction to 2^k (1 + f), with f - f²/2 and the sum carried exactly.
fn d_log_parts(x: f64) -> (f64, f64) {
    var bits = bitcast_u64(x)
    var hx = u32(bits >> 32)
    var k: i32 = 0
    if hx < 0x00100000 {
        // A subnormal: scaled up by 2^54 first.
        k -= 54
        bits = bitcast_u64(x * 18014398509481984.0)
        hx = u32(bits >> 32)
    }
    hx += 0x3ff00000 - 0x3fe6a09e
    k += i32(hx >> 20) - 0x3ff
    hx = (hx & 0x000fffff) + 0x3fe6a09e
    let m = bitcast_f64((u64(hx) << 32) | (bits & 0xffffffff))
    let f = m - 1.0
    let (ff, ffe) = d_two_product(f, f)
    let hfsq = 0.5 * ff
    let s = f / (2.0 + f)
    let z = s * s
    let w = z * z
    let t1 = w * (D_LG2 + w * (D_LG4 + w * D_LG6))
    let t2 = z * (D_LG1 + w * (D_LG3 + w * (D_LG5 + w * D_LG7)))
    let dk = f64(k)
    let small = s * (hfsq + t2 + t1) + dk * D_LN2_LO
    let (a, ae) = d_two_sum(f, -hfsq)
    let (b, be) = d_two_sum(dk * D_LN2_HI, a)
    d_two_sum(b, be + ae - 0.5 * ffe + small)
}

/// The natural logarithm of `x`: minus infinity at 0, NaN below 0.
pub fn log_f64(x: f64) -> f64 {
    if x != x || x == 1.0 / 0.0 {
        return x
    }
    if x == 0.0 {
        return -1.0 / 0.0
    }
    if x < 0.0 {
        return (x - x) / (x - x)
    }
    let (hi, lo) = d_log_parts(x)
    hi + lo
}

/// log's two parts times `c` (in two parts too): the product rounded once.
fn d_log_times(x: f64, c: f64, c_lo: f64) -> f64 {
    if x != x || x == 1.0 / 0.0 || x <= 0.0 {
        return log_f64(x)
    }
    let (hi, lo) = d_log_parts(x)
    let (p, pe) = d_two_product(hi, c)
    p + (pe + hi * c_lo + lo * c)
}

/// The logarithm of `x` to base 10: minus infinity at 0, NaN below 0; exact at the powers of 10.
pub fn log10_f64(x: f64) -> f64 {
    d_log_times(x, D_INV_LN10, D_INV_LN10_LO)
}

/// The logarithm of `x` to base 2: minus infinity at 0, NaN below 0; exact at the powers of 2.
pub fn log2_f64(x: f64) -> f64 {
    d_log_times(x, D_INV_LN2, D_INV_LN2_LO)
}

/// `x` to the power `y`, for a positive, finite `x` and a finite `y`: an infinity past f64's
/// range, 0 below it. Its error is exp's, and log's 2^-62 times |y ln x|: within an ulp while
/// |y ln x| is below about 300, within two up to the overflow.
pub fn pow_f64(x: f64, y: f64) -> f64 {
    assert(x > 0.0 && x < 1.0 / 0.0, f"pow_f64 takes a positive, finite base, not {x}")
    if y == 0.0 || x == 1.0 {
        return 1.0
    }
    // The powers a correctly rounded libm gives exactly, given so: a section's squareness is
    // often held at 1 or 2, and its quadrants' floor is a power of two. Within an ulp of them,
    // fits that turn on the last bits went their own way (the wolf's hind leg, 62% of its
    // surface within 2 mm where the host's libm gave 84%).
    if y == 1.0 {
        return x
    }
    if y == 2.0 {
        return x * x
    }
    if y == -1.0 {
        return 1.0 / x
    }
    if y == 0.5 {
        return sqrt(x)
    }
    if x == 2.0 && y == trunc(y) && abs(y) <= 1000.0 {
        return d_scaled(1.0, i32(y))
    }
    let (hi, lo) = d_log_parts(x)
    // Past exp's range, the power is too: an infinity or 0, before the compensated product,
    // whose splits would overflow (y beyond 2^996 or so) and make a NaN of it.
    let rough = y * hi
    if rough > 710.0 {
        return 1.0 / 0.0
    }
    if rough < -746.0 {
        return 0.0
    }
    let (p, pe) = d_two_product(y, hi)
    let (q, qe) = d_two_sum(p, pe + y * lo)
    let e = exp_f64(q)
    // Overflowed or flushed to 0 at the boundary: the correction would make inf · 0 a NaN.
    if e == 1.0 / 0.0 || e == 0.0 {
        return e
    }
    e + e * qe
}

/// How many representable f64s apart `a` and `b` are, if they have one sign (else the most).
fn d_apart(a: f64, b: f64) -> u64 {
    let x = bitcast_u64(a)
    let y = bitcast_u64(b)
    if (x >> 63) != (y >> 63) {
        return if a == 0.0 && b == 0.0 { 0 } else { 18446744073709551615 }
    }
    if x > y { x - y } else { y - x }
}

@test
fn powers_past_the_range_are_infinite_or_zero() {
    let inf = 1.0 / 0.0
    let cases: [(f64, f64, f64); 9] = [
        (10.0, 400.0, inf),
        (2.0, 1025.0, inf),
        (2.0, 1e308, inf),
        (0.5, -1e308, inf),
        (10.0, -400.0, 0.0),
        (2.0, -1e308, 0.0),
        (0.5, 1e308, 0.0),
        (1.0000001, 1e300, inf),
        (1.0000001, -1e300, 0.0),
    ]
    for (x, y, want) in cases {
        let got = pow_f64(x, y: y)
        assert(got == want, f"{x}^{y}: {got}")
    }
    // Near the overflow and the subnormal boundaries, libm's (macOS's) values: to a bit, or two
    // where |y ln x| nears 709 (log's 2^-62 error, times y).
    let near: [(f64, f64, u64); 12] = [
        (10.0, 308.25, u64(0x7FEFA788589D81D3)),
        (10.0, -307.9, u64(0x00090D7A3A04564B)),
        (10.0, -310.0, u64(0x000012688B70E62B)),
        (10.0, -323.5, u64(0x0000000000000001)),
        (2.0, -1074.0, u64(0x0000000000000001)),
        (2.0, 1023.9, u64(0x7FEDDB680117AA8E)),
        (1.0000001, 7000000000.0, u64(0x7F0D941AE6E762D4)),
        (0.9999999, 7000000000.0, u64(0x00D14F03C6DBC57F)),
        (7.0, 364.7, u64(0x7FECAFF29E2D5797)),
        (7.0, -382.5, u64(0x0000000000000001)),
        (3.0, 646.0, u64(0x7FED906A378B5987)),
        (3.0, -679.0, u64(0x0000000000000000)),
    ]
    for (x, y, bits) in near {
        let got = pow_f64(x, y: y)
        assert(d_apart(got, bitcast_f64(bits)) <= 2, f"{x}^{y}: {got} against {bitcast_f64(bits)}")
    }
}

/// How many of `want`'s ulps `got` is from it.
fn d_ulps(got: f64, want: f64) -> f64 {
    abs(got - want) / max(abs(want) * 0.0000000000000002220446049250313, 0.0)
}

@test
fn the_f64_functions_are_within_an_ulp_of_their_values() {
    // Each against the nearest f64 to the true value.
    let cases = [
        (sin_f64(0.5), 0.479425538604203),
        (cos_f64(0.5), 0.8775825618903728),
        (sin_f64(TAU_F64 * 7.0 / 48.0), 0.7933533402912352),
        (cos_f64(100.0), 0.8623188722876839),
        (sin_f64(-3.0), -0.1411200080598672),
        (cos_f64(1000000.0), 0.9367521275331447),
        (atan2_f64(y: 1.0, x: 1.0), 0.7853981633974483),
        (atan2_f64(y: -1.0, x: -2.0), -2.677945044588987),
        (atan2_f64(y: 0.0, x: -1.0), PI_F64),
        (exp_f64(1.0), 2.718281828459045),
        (exp_f64(-700.0), 9.85967654375977e-305),
        (log_f64(10.0), 2.302585092994046),
        (log10_f64(2.0), 0.3010299956639812),
        (log10_f64(0.00007), -4.154901959985743),
        (log2_f64(10.0), 3.321928094887362),
        (log2_f64(1.5), 0.5849625007211562),
        (pow_f64(x: 2.0, y: 0.5), 1.4142135623730951),
        (pow_f64(x: 0.001, y: 3.5), 0.000000000031622776601683794),
        (pow_f64(x: 7.0, y: -2.25), 0.012546696999005395),
    ]
    for (got, want) in cases {
        assert(d_ulps(got, want) <= 1.0, f"{got} against {want}")
    }
    assert(sin_f64(0.0) == 0.0 && cos_f64(0.0) == 1.0 && exp_f64(0.0) == 1.0 && log_f64(1.0) == 0.0)
    assert(log10_f64(1000.0) == 3.0 && log10_f64(0.01) == -2.0 && log2_f64(1024.0) == 10.0)
    assert(log10_f64(0.0) == -1.0 / 0.0 && log2_f64(0.125) == -3.0)
    // Exact where the power is.
    let x = 0.123456789
    assert(pow_f64(x, y: 1.0) == x && pow_f64(x, y: 2.0) == x * x && pow_f64(x, y: -1.0) == 1.0 / x)
    assert(
        pow_f64(x, y: 0.5) == sqrt(x) &&
            pow_f64(2.0, y: -3.0) == 0.125 &&
            pow_f64(2.0, y: 10.0) == 1024.0,
    )
}

/// How far `got` is from `want`, in units in the last place of an f32 at `want` (below the least
/// normal f32, the subnormals' step): 0 where both are the same infinity, or both NaNs. What
/// `STRICT_ULPS` measures.
pub fn f32_ulps(got: f32, want: f64) -> f64 {
    if got != got && want != want {
        return 0.0
    }
    let g = f64(got)
    if g == want {
        return 0.0
    }
    let w = abs(want)
    // At or past the largest f32 and half its ulp, the value rounds to an infinity.
    if w >= 340282356779733661637539395458142568448.0 {
        // Past the largest f32 by more than its rounding: an infinity, or off by everything.
        return if abs(g) > 340282346638528859811704183484516925440.0 && (g > 0.0) == (want > 0.0) {
            0.0
        } else {
            1.0 / 0.0
        }
    }
    // The ulp: 2^(e - 23) for want's exponent e, at least 2^-149.
    var ulp = 0.00000000000000000000000000000000000000000000140129846432481707092
    var p = 1.0
    if w >= 0.0000000000000000000000000000000000000117549435082228750797 {
        let e = i32((bitcast_u64(w) >> 52) & 2047) - 1023
        ulp = bitcast_f64(u64(e - 23 + 1023) << 52)
        p = 0.0
    }
    let _ = p
    abs(g - want) / ulp
}

/// sin and cos of an f32 in f64, for a test: by `sin_f64` and `cos_f64` where they hold, and
/// beyond by 2/π's bits (an integer reduction, to 62 bits).
fn sin_cos_reference(x: f32) -> (f64, f64) {
    if !is_finite(x) {
        let nan = f64(x - x)
        return (nan, nan)
    }
    if abs(x) < 1000000.0 {
        return (sin_f64(f64(x)), cos_f64(f64(x)))
    }
    let xi = bitcast_u32(x)
    let k = (xi >> 26) & 15
    let m = ((xi & 0x7fffff) | 0x800000) << ((xi >> 23) & 7)
    var r = (u64(m.wrapping_mul(REF_INV_PIO4[k])) << 32) |
        ((u64(m) * u64(REF_INV_PIO4[k + 8])) >> 32)
    r = r.wrapping_add(u64(m) * u64(REF_INV_PIO4[k + 4]))
    let n = r.wrapping_add(0x2000000000000000) >> 62
    r = r.wrapping_sub(n << 62)
    let y = f64(i64(r)) * 0.00000000000000000034061215800865545
    let q = if x < 0.0 { (4 - u32(n)) & 3 } else { u32(n) }
    let yy = if x < 0.0 { -y } else { y }
    let (s, c) = (sin_f64(yy), cos_f64(yy))
    if q == 0 {
        (s, c)
    } else if q == 1 {
        (c, -s)
    } else if q == 2 {
        (-s, -c)
    } else {
        (-c, s)
    }
}

// 4/π's bits for `sin_cos_reference`, each entry the 32 after the previous one's first 8
// (ARM's optimized-routines' `__inv_pio4`, MIT licence).
const REF_INV_PIO4: [u32; 24] = [
    0xa2, 0xa2f9, 0xa2f983, 0xa2f9836e, 0xf9836e4e, 0x836e4e44, 0x6e4e4415, 0x4e441529, 0x441529fc,
    0x1529fc27, 0x29fc2757, 0xfc2757d1, 0x2757d1f5, 0x57d1f534, 0xd1f534dd, 0xf534ddc0, 0x34ddc0db,
    0xddc0db62, 0xc0db6295, 0xdb629599, 0x6295993c, 0x95993c43, 0x993c4390, 0x3c439041,
]

/// Function `k` of `STRICT_ULPS`'s list at `x` (`y` the second argument of `atan2` and `pow`),
/// and its value in f64 by the f64 functions: what the errors are measured against.
pub fn strict_and_reference(k: u32, x: f32, y: f32) -> (f32, f64) {
    let xd = f64(x)
    if k == 0 {
        (sin(x), sin_cos_reference(x).0)
    } else if k == 1 {
        (cos(x), sin_cos_reference(x).1)
    } else if k == 2 {
        let (s, c) = sin_cos_reference(x)
        (tan(x), s / c)
    } else if k == 3 {
        (exp(x), exp_f64(xd))
    } else if k == 4 {
        (exp2(x), pow_f64(2.0, xd))
    } else if k == 5 {
        (log(x), if x > 0.0 { log_f64(xd) } else if x == 0.0 { -1.0 / 0.0 } else {
            (xd - xd) / (xd - xd)
        })
    } else if k == 6 {
        (log2(x), if x > 0.0 { log2_f64(xd) } else if x == 0.0 { -1.0 / 0.0 } else {
            (xd - xd) / (xd - xd)
        })
    } else if k == 7 {
        let e = exp_f64(abs(xd))
        let v = if abs(xd) < 0.001 { xd * (1.0 + xd * xd / 6.0) } else { 0.5 * (e - 1.0 / e) }
        (sinh(x), if x < 0.0 && abs(xd) >= 0.001 { -v } else { v })
    } else if k == 8 {
        let e = exp_f64(abs(xd))
        (cosh(x), 0.5 * (e + 1.0 / e))
    } else if k == 9 {
        let e = exp_f64(2.0 * min(abs(xd), 40.0))
        let v = if abs(xd) < 0.001 { xd * (1.0 - xd * xd / 3.0) } else { (e - 1.0) / (e + 1.0) }
        (tanh(x), if x < 0.0 && abs(xd) >= 0.001 { -v } else { v })
    } else if k == 10 {
        (atan(x), atan_f64(xd))
    } else if k == 11 {
        (asin(x), atan2_f64(xd, sqrt((1.0 - xd) * (1.0 + xd))))
    } else if k == 12 {
        (acos(x), atan2_f64(sqrt((1.0 - xd) * (1.0 + xd)), xd))
    } else if k == 13 {
        (atan2(x, y), atan2_f64(xd, f64(y)))
    } else {
        // pow_f64 takes a positive, finite base: a negative one's whole powers by its
        // magnitude's, signed; zeros, infinities and NaNs are exact values (`pow`'s own,
        // which `std_math_edges_match_c` holds to C's).
        let yd = f64(y)
        let r = if is_finite(x) && is_finite(y) && x > 0.0 {
            pow_f64(xd, yd)
        } else if is_finite(x) && is_finite(y) && x < 0.0 && floor(y) == y {
            let m = pow_f64(-xd, yd)
            if is_odd(y) { -m } else { m }
        } else {
            f64(pow(x, y))
        }
        (pow(x, y), r)
    }
}

@test
fn the_f32_functions_are_within_their_errors_where_sampled() {
    // 4096 arguments of each, spread over every exponent (a fixed sequence of bits), and the
    // arguments where each is hardest near: small, near π/4's multiples, near overflow.
    var s: u32 = 12345
    for k in 0..15 {
        var worst = 0.0
        for i in 0..4096 {
            s = s.wrapping_mul(1664525).wrapping_add(1013904223)
            var x = bitcast_f32(s)
            s = s.wrapping_mul(1664525).wrapping_add(1013904223)
            var y = bitcast_f32((s & 0x807fffff) | 0x3f000000) * 8.0
            // A debug build traps where a NaN is made from numbers: each within its domain.
            if !is_finite(x) {
                x = 0.5
            }
            if k == 5 || k == 6 {
                x = abs(x)
            }
            if k == 14 {
                // pow of a positive base, to powers whose results stay finite.
                x = abs(x) % 4.0 + 0.001
            }
            if k == 11 || k == 12 {
                x = x % 1.0
            }
            let (got, want) = strict_and_reference(k, x, y)
            let u = f32_ulps(got, want)
            assert(
                u <= f64(STRICT_ULPS[k]),
                f"function {k} at {x} ({y}): {got} against {want}, {u} ulps",
            )
            worst = max(worst, u)
        }
        assert(worst >= 0.0)
    }
    assert(sin(0.0) == 0.0 && cos(0.0) == 1.0 && exp(0.0) == 1.0 && log(1.0) == 0.0)
    assert(exp2(10.0) == 1024.0 && log2(1024.0) == 10.0 && pow(x: 2.0, y: 0.5) == sqrt(2.0))
}

