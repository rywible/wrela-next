// Counts in place of looking, over a frame's picture as the listers left it: holes between a
// body's parts. A pixel nothing drew is a hole where charts of the same body are drawn within two
// pixels either side of it, left and right and above and below, at about the same depth: sky
// seen through a seam between parts that join (a finger's root and its palm), not past a body's
// outline or at the tip of a wedge of sky between two limbs. Added up frame
// after frame into a buffer, read when asked.

use frame::picture::{CHART, body_of, kind_of}
use std::gpu::{Atomics, DepthTexture, GlobalId, GpuBuffer, R32Uint, Texture, buffer, dispatch, read}
use std::io::{Pending, print}

/// How far either side of a pixel a hole's sides are looked for (px), and how far apart their
/// depths may be (of the nearer's distance).
pub const SIDE: i32 = 2
pub const APART: f32 = 0.04

/// What `holes` counts: 0 pixels a chart drew, 1 holes, 2 frames.
pub const COUNTED: u32 = 3

/// The nearest chart pixel from (`x`, `y`) along (`dx`, `dy`) within `SIDE` px: its identity's
/// body + 1 (0 for none) and how far along the view it is (over the near plane).
fn side_of(
    identity: Texture<R32Uint>,
    depth: DepthTexture,
    x: i32,
    y: i32,
    dx: i32,
    dy: i32,
) -> vec2 {
    let w = i32(depth.width())
    let h = i32(depth.height())
    var out = vec2(0.0)
    for k in 1..SIDE + 1 {
        let px = x + dx * k
        let py = y + dy * k
        if out.x == 0.0 && px >= 0 && py >= 0 && px < w && py < h {
            let d = depth.load(u32(px), u32(py))
            let id = identity.load(u32(px), u32(py))
            if d > 0.0 && kind_of(id) == CHART {
                out = vec2(f32(body_of(id) + 1), 1.0 / d)
            }
        }
    }
    out
}

/// Each pixel of a frame's picture counted (`COUNTED`): one a chart drew, or a hole (nothing
/// drawn there, and one body's charts both sides of it across and down at about the same depth).
@compute(8, 8)
pub fn holes(identity: Texture<R32Uint>, depth: DepthTexture, out: mut Atomics<u32>, id: GlobalId) {
    if id.x >= depth.width() || id.y >= depth.height() {
        return
    }
    if id.x == 0 && id.y == 0 {
        let _ = out.add(i: 2, value: 1)
    }
    let x = i32(id.x)
    let y = i32(id.y)
    if depth.load(id.x, id.y) > 0.0 {
        if kind_of(identity.load(id.x, id.y)) == CHART {
            let _ = out.add(i: 0, value: 1)
        }
        return
    }
    // (Shut in across and down: the tip of a wedge of sky between two limbs is open one way.)
    var shut = 0
    for axis in 0..2 {
        let dx = if axis == 0 { 1 } else { 0 }
        let dy = 1 - dx
        let a = side_of(identity, depth, x, y, dx, dy)
        let b = side_of(identity, depth, x, y, -dx, -dy)
        // (Depths reversed: `1 / depth` is distance over the near plane, the same share.)
        if a.x > 0.0 && a.x == b.x && abs(a.y - b.y) < APART * min(a.y, b.y) {
            shut += 1
        }
    }
    let hole = shut == 2
    if hole {
        let _ = out.add(i: 1, value: 1)
    }
}

/// The holes counted frame after frame, and the reading of them asked for.
pub struct Holes {
    counts: GpuBuffer<u32>,
    asked: Option<Pending<u32>>,
}

pub fn counter() -> Holes {
    Holes { counts: buffer(COUNTED), asked: None }
}

impl Holes {
    /// A frame's picture (`identity`, `depth`) counted, added to the frames before.
    pub fn count(mut self, identity: Texture<R32Uint>, depth: DepthTexture) {
        let w = depth.width()
        let h = depth.height()
        dispatch(
            holes.bind(identity: identity, depth: depth, out: mut self.counts),
            groups: ((w + 7) / 8, (h + 7) / 8, 1),
        )
    }

    /// The counts asked for: said once they're read back (`heard`).
    pub fn ask(mut self) {
        self.asked = Some(read(self.counts.items()))
    }

    /// The counts said, once read back.
    pub fn heard(mut self) {
        match mut self.asked {
            Some(p) => match p.poll() {
                Some(Ok(v)) => {
                    print(
                        f"holes: {v[1]} pixels of sky inside a body's charts, over {v[2]} frames ({v[0]} pixels of charts drawn)",
                    )
                    self.asked = None
                },
                _ => {},
            },
            None => {},
        }
    }
}
