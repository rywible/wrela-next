// How finely a chart is drawn: a grid of quads over its two numbers, as many along it and round
// it as keep each quad within so many pixels on the screen where the chart is nearest the eye.
// Its vertices are numbered along first: vertex (i, j) is `i * (round + 1) + j`, its place `i`
// quads along and `j` round. The grid is drawn as two triangles a quad with no index buffer: the
// vertex program finds its vertex from its number (`corner_of`).

use frame::eye::Eye
use std::math::TAU

/// The counts of quads a grid takes along a chart or round it: the least of these that keeps its
/// quads within the pixels asked, or the most. (A few counts, so a grid changes seldom as the eye
/// moves, and by enough to matter when it does.)
pub const COUNTS: [u32; 11] = [4, 6, 8, 12, 16, 24, 32, 48, 64, 96, 128]

/// The least count of `COUNTS` at least `need` and no less than `least`, or the most.
pub fn count_for(need: f32, least: u32) -> u32 {
    var out = COUNTS[10]
    for k in 0..11 {
        let c = COUNTS[10 - k]
        if f32(c) >= need && c >= least {
            out = c
        }
    }
    out
}

/// How many pixels a metre is, `z` m along `eye`'s view.
pub fn pixels_a_metre(eye: Eye, z: f32) -> f32 {
    1.0 / (eye.pixel() * max(z, eye.near))
}

/// How far a chord of a circle `r` px round may lie inside it (px): a polygon of such chords
/// holds a form's outline to within this.
pub const SAG: f32 = 0.1

/// How many chords round a circle `r` px round keep within `sag` px of it.
pub fn round_for(r: f32, sag: f32) -> f32 {
    if r <= sag {
        return 3.0
    }
    3.14159265 / acos(1.0 - sag / r)
}

/// A grid's quads (along, round) for a chart `length` m along and `round` of a turn round a
/// form `radius` m across at most, nearest the eye `z` m along its view: along it, each quad at
/// most `quad.x` px; round it, as many as hold its outline within `quad.y` px (`SAG`).
pub fn grid_for(
    eye: Eye,
    length: f32,
    radius: f32,
    round: f32,
    z: f32,
    quad: vec2,
    least: vec2u,
) -> vec2u {
    let px = pixels_a_metre(eye, z)
    vec2u(
        count_for(length * px / quad.x, least.x),
        count_for(round_for(radius * px, quad.y) * round, least.y),
    )
}

/// How many vertices a grid of `quads` has.
pub fn vertices_of(quads: vec2u) -> u32 {
    (quads.x + 1) * (quads.y + 1)
}

/// How many triangles' corners a grid of `quads` is drawn with.
pub fn corners_of(quads: vec2u) -> u32 {
    quads.x * quads.y * 6
}

/// A quad's corners as two triangles, along then round: (0, 0), (1, 0), (1, 1) and (0, 0),
/// (1, 1), (0, 1). Seen from outside a closed form (angles growing to the left of the way
/// along), each winds counter-clockwise.
const CORNER_I: [u32; 6] = [0, 1, 1, 0, 1, 0]
const CORNER_J: [u32; 6] = [0, 0, 1, 0, 1, 1]

/// The vertex triangle corner `v` of a grid of `quads` is at: its number, `i * (round + 1) + j`.
pub fn corner_of(v: u32, quads: vec2u) -> u32 {
    let quad = v / 6
    let k = v % 6
    let i = quad / quads.y + CORNER_I[k]
    let j = quad % quads.y + CORNER_J[k]
    i * (quads.y + 1) + j
}

/// Where vertex `n` of a grid of `quads` is on a chart's band, from `lo` to `hi`: how far
/// along and how far round.
pub fn place_of(n: u32, quads: vec2u, lo: vec2, hi: vec2) -> vec2 {
    let i = n / (quads.y + 1)
    let j = n % (quads.y + 1)
    mix(lo, hi, vec2(f32(i) / f32(quads.x), f32(j) / f32(quads.y)))
}

/// The girth of a form whose mean radius is at most `radius` (m).
pub fn girth_of(radius: f32) -> f32 {
    TAU * radius
}

@test
fn a_grid_is_as_fine_as_its_pixels_ask() {
    assert(count_for(5.0, 4) == 6)
    assert(count_for(6.0, 4) == 6)
    assert(count_for(0.5, 8) == 8)
    assert(count_for(1000.0, 4) == 128)
    // Its last quad's far corner is its last vertex, and that quad's last triangle ends where
    // it starts round, one along.
    let q = vec2u(3, 4)
    assert(corner_of(corners_of(q) - 4, q) == vertices_of(q) - 1)
    assert(corner_of(corners_of(q) - 1, q) == 2 * 5 + 4)
    assert(corner_of(0, q) == 0 && corner_of(2, q) == 6)
    let p = place_of(vertices_of(q) - 1, q, vec2(0.1, 0.0), vec2(0.9, 2.0))
    assert(abs(p.x - 0.9) < 1.0e-6 && abs(p.y - 2.0) < 1.0e-6)
}
