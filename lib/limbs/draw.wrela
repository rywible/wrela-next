// A posed piece drawn into the frame's picture: its grid's triangles, opaque, each pixel shaded
// once (this GPU removes hidden surfaces before it shades opaque triangles), writing the
// picture's four targets as docs/frame.md says: colour by the one shading function and the
// piece's look, the edge record, identity, and the triangles' own depth.
//
// The light's normal: a limb-sized piece carries it from vertex to vertex, where it was worked
// out from the smoothed form (`placed`); where a fold, a cap or a grown place blends the side's
// own normal in, and on a wide piece everywhere, the pixel reads it from the smoothed form at its
// own place (docs/dead-ends.md: carried, a wide piece's band edges move by pixels).
//
// The edge record: the nearest of the piece's outline, where its surface turns from the eye (the
// squared facing of the drawn grid's own normal, laid from its corners: `frame::outline`), its
// band's open ends, its cover's edge and its look's cut. None is searched for on the screen.

use chart::cover::inside
use chart::grown::COVERLESS
use chart::limb::normal_at
use chart::part::sunk_by
use chart::radial::Radial
use form::look::{Place, Skin}
use form::shade::{MOST_LIGHTS, Steps}
use frame::eye::Eye
use frame::light::{Lighting, worn}
use frame::outline::{fold_field, way_to_outline}
use frame::picture::{CHART, EDGE_REACH, NO_EDGE, edge_record, identity}
use grid::corner_of
use placed::{Part, Placed}
use form::kinds::Paint
use frame::last::painted
use std::gpu::{ClipPosition, Flat, FragCoord, Targets2, Targets3, VertexIndex, discard}
use worn::{UNCUT, Worn}

/// What a corner passes to the pixels between it and the others: as `Placed`, and which part.
pub struct Seen: Copy {
    pub clip: ClipPosition,
    pub world: vec3,
    pub rest: vec3,
    pub place: vec2,
    pub normal: vec3,
    pub own: f32,
    pub light: vec3,
    pub up: vec3,
    pub left: vec3,
    /// The outline's field at its corners, laid linearly between them
    /// (`frame::outline::fold_field` of the drawn grid's own normal there): its outline is
    /// where this is 0, and it falls evenly with the distance to it near it.
    pub field: f32,
    pub part: Flat<u32>,
}

/// `v` scaled to length 1 (held where it's next to nothing).
pub fn unit(v: vec3) -> vec3 {
    v / max(length(v), 1.0e-9)
}

/// Vertex (`i`, `j`) of part `p`'s grid, where it is: round a closed form its grid closes on
/// itself; along it, held at its ends.
fn grid_at(p: Part, placed: [Placed], i: i32, j: i32) -> vec3 {
    let round = i32(p.round)
    let wraps = p.band.theta.y - p.band.theta.x >= 6.283
    let jj = if wraps { ((j % round) + round) % round } else { clamp(j, 0, round) }
    let ii = clamp(i, 0, i32(p.along))
    placed[p.base + u32(ii) * (p.round + 1) + u32(jj)].at
}

/// Corner `v` of part `part`'s grid, seen by `eye`, with the outline's field there: the squared
/// facing of the drawn grid's own normal (across its neighbours along and round, so it knows the
/// path's bend, the folds and the caps as drawn).
@vertex
pub fn corner(v: VertexIndex, eye: Eye, part: u32, parts: [Part], placed: [Placed]) -> Seen {
    let p = parts[part]
    let k = corner_of(v.index, vec2u(p.along, p.round))
    let q = placed[p.base + k]
    // (Drawn under what's over it: pushed from the eye along its line of sight.)
    let by = sunk_by(p.under, q.f)
    let i = i32(k / (p.round + 1))
    let j = i32(k % (p.round + 1))
    let along = grid_at(p, placed, i + 1, j) - grid_at(p, placed, i - 1, j)
    let round = grid_at(p, placed, i, j + 1) - grid_at(p, placed, i, j - 1)
    var drawn = cross(along, round)
    // (Where the grid closes to a point, its neighbours round it are one: its side's own.)
    if dot(drawn, drawn) < 1.0e-16 {
        drawn = q.normal
    }
    let n = unit(drawn)
    let at = q.at
    Seen {
        clip: ClipPosition { position: eye.clip(at + unit(at - eye.at) * by) },
        world: at,
        rest: q.rest,
        place: vec2(q.f, q.theta),
        normal: q.normal,
        own: q.own,
        light: q.light,
        up: q.up,
        left: q.left,
        field: fold_field(n, unit(eye.at - at)),
        part: Flat { value: part },
    }
}

/// The way from a pixel's middle to the line where `v` (over 0 at the pixel) falls to 0, from
/// how it changes a pixel across (`g.x`) and down (`g.y`): `NO_EDGE` past `EDGE_REACH`, or where
/// it doesn't change. A pixel just past the line (`v` under 0, which a triangle's corners
/// between them can leave inside the line) has it through its middle.
pub fn way_to(v: f32, g: vec2) -> vec2 {
    let gg = dot(g, g)
    if !(gg > 1.0e-30) {
        return NO_EDGE
    }
    let e = g * (-max(v, 0.0) / gg)
    if v <= 0.0 {
        // (Through its middle, the way the value falls.)
        return g * (-0.001 / sqrt(gg))
    }
    if dot(e, e) > EDGE_REACH * EDGE_REACH { NO_EDGE } else { e }
}

/// The nearer of two ways.
pub fn nearer(a: vec2, b: vec2) -> vec2 {
    if dot(a, a) <= dot(b, b) { a } else { b }
}

/// The way to `v`'s zero line, by its own change across the pixels.
pub fn line(v: f32) -> vec2 {
    way_to(v, vec2(dpdx(v), dpdy(v)))
}

/// A pixel of a piece's picture, with the light's normal `n` and the side's own normal `geo`
/// (both unit, out of its outside): which face is seen, what it wears there, its cuts, its
/// edge, its colour, its identity. `p` is its part, `look` what it wears, `covers` its cover's
/// edges (`chart::cover::Cover::edges`; anything where it has none).
pub fn texels<L: Worn>(
    s: Seen,
    p: Part,
    n: vec3,
    geo: vec3,
    eye: Eye,
    light: Lighting,
    look: L,
    covers: [f32],
    cuts: bool,
    lights: u32 = MOST_LIGHTS,
) -> Targets3<vec4, vec4, u32> {
    let world = s.world
    let across = dpdx(world)
    let down = dpdy(world)
    let toward = unit(eye.at - world)
    // Which face is seen: the triangle's own plane, as the screen's axes lie on it, faces the
    // eye; the side's normal agrees with it on the outside.
    let facing_eye = cross(down, across)
    let outside = p.faces < 2 || dot(geo, facing_eye) >= 0.0
    let px = 0.5 * (length(dpdx(s.rest)) + length(dpdy(s.rest)))
    let place = Place { world, rest: s.rest, chart: Some(s.place), normal: n }
    var normal = n
    var skin: Skin = look.worn(place, px)
    if !outside {
        if look.lined(place) {
            normal = -n
            skin = look.lining(Place { normal: -n, ..place }, px)
        }
    }
    // Where it's cut away, by its look and by its cover. (Only a piece that can be cut asks:
    // a pixel that may be dropped is shaded whether or not it's hidden, as this GPU can't tell
    // it's hidden before it runs.)
    var kept = UNCUT
    var covered = UNCUT
    if cuts {
        kept = look.kept(place)
        if p.cover != COVERLESS {
            covered = inside(covers, s.place.x, s.place.y, at: p.cover)
        }
        if kept < 0.0 || covered < 0.0 {
            discard()
        }
    }
    // Its edge: its outline (the field's zero, from its face), its band's open ends, its cuts.
    let fx = dpdx(s.field)
    let fy = dpdy(s.field)
    var way = way_to_outline(s.field, vec2(fx, fy))
    way = nearer(way, line(if p.caps.x > 0.0 { UNCUT } else { s.place.x - p.band.f.x }))
    way = nearer(way, line(if p.caps.y > 0.0 { UNCUT } else { p.band.f.y - s.place.x }))
    // (A sheet's band ends round it too; a limb's goes the whole way round.)
    let sheet = p.wide == 2
    way = nearer(way, line(if sheet { s.place.y - p.band.theta.x } else { UNCUT }))
    way = nearer(way, line(if sheet { p.band.theta.y - s.place.y } else { UNCUT }))
    way = nearer(way, line(kept))
    way = nearer(way, line(covered))
    let steps = Steps {
        across,
        down,
        normal_across: dpdx(normal),
        normal_down: dpdy(normal),
        relief: vec2(dpdx(skin.relief), dpdy(skin.relief)),
    }
    let colour = worn(light, skin, world, normal, toward, steps, live: lights).colour
    Targets3 {
        first: vec4(colour, 0.0),
        second: edge_record(way, look.ink(), skin.line),
        third: identity(CHART, p.body, p.group),
    }
}

/// A pixel of a limb-sized or wide piece (`parts`, each one's look in `looks`): its light's
/// normal carried from its vertices, or read here from its smoothed form (`shades` for the
/// limb-sized, `wide_shades` for the wide, by its limb) where it's wide or where its vertices
/// blend in their side's own; lit by at most `lights` live lights (`form::shade::lit`'s `live`).
@fragment
pub fn shade<L: Worn, const A: u32, const R: u32, const B: u32, const T: u32>(
    s: Seen,
    eye: Eye,
    light: Lighting,
    parts: [Part],
    looks: [L],
    shades: [Radial<A, R>],
    wide_shades: [Radial<B, T>],
    covers: [f32],
    cuts: const bool,
    lights: const u32,
) -> Targets3<vec4, vec4, u32> {
    let k = s.part.value
    let p = parts[k]
    let geo = unit(s.normal)
    let own = saturate(s.own)
    var n = unit(s.light)
    if p.wide == 1 {
        let read = normal_at(wide_shades[p.limb], s.up, s.left, p.length, s.place.x, s.place.y)
        n = unit(mix(read, geo, vec3(own)))
    } else if own > 0.0005 || p.read == 1 {
        let read = normal_at(shades[p.limb], s.up, s.left, p.length, s.place.x, s.place.y)
        n = unit(mix(read, geo, vec3(own)))
    }
    texels(s, p, n, geo, eye, light, looks[p.look], covers, cuts, lights)
}

/// A pixel of a piece as a reference's look takes it (`limbs::Limbs::reference`): its colour and
/// the way its surface faces (`frame::judge`). Its light is read at the pixel, as `shade`'s.
@fragment
pub fn shade_look<L: Worn, const A: u32, const R: u32, const B: u32, const T: u32>(
    s: Seen,
    eye: Eye,
    light: Lighting,
    parts: [Part],
    looks: [L],
    shades: [Radial<A, R>],
    wide_shades: [Radial<B, T>],
    covers: [f32],
) -> Targets2<vec4, vec4> {
    let k = s.part.value
    let p = parts[k]
    let geo = unit(s.normal)
    let own = saturate(s.own)
    var n = geo
    if p.wide == 1 {
        let read = normal_at(wide_shades[p.limb], s.up, s.left, p.length, s.place.x, s.place.y)
        n = unit(mix(read, geo, vec3(own)))
    } else {
        let read = normal_at(shades[p.limb], s.up, s.left, p.length, s.place.x, s.place.y)
        n = unit(mix(read, geo, vec3(own)))
    }
    let t = texels(s, p, n, geo, eye, light, looks[p.look], covers, cuts: true)
    Targets2 { first: t.first, second: vec4(geo, 0.0) }
}

/// The sky where a reference's look meets nothing: what `sky` shows along each pixel's ray.
@fragment
pub fn sky_look<P: Paint>(pixel: FragCoord, eye: Eye, sky: P) -> Targets2<vec4, vec4> {
    Targets2 { first: vec4(painted(eye, sky, eye.ray(pixel.position.xy)), 1.0), second: vec4(0.0) }
}
