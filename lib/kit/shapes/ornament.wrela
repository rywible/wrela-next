// Ornament: motifs, and the rules by which they repeat (AGENTS.md, "The vocabulary ladder": rung
// 4). Real ornament is mostly a few motifs under symmetry: a leaf mirrored about its midrib, a
// bead and a reel repeated along a moulding, a petal turned about a rosette's centre. So a motif
// here is a carving (`carve::Carving`, blades and grooves), and these place it:
//
//   mirrored(m)              m and its image across s = 0 (a leaf about its midrib)
//   row(m, period, count)    m repeated along s every `period` m, `count` times centred on 0, or
//                            without end (count 0, as round a turned part, where the period
//                            divides the circumference); every other one mirrored if `alternate`
//                            (a running scroll)
//   ring(m, n)               m turned about (0, 0) n times (a rosette's petals)
//   set(m, at, turn, size)   m moved to `at`, turned `turn` rad and scaled `size` within the face
//   pair(a, b)               both, the prouder standing (a motif and its border)
//
// and these build the classical motifs from a few numbers each, all in metres:
//
//   acanthus(length, width, height, curl)   a leaf of three lobes a side, veined, mirrored
//   bead_and_reel(bead, reel, height)       one cell: an oval bead and two thin reels
//   egg_and_dart(egg, height)               one cell: an egg in its shell, and a dart
//   rosette(radius, petals, height)         petals round a boss
//   scroll(period, span, height)            one wave of a running scroll: stem, leaves, buds
//   flute(length, width, depth)             one fluting's groove, along t
//
// A repeat reads the motif in the cell a point is in, alone: a motif keeps within its cell (half a
// period either side of its centre, or its sector of a ring), as a carver lays a repeat out.
// Motifs that reach over each other are two rows, `pair`ed. (Reading the next cell too doubled
// every repeat's code, which a carved table's shaders could not hold.)

use shapes::carve::{Carving, Cuts, Motif, Raised, blade, carving, cuts, groove, raised}
use std::cmp::Eq
use std::hash::StateHash

/// Two motifs' heights at one place, as carving leaves them: where either cuts below the ground,
/// the deeper cut; else the prouder.
pub fn joined(a: f32, b: f32) -> f32 {
    if min(a, b) < 0.0 { min(a, b) } else { max(a, b) }
}

/// A motif and its image across s = 0.
pub struct Mirrored<M>: Copy + GpuData + Eq + StateHash {
    pub motif: M,
}

/// `motif` mirrored across s = 0 (`Mirrored`).
pub fn mirrored<M: Motif>(motif: M) -> Mirrored<M> {
    Mirrored { motif }
}

impl<M: Motif> Motif for Mirrored<M> {
    fn height(self, st: vec2) -> f32 {
        self.motif.height(vec2(abs(st.x), st.y))
    }

    fn slope(self) -> f32 {
        self.motif.slope()
    }
}

/// A motif repeated along s (`row`).
pub struct Row<M>: Copy + GpuData + Eq + StateHash {
    pub motif: M,
    pub period: f32,
    /// How many, centred on s = 0; 0 for no end.
    pub count: u32,
    pub alternate: bool,
    /// How far a carver's hand wanders from one to the next (0 exact): each is shifted up to a
    /// fifth of this share of a period along s and across t, and sized up to an eighth of it
    /// larger or smaller, by a hash of its place in the row.
    pub wander: f32,
    /// Optional wrap modulus (> 0 on round turned parts) so cell IDs wrap identically across the
    /// `atan2 = ±π` seam and wandering reliefs never tear at the back of a leg or column.
    pub wrap: u32,
}

/// `motif` every `period` m along s, `count` times centred on s = 0 (0: without end), every other
/// one mirrored across its own centre if `alternate`, each a little different as a hand makes it
/// if `wander` (`Row::wander`), optionally wrapping cell IDs modulo `wrap` around a cylinder.
pub fn row<M: Motif>(
    motif: M,
    period: f32,
    count: u32 = 0,
    alternate: bool = false,
    wander: f32 = 0.0,
    wrap: u32 = 0,
) -> Row<M> {
    Row { motif, period, count, alternate, wander: clamp(wander, 0.0, 1.0), wrap }
}

/// A number in [-1, 1] from a cell of a row and a stream, the same everywhere.
fn unit_of(k: f32, stream: u32) -> f32 {
    let h = std::field::hash_u32(
        u32(i32(k) + 65536).wrapping_mul(747796405).wrapping_add(stream.wrapping_mul(2891336453)),
    )
    f32(h >> 8) * (2.0 / 16777216.0) - 1.0
}

impl<M: Motif> Motif for Row<M> {
    /// The motif in the cell `st` is in: cell `k` of `count` is centred `(k - (count - 1) / 2)`
    /// periods along s (without end, `k` periods). Any hand `wander` tapers to 0 at cell edges
    /// (`cos(π s / period)`), so a continuous running stem stays unbroken from cell to cell while
    /// each repeat's belly, curl and depth vary naturally as a carver's hand leaves them.
    fn height(self, st: vec2) -> f32 {
        let middle = if self.count > 0 { 0.5 * f32(self.count - 1) } else { 0.0 }
        var k = round(st.x / self.period + middle)
        if self.count > 0 {
            k = clamp(k, 0.0, f32(self.count - 1))
        }
        let s = st.x - (k - middle) * self.period
        let k_id = if self.wrap > 0 {
            let m = f32(self.wrap)
            k - m * floor(k / m)
        } else {
            k
        }
        let odd = self.alternate && abs(k_id - 2.0 * floor(0.5 * k_id)) > 0.5
        let edge_taper = cos(clamp(s / self.period, -0.5, 0.5) * 3.14159265)
        let w = self.wander * self.period
        let shift = vec2(
            0.10 * w * unit_of(k_id, 1) * edge_taper,
            0.08 * w * unit_of(k_id, 2) * edge_taper,
        )
        let gain = 1.0 + 0.12 * self.wander * unit_of(k_id, 3) * edge_taper
        let q = vec2(if odd { -s } else { s }, st.y) - shift
        gain * self.motif.height(q)
    }

    fn slope(self) -> f32 {
        self.motif.slope() * (1.0 + 0.45 * self.wander)
    }
}

/// A motif turned about (0, 0) `n` times (`ring`).
pub struct Ring<M>: Copy + GpuData + Eq + StateHash {
    pub motif: M,
    pub n: u32,
}

/// `motif` turned about (0, 0) `n` times, evenly: its copy at angle 0 points along +t.
pub fn ring<M: Motif>(motif: M, n: u32) -> Ring<M> {
    Ring { motif, n: max(n, 1) }
}

/// `st` turned by `-a` rad.
fn unturned(st: vec2, a: f32) -> vec2 {
    let c = cos(a)
    let s = sin(a)
    vec2(c * st.x + s * st.y, -s * st.x + c * st.y)
}

impl<M: Motif> Motif for Ring<M> {
    fn height(self, st: vec2) -> f32 {
        let step = 6.2831853 / f32(self.n)
        // The angle from +t, clockwise toward +s.
        let k = round(atan2(st.x, st.y) / step)
        self.motif.height(unturned(st, -k * step))
    }

    fn slope(self) -> f32 {
        self.motif.slope()
    }
}

/// A motif moved, turned and scaled within its face (`set`).
pub struct Set<M>: Copy + GpuData + Eq + StateHash {
    pub motif: M,
    pub at: vec2,
    pub turn: f32,
    pub size: f32,
}

/// `motif` moved to `at`, turned `turn` rad (from +t toward +s) and scaled by `size`.
pub fn set<M: Motif>(motif: M, at: vec2, turn: f32 = 0.0, size: f32 = 1.0) -> Set<M> {
    Set { motif, at, turn, size }
}

impl<M: Motif> Motif for Set<M> {
    fn height(self, st: vec2) -> f32 {
        self.size * self.motif.height(unturned(st - self.at, -self.turn) / self.size)
    }

    fn slope(self) -> f32 {
        self.motif.slope()
    }
}

/// Two motifs on one face (`pair`).
pub struct Pair<A, B>: Copy + GpuData + Eq + StateHash {
    pub a: A,
    pub b: B,
}

/// `a` and `b` together: the prouder stands, the deeper groove cuts.
pub fn pair<A: Motif, B: Motif>(a: A, b: B) -> Pair<A, B> {
    Pair { a, b }
}

impl<A: Motif, B: Motif> Motif for Pair<A, B> {
    fn height(self, st: vec2) -> f32 {
        joined(self.a.height(st), self.b.height(st))
    }

    fn slope(self) -> f32 {
        max(self.a.slope(), self.b.slope())
    }
}

// ---- the classical motifs -----------------------------------------------------------------------

/// An acanthus leaf as one side of it (`mirrored` makes the whole leaf): its midrib up t from
/// (0, 0), `length` m long and `width` m across at its widest, `height` m proud, its lobes curled
/// over by `curl` (0 straight, 1 their tips turned down as far as a leaf's turn): three broad
/// lobes reaching out and up from the midrib, the lowest widest, and the leaf's tip running on up
/// it, each lobe hollowed along its middle by a gouge, as a carver models them.
pub type Acanthus = Carving<4, 4>

/// One side of an acanthus leaf (`Acanthus`).
pub fn acanthus(length: f32, width: f32, height: f32, curl: f32 = 0.5) -> Acanthus {
    let l = length
    let w = 0.5 * width
    let roots = [vec2(0.0, 0.04 * l), vec2(0.0, 0.3 * l), vec2(0.0, 0.54 * l)]
    let tips = [vec2(0.92 * w, 0.4 * l), vec2(0.8 * w, 0.68 * l), vec2(0.56 * w, 0.9 * l)]
    let widths = [0.9 * w, 0.8 * w, 0.66 * w]
    let bow = -0.1 * curl * l
    var blades = [blade(vec2(0.0), vec2(0.0, l), width: w, height: height); 4]
    var grooves = [groove(vec2(0.0), vec2(0.0, l), depth: 0.2 * height, tool: 0.1 * w); 4]
    for i in 0..3 {
        blades[i] = blade(
            roots[i],
            tips[i],
            bend: bow,
            width: widths[i],
            belly: 0.45,
            height: (1.0 - 0.06 * f32(i)) * height,
        )
        // The lobe's hollow, down its middle from near its root almost to its tip.
        grooves[i] = groove(
            roots[i] + (tips[i] - roots[i]) * 0.15,
            tips[i] - (tips[i] - roots[i]) * 0.12,
            bend: bow,
            depth: 0.35 * height,
            tool: 0.16 * widths[i],
        )
    }
    // The tip: a lobe up the midrib's top, and the midrib's own groove under the leaf's length.
    blades[3] = blade(
        vec2(0.0, 0.62 * l),
        vec2(0.0, 1.0 * l),
        width: 0.7 * w,
        belly: 0.4,
        height: 0.9 * height,
    )
    grooves[3] = groove(
        vec2(0.0, 0.02 * l),
        vec2(0.0, 0.97 * l),
        depth: 0.22 * height,
        tool: 0.07 * w,
    )
    carving(blades, grooves)
}

/// A cell of bead and reel, centred on (0, 0) along s: an oval bead `bead` m long, and a reel (two
/// thin discs side by side) `reel` m long at each end of the cell, standing `height` m: repeated
/// every `bead + reel` m (`row`).
pub type BeadAndReel = Raised<3>

/// A bead-and-reel cell (`BeadAndReel`).
pub fn bead_and_reel(bead: f32, reel: f32, height: f32) -> BeadAndReel {
    let cell = bead + reel
    let b = blade(
        vec2(-0.5 * bead, 0.0),
        vec2(0.5 * bead, 0.0),
        width: 2.0 * height,
        height: height,
    )
    // The reels lie across the moulding, at the cell's ends: half a reel each side.
    let r0 = blade(
        vec2(0.5 * cell - 0.25 * reel, -0.9 * height),
        vec2(0.5 * cell - 0.25 * reel, 0.9 * height),
        width: 0.45 * reel,
        height: 0.8 * height,
    )
    let r1 = blade(
        vec2(-0.5 * cell + 0.25 * reel, -0.9 * height),
        vec2(-0.5 * cell + 0.25 * reel, 0.9 * height),
        width: 0.45 * reel,
        height: 0.8 * height,
    )
    raised([b, r0, r1])
}

/// A cell of egg and dart, centred on (0, 0): an egg `egg` m tall standing `height` m proud in a
/// shell cut round it, and a dart between it and the next: repeated every `0.8 * egg` m (`row`).
pub type EggAndDart = Carving<3, 2>

/// An egg-and-dart cell (`EggAndDart`).
pub fn egg_and_dart(egg: f32, height: f32) -> EggAndDart {
    let e = egg
    let cell = 0.8 * e
    // The egg points down; the shell is two grooves round it; the dart stands between cells.
    let body = blade(
        vec2(0.0, 0.5 * e),
        vec2(0.0, -0.5 * e),
        width: 0.62 * e,
        belly: 0.42,
        height: height,
    )
    let shell_l = groove(
        vec2(0.0, 0.55 * e),
        vec2(0.0, -0.58 * e),
        bend: -0.38 * e,
        depth: 0.35 * height,
        tool: 0.06 * e,
    )
    let shell_r = groove(
        vec2(0.0, 0.55 * e),
        vec2(0.0, -0.58 * e),
        bend: 0.38 * e,
        depth: 0.35 * height,
        tool: 0.06 * e,
    )
    let dart = blade(
        vec2(0.5 * cell, 0.5 * e),
        vec2(0.5 * cell, -0.6 * e),
        width: 0.16 * e,
        belly: 0.3,
        height: 0.7 * height,
    )
    let dart_back = blade(
        vec2(-0.5 * cell, 0.5 * e),
        vec2(-0.5 * cell, -0.6 * e),
        width: 0.16 * e,
        belly: 0.3,
        height: 0.7 * height,
    )
    carving([body, dart, dart_back], [shell_l, shell_r])
}

/// One bay of a classical Jacobean lunette-and-palmette frieze, centred on (0, 0) along s,
/// `period` m wide and `span` m tall (t from -span/2 to span/2), standing `height` m proud:
/// a bold uniform-width semicircular fluted lunette arch joining cleanly from bay to bay at
/// springpoint bosses, with upper spandrel jewels and a radiating three-petal sculpted palmette
/// fan rising from a carved calyx heart inside.
pub struct Scroll: Copy + GpuData + Eq + StateHash {
    pub period: f32,
    pub span: f32,
    pub height: f32,
}

/// One bay of a carved semicircular lunette-and-palmette frieze (`Scroll`).
pub fn scroll(period: f32, span: f32, height: f32) -> Scroll {
    Scroll { period, span, height }
}

impl Motif for Scroll {
    fn height(self, st: vec2) -> f32 {
        let p = self.period
        let sp = self.span
        let h = self.height
        let y0 = -0.30 * sp
        let rad = min(0.50 * p, 0.58 * sp)
        let half_w = 0.095 * sp
        let sm = vec2(abs(st.x), st.y)
        let q = sm - vec2(0.0, y0)
        let r = length(q)
        let dx = abs(r - rad) / half_w
        var out = 0.0
        if q.y >= -half_w && dx < 1.0 {
            let m = max(1.0 - dx * dx, 0.0)
            let cy = clamp(-q.y / half_w, 0.0, 1.0)
            let cm = max(1.0 - cy * cy, 0.0)
            let fx = abs(r - rad) / (0.28 * half_w)
            let fm = max(1.0 - fx * fx, 0.0)
            let flute_cut = 0.24 * h * fm * clamp(q.y / (0.22 * rad), 0.0, 1.0)
            out = max(0.96 * h * m * sqrt(m) * cm * sqrt(cm) - flute_cut, 0.0)
        }
        // Springpoint boss at (0.5*p, y0), spandrel jewel at (0.5*p, y0 + 0.90*rad), calyx at (0, y0).
        let u_cusp = min(
            length(sm - vec2(0.5 * p, y0)) / (0.125 * sp),
            min(
                length(sm - vec2(0.5 * p, y0 + 0.90 * rad)) / (0.095 * sp),
                r / (0.13 * sp),
            ),
        )
        let bm = max(1.0 - u_cusp * u_cusp, 0.0)
        out = max(out, 0.98 * h * bm * sqrt(bm))
        // Radiating three-petal sculpted palmette fan (center petal + mirrored side petal).
        let fan_c = blade(
            vec2(0.0, y0 + 0.04 * sp),
            vec2(0.0, y0 + 0.72 * rad),
            width: 0.22 * sp,
            belly: 0.62,
            height: h,
        ).height_at(sm)
        let fan_side = blade(
            vec2(0.04 * p, y0 + 0.06 * sp),
            vec2(0.55 * rad, y0 + 0.54 * rad),
            bend: 0.04 * sp,
            width: 0.20 * sp,
            belly: 0.60,
            height: 0.92 * h,
        ).height_at(sm)
        let vein = groove(
            vec2(0.0, y0 + 0.14 * sp),
            vec2(0.0, y0 + 0.62 * rad),
            depth: 0.28 * h,
            tool: 0.036 * sp,
        ).cut_at(sm)
        max(out, max(fan_c, fan_side) - vein)
    }

    fn slope(self) -> f32 {
        let half_w = max(0.095 * self.span, 1.0e-6)
        4.2 * abs(self.height) / half_w
    }
}

/// A true circular domed button with a crisp surrounding ring shadow (a rosette's heart).
pub struct Button: Copy + GpuData + Eq + StateHash {
    pub radius: f32,
    pub height: f32,
}

impl Motif for Button {
    fn height(self, st: vec2) -> f32 {
        let r = length(st) / max(self.radius, 1.0e-6)
        if r >= 1.0 {
            return 0.0
        }
        let m = max(1.0 - r * r, 0.0)
        self.height * m * sqrt(m)
    }

    fn slope(self) -> f32 {
        1.6 * abs(self.height) / max(self.radius, 1.0e-6)
    }
}

/// One petal of a rosette `radius` m round, pointing along +t from near the centre, `height` m
/// proud, with a vein; `rosette` turns it round and adds the circular domed button.
pub type Petal = Carving<1, 1>

/// One petal (`Petal`) of a rosette of `petals` petals: cleanly separated from its neighbours so
/// dark ground reads sharply around every carved petal.
pub fn petal(radius: f32, petals: u32, height: f32) -> Petal {
    let w = 6.2831853 * 0.56 * radius / f32(max(petals, 3))
    let p = blade(vec2(0.0, 0.25 * radius), vec2(0.0, radius), width: w, belly: 0.64, height: height)
    let v = groove(
        vec2(0.0, 0.30 * radius),
        vec2(0.0, 0.88 * radius),
        depth: 0.34 * height,
        tool: 0.15 * w,
    )
    carving([p], [v])
}

/// A rosette: `petals` sculpted veined petals round a true circular domed button, `radius` m round.
pub type Rosette = Pair<Ring<Petal>, Button>

/// A rosette (`Rosette`).
pub fn rosette(radius: f32, petals: u32, height: f32) -> Rosette {
    pair(
        ring(petal(radius, petals, height), n: petals),
        Button { radius: 0.27 * radius, height: 1.15 * height },
    )
}

/// One flute: a groove `length` m long up t, cut by a gouge `width` m across, `depth` m deep
/// (repeated round a turned part by `row`, its period the circumference over the count).
pub type Flute = Cuts<1>

/// A flute (`Flute`).
pub fn flute(length: f32, width: f32, depth: f32) -> Flute {
    // A gouge as wide as the flute is deep enough: its radius is half its width over the sine of
    // the angle its depth leaves.
    let r = (0.25 * width * width + depth * depth) / (2.0 * max(depth, 1.0e-5))
    cuts([groove(vec2(0.0, 0.0), vec2(0.0, length), depth: depth, tool: max(r, depth / 0.6))])
}

/// Blades alone (a reed, a gadroon: lens-shaped lobes side by side).
pub type Lobe = Raised<1>

/// A lobe `length` m long up t, `width` m across, `height` m proud (`row` sets them side by side:
/// gadrooning, reeding).
pub fn lobe(length: f32, width: f32, height: f32, belly: f32 = 0.5) -> Lobe {
    raised([blade(vec2(0.0, 0.0), vec2(0.0, length), width: width, belly: belly, height: height)])
}

/// Groove alone: a line cut by a gouge (a border, a fillet's line, a book's blind tooling).
pub type Line = Cuts<1>

/// A line (`Line`) from `a` to `b`, bowed `bend`, `depth` deep, cut by a gouge of radius `tool`.
pub fn line(a: vec2, b: vec2, bend: f32 = 0.0, depth: f32, tool: f32) -> Line {
    cuts([groove(a, b, bend: bend, depth: depth, tool: tool)])
}
