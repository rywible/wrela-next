// Fluent crafting combinators and paired profile helpers: the author-facing vocabulary built over
// `making`, `carve`, `ornament`, `wear` and `made`. Assets compose shapes left-to-right in the
// order a joiner or turner makes them (`.carve_round(...)`, `.joined(...)`, `.at(...)`,
// `.piece(...)`, `.dressed(...)`), pair each profile point directly with its arc bow (`Pt`, `pt`)
// so points and bows can never go out of step, and return opaque `Shaped` / `Asset` types instead
// of spelling out nested generic wrappers.

use shapes::carve::{Carved, Face, Motif, RoundFace, carved, round_face}
use shapes::made::{Dressed, Material, Piece, Shaped, dressed, piece}
use shapes::making::{
    Axes, Banded, Both, Extruded, Folded, Grown, Joined, Moulded, Placed, Sheathed, Turned,
    banded, both, extruded, folded, folded_across, grown, joined, moulded, placed, sheathed,
    turned, upright,
}
use shapes::ornament::{
    Flute, Mirrored, Pair, Ring, Row, Set, flute, mirrored, pair, ring, row, set,
}
use shapes::wear::{Cupped, Dinged, cupped, dinged}
use std::field::Surface
use std::hash::StateHash
use std::math::TAU

// ---- paired profile points ----------------------------------------------------------------------

/// One vertex of a profile or section outline, paired with the arc bow (`bow`, m) of the segment
/// leaving it. Pairing `at` and `bow` prevents parallel-array desynchronisation.
pub struct Pt: Copy + GpuData {
    pub at: vec2,
    pub bow: f32,
}

/// A profile point `at` whose leaving segment bows by `bow` (default straight).
pub fn pt(at: vec2, bow: f32 = 0.0) -> Pt {
    Pt { at, bow }
}

/// A turned form spun from paired `(radius, height, bow)` points.
pub fn lathe<const N: u32>(pts: [Pt; N]) -> Turned<N> {
    var points = [vec2(0.0); N]
    var bows = [0.0; N]
    for i in 0..N {
        points[i] = pts[i].at
        bows[i] = pts[i].bow
    }
    turned(points, bows)
}

/// A moulded slab whose edge profile is given as paired `(out, height, bow)` points.
pub fn slab<const N: u32>(half: vec2, corner: f32, edge: [Pt; N]) -> Moulded<N> {
    var points = [vec2(0.0); N]
    var bows = [0.0; N]
    for i in 0..N {
        points[i] = edge[i].at
        bows[i] = edge[i].bow
    }
    moulded(half, corner: corner, points: points, bulges: bows)
}

/// A closed moulding band run round a rectangular plan from paired `(out, height, bow)` points.
pub fn apron<const N: u32>(half: vec2, corner: f32, section: [Pt; N]) -> Banded<N> {
    var points = [vec2(0.0); N]
    var bows = [0.0; N]
    for i in 0..N {
        points[i] = section[i].at
        bows[i] = section[i].bow
    }
    banded(half, corner: corner, points: points, bulges: bows)
}

/// An extruded rail or panel from paired `(z, y, bow)` section points, `length` m along x.
pub fn rail<const N: u32>(section: [Pt; N], length: f32) -> Extruded<N> {
    var points = [vec2(0.0); N]
    var bows = [0.0; N]
    for i in 0..N {
        points[i] = section[i].at
        bows[i] = section[i].bow
    }
    extruded(points, bows, length: length)
}

/// A part rotated `a` rad about the whole's x axis (pitching a chair back toward -z when positive).
pub fn tilted_x(a: f32) -> Axes {
    let c = cos(a)
    let s = sin(a)
    Axes { x: vec3(1.0, 0.0, 0.0), y: vec3(0.0, c, -s), z: vec3(0.0, s, c) }
}

// ---- fluent motif combinators -------------------------------------------------------------------

/// Pipeline combinators for any carving `Motif`.
pub trait MotifOps: Motif {
    /// Mirrors this motif across s = 0.
    fn mirrored(self) -> Mirrored<Self> {
        mirrored(self)
    }

    /// Repeats this motif along s every `period` m (`count == 0` for endless wrap).
    fn repeated(
        self,
        period: f32,
        count: u32 = 0,
        alternate: bool = false,
        wander: f32 = 0.0,
    ) -> Row<Self> {
        row(self, period: period, count: count, alternate: alternate, wander: wander)
    }

    /// Repeats this motif `count` times evenly round a turned surface of radius `radius`.
    fn around(self, count: u32, radius: f32, wander: f32 = 0.0) -> Row<Self> {
        let n = max(count, 1)
        row(self, period: TAU * radius / f32(n), count: 0, wander: wander, wrap: n)
    }

    /// Turns this motif evenly `n` times about (0, 0).
    fn ring_of(self, n: u32) -> Ring<Self> {
        ring(self, n: n)
    }

    /// Moves, turns and scales this motif within its face.
    fn set_at(self, at: vec2, turn: f32 = 0.0, size: f32 = 1.0) -> Set<Self> {
        set(self, at: at, turn: turn, size: size)
    }

    /// Combines this motif with `other` (prouder stands, deeper groove cuts).
    fn and_motif<B: Motif>(self, other: B) -> Pair<Self, B> {
        pair(self, other)
    }
}

impl<M: Motif> MotifOps for M {}

// ---- fluent shape combinators -------------------------------------------------------------------

/// Pipeline combinators for any `Shaped` part, matching the sequence of workshop operations.
pub trait Craft: Shaped {
    /// Places this part at `at` with optional orientation `axes`.
    fn at(self, at: vec3, axes: Axes = upright()) -> Placed<Self> {
        placed(self, at: at, axes: axes)
    }

    /// Mirrors this part across both x = 0 and z = 0 (four-corner symmetry).
    fn four_corners(self) -> Folded<Self> {
        folded(self)
    }

    /// Mirrors this part across the selected coordinate planes.
    fn mirrored_across(self, x: bool = false, y: bool = false, z: bool = false) -> Folded<Self> {
        folded_across(self, x: x, y: y, z: z)
    }

    /// Joins `other` to this part with a visible shoulder/glue seam (`gap` wide, `depth` deep).
    fn joined_to<B: Shaped>(self, other: B, gap: f32 = 0.0006, depth: f32 = 0.0008) -> Joined<Self, B> {
        joined(self, other, gap: gap, depth: depth)
    }

    /// Combines this part with `other` as one `Shaped` union.
    fn with_part<B: Shaped>(self, other: B) -> Both<Self, B> {
        both(self, other)
    }

    /// Grows this part outward by a uniform layer `by` m thick (leather over boards, gesso).
    fn wrapped(self, by: f32) -> Grown<Self> {
        grown(self, by: by)
    }

    /// Cuts a sheet `thick` m thick over this part inside `region` (brass corners, straps).
    fn clad<R: Surface + StateHash + Eq>(self, thick: f32, region: R) -> Sheathed<Self, R> {
        sheathed(self, thick: thick, region: region)
    }

    /// Carves `motif` into `face` over `region`, lowering the ground by `ground`.
    fn carve<F: Face, M: Motif>(
        self,
        face: F,
        motif: M,
        ground: f32,
        region: vec4,
        tooling: vec2 = vec2(0.0),
    ) -> Carved<Self, F, M> {
        carved(self, face, motif, ground: ground, region: region, tooling: tooling)
    }

    /// Carves `motif` all round a turned part between heights `from` and `to`.
    fn carve_round<M: Motif>(
        self,
        from: f32,
        to: f32,
        radius: f32,
        inner: f32,
        motif: M,
        ground: f32,
        tooling: vec2 = vec2(0.0),
    ) -> Carved<Self, RoundFace, M> {
        carved(
            self,
            round_face(radius: radius, base: from, inner: inner),
            motif,
            ground: ground,
            region: vec4(-1.0, 0.0, 1.0, to - from),
            tooling: tooling,
        )
    }

    /// Cuts `count` vertical flutes around a turned column between heights `from` and `to`.
    fn fluted(
        self,
        from: f32,
        to: f32,
        radius: f32,
        inner: f32,
        count: u32,
        depth: f32,
        fill: f32 = 0.62,
        wander: f32 = 0.0,
    ) -> Carved<Self, RoundFace, Row<Flute>> {
        let n = max(count, 1)
        let period = TAU * radius / f32(n)
        let fl = flute(length: to - from, width: period * fill, depth: depth)
        self.carve_round(
            from: from,
            to: to,
            radius: radius,
            inner: inner,
            motif: row(fl, period: period, count: 0, wander: wander, wrap: n),
            ground: 0.0,
        )
    }

    /// Cups and twists a wooden board across its half-extents `across`.
    fn seasoned(self, across: vec2, cup: f32, twist: f32 = 0.0) -> Cupped<Self> {
        cupped(self, across: across, cup: cup, twist: twist)
    }

    /// Adds shallow wear dents across this part's surface.
    fn worn_dings(
        self,
        spacing: f32,
        radius: f32 = 0.004,
        depth: f32 = 0.0001,
        seed: u32 = 1,
    ) -> Dinged<Self> {
        dinged(self, spacing: spacing, radius: radius, depth: depth, seed: seed)
    }

    /// Names this part and assigns its piece index `k` (e.g. which log it was cut from).
    fn named_piece(self, k: u32, name: Text) -> Piece<Self> {
        piece(k, name, self)
    }

    /// Dresses this shaped part in `material`, yielding an engine-ready `Field<Substance>`.
    fn in_material<M: Material>(self, material: M) -> Dressed<Self, M> {
        dressed(self, material)
    }
}

impl<S: Shaped> Craft for S {}
