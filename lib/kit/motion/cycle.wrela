// A cycle: movement that repeats (a walk), as a Fourier series of each number of a body's pose
// (`engine::body::body::Pose`): the root's place, its turn about a mean turn as a rotation vector,
// and each joint's numbers, each a mean and a few harmonics of the phase. Played in place: what
// the body travels in a cycle is `travel`, apart from the pose.
//
// It is how the creature walks until the solver moves it (docs/plans/bodies-and-movement.md,
// phase 5, which removes it); a tool wrote its one walk from the old walk on the old rig
// (tools/movement/onetime).

use engine::body::body::Pose
use engine::body::joint::{Frame, turn_of_vector}
use std::collections::Vec
use std::math::TAU
use std::quat::Quat

/// One harmonic of one series: series `n` (0 to 2 the root's place, 3 to 5 its turn, then each
/// number of the pose), its multiple `k` of the phase, and how much of its cosine and its sine.
pub struct Wave: Copy {
    pub n: u32,
    pub k: u32,
    pub cos: f32,
    pub sin: f32,
}

/// Harmonic `k` of series `n` (the written form).
pub fn wave(n: u32, k: u32, cos: f32, sin: f32) -> Wave {
    Wave { n, k, cos, sin }
}

/// A cycle of a body with `D` numbers: how long one lasts (s), how far the body goes in one (the
/// body's space), the root's mean turn, each series' mean (6 then `D`) and the harmonics.
pub struct Cycle<const D: u32>: Clone {
    pub period: f32,
    pub travel: vec3,
    pub root: Quat,
    pub means: Vec<f32>,
    pub waves: Vec<Wave>,
}

impl<const D: u32> Cycle<D> {
    /// Its pose `time` s in, in place.
    pub fn pose(self, time: f32) -> Pose<D> {
        var x = [0.0; 6]
        var q = [0.0; D]
        for n in 0..6 {
            x[n] = self.means[n]
        }
        for n in 0..D {
            q[n] = self.means[6 + n]
        }
        let w = TAU * (time / self.period)
        for h in self.waves {
            let a = w * f32(h.k)
            let v = h.cos * cos(a) + h.sin * sin(a)
            if h.n < 6 {
                x[h.n] += v
            } else {
                q[h.n - 6] += v
            }
        }
        Pose {
            root: Frame {
                q: self.root.mul(turn_of_vector(vec3(x[3], x[4], x[5]))),
                t: vec3(x[0], x[1], x[2]),
            },
            q,
        }
    }
}
