// How heavy common matter is (`engine::matter::density`): measured densities, each with its
// source (docs/citations.md, "Bodies and motion"). A body's segments are weighed from these
// (`engine::body::mass`).

use engine::matter::density::{Density, density}

/// The living tissue of a body (skin, fat, muscle and bone together): the mean density of the
/// segments of the human bodies that Dempster weighed, about 1,060 kg/m³ (W. T. Dempster,
/// "Space requirements of the seated operator", WADC TR 55-159, 1955: segment densities from
/// 1,030 for the trunk to 1,160 for the hand; not read at its source, but in the tables that
/// quote it).
pub const TISSUE: Density = density(1060.0)

/// Wood of a common hardwood, dry (12% moisture): about 700 kg/m³ (USDA Forest Products
/// Laboratory, *Wood Handbook*, FPL-GTR-190, 2010, table 5-3a: a specific gravity near 0.6 to
/// 0.7 for maples and oaks; not read at its source).
pub const WOOD: Density = density(700.0)
