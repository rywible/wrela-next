// Paper in a bound book: rag paper, its edges yellowed and foxed by air and hands, its fore-edge
// banded where the gatherings (the folded sheets sewn as one) meet, each a millimetre or two
// thick: the gatherings show at a reading distance where single leaves (a tenth of a millimetre)
// do not.

use engine::matter::substance::Substance
use shapes::made::{Material, Story}
use std::cmp::Eq
use std::field::value_noise
use std::hash::StateHash

/// A book's paper: its albedo, how yellowed it is where air reaches (0 to 1), how thick a
/// gathering is (m), the direction the leaves are stacked in (in the part's frame), and a seed.
pub struct Paper: Copy + GpuData + Eq + StateHash {
    pub albedo: vec3,
    pub age: f32,
    pub gathering: f32,
    pub stack: vec3,
    pub seed: f32,
}

/// A paper (`Paper`): by default antique laid rag paper, its leaves stacked along y.
pub fn paper(
    albedo: vec3 = vec3(0.66, 0.56, 0.41),
    age: f32 = 0.65,
    gathering: f32 = 0.0022,
    stack: vec3 = vec3(0.0, 1.0, 0.0),
    seed: f32 = 0.0,
) -> Paper {
    Paper { albedo, age, gathering, stack: normalize(stack), seed }
}

impl Material for Paper {
    fn at(self, p: vec3, story: Story) -> Substance {
        let h = dot(p, self.stack) / max(self.gathering, 1.0e-5)
        let within = h - floor(h)
        // Gatherings (sewn folded quires) leave distinct micro-stepped valleys; individual deckled
        // sheets add crisp fine horizontal leaf strata catching raking light via `bump`.
        let line = smoothstep(0.16, 0.0, min(within, 1.0 - within))
        let quire_step = value_noise(vec3(floor(h) * 2.3, self.seed, 0.0))
        let leaf_wave = sin(h * 11.0 * 6.2831853 + 1.8 * value_noise(p * 35.0 + vec3(self.seed)))
        let fibre = value_noise(p * 850.0 + vec3(self.seed))
        let leaf_edges = value_noise(vec3(h * 14.0, self.seed, dot(p, vec3(1.0, 0.0, 1.0)) * 55.0))
        let exposed = max(story.exposure, 0.0)
        let fox = smoothstep(0.52, 0.84, value_noise(p * 110.0 + vec3(self.seed))) * self.age
        let stain = smoothstep(0.58, 0.78, value_noise(p * 18.0 + vec3(self.seed * 3.0))) * self.age
        var albedo = self.albedo *
            (1.0 + 0.04 * fibre + 0.09 * quire_step + 0.06 * leaf_edges + 0.03 * leaf_wave) *
            (1.0 - 0.45 * line)
        // Yellowed, oxidized and foxed where air and readers' thumbs reach.
        albedo = mix(albedo, albedo * vec3(0.90, 0.76, 0.50), self.age * (0.45 + 0.55 * exposed))
        albedo = mix(albedo, vec3(0.42, 0.27, 0.14), 0.55 * fox)
        albedo = mix(albedo, albedo * vec3(0.76, 0.65, 0.48), 0.62 * stain)
        let bump = -0.00026 * line +
            0.00009 * quire_step +
            0.000055 * leaf_wave +
            0.00004 * leaf_edges
        Substance {
            albedo: clamp(albedo, vec3(0.0), vec3(0.9)),
            roughness: clamp(0.86 + 0.08 * line - 0.04 * exposed, 0.72, 0.96),
            emits: vec3(0.0),
            metallic: 0.0,
            ior: 1.5,
            transmission: 0.0,
            subsurface: 0.22,
            coat: 0.0,
            micro: 0.0,
            bump: bump,
            pad1: 0.0,
            pad2: 0.0,
        }
    }
}
