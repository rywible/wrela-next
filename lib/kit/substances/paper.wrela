// Paper in a bound book: rag paper, its edges yellowed and foxed by air and hands, its fore-edge
// banded where the gatherings (the folded sheets sewn as one) meet, each a millimetre or two
// thick: the gatherings show at a reading distance where single leaves (a tenth of a millimetre)
// do not.

use engine::matter::substance::Substance
use shapes::made::{Material, Story}
use std::cmp::Eq
use std::field::value_noise
use std::hash::StateHash

/// A book's paper: its albedo, how yellowed it is where air reaches (0 to 1), how thick a
/// gathering is (m), the direction the leaves are stacked in (in the part's frame), and a seed.
pub struct Paper: Copy + GpuData + Eq + StateHash {
    pub albedo: vec3,
    pub age: f32,
    pub gathering: f32,
    pub stack: vec3,
    pub seed: f32,
}

/// A paper (`Paper`): by default an old laid paper, its leaves stacked along y.
pub fn paper(
    albedo: vec3 = vec3(0.6, 0.53, 0.4),
    age: f32 = 0.6,
    gathering: f32 = 0.0018,
    stack: vec3 = vec3(0.0, 1.0, 0.0),
    seed: f32 = 0.0,
) -> Paper {
    Paper { albedo, age, gathering, stack: normalize(stack), seed }
}

impl Material for Paper {
    fn at(self, p: vec3, story: Story) -> Substance {
        let h = dot(p, self.stack) / max(self.gathering, 1.0e-5)
        let within = h - floor(h)
        // Where gatherings meet, a thin dark line; each gathering's leaves a little uneven.
        let line = smoothstep(0.12, 0.0, min(within, 1.0 - within))
        let leaves = value_noise(vec3(floor(h) * 1.7, self.seed, 0.0))
        let fibre = value_noise(p * 900.0 + vec3(self.seed))
        let exposed = max(story.exposure, 0.0)
        let fox = smoothstep(0.55, 0.85, value_noise(p * 120.0 + vec3(self.seed * 2.0))) * self.age
        var albedo = self.albedo * (1.0 + 0.04 * fibre + 0.05 * leaves) * (1.0 - 0.35 * line)
        // Yellowed and foxed where air and hands reach.
        albedo = mix(albedo, albedo * vec3(0.92, 0.8, 0.55), self.age * (0.4 + 0.6 * exposed))
        albedo = mix(albedo, vec3(0.45, 0.3, 0.16), 0.5 * fox)
        Substance {
            albedo: clamp(albedo, vec3(0.0), vec3(0.9)),
            roughness: 0.88,
            emits: vec3(0.0),
            metallic: 0.0,
            ior: 1.5,
            transmission: 0.0,
            subsurface: 0.25,
            coat: 0.0,
            micro: 0.0,
            pad0: 0.0,
            pad1: 0.0,
            pad2: 0.0,
        }
    }
}
