// Wood, from the log it was cut from (AGENTS.md, "The vocabulary ladder": rung 3, processes). A
// board's figure is where its surface cuts the log's growth rings and rays, so it is said by where
// the board lay in the log, never painted: a plain-sawn top shows arches, a quarter-sawn leg the
// straight lines and broad flecks of oak's rays, and a gouge cut into either shows the grain
// inside at the angle the cut makes. The same field gives the shape's cut and its look.
//
//   Log { pith, axis, ring, wander, ray, seed }   where the log's heart ran, in the part's frame,
//                                                 how fast it grew, how its rings wander, how
//                                                 broad its rays are
//   grain(log, p)                                 latewood, ray and pore at a point
//   oak(log, ...)                                 a ring-porous oak, finished and aged
//
// Every number is a length or a share with its physical meaning: no tone.

use engine::matter::substance::Substance
use shapes::made::{Material, Story}
use std::cmp::Eq
use std::field::value_noise
use std::hash::StateHash

/// Where a part's wood grew: the line its log's heart ran along (through `pith`, along `axis`,
/// both in the part's own frame), the width of a year's ring (m), how far its rings wander off
/// round (m), how tall its rays run along the grain (m; oak's are centimetres), and a seed.
pub struct Log: Copy + GpuData + Eq + StateHash {
    pub pith: vec3,
    pub axis: vec3,
    pub ring: f32,
    pub wander: f32,
    pub ray: f32,
    pub seed: f32,
}

/// A log (`Log`), its axis made unit.
pub fn log(
    pith: vec3,
    axis: vec3,
    ring: f32 = 0.002,
    wander: f32 = 0.009,
    ray: f32 = 0.025,
    seed: f32 = 0.0,
) -> Log {
    Log { pith, axis: normalize(axis), ring, wander, ray, seed }
}

/// What the wood is at a point: how far into a year's latewood (0 earlywood, 1 the dense band
/// that closes a ring), whether a ray runs there (0 to 1), and whether an open pore does (0 to 1:
/// a ring-porous wood's pores are in its earlywood).
pub struct Grain: Copy {
    pub late: f32,
    pub ray: f32,
    pub pore: f32,
}

/// The grain at `p` (in the part's frame) of wood from `log`.
pub fn grain(log: Log, p: vec3) -> Grain {
    let v = p - log.pith
    let along = dot(v, log.axis)
    let across = v - log.axis * along
    let rho = max(length(across), 1.0e-6)
    let dir = across / rho
    // The rings wander slowly round the log and along it.
    let seed = vec3(log.seed * 13.1, log.seed * 7.7, 0.0)
    let wobble = log.wander *
        value_noise(vec3(dir.x * 2.0, dir.y * 2.0, along * 6.0 + dir.z * 2.0) + seed)
    // Each year's ring is as wide as that year's growth: wider in good years, narrower in poor,
    // the years running in spells.
    let r = (rho + wobble) / log.ring
    let year = r +
        1.6 * value_noise(vec3(r * 0.11, log.seed * 3.1, 0.5)) +
        0.6 * value_noise(vec3(r * 0.43, log.seed * 5.3, 1.5))
    let phase = year - floor(year)
    // Earlywood opens a ring; latewood thickens toward its end and stops sharp at the next.
    let late = smoothstep(0.45, 0.85, phase)
    // Rays: thin plates running out from the heart, about every 1.5 mm round at each radius,
    // each a lens `ray` m tall along the grain.
    let helper = if abs(log.axis.y) < 0.9 { vec3(0.0, 1.0, 0.0) } else { vec3(1.0, 0.0, 0.0) }
    let e1 = normalize(cross(log.axis, helper))
    let e2 = cross(log.axis, e1)
    let round = atan2(dot(dir, e2), dot(dir, e1))
    let arc = round * rho / 0.0015
    let lane = arc - floor(arc)
    let lens = value_noise(vec3(floor(arc) * 0.37, along / log.ray, log.seed))
    let ray = smoothstep(0.82, 0.95, 1.0 - abs(lane - 0.5) * 2.0) * smoothstep(0.1, 0.4, lens)
    // Pores: open vessels in the earlywood, long along the grain, a few tenths of a mm across.
    let pore_field = value_noise(vec3(arc * 2.7, along / 0.0015, year * 3.0 + log.seed))
    let pore = smoothstep(0.35, 0.7, pore_field) * (1.0 - smoothstep(0.15, 0.4, phase))
    Grain { late, ray, pore }
}

/// A ring-porous oak, as a joiner finishes it and time ages it: the logs its `N` pieces were cut
/// from, its earlywood's and latewood's
/// albedo, how much wax or varnish it carries (0 bare to 1 a full build), how far it has darkened
/// with age (0 new, 1 old), and how much dirt and old wax sit in its recesses (0 none, 1 black).
pub struct Oak<const N: u32>: Copy + GpuData + Eq + StateHash {
    /// The log each piece of the whole was cut from (`made::Story::piece`).
    pub logs: [Log; N],
    pub early: vec3,
    pub late: vec3,
    pub finish: f32,
    pub age: f32,
    pub grime: f32,
}

/// An oak (`Oak`) whose pieces were cut from `logs`: by default, an old waxed oak, darkened, dirt
/// in its recesses.
pub fn oak<const N: u32>(
    logs: [Log; N],
    early: vec3 = vec3(0.3, 0.17, 0.08),
    late: vec3 = vec3(0.22, 0.12, 0.055),
    finish: f32 = 0.6,
    age: f32 = 0.6,
    grime: f32 = 0.5,
) -> Oak<N> {
    Oak { logs, early, late, finish, age, grime }
}

impl<const N: u32> Material for Oak<N> {
    fn at(self, p: vec3, story: Story) -> Substance {
        let g = grain(self.logs[min(story.piece, N - 1)], p)
        var albedo = mix(self.early, self.late, g.late)
        // Rays are paler and denser than the wood round them; pores hold dark wax.
        albedo = mix(albedo, albedo * vec3(1.35, 1.3, 1.2), g.ray)
        albedo = albedo * (1.0 - 0.45 * g.pore)
        // Age darkens and warms the whole surface.
        albedo = albedo * mix(vec3(1.0), vec3(0.62, 0.52, 0.42), self.age)
        // Rubbed high points wear through to paler wood; recesses hold grime and old wax.
        let rubbed = max(story.exposure, 0.0)
        let recess = max(-story.exposure, 0.0)
        albedo = albedo * (1.0 + 0.25 * rubbed) * (1.0 - 0.7 * self.grime * recess)
        // A finish is glossier where it is rubbed, duller where dust settles, open at pores.
        let rough = clamp(
            0.55 - 0.3 * self.finish * (0.5 + 0.5 * rubbed) + 0.25 * recess + 0.15 * g.pore,
            0.12,
            0.95,
        )
        Substance {
            albedo: clamp(albedo, vec3(0.0), vec3(0.9)),
            roughness: rough,
            emits: vec3(0.0),
            metallic: 0.0,
            ior: 1.5,
            transmission: 0.0,
            subsurface: 0.04,
            coat: clamp(self.finish * (0.35 + 0.5 * rubbed - 0.3 * recess), 0.0, 1.0),
            micro: 0.0,
            pad0: 0.0,
            pad1: 0.0,
            pad2: 0.0,
        }
    }
}
