// The kit's materials are what they say of themselves (`Material::may_emit`, `may_micro`): what a
// material says it never has is erased from the shaders of everything made of it, so each is held
// to its word by brute force, over points and stories.

use shapes::made::{Material, story}
use substances::brass::brass
use substances::leather::leather
use substances::paper::paper
use substances::wood::{log, oak}

/// `m` at 4,096 points of a 2 m cube and as many stories (every exposure, a centimetre of depth),
/// emitting nothing where it says it never emits, and with no micro relief where it says it has
/// none.
fn holds_its_word<M: Material>(m: M, name: str) {
    for i in 0..4096 {
        let f = f32(i)
        let p = vec3(fract(f * 0.618034), fract(f * 0.754878), fract(f * 0.569840)) * 2.0 -
            vec3(1.0)
        let s = story(exposure: fract(f * 0.3141) * 2.0 - 1.0, depth: fract(f * 0.1732) * 0.01)
        let sub = m.at(p, s)
        if !m.may_emit() {
            assert(
                sub.emits.x == 0.0 && sub.emits.y == 0.0 && sub.emits.z == 0.0,
                f"{name} says it never emits, and emits {sub.emits} at {p}",
            )
        }
        if !m.may_micro() {
            assert(sub.micro == 0.0, f"{name} says it has no micro relief, and has {sub.micro} at {p}")
        }
    }
}

@test
fn a_material_is_what_it_says() {
    holds_its_word(brass(), "brass")
    holds_its_word(leather(gild: 0.5), "leather")
    holds_its_word(paper(), "paper")
    holds_its_word(
        oak([log(vec3(0.0, 0.4, 0.0), axis: vec3(1.0, 0.0, 0.0), plank: 0.15, breadboard: 0.5)]),
        "oak",
    )
}
