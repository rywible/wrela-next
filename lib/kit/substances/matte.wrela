// Matte substances: matter that scatters the light falling on it evenly every way (a Lambertian
// surface: plaster, unpolished stone, dry earth, fur seen from afar, rough wood), and gives off
// none of its own. The albedo is the share of light it sends back, linear, each colour; measured
// albedos of real things run from about 0.04 (charcoal, fresh asphalt) to about 0.9 (fresh snow).

use engine::matter::substance::Substance

/// A matte substance that sends back `albedo` of the light falling on it.
pub fn matte(albedo: vec3) -> Substance {
    Substance { albedo, emits: vec3(0.0) }
}
