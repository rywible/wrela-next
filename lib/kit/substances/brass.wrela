// Brass, as time leaves it: an alloy of copper and zinc that tarnishes brown and, in the damp, to
// green where it lies untouched, and stays bright where hands and cloths rub it. Which is which
// comes from the shape (a corner's edge is rubbed, its hollow is not: `made::Story`), so a brass
// corner, boss or clasp is polished and tarnished in the right places by the same numbers that
// shaped it.

use engine::matter::substance::Substance
use shapes::made::{Material, Story}
use std::cmp::Eq
use std::field::value_noise
use std::hash::StateHash

/// A brass: its bright metal's reflectance (F0, linear), how tarnished it is where untouched (0
/// bright to 1 dark brown), how far that has gone to verdigris (0 to 1), and a seed for the
/// tarnish's blotches.
pub struct Brass: Copy + GpuData + Eq + StateHash {
    pub bright: vec3,
    pub tarnish: f32,
    pub verdigris: f32,
    pub seed: f32,
}

/// A brass (`Brass`): by default antique cast brass, burnished bright on edges and dark in coves.
pub fn brass(
    bright: vec3 = vec3(0.95, 0.77, 0.35),
    tarnish: f32 = 0.72,
    verdigris: f32 = 0.12,
    seed: f32 = 0.0,
) -> Brass {
    Brass { bright, tarnish, verdigris, seed }
}

impl Material for Brass {
    fn at(self, p: vec3, story: Story) -> Substance {
        // Rubbed bright where exposed; dark bronze tarnish settles into hollows, verdigris only
        // in the deepest recesses so high surfaces stay rich metallic gold-brass.
        let rubbed = smoothstep(-0.15, 0.60, story.exposure)
        let blotch = 0.5 + 0.5 * value_noise(p * 260.0 + vec3(self.seed))
        let wide = 0.5 + 0.5 * value_noise(p * 48.0 + vec3(self.seed * 2.0))
        let dull = self.tarnish * (1.0 - rubbed) * (0.52 + 0.28 * blotch + 0.20 * wide)
        let green = self.verdigris * smoothstep(-0.28, -0.92, story.exposure) * blotch
        // Subtle finger oil smudges and cast-metal micro-hammering / pitting.
        let smudge = smoothstep(0.58, 0.88, value_noise(p * 115.0 + vec3(self.seed * 4.0))) * rubbed
        let hammer = value_noise(p * 190.0 + vec3(self.seed * 7.0))
        let pit = smoothstep(0.62, 0.92, value_noise(p * 520.0 + vec3(self.seed * 11.0))) * dull
        let tarnished = mix(vec3(0.24, 0.15, 0.06), vec3(0.14, 0.23, 0.16), green)
        let albedo = mix(self.bright, tarnished, clamp(dull + green, 0.0, 1.0)) *
            (1.0 - 0.14 * smudge)
        let bump = 0.000035 * hammer - 0.000085 * pit
        Substance {
            albedo,
            roughness: clamp(
                0.14 + 0.42 * dull + 0.34 * green + 0.22 * smudge + 0.05 * blotch,
                0.08,
                0.88,
            ),
            emits: vec3(0.0),
            metallic: clamp(1.0 - 0.35 * dull - 0.82 * green, 0.0, 1.0),
            ior: 1.5,
            transmission: 0.0,
            subsurface: 0.0,
            coat: 0.0,
            micro: 0.0,
            bump: bump,
            pad1: 0.0,
            pad2: 0.0,
        }
    }
}
