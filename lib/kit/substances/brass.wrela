// Brass, as time leaves it: an alloy of copper and zinc that tarnishes brown and, in the damp, to
// green where it lies untouched, and stays bright where hands and cloths rub it. Which is which
// comes from the shape (a corner's edge is rubbed, its hollow is not: `made::Story`), so a brass
// corner, boss or clasp is polished and tarnished in the right places by the same numbers that
// shaped it.

use engine::matter::substance::Substance
use shapes::made::{Material, Story}
use std::cmp::Eq
use std::field::value_noise
use std::hash::StateHash

/// A brass: its bright metal's reflectance (F0, linear), how tarnished it is where untouched (0
/// bright to 1 dark brown), how far that has gone to verdigris (0 to 1), and a seed for the
/// tarnish's blotches.
pub struct Brass: Copy + GpuData + Eq + StateHash {
    pub bright: vec3,
    pub tarnish: f32,
    pub verdigris: f32,
    pub seed: f32,
}

/// A brass (`Brass`): by default old brass, much tarnished, a little green.
pub fn brass(
    bright: vec3 = vec3(0.91, 0.78, 0.42),
    tarnish: f32 = 0.75,
    verdigris: f32 = 0.15,
    seed: f32 = 0.0,
) -> Brass {
    Brass { bright, tarnish, verdigris, seed }
}

impl Material for Brass {
    fn at(self, p: vec3, story: Story) -> Substance {
        // Rubbed bright where exposed; tarnish grows into hollows, in blotches.
        let rubbed = smoothstep(-0.1, 0.7, story.exposure)
        let blotch = 0.5 + 0.5 * value_noise(p * 260.0 + vec3(self.seed))
        let dull = self.tarnish * (1.0 - rubbed) * (0.7 + 0.3 * blotch)
        let green = self.verdigris * smoothstep(0.0, -0.8, story.exposure) * blotch
        let tarnished = mix(vec3(0.18, 0.12, 0.06), vec3(0.16, 0.24, 0.17), green)
        let albedo = mix(self.bright, tarnished, clamp(dull + green, 0.0, 1.0))
        Substance {
            albedo,
            roughness: clamp(0.18 + 0.45 * dull + 0.3 * green, 0.08, 0.9),
            emits: vec3(0.0),
            // Tarnish and verdigris are films over the metal: less metal shows through them.
            metallic: clamp(1.0 - 0.45 * dull - 0.8 * green, 0.0, 1.0),
            ior: 1.5,
            transmission: 0.0,
            subsurface: 0.0,
            coat: 0.0,
            micro: 0.0,
            pad0: 0.0,
            pad1: 0.0,
            pad2: 0.0,
        }
    }
}
