// Brass, as time leaves it: an alloy of copper and zinc that tarnishes brown and, in the damp, to
// green where it lies untouched, and stays bright where hands and cloths rub it. Which is which
// comes from the shape (a corner's edge is rubbed, its hollow is not: `made::Story`), so a brass
// corner, boss or clasp is polished and tarnished in the right places by the same numbers that
// shaped it.

use engine::matter::substance::Substance
use shapes::made::{Material, Story}
use std::cmp::Eq
use std::field::value_noise
use std::hash::StateHash

/// A brass: its bright metal's reflectance (F0, linear), how tarnished it is where untouched (0
/// bright to 1 dark brown), how far that has gone to verdigris (0 to 1), and a seed for the
/// tarnish's blotches.
pub struct Brass: Copy + GpuData + Eq + StateHash {
    pub bright: vec3,
    pub tarnish: f32,
    pub verdigris: f32,
    pub seed: f32,
}

/// A brass (`Brass`): by default rich antique cast bronze-brass, burnished warm gold on rubbed
/// edges and deep oxidized umber-bronze in hollows.
pub fn brass(
    bright: vec3 = vec3(0.82, 0.58, 0.23),
    tarnish: f32 = 0.78,
    verdigris: f32 = 0.08,
    seed: f32 = 0.0,
) -> Brass {
    Brass { bright, tarnish, verdigris, seed }
}

impl Material for Brass {
    fn at(self, p: vec3, story: Story) -> Substance {
        let rubbed = smoothstep(-0.12, 0.65, story.exposure)
        let blotch = 0.5 + 0.5 * value_noise(p * 240.0 + vec3(self.seed))
        let wide = 0.5 + 0.5 * value_noise(p * 42.0 + vec3(self.seed * 2.0))
        let dull = self.tarnish * (1.0 - rubbed) * (0.55 + 0.25 * blotch + 0.20 * wide)
        let green = self.verdigris * smoothstep(-0.42, -0.96, story.exposure) * blotch
        let smudge = smoothstep(0.55, 0.86, value_noise(p * 105.0 + vec3(self.seed * 4.0))) * rubbed
        let hammer = value_noise(p * 170.0 + vec3(self.seed * 7.0))
        let pit = smoothstep(0.64, 0.92, value_noise(p * 480.0 + vec3(self.seed * 11.0))) * dull
        let tarnished = mix(vec3(0.13, 0.08, 0.032), vec3(0.11, 0.19, 0.13), green)
        let albedo = mix(self.bright, tarnished, clamp(dull + green, 0.0, 1.0)) *
            (1.0 - 0.15 * smudge)
        let bump = 0.00004 * hammer - 0.00009 * pit
        Substance {
            albedo,
            roughness: clamp(
                0.20 + 0.38 * dull + 0.34 * green + 0.20 * smudge + 0.07 * blotch,
                0.14,
                0.88,
            ),
            emits: vec3(0.0),
            metallic: clamp(1.0 - 0.38 * dull - 0.84 * green, 0.0, 1.0),
            ior: 1.5,
            transmission: 0.0,
            subsurface: 0.0,
            coat: 0.0,
            micro: 0.0,
            bump: bump,
            pad1: 0.0,
            pad2: 0.0,
        }
    }
}
