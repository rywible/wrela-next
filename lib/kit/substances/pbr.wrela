// Physically based substance recipes (`lib/kit/substances/pbr`): pure data constructors built on
// `engine::matter::substance::Substance` for stone, wet stone, metal, glass, water, sand, flesh,
// ice, and emissive spell cores. Every recipe blends seamlessly across smooth field joins.

use engine::matter::substance::Substance

/// A general dielectric surface (stone, wood, cloth, paint, earth) with physical Fresnel (`ior = 1.5`).
pub fn dielectric(albedo: vec3, roughness: f32) -> Substance {
    Substance {
        albedo,
        roughness: clamp(roughness, 0.04, 1.0),
        emits: vec3(0.0),
        metallic: 0.0,
        ior: 1.5,
        transmission: 0.0,
        subsurface: 0.0,
        coat: 0.0,
    }
}

/// A conductor / metallic surface (gold, iron, bronze, silver, arcane filigree).
pub fn metal(albedo: vec3, roughness: f32) -> Substance {
    Substance {
        albedo,
        roughness: clamp(roughness, 0.04, 1.0),
        emits: vec3(0.0),
        metallic: 1.0,
        ior: 1.5,
        transmission: 0.0,
        subsurface: 0.0,
        coat: 0.0,
    }
}

/// Wet or glazed dielectric (rain-slick basalt, lacquered wood, damp stone) with glossy clearcoat.
pub fn glazed(albedo: vec3, roughness: f32, coat: f32) -> Substance {
    Substance {
        albedo,
        roughness: clamp(roughness, 0.04, 1.0),
        emits: vec3(0.0),
        metallic: 0.0,
        ior: 1.5,
        transmission: 0.0,
        subsurface: 0.0,
        coat: clamp(coat, 0.0, 1.0),
    }
}

/// Clear or tinted refractive glass / crystal (`ior = 1.52`, high optical transmission).
pub fn glass(tint: vec3, roughness: f32 = 0.05, ior: f32 = 1.52) -> Substance {
    Substance {
        albedo: tint,
        roughness: clamp(roughness, 0.02, 0.9),
        emits: vec3(0.0),
        metallic: 0.0,
        ior,
        transmission: 0.94,
        subsurface: 0.0,
        coat: 0.35,
    }
}

/// Refractive water / sea surface (`ior = 1.333`, Beer-Lambert tinted transmission, crisp specular).
pub fn water(tint: vec3 = vec3(0.14, 0.42, 0.48), roughness: f32 = 0.06) -> Substance {
    Substance {
        albedo: tint,
        roughness: clamp(roughness, 0.02, 0.6),
        emits: vec3(0.0),
        metallic: 0.0,
        ior: 1.333,
        transmission: 0.88,
        subsurface: 0.15,
        coat: 0.25,
    }
}

/// Organic / translucent solid (skin, wax, frosted ice, jade) with subsurface wrap scattering.
pub fn translucent(albedo: vec3, roughness: f32, subsurface: f32) -> Substance {
    Substance {
        albedo,
        roughness: clamp(roughness, 0.08, 1.0),
        emits: vec3(0.0),
        metallic: 0.0,
        ior: 1.4,
        transmission: 0.0,
        subsurface: clamp(subsurface, 0.0, 1.0),
        coat: 0.0,
    }
}

/// Fine mineral sand (warm high-roughness dielectric with subtle crystalline glint).
pub fn sand(albedo: vec3 = vec3(0.76, 0.63, 0.42)) -> Substance {
    Substance {
        albedo,
        roughness: 0.78,
        emits: vec3(0.0),
        metallic: 0.0,
        ior: 1.54,
        transmission: 0.0,
        subsurface: 0.12,
        coat: 0.0,
    }
}

/// Glowing HDR emissive matter (spell core, fire, arcane rune, ember). Bright values automatically
/// drive dynamic specular illumination, local shadows, GI bounce, volumetric glow, and bloom.
pub fn emissive(albedo: vec3, emits: vec3, roughness: f32 = 0.25) -> Substance {
    Substance {
        albedo,
        roughness: clamp(roughness, 0.04, 1.0),
        emits,
        metallic: 0.0,
        ior: 1.5,
        transmission: 0.0,
        subsurface: 0.0,
        coat: 0.0,
    }
}
