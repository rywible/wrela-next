// Leather over boards, as a binder covers a book and hands wear it: tanned hide with a pebbled
// grain, darker where it is tooled (a blind line pressed hot burnishes the hide dark), paler and
// glossier where it is rubbed (a board's edges and corners, the spine's bands), and dull with dust
// in its recesses.

use engine::matter::substance::Substance
use shapes::made::{Material, Story}
use std::cmp::Eq
use std::field::{hash_u32, value_noise}
use std::hash::StateHash

/// A leather: its albedo, the size of its grain's pebbles (m), how worn it is (0 new, 1 worn
/// through to warm russet suede at its corners), how much antique gold leaf survives in its hot-
/// pressed tooling lines (`gild`, 0 blind to 1 gilded), and a seed.
pub struct Leather: Copy + GpuData + Eq + StateHash {
    pub albedo: vec3,
    pub pebble: f32,
    pub wear: f32,
    pub gild: f32,
    pub seed: f32,
}

/// A leather (`Leather`): by default deep antique dark cordovan-espresso calfskin (matte-satin,
/// no vinyl clearcoat).
pub fn leather(
    albedo: vec3 = vec3(0.088, 0.033, 0.018),
    pebble: f32 = 0.0010,
    wear: f32 = 0.60,
    gild: f32 = 0.0,
    seed: f32 = 0.0,
) -> Leather {
    Leather { albedo, pebble, wear, gild, seed }
}

/// A number in [0, 1) from a cell and a seed, the same everywhere.
fn cell01(c: vec3, seed: f32) -> f32 {
    let a = u32(i32(c.x) + 1048576).wrapping_mul(747796405)
    let b = u32(i32(c.y) + 1048576).wrapping_mul(2891336453)
    let d = u32(i32(c.z) + 1048576).wrapping_mul(1597334677)
    f32(hash_u32(a ^ b ^ d ^ u32(seed * 1000.0)) >> 8) * (1.0 / 16777216.0)
}

/// Crazing: the fine net of cracks old leather's finish breaks into, cells about 1.5 mm across, a
/// crack where a point is nearly as near its cell's second-nearest centre as its nearest (0 to 1).
fn crazed(p: vec3, seed: f32) -> f32 {
    let q = p / 0.0015
    // The 2×2×2 cells round the cell corner nearest `q`: every centre that can be nearest.
    let base = floor(q + vec3(0.5)) - vec3(1.0)
    var d1 = 9.0
    var d2 = 9.0
    for k in 0..8 {
        let cc = base + vec3(f32(k & 1), f32((k >> 1) & 1), f32((k >> 2) & 1))
        let centre = cc + vec3(cell01(cc, seed), cell01(cc, seed + 1.0), cell01(cc, seed + 2.0))
        let d = length(q - centre)
        if d < d1 {
            d2 = d1
            d1 = d
        } else if d < d2 {
            d2 = d
        }
    }
    smoothstep(0.1, 0.0, d2 - d1)
}

impl Material for Leather {
    fn at(self, p: vec3, story: Story) -> Substance {
        let q = p / max(self.pebble, 1.0e-5) + vec3(self.seed)
        // Multi-scale organic calfskin grain: supple hide ripples + fine irregular pebbles.
        let ripples = value_noise(p * 38.0 + vec3(self.seed * 1.9))
        let pebbles = value_noise(q) * 0.65 + value_noise(q * 2.2 + vec3(4.3)) * 0.35
        let crease = smoothstep(0.14, -0.35, pebbles)
        let blotch = value_noise(p * 24.0 + vec3(self.seed * 3.0))
        let oil = value_noise(p * 9.5 + vec3(self.seed * 1.7))
        var albedo = self.albedo *
            (0.90 + 0.18 * blotch + 0.14 * oil) *
            (1.0 - 0.16 * crease)
        let rubbed = max(story.exposure, 0.0)
        let recess = max(-story.exposure, 0.0)
        // Scuffs: gentle matte drags across the hide.
        let scuff = smoothstep(
            0.40,
            0.80,
            value_noise(vec3(p.x * 24.0, p.y * 80.0, p.z * 24.0) + vec3(self.seed * 5.0)),
        ) *
            self.wear
        // Fine age crazing + hairline flex creases along the leather hide.
        let craze = crazed(p, self.seed) * self.wear * (0.4 + 0.6 * smoothstep(-0.2, 0.6, blotch))
        // Soft warm chestnut patina on rubbed corners & ridges (never stark chalky triangles).
        let ragged = 0.22 * value_noise(p * 360.0 + vec3(self.seed * 7.0))
        let through = smoothstep(0.45, 1.30, rubbed * self.wear * 0.95 + ragged)
        albedo = mix(albedo, albedo * vec3(1.55, 1.32, 1.12), 0.65 * self.wear * rubbed * rubbed)
        albedo = mix(albedo, vec3(0.18, 0.088, 0.044), 0.55 * through)
        albedo = mix(albedo, albedo * vec3(1.26, 1.18, 1.08), 0.38 * scuff)
        albedo = albedo * (1.0 - 0.34 * craze)
        // Hot-pressed blind-tooled lines: burnished deep dark brown, with patchy, heavily aged
        // antique gold leaf traces where `gild > 0`.
        let tooled = clamp(story.depth / 0.0005, 0.0, 1.0)
        albedo = albedo * (1.0 - 0.56 * tooled) * (1.0 - 0.35 * recess)
        let flake = smoothstep(0.05, 0.58, value_noise(p * 140.0 + vec3(self.seed * 9.0)))
        let gold_mask = self.gild * smoothstep(0.38, 0.78, tooled) * (0.20 + 0.80 * flake)
        albedo = mix(albedo, vec3(0.58, 0.43, 0.17), gold_mask)
        // Physical microsurface height offset (m): tactile hide pebbles, subtle ripples & crazing.
        let bump = 0.000085 * pebbles +
            0.000045 * ripples -
            0.000065 * crease -
            0.000095 * craze -
            0.00022 * tooled -
            0.00003 * scuff
        // Authentic matte-satin aged leather (no shiny vinyl clearcoat).
        let rough = clamp(
            0.66 -
                0.22 * rubbed -
                0.14 * tooled +
                0.14 * crease +
                0.20 * through +
                0.14 * scuff +
                0.12 * craze +
                0.08 * blotch,
            0.34,
            0.94,
        )
        Substance {
            albedo: clamp(albedo, vec3(0.0), vec3(0.85)),
            roughness: mix(rough, 0.34, gold_mask),
            emits: vec3(0.0),
            metallic: gold_mask * 0.78,
            ior: 1.48,
            transmission: 0.0,
            subsurface: 0.04 * (1.0 - gold_mask),
            coat: 0.0,
            micro: 0.0,
            bump: bump,
            pad1: 0.0,
            pad2: 0.0,
        }
    }
}
