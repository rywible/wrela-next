// Leather over boards, as a binder covers a book and hands wear it: tanned hide with a pebbled
// grain, darker where it is tooled (a blind line pressed hot burnishes the hide dark), paler and
// glossier where it is rubbed (a board's edges and corners, the spine's bands), and dull with dust
// in its recesses.

use engine::matter::substance::Substance
use shapes::made::{Material, Story}
use std::cmp::Eq
use std::field::value_noise
use std::hash::StateHash

/// A leather: its albedo, the size of its grain's pebbles (m), how worn it is (0 new, 1 worn
/// through to the flesh side's pale suede at its corners) and a seed.
pub struct Leather: Copy + GpuData + Eq + StateHash {
    pub albedo: vec3,
    pub pebble: f32,
    pub wear: f32,
    pub seed: f32,
}

/// A leather (`Leather`): by default an old brown calf.
pub fn leather(
    albedo: vec3 = vec3(0.16, 0.075, 0.035),
    pebble: f32 = 0.0012,
    wear: f32 = 0.5,
    seed: f32 = 0.0,
) -> Leather {
    Leather { albedo, pebble, wear, seed }
}

impl Material for Leather {
    fn at(self, p: vec3, story: Story) -> Substance {
        let q = p / max(self.pebble, 1.0e-5) + vec3(self.seed)
        // The grain: pebbles, and the creases between them darker.
        let pebbles = value_noise(q)
        let crease = smoothstep(0.1, -0.4, pebbles)
        let blotch = value_noise(p * 40.0 + vec3(self.seed * 3.0))
        var albedo = self.albedo * (1.0 + 0.12 * blotch) * (1.0 - 0.15 * crease)
        let rubbed = max(story.exposure, 0.0)
        let recess = max(-story.exposure, 0.0)
        // Worn: rubbed through the finished grain to paler hide.
        albedo = mix(albedo, albedo * vec3(2.1, 1.9, 1.7), self.wear * rubbed * rubbed)
        // Tooled lines and recesses: burnished and dirty.
        let tooled = clamp(story.depth / 0.0006, 0.0, 1.0)
        albedo = albedo * (1.0 - 0.45 * tooled) * (1.0 - 0.3 * recess)
        Substance {
            albedo: clamp(albedo, vec3(0.0), vec3(0.8)),
            roughness: clamp(0.62 - 0.25 * rubbed - 0.15 * tooled + 0.12 * crease, 0.2, 0.95),
            emits: vec3(0.0),
            metallic: 0.0,
            ior: 1.5,
            transmission: 0.0,
            subsurface: 0.08,
            coat: clamp(0.2 + 0.4 * rubbed, 0.0, 1.0),
            micro: 0.0,
            pad0: 0.0,
            pad1: 0.0,
            pad2: 0.0,
        }
    }
}
