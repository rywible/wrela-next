// A solid's share of what holds the light off a point (lib/frame's `held`, docs/light.md): its
// volume, in its own frame, of how much of the sky is open past it in each of four wedges of
// the dome, worked out once when the solid loads, from its cooked mesh; and the grid of the
// fixed world's copies that finds the ones round a point.
//
// The volume is a cube round the solid's finest mesh (`MARGIN` times its widest extent, so the
// ground at its foot and its neighbours lie in it), `SIDE` texels a side. From that mesh's
// corners its distance is taken near its surface (each corner's plane, within a texel along
// it), the rest of the cube is told inside from outside by a flood from the cube's sides (the
// mesh is closed, so the flood can't get in), and the distance carried
// out from the surface (two sweeps of a chamfer: within a few percent of the true distance,
// never past it). That is CPU work at load, under a tenth of a second a solid (M4). On the
// GPU, in bands of slices (each under 2 ms on the M4, all of a solid's in its frame), each
// texel's rays (`RAYS` a wedge, even in solid angle) are marched through that distance until
// they leave the cube or meet the solid; the share that leave is the wedge's open sky.
//
// It reads the mesh the cook made, not the cook: what is asked of it here is its distance near
// its surface.

use meshes::Corner
use frame::held::{
    GRID, Held, IN_CELL, MOST_COPIES, MOST_HELD, NO_COPY, ROWS, ROWS_HIGH, SIDE, open_past_fixed,
    wedge,
}
use std::field::Bound
use std::gpu::{
    Atomics, GlobalId, GpuBuffer, R32Float, Rg32Uint, Rgba32Float, Rgba8, Slots, Texels3d,
    Texture3d,
}

/// How much wider than the solid's widest extent its volume is.
pub const MARGIN: f32 = 1.3

/// Rays a wedge (stratified: four ways round it by three heights, even in solid angle), and the
/// most steps a ray takes.
const ROUND: u32 = 4
const HEIGHTS: u32 = 3
pub const RAYS: u32 = ROUND * HEIGHTS
const STEPS: u32 = 40

/// Slices of the volume a band works out (a band a frame).
pub const SLICES: u32 = 8

/// Farther than anything (m).
const FAR: f32 = 1.0e9

/// A solid's volume, worked out on the CPU and waiting for the GPU: its solid, its low corner
/// and a texel's side (`w`), and its distance at each texel (m).
pub struct Hold {
    pub solid: u32,
    pub box_: vec4,
    pub field: Vec<f32>,
}

/// The texel index of (`x`, `y`, `z`).
fn at(x: u32, y: u32, z: u32) -> u32 {
    (z * SIDE + y) * SIDE + x
}

/// `bound`'s volume from the corners of its finest mesh (`meshes::Corner`, closed): its box and
/// distances, each corner's plane taken as the surface's
/// near it (within a texel along it; past that, the distance to the corner itself, signed by
/// its side of the plane).
pub fn hold_of_corners(solid: u32, bound: Bound, corners: [Corner]) -> Hold {
    var a = vec3(1.0e30)
    var b = vec3(-1.0e30)
    for c in corners {
        a = min(a, c.at)
        b = max(b, c.at)
    }
    if a.x > b.x {
        a = bound.centre - vec3(bound.radius)
        b = bound.centre + vec3(bound.radius)
    }
    let side = max(b.x - a.x, max(b.y - a.y, b.z - a.z)) * MARGIN
    let v = side / f32(SIDE)
    let lo = 0.5 * (a + b) - vec3(0.5 * side)
    var d: Vec<f32> = Vec::filled(SIDE * SIDE * SIDE, FAR)
    for c in corners {
        let lo_i = max((c.at - vec3(2.0 * v) - lo) / v - vec3(0.5), vec3(0.0))
        let hi_i = min((c.at + vec3(2.0 * v) - lo) / v - vec3(0.5), vec3(f32(SIDE - 1)))
        if hi_i.x >= lo_i.x && hi_i.y >= lo_i.y && hi_i.z >= lo_i.z {
            for z in u32(ceil(lo_i.z))..u32(floor(hi_i.z)) + 1 {
                for y in u32(ceil(lo_i.y))..u32(floor(hi_i.y)) + 1 {
                    for x in u32(ceil(lo_i.x))..u32(floor(hi_i.x)) + 1 {
                        let q = lo + (vec3(f32(x), f32(y), f32(z)) + vec3(0.5)) * v
                        let o = q - c.at
                        let along = dot(o, c.normal)
                        let flat = length(o - c.normal * along)
                        let s = if flat < v { along } else { sign(along) * length(o) }
                        let i = at(x, y, z)
                        if abs(s) < 2.0 * v && abs(s) < abs(d[i]) {
                            d[i] = s
                        }
                    }
                }
            }
        }
    }
    signed(mut d)
    swept(mut d, v)
    Hold { solid, box_: vec4(lo, v), field: take d }
}

/// The texels no corner reached told inside (`-FAR`) from outside (`FAR`): what a flood from the
/// cube's sides through them reaches is outside.
fn signed(d: mut Vec<f32>) {
    let n = SIDE * SIDE * SIDE
    var out: Vec<bool> = Vec::filled(n, false)
    var stack: Vec<u32> = Vec::new()
    let top = SIDE - 1
    for z in 0..SIDE {
        for y in 0..SIDE {
            for x in 0..SIDE {
                if x == 0 || y == 0 || z == 0 || x == top || y == top || z == top {
                    let i = at(x, y, z)
                    if d[i] >= FAR {
                        out[i] = true
                        stack.push(i)
                    }
                }
            }
        }
    }
    while stack.len() > 0 {
        let i = stack.pop().unwrap()
        let x = i % SIDE
        let y = (i / SIDE) % SIDE
        let z = i / (SIDE * SIDE)
        for k in 0..6 {
            let dx = if k == 0 { -1 } else if k == 1 { 1 } else { 0 }
            let dy = if k == 2 { -1 } else if k == 3 { 1 } else { 0 }
            let dz = if k == 4 { -1 } else if k == 5 { 1 } else { 0 }
            let nx = i32(x) + dx
            let ny = i32(y) + dy
            let nz = i32(z) + dz
            if nx >= 0 && ny >= 0 && nz >= 0 && nx < i32(SIDE) && ny < i32(SIDE) && nz < i32(SIDE) {
                let j = at(u32(nx), u32(ny), u32(nz))
                if !out[j] && d[j] >= FAR {
                    out[j] = true
                    stack.push(j)
                }
            }
        }
    }
    for i in 0..n {
        if d[i] >= FAR && !out[i] {
            d[i] = -FAR
        }
    }
}

/// The distance carried out from the surface's texels to every other: two sweeps of a chamfer
/// over the 26 neighbours (each sweep the 13 it has passed), the sign kept.
fn swept(d: mut Vec<f32>, v: f32) {
    for pass in 0..2 {
        let back = pass == 1
        for zz in 0..SIDE {
            let z = if back { SIDE - 1 - zz } else { zz }
            for yy in 0..SIDE {
                let y = if back { SIDE - 1 - yy } else { yy }
                for xx in 0..SIDE {
                    let x = if back { SIDE - 1 - xx } else { xx }
                    let i = at(x, y, z)
                    var best = abs(d[i])
                    for k in 0..13 {
                        // (The 13 neighbours before a texel in the sweep's order.)
                        let o = before(k)
                        let s = if back { -1 } else { 1 }
                        let nx = i32(x) - s * o.x
                        let ny = i32(y) - s * o.y
                        let nz = i32(z) - s * o.z
                        if nx >= 0 && ny >= 0 && nz >= 0 && nx < i32(SIDE) && ny < i32(SIDE) && nz < i32(SIDE) {
                            let far = abs(d[at(u32(nx), u32(ny), u32(nz))])
                            if far < FAR {
                                let step = sqrt(f32(o.x * o.x + o.y * o.y + o.z * o.z)) * v
                                best = min(best, far + step)
                            }
                        }
                    }
                    if best < abs(d[i]) {
                        d[i] = if d[i] < 0.0 { -best } else { best }
                    }
                }
            }
        }
    }
}

/// The `k`th of the 13 neighbours a forward sweep has passed: (dx, dy, dz) back from a texel.
fn before(k: u32) -> vec3i {
    if k < 9 {
        vec3i(i32(k % 3) - 1, i32(k / 3) - 1, 1)
    } else if k < 12 {
        vec3i(i32(k - 9) - 1, 1, 0)
    } else {
        vec3i(1, 0, 0)
    }
}

/// Texel `id` of the scratch distance, in texels (`per`: texels a metre), from the CPU's
/// `values` (m).
@compute(4, 4, 4)
pub fn fielded(values: [f32], per: f32, out: mut Texels3d<R32Float>, id: GlobalId) {
    if id.x >= SIDE || id.y >= SIDE || id.z >= SIDE {
        return
    }
    out.store(id, values[at(id.x, id.y, id.z)] * per)
}

/// The distance at `q` (in texels from the cube's low corner, texel middles at halves), between
/// the eight texels round it.
fn distance_at(field: Texture3d<R32Float>, q: vec3) -> f32 {
    let c = clamp(q - vec3(0.5), vec3(0.0), vec3(f32(SIDE - 1) - 0.001))
    let lo = vec3u(u32(c.x), u32(c.y), u32(c.z))
    let f = c - vec3(f32(lo.x), f32(lo.y), f32(lo.z))
    let x00 = mix(field.load(lo.x, lo.y, lo.z), field.load(lo.x + 1, lo.y, lo.z), f.x)
    let x10 = mix(field.load(lo.x, lo.y + 1, lo.z), field.load(lo.x + 1, lo.y + 1, lo.z), f.x)
    let x01 = mix(field.load(lo.x, lo.y, lo.z + 1), field.load(lo.x + 1, lo.y, lo.z + 1), f.x)
    let x11 = mix(field.load(lo.x, lo.y + 1, lo.z + 1), field.load(lo.x + 1, lo.y + 1, lo.z + 1), f.x)
    mix(mix(x00, x10, f.y), mix(x01, x11, f.y), f.z)
}

/// Ray `r` of wedge `w` (a unit vector): `ROUND` ways across the wedge by `HEIGHTS` heights,
/// each an even share of its solid angle.
pub fn ray(w: u32, r: u32) -> vec3 {
    let round = r % ROUND
    let up = r / ROUND
    let a = (f32(w) - 0.5 + (f32(round) + 0.5) / f32(ROUND)) * 1.5707964
    let s = (f32(up) + 0.5) / f32(HEIGHTS)
    let flat = sqrt(1.0 - s * s)
    vec3(cos(a) * flat, s, sin(a) * flat)
}

/// Texel (`id.x`, `id.y`, `from + id.z`)'s four wedges: the share of each one's rays that leave
/// the cube without meeting the solid, a byte each, into `out` (`Atomics` only to write where
/// the band says: each texel is written once). A texel inside the solid or within a texel of its
/// surface holds what the point a texel out from the surface, along the distance's gradient,
/// sees: so a face read between texels never reads the solid's inside as its sky.
@compute(4, 4, 4)
pub fn wedged(field: Texture3d<R32Float>, from: u32, out: mut Atomics<u32>, id: GlobalId) {
    let z = from + id.z
    if id.x >= SIDE || id.y >= SIDE || z >= SIDE {
        return
    }
    var p = vec3(f32(id.x), f32(id.y), f32(z)) + vec3(0.5)
    let here = distance_at(field, p)
    if here < 1.0 {
        let g = vec3(
            distance_at(field, p + vec3(0.5, 0.0, 0.0)) - distance_at(field, p - vec3(0.5, 0.0, 0.0)),
            distance_at(field, p + vec3(0.0, 0.5, 0.0)) - distance_at(field, p - vec3(0.0, 0.5, 0.0)),
            distance_at(field, p + vec3(0.0, 0.0, 0.5)) - distance_at(field, p - vec3(0.0, 0.0, 0.5)),
        )
        p += g / max(length(g), 1.0e-6) * (1.0 - here)
    }
    var word: u32 = 0
    for w in 0..4 {
        var open: u32 = 0
        for r in 0..RAYS {
            let d = ray(w, r)
            var t = 0.5
            var met = false
            var gone = false
            for _s in 0..STEPS {
                if !met && !gone {
                    let q = p + d * t
                    if q.x < 0.0 || q.y < 0.0 || q.z < 0.0 || q.x > f32(SIDE) ||
                        q.y > f32(SIDE) ||
                        q.z > f32(SIDE) {
                        gone = true
                    } else {
                        let s = distance_at(field, q)
                        if s < 0.15 {
                            met = true
                        }
                        t += max(s, 0.35)
                    }
                }
            }
            if !met {
                open += 1
            }
        }
        word |= (open * 255 / RAYS) << (8 * w)
    }
    let _ = out.exchange(at(id.x, id.y, z), word)
}

/// Texel `id` of the volumes' texture, for the solid at `slot` (its layers `slot SIDE` up): its
/// wedges as `wedged` packed them.
@compute(4, 4, 4)
pub fn shelved(words: [u32], slot: u32, out: mut Texels3d<Rgba8>, id: GlobalId) {
    if id.x >= SIDE || id.y >= SIDE || id.z < slot * SIDE || id.z >= (slot + 1) * SIDE {
        return
    }
    let w = words[at(id.x, id.y, id.z - slot * SIDE)]
    out.store(
        id,
        vec4(f32(w & 255), f32((w >> 8) & 255), f32((w >> 16) & 255), f32(w >> 24)) / 255.0,
    )
}

/// Copy `id`'s share of the sky from the fixed world's other copies (`frame::held::
/// open_past_fixed`: the world's four wedges), at its middle (`middles[id]`'s `xyz`), where
/// `middles[id].w` is `which` (1 for every copy that never moved, when the grid is laid; 2 for the
/// copies that move, each frame); the rest are left as they are.
@compute(64)
pub fn shared(held: Held, middles: [vec4], count: u32, which: f32, out: mut Slots<vec4>, id: GlobalId) {
    if id.x >= count {
        return
    }
    let m = middles[id.x]
    if m.w == which {
        out[id] = open_past_fixed(held, m.xyz, id.x)
    }
}

/// Texel `id` of the grid's cells, from the CPU's `words` (a cell's two words a layer).
@compute(8, 8, 1)
pub fn gridded(words: [u32], out: mut Texels3d<Rg32Uint>, id: GlobalId) {
    if id.x >= GRID || id.y >= GRID || id.z >= IN_CELL / 4 {
        return
    }
    let i = 2 * ((id.z * GRID + id.y) * GRID + id.x)
    out.store(id, vec2u(words[i], words[i + 1]))
}

/// Texel `id` of the copies' rows, from the CPU's `rows`.
@compute(8, 32, 1)
pub fn rowed(rows: [vec4], out: mut Texels3d<Rgba32Float>, id: GlobalId) {
    if id.x >= ROWS || id.y >= ROWS_HIGH || id.z >= MOST_COPIES / ROWS_HIGH {
        return
    }
    out.store(id, rows[(id.z * ROWS_HIGH + id.y) * ROWS + id.x])
}

/// The rows of the map from the world to the frame `m` carries to the world (its inverse
/// `back`): three `vec4`s, `dot(r.xyz, p) + r.w` each.
pub fn rows_of(back: mat4) -> (vec4, vec4, vec4) {
    (
        vec4(back[0].x, back[1].x, back[2].x, back[3].x),
        vec4(back[0].y, back[1].y, back[2].y, back[3].y),
        vec4(back[0].z, back[1].z, back[2].z, back[3].z),
    )
}

/// The cells (low and high, inclusive, x and z) the box `lo` to `lo + side` of a copy's solid,
/// carried to the world by `m`, reaches on a grid from `origin` of cells `cell` m.
pub fn cells_of(m: mat4, lo: vec3, side: f32, origin: vec2, cell: f32) -> vec4 {
    var a = vec2(1.0e30)
    var b = vec2(-1.0e30)
    for k in 0..8 {
        let c = lo + vec3(
            if (k & 1) != 0 { side } else { 0.0 },
            if (k & 2) != 0 { side } else { 0.0 },
            if (k & 4) != 0 { side } else { 0.0 },
        )
        let w = (m * vec4(c, 1.0)).xyz
        a = min(a, w.xz)
        b = max(b, w.xz)
    }
    vec4((a - origin) / cell, (b - origin) / cell)
}
