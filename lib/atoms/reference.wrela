// The reference a solid's meshes are held to: the solid itself, marched along each pixel's ray to
// its first change of sign and that span halved 24 times (slow, and as near the surface as a
// float holds), lit by the same shading function as the meshes, with the band edges plain (the
// mean of many looks a pixel softens them as a pixel would); where asked, its sun's beam stopped
// where a ray from the point to the sun meets the form (a true shadow of itself). One look a
// frame, into a judge's look targets (`frame::judge`). From the atoms spike's `traced`
// (draw.wrela:329).

use form::kinds::{Paint, Solid}
use form::look::{Look, Place}
use form::shade::STILL
use frame::eye::Eye
use frame::judge::Judge
use frame::last::{cover, painted}
use frame::light::{Lighting, sun_reach, worn}
use std::gpu::{Compare, Depth, FragCoord, Targets2, WithDepth, begin_pass2_with_depth, draw, label}

/// The least a reference's step is (m): what thinner than this it may step over.
const STEP: f32 = 0.00005

/// One look of the reference's: `form` along the pixel's ray (within its bound, `bound`: a
/// sphere's middle and radius, by steps of `rate` of its distance), wearing `look` in `light`;
/// the sky where it meets nothing; with `shadowed`, the sun's beam stopped where the ray from
/// the point to the sun meets the form again. Its colour, the way it faces, its depth.
@fragment
pub fn traced<S: Solid, L: Look, P: Paint>(
    pixel: FragCoord,
    eye: Eye,
    light: Lighting,
    form: S,
    look: L,
    sky: P,
    bound: vec4,
    rate: f32,
    shadowed: u32,
) -> WithDepth<Targets2<vec4, vec4>> {
    let d = eye.ray(pixel.position.xy)
    let from = eye.at
    let none = WithDepth {
        color: Targets2 { first: vec4(painted(eye, sky, d), 1.0), second: vec4(0.0) },
        depth: 0.0,
    }
    let oc = from - bound.xyz
    let b = dot(oc, d)
    let h = b * b - (dot(oc, oc) - bound.w * bound.w)
    if !(h >= 0.0) {
        return none
    }
    let s = sqrt(max(h, 0.0))
    var t = max(-b - s, eye.near)
    let end = -b + s
    var before = t
    var crossed = false
    var i = 0
    while i < 4000 && !crossed && t < end {
        let v = form.distance(from + d * t)
        if v < 0.0 {
            crossed = true
        } else {
            before = t
            t += max(rate * v, STEP)
        }
        i += 1
    }
    if !crossed {
        return none
    }
    var lo = before
    var hi = t
    for _k in 0..24 {
        let m = 0.5 * (lo + hi)
        if form.distance(from + d * m) < 0.0 {
            hi = m
        } else {
            lo = m
        }
    }
    let p = from + d * (0.5 * (lo + hi))
    let n = normalize(form.gradient(p))
    var reach = sun_reach(light, p)
    if shadowed != 0 && reach > 0.0 && dot(n, light.sun) > 0.0 && met(form, p + n * LEAVE, light.sun, bound, rate) {
        reach = 0.0
    }
    let skin = look.skin(Place { world: p, rest: p, chart: None, normal: n })
    let lit = worn(light, skin, p, n, -d, STILL, reach: reach)
    WithDepth {
        color: Targets2 { first: vec4(lit.colour, 1.0), second: vec4(n, 0.0) },
        depth: eye.depth(p),
    }
}

/// How far off its surface a point's ray to the sun starts (m): past the float's error in the
/// point (the span halved 24 times), short of any feature the meshes keep.
const LEAVE: f32 = 0.0005

/// Whether the ray from `from` along `d` meets `form` before it leaves its bound (`bound`: a
/// sphere's middle and radius), by steps of `rate` of its distance.
fn met<S: Solid>(form: S, from: vec3, d: vec3, bound: vec4, rate: f32) -> bool {
    let oc = from - bound.xyz
    let b = dot(oc, d)
    let end = -b + sqrt(max(b * b - (dot(oc, oc) - bound.w * bound.w), 0.0))
    var t = 0.0
    var i = 0
    while i < 4000 && t < end {
        let v = form.distance(from + d * t)
        if v < 0.0 {
            return true
        }
        t += max(rate * v, STEP)
        i += 1
    }
    false
}

/// One look of `form` wearing `look`, as `eye` sees it in `light` with `sky` behind, into
/// `judge`'s look targets: band `band` of `bands` bands of the screen's rows (AGENTS.md, rule 4:
/// a 4K look in one pass held the GPU 420 ms), over the bands drawn before it. A look is whole
/// once each of its bands is drawn, its eye held. With `shadowed`, the form shadows itself.
pub fn trace<S: Solid, L: Look, P: Paint>(
    judge: mut Judge,
    eye: Eye,
    light: Lighting,
    form: S,
    look: L,
    sky: P,
    band: u32 = 0,
    bands: u32 = 1,
    shadowed: bool = false,
) {
    let b = form.bound()
    // Steps of a share of the distance its steepness allows, or of a fifth where it states none.
    let steep = form.lipschitz(0.05)
    let rate = if steep < 5.0 { 0.7 / max(steep, 1.0) } else { 0.2 }
    label("reference")
    let p = begin_pass2_with_depth(
        mut judge.look_colour,
        mut judge.look_normal,
        mut judge.look_depth,
        clear: vec4(0.0),
        keep: bands > 1,
        clear_depth: 0.0,
        keep_depth: bands > 1,
    )
    let h = u32(eye.size.y)
    let from = band * h / bands
    p.scissor(0, from, u32(eye.size.x), (band + 1) * h / bands - from)
    draw(
        p,
        cover,
        traced.bind(
            eye,
            light: light,
            form: form,
            look: look,
            sky: sky,
            bound: vec4(b.centre, b.radius),
            rate: rate,
            shadowed: if shadowed { 1 } else { 0 },
        ),
        vertices: 3,
        depth: Depth { compare: Compare::Always, write: true },
    )
    p.end()
}
