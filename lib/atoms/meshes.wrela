// A solid drawn from its cooked meshes (`mesh::bake_mesh`): each copy's set, chosen by its
// distance, drawn as ordinary opaque triangles into the frame's one pass,
// each pixel shaded once through `frame::light::worn` with its look at its place; its edge record
// the nearer of its outline (the squared facing of the vertex normals, laid across each
// triangle: `frame::outline`) and the creases of its triangle (an edge whose two triangles reach
// it by different copies of its vertices: each face's own normal either side), a line where a
// crease is, as a limb's cut is; how much of the sky reaches each vertex its own solid's share
// baked at the cook, times its copy's share from the fixed world's other copies (worked out once
// a copy, `held::shared`), times what the copies that move leave it, asked only near them.
//
// A set's triangles with no crease are drawn indexed, each corner shaded once; its triangles
// with a crease (a few in a hundred) are drawn three corners each, unshared, so each pixel of
// them knows how far it is from each of its triangle's edges and which are creases. A look baked
// at the cook (`mesh::bake_mesh_worn`) is read from the corners and laid between them, nothing of
// it asked in a frame but `Look::finished` on the triangles its cook marked fine (drawn as a run
// of their own, after the rest of the plain ones). On a solid cooked bare, a look that says it is
// coarse (`Look::coarse`) is worked out at the corners each frame and laid between them; any other
// at each pixel.
//
// Each way of wearing a look is a pipeline of its own (`wears`, a constant of the draw): a
// program holds only the code its draw can reach. A look's code is most of a program's size (the
// opening's at the pixel, 51,108 work for its every look, against 966 for a baked triangle's
// pixel), and a GPU sets aside room for the largest path a program has, whichever it takes.

use copies::{Placing, world_normal, world_of}
use form::look::{Look, Place, Skin}
use form::shade::{Steps, lit}
use frame::eye::Eye
use frame::held::{combined, in_front, movers_seen}
use frame::light::{Lighting, sun_reach}
use frame::outline::{fold_field, way_to_outline}
use frame::picture::{NO_EDGE, SOLID, edge_record, identity}
use mesh::{FINE_BIT, MESH_MAGIC, VERTEX_WORDS, kept_of, worn_of}
use std::field::Bound
use std::gpu::{ClipPosition, Flat, InstanceIndex, Targets3, VertexIndex}

/// A vertex of a set's mesh as the GPU holds it: its place and normal in the solid's own frame,
/// the first vertex at its place (a crease's copies share it), and as its file has them, its
/// baked look's colour, the sky it sees past its own solid and its wear (`mesh`'s header, words
/// 7, 14 and 15).
pub struct Corner: Copy + GpuData {
    pub at: vec3,
    pub place: u32,
    pub normal: vec3,
    pub colour: u32,
    pub sky: u32,
    pub wear: u32,
    pub spare: vec2u,
}

/// One set of a solid's meshes read back: its distance, its corners, its triangles (three
/// corners each, counter-clockwise from outside): those with no crease and no corner its baked
/// look marked fine first (`plain` of them), then those with no crease and a fine corner (`fine`),
/// then the creased; and which of each triangle's edges are creases (bit `i`: the edge across
/// from its corner `i`).
pub struct MeshRead {
    pub at: f32,
    pub corners: Vec<Corner>,
    pub triangles: Vec<u32>,
    pub creases: Vec<u32>,
    pub plain: u32,
    pub fine: u32,
}

/// How a draw's copies wear their look: baked at the cook and read from the corners; a coarse
/// look worked out at the corners each frame; a look worked out at each pixel.
pub const BAKED: u32 = 0
pub const AT_CORNERS: u32 = 1
pub const AT_PIXELS: u32 = 2

/// Whether `words` are a mesh's file.
pub fn is_mesh(words: [u32]) -> bool {
    words.len() > 0 && words[0] == MESH_MAGIC
}

fn f(words: [u32], i: u32) -> f32 {
    bitcast_f32(words[i])
}

/// A mesh's file read back: the solid's bound, and its sets.
pub fn read_mesh(words: [u32]) -> (Bound, Vec<MeshRead>) {
    assert(is_mesh(words), "not a mesh's file")
    let sets = words[1]
    let bound = Bound {
        centre: vec3(f(words, 2), f(words, 3), f(words, 4)),
        radius: f(words, 5),
        slope: 0.5,
    }
    var at = 6 + 4 * sets
    var out: Vec<MeshRead> = Vec::new()
    for k in 0..sets {
        let head = 6 + 4 * k
        let nv = words[head + 2]
        let nt = words[head + 3]
        var corners: Vec<Corner> = Vec::with_capacity(nv)
        for i in 0..nv {
            let w = at + VERTEX_WORDS * i
            corners.push(
                Corner {
                    at: vec3(f(words, w), f(words, w + 1), f(words, w + 2)),
                    place: words[w + 6],
                    normal: vec3(f(words, w + 3), f(words, w + 4), f(words, w + 5)),
                    colour: words[w + 7],
                    sky: words[w + 14],
                    wear: words[w + 15],
                    spare: vec2u(0, 0),
                },
            )
        }
        at += VERTEX_WORDS * nv
        var triangles: Vec<u32> = Vec::with_capacity(3 * nt)
        for i in 0..3 * nt {
            triangles.push(words[at + i])
        }
        at += 3 * nt
        let marks = creases_of(triangles, corners)
        // (Each triangle's class: 0 plain, 1 plain with a corner marked fine, 2 creased; drawn
        // in that order.)
        let fine_at = |c: u32| (corners[c].wear >> FINE_BIT) & 1 != 0
        var class: Vec<u32> = Vec::with_capacity(nt)
        for t in 0..nt {
            let fine = fine_at(triangles[3 * t]) || fine_at(triangles[3 * t + 1]) || fine_at(triangles[3 * t + 2])
            class.push(if marks[t] != 0 { 2 } else if fine { 1 } else { 0 })
        }
        var tris: Vec<u32> = Vec::with_capacity(3 * nt)
        var creases: Vec<u32> = Vec::with_capacity(nt)
        var counts = vec3u(0, 0, 0)
        for pass in 0..3 {
            for t in 0..nt {
                if class[t] == pass {
                    tris.push(triangles[3 * t])
                    tris.push(triangles[3 * t + 1])
                    tris.push(triangles[3 * t + 2])
                    creases.push(marks[t])
                    if pass == 0 {
                        counts.x += 1
                    } else if pass == 1 {
                        counts.y += 1
                    }
                }
            }
        }
        out.push(MeshRead { at: f(words, head), corners, triangles: tris, creases, plain: counts.x, fine: counts.y })
    }
    (bound, take out)
}

/// How far two faces turn from each other at an edge for it to be a crease though its corners
/// are shared: where the ink's crease band begins (`1 - na·nb` past 0.30, docs/frame.md, "Ink").
const TURNED: f32 = 0.30

/// Which of each triangle's edges are creases: an edge from corner `a` to `b` is shared with
/// the triangle across it as `b` to `a` where the surface is smooth there, and by other copies
/// of its places where it is a crease (the cook writes a crease's vertex once a face); and an
/// edge shared whole whose two faces turn past `TURNED` from each other is one too.
fn creases_of(triangles: [u32], corners: [Corner]) -> Vec<u32> {
    let nt = triangles.len() / 3
    var edges: Vec<vec3u> = Vec::with_capacity(3 * nt)
    for t in 0..nt {
        for i in 0..3 {
            edges.push(vec3u(triangles[3 * t + (i + 1) % 3], triangles[3 * t + (i + 2) % 3], t))
        }
    }
    var sorted = edges.clone()
    std::collections::sort_by(mut sorted, |a: vec3u, b: vec3u| a.x < b.x || (a.x == b.x && a.y < b.y))
    var out: Vec<u32> = Vec::filled(nt, 0)
    for t in 0..nt {
        for i in 0..3 {
            let e = edges[3 * t + i]
            let k = found(sorted, vec2u(e.y, e.x))
            if k >= sorted.len() {
                out[t] |= 1 << i
            } else if 1.0 - dot(face(triangles, corners, t), face(triangles, corners, sorted[k].z)) > TURNED {
                out[t] |= 1 << i
            }
        }
    }
    out
}

/// Triangle `t`'s own facing (a unit vector).
fn face(triangles: [u32], corners: [Corner], t: u32) -> vec3 {
    let a = corners[triangles[3 * t]].at
    let b = corners[triangles[3 * t + 1]].at
    let c = corners[triangles[3 * t + 2]].at
    let n = cross(b - a, c - a)
    n / max(length(n), 1.0e-20)
}

/// Where the sorted `edges` hold `e` (from, to), or past their end.
fn found(edges: [vec3u], e: vec2u) -> u32 {
    var lo: u32 = 0
    var hi = edges.len()
    while lo < hi {
        let m = (lo + hi) / 2
        let x = edges[m]
        if x.x < e.x || (x.x == e.x && x.y < e.y) { lo = m + 1 } else { hi = m }
    }
    if lo < edges.len() && edges[lo].x == e.x && edges[lo].y == e.y { lo } else { edges.len() }
}

/// What a mesh's vertex passes to its pixels: where it is (the world's and its solid's own), its
/// normal, its outline's field, how far it is from each of its triangle's edges (1 at its own
/// corner, 0 across from it: drawn unshared only), which edges are creases, its copy, how much
/// sky reaches it and how much of the sun's beam (`reach`), what its look wears there (baked, or a coarse look's): albedo and line,
/// metal, what the look kept; and whether its triangle is fine (1: creased ones only).
pub struct Meshed: Copy {
    pub clip: ClipPosition,
    pub world: vec3,
    pub rest: vec3,
    pub normal: vec3,
    pub field: f32,
    pub across: vec3,
    pub sky: f32,
    pub reach: f32,
    pub worn: vec4,
    pub metal: f32,
    pub kept: vec2,
    pub creases: Flat<u32>,
    pub copy: Flat<u32>,
    pub fine: Flat<u32>,
}

/// Corner `k` of copy `copy` (of `copies`), seen by `eye`, its look worn as `wears` says: what it
/// passes to its pixels.
fn meshed_at<L: Look>(
    eye: Eye,
    light: Lighting,
    looks: [L],
    k: Corner,
    copy: u32,
    p: Placing,
    across: vec3,
    creases: u32,
    fine: bool,
    shares: [vec4],
    own_sun: u32,
    wears: u32,
) -> Meshed {
    let world = world_of(p, k.at)
    let n = world_normal(p, k.normal)
    let toward = normalize(eye.at - world)
    var worn = vec4(0.0)
    var metal = 0.0
    var kept = vec2(0.0)
    if wears == BAKED {
        // (As this copy wears it: `Look::copied`.)
        let w = worn_of(k.colour)
        let skin = looks[p.look].copied(Skin { albedo: w.xyz, line: w.w, metal: f32(k.wear & 255) / 255.0, kept: kept_of(k.wear) })
        worn = vec4(skin.albedo, skin.line)
        metal = skin.metal
        kept = skin.kept
    } else if wears == AT_CORNERS {
        let skin = looks[p.look].skin(Place { world, rest: k.at, chart: None, normal: n })
        worn = vec4(skin.albedo, skin.line)
        metal = skin.metal
    }
    Meshed {
        clip: ClipPosition { position: eye.clip(world) },
        world,
        rest: k.at,
        normal: n,
        field: fold_field(n, toward),
        across,
        sky: sky_of(light, k, copy, world, n, shares),
        reach: sun_reach(light, world) * if own_sun != 0 { sun_past_own(k, p, light.sun) } else { 1.0 },
        worn,
        metal,
        kept,
        creases: Flat { value: creases },
        copy: Flat { value: copy },
        fine: Flat { value: if fine { 1 } else { 0 } },
    }
}

/// Corner `v` (its index in the pool) of a draw of a set's plain triangles, indexed, for the copy
/// listed at `first + i` (`listed`, of `copies`), its look worn as `wears` says.
@vertex
pub fn plain_vertex<L: Look>(
    v: VertexIndex,
    i: InstanceIndex,
    eye: Eye,
    light: Lighting,
    looks: [L],
    corners: [Corner],
    copies: [Placing],
    listed: [u32],
    first: u32,
    shares: [vec4],
    own_sun: u32,
    wears: const u32,
) -> Meshed {
    let copy = listed[first + i.index]
    meshed_at(eye, light, looks, corners[v.index], copy, copies[copy], vec3(1.0), 0, false, shares, own_sun, wears)
}

/// Vertex `v` of a draw of a set's creased triangles from triangle `from.x`, three corners each,
/// for the copy listed at `from.y + i`, its look worn as `wears` says.
@vertex
pub fn creased_vertex<L: Look>(
    v: VertexIndex,
    i: InstanceIndex,
    eye: Eye,
    light: Lighting,
    looks: [L],
    corners: [Corner],
    triangles: [u32],
    creases: [u32],
    copies: [Placing],
    listed: [u32],
    from: vec2u,
    shares: [vec4],
    own_sun: u32,
    wears: const u32,
) -> Meshed {
    let t = from.x + v.index / 3
    let c = v.index % 3
    let copy = listed[from.y + i.index]
    let across = vec3(if c == 0 { 1.0 } else { 0.0 }, if c == 1 { 1.0 } else { 0.0 }, if c == 2 { 1.0 } else { 0.0 })
    let marks = (corners[triangles[3 * t]].wear | corners[triangles[3 * t + 1]].wear | corners[triangles[3 * t + 2]].wear)
    let fine = (marks >> FINE_BIT) & 1 != 0
    meshed_at(eye, light, looks, corners[triangles[3 * t + c]], copy, copies[copy], across, creases[t], fine, shares, own_sun, wears)
}

/// How much of the sky reaches corner `k` of copy `copy`, at `world` turned `n` (the world's): what
/// its own solid leaves it (its cook's four wedges, `mesh`'s word 14, in the solid's frame), times
/// what the fixed world's other copies leave its copy (`shares`, the world's wedges, worked out
/// once at the copy's middle: `held::shared`), times what the copies that move leave it here
/// (asked only near them). Each combined as `frame::held` combines a volume's.
fn sky_of(light: Lighting, k: Corner, copy: u32, world: vec3, n: vec3, shares: [vec4]) -> f32 {
    let s = k.sky
    let own = vec4(f32(s & 255), f32((s >> 8) & 255), f32((s >> 16) & 255), f32(s >> 24)) / 255.0
    combined(own, k.normal) * combined(shares[copy], n) * movers_seen(light.held, world, n, copy)
}

/// How much of the sun's way corner `k` of a copy placed by `p` sees past its own solid: its cook's
/// four wedges (`mesh`'s word 14, in the solid's frame) between the two the sun's bearing lies
/// between, as much as the sun is toward each (the sun toward `sun`, the world's), each wedge's
/// open share of the part in front of the face (as `frame::held::combined` takes it). Nothing a
/// frame: a face under an overhang the sun is behind takes none of it.
fn sun_past_own(k: Corner, p: Placing, sun: vec3) -> f32 {
    let s = k.sky
    let own = vec4(f32(s & 255), f32((s >> 8) & 255), f32((s >> 16) & 255), f32(s >> 24)) / 255.0
    let way = (p.to_body * vec4(sun, 0.0)).xyz
    let flat = vec2(way.x, way.z) / max(length(vec2(way.x, way.z)), 1.0e-6)
    let w = max(vec4(flat.x, flat.y, -flat.x, -flat.y), vec4(0.0))
    let seen = min(own / max(in_front(k.normal), vec4(0.05)), vec4(1.0))
    dot(seen, w) / max(w.x + w.y + w.z + w.w, 1.0e-6)
}

/// The way from a pixel to the edge of its triangle where `b` (laid from 1 at the far corner)
/// falls to 0, from its screen derivatives.
fn to_edge(b: f32) -> vec2 {
    way_to_outline(b, vec2(dpdx(b), dpdy(b)))
}

/// The nearer of two edges.
fn nearer(x: vec2, y: vec2) -> vec2 {
    if dot(x, x) <= dot(y, y) { x } else { y }
}

/// A pixel of a mesh: shaded by its look (worn as `wears` says) and the frame's light, its edge
/// the nearer of its outline and its triangle's creases, its copy's identity, at its triangle's
/// depth. Its sky is always its corners' (`sky_of`), so `lit` is called with it here: through
/// `frame::light::worn`, whose sky may be asked of the held volume at the pixel, the program
/// would carry that march too.
@fragment
pub fn mesh_pixel<L: Look>(
    f: Meshed,
    eye: Eye,
    light: Lighting,
    looks: [L],
    copies: [Placing],
    lights: const u32,
    creased: const bool,
    fine: const bool,
    wears: const u32,
) -> Targets3<vec4, vec4, u32> {
    let p = copies[f.copy.value]
    let n = normalize(f.normal)
    let toward = normalize(eye.at - f.world)
    let at = Place { world: f.world, rest: f.rest, chart: None, normal: n }
    let laid = Skin { albedo: f.worn.xyz, line: f.worn.w, metal: f.metal, rim: false, kept: f.kept }
    var skin = laid
    if wears == AT_PIXELS {
        skin = looks[p.look].skin(at)
    } else if wears == BAKED && (fine || (creased && f.fine.value != 0)) {
        // (Baked: the pixel part only on a triangle the cook marked fine.)
        skin = looks[p.look].finished(laid, at)
    }
    let steps = Steps {
        across: dpdx(f.world),
        down: dpdy(f.world),
        normal_across: dpdx(n),
        normal_down: dpdy(n),
        relief: vec2(0.0),
    }
    let colour = lit(
        light.style,
        skin,
        n,
        light.sun,
        toward,
        reach: f.reach,
        sky: f.sky,
        height: f.world.y - light.ground,
        steps: steps,
        around: light.lights.from(f.world),
        live: lights,
        skylight: light.sky,
    )
    var way = way_to_outline(f.field, vec2(dpdx(f.field), dpdy(f.field)))
    // (A creased triangle's edges' ways, kept where the edge is a crease; a plain triangle's
    // pipeline has none.)
    if creased {
        let e0 = to_edge(f.across.x)
        let e1 = to_edge(f.across.y)
        let e2 = to_edge(f.across.z)
        let m = f.creases.value
        way = nearer(way, if (m & 1) != 0 { e0 } else { NO_EDGE })
        way = nearer(way, if (m & 2) != 0 { e1 } else { NO_EDGE })
        way = nearer(way, if (m & 4) != 0 { e2 } else { NO_EDGE })
    }
    Targets3 {
        first: vec4(colour, 0.0),
        second: edge_record(way, 1.0, skin.line),
        third: identity(SOLID, p.body, p.group),
    }
}
