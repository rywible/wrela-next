// Copies: a solid is cooked once, in its own frame, and drawn as many times as it's placed. A
// copy carries a point of the solid to the world by its own matrix (`to_world`), which may
// change every frame, and stands in the picture as its own body and ink group.
//
// A copy's matrix may be any affine map the solid can be drawn through: a rigid placement, a
// mirror image (a body's left boot drawn on the right), or a shear or a stretch (a smear). A
// triangle carried by an affine map is the triangle of the carried corners, so the copy is drawn
// exactly as its map says. What the cook held the mesh to (a quarter of a pixel) it held in the
// solid's own frame: a copy stretched `s` times strays up to `s` times as far, and its sets are
// chosen as if it stood `s` times nearer.

/// A copy as the GPU reads it: its matrix to the world and back, the eye in its own frame this
/// frame, whether it's rigid (1) or not (0), its identity in the picture (`frame::picture::
/// identity`'s body and group), which look it wears, and the most it stretches a length (1 for a
/// rigid copy).
pub struct Placing: Copy + GpuData {
    pub to_world: mat4,
    pub to_body: mat4,
    pub eye: vec3,
    pub rigid: f32,
    pub body: u32,
    pub group: u32,
    pub look: u32,
    pub stretch: f32,
}

/// The most copies a lister draws.
pub const COPIES: u32 = 4096

/// A point of the copy's frame in the world.
pub fn world_of(p: Placing, q: vec3) -> vec3 {
    (p.to_world * vec4(q, 1.0)).xyz
}

/// A normal of the copy's frame in the world: carried by the inverse's transpose, unit length.
pub fn world_normal(p: Placing, n: vec3) -> vec3 {
    let m = p.to_body
    normalize(vec3(dot(n, m[0].xyz), dot(n, m[1].xyz), dot(n, m[2].xyz)))
}
