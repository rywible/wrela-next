// A solid cooked when the game is built (`mesh::bake_mesh`) is a file shipped beside the program
// (`std::io::Shipped`). A scene declares it as a constant, one a solid, so a solid whose form (or
// the cook's code) changed is cooked again and one that didn't is read from the build's cache:
//
//     @fuel(2 ** 46)
//     pub const ROCK: Baked = atoms::mesh::bake_mesh("rock", rock(), nearest: 3.0)
//
// and the lister loads it (`solids::Solids::load`), which fetches the file.

/// A solid cooked at build: its file, shipped beside the program (a constant of this type is
/// written as files, and the program keeps only their names and sizes).
pub type Baked = std::io::Shipped

/// A file's bytes as words (little-endian).
pub fn words_of(bytes: [u8]) -> Vec<u32> {
    let n = bytes.len() / 4
    var out: Vec<u32> = Vec::with_capacity(n)
    for i in 0..n {
        let b = 4 * i
        out.push(
            u32(bytes[b]) |
                (u32(bytes[b + 1]) << 8) |
                (u32(bytes[b + 2]) << 16) |
                (u32(bytes[b + 3]) << 24),
        )
    }
    out
}
