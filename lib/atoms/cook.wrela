// What every cook of a solid shares: how it reads the solid (filtered to what a pixel where it
// stands can hold, `KEPT_PIXELS` of them, and its gradient), the cell it starts from (a cube
// round the solid's bound), and how it stops on a value that isn't a number. The cook itself is
// `mesh.wrela`'s.

use form::kinds::Solid
use std::derive::{Box3, gradient, value_and_gradient}

/// How many pixels wide the detail a cook keeps is: finer fades.
pub const KEPT_PIXELS: f32 = 4.0

/// A solid's value at `p` as something `foot` wide sees it, and its gradient. One that isn't a
/// number stops the check, saying where (`not_a_number`).
fn sampled<S: Solid>(s: S, p: vec3, foot: f32) -> (f32, vec3) {
    let (v, g) = seen(s, p, foot)
    if !finite(v) || !finite(g.x) || !finite(g.y) || !finite(g.z) {
        not_a_number(p, foot, v, g)
    }
    (v, g)
}

/// `sampled` unchecked: inside a derivation (the Hessian's rows), which can't say anything.
pub fn seen<S: Solid>(s: S, p: vec3, foot: f32) -> (f32, vec3) {
    value_and_gradient(|q: vec3| s.filtered(q, foot), p)
}

/// `v`'s direction, or nothing where it has none (a slope that vanishes, at a quadric's
/// middle or a solid's crest): `normalize` of a zero vector is 0 / 0.
pub fn unit(v: vec3) -> vec3 {
    if dot(v, v) > 1.0e-30 { normalize(v) } else { vec3(0.0) }
}

/// Whether `x` is a number and not infinite: a slope that is infinite makes a NaN at the next
/// step (`inf * 0`), so it stops a cook as a NaN does.
pub fn finite(x: f32) -> bool {
    abs(x) <= 3.4e38
}

/// Stops the cook: the solid's value `v` or gradient `g` at `p`, seen `foot` m wide, isn't a
/// number. (The build names the solid: the constant it cooks.)
pub fn not_a_number(p: vec3, foot: f32, v: f32, g: vec3) {
    panic(
        f"the solid's value, gradient or curvature at ({p.x}, {p.y}, {p.z}), seen {foot} m wide, isn't a finite number (value {v}, slope ({g.x}, {g.y}, {g.z})): a cook can't place a surface by it. A debug build (`wrela build --debug`; the package's tests build debug) stops at the operation that made it: `pow` of 0 to a power under 1 has an infinite slope there, `sqrt` of 0 too, `normalize` of a zero vector none, `0 / 0` none",
    )
}

/// The cell a cook starts from: a cube that holds `s`'s bound.
pub fn root<S: Solid>(s: S) -> Box3 {
    let b = s.bound()
    assert(b.radius < 1.0e6, "a solid with no bound can't be cooked")
    let r = b.radius * 1.02
    Box3 { lo: b.centre - vec3(r), hi: b.centre + vec3(r) }
}

/// Reads `form`'s value, gradient and curvature as a cook does (unfiltered, and filtered as
/// wide as `foot`) at the corners of a lattice of `cells` a side over its cook's root cube (which
/// are also its cells' middles, a level coarser): where one isn't a number, a debug build (as
/// `wrela test` builds) stops at the operation that made it. A scene's tests run it for each
/// solid it bakes, so a form whose slope isn't a number at a point the cook will read is found
/// by `wrela test`, not by a cook that carries a NaN.
pub fn slopes_checked<S: Solid>(form: S, cells: u32, foot: f32) {
    let r = root(form)
    let side = r.hi.x - r.lo.x
    for f in 0..2 {
        let wide = if f == 0 { 0.0 } else { foot }
        for i in 0..cells + 1 {
            for j in 0..cells + 1 {
                for k in 0..cells + 1 {
                    let p = r.lo + vec3(f32(i), f32(j), f32(k)) * (side / f32(cells))
                    let (v, g) = sampled(form, p, wide)
                    var h = vec3(0.0)
                    for a in 0..3 {
                        let axis = vec3(
                            if a == 0 { 1.0 } else { 0.0 },
                            if a == 1 { 1.0 } else { 0.0 },
                            if a == 2 { 1.0 } else { 0.0 },
                        )
                        h += gradient(|q: vec3| dot(seen(form, q, wide).1, axis), p)
                    }
                    if !finite(h.x) || !finite(h.y) || !finite(h.z) {
                        not_a_number(p, wide, v, h)
                    }
                    let _ = g
                }
            }
        }
    }
}
