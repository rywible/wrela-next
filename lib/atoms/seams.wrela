// A judge of the light a solid is drawn with, in two counts against one look of the reference (the
// solid traced and lit by its own gradient, `reference::trace`), at the pixels' middles:
//
// - **Lit**: how far each pixel's colour is from the reference's where both meet the solid,
//   away from any edge (a pixel whose edge record holds no edge within reach): the share over 4,
//   8 and 16 of 255 and the worst. Linear light, as `frame::judge::compare` counts it.
// - **Seams**: a step of colour from a pixel to the next (across or down) that the reference
//   doesn't take there: the picture's step less the reference's. A light normal that jumps
//   between neighbouring triangles is a seam along their edge, while the light's own change
//   (a band's edge) is in both steps and cancels. Counted in the screen's 8-bit steps (sRGB):
//   what is seen. Pairs where the reference's depth jumps (a crease or an outline) or where the
//   picture holds an edge are left out.
//
// Its numbers are said as `seams:` lines. A frame of the reference's look and the picture's
// targets is all it needs, so any scene with a judge can run it.

use frame::judge::Judge
use frame::last::cover
use frame::picture::{EDGE_REACH, Frame, edge_way}
use std::gpu::{
    Atomics, DepthTexture, FragCoord, GlobalId, GpuBuffer, Rgba16Float, Texture, begin_screen_pass,
    buffer_of, dispatch, draw, label, read,
}
use std::io::{Pending, print}

/// How many numbers `seams` counts.
pub const SEAMED: u32 = 12

/// Whether a pixel is judged: met by both, and the picture holds no edge within reach there.
fn judged_at(
    edge: Texture<Rgba16Float>,
    depth: DepthTexture,
    look_depth: DepthTexture,
    x: u32,
    y: u32,
) -> bool {
    depth.load(x, y) > 0.0 &&
        look_depth.load(x, y) > 0.0 &&
        dot(edge_way(edge.load(x, y)), edge_way(edge.load(x, y))) >= EDGE_REACH * EDGE_REACH
}

/// Linear light as a plain screen shows it (the power 1/2.2), clipped: what the seams are counted
/// in, whatever the frame's own display curve.
fn on_screen(c: vec3) -> vec3 {
    pow(saturate(c), vec3(1.0 / 2.2))
}

/// The greatest of a colour's channels' steps from `a` to `b`, in the screen's 8-bit steps.
fn shown_step(a: vec3, b: vec3) -> vec3 {
    (on_screen(b) - on_screen(a)) * 255.0
}

/// How much the step from pixel (x, y) to the next (by `ox`, `oy`) stands out from the slope
/// round it (a third of the step from the pixel before to the one after the next): nothing for a
/// steady change however steep, the most of a step for a step. In the screen's 8-bit steps.
fn kink(t: Texture<Rgba16Float>, x: u32, y: u32, ox: u32, oy: u32) -> vec3 {
    let a = t.load(x - ox, y - oy).xyz
    let b = t.load(x, y).xyz
    let c = t.load(x + ox, y + oy).xyz
    let d = t.load(x + 2 * ox, y + 2 * oy).xyz
    shown_step(b, c) - shown_step(a, d) / 3.0
}

/// A pixel an invocation, counted into `out`:
///
///   0 pixels judged (met by both, no edge in reach)
///   1 of them more than 4 of 255 off the reference (linear)     2 more than 8     3 more than 16
///   4 the worst, in hundredths of 255
///   5 pairs judged (the pixel and the next across, and down, and one more each side: all
///     judged, the reference's depths within 1% of each other)
///   6 pairs whose step stands out from the slope round it (`kink`) more than the reference's
///     does by more than 2 of 255 (the screen's)
///   7 by more than 4      8 by more than 8
///   9 the worst, in hundredths of 255
///   10 the difference summed over pairs, in hundredths of 255
@compute(8, 8)
pub fn seams(
    colour: Texture<Rgba16Float>,
    edge: Texture<Rgba16Float>,
    depth: DepthTexture,
    look_colour: Texture<Rgba16Float>,
    look_depth: DepthTexture,
    out: mut Atomics<u32>,
    id: GlobalId,
) {
    let w = colour.width()
    let h = colour.height()
    if id.x >= w || id.y >= h {
        return
    }
    if !judged_at(edge, depth, look_depth, id.x, id.y) {
        return
    }
    let c = colour.load(id.x, id.y).xyz
    let r = look_colour.load(id.x, id.y).xyz
    let dc = abs(saturate(c) - saturate(r)) * 255.0
    let most = max(dc.x, max(dc.y, dc.z))
    let _ = out.add(i: 0, value: 1)
    if most > 4.0 {
        let _ = out.add(i: 1, value: 1)
    }
    if most > 8.0 {
        let _ = out.add(i: 2, value: 1)
    }
    if most > 16.0 {
        let _ = out.add(i: 3, value: 1)
    }
    let _ = out.max(i: 4, value: u32(most * 100.0))
    for k in 0..2 {
        let ox = if k == 0 { 1 } else { 0 }
        let oy = 1 - ox
        // The pair (this pixel, the next) and one more pixel each side: all judged, the
        // reference's depths within 1% along them.
        var ok = id.x >= ox && id.y >= oy && id.x + 2 * ox < w && id.y + 2 * oy < h
        if ok {
            for t in 0..4 {
                let px = id.x + t * ox - ox
                let py = id.y + t * oy - oy
                ok = ok && judged_at(edge, depth, look_depth, px, py)
                ok = ok &&
                    abs(look_depth.load(px, py) - look_depth.load(id.x, id.y)) <
                        0.01 * look_depth.load(id.x, id.y)
            }
        }
        if ok {
            {
                let mine = kink(colour, id.x, id.y, ox, oy)
                let theirs = kink(look_colour, id.x, id.y, ox, oy)
                let d = abs(mine - theirs)
                let off = max(d.x, max(d.y, d.z))
                let _ = out.add(i: 5, value: 1)
                if off > 2.0 {
                    let _ = out.add(i: 6, value: 1)
                }
                if off > 4.0 {
                    let _ = out.add(i: 7, value: 1)
                }
                if off > 8.0 {
                    let _ = out.add(i: 8, value: 1)
                }
                let _ = out.max(i: 9, value: u32(off * 100.0))
                let _ = out.add(i: 10, value: u32(off * 100.0))
            }
        }
    }
}

/// The seams judge: its counts, asked for once, and said when read back.
pub struct Seams {
    asked: Option<Pending<u32>>,
}

pub fn seams_judge() -> Seams {
    Seams { asked: None }
}

/// What `n` is of `of`, in parts of a hundred.
fn share(n: u32, of: u32) -> f32 {
    100.0 * f32(n) / max(f32(of), 1.0)
}

impl Seams {
    /// `frame`'s picture (before its last pass) against `judge`'s look of the reference, counted
    /// when the judge compares (its settled moment's first look); said once read back.
    pub fn after_trace(mut self, frame: Frame, judge: Judge) {
        if judge.look() != 0 || judge.moment() != judge.settled {
            return
        }
        let w = u32(frame.eye.size.x)
        let h = u32(frame.eye.size.y)
        label("judge")
        var out: GpuBuffer<u32> = buffer_of(Vec::filled(SEAMED, 0))
        dispatch(
            seams.bind(
                colour: frame.colour,
                edge: frame.edge,
                depth: frame.depth,
                look_colour: judge.look_colour,
                look_depth: judge.look_depth,
                out: mut out,
            ),
            groups: ((w + 7) / 8, (h + 7) / 8, 1),
        )
        self.asked = Some(read(out.items()))
    }

    /// The counts said, once read back.
    pub fn heard(mut self) {
        match mut self.asked {
            Some(p) => match p.poll() {
                Some(Ok(v)) => {
                    print(
                        f"seams: lit, of {v[0]} px away from edges: over 4 of 255 {share(v[1], v[0])}%, over 8 {share(v[2], v[0])}%, over 16 {share(v[3], v[0])}%, the worst {f32(v[4]) / 100.0}",
                    )
                    print(
                        f"seams: steps the reference doesn't take, of {v[5]} pairs: over 2 of 255 {v[6]}, over 4 {v[7]}, over 8 {v[8]}; the worst {f32(v[9]) / 100.0}, the mean {f32(v[10]) / 100.0 / max(f32(v[5]), 1.0)}",
                    )
                    self.asked = None
                },
                _ => {},
            },
            None => {},
        }
    }
}

/// A pixel of the picture's difference from the reference's look, `gain` times as large, on the
/// screen: red where the picture is brighter, blue where it's darker, grey where only one of
/// them meets the solid.
@fragment
pub fn apart(
    pixel: FragCoord,
    colour: Texture<Rgba16Float>,
    depth: DepthTexture,
    look_colour: Texture<Rgba16Float>,
    look_depth: DepthTexture,
    gain: f32,
) -> vec4 {
    let x = u32(pixel.position.x)
    let y = u32(pixel.position.y)
    let a = depth.load(x, y) > 0.0
    let b = look_depth.load(x, y) > 0.0
    if a != b {
        return vec4(0.5, 0.5, 0.5, 1.0)
    }
    if !a {
        return vec4(0.0, 0.0, 0.0, 1.0)
    }
    if gain >= 1000.0 {
        // The reference's look itself.
        return vec4(on_screen(look_colour.load(x, y).xyz), 1.0)
    }
    if gain < 0.0 {
        // The seams: the step to the next pixel across and down less the reference's, the
        // larger, in white.
        var most = 0.0
        for k in 0..2 {
            let ox: u32 = if k == 0 { 1 } else { 0 }
            let oy: u32 = 1 - ox
            if x >= ox && y >= oy && x + 2 * ox < colour.width() && y + 2 * oy < colour.height() {
                var met = true
                for t in 0..4 {
                    met = met && depth.load(x + t * ox - ox, y + t * oy - oy) > 0.0
                    met = met && look_depth.load(x + t * ox - ox, y + t * oy - oy) > 0.0
                }
                if met {
                    let dd = abs(kink(colour, x, y, ox, oy) - kink(look_colour, x, y, ox, oy))
                    most = max(most, max(dd.x, max(dd.y, dd.z)))
                }
            }
        }
        return vec4(vec3(most * -gain / 255.0), 1.0)
    }
    let d = dot(
        on_screen(colour.load(x, y).xyz) - on_screen(look_colour.load(x, y).xyz),
        vec3(1.0 / 3.0),
    )
    vec4(max(d, 0.0) * gain, 0.0, max(-d, 0.0) * gain, 1.0)
}

/// The picture's difference from `judge`'s look of the reference, `gain` times as large, shown
/// on the screen in place of the picture.
pub fn show_apart(frame: Frame, judge: Judge, gain: f32) {
    label("shown")
    let screen = begin_screen_pass(clear: vec4(0.0, 0.0, 0.0, 1.0))
    draw(
        screen,
        cover,
        apart.bind(
            colour: frame.colour,
            depth: frame.depth,
            look_colour: judge.look_colour,
            look_depth: judge.look_depth,
            gain: gain,
        ),
        vertices: 3,
    )
    screen.present()
}
