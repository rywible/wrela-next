// A height chart given by its function (the land): its vertex and pixel programs.
//
// At a vertex: where it stands on the chart (`rings::placed`), the chart's point there, the
// normal the light reads, and what the look wears there. Each is the mean over the vertex's own
// cell (its spacing across): the point the mean of four, the slopes the chart's own differences
// across the cell (the mean slope over it, exactly, for a height), the look the mean of four
// looks within it. So what is finer than the vertices fades into its mean as the rings coarsen
// with distance, instead of being sampled and shimmering as the eye moves. Near, where the
// cells are a few centimetres, the mean is the point's own.
//
// At a pixel, between the vertices: the light (`frame::light::shaded`, the one shading
// function), the look's line field, the identity, the depth, which is the triangles' own, and
// the way to its outline at strength 0: smoothed, no line (see `shade`).

use form::kinds::Chart
use form::look::{Look, Place, Skin}
use form::shade::{MOST_LIGHTS, Steps}
use frame::eye::Eye
use frame::light::{Lighting, worn}
use frame::outline::{fold_field, way_to_outline}
use frame::picture::{CHART, edge_record, identity}
use rings::{Layout, placed}
use std::derive::gradient
use std::gpu::{Atomics, ClipPosition, InstanceIndex, Targets3, VertexIndex}

/// What a vertex passes to its pixels: where its point is (the world's), the normal the light
/// reads there, the chart's place, and what the look wears there.
pub struct Ground: Copy {
    pub clip: ClipPosition,
    pub world: vec3,
    pub normal: vec3,
    pub albedo: vec3,
    pub line: f32,
    /// How metal, whether the rim falls on it (1 or 0), its relief (m).
    pub worn: vec3,
    pub emits: vec3,
    pub rest: vec2,
    /// The outline's field there (`frame::outline::fold_field`): 0 where it turns from the eye.
    pub field: f32,
}

/// The chart over a cell `w` m across round `uv`: its point, as the mean of the four at half
/// the cell either way along each number, and its tangents, its point's change along each
/// number from its own differences across the cell (the mean of the slope over the cell along
/// that number). So far off, where the cells are metres across, what is finer than a cell (a
/// dune's ripples) is in neither the outline nor the light.
fn cell<C: Chart>(chart: C, uv: vec2, w: f32) -> (vec3, vec3, vec3) {
    let h = 0.5 * w
    let a = chart.at(uv + vec2(h, 0.0))
    let b = chart.at(uv - vec2(h, 0.0))
    let c = chart.at(uv + vec2(0.0, h))
    let d = chart.at(uv - vec2(0.0, h))
    ((a + b + c + d) * 0.25, (a - b) / w, (c - d) / w)
}

/// The skin `look` wears over a cell `w` m across round `p` (the chart's point at `uv`, facing
/// `n`): the mean of four looks at a quarter of the cell either way along each number.
fn skin_over<C: Chart, L: Look>(chart: C, look: L, uv: vec2, n: vec3, w: f32) -> Skin {
    var albedo = vec3(0.0)
    var line = 0.0
    var metal = 0.0
    var rim = 0.0
    var relief = 0.0
    var emits = vec3(0.0)
    for k in 0..4 {
        let q = uv + vec2(if (k & 1) == 0 { -0.25 } else { 0.25 }, if (k & 2) == 0 {
            -0.25
        } else { 0.25 }) * w
        let p = chart.at(q)
        let s = look.skin(Place { world: p, rest: p, chart: Some(q), normal: n })
        albedo += s.albedo
        line += s.line
        metal += s.metal
        rim += if s.rim { 1.0 } else { 0.0 }
        relief += s.relief
        emits += s.emits
    }
    Skin {
        albedo: albedo * 0.25,
        line: line * 0.25,
        metal: metal * 0.25,
        rim: rim >= 2.0,
        relief: relief * 0.25,
        emits: emits * 0.25,
    }
}

/// A vertex of a height chart's rings.
@vertex
pub fn ground_vertex<C: Chart, L: Look>(
    v: VertexIndex,
    i: InstanceIndex,
    eye: Eye,
    layout: Layout,
    chart: C,
    look: L,
) -> Ground {
    let at = placed(layout, v.index, i.index)
    let (p, du, dv) = cell(chart, at.rest, at.spacing)
    var n = normalize(cross(dv, du))
    if n.y < 0.0 {
        n = -n
    }
    let s = skin_over(chart, look, at.rest, n, at.spacing)
    Ground {
        clip: ClipPosition { position: eye.clip(p) },
        world: p,
        normal: n,
        albedo: s.albedo,
        line: s.line,
        worn: vec3(s.metal, if s.rim { 1.0 } else { 0.0 }, s.relief),
        emits: s.emits,
        rest: at.rest,
        field: fold_field(n, normalize(eye.at - p)),
    }
}

/// A pixel of a height chart: lit, its edge, which body it is, at its triangle's depth.
@fragment
pub fn ground_pixel(
    f: Ground,
    eye: Eye,
    light: Lighting,
    body: u32,
    lights: const u32,
) -> Targets3<vec4, vec4, u32> {
    shade(f, eye, light, body, lights)
}

/// What `ground_pixel` writes, lit by at most `lights` live lights (`form::shade::lit`'s `live`).
fn shade(
    f: Ground,
    eye: Eye,
    light: Lighting,
    body: u32,
    lights: u32,
) -> Targets3<vec4, vec4, u32> {
    let n = normalize(f.normal)
    let toward = normalize(eye.at - f.world)
    let steps = Steps {
        across: dpdx(f.world),
        down: dpdy(f.world),
        normal_across: dpdx(n),
        normal_down: dpdy(n),
        relief: vec2(0.0),
    }
    let skin = Skin {
        albedo: f.albedo,
        line: f.line,
        metal: f.worn.x,
        rim: f.worn.y > 0.5,
        relief: f.worn.z,
        emits: f.emits,
    }
    let s = worn(light, skin, f.world, n, toward, steps, live: lights)
    // Its outline (`frame::outline`) at strength 0: smoothed, with no line. The ground draws no
    // fold (the old ink drew none on the ground: "toward the horizon it folds away at every
    // pixel, a line of static") and no crease: every brow is a fold of the field, and drawn they
    // were fragments of faint lines over the far dunes (docs/heights.md). Where it meets the sky
    // or the sea the frame's change of identity draws the line; its line field draws its seams.
    let way = way_to_outline(f.field, vec2(dpdx(f.field), dpdy(f.field)))
    Targets3 {
        first: vec4(s.colour, 0.0),
        second: edge_record(way, 0.0, s.line),
        third: identity(CHART, body, 0),
    }
}

/// The chart's exact normal at `uv`: its two tangents from the derived gradients of its point,
/// crossed, facing up.
fn exact_normal<C: Chart>(chart: C, uv: vec2) -> vec3 {
    let gx = gradient(|q: vec2| chart.at(q).x, uv)
    let gy = gradient(|q: vec2| chart.at(q).y, uv)
    let gz = gradient(|q: vec2| chart.at(q).z, uv)
    let n = normalize(cross(vec3(gx.y, gy.y, gz.y), vec3(gx.x, gy.x, gz.x)))
    if n.y < 0.0 { -n } else { n }
}

/// A pixel of a height chart with the normal worked out at the pixel, exactly, in place of the
/// one laid between the vertices: the other way to draw it, to time against `ground_pixel`.
@fragment
pub fn ground_exact<C: Chart>(
    f: Ground,
    eye: Eye,
    light: Lighting,
    body: u32,
    chart: C,
) -> Targets3<vec4, vec4, u32> {
    var g = f
    g.normal = exact_normal(chart, f.rest)
    shade(g, eye, light, body, MOST_LIGHTS)
}

/// How many counts `ground_measured` keeps: four for each of the two band edges (n·l crossing
/// the light's `lit_edge`, then its `full_edge`).
pub const EDGE_COUNTS: u32 = 8

/// A pixel of a height chart as `ground_pixel` draws it, and how far its normal laid between the
/// vertices moves each band's edge from where the exact normal (`exact_normal`) puts it, into
/// `out`: for each edge, at 4k: the pixels within 2 px of where the exact normal puts it, the
/// distance the laid normal moves it (px / 1000) summed, and at most, and the pixels it moves
/// more than a pixel. The distance is the two n·l's difference over how fast the exact one
/// changes a pixel.
@fragment
pub fn ground_measured<C: Chart>(
    f: Ground,
    eye: Eye,
    light: Lighting,
    body: u32,
    chart: C,
    out: mut Atomics<u32>,
) -> Targets3<vec4, vec4, u32> {
    let laid = dot(normalize(f.normal), light.sun)
    let exact = dot(exact_normal(chart, f.rest), light.sun)
    let rate = length(vec2(dpdx(exact), dpdy(exact)))
    for k in 0..2 {
        let e = if k == 0 { light.style.lit_edge } else { light.style.full_edge }
        if rate > 1.0e-7 && abs(exact - e) <= 2.0 * rate {
            let moved = abs(laid - exact) / rate
            let at = k * 4
            let _ = out.add(i: at, value: 1)
            let _ = out.add(i: at + 1, value: u32(min(moved, 1000.0) * 1000.0))
            let _ = out.max(i: at + 2, value: u32(min(moved, 1000.0) * 1000.0))
            if moved > 1.0 {
                let _ = out.add(i: at + 3, value: 1)
            }
        }
    }
    shade(f, eye, light, body, MOST_LIGHTS)
}
