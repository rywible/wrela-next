// The lister of height charts, as a scene uses it: a chart over the ground's places and its
// look, handed over once; each frame, its rings round the frame's eye drawn into the frame's
// picture (docs/frame.md: opaque triangles shaded forward, meeting other listers by depth).
//
//     var land = heights::lister::ground(land(), SandLook { t: 0.0 }, body: 0)   // once
//     land.look = SandLook { t }                                                 // each frame
//     frame.draw(|d| { land.draw_into(d) })                                     // each frame
//
// (The sea, read from lib/sea's tiles, is `tiled::Seas`.)

use form::kinds::Chart
use form::look::Look
use frame::eye::NEARER
use frame::light::{AllLit, Lit, OneLit, Unlit, lit_by}
use frame::picture::Drawing
use ground::{EDGE_COUNTS, ground_exact, ground_measured, ground_pixel, ground_vertex}
use rings::{Layout, Rings, Run, rings}
use std::derive::Box2
use std::gpu::{GpuBuffer, buffer_of, draw, read}
use std::io::{Pending, print}

/// How far apart the finest ring's vertices are (m): an eight of a metre.
pub const FINEST: f32 = 0.125

/// A height chart drawn by its function: the chart, its look, which body it is among the
/// charts (its identity's), its rings, and how low and high it lies (m: its bound's, for
/// leaving off what is off the screen).
pub struct Grounds<C, L> {
    pub chart: C,
    pub look: L,
    pub body: u32,
    /// How far from the eye the rings are laid round (m): none but for the steadiness judge,
    /// which lays them either side of a level's snap from one eye to see what the snap changes.
    pub nudge: vec3,
    /// How its pixels find their normal: 0 laid between the vertices (as drawn), 1 worked out
    /// at each pixel (to time against it), 2 laid and counted against the exact one where a
    /// band's edge falls (`ground::ground_measured`, said by `edges`).
    pub normals: u32,
    counts: GpuBuffer<u32>,
    heard: Option<Pending<u32>>,
    rings: Rings,
    low: f32,
    high: f32,
}

/// `chart` wearing `look`, body `body` of the charts.
pub fn ground<C: Chart, L: Look>(chart: C, look: L, body: u32) -> Grounds<C, L> {
    let b = chart.bound()
    Grounds {
        chart,
        look,
        body,
        nudge: vec3(0.0),
        normals: 0,
        counts: buffer_of(Vec::filled(EDGE_COUNTS, value: 0)),
        heard: None,
        rings: rings(FINEST),
        low: b.lo.y,
        high: b.hi.y,
    }
}

impl<C: Chart, L: Look> Grounds<C, L> {
    /// Drawn into the picture's one pass (`frame::picture::Frame::draw`), round its eye.
    pub fn draw_into(mut self, d: Drawing) {
        let eye = d.eye
        var round = eye
        round.at += self.nudge
        let (layout, runs) = self.rings.frame(round, self.chart.domain(), self.low, self.high)
        let q = d.pass
        if self.normals == 0 {
            // Each part by its pixels' pipeline for as many live lights as reach it: for none
            // where none does, which has no loop over them (`form::shade::lit`); for exactly the
            // one lit where one is (a loop for four costs a pixel more even when it lights one).
            for r in runs {
                let lo = vec3(r.lo.x, self.low, r.lo.y)
                let hi = vec3(r.hi.x, self.high, r.hi.y)
                let k = lit_by(d.light.lights, lo, hi)
                if k == 0 {
                    self.drawn_run(d, layout, r, Unlit {})
                } else if k == 1 {
                    self.drawn_run(d, layout, r, OneLit {})
                } else {
                    self.drawn_run(d, layout, r, AllLit {})
                }
            }
            return
        }
        for r in runs {
            if self.normals == 1 {
                draw(
                    q,
                    ground_vertex.bind(eye, layout: layout, chart: self.chart, look: self.look),
                    ground_exact.bind(eye, light: d.light, body: self.body, chart: self.chart),
                    indices: self.rings.indices,
                    index_count: r.count,
                    first_index: r.first,
                    first_instance: r.level,
                    depth: NEARER,
                )
            } else {
                draw(
                    q,
                    ground_vertex.bind(eye, layout: layout, chart: self.chart, look: self.look),
                    ground_measured.bind(
                        eye,
                        light: d.light,
                        body: self.body,
                        chart: self.chart,
                        out: mut self.counts,
                    ),
                    indices: self.rings.indices,
                    index_count: r.count,
                    first_index: r.first,
                    first_instance: r.level,
                    depth: NEARER,
                )
            }
        }
    }
}

impl<C: Chart, L: Look> Grounds<C, L> {
    /// Run `r` of the rings drawn into the picture's pass by the pixels' pipeline for `K`'s live
    /// lights.
    fn drawn_run<K: Lit>(self, d: Drawing, layout: Layout, r: Run, _lit: K) {
        draw(
            d.pass,
            ground_vertex.bind(d.eye, layout: layout, chart: self.chart, look: self.look),
            ground_pixel.bind(d.eye, light: d.light, body: self.body, lights: K::LIVE),
            indices: self.rings.indices,
            index_count: r.count,
            first_index: r.first,
            first_instance: r.level,
            depth: NEARER,
        )
    }
}

impl<C: Chart, L: Look> Grounds<C, L> {
    /// The band edges' counts (`normals` 2) asked for, after the frames counted.
    pub fn edges(mut self) {
        self.heard = Some(read(self.counts.items()))
    }

    /// The band edges' counts said, once read back.
    pub fn edges_said(mut self) {
        match mut self.heard {
            Some(p) => match p.poll() {
                Some(Ok(v)) => {
                    for k in 0..2 {
                        let at = k * 4
                        let name = if k == 0 { "the first band's edge" } else {
                            "the full light's edge"
                        }
                        print(
                            f"edges: {name}: {v[at]} pixels within 2 px of it, the normal laid between vertices moves it {f32(v[at + 1]) / 1000.0 / max(f32(v[at]), 1.0)} px on average, {f32(v[at + 2]) / 1000.0} px at most; over a pixel at {v[at + 3]} of them",
                        )
                    }
                },
                _ => {},
            },
            None => {},
        }
    }
}
