// What the picture holds at chosen pixels, read back for checks: each pixel's depth, and the
// kind and body its identity names. A scene holds what was drawn to its forms by these (game
// code reads no GPU memory of its own).

use frame::picture::{Frame, body_of, kind_of}
use std::gpu::{
    DepthTexture, GlobalId, GpuBuffer, R32Uint, Slots, Texture, buffer, buffer_of, dispatch, read,
}
use std::io::Pending

/// Pixel `at[i]`'s depth, and its identity's kind and body, into `out[i]`.
@compute(64)
fn probed(
    depth: DepthTexture,
    ids: Texture<R32Uint>,
    at: [vec2u],
    out: mut Slots<vec4>,
    id: GlobalId,
) {
    if id.x >= at.len() {
        return
    }
    let p = at[id.x]
    let k = ids.load(p.x, p.y)
    out[id] = vec4(depth.load(p.x, p.y), f32(kind_of(k)), f32(body_of(k)), 0.0)
}

/// What `frame`'s picture holds at `pixels` (each its column and row), asked for now, after
/// what has been drawn into it: each pixel's depth, and its identity's kind and body.
pub fn probe(frame: Frame, pixels: [vec2u]) -> Pending<vec4> {
    let at = buffer_of(pixels)
    var out: GpuBuffer<vec4> = buffer(pixels.len())
    dispatch(
        probed.bind(depth: frame.depth, ids: frame.identity, at: at, out: mut out),
        over: pixels.len(),
    )
    read(out.items())
}
