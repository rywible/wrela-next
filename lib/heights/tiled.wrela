// A height chart read from lib/sea's tiles (the sea): a chart from the place where the water
// rests to where that water is now, so a posed grid needs no search for which water is where.
//
// At a vertex: where it stands on the chart (`rings::placed`, a rest place), the two long bands'
// water there read from their tiles a mip level as coarse as the vertices are apart (so the
// vertices never sample waves shorter than they can hold, and far waves settle into their mean
// as the rings coarsen), and the scene's water made of them (`Waters::wet`: its damping as the
// water shallows, its swash). The point drawn is where that water is now.
//
// At a pixel: the short bands' slopes read at the pixel's own rest place through its footprint
// (`STEADY` times it: the shortest waves alias a bare footprint), added to the long bands'
// slopes the vertices carried, as much as the scene says they are felt there (`Waters::short`);
// the normal from them all, exactly (the chart's own two tangents, crossed); the slopes the
// footprint loses as the surface's roughness, which the mirror reads the sky through (`sky`'s
// table, a level for each doubling); and the look the scene's sea wears there, from the water
// its vertices carried (`Waters::skin`), through the one shading function.

use edge::HORIZON
use frame::outline::way_to_outline
use form::shade::Steps
use frame::eye::{Eye, NEARER}
use frame::held::{Held, sky_seen}
use frame::sun::{SunShade, through_clouds}
use frame::light::{AllLit, Lighting, Lit, OneLit, Unlit, lit_by, sun_glint, worn}
use frame::picture::{CHART, Drawing, NO_EDGE, edge_record, identity}
use ocean::spectrum::{SIDES, SeaState, leaning}
use ocean::swell::Shape
use marks::{Marks, MarksSeen, held_down, marked, no_marks}
use ocean::tiles::{Ocean, Sea, band_at, level_for, lost, on_tile, slopes_at}
use ocean::waters::{PATTERN_SIDE, PATTERN_TEXELS, TRAIL, Waters, Wet}
use rings::{Layout, Rings, Run, placed, rings}
use frame::sky::{mirror, mirrored}
use form::kinds::{Chart, Paint}
use std::gpu::{
    ClipPosition, GlobalId, GpuBuffer, InstanceIndex, One, Slots, Rgba16Float, Sampler, Targets3,
    Texels, Texture, Texture3d, VertexIndex, buffer, copy_texture, dispatch, draw, generate_mips,
    label, mip_levels, writable_texture,
}

/// How much wider than a pixel's footprint the short bands are read: through the footprint
/// alone the shortest waves alias it and crawl as the eye moves; the old shading found 3 times
/// it held still (rywible/wrela engine/ocean.wrela:808-818, `STEADY`), the slopes the coarser
/// read loses going to the roughness.
pub const STEADY: f32 = 3.0

/// The long bands' tiles, as a vertex reads them.
pub borrow struct Long {
    pub big_was: borrow Texture<Rgba16Float>,
    pub big_tilt_was: borrow Texture<Rgba16Float>,
    pub big_shape: borrow Texture<Rgba16Float>,
    pub big_tilt: borrow Texture<Rgba16Float>,
    pub mid_was: borrow Texture<Rgba16Float>,
    pub mid_tilt_was: borrow Texture<Rgba16Float>,
    pub mid_shape: borrow Texture<Rgba16Float>,
    pub mid_tilt: borrow Texture<Rgba16Float>,
    pub s: borrow Sampler,
    pub lean: vec2,
    /// How far this frame is between each tile's two last steps (`Ocean::between`).
    pub between: vec2,
}

/// The short bands' tilts and the sky's table, as a pixel reads them (the tilts through their
/// mips, with no anisotropy: on a slant they're read as coarse across as along, and the slopes
/// lost to that are roughness. With eightfold anisotropy the reads were 0.56 ms more of the
/// sea's pass at 3840x2160.)
pub borrow struct Short {
    pub big_froth: borrow Texture<Rgba16Float>,
    pub mid_froth: borrow Texture<Rgba16Float>,
    pub marks_now: borrow Texture<Rgba16Float>,
    pub marks_s: borrow Sampler,
    pub marks_window: vec4,
    pub fine_tilt: borrow Texture<Rgba16Float>,
    pub ripple_tilt: borrow Texture<Rgba16Float>,
    pub s: borrow Sampler,
    pub view: Sea,
    pub sky: borrow Texture3d<Rgba16Float>,
    pub sky_s: borrow Sampler,
    pub sky_map: borrow Texture<Rgba16Float>,
    /// The way the wind blows (x, z: a unit vector).
    pub wind: vec2,
    /// The sea's patterns (`Waters::pattern`), made once.
    pub pattern: borrow Texture<Rgba16Float>,
}

/// What a vertex of the sea passes to its pixels: where its water is (the world's), how that
/// changes along x and z, what the scene's look reads (`Wet`'s), its rest place, and how much
/// of the sky reaches it (`frame::held`: it changes over metres, so its vertices ask it, not
/// its pixels).
pub struct Afloat: Copy {
    pub clip: ClipPosition,
    pub world: vec3,
    pub du: vec3,
    pub dv: vec3,
    pub kept: vec4,
    pub more: vec4,
    pub rest: vec2,
    pub sky: f32,
    /// How much of the sun's beam the clouds let through to it (`frame::sun`), asked here.
    pub reach: f32,
    /// The sky just over the horizon along the eye's way to it (what a thin crest lets through:
    /// `Waters::seen`), asked here: it changes only with the way round.
    pub behind: vec3,
}

/// A vertex of the sea's rings.
@vertex
pub fn sea_vertex<W: Waters>(
    v: VertexIndex,
    i: InstanceIndex,
    eye: Eye,
    layout: Layout,
    sea: W,
    long: Long,
    marks: MarksSeen,
    held: Held,
    shade: SunShade,
    sky_map: Texture<Rgba16Float>,
    sky_s: Sampler,
) -> Afloat {
    let at = placed(layout, v.index, i.index)
    let big = band_at(
        long.big_was,
        long.big_tilt_was,
        long.big_shape,
        long.big_tilt,
        long.between.x,
        long.s,
        SIDES.x,
        long.lean,
        at.rest,
        level_for(SIDES.x, at.spacing),
    )
    let mid = band_at(
        long.mid_was,
        long.mid_tilt_was,
        long.mid_shape,
        long.mid_tilt,
        long.between.y,
        long.s,
        SIDES.y,
        long.lean,
        at.rest,
        level_for(SIDES.y, at.spacing),
    )
    var w = sea.wet(at.rest, big, mid)
    // (Held down where a body afloat presses it: `marks::held`.)
    w.shape.at.y = held_down(marks, at.rest, w.shape.at.y)
    Afloat {
        clip: ClipPosition { position: eye.clip(w.shape.at) },
        world: w.shape.at,
        du: w.shape.du,
        dv: w.shape.dv,
        kept: w.kept,
        more: w.more,
        rest: at.rest,
        sky: sky_seen(held, w.shape.at, normalize(cross(w.shape.dv, w.shape.du))),
        reach: through_clouds(shade, w.shape.at),
        behind: mirrored(sky_map, sky_s, normalize(vec3(w.shape.at.x - eye.at.x, 0.0, w.shape.at.z - eye.at.z) + vec3(1.0e-6, 0.0, 0.0)) + vec3(0.0, 0.006, 0.0), 1.0, 0.0, 0.0).xyz,
    }
}

/// The least spread of the water's facets' slopes the sun's glitter is drawn with (their
/// variance): the capillary ripples no band holds.
const GLINT_SPREAD: f32 = 0.004

/// A pixel of the sea: its normal from all four bands, lit, the sky mirrored, its edge, which
/// body it is, at its triangle's depth.
@fragment
pub fn sea_pixel<W: Waters>(
    f: Afloat,
    eye: Eye,
    light: Lighting,
    sea: W,
    short: Short,
    body: u32,
    lights: const u32,
) -> Targets3<vec4, vec4, u32> {
    let fu = dpdx(f.rest) * STEADY
    let fv = dpdy(f.rest) * STEADY
    let (fine_u, fine_v) = slopes_at(short.fine_tilt, short.s, SIDES.z, f.rest, fu, fv)
    let (rip_u, rip_v) = slopes_at(short.ripple_tilt, short.s, SIDES.w, f.rest, fu, fv)
    // The long tiles' own foam where the water rests, through the pixel's footprint (stepped
    // state: carried down the wind and fading), and what the scene has marked there.
    let fb = short.big_froth.sample_grad(short.s, on_tile(f.rest, SIDES.x), fu / SIDES.x, fv / SIDES.x)
    let fm = short.mid_froth.sample_grad(short.s, on_tile(f.rest, SIDES.y), fu / SIDES.y, fv / SIDES.y)
    let seen_marks = MarksSeen { now: short.marks_now, s: short.marks_s, window: short.marks_window }
    // (The foam upwind, blurred: `Wet::trail`. Its footprint long along the wind, as the wind
    // draws it out.)
    let far = f.rest - short.wind * TRAIL
    let near = f.rest - short.wind * (TRAIL * 0.25)
    let gu = fu * 12.0 + short.wind * 3.0
    let gv = fv * 12.0
    let tb = short.big_froth.sample_grad(short.s, on_tile(far, SIDES.x), gu / SIDES.x, gv / SIDES.x)
    let tm = short.mid_froth.sample_grad(short.s, on_tile(far, SIDES.y), gu / SIDES.y, gv / SIDES.y)
    let nb = short.big_froth.sample_grad(short.s, on_tile(near, SIDES.x), (fu * 6.0 + short.wind * 0.5) / SIDES.x, fv * 6.0 / SIDES.x)
    let nm = short.mid_froth.sample_grad(short.s, on_tile(near, SIDES.y), (fu * 6.0 + short.wind * 0.5) / SIDES.y, fv * 6.0 / SIDES.y)
    let w = Wet {
        shape: Shape { at: f.world, du: f.du, dv: f.dv },
        kept: f.kept,
        more: f.more,
        foam: vec4(fb.x, fb.y, fm.x, fm.y),
        marks: marked(seen_marks, f.rest, fu, fv),
        trail: vec4(tb.x, tm.x, nb.x, nm.x),
        pattern: patterned(short, f.rest),
    }
    let k = sea.short(w)
    let du = f.du + (fine_u + rip_u) * k
    let dv = f.dv + (fine_v + rip_v) * k
    let n = normalize(cross(dv, du))
    let toward = normalize(eye.at - f.world)
    let steps = Steps {
        across: dpdx(f.world),
        down: dpdy(f.world),
        normal_across: dpdx(n),
        normal_down: dpdy(n),
        relief: vec2(0.0),
    }
    // Its edges, each a line of ink (docs/frame.md, "Ink"): where its water goes under what bounds
    // it (a shore's sand: what the pixel shows stops being the sea there, a line at full
    // strength, as every change of what was met was in the old ink); and its silhouette against
    // the sky, which for a level sea is the horizon: where the level's own n·v falls to nothing,
    // at `HORIZON` strength. Nothing inside it: a wave's crest in front of the water behind it is
    // no line in this look (the old ink drew no fold on the sea: "toward the horizon each pixel
    // reaches much further than the last"), and recorded, every far crest was a stroke.
    let over = sea.over(w)
    // (Only where the water is within half a metre of the sand: far off, where a pixel spans
    // kilometres, the 20 m of water changes so much from pixel to pixel that its zero, taken
    // straight on, falls within reach of a few, a stray stroke each.)
    let over_x = dpdx(over)
    let over_y = dpdy(over)
    let shore = if abs(over) < 0.5 { way_to_outline(over, vec2(over_x, over_y)) } else { NO_EDGE }
    let level = toward.y
    let horizon_way = way_to_outline(level, vec2(dpdx(level), dpdy(level)))
    // (Within a pixel: the sea runs on until it is, so only its top row holds the horizon; a row
    // below, with sea across, drew a faint fold.)
    let horizon = if dot(horizon_way, horizon_way) <= 1.0 { horizon_way } else { NO_EDGE }
    let at_shore = dot(shore, shore) <= dot(horizon, horizon)
    let way = if at_shore { shore } else { horizon }
    let strength = if at_shore { 1.0 } else { HORIZON }
    // The roughness: the slopes the footprint lost, as a spread of the normal (rad).
    // (The short bands are read through the footprint's longer side both ways: what they lose
    // is lost along both.)
    let foot = max(length(fu), length(fv))
    let gone = lost(short.view, vec2(foot, 0.0), vec2(0.0, foot)) * k +
        vec2(short.view.unseen) * (1.0 - k)
    let r = n * (2.0 * dot(n, toward)) - toward
    let foot_r = max(length(dpdx(r)), length(dpdy(r)))
    let sky = mirrored(short.sky_map, short.sky_s, r, dot(n, toward), sqrt(gone.y), foot_r)
    let skin = sea.skin(w, n)
    let s = worn(light, skin, f.world, n, toward, steps, live: lights, sky: f.sky, reach: f.reach)
    Targets3 {
        first: vec4(sea.seen(w, n, toward, s.colour, sky, f.behind) + sun_glint(light, f.reach, n, toward, gone.y + GLINT_SPREAD), 0.0),
        second: edge_record(way, strength, s.line),
        third: identity(CHART, body, 0),
    }
}

/// The sea drawn from lib/sea's tiles: the scene's waters (`W`, which is a chart too: its
/// places), which body it is among the charts, the ocean whose tiles it reads, the sky's table
/// it mirrors, its rings, and how far its water stands off the level at most (m).
pub struct Seas<W> {
    pub waters: W,
    pub body: u32,
    /// How far from the eye the rings are laid round (m): as `Grounds::nudge`.
    pub nudge: vec3,
    pub ocean: Ocean,
    rings: Rings,
    reach: f32,
    /// Its water's level at `CRESTED` places over the frames before (`crests`), the GPU's.
    kept: GpuBuffer<Crested>,
    now: GpuBuffer<f32>,
    /// What the scene writes onto the sea's places as it plays (`marks::Marks`; none unless it
    /// sets them): read by its look in `Wet::marks`.
    pub marks: Marks,
    /// Its patterns (`Waters::pattern`), made at its first step.
    pattern: Texture<Rgba16Float>,
    patterned: bool,
}

/// The sea `waters` of lib/sea's waves for `state`, body `body` of the charts, its water never
/// more than `reach` m off the level.
pub fn sea<W: Waters + Chart>(waters: W, state: SeaState, body: u32, reach: f32) -> Seas<W> {
    Seas {
        waters,
        body,
        nudge: vec3(0.0),
        ocean: Ocean::new(state),
        rings: rings(0.125),
        reach,
        kept: buffer(1),
        now: buffer(CRESTED),
        marks: no_marks(),
        pattern: writable_texture::<Rgba16Float>(width: PATTERN_TEXELS, height: PATTERN_TEXELS, levels: mip_levels(PATTERN_TEXELS, PATTERN_TEXELS)),
        patterned: false,
    }
}

/// How many rows of the patterns' tile a dispatch makes.
const PATTERN_ROWS: u32 = 256

/// Texel `id` of the sea's patterns' tile, rows from `from`: `sea.pattern` at its middle.
@compute(8, 8)
fn pattern_texel<W: Waters>(sea: W, from: u32, out: mut Texels<Rgba16Float>, id: GlobalId) {
    if id.x >= PATTERN_TEXELS || id.y >= PATTERN_ROWS {
        return
    }
    let p = (vec2(f32(id.x), f32(from + id.y)) + vec2(0.5)) * (PATTERN_SIDE / f32(PATTERN_TEXELS))
    out.store(id, sea.pattern(p))
}

/// The sea's patterns at rest place `rest`, through the pixel's footprint there: laid along the
/// wind.
fn patterned(short: Short, rest: vec2) -> vec4 {
    let w = short.wind
    let across = vec2(-w.y, w.x)
    let p = vec2(dot(rest, w), dot(rest, across)) / PATTERN_SIDE
    let du = dpdx(rest)
    let dv = dpdy(rest)
    short.pattern.sample_grad(
        short.s,
        p,
        vec2(dot(du, w), dot(du, across)) / PATTERN_SIDE,
        vec2(dot(dv, w), dot(dv, across)) / PATTERN_SIDE,
    )
}

impl<W: Waters + Chart> Seas<W> {
    /// The ocean summed at time `t` (s), for this drawing.
    pub fn step(mut self, t: f32) {
        self.ocean.step(t)
        if !self.patterned {
            label("patterns")
            var band = writable_texture::<Rgba16Float>(width: PATTERN_TEXELS, height: PATTERN_ROWS)
            for k in 0..PATTERN_TEXELS / PATTERN_ROWS {
                dispatch(
                    pattern_texel.bind(sea: self.waters, from: k * PATTERN_ROWS, out: mut band),
                    groups: (PATTERN_TEXELS / 8, PATTERN_ROWS / 8, 1),
                )
                copy_texture(band.level(0), self.pattern.level_mut(0), to_y: k * PATTERN_ROWS)
            }
            generate_mips(mut self.pattern, self.ocean.mips)
            self.patterned = true
        }
    }

    /// How far its water stands off the level at most (m).
    pub fn reach(self) -> f32 {
        self.reach
    }

    /// Each of `places`' highest crest over the last `window` s, the older ones `drop` m a second
    /// lower (the water's level there, from the tiles this frame's `step` made, kept a frame at a
    /// time on the GPU), written into `out`'s first value (`x` the first place's, and so on): a
    /// medium thrown up where waves break (`mediums::lister::Mediums::live`), anything that
    /// floats. The CPU sums no wave and reads nothing back. Time `t` (s) is this frame's; a
    /// level kept from a later time than `t` (a time gone back) is let go.
    pub fn crests(
        mut self,
        places: Places,
        t: f32,
        window: f32,
        drop: f32,
        out: mut GpuBuffer<vec4>,
    ) {
        label("crests")
        dispatch(
            levelled.bind(
                sea: self.waters,
                long: long_of(self.ocean),
                places: places,
                out: mut self.now,
            ),
            groups: 1,
        )
        dispatch(crested.bind(now: self.now.items(), t: t, kept: mut self.kept), groups: 1)
        dispatch(
            highest.bind(kept: self.kept.items(), t: t, window: window, drop: drop, out: mut out),
            groups: 1,
        )
    }

    /// The long bands' tiles, as its vertices read them.
    pub fn long(self) -> Long {
        long_of(self.ocean)
    }

    /// Drawn into the picture's one pass (`frame::picture::Frame::draw`), round its eye.
    pub fn draw_into(self, d: Drawing) {
        let eye = d.eye
        var round = eye
        round.at += self.nudge
        let (layout, runs) = self.rings.frame(round, self.waters.domain(), -self.reach, self.reach)
        let long = self.long()
        let seen = self.marks.seen()
        let short = Short {
            big_froth: self.ocean.big.froth,
            mid_froth: self.ocean.mid.froth,
            marks_now: seen.now,
            marks_s: seen.s,
            marks_window: seen.window,
            fine_tilt: self.ocean.fine.tilt,
            ripple_tilt: self.ocean.ripple.tilt,
            s: self.ocean.mips,
            view: self.ocean.view(),
            sky: d.mirror,
            sky_s: d.mirror_s,
            sky_map: d.sky_map,
            wind: self.ocean.sea.wind,
            pattern: self.pattern,
        }
        // Each part by its pixels' pipeline for as many live lights as reach it, as the land's
        // (`lister::Grounds::draw_into`).
        for r in runs {
            let lo = vec3(r.lo.x, -self.reach, r.lo.y)
            let hi = vec3(r.hi.x, self.reach, r.hi.y)
            let k = lit_by(d.light.lights, lo, hi)
            if k == 0 {
                self.drawn_run(d, layout, long, short, r, Unlit {})
            } else if k == 1 {
                self.drawn_run(d, layout, long, short, r, OneLit {})
            } else {
                self.drawn_run(d, layout, long, short, r, AllLit {})
            }
        }
    }

    /// Run `r` of the rings drawn into the picture's pass by the pixels' pipeline for `K`'s live
    /// lights.
    fn drawn_run<K: Lit>(
        self,
        d: Drawing,
        layout: Layout,
        long: Long,
        short: Short,
        r: Run,
        _lit: K,
    ) {
        draw(
            d.pass,
            sea_vertex.bind(
                d.eye,
                layout: layout,
                sea: self.waters,
                long: long,
                marks: self.marks.seen(),
                held: d.light.held,
                shade: d.light.shade,
                sky_map: d.sky_map,
                sky_s: d.mirror_s,
            ),
            sea_pixel.bind(
                d.eye,
                light: d.light,
                sea: self.waters,
                short: short,
                body: self.body,
                lights: K::LIVE,
            ),
            indices: self.rings.indices,
            index_count: r.count,
            first_index: r.first,
            first_instance: r.level,
            depth: NEARER,
        )
    }
}

/// `ocean`'s long bands' tiles, as a vertex or a kernel reads them.
fn long_of(ocean: Ocean) -> Long {
    Long {
        big_was: ocean.big.shape_was,
        big_tilt_was: ocean.big.tilt_was,
        big_shape: ocean.big.shape,
        big_tilt: ocean.big.tilt,
        mid_was: ocean.mid.shape_was,
        mid_tilt_was: ocean.mid.tilt_was,
        mid_shape: ocean.mid.shape,
        mid_tilt: ocean.mid.tilt,
        s: ocean.s,
        lean: leaning(ocean.sea),
        between: ocean.between(),
    }
}

/// How many places `Seas::crests` follows, and how many frames of their levels it keeps (a
/// second at 60 frames a second).
pub const CRESTED: u32 = 4
const KEPT: u32 = 64

/// The places (x, z) `Seas::crests` follows.
pub struct Places: Copy + GpuData {
    pub at: [vec2; CRESTED],
}

/// The water's level at each place over the frames before, and the time of each (s), the latest
/// at `next - 1`.
pub struct Crested: Copy + GpuData {
    pub levels: [vec4; KEPT],
    pub at: [f32; KEPT],
    pub next: u32,
}

/// The water resting at `rest` (x, z), from the long bands' tiles at their finest.
fn water_at<W: Waters>(sea: W, long: Long, rest: vec2) -> Wet {
    let big = band_at(
        long.big_was,
        long.big_tilt_was,
        long.big_shape,
        long.big_tilt,
        long.between.x,
        long.s,
        SIDES.x,
        long.lean,
        rest,
        0.0,
    )
    let mid = band_at(
        long.mid_was,
        long.mid_tilt_was,
        long.mid_shape,
        long.mid_tilt,
        long.between.y,
        long.s,
        SIDES.y,
        long.lean,
        rest,
        0.0,
    )
    sea.wet(rest, big, mid)
}

/// The water's level (m) over the place `p` (x, z): the rest place whose water is carried over
/// `p` found as a scene's CPU finds it (moved back twice by how far its water is carried, then a
/// step along how that changes), and its water's height.
pub fn level_at<W: Waters>(sea: W, long: Long, p: vec2) -> f32 {
    var r = p
    for _ in 0..2 {
        let w = water_at(sea, long, r)
        r = r - (w.shape.at.xz - p)
    }
    let w0 = water_at(sea, long, r).shape
    let off = w0.at.xz - p
    let det = w0.du.x * w0.dv.z - w0.dv.x * w0.du.z
    if abs(det) > 1.0e-6 {
        r = r - vec2(w0.dv.z * off.x - w0.dv.x * off.y, -w0.du.z * off.x + w0.du.x * off.y) / det
    }
    water_at(sea, long, r).shape.at.y
}

/// The water's level at each of `places`, an invocation a place.
@compute(4)
pub fn levelled<W: Waters>(sea: W, long: Long, places: Places, out: mut Slots<f32>, id: GlobalId) {
    out[id] = level_at(sea, long, places.at[id.x])
}

/// This frame's levels (`now`, `levelled`'s), kept at time `t` (one invocation).
@compute(1)
pub fn crested(now: [f32], t: f32, kept: mut One<Crested>, id: GlobalId) {
    let levels = vec4(now[0], now[1], now[2], now[3])
    kept.update(id, |c: Crested| {
        var k = c
        k.levels[k.next % KEPT] = levels
        k.at[k.next % KEPT] = t
        k.next += 1
        k
    })
}

/// Each place's highest kept level over the last `window` s before `t`, each `drop` m a second
/// lower for its age (one invocation).
@compute(1)
pub fn highest(kept: [Crested], t: f32, window: f32, drop: f32, out: mut One<vec4>, id: GlobalId) {
    let c = kept[0]
    var most = vec4(-1.0e9)
    for j in 0..KEPT {
        let age = t - c.at[j]
        if j < c.next && age >= 0.0 && age <= window {
            most = max(most, c.levels[j] - vec4(drop * age))
        }
    }
    out.set(id, most)
}
