// The rings held to what they promise: neighbouring levels meet vertex for vertex, each level's
// hole is the level inside it, and a frame draws few vertices. Each check is also run on a
// broken ring (a mutant) and shown to catch it.

use frame::eye::{Eye, eye_at}
use rings::{HALF, Layout, Placed, SIDE, hole, listed, placed}
use std::derive::Box2
use std::io::print

/// Eyes the checks look from: the coast's three, and some places off any grid, high and low.
fn eyes() -> Vec<Eye> {
    var out: Vec<Eye> = Vec::new()
    let at = vec3(0.0, 3.1, 7.0)
    out.push(eye_at(at, at + vec3(0.0, -0.07, -1.0), 0.75, width: 3840, height: 2160))
    out.push(eye_at(at, at + vec3(1.0, -0.06, -0.35), 0.75, width: 3840, height: 2160))
    for k in 0..12 {
        let p = vec3(f32(k) * 13.37 - 70.3, 1.5 + f32(k % 4) * 7.1, f32(k) * -5.731 + 11.9)
        out.push(
            eye_at(p, p + vec3(sin(f32(k)), -0.2, cos(f32(k))), 0.8, width: 1920, height: 1080),
        )
    }
    out
}

const WIDE = Box2 { lo: vec2(-200000.0, -200000.0), hi: vec2(200000.0, 200000.0) }

/// A vertex placed with no morph at all: a broken ring, to show the checks catch one.
fn unmorphed(l: Layout, vertex: u32, level: u32) -> Placed {
    var p = placed(l, vertex, level)
    let n = f32(HALF)
    let g = vec2(f32(vertex % SIDE), f32(vertex / SIDE)) - vec2(n)
    let lv = l.levels[level]
    p.rest = lv.xy + g * lv.z
    p.morph = 0.0
    p
}

/// How many of each level's outer vertices are not, to the bit, a vertex of the level outside
/// it (where it lies, its spacing, and wholly unmorphed there), placed by `place`.
fn seams(l: Layout, place: fn(Layout, u32, u32) -> Placed) -> u32 {
    let n = f32(HALF)
    var off: u32 = 0
    for level in 0..l.count - 1 {
        for k in 0..4 * (2 * HALF) {
            let side = k / (2 * HALF)
            let t = k % (2 * HALF)
            let ij = if side == 0 { vec2u(t, 0) } else if side == 1 {
                vec2u(2 * HALF, t)
            } else if side == 2 { vec2u(2 * HALF - t, 2 * HALF) } else { vec2u(0, 2 * HALF - t) }
            let p = place(l, ij.y * SIDE + ij.x, level)
            let outer = l.levels[level + 1]
            let g = (p.rest - outer.xy) / outer.z + vec2(n)
            let whole = g == floor(g) &&
                g.x >= 0.0 &&
                g.y >= 0.0 &&
                g.x <= 2.0 * n &&
                g.y <= 2.0 * n
            if !whole {
                off += 1
            } else {
                let q = place(l, u32(g.y) * SIDE + u32(g.x), level + 1)
                if q.rest != p.rest || q.spacing != p.spacing || q.morph != 0.0 {
                    off += 1
                }
            }
        }
    }
    off
}

/// Every level's outer edge is the next level's hole's edge, vertex for vertex, to the bit: so
/// no crack can open between them, and no T joins them. Broken (no morph), it is not.
@test
fn neighbouring_levels_meet_vertex_for_vertex() {
    let (parts, _) = listed(0.125)
    var checked = 0
    var broken = 0
    for e in eyes() {
        let (l, _) = parts.frame(e, WIDE, low: -10.0, high: 10.0)
        assert(seams(l, placed) == 0, f"a seam is open, the eye at {e.at}")
        broken += seams(l, unmorphed)
        checked += (l.count - 1) * 8 * HALF
    }
    print(
        f"{checked} outer vertices each a vertex of the level outside; with no morph, {broken} are not",
    )
    assert(broken > 0, "the check catches a broken seam")
}

/// The hole of each level lies exactly where the level inside it does, for eyes anywhere: its
/// form the one the frame chose. Broken (the hole moved the other way), it does not.
@test
fn each_hole_is_the_level_inside() {
    let (parts, _) = listed(0.125)
    let n = f32(HALF)
    var wrong = 0
    var broken = 0
    for k in 0..400 {
        let p = vec3(f32(k) * 0.3713 - 61.0, 3.0, f32(k) * -0.2917 + 23.0)
        let e = eye_at(p, p + vec3(0.0, -0.1, -1.0), 0.8, width: 640, height: 360)
        let (l, _) = parts.frame(e, WIDE, low: -10.0, high: 10.0)
        for level in 1..l.count {
            let lv = l.levels[level]
            let inside = l.levels[level - 1]
            let o = (inside.xy - lv.xy) / lv.z
            let v = u32(o.y + 1.0) * 3 + u32(o.x + 1.0)
            let (h0, h1) = hole(v)
            let lo = lv.xy + (vec2(f32(h0.x), f32(h0.y)) - vec2(n)) * lv.z
            let hi = lv.xy + (vec2(f32(h1.x), f32(h1.y)) - vec2(n)) * lv.z
            if lo != inside.xy - vec2(n * inside.z) || hi != inside.xy + vec2(n * inside.z) {
                wrong += 1
            }
            let (b0, _) = hole(8 - v)
            let blo = lv.xy + (vec2(f32(b0.x), f32(b0.y)) - vec2(n)) * lv.z
            if v != 4 && blo != inside.xy - vec2(n * inside.z) {
                broken += 1
            }
        }
    }
    print(f"holes off the level inside: {wrong}; moved the other way, {broken}")
    assert(wrong == 0 && broken > 0, f"{wrong}, {broken}")
}

/// A frame draws few vertices: for the coast's eyes at 3840x2160, each chart's vertices drawn
/// (each distinct vertex of each run once), its triangles, and its levels.
@test
fn a_frame_draws_few_vertices() {
    let (parts, all) = listed(0.125)
    let sea = Box2 { lo: vec2(-200000.0, -200000.0), hi: vec2(200000.0, 12.0) }
    let land = Box2 { lo: vec2(-200000.0, -60.0), hi: vec2(200000.0, 400.0) }
    let es = eyes()
    for k in 0..2 {
        for (domain, low, high, name) in [(sea, -4.0, 4.0, "sea"), (land, -20.0, 5.0, "land")] {
            let (l, runs) = parts.frame(es[k], domain, low: low, high: high)
            var vertices = 0
            var triangles = 0
            for r in runs {
                var seen = Vec::filled(SIDE * SIDE, value: false)
                for i in 0..r.count {
                    let v = all[r.first + i]
                    if !seen[v] {
                        seen[v] = true
                        vertices += 1
                    }
                }
                triangles += r.count / 3
            }
            print(
                f"eye {k}, the {name}: {l.count} levels, {runs.len()} runs, {vertices} vertices, {triangles} triangles",
            )
            assert(vertices < 80000, f"{vertices} vertices")
        }
    }
}
