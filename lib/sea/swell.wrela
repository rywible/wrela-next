// The sea's long waves summed on the CPU, a wave at a time: the loudest of the two longer bands
// (`big`, `mid`), each band's sum kept apart so a game can damp each as its own depths ask. Each
// sum gives the water's displacement from its rest place (along x, up, along z) and its exact
// first derivatives, which a wave's spectrum gives for nothing (∂/∂x of a wave is i kx times it);
// and each band states how far it can bend (`Bend`), the sum of its waves' amplitudes times k
// and k², whatever the time.
//
// Carried from rywible/wrela at 7ae6711e, engine/ocean.wrela:908-1075 (`Mode`, `Swell`, `Moment`,
// `powers`, `shape_at`, `height_at`), with the derivatives `evolve` (:310-349) forms on the GPU
// written here for each wave, and the sum kept by band. The selection, the lattice tables and the
// order of the sum are the old code's.

use spectrum::{
    G, SIDE, SIDES, SeaState, amplitude, band, leaning, standing, standing_slope, wavenumber,
}
use std::math::TAU

/// A wave as the CPU sums it: its wavenumber (rad/m), its angular frequency (rad/s), its complex
/// amplitude at time 0 (m) and its mean square (2|a|², m²); which band it's from (0 big, 1 mid),
/// the way it runs (`k` made a unit vector), and its place on its band's lattice (`k` is `n` 2π /
/// the band's side).
pub struct Mode: Copy + GpuData {
    pub k: vec2,
    pub w: f32,
    pub a: vec2,
    pub power: f32,
    pub tile: u32,
    pub u: vec2,
    pub n: vec2i,
}

const NO_MODE = Mode {
    k: vec2(),
    w: 0.0,
    a: vec2(),
    power: 0.0,
    tile: 0,
    u: vec2(),
    n: vec2i(0, 0),
}

fn louder(a: Mode, b: Mode) -> bool {
    a.power > b.power
}

/// The `N` loudest waves of the two longer bands, and the crests' lean; how much of those bands'
/// height variance they hold (`held`, 0 to 1); and how far each band can bend (`bend`).
pub struct Swell<const N: u32>: Copy {
    pub modes: [Mode; N],
    pub chop: f32,
    pub held: f32,
    /// How far the crests lean down the wind per metre they stand (as the GPU's `settle` leans
    /// them).
    pub lean: vec2,
    pub bend: Bend,
}

/// How far each band can bend, whatever the time and place (x the big band, y the mid): the
/// largest its height can be (Σ 2|a|), the largest its slope can be (Σ 2|a| k) and the largest
/// its height's second derivative along any line can be (Σ 2|a| k²); and the largest its
/// unchopped displacement's derivative can be (Σ 2|a| k, as its slope's) and second derivative
/// (Σ 2|a| k²). Each wave is 2 Re(a e^(i(k·p - ωt))), so each term is that wave's own most.
pub struct Bend: Copy + GpuData {
    pub height: vec2,
    pub slope: vec2,
    pub curve: vec2,
}

/// A swell at one time (`Swell::moment`): each of its waves' amplitudes turned on to it
/// (a e^(-iωt)), once, for every place asked of that time.
pub struct Moment<const N: u32>: Copy {
    pub turned: [vec2; N],
}

/// One band's sum at a rest place: its height, its unchopped displacement (x, z), and their
/// first derivatives: the height's slope (∂h/∂x, ∂h/∂z) and the displacement's stretches
/// (∂Dx/∂x, ∂Dx/∂z = ∂Dz/∂x, ∂Dz/∂z).
pub struct Part: Copy + GpuData {
    pub stretch: vec3,
    pub h: f32,
    pub d: vec2,
    pub slope: vec2,
}

/// The water's height under a body (m): at its middle, its bow and stern, its port and starboard
/// side (`Swell::under`).
pub struct Under: Copy {
    pub mid: f32,
    pub bow: f32,
    pub stern: f32,
    pub port: f32,
    pub star: f32,
}

const NOTHING = Part { h: 0.0, d: vec2(), slope: vec2(), stretch: vec3() }

/// A band's water as it is drawn: where the water resting at a place is carried (x, up, z: the
/// displacement chopped and the crests leaned on their own height), and how that changes along x
/// (`du`) and along z (`dv`).
pub struct Shape: Copy + GpuData {
    pub at: vec3,
    pub du: vec3,
    pub dv: vec3,
}

fn cmul(a: vec2, b: vec2) -> vec2 {
    vec2(a.x * b.x - a.y * b.y, a.x * b.y + a.y * b.x)
}

/// How far out a band's lattice the CPU's waves lie, at most (a band ends six of the next band's
/// longest waves out: `band`): the length of the tables each way.
const LATTICE: u32 = 48

/// e^(i j θ) for j from -(LATTICE - 1) to LATTICE - 1, at `at + LATTICE - 1 + j` of `into`: each
/// from the one before, θ's own cosine and sine taken once.
fn powers(into: mut [vec2; 4 * (2 * LATTICE - 1)], at: u32, theta: f32) {
    let one = vec2(cos(theta), sin(theta))
    let mid = at + LATTICE - 1
    var e = vec2(1.0, 0.0)
    into[mid] = e
    for j in 1..LATTICE {
        e = cmul(e, one)
        into[mid + j] = e
        into[mid - j] = vec2(e.x, -e.y)
    }
}

/// `sea`'s `N` loudest waves of the big and mid bands, the mid's weighted `mid`.
pub fn loudest<const N: u32>(sea: SeaState, mid: f32) -> Swell<N> {
    ridden(sea, mid, long: 0.0)
}

/// The swell a body `long` m long rides: `sea`'s `N` loudest waves of the big and mid bands at
/// least `long` long, the mid's weighted `mid`. A wave shorter than the body lifts one end of it
/// as it drops the other, and the body rides through it; what it rides is the waves as long as
/// itself and longer, which are few (`held` says how much of the bands' height variance they
/// hold). The engine's answer to "how high is the water here" for a body: a sum of `N` waves,
/// the same bits on every run and every machine.
pub fn ridden<const N: u32>(sea: SeaState, mid: f32, long: f32) -> Swell<N> {
    var all: Vec<Mode> = Vec::new()
    var total = 0.0
    for i in 0..2 {
        let b = band(i)
        let weight = if i == 0 { 1.0 } else { mid }
        // The band's waves lie within hi of the origin: the lattice points out to there.
        let reach = min(i32(ceil(b.hi * b.side / TAU)), i32(SIDE / 2) - 1)
        assert(reach < i32(LATTICE), f"band {i}'s waves lie {reach} out: past the tables")
        for y in -reach..reach + 1 {
            for x in -reach..reach + 1 {
                let n = vec2i(x, y)
                let a = amplitude(sea, b, n) * weight
                let power = 2.0 * dot(a, a)
                let k = wavenumber(b, n)
                total += power
                if power > 0.0 && length(k) * long <= TAU {
                    all.push(
                        Mode { k, w: sqrt(G * length(k)), a, power, tile: i, u: k / length(k), n },
                    )
                }
            }
        }
    }
    all.sort_by(louder)
    assert(all.len() >= N, f"only {all.len()} waves to keep {N} of")
    var modes = [NO_MODE; N]
    var held = 0.0
    var bend = Bend { height: vec2(), slope: vec2(), curve: vec2() }
    for i in 0..N {
        let m = all[i]
        held += m.power
        modes[i] = m
        let reach = 2.0 * length(m.a)
        let kk = length(m.k)
        let one = vec2(if m.tile == 0 { 1.0 } else { 0.0 }, if m.tile == 0 { 0.0 } else { 1.0 })
        bend.height += one * reach
        bend.slope += one * (reach * kk)
        bend.curve += one * (reach * kk * kk)
    }
    Swell {
        modes,
        chop: sea.chop,
        held: if total > 0.0 { held / total } else { 0.0 },
        lean: leaning(sea),
        bend,
    }
}

impl<const N: u32> Swell<N> {
    /// It at time `t`: every wave turned on to `t`, a cosine and a sine each. Ask it once for all
    /// the places wanted at `t`: turning the waves is most of summing them.
    pub fn moment(self, t: f32) -> Moment<N> {
        var turned = [vec2(); N]
        for i in 0..N {
            let m = self.modes[i]
            let phase = -m.w * t
            turned[i] = cmul(m.a, vec2(cos(phase), sin(phase)))
        }
        Moment { turned }
    }

    /// Each band's sum at rest place `p` (x, z) at `now`'s time (big, then mid): each wave
    /// 2 Re(a e^(i(k·p - ωt))), its displacement 2 Re(iκ̂ a e^(...)) toward its crests, and their
    /// derivatives, i k times each.
    pub fn parts(self, now: Moment<N>, p: vec2) -> (Part, Part) {
        // (A band's waves lie on its lattice, k = n 2π / side, so e^(i k·p) is e^(i n.x θx) times
        // e^(i n.y θz) with θ = 2π p / side: two short tables a band, each power from the one
        // before, in place of a cosine and a sine a wave. p's whole turns of the tile dropped
        // first, so the powers are of an angle under a turn.)
        var e = [vec2(0.0); 4 * (2 * LATTICE - 1)]
        for tile in 0..2 {
            let q = p / SIDES[tile]
            powers(mut e, tile * 2 * (2 * LATTICE - 1), TAU * fract(q.x))
            powers(mut e, (tile * 2 + 1) * (2 * LATTICE - 1), TAU * fract(q.y))
        }
        var big = NOTHING
        var mid = NOTHING
        for i in 0..N {
            let m = self.modes[i]
            let at = m.tile * 2 * (2 * LATTICE - 1) + LATTICE - 1
            let ex = e[u32(i32(at) + m.n.x)]
            let ez = e[u32(i32(at + 2 * LATTICE - 1) + m.n.y)]
            let a = cmul(now.turned[i], cmul(ex, ez))
            // (re, im) of a e^(iφ): the height is 2 re, the displacement -2 κ̂ im, and each
            // derivative i k times its term.
            let re = a.x * 2.0
            let im = a.y * 2.0
            let term = Part {
                h: re,
                d: m.u * -im,
                slope: m.k * -im,
                stretch: vec3(m.u.x * m.k.x, m.u.x * m.k.y, m.u.y * m.k.y) * -re,
            }
            if m.tile == 0 { big = add(big, term) } else { mid = add(mid, term) }
        }
        (big, mid)
    }

    /// The water under a body whose middle is at `at` (x, z: a place on the level) at `now`'s
    /// time: its height there, and at `at` ± `along` and `at` ± `across` (its bow and stern, its
    /// starboard and port side), both bands whole. The water carried to its middle is found back
    /// in two steps, as `height` finds it, and the body's other four places are taken as carried
    /// as that water is stretched there (to first order); then one sum gives all five: each
    /// wave turned on to the middle once, and to each other place by the power of its lattice's
    /// angle there (`powers`). Five heights for the price of about one and a half: the engine's
    /// answer to "how high is the water here" for a body, the same bits on every run.
    pub fn under(self, now: Moment<N>, at: vec2, along_at: vec2, across_at: vec2) -> Under {
        var q = at
        var du = vec3(1.0, 0.0, 0.0)
        var dv = vec3(0.0, 0.0, 1.0)
        for _ in 0..2 {
            let (big, mid) = self.parts(now, q)
            let b = self.shaped(big)
            let m = self.shaped(mid)
            let d = b.at + m.at
            du = vec3(1.0, 0.0, 0.0) + b.du + m.du
            dv = vec3(0.0, 0.0, 1.0) + b.dv + m.dv
            q = at - vec2(d.x, d.z)
        }
        // (The places a body's ends rest at, to first order: its offsets carried back through
        // the carrying's own derivative there, the water stretched and squeezed under a crest.)
        let det = du.x * dv.z - dv.x * du.z
        let back = |o: vec2| vec2(dv.z * o.x - dv.x * o.y, -du.z * o.x + du.x * o.y) / det
        let along = back(along_at)
        let across = back(across_at)
        let span = 2 * LATTICE - 1
        var e = [vec2(0.0); 4 * (2 * LATTICE - 1)]
        var ea = [vec2(0.0); 4 * (2 * LATTICE - 1)]
        var ec = [vec2(0.0); 4 * (2 * LATTICE - 1)]
        for tile in 0..2 {
            let side = SIDES[tile]
            let o = q / side
            powers(mut e, (tile * 2) * span, TAU * fract(o.x))
            powers(mut e, (tile * 2 + 1) * span, TAU * fract(o.y))
            powers(mut ea, (tile * 2) * span, TAU * along.x / side)
            powers(mut ea, (tile * 2 + 1) * span, TAU * along.y / side)
            powers(mut ec, (tile * 2) * span, TAU * across.x / side)
            powers(mut ec, (tile * 2 + 1) * span, TAU * across.y / side)
        }
        var out = Under { mid: 0.0, bow: 0.0, stern: 0.0, port: 0.0, star: 0.0 }
        for i in 0..N {
            let m = self.modes[i]
            let at_x = i32(m.tile * 2 * span + LATTICE - 1) + m.n.x
            let at_z = i32((m.tile * 2 + 1) * span + LATTICE - 1) + m.n.y
            let base = cmul(now.turned[i], cmul(e[u32(at_x)], e[u32(at_z)]))
            let fa = cmul(ea[u32(at_x)], ea[u32(at_z)])
            let fc = cmul(ec[u32(at_x)], ec[u32(at_z)])
            let a = cmul(base, fa)
            let c = cmul(base, fc)
            // (A wave's height is 2 Re(a e^(iφ)); at a place o along, e^(ik·o) more, and at -o
            // its conjugate: Re(b conj(f)) = b.x f.x + b.y f.y.)
            out.mid += 2.0 * base.x
            out.bow += 2.0 * a.x
            out.stern += 2.0 * (base.x * fa.x + base.y * fa.y)
            out.star += 2.0 * c.x
            out.port += 2.0 * (base.x * fc.x + base.y * fc.y)
        }
        out
    }

    /// A band's sum as it's drawn: its displacement chopped, its crests leaned on its own height
    /// (as the GPU's `settle` leans a tile's), and how that changes along x and z.
    pub fn shaped(self, b: Part) -> Shape {
        let up = standing_slope(b.h)
        let carried = self.lean * standing(b.h)
        Shape {
            at: vec3(b.d.x * self.chop + carried.x, b.h, b.d.y * self.chop + carried.y),
            du: vec3(
                b.stretch.x * self.chop + self.lean.x * up * b.slope.x,
                b.slope.x,
                b.stretch.y * self.chop + self.lean.y * up * b.slope.x,
            ),
            dv: vec3(
                b.stretch.y * self.chop + self.lean.x * up * b.slope.y,
                b.slope.y,
                b.stretch.z * self.chop + self.lean.y * up * b.slope.y,
            ),
        }
    }

    /// Its displacement (x, height, z) at rest place `p` at time `t`, both bands whole: the open
    /// sea's, as the old CPU sum gave it (engine/ocean.wrela `Swell::shape`).
    pub fn shape(self, p: vec2, t: f32) -> vec3 {
        let (big, mid) = self.parts(self.moment(t), p)
        self.shaped(big).at + self.shaped(mid).at
    }

    /// Its height at `p` (x, z: a place on the level, not which water is there) at time `t`, both
    /// bands whole, the water carried there found back in two steps (as the old shading found
    /// it).
    pub fn height(self, p: vec2, t: f32) -> f32 {
        let now = self.moment(t)
        var q = p
        for _ in 0..2 {
            let (big, mid) = self.parts(now, q)
            let d = self.shaped(big).at + self.shaped(mid).at
            q = p - vec2(d.x, d.z)
        }
        let (big, mid) = self.parts(now, q)
        self.shaped(big).at.y + self.shaped(mid).at.y
    }
}

fn add(a: Part, b: Part) -> Part {
    Part { h: a.h + b.h, d: a.d + b.d, slope: a.slope + b.slope, stretch: a.stretch + b.stretch }
}

/// Band `i`'s sum of every one of its waves (not only the loudest) at rest place `p` at time `t`,
/// a wave at a time: what its GPU tile's texel holds where `p` is a texel's place (`tiles`), to
/// check the tiles by. Slow: some thousands of waves.
pub fn band_sum(sea: SeaState, i: u32, p: vec2, t: f32) -> Part {
    let b = band(i)
    let reach = min(i32(ceil(b.hi * b.side / TAU)), i32(SIDE / 2) - 1)
    var sum = NOTHING
    for y in -reach..reach + 1 {
        for x in -reach..reach + 1 {
            let n = vec2i(x, y)
            let a = amplitude(sea, b, n)
            if dot(a, a) > 0.0 {
                let k = wavenumber(b, n)
                let u = k / length(k)
                let phase = dot(k, p) - sqrt(G * length(k)) * t
                let e = cmul(a, vec2(cos(phase), sin(phase)))
                let re = e.x * 2.0
                let im = e.y * 2.0
                sum = add(
                    sum,
                    Part {
                        h: re,
                        d: u * -im,
                        slope: k * -im,
                        stretch: vec3(u.x * k.x, u.x * k.y, u.y * k.y) * -re,
                    },
                )
            }
        }
    }
    sum
}
