// The sea's four bands summed on the GPU each frame by inverse FFT (Tessendorf's method), each
// into a tile of 256² texels laid over the others at sides that don't divide each other, so no
// repeat lines up. Each texel holds where the water resting there has been carried (x, height,
// z: the crests lean and sharpen toward each other, the troughs widen), how that changes along
// x and along z (its slopes, stretches and shear: all a band's `swell::Shape` needs), and its
// foam; with mips. What a texel holds is what `swell` sums for the two longer bands, for every
// wave of the band, at the texel's rest place.
//
// A game damps a band where its water shallows by scaling what it reads of that band's tile,
// as it damps the CPU's sum of the band (`swell`). The foam is stepped state (docs/design.md,
// "Forms": a mark on the chart's domain), carried from frame to frame here as it was.
//
// Carried from rywible/wrela at 7ae6711e, engine/ocean.wrela:32-60, 288-801, as it was but for
// what nothing here calls: the pass-a-dispatch FFT kept to check it by (`butterfly`), the CPU's
// waves inside `Ocean` (`swell`), the bytes count, and the shaders' reads (`Waves`, `shape_at`,
// `level_at`, `surface_at`), which were the old trace's; and but for the shear (∂Dx/∂z), which
// the old tiles dropped and an exact normal needs: it is kept in the shape's fourth channel, and
// the foam in a texture of its own.

use spectrum::{
    Band, G, SIDE, SIDES, SeaState, TILES, amplitude, band, breaking, capillary, foam_fade,
    held_slopes, kept_over, leaning, slope_variance, standing, standing_slope, tail_alpha,
    wavenumber,
}
use std::gpu::{
    Address, GlobalId, GpuBuffer, LocalId, MipStep, Rgba16Float, Rgba32Float, Sampler, Shared,
    Slots, Texels, Texture, buffer, buffer_of, read, barrier, dispatch, label, mip_levels, sampler,
    writable_texture,
}
use std::io::Pending
use std::math::{PI, TAU}
use swell::Shape

/// The FFT's passes each way (log₂ of `SIDE`).
const PASSES: u32 = 8

/// The levels a tile's textures keep: 256 texels a side down to 8.
const MIPS: u32 = 6

/// How far past its breaking a crest's water goes white through, in its Jacobian's
/// deviations: a breaking crest's froth is white at once, its foam greying only as it fades.
const WHITENS: f32 = 0.45

/// How many steps the sea's settled over before its first (`Ocean::step`).
const WARM: u32 = 12

/// How fast the wind blows the foam over the water, as a share of its speed (some
/// hundredths: the surface's own drift), drawing it out down the wind into streaks.
const BLOWN: f32 = 0.035

/// Lattice point `i` (0 to SIDE - 1) as the wave it holds: 0 to SIDE/2 - 1, then the negatives.
fn wave_of(i: u32) -> i32 {
    if i < SIDE / 2 { i32(i) } else { i32(i) - i32(SIDE) }
}

/// `z` times i.
fn times_i(z: vec2) -> vec2 {
    vec2(-z.y, z.x)
}

fn cmul(a: vec2, b: vec2) -> vec2 {
    vec2(a.x * b.x - a.y * b.y, a.x * b.y + a.y * b.x)
}

/// Each wave of band `b` at time 0 (its complex amplitude, and that of the wave running the other
/// way), into texel `id` of `out`: worked out once, when the tile is made (it was a tenth of the
/// sea's step, every step).
@compute(8, 8)
fn spectrum_of(sea: SeaState, b: Band, out: mut Texels<Rgba32Float>, id: GlobalId) {
    if id.x >= SIDE || id.y >= SIDE {
        return
    }
    let n = vec2i(wave_of(id.x), wave_of(id.y))
    out.store(id, vec4(amplitude(sea, b, n), amplitude(sea, b, vec2i(-n.x, -n.y))))
}

/// Wave `id` of band `b` at time `t`: h₀(k) e^(-iωt), a wave running along k, and the conjugate
/// of the one running along -k, h₀*(-k) e^(iωt) (the height's spectrum is its own conjugate's
/// mirror, so its sum is real); and its wavenumber and the way it runs. `waves` holds h₀.
fn turned(b: Band, t: f32, waves: Texture<Rgba32Float>, id: GlobalId) -> (vec2, vec2, vec2) {
    let n = vec2i(wave_of(id.x), wave_of(id.y))
    let k = wavenumber(b, n)
    let kk = max(length(k), 1.0e-9)
    let am = waves.load(x: id.x, y: id.y)
    let phase = sqrt(G * kk) * t
    let c = cos(phase)
    let s = sin(phase)
    let h = vec2(am.x * c + am.y * s, am.y * c - am.x * s) +
        vec2(am.z * c + am.w * s, am.z * s - am.w * c)
    (h, k, k / kk)
}

/// Each wave of band `b` at time `t`, as the inverse FFT reads them: four pairs of real fields,
/// each pair one complex number (a real field's spectrum is its conjugate's mirror, so a + ib's
/// inverse is the two fields at once). Into `heights` the displacement along x with the height,
/// and the displacement along z with its shear (∂Dx/∂z); into `slopes` the height's slopes (∂h/∂x
/// with ∂h/∂z) and the stretches (∂Dx/∂x with ∂Dz/∂z). The displacement carries the water toward
/// a crest from either side (iκ̂h), so crests sharpen and troughs widen, and squeezes it there.
@compute(8, 8)
fn evolve(
    b: Band,
    t: f32,
    waves: Texture<Rgba32Float>,
    heights: mut Texels<Rgba32Float>,
    slopes: mut Texels<Rgba32Float>,
    id: GlobalId,
) {
    if id.x >= SIDE || id.y >= SIDE {
        return
    }
    let (h, k, u) = turned(b, t, waves, id)
    let ih = times_i(h)
    let dx = ih * u.x
    let dz = ih * u.y
    let dxz = h * (-k.x * u.y)
    let sx = ih * k.x
    let sz = ih * k.y
    let dxx = h * (-k.x * u.x)
    let dzz = h * (-k.y * u.y)
    heights.store(id, vec4(dx + ih, dz + times_i(dxz)))
    slopes.store(id, vec4(sx + times_i(sz), dxx + times_i(dzz)))
}

/// A short band's waves at time `t`, its slopes and stretches alone (`evolve`'s `slopes`): what
/// a pixel reads of it.
@compute(8, 8)
fn evolve_slopes(
    b: Band,
    t: f32,
    waves: Texture<Rgba32Float>,
    slopes: mut Texels<Rgba32Float>,
    id: GlobalId,
) {
    if id.x >= SIDE || id.y >= SIDE {
        return
    }
    let (h, k, u) = turned(b, t, waves, id)
    let ih = times_i(h)
    slopes.store(
        id,
        vec4(ih * k.x + times_i(ih * k.y), h * (-k.x * u.x) + times_i(h * (-k.y * u.y))),
    )
}

/// `i`'s low PASSES bits reversed: where the FFT's first pass reads.
fn reversed(i: u32) -> u32 {
    var r: u32 = 0
    for b in 0..PASSES {
        r = (r << 1) | ((i >> b) & 1)
    }
    r
}

/// All `PASSES` passes of the inverse FFT along one line of `SIDE` texels, in workgroup memory:
/// the line's element `x` (this invocation's) read in bit-reversed order into `sa`, `sb` by the
/// caller, each pass radix 2, decimating in time, two barriers a pass (all read before any
/// writes). Its result for `x`. Wave n's wavenumber is 2πn/L and texel m lies at mL/SIDE, so
/// e^(ikx) is e^(2πi nm/SIDE): the plain inverse transform, unscaled. (One dispatch a line in
/// place of a pass a dispatch: the tiles' texels go through memory twice a direction, not
/// `PASSES` times, and the sea's step is mostly that.)
fn line_fft(
    sa: mut Shared<vec4, SIDE>,
    sb: mut Shared<vec4, SIDE>,
    lid: LocalId,
    x: u32,
    a0: vec4,
    b0: vec4,
) -> (vec4, vec4) {
    let ca = sa.chunk(lid)
    let cb = sb.chunk(lid)
    sa.write(ca, 0, a0)
    sb.write(cb, 0, b0)
    barrier(mut sa)
    var na = a0
    var nb = b0
    for pass in 0..PASSES {
        let half: u32 = 1 << pass
        let j = x & (2 * half - 1)
        let jj = j & (half - 1)
        let top = x - j + jj
        let bottom = top + half
        let angle = TAU * f32(jj) / f32(2 * half)
        let w = vec2(cos(angle), sin(angle)) * (if j < half { 1.0 } else { -1.0 })
        let at = sa.get(top)
        let ab = sa.get(bottom)
        let bt = sb.get(top)
        let bb = sb.get(bottom)
        na = vec4(at.xy + cmul(w, ab.xy), at.zw + cmul(w, ab.zw))
        nb = vec4(bt.xy + cmul(w, bb.xy), bt.zw + cmul(w, bb.zw))
        barrier(mut sa)
        sa.write(ca, 0, na)
        sb.write(cb, 0, nb)
        barrier(mut sa)
    }
    (na, nb)
}

/// The inverse FFT along x of every row (`line_fft`), a workgroup a row.
@compute(256, 1)
fn fft_rows(
    a: Texture<Rgba32Float>,
    b: Texture<Rgba32Float>,
    to_a: mut Texels<Rgba32Float>,
    to_b: mut Texels<Rgba32Float>,
    sa: mut Shared<vec4, SIDE>,
    sb: mut Shared<vec4, SIDE>,
    lid: LocalId,
    id: GlobalId,
) {
    let r = reversed(id.x)
    let (na, nb) = line_fft(mut sa, mut sb, lid, id.x, a.load(x: r, y: id.y), b.load(x: r, y: id.y))
    to_a.store(id, na)
    to_b.store(id, nb)
}

/// The inverse FFT along z of every column (`line_fft`), a workgroup a column.
@compute(1, 256)
fn fft_columns(
    a: Texture<Rgba32Float>,
    b: Texture<Rgba32Float>,
    to_a: mut Texels<Rgba32Float>,
    to_b: mut Texels<Rgba32Float>,
    sa: mut Shared<vec4, SIDE>,
    sb: mut Shared<vec4, SIDE>,
    lid: LocalId,
    id: GlobalId,
) {
    let r = reversed(id.y)
    let (na, nb) = line_fft(mut sa, mut sb, lid, id.y, a.load(x: id.x, y: r), b.load(x: id.x, y: r))
    to_a.store(id, na)
    to_b.store(id, nb)
}

/// `line_fft` of one pair of fields.
fn line_fft1(sa: mut Shared<vec4, SIDE>, lid: LocalId, x: u32, a0: vec4) -> vec4 {
    let ca = sa.chunk(lid)
    sa.write(ca, 0, a0)
    barrier(mut sa)
    var na = a0
    for pass in 0..PASSES {
        let half: u32 = 1 << pass
        let j = x & (2 * half - 1)
        let jj = j & (half - 1)
        let top = x - j + jj
        let bottom = top + half
        let angle = TAU * f32(jj) / f32(2 * half)
        let w = vec2(cos(angle), sin(angle)) * (if j < half { 1.0 } else { -1.0 })
        let at = sa.get(top)
        let ab = sa.get(bottom)
        na = vec4(at.xy + cmul(w, ab.xy), at.zw + cmul(w, ab.zw))
        barrier(mut sa)
        sa.write(ca, 0, na)
        barrier(mut sa)
    }
    na
}

/// `fft_rows` of one pair of fields.
@compute(256, 1)
fn fft_rows1(
    a: Texture<Rgba32Float>,
    to_a: mut Texels<Rgba32Float>,
    sa: mut Shared<vec4, SIDE>,
    lid: LocalId,
    id: GlobalId,
) {
    to_a.store(id, line_fft1(mut sa, lid, id.x, a.load(x: reversed(id.x), y: id.y)))
}

/// `fft_columns` of one pair of fields.
@compute(1, 256)
fn fft_columns1(
    a: Texture<Rgba32Float>,
    to_a: mut Texels<Rgba32Float>,
    sa: mut Shared<vec4, SIDE>,
    lid: LocalId,
    id: GlobalId,
) {
    to_a.store(id, line_fft1(mut sa, lid, id.y, a.load(x: id.x, y: reversed(id.y))))
}

/// A short tile's slopes and stretches from the inverse FFT (`slopes`) into `tilt`, chopped. Not
/// leaned: a short band's lean changes its stretches by its slope times the lean, and in the
/// normal a stretch only ever scales a slope, so what the lean would change is of the second
/// order; it would need the band's heights summed too.
@compute(8, 8)
fn settle_short(
    chop: f32,
    slopes: Texture<Rgba32Float>,
    tilt: mut Texels<Rgba16Float>,
    id: GlobalId,
) {
    if id.x >= SIDE || id.y >= SIDE {
        return
    }
    let sq = slopes.load(x: id.x, y: id.y)
    tilt.store(id, vec4(sq.x, sq.y, sq.z * chop, sq.w * chop))
}

/// A level of a short tile's tilt, each texel the mean of the four under it in the level before.
@compute(8, 8)
fn halve_tilt(tilt: mut MipStep<Rgba16Float>, s: Sampler, size: vec2u, id: GlobalId) {
    if id.x < size.x && id.y < size.y {
        let uv = (vec2(f32(id.x), f32(id.y)) + vec2(0.5)) / vec2(f32(size.x), f32(size.y))
        tilt.store(id, tilt.sample(s, uv))
    }
}

/// A tile's fields from the inverse FFT (`heights`, `slopes`), as the surface reads them. Into
/// `shape`: its displacement (x, height, z; the crests leaned by `chop`) and its shear (∂Dx/∂z,
/// chopped: the lean's part of it differs along x and z, and is the reader's, `band_at`). Into
/// `tilt`: its slopes and stretches (∂h/∂x, ∂h/∂z, ∂Dx/∂x, ∂Dz/∂z, leaned as the crests are).
/// Into `froth`: its foam, the last frame's (`before`) carried `drift` texels down the wind and
/// `kept` of it left after the time since (faded once on the CPU, one number for every texel),
/// and fresh where a crest breaks: where the water is squeezed toward folding over, its Jacobian
/// under `breaks` (white `WHITENS` of a deviation, `spread`, past it).
@compute(8, 8)
fn settle(
    chop: f32,
    kept: f32,
    drift: vec2,
    lean: vec2,
    breaks: f32,
    spread: f32,
    heights: Texture<Rgba32Float>,
    slopes: Texture<Rgba32Float>,
    before: Texture<Rgba16Float>,
    shape: mut Texels<Rgba16Float>,
    tilt: mut Texels<Rgba16Float>,
    froth: mut Texels<Rgba16Float>,
    id: GlobalId,
) {
    if id.x >= SIDE || id.y >= SIDE {
        return
    }
    let hq = heights.load(x: id.x, y: id.y)
    let sq = slopes.load(x: id.x, y: id.y)
    // (The crests leaned on down the wind, `lean` m per metre they stand over the level, so
    // their lee faces steepen and their backs lengthen, as a wind's waves are: the water over
    // the level carried that far further, and its stretches with it.)
    let up = standing_slope(hq.y)
    let carried = lean * standing(hq.y)
    let dxx = sq.z * chop + lean.x * sq.x * up
    let dzz = sq.w * chop + lean.y * sq.y * up
    let dxz = hq.w * chop + lean.x * sq.y * up
    let dzx = hq.w * chop + lean.y * sq.x * up
    let squeezed = (1.0 + dxx) * (1.0 + dzz) - dxz * dzx
    // (The foam carried on from upwind, `drift` texels this step along x and z: from the
    // texels behind on either axis, as far as it moved.)
    let back_x = u32((i32(id.x) - i32(sign(drift.x)) + i32(SIDE)) % i32(SIDE))
    let back_z = u32((i32(id.y) - i32(sign(drift.y)) + i32(SIDE)) % i32(SIDE))
    let here = before.load(x: id.x, y: id.y).x
    let ax = min(abs(drift.x), 1.0)
    let az = min(abs(drift.y), 1.0)
    let old = here * (1.0 - ax) * (1.0 - az) +
        before.load(x: back_x, y: id.y).x * ax * (1.0 - az) +
        before.load(x: id.x, y: back_z).x * az * (1.0 - ax) +
        before.load(x: back_x, y: back_z).x * ax * az
    let broke = clamp((breaks - squeezed) / (spread * WHITENS), 0.0, 1.0)
    let foam = max(old * kept, broke)
    shape.store(id, vec4(hq.x * chop + carried.x, hq.y, hq.z * chop + carried.y, hq.w * chop))
    tilt.store(id, vec4(sq.x, sq.y, dxx, dzz))
    froth.store(id, vec4(foam, squeezed, 0.0, 0.0))
}

/// One tile's textures: its surface this frame (`shape`, `tilt`, with mips), its foam this frame
/// (`froth`, with mips: the foam, and how squeezed the water is), and its foam the frame before
/// (`before`), which this frame's carries on.
pub struct Tile {
    pub band: Band,
    /// Whether it's a short band's: summed for its tilt alone (no shape, no foam: a pixel reads
    /// its slopes, nothing its displacement).
    pub short: bool,
    /// Its waves at time 0 (h₀ and the wave running the other way's), worked out once.
    waves: Texture<Rgba32Float>,
    pub shape: Texture<Rgba16Float>,
    pub tilt: Texture<Rgba16Float>,
    pub froth: Texture<Rgba16Float>,
    before: Texture<Rgba16Float>,
    /// A long tile's step before its last (`shape_was`, `tilt_was`), and the times of the two
    /// (s): a long tile is stepped ahead, `STEPPED` s at a time, and read between its two last
    /// steps (`Ocean::between`). A short tile's `at` is its one step's time.
    pub shape_was: Texture<Rgba16Float>,
    pub tilt_was: Texture<Rgba16Float>,
    pub was: f32,
    pub at: f32,
    /// Where the tile's crests break: its Jacobian (1 flat, 0 folding), and its Jacobian's
    /// deviation, over which its foam whitens. A linear sum's crests crowd less than a real
    /// sea's steepest, which break short of folding: a crest breaks under 1 less a few of its
    /// deviations (some thousandths of the water, as a moderate breeze's white horses cover;
    /// the longest waves' the rarest, their texels too coarse for a white horse's shape, the
    /// shorter waves' the most); the ripples never do.
    breaks: f32,
    spread: f32,
}

/// Tile `i` of `sea`, its crests breaking where its Jacobian is `deviations` of its deviation
/// under 1 (none at all, if 0).
fn tile(sea: SeaState, i: u32, deviations: f32, short: bool) -> Tile {
    // (Down to 8 texels a side, not to one: each level is a dispatch of its own for each of a
    // tile's two textures every frame, and a dispatch costs tens of microseconds whatever it
    // writes. The last three levels were 24 of a frame's 80 dispatches, to average a tile whose
    // 8 texel level is its mean already to within what far water shows.)
    let levels = min(mip_levels(SIDE, SIDE), MIPS)
    let spread = sea.chop * sqrt(slope_variance(sea, band(i)))
    let whole = if short { 1 } else { SIDE }
    let whole_levels = if short { 1 } else { levels }
    var waves = writable_texture::<Rgba32Float>(width: SIDE, height: SIDE)
    dispatch(spectrum_of.bind(sea, band(i), out: mut waves), over: (SIDE, SIDE))
    Tile {
        band: band(i),
        short,
        waves,
        shape: writable_texture::<Rgba16Float>(width: whole, height: whole, levels: whole_levels),
        tilt: writable_texture::<Rgba16Float>(width: SIDE, height: SIDE, levels: levels),
        froth: writable_texture::<Rgba16Float>(width: whole, height: whole, levels: whole_levels),
        before: writable_texture::<Rgba16Float>(width: whole, height: whole, levels: whole_levels),
        shape_was: writable_texture::<Rgba16Float>(
            width: whole,
            height: whole,
            levels: whole_levels,
        ),
        tilt_was: writable_texture::<Rgba16Float>(
            width: whole,
            height: whole,
            levels: whole_levels,
        ),
        was: -1.0,
        at: -1.0,
        breaks: if deviations > 0.0 { 1.0 - deviations * spread } else { -1.0e9 },
        spread: max(spread, 1.0e-4),
    }
}

/// Long tile `tile` kept stepped ahead of time `t`: read between its two last steps, so its last
/// at or past `t`. When `t` passes it, the last step becomes the one before and the tile is
/// stepped `STEPPED` on; when `t` is out of reach of them (the first frame, or time run back or
/// leapt), stepped at `t` and again `STEPPED` less `offset` on (the mid tile offset half a step,
/// so the two never step in one frame).
fn ahead(
    sea: SeaState,
    t: f32,
    offset: f32,
    fresh: bool,
    tile: mut Tile,
    f: mut Scratch,
    s: Sampler,
) {
    if !fresh && t >= tile.was && t <= tile.at {
        return
    }
    if !fresh && t > tile.at && t <= tile.at + STEPPED {
        swap(mut tile.shape, mut tile.shape_was)
        swap(mut tile.tilt, mut tile.tilt_was)
        tile.was = tile.at
        let next = tile.at + STEPPED
        run(sea, next, min(STEPPED, 0.25), kept_over(sea, STEPPED), mut tile, mut f, s)
        return
    }
    run(sea, t, dt: 0.0, kept: 1.0, tile: mut tile, f: mut f, s: s)
    swap(mut tile.shape, mut tile.shape_was)
    swap(mut tile.tilt, mut tile.tilt_was)
    tile.was = t
    run(sea, t + STEPPED - offset, dt: 0.0, kept: 1.0, tile: mut tile, f: mut f, s: s)
}

/// The FFT's textures, which the tiles take in turn: the spectrum's two textures, and the two
/// each pass writes into.
struct Scratch {
    a: Texture<Rgba32Float>,
    b: Texture<Rgba32Float>,
    to_a: Texture<Rgba32Float>,
    to_b: Texture<Rgba32Float>,
}

/// Tile `tile` at time `t`, `dt` s after the last (at most a quarter second: how far its foam
/// drifts), its old foam kept by `kept`: its waves (`evolve`), summed along x and then along z,
/// settled into its surface and its mips filled.
fn run(sea: SeaState, t: f32, dt: f32, kept: f32, tile: mut Tile, f: mut Scratch, s: Sampler) {
    tile.at = t
    if tile.short {
        dispatch(
            evolve_slopes.bind(tile.band, t, waves: tile.waves, slopes: mut f.b),
            over: (SIDE, SIDE),
        )
        dispatch(fft_rows1.bind(a: f.b, to_a: mut f.to_b), groups: (1, SIDE, 1))
        dispatch(fft_columns1.bind(a: f.to_b, to_a: mut f.b), groups: (SIDE, 1, 1))
        dispatch(settle_short.bind(sea.chop, slopes: f.b, tilt: mut tile.tilt), over: (SIDE, SIDE))
        for i in 1..MIPS {
            let size = vec2u(max(SIDE >> i, 1), max(SIDE >> i, 1))
            dispatch(
                halve_tilt.bind(tile.tilt.mip_step(i), s, size),
                groups: ((size.x + 7) / 8, (size.y + 7) / 8, 1),
            )
        }
        return
    }
    dispatch(
        evolve.bind(tile.band, t, waves: tile.waves, heights: mut f.a, slopes: mut f.b),
        over: (SIDE, SIDE),
    )
    dispatch(
        fft_rows.bind(a: f.a, b: f.b, to_a: mut f.to_a, to_b: mut f.to_b),
        groups: (1, SIDE, 1),
    )
    swap(mut f.a, mut f.to_a)
    swap(mut f.b, mut f.to_b)
    dispatch(
        fft_columns.bind(a: f.a, b: f.b, to_a: mut f.to_a, to_b: mut f.to_b),
        groups: (SIDE, 1, 1),
    )
    swap(mut f.a, mut f.to_a)
    swap(mut f.b, mut f.to_b)
    swap(mut tile.froth, mut tile.before)
    dispatch(
        settle.bind(
            sea.chop,
            kept,
            sea.wind * (BLOWN * sea.speed * dt * f32(SIDE) / tile.band.side),
            leaning(sea),
            tile.breaks,
            tile.spread,
            heights: f.a,
            slopes: f.b,
            before: tile.before,
            shape: mut tile.shape,
            tilt: mut tile.tilt,
            froth: mut tile.froth,
        ),
        over: (SIDE, SIDE),
    )
    // Its mips: each level of its shape, its tilt and its foam from the level before, all in one
    // dispatch (`std::gpu::generate_mips` would make it three).
    for i in 1..MIPS {
        let size = vec2u(max(SIDE >> i, 1), max(SIDE >> i, 1))
        dispatch(
            halve.bind(
                tile.shape.mip_step(i),
                tile.tilt.mip_step(i),
                tile.froth.mip_step(i),
                s,
                size,
            ),
            groups: ((size.x + 7) / 8, (size.y + 7) / 8, 1),
        )
    }
}

/// A level of a tile's shape, its tilt and its foam, each texel the average of the four under it
/// in the level before (`s`, linear).
@compute(8, 8)
fn halve(
    shape: mut MipStep<Rgba16Float>,
    tilt: mut MipStep<Rgba16Float>,
    froth: mut MipStep<Rgba16Float>,
    s: Sampler,
    size: vec2u,
    id: GlobalId,
) {
    if id.x < size.x && id.y < size.y {
        let uv = (vec2(f32(id.x), f32(id.y)) + vec2(0.5)) / vec2(f32(size.x), f32(size.y))
        shape.store(id, shape.sample(s, uv))
        tilt.store(id, tilt.sample(s, uv))
        froth.store(id, froth.sample(s, uv))
    }
}

/// `t`'s texels at `at`, asked for (`texels`).
fn read_texels(t: Tile, at: [vec2u]) -> Pending<vec4> {
    let places = buffer_of(at)
    var out: GpuBuffer<vec4> = buffer(at.len() * 3)
    dispatch(
        texels.bind(shape: t.shape, tilt: t.tilt, froth: t.froth, at: places, out: mut out),
        over: at.len() * 3,
    )
    read(out.items())
}

/// What a shader needs of the ocean besides its textures: the tiles' sides (m); the slope
/// variance each octave of the shortest waves holds (their spectrum falls as k⁻⁴, so each
/// octave's is α ln 2 / 2), to roughen the light where a footprint loses them; the shortest
/// wave's wavenumber (rad/m); and the crests' chop.
pub struct Sea: Copy + GpuData {
    pub sides: vec4,
    pub octave: f32,
    pub finest: f32,
    pub chop: f32,
    /// The slope variance, along each slope, of the waves shorter than the ripples' shortest (the
    /// capillaries the wind raises, which roughen every footprint).
    pub unseen: f32,
}

/// The ocean: its sea, its four tiles and what sums them.
pub struct Ocean {
    pub sea: SeaState,
    pub big: Tile,
    pub mid: Tile,
    pub fine: Tile,
    pub ripple: Tile,
    scratch: Scratch,
    /// The surface's sampler (repeating, anisotropic), and the mips' (repeating, linear).
    pub s: Sampler,
    pub mips: Sampler,
    last: f32,
    /// The time of the sea this frame (s).
    pub now: f32,
    /// The tiles' slope variance, all four summed.
    held: f32,
}

/// How far ahead a long tile is stepped at a time (s): four frames at 60 a second. Its waves are
/// 22 m and longer (the mid tile's, 3.3 m), turning 0.11 rad (0.29) in that time, so read
/// between its two last steps by their times, linearly, a wave is off its own by at most
/// 1 - cos(0.055) of itself (0.15%; the mid's 1.1%).
pub const STEPPED: f32 = 4.0 / 60.0

impl Ocean {
    /// The ocean of `sea`.
    pub fn new(sea: SeaState) -> Ocean {
        // The crests break as often as the wind makes them (`breaking`): most on the longest
        // waves, the sea's own (a gale's white horses lie in bands along their crests, tens of
        // metres long), the waves a boat rides a little rarer; the short waves and the ripples
        // never (theirs would be speckle: the look draws the froth's grain).
        let d = breaking(sea)
        Ocean {
            sea,
            big: tile(sea, 0, d + 0.6, short: false),
            mid: tile(sea, 1, d + 0.6, short: false),
            fine: tile(sea, 2, 0.0, short: true),
            ripple: tile(sea, 3, 0.0, short: true),
            scratch: Scratch {
                a: writable_texture::<Rgba32Float>(width: SIDE, height: SIDE),
                b: writable_texture::<Rgba32Float>(width: SIDE, height: SIDE),
                to_a: writable_texture::<Rgba32Float>(width: SIDE, height: SIDE),
                to_b: writable_texture::<Rgba32Float>(width: SIDE, height: SIDE),
            },
            s: sampler(address: Address::Repeat, anisotropy: 8),
            mips: sampler(address: Address::Repeat),
            last: -1.0,
            now: 0.0,
            held: held_slopes(sea),
        }
    }

    /// The sea at time `t` (s): each tile summed and settled. The foam fades by the time since
    /// the last, and when time runs back or this is the first, the sea is settled over the
    /// half minute before `t` first (`WARM` steps), so its foam is as a sea's that's been
    /// blowing a while, not bare.
    pub fn step(mut self, t: f32) {
        self.now = t
        let fresh = self.last < 0.0 || t < self.last
        if fresh {
            label("ocean warming")
            let span = foam_fade(self.sea) * 2.0
            for k in 0..WARM {
                let at = t - span * f32(WARM - k) / f32(WARM)
                let gap = if k == 0 { 0.0 } else { span / f32(WARM) }
                self.all(at, gap, kept_over(self.sea, gap))
            }
            self.last = t - span / f32(WARM)
        }
        // (Faded over the whole time since, however long: a long gap leaves no old foam looking
        // fresh. Drifted at most a quarter second's worth.)
        let gap = max(t - self.last, 0.0)
        self.last = t
        label("ocean")
        let kept = kept_over(self.sea, gap)
        run(self.sea, t, min(gap, 0.25), kept, mut self.fine, mut self.scratch, self.mips)
        run(self.sea, t, min(gap, 0.25), kept, mut self.ripple, mut self.scratch, self.mips)
        // The long tiles stepped ahead when the time passes their last step, the mid's half a
        // step after the long's, so one frame steps at most one of them.
        ahead(self.sea, t, 0.0, fresh, mut self.big, mut self.scratch, self.mips)
        ahead(self.sea, t, 0.5 * STEPPED, fresh, mut self.mid, mut self.scratch, self.mips)
    }

    /// How far this frame's time is between each long tile's two last steps (0 to 1: the long
    /// tile's, then the mid's).
    pub fn between(self) -> vec2 {
        vec2(
            saturate((self.now - self.big.was) / max(self.big.at - self.big.was, 1.0e-6)),
            saturate((self.now - self.mid.was) / max(self.mid.at - self.mid.was, 1.0e-6)),
        )
    }

    /// Each tile at `t`, `dt` s after the last, `kept` of its old foam left.
    fn all(mut self, t: f32, dt: f32, kept: f32) {
        run(self.sea, t, dt, kept, mut self.big, mut self.scratch, self.mips)
        run(self.sea, t, dt, kept, mut self.mid, mut self.scratch, self.mips)
        run(self.sea, t, dt, kept, mut self.fine, mut self.scratch, self.mips)
        run(self.sea, t, dt, kept, mut self.ripple, mut self.scratch, self.mips)
    }

    /// Tile `tile`'s texels at `at` (0 the long band, then mid, fine, ripple), asked for now:
    /// for each, its shape, its tilt and its foam, in turn (`texels`).
    pub fn texels_of(self, tile: u32, at: [vec2u]) -> Pending<vec4> {
        if tile == 0 {
            return read_texels(self.big, at)
        }
        if tile == 1 {
            return read_texels(self.mid, at)
        }
        if tile == 2 {
            return read_texels(self.fine, at)
        }
        read_texels(self.ripple, at)
    }

    /// What a shader needs of it beside its textures.
    pub fn view(self) -> Sea {
        Sea {
            sides: SIDES,
            octave: tail_alpha(self.sea) * 0.5 * log(2.0),
            finest: band(TILES - 1).hi,
            chop: self.sea.chop,
            unseen: max(capillary(self.sea) - self.held, 0.0) * 0.5,
        }
    }
}

// ---- reading it in a shader ---------------------------------------------------------------------

/// Where rest place `p` (x, z, m) lies on a tile `side` m across: texel m holds the water
/// resting at m side / SIDE, its middle half a texel on.
pub fn on_tile(p: vec2, side: f32) -> vec2 {
    p / side + vec2(0.5 / f32(SIDE))
}

/// The mip level a tile `side` m across is read at for detail no finer than `spacing` m: where
/// its texels are `spacing` apart (0 at its own).
pub fn level_for(side: f32, spacing: f32) -> f32 {
    max(log2(spacing * f32(SIDE) / side), 0.0)
}

/// How much of a band is left read at level `lod`: all of it to its last mip, then fading to
/// nothing a level past it (a band's mean is nothing: it holds no wave as long as its tile).
pub fn kept_at(lod: f32) -> f32 {
    saturate(f32(MIPS) - lod)
}

/// A band's water as its tile holds it, between its two last steps (`shape_was`, `tilt_was`
/// and `shape`, `tilt`, `w` of the way from the one to the other), read with `s` at its rest
/// place `p` at mip level `lod`: where the water resting there is carried, and how that changes
/// along x and along z, its crests leaned down the wind by `lean` (`leaning`) as `settle` leans
/// them; as `swell::Swell::shaped` gives it from the CPU's sum.
pub fn band_at(
    shape_was: Texture<Rgba16Float>,
    tilt_was: Texture<Rgba16Float>,
    shape: Texture<Rgba16Float>,
    tilt: Texture<Rgba16Float>,
    w: f32,
    s: Sampler,
    side: f32,
    lean: vec2,
    p: vec2,
    lod: f32,
) -> Shape {
    let uv = on_tile(p, side)
    let a = mix(shape_was.sample_level(s, uv, lod), shape.sample_level(s, uv, lod), vec4(w))
    let t = mix(tilt_was.sample_level(s, uv, lod), tilt.sample_level(s, uv, lod), vec4(w))
    let up = standing_slope(a.y)
    let k = kept_at(lod)
    Shape {
        at: a.xyz * k,
        du: vec3(t.z, t.x, a.w + lean.y * up * t.x) * k,
        dv: vec3(a.w + lean.x * up * t.y, t.y, t.w) * k,
    }
}

/// A short band's change along x and along z (`Shape`'s `du` and `dv`; no displacement: the short
/// bands are the look's, not the chart's), read with `s` at rest place `p` through a footprint
/// `fu`, `fv` (m: how `p` changes a pixel across and down): its tilt alone, its slopes and
/// stretches. Its shear and its lean's share of `du.z` and `dv.x` are left out: in the normal
/// (`dv × du`) they are only ever multiplied by a slope, so what they change is of the second
/// order; and reading its shape too, for them, was a second texture read a band a pixel (at
/// 3840x2160, 0.56 ms of the sea's pass with an anisotropic sampler, the two bands).
pub fn slopes_at(
    tilt: Texture<Rgba16Float>,
    s: Sampler,
    side: f32,
    p: vec2,
    fu: vec2,
    fv: vec2,
) -> (vec3, vec3) {
    let t = tilt.sample_grad(s, on_tile(p, side), fu / side, fv / side)
    // Past its last mip a footprint still read the last level's texels, each its own: the
    // band's slopes, unfiltered, flashing pixel by pixel far off. They fade to their mean
    // (nothing) as the long bands' do (`kept_at`), by the level the footprint asks for.
    let k = kept_at(level_for(side, max(length(fu), length(fv))))
    (vec3(t.z, t.x, 0.0) * k, vec3(0.0, t.y, t.w) * k)
}

/// The slope variance a footprint `fu`, `fv` (m) loses, along each of its two sides: of the
/// waves too short for it, each octave's half (one slope of its two) past what a side holds
/// (the shortest held is `finest` rad/m), most along that side and the rest across; and the
/// capillaries no tile holds (`Sea::unseen`). From the old shading (engine/ocean.wrela:894-902).
pub fn lost(sea: Sea, fu: vec2, fv: vec2) -> vec2 {
    let past_u = max(log2(sea.finest * length(fu) / PI), 0.0)
    let past_v = max(log2(sea.finest * length(fv) / PI), 0.0)
    vec2(past_u * 0.75 + past_v * 0.25, past_v * 0.75 + past_u * 0.25) * (sea.octave * 0.5) +
        vec2(sea.unseen)
}

/// A tile's texels as they are, for checking against the CPU's sum: texel (`at[i].x`,
/// `at[i].y`) of `shape`, `tilt` and `froth`, into `out` at 3i, 3i + 1 and 3i + 2.
@compute(64)
pub fn texels(
    shape: Texture<Rgba16Float>,
    tilt: Texture<Rgba16Float>,
    froth: Texture<Rgba16Float>,
    at: [vec2u],
    out: mut Slots<vec4>,
    id: GlobalId,
) {
    let i = id.x / 3
    if i >= at.len() {
        return
    }
    let p = at[i]
    let k = id.x % 3
    out[id] = if k == 0 {
        shape.load(p.x, p.y)
    } else if k == 1 { tilt.load(p.x, p.y) } else { froth.load(p.x, p.y) }
}
