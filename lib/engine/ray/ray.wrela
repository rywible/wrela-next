// The ray (docs/design.md, "The engine's four modules": ray): what a ray meets, and how nearly it
// passes what it doesn't. One function: the eye's rays, a shadow, the sky's light, bounced light
// and "what is behind this" are this call from another place in another way.
//
// A ray is a cone: it starts `wide` m across and widens `spread` m a metre (an eye's ray starts
// at a point and widens by a pixel's angle; a shadow ray from a pixel's surface keeps that
// pixel's footprint). It steps as far as matter says it may (`Asked::step`: across empty roots, or
// by the distance its parts or cells give), never less than a quarter of its width,
// until matter says it is inside (`far` under 0); then the span of that step is halved to the
// surface. It begins where it is given: a ray that begins inside matter has met it there. It never
// aims a step at a face (the volume spike's tangent-plane steps passed thin things and went
// through faces); a part it skims and doesn't enter it simply goes on past.

use matter::asked::Asked

/// A ray: from `o` along `d` (unit), from `from` to `to` m along it, `wide` m across at `o`,
/// widening `spread` m a metre.
pub struct Ray: Copy {
    pub o: vec3,
    pub d: vec3,
    pub from: f32,
    pub to: f32,
    pub wide: f32,
    pub spread: f32,
}

/// What a ray met: whether it entered matter and where along it (m: the last place it was outside,
/// within a hundredth of a millimetre or a ten-thousandth of its last step); else, where it came nearest
/// matter, as a share of its own width there (`nearest`: how nearly it passed), and where. And
/// matter's walk where it ended (`walk`: what matter asks there through, opaque here).
pub struct Met<K: Copy>: Copy {
    pub met: bool,
    pub t: f32,
    pub nearest: f32,
    pub nearest_t: f32,
    pub steps: u32,
    pub walk: K,
}

/// The most steps a ray takes; how many times the span of its last step is cut to put it on the
/// surface, the first `SECANTS` where a line through the distances either side crosses 0, the
/// rest in halves; and how far past what matter allows a step reaches (`RELAX`).
pub const MOST_STEPS: u32 = 512
const HALVINGS: u32 = 10
const SECANTS: u32 = 4
const RELAX: f32 = 1.6

/// The least step, of the ray's width there; and a least step in metres beside it (a float's
/// span: a hundredth of a millimetre).
const LEAST: f32 = 0.25
const LEAST_M: f32 = 0.00001

/// What `r` meets of `w`.
pub fn met<W: Asked>(w: W, r: Ray) -> Met<W::Walk> {
    let begun = w.begun(r.o, r.d, r.wide, r.spread)
    let to = min(r.to, begun.far)
    var t = max(r.from, begun.near)
    if to < t {
        return Met { met: false, t: r.to, nearest: 1.0e9, nearest_t: r.to, steps: 0, walk: begun.walk }
    }
    var before = t
    var crossed = false
    var nearest = 1.0e9
    var nearest_t = t
    var steps: u32 = 0
    let inv = vec3(1.0) / r.d
    // (Where it is in matter's roots: matter's own, carried from step to step, so a root is
    // fetched once as the ray enters it. It only goes forward: going back, a new one.)
    var walk = begun.walk
    // (Over-relaxed: a step of `RELAX` times what matter allows, kept only where the sphere it
    // reached overlaps the one it came from, so nothing between them was passed; else the plain
    // step from where it was: J. Keinert, H. Schäfer, J. Korndörfer, U. Ganse and M. Stamminger,
    // "Enhanced Sphere Tracing", STAG 2014.)
    var relax = RELAX
    var last = 0.0
    var stretched = false
    var plain_before = 0.0
    var walk_before = walk
    var f_before = 1.0e9
    var f_after = -1.0
    while steps < MOST_STEPS && !crossed && t < to {
        steps += 1
        let width = r.wide + r.spread * t
        let a = w.step(walk, r.o + r.d * t, r.d, inv, t, width)
        walk = a.walk
        if a.y < 0.0 && stretched {
            // In on an over-relaxed step: past the plain step's end it may have passed in and
            // out of a thin part before this, and the surface found between would not be the
            // first (the creature's hits off by more than a pixel). Back to the plain step's end
            // (clear: matter allowed it), with the walk there, and plain from there on.
            t = before + plain_before
            relax = 1.0
            last = 0.0
            stretched = false
            walk = walk_before
        } else if a.y < 0.0 {
            // In: the surface lies between where it was and here.
            crossed = true
            f_after = a.y
        } else if relax > 1.0 && last > 0.0 && a.y + f_before < last {
            // The spheres don't overlap: the over-relaxed step may have passed something. Back,
            // and the next step plain.
            t = before
            relax = 1.0
            last = 0.0
            walk = begun.walk
        } else {
            // (How nearly it passes, only where matter answered with a distance: an empty brick's
            // bound says only that nothing is nearer, and is no near miss.)
            let share = a.y / max(width, 1.0e-9)
            if share < nearest && a.x <= a.y * 1.0001 {
                nearest = share
                nearest_t = t
            }
            before = t
            f_before = a.y
            let plain = max(a.x, max(LEAST * width, LEAST_M))
            plain_before = plain
            walk_before = walk
            // (Relaxed only by the distance, never past an empty brick's far side.)
            last = if a.x <= a.y * 1.0001 { max(relax * a.x, plain) } else { plain }
            stretched = last > plain * 1.0001
            t += last
        }
    }
    if !crossed {
        if steps >= MOST_STEPS && t < to && nearest < LEAST {
            // (Out of steps skimming matter within a quarter of its width: it lies along the
            // surface, and has met it where it came nearest.)
            return Met { met: true, t: nearest_t, nearest: 0.0, nearest_t, steps, walk }
        }
        return Met { met: false, t: min(t, r.to), nearest, nearest_t, steps, walk }
    }
    if t <= max(r.from, begun.near) {
        return Met { met: true, t, nearest: 0.0, nearest_t: t, steps, walk }
    }
    // Onto the surface: where a line through the distances either side is 0, then halved.
    var lo = before
    var hi = t
    var flo = min(f_before, hi - lo)
    var fhi = min(f_after, -1.0e-9)
    var k: u32 = 0
    while k < HALVINGS {
        k += 1
        let m = if k <= SECANTS { lo + (hi - lo) * clamp(flo / (flo - fhi), 0.05, 0.95) } else { 0.5 * (lo + hi) }
        let fm = w.far(walk, r.o + r.d * m, m, r.wide + r.spread * m)
        if fm < 0.0 {
            hi = m
            fhi = min(fm, -1.0e-9)
        } else {
            lo = m
            flo = fm
        }
    }
    // (The last place outside: a ray that leaves the surface from there starts outside it.)
    Met { met: true, t: lo, nearest: 0.0, nearest_t: lo, steps, walk }
}
