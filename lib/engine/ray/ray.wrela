// The ray (docs/design.md, "The engine's four modules": ray): what a ray meets, and how nearly it
// passes what it doesn't. One function: the eye's rays, a shadow, the sky's light, bounced light
// and "what is behind this" are this call from another place in another way.
//
// A ray is a cone: it starts `wide` m across and widens `spread` m a metre (an eye's ray starts
// at a point and widens by a pixel's angle; a shadow ray from a pixel's surface keeps that
// pixel's footprint). It steps as far as matter says it may (`Asked::step`: to an empty brick's
// far side, or by the distance its field or cells give), never less than a quarter of its width,
// until matter says it is inside (`far` under 0); then the span of that step is halved to the
// surface. It begins where it is given: a ray that begins inside matter has met it there. It never
// aims a step at a face (the volume spike's tangent-plane steps passed thin things and went
// through faces); a part it skims and doesn't enter it simply goes on past.

use matter::asked::Asked

/// A ray: from `o` along `d` (unit), from `from` to `to` m along it, `wide` m across at `o`,
/// widening `spread` m a metre.
pub struct Ray: Copy {
    pub o: vec3,
    pub d: vec3,
    pub from: f32,
    pub to: f32,
    pub wide: f32,
    pub spread: f32,
}

/// What a ray met: whether it entered matter and where along it (m: the last place it was outside,
/// within a hundredth of a millimetre or a ten-thousandth of its last step); and how nearly it
/// passed matter it didn't meet, as a share of its own width there (`nearest`), and where: the
/// least distance at a place it came near and then left (the distance rose again by its width
/// after), or, a ray that met nothing, the least at all. (A convex thing's distance along a line
/// has one least: a ray that meets a face never passes it, and one past an outline does.)
pub struct Met: Copy {
    pub met: bool,
    pub t: f32,
    pub nearest: f32,
    pub nearest_t: f32,
    pub steps: u32,
}

/// The most steps a ray takes; how many times the span of its last step is cut to put it on the
/// surface, the first `SECANTS` where a line through the distances either side crosses 0, the
/// rest in halves; and how far past what matter allows a step reaches (`RELAX`).
pub const MOST_STEPS: u32 = 512
const HALVINGS: u32 = 10
const SECANTS: u32 = 4
const RELAX: f32 = 1.6

/// The least step, of the ray's width there; and a least step in metres beside it (a float's
/// span: a hundredth of a millimetre).
const LEAST: f32 = 0.25
const LEAST_M: f32 = 0.00001

/// Where between three places a ray read the distance (`t`, distance: the least in the middle)
/// the distance is least, and that as a share of the ray's width there: the parabola through the
/// three squared distances (exact for a ray passing a sphere, a line or a plane: its squared
/// distance is a parabola along it), so how nearly it passed doesn't hang on where its steps fell.
/// Where there aren't three, the middle's.
fn passed(a: vec2, b: vec2, c: vec2, r: Ray) -> vec2 {
    let at_b = vec2(b.x, b.y / max(r.wide + r.spread * b.x, 1.0e-9))
    if a.x < 0.0 || c.x < 0.0 || !(a.x < b.x && b.x < c.x) {
        return at_b
    }
    let ya = a.y * a.y
    let yb = b.y * b.y
    let yc = c.y * c.y
    let p = (b.x - a.x) * (yb - yc)
    let q = (b.x - c.x) * (yb - ya)
    let den = p - q
    if !(abs(den) > 1.0e-20) {
        return at_b
    }
    let x = clamp(b.x - 0.5 * ((b.x - a.x) * p - (b.x - c.x) * q) / den, a.x, c.x)
    let la = (x - b.x) * (x - c.x) / ((a.x - b.x) * (a.x - c.x))
    let lb = (x - a.x) * (x - c.x) / ((b.x - a.x) * (b.x - c.x))
    let lc = (x - a.x) * (x - b.x) / ((c.x - a.x) * (c.x - b.x))
    let y = clamp(ya * la + yb * lb + yc * lc, 0.0, yb)
    vec2(x, sqrt(y) / max(r.wide + r.spread * x, 1.0e-9))
}

/// What `r` meets of `w`.
pub fn met<W: Asked>(w: W, r: Ray) -> Met {
    let span = w.span(r.o, r.d)
    let to = min(r.to, span.y)
    var t = max(r.from, span.x)
    if to < t {
        return Met { met: false, t: r.to, nearest: 1.0e9, nearest_t: r.to, steps: 0 }
    }
    var before = t
    var crossed = false
    var nearest = 1.0e9
    var nearest_t = t
    // (The least share since the distance last rose by the ray's width: a pass not yet left; and
    // the places either side of it, where the distance was read, to find its least between them.)
    var run = 1.0e9
    var run_t = t
    var at0 = vec2(-1.0)
    var at1 = vec2(-1.0)
    var at2 = vec2(-1.0)
    var seen = vec2(-1.0)
    var steps: u32 = 0
    let inv = vec3(1.0) / r.d
    // (Over-relaxed: a step of `RELAX` times what matter allows, kept only where the sphere it
    // reached overlaps the one it came from, so nothing between them was passed; else the plain
    // step from where it was: J. Keinert, H. Schäfer, J. Korndörfer, U. Ganse and M. Stamminger,
    // "Enhanced Sphere Tracing", STAG 2014.)
    var relax = RELAX
    var last = 0.0
    var f_before = 1.0e9
    var f_after = -1.0
    while steps < MOST_STEPS && !crossed && t < to {
        steps += 1
        let width = r.wide + r.spread * t
        let a = w.step(r.o + r.d * t, r.d, inv, width)
        if a.y < 0.0 {
            // In: the surface lies between where it was and here. (An over-relaxed step that
            // went in is kept too: what it passed before the plain step's end was clear, so the
            // surface is past that and before here.)
            crossed = true
            f_after = a.y
        } else if relax > 1.0 && last > 0.0 && a.y + f_before < last {
            // The spheres don't overlap: the over-relaxed step may have passed something. Back,
            // and the next step plain.
            t = before
            relax = 1.0
            last = 0.0
        } else {
            // (How nearly it passes, only where matter answered with a distance: an empty brick's
            // bound says only that nothing is nearer, and is no near miss.)
            let share = a.y / max(width, 1.0e-9)
            if a.x <= a.y * 1.0001 {
                if share < run {
                    run = share
                    run_t = t
                    at0 = seen
                    at1 = vec2(t, a.y)
                    at2 = vec2(-1.0)
                } else {
                    if at2.x < 0.0 {
                        at2 = vec2(t, a.y)
                    }
                    if share > run + 1.0 {
                        // Left a place it came near: a pass.
                        let least = passed(at0, at1, at2, r)
                        if least.y < nearest {
                            nearest = least.y
                            nearest_t = least.x
                        }
                        run = share
                        run_t = t
                        at0 = seen
                        at1 = vec2(t, a.y)
                        at2 = vec2(-1.0)
                    }
                }
                seen = vec2(t, a.y)
            }
            before = t
            f_before = a.y
            let plain = max(a.x, max(LEAST * width, LEAST_M))
            // (Relaxed only by the distance, never past an empty brick's far side.)
            last = if a.x <= a.y * 1.0001 { max(relax * a.x, plain) } else { plain }
            t += last
        }
    }
    if !crossed {
        if run < 1.0e9 {
            let least = passed(at0, at1, at2, r)
            if least.y < nearest {
                nearest = least.y
                nearest_t = least.x
            }
        }
        if steps >= MOST_STEPS && t < to && nearest < LEAST {
            // (Out of steps skimming matter within a quarter of its width: it lies along the
            // surface, and has met it where it came nearest.)
            return Met { met: true, t: nearest_t, nearest: 1.0e9, nearest_t, steps }
        }
        return Met { met: false, t: min(t, r.to), nearest, nearest_t, steps }
    }
    if t <= max(r.from, span.x) {
        return Met { met: true, t, nearest, nearest_t, steps }
    }
    // Onto the surface: where a line through the distances either side is 0, then halved.
    var lo = before
    var hi = t
    var flo = min(f_before, hi - lo)
    var fhi = min(f_after, -1.0e-9)
    var k: u32 = 0
    while k < HALVINGS {
        k += 1
        let m = if k <= SECANTS { lo + (hi - lo) * clamp(flo / (flo - fhi), 0.05, 0.95) } else { 0.5 * (lo + hi) }
        let fm = w.far(r.o + r.d * m, r.wide + r.spread * m)
        if fm < 0.0 {
            hi = m
            fhi = min(fm, -1.0e-9)
        } else {
            lo = m
            flo = fm
        }
    }
    // (The last place outside: a ray that leaves the surface from there starts outside it.)
    Met { met: true, t: lo, nearest, nearest_t, steps }
}
