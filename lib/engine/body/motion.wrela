// A movement as the solver reads and writes it (docs/plans/bodies-and-movement.md, phase 5 steps
// 3 and 4): the state of a body at a frame (`state`), the step from one frame to the next
// (`step`), the pose a step makes (`after`) and the goals a later frame sets (`goal`). Each is in
// the body's heading frame (the turn about +y that its root has made from rest), so a movement
// means the same thing wherever the body stands and whichever way it faces, and each number has a
// physical meaning for any body: heights and speeds in metres, turns in radians.
//
// The training scripts compute the same numbers from the same poses (`tools/movement/solve.py`),
// and a test of the tool that writes the data holds the two to each other.

use body::body::{Body, Pose}
use body::joint::{Frame, vector_of_turn}
use body::fit::{Aim, aim_frame, aim_point, fit}
use body::skin::Cone
use learned::net::Net
use std::collections::Vec
use std::hash::pcg

/// The numbers of `state` past the pose's own (2 D of them): the root's height, the two axes of
/// its tilt (6), its speed (3), its turn rate about +y (1) and its turn's rate (3).
pub const STATE_ROOT: u32 = 14

/// The numbers of `step` past the pose's own (D): the root's move along the ground (2), its next
/// height (1), its turn about +y (1) and its next tilt's two axes (6).
pub const STEP_ROOT: u32 = 10

/// The numbers of `goal`: the root's mean speed along the ground in the heading frame (2), the
/// heading's change (its sine and cosine, 2).
pub const GOAL: u32 = 4

/// The turn by `a` radians about +y.
pub fn yaw(a: f32) -> Quat {
    Quat::axis_angle(vec3(0.0, 1.0, 0.0), a)
}

/// Where a root turned by `q` faces, about +y, in radians: its rest's +z (`rest` the root's turn
/// at rest) turned as the root turned from rest, measured from +z toward +x.
pub fn heading(rest: Quat, q: Quat) -> f32 {
    let f = q.mul(rest.inverse()).rotate(vec3(0.0, 0.0, 1.0))
    atan2(f.x, f.z)
}

/// `a` brought into (-pi, pi].
pub fn wrapped(a: f32) -> f32 {
    var x = a
    while x > 3.14159265 {
        x -= 6.2831853
    }
    while x <= -3.14159265 {
        x += 6.2831853
    }
    x
}

/// The root's turn with its heading taken off: what is left is its tilt (and its turn about
/// itself) from rest. Written as the two axes it turns +x and +y to.
fn tilt(rest: Quat, q: Quat) -> (vec3, vec3) {
    let t = yaw(-heading(rest, q)).mul(q).mul(rest.inverse())
    (t.rotate(vec3(1.0, 0.0, 0.0)), t.rotate(vec3(0.0, 1.0, 0.0)))
}

/// The state at `now`, which came after `before` (`rate` frames a second), in `out`: the root's
/// height, tilt, speed in the heading frame, turn rate about +y and turn's rate; then the pose's
/// numbers and their rates.
pub fn state<const S: u32, const D: u32>(
    body: Body<S>,
    before: Pose<D>,
    now: Pose<D>,
    rate: f32,
    out: mut Vec<f32>,
) {
    let rest = body.segments[0].joint.at.q
    let h = heading(rest, now.root.q)
    let into = yaw(-h)
    out.clear()
    out.push(now.root.t.y)
    let (ax, ay) = tilt(rest, now.root.q)
    for v in [ax, ay] {
        out.push(v.x)
        out.push(v.y)
        out.push(v.z)
    }
    let v = into.rotate(now.root.t - before.root.t) * rate
    out.push(v.x)
    out.push(v.y)
    out.push(v.z)
    out.push(wrapped(h - heading(rest, before.root.q)) * rate)
    let w = into.rotate(vector_of_turn(now.root.q.mul(before.root.q.inverse()))) * rate
    out.push(w.x)
    out.push(w.y)
    out.push(w.z)
    for k in 0..D {
        out.push(now.q[k])
    }
    for k in 0..D {
        out.push((now.q[k] - before.q[k]) * rate)
    }
}

/// The step from `now` to `next`, in `out`: the root's move along the ground in `now`'s heading
/// frame, its height at `next`, its heading's change and its tilt at `next`; then the change of
/// each number.
pub fn step<const S: u32, const D: u32>(
    body: Body<S>,
    now: Pose<D>,
    next: Pose<D>,
    out: mut Vec<f32>,
) {
    let rest = body.segments[0].joint.at.q
    let h = heading(rest, now.root.q)
    let d = yaw(-h).rotate(next.root.t - now.root.t)
    out.clear()
    out.push(d.x)
    out.push(d.z)
    out.push(next.root.t.y)
    out.push(wrapped(heading(rest, next.root.q) - h))
    let (ax, ay) = tilt(rest, next.root.q)
    for v in [ax, ay] {
        out.push(v.x)
        out.push(v.y)
        out.push(v.z)
    }
    for k in 0..D {
        out.push(next.q[k] - now.q[k])
    }
}

/// The pose that step `s` (as `step` writes it) makes from `now`, each joint's numbers put into
/// its range. The tilt's two axes are made a frame first (Gram and Schmidt), so a step that a
/// net gives, whose axes are not quite square, still makes a turn.
pub fn after<const S: u32, const D: u32>(body: Body<S>, now: Pose<D>, s: [f32]) -> Pose<D> {
    let rest = body.segments[0].joint.at.q
    let h = heading(rest, now.root.q)
    var p = now
    let d = yaw(h).rotate(vec3(s[0], 0.0, s[1]))
    p.root.t = vec3(now.root.t.x + d.x, s[2], now.root.t.z + d.z)
    let a = normalize(vec3(s[4], s[5], s[6]))
    let b0 = vec3(s[7], s[8], s[9])
    let b = normalize(b0 - a * dot(a, b0))
    let t = Quat::from_mat3(mat3(a, b, cross(a, b)))
    p.root.q = yaw(h + s[3]).mul(t).mul(rest)
    for k in 0..D {
        p.q[k] = now.q[k] + s[STEP_ROOT + k]
    }
    for seg in 1..S {
        let n = body.freedom_of(seg)
        if n > 0 {
            body.set_numbers(mut p, seg, body.segments[seg].joint.clamped(body.numbers(p, seg)))
        }
    }
    p
}

/// The goal that `ahead` (`seconds` after `now`) sets: the root's mean speed along the ground
/// to it, in `now`'s heading frame, and the heading's change to it (its sine and cosine).
pub fn goal<const S: u32, const D: u32>(
    body: Body<S>,
    now: Pose<D>,
    ahead: Pose<D>,
    seconds: f32,
) -> [f32; GOAL] {
    let rest = body.segments[0].joint.at.q
    let h = heading(rest, now.root.q)
    let d = yaw(-h).rotate(ahead.root.t - now.root.t) / seconds
    let turn = heading(rest, ahead.root.q) - h
    [d.x, d.z, sin(turn), cos(turn)]
}

/// What a body is asked to do at a tick: its goal (`goal`'s numbers) and which of its two parts
/// it is held to: the speed along the ground, and the heading.
pub struct Wish: Copy {
    pub goal: [f32; GOAL],
    pub speed: bool,
    pub heading: bool,
}

/// A number of the standard normal distribution from `h` (Box and Muller, two hashes of it).
fn normal(h: u32) -> f32 {
    let u = (f32(pcg(h.wrapping_mul(2).wrapping_add(1)) >> 8) + 0.5) / 16777216.0
    let v = f32(pcg(h.wrapping_mul(2).wrapping_add(2)) >> 8) / 16777216.0
    sqrt(-2.0 * log(u)) * cos(6.2831853 * v)
}

/// How many ticks the solver's code takes to change: its value at each tick is between two draws
/// of the standard normal distribution made every `CODE_TICKS` ticks, so the movement it chooses
/// does not change at each tick.
pub const CODE_TICKS: u32 = 8

/// Number `k` of the code at `tick` from `seed`: between the draws of the knots before and after
/// the tick, by the tick's place between them, scaled to stay standard normal.
pub fn code(seed: u32, tick: u32, k: u32) -> f32 {
    let knot = tick / CODE_TICKS
    let u = f32(tick % CODE_TICKS) / f32(CODE_TICKS)
    let a = normal(pcg(seed.wrapping_add(knot.wrapping_mul(2654435761))).wrapping_add(k * 7919))
    let b = normal(
        pcg(seed.wrapping_add((knot + 1).wrapping_mul(2654435761))).wrapping_add(k * 7919),
    )
    ((1.0 - u) * a + u * b) / sqrt((1.0 - u) * (1.0 - u) + u * u)
}

/// The pose the solver `net` gives `period` frames after `now` (which came `period` frames after
/// `before`; the net's frames are `rate` a second) for `wish` at `tick`, its code drawn from
/// `seed` (the same seed and tick give the same pose on each machine). The net reads the state,
/// the goal (a part not held to is 0), the two flags, the period's log2 and the code; it gives the
/// step of one frame, which a body solved each `period` frames (`periods`: a body far from the eye)
/// takes `period` times over (`stretched`), as it was trained to (`tools/movement/solve_train.py`,
/// strides of 1, 2 and 4 frames). `after` puts each joint into its range.
pub fn solved<const S: u32, const D: u32>(
    body: Body<S>,
    net: Net,
    before: Pose<D>,
    now: Pose<D>,
    rate: f32,
    period: u32,
    wish: Wish,
    seed: u32,
    tick: u32,
) -> Pose<D> {
    var x: Vec<f32> = Vec::with_capacity(net.ins)
    state(body, before, now, rate / f32(period), mut x)
    let flags = [if wish.speed { 1.0 } else { 0.0 }, if wish.heading { 1.0 } else { 0.0 }]
    for k in 0..GOAL {
        x.push(wish.goal[k] * flags[k / 2])
    }
    x.push(flags[0])
    x.push(flags[1])
    x.push(log2(f32(period)))
    let n = net.ins - x.len()
    for k in 0..n {
        x.push(code(seed, tick, k))
    }
    var s: Vec<f32> = Vec::new()
    net.apply(x, mut s)
    if period > 1 {
        stretched(body, now, mut s, f32(period))
    }
    after(body, now, s)
}

/// Step `s` (of one frame from `now`) taken `k` times over: each change (the move along the
/// ground, the heading's turn, each number's change, and the height's and the tilt's from
/// `now`'s) times `k`.
pub fn stretched<const S: u32, const D: u32>(body: Body<S>, now: Pose<D>, s: mut Vec<f32>, k: f32) {
    let rest = body.segments[0].joint.at.q
    let (ax, ay) = tilt(rest, now.root.q)
    s[0] *= k
    s[1] *= k
    s[2] = now.root.t.y + k * (s[2] - now.root.t.y)
    s[3] *= k
    let was = [ax.x, ax.y, ax.z, ay.x, ay.y, ay.z]
    for i in 0..6 {
        s[4 + i] = was[i] + k * (s[4 + i] - was[i])
    }
    for i in STEP_ROOT..s.len() {
        s[i] *= k
    }
}

/// The pose a share `u` of the way from `now` to `next`, two solved poses a period apart that
/// came after `before` (a period before `now`): a cubic of each number, the root's place and its
/// turn's four numbers (normalised), whose rate at `now` is the mean of the two periods' and at
/// `next` the last period's (a cubic of Hermite). So the rates of a body that the solver moves each
/// few frames do not jump where two periods meet, as a straight line's do. What it shows at the
/// frames between.
pub fn between<const D: u32>(before: Pose<D>, now: Pose<D>, next: Pose<D>, u: f32) -> Pose<D> {
    let (u2, u3) = (u * u, u * u * u)
    let h00 = 2.0 * u3 - 3.0 * u2 + 1.0
    let h10 = u3 - 2.0 * u2 + u
    let h01 = -2.0 * u3 + 3.0 * u2
    let h11 = u3 - u2
    let cubic = |b: f32, a: f32, c: f32| h00 * a + h10 * 0.5 * (c - b) + h01 * c + h11 * (c - a)
    var p = now
    p.root.t = vec3(
        cubic(before.root.t.x, now.root.t.x, next.root.t.x),
        cubic(before.root.t.y, now.root.t.y, next.root.t.y),
        cubic(before.root.t.z, now.root.t.z, next.root.t.z),
    )
    // The turns on the same side as `now`'s.
    let qa = now.root.q.v
    let qb = if dot(qa, before.root.q.v) < 0.0 { -before.root.q.v } else { before.root.q.v }
    let qc = if dot(qa, next.root.q.v) < 0.0 { -next.root.q.v } else { next.root.q.v }
    p.root.q = Quat {
        v: normalize(
            vec4(
                cubic(qb.x, qa.x, qc.x),
                cubic(qb.y, qa.y, qc.y),
                cubic(qb.z, qa.z, qc.z),
                cubic(qb.w, qa.w, qc.w),
            ),
        ),
    }
    for k in 0..D {
        p.q[k] = cubic(before.q[k], now.q[k], next.q[k])
    }
    p
}

/// How often each body gets a pose from the solver (phase 5 step 10): a period in frames for each
/// body at `distance` (m) from the eye, each a power of two, at most `most`, so that the bodies'
/// mean cost a frame (each `cost`, over its period) is within `budget`. A body nearer than the
/// distance `d` of the first period of two gets a pose each frame, one at 2 d to 4 d each 2, and
/// so on: `d` is the largest that keeps the cost in the budget. If each body at `most` is over the
/// budget, each is at `most`.
pub fn periods(distance: [f32], cost: f32, budget: f32, most: u32) -> Vec<u32> {
    var lo = 1.0e-3
    var hi = 1.0e6
    if load(distance, cost, lo, most) > budget {
        return period_at(distance, lo, most)
    }
    if load(distance, cost, hi, most) <= budget {
        return period_at(distance, hi, most)
    }
    // The cost rises with `d`: the largest `d` in the budget, halving its ratio of `hi` to `lo`.
    for _ in 0..60 {
        let mid = sqrt(lo * hi)
        if load(distance, cost, mid, most) <= budget { lo = mid } else { hi = mid }
    }
    period_at(distance, lo, most)
}

fn period_of(distance: f32, d: f32, most: u32) -> u32 {
    var p = 1
    while p < most && distance > d * f32(p) {
        p *= 2
    }
    p
}

fn period_at(distance: [f32], d: f32, most: u32) -> Vec<u32> {
    var out: Vec<u32> = Vec::with_capacity(distance.len())
    for x in distance {
        out.push(period_of(x, d, most))
    }
    out
}

fn load(distance: [f32], cost: f32, d: f32, most: u32) -> f32 {
    var sum = 0.0
    for x in distance {
        sum += cost / f32(period_of(x, d, most))
    }
    sum
}

/// Whether body `index`, solved each `period` frames, is solved at `frame`: bodies of the same
/// period take their turns on different frames, so each frame's cost is near the mean.
pub fn due(period: u32, index: u32, frame: u32) -> bool {
    (frame + index) % period == 0
}

/// A timed goal of a part: point `point` of segment `segment` (in its frame) at `at` (the body's
/// space) at tick `tick` (a hand at a point, a foot on a step).
pub struct Reach: Copy {
    pub segment: u32,
    pub point: vec3,
    pub at: vec3,
    pub tick: u32,
}

/// The pose a step nearer `reach` at `tick`: the part's point brought a share of the way left
/// from where the pose has it to its aim (one over the ticks left and one), by the joints between
/// the root and the part, the root held where it is (`fit`): so the part is at its aim at its tick,
/// and nears it as steadily as the ticks allow. Past its tick the pose is itself.
pub fn reaching<const S: u32, const D: u32>(
    body: Body<S>,
    pose: Pose<D>,
    reach: Reach,
    tick: u32,
) -> Pose<D> {
    if tick > reach.tick {
        return pose
    }
    let left = reach.tick - tick
    let at = body.places(pose)
    let now = at[reach.segment].apply(reach.point)
    let aim = now + (reach.at - now) / f32(left + 1)
    var aims: Vec<Aim> = Vec::new()
    aims.push(aim_point(reach.segment, reach.point, aim, 1.0))
    aims.push(aim_frame(0, pose.root, 100.0, 100.0))
    let fitted = fit(body, aims, pose, 30, still: 0.001)
    fitted.pose
}

/// The pose with segment `segment` (a head: its frame's z the way it faces) turned a share
/// `share` of the way toward `point`, by its joints and those it hangs from, the root held.
pub fn looking<const S: u32, const D: u32>(
    body: Body<S>,
    pose: Pose<D>,
    segment: u32,
    point: vec3,
    share: f32,
) -> Pose<D> {
    let at = body.places(pose)
    let f = at[segment]
    let ahead = f.q.rotate(vec3(0.0, 0.0, 1.0))
    let want = normalize(point - f.t)
    let full = shortest(ahead, want)
    let part = Quat::identity().nlerp(full, share)
    var aims: Vec<Aim> = Vec::new()
    aims.push(
        Aim {
            segment,
            point: vec3(0.0),
            at: f.t,
            place: 0.0,
            turn: part.mul(f.q),
            turned: 1.0,
            axes: vec3(1.0),
            floor: false,
        },
    )
    aims.push(aim_frame(0, pose.root, 100.0, 100.0))
    fit(body, aims, pose, 8, still: 0.01).pose
}

/// The shortest turn that takes unit direction `a` to `b`.
fn shortest(a: vec3, b: vec3) -> Quat {
    let d = dot(a, b)
    if d > 0.999999 {
        return Quat::identity()
    }
    if d < -0.999999 {
        return Quat::axis_angle(vec3(0.0, 1.0, 0.0), 3.14159265)
    }
    Quat { v: normalize(vec4(cross(a, b), 1.0 + d)) }
}

/// The pose with its root raised by how far its deepest part is under the floor at `floor` (a
/// height): a net's pose sinks a foot by millimetres where its steps do not quite meet, and a body
/// does not go into the ground (phase 5 step 9). A pose with no part under the floor is itself.
pub fn on_floor<const S: u32, const D: u32, const P: u32>(
    body: Body<S>,
    parts: [Cone; P],
    pose: Pose<D>,
    floor: f32,
) -> Pose<D> {
    let at = body.places(pose)
    var deepest = 0.0
    for c in parts {
        let (a, b) = c.placed(at)
        deepest = max(deepest, max(floor - (a.y - c.ra), floor - (b.y - c.rb)))
    }
    var p = pose
    p.root.t.y += deepest
    p
}

// ---- tests -------------------------------------------------------------------------------------

use body::body::{Segment, body}
use body::joint::{Joint, Kind}

fn test_body() -> Body<3> {
    let wide = vec3(3.0)
    let free = Joint {
        kind: Kind::Fixed,
        parent: body::joint::NONE,
        at: Frame { q: Quat::axis_angle(vec3(1.0, 0.0, 0.0), 0.3), t: vec3(0.0, 1.0, 0.0) },
        lo: -wide,
        hi: wide,
        strength: vec3(100.0),
    }
    var hinge = free
    hinge.parent = 0
    hinge.kind = Kind::Hinge
    hinge.at = Frame { q: Quat::identity(), t: vec3(0.0, -0.4, 0.0) }
    hinge.lo = vec3(-1.0)
    hinge.hi = vec3(1.0)
    var ball = free
    ball.parent = 1
    ball.kind = Kind::Ball
    ball.at = Frame { q: Quat::identity(), t: vec3(0.0, -0.4, 0.0) }
    body(
        [
            Segment { joint: free, tip: vec3(0.0, -0.4, 0.0) },
            Segment { joint: hinge, tip: vec3(0.0, -0.4, 0.0) },
            Segment { joint: ball, tip: vec3(0.0, -0.4, 0.0) },
        ],
    )
}

fn moved(p: Pose<4>, t: f32) -> Pose<4> {
    var q = p
    q.root.t = p.root.t + vec3(0.3 * t, 0.02 * sin(4.0 * t), 1.1 * t)
    q.root.q = yaw(0.8 * t)
        .mul(Quat::axis_angle(vec3(1.0, 0.2, 0.0), 0.1 * sin(3.0 * t)))
        .mul(p.root.q)
    q.q = [0.5 * sin(2.0 * t), 0.2 * t, -0.1, 0.3 * cos(t)]
    q
}

@test
fn a_step_makes_the_next_pose_back() {
    let b = test_body()
    let rest: Pose<4> = b.rest()
    var s: Vec<f32> = Vec::new()
    var worst = 0.0
    for i in 0..40 {
        let now = moved(rest, f32(i) / 30.0)
        let next = moved(rest, f32(i + 1) / 30.0)
        step(b, now, next, mut s)
        assert(s.len() == STEP_ROOT + 4)
        let p = after(b, now, s)
        worst = max(worst, length(p.root.t - next.root.t))
        worst = max(worst, length(vector_of_turn(p.root.q.mul(next.root.q.inverse()))))
        for k in 0..4 {
            worst = max(worst, abs(p.q[k] - next.q[k]))
        }
    }
    assert(worst < 1.0e-5, f"the pose a step makes is {worst} from the next one")
}

@test
fn the_state_does_not_change_where_the_body_stands_or_faces() {
    let b = test_body()
    let rest: Pose<4> = b.rest()
    var a: Vec<f32> = Vec::new()
    var c: Vec<f32> = Vec::new()
    let turn = yaw(2.0)
    let shift = vec3(5.0, 0.0, -3.0)
    for i in 1..20 {
        let (p0, p1) = (moved(rest, f32(i - 1) / 30.0), moved(rest, f32(i) / 30.0))
        state(b, p0, p1, 30.0, mut a)
        var q0 = p0
        var q1 = p1
        q0.root = Frame { q: turn.mul(p0.root.q), t: turn.rotate(p0.root.t) + shift }
        q1.root = Frame { q: turn.mul(p1.root.q), t: turn.rotate(p1.root.t) + shift }
        state(b, q0, q1, 30.0, mut c)
        assert(a.len() == STATE_ROOT + 8 && c.len() == a.len())
        for k in 0..a.len() {
            assert(abs(a[k] - c[k]) < 1.0e-4, f"number {k}: {a[k]} and {c[k]}")
        }
    }
}

@test
fn a_step_out_of_range_is_put_into_it() {
    let b = test_body()
    let now: Pose<4> = b.rest()
    var s: Vec<f32> = Vec::new()
    step(b, now, now, mut s)
    s[STEP_ROOT] = 3.0
    let p = after(b, now, s)
    assert(abs(p.q[0] - 1.0) < 1.0e-5)
}

@test
fn a_stretched_step_is_the_steps_it_stands_for() {
    // Two frames of a smooth movement taken as one step of one frame stretched twice over: the
    // pose two frames on, to the second order of the movement's change.
    let b = test_body()
    let rest: Pose<4> = b.rest()
    var s: Vec<f32> = Vec::new()
    var worst = 0.0
    for i in 0..40 {
        let now = moved(rest, f32(i) / 60.0)
        let next = moved(rest, f32(i + 1) / 60.0)
        let far = moved(rest, f32(i + 2) / 60.0)
        step(b, now, next, mut s)
        stretched(b, now, mut s, 2.0)
        let p = after(b, now, s)
        worst = max(worst, length(p.root.t - far.root.t))
        for k in 0..4 {
            worst = max(worst, abs(p.q[k] - far.q[k]))
        }
    }
    assert(worst < 2.0e-3, f"a stretched step is {worst} from the pose it stands for")
}

@test
fn the_periods_keep_the_cost_in_the_budget() {
    var near: Vec<f32> = Vec::new()
    for i in 0..200 {
        near.push(1.0 + f32(i))
    }
    // 200 bodies from 1 m to 200 m at 64 microseconds each, in 1 ms a frame (12.8 ms each frame).
    let p = periods(near, 64.0, 1000.0, 16)
    var sum = 0.0
    for i in 0..200 {
        sum += 64.0 / f32(p[i])
        if i > 0 {
            assert(p[i] >= p[i - 1], f"body {i} is farther and solved more often")
        }
    }
    assert(sum <= 1000.0, f"{sum} microseconds a frame")
    assert(p[0] == 1, "the nearest body is solved each frame")
    assert(p[199] >= 8, f"the farthest body is solved each {p[199]} frames")
    // A few bodies: each frame.
    let few = periods([3.0, 30.0, 300.0], 64.0, 1000.0, 16)
    assert(few[0] == 1 && few[1] == 1 && few[2] == 1)
    // More than the budget at the least rate: each at the least rate.
    let many = periods(near, 64.0, 1.0, 16)
    assert(many[0] == 16 && many[199] == 16)
    // Turns taken on different frames.
    var on = 0
    for i in 0..16 {
        if due(16, i, 5) {
            on += 1
        }
    }
    assert(on == 1)
}

@test
fn between_ends_at_its_two_poses() {
    let b = test_body()
    let rest: Pose<4> = b.rest()
    let (w, x, y) = (moved(rest, 0.0), moved(rest, 0.1), moved(rest, 0.2))
    let (p0, p1) = (between(w, x, y, 0.0), between(w, x, y, 1.0))
    assert(length(p0.root.t - x.root.t) < 1.0e-6 && length(p1.root.t - y.root.t) < 1.0e-6)
    assert(abs(abs(dot(p1.root.q.v, y.root.q.v)) - 1.0) < 1.0e-6)
    // A smooth movement's frame between: near the movement's own there.
    let half = between(w, x, y, 0.5)
    let truth = moved(rest, 0.15)
    assert(length(half.root.t - truth.root.t) < 2.0e-3, f"{length(half.root.t - truth.root.t)}")
    assert(abs(half.q[0] - truth.q[0]) < 2.0e-3, f"{abs(half.q[0] - truth.q[0])}")
}
