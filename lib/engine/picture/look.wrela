// The look (docs/design.md, "What an author writes"): how light becomes the picture. The look owns
// tone, alone: matter and the sky say only how much light there is, physically, and the look says
// what the screen shows of it (exposure, a tone curve, optical bloom, a grade, later ink). Style
// enters nowhere else.

/// What a pixel's ray brought back, as the picture hands it to the look.
pub struct Seen: Copy {
    /// The light arriving at the eye along the ray (radiance, linear, the sky's units).
    pub light: vec3,
}

/// Optical bloom settings (lens/eye scattering of bright HDR radiance before tone mapping).
pub struct Bloom: Copy + GpuData {
    /// Additive bloom intensity (`0.0` disables bloom with zero GPU passes).
    pub strength: f32,
    /// Soft HDR luminance threshold above which light blooms (linear sky units).
    pub threshold: f32,
    /// Soft transition knee width around `threshold`.
    pub knee: f32,
    /// Filter spread scale (`1.0` default).
    pub radius: f32,
}

/// No optical bloom (default for unbloomed looks and brute-force reference comparisons).
pub fn no_bloom() -> Bloom {
    Bloom { strength: 0.0, threshold: 1.0, knee: 0.5, radius: 1.0 }
}

/// A look: light to the colour the screen shows, linear (from 0, black, to 1, the screen's
/// white; the picture encodes it for the screen).
pub trait Look: Copy + GpuData {
    fn tone(self, seen: Seen) -> vec3

    /// Optical bloom parameters (defaults to disabled so existing looks stay bit-identical).
    fn bloom(self) -> Bloom {
        no_bloom()
    }
}
