// A picture, as any way of drawing one can give it to be judged (`judge`): the colour each pixel
// shows (linear, a look's, before the screen's encoding) and, where the drawing knows it, where
// along each pixel's middle ray it put the surface it shows and which way that faces. A picture
// that can't say where (`placed` false) is judged on its colour alone.

use std::gpu::{Rgba16Float, Rgba32Float, Texture, texture}

pub struct Picture {
    /// What each pixel shows, linear (`Look::tone`'s colour).
    pub colour: Texture<Rgba16Float>,
    /// Where each pixel's middle ray met the surface it shows: the way it faces (`xyz`) and how
    /// far along the ray (`w`, m; 0 where it shows the sky).
    pub place: Texture<Rgba32Float>,
    /// Whether `place` is given.
    pub placed: bool,
}

/// A picture `width` × `height`, as yet unknown.
pub fn picture(width: u32, height: u32) -> Picture {
    Picture { colour: texture(width: width, height: height), place: texture(width: width, height: height), placed: false }
}

impl Picture {
    pub fn width(self) -> u32 {
        self.colour.width()
    }

    pub fn height(self) -> u32 {
        self.colour.height()
    }
}
