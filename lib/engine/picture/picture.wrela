// A picture, as any way of drawing one can give it to be judged (`judge`): the colour each pixel
// shows (linear, a look's, before the screen's encoding) and, where the drawing knows it, where
// along each pixel's middle ray it put the surface it shows and which way that faces. A picture
// that can't say where (`placed` false) is judged on its colour alone.

use std::gpu::{GpuBuffer, R8, Rgba16Float, Rgba32Float, Texture, buffer, texture}

pub struct Picture {
    /// What each pixel shows, linear (`Look::tone`'s colour).
    pub colour: Texture<Rgba16Float>,
    /// Where each pixel's middle ray met the surface it shows: the way it faces (`xyz`) and how
    /// far along the ray (`w`, m; 0 where it shows the sky).
    pub place: Texture<Rgba32Float>,
    /// Whether `place` is given.
    pub placed: bool,
    /// How much of the sun each pixel's middle ray's surface sees (1 where it doesn't say), so
    /// the judges can find where a shadow's edge is.
    pub sun: Texture<R8>,
    /// How much of each pixel matter covers, as the drawing reckons it (`covered` false: it doesn't
    /// say), so the judges can hold its outline to the reference's own cover and not only read it
    /// from colour: at an edge pixel (`edge_at`, its place in the list, or `NO_EDGE`) its cover
    /// there (`edge_cover`); elsewhere whether its middle ray met matter (`place`).
    pub edge_at: GpuBuffer<u32>,
    pub edge_cover: GpuBuffer<u32>,
    pub covered: bool,
}

/// A picture `width` × `height`, as yet unknown.
pub fn picture(width: u32, height: u32) -> Picture {
    Picture { colour: texture(width: width, height: height), place: texture(width: width, height: height), placed: false, sun: texture(width: width, height: height), edge_at: buffer(1), edge_cover: buffer(1), covered: false }
}

impl Picture {
    pub fn width(self) -> u32 {
        self.colour.width()
    }

    pub fn height(self) -> u32 {
        self.colour.height()
    }
}
