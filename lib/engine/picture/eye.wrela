// The eye (docs/design.md, "What an author writes"): where the picture is taken from. An author
// says where it stands, what it looks at and how wide it sees; the engine makes a view of it for
// whatever screen it is drawing (`view`), with each pixel's ray. The rays are a pinhole's. From
// branch `backend`'s lib/frame/eye.wrela (`Eye`, `eye_at`), cut to rays: no depth buffer, so no
// near plane and no clip space here.

/// An eye: where it stands, the point it looks at, and how wide it sees (rad, upward: the field
/// of view from the screen's top edge to its bottom).
pub struct Eye: Copy {
    pub at: vec3,
    pub toward: vec3,
    pub wide: f32,
}

/// An eye as one screen sees through it: where it stands, its axes (`forward` into the screen,
/// `right` and `up` across it), its focal length (1 over the tangent of half its field of view
/// upward), the screen's size (px), and how far every ray is moved within its pixel (px, from its
/// middle: one look of many in a pixel).
pub struct View: Copy + GpuData {
    pub at: vec3,
    pub focal: f32,
    pub forward: vec3,
    pub spare: f32,
    pub right: vec3,
    pub spare2: f32,
    pub up: vec3,
    pub spare3: f32,
    pub size: vec2,
    pub jitter: vec2,
}

/// `eye` seen through a `width` × `height` screen, every ray through its pixel's middle.
pub fn view(eye: Eye, width: u32, height: u32) -> View {
    let forward = normalize(eye.toward - eye.at)
    let right = normalize(cross(forward, vec3(0.0, 1.0, 0.0)))
    View {
        at: eye.at,
        focal: 1.0 / tan(0.5 * eye.wide),
        forward,
        spare: 0.0,
        right,
        spare2: 0.0,
        up: cross(right, forward),
        spare3: 0.0,
        size: vec2(f32(width), f32(height)),
        jitter: vec2(0.0),
    }
}

impl View {
    /// The ray through `pixel` (px, middles at half-integers), moved by `jitter`: a unit vector.
    pub fn ray(self, pixel: vec2) -> vec3 {
        let uv = ((pixel + self.jitter) * 2.0 - self.size) / self.size.y
        normalize(self.forward * self.focal + self.right * uv.x - self.up * uv.y)
    }

    /// A pixel's width a metre along the view (m): how wide a pixel's footprint is, at `t` m
    /// along a ray near the middle of the screen, over `t`.
    pub fn pixel(self) -> f32 {
        2.0 / (self.size.y * self.focal)
    }

    /// Where on the screen (px) the ray through the world point `w` crosses it, its rays
    /// through their pixels' middles.
    pub fn pixel_of(self, w: vec3) -> vec2 {
        let v = w - self.at
        let z = dot(v, self.forward)
        let uv = vec2(dot(v, self.right), -dot(v, self.up)) * (self.focal / z)
        (uv * self.size.y + self.size) * 0.5
    }

    /// The same view with every ray moved `jitter` px within its pixel.
    pub fn moved(self, jitter: vec2) -> View {
        var v = self
        v.jitter = jitter
        v
    }
}
