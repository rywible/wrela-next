// The picture, as slice 1 draws it (docs/design.md, "Order of work", 1): each thing by itself,
// then light, then the look. No scouts, no blocks yet.
//
// One where it is written, many where it runs (docs/design.md, under the four modules). Each thing
// is drawn by code specialised to it: `world::World::each` hands the picture each thing as GPU
// code asks it, answered only the ways that thing can be (`asked::Seen`'s `W`), and the picture
// draws it over the part of the screen its bound covers. A pixel runs only its things' code.
//
// A frame: for each thing an EYE draw (`eye`: a triangle over the screen at the depth of the
// bound's nearest point, scissored to the bound's rectangle) marches the pixel's ray against that
// thing alone (`ray::met`) and writes its own depth, never nearer than its triangle's, so the
// depth test keeps the nearest thing and skips pixels a nearer thing already covers; what it met,
// its facing and its light, split into what the sun's shadow ray decides and the rest. Then for
// each thing a SHADOW draw (`shadow`) over the screen: the sun's ray from each lit pixel against
// that thing alone, into a visibility target by the least (`Blend::Min`). Then one SHADE pass
// (`shade`): the look's tone of the light, or of the sky where nothing was met.
//
// The picture tells matter how finely it asks: every ask names the ray's width there (its
// footprint, m), and after each frame matter is handed the places the picture showed and the size
// each was asked at (`asks`), to refine its cells where they were coarser than that. Matter never
// sees the eye: only places and sizes.
//
// Where a pixel holds an edge (its middle ray met matter and a neighbour's didn't, or the other
// way; it passed matter within its width; its neighbour shows another surface, nearer or farther
// or turned another way), one ray through its middle can't say what it shows: the edge pass
// (`edges_found`, the same three draws laid out a ray a fragment, `edges_resolved`) draws it
// again as the mean of `EDGE_LOOKS`² rays spread evenly over it, as the reference's mean of looks
// over the pixel is. The edge pixels are listed first and their rays drawn a ray a fragment, so a
// few edge pixels don't hold up the many round them.
//
// The light here is a stand-in, the simplest that can be held to the reference exactly (the
// reference's `SIMPLE` light): the sun where a shadow ray (the same `ray::met`) says it reaches,
// toward the middle of its disc; and the sky's light as if nothing were in its way, read from a
// table of what the open sky lays on a face turned each way (`skylit`). The light module (slice 2)
// replaces it whole: nothing outside this file knows how a pixel is lit. Its shadow ray is the
// one ray that must cross every thing: a draw a thing over the whole screen.

use matter::asked::{Asked, box_span}
use matter::cells::{Kept, kept}
use matter::sky::{Sky, seen}
use matter::world::{Each, World}
use picture::eye::{Eye, View, view}
use picture::look::{Look, Seen}
use picture::picture::{Picture, picture}
use picture::screen::{cover, show}
use ray::ray::{Ray, met}
use reference::traced::LEAVE
use std::collections::Vec
use std::gpu::{
    Address, Atomics, Blend, ClipPosition, Cull, DepthPass5, DepthTexture, FragCoord, GlobalId, GpuBuffer, GpuSpan, Pass, R8,
    Rgba16Float, Rgba32Float, Sampler, Targets5, Texels, Texture, VertexIndex, InstanceIndex, WithDepthBehind, buffer_of, read, begin_pass,
    begin_pass5_with_depth, begin_screen_pass, buffer, depth_texture, discard, dispatch, draw, label, sampler, texture, timed,
    writable_texture,
}
use std::io::{Pending, print}

/// The picture is drawn in passes, each a band of the screen's rows, as many as keep a pass near
/// `BAND_US` by the last times of the banded passes (the eye draws, the shadow draws, and
/// the edge pass's two; each timed in turn, the dearest sizing them all: with many things the
/// shadows, a draw a thing over the screen, outweigh the eye draws; no pass may hold the GPU long:
/// AGENTS.md; the timing only cuts the work in parts, it never changes what is drawn): at first `FIRST_BANDS` (the stack
/// asked by its field took 58 ms a quarter of the screen at 1080p on the M4), and between
/// `LEAST_BANDS` and `MOST_BANDS`.
const BAND_US: f32 = 10000.0
const FIRST_BANDS: u32 = 32
const LEAST_BANDS: u32 = 1
const MOST_BANDS: u32 = 128

/// An edge pixel's rays a side; how far apart two neighbours' surfaces are, as a share of the
/// nearer's distance, to be two surfaces; and the least cosine between two neighbours' facings for
/// them to be one surface.
const EDGE_LOOKS: u32 = 3
const JUMP: f32 = 0.05
const CREASE: f32 = 0.8

/// No edge at a pixel; one in how many of a picture's pixels may be an edge (the rest drawn by
/// their middle ray alone): the edge rays fill a picture the screen's size.
const NO_EDGE: u32 = 4294967295
const EDGE_SHARE: u32 = 16

/// The sky table's texels a side (an octahedron's fold of every way a face can turn), and how
/// many ways each texel's light is gathered from (a side of a square of them, cosine-spread).
const TABLE: u32 = 32
const GATHER: u32 = 24

/// A unit vector folded onto an octahedron, as two numbers from -1 to 1, and back.
pub fn octa(n: vec3) -> vec2 {
    let a = n / (abs(n.x) + abs(n.y) + abs(n.z))
    if a.y >= 0.0 {
        return a.xz
    }
    (vec2(1.0) - abs(vec2(a.z, a.x))) * vec2(if a.x >= 0.0 { 1.0 } else { -1.0 }, if a.z >= 0.0 { 1.0 } else { -1.0 })
}

pub fn unocta(e: vec2) -> vec3 {
    var v = vec3(e.x, 1.0 - abs(e.x) - abs(e.y), e.y)
    let t = max(-v.y, 0.0)
    v.x += if v.x >= 0.0 { -t } else { t }
    v.z += if v.z >= 0.0 { -t } else { t }
    normalize(v)
}

/// The open sky's light on a face turned the way texel `id` stands for (irradiance): gathered
/// from `GATHER`² ways over its hemisphere, cosine-spread, evenly over the square.
@compute(8, 8)
pub fn skylit<S: Sky>(sky: S, out: mut Texels<Rgba16Float>, id: GlobalId) {
    if id.x >= TABLE || id.y >= TABLE {
        return
    }
    let n = unocta((vec2(f32(id.x), f32(id.y)) + vec2(0.5)) / f32(TABLE) * 2.0 - vec2(1.0))
    let s = if n.z >= 0.0 { 1.0 } else { -1.0 }
    let a = -1.0 / (s + n.z)
    let b = n.x * n.y * a
    let u = vec3(1.0 + s * n.x * n.x * a, s * b, -s * n.x)
    let v = vec3(b, s + n.y * n.y * a, -n.y)
    var sum = vec3(0.0)
    var i: u32 = 0
    while i < GATHER * GATHER {
        let e = (vec2(f32(i % GATHER), f32(i / GATHER)) + vec2(0.5)) / f32(GATHER)
        let c = sqrt(1.0 - e.x)
        let r = sqrt(max(1.0 - c * c, 0.0))
        let turn = 6.2831853 * e.y
        sum += sky.light(normalize(u * (r * cos(turn)) + v * (r * sin(turn)) + n * c))
        i += 1
    }
    out.store(id, vec4(sum * (3.14159265 / f32(GATHER * GATHER)), 1.0))
}

/// The open sky's light on a face turned `n`, from the table.
fn sky_on(table: Texture<Rgba16Float>, s: Sampler, n: vec3) -> vec3 {
    let e = octa(n) * 0.5 + vec2(0.5)
    table.sample_level(s, (e * (f32(TABLE) - 1.0) + vec2(0.5)) / f32(TABLE), 0.0).xyz
}

/// Where a fragment's ray goes through the screen: the screen's own pixels (`edges` 0), or the
/// edge pass's rays laid out a ray a fragment (`edges` 1: ray `j` of edge pixel `e` at fragment
/// `EDGE_LOOKS² e + j` of a picture `width` wide).
pub struct Lay: Copy + GpuData {
    pub edges: u32,
    pub width: u32,
    pub spare: u32,
    pub spare2: u32,
}

/// The point on the screen (px) a fragment at `at` draws the ray through (`xy`), and whether it
/// draws one (`z` 1): an edge pixel's ray is one of `EDGE_LOOKS`² spread evenly over its pixel.
fn spot(at: vec2, lay: Lay, list: GpuSpan<u32>, count: GpuSpan<u32>) -> vec3 {
    if lay.edges == 0 {
        return vec3(at, 1.0)
    }
    let i = u32(at.x) + lay.width * u32(at.y)
    let n = EDGE_LOOKS * EDGE_LOOKS
    let e = i / n
    if e >= count[0] {
        return vec3(0.0)
    }
    let pix = list[e]
    let j = i % n
    let o = (vec2(f32(j % EDGE_LOOKS), f32(j / EDGE_LOOKS)) + vec2(0.5)) / f32(EDGE_LOOKS)
    vec3(vec2(f32(pix % lay.width), f32(pix / lay.width)) + o, 1.0)
}

/// The depth (0 to 1) of what is `t` m along a pixel's ray: the nearer, the less, on every ray.
fn depth_of(t: f32) -> f32 {
    t / (t + 1.0)
}

/// The depth a near miss is kept at: behind anything met.
const MISSED: f32 = 0.9999999

/// The edge pass's layout over only the rays of one row of tiles of a thing's rectangle (the edge
/// pixels listed tile by tile, `TILE` px a side, tiles in rows `tw` across, `tile_at[t]` the first
/// of tile `t`'s; `EDGE_LOOKS`² rays each, a ray a fragment, `width` to a row; at most `most`): row
/// `ty0` + the instance of tiles `tx0` to `tx1`, its rays a span of the layout drawn as three
/// quads (its first row's part, the rows between, its last row's part), at depth `z`. A draw's
/// fragments are only the rays its thing can matter to.
@vertex
pub fn rays_tiles(v: VertexIndex, i: InstanceIndex, tile_at: GpuSpan<u32>, tx0: u32, tx1: u32, ty0: u32, tw: u32, most: u32, width: u32, height: u32, z: f32) -> ClipPosition {
    let n = EDGE_LOOKS * EDGE_LOOKS
    let row = (ty0 + i.index) * tw
    let a = min(tile_at[row + tx0], most) * n
    let b = min(tile_at[row + tx1 + 1], most) * n
    let ra = a / width
    let rb = b / width
    let part = v.index / 6
    let k = QUAD[v.index % 6]
    // (The span's three parts in fragments: x from `x0` to `x1`, rows `y0` to `y1`.)
    var x0: u32 = 0
    var x1: u32 = 0
    var y0: u32 = 0
    var y1: u32 = 0
    if ra == rb {
        if part == 0 {
            x0 = a % width
            x1 = b % width
            y0 = ra
            y1 = ra + 1
        }
    } else if part == 0 {
        x0 = a % width
        x1 = width
        y0 = ra
        y1 = ra + 1
    } else if part == 1 {
        x0 = 0
        x1 = width
        y0 = ra + 1
        y1 = rb
    } else {
        x0 = 0
        x1 = b % width
        y0 = rb
        y1 = rb + 1
    }
    let px = f32(if k % 2 == 0 { x0 } else { x1 })
    let py = f32(if k / 2 == 0 { y0 } else { y1 })
    let none = x1 <= x0 || y1 <= y0 || y0 >= height
    ClipPosition { position: if none { vec4(2.0, 2.0, 2.0, 1.0) } else { vec4(px / f32(width) * 2.0 - 1.0, 1.0 - 2.0 * min(py, f32(height)) / f32(height), z, 1.0) } }
}

/// How many pixels a side of the tiles the edge pixels are listed by.
const TILE: u32 = 32

/// The tiles of a screen `width` x `height`, across and down.
fn tiles_of(width: u32, height: u32) -> vec2u {
    vec2u((width + TILE - 1) / TILE, (height + TILE - 1) / TILE)
}

/// The tiles a rectangle `r` (px) covers, for `rays_tiles`: (tx0, tx1, ty0, rows of tiles).
fn tiles_over(r: vec4, width: u32, height: u32) -> vec4u {
    let t = tiles_of(width, height)
    let tx0 = min(u32(r.x) / TILE, t.x - 1)
    let tx1 = min((u32(max(r.z, 1.0)) - 1) / TILE, t.x - 1)
    let ty0 = min(u32(r.y) / TILE, t.y - 1)
    let ty1 = min((u32(max(r.w, 1.0)) - 1) / TILE, t.y - 1)
    vec4u(tx0, tx1, ty0, ty1 + 1 - ty0)
}

/// A quad's corners as two triangles (a corner `k`: x `k % 2`, y `k / 2`).
const QUAD: [u32; 6] = [0, 1, 2, 2, 1, 3]

/// The three corners of a triangle that covers the screen, at depth `z`.
@vertex
pub fn cover_at(v: VertexIndex, z: f32) -> ClipPosition {
    let x = f32(v.index % 2) * 4.0 - 1.0
    let y = f32(v.index / 2) * 4.0 - 1.0
    ClipPosition { position: vec4(x, y, z, 1.0) }
}

/// A thing's eye draw: the fragment's ray (`spot`) against that thing (`w`) alone. Where it meets
/// it: its own depth, and into the targets which way the surface faces and how far along the ray
/// (`first`), the place and the size it was asked at (`second`), the sun's light it would scatter
/// toward the eye if the shadow ray finds the sun (`third`; `w` 1 where the sun is in front of
/// it), what it scatters of the open sky's light, by the sky's light on a face turned so
/// (`fourth`), and what it gives off itself (`fifth`). A ray that passes it within half its width,
/// so that it is within the pixel: the place it passed, at the depth behind everything met (an
/// outline needs it, and the edge pass reads it as an edge). Else nothing.
@fragment
pub fn eye<A: Asked, S: Sky>(
    pixel: FragCoord,
    v: View,
    w: A,
    sky: S,
    lay: Lay,
    list: GpuSpan<u32>,
    count: GpuSpan<u32>,
) -> WithDepthBehind<Targets5<vec4, vec4, vec4, vec4, vec4>> {
    let at = spot(pixel.position.xy, lay, list, count)
    let d = v.ray(at.xy)
    let px = v.pixel()
    // (A fragment past the edge pass's last ray marches nothing: a discarded fragment goes on.)
    let m = met(w, Ray { o: v.at, d, from: 0.0, to: if at.z < 0.5 { -1.0 } else { 1.0e9 }, wide: 0.0, spread: px })
    var out = Targets5 { first: vec4(0.0), second: vec4(0.0), third: vec4(0.0), fourth: vec4(0.0), fifth: vec4(0.0) }
    var depth = MISSED
    if at.z < 0.5 || (!m.met && !(m.nearest < 0.5)) {
        discard()
    } else if !m.met {
        out.second = vec4(v.at + d * m.nearest_t, px * m.nearest_t)
    } else {
        let p = v.at + d * m.t
        let size = px * m.t
        let n = w.facing(m.walk, p, m.t, -d, size)
        let stuff = w.made_of(m.walk, p, m.t)
        let sun = sky.sun()
        let lean = dot(n, sun.way)
        out.first = vec4(n, m.t)
        out.second = vec4(p, size)
        out.third = vec4(stuff.scatters(n, sun.way, -d) * sun.light * max(lean, 0.0), if lean > 0.0 { 1.0 } else { 0.0 })
        out.fourth = vec4(stuff.scatters(n, n, -d), 0.0)
        out.fifth = vec4(stuff.emits, 0.0)
        depth = depth_of(m.t)
    }
    WithDepthBehind { color: out, depth }
}

/// A thing's shadow draw: from each pixel that met matter with the sun in front of it, the sun's
/// ray against that thing (`w`) alone: 0 where it meets it, else 1 (the least of the things'
/// is kept).
@fragment
pub fn shadow<A: Asked, S: Sky>(pixel: FragCoord, w: A, sky: S, place: Texture<Rgba32Float>, asks: Texture<Rgba32Float>, lit: Texture<Rgba16Float>) -> vec4 {
    let x = u32(pixel.position.x)
    let y = u32(pixel.position.y)
    let at = place.load(x, y)
    var seen_sun = 1.0
    if at.w > 0.0 && lit.load(x, y).w > 0.5 {
        let a = asks.load(x, y)
        let m = met(w, Ray { o: a.xyz + at.xyz * LEAVE, d: sky.sun().way, from: 0.0, to: 1.0e9, wide: a.w, spread: 0.0 })
        if m.met {
            seen_sun = 0.0
        }
    }
    vec4(seen_sun)
}

/// How far from its centre a thing's matter can be: its bound (`Kept::derived`, `ranges::
/// derived_bound`) is a cube, centre and half its side, so its corners are half a side times the
/// root of 3 away.
fn round_of(b: vec4) -> f32 {
    b.w * 1.7320508
}

/// A thing's bound (`bound`: a cube, centre and half its side) swept away from the sun along `away` (unit), `far` m:
/// where a ray toward the sun can start and meet the thing (up to where that line leaves the box
/// round the world's matter: nothing past it is shown).
pub struct Swept: Copy + GpuData {
    pub bound: vec4,
    pub away: vec3,
    pub far: f32,
}

/// Corner `c` of the swept bound `sw` as a box (its axis along `away`, from a radius before the
/// bound's centre to a radius past `far`, a radius and a footprint at its far end round it), through
/// `v`: its faces away from the eye drawn (the draw culls the rest), so each pixel whose shown
/// surface it may shade is drawn once, the eye inside it too; cut within `NEAR` of the eye.
@vertex
pub fn swept_corner(c: VertexIndex, v: View, sw: Swept) -> ClipPosition {
    let u = sw.away
    let a = if abs(u.y) < 0.9 { vec3(0.0, 1.0, 0.0) } else { vec3(1.0, 0.0, 0.0) }
    let e1 = normalize(cross(u, a))
    let e2 = cross(u, e1)
    let r = round_of(sw.bound) + v.pixel() * (length(sw.bound.xyz - v.at) + sw.far + round_of(sw.bound))
    let k = BOX[c.index]
    let s = vec3(f32(k & 1), f32((k >> 1) & 1), f32(k >> 2))
    let q = sw.bound.xyz + u * (-r + s.x * (sw.far + 2.0 * r)) + e1 * (s.y * 2.0 - 1.0) * r + e2 * (s.z * 2.0 - 1.0) * r - v.at
    let z = dot(q, v.forward)
    let j = v.jitter * 2.0 / v.size
    let x = dot(q, v.right) * v.focal * v.size.y / v.size.x
    let y = dot(q, v.up) * v.focal
    ClipPosition { position: vec4(x - j.x * z, y + j.y * z, z - NEAR, z) }
}

/// A box's corners (`BOX`: its twelve triangles, each running counter-clockwise seen from
/// outside, with y up: on the target, whose y runs down, a face toward the eye runs clockwise, so
/// `Cull::Back` keeps the faces toward the eye and `Cull::Front` those away; a corner `c` is at x
/// `c & 1`, y `c >> 1 & 1`, z `c >> 2`).
const BOX: [u32; 36] = [0, 4, 6, 0, 6, 2, 1, 3, 7, 1, 7, 5, 0, 1, 5, 0, 5, 4, 2, 6, 7, 2, 7, 3, 0, 2, 3, 0, 3, 1, 4, 5, 7, 4, 7, 6]

/// How near the eye a swept bound is drawn (m along the view).
const NEAR: f32 = 0.0001

/// The picture's colour at each fragment: the look's tone of the light where matter was met (what
/// it gives off, the sun where its shadow ray found it, the open sky's), else of the sky.
@fragment
pub fn shade<S: Sky, L: Look>(
    pixel: FragCoord,
    v: View,
    sky: S,
    look: L,
    table: Texture<Rgba16Float>,
    s: Sampler,
    place: Texture<Rgba32Float>,
    lit: Texture<Rgba16Float>,
    open: Texture<Rgba16Float>,
    emits: Texture<Rgba16Float>,
    sunny: Texture<R8>,
    lay: Lay,
    list: GpuSpan<u32>,
    count: GpuSpan<u32>,
) -> vec4 {
    let x = u32(pixel.position.x)
    let y = u32(pixel.position.y)
    let at = place.load(x, y)
    let spotted = spot(pixel.position.xy, lay, list, count)
    var colour = look.tone(Seen { light: seen(sky, v.ray(spotted.xy)) })
    if at.w > 0.0 {
        let found: f32 = sunny.load(x, y)
        let light = emits.load(x, y).xyz + lit.load(x, y).xyz * found + open.load(x, y).xyz * sky_on(table, s, at.xyz)
        colour = look.tone(Seen { light })
    }
    vec4(colour, 1.0)
}

/// Where on the screen (px: least x and y, greatest x and y, past the last) the sphere `b` can
/// show through `v`, `width` × `height`: its bounding cube's corners' pixels, or the whole screen
/// where a corner is behind the eye.
fn rect_of(v: View, b: vec4, width: u32, height: u32) -> vec4 {
    let all = vec4(0.0, 0.0, f32(width), f32(height))
    var lo = vec2(1.0e9)
    var hi = vec2(-1.0e9)
    var behind = false
    for k in 0..8 {
        let c = b.xyz + (vec3(f32(k & 1), f32((k >> 1) & 1), f32((k >> 2) & 1)) * 2.0 - vec3(1.0)) * b.w
        if dot(c - v.at, v.forward) <= 0.001 {
            behind = true
        } else {
            let q = v.pixel_of(c)
            lo = min(lo, q)
            hi = max(hi, q)
        }
    }
    if behind {
        return all
    }
    clamp(vec4(floor(lo) - vec2(1.0), ceil(hi) + vec2(1.0)), vec4(0.0), vec4(f32(width), f32(height), f32(width), f32(height)))
}

/// Where on the screen (px, as `rect_of`) the box from `lo` to `hi` can show through `v`: its
/// corners' pixels, or the whole screen where a corner is behind the eye.
fn rect_of_box(v: View, lo: vec3, hi: vec3, width: u32, height: u32) -> vec4 {
    let all = vec4(0.0, 0.0, f32(width), f32(height))
    var a = vec2(1.0e9)
    var b = vec2(-1.0e9)
    var behind = false
    for k in 0..8 {
        let c = mix(lo, hi, vec3(f32(k & 1), f32((k >> 1) & 1), f32((k >> 2) & 1)))
        if dot(c - v.at, v.forward) <= 0.001 {
            behind = true
        } else {
            let q = v.pixel_of(c)
            a = min(a, q)
            b = max(b, q)
        }
    }
    if behind {
        return all
    }
    clamp(vec4(floor(a) - vec2(1.0), ceil(b) + vec2(1.0)), vec4(0.0), vec4(f32(width), f32(height), f32(width), f32(height)))
}

/// The things' eye draws into one pass (`World::each`): each over its bound's rectangle within the
/// band of rows from `y0` to `y1`.
borrow struct Eyes<S: Sky> {
    pass: DepthPass5<Rgba32Float, Rgba32Float, Rgba16Float, Rgba16Float, Rgba16Float>,
    v: View,
    sky: S,
    lay: Lay,
    list: GpuSpan<u32>,
    count: GpuSpan<u32>,
    y0: u32,
    y1: u32,
    width: u32,
    height: u32,
    tile_at: GpuSpan<u32>,
    most: u32,
}

impl<S: Sky> Each for Eyes<S> {
    fn thing<A: Asked>(mut self, a: A, k: u32, bound: vec4) {
        let r = rect_of(self.v, bound, self.width, self.height)
        if self.lay.edges == 1 {
            // (Laid out a ray a fragment tile by tile: only the rays of its rectangle's tiles.)
            if u32(r.z) > u32(r.x) && u32(r.w) > u32(r.y) {
                self.pass.scissor(0, self.y0, self.width, self.y1 - self.y0)
                let near = max(length(bound.xyz - self.v.at) - round_of(bound), 0.0)
                let t = tiles_over(r, self.width, self.height)
                draw(self.pass, rays_tiles.bind(tile_at: self.tile_at, tx0: t.x, tx1: t.y, ty0: t.z, tw: tiles_of(self.width, self.height).x, most: self.most, width: self.width, height: self.height, z: depth_of(near)), eye.bind(v: self.v, w: a, sky: self.sky, lay: self.lay, list: self.list, count: self.count), vertices: 18, instances: t.w)
            }
            return
        }
        let ya = max(u32(r.y), self.y0)
        let yb = min(u32(r.w), self.y1)
        if u32(r.z) > u32(r.x) && yb > ya {
            self.pass.scissor(u32(r.x), ya, u32(r.z) - u32(r.x), yb - ya)
            // (Its nearest corner may be nearer than its centre less half its side.)
            let near = max(length(bound.xyz - self.v.at) - round_of(bound), 0.0)
            draw(self.pass, cover_at.bind(z: depth_of(near)), eye.bind(v: self.v, w: a, sky: self.sky, lay: self.lay, list: self.list, count: self.count), vertices: 3)
        }
    }
}

/// The things' shadow draws into one pass, each over the band of rows from `y0` to `y1`.
borrow struct Shadows<S: Sky> {
    pass: Pass<R8>,
    sky: S,
    place: borrow Texture<Rgba32Float>,
    asks: borrow Texture<Rgba32Float>,
    lit: borrow Texture<Rgba16Float>,
    y0: u32,
    y1: u32,
    width: u32,
    v: View,
    /// Laid out a ray a fragment (the edge pass: no place on the screen to draw a bound over),
    /// `count` edge pixels; and the screen's height.
    edge: bool,
    tile_at: GpuSpan<u32>,
    most: u32,
    height: u32,
    /// The box round the world's matter (its things' bounds).
    world_lo: vec3,
    world_hi: vec3,
}

impl<S: Sky> Each for Shadows<S> {
    fn thing<A: Asked>(mut self, a: A, k: u32, bound: vec4) {
        self.pass.scissor(0, self.y0, self.width, self.y1 - self.y0)
        let away = -self.sky.sun().way
        // (Swept to where that line leaves the box round the world's matter: nothing past it shows.)
        let far = max(box_span(bound.xyz, away, self.world_lo, self.world_hi).y, 0.0)
        let sw = Swept { bound, away, far }
        if self.edge {
            // (Only the rays of the screen's rows the swept bound covers.)
            let rr = round_of(bound)
            let lo = min(bound.xyz, bound.xyz + away * far) - vec3(rr)
            let hi = max(bound.xyz, bound.xyz + away * far) + vec3(rr)
            let r = rect_of_box(self.v, lo, hi, self.width, self.height)
            if u32(r.z) > u32(r.x) && u32(r.w) > u32(r.y) {
                let t = tiles_over(r, self.width, self.height)
                draw(self.pass, rays_tiles.bind(tile_at: self.tile_at, tx0: t.x, tx1: t.y, ty0: t.z, tw: tiles_of(self.width, self.height).x, most: self.most, width: self.width, height: self.height, z: 0.5), shadow.bind(w: a, sky: self.sky, place: self.place, asks: self.asks, lit: self.lit), vertices: 18, instances: t.w, blend: Blend::Min)
            }
        } else {
            draw(self.pass, swept_corner.bind(v: self.v, sw: sw), shadow.bind(w: a, sky: self.sky, place: self.place, asks: self.asks, lit: self.lit), vertices: 36, blend: Blend::Min, cull: Cull::Front)
        }
    }
}

/// An instrument: the eye's ray through `at` (px) of `v` against `w`, stepped as `ray::met` steps
/// it (over-relaxed, its least step a quarter of its width), each step written to `out` (12 words:
/// t, the step, the distance, then `Asked::told` at the point) until it meets matter or leaves.
@compute(1)
fn ray_traced<A: Asked>(w: A, v: View, at: vec2, out: mut Atomics<u32>, id: GlobalId) {
    let d = v.ray(at)
    let px = v.pixel()
    let b = w.begun(v.at, d, 0.0, px)
    var t = max(0.0, b.near)
    var walk = b.walk
    let inv = vec3(1.0) / d
    var steps: u32 = 0
    var crossed = false
    var relax = 1.6
    var last = 0.0
    var f_before = 1.0e9
    var before = t
    while steps < 120 && !crossed && t < b.far {
        let width = px * t
        let p = v.at + d * t
        let a = w.step(walk, p, d, inv, t, width)
        walk = a.walk
        let told = w.told(walk, p, width)
        let o = 12 * steps + 2
        out.store(i: o, value: bitcast_u32(t))
        out.store(i: o + 1, value: bitcast_u32(a.x))
        out.store(i: o + 2, value: bitcast_u32(a.y))
        out.store(i: o + 3, value: told.node)
        out.store(i: o + 4, value: told.level)
        out.store(i: o + 5, value: bitcast_u32(told.side))
        out.store(i: o + 6, value: bitcast_u32(told.off))
        out.store(i: o + 7, value: bitcast_u32(told.cells))
        out.store(i: o + 8, value: bitcast_u32(told.field))
        out.store(i: o + 9, value: bitcast_u32(told.exit))
        out.store(i: o + 10, value: told.brick)
        out.store(i: o + 11, value: bitcast_u32(width))
        steps += 1
        if a.y < 0.0 {
            crossed = true
        } else if relax > 1.0 && last > 0.0 && a.y + f_before < last {
            t = before
            relax = 1.0
            last = 0.0
            walk = b.walk
        } else {
            before = t
            f_before = a.y
            let plain = max(a.x, max(0.25 * width, 0.00001))
            last = if a.x <= a.y * 1.0001 { max(relax * a.x, plain) } else { plain }
            t += last
        }
    }
    out.store(i: 0, value: steps)
    out.store(i: 1, value: if crossed { 1 } else { 0 })
}

/// The things' ray traces (`ray_traced`), each into `out` at its own offset.
borrow struct Tracer {
    v: View,
    at: vec2,
    out: mut GpuBuffer<u32>,
}

impl Each for Tracer {
    fn thing<A: Asked>(mut self, a: A, k: u32, bound: vec4) {
        dispatch(ray_traced.bind(w: a, v: self.v, at: self.at, out: mut self.out), over: 1)
    }
}

/// Whether pixel (`x`, `y`) holds an edge (see the head of the file), by what the picture put there
/// and round it (`place`, and `asks`: a ray that met nothing but asked passed matter within its
/// width).
fn on_edge(place: Texture<Rgba32Float>, asks: Texture<Rgba32Float>, x: u32, y: u32) -> bool {
    let me = place.load(x, y)
    let met = me.w > 0.0
    if !met && asks.load(x, y).w > 0.0 {
        return true
    }
    let w = place.width()
    let h = place.height()
    var k: u32 = 0
    var edge = false
    while k < 4 {
        let nx = if k == 0 { min(x + 1, w - 1) } else if k == 1 { if x > 0 { x - 1 } else { 0 } } else { x }
        let ny = if k == 2 { min(y + 1, h - 1) } else if k == 3 { if y > 0 { y - 1 } else { 0 } } else { y }
        let o = place.load(nx, ny)
        let o_met = o.w > 0.0
        if met != o_met {
            edge = true
        } else if met && (abs(o.w - me.w) > JUMP * min(o.w, me.w) || dot(o.xyz, me.xyz) < CREASE) {
            edge = true
        }
        k += 1
    }
    edge
}

/// The edge pixels counted, a tile at a time (`tiles`, `tw` across), each pixel marked an edge
/// or not at the pixel (`at`: `EDGE_MARK` or `NO_EDGE`; `edges_found` lists the marked).
@compute(8, 8)
fn edges_counted(place: Texture<Rgba32Float>, asks: Texture<Rgba32Float>, tw: u32, tiles: mut Atomics<u32>, at: mut Atomics<u32>, id: GlobalId) {
    let w = place.width()
    if id.x >= w || id.y >= place.height() {
        return
    }
    let edge = on_edge(place, asks, id.x, id.y)
    if edge {
        let _ = tiles.add(i: (id.y / TILE) * tw + id.x / TILE, value: 1)
    }
    at.store(i: id.x + w * id.y, value: if edge { EDGE_MARK } else { NO_EDGE })
}

/// A pixel's mark that it is an edge pixel, before it is listed (`edges_counted`).
const EDGE_MARK: u32 = 4294967294

/// Where each tile's edge pixels start in the list (`tile_at`, tile `n` past the last), from the
/// tiles' counts (`tiles`): an invocation a tile, adding the counts before it (the tiles are few:
/// 2,040 at 1080p); how many are listed (`count`, at most `most`); and each tile's fill begun at
/// nothing (`fill`).
@compute(64)
fn edge_tiles_summed(tiles: [u32], n: u32, most: u32, tile_at: mut Atomics<u32>, fill: mut Atomics<u32>, count: mut Atomics<u32>, id: GlobalId) {
    let t = id.x
    if t > n {
        return
    }
    var at: u32 = 0
    for k in 0..min(t, MOST_TILES) {
        at += tiles[k]
    }
    tile_at.store(i: t, value: at)
    if t < n {
        fill.store(i: t, value: 0)
    } else {
        count.store(i: 0, value: min(at, most))
    }
}

/// The edge pixels listed tile by tile (`list`, the first `most` kept; within a tile in any order),
/// each pixel's place on it kept at the pixel (`at`, `NO_EDGE` for none).
@compute(8, 8)
fn edges_found(place: Texture<Rgba32Float>, tile_at: [u32], tw: u32, most: u32, fill: mut Atomics<u32>, tiles: mut Atomics<u32>, list: mut Atomics<u32>, at: mut Atomics<u32>, id: GlobalId) {
    let w = place.width()
    if id.x >= w || id.y >= place.height() {
        return
    }
    let pix = id.x + w * id.y
    var k = NO_EDGE
    let t = (id.y / TILE) * tw + id.x / TILE
    // (The tiles' counts left at nothing for the next frame, by each tile's first pixel.)
    if id.x % TILE == 0 && id.y % TILE == 0 {
        tiles.store(i: t, value: 0)
    }
    if at.load(i: pix) == EDGE_MARK {
        let i = tile_at[t] + fill.add(i: t, value: 1)
        if i < most {
            list.store(i: i, value: pix)
            k = i
        }
    }
    at.store(i: pix, value: k)
}

/// The most tiles a screen has (the most passes a loop the host can bound takes: 1080p has 2,040).
const MOST_TILES: u32 = 4096

/// The picture: an edge pixel the mean of its rays, any other what its middle ray drew (`raw`);
/// drawing `steps` 1 (the instrument) every pixel as drawn, `steps` 2 its edge pixels red.
@compute(8, 8)
fn edges_resolved(raw: Texture<Rgba16Float>, at: [u32], rays: Texture<Rgba16Float>, steps: u32, out: mut Texels<Rgba16Float>, id: GlobalId) {
    let w = raw.width()
    if id.x >= w || id.y >= raw.height() {
        return
    }
    let k = at[id.x + w * id.y]
    if k == NO_EDGE || steps == 1 {
        out.store(id, raw.load(id.x, id.y))
    } else if steps == 2 {
        out.store(id, vec4(1.0, 0.0, 0.0, 1.0))
    } else {
        let n = EDGE_LOOKS * EDGE_LOOKS
        var sum = vec3(0.0)
        var j: u32 = 0
        while j < n {
            let r = n * k + j
            sum += rays.load(r % w, r / w).xyz
            j += 1
        }
        out.store(id, vec4(sum / f32(n), 1.0))
    }
}

/// A load beside the frame while it is timed, so the M4 keeps its clock up (branch `backend`'s
/// lib/frame/load.wrela, `burn`): `rounds` sines a pixel, drawn into a target nothing reads.
@fragment
pub fn burn(pixel: FragCoord, rounds: u32) -> vec4 {
    var x = pixel.position.x * 0.001 + pixel.position.y * 0.002
    var i: u32 = 0
    while i < 4096 && i < rounds {
        x = sin(x * 1.7 + 0.3) + cos(x * 0.9)
        i += 1
    }
    vec4(x, 0.0, 0.0, 1.0)
}

/// What the engine keeps from frame to frame to draw a world: each thing's cells, the sky's
/// table, the picture and what it asked of matter, and the load beside the frame.
pub struct Sight {
    kept: Vec<Kept>,
    s: Sampler,
    table: Texture<Rgba16Float>,
    pub drawn: Picture,
    asks: Texture<Rgba32Float>,
    /// The picture before the edge pass (`drawn.colour` after it), and the edge pass's list, each
    /// pixel's place on it, and the edge rays' colours.
    raw: Texture<Rgba16Float>,
    edge_list: GpuBuffer<u32>,
    edge_count: GpuBuffer<u32>,
    edge_tiles: GpuBuffer<u32>,
    edge_tile_at: GpuBuffer<u32>,
    edge_fill: GpuBuffer<u32>,
    edge_at: GpuBuffer<u32>,
    edge_rays: Texture<Rgba16Float>,
    /// What the eye draws hand the shade pass (the sun's light if its ray finds it, the open
    /// sky's factor, what is given off), the depth that joins things, whether the sun's ray found
    /// the sun; and the edge pass's own places and asks.
    lit: Texture<Rgba16Float>,
    open: Texture<Rgba16Float>,
    emits: Texture<Rgba16Float>,
    depth: DepthTexture,
    sunny: Texture<R8>,
    edge_place: Texture<Rgba32Float>,
    edge_asks: Texture<Rgba32Float>,
    burned: Texture<R8>,
    trace_out: GpuBuffer<u32>,
    trace_read: Option<Pending<u32>>,
    /// The load beside each frame (sines a pixel; 0: none).
    pub load: u32,
    held_asks: u32,
    held_cell: f32,
    held_whole: u32,
    said: bool,
    /// An instrument: the picture shows each pixel's steps instead of its colour (1), or its edge
    /// pixels red (2).
    pub steps: u32,
    /// How many bands the picture is drawn in (`BAND_US`), and its time asked for.
    bands: u32,
    sizing: Option<Pending<f32>>,
    /// Which of `BANDED` is being timed, and each one's last time (us).
    timing: u32,
    spent: [f32; 4],
    all_timed: bool,
}

/// The engine's sight, as yet of nothing.
pub fn sight() -> Sight {
    Sight {
        kept: Vec::new(),
        s: sampler(address: Address::Clamp),
        table: writable_texture(width: TABLE, height: TABLE),
        drawn: picture(width: 1, height: 1),
        asks: texture(width: 1, height: 1),
        raw: texture(width: 1, height: 1),
        edge_list: buffer(1),
        edge_count: buffer(1),
        edge_tiles: buffer(1),
        edge_tile_at: buffer(2),
        edge_fill: buffer(1),
        edge_at: buffer(1),
        edge_rays: texture(width: 1, height: 1),
        lit: texture(width: 1, height: 1),
        open: texture(width: 1, height: 1),
        emits: texture(width: 1, height: 1),
        depth: depth_texture(width: 1, height: 1),
        sunny: texture(width: 1, height: 1),
        edge_place: texture(width: 1, height: 1),
        edge_asks: texture(width: 1, height: 1),
        burned: texture(width: 1, height: 1),
        trace_out: buffer(1),
        trace_read: None,
        load: 0,
        held_asks: 0,
        held_cell: 0.0,
        held_whole: 0,
        said: false,
        steps: 0,
        bands: FIRST_BANDS,
        sizing: None,
        timing: 0,
        spent: [0.0; 4],
        all_timed: false,
    }
}

/// An instrument, not an author's: the engine's sight with its own choices held, to measure them
/// (`asks`: 0 its own, 1 every root answered by its field, 2 a still thing's by its cells; `cell`: 0 its own size, or
/// a cell's side in m; `whole` 1: every root asks its whole field, never a mask).
pub fn sight_held(asks: u32, cell: f32, whole: u32) -> Sight {
    var s = sight()
    s.held_asks = asks
    s.held_cell = cell
    s.held_whole = whole
    s
}

impl Sight {
    /// Whether every thing's cells are ready and the picture drawn.
    /// Where the world's matter can be: the box round its things' bounds (least and greatest
    /// corners; none: the greatest under the least).
    fn world_box(self) -> (vec3, vec3) {
        var lo = vec3(1.0e30)
        var hi = vec3(-1.0e30)
        for i in 0..self.kept.len() {
            let b = self.kept[i].derived()
            lo = min(lo, b.xyz - vec3(b.w))
            hi = max(hi, b.xyz + vec3(b.w))
        }
        (lo, hi)
    }

    pub fn settled(self) -> bool {
        self.drawn.placed
    }

    /// The bytes every thing's cells hold, and their room.
    pub fn bytes(self) -> (f32, f32) {
        var used = 0.0
        var room = 0.0
        for k in self.kept {
            let (u, r) = k.bytes()
            used += u
            room += r
        }
        (used, room)
    }

    /// The picture's bands sized for the banded passes' last times (`spent`): the dearest.
    fn banded(mut self) {
        var us = 0.0
        for i in 0..4 {
            us = max(us, self.spent[i])
        }
        self.bands = u32(clamp(ceil(us / BAND_US), f32(LEAST_BANDS), f32(MOST_BANDS)))
    }

    /// `world` under `sky` in `look` through `eye`, on a `width` × `height` screen: its cells
    /// brought up to date, every pixel drawn into `drawn`, and shown. Until every thing's cells
    /// are ready, the screen is black.
    pub fn draw<W: World, S: Sky, L: Look>(mut self, world: W, sky: S, look: L, eye: Eye, width: u32, height: u32) {
        self.drawn_only(world, sky, look, eye, width, height)
        if self.drawn.placed {
            show(self.drawn.colour)
        } else {
            label("shown")
            let screen = begin_screen_pass(clear: vec4(0.0, 0.0, 0.0, 1.0))
            screen.present()
        }
    }

    /// The eye draws, the shadow draws and the shade pass, the fragments laid out as `lay` says,
    /// into the picture's targets (`edge` false) or the edge pass's (`edge` true), in `bands`
    /// bands of rows.
    fn lit_by<W: World, S: Sky, L: Look>(mut self, world: W, sky: S, look: L, v: View, lay: Lay, bands: u32, width: u32, height: u32, edge: bool) {
        label(if edge { "edge rays" } else { "picture" })
        var band: u32 = 0
        while band < bands {
            let y0 = band * height / bands
            let y1 = (band + 1) * height / bands
            band += 1
            if edge {
                let p = begin_pass5_with_depth(mut self.edge_place, mut self.edge_asks, mut self.lit, mut self.open, mut self.emits, mut self.depth, clear: vec4(0.0), keep: band > 1, keep_depth: band > 1)
                var e = Eyes { pass: p, v, sky, lay, list: self.edge_list.items(), count: self.edge_count.items(), y0, y1, width, height, tile_at: self.edge_tile_at.items(), most: width * height / EDGE_SHARE }
                world.each(self.kept, 0, mut e)
                e.pass.end()
            } else {
                let p = begin_pass5_with_depth(mut self.drawn.place, mut self.asks, mut self.lit, mut self.open, mut self.emits, mut self.depth, clear: vec4(0.0), keep: band > 1, keep_depth: band > 1)
                var e = Eyes { pass: p, v, sky, lay, list: self.edge_list.items(), count: self.edge_count.items(), y0, y1, width, height, tile_at: self.edge_tile_at.items(), most: width * height / EDGE_SHARE }
                world.each(self.kept, 0, mut e)
                e.pass.end()
            }
        }
        label(if edge { "edge shadows" } else { "shadows" })
        let (reach_lo, reach_hi) = self.world_box()
        band = 0
        while band < bands {
            let y0 = band * height / bands
            let y1 = (band + 1) * height / bands
            band += 1
            let p = begin_pass(mut self.sunny, clear: vec4(1.0), keep: band > 1)
            if edge {
                var e = Shadows { pass: p, sky, place: self.edge_place, asks: self.edge_asks, lit: self.lit, y0, y1, width, v, edge: true, world_lo: reach_lo, world_hi: reach_hi, tile_at: self.edge_tile_at.items(), most: width * height / EDGE_SHARE, height }
                world.each(self.kept, 0, mut e)
                e.pass.end()
            } else {
                var e = Shadows { pass: p, sky, place: self.drawn.place, asks: self.asks, lit: self.lit, y0, y1, width, v, edge: false, world_lo: reach_lo, world_hi: reach_hi, tile_at: self.edge_tile_at.items(), most: width * height / EDGE_SHARE, height }
                world.each(self.kept, 0, mut e)
                e.pass.end()
            }
        }
        label(if edge { "edge shade" } else { "shade" })
        if edge {
            let p = begin_pass(mut self.edge_rays)
            let tt = tiles_of(width, height)
            draw(p, rays_tiles.bind(tile_at: self.edge_tile_at.items(), tx0: 0, tx1: tt.x - 1, ty0: 0, tw: tt.x, most: width * height / EDGE_SHARE, width: width, height: height, z: 0.5), shade.bind(v: v, sky: sky, look: look, table: self.table, s: self.s, place: self.edge_place, lit: self.lit, open: self.open, emits: self.emits, sunny: self.sunny, lay: lay, list: self.edge_list.items(), count: self.edge_count.items()), vertices: 18, instances: tt.y)
            p.end()
        } else {
            let p = begin_pass(mut self.raw)
            draw(p, cover, shade.bind(v: v, sky: sky, look: look, table: self.table, s: self.s, place: self.drawn.place, lit: self.lit, open: self.open, emits: self.emits, sunny: self.sunny, lay: lay, list: self.edge_list.items(), count: self.edge_count.items()), vertices: 3)
            p.end()
        }
    }

    /// An instrument: the eye's ray through pixel (`x`, `y`) traced through each thing
    /// (`ray_traced`), asked for; `traced_said` prints it once it is back.
    pub fn trace<W: World>(mut self, world: W, eye: Eye, width: u32, height: u32, x: u32, y: u32) {
        let v = view(eye, width, height)
        self.trace_out = buffer_of(Vec::filled(2 + 12 * 120, 0))
        var e = Tracer { v, at: vec2(f32(x) + 0.5, f32(y) + 0.5), out: mut self.trace_out }
        world.each(self.kept, 0, mut e)
        self.trace_read = Some(read(self.trace_out.items()))
    }

    /// Prints the trace asked for (`trace`) once it is back: true then.
    pub fn traced_said(mut self) -> bool {
        match mut self.trace_read {
            Some(r) => match r.poll() {
                Some(Ok(w)) => {
                    print(f"trace: {w[0]} steps, met {w[1]}")
                    var i: u32 = 0
                    while i < w[0] {
                        let o = 12 * i + 2
                        print(f"trace: t {bitcast_f32(w[o])} step {bitcast_f32(w[o + 1])} far {bitcast_f32(w[o + 2])} | node {w[o + 3]} brick {w[o + 10]} level {w[o + 4]} side {bitcast_f32(w[o + 5])} err {bitcast_f32(w[o + 6])} cells {bitcast_f32(w[o + 7])} field {bitcast_f32(w[o + 8])} | walk ends {bitcast_f32(w[o + 9])} width {bitcast_f32(w[o + 11])}")
                        i += 1
                    }
                    self.trace_read = None
                    return true
                },
                _ => {},
            },
            None => {},
        }
        false
    }

    /// The same, into `drawn` only (nothing shown): `drawn.placed` once drawn.
    pub fn drawn_only<W: World, S: Sky, L: Look>(mut self, world: W, sky: S, look: L, eye: Eye, width: u32, height: u32) {
        let v = view(eye, width, height)
        if self.load > 0 {
            if self.burned.width() != width || self.burned.height() != height {
                self.burned = texture(width: width, height: height)
            }
            label("load")
            let b = begin_pass(mut self.burned, clear: vec4(0.0))
            draw(b, cover, burn.bind(rounds: self.load), vertices: 3)
            b.end()
        }
        while self.kept.len() < world.count() {
            var k = kept()
            k.held_asks = self.held_asks
            k.held_cell = self.held_cell
            k.held_whole = self.held_whole
            self.kept.push(take k)
        }
        // How finely each thing is asked at the most: a pixel's footprint where its bound comes
        // nearest the eye (what the picture knows; matter is told only the size).
        // (Where each thing can be, as matter derived it last frame: none yet, a metre off.)
        var sizes: Vec<f32> = Vec::filled(world.count(), 0.0)
        var i: u32 = 0
        while i < world.count() {
            let b = self.kept[i].derived()
            sizes[i] = v.pixel() * (if b.w > 0.0 { max(length(b.xyz - v.at) - b.w, 0.05) } else { 1.0 })
            i += 1
        }
        world.kept(mut self.kept, 0, sizes)
        if !world.ready(self.kept, 0) {
            self.drawn.placed = false
            return
        }
        if !self.said {
            self.said = true
            print("picture: ready")
        }
        if self.drawn.width() != width || self.drawn.height() != height {
            self.drawn = picture(width: width, height: height)
            self.drawn.colour = writable_texture(width: width, height: height)
            self.asks = texture(width: width, height: height)
            self.raw = texture(width: width, height: height)
            let most = width * height / EDGE_SHARE
            self.edge_list = buffer(most)
            self.edge_count = buffer(1)
            let tt = tiles_of(width, height)
            self.edge_tiles = buffer(tt.x * tt.y)
            self.edge_tile_at = buffer(tt.x * tt.y + 1)
            self.edge_fill = buffer(tt.x * tt.y)
            self.edge_at = buffer(width * height)
            self.edge_rays = texture(width: width, height: height)
            self.lit = texture(width: width, height: height)
            self.open = texture(width: width, height: height)
            self.emits = texture(width: width, height: height)
            self.depth = depth_texture(width: width, height: height)
            self.sunny = texture(width: width, height: height)
            self.edge_place = texture(width: width, height: height)
            self.edge_asks = texture(width: width, height: height)
        }
        match mut self.sizing {
            Some(p) => match p.poll() {
                Some(Ok(us)) => {
                    // (Each in turn; bands from the dearest once all have been timed: till then
                    // `FIRST_BANDS`.)
                    self.spent[self.timing] = us[0]
                    self.timing = (self.timing + 1) % 4
                    if self.timing == 0 {
                        self.all_timed = true
                    }
                    if self.all_timed {
                        self.banded()
                    }
                    self.sizing = None
                },
                _ => {},
            },
            None => {
                self.sizing = Some(timed(if self.timing == 0 { "picture" } else if self.timing == 1 { "shadows" } else if self.timing == 2 { "edge rays" } else { "edge shadows" }))
            },
        }
        label("sky table")
        dispatch(skylit.bind(sky: sky, out: mut self.table), groups: ((TABLE + 7) / 8, (TABLE + 7) / 8, 1))
        let bands = self.bands
        // The picture: each thing's eye draw, each thing's shadow draw, the shade.
        let screen = Lay { edges: 0, width, spare: 0, spare2: 0 }
        self.lit_by(world, sky, look, v, screen, bands, width, height, edge: false)
        label("edges")
        // (Listed tile by tile, so a thing's edge draws cover only its rectangle's tiles' rays.)
        let most = width * height / EDGE_SHARE
        let groups = ((width + 7) / 8, (height + 7) / 8, 1)
        let nt = tiles_of(width, height).x * tiles_of(width, height).y
        dispatch(edges_counted.bind(place: self.drawn.place, asks: self.asks, tw: tiles_of(width, height).x, tiles: mut self.edge_tiles, at: mut self.edge_at), groups: groups)
        dispatch(edge_tiles_summed.bind(tiles: self.edge_tiles.items(), n: nt, most: most, tile_at: mut self.edge_tile_at, fill: mut self.edge_fill, count: mut self.edge_count), over: nt + 1)
        dispatch(edges_found.bind(place: self.drawn.place, tile_at: self.edge_tile_at.items(), tw: tiles_of(width, height).x, most: most, fill: mut self.edge_fill, tiles: mut self.edge_tiles, list: mut self.edge_list, at: mut self.edge_at), groups: groups)
        // (The edge rays the same three, laid out a ray a fragment.)
        let rays = Lay { edges: 1, width, spare: 0, spare2: 0 }
        self.lit_by(world, sky, look, v, rays, bands, width, height, edge: true)
        label("edges resolved")
        dispatch(
            edges_resolved.bind(raw: self.raw, at: self.edge_at.items(), rays: self.edge_rays, steps: self.steps, out: mut self.drawn.colour),
            groups: ((width + 7) / 8, (height + 7) / 8, 1),
        )
        self.drawn.placed = true
        // Matter refines its cells where this picture asked finer than they hold.
        world.refine(mut self.kept, 0, self.asks, self.drawn.place)
    }
}
