// The picture, as slice 1 draws it (docs/design.md, "Order of work", 1): every pixel by one ray
// through its middle (`ray::met`), then light, then the look. No scouts, no blocks yet.
//
// The picture tells matter how finely it asks: every ask names the ray's width there (its
// footprint, m), and after each frame matter is handed the places the picture showed and the size
// each was asked at (`asks`), to refine its cells where they were coarser than that. Matter never
// sees the eye: only places and sizes.
//
// A pixel is the mean of what the look shows over it, so where an edge crosses a pixel its colour
// is shared between the two sides by how much of it each covers, and that share must change
// smoothly as the edge moves across. One ray a pixel says where each side is, from distances it
// already has (`covered`): how far its neighbour's ray passed the surface that ends there (the
// ray's own `Met::nearest`, kept in the colour's alpha, px), turned onto the screen by which way
// the surface faces; or, at a crease, where the two faces' planes meet between the two pixels.
// Each side's colour is its own pixel's. Only where two edges cross one pixel (a part thinner than
// a pixel, a gap narrower than one) does that not hold: those pixels alone (`edges_found`) are drawn
// again as the mean of `EDGE_LOOKS`² rays spread evenly over each, the same `shown`, a ray a
// fragment, so a few of them don't hold up the many round them.
//
// The light here is a stand-in, the simplest that can be held to the reference exactly (the
// reference's `SIMPLE` light): the sun where a shadow ray (the same `ray::met`) says it reaches,
// toward the middle of its disc; and the sky's light as if nothing were in its way, read from a
// table of what the open sky lays on a face turned each way (`skylit`). The light module (slice 2)
// replaces it whole: nothing outside this file knows how a pixel is lit.

use matter::asked::{Answers, Asked, Chosen}
use matter::cells::{ASKS_CELLS, Kept, kept}
use matter::sky::{Sky, seen}
use matter::world::World
use picture::eye::{Eye, View, view}
use picture::look::{Look, Seen}
use picture::picture::{Picture, picture}
use picture::screen::{cover, show}
use ray::ray::{Met, Ray, met}
use reference::traced::LEAVE
use std::collections::Vec
use std::gpu::{
    Address, Append, AppendBuffer, Atomics, FragCoord, GlobalId, GpuBuffer, GpuSpan, R8, Rgba16Float, Rgba32Float, Sampler, Targets3, Texels,
    Texture, append_buffer, begin_pass, begin_pass3, begin_screen_pass, buffer, dispatch, draw, label, sampler, texture, timed,
    writable_texture,
}
use std::io::{Pending, print}

/// The picture is drawn in passes, each a band of the screen's rows, as many as keep a pass near
/// `BAND_US` by the picture's last time (no pass may hold the GPU long: AGENTS.md; the timing only
/// cuts the work in parts, it never changes what is drawn): at first `FIRST_BANDS` (the stack
/// asked by its field took 58 ms a quarter of the screen at 1080p on the M4), and between
/// `LEAST_BANDS` and `MOST_BANDS`.
const BAND_US: f32 = 10000.0
const FIRST_BANDS: u32 = 32
const LEAST_BANDS: u32 = 4
const MOST_BANDS: u32 = 128

/// A pixel's rays a side where two edges cross it.
const EDGE_LOOKS: u32 = 3

/// No edge at a pixel; one in how many of a picture's pixels may be an edge (the rest drawn by
/// their middle ray alone): the edge rays fill a picture the screen's size.
const NO_EDGE: u32 = 4294967295
const EDGE_SHARE: u32 = 16

/// The sky table's texels a side (an octahedron's fold of every way a face can turn), and how
/// many ways each texel's light is gathered from (a side of a square of them, cosine-spread).
const TABLE: u32 = 32
const GATHER: u32 = 24

/// A unit vector folded onto an octahedron, as two numbers from -1 to 1, and back.
pub fn octa(n: vec3) -> vec2 {
    let a = n / (abs(n.x) + abs(n.y) + abs(n.z))
    if a.y >= 0.0 {
        return a.xz
    }
    (vec2(1.0) - abs(vec2(a.z, a.x))) * vec2(if a.x >= 0.0 { 1.0 } else { -1.0 }, if a.z >= 0.0 { 1.0 } else { -1.0 })
}

pub fn unocta(e: vec2) -> vec3 {
    var v = vec3(e.x, 1.0 - abs(e.x) - abs(e.y), e.y)
    let t = max(-v.y, 0.0)
    v.x += if v.x >= 0.0 { -t } else { t }
    v.z += if v.z >= 0.0 { -t } else { t }
    normalize(v)
}

/// The open sky's light on a face turned the way texel `id` stands for (irradiance): gathered
/// from `GATHER`² ways over its hemisphere, cosine-spread, evenly over the square.
@compute(8, 8)
pub fn skylit<S: Sky>(sky: S, out: mut Texels<Rgba16Float>, id: GlobalId) {
    if id.x >= TABLE || id.y >= TABLE {
        return
    }
    let n = unocta((vec2(f32(id.x), f32(id.y)) + vec2(0.5)) / f32(TABLE) * 2.0 - vec2(1.0))
    let s = if n.z >= 0.0 { 1.0 } else { -1.0 }
    let a = -1.0 / (s + n.z)
    let b = n.x * n.y * a
    let u = vec3(1.0 + s * n.x * n.x * a, s * b, -s * n.x)
    let v = vec3(b, s + n.y * n.y * a, -n.y)
    var sum = vec3(0.0)
    var i: u32 = 0
    while i < GATHER * GATHER {
        let e = (vec2(f32(i % GATHER), f32(i / GATHER)) + vec2(0.5)) / f32(GATHER)
        let c = sqrt(1.0 - e.x)
        let r = sqrt(max(1.0 - c * c, 0.0))
        let turn = 6.2831853 * e.y
        sum += sky.light(normalize(u * (r * cos(turn)) + v * (r * sin(turn)) + n * c))
        i += 1
    }
    out.store(id, vec4(sum * (3.14159265 / f32(GATHER * GATHER)), 1.0))
}

/// The open sky's light on a face turned `n`, from the table.
fn sky_on(table: Texture<Rgba16Float>, s: Sampler, n: vec3) -> vec3 {
    let e = octa(n) * 0.5 + vec2(0.5)
    table.sample_level(s, (e * (f32(TABLE) - 1.0) + vec2(0.5)) / f32(TABLE), 0.0).xyz
}

/// What one ray through a pixel shows (`at`: the point on the screen, px), lit by the stand-in
/// light and toned: the look's colour (`colour`), the facing and distance of what it met
/// (`place`: 0 where the sky), and the place it shows with the size it was asked at (`ask`: `w`
/// 0 where nothing).
pub struct Shown: Copy {
    pub colour: vec3,
    pub place: vec4,
    pub ask: vec4,
    pub pass: f32,
    pub steps: u32,
}

/// One ray through `at` (px) of `v`, as `pixel` shows it.
pub fn shown<W: Asked, S: Sky, L: Look>(v: View, w: W, sky: S, look: L, table: Texture<Rgba16Float>, s: Sampler, at: vec2) -> Shown {
    let d = v.ray(at)
    let px = v.pixel()
    let m = met(w, Ray { o: v.at, d, from: 0.0, to: 1.0e9, wide: 0.0, spread: px })
    if !m.met {
        // (A ray that passed matter within half its width, so that matter is within its pixel,
        // asks there too: an outline needs it, and the edge pass reads it as an edge.)
        var ask = vec4(0.0)
        if m.nearest < 0.5 {
            ask = vec4(v.at + d * m.nearest_t, px * m.nearest_t)
        }
        return Shown { colour: look.tone(Seen { light: seen(sky, d) }), place: vec4(0.0), ask, pass: min(m.nearest, 64.0), steps: m.steps }
    }
    let p = v.at + d * m.t
    let size = px * m.t
    let n = w.facing(p, -d, size)
    let stuff = w.made_of(p)
    let sun = sky.sun()
    var light = stuff.emits
    let lean = dot(n, sun.way)
    var steps = m.steps
    if lean > 0.0 {
        let o = p + n * LEAVE
        let shadow = met(w, Ray { o, d: sun.way, from: 0.0, to: 1.0e9, wide: size, spread: 0.0 })
        steps += shadow.steps * 65536
        if !shadow.met {
            light += stuff.scatters(n, sun.way, -d) * sun.light * lean
        }
    }
    light += stuff.scatters(n, n, -d) * sky_on(table, s, n)
    Shown { colour: look.tone(Seen { light }), place: vec4(n, m.t), ask: vec4(p, size), pass: min(m.nearest, 64.0), steps }
}

/// A pixel: its middle ray (`shown`). Into the first target, the look's colour and how nearly the
/// ray passed matter it didn't meet (alpha, px) (or, as an instrument, `steps` 1: the eye's ray's
/// steps in red and its shadow ray's in green, 64 to full);
/// into the second, which way the surface it shows faces and how far along the ray (0: the sky);
/// into the third, the place it shows and the size it was asked at (for matter's refining).
@fragment
pub fn pixel<W: Asked, S: Sky, L: Look>(pixel: FragCoord, v: View, w: W, sky: S, look: L, table: Texture<Rgba16Float>, s: Sampler, steps: u32) -> Targets3<vec4, vec4, vec4> {
    let r = shown(v, w, sky, look, table, s, pixel.position.xy)
    if steps == 1 {
        return Targets3 { first: vec4(f32(r.steps % 65536) / 64.0, f32(r.steps / 65536) / 64.0, 0.0, 1.0), second: r.place, third: r.ask }
    }
    Targets3 { first: vec4(r.colour, r.pass), second: r.place, third: r.ask }
}

/// What the first pass saw at pixel (`x`, `y`): whether its ray met matter, its colour and how
/// nearly it passed matter it didn't meet (px), and the facing and distance of what it met.
struct Saw: Copy {
    met: bool,
    colour: vec3,
    pass: f32,
    n: vec3,
    t: f32,
}

fn saw(raw: Texture<Rgba16Float>, place: Texture<Rgba32Float>, x: u32, y: u32) -> Saw {
    let c = raw.load(x, y)
    let q = place.load(x, y)
    Saw { met: q.w > 0.0, colour: c.xyz, pass: c.w, n: q.xyz, t: q.w }
}

/// Pixel (`x`, `y`)'s neighbour `k` (0 right, 1 left, 2 down, 3 up) and its offset (px); the pixel
/// itself where the screen ends.
fn neighbour(x: u32, y: u32, w: u32, h: u32, k: u32) -> vec4 {
    let nx = if k == 0 { min(x + 1, w - 1) } else if k == 1 { if x > 0 { x - 1 } else { 0 } } else { x }
    let ny = if k == 2 { min(y + 1, h - 1) } else if k == 3 { if y > 0 { y - 1 } else { 0 } } else { y }
    vec4(f32(nx), f32(ny), f32(nx) - f32(x), f32(ny) - f32(y))
}

/// Which way the outline of the surface a pixel met faces on the screen (unit; 0 where its facing
/// is straight at the eye): its facing at `p`, seen through `v`, `t` m along its ray.
fn outward(v: View, p: vec3, n: vec3, t: f32) -> vec2 {
    let e = v.pixel_of(p + n * (v.pixel() * t)) - v.pixel_of(p)
    if dot(e, e) > 1.0e-12 { normalize(e) } else { vec2(0.0) }
}

/// Whether two edges cross pixel (`x`, `y`), so its neighbours can't say how it is shared: its
/// own surface ends both before and behind it across its outline (a part thinner than a pixel),
/// or beside it where no outline faces; it met nothing, passed matter under half a pixel, and no
/// neighbour met that matter, or neighbours each side did (a gap); or a neighbour across an
/// outline from it passed nothing to say where the outline is.
fn crossed_twice(raw: Texture<Rgba16Float>, place: Texture<Rgba32Float>, v: View, x: u32, y: u32) -> bool {
    let w = place.width()
    let h = place.height()
    let me = saw(raw, place, x, y)
    let out = if me.met { outward(v, v.at + v.ray(vec2(f32(x), f32(y)) + vec2(0.5)) * me.t, me.n, me.t) } else { vec2(0.0) }
    var met = [false; 4]
    var any = false
    var before = false
    var behind = false
    var unsaid = false
    var k: u32 = 0
    while k < 4 {
        let o = neighbour(x, y, w, h, k)
        let q = saw(raw, place, u32(o.x), u32(o.y))
        met[k] = q.met
        any = any || q.met
        if me.met && (!q.met || (q.t > me.t && q.pass < 1.5)) {
            // Its own surface ends toward this neighbour.
            let along = dot(o.zw, out)
            if along > 0.25 {
                before = true
                unsaid = unsaid || q.pass >= 1.5
            } else {
                behind = true
            }
        }
        k += 1
    }
    if me.met {
        return (before && behind) || unsaid
    }
    if me.pass < 0.5 && !any {
        return true
    }
    me.pass < 0.5 && ((met[0] && met[1]) || (met[2] && met[3]))
}

/// The pixels where two edges cross (`crossed_twice`), each pushed on `list` (the first `most`
/// kept), its place on the list kept at the pixel (`at`, `NO_EDGE` for none).
@compute(8, 8)
fn edges_found(raw: Texture<Rgba16Float>, place: Texture<Rgba32Float>, v: View, most: u32, list: mut Append<u32>, at: mut Atomics<u32>, id: GlobalId) {
    let w = place.width()
    if id.x >= w || id.y >= place.height() {
        return
    }
    let pix = id.x + w * id.y
    var k = NO_EDGE
    if crossed_twice(raw, place, v, id.x, id.y) {
        let i = list.push(pix)
        if i < most {
            k = i
        }
    }
    at.store(i: pix, value: k)
}

/// Where between pixel `a` and its neighbour `a + o` (px) the plane through `pa` facing `na` and
/// the one through `pb` facing `nb` are met at the same distance along the ray (as a share of the
/// way, 0 at `a`), seen through `v`; -1 where they aren't between the two.
fn crease(v: View, a: vec2, o: vec2, pa: vec3, na: vec3, pb: vec3, nb: vec3) -> f32 {
    let ha = dot(pa - v.at, na)
    let hb = dot(pb - v.at, nb)
    var lo = 0.0
    var hi = 1.0
    let d0 = v.ray(a)
    let d1 = v.ray(a + o)
    let g0 = ha / dot(d0, na) - hb / dot(d0, nb)
    let g1 = ha / dot(d1, na) - hb / dot(d1, nb)
    if !(g0 * g1 < 0.0) {
        return -1.0
    }
    // (Nearly a line across one pixel: where the line through the two ends crosses 0, and once
    // more from there.)
    var glo = g0
    var ghi = g1
    var k: u32 = 0
    while k < 3 {
        let m = clamp(lo + (hi - lo) * glo / (glo - ghi), lo, hi)
        let d = v.ray(a + o * m)
        let g = ha / dot(d, na) - hb / dot(d, nb)
        if (g < 0.0) == (glo < 0.0) {
            lo = m
            glo = g
        } else {
            hi = m
            ghi = g
        }
        k += 1
    }
    lo + (hi - lo) * glo / (glo - ghi)
}

/// Pixel (`x`, `y`)'s colour where one edge crosses it: its own colour over the share of it its
/// own side covers, its neighbour's over the rest, the share from distances alone (see the head of
/// the file): of the four neighbours, the one that leaves it the least.
fn covered(raw: Texture<Rgba16Float>, place: Texture<Rgba32Float>, v: View, x: u32, y: u32) -> vec3 {
    let w = place.width()
    let h = place.height()
    let me = saw(raw, place, x, y)
    // (Where no neighbour's colour differs from its own by a level of 255, sharing it changes
    // nothing that shows.)
    var differs = false
    var j: u32 = 0
    while j < 4 {
        let o = neighbour(x, y, w, h, j)
        let c = raw.load(u32(o.x), u32(o.y)).xyz - me.colour
        differs = differs || max(abs(c.x), max(abs(c.y), abs(c.z))) > 1.0 / 255.0
        j += 1
    }
    if !differs {
        return me.colour
    }
    let at = vec2(f32(x), f32(y)) + vec2(0.5)
    let d = v.ray(at)
    let p = v.at + d * me.t
    // Which way the edge of its own surface faces on the screen: its facing, seen.
    let out = if me.met { outward(v, p, me.n, me.t) } else { vec2(0.0) }
    var keep = 1.0
    var other = me.colour
    var k: u32 = 0
    while k < 4 {
        let o = neighbour(x, y, w, h, k)
        let q = saw(raw, place, u32(o.x), u32(o.y))
        var c = 1.0
        if me.met && (!q.met || (q.t > me.t && q.pass < 1.5)) {
            // Its own surface ends between them: the outline is the neighbour's pass from the
            // neighbour, and this pixel that less the neighbour's way along the outline's normal.
            let along = dot(o.zw, out)
            if along > 0.25 && q.pass < 1.5 {
                c = clamp(0.5 - (q.pass - along), 0.0, 1.0)
            }
        } else if q.met && (!me.met || (me.t > q.t && me.pass < 1.5)) {
            // A nearer surface ends here, passed this near by this pixel's ray.
            c = clamp(0.5 + me.pass, 0.0, 1.0)
        } else if me.met && q.met && dot(me.n, q.n) < 0.99999 {
            // A crease: where the two faces' planes meet.
            let u = crease(v, at, o.zw, p, me.n, v.at + v.ray(at + o.zw) * q.t, q.n)
            if u >= 0.0 {
                c = clamp(u + 0.5, 0.0, 1.0)
            }
        }
        if c < keep {
            keep = c
            other = q.colour
        }
        k += 1
    }
    me.colour * keep + other * (1.0 - keep)
}

/// One of the edge pixels' rays (ray `j` of edge pixel `e` is `EDGE_LOOKS² e + j`, drawn at pixel
/// `j % width`, `j / width` of `rays`): its colour, one of `EDGE_LOOKS`² rays spread evenly over its
/// pixel (`shown`). Drawn as a picture of its own so that every ray is a fragment's whole work, a
/// few edge pixels not holding up the many round them.
@fragment
pub fn edge_ray<W: Asked, S: Sky, L: Look>(
    pixel: FragCoord,
    v: View,
    w: W,
    sky: S,
    look: L,
    table: Texture<Rgba16Float>,
    s: Sampler,
    list: GpuSpan<u32>,
    count: GpuSpan<u32>,
    width: u32,
) -> vec4 {
    let i = u32(pixel.position.x) + width * u32(pixel.position.y)
    let n = EDGE_LOOKS * EDGE_LOOKS
    let e = i / n
    if e >= count[0] {
        return vec4(0.0)
    }
    let pix = list[e]
    let j = i % n
    let o = (vec2(f32(j % EDGE_LOOKS), f32(j / EDGE_LOOKS)) + vec2(0.5)) / f32(EDGE_LOOKS)
    vec4(shown(v, w, sky, look, table, s, vec2(f32(pix % width), f32(pix / width)) + o).colour, 1.0)
}

/// The picture: a pixel two edges cross the mean of its rays, any other its colour as one edge
/// shares it (`covered`); drawing `steps` 1 (the instrument) every pixel as drawn, `steps` 2 the
/// pixels drawn by rays red and those an edge shares blue.
@compute(8, 8)
fn edges_resolved(raw: Texture<Rgba16Float>, place: Texture<Rgba32Float>, v: View, at: [u32], rays: Texture<Rgba16Float>, steps: u32, out: mut Texels<Rgba16Float>, id: GlobalId) {
    let w = raw.width()
    if id.x >= w || id.y >= raw.height() {
        return
    }
    let k = at[id.x + w * id.y]
    if steps == 1 {
        out.store(id, vec4(raw.load(id.x, id.y).xyz, 1.0))
    } else if steps == 3 {
        let q = place.load(id.x, id.y)
        out.store(id, vec4(vec3(clamp(raw.load(id.x, id.y).w / 2.0, 0.0, 1.0)), 1.0) * (if q.w > 0.0 { vec4(1.0, 0.6, 0.6, 1.0) } else { vec4(0.6, 0.6, 1.0, 1.0) }))
    } else if k == NO_EDGE {
        let c = covered(raw, place, v, id.x, id.y)
        if steps == 2 && length(c - raw.load(id.x, id.y).xyz) > 0.001 {
            out.store(id, vec4(0.0, 0.0, 1.0, 1.0))
        } else {
            out.store(id, vec4(c, 1.0))
        }
    } else if steps == 2 {
        out.store(id, vec4(1.0, 0.0, 0.0, 1.0))
    } else {
        let n = EDGE_LOOKS * EDGE_LOOKS
        var sum = vec3(0.0)
        var j: u32 = 0
        while j < n {
            let r = n * k + j
            sum += rays.load(r % w, r / w).xyz
            j += 1
        }
        out.store(id, vec4(sum / f32(n), 1.0))
    }
}

/// A load beside the frame while it is timed, so the M4 keeps its clock up (branch `backend`'s
/// lib/frame/load.wrela, `burn`): `rounds` sines a pixel, drawn into a target nothing reads.
@fragment
pub fn burn(pixel: FragCoord, rounds: u32) -> vec4 {
    var x = pixel.position.x * 0.001 + pixel.position.y * 0.002
    var i: u32 = 0
    while i < 4096 && i < rounds {
        x = sin(x * 1.7 + 0.3) + cos(x * 0.9)
        i += 1
    }
    vec4(x, 0.0, 0.0, 1.0)
}

/// What the engine keeps from frame to frame to draw a world: each thing's cells, the sky's
/// table, the picture and what it asked of matter, and the load beside the frame.
pub struct Sight {
    kept: Vec<Kept>,
    s: Sampler,
    table: Texture<Rgba16Float>,
    pub drawn: Picture,
    asks: Texture<Rgba32Float>,
    /// The picture before the edge pass (`drawn.colour` after it), and the edge pass's list, each
    /// pixel's place on it, and the edge rays' colours.
    raw: Texture<Rgba16Float>,
    edge_list: AppendBuffer<u32>,
    edge_at: GpuBuffer<u32>,
    edge_rays: Texture<Rgba16Float>,
    burned: Texture<R8>,
    /// The load beside each frame (sines a pixel; 0: none).
    pub load: u32,
    held_asks: u32,
    held_cell: f32,
    said: bool,
    /// An instrument: the picture shows each pixel's steps instead of its colour (1), or its edge
    /// pixels red (2).
    pub steps: u32,
    /// How many bands the picture is drawn in (`BAND_US`), and its time asked for.
    bands: u32,
    sizing: Option<Pending<f32>>,
}

/// The engine's sight, as yet of nothing.
pub fn sight() -> Sight {
    Sight {
        kept: Vec::new(),
        s: sampler(address: Address::Clamp),
        table: writable_texture(width: TABLE, height: TABLE),
        drawn: picture(width: 1, height: 1),
        asks: texture(width: 1, height: 1),
        raw: texture(width: 1, height: 1),
        edge_list: append_buffer(1),
        edge_at: buffer(1),
        edge_rays: texture(width: 1, height: 1),
        burned: texture(width: 1, height: 1),
        load: 0,
        held_asks: 0,
        held_cell: 0.0,
        said: false,
        steps: 0,
        bands: FIRST_BANDS,
        sizing: None,
    }
}

/// An instrument, not an author's: the engine's sight with its own choices held, to measure them
/// (`asks`: 0 its own, 1 every thing asked by its field, 2 by its cells; `cell`: 0 its own size, or
/// a cell's side in m).
pub fn sight_held(asks: u32, cell: f32) -> Sight {
    var s = sight()
    s.held_asks = asks
    s.held_cell = cell
    s
}

impl Sight {
    /// Whether every thing's cells are ready and the picture drawn.
    pub fn settled(self) -> bool {
        self.drawn.placed
    }

    /// The bytes every thing's cells hold, and their room.
    pub fn bytes(self) -> (f32, f32) {
        var used = 0.0
        var room = 0.0
        for k in self.kept {
            let (u, r) = k.bytes()
            used += u
            room += r
        }
        (used, room)
    }

    /// The picture's bands sized for a picture that took `us`.
    fn banded(mut self, us: f32) {
        self.bands = u32(clamp(ceil(us / BAND_US), f32(LEAST_BANDS), f32(MOST_BANDS)))
    }

    /// `world` under `sky` in `look` through `eye`, on a `width` × `height` screen: its cells
    /// brought up to date, every pixel drawn into `drawn`, and shown. Until every thing's cells
    /// are ready, the screen is black.
    pub fn draw<W: World, S: Sky, L: Look>(mut self, world: W, sky: S, look: L, eye: Eye, width: u32, height: u32) {
        self.drawn_only(world, sky, look, eye, width, height)
        if self.drawn.placed {
            show(self.drawn.colour)
        } else {
            label("shown")
            let screen = begin_screen_pass(clear: vec4(0.0, 0.0, 0.0, 1.0))
            screen.present()
        }
    }

    /// The same, into `drawn` only (nothing shown): `drawn.placed` once drawn.
    pub fn drawn_only<W: World, S: Sky, L: Look>(mut self, world: W, sky: S, look: L, eye: Eye, width: u32, height: u32) {
        let v = view(eye, width, height)
        if self.load > 0 {
            if self.burned.width() != width || self.burned.height() != height {
                self.burned = texture(width: width, height: height)
            }
            label("load")
            let b = begin_pass(mut self.burned, clear: vec4(0.0))
            draw(b, cover, burn.bind(rounds: self.load), vertices: 3)
            b.end()
        }
        while self.kept.len() < world.count() {
            var k = kept()
            k.held_asks = self.held_asks
            k.held_cell = self.held_cell
            self.kept.push(take k)
        }
        // How finely each thing is asked at the most: a pixel's footprint where its bound comes
        // nearest the eye (what the picture knows; matter is told only the size).
        // (Where each thing can be, as matter derived it last frame: none yet, a metre off.)
        var sizes: Vec<f32> = Vec::filled(world.count(), 0.0)
        var i: u32 = 0
        while i < world.count() {
            let b = self.kept[i].derived()
            sizes[i] = v.pixel() * (if b.w > 0.0 { max(length(b.xyz - v.at) - b.w, 0.05) } else { 1.0 })
            i += 1
        }
        world.kept(mut self.kept, 0, sizes)
        if !world.ready(self.kept, 0) {
            self.drawn.placed = false
            return
        }
        if !self.said {
            self.said = true
            print("picture: ready")
        }
        if self.drawn.width() != width || self.drawn.height() != height {
            self.drawn = picture(width: width, height: height)
            self.drawn.colour = writable_texture(width: width, height: height)
            self.asks = texture(width: width, height: height)
            self.raw = texture(width: width, height: height)
            let most = width * height / EDGE_SHARE
            self.edge_list = append_buffer(most)
            self.edge_at = buffer(width * height)
            self.edge_rays = texture(width: width, height: height)
        }
        match mut self.sizing {
            Some(p) => match p.poll() {
                Some(Ok(us)) => {
                    self.banded(us[0])
                    self.sizing = None
                },
                _ => {},
            },
            None => {
                self.sizing = Some(timed("picture"))
            },
        }
        label("sky table")
        dispatch(skylit.bind(sky: sky, out: mut self.table), groups: ((TABLE + 7) / 8, (TABLE + 7) / 8, 1))
        label("picture")
        let w = world.asked(self.kept, 0)
        let bands = self.bands
        var band: u32 = 0
        while band < bands {
            let y0 = band * height / bands
            let y1 = (band + 1) * height / bands
            band += 1
            let p = begin_pass3(mut self.raw, mut self.drawn.place, mut self.asks, keep: band > 1)
            p.scissor(0, y0, width, y1 - y0)
            // (Which things are asked by their cells is a constant of the draw, so each pipeline
            // holds only the code its things are asked by: four, for worlds of up to two things.)
            let c = world.cells(self.kept, 0)
            if c == 0 {
                let g: Chosen<W::Asked, 0> = Chosen { w: w }
                draw(p, cover, pixel.bind(v: v, w: g, sky: sky, look: look, table: self.table, s: self.s, steps: self.steps), vertices: 3)
            } else if c == 1 {
                let g: Chosen<W::Asked, 1> = Chosen { w: w }
                draw(p, cover, pixel.bind(v: v, w: g, sky: sky, look: look, table: self.table, s: self.s, steps: self.steps), vertices: 3)
            } else if c == 2 {
                let g: Chosen<W::Asked, 2> = Chosen { w: w }
                draw(p, cover, pixel.bind(v: v, w: g, sky: sky, look: look, table: self.table, s: self.s, steps: self.steps), vertices: 3)
            } else if c == 3 {
                let g: Chosen<W::Asked, 3> = Chosen { w: w }
                draw(p, cover, pixel.bind(v: v, w: g, sky: sky, look: look, table: self.table, s: self.s, steps: self.steps), vertices: 3)
            } else {
                panic("engine::picture: a world of more than two things asked by its cells: not built yet")
            }
            p.end()
        }
        label("edges")
        self.edge_list.clear()
        dispatch(
            edges_found.bind(raw: self.raw, place: self.drawn.place, v: v, most: width * height / EDGE_SHARE, list: mut self.edge_list, at: mut self.edge_at),
            groups: ((width + 7) / 8, (height + 7) / 8, 1),
        )
        // (The edge rays in bands of rows, as the picture is; a band past the last ray is
        // fragments that only read the count.)
        label("edge rays")
        let c = world.cells(self.kept, 0)
        band = 0
        while band < bands && self.steps != 1 {
            let y0 = band * height / bands
            let y1 = (band + 1) * height / bands
            band += 1
            let p = begin_pass(mut self.edge_rays, keep: band > 1)
            p.scissor(0, y0, width, y1 - y0)
            if c == 0 {
                let g: Chosen<W::Asked, 0> = Chosen { w: w }
                draw(p, cover, edge_ray.bind(v: v, w: g, sky: sky, look: look, table: self.table, s: self.s, list: self.edge_list.items(), count: self.edge_list.count(), width: width), vertices: 3)
            } else if c == 1 {
                let g: Chosen<W::Asked, 1> = Chosen { w: w }
                draw(p, cover, edge_ray.bind(v: v, w: g, sky: sky, look: look, table: self.table, s: self.s, list: self.edge_list.items(), count: self.edge_list.count(), width: width), vertices: 3)
            } else if c == 2 {
                let g: Chosen<W::Asked, 2> = Chosen { w: w }
                draw(p, cover, edge_ray.bind(v: v, w: g, sky: sky, look: look, table: self.table, s: self.s, list: self.edge_list.items(), count: self.edge_list.count(), width: width), vertices: 3)
            } else {
                let g: Chosen<W::Asked, 3> = Chosen { w: w }
                draw(p, cover, edge_ray.bind(v: v, w: g, sky: sky, look: look, table: self.table, s: self.s, list: self.edge_list.items(), count: self.edge_list.count(), width: width), vertices: 3)
            }
            p.end()
        }
        label("edges resolved")
        dispatch(
            edges_resolved.bind(raw: self.raw, place: self.drawn.place, v: v, at: self.edge_at.items(), rays: self.edge_rays, steps: self.steps, out: mut self.drawn.colour),
            groups: ((width + 7) / 8, (height + 7) / 8, 1),
        )
        self.drawn.placed = true
        // Matter refines its cells where this picture asked finer than they hold.
        world.refine(mut self.kept, 0, self.asks)
    }
}
