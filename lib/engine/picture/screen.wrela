// The screen: what the picture writes for it. A look's colour is linear, 0 to 1; an ordinary
// (SDR, 8-bit) screen takes it encoded by sRGB's transfer function (IEC 61966-2-1), written by the
// picture as the screen's own values. The judges compare pictures as the screen shows them: in
// these encoded values, in 255ths.

use std::gpu::{
    ClipPosition, FragCoord, Rgba16Float, Texture, VertexIndex, begin_screen_pass, draw, label,
}

/// Linear `x` (0 to 1) as an sRGB screen's value (0 to 1).
pub fn encoded1(x: f32) -> f32 {
    let c = clamp(x, 0.0, 1.0)
    if c <= 0.0031308 { c * 12.92 } else { 1.055 * pow(c, 1.0 / 2.4) - 0.055 }
}

/// Linear `c` (0 to 1) as an sRGB screen's value (0 to 1), each channel.
pub fn encoded(c: vec3) -> vec3 {
    vec3(encoded1(c.x), encoded1(c.y), encoded1(c.z))
}

/// How bright a colour is by Rec. 709's weights (on encoded values, the luma a step is judged
/// by; on linear ones, a linear brightness).
pub fn luma(c: vec3) -> f32 {
    dot(c, vec3(0.2126, 0.7152, 0.0722))
}

/// The three corners of a triangle that covers the screen.
@vertex
pub fn cover(v: VertexIndex) -> ClipPosition {
    let x = f32(v.index % 2) * 4.0 - 1.0
    let y = f32(v.index / 2) * 4.0 - 1.0
    ClipPosition { position: vec4(x, y, 0.0, 1.0) }
}

/// A picture as the screen shows it: its linear colour, encoded.
@fragment
pub fn shown(pixel: FragCoord, colour: Texture<Rgba16Float>) -> vec4 {
    vec4(encoded(colour.load(u32(pixel.position.x), u32(pixel.position.y)).xyz), 1.0)
}

/// `colour` (linear, a look's) shown on the screen.
pub fn show(colour: Texture<Rgba16Float>) {
    label("shown")
    let screen = begin_screen_pass(clear: vec4(0.0, 0.0, 0.0, 1.0))
    draw(screen, cover, shown.bind(colour: colour), vertices: 3)
    screen.present()
}
