// The reference (docs/design.md, "Order of work", 0): a world drawn by brute force and nothing
// clever (`traced`), against which any picture is judged (`judge`). Each pixel is the mean of many
// looks, each look's ray moved to another place in the pixel (Halton's points, J. H. Halton,
// Numer. Math. 2, 1960) and lit by its own dice; the mean of the looks' colours (each toned by the
// look, as the screen would show that ray alone) is what the pixel would show if it saw all of
// itself.
//
// The looks are kept in two halves, each with its own points and dice. Each half alone is a
// reference of half as many looks; the two together are the reference; and how far one half is
// from the other says how far the reference is from what it converges to (its noise: the mean of
// both is about half as far off as the halves are apart). So one run gives the reference, its own
// error, and a second picture to calibrate the judges on: the judges hold one half to the other
// and must find nothing wrong.
//
// Besides the looks, once per world: the pixel's middle ray alone (`centred`): where it meets
// matter and which way it faces there, and what the sky behind looks like along it (what the pixel
// would show if nothing were in front). The judges read coverage from colour with it.
//
// Every pass is a band of rows, so no pass holds the GPU long (AGENTS.md, rule 2), and a frame
// draws at most `PASSES` of them. `work` draws the next ones; a world that changes is begun again
// (`begin`). It prints "reference: done" when every look is in.

use matter::matter::Matter
use matter::sky::{Sky, seen}
use matter::substance::Substance
use picture::eye::{Eye, View, view}
use picture::look::{Look, Seen}
use picture::picture::Picture
use picture::screen::{cover, luma}
use reference::traced::{ends, entered, lit}
use std::field::{Field, hash_u32}
use std::gpu::{FragCoord, Rgba16Float, Rgba32Float, Targets2, Texture, begin_pass, begin_pass2, draw, label, texture}
use std::io::print

/// About how many pixels a pass draws (whole rows of the screen: at least one). At 3 µs a
/// pixel's look on the M4 for the first scene, 4096 are about 12 ms there and under 60 ms on the
/// Radeon.
pub const BAND_PIXELS: u32 = 4096

/// The most passes of the reference a frame draws.
pub const PASSES: u32 = 4

/// Point `i` of the Halton sequence in base `base`: from 0 to 1.
pub fn halton(i: u32, base: u32) -> f32 {
    var f = 1.0
    var r = 0.0
    var n = i
    var k: u32 = 0
    while k < 32 && n > 0 {
        k += 1
        f /= f32(base)
        r += f * f32(n % base)
        n /= base
    }
    r
}

/// Where in its pixel look `i` of half `half` looks (px from the middle, each way from -0.5 to
/// 0.5): Halton's points, the second half's moved by a fixed amount round the pixel (each half's
/// points then spread evenly over it).
pub fn jitter(half: u32, i: u32) -> vec2 {
    let shift = if half == 0 { vec2(0.0) } else { vec2(0.5, 0.5) }
    let h = vec2(halton(i + 1, 2), halton(i + 1, 3)) + shift
    h - floor(h) - vec2(0.5)
}

/// The dice of pixel (`x`, `y`) in look `look` (counted over both halves) of a reference whose
/// dice are `salt`.
fn dice(x: u32, y: u32, look: u32, salt: u32) -> u32 {
    hash_u32((x + 8192 * y) ^ hash_u32(look.wrapping_mul(2246822519).wrapping_add(salt.wrapping_mul(3266489917))))
}

/// One look of the reference at a pixel, added to the looks before it (`met_sofar`,
/// `matter_sofar`; none where `first`): into the first target, the look's colour (toned) and 1 if
/// its ray met matter; into the second, its colour again only if it met matter (what matter alone
/// shows, summed), and the square of its brightness (linear luma).
@fragment
pub fn looked<M: Field<Substance>, S: Sky, L: Look>(
    pixel: FragCoord,
    view: View,
    m: Matter<M>,
    sky: S,
    look: L,
    salt: u32,
    index: u32,
    rays: u32,
    bounces: u32,
    first: u32,
    met_sofar: Texture<Rgba32Float>,
    matter_sofar: Texture<Rgba32Float>,
) -> Targets2<vec4, vec4> {
    let x = u32(pixel.position.x)
    let y = u32(pixel.position.y)
    let a = if first != 0 { vec4(0.0) } else { met_sofar.load(x, y) }
    let b = if first != 0 { vec4(0.0) } else { matter_sofar.load(x, y) }
    let d = view.ray(pixel.position.xy)
    let span = m.span(view.at, d)
    var t = -1.0
    if span.y > max(span.x, 0.0) {
        t = entered(m, view.at, d, max(span.x, 0.0), ends(m, view.at, d))
    }
    if t < 0.0 {
        let c = look.tone(Seen { light: seen(sky, d) })
        return Targets2 { first: a + vec4(c, 0.0), second: b }
    }
    let p = view.at + d * t
    let n = m.facing(p, -d)
    let s = m.made_of(p)
    let light = lit(m, sky, p, n, s, -d, dice(x, y, index, salt), rays, bounces)
    let c = look.tone(Seen { light })
    let l = luma(c)
    Targets2 { first: a + vec4(c, 1.0), second: b + vec4(c, l * l) }
}

/// The pixel's middle ray alone: into the first target, which way the matter it meets faces and
/// how far along the ray (0, 0, 0, 0 where it meets none); into the second, the sky along it as
/// the look shows it, and 1 (2 where the ray ran out of steps: the reference failed there).
@fragment
pub fn centred<M: Field<Substance>, S: Sky, L: Look>(pixel: FragCoord, view: View, m: Matter<M>, sky: S, look: L) -> Targets2<vec4, vec4> {
    let d = view.ray(pixel.position.xy)
    let behind = vec4(look.tone(Seen { light: seen(sky, d) }), 1.0)
    let span = m.span(view.at, d)
    if !(span.y > max(span.x, 0.0)) {
        return Targets2 { first: vec4(0.0), second: behind }
    }
    let t = entered(m, view.at, d, max(span.x, 0.0), ends(m, view.at, d))
    if t < 0.0 {
        return Targets2 { first: vec4(0.0), second: vec4(behind.xyz, if t < -1.5 { 2.0 } else { 1.0 }) }
    }
    let p = view.at + d * t
    Targets2 { first: vec4(m.facing(p, -d), t), second: behind }
}

/// The looks summed, as means: which halves (`which`: 0 both, 1 the first, 2 the second), each of
/// `looks` looks. Into the first target, the mean colour and the share of looks that met matter
/// (its coverage); into the second, the mean colour of the looks that met matter, and how far
/// their brightness spreads.
@fragment
pub fn settled(
    pixel: FragCoord,
    met_a: Texture<Rgba32Float>,
    matter_a: Texture<Rgba32Float>,
    met_b: Texture<Rgba32Float>,
    matter_b: Texture<Rgba32Float>,
    which: u32,
    looks: f32,
) -> Targets2<vec4, vec4> {
    let x = u32(pixel.position.x)
    let y = u32(pixel.position.y)
    var met = vec4(0.0)
    var matter = vec4(0.0)
    var n = 0.0
    if which != 2 {
        met += met_a.load(x, y)
        matter += matter_a.load(x, y)
        n += looks
    }
    if which != 1 {
        met += met_b.load(x, y)
        matter += matter_b.load(x, y)
        n += looks
    }
    // How far the looks that met matter spread in brightness (their linear luma's deviation):
    // wide where a pixel holds an edge between two surfaces.
    let count = max(met.w, 1.0)
    let m = matter.xyz / count
    let l = luma(m)
    let spread = sqrt(max(matter.w / count - l * l, 0.0))
    Targets2 { first: vec4(met.xyz / n, met.w / n), second: vec4(m, spread) }
}

/// A reference's means as a picture's colour (linear, in half floats, as a picture gives it).
@fragment
pub fn pictured(pixel: FragCoord, mean: Texture<Rgba32Float>) -> vec4 {
    vec4(mean.load(u32(pixel.position.x), u32(pixel.position.y)).xyz, 1.0)
}

/// A half of the reference's looks, summed by turns into one of two pairs (a look reads the sums
/// before it from one pair and writes them with its own into the other).
pub struct Half {
    met_even: Texture<Rgba32Float>,
    matter_even: Texture<Rgba32Float>,
    met_odd: Texture<Rgba32Float>,
    matter_odd: Texture<Rgba32Float>,
    /// Looks whole.
    looks: u32,
}

fn half(width: u32, height: u32) -> Half {
    Half {
        met_even: texture(width: width, height: height),
        matter_even: texture(width: width, height: height),
        met_odd: texture(width: width, height: height),
        matter_odd: texture(width: width, height: height),
        looks: 0,
    }
}

/// What the reference says of each pixel, as the judges read it.
pub struct Truth {
    /// The mean colour of its looks (linear, the look's), and the share of them that met matter.
    pub mean: Texture<Rgba32Float>,
    /// The mean colour of its looks that met matter, and how far their brightness (linear luma)
    /// spreads about its mean.
    pub matter: Texture<Rgba32Float>,
    /// Its middle ray's: which way the matter it meets faces, and how far along it (0: none).
    pub centre: Texture<Rgba32Float>,
    /// The sky along its middle ray, as the look shows it.
    pub behind: Texture<Rgba32Float>,
    /// How many looks it is the mean of.
    pub looks: u32,
}

/// A reference: `looks` looks a half (an even number), each lit by `rays` rays over the
/// hemisphere followed through up to `bounces` stops, with dice `salt`.
pub struct Reference {
    pub looks: u32,
    pub rays: u32,
    pub bounces: u32,
    pub salt: u32,
    first: Half,
    second: Half,
    centre: Texture<Rgba32Float>,
    behind: Texture<Rgba32Float>,
    /// Bands of the middle rays drawn, of looks' bands drawn (the current look's).
    centred: u32,
    band: u32,
    passes: u32,
    width: u32,
    height: u32,
    said: bool,
}

pub fn reference(looks: u32, rays: u32, bounces: u32, salt: u32 = 0) -> Reference {
    if looks % 2 != 0 || looks == 0 {
        panic("engine::reference: a half's looks must be an even number, over 0")
    }
    Reference {
        looks,
        rays,
        bounces,
        salt,
        first: half(width: 1, height: 1),
        second: half(width: 1, height: 1),
        centre: texture(width: 1, height: 1),
        behind: texture(width: 1, height: 1),
        centred: 0,
        band: 0,
        passes: 0,
        width: 1,
        height: 1,
        said: false,
    }
}

/// One band of a look of `h` (look number `index` over both halves), its rows from `y`.
fn band_of<M: Field<Substance>, S: Sky, L: Look>(
    h: mut Half,
    v: View,
    m: Matter<M>,
    sky: S,
    look: L,
    salt: u32,
    index: u32,
    rays: u32,
    bounces: u32,
    y: u32,
    rows: u32,
    width: u32,
) {
    let first: u32 = if h.looks == 0 { 1 } else { 0 }
    if h.looks % 2 == 0 {
        let p = begin_pass2(mut h.met_even, mut h.matter_even, keep: true)
        p.scissor(0, y, width, rows)
        draw(
            p,
            cover,
            looked.bind(
                view: v,
                m: m,
                sky: sky,
                look: look,
                salt: salt,
                index: index,
                rays: rays,
                bounces: bounces,
                first: first,
                met_sofar: h.met_odd,
                matter_sofar: h.matter_odd,
            ),
            vertices: 3,
        )
        p.end()
    } else {
        let p = begin_pass2(mut h.met_odd, mut h.matter_odd, keep: true)
        p.scissor(0, y, width, rows)
        draw(
            p,
            cover,
            looked.bind(
                view: v,
                m: m,
                sky: sky,
                look: look,
                salt: salt,
                index: index,
                rays: rays,
                bounces: bounces,
                first: first,
                met_sofar: h.met_even,
                matter_sofar: h.matter_even,
            ),
            vertices: 3,
        )
        p.end()
    }
}

impl Reference {
    /// How many bands of rows the screen is cut into.
    fn bands(self) -> u32 {
        (self.height + self.rows() - 1) / self.rows()
    }

    /// Rows of the screen a pass draws.
    fn rows(self) -> u32 {
        max(BAND_PIXELS / self.width, 1)
    }

    /// Whether every look is in.
    pub fn done(self) -> bool {
        self.first.looks + self.second.looks >= 2 * self.looks
    }

    /// Looks whole, both halves.
    pub fn looked(self) -> u32 {
        self.first.looks + self.second.looks
    }

    /// The passes drawn since the world was begun.
    pub fn passes(self) -> u32 {
        self.passes
    }

    /// Begins again, for a world that has changed: every look and middle ray to draw again.
    pub fn begin(mut self) {
        self.first.looks = 0
        self.second.looks = 0
        self.centred = 0
        self.band = 0
        self.passes = 0
        self.said = false
    }

    /// Its targets `width` × `height` (begun again if they weren't).
    fn sized(mut self, width: u32, height: u32) {
        if self.width == width && self.height == height {
            return
        }
        self.width = width
        self.height = height
        self.first = half(width: width, height: height)
        self.second = half(width: width, height: height)
        self.centre = texture(width: width, height: height)
        self.behind = texture(width: width, height: height)
        self.begin()
    }

    /// Up to `PASSES` more bands of `m` under `sky`, seen in `look` through `eye` on a `width` ×
    /// `height` screen: the middle rays first, then the looks, the halves by turns.
    pub fn work<M: Field<Substance>, S: Sky, L: Look>(mut self, m: Matter<M>, sky: S, look: L, eye: Eye, width: u32, height: u32) {
        self.sized(width, height)
        let middle = view(eye, width, height)
        let bands = self.bands()
        let rows_a_band = self.rows()
        var drawn: u32 = 0
        label("reference")
        while drawn < PASSES && !self.done() {
            drawn += 1
            self.passes += 1
            if self.centred < bands {
                let y = self.centred * rows_a_band
                let p = begin_pass2(mut self.centre, mut self.behind, keep: true)
                p.scissor(0, y, width, min(rows_a_band, height - y))
                draw(p, cover, centred.bind(view: middle, m: m, sky: sky, look: look), vertices: 3)
                p.end()
                self.centred += 1
                continue
            }
            let index = self.first.looks + self.second.looks
            let which = index % 2
            let y = self.band * rows_a_band
            let rows = min(rows_a_band, height - y)
            if which == 0 {
                let v = middle.moved(jitter(0, self.first.looks))
                band_of(mut self.first, v, m, sky, look, self.salt, index, self.rays, self.bounces, y, rows, width)
            } else {
                let v = middle.moved(jitter(1, self.second.looks))
                band_of(mut self.second, v, m, sky, look, self.salt, index, self.rays, self.bounces, y, rows, width)
            }
            self.band += 1
            if self.band == bands {
                self.band = 0
                if which == 0 {
                    self.first.looks += 1
                } else {
                    self.second.looks += 1
                }
            }
        }
        if self.done() && !self.said {
            self.said = true
            print(f"reference: done: {2 * self.looks} looks of {self.rays} rays and {self.bounces} bounces at {width}x{height}, in {self.passes} passes")
        }
    }

    /// What it says of each pixel (`which`: 0 both halves, 1 the first, 2 the second), into
    /// `truth`. Every look must be in.
    pub fn settle(self, which: u32, truth: mut Truth) {
        if !self.done() {
            panic("engine::reference: settled before every look is in")
        }
        if truth.mean.width() != self.width || truth.mean.height() != self.height {
            truth.mean = texture(width: self.width, height: self.height)
            truth.matter = texture(width: self.width, height: self.height)
            truth.centre = texture(width: self.width, height: self.height)
            truth.behind = texture(width: self.width, height: self.height)
        }
        label("reference settled")
        // (Each half's looks are even, so the last of them wrote its odd pair.)
        let p = begin_pass2(mut truth.mean, mut truth.matter)
        draw(
            p,
            cover,
            settled.bind(
                met_a: self.first.met_odd,
                matter_a: self.first.matter_odd,
                met_b: self.second.met_odd,
                matter_b: self.second.matter_odd,
                which: which,
                looks: f32(self.looks),
            ),
            vertices: 3,
        )
        p.end()
        let q = begin_pass2(mut truth.centre, mut truth.behind)
        draw(q, cover, copied2.bind(a: self.centre, b: self.behind), vertices: 3)
        q.end()
        truth.looks = if which == 0 { 2 * self.looks } else { self.looks }
    }

    /// What it says of each pixel as a picture (`which` as `settle` takes it): its mean colour,
    /// and its middle rays' places.
    pub fn picture(self, which: u32, out: mut Picture, scratch: mut Truth) {
        self.settle(which, mut scratch)
        if out.colour.width() != self.width || out.colour.height() != self.height {
            out.colour = texture(width: self.width, height: self.height)
            out.place = texture(width: self.width, height: self.height)
        }
        label("reference pictured")
        let p = begin_pass(mut out.colour)
        draw(p, cover, pictured.bind(mean: scratch.mean), vertices: 3)
        p.end()
        let q = begin_pass(mut out.place)
        draw(q, cover, copied.bind(a: scratch.centre), vertices: 3)
        q.end()
        out.placed = true
    }
}

/// A truth, as yet unknown.
pub fn truth() -> Truth {
    Truth {
        mean: texture(width: 1, height: 1),
        matter: texture(width: 1, height: 1),
        centre: texture(width: 1, height: 1),
        behind: texture(width: 1, height: 1),
        looks: 0,
    }
}

/// A texture copied.
@fragment
pub fn copied(pixel: FragCoord, a: Texture<Rgba32Float>) -> vec4 {
    a.load(u32(pixel.position.x), u32(pixel.position.y))
}

/// Two textures copied.
@fragment
pub fn copied2(pixel: FragCoord, a: Texture<Rgba32Float>, b: Texture<Rgba32Float>) -> Targets2<vec4, vec4> {
    let x = u32(pixel.position.x)
    let y = u32(pixel.position.y)
    Targets2 { first: a.load(x, y), second: b.load(x, y) }
}
