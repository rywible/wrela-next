// Cost-driven O(1) SDF brick baker (`BakedField<M>`): decouples author field complexity from
// per-pixel GPU cost by baking an arbitrarily expensive `Surface` into a hardware-filtered 3D
// `R32Float` distance volume (`std::field::Sampled3d`) in bounded compute slices.
//
// Once baked, every per-pixel distance query evaluates in constant O(1) time (1 hardware trilinear
// sample) with guaranteed unit Lipschitz (`<= 1.0 + eps`) regardless of how many octaves or warps
// the source field contains.

use matter::substance::Substance
use mesh::grid::AUTO_BAKE_WORK
use std::derive::{Box3, Interval, work}
use std::field::{Bound, Field, FieldFacts, Live, Pruned, Sampled3d, Surface, sampled3d}
use std::gpu::{GlobalId, R32Float, Texels3d, Texture3d, dispatch, texture3d}
use std::hash::{Hasher, StateHash}

/// Compute kernel that samples `field.distance(p)` into a 3D `R32Float` distance volume.
@compute(4, 4, 4)
pub(package) fn bake_sdf_volume<M: Surface>(
    field: M,
    origin: vec3,
    voxel: f32,
    side: u32,
    out: mut Texels3d<R32Float>,
    id: GlobalId,
) {
    if id.x >= side || id.y >= side || id.z >= side {
        return
    }
    let p = origin + vec3(f32(id.x) + 0.5, f32(id.y) + 0.5, f32(id.z) + 0.5) * voxel
    out.store(id, field.distance(p))
}

/// GPU-backed `O(1)` distance cache for an expensive `Field<Substance>`.
/// Holds the baked 3D distance texture plus its source field `source` for exact channel queries.
pub struct BakedVolume<M: Field<Substance>> {
    pub tex: Texture3d<R32Float>,
    pub origin: vec3,
    pub voxel: f32,
    pub side: u32,
    pub bound: Bound,
    pub source: M,
}

/// Lightweight `Copy + GpuData` view of a `BakedVolume<M>` implementing `Surface` and `Field<Substance>`
/// so every engine pass (extraction, exact cells, ray queries, collision) takes it identically to
/// any analytic field, at O(1) distance cost.
pub struct BakedField<M: Field<Substance>>: Copy + GpuData {
    pub grid: Sampled3d,
    pub bound_sphere: Bound,
    pub source: M,
}

impl<M: Field<Substance> + StateHash> StateHash for BakedField<M> {
    fn state_hash(self, h: mut Hasher) {
        self.grid.origin.state_hash(mut h)
        self.grid.voxel.state_hash(mut h)
        self.bound_sphere.centre.state_hash(mut h)
        self.bound_sphere.radius.state_hash(mut h)
        self.source.state_hash(mut h)
    }
}

impl<M: Field<Substance>> Surface for BakedField<M> {
    fn distance(self, p: vec3) -> f32 {
        self.grid.distance(p)
    }

    fn bound(self) -> Bound {
        self.bound_sphere
    }

    fn lipschitz(self, _near: f32) -> f32 {
        1.02
    }

    fn interval_near(self, b: Box3) -> Interval {
        self.source.interval_near(b)
    }

    fn pruned<F: Copy + fn(vec3) -> vec3>(
        self,
        over: Box3,
        at: F,
        stretch: f32,
        live: Live,
        first: u32,
    ) -> Pruned {
        self.source.pruned(over, at, stretch, live, first)
    }
}

impl<M: Field<Substance>> Field<Substance> for BakedField<M> {
    fn channels(self, p: vec3) -> Substance {
        self.source.channels(p)
    }

    fn field_facts(self) -> FieldFacts {
        let f = self.source.field_facts()
        FieldFacts::proven(
            lip: 1.02,
            may_transmit: f.may_transmit,
            may_emit: f.may_emit,
            may_coat: f.may_coat,
            may_subsurface: f.may_subsurface,
            may_micro: f.may_micro,
            channels_proven: f.channels_proven,
            max_freq: f.max_freq,
            may_bump: f.may_bump,
        )
    }
}

/// Compile-time cost predicate: true when `field.distance(p)`'s compiler-measured ALU work
/// (`std::derive::work`) exceeds `AUTO_BAKE_WORK`, signalling the engine to promote it into a
/// baked distance cache automatically without any explicit author opt-in.
pub fn should_auto_bake<M: Surface>(field: M) -> bool {
    work(|q: vec3| field.distance(q)) > AUTO_BAKE_WORK
}

/// Bakes `field` into a `side³` `R32Float` 3D texture (clamped to `<= 64³` so one bake never holds
/// the GPU for long).
pub fn bake_field<M: Field<Substance>>(field: M, side: u32) -> BakedVolume<M> {
    let s = clamp(side, 2, 64)
    let b = field.bound()
    let r = max(min(b.radius, 1.0e4), 0.05)
    let pad = r * 1.15
    let origin = b.centre - vec3(pad)
    let voxel = (2.0 * pad) / f32(s)
    var tex = texture3d(s, s, s)
    dispatch(
        bake_sdf_volume.bind(
            field: field,
            origin: origin,
            voxel: voxel,
            side: s,
            out: mut tex,
        ),
        over: (s, s, s),
    )
    BakedVolume { tex, origin, voxel, side: s, bound: b, source: field }
}

impl<M: Field<Substance>> BakedVolume<M> {
    /// Returns a `Copy + GpuData` `BakedField<M>` handle usable directly by any `Surface`/`Field` pass.
    pub fn as_field(self) -> BakedField<M> {
        BakedField {
            grid: sampled3d(self.tex.to_handle(), self.origin, self.voxel),
            bound_sphere: self.bound,
            source: self.source,
        }
    }
}

@test
fn auto_bake_threshold_separates_simple_and_heavy_fields() {
    let cheap = std::field::sphere(1.0)
    assert(!should_auto_bake(cheap), "simple sphere must not trigger auto-bake")
    let heavy = std::field::sphere(1.0)
        .displace(std::field::fbm(freq: 2.0, octaves: 5), amp: 0.08)
        .displace(std::field::fbm(freq: 5.0, octaves: 5), amp: 0.03)
        .displace(std::field::fbm(freq: 11.0, octaves: 5), amp: 0.01)
    assert(should_auto_bake(heavy), "15-octave nested displacement field must trigger auto-bake")
}
