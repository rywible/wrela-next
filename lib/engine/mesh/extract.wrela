/// What the extraction asks of a field at once (`mesh_answer`): a point, a box and the parts
/// live in it, how near a steepness is asked for, and a solved vertex's gradient.
pub struct MeshAsk: Copy + GpuData {
    pub p: vec3,
    pub near: f32,
    pub b: Box3,
    pub live: Live,
}

/// Everything a field's mesh is made of, asked as the extraction's kernels and its CPU side ask
/// it: the distance and its parts' (`distance_live`, `pruned`, `interval_near`), its enclosure
/// (`slope_affine`: the certificates and the thin cells), its bound and steepness, and what a
/// vertex keeps of its channels (`vertex_meta`'s transmissive flag, `keep_verts`' kept part and
/// story). Not its light: a mesh is the same however a thing glows.
pub fn mesh_answer<M: Field<Substance>>(f: M, q: MeshAsk) -> (vec4, Pruned, Affine3, vec4, vec4, vec4) {
    let pr = f.pruned(q.b, |x: vec3| x, 1.0, q.live, 0)
    let iv = f.interval_near(q.b)
    let bd = f.bound()
    let trans = if !f.uses_kept() && f.field_facts().may_transmit && f.channels(q.p).transmission > 0.02 {
        1.0
    } else {
        0.0
    }
    let (kd, part, k) = f.kept_at(q.p)
    let kt = if f.field_facts().may_transmit { f.channels_kept(q.p, part, k).transmission } else { 0.0 }
    (
        vec4(f.distance_live(q.p, q.live), iv.lo, iv.hi, f.lipschitz(q.near)),
        pr,
        f.slope_affine(q.b, q.live),
        vec4(bd.centre, bd.radius),
        vec4(bd.slope, trans, kd + kt, f32(part)),
        k,
    )
}

/// A hash of what of `field` its mesh is made of (`mesh_answer`), and nothing else of it: the
/// compiler's account of which of the field's scalars `mesh_answer`'s result depends on
/// (`std::derive::kept_deps`), so the list can't go stale as a kind changes, and a field whose
/// light alone changed (the branch of glass as it cools) is not meshed again.
pub fn mesh_key<M: Field<Substance> + StateHash>(field: M, h: mut Hasher) {
    std::derive::kept_deps(|f: M, q: MeshAsk| mesh_answer(f, q), field).state_hash(mut h)
}

/// or `(Rigid::identity(), None)` otherwise.
fn rigid_key<M: Field<Substance> + StateHash>(field: M) -> (Rigid, Option<u64>) {
    let rf = field.rigid_frame()
    if rf.is_rigid() {
        match field.rigid_shape_hash() {
            Some(sh) => {
                if field.has_constant_channels() {
                    var h = Hasher::new()
                    sh.state_hash(mut h)
                    field.channels(vec3(0.0)).state_hash(mut h)
                    return (rf, Some(h.finish()))
                }
                if field.has_local_channels() {
                    return (rf, Some(sh))
                }
            },
            None => {},
        }
    }
    (Rigid::identity(), None)
}

/// Shared temporary GPU workspace used during `MeshBatch` extraction (~34 MB total for the
/// whole engine, regardless of how many batches exist in the scene).
pub struct ExtractScratch {
    pub active: AppendBuffer<ActiveBrick>,
    pub corners: GpuBuffer<f32>,
    pub corners_raw: GpuBuffer<f32>,
    pub cell_verts: GpuBuffer<u32>,
    pub exact_seen: GpuBuffer<u32>,
    /// Which seam coarse cells have an exact cell this extraction (`box_seam_cells`; `SEAM_SEEN`
    /// slots, open addressing).
    pub seam_seen: GpuBuffer<u32>,
    pub brick_idx_counts: GpuBuffer<u32>,
    pub brick_idx_cursor: GpuBuffer<u32>,
    pub brick_idx_offsets: GpuBuffer<u32>,
    pub group_sums: GpuBuffer<u32>,
    pub group_offsets: GpuBuffer<u32>,
    pub creases: AppendBuffer<u32>,
    pub surf: AppendBuffer<u32>,
    pub thin_cands: AppendBuffer<u32>,
    /// Each thin candidate of a slice: the octants its core's whole form didn't clear
    /// (`thin_watched`, for `thin_watched_octants`).
    pub thin_masks: GpuBuffer<u32>,
    /// `thin_watched_octants`' slices' dispatch sizes.
    pub thin_args: GpuBuffer<DispatchArgs>,
    /// Outline vertices put up for a certificate (`outline_quads`, `certify_watched`).
    pub cert_cands: AppendBuffer<vec2u>,
    pub grids: GpuBuffer<GridSpec>,
    pub super_grids: GpuBuffer<vec4u>,
    pub super_active: AppendBuffer<ActiveBrick>,
    pub super_args: GpuBuffer<DispatchArgs>,
    pub total_super: u32,
    pub seam_quads: AppendBuffer<SeamQuad>,
    pub seam_cells: AppendBuffer<SeamCell>,
    pub seam_creases: AppendBuffer<u32>,
    pub seam_verts: GpuBuffer<u32>,
    pub eval_args: GpuBuffer<DispatchArgs>,
    pub vert_args: GpuBuffer<DispatchArgs>,
    pub crease_args: GpuBuffer<DispatchArgs>,
    /// The crease cells' solves one crease dispatch keeps for the next, where a field's solve
    /// takes more than one (`crease_part`): one a cell of a slice (`CREASE_SLICE` at most).
    pub crease_solves: GpuBuffer<CreaseSolve>,
    pub surf_args: GpuBuffer<DispatchArgs>,
    pub quad_args: GpuBuffer<DispatchArgs>,
    pub seam_args: GpuBuffer<DispatchArgs>,
    /// Constant `[0]` buffer used as `slot_base` for non-pooled extractions, and 1-element dummy
    /// buffer passed as `exact_slots` when `cap_exact_slots == 0`.
    pub zero_u32: GpuBuffer<u32>,
    pub dummy_exact_slots: GpuBuffer<u32>,
    /// Transient buffers for `certify_watched` -> `place_cert_append` -> `place_cert_link`.
    pub place_cert_new: AppendBuffer<PlaceCert>,
    pub place_cert_new_slots: GpuBuffer<u32>,
    /// Transient GPU workspace for `BrickPool` probing, seam extraction, and active-cut compaction.
    pub miss_interior: AppendBuffer<ActiveBrick>,
    pub active_seam: AppendBuffer<ActiveBrick>,
    pub draw_slots: AppendBuffer<u32>,
    pub draw_slot_dst: GpuBuffer<u32>,
    pub compact_group_sums: GpuBuffer<u32>,
    pub compact_group_offsets: GpuBuffer<u32>,
    pub compact_copy_args: GpuBuffer<DispatchArgs>,
    pub compact_seam_args: GpuBuffer<DispatchArgs>,
    pub compact_exact_args: GpuBuffer<DispatchArgs>,
    pub compact_seam_exact_args: GpuBuffer<DispatchArgs>,
    pub zero_seam_args: GpuBuffer<DispatchArgs>,
    pub seam_strip_indices: GpuBuffer<u32>,
    pub seam_tri_count: GpuBuffer<u32>,
    pub seam_exact_cells: AppendBuffer<ExactCell>,
    pub pool_stats: GpuBuffer<u32>,
    /// What a pool update's `pool_decide` said (`mesh::pool::GATE_*`), and `pool_mark_alive`'s
    /// dispatch.
    pub pool_gate: GpuBuffer<u32>,
    pub alive_args: GpuBuffer<DispatchArgs>,
    pub max_bricks: u32,
    pub grids_cap: u32,
    /// The indirect dispatches extraction may still make this frame (`begin_frame`): a host
    /// refuses a frame's 4,097th, so every batch's chunks draw on one budget, and a batch whose
    /// chunks don't fit meshes the rest a frame later (`MeshBatch::settled` says when it has).
    pub indirect_left: u32,
    /// Where the world's lattice of cells stands (`grid::placement`): every grid made here is on
    /// it.
    pub lattice: vec3,
    /// How wide the finest cells are, in pixels where the surface is seen (`grid::CELL_PX`).
    pub cell_px: f32,
    /// The origin of the grids `set_grids` last set (every grid of a batch has its first's).
    pub origin0: vec3,
}

/// Zeroes `count` words of `buf` in chunks of at most `2097152` elements (`32768` workgroups,
/// well below Metal/Vulkan's `65535` per-dimension dispatch limit).
fn zero_u32_buf(buf: mut GpuBuffer<u32>, count: u32) {
    let chunk: u32 = 2097152
    var off: u32 = 0
    while off < count {
        let n = min(count - off, chunk)
        dispatch(zero_words.bind(words: buf.span_mut(start: off, count: n)), over: n)
        off += n
    }
}

/// The slices of `slice` cells that hold `cells`, no more than a prepared list's (`SLICES_MOST`).
fn thin_most(slice: u32, cells: u32) -> u32 {
    clamp((cells + slice - 1) / max(slice, 1), 1, SLICES_MOST)
}

/// Exact power-of-two level exponent for a requested cell width `h`, with hysteresis around `prev`
/// (`< -100.0` when unset): never coarser than `2^0.35` (`~1.27×`) past what was asked and never
/// more than `1.57×` finer, keeping exact integer powers of two so world-anchored `BrickPool` keys
/// stay invariant across eye motion without overspending bricks.
fn snapped_level(h: f32, prev: f32) -> f32 {
    let k = log2(max(h, 1.0e-6))
    if prev > -100.0 && k >= prev - 0.35 && k <= prev + 0.65 {
        prev
    } else {
        floor(k + 0.35)
    }
}

/// A distance-fitted mesh's slack (`MeshBatch::sync_one_lod`): its rings reach `FIT_REACH` times as
/// far as the eye's immediate need so walking keeps the active cut for dozens of frames before
/// stepping one world-anchored ring.
pub const FIT_REACH: f32 = 1.3

/// The indirect dispatches extraction may make in a frame, of the host's 16,384: the rest are left
/// to the swarm, skinning and the passes that follow.
pub const EXTRACT_INDIRECT: u32 = 12288

/// The pool updates whose cuts are kept for their readbacks (`MeshBatch::pool_pending`): more than
/// the frames a readback takes.
const POOL_PENDING: u32 = 6

/// The words of a batch's `tri_count` (`mesh::pool::finish_pool_draw` says what each is), all read
/// back.
const TRI_WORDS: u32 = 20

/// The indirect dispatches a chunk of `run_extract` makes besides its crease slices.
const CHUNK_INDIRECT: u32 = 7

impl ExtractScratch {
    /// Begins a frame's extraction: its whole indirect-dispatch budget.
    pub fn begin_frame(mut self) {
        self.indirect_left = EXTRACT_INDIRECT
    }
}

/// Allocates one shared `ExtractScratch` sized for up to `max_bricks` active bricks per batch.
/// `corners` and `cell_verts` are chunk-local (`CHUNK_BRICKS = 1024`), using only ~5.5 MB VRAM
/// regardless of `max_bricks`.
pub fn extract_scratch(max_bricks: u32, lattice: vec3, cell_px: f32 = CELL_PX) -> ExtractScratch {
    let grids_cap: u32 = 512
    let compact_cap = COMPACT_GROUPS * COMPACT_PER_GROUP
    ExtractScratch {
        active: append_buffer(max_bricks),
        corners: buffer(CHUNK_BRICKS * CORNERS_BRICK),
        corners_raw: buffer(CHUNK_BRICKS * CORNERS_BRICK),
        cell_verts: buffer(CHUNK_BRICKS * VERTS_STRIDE),
        exact_seen: buffer(CHUNK_BRICKS * 36),
        seam_seen: buffer(SEAM_SEEN),
        brick_idx_counts: buffer(CHUNK_BRICKS),
        brick_idx_cursor: buffer(CHUNK_BRICKS),
        brick_idx_offsets: buffer(CHUNK_BRICKS),
        group_sums: buffer(64),
        group_offsets: buffer(64),
        creases: append_buffer(CAP_SURF),
        surf: append_buffer(CAP_SURF),
        thin_cands: append_buffer(CAP_SURF),
        thin_masks: buffer(THIN_SLICE),
        thin_args: buffer_of(Vec::filled(SLICES_MOST, DispatchArgs { x: 0, y: 1, z: 1 })),
        cert_cands: append_buffer(CAP_SURF),
        grids: buffer(grids_cap),
        super_grids: buffer(grids_cap),
        super_active: append_buffer(65536),
        super_args: buffer_of(Vec::filled(SLICES_MOST, DispatchArgs { x: 0, y: 1, z: 1 })),
        total_super: 0,
        seam_quads: append_buffer(CAP_SEAM),
        seam_cells: append_buffer(CAP_SEAM * 2),
        seam_creases: append_buffer(CAP_SEAM * 2),
        seam_verts: buffer(CAP_SEAM * 4),
        eval_args: buffer_of(Vec::filled(SLICES_MOST, DispatchArgs { x: 0, y: 1, z: 1 })),
        vert_args: buffer_of([DispatchArgs { x: 0, y: 1, z: 1 }]),
        crease_args: buffer_of(Vec::filled(SLICES_MOST, DispatchArgs { x: 0, y: 1, z: 1 })),
        crease_solves: buffer(CREASE_SLICE),
        surf_args: buffer_of(Vec::filled(SLICES_MOST, DispatchArgs { x: 0, y: 1, z: 1 })),
        quad_args: buffer_of(Vec::filled(SLICES_MOST, DispatchArgs { x: 0, y: 1, z: 1 })),
        seam_args: buffer_of(Vec::filled(SLICES_MOST, DispatchArgs { x: 0, y: 1, z: 1 })),
        zero_u32: buffer_of([0]),
        dummy_exact_slots: buffer(1),
        place_cert_new: append_buffer(CAP_SURF),
        place_cert_new_slots: buffer(CAP_SURF),
        miss_interior: append_buffer(max_bricks),
        active_seam: append_buffer(SEAM_SLOTS_CAP),
        draw_slots: append_buffer(compact_cap),
        draw_slot_dst: buffer(compact_cap),
        compact_group_sums: buffer(COMPACT_GROUPS),
        compact_group_offsets: buffer(COMPACT_GROUPS),
        compact_copy_args: buffer_of([DispatchArgs { x: 0, y: 1, z: 1 }]),
        compact_seam_args: buffer_of([DispatchArgs { x: 0, y: 1, z: 1 }]),
        compact_exact_args: buffer_of([DispatchArgs { x: 0, y: 1, z: 1 }]),
        compact_seam_exact_args: buffer_of([DispatchArgs { x: 0, y: 1, z: 1 }]),
        zero_seam_args: buffer_of([DispatchArgs { x: 0, y: 1, z: 1 }]),
        seam_strip_indices: buffer(CAP_SEAM * 6),
        seam_tri_count: buffer(16),
        seam_exact_cells: append_buffer(CAP_SEAM * 2),
        pool_stats: buffer(8),
        pool_gate: buffer(GATE_WORDS),
        alive_args: buffer_of([DispatchArgs { x: 0, y: 1, z: 1 }]),
        max_bricks,
        grids_cap,
        indirect_left: EXTRACT_INDIRECT,
        lattice,
        cell_px,
        origin0: vec3(0.0),
    }
}

impl ExtractScratch {
    /// Ensures `self.grids` holds at least `count` entries without reallocating every frame.
    fn ensure_grids(mut self, count: u32) {
        if count > self.grids_cap {
            var cap = max(self.grids_cap, 512)
            while cap < count {
                cap *= 2
            }
            self.grids = buffer(cap)
            self.super_grids = buffer(cap)
            self.grids_cap = cap
        }
        self.total_super = 0
    }

    /// Uploads `grids` and precomputes `4×4×4` super-brick dimensions and base offsets for 2-level
    /// hierarchical brick culling (`super_cull_bricks` -> `cull_bricks_sub`).
    fn set_grids(mut self, grids: Vec<GridSpec>) {
        let count = grids.len()
        self.ensure_grids(count)
        var sgs: Vec<vec4u> = Vec::new()
        var total_super: u32 = 0
        for i in 0..count {
            let d = grids[i].dims
            let sx = (d.x + 3) / 4
            let sy = (d.y + 3) / 4
            let sz = (d.z + 3) / 4
            sgs.push(vec4u(sx, sy, sz, total_super))
            total_super += sx * sy * sz
        }
        if count > 0 {
            self.origin0 = grids[0].origin
        }
        write(mut self.grids, 0, grids)
        write(mut self.super_grids, 0, sgs)
        self.total_super = total_super
    }
}

/// Rounds `want` up to a power-of-two brick bucket in `[128, max_bricks]` so small objects never
/// pre-allocate tens of megabytes of unused vertex/index storage.
fn bucket_bricks(want: u32, max_bricks: u32) -> u32 {
    if want <= 128 {
        min(128, max_bricks)
    } else if want <= 512 {
        min(512, max_bricks)
    } else if want <= 1024 {
        min(1024, max_bricks)
    } else if want <= 2048 {
        min(2048, max_bricks)
    } else if want <= 4096 {
        min(4096, max_bricks)
    } else if want <= 8192 {
        min(8192, max_bricks)
    } else if want <= 16384 {
        min(16384, max_bricks)
    } else if want <= 32768 {
        min(32768, max_bricks)
    } else {
        max_bricks
    }
}

/// GPU-extracted triangle mesh for one field or a batch of fields of the same type.
/// Owns ONLY its output geometry (`verts`, `indices`, `trans_indices`, draw args, instance
/// `xforms`); temporary extraction buffers live once in `ExtractScratch`.
pub struct MeshBatch {
    pub verts: AppendBuffer<MeshVertex>,
    /// Per-vertex kept part (`part | trans`) and packed story (`pack_kept`), allocated and filled
    /// ONLY when `field.uses_kept()` is true (dummy 2-u32 buffer otherwise).
    pub vert_kept: GpuBuffer<u32>,
    vert_kept_cap: u32,
    keep_slice: u32,
    keep_args: GpuBuffer<DispatchArgs>,
    keep_first: GpuBuffer<u32>,
    /// Packed 8-byte per-vertex skin weights (`[bones_u32, weights_u32]` per vertex); allocated
    /// ONLY when `is_skinned` is true (dummy 2-u32 buffer otherwise).
    pub skin_verts: GpuBuffer<u32>,
    skin_cap: u32,
    /// Exact deformed local vertices (`One<Skinned>` DQS + Newton projection) and previous-frame
    /// deformed vertices for exact TSR motion vectors (dummy 1-vertex buffers when not deformed).
    pub deformed_verts: GpuBuffer<MeshVertex>,
    pub prev_deformed_verts: GpuBuffer<MeshVertex>,
    deformed_cap: u32,
    prev_deformed_dirty: bool,
    pub is_deformed: bool,
    pub indices: GpuBuffer<u32>,
    pub trans_indices: GpuBuffer<u32>,
    /// The partly transmissive quads of `trans_indices` again (`emit_quad`): what the G-buffer's
    /// `_cut_` draw reads, so a wholly transmissive thing's quads never reach the G-buffer.
    pub cut_indices: GpuBuffer<u32>,
    pub tri_count: GpuBuffer<u32>,
    pub draw_args: GpuBuffer<DrawIndexedArgs>,
    pub trans_draw_args: GpuBuffer<DrawIndexedArgs>,
    pub cut_draw_args: GpuBuffer<DrawIndexedArgs>,
    /// Multi-LOD seam strip draw args (`first_index = seam_start[0]`, `indices = n - seam_start[0]`).
    pub seam_draw_args: GpuBuffer<DrawIndexedArgs>,
    pub seam_start: GpuBuffer<u32>,
    /// Tier-2 Exact-Bracket cell AABBs (silhouette, grazing, budget-capped, and sub-cell thin features).
    pub exact_cells: AppendBuffer<ExactCell>,
    pub exact_draw_args: GpuBuffer<DrawIndexedArgs>,
    pub cap_exact: u32,
    pub has_exact: bool,
    /// The eye its last full extraction found exact cells for (`w`: its pixel's width a metre
    /// out; 0 for none), and the field's bound there: what a patch (`try_patch_dirty`) finds the
    /// patched bricks' exact cells for.
    exact_eye: vec4,
    /// The most the eye moves before the next extraction for it (`eye_step`'s cube): how near
    /// grazing a facing test counts a plane as both (`facing`).
    eye_reach: f32,
    exact_lip: f32,
    /// Per-brick world-space AABBs (`32 B`), alive flags (`4 B`), and packed `DrawIndexedArgs`
    /// (`20 B`) powering both 2-pass Reversed-Z Hi-Z occlusion culling (`draw_multi()`) and
    /// `< 0.15 ms` in-place dirty-region CSG re-extraction (`Edited<M>`).
    pub brick_bounds: GpuBuffer<BrickBound>,
    pub brick_alive: GpuBuffer<u32>,
    pub brick_draws: GpuBuffer<DrawIndexedArgs>,
    pub cap_brick_draws: u32,
    pub has_brick_draws: bool,
    pub has_seams: bool,
    pub edit_patched: bool,
    pub cpu_brick_slots: u32,
    pub template_lo: vec3,
    pub template_hi: vec3,
    edit_base_hash: u64,
    edit_field_hash: u64,
    edit_base_bound: vec4,
    edit_view_at: vec3,
    edit_view_fwd: vec3,
    edit_grids: Vec<GridSpec>,
    /// Each part's state hash and box at the last extraction (`part_states`), where every part
    /// could say: a later field whose hash moved in some parts only is patched in their bricks.
    part_hashes: Vec<u64>,
    part_boxes: Vec<Box3>,
    edit_append_cursor: u32,
    pub xforms: GpuBuffer<Rigid>,
    pub prev_xforms: GpuBuffer<Rigid>,
    pub inst_ids: GpuBuffer<u32>,
    xforms_cap: u32,
    prev_xforms_dirty: bool,
    /// Per-instance Dual Quaternion bone palettes (`inst_count * bone_stride`); dummy 1-element
    /// buffers when non-skinned.
    pub bones: GpuBuffer<DualQuat>,
    pub prev_bones: GpuBuffer<DualQuat>,
    bones_cap: u32,
    prev_bones_dirty: bool,
    pub is_skinned: bool,
    pub bone_stride: u32,
    pub inst_count: u32,
    extracted_xform: Rigid,
    shape_key: u64,
    is_rigid_cached: bool,
    pub instanced: bool,
    pub max_bricks: u32,
    pub cap_bricks: u32,
    pub cap_verts: u32,
    pub cap_indices: u32,
    pub cap_trans: u32,
    pub hash: u64,
    pub cell: f32,
    pub built: bool,
    pub still_frames: u32,
    pub bound: vec4,
    /// Whether the last extraction may have drawn opaque (transmissive) triangles: `true` from
    /// every extraction until a readback of that same extraction says otherwise, so a readback
    /// never hides geometry that is there (its draws, if empty, draw nothing).
    pub has_opaque: bool,
    pub has_trans: bool,
    /// Whether any of this batch's counts has been read back, and whether any of them held
    /// transmissive triangles: a batch whose read counts never did is patched in place (its
    /// transmissive triangles are made by its materials, which a patch doesn't change), whatever
    /// extraction the counts were of.
    trans_read: bool,
    trans_ever: bool,
    trans_field_key: u64,
    stats_poll: Option<Pending<u32>>,
    /// The extraction last read back. Every real extraction is read, as a settled read
    /// (`std::gpu::read_settled`): answered once the GPU has done it, a frame or two later, and
    /// never by stalling a frame; one at a time, so a thing that extracts every frame has its
    /// limits from an extraction at most a few frames old, which their headroom covers (and past
    /// it `took_counts` extracts again).
    polled_gen: u32,
    /// How many times `tri_count` has been rewritten (extractions and emptyings), whether the
    /// latest was a real extraction, and the cell scale it ran at.
    gen: u32,
    gen_real: bool,
    extract_scale: f32,
    /// The same for the extraction the pending readback reads, with the capacities it ran under
    /// (`cap_verts`, `cap_indices`, `cap_trans`, `max_bricks`).
    poll_gen: u32,
    poll_real: bool,
    poll_scale: f32,
    poll_caps: vec4u,
    /// The bricks each extraction meshes chunks for (`chunk_limit`): what the latest readback's
    /// active bricks (`active_hint`, of `hint_total` candidates) say with headroom, or every one
    /// that can be active. The latest extraction's candidates and limit, and the pending
    /// readback's.
    active_hint: u32,
    hint_total: u32,
    /// The eye the latest view-dependent extraction was made for, and whether the one being made
    /// now follows a cut (`is_cut`): the latest readback's active bricks then say little of this
    /// view's, so `chunk_limit` meshes chunks for up to `CUT_BRICKS`.
    lod_view_at: vec3,
    lod_view_fwd: vec3,
    lod_cut: bool,
    /// The levels its cells are meshed at (`snapped_level`'s exponents), and its last fit (its
    /// grids, their bricks, and the eye and the turn it was made for).
    lod_kn: f32,
    lod_kt: f32,
    lod_fit: Vec<GridSpec>,
    lod_fit_total: u32,
    lod_fit_at: vec3,
    lod_fit_fwd: vec3,
    lod_fit_right: vec3,
    lod_fit_up: vec3,
    lod_fit_cos: f32,
    /// Whether the latest extraction meshed fewer chunks than it wanted, the frame's
    /// indirect-dispatch budget spent (`ExtractScratch::indirect_left`): it is extracted again
    /// each frame, though nothing it meshes has changed, until one is whole, and till then what
    /// it draws may have holes.
    pub budget_short: bool,
    /// The last extraction's sizes, for the audit's word on an unsettled eye: the bricks it
    /// wanted, what a frame's whole budget meshes, and the indirect dispatches a chunk makes.
    last_wanted: u32,
    last_alone: u32,
    last_per_chunk: u32,
    /// True only when this batch holds a complete, un-truncated extraction (`!budget_short`),
    /// sealing `(Meshlets, ExactCover)` so a later tight-budget frame preserves the prior complete
    /// mesh instead of publishing a partial holey extraction.
    pub certified: bool,
    extract_total: u32,
    extract_limit: u32,
    poll_total: u32,
    poll_limit: u32,
    /// The most creases a chunk of the latest read extraction held (`crease_slices`).
    crease_hint: u32,
    /// Work-sized crease and surface slice sizes for the field extracted now (`crease_slice`,
    /// `surf_slice`).
    crease_slice: u32,
    /// `refine_seam_creases`' cells a dispatch, by its own bound (`kernel_work`).
    seam_crease_slice: u32,
    surf_slice: u32,
    /// The bricks one `inherit_seam_corners` dispatch takes (512 invocations a brick), and the
    /// seam cells one `solve_seam_smooth` or `box_seam_cells` dispatch takes (at most
    /// `SEAM_SLICE`; the Radeon refused 16,384 of the study's, 932,186 work an invocation).
    inherit_slice: u32,
    seam_slice: u32,
    /// The bricks a dispatch of a chunk's corner kernel takes, and of its triangle kernels
    /// (`dc::brick_slice`).
    eval_slice: u32,
    quad_slice: u32,
    /// The dispatches a crease slice's solves take for the field extracted now (`crease_passes`
    /// of `crease_part` of `crease_step_cost_of`, or of `crease_step_cost_rest_of` at rest).
    crease_passes: u32,
    /// The seam cells of the latest read extraction (`seam_slices`).
    seam_hint: u32,
    /// The latest readback's, for `took_counts`.
    seam_read: u32,
    /// The rest mesh's vertex count as a readback of extraction `verts_gen` gave it (`deform`).
    verts_known: u32,
    verts_gen: u32,
    /// Every requested cell is multiplied by this (at least 1): raised when a readback finds more
    /// active bricks than `max_bricks` (a brick count goes as `1 / cell²`), lowered as the need goes.
    cell_scale: f32,
    /// Output budgets per brick, doubled when a readback finds them overflowed.
    verts_per_brick: u32,
    indices_per_brick: u32,
    trans_per_brick: u32,
    /// Sticky `OVERFLOW_*` bitmask reported by the latest settled extraction readback (`0` = clean).
    overflow_flags: u32,
    /// The thing of its `Pool` this batch meshes as a `One` (it came near the eye), or `NONE`.
    pub near_id: u32,
    /// Whether more of its `Pool`'s things came near than the pool has such batches
    /// (`OVERFLOW_NEAR`; set on the pool's first batch).
    pub near_over: bool,
    /// The instanced paths' last instance slots on the CPU (thing per slot, its transform and
    /// bones), so each thing's previous-frame transform follows the thing, not the slot.
    cpu_ids: Vec<u32>,
    cpu_xforms: Vec<Rigid>,
    cpu_bones: Vec<DualQuat>,
    /// What this batch has done since its counts were last asked (`extraction_counts`): real
    /// extractions (whole or patched), readbacks of them, and the active bricks those read.
    /// Whether the exact pass holds this mesh, its outline found each frame for that frame's eye
    /// (`watch`, `mesh::outline`), and what its extraction kept for it: its slots' bricks and
    /// bits, its opaque quads, its thin cells and their proofs, its vertices' certificates, the
    /// exact cells it gave for every eye (`exact_base`: how many), and the lattice's origin and
    /// placement. The eye and the extraction its outline was last found for.
    watched: bool,
    watch_bits: GpuBuffer<u32>,
    slot_bricks: GpuBuffer<u32>,
    patch_slot_base: GpuBuffer<u32>,
    quad_recs: AppendBuffer<vec4u>,
    thin_keep: AppendBuffer<u32>,
    thin_proof: GpuBuffer<u32>,
    thin_due: AppendBuffer<u32>,
    cert_due: AppendBuffer<u32>,
    vert_cert: GpuBuffer<u32>,
    exact_base: GpuBuffer<u32>,
    place_cert_hash: GpuBuffer<u32>,
    place_cert_entries: AppendBuffer<PlaceCert>,
    place_cert_vals: GpuBuffer<u32>,
    place_cert_ready: bool,
    place_cert_field_key: u64,
    /// Persistent world-anchored `BrickPool` storage for static Multi-LOD batches.
    pub pooled: bool,
    pool_field_key: u64,
    pool_origin: vec3,
    pool_shift: vec3,
    pub pool_cap: u32,
    pool_hash_cap: u32,
    pool_idx_cap: u32,
    pool_exact_cap: u32,
    pub pool_used_slots: u32,
    pool_used_idx: u32,
    pool_used_exact: u32,
    pool_miss_hint: u32,
    pool_seam_hint: u32,
    /// The cut the pool holds every brick of (`cut_bounds`' `have`), and the last updates' cuts
    /// (their grids one after another, each update's generation, first grid and count), each
    /// held once its readback says it committed whole.
    pool_grids: Vec<GridSpec>,
    pool_pending: Vec<GridSpec>,
    pool_pending_at: Vec<vec3u>,
    pool_hash_slots: GpuBuffer<u32>,
    pool_keys: GpuBuffer<u32>,
    pool_slot_meta: GpuBuffer<u32>,
    pool_indices: GpuBuffer<u32>,
    pool_tri_count: GpuBuffer<u32>,
    pool_marks: GpuBuffer<u32>,
    pool_slot_base: GpuBuffer<u32>,
    pool_seam_base: GpuBuffer<u32>,
    pool_exact_cells: AppendBuffer<ExactCell>,
    pool_exact_slots: GpuBuffer<u32>,
    watch_slots_cap: u32,
    watch_quads_cap: u32,
    watch_verts_cap: u32,
    watch_origin: vec3,
    watch_shift: vec3,
    watch_eye: vec4,
    watch_fwd: vec3,
    watch_gen: u32,
    /// The counts the last watched frame put up (outline cells for a certificate, thin cells
    /// beside the outline, kept thin cells), read back settled (`watch_poll`), what the next
    /// watch's slices are sized by; whether a watch had more than its slices took (its exact
    /// cells not all found: the mesh isn't settled until one has all).
    watch_counts: GpuBuffer<u32>,
    watch_poll: Option<Pending<u32>>,
    pub watch_hint: vec3u,
    watch_hint_cands: u32,
    /// The exact cells the last watch read back had, the extraction's and its own.
    pub watch_exact: u32,
    pub watch_split: vec3u,
    watch_known: bool,
    watch_taken: vec3u,
    watch_taken_cands: u32,
    watch_short: bool,
    stat_extractions: u32,
    stat_reads: u32,
    stat_bricks: u32,
    pub stat_pool_hits: u32,
    pub stat_pool_misses: u32,
    pub late_streak: u32,
    pub max_late_streak: u32,
    pub late_frames: u32,
    last_field_key: u64,
    static_key_streak: u32,
    aabb_key: u64,
    aabb_valid: bool,
    aabb_empty: bool,
    cached_aabb: Box3,
}

/// What a judge reads back of a batch's mesh (`MeshBatch::read_drawn`), each answered later.
pub struct DrawnRead {
    pub counts: Pending<u32>,
    pub verts: Pending<MeshVertex>,
    pub indices: Pending<u32>,
    pub exact: Pending<ExactCell>,
    pub exact_base: Pending<u32>,
    pub quads: Pending<vec4u>,
    pub quad_count: Pending<u32>,
    pub slots: Pending<u32>,
    pub alive: Pending<u32>,
    pub quad_indices: Pending<u32>,
}

/// Creates a lazy `MeshBatch` (minimal initial buffers; grows cleanly on demand up to `max_bricks`).
pub fn mesh_batch(max_bricks: u32) -> MeshBatch {
    MeshBatch {
        verts: append_buffer(1),
        vert_kept: buffer(2),
        vert_kept_cap: 1,
        keep_slice: 65536,
        keep_args: buffer_of(Vec::filled(SLICES_MOST, DispatchArgs { x: 0, y: 1, z: 1 })),
        keep_first: buffer(1),
        skin_verts: buffer_of([0, 255]),
        skin_cap: 1,
        deformed_verts: buffer_of([MeshVertex { px: 0.0, py: 0.0, pz: 0.0, packed: 0 }]),
        prev_deformed_verts: buffer_of([MeshVertex { px: 0.0, py: 0.0, pz: 0.0, packed: 0 }]),
        deformed_cap: 1,
        prev_deformed_dirty: false,
        is_deformed: false,
        indices: buffer(6),
        trans_indices: buffer(6),
        cut_indices: buffer(6),
        tri_count: buffer_of(Vec::filled(TRI_WORDS, 0)),
        draw_args: buffer_of(
            [
                DrawIndexedArgs {
                    indices: 0,
                    instances: 0,
                    first_index: 0,
                    base_vertex: 0,
                    first_instance: 0,
                },
            ],
        ),
        trans_draw_args: buffer_of(
            [
                DrawIndexedArgs {
                    indices: 0,
                    instances: 0,
                    first_index: 0,
                    base_vertex: 0,
                    first_instance: 0,
                },
            ],
        ),
        cut_draw_args: buffer_of(
            [
                DrawIndexedArgs {
                    indices: 0,
                    instances: 0,
                    first_index: 0,
                    base_vertex: 0,
                    first_instance: 0,
                },
            ],
        ),
        seam_draw_args: buffer_of(
            [
                DrawIndexedArgs {
                    indices: 0,
                    instances: 0,
                    first_index: 0,
                    base_vertex: 0,
                    first_instance: 0,
                },
            ],
        ),
        seam_start: buffer_of([0]),
        exact_cells: append_buffer(1),
        exact_draw_args: buffer_of(
            [
                DrawIndexedArgs {
                    indices: 0,
                    instances: 0,
                    first_index: 0,
                    base_vertex: 0,
                    first_instance: 0,
                },
            ],
        ),
        cap_exact: 0,
        has_exact: false,
        exact_eye: vec4(0.0),
        eye_reach: 0.0,
        exact_lip: 1.0,
        brick_bounds: buffer(64),
        brick_alive: buffer(64),
        brick_draws: buffer(64),
        cap_brick_draws: 64,
        has_brick_draws: false,
        has_seams: false,
        edit_patched: false,
        cpu_brick_slots: 0,
        template_lo: vec3(0.0),
        template_hi: vec3(0.0),
        edit_base_hash: 0,
        edit_field_hash: 0,
        edit_base_bound: vec4(0.0),
        edit_view_at: vec3(0.0),
        edit_view_fwd: vec3(0.0, 0.0, -1.0),
        lod_view_at: vec3(0.0),
        lod_view_fwd: vec3(0.0, 0.0, -1.0),
        lod_cut: false,
        lod_kn: -1000.0,
        lod_kt: -1000.0,
        lod_fit: Vec::new(),
        lod_fit_total: 0,
        lod_fit_at: vec3(0.0),
        lod_fit_fwd: vec3(0.0, 0.0, 1.0),
        lod_fit_right: vec3(1.0, 0.0, 0.0),
        lod_fit_up: vec3(0.0, 1.0, 0.0),
        lod_fit_cos: 2.0,
        budget_short: false,
        last_wanted: 0,
        last_alone: 0,
        last_per_chunk: 0,
        certified: false,
        edit_grids: Vec::new(),
        part_hashes: Vec::new(),
        part_boxes: Vec::new(),
        edit_append_cursor: 0,
        xforms: buffer_of([Rigid::identity()]),
        prev_xforms: buffer_of([Rigid::identity()]),
        inst_ids: buffer_of([0]),
        xforms_cap: 1,
        prev_xforms_dirty: false,
        bones: buffer_of([DualQuat::identity()]),
        prev_bones: buffer_of([DualQuat::identity()]),
        bones_cap: 1,
        prev_bones_dirty: false,
        is_skinned: false,
        bone_stride: 0,
        inst_count: 1,
        extracted_xform: Rigid::identity(),
        shape_key: 0,
        is_rigid_cached: false,
        instanced: false,
        max_bricks,
        cap_bricks: 0,
        cap_verts: 0,
        cap_indices: 0,
        cap_trans: 0,
        hash: 0,
        cell: 0.0,
        built: false,
        still_frames: 0,
        bound: vec4(0.0),
        has_opaque: true,
        has_trans: true,
        trans_read: false,
        trans_ever: false,
        trans_field_key: 0,
        stats_poll: None,
        polled_gen: 0,
        gen: 0,
        gen_real: false,
        extract_scale: 1.0,
        poll_gen: 0,
        poll_real: false,
        poll_scale: 1.0,
        poll_caps: vec4u(0, 0, 0, 0),
        cell_scale: 1.0,
        active_hint: 0,
        hint_total: 0,
        extract_total: 0,
        extract_limit: 0,
        poll_total: 0,
        poll_limit: 0,
        crease_hint: 0,
        crease_slice: CREASE_SLICE_LEAST,
        seam_crease_slice: CREASE_SLICE_LEAST,
        surf_slice: CAP_SURF,
        inherit_slice: 64,
        seam_slice: SEAM_SLICE,
        eval_slice: CHUNK_BRICKS,
        quad_slice: CHUNK_BRICKS,
        crease_passes: CREASE_STEPS,
        seam_hint: 0,
        seam_read: 0,
        verts_known: 0,
        verts_gen: 0,
        verts_per_brick: START_VERTS_PER_BRICK,
        indices_per_brick: START_INDICES_PER_BRICK,
        trans_per_brick: START_TRANS_PER_BRICK,
        overflow_flags: 0,
        near_id: NONE,
        near_over: false,
        cpu_ids: Vec::new(),
        cpu_xforms: Vec::new(),
        cpu_bones: Vec::new(),
        watched: false,
        watch_bits: buffer(SLOT_WORDS),
        slot_bricks: buffer(SLOT_BRICK_WORDS),
        patch_slot_base: buffer_of([0]),
        quad_recs: append_buffer(1),
        thin_keep: append_buffer(1),
        thin_proof: buffer(1),
        thin_due: append_buffer(1),
        cert_due: append_buffer(CAP_SURF),
        vert_cert: buffer(1),
        exact_base: buffer(1),
        place_cert_hash: buffer(1),
        place_cert_entries: append_buffer(1),
        place_cert_vals: buffer(1),
        place_cert_ready: false,
        place_cert_field_key: 0,
        pooled: false,
        pool_field_key: 0,
        pool_origin: vec3(0.0),
        pool_shift: vec3(0.0),
        pool_cap: 0,
        pool_hash_cap: 0,
        pool_idx_cap: 0,
        pool_exact_cap: 0,
        pool_used_slots: 0,
        pool_used_idx: 0,
        pool_used_exact: 0,
        pool_miss_hint: 0,
        pool_seam_hint: 0,
        pool_grids: Vec::new(),
        pool_pending: Vec::new(),
        pool_pending_at: Vec::new(),
        pool_hash_slots: buffer(1),
        pool_keys: buffer(4),
        pool_slot_meta: buffer(POOL_META_WORDS),
        pool_indices: buffer(6),
        pool_tri_count: buffer(16),
        pool_marks: buffer(POOL_MARK_WORDS),
        pool_slot_base: buffer_of([0]),
        pool_seam_base: buffer_of([0]),
        pool_exact_cells: append_buffer(1),
        pool_exact_slots: buffer(1),
        watch_slots_cap: 1,
        watch_quads_cap: 1,
        watch_verts_cap: 1,
        watch_origin: vec3(0.0),
        watch_shift: vec3(0.0),
        watch_eye: vec4(0.0),
        watch_fwd: vec3(0.0, 0.0, -1.0),
        watch_gen: 0,
        watch_counts: buffer(8),
        watch_poll: None,
        watch_hint: vec3u(0, 0, 0),
        watch_hint_cands: 0,
        watch_exact: 0,
        watch_split: vec3u(0, 0, 0),
        watch_known: false,
        watch_taken: vec3u(0, 0, 0),
        watch_taken_cands: 0,
        watch_short: false,
        stat_extractions: 0,
        stat_reads: 0,
        stat_bricks: 0,
        stat_pool_hits: 0,
        stat_pool_misses: 0,
        late_streak: 0,
        max_late_streak: 0,
        late_frames: 0,
        last_field_key: 0,
        static_key_streak: 0,
        aabb_key: 0,
        aabb_valid: false,
        aabb_empty: false,
        cached_aabb: Box3 { lo: vec3(0.0), hi: vec3(0.0) },
    }
}

impl MeshBatch {
    /// Ensures `self.xforms`, `self.prev_xforms`, and `self.inst_ids` hold at least `count` entries.
    fn ensure_xforms(mut self, count: u32) -> bool {
        if count > self.xforms_cap {
            var cap = max(self.xforms_cap, 16)
            while cap < count {
                cap *= 2
            }
            self.xforms = buffer(cap)
            self.prev_xforms = buffer(cap)
            self.inst_ids = buffer(cap)
            self.xforms_cap = cap
            self.prev_xforms_dirty = false
            return true
        }
        false
    }

    /// Ensures `self.bones` and `self.prev_bones` hold at least `count` Dual Quaternions.
    fn ensure_bones(mut self, count: u32) -> bool {
        if count > self.bones_cap {
            var cap = max(self.bones_cap, 32)
            while cap < count {
                cap *= 2
            }
            self.bones = buffer(cap)
            self.prev_bones = buffer(cap)
            self.bones_cap = cap
            self.prev_bones_dirty = false
            return true
        }
        false
    }

    /// Ensures `self.skin_verts` holds at least `vert_cap * 2` u32s (8 bytes per vertex).
    fn ensure_skin_verts(mut self, vert_cap: u32) {
        if vert_cap > self.skin_cap {
            self.skin_verts = buffer(vert_cap * 2)
            self.skin_cap = vert_cap
        }
    }

    /// Ensures `self.vert_kept` holds at least `2 * vert_cap` u32s (ONLY when `uses_kept()`).
    fn ensure_vert_kept(mut self, vert_cap: u32) {
        if vert_cap > self.vert_kept_cap {
            self.vert_kept = buffer(2 * vert_cap)
            self.vert_kept_cap = vert_cap
        }
    }

    /// Ensures `self.deformed_verts` and `self.prev_deformed_verts` hold at least `vert_cap` vertices.
    fn ensure_deformed_verts(mut self, vert_cap: u32) {
        if vert_cap > self.deformed_cap {
            self.deformed_verts = buffer(vert_cap)
            self.prev_deformed_verts = buffer(vert_cap)
            self.deformed_cap = vert_cap
            self.prev_deformed_dirty = false
        }
    }

    /// Grows output vertex/index buffers on demand to fit `want_bricks` active bricks at the
    /// batch's per-brick budgets (never shrinking).
    fn ensure_cap(mut self, want_bricks: u32) {
        let cap = max(bucket_bricks(want_bricks, self.max_bricks), self.cap_bricks)
        let cap_verts = cap * self.verts_per_brick
        let cap_indices = cap * self.indices_per_brick
        let cap_trans = cap * self.trans_per_brick
        if cap_verts > self.cap_verts {
            self.verts = append_buffer(cap_verts)
            self.cap_verts = cap_verts
        }
        if cap_indices > self.cap_indices {
            self.indices = buffer(cap_indices)
            self.cap_indices = cap_indices
        }
        if cap_trans > self.cap_trans {
            self.trans_indices = buffer(cap_trans)
            self.cut_indices = buffer(cap_trans)
            self.cap_trans = cap_trans
        }
        self.cap_bricks = cap
    }

    /// Ensures per-brick metadata buffers (`brick_bounds`, `brick_alive`, `brick_draws`) hold at
    /// least `want_slots` entries, rounded up to a multiple of `64` (`lcm(20, 256) / 20 = 64`) so
    /// every 64-slot `span_mut` offset is 256-byte aligned on both Metal and Vulkan.
    fn ensure_brick_draws(mut self, want_slots: u32) {
        let aligned = max(((want_slots + 63) / 64) * 64, 64)
        if aligned > self.cap_brick_draws {
            self.brick_bounds = buffer(aligned)
            self.brick_alive = buffer(aligned)
            self.brick_draws = buffer(aligned)
            self.cap_brick_draws = aligned
        }
    }

    /// Grows what a held mesh keeps for its outline each frame (`watch`) to its slots, quads and
    /// vertices: a slot's bricks and bits for each brick slot, a record for each opaque quad its
    /// indices can hold, a certificate and a thin cell's proof for each vertex, and the place-keyed
    /// certificate cache. Returns `true` if any watch buffer was reallocated.
    fn ensure_watch(mut self, need_slots: u32 = 0) -> bool {
        var grew = false
        let want_slots = max(self.cap_brick_draws, need_slots)
        if want_slots > self.watch_slots_cap {
            self.watch_slots_cap = want_slots
            self.slot_bricks = buffer(self.watch_slots_cap * SLOT_BRICK_WORDS)
            self.watch_bits = buffer(self.watch_slots_cap * SLOT_WORDS)
            grew = true
        }
        let quads = max(self.cap_indices, self.pool_idx_cap) / 6 + 1
        if quads > self.watch_quads_cap {
            self.watch_quads_cap = quads
            self.quad_recs = append_buffer(quads)
            grew = true
        }
        if self.cap_verts > self.watch_verts_cap {
            self.watch_verts_cap = self.cap_verts
            self.vert_cert = buffer(self.watch_verts_cap)
            self.thin_keep = append_buffer(self.watch_verts_cap)
            self.thin_proof = buffer(self.watch_verts_cap)
            self.thin_due = append_buffer(self.watch_verts_cap)
            grew = true
        }
        if !self.place_cert_ready {
            self.place_cert_hash = buffer(PLACE_CERT_HASH)
            self.place_cert_entries = append_buffer(PLACE_CERT_CAP)
            self.place_cert_vals = buffer(PLACE_CERT_CAP)
            dispatch(
                reset_place_cert.bind(hash_slots: self.place_cert_hash.items_mut()),
                over: PLACE_CERT_HASH,
            )
            self.place_cert_entries.clear()
            self.place_cert_ready = true
        }
        grew
    }

    /// Ensures persistent `BrickPool` storage holds at least `want_slots` interior bricks (capped
    /// at `COMPACT_GROUPS * COMPACT_PER_GROUP - SEAM_SLOTS_CAP = 57344`) and matching `pool_indices`
    /// and `pool_exact_cells`. Returns `true` if any pool buffer was reallocated.
    fn ensure_pool(mut self, want_slots: u32, want_exact: u32) -> bool {
        var grew = false
        let max_interior = COMPACT_GROUPS * COMPACT_PER_GROUP - SEAM_SLOTS_CAP
        let target_slots = min(max(want_slots, 2048), max_interior)
        var cap = max(self.pool_cap, 2048)
        while cap < target_slots && cap < max_interior {
            cap = min(cap * 2, max_interior)
        }
        if cap > self.pool_cap {
            var hcap: u32 = 4096
            while hcap < cap * 2 {
                hcap *= 2
            }
            self.pool_cap = cap
            self.pool_hash_cap = hcap
            self.pool_hash_slots = buffer(hcap)
            self.pool_keys = buffer(cap * 4)
            let total_slots = cap + SEAM_SLOTS_CAP
            self.pool_slot_meta = buffer(total_slots * POOL_META_WORDS)
            if total_slots > self.cap_brick_draws {
                self.brick_alive = buffer(total_slots)
                self.cap_brick_draws = total_slots
            }
            write(mut self.pool_seam_base, 0, [cap])
            grew = true
        }
        let target_idx = max(self.cap_indices * 2, cap * self.indices_per_brick)
        let capped_idx = min(target_idx, 16777216)
        if capped_idx > self.pool_idx_cap {
            self.pool_indices = buffer(capped_idx)
            self.pool_idx_cap = capped_idx
            grew = true
        }
        let target_ex = clamp(max(want_exact, self.cap_exact), 4096, CAP_EXACT_MAX)
        if target_ex > self.pool_exact_cap {
            var ecap = max(self.pool_exact_cap, 4096)
            while ecap < target_ex && ecap < CAP_EXACT_MAX {
                ecap = min(ecap * 2, CAP_EXACT_MAX)
            }
            self.pool_exact_cells = append_buffer(ecap)
            self.pool_exact_slots = buffer(ecap)
            self.pool_exact_cap = ecap
            grew = true
        }
        grew
    }

    /// Lazily allocates/grows the Tier-2 `ExactCell` AABB shell buffer (`<= CAP_EXACT_MAX`).
    fn ensure_exact_cap(mut self, want: u32) {
        let target = clamp(want, 4096, CAP_EXACT_MAX)
        if target > self.cap_exact {
            var cap = max(self.cap_exact, 4096)
            while cap < target && cap < CAP_EXACT_MAX {
                cap = min(cap * 2, CAP_EXACT_MAX)
            }
            self.exact_cells = append_buffer(cap)
            self.cap_exact = cap
        }
    }

    /// Whether this instanced batch (`Pool<M>` crowd of `>= 16` instances) should use 2-pass
    /// per-instance Reversed-Z Hi-Z occlusion culling via `draw_multi()`.
    pub fn use_inst_cull(self) -> bool {
        self.instanced && self.inst_count >= 16 && self.has_opaque
    }

    /// Which extraction made the mesh this batch draws (changes whenever it is extracted again).
    pub fn mesh_generation(self) -> u32 {
        self.gen
    }

    /// Whether the mesh this batch draws now is known complete: its latest extraction has been
    /// read back (no extraction since) and found to have meshed every active brick within its
    /// budgets. An extraction's counts are read back without stalling, a frame or more after it
    /// runs, so the frame that extracts is never settled; one whose budgets overflowed is not
    /// settled until the extraction made again for it is read back.
    pub fn settled(self) -> bool {
        if !self.gen_real {
            return true
        }
        let read = match self.stats_poll {
            Some(_) => false,
            None => true,
        }
        self.built &&
            read &&
            self.polled_gen == self.gen &&
            self.overflowed() == 0 &&
            !self.budget_short &&
            !self.watch_short
    }

    /// Why `settled` doesn't hold, in words (`""` when it does): what the audit says of an eye it
    /// held unsettled.
    pub fn unsettled_why(self) -> String {
        if self.settled() {
            return String::new()
        }
        let read = match self.stats_poll {
            Some(_) => false,
            None => true,
        }
        f"built {self.built}, read back {read}, generation read {self.polled_gen} of {self.gen}, overflow bits {self.overflowed()}, budget short {self.budget_short} (wanted {self.last_wanted} bricks, a frame alone meshes {self.last_alone}, {self.last_per_chunk} dispatches a chunk), outline short {self.watch_short} (last counts {self.watch_hint.x}, {self.watch_hint.y}, {self.watch_hint.z} of {self.watch_taken.x}, {self.watch_taken.y}, {self.watch_taken.z} taken)"
    }

    /// Draws nothing until synced again, and forgets what it meshed, so the next sync meshes its
    /// thing afresh whatever it is (a `Pool`'s near batch given up, then given a thing again).
    pub fn forget(mut self) {
        self.has_opaque = false
        self.has_trans = false
        self.has_exact = false
        self.certified = false
        self.inst_count = 0
        self.hash = 0
        self.shape_key = 0
        self.is_skinned = false
        self.is_deformed = false
        self.is_rigid_cached = false
        self.edit_base_hash = 0
        self.pooled = false
        self.pool_field_key = 0
        self.pool_grids = Vec::new()
        self.pool_pending = Vec::new()
        self.pool_pending_at = Vec::new()
        self.trans_read = false
        self.trans_ever = false
        self.trans_field_key = 0
        self.lod_fit = Vec::new()
        self.lod_fit_total = 0
        self.aabb_valid = false
        self.aabb_key = 0
        self.lod_kn = -1000.0
        self.lod_kt = -1000.0
        self.watch_known = false
        self.watch_short = false
        self.last_field_key = 0
        self.static_key_streak = 0
        self.late_streak = 0
        self.still_frames += 1
    }

    /// Makes this batch draw nothing, with no extraction: its counts zero, its draws empty.
    /// (`key` and `cell` are what it now holds.)
    fn make_empty(mut self, scratch: mut ExtractScratch, key: u64, first_cell: f32) {
        write(mut self.tri_count, 0, Vec::filled(TRI_WORDS, 0))
        scratch.active.clear()
        self.exact_cells.clear()
        dispatch(
            finish_draw.bind(
                active_count: scratch.active.count(),
                vert_count: scratch.active.count(),
                seam_quad_count: scratch.seam_quads.count(),
                seam_cell_count: scratch.seam_cells.count(),
                exact_count: self.exact_cells.count(),
                seam_start: self.seam_start.items(),
                has_seams: 0,
                cap_indices: self.cap_indices,
                cap_trans: self.cap_trans,
                cap_exact: self.cap_exact,
                inst_count: 0,
                tri_count: mut self.tri_count,
                args: mut self.draw_args,
                trans_args: mut self.trans_draw_args,
                cut_args: mut self.cut_draw_args,
                seam_args: mut self.seam_draw_args,
                exact_args: mut self.exact_draw_args,
            ),
            over: 1,
        )
        self.has_exact = false
        self.has_brick_draws = false
        self.has_seams = false
        self.edit_patched = false
        self.cpu_brick_slots = 0
        self.hash = key
        self.cell = first_cell
        self.built = true
        self.still_frames = 0
        self.inst_count = 0
        self.note_extracted(false)
        self.cpu_ids = Vec::new()
        self.cpu_xforms = Vec::new()
        self.cpu_bones = Vec::new()
    }

    /// The exact cells beside this held mesh's outline for the eye `v` (`mesh::outline`), after
    /// the ones its extraction gave every eye: each kept quad held to the eye, its outline cells
    /// certified or solved, and each thin cell beside them or kept, its core asked of the field.
    /// Nothing is done for an eye the last watch was for, of the same extraction.
    pub fn watch<M: Field<Substance> + GpuData>(mut self, scratch: mut ExtractScratch, field: M, v: View) {
        self.finish_watch_poll()
        if !self.watched || !self.built || self.cpu_brick_slots == 0 {
            return
        }
        let eye = vec4(v.at, v.pixel())
        if eye == self.watch_eye &&
            v.forward == self.watch_fwd &&
            self.watch_gen == self.gen &&
            !self.watch_short {
            return
        }
        self.watch_eye = eye
        self.watch_fwd = v.forward
        self.watch_gen = self.gen
        let fc = frustum_cull_view(v, margin: 1.08)
        label("mesh_watch")
        let fbuf = buffer_of([field])
        let fields = fbuf.items()
        let slots = self.cpu_brick_slots
        self.exact_cells.count_from(self.exact_base.items())
        dispatch(
            forget_frame.bind(slots: slots, bits: mut self.watch_bits),
            over: slots * (SLOT_BESIDE - SLOT_LINE),
        )
        dispatch(
            stale_beside.bind(
                count: slots,
                slots: self.slot_bricks.items(),
                alive: self.brick_alive.items(),
                origin: self.watch_origin,
                shift: self.watch_shift,
                eye: eye,
                bits: mut self.watch_bits,
            ),
            over: slots,
        )
        scratch.cert_cands.clear()
        scratch.thin_cands.clear()
        let quad_indices = if self.pooled { self.pool_indices.items() } else { self.indices.items() }
        // The kept quads held to the eye, in slices as the kernel's bound lets a dispatch hold.
        let quads_k = outline_quads.bind(
            quads: self.quad_recs.items(),
            quad_count: self.quad_recs.count(),
            cap_quads: self.watch_quads_cap,
            indices: quad_indices,
            verts: self.verts.items(),
            slots: self.slot_bricks.items(),
            alive: self.brick_alive.items(),
            origin: self.watch_origin,
            shift: self.watch_shift,
            first: 0,
            eye: eye,
            fc: fc,
            bits: mut self.watch_bits,
            cert_cands: mut scratch.cert_cands,
            thin_cands: mut scratch.thin_cands,
        )
        let quad_slice = lane_slice(kernel_work(quads_k), most: self.watch_quads_cap)
        let quad_slices = thin_most(quad_slice, self.watch_quads_cap)
        dispatch(
            prep_slices.bind(
                count: self.quad_recs.count(),
                cap: self.watch_quads_cap,
                most: quad_slice,
                slices: quad_slices,
                args: scratch.surf_args.span_mut(start: 0, count: quad_slices),
            ),
            over: quad_slices,
        )
        for k in 0..quad_slices {
            dispatch(
                outline_quads.bind(
                    quads: self.quad_recs.items(),
                    quad_count: self.quad_recs.count(),
                    cap_quads: self.watch_quads_cap,
                    indices: quad_indices,
                    verts: self.verts.items(),
                    slots: self.slot_bricks.items(),
                    alive: self.brick_alive.items(),
                    origin: self.watch_origin,
                    shift: self.watch_shift,
                    first: k * quad_slice,
                    eye: eye,
                    fc: fc,
                    bits: mut self.watch_bits,
                    cert_cands: mut scratch.cert_cands,
                    thin_cands: mut scratch.thin_cands,
                ),
                groups: scratch.surf_args.at(k),
                most: quad_slice / 64,
            )
        }
        // The outline's cells certified, or given exact cells.
        label("mesh_watch_cert")
        let cert_k = certify_watched.bind(
            fields: fields,
            slots: self.slot_bricks.items(),
            verts: self.verts.items(),
            cert_cands: scratch.cert_cands.items(),
            due: self.cert_due.items(),
            due_count: self.cert_due.count(),
            cap: CAP_SURF,
            first: 0,
            origin: self.watch_origin,
            shift: self.watch_shift,
            eye: eye,
            vert_cert: mut self.vert_cert,
            place_hash: self.place_cert_hash.items(),
            place_entries: self.place_cert_entries.items(),
            place_new: mut scratch.place_cert_new,
            place_vals: mut self.place_cert_vals,
            bits: mut self.watch_bits,
            exact_cells: mut self.exact_cells,
        )
        let cert_w = kernel_work(cert_k)
        let certifies = cert_w <= limits().lane_work
        let cert_slice = lane_slice(cert_w, most: CERT_SLICE)
        let cert_slices = if certifies { self.watch_slices(self.watch_hint.x, cert_slice, CAP_SURF) } else { 0 }
        // The candidates read in slices as their kernels' bounds let a dispatch hold (each may
        // give an exact cell, whose live parts are asked of the field).
        let read_k = cert_due.bind(
            fields: fields,
            slots: self.slot_bricks.items(),
            cert_cands: scratch.cert_cands.items(),
            cert_count: scratch.cert_cands.count(),
            cap: CAP_SURF,
            first: 0,
            origin: self.watch_origin,
            shift: self.watch_shift,
            eye: eye,
            vert_cert: mut self.vert_cert,
            place_hash: self.place_cert_hash.items(),
            place_entries: self.place_cert_entries.items(),
            place_vals: self.place_cert_vals.items(),
            bits: mut self.watch_bits,
            exact_cells: mut self.exact_cells,
            due: mut self.cert_due,
        )
        let read_slice = lane_slice(kernel_work(read_k), most: CAP_SURF)
        let read_slices = self.watch_slices(self.watch_hint_cands, read_slice, CAP_SURF)
        dispatch(
            prep_slices.bind(
                count: scratch.cert_cands.count(),
                cap: CAP_SURF,
                most: read_slice,
                slices: read_slices,
                args: scratch.seam_args.span_mut(start: 0, count: read_slices),
            ),
            over: read_slices,
        )
        if certifies {
            // The cached certificates read; the cells left unsaid put up (`cert_due`), and those
            // certified.
            self.cert_due.clear()
            scratch.place_cert_new.clear()
            for k in 0..read_slices {
                dispatch(
                    cert_due.bind(
                        fields: fields,
                        slots: self.slot_bricks.items(),
                        cert_cands: scratch.cert_cands.items(),
                        cert_count: scratch.cert_cands.count(),
                        cap: CAP_SURF,
                        first: k * read_slice,
                        origin: self.watch_origin,
                        shift: self.watch_shift,
                        eye: eye,
                        vert_cert: mut self.vert_cert,
                        place_hash: self.place_cert_hash.items(),
                        place_entries: self.place_cert_entries.items(),
                        place_vals: self.place_cert_vals.items(),
                        bits: mut self.watch_bits,
                        exact_cells: mut self.exact_cells,
                        due: mut self.cert_due,
                    ),
                    groups: scratch.seam_args.at(k),
                    most: read_slice / 64,
                )
            }
            dispatch(
                prep_slices.bind(
                    count: self.cert_due.count(),
                    cap: CAP_SURF,
                    most: cert_slice,
                    slices: cert_slices,
                    args: scratch.crease_args.span_mut(start: 0, count: cert_slices),
                ),
                over: cert_slices,
            )
            for k in 0..cert_slices {
                dispatch(
                    certify_watched.bind(
                        fields: fields,
                        slots: self.slot_bricks.items(),
                        verts: self.verts.items(),
                        cert_cands: scratch.cert_cands.items(),
                        due: self.cert_due.items(),
                        due_count: self.cert_due.count(),
                        cap: CAP_SURF,
                        first: k * cert_slice,
                        origin: self.watch_origin,
                        shift: self.watch_shift,
                        eye: eye,
                        vert_cert: mut self.vert_cert,
                        place_hash: self.place_cert_hash.items(),
                        place_entries: self.place_cert_entries.items(),
                        place_new: mut scratch.place_cert_new,
                        place_vals: mut self.place_cert_vals,
                        bits: mut self.watch_bits,
                        exact_cells: mut self.exact_cells,
                    ),
                    groups: scratch.crease_args.at(k),
                    most: cert_slice / 64,
                )
            }
            // Publish newly certified cells into the place-keyed certificate cache (static/pooled
            // batches only; dynamic per-frame movers never reuse world-place certificates).
            if self.pooled || self.static_key_streak >= 1 {
                dispatch(
                    prep_slices.bind(
                        count: scratch.place_cert_new.count(),
                        cap: CAP_SURF,
                        most: CAP_SURF,
                        slices: 1,
                        args: scratch.surf_args.span_mut(start: 0, count: 1),
                    ),
                    over: 1,
                )
                dispatch(
                    place_cert_append.bind(
                        new_entries: scratch.place_cert_new.items(),
                        new_count: scratch.place_cert_new.count(),
                        cap_new: CAP_SURF,
                        entries: mut self.place_cert_entries,
                        vals: mut self.place_cert_vals,
                        new_slots: mut scratch.place_cert_new_slots,
                    ),
                    groups: scratch.surf_args.at(0),
                    most: CAP_SURF / 64,
                )
                dispatch(
                    place_cert_link.bind(
                        new_entries: scratch.place_cert_new.items(),
                        new_count: scratch.place_cert_new.count(),
                        cap_new: CAP_SURF,
                        new_slots: scratch.place_cert_new_slots.items(),
                        entries: self.place_cert_entries.items(),
                        hash_slots: mut self.place_cert_hash,
                        vals: mut self.place_cert_vals,
                    ),
                    groups: scratch.surf_args.at(0),
                    most: CAP_SURF / 64,
                )
            }
        } else {
            // Its certificate is past what an invocation may do here: its outline cells are solved.
            for k in 0..read_slices {
                dispatch(
                    uncertified.bind(
                        fields: fields,
                        slots: self.slot_bricks.items(),
                        cert_cands: scratch.cert_cands.items(),
                        cert_count: scratch.cert_cands.count(),
                        cap: CAP_SURF,
                        first: k * read_slice,
                        origin: self.watch_origin,
                        shift: self.watch_shift,
                        bits: mut self.watch_bits,
                        exact_cells: mut self.exact_cells,
                    ),
                    groups: scratch.seam_args.at(k),
                    most: read_slice / 64,
                )
            }
        }
        copy(from: self.exact_cells.count().sub(start: 0, count: 1), to: self.watch_counts.span_mut(start: 5, count: 1))
        // The thin cells beside the outline (`keep` 0), then the kept ones (`keep` 1).
        label("mesh_watch_beside")
        let dilated = self.watch_thin(mut scratch, fields, eye, fc, keep: false, hint: self.watch_hint.y)
        label("mesh_watch_kept")
        copy(from: self.exact_cells.count().sub(start: 0, count: 1), to: self.watch_counts.span_mut(start: 6, count: 1))
        let kept = self.watch_thin(mut scratch, fields, eye, fc, keep: true, hint: self.watch_hint.z)
        dispatch(
            set_exact_args.bind(
                exact_count: self.exact_cells.count(),
                cap_exact: self.cap_exact,
                tri_count: mut self.tri_count,
                exact_args: mut self.exact_draw_args,
            ),
            over: 1,
        )
        copy(from: self.exact_base.items(), to: self.watch_counts.span_mut(start: 4, count: 1))
        copy(from: self.cert_due.count().sub(start: 0, count: 1), to: self.watch_counts.span_mut(start: 0, count: 1))
        copy(from: scratch.cert_cands.count().sub(start: 0, count: 1), to: self.watch_counts.span_mut(start: 7, count: 1))
        copy(from: scratch.thin_cands.count().sub(start: 0, count: 1), to: self.watch_counts.span_mut(start: 1, count: 1))
        copy(from: self.thin_due.count().sub(start: 0, count: 1), to: self.watch_counts.span_mut(start: 2, count: 1))
        copy(from: self.exact_cells.count().sub(start: 0, count: 1), to: self.watch_counts.span_mut(start: 3, count: 1))
        self.watch_taken = vec3u(if certifies { cert_slices * cert_slice } else { CAP_SURF }, dilated, kept)
        self.watch_taken_cands = read_slices * read_slice
        self.has_exact = true
    }

    /// The slices a watch's list of at most `cap` takes, of `slice` each: as many as the last
    /// watch's count (`hint`) needs, with a quarter more and a sixteenth of a slice, or every one
    /// before any count is read.
    fn watch_slices(self, hint: u32, slice: u32, cap: u32) -> u32 {
        let most = thin_most(slice, cap)
        if !self.watch_known {
            return most
        }
        let want = hint + hint / 4 + slice / 16
        clamp((want + slice - 1) / slice, 1, most)
    }

    /// One thin list's tests for the eye `eye` (`mesh::outline::thin_watched`, then its octants):
    /// the cells beside this frame's outline (`scratch.thin_cands`), or the extraction's kept
    /// thin cells (`thin_keep`, their proofs kept); the cells its slices take.
    fn watch_thin<M: Field<Substance>>(
        mut self,
        scratch: mut ExtractScratch,
        fields: GpuSpan<M>,
        eye: vec4,
        fc: FrustumCull,
        keep: bool,
        hint: u32,
    ) -> u32 {
        if keep {
            // The kept cells the eye's move left unproven, first (`thin_due`).
            self.thin_due.clear()
            let due_k = thin_due.bind(
                cands: self.thin_keep.items(),
                count: self.thin_keep.count(),
                cap: self.watch_verts_cap,
                slots: self.slot_bricks.items(),
                alive: self.brick_alive.items(),
                origin: self.watch_origin,
                shift: self.watch_shift,
                first: 0,
                eye: eye,
                fc: fc,
                thin_proof: self.thin_proof.items(),
                due: mut self.thin_due,
            )
            let due_slice = lane_slice(kernel_work(due_k), most: self.watch_verts_cap)
            let due_slices = thin_most(due_slice, self.watch_verts_cap)
            dispatch(
                prep_slices.bind(
                    count: self.thin_keep.count(),
                    cap: self.watch_verts_cap,
                    most: due_slice,
                    slices: due_slices,
                    args: scratch.surf_args.span_mut(start: 0, count: due_slices),
                ),
                over: due_slices,
            )
            for k in 0..due_slices {
                dispatch(
                    thin_due.bind(
                        cands: self.thin_keep.items(),
                        count: self.thin_keep.count(),
                        cap: self.watch_verts_cap,
                        slots: self.slot_bricks.items(),
                        alive: self.brick_alive.items(),
                        origin: self.watch_origin,
                        shift: self.watch_shift,
                        first: k * due_slice,
                        eye: eye,
                        fc: fc,
                        thin_proof: self.thin_proof.items(),
                        due: mut self.thin_due,
                    ),
                    groups: scratch.surf_args.at(k),
                    most: due_slice / 64,
                )
            }
        }
        let cands = if keep { self.thin_keep.items() } else { scratch.thin_cands.items() }
        let order = if keep { self.thin_due.items() } else { scratch.thin_cands.items() }
        let count = if keep { self.thin_due.count() } else { scratch.thin_cands.count() }
        let cap = if keep { self.watch_verts_cap } else { CAP_SURF }
        let kf: u32 = if keep { 1 } else { 0 }
        let whole_k = thin_watched.bind(
            fields: fields,
            slots: self.slot_bricks.items(),
            alive: self.brick_alive.items(),
            cands: cands,
            order: order,
            count: count,
            cap: cap,
            first: 0,
            origin: self.watch_origin,
            shift: self.watch_shift,
            eye: eye,
            keep: kf,
            thin_proof: mut self.thin_proof,
            bits: mut self.watch_bits,
            thin_masks: scratch.thin_masks.span_mut(start: 0, count: THIN_SLICE),
        )
        let whole_w = kernel_work(whole_k)
        let oct_k = thin_watched_octants.bind(
            fields: fields,
            slots: self.slot_bricks.items(),
            alive: self.brick_alive.items(),
            cands: cands,
            order: order,
            count: count,
            cap: cap,
            thin_masks: scratch.thin_masks.items(),
            first: 0,
            origin: self.watch_origin,
            shift: self.watch_shift,
            eye: eye,
            keep: kf,
            thin_proof: mut self.thin_proof,
            bits: mut self.watch_bits,
            exact_cells: mut self.exact_cells,
        )
        // (A slice's octants are eight invocations a candidate.)
        let slice = min(
            lane_slice(whole_w, most: THIN_SLICE),
            max((lane_slice(kernel_work(oct_k), most: 8 * THIN_SLICE) / 512) * 64, 64),
        )
        let slices = self.watch_slices(hint, slice, cap)
        dispatch(
            prep_slices.bind(
                count: count,
                cap: cap,
                most: slice,
                slices: slices,
                args: scratch.crease_args.span_mut(start: 0, count: slices),
            ),
            over: slices,
        )
        dispatch(
            prep_lane_slices.bind(
                count: count,
                cap: cap,
                most: slice,
                slices: slices,
                lanes: 8,
                args: scratch.thin_args.span_mut(start: 0, count: slices),
            ),
            over: slices,
        )
        for k in 0..slices {
            dispatch(
                thin_watched.bind(
                    fields: fields,
                    slots: self.slot_bricks.items(),
                    alive: self.brick_alive.items(),
                    cands: cands,
                    order: order,
                    count: count,
                    cap: cap,
                    first: k * slice,
                    origin: self.watch_origin,
                    shift: self.watch_shift,
                    eye: eye,
                    keep: kf,
                    thin_proof: mut self.thin_proof,
                    bits: mut self.watch_bits,
                    thin_masks: scratch.thin_masks.span_mut(start: 0, count: slice),
                ),
                groups: scratch.crease_args.at(k),
                most: slice / 64,
            )
            dispatch(
                thin_watched_octants.bind(
                    fields: fields,
                    slots: self.slot_bricks.items(),
                    alive: self.brick_alive.items(),
                    cands: cands,
                    order: order,
                    count: count,
                    cap: cap,
                    thin_masks: scratch.thin_masks.items(),
                    first: k * slice,
                    origin: self.watch_origin,
                    shift: self.watch_shift,
                    eye: eye,
                    keep: kf,
                    thin_proof: mut self.thin_proof,
                    bits: mut self.watch_bits,
                    exact_cells: mut self.exact_cells,
                ),
                groups: scratch.thin_args.at(k),
                most: slice / 8,
            )
        }
        slices * slice
    }

    /// Reads the last watch's counts (`watch`), once the GPU has them: the next watch's slices
    /// are sized by them, and a watch whose lists held more than its slices took is done again.
    fn finish_watch_poll(mut self) {
        match mut self.watch_poll {
            Some(p) => match p.poll() {
                Some(Ok(c)) => {
                    self.watch_hint = vec3u(c[0], c[1], c[2])
                    self.watch_hint_cands = c[7]
                    self.watch_exact = c[3]
                    self.watch_split = vec3u(c[4], c[5], c[6])
                    self.watch_known = true
                    self.watch_short = c[0] > self.watch_taken.x || c[1] > self.watch_taken.y ||
                        c[2] > self.watch_taken.z || c[7] > self.watch_taken_cands
                    self.watch_poll = None
                },
                Some(Err(_)) => {
                    self.watch_poll = None
                },
                None => {},
            },
            None => {},
        }
    }

    /// Queues the read of this frame's watch counts, settled (at the frame's end).
    pub fn queue_watch_poll(mut self) {
        if self.watched && self.watch_poll.is_none() && self.watch_gen == self.gen {
            self.watch_poll = Some(read_settled(self.watch_counts.items()))
        }
    }

    /// Since this was last asked: the real extractions this batch made (whole or patched), how
    /// many of them were read back, and the active bricks those read held; and they start again.
    pub fn extraction_counts(mut self) -> vec3u {
        let out = vec3u(self.stat_extractions, self.stat_reads, self.stat_bricks)
        self.stat_extractions = 0
        self.stat_reads = 0
        self.stat_bricks = 0
        out
    }

    /// Whether this batch draws a pooled mesh (`mesh::pool`).
    pub fn is_pooled(self) -> bool {
        self.pooled
    }

    /// The cut this batch last extracted for (its nested grids): the drawn cut once `settled`.
    pub fn drawn_cut(self) -> Vec<GridSpec> {
        self.lod_fit.clone()
    }

    /// The eye, the steepness and the eye's reach its last extraction was made for
    /// (`run_extract`'s and `run_pool_update`'s `exact_eye`, `lip`, `eye_reach`).
    pub fn extraction_eye(self) -> (vec4, f32, f32) {
        (self.exact_eye, self.exact_lip, self.eye_reach)
    }

    /// Extracts `cut` (nested grids) of `field` cold, by the one extraction of every batch that is
    /// not a pool (`run_extract`), for the eye `exact_eye`: what a pool's mesh of the same cut is
    /// held to (`judge::pool`).
    pub fn extract_cut_cold<M: Field<Substance> + StateHash + GpuData>(
        mut self,
        scratch: mut ExtractScratch,
        field: M,
        cut: Vec<GridSpec>,
        exact_eye: vec4,
        lip: f32,
        eye_reach: f32,
    ) {
        var total: u32 = 0
        var has_seams = false
        for i in 0..cut.len() {
            let g = cut[i]
            total += g.dims.x * g.dims.y * g.dims.z
            if g.seam_mask != 0 {
                has_seams = true
            }
        }
        let things = cut.len()
        self.lod_fit = cut.clone()
        scratch.set_grids(cut)
        write(mut self.xforms, 0, [Rigid::identity()])
        write(mut self.prev_xforms, 0, [Rigid::identity()])
        write(mut self.inst_ids, 0, [0])
        self.prev_xforms_dirty = false
        self.is_skinned = false
        self.is_deformed = false
        self.is_rigid_cached = false
        self.extracted_xform = Rigid::identity()
        self.instanced = false
        self.inst_count = 1
        let fbuf = buffer_of([field])
        self.run_extract(
            mut scratch,
            fbuf.items(),
            sample: field,
            things: things,
            total_bricks: total,
            inst_count: 1,
            has_seams: has_seams,
            fc: frustum_cull_none(),
            extra_bricks: 0,
            exact_eye: exact_eye,
            lip: lip,
            eye_reach: eye_reach,
            field_key: 0,
        )
        self.built = true
        self.still_frames = 0
    }

    /// Reads back what this batch draws, for a judge (`judge::pool`): its counts (`tri_count`),
    /// its vertices, its opaque draw's indices, its exact cells and how many its extraction made
    /// (`exact_base`: the outline's of a frame follow them), its outline records, its slots'
    /// bricks and which are alive, and the indices the records name (a pool's arena, else the
    /// draw's), each whole: the judge takes what the counts say of each.
    pub fn read_drawn(self) -> DrawnRead {
        DrawnRead {
            counts: read(self.tri_count.items()),
            verts: read(self.verts.items().sub(start: 0, count: self.cap_verts)),
            indices: read(self.indices.items().sub(start: 0, count: self.cap_indices)),
            exact: read(self.exact_cells.items().sub(start: 0, count: max(self.cap_exact, 1))),
            exact_base: read(self.exact_base.items()),
            quads: read(self.quad_recs.items().sub(start: 0, count: self.watch_quads_cap)),
            quad_count: read(self.quad_recs.count()),
            slots: read(self.slot_bricks.items()),
            alive: read(self.brick_alive.items()),
            quad_indices: if self.pooled {
                read(self.pool_indices.items().sub(start: 0, count: self.pool_idx_cap))
            } else {
                read(self.indices.items().sub(start: 0, count: self.cap_indices))
            },
        }
    }

    /// Sticky `OVERFLOW_*` bitflags reported by the latest settled extraction (`0` = no truncation).
    pub fn overflowed(self) -> u32 {
        self.overflow_flags | (if self.near_over { OVERFLOW_NEAR } else { 0 })
    }

    /// Non-blocking check of any pending `(opaque, trans, active_bricks, vertices, ...)` readback.
    pub fn finish_poll(mut self) {
        var counts = vec4u(0, 0, 0, 0)
        var creases: u32 = 0
        var uncovered: u32 = 0
        var cut_indices: u32 = 0
        var gpu_ovf: u32 = 0
        var exact_count: u32 = 0
        var pool_hits: u32 = 0
        var pool_misses: u32 = 0
        var pool_slots: u32 = 0
        var pool_idx: u32 = 0
        var pool_seams: u32 = 0
        var pool_commit: u32 = 0
        var have = false
        match mut self.stats_poll {
            Some(p) => match p.poll() {
                Some(Ok(c)) => {
                    // `tri_count`'s words, all `TRI_WORDS` of them.
                    counts = vec4u(c[0], c[1], c[2], c[3])
                    creases = c[4]
                    uncovered = c[5]
                    cut_indices = c[6]
                    gpu_ovf = c[7]
                    exact_count = c[8]
                    pool_hits = c[10]
                    pool_misses = c[11]
                    self.seam_read = c[12]
                    pool_slots = c[14]
                    pool_idx = c[15]
                    pool_seams = c[16]
                    pool_commit = c[17]
                    self.pool_used_exact = c[18]
                    have = true
                    self.stats_poll = None
                },
                Some(Err(_)) => {
                    self.stats_poll = None
                },
                None => {},
            },
            None => {},
        }
        if have {
            self.took_counts(
                counts,
                creases: creases,
                uncovered: uncovered,
                cut_indices: cut_indices,
                gpu_ovf: gpu_ovf,
                exact_count: exact_count,
                pool_hits: pool_hits,
                pool_misses: pool_misses,
                pool_slots: pool_slots,
                pool_idx: pool_idx,
                pool_seams: pool_seams,
                pool_commit: pool_commit,
            )
        }
    }

    /// Acts on one readback of `tri_count`: `(opaque indices, transmissive indices, active
    /// bricks, vertices)`, each counted past its capacity, plus `cut_indices`, `gpu_ovf`, `exact_count`,
    /// and `BrickPool` counters.
    fn took_counts(
        mut self,
        c: vec4u,
        creases: u32,
        uncovered: u32,
        cut_indices: u32,
        gpu_ovf: u32,
        exact_count: u32,
        pool_hits: u32,
        pool_misses: u32,
        pool_slots: u32,
        pool_idx: u32,
        pool_seams: u32,
        pool_commit: u32,
    ) {
        if self.poll_real && (c.x > 0 || c.y > 0) {
            self.trans_read = true
            self.trans_ever = self.trans_ever || c.y > 0
        }
        if self.pooled {
            self.stat_pool_hits += pool_hits
            self.stat_pool_misses += pool_misses
            self.pool_used_slots = pool_slots
            self.pool_used_idx = pool_idx
            self.pool_miss_hint = pool_misses
            self.pool_seam_hint = pool_seams
            if pool_commit == GATE_NONE {
                // An update drew nothing new: what the pool holds is not known past the last
                // cold one, and the next is counted against nothing held.
                self.pool_grids = Vec::new()
            } else if pool_commit != 0 && (gpu_ovf & OVERFLOW_BRICKS) == 0 {
                // The update read committed its whole cut: the pool holds every brick of it.
                for k in 0..self.pool_pending_at.len() {
                    let at = self.pool_pending_at[k]
                    if at.x == self.poll_gen {
                        var held: Vec<GridSpec> = Vec::new()
                        for j in 0..at.z {
                            held.push(self.pool_pending[at.y + j])
                        }
                        self.pool_grids = take held
                    }
                }
            }
        }
        // Narrow what may be drawn only from the extraction that is drawn now.
        if self.poll_gen == self.gen {
            self.has_opaque = c.x > 0
            self.has_trans = c.y > 0
            self.has_exact = (exact_count > 0 || self.watched) && self.cap_exact > 0
        }
        if !self.poll_real {
            if self.poll_gen == self.gen {
                self.overflow_flags = 0
            }
            return
        }
        self.stat_reads += 1
        self.stat_bricks += c.z
        var ovf = gpu_ovf
        if c.z > self.poll_limit || c.z > self.poll_caps.w {
            ovf |= OVERFLOW_BRICKS
        }
        if c.w > self.poll_caps.x {
            ovf |= OVERFLOW_VERTS
        }
        if c.x > self.poll_caps.y {
            ovf |= OVERFLOW_INDICES
        }
        if c.y > self.poll_caps.z {
            ovf |= OVERFLOW_TRANS
        }
        if cut_indices > self.poll_caps.z {
            ovf |= OVERFLOW_CUT
        }
        if uncovered > 0 {
            ovf |= OVERFLOW_CREASES
        }
        if self.cap_exact > 0 && exact_count > self.cap_exact {
            ovf |= OVERFLOW_EXACT
            if self.cap_exact < CAP_EXACT_MAX {
                self.ensure_exact_cap(min(exact_count * 2, CAP_EXACT_MAX))
                self.built = false
            }
        }
        // What the extraction found: its vertices (the rest mesh `deform` moves), and its
        // active bricks, the next extraction's chunk limit. If more were active than it meshed
        // chunks for, some went unmeshed: extract again, with chunks for them all.
        if self.poll_gen == self.gen {
            self.overflow_flags = ovf
            self.verts_known = c.w
            self.verts_gen = self.gen
            if self.has_brick_draws {
                self.cpu_brick_slots = min(c.z, self.cap_brick_draws)
                self.edit_append_cursor = ((self.cpu_brick_slots + 63) / 64) * 64
            }
            if (!self.pooled && c.z > self.poll_limit) || uncovered > 0 || (self.pooled && (gpu_ovf & OVERFLOW_BRICKS) != 0) {
                self.built = false
            }
        }
        self.active_hint = c.z
        self.crease_hint = creases
        self.seam_hint = self.seam_read
        // A list that outgrew its slices left cells untested: extract again, with slices for it.
        if self.poll_gen == self.gen && (gpu_ovf & OVERFLOW_THIN) != 0 {
            self.built = false
        }
        self.hint_total = self.poll_total

        // An output budget that overflowed dropped triangles: double it and extract again.
        var regrow = false
        if c.w > self.poll_caps.x && self.verts_per_brick < VERTS_BRICK {
            self.verts_per_brick = min(self.verts_per_brick * 2, VERTS_BRICK)
            regrow = true
        }
        if c.x > self.poll_caps.y && self.indices_per_brick < MOST_INDICES_PER_BRICK {
            self.indices_per_brick = min(self.indices_per_brick * 2, MOST_INDICES_PER_BRICK)
            regrow = true
        }
        if (c.y > self.poll_caps.z || cut_indices > self.poll_caps.z) &&
            self.trans_per_brick < MOST_INDICES_PER_BRICK {
            self.trans_per_brick = min(self.trans_per_brick * 2, MOST_INDICES_PER_BRICK)
            regrow = true
        }
        if regrow {
            self.built = false
        }
        // More active bricks than the batch holds dropped bricks: coarsen every cell so they fit
        // at 70% of the limit (by at least 20%, past the cached paths' 15% cell tolerance, so the
        // next sync extracts again); relax back once well under it.
        let limit = f32(max(self.poll_caps.w, 1))
        let got = f32(c.z)
        let aim = 0.7 * limit
        if got > limit {
            let s = self.poll_scale * max(sqrt(got / aim), 1.2)
            if s > self.cell_scale {
                self.cell_scale = s
            }
        } else if self.poll_scale > 1.0 && got < 0.35 * limit {
            let s = max(self.poll_scale * sqrt(max(got, 1.0) / aim), 1.0)
            if s < 0.8 * self.cell_scale {
                self.cell_scale = s
            }
        }
    }

    /// Schedules one deferred async readback of `tri_count` (called ONCE at frame end, never
    /// mid-frame inside `run_extract`, so extraction never forces GPU submission flushes).
    pub fn maybe_queue_poll(mut self) {
        self.finish_poll()
        // Read the latest real extraction not yet read, settled: it costs the frame nothing.
        let due = self.gen_real && self.gen != self.polled_gen
        if !due {
            return
        }
        match self.stats_poll {
            None => {
                self.stats_poll = Some(read_settled(self.tri_count.items()))
                self.poll_gen = self.gen
                self.poll_real = self.gen_real
                self.poll_scale = self.extract_scale
                self.poll_total = self.extract_total
                self.poll_limit = self.extract_limit
                self.poll_caps = vec4u(
                    self.cap_verts,
                    self.cap_indices,
                    self.cap_trans,
                    self.max_bricks,
                )
                self.polled_gen = self.gen
            },
            Some(_) => {},
        }
    }

    /// Skins and projects this batch's rest-pose vertices into `deformed_verts`
    /// (`deform_skinned_verts`), in dispatches of as many vertices as its bound lets one hold
    /// (`lane_slice`), at most `DEFORM_SLICE`.
    fn deform<M: Field<Substance> + GpuData>(mut self, scratch: mut ExtractScratch, field: M) {
        // As many slices as the rest mesh has vertices, once a readback of this extraction says
        // how many (the rest mesh changes only when extracted again); every slot's until then.
        let known = self.verts_gen == self.gen && self.verts_known > 0
        let n_verts = if known { min(self.verts_known, self.cap_verts) } else { self.cap_verts }
        // A slice is as many vertices as the kernel's own bound lets a dispatch hold.
        let slice = lane_slice(
            kernel_work(deform_skinned_verts.bind(
                field: field,
                rest_verts: self.verts.items(),
                skin: self.skin_verts.items(),
                vert_count: self.verts.count(),
                cap_verts: self.cap_verts,
                first: 0,
                bones: self.bones.items(),
                out: self.deformed_verts.span_mut(start: 0, count: 64),
            )),
            most: DEFORM_SLICE,
        )
        let slices = max((n_verts + slice - 1) / slice, 1)
        dispatch(
            prep_slices.bind(
                count: self.verts.count(),
                cap: self.cap_verts,
                most: slice,
                slices: slices,
                args: scratch.crease_args.span_mut(start: 0, count: slices),
            ),
            over: slices,
        )
        for k in 0..slices {
            let first = k * slice
            let n = min(self.cap_verts - first, slice)
            dispatch(
                deform_skinned_verts.bind(
                    field: field,
                    rest_verts: self.verts.items(),
                    skin: self.skin_verts.items(),
                    vert_count: self.verts.count(),
                    cap_verts: self.cap_verts,
                    first: first,
                    bones: self.bones.items(),
                    out: self.deformed_verts.span_mut(start: first, count: n),
                ),
                groups: scratch.crease_args.at(k),
                most: (n + 63) / 64,
            )
        }
    }

    /// The bricks an extraction of `total` candidates (`hard_cap` of them meshable) meshes chunks
    /// for: the last readback's active bricks with a quarter and half a chunk of headroom, while
    /// the candidates haven't grown past a quarter of the readback's (a finer cell, a grown
    /// thing); else all of them. A chunk dispatches its passes whether bricks reach it or not, so
    /// this keeps a thing's dispatches to the chunks it fills; a surface that outgrows the
    /// headroom is met by `took_counts`, which extracts again with chunks for it all.
    fn chunk_limit(self, total: u32, hard_cap: u32) -> u32 {
        if self.lod_cut {
            let want = max(2 * self.active_hint + CHUNK_BRICKS, CUT_BRICKS)
            return min(hard_cap, ((want + CHUNK_BRICKS - 1) / CHUNK_BRICKS) * CHUNK_BRICKS)
        }
        if self.active_hint == 0 {
            // Cold, before `took_counts` has measured the surface: every candidate, as the
            // frame's budget of indirect dispatches affords (`run_extract`'s `fit`, which every
            // batch of the frame draws on). A fixed 16k bricks (from when a frame held 4,096)
            // cut a kind's first mesh short where its surface had more, and its first frame
            // was drawn with holes (the cut column at cells 20% finer: 8,981 holes).
            return hard_cap
        }
        if total > self.hint_total + self.hint_total / 4 {
            return hard_cap
        }
        let want = self.active_hint + self.active_hint / 2 + CHUNK_BRICKS
        min(hard_cap, ((want + CHUNK_BRICKS - 1) / CHUNK_BRICKS) * CHUNK_BRICKS)
    }

    /// The crease slices a chunk of `chunk_n` bricks dispatches: as `chunk_limit` does for
    /// chunks, the last readback's most creases a chunk held with a quarter and a sixteenth of a
    /// slice of headroom (or `COLD_CREASE_SLICES`, cold or after a cut); any
    /// chunk that outgrows them sets `uncovered > 0` and is met by `took_counts`.
    fn crease_slices(self, chunk_n: u32) -> u32 {
        let slice = self.crease_slice
        let most = min((chunk_n * VERTS_BRICK + slice - 1) / slice, SLICES_MOST)
        let cold = max(COLD_CREASE_SLICES, (65536 + slice - 1) / slice)
        if self.active_hint == 0 ||
            self.lod_cut ||
            self.extract_total > self.hint_total + self.hint_total / 4 {
            return min(most, cold)
        }
        let want = self.crease_hint + self.crease_hint / 4 + slice / 16
        clamp((want + slice - 1) / slice, 1, most)
    }

    /// The seam slices a batch dispatches (`SEAM_SLICE` seam cells each, for each seam pass): by
    /// the last readback's seam cells with a quarter and a sixteenth of a slice of headroom, all of
    /// them (`SEAM_SLICES`) cold or after a cut.
    fn seam_slices(self) -> u32 {
        if self.active_hint == 0 ||
            self.lod_cut ||
            self.extract_total > self.hint_total + self.hint_total / 4 {
            return thin_most(self.seam_slice, SEAM_SLICES * SEAM_SLICE)
        }
        let want = self.seam_hint + self.seam_hint / 4 + SEAM_SLICE / 16
        clamp(
            (want + self.seam_slice - 1) / self.seam_slice,
            1,
            thin_most(self.seam_slice, SEAM_SLICES * SEAM_SLICE),
        )
    }

    /// Notes that `tri_count` was rewritten by a real extraction (or emptied, `real == false`).
    fn note_extracted(mut self, real: bool) {
        if real {
            self.stat_extractions += 1
        }
        self.gen = self.gen.wrapping_add(1)
        self.gen_real = real
        self.extract_scale = self.cell_scale
        self.has_opaque = real
        self.has_trans = real
    }

    /// Each of this frame's instance slots' previous-frame transform, matched by thing (`ids`
    /// among `n` things): the thing's own last transform, or `now`'s (no motion) if it wasn't drawn.
    fn matched_prev_xforms(self, n: u32, ids: Vec<u32>, now: Vec<Rigid>) -> Vec<Rigid> {
        let last = self.last_slots(n)
        var out: Vec<Rigid> = Vec::new()
        for j in 0..ids.len() {
            let k = last[ids[j]]
            out.push(if k != NONE && k < self.cpu_xforms.len() { self.cpu_xforms[k] } else {
                now[j]
            })
        }
        out
    }

    /// `matched_prev_xforms` for each slot's `stride` bones.
    fn matched_prev_bones(
        self,
        n: u32,
        ids: Vec<u32>,
        now: Vec<DualQuat>,
        stride: u32,
    ) -> Vec<DualQuat> {
        let last = self.last_slots(n)
        var out: Vec<DualQuat> = Vec::new()
        for j in 0..ids.len() {
            let k = last[ids[j]]
            let had = k != NONE && (k + 1) * stride <= self.cpu_bones.len()
            for b in 0..stride {
                out.push(if had { self.cpu_bones[k * stride + b] } else { now[j * stride + b] })
            }
        }
        out
    }

    /// Last frame's slot of each of `n` things (`NONE` where it wasn't drawn).
    fn last_slots(self, n: u32) -> Vec<u32> {
        var last: Vec<u32> = Vec::new()
        for _i in 0..n {
            last.push(NONE)
        }
        for k in 0..self.cpu_ids.len() {
            let t = self.cpu_ids[k]
            if t < n {
                last[t] = k
            }
        }
        last
    }

    /// Extracts a single field into this batch if its state hash or requested cell size changed.
    /// Skinned fields extract their rest-pose template ONCE with auto-computed per-vertex skin
    /// weights and stream only their Dual Quaternion bone palette each frame (0.000 ms extraction).
    /// Rigidly transformed fields update only their 64-byte GPU transform matrix.
    pub fn sync_one<M: Field<Substance> + StateHash + GpuData>(
        mut self,
        scratch: mut ExtractScratch,
        field: M,
        cell: f32,
    ) {
        let cell = cell * self.cell_scale
        var h = Hasher::new()
        mesh_key(field, mut h)
        let key = h.finish()

        if M::MAY_SKIN {
            match field.skin_shape_hash() {
                Some(sk) => {
                    let rf = field.rigid_frame()
                    // Extract the reusable rest-pose template slightly finer (0.75×) so edges bridging
                    // bent joints (shoulders, hips, knees) stay sub-pixel accurate after DQS.
                    let eff_cell = (cell * 0.75) / max(rf.scale_factor(), 1.0e-4)
                    let bc = max(field.skin_bone_count(), 1)
                    if self.built &&
                        self.is_skinned &&
                        self.is_deformed &&
                        self.hash == key &&
                        !self.budget_short &&
                        abs(self.cell - eff_cell) <= 0.05 * max(self.cell, 1.0e-4) {
                        if self.prev_xforms_dirty {
                            copy(from: self.xforms.items(), to: self.prev_xforms.items_mut())
                            self.prev_xforms_dirty = false
                        }
                        if self.prev_bones_dirty {
                            copy(from: self.bones.items(), to: self.prev_bones.items_mut())
                            self.prev_bones_dirty = false
                        }
                        if self.prev_deformed_dirty {
                            copy(
                                from: self.deformed_verts.items(),
                                to: self.prev_deformed_verts.items_mut(),
                            )
                            self.prev_deformed_dirty = false
                        }
                        self.still_frames += 1
                        return
                    }
                    var pose_dq: Vec<DualQuat> = Vec::new()
                    for b in 0..bc {
                        pose_dq.push(field.skin_bone(b))
                    }
                    let wb = field.bound()
                    self.bound = vec4(wb.centre, min(wb.radius, 1.0e4))
                    if self.built &&
                        self.is_skinned &&
                        self.is_deformed &&
                        !self.instanced &&
                        self.shape_key == sk &&
                        self.bone_stride == bc &&
                        abs(self.cell - eff_cell) <= 0.05 * max(self.cell, 1.0e-4) {
                        copy(from: self.xforms.items(), to: self.prev_xforms.items_mut())
                        write(mut self.xforms, 0, [rf])
                        self.prev_xforms_dirty = true
                        let grew_b = self.ensure_bones(bc)
                        if !grew_b {
                            copy(from: self.bones.items(), to: self.prev_bones.items_mut())
                            self.prev_bones_dirty = true
                        } else {
                            write(mut self.prev_bones, 0, pose_dq)
                            self.prev_bones_dirty = false
                        }
                        write(mut self.bones, 0, pose_dq)
                        label("mesh_skin")
                        copy(
                            from: self.deformed_verts.items(),
                            to: self.prev_deformed_verts.items_mut(),
                        )
                        self.deform(mut scratch, field)
                        self.prev_deformed_dirty = true
                        self.hash = key
                        self.still_frames = 0
                        return
                    }
                    let aabb = tight_aabb_rest(field)
                    let g = grid_for(aabb, eff_cell, base_brick: 0, orig_id: 0, shift: scratch.lattice)
                    let total_bricks = g.dims.x * g.dims.y * g.dims.z
                    let fbuf = buffer_of([field])
                    scratch.ensure_grids(1)
                    write(mut scratch.grids, 0, [g])
                    write(mut self.xforms, 0, [rf])
                    write(mut self.prev_xforms, 0, [rf])
                    write(mut self.inst_ids, 0, [0])
                    self.prev_xforms_dirty = false
                    let _ = self.ensure_bones(bc)
                    write(mut self.bones, 0, pose_dq)
                    write(mut self.prev_bones, 0, pose_dq)
                    self.prev_bones_dirty = false
                    self.inst_count = 1
                    self.run_extract_skinned(
                        mut scratch,
                        fbuf.items(),
                        sample: field,
                        things: 1,
                        total_bricks: total_bricks,
                        inst_count: 1,
                    )
                    self.ensure_deformed_verts(self.cap_verts)
                    label("mesh_skin")
                    self.deform(mut scratch, field)
                    copy(from: self.deformed_verts.items(), to: self.prev_deformed_verts.items_mut())
                    self.prev_deformed_dirty = false
                    self.extracted_xform = Rigid::identity()
                    self.shape_key = sk
                    self.is_rigid_cached = false
                    self.is_skinned = true
                    self.is_deformed = true
                    self.bone_stride = bc
                    self.instanced = false
                    self.hash = key
                    self.cell = eff_cell
                    self.built = true
                    self.still_frames = 0
                    return
                },
                None => {},
            }
        } else {
            held_unskinned(field)
        }

        let (rf, maybe_sk) = rigid_key(field)
        let eff_cell = match maybe_sk {
            Some(_) => cell / max(rf.scale_factor(), 1.0e-4),
            None => cell,
        }
        if self.built &&
            !self.is_skinned &&
            self.hash == key &&
            !self.budget_short &&
            abs(self.cell - eff_cell) <= 0.05 * max(self.cell, 1.0e-4) {
            if self.prev_xforms_dirty {
                copy(from: self.xforms.items(), to: self.prev_xforms.items_mut())
                self.prev_xforms_dirty = false
            }
            self.still_frames += 1
            self.late_streak = 0
            return
        }
        match maybe_sk {
            Some(sk) => {
                if self.built &&
                    !self.is_skinned &&
                    self.is_rigid_cached &&
                    !self.instanced &&
                    self.shape_key == sk &&
                    abs(self.cell - eff_cell) <= 0.15 * max(self.cell, 1.0e-4) {
                    copy(from: self.xforms.items(), to: self.prev_xforms.items_mut())
                    let delta = rf.delta_from(self.extracted_xform)
                    write(mut self.xforms, 0, [delta])
                    self.prev_xforms_dirty = true
                    let b = field.bound()
                    self.bound = vec4(b.centre, min(b.radius, 1.0e4))
                    self.hash = key
                    self.still_frames = 0
                    return
                }
            },
            None => {},
        }
        if self.try_patch_dirty(mut scratch, field, key: key, check_cell: eff_cell) {
            return
        }
        let is_edited = match field.edit_base_hash() {
            Some(_) => true,
            None => false,
        }
        let aabb = tight_aabb(field)
        let g = grid_for(aabb, cell, base_brick: 0, orig_id: 0, shift: scratch.lattice)
        let total_bricks = g.dims.x * g.dims.y * g.dims.z
        let fbuf = buffer_of([field])
        scratch.ensure_grids(1)
        write(mut scratch.grids, 0, [g])
        let mid = 0.5 * (aabb.lo + aabb.hi)
        self.bound = vec4(mid, length(aabb.hi - mid))
        write(mut self.xforms, 0, [Rigid::identity()])
        write(mut self.prev_xforms, 0, [Rigid::identity()])
        write(mut self.inst_ids, 0, [0])
        self.prev_xforms_dirty = false
        self.is_skinned = false
        self.is_deformed = false
        self.bone_stride = 0
        self.inst_count = 1
        self.run_extract(
            mut scratch,
            fbuf.items(),
            sample: field,
            things: 1,
            total_bricks: total_bricks,
            inst_count: 1,
            has_seams: false,
            fc: frustum_cull_none(),
            extra_bricks: if is_edited { 4096 } else { 0 },
            exact_eye: vec4(0.0),
            lip: max(field.lipschitz(cell * 1.7320508), 1.0),
        )
        self.hash = key
        self.cell = eff_cell
        self.built = true
        self.still_frames = 0
        self.instanced = false
        match field.edit_base_hash() {
            Some(bh) => {
                let fb = field.bound()
                self.edit_base_hash = bh
                self.edit_field_hash = key
                self.edit_base_bound = vec4(fb.centre, min(fb.radius, 1.0e4))
                var eg: Vec<GridSpec> = Vec::new()
                eg.push(g)
                self.edit_grids = take eg
            },
            None => {
                self.edit_base_hash = 0
                self.edit_field_hash = 0
                self.edit_grids = Vec::new()
                // A field whose parts say what they're made of is patched in the bricks of the
                // parts that move (`parts_dirty`).
                match part_states(field) {
                    Some((hs, bs)) => {
                        var eg: Vec<GridSpec> = Vec::new()
                        eg.push(g)
                        self.edit_grids = take eg
                        let fb = field.bound()
                        self.edit_base_bound = vec4(fb.centre, min(fb.radius, 1.0e4))
                        self.part_hashes = take hs
                        self.part_boxes = take bs
                    },
                    None => {
                        self.part_hashes = Vec::new()
                        self.part_boxes = Vec::new()
                    },
                }
            },
        }
        match maybe_sk {
            Some(sk) => {
                self.extracted_xform = rf
                self.shape_key = sk
                self.is_rigid_cached = true
            },
            None => {
                self.extracted_xform = Rigid::identity()
                self.shape_key = 0
                self.is_rigid_cached = false
            },
        }
    }

    /// Adaptive Multi-LOD extraction for a single `One<M>` field around view `v`:
    /// - Uses fast cached `sync_one` (including DQS skinning or rigid-cached delta transforms)
    ///   whenever `!force_direct` and either `field` is `Skinned` or `h_top <= h_near * 1.45`.
    /// - Otherwise builds a strictly 2:1-balanced frustum-fitted nested clipmap of up to
    ///   `MAX_LOD_LEVELS` rings snapped to integer coarse brick boundaries (`build_lod_grids_view`)
    ///   so fine detail across the full screen frustum coexists watertightly (`open_edges == 0`)
    ///   with coarse far geometry.
    pub fn sync_one_lod<M: Field<Substance> + StateHash + GpuData>(
        mut self,
        scratch: mut ExtractScratch,
        field: M,
        v: View,
        d_surf: f32,
        h_near_asked: f32,
        h_top_asked: f32,
        force_direct: bool,
    ) {
        // The cells asked for, as powers of two, each kept while what is asked stays within
        // `LEVEL_SLACK` of it: an eye moving or turning moves them by a level at a time, and only
        // at its edges, so the grids (and every brick on them) stay as they were between.
        self.lod_kn = snapped_level(h_near_asked, self.lod_kn)
        self.lod_kt = max(snapped_level(h_top_asked, self.lod_kt), self.lod_kn)
        let h_near = exp2(self.lod_kn)
        let h_top = exp2(self.lod_kt)
        if !force_direct {
            if M::MAY_SKIN {
                match field.skin_shape_hash() {
                    Some(_) => {
                        self.sync_one(mut scratch, field, h_top)
                        return
                    },
                    None => {},
                }
            } else {
                held_unskinned(field)
            }
            if h_top <= h_near * 1.45 {
                let (_, rkey) = rigid_key(field)
                match rkey {
                    Some(_) => {
                        self.sync_one(mut scratch, field, h_near)
                        return
                    },
                    None => {},
                }
            }
        }
        // Fast path for `Edited<M>` solids when camera hasn't moved: avoid CPU `tight_aabb` +
        // `build_lod_grids_view` completely on steady frames AND on live CSG dirty patches!
        let eff_near = h_near * self.cell_scale
        if self.built &&
            !self.is_skinned &&
            self.edit_base_hash != 0 &&
            self.edit_grids.len() > 0 &&
            length(v.at - self.edit_view_at) < eye_step(d_surf) &&
            dot(v.forward, self.edit_view_fwd) > 0.999 {
            match field.edit_base_hash() {
                Some(bh) => {
                    if bh == self.edit_base_hash {
                        var fh = Hasher::new()
                        field.state_hash(mut fh)
                        let fkey = fh.finish()
                        if fkey == self.edit_field_hash {
                            if self.prev_xforms_dirty {
                                copy(from: self.xforms.items(), to: self.prev_xforms.items_mut())
                                self.prev_xforms_dirty = false
                            }
                            self.still_frames += 1
                            return
                        }
                        if self.try_patch_dirty(
                            mut scratch,
                            field,
                            key: self.hash ^ fkey,
                            check_cell: self.cell,
                        ) {
                            self.edit_field_hash = fkey
                            return
                        }
                    }
                },
                None => {},
            }
        }
        var fh = Hasher::new()
        mesh_key(field, mut fh)
        let field_key = fh.finish()
        var aabb = self.cached_aabb
        var aabb_empty = self.aabb_empty
        if !self.aabb_valid || self.aabb_key != field_key {
            aabb = tight_aabb(field)
            aabb_empty = !may_cross(field.interval_near(aabb))
            self.cached_aabb = aabb
            self.aabb_empty = aabb_empty
            self.aabb_key = field_key
            self.aabb_valid = true
        }
        // A field none of whose points is inside (an absent thing: the bolt between strikes)
        // has no surface to mesh: nothing is extracted, and nothing dispatched, however its
        // state moves.
        if aabb_empty {
            if !(self.built && !self.gen_real && self.inst_count == 0) {
                self.make_empty(mut scratch, 0, eff_near)
            } else {
                self.still_frames += 1
            }
            return
        }
        let eff_top = max(h_top * self.cell_scale, eff_near)
        let lip = field.lipschitz(1.0)
        let is_st = steep(field)
        let z_near = d_surf
        let eff_cpx = scratch.cell_px * (if lip > 2.5 { STEEP_CELLS } else { 1.0 })
        let k_px = eff_cpx * (if is_st { 0.80 } else { 1.05 })
        let screen_bricks = (v.size.x / f32(BRICK)) * (v.size.y / f32(BRICK))
        let res_scale = clamp(screen_bricks / 4000.0, 0.65, 1.0)
        let base_budget = if lip > 2.5 {
            15500.0
        } else if is_st {
            16500.0
        } else {
            7200.0
        }
        let area_budget = u32(base_budget * res_scale / (eff_cpx * eff_cpx))
        let px = v.pixel()
        let (need, need_total, need_seams) = build_lod_grids_distance(
            aabb,
            v.at,
            px,
            eff_near,
            eff_top,
            z_near: z_near,
            orig_id: 0,
            k_px: k_px,
            max_parent_span: 128,
            area_budget: area_budget,
            shift: scratch.lattice,
            reach_mult: 1.0,
        )
        // Distance-only cut reuse: if the previous world-anchored fit still covers every ring
        // needed by `v.at`, keep it with zero extraction (pure camera rotation never changes a
        // brick!). Otherwise build a wider distance fit (`FIT_REACH`) around `v.at`.
        let kept_fit = self.lod_fit.len() > 0 && grids_hold(self.lod_fit.clone(), need.clone())
        var grids = take need
        var total_bricks = need_total
        var has_seams = need_seams
        if kept_fit {
            grids = self.lod_fit.clone()
            total_bricks = self.lod_fit_total
            has_seams = false
            for gi in 0..grids.len() {
                if grids[gi].seam_mask != 0 {
                    has_seams = true
                }
            }
        } else if need_seams {
            let (wide, wide_total, wide_seams) = expand_lod_grids(grids.clone())
            if grids_hold(wide.clone(), grids.clone()) {
                grids = take wide
                total_bricks = wide_total
                has_seams = wide_seams
            }
            self.lod_fit_at = v.at
        }
        if !kept_fit {
            self.lod_fit = grids.clone()
            self.lod_fit_total = total_bricks
        }
        let fc = frustum_cull_none()
        if self.built && field_key == self.last_field_key {
            self.static_key_streak += 1
        } else {
            self.static_key_streak = 0
        }
        self.last_field_key = field_key
        var h = Hasher::new()
        field_key.state_hash(mut h)
        grids.len().state_hash(mut h)
        for i in 0..grids.len() {
            let g = grids[i]
            g.dims.x.state_hash(mut h)
            g.dims.y.state_hash(mut h)
            g.dims.z.state_hash(mut h)
            g.cell_offset.x.state_hash(mut h)
            g.cell_offset.y.state_hash(mut h)
            g.cell_offset.z.state_hash(mut h)
            g.seam_mask.state_hash(mut h)
            g.has_hole.state_hash(mut h)
            g.hole_min.x.state_hash(mut h)
            g.hole_min.y.state_hash(mut h)
            g.hole_min.z.state_hash(mut h)
            g.hole_max.x.state_hash(mut h)
            g.hole_max.y.state_hash(mut h)
            g.hole_max.z.state_hash(mut h)
            bitcast_u32(g.cell).state_hash(mut h)
        }
        let key = h.finish()
        if self.built &&
            !self.is_skinned &&
            self.hash == key &&
            !self.budget_short &&
            abs(self.cell - eff_near) <= 0.05 * max(self.cell, 1.0e-4) {
            if self.prev_xforms_dirty {
                copy(from: self.xforms.items(), to: self.prev_xforms.items_mut())
                self.prev_xforms_dirty = false
            }
            self.still_frames += 1
            self.late_streak = 0
            return
        }
        var same_lod_grids = grids.len() == self.edit_grids.len() && grids.len() > 0
        if same_lod_grids {
            for i in 0..grids.len() {
                if grids[i].dims != self.edit_grids[i].dims ||
                    grids[i].cell_offset != self.edit_grids[i].cell_offset ||
                    abs(grids[i].cell - self.edit_grids[i].cell) > 1.0e-5 {
                    same_lod_grids = false
                }
            }
        }
        if same_lod_grids &&
            self.try_patch_dirty(mut scratch, field, key: key, check_cell: eff_near) {
            return
        }
        let is_edited = match field.edit_base_hash() {
            Some(_) => true,
            None => false,
        }
        if self.trans_field_key != field_key {
            self.trans_read = false
            self.trans_ever = false
            self.trans_field_key = field_key
        }
        let opaque_only = !field.field_facts().may_transmit || (self.trans_read && !self.trans_ever)
        let is_static_field = self.static_key_streak >= 1 ||
            (!self.built && std::derive::reads_only_input(|p: vec3| field.distance(p)))
        let use_pool = !is_edited &&
            is_static_field &&
            opaque_only &&
            (has_seams || self.pooled || total_bricks >= 512)
        let count = grids.len()
        // A cut: the eye jumped far or turned sharply since the last extraction.
        self.lod_cut = self.active_hint > 0 &&
            (length(v.at - self.lod_view_at) > 0.35 * max(z_near, 0.01) ||
                dot(v.forward, self.lod_view_fwd) < 0.90)
        if self.lod_cut {
            self.watch_known = false
        }
        self.lod_view_at = v.at
        self.lod_view_fwd = v.forward
        let fbuf = buffer_of([field])
        let cut = grids.clone()
        scratch.set_grids(grids)
        let mid = 0.5 * (aabb.lo + aabb.hi)
        self.bound = vec4(mid, length(aabb.hi - mid))
        write(mut self.xforms, 0, [Rigid::identity()])
        write(mut self.prev_xforms, 0, [Rigid::identity()])
        write(mut self.inst_ids, 0, [0])
        self.prev_xforms_dirty = false
        self.is_skinned = false
        self.is_deformed = false
        self.is_rigid_cached = false
        self.extracted_xform = Rigid::identity()
        self.shape_key = 0
        self.bone_stride = 0
        self.instanced = false
        self.inst_count = 1
        let extract_lip = max(field.lipschitz(max(1.7320508 * eff_top, 1.0)), 1.0)
        if use_pool {
            self.run_pool_update(
                mut scratch,
                fbuf.items(),
                sample: field,
                field_key: field_key,
                cut: cut,
                things: count,
                total_bricks: total_bricks,
                has_seams: has_seams,
                exact_eye: vec4(v.at, v.pixel()),
                lip: extract_lip,
                eye_reach: 1.7320508 * eye_step(d_surf),
            )
        } else {
            self.run_extract(
                mut scratch,
                fbuf.items(),
                sample: field,
                things: count,
                total_bricks: total_bricks,
                inst_count: 1,
                has_seams: has_seams,
                fc: fc,
                extra_bricks: if is_edited { 4096 } else { 0 },
                exact_eye: vec4(v.at, v.pixel()),
                // The bound over the coarsest cell's diagonal, so a thin feature's candidates
                // (`classify_cells`) are kept at every level.
                lip: extract_lip,
                eye_reach: 1.7320508 * eye_step(d_surf),
                field_key: field_key,
            )
        }
        self.lod_cut = false
        self.hash = key
        self.cell = eff_near
        self.built = true
        self.still_frames = 0
        if self.budget_short || self.overflowed() != 0 {
            self.late_streak += 1
            self.late_frames += 1
            if self.late_streak > self.max_late_streak {
                self.max_late_streak = self.late_streak
            }
        } else {
            self.late_streak = 0
        }
        match field.edit_base_hash() {
            Some(bh) => {
                var fh = Hasher::new()
                field.state_hash(mut fh)
                let fb = field.bound()
                self.edit_base_hash = bh
                self.edit_field_hash = fh.finish()
                self.edit_base_bound = vec4(fb.centre, min(fb.radius, 1.0e4))
                self.edit_view_at = v.at
                self.edit_view_fwd = v.forward
                self.edit_grids = take grids
            },
            None => {
                self.edit_base_hash = 0
                self.edit_field_hash = 0
                self.edit_grids = Vec::new()
                // A field whose parts say what they're made of is patched in the bricks of the
                // parts that move (`parts_dirty`).
                match part_states(field) {
                    Some((hs, bs)) => {
                        let fb = field.bound()
                        self.edit_base_bound = vec4(fb.centre, min(fb.radius, 1.0e4))
                        self.edit_view_at = v.at
                        self.edit_view_fwd = v.forward
                        self.edit_grids = take grids
                        self.part_hashes = take hs
                        self.part_boxes = take bs
                    },
                    None => {
                        self.part_hashes = Vec::new()
                        self.part_boxes = Vec::new()
                    },
                }
            },
        }
    }

    /// Extracts a dynamic `Vec<M>` of fields of one type into this shared batch (one draw call for
    /// all items), each item using its own view-adapted cell spacing `asked[i]` (`0.0` skips an item).
    /// When all visible items share a `Skinned` rest-pose template or a rigid local shape, extracts
    /// ONE template mesh once and renders all visible items via GPU instancing (0.000 ms extraction).
    pub fn sync_pool<M: Field<Substance> + StateHash + GpuData>(
        mut self,
        scratch: mut ExtractScratch,
        fields: Vec<M>,
        asked: Vec<f32>,
    ) {
        let n = fields.len()
        var cells: Vec<f32> = Vec::new()
        for i in 0..n {
            cells.push(asked[i] * self.cell_scale)
        }
        var h = Hasher::new()
        var first_cell = 0.0
        var vis_count: u32 = 0
        var all_same_rigid = true
        var shared_sk: u64 = 0
        var best_i: u32 = 0
        var best_local_cell: f32 = 1.0e20
        var all_same_skin = M::MAY_SKIN
        var shared_skin_sk: u64 = 0
        var shared_bc: u32 = 0
        var best_skin_i: u32 = 0
        var best_skin_cell: f32 = 1.0e20
        var wlo = vec3(1.0e20)
        var whi = vec3(-1.0e20)

        for i in 0..n {
            let c = cells[i]
            if c > 0.0 {
                i.state_hash(mut h)
                fields[i].state_hash(mut h)
                if first_cell == 0.0 {
                    first_cell = c
                }
                let b = fields[i].bound()
                let r = min(b.radius, 1.0e4)
                wlo = min(wlo, b.centre - vec3(r))
                whi = max(whi, b.centre + vec3(r))
                if M::MAY_SKIN && all_same_skin {
                    match fields[i].skin_shape_hash() {
                        Some(sk) => {
                            let bc = max(fields[i].skin_bone_count(), 1)
                            if vis_count == 0 {
                                shared_skin_sk = sk
                                shared_bc = bc
                            } else if sk != shared_skin_sk || bc != shared_bc {
                                all_same_skin = false
                            }
                            let rf = fields[i].rigid_frame()
                            let lc = c / max(rf.scale_factor(), 1.0e-4)
                            if lc < best_skin_cell {
                                best_skin_cell = lc
                                best_skin_i = i
                            }
                        },
                        None => {
                            all_same_skin = false
                        },
                    }
                }
                if all_same_rigid {
                    let (rf, maybe_sk) = rigid_key(fields[i])
                    match maybe_sk {
                        Some(sk) => {
                            if vis_count == 0 {
                                shared_sk = sk
                            } else if sk != shared_sk {
                                all_same_rigid = false
                            }
                            let lc = c / max(rf.scale_factor(), 1.0e-4)
                            if lc < best_local_cell {
                                best_local_cell = lc
                                best_i = i
                            }
                        },
                        None => {
                            all_same_rigid = false
                        },
                    }
                }
                vis_count += 1
            }
        }
        let key = h.finish()
        let check_cell = if M::MAY_SKIN && all_same_skin && vis_count > 0 {
            best_skin_cell
        } else if all_same_rigid && vis_count > 0 {
            best_local_cell
        } else {
            first_cell
        }
        if self.built &&
            self.hash == key &&
            !self.budget_short &&
            abs(self.cell - check_cell) <= 0.05 * max(self.cell, 1.0e-4) {
            if self.prev_xforms_dirty {
                copy(from: self.xforms.items(), to: self.prev_xforms.items_mut())
                self.prev_xforms_dirty = false
            }
            if self.prev_bones_dirty {
                copy(from: self.bones.items(), to: self.prev_bones.items_mut())
                self.prev_bones_dirty = false
            }
            self.still_frames += 1
            self.late_streak = 0
            return
        }
        if vis_count == 0 {
            self.make_empty(mut scratch, key, first_cell)
            return
        }

        // Fast path A: all visible items share one `Skinned` rest-pose template -> extract 1
        // rest-pose meshlet once and GPU-instance all `vis_count` articulated characters with DQS!
        if M::MAY_SKIN && all_same_skin {
            let mid = 0.5 * (wlo + whi)
            self.bound = vec4(mid, length(whi - mid))
            var deltas: Vec<Rigid> = Vec::new()
            var ids: Vec<u32> = Vec::new()
            var all_bones: Vec<DualQuat> = Vec::new()
            for i in 0..n {
                if cells[i] > 0.0 {
                    deltas.push(fields[i].rigid_frame())
                    ids.push(i)
                    for b in 0..shared_bc {
                        all_bones.push(fields[i].skin_bone(b))
                    }
                }
            }
            if self.built &&
                self.instanced &&
                self.is_skinned &&
                self.shape_key == shared_skin_sk &&
                self.bone_stride == shared_bc &&
                abs(self.cell - best_skin_cell) <= 0.15 * max(self.cell, 1.0e-4) {
                let _ = self.ensure_xforms(vis_count)
                let _ = self.ensure_bones(vis_count * shared_bc)
                // Last frame's transform and bones of each slot's own thing (the slots may hold
                // other things than last frame's, even when their count is the same).
                write(mut self.prev_xforms, 0, self.matched_prev_xforms(n, ids, deltas))
                write(mut self.prev_bones, 0, self.matched_prev_bones(n, ids, all_bones, shared_bc))
                self.prev_xforms_dirty = true
                self.prev_bones_dirty = true
                write(mut self.xforms, 0, deltas)
                write(mut self.inst_ids, 0, ids)
                write(mut self.bones, 0, all_bones)
                self.cpu_ids = take ids
                self.cpu_xforms = take deltas
                self.cpu_bones = take all_bones
                if vis_count != self.inst_count {
                    label("mesh_extract")
                    dispatch(
                        set_instances.bind(
                            tri_count: self.tri_count.items(),
                            cap_indices: self.cap_indices,
                            cap_trans: self.cap_trans,
                            inst_count: vis_count,
                            args: mut self.draw_args,
                            trans_args: mut self.trans_draw_args,
                            cut_args: mut self.cut_draw_args,
                        ),
                        over: 1,
                    )
                    self.inst_count = vis_count
                }
                self.hash = key
                self.still_frames = 0
                return
            }
            let template = fields[best_skin_i]
            let aabb = tight_aabb_rest(template)
            let g = grid_for(aabb, best_skin_cell, base_brick: 0, orig_id: 0, shift: scratch.lattice)
            let total_bricks = g.dims.x * g.dims.y * g.dims.z
            let fbuf = buffer_of([template])
            scratch.ensure_grids(1)
            write(mut scratch.grids, 0, [g])
            let _ = self.ensure_xforms(vis_count)
            let _ = self.ensure_bones(vis_count * shared_bc)
            write(mut self.xforms, 0, deltas)
            write(mut self.prev_xforms, 0, deltas)
            write(mut self.inst_ids, 0, ids)
            write(mut self.bones, 0, all_bones)
            write(mut self.prev_bones, 0, all_bones)
            self.prev_xforms_dirty = false
            self.prev_bones_dirty = false
            self.cpu_ids = take ids
            self.cpu_xforms = take deltas
            self.cpu_bones = take all_bones
            self.inst_count = vis_count
            self.run_extract_skinned(
                mut scratch,
                fbuf.items(),
                sample: template,
                things: 1,
                total_bricks: total_bricks,
                inst_count: vis_count,
            )
            self.certified = true
            self.extracted_xform = Rigid::identity()
            self.shape_key = shared_skin_sk
            self.is_rigid_cached = false
            self.is_skinned = true
            self.is_deformed = false
            self.bone_stride = shared_bc
            self.instanced = true
            let pad_s = 0.45 * length(aabb.hi - aabb.lo)
            self.template_lo = aabb.lo - vec3(pad_s)
            self.template_hi = aabb.hi + vec3(pad_s)
            self.hash = key
            self.cell = best_skin_cell
            self.built = true
            self.still_frames = 0
            return
        }

        // Fast path B: all visible items share one rigid local shape -> extract 1 template mesh and
        // GPU-instance all `vis_count` items via `self.xforms` (0 ms extraction on motion!).
        if all_same_rigid {
            let mid = 0.5 * (wlo + whi)
            self.bound = vec4(mid, length(whi - mid))
            if self.built &&
                self.instanced &&
                self.is_rigid_cached &&
                self.shape_key == shared_sk &&
                abs(self.cell - best_local_cell) <= 0.15 * max(self.cell, 1.0e-4) {
                var deltas: Vec<Rigid> = Vec::new()
                var ids: Vec<u32> = Vec::new()
                for i in 0..n {
                    if cells[i] > 0.0 {
                        deltas.push(fields[i].rigid_frame().delta_from(self.extracted_xform))
                        ids.push(i)
                    }
                }
                let _ = self.ensure_xforms(vis_count)
                // Last frame's transform of each slot's own thing (see fast path A).
                write(mut self.prev_xforms, 0, self.matched_prev_xforms(n, ids, deltas))
                self.prev_xforms_dirty = true
                write(mut self.xforms, 0, deltas)
                write(mut self.inst_ids, 0, ids)
                self.cpu_ids = take ids
                self.cpu_xforms = take deltas
                if vis_count != self.inst_count {
                    label("mesh_extract")
                    dispatch(
                        set_instances.bind(
                            tri_count: self.tri_count.items(),
                            cap_indices: self.cap_indices,
                            cap_trans: self.cap_trans,
                            inst_count: vis_count,
                            args: mut self.draw_args,
                            trans_args: mut self.trans_draw_args,
                            cut_args: mut self.cut_draw_args,
                        ),
                        over: 1,
                    )
                    self.inst_count = vis_count
                }
                self.hash = key
                self.still_frames = 0
                return
            }
            let template = fields[best_i]
            let template_rf = template.rigid_frame()
            let aabb = tight_aabb(template)
            let g = grid_for(aabb, cells[best_i], base_brick: 0, orig_id: 0, shift: scratch.lattice)
            let total_bricks = g.dims.x * g.dims.y * g.dims.z
            let fbuf = buffer_of([template])
            scratch.ensure_grids(1)
            write(mut scratch.grids, 0, [g])
            var deltas: Vec<Rigid> = Vec::new()
            var ids: Vec<u32> = Vec::new()
            for i in 0..n {
                if cells[i] > 0.0 {
                    deltas.push(fields[i].rigid_frame().delta_from(template_rf))
                    ids.push(i)
                }
            }
            let _ = self.ensure_xforms(vis_count)
            write(mut self.xforms, 0, deltas)
            write(mut self.prev_xforms, 0, deltas)
            write(mut self.inst_ids, 0, ids)
            self.prev_xforms_dirty = false
            self.cpu_ids = take ids
            self.cpu_xforms = take deltas
            self.inst_count = vis_count
            self.run_extract(
                mut scratch,
                fbuf.items(),
                sample: template,
                things: 1,
                total_bricks: total_bricks,
                inst_count: vis_count,
                has_seams: false,
                fc: frustum_cull_none(),
                extra_bricks: 0,
                exact_eye: vec4(0.0),
                lip: 1.0,
            )
            self.extracted_xform = template_rf
            self.shape_key = shared_sk
            self.is_rigid_cached = true
            self.is_skinned = false
            self.is_deformed = false
            self.bone_stride = 0
            self.instanced = true
            self.template_lo = aabb.lo
            self.template_hi = aabb.hi
            self.hash = key
            self.cell = best_local_cell
            self.built = true
            self.still_frames = 0
            return
        }

        // General path: heterogeneous or deforming fields packed into one shared world-space mesh.
        // Pass the full `fields` buffer so each `GridSpec` carries its original index `orig_id = i`
        // directly into `MeshVertex::packed` for exact pixel-rate `fields[orig_id].channels(wp)`,
        // which holds `THING_IDS` of them.
        assert(
            n <= THING_IDS,
            "engine::mesh: a batch of more than THING_IDS things that aren't one shape can't tell its things apart",
        )
        var grids: Vec<GridSpec> = Vec::new()
        var total_bricks: u32 = 0
        var tlo = vec3(1.0e20)
        var thi = vec3(-1.0e20)
        for i in 0..n {
            let c = cells[i]
            if c <= 0.0 {
                continue
            }
            let aabb = if n <= 32 {
                tight_aabb(fields[i])
            } else {
                let b = fields[i].bound()
                let r = min(b.radius, 1.0e4)
                Box3 { lo: b.centre - vec3(r), hi: b.centre + vec3(r) }
            }
            let g = grid_for(aabb, c, base_brick: total_bricks, orig_id: i, shift: scratch.lattice)
            total_bricks += g.dims.x * g.dims.y * g.dims.z
            grids.push(g)
            tlo = min(tlo, aabb.lo)
            thi = max(thi, aabb.hi)
        }
        let count = grids.len()
        let fbuf = buffer_of(fields)
        scratch.set_grids(grids)
        let mid = 0.5 * (tlo + thi)
        self.bound = vec4(mid, length(thi - mid))
        write(mut self.xforms, 0, [Rigid::identity()])
        write(mut self.prev_xforms, 0, [Rigid::identity()])
        write(mut self.inst_ids, 0, [0])
        self.prev_xforms_dirty = false
        self.inst_count = 1
        self.run_extract(
            mut scratch,
            fbuf.items(),
            sample: fields[0],
            things: count,
            total_bricks: total_bricks,
            inst_count: 1,
            has_seams: false,
            fc: frustum_cull_none(),
            extra_bricks: 0,
            exact_eye: vec4(0.0),
            lip: 1.0,
        )
        self.extracted_xform = Rigid::identity()
        self.shape_key = 0
        self.is_rigid_cached = false
        self.is_skinned = false
        self.is_deformed = false
        self.bone_stride = 0
        self.instanced = false
        self.hash = key
        self.cell = first_cell
        self.built = true
        self.still_frames = 0
    }

    /// The box of the parts of `field` whose state moved since the last extraction, each part's
    /// old box and new, or none where the batch kept no part states, every part moved, none did,
    /// or a part can't say what it's made of. Keeps the new states on an answer.
    /// The box the parts whose state moved since the last extraction cover, old and new
    /// (`part_states`), with the parts' new hashes and boxes: none when no part moved, when all
    /// did, or when the field's parts can't say. Nothing is kept here: the caller keeps the new
    /// state only once the patch it makes of them is drawn (`try_patch_dirty`), so a patch that
    /// falls back to a whole extraction leaves the state the drawn mesh was made from.
    fn parts_dirty<M: Field<Substance>>(self, field: M) -> Option<(Box3, Vec<u64>, Vec<Box3>)> {
        let n = self.part_hashes.len()
        if n == 0 {
            return None
        }
        let (hs, bs) = part_states(field)?
        if hs.len() != n {
            return None
        }
        var moved: u32 = 0
        var lo = vec3(1.0e30)
        var hi = vec3(-1.0e30)
        for i in 0..n {
            if hs[i] != self.part_hashes[i] {
                moved += 1
                lo = min(lo, min(bs[i].lo, self.part_boxes[i].lo))
                hi = max(hi, max(bs[i].hi, self.part_boxes[i].hi))
            }
        }
        if moved == 0 || moved == n {
            return None
        }
        Some((Box3 { lo, hi }, hs, bs))
    }

    /// Attempts an in-place dirty-region CSG patch for an `Edited<M>` field whose base solid
    /// matches `self.edit_base_hash`: invalidates only the existing bricks inside the exact
    /// integer brick range overlapping the padded `dirty_region()`, extracts only those dirty
    /// bricks on the exact same cell lattice, and appends them at 64-aligned `edit_append_cursor`
    /// (`< 0.15 ms` on GPU). Returns `true` if patched in place, or `false` to fall back to a
    /// compact full rebuild.
    /// (A batch knows its drawn extraction has no transmissive triangles only when its counts
    /// are read back, a frame or more late, and a field that moves every frame is extracted again
    /// before; so a batch none of whose read counts held any, or a kind whose facts say it can't
    /// transmit, is patched.)
    fn try_patch_dirty<M: Field<Substance> + StateHash + GpuData>(
        mut self,
        scratch: mut ExtractScratch,
        field: M,
        key: u64,
        check_cell: f32,
    ) -> bool {
        self.finish_poll()
        if !self.built ||
            !self.has_brick_draws ||
            self.instanced ||
            self.is_skinned ||
            (self.has_trans && (self.trans_ever || !self.trans_read) && field.field_facts().may_transmit) ||
            self.edit_grids.len() == 0 {
            return false
        }
        if abs(self.cell - check_cell) > 0.10 * max(self.cell, 1.0e-4) {
            return false
        }
        // An edit's dirty region on an unchanged base, or the boxes, old and new, of the parts
        // whose state moved (the others' cells are the same), and the parts' new state, kept
        // once the patch is made.
        var new_parts: Option<(Vec<u64>, Vec<Box3>)> = None
        let dirty_box = match field.edit_base_hash() {
            Some(bh) => {
                if bh != self.edit_base_hash {
                    return false
                }
                match field.dirty_region() {
                    Some(bx) => bx,
                    None => {
                        return false
                    },
                }
            },
            None => match self.parts_dirty(field) {
                Some((bx, hs, bs)) => {
                    new_parts = Some((take hs, take bs))
                    bx
                },
                None => {
                    return false
                },
            },
        }
        let g0 = self.edit_grids[0]
        let step0 = f32(BRICK) * g0.cell
        let g0_lo = g0.origin +
            vec3(f32(g0.cell_offset.x), f32(g0.cell_offset.y), f32(g0.cell_offset.z)) * g0.cell
        let g0_hi = g0_lo + vec3(f32(g0.dims.x), f32(g0.dims.y), f32(g0.dims.z)) * step0
        let fb = field.bound()
        let fr = min(fb.radius, 1.0e4)
        let grew = fr > self.edit_base_bound.w + 1.0e-3 ||
            length(fb.centre - self.edit_base_bound.xyz) > 1.0e-3
        if grew &&
            (dirty_box.lo.x < g0_lo.x ||
                dirty_box.lo.y < g0_lo.y ||
                dirty_box.lo.z < g0_lo.z ||
                dirty_box.hi.x > g0_hi.x ||
                dirty_box.hi.y > g0_hi.y ||
                dirty_box.hi.z > g0_hi.z) {
            return false
        }

        var sub_grids: Vec<GridSpec> = Vec::new()
        var clear_targets: Vec<u32> = Vec::new()
        var clear_los: Vec<vec3> = Vec::new()
        var clear_his: Vec<vec3> = Vec::new()
        var patch_total: u32 = 0
        for gi in 0..self.edit_grids.len() {
            let g = self.edit_grids[gi]
            let step = f32(BRICK) * g.cell
            let g_lo = g.origin +
                vec3(f32(g.cell_offset.x), f32(g.cell_offset.y), f32(g.cell_offset.z)) * g.cell
            let dlo = dirty_box.lo - vec3(2.0 * g.cell)
            let dhi = dirty_box.hi + vec3(2.0 * g.cell)
            let bmin_x = u32(clamp(floor((dlo.x - g_lo.x) / step), 0.0, f32(g.dims.x)))
            let bmin_y = u32(clamp(floor((dlo.y - g_lo.y) / step), 0.0, f32(g.dims.y)))
            let bmin_z = u32(clamp(floor((dlo.z - g_lo.z) / step), 0.0, f32(g.dims.z)))
            let bmax_x = u32(clamp(floor((dhi.x - g_lo.x) / step) + 1.0, 0.0, f32(g.dims.x)))
            let bmax_y = u32(clamp(floor((dhi.y - g_lo.y) / step) + 1.0, 0.0, f32(g.dims.y)))
            let bmax_z = u32(clamp(floor((dhi.z - g_lo.z) / step) + 1.0, 0.0, f32(g.dims.z)))
            if bmin_x >= bmax_x || bmin_y >= bmax_y || bmin_z >= bmax_z {
                continue
            }
            if self.has_seams {
                if g.seam_mask != 0 &&
                    (bmin_x == 0 ||
                        bmax_x == g.dims.x ||
                        bmin_y == 0 ||
                        bmax_y == g.dims.y ||
                        bmin_z == 0 ||
                        bmax_z == g.dims.z) {
                    return false
                }
                if g.has_hole != 0 {
                    let hmin_x = if g.hole_min.x > 0 { g.hole_min.x - 1 } else { 0 }
                    let hmin_y = if g.hole_min.y > 0 { g.hole_min.y - 1 } else { 0 }
                    let hmin_z = if g.hole_min.z > 0 { g.hole_min.z - 1 } else { 0 }
                    let hmax_x = g.hole_max.x + 1
                    let hmax_y = g.hole_max.y + 1
                    let hmax_z = g.hole_max.z + 1
                    if bmax_x > hmin_x &&
                        bmin_x < hmax_x &&
                        bmax_y > hmin_y &&
                        bmin_y < hmax_y &&
                        bmax_z > hmin_z &&
                        bmin_z < hmax_z {
                        return false
                    }
                }
            }
            let dims = vec3u(bmax_x - bmin_x, bmax_y - bmin_y, bmax_z - bmin_z)
            let count = dims.x * dims.y * dims.z
            sub_grids.push(
                GridSpec {
                    origin: g.origin,
                    cell: g.cell,
                    dims: dims,
                    base_brick: patch_total,
                    orig_id: g.orig_id,
                    cell_offset: g.cell_offset +
                        vec3u(bmin_x * BRICK, bmin_y * BRICK, bmin_z * BRICK),
                    parent_grid: gi,
                    seam_mask: 0,
                    has_hole: 0,
                    pad0: 0,
                    hole_min: vec3u(0, 0, 0),
                    pad1: 0,
                    hole_max: vec3u(0, 0, 0),
                    pad2: 0,
                    parent_hole_min: vec3u(0, 0, 0),
                    pad3: 0,
                    shift: g.shift,
                    pad4: 0,
                },
            )
            clear_targets.push(gi)
            clear_los.push(g_lo + vec3(f32(bmin_x), f32(bmin_y), f32(bmin_z)) * step)
            clear_his.push(g_lo + vec3(f32(bmax_x), f32(bmax_y), f32(bmax_z)) * step)
            patch_total += count
        }

        if patch_total == 0 {
            self.keep_parts(take new_parts)
            self.hash = key
            return true
        }
        // A patch meshes every brick its cut may reach, or none: one that met more than it meshes
        // left the rest unmeshed on the cut's frame (SCENE 6's column cut while seen: 8,238 cracks
        // on that frame, gone once a readback re-extracted it), so a larger cut is re-extracted
        // whole.
        if patch_total > min(PATCH_MOST, scratch.max_bricks) {
            return false
        }
        let patch_cap = patch_total
        let dst_base = self.edit_append_cursor
        let est_slots = dst_base + patch_cap
        if est_slots > self.cap_brick_draws {
            return false
        }
        if self.verts_known > 0 {
            if self.verts_known + min(patch_cap, 512) * self.verts_per_brick > self.cap_verts {
                return false
            }
        } else if est_slots * self.verts_per_brick > self.cap_verts {
            return false
        }
        if est_slots * self.indices_per_brick > self.cap_indices {
            return false
        }

        label("mesh_extract")
        if self.watched {
            // The last frame's outline cells go; the patch's own follow the extraction's.
            self.exact_cells.count_from(self.exact_base.items())
        }
        let n_sub = sub_grids.len()
        let fbuf = buffer_of([field])
        scratch.ensure_grids(n_sub)
        write(mut scratch.grids, 0, sub_grids)
        let grids = scratch.grids.items()

        // 1. Invalidate existing bricks inside the exact dirty brick box (`< 5 µs`).
        if self.cpu_brick_slots > 0 {
            for ci in 0..clear_targets.len() {
                dispatch(
                    reset_dirty_bricks.bind(
                        brick_bounds: self.brick_bounds.items(),
                        clear_lo: clear_los[ci],
                        clear_hi: clear_his[ci],
                        target_grid: clear_targets[ci],
                        live_slots: self.cpu_brick_slots,
                        brick_draws: self.brick_draws.span_mut(
                            start: 0,
                            count: self.cpu_brick_slots,
                        ),
                        brick_alive: mut self.brick_alive,
                        indices: mut self.indices,
                    ),
                    over: self.cpu_brick_slots,
                )
            }
        }

        // 2. Cull & extract ONLY the dirty sub-grid bricks in bounded chunks and append at `dst_base`.
        write(mut self.patch_slot_base, 0, [dst_base])
        scratch.active.clear()
        let cull_most = lane_slice(
            kernel_work(cull_bricks.bind(
                fields: fbuf.items(),
                grids: grids,
                things: n_sub,
                first_brick: 0,
                total_bricks: patch_total,
                fc: frustum_cull_none(),
                active: mut scratch.active,
            )),
            most: CULL_CHUNK,
        )
        var c_first: u32 = 0
        while c_first < patch_total {
            let cn = min(patch_total - c_first, cull_most)
            dispatch(
                cull_bricks.bind(
                    fields: fbuf.items(),
                    grids: grids,
                    things: n_sub,
                    first_brick: c_first,
                    total_bricks: patch_total,
                    fc: frustum_cull_none(),
                    active: mut scratch.active,
                ),
                over: cn,
            )
            c_first += cn
        }
        var chunk_start: u32 = 0
        scratch.cert_cands.clear()
        while chunk_start < patch_cap {
            let chunk_n = min(patch_cap - chunk_start, CHUNK_BRICKS)
            let eval_slices = (chunk_n + self.eval_slice - 1) / self.eval_slice
            let quad_slices = (chunk_n + self.quad_slice - 1) / self.quad_slice
            let chunk_slices = max(eval_slices, quad_slices)
            dispatch(
                prep_chunk.bind(
                    active_count: scratch.active.count(),
                    cap_bricks: patch_cap,
                    chunk_start: chunk_start,
                    eval_slice: self.eval_slice,
                    quad_slice: self.quad_slice,
                    vert_args: mut scratch.vert_args,
                    eval_args: scratch.eval_args.span_mut(start: 0, count: chunk_slices),
                    quad_args: scratch.quad_args.span_mut(start: 0, count: chunk_slices),
                ),
                over: chunk_slices,
            )
            for e in 0..eval_slices {
                dispatch(
                    eval_corners.bind(
                        fields: fbuf.items(),
                        grids: grids,
                        active: scratch.active.items(),
                        active_count: scratch.active.count(),
                        cap_bricks: patch_cap,
                        chunk_start: chunk_start,
                        brick_off: e * self.eval_slice,
                        corners: scratch.corners.span_mut(
                            start: e * self.eval_slice * CORNERS_BRICK,
                            count: min(chunk_n - e * self.eval_slice, self.eval_slice) * CORNERS_BRICK,
                        ),
                    ),
                    groups: scratch.eval_args.at(e),
                    most: min(chunk_n - e * self.eval_slice, self.eval_slice) * 8,
                )
            }
            scratch.creases.clear()
            scratch.surf.clear()
            if self.watched {
                dispatch(
                    keep_slots.bind(
                        grids: grids,
                        active: scratch.active.items(),
                        active_count: scratch.active.count(),
                        cap_bricks: patch_cap,
                        chunk_start: chunk_start,
                        slot_base: self.patch_slot_base.items(),
                        max_slots: self.watch_slots_cap,
                        slots: mut self.slot_bricks,
                        bits: mut self.watch_bits,
                    ),
                    over: chunk_n,
                )
            }
            dispatch(
                classify_cells.bind(
                    grids: grids,
                    active: scratch.active.items(),
                    active_count: scratch.active.count(),
                    cap_bricks: patch_cap,
                    chunk_start: chunk_start,
                    lip: self.exact_lip,
                    held: if (self.exact_eye).w > 0.0 { 1 } else { 0 },
                    slot_base: self.patch_slot_base.items(),
                    max_slots: self.watch_slots_cap,
                    corners: scratch.corners.items(),
                    cell_verts: scratch.cell_verts.span_mut(
                        start: 0,
                        count: chunk_n * VERTS_STRIDE,
                    ),
                    exact_seen: mut scratch.exact_seen,
                    surf: mut scratch.surf,
                    watch_bits: mut self.watch_bits,
                    thin_keep: mut self.thin_keep,
                ),
                groups: scratch.vert_args.at(0),
                most: chunk_n * 6,
            )
            let surf_slice = self.surf_slice
            let surf_slices = min((chunk_n * VERTS_BRICK + surf_slice - 1) / surf_slice, SLICES_MOST)
            dispatch(
                prep_slices.bind(
                    count: scratch.surf.count(),
                    cap: CAP_SURF,
                    most: surf_slice,
                    slices: surf_slices,
                    args: scratch.surf_args.span_mut(start: 0, count: surf_slices),
                ),
                over: surf_slices,
            )
            for k in 0..surf_slices {
                dispatch(
                    solve_verts.bind(
                        fields: fbuf.items(),
                        grids: grids,
                        active: scratch.active.items(),
                        chunk_start: chunk_start,
                        corners: scratch.corners.items(),
                        surf: scratch.surf.items(),
                        surf_count: scratch.surf.count(),
                        first: k * surf_slice,
                        cap_verts: self.cap_verts,
                        cell_verts: mut scratch.cell_verts,
                        verts: mut self.verts,
                        creases: mut scratch.creases,
                    ),
                    groups: scratch.surf_args.at(k),
                    most: surf_slice / 64,
                )
            }
            let c_slice = self.crease_slice
            let crease_slices = clamp(
                (chunk_n * VERTS_BRICK + c_slice - 1) / c_slice,
                1,
                min(max(4, (65536 + c_slice - 1) / c_slice), SLICES_MOST),
            )
            dispatch(
                prep_creases.bind(
                    count: scratch.creases.count(),
                    slices: crease_slices,
                    slice: c_slice,
                    args: scratch.crease_args.span_mut(start: 0, count: crease_slices),
                    seen: mut self.tri_count,
                ),
                over: crease_slices,
            )
            for k in 0..crease_slices {
                for pass in 0..self.crease_passes {
                    dispatch(
                        refine_creases.bind(
                            fields: fbuf.items(),
                            grids: grids,
                            active: scratch.active.items(),
                            chunk_start: chunk_start,
                            corners: scratch.corners.items(),
                            creases: scratch.creases.items(),
                            crease_count: scratch.creases.count(),
                            first: k * c_slice,
                            pass: pass,
                            solves: mut scratch.crease_solves,
                            cap_verts: self.cap_verts,
                            cell_verts: mut scratch.cell_verts,
                            verts: mut self.verts,
                        ),
                        groups: scratch.crease_args.at(k),
                        most: c_slice / 64,
                    )
                }
            }
            dispatch(
                zero_chunk_counts.bind(
                    counts: scratch.brick_idx_counts.span_mut(start: 0, count: chunk_n),
                    cursors: scratch.brick_idx_cursor.span_mut(start: 0, count: chunk_n),
                ),
                over: chunk_n,
            )
            for q in 0..quad_slices {
                dispatch(
                    count_brick_tris.bind(
                        active_count: scratch.active.count(),
                        cap_bricks: patch_cap,
                        chunk_start: chunk_start,
                        brick_off: q * self.quad_slice,
                        corners: scratch.corners.items(),
                        cell_verts: scratch.cell_verts.items(),
                        verts: self.verts.items(),
                        brick_idx_counts: mut scratch.brick_idx_counts,
                    ),
                    groups: scratch.quad_args.at(q),
                    most: min(chunk_n - q * self.quad_slice, self.quad_slice) * 4,
                )
            }
            scan_chunk_offsets(
                scratch.active.count(),
                scratch.brick_idx_counts.items(),
                mut scratch.group_sums,
                mut scratch.group_offsets,
                mut scratch.brick_idx_offsets,
                mut self.tri_count,
                cap_bricks: patch_cap,
                chunk_start: chunk_start,
                chunk_n: chunk_n,
            )
            let meta_dst = dst_base + chunk_start
            dispatch(
                write_brick_meta.bind(
                    grids: grids,
                    active: scratch.active.items(),
                    active_count: scratch.active.count(),
                    cap_bricks: patch_cap,
                    cap_indices: self.cap_indices,
                    inst_count: 1,
                    chunk_start: chunk_start,
                    use_parent_tag: 1,
                    brick_idx_saved: scratch.brick_idx_counts.items(),
                    brick_idx_offsets: scratch.brick_idx_offsets.items(),
                    brick_bounds: self.brick_bounds.span_mut(start: meta_dst, count: chunk_n),
                    brick_draws: self.brick_draws.span_mut(start: meta_dst, count: chunk_n),
                    brick_alive: self.brick_alive.span_mut(start: meta_dst, count: chunk_n),
                ),
                over: chunk_n,
            )
            for q in 0..quad_slices {
                dispatch(
                    emit_tris.bind(
                        grids: grids,
                        active: scratch.active.items(),
                        active_count: scratch.active.count(),
                        cap_bricks: patch_cap,
                        cap_indices: self.cap_indices,
                        cap_trans: self.cap_trans,
                        chunk_start: chunk_start,
                        brick_off: q * self.quad_slice,
                        held: if (self.exact_eye).w > 0.0 { 1 } else { 0 },
                        slot_base: self.patch_slot_base.items(),
                        max_slots: self.watch_slots_cap,
                        cap_exact_slots: 0,
                        corners: scratch.corners.items(),
                        cell_verts: scratch.cell_verts.items(),
                        verts: self.verts.items(),
                        brick_idx_offsets: scratch.brick_idx_offsets.items(),
                        brick_idx_counts: mut scratch.brick_idx_cursor,
                        tri_count: mut self.tri_count,
                        indices: mut self.indices,
                        trans_indices: mut self.trans_indices,
                        cut_indices: mut self.cut_indices,
                        exact_seen: mut scratch.exact_seen,
                        exact_cells: mut self.exact_cells,
                        exact_slots: mut scratch.dummy_exact_slots,
                        quad_recs: mut self.quad_recs,
                    ),
                    groups: scratch.quad_args.at(q),
                    most: min(chunk_n - q * self.quad_slice, self.quad_slice) * 4,
                )
            }
            chunk_start += chunk_n
        }
        dispatch(
            finish_draw_patch.bind(
                dst_base: dst_base,
                patch_active_count: scratch.active.count(),
                vert_count: self.verts.count(),
                cap_indices: self.cap_indices,
                cap_trans: self.cap_trans,
                inst_count: 1,
                tri_count: mut self.tri_count,
                args: mut self.draw_args,
                trans_args: mut self.trans_draw_args,
                cut_args: mut self.cut_draw_args,
            ),
            over: 1,
        )
        if self.exact_eye.w > 0.0 {
            dispatch(
                set_exact_args.bind(
                    exact_count: self.exact_cells.count(),
                    cap_exact: self.cap_exact,
                    tri_count: mut self.tri_count,
                    exact_args: mut self.exact_draw_args,
                ),
                over: 1,
            )
        }
        if self.watched {
            copy(from: self.exact_cells.count().sub(start: 0, count: 1), to: self.exact_base.items_mut())
        }
        self.edit_patched = true
        self.cpu_brick_slots = est_slots
        self.edit_append_cursor = ((est_slots + 63) / 64) * 64
        self.extract_total = patch_total
        self.extract_limit = est_slots
        self.note_extracted(true)
        self.keep_parts(take new_parts)
        self.hash = key
        self.still_frames = 0
        true
    }

    /// Keeps the parts' state a patch was made from (`parts_dirty`), once it is made.
    fn keep_parts(mut self, parts: take Option<(Vec<u64>, Vec<Box3>)>) {
        match take parts {
            Some((hs, bs)) => {
                self.part_hashes = take hs
                self.part_boxes = take bs
            },
            None => {},
        }
    }

    fn run_extract<M: Field<Substance>>(
        mut self,
        scratch: mut ExtractScratch,
        fields: GpuSpan<M>,
        sample: M,
        things: u32,
        total_bricks: u32,
        inst_count: u32,
        has_seams: bool,
        fc: FrustumCull,
        extra_bricks: u32,
        exact_eye: vec4,
        lip: f32,
        eye_reach: f32 = 0.0,
        field_key: u64 = 0,
    ) {
        label("mesh_extract")
        let step = crease_step_cost_of(sample)
        // A crease slice is as many cells as the kernel's own bound (`kernel_work`) lets a
        // dispatch hold: this batch's kernels, bound as they're dispatched.
        let crease_kernel = refine_creases.bind(
            fields: fields,
            grids: scratch.grids.items(),
            active: scratch.active.items(),
            chunk_start: 0,
            corners: scratch.corners.items(),
            creases: scratch.creases.items(),
            crease_count: scratch.creases.count(),
            first: 0,
            pass: 0,
            solves: mut scratch.crease_solves,
            cap_verts: self.cap_verts,
            cell_verts: mut scratch.cell_verts,
            verts: mut self.verts,
        )
        self.crease_slice = crease_slice(kernel_work(crease_kernel))
        let seam_kernel = refine_seam_creases.bind(
            fields: fields,
            grids: scratch.grids.items(),
            seam_cells: scratch.seam_cells.items(),
            seam_creases: scratch.seam_creases.items(),
            seam_crease_count: scratch.seam_creases.count(),
            first: 0,
            pass: 0,
            solves: mut scratch.crease_solves,
            cap_verts: self.cap_verts,
            verts: mut self.verts,
            seam_verts: mut scratch.seam_verts,
        )
        self.seam_crease_slice = crease_slice(kernel_work(seam_kernel))
        self.crease_passes = crease_passes(crease_part(step))
        let surf_kernel = solve_verts.bind(
            fields: fields,
            grids: scratch.grids.items(),
            active: scratch.active.items(),
            chunk_start: 0,
            corners: scratch.corners.items(),
            surf: scratch.surf.items(),
            surf_count: scratch.surf.count(),
            first: 0,
            cap_verts: self.cap_verts,
            cell_verts: mut scratch.cell_verts,
            verts: mut self.verts,
            creases: mut scratch.creases,
        )
        self.surf_slice = surf_slice(kernel_work(surf_kernel))
        // The seams' cells' and corners' slices, as their kernels' own bounds let a dispatch hold.
        self.seam_slice = min(
            lane_slice(
                kernel_work(solve_seam_smooth.bind(
                    fields: fields,
                    grids: scratch.grids.items(),
                    seam_cells: scratch.seam_cells.items(),
                    seam_cell_count: scratch.seam_cells.count(),
                    first: 0,
                    cap_verts: self.cap_verts,
                    verts: mut self.verts,
                    seam_verts: mut scratch.seam_verts,
                    seam_creases: mut scratch.seam_creases,
                )),
                most: SEAM_SLICE,
            ),
            lane_slice(
                kernel_work(box_seam_cells.bind(
                    fields: fields,
                    grids: scratch.grids.items(),
                    seam_cells: scratch.seam_cells.items(),
                    seam_cell_count: scratch.seam_cells.count(),
                    first: 0,
                    seam_seen: mut scratch.seam_seen,
                    exact_cells: mut self.exact_cells,
                )),
                most: SEAM_SLICE,
            ),
        )
        self.inherit_slice = min(
            brick_slice(lanes: 512, invocation: kernel_work(inherit_seam_corners.bind(
                fields: fields,
                grids: scratch.grids.items(),
                active: scratch.active.items(),
                active_count: scratch.active.count(),
                cap_bricks: self.max_bricks,
                chunk_start: 0,
                brick_off: 0,
                corners_in: scratch.corners_raw.items(),
                corners_out: scratch.corners.span_mut(start: 0, count: CORNERS_BRICK),
            ))),
            CHUNK_BRICKS,
        )
        // A chunk's corner and triangle dispatches take as many bricks as their kernel's own
        // bound lets a dispatch hold (`brick_slice`).
        self.eval_slice = brick_slice(
            lanes: 512,
            invocation: kernel_work(eval_corners.bind(
                fields: fields,
                grids: scratch.grids.items(),
                active: scratch.active.items(),
                active_count: scratch.active.count(),
                cap_bricks: self.max_bricks,
                chunk_start: 0,
                brick_off: 0,
                corners: scratch.corners.span_mut(start: 0, count: CORNERS_BRICK),
            )),
        )
        self.quad_slice = if has_seams {
            brick_slice(lanes: 256, invocation: kernel_work(emit_tris_lod.bind(
                grids: scratch.grids.items(),
                active: scratch.active.items(),
                active_count: scratch.active.count(),
                cap_bricks: self.max_bricks,
                cap_indices: self.cap_indices,
                cap_trans: self.cap_trans,
                chunk_start: 0,
                brick_off: 0,
                corners: scratch.corners.items(),
                cell_verts: scratch.cell_verts.items(),
                verts: self.verts.items(),
                brick_idx_offsets: scratch.brick_idx_offsets.items(),
                brick_idx_counts: mut scratch.brick_idx_cursor,
                tri_count: mut self.tri_count,
                indices: mut self.indices,
                trans_indices: mut self.trans_indices,
                cut_indices: mut self.cut_indices,
                seam_quads: mut scratch.seam_quads,
                seam_cells: mut scratch.seam_cells,
                seam_verts: mut scratch.seam_verts,
                held: if (exact_eye).w > 0.0 { 1 } else { 0 },
                slot_base: scratch.zero_u32.items(),
                max_slots: self.watch_slots_cap,
                cap_exact_slots: 0,
                exact_seen: mut scratch.exact_seen,
                exact_cells: mut self.exact_cells,
                exact_slots: mut scratch.dummy_exact_slots,
                quad_recs: mut self.quad_recs,
            )))
        } else {
            brick_slice(lanes: 256, invocation: kernel_work(emit_tris.bind(
                grids: scratch.grids.items(),
                active: scratch.active.items(),
                active_count: scratch.active.count(),
                cap_bricks: self.max_bricks,
                cap_indices: self.cap_indices,
                cap_trans: self.cap_trans,
                chunk_start: 0,
                brick_off: 0,
                held: if (exact_eye).w > 0.0 { 1 } else { 0 },
                slot_base: scratch.zero_u32.items(),
                max_slots: self.watch_slots_cap,
                cap_exact_slots: 0,
                corners: scratch.corners.items(),
                cell_verts: scratch.cell_verts.items(),
                verts: self.verts.items(),
                brick_idx_offsets: scratch.brick_idx_offsets.items(),
                brick_idx_counts: mut scratch.brick_idx_cursor,
                tri_count: mut self.tri_count,
                indices: mut self.indices,
                trans_indices: mut self.trans_indices,
                cut_indices: mut self.cut_indices,
                exact_seen: mut scratch.exact_seen,
                exact_cells: mut self.exact_cells,
                exact_slots: mut scratch.dummy_exact_slots,
                quad_recs: mut self.quad_recs,
            )))
        }
        let uses_kept = sample.uses_kept()
        if uses_kept {
            self.keep_slice = keep_slice_of(sample)
        }
        // Size this batch's output buffers for every candidate brick (active ones are a subset),
        // plus optional CSG patch headroom when `extra_bricks > 0`.
        let use_exact = exact_eye.w > 0.0
        let est_cap = min(min(total_bricks + extra_bricks, self.max_bricks), scratch.max_bricks)
        let wanted = self.chunk_limit(total_bricks, min(est_cap, total_bricks))
        // A chunk's slots are written (`keep_slots`, and its cells' bits cleared, `clear_slot_out`)
        // where the mesh is held; its outline is found each frame (`watch`).
        let exact_indirect: u32 = if use_exact { 2 } else { 0 }
        let surf_per_chunk = min(
            (CHUNK_BRICKS * VERTS_BRICK + self.surf_slice - 1) / self.surf_slice,
            SLICES_MOST,
        )
        let keep_per_chunk = if uses_kept {
            min((CHUNK_BRICKS * VERTS_BRICK + self.keep_slice - 1) / self.keep_slice, SLICES_MOST)
        } else {
            0
        }
        let eval_per_chunk = (CHUNK_BRICKS + self.eval_slice - 1) / self.eval_slice
        let quad_per_chunk = (CHUNK_BRICKS + self.quad_slice - 1) / self.quad_slice
        let per_chunk = CHUNK_INDIRECT +
            (surf_per_chunk - 1) +
            (eval_per_chunk - 1) +
            2 * (quad_per_chunk - 1) +
            keep_per_chunk +
            exact_indirect +
            self.crease_slices(CHUNK_BRICKS) * self.crease_passes
        let seam_c_slice = min(SEAM_SLICE, self.seam_crease_slice)
        let seam_c_slices = if has_seams {
            min((self.seam_slices() * self.seam_slice + seam_c_slice - 1) / seam_c_slice, SLICES_MOST)
        } else {
            0
        }
        let seam_keep_slices = if has_seams && uses_kept {
            min((self.seam_slices() * self.seam_slice + self.keep_slice - 1) / self.keep_slice, SLICES_MOST)
        } else {
            0
        }
        let seam_indirect: u32 = if !has_seams {
            0
        } else if use_exact {
            2 * self.seam_slices() + seam_c_slices * self.crease_passes + seam_keep_slices + 1
        } else {
            self.seam_slices() + seam_c_slices * self.crease_passes + seam_keep_slices + 1
        }
        let cert_indirect: u32 = 0
        let super_sub_k = cull_bricks_sub.bind(
            fields: fields,
            grids: scratch.grids.items(),
            super_active: scratch.super_active.items(),
            super_count: scratch.super_active.count(),
            cap_super: 65536,
            first: 0,
            fc: fc,
            active: mut scratch.active,
        )
        let super_sub_slice = max(
            u32(clamp(
                f32(limits().step_work) * 1000.0 / (64.0 * (f32(kernel_work(super_sub_k)) + 2000.0)),
                1.0,
                4096.0,
            )),
            1,
        )
        let super_slices = if scratch.total_super > 0 {
            min((scratch.total_super + super_sub_slice - 1) / super_sub_slice, SLICES_MOST)
        } else {
            0
        }
        let use_super = total_bricks >= 512 &&
            scratch.total_super > 0 &&
            scratch.total_super <= 65536 &&
            super_slices * super_sub_slice >= scratch.total_super
        let super_indirect: u32 = if use_super { super_slices } else { 0 }
        let fixed_indirect = seam_indirect + cert_indirect + super_indirect
        let avail_after_fixed = if scratch.indirect_left > fixed_indirect {
            scratch.indirect_left - fixed_indirect
        } else {
            0
        }
        let fit = max(avail_after_fixed / per_chunk, 1)
        let hard_cap = min(wanted, fit * CHUNK_BRICKS)
        let would_short = hard_cap < wanted
        // What a frame's whole budget meshes, were this batch alone in it.
        let alone = if EXTRACT_INDIRECT > fixed_indirect {
            max((EXTRACT_INDIRECT - fixed_indirect) / per_chunk, 1) * CHUNK_BRICKS
        } else {
            CHUNK_BRICKS
        }
        // A certified mesh isn't replaced by an extraction cut short: it is kept, and the
        // extraction made whole a later frame, when the batches before it have settled. That
        // holds only for an extraction a frame can hold at all: one sized past a frame's whole
        // budget (after a cut, its candidates past what the last readback found and so sized for
        // all of them) would wait for ever, never read back to size it again (the Radeon's glass
        // barrage, an eye held unsettled at 12 frames). That one meshes what fits now, and its
        // counts, read back, size the next to what the surface holds.
        self.last_wanted = wanted
        self.last_alone = alone
        self.last_per_chunk = per_chunk
        if would_short && self.built && self.certified && wanted <= alone {
            self.budget_short = true
            return
        }
        self.exact_eye = exact_eye
        self.eye_reach = eye_reach
        self.exact_lip = lip
        self.ensure_cap(min(total_bricks + extra_bricks, self.max_bricks))
        if uses_kept {
            self.ensure_vert_kept(self.cap_verts)
        }
        if use_exact {
            self.ensure_exact_cap(max(self.cap_exact, 16384))
        }
        self.watched = use_exact

        let effective_cap = min(self.cap_bricks, scratch.max_bricks)
        scratch.active.clear()
        self.verts.clear()
        self.exact_cells.clear()
        write(mut self.tri_count, 0, Vec::filled(TRI_WORDS, 0))
        if has_seams {
            scratch.seam_quads.clear()
            scratch.seam_cells.clear()
            scratch.seam_creases.clear()
        }

        let grids = scratch.grids.items()

        // Pass 0: Interval-cull bricks (2-level 4×4×4 super-bricks on large grids, else flat).
        if use_super {
            scratch.super_active.clear()
            let super_most = lane_slice(
                kernel_work(super_cull_bricks.bind(
                    fields: fields,
                    grids: grids,
                    super_grids: scratch.super_grids.items(),
                    things: things,
                    first_super: 0,
                    total_super: scratch.total_super,
                    fc: fc,
                    super_active: mut scratch.super_active,
                )),
                most: CULL_CHUNK,
            )
            var s_first: u32 = 0
            while s_first < scratch.total_super {
                let sn = min(scratch.total_super - s_first, super_most)
                dispatch(
                    super_cull_bricks.bind(
                        fields: fields,
                        grids: grids,
                        super_grids: scratch.super_grids.items(),
                        things: things,
                        first_super: s_first,
                        total_super: scratch.total_super,
                        fc: fc,
                        super_active: mut scratch.super_active,
                    ),
                    over: sn,
                )
                s_first += sn
            }
            dispatch(
                prep_super_sub.bind(
                    super_count: scratch.super_active.count(),
                    cap_super: 65536,
                    most: super_sub_slice,
                    slices: super_slices,
                    args: scratch.super_args.span_mut(start: 0, count: super_slices),
                ),
                over: super_slices,
            )
            for sk in 0..super_slices {
                dispatch(
                    cull_bricks_sub.bind(
                        fields: fields,
                        grids: grids,
                        super_active: scratch.super_active.items(),
                        super_count: scratch.super_active.count(),
                        cap_super: 65536,
                        first: sk * super_sub_slice,
                        fc: fc,
                        active: mut scratch.active,
                    ),
                    groups: scratch.super_args.at(sk),
                    most: super_sub_slice,
                )
            }
        } else {
            let cull_most = lane_slice(
                kernel_work(cull_bricks.bind(
                    fields: fields,
                    grids: grids,
                    things: things,
                    first_brick: 0,
                    total_bricks: total_bricks,
                    fc: fc,
                    active: mut scratch.active,
                )),
                most: CULL_CHUNK,
            )
            var first: u32 = 0
            while first < total_bricks {
                let n = min(total_bricks - first, cull_most)
                dispatch(
                    cull_bricks.bind(
                        fields: fields,
                        grids: grids,
                        things: things,
                        first_brick: first,
                        total_bricks: total_bricks,
                        fc: fc,
                        active: mut scratch.active,
                    ),
                    over: n,
                )
                first += n
            }
        }

        // Passes 1–3: Extract in bounded chunks of `CHUNK_BRICKS` active bricks using `chunk_limit`
        // (generous 1.5× + 1-chunk headroom; `took_counts` re-extracts automatically if exceeded).
        scratch.indirect_left -= min(scratch.indirect_left, fixed_indirect)
        self.budget_short = would_short
        self.certified = !would_short
        let chunks = (hard_cap + CHUNK_BRICKS - 1) / CHUNK_BRICKS
        scratch.indirect_left -= min(scratch.indirect_left, chunks * per_chunk)
        self.ensure_brick_draws(hard_cap + extra_bricks)
        if use_exact {
            let _ = self.ensure_watch()
            self.quad_recs.clear()
            self.thin_keep.clear()
            zero_u32_buf(mut self.vert_cert, self.watch_verts_cap)
            zero_u32_buf(mut self.thin_proof, self.watch_verts_cap)
            if self.place_cert_field_key != 0 && self.place_cert_field_key != field_key {
                dispatch(
                    reset_place_cert.bind(hash_slots: self.place_cert_hash.items_mut()),
                    over: PLACE_CERT_HASH,
                )
                self.place_cert_entries.clear()
                self.place_cert_field_key = 0
            }
            if self.static_key_streak >= 1 && field_key != 0 {
                self.place_cert_field_key = field_key
            }
            self.watch_origin = scratch.origin0
            self.watch_shift = scratch.lattice
        }
        self.extract_total = total_bricks
        self.extract_limit = hard_cap
        var chunk_start: u32 = 0
        scratch.cert_cands.clear()
        while chunk_start < hard_cap {
            let chunk_n = min(hard_cap - chunk_start, CHUNK_BRICKS)
            let eval_slices = (chunk_n + self.eval_slice - 1) / self.eval_slice
            let quad_slices = (chunk_n + self.quad_slice - 1) / self.quad_slice
            let chunk_slices = max(eval_slices, quad_slices)
            dispatch(
                prep_chunk.bind(
                    active_count: scratch.active.count(),
                    cap_bricks: effective_cap,
                    chunk_start: chunk_start,
                    eval_slice: self.eval_slice,
                    quad_slice: self.quad_slice,
                    vert_args: mut scratch.vert_args,
                    eval_args: scratch.eval_args.span_mut(start: 0, count: chunk_slices),
                    quad_args: scratch.quad_args.span_mut(start: 0, count: chunk_slices),
                ),
                over: chunk_slices,
            )
            if has_seams {
                for e in 0..eval_slices {
                    dispatch(
                        eval_corners.bind(
                            fields: fields,
                            grids: grids,
                            active: scratch.active.items(),
                            active_count: scratch.active.count(),
                            cap_bricks: effective_cap,
                            chunk_start: chunk_start,
                            brick_off: e * self.eval_slice,
                            corners: scratch.corners_raw.span_mut(
                                start: e * self.eval_slice * CORNERS_BRICK,
                                count: min(chunk_n - e * self.eval_slice, self.eval_slice) * CORNERS_BRICK,
                            ),
                        ),
                        groups: scratch.eval_args.at(e),
                        most: min(chunk_n - e * self.eval_slice, self.eval_slice) * 8,
                    )
                }
                var inh_off: u32 = 0
                while inh_off < chunk_n {
                    let band = min(chunk_n - inh_off, self.inherit_slice)
                    dispatch(
                        inherit_seam_corners.bind(
                            fields: fields,
                            grids: grids,
                            active: scratch.active.items(),
                            active_count: scratch.active.count(),
                            cap_bricks: effective_cap,
                            chunk_start: chunk_start,
                            brick_off: inh_off,
                            corners_in: scratch.corners_raw.items(),
                            corners_out: scratch.corners.span_mut(
                                start: inh_off * CORNERS_BRICK,
                                count: band * CORNERS_BRICK,
                            ),
                        ),
                        over: band * CORNERS_BRICK,
                    )
                    inh_off += band
                }
            } else {
                for e in 0..eval_slices {
                    dispatch(
                        eval_corners.bind(
                            fields: fields,
                            grids: grids,
                            active: scratch.active.items(),
                            active_count: scratch.active.count(),
                            cap_bricks: effective_cap,
                            chunk_start: chunk_start,
                            brick_off: e * self.eval_slice,
                            corners: scratch.corners.span_mut(
                                start: e * self.eval_slice * CORNERS_BRICK,
                                count: min(chunk_n - e * self.eval_slice, self.eval_slice) * CORNERS_BRICK,
                            ),
                        ),
                        groups: scratch.eval_args.at(e),
                        most: min(chunk_n - e * self.eval_slice, self.eval_slice) * 8,
                    )
                }
            }
            scratch.creases.clear()
            scratch.surf.clear()
            if self.watched {
                dispatch(
                    keep_slots.bind(
                        grids: grids,
                        active: scratch.active.items(),
                        active_count: scratch.active.count(),
                        cap_bricks: effective_cap,
                        chunk_start: chunk_start,
                        slot_base: scratch.zero_u32.items(),
                        max_slots: self.watch_slots_cap,
                        slots: mut self.slot_bricks,
                        bits: mut self.watch_bits,
                    ),
                    over: chunk_n,
                )
            }
            dispatch(
                classify_cells.bind(
                    grids: grids,
                    active: scratch.active.items(),
                    active_count: scratch.active.count(),
                    cap_bricks: effective_cap,
                    chunk_start: chunk_start,
                    lip: lip,
                    held: if (exact_eye).w > 0.0 { 1 } else { 0 },
                    slot_base: scratch.zero_u32.items(),
                    max_slots: self.watch_slots_cap,
                    corners: scratch.corners.items(),
                    cell_verts: scratch.cell_verts.span_mut(
                        start: 0,
                        count: chunk_n * VERTS_STRIDE,
                    ),
                    exact_seen: mut scratch.exact_seen,
                    surf: mut scratch.surf,
                    watch_bits: mut self.watch_bits,
                    thin_keep: mut self.thin_keep,
                ),
                groups: scratch.vert_args.at(0),
                most: chunk_n * 6,
            )
            if uses_kept {
                dispatch(
                    mark_first.bind(
                        vert_count: self.verts.count(),
                        cap_verts: self.cap_verts,
                        first: mut self.keep_first,
                    ),
                    over: 1,
                )
            }
            let surf_slices = min(
                (chunk_n * VERTS_BRICK + self.surf_slice - 1) / self.surf_slice,
                SLICES_MOST,
            )
            dispatch(
                prep_slices.bind(
                    count: scratch.surf.count(),
                    cap: CAP_SURF,
                    most: self.surf_slice,
                    slices: surf_slices,
                    args: scratch.surf_args.span_mut(start: 0, count: surf_slices),
                ),
                over: surf_slices,
            )
            for k in 0..surf_slices {
                dispatch(
                    solve_verts.bind(
                        fields: fields,
                        grids: grids,
                        active: scratch.active.items(),
                        chunk_start: chunk_start,
                        corners: scratch.corners.items(),
                        surf: scratch.surf.items(),
                        surf_count: scratch.surf.count(),
                        first: k * self.surf_slice,
                        cap_verts: self.cap_verts,
                        cell_verts: mut scratch.cell_verts,
                        verts: mut self.verts,
                        creases: mut scratch.creases,
                    ),
                    groups: scratch.surf_args.at(k),
                    most: self.surf_slice / 64,
                )
            }
            // The chunk's creases, in dispatches of at most `self.crease_slice` cells, their counts
            // prepared in one dispatch (a slice past the list's end dispatches no groups).
            let crease_slices = self.crease_slices(chunk_n)
            dispatch(
                prep_creases.bind(
                    count: scratch.creases.count(),
                    slices: crease_slices,
                    slice: self.crease_slice,
                    args: scratch.crease_args.span_mut(start: 0, count: crease_slices),
                    seen: mut self.tri_count,
                ),
                over: crease_slices,
            )
            for k in 0..crease_slices {
                for pass in 0..self.crease_passes {
                    dispatch(
                        refine_creases.bind(
                            fields: fields,
                            grids: grids,
                            active: scratch.active.items(),
                            chunk_start: chunk_start,
                            corners: scratch.corners.items(),
                            creases: scratch.creases.items(),
                            crease_count: scratch.creases.count(),
                            first: k * self.crease_slice,
                            pass: pass,
                            solves: mut scratch.crease_solves,
                            cap_verts: self.cap_verts,
                            cell_verts: mut scratch.cell_verts,
                            verts: mut self.verts,
                        ),
                        groups: scratch.crease_args.at(k),
                        most: self.crease_slice / 64,
                    )
                }
            }
            if uses_kept {
                let keep_slices = min(
                    (chunk_n * VERTS_BRICK + self.keep_slice - 1) / self.keep_slice,
                    SLICES_MOST,
                )
                dispatch(
                    prep_from.bind(
                        count: self.verts.count(),
                        cap: self.cap_verts,
                        first: self.keep_first.items(),
                        most: self.keep_slice,
                        slices: keep_slices,
                        args: self.keep_args.span_mut(start: 0, count: keep_slices),
                    ),
                    over: keep_slices,
                )
                for k in 0..keep_slices {
                    dispatch(
                        keep_verts.bind(
                            fields: fields,
                            verts: self.verts.items(),
                            vert_count: self.verts.count(),
                            cap_verts: self.cap_verts,
                            first: self.keep_first.items(),
                            from: k * self.keep_slice,
                            vert_kept: mut self.vert_kept,
                        ),
                        groups: self.keep_args.at(k),
                        most: self.keep_slice / 64,
                    )
                }
            }
            dispatch(
                zero_chunk_counts.bind(
                    counts: scratch.brick_idx_counts.span_mut(start: 0, count: chunk_n),
                    cursors: scratch.brick_idx_cursor.span_mut(start: 0, count: chunk_n),
                ),
                over: chunk_n,
            )
            if has_seams {
                for q in 0..quad_slices {
                    dispatch(
                        count_brick_tris_lod.bind(
                            grids: grids,
                            active: scratch.active.items(),
                            active_count: scratch.active.count(),
                            cap_bricks: effective_cap,
                            chunk_start: chunk_start,
                            brick_off: q * self.quad_slice,
                            corners: scratch.corners.items(),
                            cell_verts: scratch.cell_verts.items(),
                            verts: self.verts.items(),
                            brick_idx_counts: mut scratch.brick_idx_counts,
                        ),
                        groups: scratch.quad_args.at(q),
                        most: min(chunk_n - q * self.quad_slice, self.quad_slice) * 4,
                    )
                }
            } else {
                for q in 0..quad_slices {
                    dispatch(
                        count_brick_tris.bind(
                            active_count: scratch.active.count(),
                            cap_bricks: effective_cap,
                            chunk_start: chunk_start,
                            brick_off: q * self.quad_slice,
                            corners: scratch.corners.items(),
                            cell_verts: scratch.cell_verts.items(),
                            verts: self.verts.items(),
                            brick_idx_counts: mut scratch.brick_idx_counts,
                        ),
                        groups: scratch.quad_args.at(q),
                        most: min(chunk_n - q * self.quad_slice, self.quad_slice) * 4,
                    )
                }
            }
            scan_chunk_offsets(
                scratch.active.count(),
                scratch.brick_idx_counts.items(),
                mut scratch.group_sums,
                mut scratch.group_offsets,
                mut scratch.brick_idx_offsets,
                mut self.tri_count,
                cap_bricks: effective_cap,
                chunk_start: chunk_start,
                chunk_n: chunk_n,
            )
            dispatch(
                write_brick_meta.bind(
                    grids: grids,
                    active: scratch.active.items(),
                    active_count: scratch.active.count(),
                    cap_bricks: effective_cap,
                    cap_indices: self.cap_indices,
                    inst_count: inst_count,
                    chunk_start: chunk_start,
                    use_parent_tag: 0,
                    brick_idx_saved: scratch.brick_idx_counts.items(),
                    brick_idx_offsets: scratch.brick_idx_offsets.items(),
                    brick_bounds: self.brick_bounds.span_mut(start: chunk_start, count: chunk_n),
                    brick_draws: self.brick_draws.span_mut(start: chunk_start, count: chunk_n),
                    brick_alive: self.brick_alive.span_mut(start: chunk_start, count: chunk_n),
                ),
                over: chunk_n,
            )
            if has_seams {
                for q in 0..quad_slices {
                    dispatch(
                        emit_tris_lod.bind(
                            grids: grids,
                            active: scratch.active.items(),
                            active_count: scratch.active.count(),
                            cap_bricks: effective_cap,
                            cap_indices: self.cap_indices,
                            cap_trans: self.cap_trans,
                            chunk_start: chunk_start,
                            brick_off: q * self.quad_slice,
                            corners: scratch.corners.items(),
                            cell_verts: scratch.cell_verts.items(),
                            verts: self.verts.items(),
                            brick_idx_offsets: scratch.brick_idx_offsets.items(),
                            brick_idx_counts: mut scratch.brick_idx_cursor,
                            tri_count: mut self.tri_count,
                            indices: mut self.indices,
                            trans_indices: mut self.trans_indices,
                            cut_indices: mut self.cut_indices,
                            seam_quads: mut scratch.seam_quads,
                            seam_cells: mut scratch.seam_cells,
                            seam_verts: mut scratch.seam_verts,
                            held: if (exact_eye).w > 0.0 { 1 } else { 0 },
                            slot_base: scratch.zero_u32.items(),
                            max_slots: self.watch_slots_cap,
                            cap_exact_slots: 0,
                            exact_seen: mut scratch.exact_seen,
                            exact_cells: mut self.exact_cells,
                            exact_slots: mut scratch.dummy_exact_slots,
                            quad_recs: mut self.quad_recs,
                        ),
                        groups: scratch.quad_args.at(q),
                        most: min(chunk_n - q * self.quad_slice, self.quad_slice) * 4,
                    )
                }
            } else {
                for q in 0..quad_slices {
                    dispatch(
                        emit_tris.bind(
                            grids: grids,
                            active: scratch.active.items(),
                            active_count: scratch.active.count(),
                            cap_bricks: effective_cap,
                            cap_indices: self.cap_indices,
                            cap_trans: self.cap_trans,
                            chunk_start: chunk_start,
                            brick_off: q * self.quad_slice,
                            held: if (exact_eye).w > 0.0 { 1 } else { 0 },
                            slot_base: scratch.zero_u32.items(),
                            max_slots: self.watch_slots_cap,
                            cap_exact_slots: 0,
                            corners: scratch.corners.items(),
                            cell_verts: scratch.cell_verts.items(),
                            verts: self.verts.items(),
                            brick_idx_offsets: scratch.brick_idx_offsets.items(),
                            brick_idx_counts: mut scratch.brick_idx_cursor,
                            tri_count: mut self.tri_count,
                            indices: mut self.indices,
                            trans_indices: mut self.trans_indices,
                            cut_indices: mut self.cut_indices,
                            exact_seen: mut scratch.exact_seen,
                            exact_cells: mut self.exact_cells,
                            exact_slots: mut scratch.dummy_exact_slots,
                            quad_recs: mut self.quad_recs,
                        ),
                        groups: scratch.quad_args.at(q),
                        most: min(chunk_n - q * self.quad_slice, self.quad_slice) * 4,
                    )
                }
            }
            chunk_start += chunk_n
        }

        // Passes 3b–3d (Multi-LOD only): Solve enclosing coarse cells on 2:1 seam faces on the fly
        // (bit-for-bit identical to the parent level) and emit watertight seam triangles/quads.
        if has_seams {
            dispatch(
                record_seam_start.bind(
                    tri_count: self.tri_count.items(),
                    seam_start: mut self.seam_start,
                ),
                over: 1,
            )
            let seam_slices = self.seam_slices()
            dispatch(
                note_seams.bind(
                    seam_count: scratch.seam_cells.count(),
                    tested: seam_slices * self.seam_slice,
                    tri_count: mut self.tri_count,
                ),
                over: 1,
            )
            dispatch(
                prep_slices.bind(
                    count: scratch.seam_cells.count(),
                    cap: CAP_SEAM * 2,
                    most: self.seam_slice,
                    slices: seam_slices,
                    args: scratch.seam_args.span_mut(start: 0, count: seam_slices),
                ),
                over: seam_slices,
            )
            if use_exact {
                dispatch(
                    reset_seam_seen.bind(
                        seam_seen: scratch.seam_seen.span_mut(start: 0, count: SEAM_SEEN),
                    ),
                    over: SEAM_SEEN,
                )
                for k in 0..seam_slices {
                    dispatch(
                        box_seam_cells.bind(
                            fields: fields,
                            grids: grids,
                            seam_cells: scratch.seam_cells.items(),
                            seam_cell_count: scratch.seam_cells.count(),
                            first: k * self.seam_slice,
                            seam_seen: mut scratch.seam_seen,
                            exact_cells: mut self.exact_cells,
                        ),
                        groups: scratch.seam_args.at(k),
                        most: self.seam_slice / 64,
                    )
                }
            }
            if uses_kept {
                dispatch(
                    mark_first.bind(
                        vert_count: self.verts.count(),
                        cap_verts: self.cap_verts,
                        first: mut self.keep_first,
                    ),
                    over: 1,
                )
            }
            for k in 0..seam_slices {
                dispatch(
                    solve_seam_smooth.bind(
                        fields: fields,
                        grids: grids,
                        seam_cells: scratch.seam_cells.items(),
                        seam_cell_count: scratch.seam_cells.count(),
                        first: k * self.seam_slice,
                        cap_verts: self.cap_verts,
                        verts: mut self.verts,
                        seam_verts: mut scratch.seam_verts,
                        seam_creases: mut scratch.seam_creases,
                    ),
                    groups: scratch.seam_args.at(k),
                    most: self.seam_slice / 64,
                )
            }
            dispatch(
                prep_slices.bind(
                    count: scratch.seam_creases.count(),
                    cap: CAP_SEAM * 2,
                    most: seam_c_slice,
                    slices: seam_c_slices,
                    args: scratch.crease_args.span_mut(start: 0, count: seam_c_slices),
                ),
                over: seam_c_slices,
            )
            for k in 0..seam_c_slices {
                for pass in 0..self.crease_passes {
                    dispatch(
                        refine_seam_creases.bind(
                            fields: fields,
                            grids: grids,
                            seam_cells: scratch.seam_cells.items(),
                            seam_creases: scratch.seam_creases.items(),
                            seam_crease_count: scratch.seam_creases.count(),
                            first: k * seam_c_slice,
                            pass: pass,
                            solves: mut scratch.crease_solves,
                            cap_verts: self.cap_verts,
                            verts: mut self.verts,
                            seam_verts: mut scratch.seam_verts,
                        ),
                        groups: scratch.crease_args.at(k),
                        most: seam_c_slice / 64,
                    )
                }
            }
            if uses_kept {
                dispatch(
                    prep_from.bind(
                        count: self.verts.count(),
                        cap: self.cap_verts,
                        first: self.keep_first.items(),
                        most: self.keep_slice,
                        slices: seam_keep_slices,
                        args: self.keep_args.span_mut(start: 0, count: seam_keep_slices),
                    ),
                    over: seam_keep_slices,
                )
                for k in 0..seam_keep_slices {
                    dispatch(
                        keep_verts.bind(
                            fields: fields,
                            verts: self.verts.items(),
                            vert_count: self.verts.count(),
                            cap_verts: self.cap_verts,
                            first: self.keep_first.items(),
                            from: k * self.keep_slice,
                            vert_kept: mut self.vert_kept,
                        ),
                        groups: self.keep_args.at(k),
                        most: self.keep_slice / 64,
                    )
                }
            }
            dispatch(
                prep_slices.bind(
                    count: scratch.seam_quads.count(),
                    cap: CAP_SEAM,
                    most: CAP_SEAM,
                    slices: 1,
                    args: scratch.surf_args.span_mut(start: 0, count: 1),
                ),
                over: 1,
            )
            dispatch(
                finish_seam_tris.bind(
                    seam_quads: scratch.seam_quads.items(),
                    seam_quad_count: scratch.seam_quads.count(),
                    seam_verts: scratch.seam_verts.items(),
                    verts: self.verts.items(),
                    cap_indices: self.cap_indices,
                    cap_trans: self.cap_trans,
                    tri_count: mut self.tri_count,
                    indices: mut self.indices,
                    trans_indices: mut self.trans_indices,
                    cut_indices: mut self.cut_indices,
                ),
                groups: scratch.surf_args.at(0),
                most: CAP_SEAM / 64,
            )
        }

        dispatch(
            finish_draw.bind(
                active_count: scratch.active.count(),
                vert_count: self.verts.count(),
                seam_quad_count: scratch.seam_quads.count(),
                seam_cell_count: scratch.seam_cells.count(),
                exact_count: self.exact_cells.count(),
                seam_start: self.seam_start.items(),
                has_seams: if has_seams { 1 } else { 0 },
                cap_indices: self.cap_indices,
                cap_trans: self.cap_trans,
                cap_exact: self.cap_exact,
                inst_count: inst_count,
                tri_count: mut self.tri_count,
                args: mut self.draw_args,
                trans_args: mut self.trans_draw_args,
                cut_args: mut self.cut_draw_args,
                seam_args: mut self.seam_draw_args,
                exact_args: mut self.exact_draw_args,
            ),
            over: 1,
        )
        if use_exact {
            // What it gave exact cells for every eye; each frame's outline follows them.
            copy(from: self.exact_cells.count().sub(start: 0, count: 1), to: self.exact_base.items_mut())
        }
        self.pooled = false
        self.has_exact = use_exact
        self.has_brick_draws = true
        self.has_seams = has_seams
        self.edit_patched = false
        self.cpu_brick_slots = hard_cap
        self.edit_append_cursor = ((hard_cap + 63) / 64) * 64
        // Read back what was drawn (queued at frame end, never here, so mid-frame extraction
        // never flushes the GPU).
        self.note_extracted(true)
    }

    /// World-anchored persistent `BrickPool` update for static Multi-LOD fields:
    /// - Reuses resident interior bricks (`brick_seam_mask == 0`) by 128-bit integer `BrickKey`
    ///   with zero re-extraction across LOD ring moves and camera motion.
    /// - Extracts only newly entered interior bricks (`miss_interior`) into persistent slots and
    ///   re-extracts only the thin 1-brick 2:1 seam shell (`active_seam`) into a reclaimed tail.
    /// - Compacts active brick indices + seam strip into contiguous `self.indices` on GPU (`< 0.1 ms`)
    ///   so every downstream render pass draws one single indirect call.
    fn run_pool_update<M: Field<Substance>>(
        mut self,
        scratch: mut ExtractScratch,
        fields: GpuSpan<M>,
        sample: M,
        field_key: u64,
        cut: Vec<GridSpec>,
        things: u32,
        total_bricks: u32,
        has_seams: bool,
        exact_eye: vec4,
        lip: f32,
        eye_reach: f32 = 0.0,
    ) {
        label("mesh_extract")
        let use_exact = exact_eye.w > 0.0
        let uses_kept = sample.uses_kept()
        if uses_kept {
            self.keep_slice = keep_slice_of(sample)
        }
        let step = crease_step_cost_of(sample)
        let crease_kernel = refine_creases.bind(
            fields: fields,
            grids: scratch.grids.items(),
            active: scratch.active.items(),
            chunk_start: 0,
            corners: scratch.corners.items(),
            creases: scratch.creases.items(),
            crease_count: scratch.creases.count(),
            first: 0,
            pass: 0,
            solves: mut scratch.crease_solves,
            cap_verts: self.cap_verts,
            cell_verts: mut scratch.cell_verts,
            verts: mut self.verts,
        )
        self.crease_slice = crease_slice(kernel_work(crease_kernel))
        let seam_kernel = refine_seam_creases.bind(
            fields: fields,
            grids: scratch.grids.items(),
            seam_cells: scratch.seam_cells.items(),
            seam_creases: scratch.seam_creases.items(),
            seam_crease_count: scratch.seam_creases.count(),
            first: 0,
            pass: 0,
            solves: mut scratch.crease_solves,
            cap_verts: self.cap_verts,
            verts: mut self.verts,
            seam_verts: mut scratch.seam_verts,
        )
        self.seam_crease_slice = crease_slice(kernel_work(seam_kernel))
        self.crease_passes = crease_passes(crease_part(step))
        let surf_kernel = solve_verts.bind(
            fields: fields,
            grids: scratch.grids.items(),
            active: scratch.active.items(),
            chunk_start: 0,
            corners: scratch.corners.items(),
            surf: scratch.surf.items(),
            surf_count: scratch.surf.count(),
            first: 0,
            cap_verts: self.cap_verts,
            cell_verts: mut scratch.cell_verts,
            verts: mut self.verts,
            creases: mut scratch.creases,
        )
        self.surf_slice = surf_slice(kernel_work(surf_kernel))
        self.seam_slice = min(
            lane_slice(
                kernel_work(solve_seam_smooth.bind(
                    fields: fields,
                    grids: scratch.grids.items(),
                    seam_cells: scratch.seam_cells.items(),
                    seam_cell_count: scratch.seam_cells.count(),
                    first: 0,
                    cap_verts: self.cap_verts,
                    verts: mut self.verts,
                    seam_verts: mut scratch.seam_verts,
                    seam_creases: mut scratch.seam_creases,
                )),
                most: SEAM_SLICE,
            ),
            lane_slice(
                kernel_work(box_seam_cells.bind(
                    fields: fields,
                    grids: scratch.grids.items(),
                    seam_cells: scratch.seam_cells.items(),
                    seam_cell_count: scratch.seam_cells.count(),
                    first: 0,
                    seam_seen: mut scratch.seam_seen,
                    exact_cells: mut scratch.seam_exact_cells,
                )),
                most: SEAM_SLICE,
            ),
        )
        self.inherit_slice = min(
            brick_slice(lanes: 512, invocation: kernel_work(inherit_seam_corners.bind(
                fields: fields,
                grids: scratch.grids.items(),
                active: scratch.active.items(),
                active_count: scratch.active.count(),
                cap_bricks: self.max_bricks,
                chunk_start: 0,
                brick_off: 0,
                corners_in: scratch.corners_raw.items(),
                corners_out: scratch.corners.span_mut(start: 0, count: CORNERS_BRICK),
            ))),
            CHUNK_BRICKS,
        )
        self.eval_slice = brick_slice(
            lanes: 512,
            invocation: kernel_work(eval_corners.bind(
                fields: fields,
                grids: scratch.grids.items(),
                active: scratch.active.items(),
                active_count: scratch.active.count(),
                cap_bricks: self.max_bricks,
                chunk_start: 0,
                brick_off: 0,
                corners: scratch.corners.span_mut(start: 0, count: CORNERS_BRICK),
            )),
        )
        self.quad_slice = brick_slice(lanes: 256, invocation: kernel_work(emit_tris_lod.bind(
            grids: scratch.grids.items(),
            active: scratch.active.items(),
            active_count: scratch.active.count(),
            cap_bricks: self.max_bricks,
            cap_indices: self.cap_indices,
            cap_trans: self.cap_trans,
            chunk_start: 0,
            brick_off: 0,
            corners: scratch.corners.items(),
            cell_verts: scratch.cell_verts.items(),
            verts: self.verts.items(),
            brick_idx_offsets: scratch.brick_idx_offsets.items(),
            brick_idx_counts: mut scratch.brick_idx_cursor,
            tri_count: mut self.pool_tri_count,
            indices: mut self.pool_indices,
            trans_indices: mut self.trans_indices,
            cut_indices: mut self.cut_indices,
            seam_quads: mut scratch.seam_quads,
            seam_cells: mut scratch.seam_cells,
            seam_verts: mut scratch.seam_verts,
            held: if use_exact { 1 } else { 0 },
            slot_base: self.pool_slot_base.items(),
            max_slots: max(self.watch_slots_cap, 1),
            cap_exact_slots: self.pool_exact_cap,
            exact_seen: mut scratch.exact_seen,
            exact_cells: mut self.pool_exact_cells,
            exact_slots: mut self.pool_exact_slots,
            quad_recs: mut self.quad_recs,
        )))

        // Ensure output, pool, and watch storage; any buffer reallocation forces a clean cold populate.
        let old_verts = self.cap_verts
        let old_kept = self.vert_kept_cap
        let active_est = if self.active_hint > 0 { self.active_hint } else { min(total_bricks, 8192) }
        let pool_target_bricks = min(max(active_est * 3, 4096), min(self.max_bricks, 49152))
        self.ensure_cap(pool_target_bricks)
        if uses_kept {
            self.ensure_vert_kept(self.cap_verts)
        }
        // The drawn exact cells are the live slots' of the arena's and the seam tail's (and the
        // outline's of a frame): the drawn list holds the most there are, so a commit never drops
        // one.
        if use_exact {
            self.ensure_exact_cap(CAP_EXACT_MAX)
        }
        let grew_pool = self.ensure_pool(pool_target_bricks, CAP_EXACT_MAX)
        let total_slots = self.pool_cap + SEAM_SLOTS_CAP
        let grew_watch = if use_exact { self.ensure_watch(need_slots: total_slots) } else { false }
        let reallocated = grew_pool || grew_watch || self.cap_verts != old_verts || self.vert_kept_cap != old_kept

        let same_space = self.pooled &&
            !reallocated &&
            self.pool_field_key == field_key &&
            self.pool_origin == scratch.origin0 &&
            self.pool_shift == scratch.lattice
        let room_ok = self.pool_cap > 0 &&
            self.pool_used_exact < self.pool_exact_cap / 2 &&
            self.pool_used_slots < (self.pool_cap * 4) / 5 &&
            self.pool_used_idx < (self.pool_idx_cap * 4) / 5 &&
            self.verts_known < (self.cap_verts * 4) / 5
        let warm = same_space && room_ok

        // Compute indirect-dispatch budget for misses, seam bricks, seam strip, and compaction.
        let exact_indirect: u32 = if use_exact { 2 } else { 0 }
        let surf_per_chunk = min(
            (CHUNK_BRICKS * VERTS_BRICK + self.surf_slice - 1) / self.surf_slice,
            SLICES_MOST,
        )
        let keep_per_chunk = if uses_kept {
            min((CHUNK_BRICKS * VERTS_BRICK + self.keep_slice - 1) / self.keep_slice, SLICES_MOST)
        } else {
            0
        }
        let eval_per_chunk = (CHUNK_BRICKS + self.eval_slice - 1) / self.eval_slice
        let quad_per_chunk = (CHUNK_BRICKS + self.quad_slice - 1) / self.quad_slice
        let per_chunk = CHUNK_INDIRECT +
            (surf_per_chunk - 1) +
            (eval_per_chunk - 1) +
            2 * (quad_per_chunk - 1) +
            keep_per_chunk +
            exact_indirect +
            self.crease_slices(CHUNK_BRICKS) * self.crease_passes
        let seam_c_slice = min(SEAM_SLICE, self.seam_crease_slice)
        let seam_c_slices = if has_seams {
            min((self.seam_slices() * self.seam_slice + seam_c_slice - 1) / seam_c_slice, SLICES_MOST)
        } else {
            0
        }
        let seam_keep_slices = if has_seams && uses_kept {
            min((self.seam_slices() * self.seam_slice + self.keep_slice - 1) / self.keep_slice, SLICES_MOST)
        } else {
            0
        }
        let seam_strip_indirect: u32 = if !has_seams {
            0
        } else if use_exact {
            2 * self.seam_slices() + seam_c_slices * self.crease_passes + seam_keep_slices + 1
        } else {
            self.seam_slices() + seam_c_slices * self.crease_passes + seam_keep_slices + 1
        }
        let super_sub_k = cull_bricks_sub.bind(
            fields: fields,
            grids: scratch.grids.items(),
            super_active: scratch.super_active.items(),
            super_count: scratch.super_active.count(),
            cap_super: 65536,
            first: 0,
            fc: frustum_cull_none(),
            active: mut scratch.active,
        )
        let super_sub_slice = max(
            u32(clamp(
                f32(limits().step_work) * 1000.0 / (64.0 * (f32(kernel_work(super_sub_k)) + 2000.0)),
                1.0,
                4096.0,
            )),
            1,
        )
        let super_slices = if scratch.total_super > 0 {
            min((scratch.total_super + super_sub_slice - 1) / super_sub_slice, SLICES_MOST)
        } else {
            0
        }
        let use_super = total_bricks >= 512 &&
            scratch.total_super > 0 &&
            scratch.total_super <= 65536 &&
            super_slices * super_sub_slice >= scratch.total_super
        let super_indirect: u32 = if use_super { super_slices } else { 0 }
        let pool_fixed_indirect: u32 = 8 + seam_strip_indirect + super_indirect
        let avail = if scratch.indirect_left > pool_fixed_indirect {
            scratch.indirect_left - pool_fixed_indirect
        } else {
            0
        }
        let fit_chunks = max(avail / per_chunk, 1)
        // The most this cut can miss of what the pool holds (the last cut whose misses all fit
        // what was dispatched for them), and the most seam bricks it has: counts from the boxes
        // (`cut_bounds`), so an update dispatched for them commits.
        let held_cut = if warm { self.pool_grids.clone() } else { Vec::new() }
        let (miss_bound, seam_bound) = cut_bounds(held_cut, cut.clone())
        let seam_chunks_want: u32 = if !has_seams {
            0
        } else {
            (min(seam_bound, SEAM_SLOTS_CAP) + CHUNK_BRICKS - 1) / CHUNK_BRICKS
        }
        let miss_cap_max = min(total_bricks, self.pool_cap)
        let miss_want = min(miss_bound, miss_cap_max)
        let miss_chunks_want = max((miss_want + CHUNK_BRICKS - 1) / CHUNK_BRICKS, 1)
        let total_chunks_want = miss_chunks_want + seam_chunks_want
        let seam_chunks = if has_seams {
            min(seam_chunks_want, max(fit_chunks / 3, 1))
        } else {
            0
        }
        let miss_chunks = max(if fit_chunks > seam_chunks { min(miss_chunks_want, fit_chunks - seam_chunks) } else { 1 }, 1)
        let miss_limit = min(miss_chunks * CHUNK_BRICKS, self.pool_cap)
        let seam_limit = if has_seams { min(seam_chunks * CHUNK_BRICKS, SEAM_SLOTS_CAP) } else { 0 }
        let would_short = total_chunks_want > fit_chunks
        let alone_chunks = if EXTRACT_INDIRECT > pool_fixed_indirect {
            max((EXTRACT_INDIRECT - pool_fixed_indirect) / per_chunk, 1)
        } else {
            1
        }
        self.last_wanted = total_chunks_want * CHUNK_BRICKS
        self.last_alone = alone_chunks * CHUNK_BRICKS
        self.last_per_chunk = per_chunk
        if would_short && self.built && self.certified && total_chunks_want <= alone_chunks {
            self.budget_short = true
            return
        }

        scratch.indirect_left -= min(scratch.indirect_left, pool_fixed_indirect + (miss_chunks + seam_chunks) * per_chunk)
        // What the pool holds once this update commits: its cut, when every miss it can have is
        // dispatched for (else the last such cut, still held, or nothing after a cold one).
        if miss_limit >= miss_bound {
            self.pool_grids = cut.clone()
        } else if !warm {
            self.pool_grids = Vec::new()
        }
        self.budget_short = would_short
        self.certified = !would_short
        self.exact_eye = exact_eye
        self.eye_reach = eye_reach
        self.exact_lip = lip
        self.watched = use_exact
        self.extract_total = total_bricks
        self.extract_limit = min(total_bricks, self.pool_cap)

        // Cold reset vs warm watermark restore.
        if !warm {
            dispatch(
                reset_pool_hash.bind(hash_slots: self.pool_hash_slots.items_mut()),
                over: self.pool_hash_cap,
            )
            write(mut self.pool_marks, 0, Vec::filled(POOL_MARK_WORDS, 0))
            write(mut self.pool_tri_count, 0, Vec::filled(16, 0))
            write(mut self.pool_slot_base, 0, [0])
            write(mut self.pool_seam_base, 0, [self.pool_cap])
            self.verts.clear()
            self.pool_exact_cells.clear()
            if use_exact {
                self.quad_recs.clear()
                self.thin_keep.clear()
                zero_u32_buf(mut self.vert_cert, self.watch_verts_cap)
                zero_u32_buf(mut self.thin_proof, self.watch_verts_cap)
                if self.place_cert_field_key != field_key {
                    dispatch(
                        reset_place_cert.bind(hash_slots: self.place_cert_hash.items_mut()),
                        over: PLACE_CERT_HASH,
                    )
                    self.place_cert_entries.clear()
                    self.place_cert_field_key = field_key
                }
                self.watch_origin = scratch.origin0
                self.watch_shift = scratch.lattice
            }
            self.pool_field_key = field_key
            self.pool_origin = scratch.origin0
            self.pool_shift = scratch.lattice
            self.pool_used_slots = 0
            self.pool_used_idx = 0
            self.pool_used_exact = 0
        }
        write(mut self.tri_count, 0, Vec::filled(TRI_WORDS, 0))
        scratch.active.clear()
        scratch.miss_interior.clear()
        scratch.active_seam.clear()
        scratch.draw_slots.clear()
        scratch.seam_quads.clear()
        scratch.seam_cells.clear()
        scratch.seam_creases.clear()
        scratch.seam_exact_cells.clear()
        // What the probe counts and the seam strip's counts start each update at 0; what is
        // drawn is the committed cut's until `pool_decide` commits.
        write(mut scratch.seam_tri_count, 0, Vec::filled(16, 0))
        write(mut scratch.pool_stats, 0, Vec::filled(8, 0))

        let grids = scratch.grids.items()
        let fc = frustum_cull_none()
        label("mesh_extract_cull")
        // Pass 0: Interval-cull all bricks of the new distance-only cut.
        if use_super {
            scratch.super_active.clear()
            let super_most = lane_slice(
                kernel_work(super_cull_bricks.bind(
                    fields: fields,
                    grids: grids,
                    super_grids: scratch.super_grids.items(),
                    things: things,
                    first_super: 0,
                    total_super: scratch.total_super,
                    fc: fc,
                    super_active: mut scratch.super_active,
                )),
                most: CULL_CHUNK,
            )
            var s_first: u32 = 0
            while s_first < scratch.total_super {
                let sn = min(scratch.total_super - s_first, super_most)
                dispatch(
                    super_cull_bricks.bind(
                        fields: fields,
                        grids: grids,
                        super_grids: scratch.super_grids.items(),
                        things: things,
                        first_super: s_first,
                        total_super: scratch.total_super,
                        fc: fc,
                        super_active: mut scratch.super_active,
                    ),
                    over: sn,
                )
                s_first += sn
            }
            dispatch(
                prep_super_sub.bind(
                    super_count: scratch.super_active.count(),
                    cap_super: 65536,
                    most: super_sub_slice,
                    slices: super_slices,
                    args: scratch.super_args.span_mut(start: 0, count: super_slices),
                ),
                over: super_slices,
            )
            for sk in 0..super_slices {
                dispatch(
                    cull_bricks_sub.bind(
                        fields: fields,
                        grids: grids,
                        super_active: scratch.super_active.items(),
                        super_count: scratch.super_active.count(),
                        cap_super: 65536,
                        first: sk * super_sub_slice,
                        fc: fc,
                        active: mut scratch.active,
                    ),
                    groups: scratch.super_args.at(sk),
                    most: super_sub_slice,
                )
            }
        } else {
            let cull_most = lane_slice(
                kernel_work(cull_bricks.bind(
                    fields: fields,
                    grids: grids,
                    things: things,
                    first_brick: 0,
                    total_bricks: total_bricks,
                    fc: fc,
                    active: mut scratch.active,
                )),
                most: CULL_CHUNK,
            )
            var first: u32 = 0
            while first < total_bricks {
                let n = min(total_bricks - first, cull_most)
                dispatch(
                    cull_bricks.bind(
                        fields: fields,
                        grids: grids,
                        things: things,
                        first_brick: first,
                        total_bricks: total_bricks,
                        fc: fc,
                        active: mut scratch.active,
                    ),
                    over: n,
                )
                first += n
            }
        }

        label("mesh_extract_probe")
        // Pass 1: Probe BrickPool hash table (resident hits -> draw_slots, misses -> miss_interior, seam -> active_seam).
        let probe_cap = min(total_bricks, scratch.max_bricks)
        dispatch(
            prep_slices.bind(
                count: scratch.active.count(),
                cap: probe_cap,
                most: probe_cap,
                slices: 1,
                args: scratch.surf_args.span_mut(start: 0, count: 1),
            ),
            over: 1,
        )
        dispatch(
            pool_probe.bind(
                grids: grids,
                active: scratch.active.items(),
                active_count: scratch.active.count(),
                cap_active: probe_cap,
                first: 0,
                hash_mask: self.pool_hash_cap - 1,
                hash_slots: self.pool_hash_slots.items(),
                pool_keys: self.pool_keys.items(),
                draw_slots: mut scratch.draw_slots,
                miss_interior: mut scratch.miss_interior,
                active_seam: mut scratch.active_seam,
                pool_stats: mut scratch.pool_stats,
            ),
            groups: scratch.surf_args.at(0),
            most: (probe_cap + 63) / 64,
        )

        // Commit or nothing: the misses and seam bricks this update extracts, and the counts it
        // appends from (the last cut's seam tail reclaimed on a commit, kept whole on none).
        dispatch(
            pool_decide.bind(
                miss_count: scratch.miss_interior.count(),
                miss_limit: miss_limit,
                seam_count: scratch.active_seam.count(),
                seam_limit: seam_limit,
                pool_cap: self.pool_cap,
                cold: if warm { 0 } else { 1 },
                verts_count: self.verts.count(),
                quad_count: self.quad_recs.count(),
                thin_count: self.thin_keep.count(),
                exact_base: self.exact_base.items(),
                marks: mut self.pool_marks,
                slot_base: mut self.pool_slot_base,
                pool_tri_count: mut self.pool_tri_count,
                gate: mut scratch.pool_gate,
            ),
            over: 1,
        )
        let gate = scratch.pool_gate.items()
        scratch.miss_interior.count_from(gate.sub(start: GATE_MISSES, count: 1))
        scratch.active_seam.count_from(gate.sub(start: GATE_SEAMS, count: 1))
        self.verts.count_from(gate.sub(start: GATE_VERTS, count: 1))
        self.quad_recs.count_from(gate.sub(start: GATE_QUADS, count: 1))
        self.thin_keep.count_from(gate.sub(start: GATE_THIN, count: 1))
        self.pool_exact_cells.count_from(gate.sub(start: GATE_POOL_EXACT, count: 1))
        if use_exact && warm {
            dispatch(
                prep_zero_seam_certs.bind(
                    marks: self.pool_marks.items(),
                    cap_verts: self.watch_verts_cap,
                    args: mut scratch.zero_seam_args,
                ),
                over: 1,
            )
            dispatch(
                zero_seam_certs.bind(
                    marks: self.pool_marks.items(),
                    cap_verts: self.watch_verts_cap,
                    vert_cert: mut self.vert_cert,
                    thin_proof: mut self.thin_proof,
                ),
                groups: scratch.zero_seam_args.at(0),
                most: min((self.watch_verts_cap + 63) / 64, 65535),
            )
        }

        label("mesh_extract_miss")
        // Pass 2: Extract ONLY interior cache misses into persistent pool slots.
        var chunk_start: u32 = 0
        while chunk_start < miss_limit {
            let chunk_n = min(miss_limit - chunk_start, CHUNK_BRICKS)
            let eval_slices = (chunk_n + self.eval_slice - 1) / self.eval_slice
            let quad_slices = (chunk_n + self.quad_slice - 1) / self.quad_slice
            let chunk_slices = max(eval_slices, quad_slices)
            dispatch(
                prep_chunk.bind(
                    active_count: scratch.miss_interior.count(),
                    cap_bricks: miss_limit,
                    chunk_start: chunk_start,
                    eval_slice: self.eval_slice,
                    quad_slice: self.quad_slice,
                    vert_args: mut scratch.vert_args,
                    eval_args: scratch.eval_args.span_mut(start: 0, count: chunk_slices),
                    quad_args: scratch.quad_args.span_mut(start: 0, count: chunk_slices),
                ),
                over: chunk_slices,
            )
            for e in 0..eval_slices {
                dispatch(
                    eval_corners.bind(
                        fields: fields,
                        grids: grids,
                        active: scratch.miss_interior.items(),
                        active_count: scratch.miss_interior.count(),
                        cap_bricks: miss_limit,
                        chunk_start: chunk_start,
                        brick_off: e * self.eval_slice,
                        corners: scratch.corners.span_mut(
                            start: e * self.eval_slice * CORNERS_BRICK,
                            count: min(chunk_n - e * self.eval_slice, self.eval_slice) * CORNERS_BRICK,
                        ),
                    ),
                    groups: scratch.eval_args.at(e),
                    most: min(chunk_n - e * self.eval_slice, self.eval_slice) * 8,
                )
            }
            scratch.creases.clear()
            scratch.surf.clear()
            if self.watched {
                dispatch(
                    keep_slots.bind(
                        grids: grids,
                        active: scratch.miss_interior.items(),
                        active_count: scratch.miss_interior.count(),
                        cap_bricks: miss_limit,
                        chunk_start: chunk_start,
                        slot_base: self.pool_slot_base.items(),
                        max_slots: self.pool_cap,
                        slots: mut self.slot_bricks,
                        bits: mut self.watch_bits,
                    ),
                    over: chunk_n,
                )
            }
            dispatch(
                classify_cells.bind(
                    grids: grids,
                    active: scratch.miss_interior.items(),
                    active_count: scratch.miss_interior.count(),
                    cap_bricks: miss_limit,
                    chunk_start: chunk_start,
                    lip: lip,
                    held: if use_exact { 1 } else { 0 },
                    slot_base: self.pool_slot_base.items(),
                    max_slots: self.pool_cap,
                    corners: scratch.corners.items(),
                    cell_verts: scratch.cell_verts.span_mut(
                        start: 0,
                        count: chunk_n * VERTS_STRIDE,
                    ),
                    exact_seen: mut scratch.exact_seen,
                    surf: mut scratch.surf,
                    watch_bits: mut self.watch_bits,
                    thin_keep: mut self.thin_keep,
                ),
                groups: scratch.vert_args.at(0),
                most: chunk_n * 6,
            )
            if uses_kept {
                dispatch(
                    mark_first.bind(
                        vert_count: self.verts.count(),
                        cap_verts: self.cap_verts,
                        first: mut self.keep_first,
                    ),
                    over: 1,
                )
            }
            let surf_slices = min(
                (chunk_n * VERTS_BRICK + self.surf_slice - 1) / self.surf_slice,
                SLICES_MOST,
            )
            dispatch(
                prep_slices.bind(
                    count: scratch.surf.count(),
                    cap: CAP_SURF,
                    most: self.surf_slice,
                    slices: surf_slices,
                    args: scratch.surf_args.span_mut(start: 0, count: surf_slices),
                ),
                over: surf_slices,
            )
            for k in 0..surf_slices {
                dispatch(
                    solve_verts.bind(
                        fields: fields,
                        grids: grids,
                        active: scratch.miss_interior.items(),
                        chunk_start: chunk_start,
                        corners: scratch.corners.items(),
                        surf: scratch.surf.items(),
                        surf_count: scratch.surf.count(),
                        first: k * self.surf_slice,
                        cap_verts: self.cap_verts,
                        cell_verts: mut scratch.cell_verts,
                        verts: mut self.verts,
                        creases: mut scratch.creases,
                    ),
                    groups: scratch.surf_args.at(k),
                    most: self.surf_slice / 64,
                )
            }
            let crease_slices = self.crease_slices(chunk_n)
            dispatch(
                prep_creases.bind(
                    count: scratch.creases.count(),
                    slices: crease_slices,
                    slice: self.crease_slice,
                    args: scratch.crease_args.span_mut(start: 0, count: crease_slices),
                    seen: mut self.tri_count,
                ),
                over: crease_slices,
            )
            for k in 0..crease_slices {
                for pass in 0..self.crease_passes {
                    dispatch(
                        refine_creases.bind(
                            fields: fields,
                            grids: grids,
                            active: scratch.miss_interior.items(),
                            chunk_start: chunk_start,
                            corners: scratch.corners.items(),
                            creases: scratch.creases.items(),
                            crease_count: scratch.creases.count(),
                            first: k * self.crease_slice,
                            pass: pass,
                            solves: mut scratch.crease_solves,
                            cap_verts: self.cap_verts,
                            cell_verts: mut scratch.cell_verts,
                            verts: mut self.verts,
                        ),
                        groups: scratch.crease_args.at(k),
                        most: self.crease_slice / 64,
                    )
                }
            }
            if uses_kept {
                let keep_slices = min(
                    (chunk_n * VERTS_BRICK + self.keep_slice - 1) / self.keep_slice,
                    SLICES_MOST,
                )
                dispatch(
                    prep_from.bind(
                        count: self.verts.count(),
                        cap: self.cap_verts,
                        first: self.keep_first.items(),
                        most: self.keep_slice,
                        slices: keep_slices,
                        args: self.keep_args.span_mut(start: 0, count: keep_slices),
                    ),
                    over: keep_slices,
                )
                for k in 0..keep_slices {
                    dispatch(
                        keep_verts.bind(
                            fields: fields,
                            verts: self.verts.items(),
                            vert_count: self.verts.count(),
                            cap_verts: self.cap_verts,
                            first: self.keep_first.items(),
                            from: k * self.keep_slice,
                            vert_kept: mut self.vert_kept,
                        ),
                        groups: self.keep_args.at(k),
                        most: self.keep_slice / 64,
                    )
                }
            }
            dispatch(
                zero_chunk_counts.bind(
                    counts: scratch.brick_idx_counts.span_mut(start: 0, count: chunk_n),
                    cursors: scratch.brick_idx_cursor.span_mut(start: 0, count: chunk_n),
                ),
                over: chunk_n,
            )
            for q in 0..quad_slices {
                dispatch(
                    count_brick_tris_lod.bind(
                        grids: grids,
                        active: scratch.miss_interior.items(),
                        active_count: scratch.miss_interior.count(),
                        cap_bricks: miss_limit,
                        chunk_start: chunk_start,
                        brick_off: q * self.quad_slice,
                        corners: scratch.corners.items(),
                        cell_verts: scratch.cell_verts.items(),
                        verts: self.verts.items(),
                        brick_idx_counts: mut scratch.brick_idx_counts,
                    ),
                    groups: scratch.quad_args.at(q),
                    most: min(chunk_n - q * self.quad_slice, self.quad_slice) * 4,
                )
            }
            scan_chunk_offsets(
                scratch.miss_interior.count(),
                scratch.brick_idx_counts.items(),
                mut scratch.group_sums,
                mut scratch.group_offsets,
                mut scratch.brick_idx_offsets,
                mut self.pool_tri_count,
                cap_bricks: miss_limit,
                chunk_start: chunk_start,
                chunk_n: chunk_n,
            )
            dispatch(
                pool_write_meta.bind(
                    grids: grids,
                    active: scratch.miss_interior.items(),
                    active_count: scratch.miss_interior.count(),
                    cap_bricks: miss_limit,
                    cap_indices: self.pool_idx_cap,
                    chunk_start: chunk_start,
                    slot_base_buf: self.pool_slot_base.items(),
                    max_slots: self.pool_cap,
                    is_interior: 1,
                    brick_idx_saved: scratch.brick_idx_counts.items(),
                    brick_idx_offsets: scratch.brick_idx_offsets.items(),
                    slot_meta: mut self.pool_slot_meta,
                    pool_keys: mut self.pool_keys,
                    draw_slots: mut scratch.draw_slots,
                ),
                over: chunk_n,
            )
            for q in 0..quad_slices {
                dispatch(
                    emit_tris_lod.bind(
                        grids: grids,
                        active: scratch.miss_interior.items(),
                        active_count: scratch.miss_interior.count(),
                        cap_bricks: miss_limit,
                        cap_indices: self.pool_idx_cap,
                        cap_trans: self.cap_trans,
                        chunk_start: chunk_start,
                        brick_off: q * self.quad_slice,
                        corners: scratch.corners.items(),
                        cell_verts: scratch.cell_verts.items(),
                        verts: self.verts.items(),
                        brick_idx_offsets: scratch.brick_idx_offsets.items(),
                        brick_idx_counts: mut scratch.brick_idx_cursor,
                        tri_count: mut self.pool_tri_count,
                        indices: mut self.pool_indices,
                        trans_indices: mut self.trans_indices,
                        cut_indices: mut self.cut_indices,
                        seam_quads: mut scratch.seam_quads,
                        seam_cells: mut scratch.seam_cells,
                        seam_verts: mut scratch.seam_verts,
                        held: if use_exact { 1 } else { 0 },
                        slot_base: self.pool_slot_base.items(),
                        max_slots: self.pool_cap,
                        cap_exact_slots: self.pool_exact_cap,
                        exact_seen: mut scratch.exact_seen,
                        exact_cells: mut self.pool_exact_cells,
                        exact_slots: mut self.pool_exact_slots,
                        quad_recs: mut self.quad_recs,
                    ),
                    groups: scratch.quad_args.at(q),
                    most: min(chunk_n - q * self.quad_slice, self.quad_slice) * 4,
                )
            }
            chunk_start += chunk_n
        }

        // Insert newly extracted interior bricks into pool_hash_slots and save persistent watermarks.
        dispatch(
            prep_slices.bind(
                count: scratch.miss_interior.count(),
                cap: miss_limit,
                most: miss_limit,
                slices: 1,
                args: scratch.surf_args.span_mut(start: 0, count: 1),
            ),
            over: 1,
        )
        dispatch(
            pool_insert.bind(
                active_count: scratch.miss_interior.count(),
                cap_bricks: miss_limit,
                first: 0,
                slot_base_buf: self.pool_slot_base.items(),
                pool_cap: self.pool_cap,
                hash_mask: self.pool_hash_cap - 1,
                pool_keys: self.pool_keys.items(),
                hash_slots: mut self.pool_hash_slots,
            ),
            groups: scratch.surf_args.at(0),
            most: (miss_limit + 63) / 64,
        )
        dispatch(
            save_pool_marks.bind(
                gate: scratch.pool_gate.items(),
                miss_count: scratch.miss_interior.count(),
                miss_limit: miss_limit,
                pool_cap: self.pool_cap,
                verts_count: self.verts.count(),
                quad_count: self.quad_recs.count(),
                thin_count: self.thin_keep.count(),
                pool_tri_count: self.pool_tri_count.items(),
                pool_exact_count: self.pool_exact_cells.count(),
                marks: mut self.pool_marks,
            ),
            over: 1,
        )

        label("mesh_extract_seam")
        // Pass 3: Extract transient 2:1 seam-boundary bricks + seam strip (only when `has_seams`).
        if has_seams && seam_limit > 0 {
            var s_chunk: u32 = 0
            while s_chunk < seam_limit {
                let chunk_n = min(seam_limit - s_chunk, CHUNK_BRICKS)
                let seam_eval_slice = min(self.eval_slice, self.inherit_slice)
                let eval_slices = (chunk_n + seam_eval_slice - 1) / seam_eval_slice
                let quad_slices = (chunk_n + self.quad_slice - 1) / self.quad_slice
                let chunk_slices = max(eval_slices, quad_slices)
                dispatch(
                    prep_chunk.bind(
                        active_count: scratch.active_seam.count(),
                        cap_bricks: seam_limit,
                        chunk_start: s_chunk,
                        eval_slice: seam_eval_slice,
                        quad_slice: self.quad_slice,
                        vert_args: mut scratch.vert_args,
                        eval_args: scratch.eval_args.span_mut(start: 0, count: chunk_slices),
                        quad_args: scratch.quad_args.span_mut(start: 0, count: chunk_slices),
                    ),
                    over: chunk_slices,
                )
                for e in 0..eval_slices {
                    let band = min(chunk_n - e * seam_eval_slice, seam_eval_slice)
                    dispatch(
                        eval_corners.bind(
                            fields: fields,
                            grids: grids,
                            active: scratch.active_seam.items(),
                            active_count: scratch.active_seam.count(),
                            cap_bricks: seam_limit,
                            chunk_start: s_chunk,
                            brick_off: e * seam_eval_slice,
                            corners: scratch.corners_raw.span_mut(
                                start: e * seam_eval_slice * CORNERS_BRICK,
                                count: band * CORNERS_BRICK,
                            ),
                        ),
                        groups: scratch.eval_args.at(e),
                        most: band * 8,
                    )
                    dispatch(
                        inherit_seam_corners.bind(
                            fields: fields,
                            grids: grids,
                            active: scratch.active_seam.items(),
                            active_count: scratch.active_seam.count(),
                            cap_bricks: seam_limit,
                            chunk_start: s_chunk,
                            brick_off: e * seam_eval_slice,
                            corners_in: scratch.corners_raw.items(),
                            corners_out: scratch.corners.span_mut(
                                start: e * seam_eval_slice * CORNERS_BRICK,
                                count: band * CORNERS_BRICK,
                            ),
                        ),
                        groups: scratch.eval_args.at(e),
                        most: band * 8,
                    )
                }
                scratch.creases.clear()
                scratch.surf.clear()
                if self.watched {
                    dispatch(
                        keep_slots.bind(
                            grids: grids,
                            active: scratch.active_seam.items(),
                            active_count: scratch.active_seam.count(),
                            cap_bricks: seam_limit,
                            chunk_start: s_chunk,
                            slot_base: self.pool_seam_base.items(),
                            max_slots: total_slots,
                            slots: mut self.slot_bricks,
                            bits: mut self.watch_bits,
                        ),
                        over: chunk_n,
                    )
                }
                dispatch(
                    classify_cells.bind(
                        grids: grids,
                        active: scratch.active_seam.items(),
                        active_count: scratch.active_seam.count(),
                        cap_bricks: seam_limit,
                        chunk_start: s_chunk,
                        lip: lip,
                        held: if use_exact { 1 } else { 0 },
                        slot_base: self.pool_seam_base.items(),
                        max_slots: total_slots,
                        corners: scratch.corners.items(),
                        cell_verts: scratch.cell_verts.span_mut(
                            start: 0,
                            count: chunk_n * VERTS_STRIDE,
                        ),
                        exact_seen: mut scratch.exact_seen,
                        surf: mut scratch.surf,
                        watch_bits: mut self.watch_bits,
                        thin_keep: mut self.thin_keep,
                    ),
                    groups: scratch.vert_args.at(0),
                    most: chunk_n * 6,
                )
                if uses_kept {
                    dispatch(
                        mark_first.bind(
                            vert_count: self.verts.count(),
                            cap_verts: self.cap_verts,
                            first: mut self.keep_first,
                        ),
                        over: 1,
                    )
                }
                let surf_slices = min(
                    (chunk_n * VERTS_BRICK + self.surf_slice - 1) / self.surf_slice,
                    SLICES_MOST,
                )
                dispatch(
                    prep_slices.bind(
                        count: scratch.surf.count(),
                        cap: CAP_SURF,
                        most: self.surf_slice,
                        slices: surf_slices,
                        args: scratch.surf_args.span_mut(start: 0, count: surf_slices),
                    ),
                    over: surf_slices,
                )
                for k in 0..surf_slices {
                    dispatch(
                        solve_verts.bind(
                            fields: fields,
                            grids: grids,
                            active: scratch.active_seam.items(),
                            chunk_start: s_chunk,
                            corners: scratch.corners.items(),
                            surf: scratch.surf.items(),
                            surf_count: scratch.surf.count(),
                            first: k * self.surf_slice,
                            cap_verts: self.cap_verts,
                            cell_verts: mut scratch.cell_verts,
                            verts: mut self.verts,
                            creases: mut scratch.creases,
                        ),
                        groups: scratch.surf_args.at(k),
                        most: self.surf_slice / 64,
                    )
                }
                let crease_slices = self.crease_slices(chunk_n)
                dispatch(
                    prep_creases.bind(
                        count: scratch.creases.count(),
                        slices: crease_slices,
                        slice: self.crease_slice,
                        args: scratch.crease_args.span_mut(start: 0, count: crease_slices),
                        seen: mut scratch.seam_tri_count,
                    ),
                    over: crease_slices,
                )
                for k in 0..crease_slices {
                    for pass in 0..self.crease_passes {
                        dispatch(
                            refine_creases.bind(
                                fields: fields,
                                grids: grids,
                                active: scratch.active_seam.items(),
                                chunk_start: s_chunk,
                                corners: scratch.corners.items(),
                                creases: scratch.creases.items(),
                                crease_count: scratch.creases.count(),
                                first: k * self.crease_slice,
                                pass: pass,
                                solves: mut scratch.crease_solves,
                                cap_verts: self.cap_verts,
                                cell_verts: mut scratch.cell_verts,
                                verts: mut self.verts,
                            ),
                            groups: scratch.crease_args.at(k),
                            most: self.crease_slice / 64,
                        )
                    }
                }
                if uses_kept {
                    let keep_slices = min(
                        (chunk_n * VERTS_BRICK + self.keep_slice - 1) / self.keep_slice,
                        SLICES_MOST,
                    )
                    dispatch(
                        prep_from.bind(
                            count: self.verts.count(),
                            cap: self.cap_verts,
                            first: self.keep_first.items(),
                            most: self.keep_slice,
                            slices: keep_slices,
                            args: self.keep_args.span_mut(start: 0, count: keep_slices),
                        ),
                        over: keep_slices,
                    )
                    for k in 0..keep_slices {
                        dispatch(
                            keep_verts.bind(
                                fields: fields,
                                verts: self.verts.items(),
                                vert_count: self.verts.count(),
                                cap_verts: self.cap_verts,
                                first: self.keep_first.items(),
                                from: k * self.keep_slice,
                                vert_kept: mut self.vert_kept,
                            ),
                            groups: self.keep_args.at(k),
                            most: self.keep_slice / 64,
                        )
                    }
                }
                dispatch(
                    zero_chunk_counts.bind(
                        counts: scratch.brick_idx_counts.span_mut(start: 0, count: chunk_n),
                        cursors: scratch.brick_idx_cursor.span_mut(start: 0, count: chunk_n),
                    ),
                    over: chunk_n,
                )
                for q in 0..quad_slices {
                    dispatch(
                        count_brick_tris_lod.bind(
                            grids: grids,
                            active: scratch.active_seam.items(),
                            active_count: scratch.active_seam.count(),
                            cap_bricks: seam_limit,
                            chunk_start: s_chunk,
                            brick_off: q * self.quad_slice,
                            corners: scratch.corners.items(),
                            cell_verts: scratch.cell_verts.items(),
                            verts: self.verts.items(),
                            brick_idx_counts: mut scratch.brick_idx_counts,
                        ),
                        groups: scratch.quad_args.at(q),
                        most: min(chunk_n - q * self.quad_slice, self.quad_slice) * 4,
                    )
                }
                scan_chunk_offsets(
                    scratch.active_seam.count(),
                    scratch.brick_idx_counts.items(),
                    mut scratch.group_sums,
                    mut scratch.group_offsets,
                    mut scratch.brick_idx_offsets,
                    mut self.pool_tri_count,
                    cap_bricks: seam_limit,
                    chunk_start: s_chunk,
                    chunk_n: chunk_n,
                )
                dispatch(
                    pool_write_meta.bind(
                        grids: grids,
                        active: scratch.active_seam.items(),
                        active_count: scratch.active_seam.count(),
                        cap_bricks: seam_limit,
                        cap_indices: self.pool_idx_cap,
                        chunk_start: s_chunk,
                        slot_base_buf: self.pool_seam_base.items(),
                        max_slots: total_slots,
                        is_interior: 0,
                        brick_idx_saved: scratch.brick_idx_counts.items(),
                        brick_idx_offsets: scratch.brick_idx_offsets.items(),
                        slot_meta: mut self.pool_slot_meta,
                        pool_keys: mut self.pool_keys,
                        draw_slots: mut scratch.draw_slots,
                    ),
                    over: chunk_n,
                )
                for q in 0..quad_slices {
                    dispatch(
                        emit_tris_lod.bind(
                            grids: grids,
                            active: scratch.active_seam.items(),
                            active_count: scratch.active_seam.count(),
                            cap_bricks: seam_limit,
                            cap_indices: self.pool_idx_cap,
                            cap_trans: self.cap_trans,
                            chunk_start: s_chunk,
                            brick_off: q * self.quad_slice,
                            corners: scratch.corners.items(),
                            cell_verts: scratch.cell_verts.items(),
                            verts: self.verts.items(),
                            brick_idx_offsets: scratch.brick_idx_offsets.items(),
                            brick_idx_counts: mut scratch.brick_idx_cursor,
                            tri_count: mut self.pool_tri_count,
                            indices: mut self.pool_indices,
                            trans_indices: mut self.trans_indices,
                            cut_indices: mut self.cut_indices,
                            seam_quads: mut scratch.seam_quads,
                            seam_cells: mut scratch.seam_cells,
                            seam_verts: mut scratch.seam_verts,
                            held: if use_exact { 1 } else { 0 },
                            slot_base: self.pool_seam_base.items(),
                            max_slots: total_slots,
                            cap_exact_slots: 0,
                            exact_seen: mut scratch.exact_seen,
                            exact_cells: mut scratch.seam_exact_cells,
                            exact_slots: mut scratch.dummy_exact_slots,
                            quad_recs: mut self.quad_recs,
                        ),
                        groups: scratch.quad_args.at(q),
                        most: min(chunk_n - q * self.quad_slice, self.quad_slice) * 4,
                    )
                }
                s_chunk += chunk_n
            }

            // 2:1 seam strip (into transient `scratch.seam_strip_indices`).
            let seam_slices = self.seam_slices()
            dispatch(
                note_seams.bind(
                    seam_count: scratch.seam_cells.count(),
                    tested: seam_slices * self.seam_slice,
                    tri_count: mut scratch.seam_tri_count,
                ),
                over: 1,
            )
            dispatch(
                prep_slices.bind(
                    count: scratch.seam_cells.count(),
                    cap: CAP_SEAM * 2,
                    most: self.seam_slice,
                    slices: seam_slices,
                    args: scratch.seam_args.span_mut(start: 0, count: seam_slices),
                ),
                over: seam_slices,
            )
            if use_exact {
                dispatch(
                    reset_seam_seen.bind(
                        seam_seen: scratch.seam_seen.span_mut(start: 0, count: SEAM_SEEN),
                    ),
                    over: SEAM_SEEN,
                )
                for k in 0..seam_slices {
                    dispatch(
                        box_seam_cells.bind(
                            fields: fields,
                            grids: grids,
                            seam_cells: scratch.seam_cells.items(),
                            seam_cell_count: scratch.seam_cells.count(),
                            first: k * self.seam_slice,
                            seam_seen: mut scratch.seam_seen,
                            exact_cells: mut scratch.seam_exact_cells,
                        ),
                        groups: scratch.seam_args.at(k),
                        most: self.seam_slice / 64,
                    )
                }
            }
            if uses_kept {
                dispatch(
                    mark_first.bind(
                        vert_count: self.verts.count(),
                        cap_verts: self.cap_verts,
                        first: mut self.keep_first,
                    ),
                    over: 1,
                )
            }
            for k in 0..seam_slices {
                dispatch(
                    solve_seam_smooth.bind(
                        fields: fields,
                        grids: grids,
                        seam_cells: scratch.seam_cells.items(),
                        seam_cell_count: scratch.seam_cells.count(),
                        first: k * self.seam_slice,
                        cap_verts: self.cap_verts,
                        verts: mut self.verts,
                        seam_verts: mut scratch.seam_verts,
                        seam_creases: mut scratch.seam_creases,
                    ),
                    groups: scratch.seam_args.at(k),
                    most: self.seam_slice / 64,
                )
            }
            dispatch(
                prep_slices.bind(
                    count: scratch.seam_creases.count(),
                    cap: CAP_SEAM * 2,
                    most: seam_c_slice,
                    slices: seam_c_slices,
                    args: scratch.crease_args.span_mut(start: 0, count: seam_c_slices),
                ),
                over: seam_c_slices,
            )
            for k in 0..seam_c_slices {
                for pass in 0..self.crease_passes {
                    dispatch(
                        refine_seam_creases.bind(
                            fields: fields,
                            grids: grids,
                            seam_cells: scratch.seam_cells.items(),
                            seam_creases: scratch.seam_creases.items(),
                            seam_crease_count: scratch.seam_creases.count(),
                            first: k * seam_c_slice,
                            pass: pass,
                            solves: mut scratch.crease_solves,
                            cap_verts: self.cap_verts,
                            verts: mut self.verts,
                            seam_verts: mut scratch.seam_verts,
                        ),
                        groups: scratch.crease_args.at(k),
                        most: seam_c_slice / 64,
                    )
                }
            }
            if uses_kept {
                dispatch(
                    prep_from.bind(
                        count: self.verts.count(),
                        cap: self.cap_verts,
                        first: self.keep_first.items(),
                        most: self.keep_slice,
                        slices: seam_keep_slices,
                        args: self.keep_args.span_mut(start: 0, count: seam_keep_slices),
                    ),
                    over: seam_keep_slices,
                )
                for k in 0..seam_keep_slices {
                    dispatch(
                        keep_verts.bind(
                            fields: fields,
                            verts: self.verts.items(),
                            vert_count: self.verts.count(),
                            cap_verts: self.cap_verts,
                            first: self.keep_first.items(),
                            from: k * self.keep_slice,
                            vert_kept: mut self.vert_kept,
                        ),
                        groups: self.keep_args.at(k),
                        most: self.keep_slice / 64,
                    )
                }
            }
            dispatch(
                prep_slices.bind(
                    count: scratch.seam_quads.count(),
                    cap: CAP_SEAM,
                    most: CAP_SEAM,
                    slices: 1,
                    args: scratch.surf_args.span_mut(start: 0, count: 1),
                ),
                over: 1,
            )
            dispatch(
                finish_seam_tris.bind(
                    seam_quads: scratch.seam_quads.items(),
                    seam_quad_count: scratch.seam_quads.count(),
                    seam_verts: scratch.seam_verts.items(),
                    verts: self.verts.items(),
                    cap_indices: CAP_SEAM * 6,
                    cap_trans: self.cap_trans,
                    tri_count: mut scratch.seam_tri_count,
                    indices: mut scratch.seam_strip_indices,
                    trans_indices: mut self.trans_indices,
                    cut_indices: mut self.cut_indices,
                ),
                groups: scratch.surf_args.at(0),
                most: CAP_SEAM / 64,
            )
        }

        label("mesh_extract_compact")
        // Pass 4: Compact all active brick indices (hits + new misses + active seams) + seam strip
        // into one contiguous `self.indices` buffer (`< 0.1 ms` on GPU).
        let compact_cap = COMPACT_GROUPS * COMPACT_PER_GROUP
        dispatch(
            compact_count_groups.bind(
                gate: scratch.pool_gate.items(),
                draw_slots: scratch.draw_slots.items(),
                draw_count: scratch.draw_slots.count(),
                cap_slots: compact_cap,
                slot_meta: self.pool_slot_meta.items(),
                group_sums: scratch.compact_group_sums.items_mut(),
            ),
            over: COMPACT_GROUPS,
        )
        dispatch(
            compact_scan_groups.bind(
                gate: scratch.pool_gate.items(),
                group_sums: scratch.compact_group_sums.items(),
                group_offsets: mut scratch.compact_group_offsets,
                seam_start: mut self.seam_start,
            ),
            over: 1,
        )
        dispatch(
            compact_local_offsets.bind(
                gate: scratch.pool_gate.items(),
                draw_slots: scratch.draw_slots.items(),
                draw_count: scratch.draw_slots.count(),
                cap_slots: compact_cap,
                slot_meta: self.pool_slot_meta.items(),
                group_offsets: scratch.compact_group_offsets.items(),
                draw_slot_dst: mut scratch.draw_slot_dst,
            ),
            over: COMPACT_GROUPS,
        )
        dispatch(
            prep_compact_args.bind(
                gate: scratch.pool_gate.items(),
                draw_count: scratch.draw_slots.count(),
                cap_slots: compact_cap,
                seam_tri_count: scratch.seam_tri_count.items(),
                cap_seam_idx: CAP_SEAM * 6,
                pool_exact_count: self.pool_exact_cells.count(),
                cap_pool_exact: self.pool_exact_cap,
                seam_exact_count: scratch.seam_exact_cells.count(),
                cap_seam_exact: CAP_SEAM * 2,
                copy_args: mut scratch.compact_copy_args,
                seam_copy_args: mut scratch.compact_seam_args,
                exact_copy_args: mut scratch.compact_exact_args,
                seam_exact_args: mut scratch.compact_seam_exact_args,
                alive_args: mut scratch.alive_args,
            ),
            over: 1,
        )
        // The committed cut's slots alive (what the outline, the exact cells and the light read);
        // on no commit the drawn cut's stay.
        dispatch(
            pool_clear_alive.bind(
                gate: scratch.pool_gate.items(),
                n: total_slots,
                alive: mut self.brick_alive,
            ),
            over: total_slots,
        )
        dispatch(
            pool_mark_alive.bind(
                gate: scratch.pool_gate.items(),
                draw_slots: scratch.draw_slots.items(),
                draw_count: scratch.draw_slots.count(),
                cap_slots: compact_cap,
                n: total_slots,
                alive: mut self.brick_alive,
            ),
            groups: scratch.alive_args.at(0),
            most: (compact_cap + 63) / 64,
        )
        let copy_k = compact_copy_indices.bind(
            draw_slots: scratch.draw_slots.items(),
            draw_count: scratch.draw_slots.count(),
            cap_slots: compact_cap,
            first: 0,
            slot_meta: self.pool_slot_meta.items(),
            draw_slot_dst: scratch.draw_slot_dst.items(),
            pool_indices: self.pool_indices.items(),
            cap_draw_indices: self.cap_indices,
            draw_indices: mut self.indices,
        )
        let copy_slice = clamp(lane_slice(kernel_work(copy_k), most: compact_cap * 64) / 64, 64, 32768)
        let copy_slices = min((compact_cap + copy_slice - 1) / copy_slice, SLICES_MOST)
        dispatch(
            prep_super_sub.bind(
                super_count: scratch.draw_slots.count(),
                cap_super: compact_cap,
                most: copy_slice,
                slices: copy_slices,
                args: scratch.surf_args.span_mut(start: 0, count: copy_slices),
            ),
            over: copy_slices,
        )
        for k in 0..copy_slices {
            dispatch(
                compact_copy_indices.bind(
                    draw_slots: scratch.draw_slots.items(),
                    draw_count: scratch.draw_slots.count(),
                    cap_slots: compact_cap,
                    first: k * copy_slice,
                    slot_meta: self.pool_slot_meta.items(),
                    draw_slot_dst: scratch.draw_slot_dst.items(),
                    pool_indices: self.pool_indices.items(),
                    cap_draw_indices: self.cap_indices,
                    draw_indices: mut self.indices,
                ),
                groups: scratch.surf_args.at(k),
                most: copy_slice,
            )
        }
        if has_seams {
            dispatch(
                compact_append_seam_strip.bind(
                    seam_tri_count: scratch.seam_tri_count.items(),
                    cap_seam_idx: CAP_SEAM * 6,
                    seam_start: self.seam_start.items(),
                    seam_strip_indices: scratch.seam_strip_indices.items(),
                    cap_draw_indices: self.cap_indices,
                    draw_indices: mut self.indices,
                ),
                groups: scratch.compact_seam_args.at(0),
                most: (CAP_SEAM * 6 + 63) / 64,
            )
        }
        if use_exact {
            self.exact_cells.count_from(scratch.pool_gate.items().sub(start: GATE_EXACT, count: 1))
            dispatch(
                compact_pool_exact.bind(
                    pool_exact_cells: self.pool_exact_cells.items(),
                    pool_exact_slots: self.pool_exact_slots.items(),
                    pool_exact_count: self.pool_exact_cells.count(),
                    cap_pool_exact: self.pool_exact_cap,
                    brick_alive: self.brick_alive.items(),
                    exact_cells: mut self.exact_cells,
                ),
                groups: scratch.compact_exact_args.at(0),
                most: (self.pool_exact_cap + 63) / 64,
            )
            if has_seams {
                dispatch(
                    compact_seam_exact.bind(
                        seam_exact_cells: scratch.seam_exact_cells.items(),
                        seam_exact_count: scratch.seam_exact_cells.count(),
                        cap_seam_exact: CAP_SEAM * 2,
                        exact_cells: mut self.exact_cells,
                    ),
                    groups: scratch.compact_seam_exact_args.at(0),
                    most: (CAP_SEAM * 2 + 63) / 64,
                )
            }
        }
        dispatch(
            finish_pool_draw.bind(
                gate: scratch.pool_gate.items(),
                active_count: scratch.active.count(),
                verts_count: self.verts.count(),
                seam_quad_count: scratch.seam_quads.count(),
                seam_cell_count: scratch.seam_cells.count(),
                exact_count: self.exact_cells.count(),
                seam_start: self.seam_start.items(),
                seam_tri_count: scratch.seam_tri_count.items(),
                pool_tri_count: self.pool_tri_count.items(),
                pool_stats: scratch.pool_stats.items(),
                has_seams: if has_seams { 1 } else { 0 },
                cap_indices: self.cap_indices,
                cap_pool_indices: self.pool_idx_cap,
                cap_trans: self.cap_trans,
                cap_exact: self.cap_exact,
                cap_pool_exact: self.pool_exact_cap,
                inst_count: 1,
                tri_count: mut self.tri_count,
                args: mut self.draw_args,
                trans_args: mut self.trans_draw_args,
                cut_args: mut self.cut_draw_args,
                seam_args: mut self.seam_draw_args,
                exact_args: mut self.exact_draw_args,
                marks: mut self.pool_marks,
            ),
            over: 1,
        )
        if use_exact {
            copy(from: self.exact_cells.count().sub(start: 0, count: 1), to: self.exact_base.items_mut())
        }
        self.pooled = true
        self.has_exact = use_exact
        self.has_brick_draws = false
        self.has_seams = has_seams
        self.edit_patched = false
        self.cpu_brick_slots = total_slots
        self.note_extracted(true)
        // The last few updates' cuts, for their readbacks (a moving eye updates every frame or
        // two, and a readback comes a frame or two after).
        var kept_cuts: Vec<GridSpec> = Vec::new()
        var kept_at: Vec<vec3u> = Vec::new()
        let first = if self.pool_pending_at.len() >= POOL_PENDING { 1 } else { 0 }
        for k in first..self.pool_pending_at.len() {
            let at = self.pool_pending_at[k]
            kept_at.push(vec3u(at.x, kept_cuts.len(), at.z))
            for j in 0..at.z {
                kept_cuts.push(self.pool_pending[at.y + j])
            }
        }
        kept_at.push(vec3u(self.gen, kept_cuts.len(), cut.len()))
        for j in 0..cut.len() {
            kept_cuts.push(cut[j])
        }
        self.pool_pending = take kept_cuts
        self.pool_pending_at = take kept_at
    }

    /// Runs the 4-pass GPU rest-pose Hermite Dual Contouring pipeline for `Skinned` fields,
    /// outputting 16-byte compact `MeshVertex` + 8-byte auto-computed `skin_verts` ONCE.
    fn run_extract_skinned<M: Field<Substance>>(
        mut self,
        scratch: mut ExtractScratch,
        fields: GpuSpan<M>,
        sample: M,
        things: u32,
        total_bricks: u32,
        inst_count: u32,
    ) {
        label("mesh_extract")
        let step = crease_step_cost_rest_of(sample)
        let crease_kernel = refine_creases_rest.bind(
            fields: fields,
            grids: scratch.grids.items(),
            active: scratch.active.items(),
            chunk_start: 0,
            corners: scratch.corners.items(),
            creases: scratch.creases.items(),
            crease_count: scratch.creases.count(),
            first: 0,
            pass: 0,
            solves: mut scratch.crease_solves,
            cap_verts: self.cap_verts,
            cell_verts: mut scratch.cell_verts,
            verts: mut self.verts,
            skin_verts: mut self.skin_verts,
        )
        self.crease_slice = crease_slice(kernel_work(crease_kernel))
        self.crease_passes = crease_passes(crease_part(step))
        let surf_kernel = solve_verts_rest.bind(
            fields: fields,
            grids: scratch.grids.items(),
            active: scratch.active.items(),
            chunk_start: 0,
            corners: scratch.corners.items(),
            surf: scratch.surf.items(),
            surf_count: scratch.surf.count(),
            first: 0,
            cap_verts: self.cap_verts,
            cell_verts: mut scratch.cell_verts,
            verts: mut self.verts,
            skin_verts: mut self.skin_verts,
            creases: mut scratch.creases,
        )
        self.surf_slice = surf_slice(kernel_work(surf_kernel))
        self.eval_slice = brick_slice(
            lanes: 512,
            invocation: kernel_work(eval_corners_rest.bind(
                fields: fields,
                grids: scratch.grids.items(),
                active: scratch.active.items(),
                active_count: scratch.active.count(),
                cap_bricks: self.max_bricks,
                chunk_start: 0,
                brick_off: 0,
                corners: scratch.corners.span_mut(start: 0, count: CORNERS_BRICK),
            )),
        )
        self.quad_slice = brick_slice(lanes: 256, invocation: kernel_work(emit_tris.bind(
            grids: scratch.grids.items(),
            active: scratch.active.items(),
            active_count: scratch.active.count(),
            cap_bricks: self.max_bricks,
            cap_indices: self.cap_indices,
            cap_trans: self.cap_trans,
            chunk_start: 0,
            brick_off: 0,
            held: if (vec4(0.0)).w > 0.0 { 1 } else { 0 },
            slot_base: scratch.zero_u32.items(),
            max_slots: self.watch_slots_cap,
            cap_exact_slots: 0,
            corners: scratch.corners.items(),
            cell_verts: scratch.cell_verts.items(),
            verts: self.verts.items(),
            brick_idx_offsets: scratch.brick_idx_offsets.items(),
            brick_idx_counts: mut scratch.brick_idx_cursor,
            tri_count: mut self.tri_count,
            indices: mut self.indices,
            trans_indices: mut self.trans_indices,
            cut_indices: mut self.cut_indices,
            exact_seen: mut scratch.exact_seen,
            exact_cells: mut self.exact_cells,
            exact_slots: mut scratch.dummy_exact_slots,
            quad_recs: mut self.quad_recs,
        )))
        self.ensure_cap(min(total_bricks, self.max_bricks))
        self.ensure_skin_verts(self.cap_verts)

        let effective_cap = min(self.cap_bricks, scratch.max_bricks)
        scratch.active.clear()
        self.verts.clear()
        self.exact_cells.clear()
        write(mut self.tri_count, 0, Vec::filled(TRI_WORDS, 0))

        let grids = scratch.grids.items()
        let cull_most = lane_slice(
            kernel_work(cull_bricks_rest.bind(
                fields: fields,
                grids: grids,
                things: things,
                first_brick: 0,
                total_bricks: total_bricks,
                active: mut scratch.active,
            )),
            most: CULL_CHUNK,
        )
        var first: u32 = 0
        while first < total_bricks {
            let n = min(total_bricks - first, cull_most)
            dispatch(
                cull_bricks_rest.bind(
                    fields: fields,
                    grids: grids,
                    things: things,
                    first_brick: first,
                    total_bricks: total_bricks,
                    active: mut scratch.active,
                ),
                over: n,
            )
            first += n
        }

        let hard_cap = self.chunk_limit(total_bricks, min(effective_cap, total_bricks))
        self.extract_total = total_bricks
        self.extract_limit = hard_cap
        var chunk_start: u32 = 0
        while chunk_start < hard_cap {
            let chunk_n = min(hard_cap - chunk_start, CHUNK_BRICKS)
            let eval_slices = (chunk_n + self.eval_slice - 1) / self.eval_slice
            let quad_slices = (chunk_n + self.quad_slice - 1) / self.quad_slice
            let chunk_slices = max(eval_slices, quad_slices)
            dispatch(
                prep_chunk.bind(
                    active_count: scratch.active.count(),
                    cap_bricks: effective_cap,
                    chunk_start: chunk_start,
                    eval_slice: self.eval_slice,
                    quad_slice: self.quad_slice,
                    vert_args: mut scratch.vert_args,
                    eval_args: scratch.eval_args.span_mut(start: 0, count: chunk_slices),
                    quad_args: scratch.quad_args.span_mut(start: 0, count: chunk_slices),
                ),
                over: chunk_slices,
            )
            for e in 0..eval_slices {
                dispatch(
                    eval_corners_rest.bind(
                        fields: fields,
                        grids: grids,
                        active: scratch.active.items(),
                        active_count: scratch.active.count(),
                        cap_bricks: effective_cap,
                        chunk_start: chunk_start,
                        brick_off: e * self.eval_slice,
                        corners: scratch.corners.span_mut(
                            start: e * self.eval_slice * CORNERS_BRICK,
                            count: min(chunk_n - e * self.eval_slice, self.eval_slice) * CORNERS_BRICK,
                        ),
                    ),
                    groups: scratch.eval_args.at(e),
                    most: min(chunk_n - e * self.eval_slice, self.eval_slice) * 8,
                )
            }
            scratch.creases.clear()
            scratch.surf.clear()
            scratch.thin_cands.clear()
            dispatch(
                classify_cells.bind(
                    grids: grids,
                    active: scratch.active.items(),
                    active_count: scratch.active.count(),
                    cap_bricks: effective_cap,
                    chunk_start: chunk_start,
                    lip: 1.0,
                    held: if (vec4(0.0)).w > 0.0 { 1 } else { 0 },
                    slot_base: scratch.zero_u32.items(),
                    max_slots: self.watch_slots_cap,
                    corners: scratch.corners.items(),
                    cell_verts: scratch.cell_verts.span_mut(
                        start: 0,
                        count: chunk_n * VERTS_STRIDE,
                    ),
                    exact_seen: mut scratch.exact_seen,
                    surf: mut scratch.surf,
                    watch_bits: mut self.watch_bits,
                    thin_keep: mut self.thin_keep,
                ),
                groups: scratch.vert_args.at(0),
                most: chunk_n * 6,
            )
            let surf_slices = min(
                (chunk_n * VERTS_BRICK + self.surf_slice - 1) / self.surf_slice,
                SLICES_MOST,
            )
            dispatch(
                prep_slices.bind(
                    count: scratch.surf.count(),
                    cap: CAP_SURF,
                    most: self.surf_slice,
                    slices: surf_slices,
                    args: scratch.surf_args.span_mut(start: 0, count: surf_slices),
                ),
                over: surf_slices,
            )
            for k in 0..surf_slices {
                dispatch(
                    solve_verts_rest.bind(
                        fields: fields,
                        grids: grids,
                        active: scratch.active.items(),
                        chunk_start: chunk_start,
                        corners: scratch.corners.items(),
                        surf: scratch.surf.items(),
                        surf_count: scratch.surf.count(),
                        first: k * self.surf_slice,
                        cap_verts: self.cap_verts,
                        cell_verts: mut scratch.cell_verts,
                        verts: mut self.verts,
                        skin_verts: mut self.skin_verts,
                        creases: mut scratch.creases,
                    ),
                    groups: scratch.surf_args.at(k),
                    most: self.surf_slice / 64,
                )
            }
            // The chunk's creases, in dispatches of at most `self.crease_slice` cells, their counts
            // prepared in one dispatch (a slice past the list's end dispatches no groups).
            let crease_slices = self.crease_slices(chunk_n)
            dispatch(
                prep_creases.bind(
                    count: scratch.creases.count(),
                    slices: crease_slices,
                    slice: self.crease_slice,
                    args: scratch.crease_args.span_mut(start: 0, count: crease_slices),
                    seen: mut self.tri_count,
                ),
                over: crease_slices,
            )
            for k in 0..crease_slices {
                for pass in 0..self.crease_passes {
                    dispatch(
                        refine_creases_rest.bind(
                            fields: fields,
                            grids: grids,
                            active: scratch.active.items(),
                            chunk_start: chunk_start,
                            corners: scratch.corners.items(),
                            creases: scratch.creases.items(),
                            crease_count: scratch.creases.count(),
                            first: k * self.crease_slice,
                            pass: pass,
                            solves: mut scratch.crease_solves,
                            cap_verts: self.cap_verts,
                            cell_verts: mut scratch.cell_verts,
                            verts: mut self.verts,
                            skin_verts: mut self.skin_verts,
                        ),
                        groups: scratch.crease_args.at(k),
                        most: self.crease_slice / 64,
                    )
                }
            }
            dispatch(
                zero_chunk_counts.bind(
                    counts: scratch.brick_idx_counts.span_mut(start: 0, count: chunk_n),
                    cursors: scratch.brick_idx_cursor.span_mut(start: 0, count: chunk_n),
                ),
                over: chunk_n,
            )
            for q in 0..quad_slices {
                dispatch(
                    count_brick_tris.bind(
                        active_count: scratch.active.count(),
                        cap_bricks: effective_cap,
                        chunk_start: chunk_start,
                        brick_off: q * self.quad_slice,
                        corners: scratch.corners.items(),
                        cell_verts: scratch.cell_verts.items(),
                        verts: self.verts.items(),
                        brick_idx_counts: mut scratch.brick_idx_counts,
                    ),
                    groups: scratch.quad_args.at(q),
                    most: min(chunk_n - q * self.quad_slice, self.quad_slice) * 4,
                )
            }
            scan_chunk_offsets(
                scratch.active.count(),
                scratch.brick_idx_counts.items(),
                mut scratch.group_sums,
                mut scratch.group_offsets,
                mut scratch.brick_idx_offsets,
                mut self.tri_count,
                cap_bricks: effective_cap,
                chunk_start: chunk_start,
                chunk_n: chunk_n,
            )
            for q in 0..quad_slices {
                dispatch(
                    emit_tris.bind(
                        grids: grids,
                        active: scratch.active.items(),
                        active_count: scratch.active.count(),
                        cap_bricks: effective_cap,
                        cap_indices: self.cap_indices,
                        cap_trans: self.cap_trans,
                        chunk_start: chunk_start,
                        brick_off: q * self.quad_slice,
                        held: if (vec4(0.0)).w > 0.0 { 1 } else { 0 },
                        slot_base: scratch.zero_u32.items(),
                        max_slots: self.watch_slots_cap,
                        cap_exact_slots: 0,
                        corners: scratch.corners.items(),
                        cell_verts: scratch.cell_verts.items(),
                        verts: self.verts.items(),
                        brick_idx_offsets: scratch.brick_idx_offsets.items(),
                        brick_idx_counts: mut scratch.brick_idx_cursor,
                        tri_count: mut self.tri_count,
                        indices: mut self.indices,
                        trans_indices: mut self.trans_indices,
                        cut_indices: mut self.cut_indices,
                        exact_seen: mut scratch.exact_seen,
                        exact_cells: mut self.exact_cells,
                        exact_slots: mut scratch.dummy_exact_slots,
                        quad_recs: mut self.quad_recs,
                    ),
                    groups: scratch.quad_args.at(q),
                    most: min(chunk_n - q * self.quad_slice, self.quad_slice) * 4,
                )
            }
            chunk_start += chunk_n
        }

        dispatch(
            finish_draw.bind(
                active_count: scratch.active.count(),
                vert_count: self.verts.count(),
                seam_quad_count: scratch.seam_quads.count(),
                seam_cell_count: scratch.seam_cells.count(),
                exact_count: self.exact_cells.count(),
                seam_start: self.seam_start.items(),
                has_seams: 0,
                cap_indices: self.cap_indices,
                cap_trans: self.cap_trans,
                cap_exact: self.cap_exact,
                inst_count: inst_count,
                tri_count: mut self.tri_count,
                args: mut self.draw_args,
                trans_args: mut self.trans_draw_args,
                cut_args: mut self.cut_draw_args,
                seam_args: mut self.seam_draw_args,
                exact_args: mut self.exact_draw_args,
            ),
            over: 1,
        )
        self.pooled = false
        self.has_exact = false
        self.has_brick_draws = false
        self.has_seams = false
        self.edit_patched = false
        self.cpu_brick_slots = 0
        self.note_extracted(true)
    }
}

/// The most parts whose states a batch keeps (`part_states`): past it, the whole field's hash.
const MOST_PARTS: u32 = 256

/// Each part of `field`'s state hash and box (`Surface::part_state`, `part_bound`), or none
/// where it has one part, more than `MOST_PARTS`, or a part that can't say what it's made of
/// (then the whole field's hash decides, as before).
pub(package) fn part_states<M: Field<Substance>>(field: M) -> Option<(Vec<u64>, Vec<Box3>)> {
    let n = field.parts()
    if n < 2 || n > MOST_PARTS {
        return None
    }
    var hs: Vec<u64> = Vec::new()
    var bs: Vec<Box3> = Vec::new()
    for i in 0..n {
        var h = Hasher::new()
        if !field.part_state(i, mut h) {
            return None
        }
        hs.push(h.finish())
        let b = field.part_bound(i)
        let r = vec3(min(b.radius, 1.0e4))
        bs.push(Box3 { lo: b.centre - r, hi: b.centre + r })
    }
    Some((hs, bs))
}

/// A part's change class (docs/plans/engine-at-build.md, phase 2), slow to fast: its state the same
/// at every moment (`NEVER`), moved by the game's state at a tick (`STATE`), moved every frame
/// (`FRAME`), moved with the eye (`EYE`).
pub const NEVER: u32 = 0
pub const STATE: u32 = 1
pub const FRAME: u32 = 2
pub const EYE: u32 = 3

/// The class of each part of a kind, from the field at two moments a frame apart, `then` and
/// `now`: a part whose state (`Surface::part_state`) moved is `FRAME`, else `NEVER`. Where the
/// parts can't say what they're made of, every part takes the whole field's.
pub fn part_classes<M: Field<Substance> + StateHash>(then: M, now: M) -> Vec<u32> {
    var out: Vec<u32> = Vec::new()
    match (part_states(then), part_states(now)) {
        (Some((a, _)), Some((b, _))) => {
            for i in 0..a.len() {
                out.push(if a[i] == b[i] { NEVER } else { FRAME })
            }
        },
        _ => {
            let whole = if state_hash(then) == state_hash(now) { NEVER } else { FRAME }
            for _i in 0..now.parts() {
                out.push(whole)
            }
        },
    }
    out
}

/// Stops where `field`, of a kind that says it can't be skinned (`Surface::MAY_SKIN` false: its
/// extraction and draws have no skinned path, built so), is skinned all the same: those draws
/// would draw it at rest.
pub(package) fn held_unskinned<M: Field<Substance>>(field: M) {
    assert(
        field.skin_shape_hash().is_none(),
        "a skinned field's kind says it can't be skinned (`Surface::MAY_SKIN`): its draws have no skinned path",
    )
}
