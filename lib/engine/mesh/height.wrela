// Universal GPU Geometry Clipmap realization for `Height` fields (Losasso & Hoppe, SIGGRAPH 2004):
// draws nested indexed square rings around the eye directly into the unified 4× MSAA reversed-Z
// eye pass and `MeshVary` shading pipeline, so continuous ocean swells and distant terrain share
// the exact same depth buffer, shadows, GI radiance cache, volumetrics, and `Look`.

use matter::height::Height
use mesh::light::clip_of
use picture::eye::View
use std::collections::Vec
use std::gpu::{ClipPosition, GpuBuffer, InstanceIndex, VertexIndex, buffer_of}

/// Quads per side of each clipmap ring (`64×64` quads over `65×65 = 4,225` shared grid vertices).
pub const CLIP_N: u32 = 64
pub const CLIP_GRID: u32 = 65
/// Number of nested clipmap rings (base step 0.25 m -> covers ±256 m seamlessly).
pub const CLIP_RINGS: u32 = 6
const CLIP_BASE_STEP: f32 = 0.25

/// Static index buffers for the inner solid clipmap ring (`level == 0`) and the outer hollow
/// clipmap rings (`level 1..CLIP_RINGS`, omitting the interior covered by `level - 1` while
/// keeping a 1-quad overlap collar). Shared vertices hit the hardware post-transform cache (~6×
/// fewer `Height::height_at` evaluations than unindexed triangles).
pub struct ClipmapMesh {
    pub inner_indices: GpuBuffer<u32>,
    pub inner_count: u32,
    pub outer_indices: GpuBuffer<u32>,
    pub outer_count: u32,
}

/// Builds the static index buffers for inner and outer clipmap rings once at startup.
pub fn clipmap_mesh() -> ClipmapMesh {
    var inner: Vec<u32> = Vec::new()
    var outer: Vec<u32> = Vec::new()
    let q4 = CLIP_N / 4
    let q34 = CLIP_N - q4
    for qz in 0..CLIP_N {
        for qx in 0..CLIP_N {
            let v00 = qz * CLIP_GRID + qx
            let v10 = v00 + 1
            let v01 = v00 + CLIP_GRID
            let v11 = v01 + 1
            // Two CCW triangles viewed from +Y: (0,0)-(0,1)-(1,1) and (0,0)-(1,1)-(1,0).
            inner.push(v00)
            inner.push(v01)
            inner.push(v11)
            inner.push(v00)
            inner.push(v11)
            inner.push(v10)
            let in_hole = qx >= q4 + 1 && qx < q34 - 1 && qz >= q4 + 1 && qz < q34 - 1
            if !in_hole {
                outer.push(v00)
                outer.push(v01)
                outer.push(v11)
                outer.push(v00)
                outer.push(v11)
                outer.push(v10)
            }
        }
    }
    let inner_count = inner.len()
    let outer_count = outer.len()
    ClipmapMesh {
        inner_indices: buffer_of(inner),
        inner_count,
        outer_indices: buffer_of(outer),
        outer_count,
    }
}

/// Interpolants shared between `mesh_vs` (Dual Contouring meshlets) and `height_vs` (clipmap rings)
/// so both pass through the exact same unified physically-based shading pipeline.
///   `pbr`:    `(roughness, metallic, ior, smooth)`
///   `optics`: `(transmission, subsurface, coat, micro)`
pub struct MeshVary: Copy {
    pub clip: ClipPosition,
    pub wp: vec3,
    pub prev_wp: vec3,
    pub normal: vec3,
    pub albedo: vec3,
    pub emits: vec3,
    pub pbr: vec4,
    pub optics: vec4,
}

/// A vertex outside every clip volume: the triangles it belongs to are dropped before rasterising.
fn culled_vary() -> MeshVary {
    MeshVary {
        clip: ClipPosition { position: vec4(0.0, 0.0, 0.0, 0.0) },
        wp: vec3(0.0),
        prev_wp: vec3(0.0),
        normal: vec3(0.0, 1.0, 0.0),
        albedo: vec3(0.0),
        emits: vec3(0.0),
        pbr: vec4(1.0, 0.0, 1.0, 1.0),
        optics: vec4(0.0),
    }
}

/// Evaluates one shared clipmap grid vertex for ring `base_level + ii.index`.
/// `trans_pass == 0` emits only opaque terrain vertices; `trans_pass == 1` emits only transmissive
/// water vertices, collapsing the other kind to degenerate triangles with zero fragment cost.
@vertex
pub fn height_vs<H: Height>(
    height: H,
    v: View,
    base_level: u32,
    trans_pass: u32,
    vi: VertexIndex,
    ii: InstanceIndex,
) -> MeshVary {
    let gz = vi.index / CLIP_GRID
    let gx = vi.index - gz * CLIP_GRID
    let level = base_level + ii.index

    let step = CLIP_BASE_STEP * f32(1 << level)
    // Snap ring centre to `2 * step` (the parent ring's grid) so nested rings meet vertex-for-vertex.
    let snap = step * 2.0
    let cx = floor(v.at.x / snap) * snap
    let cz = floor(v.at.z / snap) * snap
    let half = f32(CLIP_N) * 0.5
    let wx = cx + (f32(gx) - half) * step
    let wz = cz + (f32(gz) - half) * step

    let hs = height.height_at(vec2(wx, wz))
    let is_trans = hs.sub.transmission > 0.02
    if (trans_pass == 0 && is_trans) || (trans_pass != 0 && !is_trans) {
        return culled_vary()
    }
    let wp = vec3(wx, hs.y, wz)
    MeshVary {
        clip: clip_of(v, wp),
        wp,
        prev_wp: wp,
        normal: hs.normal,
        albedo: hs.sub.albedo,
        emits: hs.sub.emits,
        pbr: vec4(hs.sub.roughness, hs.sub.metallic, hs.sub.ior, 1.0),
        optics: vec4(hs.sub.transmission, hs.sub.subsurface, hs.sub.coat, hs.sub.micro),
    }
}
