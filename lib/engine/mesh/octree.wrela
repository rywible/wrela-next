// Persistent sparse 6^3 brick octree for continual view-adaptive streaming LOD:
// anchors every static/edited field to an immutable power-of-two root lattice, splits and merges
// individual bricks by screen-space error with strict 2:1 neighbor balance and hysteresis, and
// caps per-frame GPU extraction work to a bounded brick budget so moving cameras never hitch.

use matter::substance::Substance
use mesh::dc::eye_step
use mesh::grid::{
    ActiveBrick, BRICK, CELL_PX, GridSpec, NONE, box_in_frustum, frustum_cull_view, steep,
    tight_aabb,
}
use picture::eye::{Eye, View, view}
use std::collections::Vec
use std::derive::{Box3, value_and_gradient, work}
use std::field::{ALL_LIVE, Field}
use std::hash::{Hasher, StateHash}

/// Maximum octree depth (`0..MAX_OCTREE_LEVELS`, up to `2^8 = 256x` cell refinement ratio).
pub const MAX_OCTREE_LEVELS: u32 = 9

/// Node lifecycle state in `OctNode::state` so merged (recycled) children still present in
/// `OctreeMap` are never mistaken for subdivided `NODE_INTERNAL` (`NBR_FINER`) nodes.
pub const NODE_INACTIVE: u32 = 0
pub const NODE_LEAF: u32 = 1
pub const NODE_INTERNAL: u32 = 2

/// 2-bit per-neighbor level relationship packed in `ActiveBrick::nbr_lo` / `nbr_hi` (`3x3x3`).
pub const NBR_SAME: u32 = 0
pub const NBR_FINER: u32 = 1
pub const NBR_COARSER: u32 = 2
/// Bitmask covering the 22 neighbor bits in `ActiveBrick::nbr_hi` (`slots 16..26`).
pub const NBR_HI_MASK: u32 = 4194303
/// Flag bit in `ActiveBrick::nbr_hi` marking a non-planar brick that is still awaiting streaming
/// refinement (`cell_px > 2 * fine_px`), so front-facing cells also certify against protruding
/// sub-cell features until the brick refines; converged and planar `flat_px` bricks leave this 0.
pub const NBR_FLAG_UNREFINED: u32 = 2147483648

/// Flat index (`0..26`) of neighbor offset `(dx, dy, dz)` in `{-1, 0, +1}^3`.
pub fn nbr_index(dx: i32, dy: i32, dz: i32) -> u32 {
    u32(dx + 1) + u32(dy + 1) * 3 + u32(dz + 1) * 9
}

/// Reads the 2-bit neighbor state at offset `(dx, dy, dz)` from `(nbr_lo, nbr_hi)`.
pub fn nbr_get(nbr_lo: u32, nbr_hi: u32, dx: i32, dy: i32, dz: i32) -> u32 {
    let idx = nbr_index(dx, dy, dz)
    if idx < 16 { (nbr_lo >> (idx * 2)) & 3 } else { (nbr_hi >> ((idx - 16) * 2)) & 3 }
}

/// Writes the 2-bit neighbor state `val` at offset `(dx, dy, dz)` into `(nbr_lo, nbr_hi)`.
pub fn nbr_set(nbr_lo: u32, nbr_hi: u32, dx: i32, dy: i32, dz: i32, val: u32) -> (u32, u32) {
    let idx = nbr_index(dx, dy, dz)
    let v = val & 3
    if idx < 16 {
        let sh = idx * 2
        ((nbr_lo & !(3 << sh)) | (v << sh), nbr_hi)
    } else {
        let sh = (idx - 16) * 2
        (nbr_lo, (nbr_hi & !(3 << sh)) | (v << sh))
    }
}

/// True iff any neighbor in `(nbr_lo, nbr_hi)` is `NBR_COARSER (2)` (bit 1 of any 2-bit slot).
pub fn nbr_has_coarser(nbr_lo: u32, nbr_hi: u32) -> bool {
    // 0xAAAAAAAA = 2863311530, 0x002AAAAA = 2796202 (slots 16..26).
    (nbr_lo & 2863311530) != 0 || (nbr_hi & 2796202) != 0
}

/// True iff any neighbor in `(nbr_lo, nbr_hi)` differs in level (`NBR_FINER` or `NBR_COARSER`).
pub fn nbr_has_any_seam(nbr_lo: u32, nbr_hi: u32) -> bool {
    nbr_lo != 0 || (nbr_hi & NBR_HI_MASK) != 0
}

/// Neighbor state (`NBR_SAME`, `NBR_FINER`, `NBR_COARSER`) for a brick-local cell shifted by `+1`
/// (`lp = local_cell + (1, 1, 1)`, so `lp == 0` means `-1`, `lp in 1..=6` means interior `0..5`,
/// and `lp == 7` means `+1` halo).
pub fn cell_nbr_state_p(nbr_lo: u32, nbr_hi: u32, lp: vec3u) -> u32 {
    let dx: i32 = if lp.x == 0 { -1 } else if lp.x > BRICK { 1 } else { 0 }
    let dy: i32 = if lp.y == 0 { -1 } else if lp.y > BRICK { 1 } else { 0 }
    let dz: i32 = if lp.z == 0 { -1 } else if lp.z > BRICK { 1 } else { 0 }
    if dx == 0 && dy == 0 && dz == 0 {
        return NBR_SAME
    }
    nbr_get(nbr_lo, nbr_hi, dx, dy, dz)
}

/// True iff brick-local corner `(cx, cy, cz)` in `0..8` touches at least one `NBR_COARSER`
/// neighbor (so odd coordinates on that seam face/edge must inherit coarse sign-preserving values
/// in `inherit_seam_corners` for exact fine/coarse sign agreement).
/// Halo corners (`c == 7`) live inside the `+1` neighbor and check the exact same neighbors that
/// the `+1` neighbor's `c == 1` corner checks, guaranteeing bit-for-bit agreement across bricks.
pub fn corner_on_coarser_seam(nbr_lo: u32, nbr_hi: u32, cx: u32, cy: u32, cz: u32) -> bool {
    if !nbr_has_coarser(nbr_lo, nbr_hi) {
        return false
    }
    let x0: i32 = if cx == 0 { -1 } else if cx == 7 { 1 } else { 0 }
    let x1: i32 = if cx >= 6 { 1 } else { 0 }
    let y0: i32 = if cy == 0 { -1 } else if cy == 7 { 1 } else { 0 }
    let y1: i32 = if cy >= 6 { 1 } else { 0 }
    let z0: i32 = if cz == 0 { -1 } else if cz == 7 { 1 } else { 0 }
    let z1: i32 = if cz >= 6 { 1 } else { 0 }
    for oz in 0..2 {
        let dz = z0 + i32(oz)
        if dz <= z1 {
            for oy in 0..2 {
                let dy = y0 + i32(oy)
                if dy <= y1 {
                    for ox in 0..2 {
                        let dx = x0 + i32(ox)
                        if dx <= x1 &&
                            (dx != 0 || dy != 0 || dz != 0) &&
                            nbr_get(nbr_lo, nbr_hi, dx, dy, dz) == NBR_COARSER {
                            return true
                        }
                    }
                }
            }
        }
    }
    false
}

/// Unique edge-ownership predicate for `slot in 0..4` along `axis` (`0=X, 1=Y, 2=Z`) at edge
/// indices `(eb, ec)` in `0..6` across the two perpendicular axes `(ub, uc)`.
/// Guarantees that around every brick-boundary edge shared by up to 4 bricks `{A, B, C, D}`,
/// **exactly one** finest-level brick owns the edge (priority `A > B > C > D`), giving zero
/// missing edges and zero duplicate edges on any 2:1-balanced 3D octree.
pub fn octree_edge_owned(nbr_lo: u32, nbr_hi: u32, axis: u32, eb: u32, ec: u32, slot: u32) -> bool {
    if slot == 0 {
        return true
    }
    let ubx: i32 = if axis == 2 { 1 } else { 0 }
    let uby: i32 = if axis == 0 { 1 } else { 0 }
    let ubz: i32 = if axis == 1 { 1 } else { 0 }
    let ucx: i32 = if axis == 1 { 1 } else { 0 }
    let ucy: i32 = if axis == 2 { 1 } else { 0 }
    let ucz: i32 = if axis == 0 { 1 } else { 0 }
    if slot == 1 {
        if eb != 0 {
            return false
        }
        // Negative-ub face edge: owned when `-ub` is COARSER, except at `ec == 5` where
        // neighbor `(-ub + uc)` has higher priority (`B > C`) whenever it is not COARSER.
        if nbr_get(nbr_lo, nbr_hi, -ubx, -uby, -ubz) != NBR_COARSER {
            return false
        }
        if ec == BRICK - 1 &&
            nbr_get(nbr_lo, nbr_hi, -ubx + ucx, -uby + ucy, -ubz + ucz) != NBR_COARSER {
            return false
        }
        return true
    }
    if slot == 2 {
        if ec != 0 {
            return false
        }
        // Negative-uc face edge: owned whenever `-uc` is COARSER (at `eb == 5`, we are `B > C`).
        return nbr_get(nbr_lo, nbr_hi, -ucx, -ucy, -ucz) == NBR_COARSER
    }
    // `slot == 3`: `(0, 0)` corner edge along `axis`, owned iff all three of `-ub`, `-uc`,
    // and `-ub - uc` are COARSER (`D` yields to `A`, `B`, and `C`).
    eb == 0 &&
        ec == 0 &&
        nbr_get(nbr_lo, nbr_hi, -ubx, -uby, -ubz) == NBR_COARSER &&
        nbr_get(nbr_lo, nbr_hi, -ucx, -ucy, -ucz) == NBR_COARSER &&
        nbr_get(nbr_lo, nbr_hi, -ubx - ucx, -uby - ucy, -ubz - ucz) == NBR_COARSER
}

/// Enclosing coarse parent-grid cell coordinate of fine cell `qp - 1` (shifted by `+1` so `-1`
/// maps to `0`), valid for root-aligned octree levels where `cell_offset == 0`.
pub fn octree_parent_cell_p(qp: vec3u) -> vec3u {
    vec3u(((qp.x + 1) >> 1) - 1, ((qp.y + 1) >> 1) - 1, ((qp.z + 1) >> 1) - 1)
}

/// Compile-time work-adaptive streaming brick budget per frame (`<= 1.5 ms` M4 / `<= 3.0 ms` Radeon).
pub fn stream_budget_of<M: Field<Substance>>(field: M) -> u32 {
    let w = work(|q: vec3| field.distance_live(q, ALL_LIVE))
    if w <= 300 {
        384
    } else if w <= 1200 {
        256
    } else if w <= 3000 {
        192
    } else {
        160
    }
}

/// Packs `(level, bx, by, bz)` into a non-zero 64-bit lookup key.
fn oct_key(level: u32, bx: u32, by: u32, bz: u32) -> u64 {
    ((u64(level) + 1) << 48) |
        ((u64(bx) & 65535) << 32) |
        ((u64(by) & 65535) << 16) |
        (u64(bz) & 65535)
}

/// Mixes a 64-bit key into a hash table slot index.
fn oct_hash(k: u64, mask: u32) -> u32 {
    let x = (k ^ (k >> 30)).wrapping_mul(13787848793156543929)
    let y = (x ^ (x >> 27)).wrapping_mul(10723151780598845931)
    u32(y ^ (y >> 31)) & mask
}

/// Open-addressing hash map `(level, bx, by, bz) -> node_idx` for O(1) octree neighbor queries.
pub struct OctreeMap {
    keys: Vec<u64>,
    vals: Vec<u32>,
    count: u32,
}

pub fn octree_map() -> OctreeMap {
    OctreeMap { keys: Vec::filled(256, 0), vals: Vec::filled(256, NONE), count: 0 }
}

impl OctreeMap {
    pub fn reset(mut self) {
        self.keys = Vec::filled(256, 0)
        self.vals = Vec::filled(256, NONE)
        self.count = 0
    }

    fn grow(mut self) {
        let new_cap = max(self.keys.len() * 2, 256)
        let mask = new_cap - 1
        var nk = Vec::filled(new_cap, 0)
        var nv = Vec::filled(new_cap, NONE)
        for i in 0..self.keys.len() {
            let k = self.keys[i]
            if k != 0 {
                var slot = oct_hash(k, mask)
                while nk[slot] != 0 {
                    slot = (slot + 1) & mask
                }
                nk[slot] = k
                nv[slot] = self.vals[i]
            }
        }
        self.keys = take nk
        self.vals = take nv
    }

    pub fn insert(mut self, level: u32, bx: u32, by: u32, bz: u32, val: u32) {
        if (self.count + 1) * 10 >= self.keys.len() * 6 {
            self.grow()
        }
        let k = oct_key(level, bx, by, bz)
        let mask = self.keys.len() - 1
        var slot = oct_hash(k, mask)
        while self.keys[slot] != 0 {
            if self.keys[slot] == k {
                self.vals[slot] = val
                return
            }
            slot = (slot + 1) & mask
        }
        self.keys[slot] = k
        self.vals[slot] = val
        self.count += 1
    }

    pub fn get(self, level: u32, bx: u32, by: u32, bz: u32) -> u32 {
        if self.keys.len() == 0 {
            return NONE
        }
        let k = oct_key(level, bx, by, bz)
        let mask = self.keys.len() - 1
        var slot = oct_hash(k, mask)
        while self.keys[slot] != 0 {
            if self.keys[slot] == k {
                return self.vals[slot]
            }
            slot = (slot + 1) & mask
        }
        NONE
    }
}

/// One node in the persistent sparse brick octree.
pub struct OctNode: Copy {
    pub level: u32,
    pub bx: u32,
    pub by: u32,
    pub bz: u32,
    pub parent: u32,
    /// Index of its 8 contiguous children in `BrickOctree::nodes`, or `NONE` if never split.
    pub child_base: u32,
    /// `NODE_INACTIVE (0)` = merged child, `NODE_LEAF (1)` = active leaf, `NODE_INTERNAL (2)` = split.
    pub state: u32,
    pub empty: bool,
    /// Conservative world-space geometric deviation (m) of the surface from a trilinear cell inside
    /// this brick (measured ONCE on creation via 8 corners + center + 6 face centers: `0.0` on flat
    /// planes, `~h^2/(8R)` on curved shells, large on carvings/creases).
    pub geom_err: f32,
    /// Resident GPU pool slot index (`NONE` when not yet extracted or invalidated).
    pub pool_slot: u32,
    /// Cached 54-bit neighbor mask with which `pool_slot` was extracted.
    pub cached_nbr_lo: u32,
    pub cached_nbr_hi: u32,
    /// `exact_eye` and per-brick `eye_reach` at which `pool_slot`'s exact cells were built.
    pub cached_eye: vec4,
    pub cached_reach: f32,
    pub last_used: u32,
}

/// Result of one per-frame `BrickOctree::update` step.
pub struct OctreeUpdate {
    /// Bricks that must be extracted on the GPU this frame (`<= budget` on streaming frames).
    pub dirty_bricks: Vec<ActiveBrick>,
    /// Node index in `BrickOctree::nodes` corresponding to each dirty brick.
    pub dirty_nodes: Vec<u32>,
    /// Per-dirty-brick `eye_reach` (`eye_step(dist_to_brick) * sqrt(3)`).
    pub dirty_reaches: Vec<f32>,
    /// Resident GPU pool slot IDs of all non-empty active leaves after this frame's extraction.
    pub active_slots: Vec<u32>,
    /// True if any brick was split, merged, dirtied, or extracted this frame.
    pub changed: bool,
    /// True if any dirty brick has a `COARSER` or `FINER` neighbor needing 2:1 seam handling.
    pub dirty_has_seams: bool,
    /// True if any active leaf has a 2:1 seam.
    pub any_seams: bool,
    /// True if all active leaves are at or finer than screen target (no pending splits/refreshes).
    pub converged: bool,
}

/// Persistent CPU-side sparse brick octree paired with `MeshBatch`'s GPU brick pool.
pub struct BrickOctree {
    pub initialized: bool,
    pub field_hash: u64,
    pub edit_base_hash: u64,
    pub edit_base_bound: vec4,
    pub aabb: Box3,
    pub origin: vec3,
    pub h0: f32,
    pub dims0: vec3u,
    pub lip: f32,
    pub is_steep: bool,
    pub frame: u32,
    pub nodes: Vec<OctNode>,
    pub map: OctreeMap,
    pub roots: Vec<u32>,
    pub active_leaves: Vec<u32>,
    pub pending_splits: bool,
    pub next_pool_slot: u32,
    pub last_eye: vec4,
    pub last_forward: vec3,
}

pub fn brick_octree() -> BrickOctree {
    BrickOctree {
        initialized: false,
        field_hash: 0,
        edit_base_hash: 0,
        edit_base_bound: vec4(0.0),
        aabb: Box3 { lo: vec3(0.0), hi: vec3(0.0) },
        origin: vec3(0.0),
        h0: 1.0,
        dims0: vec3u(1, 1, 1),
        lip: 1.0,
        is_steep: false,
        frame: 0,
        nodes: Vec::new(),
        map: octree_map(),
        roots: Vec::new(),
        active_leaves: Vec::new(),
        pending_splits: false,
        next_pool_slot: 0,
        last_eye: vec4(0.0),
        last_forward: vec3(0.0, 0.0, -1.0),
    }
}

impl BrickOctree {
    /// Cell spacing at octree level `L` (`h0 / 2^L`, exact IEEE-754 power-of-two scaling).
    pub fn cell_at(self, level: u32) -> f32 {
        self.h0 / f32(1 << level)
    }

    /// World-space `[lo, hi]` box of brick `(level, bx, by, bz)`.
    pub fn brick_box(self, level: u32, bx: u32, by: u32, bz: u32) -> (vec3, vec3) {
        let h = self.cell_at(level)
        let bspan = h * f32(BRICK)
        let lo = self.origin + vec3(f32(bx), f32(by), f32(bz)) * bspan
        (lo, lo + vec3(bspan))
    }

    /// Grid dimensions in bricks at octree level `L`.
    pub fn dims_at(self, level: u32) -> vec3u {
        let s: u32 = 1 << level
        vec3u(self.dims0.x * s, self.dims0.y * s, self.dims0.z * s)
    }

    /// Builds the `MAX_OCTREE_LEVELS` `GridSpec` entries shared by all GPU extraction kernels.
    pub fn level_grids(self, orig_id: u32) -> Vec<GridSpec> {
        var out: Vec<GridSpec> = Vec::new()
        var base: u32 = 0
        for lvl in 0..MAX_OCTREE_LEVELS {
            let d = self.dims_at(lvl)
            out.push(
                GridSpec {
                    origin: self.origin,
                    cell: self.cell_at(lvl),
                    dims: d,
                    base_brick: base,
                    orig_id,
                    seam_mask: 0,
                    parent_grid: if lvl > 0 { lvl - 1 } else { NONE },
                    has_hole: 0,
                    hole_min: vec3u(0, 0, 0),
                    pad0: 0,
                    hole_max: vec3u(0, 0, 0),
                    pad1: 0,
                    cell_offset: vec3u(0, 0, 0),
                    pad2: 0,
                    parent_hole_min: vec3u(0, 0, 0),
                    pad3: 0,
                },
            )
            base += d.x * d.y * d.z
        }
        out
    }

    /// Tests whether brick `(level, bx, by, bz)` plus its 2-cell halo is provably empty, and when
    /// non-empty estimates its world-space surface deviation (`geom_err` in meters).
    /// - For heavy hero fields (`work > 1200`), skips CPU point evaluation (`geom_err = h`) so
    ///   CPU `octree.update` stays `< 0.1 ms` with zero per-split stalls.
    /// - For light world/architectural fields (`work <= 1200`), projects the brick center and 6 face
    ///   centers onto the local zero set via 1 Newton step and measures normal + tangent-plane
    ///   agreement: strictly planar walls and floor slabs get `geom_err = 0.0` even when a coarse
    ///   brick straddles a thin slab's interior medial axis, while corners, skirting, and curved
    ///   surfaces get accurate non-zero `geom_err`.
    fn probe_brick<M: Field<Substance>>(
        self,
        field: M,
        level: u32,
        bx: u32,
        by: u32,
        bz: u32,
    ) -> (bool, f32) {
        let h = self.cell_at(level)
        let (lo, hi_core) = self.brick_box(level, bx, by, bz)
        // Include `+2` cell halo (`8 = BRICK + 2` cells) so seam-corner inheritance and `+1` dual
        // cells never miss a brick whose halo touches the surface.
        let hi_halo = lo + vec3(h * f32(BRICK + 2))
        let iv = field.interval_near(Box3 { lo, hi: hi_halo })
        if iv.lo > 0.0 || iv.hi < 0.0 {
            return (true, 0.0)
        }
        if work(|q: vec3| field.distance_live(q, ALL_LIVE)) > 5000 {
            return (false, h)
        }
        let bspan = h * f32(BRICK)
        // Sample 8 asymmetric interior points (0.22 / 0.78) so probes never land on power-of-two
        // slab centerlines (e.g. y = -0.25 or z = 0) where the gradient vanishes on a medial axis.
        let p0 = lo + vec3(0.22 * bspan)
        let p1 = lo + vec3(0.78 * bspan)
        let probes = [
            vec3(p0.x, p0.y, p0.z),
            vec3(p1.x, p0.y, p0.z),
            vec3(p0.x, p1.y, p0.z),
            vec3(p1.x, p1.y, p0.z),
            vec3(p0.x, p0.y, p1.z),
            vec3(p1.x, p0.y, p1.z),
            vec3(p0.x, p1.y, p1.z),
            vec3(p1.x, p1.y, p1.z),
        ]
        var ref_ok = false
        var ref_p = vec3(0.0)
        var ref_n = vec3(0.0, 1.0, 0.0)
        var opp_ok = false
        var opp_p = vec3(0.0)
        var max_plane_err = 0.0
        var min_ndot = 1.0
        for k in 0..8 {
            let q = probes[k]
            let (d0, g0) = value_and_gradient(|p: vec3| field.distance(p), q)
            let gl0 = length(g0)
            if gl0 <= 1.0e-5 {
                // Medial axis inside a symmetric slab is not surface curvature.
                continue
            }
            let n0 = g0 / gl0
            // One Newton step toward the surface, clamped inside the brick + 1 cell halo.
            let step = clamp(d0 / max(gl0, 1.0), -bspan, bspan)
            let ps = q - n0 * step
            let in_brick = ps.x >= lo.x - h &&
                ps.x <= hi_core.x + h &&
                ps.y >= lo.y - h &&
                ps.y <= hi_core.y + h &&
                ps.z >= lo.z - h &&
                ps.z <= hi_core.z + h
            if !in_brick {
                continue
            }
            let (ds, gs) = value_and_gradient(|p: vec3| field.distance(p), ps)
            let gls = length(gs)
            if abs(ds) > 0.25 * bspan || gls <= 1.0e-5 {
                continue
            }
            let ns = gs / gls
            let p_on = ps - ns * (ds / max(gls, 1.0))
            if !ref_ok {
                ref_ok = true
                ref_p = p_on
                ref_n = ns
            } else {
                let nd = dot(ref_n, ns)
                if nd < -0.995 {
                    // Antiparallel face of a flat slab (e.g. floor or wall underside): exact in DC
                    // once the two faces are separated by at least `1.5 * h`.
                    if !opp_ok {
                        opp_ok = true
                        opp_p = p_on
                    } else {
                        max_plane_err = max(max_plane_err, abs(dot(p_on - opp_p, ref_n)))
                    }
                    min_ndot = min(min_ndot, -nd)
                } else {
                    min_ndot = min(min_ndot, nd)
                    max_plane_err = max(max_plane_err, abs(dot(p_on - ref_p, ref_n)))
                }
            }
        }
        if !ref_ok {
            // Surface missed all 7 projected probes (e.g. small detail tucked in one corner):
            // conservatively treat as non-planar so it refines down to `fine_px`.
            return (false, 0.25 * h)
        }
        if opp_ok {
            let slab_thick = abs(dot(opp_p - ref_p, ref_n))
            if slab_thick < 1.5 * h {
                // Slab is thinner than 1.5 cells: keep splitting until DC resolves both faces.
                return (false, 0.25 * h)
            }
        }
        let ang_err = bspan * 0.125 * sqrt(max(1.0 - min_ndot, 0.0))
        let geom_err = max(max_plane_err, ang_err)
        (false, geom_err)
    }

    /// Initializes the octree anchored to `field`'s immutable tight AABB.
    pub fn init<M: Field<Substance>>(
        mut self,
        field: M,
        field_hash: u64,
        edit_base_hash: u64,
        edit_base_bound: vec4,
    ) {
        let aabb = tight_aabb(field)
        let span = max(aabb.hi - aabb.lo, vec3(1.0e-3))
        let longest = max(span.x, max(span.y, span.z))
        // Target ~4 root bricks along the longest axis so root extraction is always tiny (`~16-80`
        // non-empty bricks, `< 1.5 ms` even for complex assets) while covering 100% of the object.
        let bspan0 = max(longest / 4.0, 0.01)
        let h0 = bspan0 / f32(BRICK)
        let pad = vec3(h0 * 2.0)
        let origin = aabb.lo - pad
        let full = max(aabb.hi + pad - origin, vec3(h0))
        let nx = max(u32(ceil(full.x / bspan0)), 1)
        let ny = max(u32(ceil(full.y / bspan0)), 1)
        let nz = max(u32(ceil(full.z / bspan0)), 1)

        self.initialized = true
        self.field_hash = field_hash
        self.edit_base_hash = edit_base_hash
        self.edit_base_bound = edit_base_bound
        self.aabb = aabb
        self.origin = origin
        self.h0 = h0
        self.dims0 = vec3u(nx, ny, nz)
        self.lip = max(field.lipschitz(1.0), 1.0)
        self.is_steep = steep(field)
        self.frame = 0
        self.nodes = Vec::new()
        self.map.reset()
        self.roots = Vec::new()
        self.active_leaves = Vec::new()
        self.pending_splits = false
        self.next_pool_slot = 0
        self.last_eye = vec4(0.0)
        self.last_forward = vec3(0.0, 0.0, -1.0)

        for bz in 0..nz {
            for by in 0..ny {
                for bx in 0..nx {
                    let (empty, geom_err) = self.probe_brick(field, 0, bx, by, bz)
                    let idx = self.nodes.len()
                    self.nodes.push(
                        OctNode {
                            level: 0,
                            bx,
                            by,
                            bz,
                            parent: NONE,
                            child_base: NONE,
                            state: NODE_LEAF,
                            empty,
                            geom_err,
                            pool_slot: NONE,
                            cached_nbr_lo: 0,
                            cached_nbr_hi: 0,
                            cached_eye: vec4(0.0),
                            cached_reach: 0.0,
                            last_used: 0,
                        },
                    )
                    self.map.insert(0, bx, by, bz, idx)
                    self.roots.push(idx)
                    if !empty {
                        self.active_leaves.push(idx)
                    }
                }
            }
        }
    }

    /// Invalidates every cached GPU pool slot (e.g., when the GPU brick arena wraps/resets),
    /// preserving the entire refined octree topology so active leaves re-pack cleanly.
    pub fn reset_gpu_slots(mut self) {
        for i in 0..self.nodes.len() {
            self.nodes[i].pool_slot = NONE
        }
        self.next_pool_slot = 0
    }

    /// Applies an in-place live CSG `dirty_box` edit: re-tests emptiness and invalidates GPU pool
    /// slots ONLY for octree nodes overlapping `dirty_box` (and returns the count invalidated).
    pub fn apply_dirty_edit<M: Field<Substance>>(
        mut self,
        field: M,
        dirty_box: Box3,
        new_field_hash: u64,
    ) -> u32 {
        self.field_hash = new_field_hash
        var invalidated: u32 = 0
        var empty_changed = false
        for i in 0..self.nodes.len() {
            let n = self.nodes[i]
            let h = self.cell_at(n.level)
            let (lo, _) = self.brick_box(n.level, n.bx, n.by, n.bz)
            let hi = lo + vec3(h * f32(BRICK + 2))
            let overlaps = hi.x >= dirty_box.lo.x &&
                lo.x <= dirty_box.hi.x &&
                hi.y >= dirty_box.lo.y &&
                lo.y <= dirty_box.hi.y &&
                hi.z >= dirty_box.lo.z &&
                lo.z <= dirty_box.hi.z
            if overlaps {
                let was_empty = n.empty
                let (now_empty, now_err) = self.probe_brick(field, n.level, n.bx, n.by, n.bz)
                self.nodes[i].empty = now_empty
                self.nodes[i].geom_err = now_err
                self.nodes[i].pool_slot = NONE
                invalidated += 1
                if was_empty != now_empty {
                    empty_changed = true
                }
            }
        }
        if empty_changed {
            self.rebuild_active_leaves()
        }
        invalidated
    }

    /// Computes the exact 54-bit `3x3x3` neighbor level mask for active leaf `ni`.
    pub fn neighbor_mask(self, ni: u32) -> (u32, u32) {
        let n = self.nodes[ni]
        let lvl = n.level
        let d = self.dims_at(lvl)
        var lo: u32 = 0
        var hi: u32 = 0
        for dz in -1..=1 {
            let nz = i32(n.bz) + dz
            for dy in -1..=1 {
                let ny = i32(n.by) + dy
                for dx in -1..=1 {
                    if dx == 0 && dy == 0 && dz == 0 {
                        continue
                    }
                    let nx = i32(n.bx) + dx
                    if nx < 0 ||
                        ny < 0 ||
                        nz < 0 ||
                        nx >= i32(d.x) ||
                        ny >= i32(d.y) ||
                        nz >= i32(d.z) {
                        continue
                    }
                    let nb = self.map.get(lvl, u32(nx), u32(ny), u32(nz))
                    let st = if nb == NONE || self.nodes[nb].state == NODE_INACTIVE {
                        // Ancestor at `lvl - 1` is the active leaf (guaranteed by 2:1 balance).
                        NBR_COARSER
                    } else if self.nodes[nb].state == NODE_INTERNAL {
                        NBR_FINER
                    } else {
                        NBR_SAME
                    }
                    if st != NBR_SAME {
                        let (nlo, nhi) = nbr_set(lo, hi, dx, dy, dz, st)
                        lo = nlo
                        hi = nhi
                    }
                }
            }
        }
        (lo, hi)
    }

    /// Splits leaf `ni` (`1 -> 8`) without checking 2:1 preconditions (caller ensures 2:1 first).
    fn split_node_raw<M: Field<Substance>>(mut self, field: M, ni: u32) -> u32 {
        let n = self.nodes[ni]
        if n.state != NODE_LEAF || n.level + 1 >= MAX_OCTREE_LEVELS {
            return 0
        }
        self.nodes[ni].state = NODE_INTERNAL
        let clvl = n.level + 1
        var added_non_empty: u32 = 0
        if n.child_base != NONE {
            let cb = n.child_base
            for k in 0..8 {
                self.nodes[cb + k].state = NODE_LEAF
                self.nodes[cb + k].last_used = self.frame
                if !self.nodes[cb + k].empty {
                    added_non_empty += 1
                }
            }
            return added_non_empty
        }
        let cb = self.nodes.len()
        self.nodes[ni].child_base = cb
        for k in 0..8 {
            let ox = k & 1
            let oy = (k >> 1) & 1
            let oz = (k >> 2) & 1
            let cbx = n.bx * 2 + ox
            let cby = n.by * 2 + oy
            let cbz = n.bz * 2 + oz
            let (empty, geom_err) = if n.empty { (true, 0.0) } else {
                self.probe_brick(field, clvl, cbx, cby, cbz)
            }
            let cidx = self.nodes.len()
            self.nodes.push(
                OctNode {
                    level: clvl,
                    bx: cbx,
                    by: cby,
                    bz: cbz,
                    parent: ni,
                    child_base: NONE,
                    state: NODE_LEAF,
                    empty,
                    geom_err,
                    pool_slot: NONE,
                    cached_nbr_lo: 0,
                    cached_nbr_hi: 0,
                    cached_eye: vec4(0.0),
                    cached_reach: 0.0,
                    last_used: self.frame,
                },
            )
            self.map.insert(clvl, cbx, cby, cbz, cidx)
            if !empty {
                added_non_empty += 1
            }
        }
        added_non_empty
    }

    /// Splits leaf `ni` while preserving strict 2:1 balance across all 26 neighbors: any coarser
    /// neighbor at `level - 1` is split first (iteratively upward to level 0, guaranteed to stop).
    /// Returns the number of newly activated non-empty leaf bricks.
    pub fn split_balanced<M: Field<Substance>>(mut self, field: M, target: u32) -> u32 {
        var stack: Vec<u32> = Vec::new()
        stack.push(target)
        var added: u32 = 0
        while stack.len() > 0 {
            let top = stack[stack.len() - 1]
            let n = self.nodes[top]
            if n.state != NODE_LEAF || n.level + 1 >= MAX_OCTREE_LEVELS {
                let _ = stack.pop()
                continue
            }
            var need_ancestor = NONE
            if n.level > 0 {
                let lvl = n.level
                let d = self.dims_at(lvl)
                for dz in -1..=1 {
                    let nz = i32(n.bz) + dz
                    for dy in -1..=1 {
                        let ny = i32(n.by) + dy
                        for dx in -1..=1 {
                            if need_ancestor != NONE || (dx == 0 && dy == 0 && dz == 0) {
                                continue
                            }
                            let nx = i32(n.bx) + dx
                            if nx < 0 ||
                                ny < 0 ||
                                nz < 0 ||
                                nx >= i32(d.x) ||
                                ny >= i32(d.y) ||
                                nz >= i32(d.z) {
                                continue
                            }
                            let nb = self.map.get(lvl, u32(nx), u32(ny), u32(nz))
                            if nb == NONE || self.nodes[nb].state == NODE_INACTIVE {
                                // Neighbor exists only at `lvl - 1` (2:1 invariant): split it first!
                                let pnb = self.map.get(
                                    lvl - 1,
                                    u32(nx) >> 1,
                                    u32(ny) >> 1,
                                    u32(nz) >> 1,
                                )
                                if pnb != NONE && self.nodes[pnb].state == NODE_LEAF {
                                    need_ancestor = pnb
                                }
                            }
                        }
                    }
                }
            }
            if need_ancestor != NONE {
                stack.push(need_ancestor)
            } else {
                let _ = stack.pop()
                added += self.split_node_raw(field, top)
            }
        }
        added
    }

    /// True iff parent node `pi` can safely merge its 8 leaf children (`8 -> 1`) without violating
    /// 2:1 balance (no 26-neighbor of `pi` at `pi.level` may have a subdivided child at `pi.level + 1`).
    pub fn can_merge_2to1(self, pi: u32) -> bool {
        let p = self.nodes[pi]
        if p.state != NODE_INTERNAL || p.child_base == NONE {
            return false
        }
        let cb = p.child_base
        for k in 0..8 {
            if self.nodes[cb + k].state != NODE_LEAF {
                return false
            }
        }
        let lvl = p.level
        let clvl = lvl + 1
        let cd = self.dims_at(clvl)
        // Any child-level brick `(cx, cy, cz)` adjacent to `p`'s `2x2x2` child block must be a leaf
        // (never subdivided to `lvl + 2`), otherwise merging `p` to `lvl` creates a `lvl` vs `lvl + 2` jump.
        let x0 = i32(p.bx * 2) - 1
        let x1 = i32(p.bx * 2) + 2
        let y0 = i32(p.by * 2) - 1
        let y1 = i32(p.by * 2) + 2
        let z0 = i32(p.bz * 2) - 1
        let z1 = i32(p.bz * 2) + 2
        for cz in z0..=z1 {
            if cz < 0 || cz >= i32(cd.z) {
                continue
            }
            for cy in y0..=y1 {
                if cy < 0 || cy >= i32(cd.y) {
                    continue
                }
                for cx in x0..=x1 {
                    if cx < 0 || cx >= i32(cd.x) {
                        continue
                    }
                    let nb = self.map.get(clvl, u32(cx), u32(cy), u32(cz))
                    if nb != NONE && self.nodes[nb].state == NODE_INTERNAL {
                        return false
                    }
                }
            }
        }
        true
    }

    /// Merges parent `pi`'s 8 leaf children back into `pi` (`8 -> 1`).
    pub fn merge_node(mut self, pi: u32) -> bool {
        if !self.can_merge_2to1(pi) {
            return false
        }
        let cb = self.nodes[pi].child_base
        for k in 0..8 {
            self.nodes[cb + k].state = NODE_INACTIVE
        }
        self.nodes[pi].state = NODE_LEAF
        self.nodes[pi].last_used = self.frame
        true
    }

    /// Rebuilds the flat `active_leaves` list of non-empty leaves by traversing from `roots`.
    pub fn rebuild_active_leaves(mut self) {
        var out: Vec<u32> = Vec::new()
        var stack: Vec<u32> = Vec::new()
        for i in 0..self.roots.len() {
            stack.push(self.roots[i])
        }
        while stack.len() > 0 {
            let ni = stack[stack.len() - 1]
            let _ = stack.pop()
            let n = self.nodes[ni]
            if n.empty {
                continue
            }
            if n.state == NODE_LEAF {
                out.push(ni)
            } else if n.state == NODE_INTERNAL && n.child_base != NONE {
                let cb = n.child_base
                for k in 0..8 {
                    stack.push(cb + k)
                }
            }
        }
        self.active_leaves = take out
    }

    /// Performs one continual per-brick streaming LOD step for camera `v`:
    /// 1. Merges over-refined sibling groups (`parent_cell_px < 0.72 * split_px` or off-frustum).
    /// 2. Splits highest-error in-frustum bricks (`cell_px > split_px`) with strict 2:1 balance,
    ///    strictly capped to `budget` GPU bricks per frame (`<= 1.5 ms` M4 / `<= 3.0 ms` Radeon).
    /// 3. Computes 54-bit neighbor masks and collects all dirty bricks (newly split, seam-changed,
    ///    CSG-dirtied, or `exact_eye`-stale beyond per-brick `eye_reach`) up to budget.
    pub fn update<M: Field<Substance>>(
        mut self,
        field: M,
        v: View,
        budget: u32,
        max_leaves: u32,
        exact_eye: vec4,
        cell_scale: f32,
        min_cell: f32,
        is_cold: bool,
    ) -> OctreeUpdate {
        self.frame += 1
        let fc = frustum_cull_view(v, margin: 1.18)
        let px_rad = max(v.pixel(), 1.0e-5)
        let obj_rad = max(0.5 * length(self.aabb.hi - self.aabb.lo), 0.1)
        let is_cut = is_cold ||
            self.last_eye.w <= 0.0 ||
            length(exact_eye.xyz - self.last_eye.xyz) > 0.35 * obj_rad ||
            dot(v.forward, self.last_forward) < 0.75 ||
            abs(exact_eye.w - self.last_eye.w) > 0.25 * max(self.last_eye.w, 1.0e-5)
        self.last_eye = exact_eye
        self.last_forward = v.forward
        let eff_cpx = if self.lip > 2.5 { min(CELL_PX, 2.0) } else { CELL_PX }
        let fine_px = eff_cpx * max(cell_scale, 1.0) * (if self.is_steep { 0.80 } else { 1.0 })
        // Strictly planar bricks (`geom_err <= 0.002 * h`) are exact at any cell size and stay
        // coarse (`flat_px = 160 px`), keeping flat rooms/floors/walls to ~100 bricks total; any
        // non-planar brick (curved, creased, carved, or thin) refines smoothly down to `fine_px`.
        let flat_px = (if self.is_steep { 24.0 } else { 160.0 }) * max(cell_scale, 1.0)
        let err_px_limit = 0.25 * max(cell_scale, 1.0)
        let merge_scale = 0.55

        var topo_changed = false

        // 1. Collect candidate parent merges (children that are all leaves and parent satisfies both
        //    sub-pixel geometric error and coarse flat cell bound with hysteresis, or off-frustum).
        var merge_cands: Vec<u32> = Vec::new()
        for i in 0..self.active_leaves.len() {
            let ni = self.active_leaves[i]
            let p = self.nodes[ni].parent
            if p == NONE {
                continue
            }
            let pn = self.nodes[p]
            let ph = self.cell_at(pn.level)
            let (plo, phi) = self.brick_box(pn.level, pn.bx, pn.by, pn.bz)
            let p_in = box_in_frustum(plo, phi, fc)
            let p_closest = clamp(v.at, plo, phi)
            let p_dist = max(length(v.at - p_closest), 0.004)
            let inv_px = 1.0 / (p_dist * px_rad)
            let p_cell_px = ph * inv_px
            let p_err_px = pn.geom_err * inv_px
            let p_planar = pn.geom_err <= 0.002 * ph
            let p_ok = p_cell_px < fine_px * merge_scale ||
                (p_planar &&
                    p_cell_px < flat_px * merge_scale &&
                    p_err_px < err_px_limit * merge_scale)
            if !p_in || p_ok {
                merge_cands.push(p)
            }
        }
        // Apply valid merges (up to `budget / 4` merged parents per frame so neighbor seam refreshes stay bounded).
        var merged_count: u32 = 0
        let merge_cap = max(budget / 4, 8)
        for i in 0..merge_cands.len() {
            if merged_count >= merge_cap {
                break
            }
            let pi = merge_cands[i]
            if self.merge_node(pi) {
                merged_count += 1
                topo_changed = true
            }
        }
        if topo_changed {
            self.rebuild_active_leaves()
        }

        // 2. Prioritize refreshing `exact_eye`-stale visible bricks BEFORE spending budget on new
        //    splits so camera cuts and turns never leave stale silhouette `ExactCell`s (zero holes
        //    even on Frame 0 of a cut). On cold starts / camera cuts, run up to 3 top-down split
        //    passes within a bounded cut budget (`<= 512` bricks) so newly viewed objects start
        //    near target LOD and settle within a few frames.
        let eff_min_cell = max(min_cell, 0.0004)
        var unextracted_now: u32 = 0
        var eye_stale_count: u32 = 0
        for i in 0..self.active_leaves.len() {
            let n = self.nodes[self.active_leaves[i]]
            if n.pool_slot == NONE {
                unextracted_now += 1
            } else if exact_eye.w > 0.0 {
                let (lo, hi) = self.brick_box(n.level, n.bx, n.by, n.bz)
                if box_in_frustum(lo, hi, fc) {
                    let moved = length(exact_eye.xyz - n.cached_eye.xyz) > n.cached_reach ||
                        abs(exact_eye.w - n.cached_eye.w) > 0.15 * max(n.cached_eye.w, 1.0e-5)
                    if moved {
                        eye_stale_count += 1
                    }
                }
            }
        }
        let split_passes: u32 = if is_cold { 4 } else if is_cut { 2 } else { 1 }
        let frame_budget = if is_cold || is_cut { max(budget * 3, 512) } else { budget }
        let mandatory_now = unextracted_now + (if is_cut { 0 } else { eye_stale_count })
        let avail_budget = if frame_budget > mandatory_now { frame_budget - mandatory_now } else {
            0
        }
        let split_brick_budget = if is_cold || is_cut {
            avail_budget
        } else {
            max((avail_budget * 3) / 4, 0)
        }
        var cur_leaves = self.active_leaves.len()
        var splits_budget_used: u32 = 0
        for _pass in 0..split_passes {
            if splits_budget_used >= split_brick_budget || cur_leaves + 8 > max_leaves {
                break
            }
            var b0: Vec<u32> = Vec::new() // >= 16x error
            var b1: Vec<u32> = Vec::new() // >= 8x
            var b2: Vec<u32> = Vec::new() // >= 4x
            var b3: Vec<u32> = Vec::new() // >= 2x
            var b4: Vec<u32> = Vec::new() // >= 1.5x
            var b5: Vec<u32> = Vec::new() // >= 1.25x
            var b6: Vec<u32> = Vec::new() // > 1.0x
            for i in 0..self.active_leaves.len() {
                let ni = self.active_leaves[i]
                let n = self.nodes[ni]
                if n.empty || n.level + 1 >= MAX_OCTREE_LEVELS {
                    continue
                }
                let h = self.cell_at(n.level)
                if h * 0.5 < eff_min_cell {
                    continue
                }
                let (lo, hi) = self.brick_box(n.level, n.bx, n.by, n.bz)
                if !box_in_frustum(lo, hi, fc) {
                    continue
                }
                let closest = clamp(v.at, lo, hi)
                let dist = max(length(v.at - closest), 0.004)
                let inv_px = 1.0 / (dist * px_rad)
                let cell_px = h * inv_px
                let err_px = n.geom_err * inv_px
                let non_planar = n.geom_err > 0.002 * h
                let want = cell_px > flat_px ||
                    (cell_px > fine_px && (err_px > err_px_limit || non_planar))
                if want {
                    let ratio = max(cell_px / fine_px, err_px / err_px_limit)
                    if ratio >= 16.0 {
                        b0.push(ni)
                    } else if ratio >= 8.0 {
                        b1.push(ni)
                    } else if ratio >= 4.0 {
                        b2.push(ni)
                    } else if ratio >= 2.0 {
                        b3.push(ni)
                    } else if ratio >= 1.5 {
                        b4.push(ni)
                    } else if ratio >= 1.25 {
                        b5.push(ni)
                    } else {
                        b6.push(ni)
                    }
                }
            }
            var did_split = false
            for bucket_id in 0..7 {
                let blen = if bucket_id == 0 {
                    b0.len()
                } else if bucket_id == 1 {
                    b1.len()
                } else if bucket_id == 2 {
                    b2.len()
                } else if bucket_id == 3 {
                    b3.len()
                } else if bucket_id == 4 {
                    b4.len()
                } else if bucket_id == 5 {
                    b5.len()
                } else {
                    b6.len()
                }
                for i in 0..blen {
                    if splits_budget_used >= split_brick_budget || cur_leaves + 8 > max_leaves {
                        break
                    }
                    let ni = if bucket_id == 0 {
                        b0[i]
                    } else if bucket_id == 1 {
                        b1[i]
                    } else if bucket_id == 2 {
                        b2[i]
                    } else if bucket_id == 3 {
                        b3[i]
                    } else if bucket_id == 4 {
                        b4[i]
                    } else if bucket_id == 5 {
                        b5[i]
                    } else {
                        b6[i]
                    }
                    if self.nodes[ni].state != NODE_LEAF {
                        continue
                    }
                    let added = self.split_balanced(field, ni)
                    if added > 0 {
                        splits_budget_used += added
                        cur_leaves += added - 1
                        did_split = true
                        topo_changed = true
                    }
                }
            }
            if did_split {
                self.rebuild_active_leaves()
            } else {
                break
            }
        }

        // 3. Recompute 54-bit neighbor masks for all active leaves and gather dirty bricks.
        //    Priority 1 (mandatory for watertightness): never-extracted bricks (`pool_slot == NONE`)
        //    and bricks whose 2:1 `nbr_mask` changed due to a neighbor split/merge.
        //    Priority 2 (budgeted): cached bricks whose `exact_eye` moved beyond their per-brick
        //    `eye_reach` (closest bricks first).
        var dirty_bricks: Vec<ActiveBrick> = Vec::new()
        var dirty_nodes: Vec<u32> = Vec::new()
        var dirty_reaches: Vec<f32> = Vec::new()
        var eye_stale_nodes: Vec<u32> = Vec::new()
        var eye_stale_lo: Vec<u32> = Vec::new()
        var eye_stale_hi: Vec<u32> = Vec::new()
        var eye_stale_reach: Vec<f32> = Vec::new()
        var any_seams = false
        var dirty_has_seams = false

        for i in 0..self.active_leaves.len() {
            let ni = self.active_leaves[i]
            let n = self.nodes[ni]
            self.nodes[ni].last_used = self.frame
            let (nlo, nhi) = self.neighbor_mask(ni)
            if nbr_has_any_seam(nlo, nhi) {
                any_seams = true
            }
            let (lo, hi) = self.brick_box(n.level, n.bx, n.by, n.bz)
            let dist = max(length(v.at - clamp(v.at, lo, hi)), 0.004)
            let reach = 1.7320508 * eye_step(dist)
            let h = self.cell_at(n.level)
            let cell_px = h / (dist * px_rad)
            let is_unrefined = n.geom_err > 0.002 * h &&
                cell_px > fine_px * 2.0 &&
                h * 0.5 >= eff_min_cell &&
                n.level + 1 < MAX_OCTREE_LEVELS
            let nhi_packed = if is_unrefined { nhi | NBR_FLAG_UNREFINED } else { nhi }
            let must_extract = n.pool_slot == NONE ||
                n.cached_nbr_lo != nlo ||
                n.cached_nbr_hi != nhi_packed
            if must_extract {
                if n.pool_slot == NONE {
                    self.nodes[ni].pool_slot = self.next_pool_slot
                    self.next_pool_slot += 1
                }
                self.nodes[ni].cached_nbr_lo = nlo
                self.nodes[ni].cached_nbr_hi = nhi_packed
                self.nodes[ni].cached_eye = exact_eye
                self.nodes[ni].cached_reach = reach
                dirty_bricks.push(
                    ActiveBrick {
                        coord: vec4u(n.bx, n.by, n.bz, n.level),
                        live: ALL_LIVE,
                        nbr_lo: nlo,
                        nbr_hi: nhi_packed,
                    },
                )
                dirty_nodes.push(ni)
                dirty_reaches.push(reach)
                if nbr_has_any_seam(nlo, nhi) {
                    dirty_has_seams = true
                }
            } else if exact_eye.w > 0.0 && box_in_frustum(lo, hi, fc) {
                let moved = length(exact_eye.xyz - n.cached_eye.xyz) > n.cached_reach ||
                    abs(exact_eye.w - n.cached_eye.w) > 0.15 * max(n.cached_eye.w, 1.0e-5)
                if moved {
                    eye_stale_nodes.push(ni)
                    eye_stale_lo.push(nlo)
                    eye_stale_hi.push(nhi_packed)
                    eye_stale_reach.push(reach)
                }
            }
        }

        // Refresh `exact_eye`-stale bricks: on a camera cut refresh ALL visible stale bricks
        // immediately so Frame 0 of a cut has zero stale-eye holes; on smooth motion cap to budget.
        var eye_stale_left = false
        for i in 0..eye_stale_nodes.len() {
            if !is_cut && dirty_bricks.len() >= budget {
                eye_stale_left = true
                break
            }
            let ni = eye_stale_nodes[i]
            let n = self.nodes[ni]
            let nlo = eye_stale_lo[i]
            let nhi = eye_stale_hi[i]
            let reach = eye_stale_reach[i]
            self.nodes[ni].cached_eye = exact_eye
            self.nodes[ni].cached_reach = reach
            dirty_bricks.push(
                ActiveBrick {
                    coord: vec4u(n.bx, n.by, n.bz, n.level),
                    live: ALL_LIVE,
                    nbr_lo: nlo,
                    nbr_hi: nhi,
                },
            )
            dirty_nodes.push(ni)
            dirty_reaches.push(reach)
            if nbr_has_any_seam(nlo, nhi) {
                dirty_has_seams = true
            }
        }

        // Check if any in-frustum leaf still wants to split next frame.
        var still_want_split = false
        if cur_leaves + 8 <= max_leaves {
            for i in 0..self.active_leaves.len() {
                let ni = self.active_leaves[i]
                let n = self.nodes[ni]
                if n.empty || n.level + 1 >= MAX_OCTREE_LEVELS {
                    continue
                }
                let h = self.cell_at(n.level)
                if h * 0.5 < eff_min_cell {
                    continue
                }
                let (lo, hi) = self.brick_box(n.level, n.bx, n.by, n.bz)
                if !box_in_frustum(lo, hi, fc) {
                    continue
                }
                let dist = max(length(v.at - clamp(v.at, lo, hi)), 0.004)
                let inv_px = 1.0 / (dist * px_rad)
                let cell_px = h * inv_px
                let err_px = n.geom_err * inv_px
                let non_planar = n.geom_err > 0.002 * h
                if cell_px > flat_px ||
                    (cell_px > fine_px && (err_px > err_px_limit || non_planar)) {
                    still_want_split = true
                    break
                }
            }
        }
        self.pending_splits = still_want_split || eye_stale_left

        var active_slots: Vec<u32> = Vec::new()
        for i in 0..self.active_leaves.len() {
            let slot = self.nodes[self.active_leaves[i]].pool_slot
            if slot != NONE {
                active_slots.push(slot)
            }
        }
        let changed = topo_changed || dirty_bricks.len() > 0
        OctreeUpdate {
            dirty_bricks,
            dirty_nodes,
            dirty_reaches,
            active_slots,
            changed,
            dirty_has_seams,
            any_seams,
            converged: !self.pending_splits,
        }
    }

    /// Diagnostic invariant check: returns `true` iff every active leaf in `self` satisfies strict
    /// 2:1 balance against all 26 neighbors (`|level(A) - level(B)| <= 1`).
    pub fn is_2to1_balanced(self) -> bool {
        for i in 0..self.active_leaves.len() {
            let ni = self.active_leaves[i]
            let n = self.nodes[ni]
            if n.level < 2 {
                continue
            }
            let lvl = n.level
            let d = self.dims_at(lvl)
            for dz in -1..=1 {
                let nz = i32(n.bz) + dz
                for dy in -1..=1 {
                    let ny = i32(n.by) + dy
                    for dx in -1..=1 {
                        if dx == 0 && dy == 0 && dz == 0 {
                            continue
                        }
                        let nx = i32(n.bx) + dx
                        if nx < 0 ||
                            ny < 0 ||
                            nz < 0 ||
                            nx >= i32(d.x) ||
                            ny >= i32(d.y) ||
                            nz >= i32(d.z) {
                            continue
                        }
                        let nb = self.map.get(lvl, u32(nx), u32(ny), u32(nz))
                        if nb == NONE || self.nodes[nb].state == NODE_INACTIVE {
                            // Neighbor must exist as a leaf at `lvl - 1` (never `lvl - 2`!).
                            let pnb = self.map.get(
                                lvl - 1,
                                u32(nx) >> 1,
                                u32(ny) >> 1,
                                u32(nz) >> 1,
                            )
                            if pnb == NONE || self.nodes[pnb].state != NODE_LEAF {
                                return false
                            }
                        }
                    }
                }
            }
        }
        true
    }
}

@test
fn octree_edge_ownership_is_exact_across_all_15_subsets() {
    // Verify for all 3 axes and all 15 non-empty subsets of the 4 bricks {A=(0,0), B=(0,1),
    // C=(1,0), D=(1,1)} at level L (rest at L-1) that EXACTLY ONE brick owns the shared edge.
    for axis in 0..3 {
        let ubx: i32 = if axis == 2 { 1 } else { 0 }
        let uby: i32 = if axis == 0 { 1 } else { 0 }
        let ubz: i32 = if axis == 1 { 1 } else { 0 }
        let ucx: i32 = if axis == 1 { 1 } else { 0 }
        let ucy: i32 = if axis == 2 { 1 } else { 0 }
        let ucz: i32 = if axis == 0 { 1 } else { 0 }
        for mask in 1..16 {
            let has_a = (mask & 1) != 0
            let has_b = (mask & 2) != 0 // +uc from A (wait: C=+ub, B=+uc)
            let has_c = (mask & 4) != 0 // +ub from A
            let has_d = (mask & 8) != 0 // +ub+uc from A
            var owners: u32 = 0
            // Brick A at (0,0) tests slot 0 at (eb=5, ec=5): always owned when A is at level L.
            if has_a {
                if octree_edge_owned(nbr_lo: 0, nbr_hi: 0, axis: axis, eb: 5, ec: 5, slot: 0) {
                    owners += 1
                }
            }
            // Brick B at (0,1) tests slot 2 at (eb=5, ec=0); its -uc is A.
            if has_b {
                var lo: u32 = 0
                var hi: u32 = 0
                if !has_a {
                    let (nlo, nhi) = nbr_set(lo, hi, -ucx, -ucy, -ucz, NBR_COARSER)
                    lo = nlo
                    hi = nhi
                }
                if octree_edge_owned(nbr_lo: lo, nbr_hi: hi, axis: axis, eb: 5, ec: 0, slot: 2) {
                    owners += 1
                }
            }
            // Brick C at (1,0) tests slot 1 at (eb=0, ec=5); its -ub is A, its -ub+uc is B.
            if has_c {
                var lo: u32 = 0
                var hi: u32 = 0
                if !has_a {
                    let (nlo, nhi) = nbr_set(lo, hi, -ubx, -uby, -ubz, NBR_COARSER)
                    lo = nlo
                    hi = nhi
                }
                if !has_b {
                    let (nlo, nhi) = nbr_set(
                        lo,
                        hi,
                        -ubx + ucx,
                        -uby + ucy,
                        -ubz + ucz,
                        NBR_COARSER,
                    )
                    lo = nlo
                    hi = nhi
                }
                if octree_edge_owned(nbr_lo: lo, nbr_hi: hi, axis: axis, eb: 0, ec: 5, slot: 1) {
                    owners += 1
                }
            }
            // Brick D at (1,1) tests slot 3 at (eb=0, ec=0); its -ub is B, -uc is C, -ub-uc is A.
            if has_d {
                var lo: u32 = 0
                var hi: u32 = 0
                if !has_b {
                    let (nlo, nhi) = nbr_set(lo, hi, -ubx, -uby, -ubz, NBR_COARSER)
                    lo = nlo
                    hi = nhi
                }
                if !has_c {
                    let (nlo, nhi) = nbr_set(lo, hi, -ucx, -ucy, -ucz, NBR_COARSER)
                    lo = nlo
                    hi = nhi
                }
                if !has_a {
                    let (nlo, nhi) = nbr_set(
                        lo,
                        hi,
                        -ubx - ucx,
                        -uby - ucy,
                        -ubz - ucz,
                        NBR_COARSER,
                    )
                    lo = nlo
                    hi = nhi
                }
                if octree_edge_owned(nbr_lo: lo, nbr_hi: hi, axis: axis, eb: 0, ec: 0, slot: 3) {
                    owners += 1
                }
            }
            assert(owners == 1, f"axis={axis} mask={mask} had {owners} edge owners (expected 1)")
        }
    }
}

@test
fn octree_flyin_splits_incrementally_keeps_2to1_balance_and_merges_cleanly() {
    let f = std::field::sphere(radius: 1.5).with(matter::substance::lambert(vec3(0.5)))
    var oct = brick_octree()
    oct.init(f, field_hash: 1, edit_base_hash: 0, edit_base_bound: vec4(0.0))
    assert(oct.is_2to1_balanced(), "initial root octree is 2:1 balanced")
    // Simulate a 30-frame fly-in from 10 m -> 2.8 m using `stream_budget_of(f)`.
    let b = stream_budget_of(f)
    var max_dirty: u32 = 0
    for step in 0..30 {
        let z = 10.0 - f32(step) * (7.2 / 29.0)
        let v = view(
            Eye { at: vec3(0.0, 0.2, z), toward: vec3(0.0, 0.0, 0.0), wide: 0.6 },
            width: 1920,
            height: 1080,
        )
        let u = oct.update(
            f,
            v,
            budget: b,
            max_leaves: 4096,
            exact_eye: vec4(v.at, v.pixel()),
            cell_scale: 1.0,
            min_cell: 0.0004,
            is_cold: step == 0,
        )
        assert(oct.is_2to1_balanced(), f"2:1 balance broken on fly-in frame {step}")
        if step > 0 {
            max_dirty = max(max_dirty, u.dirty_bricks.len())
        }
    }
    let peak_leaves = oct.active_leaves.len()
    assert(peak_leaves > oct.roots.len(), f"fly-in refined bricks (got {peak_leaves} leaves)")
    // Steady hold must settle to 0 dirty bricks/frame (zero oscillation!).
    let v_near = view(
        Eye { at: vec3(0.0, 0.2, 2.8), toward: vec3(0.0, 0.0, 0.0), wide: 0.6 },
        width: 1920,
        height: 1080,
    )
    var settled = false
    var last_dirty: u32 = 0
    for _k in 0..20 {
        let u = oct.update(
            f,
            v_near,
            budget: b,
            max_leaves: 4096,
            exact_eye: vec4(v_near.at, v_near.pixel()),
            cell_scale: 1.0,
            min_cell: 0.0004,
            is_cold: false,
        )
        assert(oct.is_2to1_balanced(), "2:1 balance holds while settling")
        last_dirty = u.dirty_bricks.len()
        if u.converged && last_dirty == 0 {
            settled = true
            break
        }
    }
    assert(
        settled,
        f"octree must converge cleanly at steady close camera (leaves={oct.active_leaves.len()} last_dirty={last_dirty} pending={oct.pending_splits})",
    )
    // Verify 3 additional steady frames stay at 0 dirty bricks (zero split/merge oscillation).
    for _s in 0..3 {
        let u = oct.update(
            f,
            v_near,
            budget: b,
            max_leaves: 4096,
            exact_eye: vec4(v_near.at, v_near.pixel()),
            cell_scale: 1.0,
            min_cell: 0.0004,
            is_cold: false,
        )
        assert(u.converged && u.dirty_bricks.len() == 0, "zero oscillation once settled")
    }
    let settled_leaves = oct.active_leaves.len()
    // Pull back to 25 m: bricks must merge back smoothly without violating 2:1 balance.
    let v_far = view(
        Eye { at: vec3(0.0, 0.2, 25.0), toward: vec3(0.0, 0.0, 0.0), wide: 0.6 },
        width: 1920,
        height: 1080,
    )
    for _k in 0..15 {
        let _ = oct.update(
            f,
            v_far,
            budget: b,
            max_leaves: 4096,
            exact_eye: vec4(v_far.at, v_far.pixel()),
            cell_scale: 1.0,
            min_cell: 0.0004,
            is_cold: false,
        )
        assert(oct.is_2to1_balanced(), "2:1 balance holds during merge pull-back")
    }
    assert(
        oct.active_leaves.len() < settled_leaves,
        f"pull-back merged leaves ({oct.active_leaves.len()} < {settled_leaves})",
    )
    // Verify merged nodes' inactive children are never misclassified as NBR_FINER in neighbor_mask.
    for i in 0..oct.active_leaves.len() {
        let ni = oct.active_leaves[i]
        let (nlo, nhi) = oct.neighbor_mask(ni)
        let n = oct.nodes[ni]
        let d = oct.dims_at(n.level)
        for dz in -1..=1 {
            let nz = i32(n.bz) + dz
            for dy in -1..=1 {
                let ny = i32(n.by) + dy
                for dx in -1..=1 {
                    if dx == 0 && dy == 0 && dz == 0 {
                        continue
                    }
                    let nx = i32(n.bx) + dx
                    if nx < 0 ||
                        ny < 0 ||
                        nz < 0 ||
                        nx >= i32(d.x) ||
                        ny >= i32(d.y) ||
                        nz >= i32(d.z) {
                        continue
                    }
                    let st = nbr_get(nlo, nhi, dx, dy, dz)
                    let nb = oct.map.get(n.level, u32(nx), u32(ny), u32(nz))
                    if nb != NONE && oct.nodes[nb].state == NODE_INACTIVE {
                        assert(
                            st == NBR_COARSER,
                            "inactive merged child must report NBR_COARSER, never NBR_FINER",
                        )
                    }
                }
            }
        }
    }
}
