// Sparse 2-cascade hardware 3D SDF Clipmap (`SdfClipmap`): camera-focused fine cascade (`96³`
// `R16Float`, ~1.77 MB) + world-spanning coarse cascade (`64³` `R16Float`, ~0.52 MB) with static/
// dynamic split (0.00 ms/frame static cost after Frame 1).
//
// Powers five unified engine systems from ONE hardware-trilinear distance representation:
//   1. Exact variable-width soft shadows & blocker distance (Aaltonen 2018 cone penumbra)
//   2. Multi-scale bent-normal ambient occlusion + Jimenez (2016) multi-bounce colored AO
//   3. Exact interior physical thickness for backlit subsurface scattering (SSS)
//   4. Analytical world-space mean curvature (`∇²d`) for universal edge wear & cavity darkening
//   5. 1-tap hardware SDF broad-phase acceleration for GPU swarms & offscreen specular reflections

use matter::substance::Substance
use std::collections::Vec
use std::field::Field
use std::gpu::{
    Address, Atomics, Filter, GlobalId, GpuBuffer, GpuSpan, R16Float, Sampler, Slots, Texels3d,
    Texture3d, buffer, buffer_of, copy, dispatch, label, sampler, texture3d, write,
}

/// Cascade 0 (camera-focused fine SDF) resolution along each axis (`96³` = 884,736 texels).
pub const SDF0_SIDE: u32 = 96
const SDF0_VOXELS: u32 = 884736

/// Cascade 1 (world-spanning coarse SDF) resolution along each axis (`64³` = 262,144 texels).
pub const SDF1_SIDE: u32 = 64
const SDF1_VOXELS: u32 = 262144

/// Maximum stored signed distance (m) and fixed-point scale for `Atomics<i32>` min accumulation.
pub const SDF_MAX: f32 = 8.0
const SDF_SCALE: f32 = 16384.0
const SDF_INV_SCALE: f32 = 6.1035156e-5
const SDF_INIT_I32: i32 = 131072 // 8.0 * 16384.0

/// Spatial mapping of the 2-cascade 3D SDF clipmap (48 bytes, std140/std430-aligned).
pub struct SdfGrid: Copy + GpuData {
    pub o0: vec3,
    pub v0: f32,
    pub o1: vec3,
    pub v1: f32,
    pub inv_s0: f32,
    pub inv_s1: f32,
    pub enabled: u32,
    pub pad0: u32,
}

/// One tight 3D voxel sub-box for splatting item `item` of a field array into an SDF cascade.
struct SdfBox: Copy + GpuData {
    vlo: vec3u,
    item: u32,
    size: vec3u,
    base_work: u32,
    bound: vec4,
}

/// Builds voxel-snapped cascade origins and spacings around `(focus, wmid, wrad)`.
pub fn sdf_grid(focus: vec3, wmid: vec3, wrad: f32, enabled: bool) -> SdfGrid {
    let half0 = clamp(wrad * 1.05, 4.5, 9.5)
    let span0 = 2.0 * half0
    let v0 = span0 / f32(SDF0_SIDE)
    let o0 = floor((focus - vec3(half0)) / v0) * v0

    let half1 = clamp(wrad * 1.12, 8.0, 28.0)
    let span1 = 2.0 * half1
    let v1 = span1 / f32(SDF1_SIDE)
    let o1 = floor((wmid - vec3(half1)) / v1) * v1

    SdfGrid {
        o0,
        v0,
        o1,
        v1,
        inv_s0: 1.0 / span0,
        inv_s1: 1.0 / span1,
        enabled: if enabled { 1 } else { 0 },
        pad0: 0,
    }
}

/// Encodes signed distance `d` (m) into fixed-point `i32` for exact atomic `min` accumulation.
fn encode_sdf_i32(d: f32) -> i32 {
    i32(clamp(d, -SDF_MAX, SDF_MAX) * SDF_SCALE)
}

/// Initializes an `i32` SDF accumulation buffer to `+SDF_MAX`.
@compute(64)
fn clear_sdf_i32(n: u32, buf: mut Slots<i32>, id: GlobalId) {
    if id.x >= n {
        return
    }
    buf[id] = SDF_INIT_I32
}

/// Finds which `SdfBox` owns flat voxel work index `wi` by binary search over `base_work`.
fn find_sdf_box(boxes: [SdfBox], n: u32, wi: u32) -> u32 {
    var lo: u32 = 0
    var hi: u32 = n
    for _k in 0..16 {
        if lo + 1 >= hi {
            break
        }
        let mid = (lo + hi) >> 1
        if boxes[mid].base_work <= wi {
            lo = mid
        } else {
            hi = mid
        }
    }
    lo
}

/// Splats `n_boxes` padded 3D voxel sub-boxes of `fields` into an `Atomics<i32>` SDF cascade,
/// using each field's provably sound bounding sphere (`length(wp - c) - r >= cur`) to skip
/// `field.distance(wp)` whenever the voxel is already closer to another surface.
@compute(64)
@budget(work: 32000)
fn sdf_splat_boxes<M: Field<Substance>>(
    fields: [M],
    boxes: [SdfBox],
    n_boxes: u32,
    total_work: u32,
    origin: vec3,
    voxel: f32,
    side: u32,
    out: mut Atomics<i32>,
    id: GlobalId,
) {
    if id.x >= total_work || n_boxes == 0 {
        return
    }
    let bi = find_sdf_box(boxes, n_boxes, id.x)
    let b = boxes[bi]
    let local = id.x - b.base_work
    let xy = b.size.x * b.size.y
    let lz = local / xy
    let rem = local - lz * xy
    let ly = rem / b.size.x
    let lx = rem - ly * b.size.x
    let vx = b.vlo.x + lx
    let vy = b.vlo.y + ly
    let vz = b.vlo.z + lz
    let idx = vx + (vy + vz * side) * side
    let wp = origin + (vec3(f32(vx), f32(vy), f32(vz)) + vec3(0.5)) * voxel
    let cur = f32(out.load(idx)) * SDF_INV_SCALE
    let lower = length(wp - b.bound.xyz) - b.bound.w
    if lower >= cur {
        return
    }
    let d = fields[b.item].distance(wp)
    if d < cur {
        let _ = out.min(idx, encode_sdf_i32(d))
    }
}

/// Resolves a fixed-point `i32` SDF accumulation buffer into a hardware-filtered `Texture3d<R16Float>`.
@compute(4, 4, 4)
fn sdf_resolve(
    src: [i32],
    side: u32,
    out: mut Texels3d<R16Float>,
    id: GlobalId,
) {
    if id.x >= side || id.y >= side || id.z >= side {
        return
    }
    let idx = id.x + (id.y + id.z * side) * side
    let d = clamp(f32(src[idx]) * SDF_INV_SCALE, -SDF_MAX, SDF_MAX)
    out.store(id, d)
}

// ---- Hardware-Trilinear 3D SDF Queries ---------------------------------------------------------

/// 4-corner regular tetrahedron gradient normal of the 3D SDF clipmap at `wp` (4 cache-coherent
/// `R16Float` taps): exact on planar floors/walls and smooth on curved geometry for fast swarms.
pub fn sdf_normal(
    grid: SdfGrid,
    sdf0: Texture3d<R16Float>,
    sdf1: Texture3d<R16Float>,
    s: Sampler,
    wp: vec3,
) -> vec3 {
    let h = max(grid.v0 * 0.45, 0.04)
    let d0 = sdf_sample(grid, sdf0, sdf1, s, wp + vec3(h, h, h))
    let d1 = sdf_sample(grid, sdf0, sdf1, s, wp + vec3(h, -h, -h))
    let d2 = sdf_sample(grid, sdf0, sdf1, s, wp + vec3(-h, h, -h))
    let d3 = sdf_sample(grid, sdf0, sdf1, s, wp + vec3(-h, -h, h))
    let g = vec3(d0 + d1 - d2 - d3, d0 - d1 + d2 - d3, d0 - d1 - d2 + d3)
    let gl2 = dot(g, g)
    if gl2 > 1.0e-10 { g * (1.0 / sqrt(gl2)) } else { vec3(0.0, 1.0, 0.0) }
}

/// Samples the signed distance (m) at world point `wp` from the finest covering SDF cascade
/// (1 hardware trilinear 2-byte `R16Float` tap).
pub fn sdf_sample(
    grid: SdfGrid,
    sdf0: Texture3d<R16Float>,
    sdf1: Texture3d<R16Float>,
    s: Sampler,
    wp: vec3,
) -> f32 {
    let u0 = (wp - grid.o0) * grid.inv_s0
    if u0.x >= 0.02 && u0.x <= 0.98 && u0.y >= 0.02 && u0.y <= 0.98 && u0.z >= 0.02 && u0.z <= 0.98 {
        return sdf0.sample_level(s, u0, 0.0)
    }
    let u1 = (wp - grid.o1) * grid.inv_s1
    if u1.x >= 0.02 && u1.x <= 0.98 && u1.y >= 0.02 && u1.y <= 0.98 && u1.z >= 0.02 && u1.z <= 0.98 {
        return sdf1.sample_level(s, u1, 0.0)
    }
    SDF_MAX
}

/// Exact variable-width soft directional shadow via improved cone-penumbra sphere tracing
/// (Aaltonen, GDC 2018). Returns `vec2(soft_visibility, blocker_distance_m)`:
///   - `soft_visibility` in `[0, 1]`: razor-sharp near contact, smoothly widening with blocker distance
///   - `blocker_distance_m`: exact distance to the tightest occluder along `light_dir` (for hybrid PCSS)
pub fn sdf_soft_shadow(
    grid: SdfGrid,
    sdf0: Texture3d<R16Float>,
    sdf1: Texture3d<R16Float>,
    s: Sampler,
    wp: vec3,
    n: vec3,
    light_dir: vec3,
    max_dist: f32,
    k: f32,
) -> vec2 {
    if grid.enabled == 0 {
        return vec2(1.0, 0.0)
    }
    let p0 = wp + n * max(grid.v0 * 0.95, 0.09)
    var t = max(grid.v0 * 1.15, 0.14)
    var res = 1.0
    var prev_d = 1.0e10
    var blocker_t = 0.0
    for _step in 0..6 {
        if t >= max_dist {
            break
        }
        let d = sdf_sample(grid, sdf0, sdf1, s, p0 + light_dir * t)
        if d < 0.008 {
            return vec2(0.0, t)
        }
        let y = if prev_d < 1.0e9 { (d * d) / (2.0 * prev_d) } else { 0.0 }
        let r = sqrt(max(d * d - y * y, 0.0))
        let pen = k * r / max(t - y, 0.001)
        if pen < res {
            res = pen
            blocker_t = t
        }
        if res <= 0.01 {
            return vec2(0.0, blocker_t)
        }
        prev_d = d
        t += clamp(d, grid.v0 * 0.55, 1.65)
    }
    let vis = clamp(res, 0.0, 1.0)
    // Smoothstep S-curve avoids linear penumbra Mach bands.
    let smooth_vis = vis * vis * (3.0 - 2.0 * vis)
    vec2(smooth_vis, blocker_t)
}

/// Soft local shadow visibility from `wp` toward an auto-extracted emitter at `lp` (radius `lr`),
/// sphere-traced in 5 hardware SDF taps for crisp fire/spell shadows around columns & duelists.
pub fn sdf_local_shadow(
    grid: SdfGrid,
    sdf0: Texture3d<R16Float>,
    sdf1: Texture3d<R16Float>,
    s: Sampler,
    wp: vec3,
    n: vec3,
    lp: vec3,
    lr: f32,
) -> f32 {
    if grid.enabled == 0 {
        return 1.0
    }
    let delta = lp - wp
    let dist = length(delta)
    let start_t = max(grid.v0 * 1.15, 0.14)
    let end_t = dist - lr - max(grid.v0 * 0.8, 0.12)
    if end_t <= start_t {
        return 1.0
    }
    let dir = delta / max(dist, 1.0e-5)
    let p0 = wp + n * max(grid.v0 * 0.9, 0.08)
    var t = start_t
    var res = 1.0
    for _step in 0..4 {
        if t >= end_t {
            break
        }
        let d = sdf_sample(grid, sdf0, sdf1, s, p0 + dir * t)
        if d <= 0.01 {
            return 0.08
        }
        // Soft area-light penumbra scales inversely with emitter radius `lr`.
        let k = clamp(1.4 / max(lr, 0.18), 2.5, 8.0)
        res = min(res, k * d / max(t, 0.05))
        t += clamp(d, grid.v0 * 0.55, 1.35)
    }
    let fade = clamp((end_t - start_t) / max(grid.v0 * 1.5, 0.2), 0.0, 1.0)
    let svis = clamp(res, 0.0, 1.0)
    mix(1.0, max(svis * svis * (3.0 - 2.0 * svis), 0.08), fade)
}

/// Multi-scale bent-normal ambient occlusion from the 3D SDF clipmap (Evans 2006 / Jimenez 2016):
/// traces 4 hemisphere directions × 3 escalating distances (12 fast 2-byte `R16Float` taps),
/// returning `vec4(bent_normal.xyz, ao)` where `bent_normal` points toward the unoccluded sky.
pub fn sdf_bent_ao(
    grid: SdfGrid,
    sdf0: Texture3d<R16Float>,
    sdf1: Texture3d<R16Float>,
    s: Sampler,
    wp: vec3,
    n: vec3,
) -> vec4 {
    if grid.enabled == 0 {
        return vec4(n, 1.0)
    }
    let up = if abs(n.y) < 0.9 { vec3(0.0, 1.0, 0.0) } else { vec3(1.0, 0.0, 0.0) }
    let t = normalize(cross(up, n))
    let b = cross(n, t)
    let dirs = [
        n,
        normalize(n * 0.58 + t * 0.815),
        normalize(n * 0.58 - t * 0.4075 + b * 0.706),
        normalize(n * 0.58 - t * 0.4075 - b * 0.706),
    ]
    let weights = [0.34, 0.22, 0.22, 0.22]
    let v = max(grid.v0, 0.06)
    let d1 = v * 1.15
    let d2 = v * 2.6
    let d3 = v * 5.2
    let p0 = wp + n * (v * 0.25)

    var ao = 0.0
    var bent = n * 0.08
    for k in 0..4 {
        let dir = dirs[k]
        let s1 = clamp(sdf_sample(grid, sdf0, sdf1, s, p0 + dir * d1) / d1, 0.0, 1.0)
        let s2 = clamp(sdf_sample(grid, sdf0, sdf1, s, p0 + dir * d2) / d2, 0.0, 1.0)
        let s3 = clamp(sdf_sample(grid, sdf0, sdf1, s, p0 + dir * d3) / d3, 0.0, 1.0)
        let vis = min(s1, min(s2 * 1.05, s3 * 1.12))
        let w = weights[k]
        ao += w * vis
        bent += dir * (w * vis)
    }
    let bl2 = dot(bent, bent)
    let bent_n = if bl2 > 1.0e-8 { bent * (1.0 / sqrt(bl2)) } else { n }
    vec4(bent_n, clamp(ao, 0.08, 1.0))
}

/// Jimenez et al. (2016) multi-bounce colored AO approximation: preserves warm inter-reflected
/// bounce color in crevices instead of crushing albedo to dead black.
pub fn multi_bounce_ao(ao: f32, albedo: vec3) -> vec3 {
    let a = albedo * 2.0404 - vec3(0.3324)
    let b = albedo * (-4.7951) + vec3(0.6417)
    let c = albedo * 2.7552 + vec3(0.6903)
    let x = vec3(clamp(ao, 0.0, 1.0))
    max(x, ((x * a + b) * x + c) * x)
}

/// Measures physical interior thickness (m) behind surface point `(wp, n)` along `-light_dir` using
/// 2 interior SDF taps for physically grounded backlit Subsurface Scattering (SSS) transmittance.
pub fn sdf_thickness(
    grid: SdfGrid,
    sdf0: Texture3d<R16Float>,
    sdf1: Texture3d<R16Float>,
    s: Sampler,
    wp: vec3,
    n: vec3,
    light_dir: vec3,
) -> f32 {
    if grid.enabled == 0 {
        return 0.25
    }
    let v = max(grid.v0, 0.06)
    let d1 = sdf_sample(grid, sdf0, sdf1, s, wp - n * (v * 0.55) - light_dir * (v * 0.85))
    let d2 = sdf_sample(grid, sdf0, sdf1, s, wp - n * (v * 0.90) - light_dir * (v * 2.0))
    max(-d1, 0.0) * 1.4 + max(-d2, 0.0) * 2.2
}

/// Analytical discrete isotropic Laplacian (`∇²d`) of the 3D SDF at `wp` using a 4-corner regular
/// tetrahedron stencil (`sum(4 corners) - 4*c0 = 2 h² ∇²d`): 5 cache-coherent taps total,
/// returning dimensionless signed curvature in `[-1, 1]` (`+` = convex bevel, `-` = concave crevice).
pub fn sdf_curvature(
    grid: SdfGrid,
    sdf0: Texture3d<R16Float>,
    sdf1: Texture3d<R16Float>,
    s: Sampler,
    wp: vec3,
) -> f32 {
    if grid.enabled == 0 {
        return 0.0
    }
    let u0 = (wp - grid.o0) * grid.inv_s0
    if u0.x < 0.03 || u0.x > 0.97 || u0.y < 0.03 || u0.y > 0.97 || u0.z < 0.03 || u0.z > 0.97 {
        return 0.0
    }
    let du = grid.v0 * grid.inv_s0 * 0.72
    let c0 = sdf0.sample_level(s, u0, 0.0)
    let sum = sdf0.sample_level(s, u0 + vec3(du, du, du), 0.0) +
        sdf0.sample_level(s, u0 + vec3(du, -du, -du), 0.0) +
        sdf0.sample_level(s, u0 + vec3(-du, du, -du), 0.0) +
        sdf0.sample_level(s, u0 + vec3(-du, -du, du), 0.0)
    clamp((sum - 4.0 * c0) / max(grid.v0 * 1.15, 0.08), -1.0, 1.0)
}

/// Sphere-traces 5 steps in the 3D SDF clipmap along reflection ray `refl` to locate offscreen
/// surfaces (pillars, braziers, spells behind the camera). Returns `vec4(hit_wp, hit_confidence)`.
pub fn sdf_spec_hit(
    grid: SdfGrid,
    sdf0: Texture3d<R16Float>,
    sdf1: Texture3d<R16Float>,
    s: Sampler,
    wp: vec3,
    n: vec3,
    refl: vec3,
    max_dist: f32,
) -> vec4 {
    if grid.enabled == 0 {
        return vec4(0.0)
    }
    let v = max(grid.v0, 0.06)
    let p0 = wp + n * (v * 1.1)
    var t = v * 1.4
    for _step in 0..5 {
        if t >= max_dist {
            break
        }
        let p = p0 + refl * t
        let d = sdf_sample(grid, sdf0, sdf1, s, p)
        if d < v * 0.65 {
            let fade = clamp(1.0 - t / max_dist, 0.15, 1.0)
            return vec4(p, fade)
        }
        t += clamp(d, v * 0.5, 1.4)
    }
    vec4(0.0)
}

// ---- Persistent GPU State (`SdfClipmap`) -------------------------------------------------------

/// Computes the clamped voxel sub-box `[vlo, size]` overlapping sphere `bound` expanded by `pad`,
/// returning `None` if disjoint from `[0, side)³`.
fn box_for_sphere(
    bound: vec4,
    pad: f32,
    origin: vec3,
    voxel: f32,
    side: u32,
    item: u32,
    base_work: u32,
) -> Option<SdfBox> {
    if bound.w <= 0.0 {
        return None
    }
    let r = bound.w + pad
    let lo = bound.xyz - vec3(r)
    let hi = bound.xyz + vec3(r)
    let inv_v = 1.0 / max(voxel, 1.0e-5)
    let fside = f32(side)
    let x0 = i32(floor((lo.x - origin.x) * inv_v))
    let y0 = i32(floor((lo.y - origin.y) * inv_v))
    let z0 = i32(floor((lo.z - origin.z) * inv_v))
    let x1 = i32(ceil((hi.x - origin.x) * inv_v))
    let y1 = i32(ceil((hi.y - origin.y) * inv_v))
    let z1 = i32(ceil((hi.z - origin.z) * inv_v))
    if x1 <= 0 || y1 <= 0 || z1 <= 0 || x0 >= i32(side) || y0 >= i32(side) || z0 >= i32(side) {
        return None
    }
    let cx0 = u32(clamp(f32(x0), 0.0, fside - 1.0))
    let cy0 = u32(clamp(f32(y0), 0.0, fside - 1.0))
    let cz0 = u32(clamp(f32(z0), 0.0, fside - 1.0))
    let cx1 = u32(clamp(f32(x1), 1.0, fside))
    let cy1 = u32(clamp(f32(y1), 1.0, fside))
    let cz1 = u32(clamp(f32(z1), 1.0, fside))
    if cx1 <= cx0 || cy1 <= cy0 || cz1 <= cz0 {
        return None
    }
    Some(SdfBox {
        vlo: vec3u(cx0, cy0, cz0),
        item,
        size: vec3u(cx1 - cx0, cy1 - cy0, cz1 - cz0),
        base_work,
        bound,
    })
}

/// Persistent GPU buffers and 2-cascade `R16Float` 3D textures for the unified SDF clipmap.
pub struct SdfClipmap {
    pub static_buf0: GpuBuffer<i32>,
    pub work_buf0: GpuBuffer<i32>,
    pub static_buf1: GpuBuffer<i32>,
    pub work_buf1: GpuBuffer<i32>,
    boxes_buf: GpuBuffer<SdfBox>,
    boxes_cap: u32,
    pub sdf0: Texture3d<R16Float>,
    pub sdf1: Texture3d<R16Float>,
    pub s: Sampler,
    pub grid: SdfGrid,
    pub static_key: u64,
    pub static_valid: bool,
    pub full_key: u64,
    pub full_valid: bool,
}

/// Allocates a fresh 2-cascade `SdfClipmap` (~11.4 MB total VRAM).
pub fn sdf_clipmap() -> SdfClipmap {
    SdfClipmap {
        static_buf0: buffer(SDF0_VOXELS),
        work_buf0: buffer(SDF0_VOXELS),
        static_buf1: buffer(SDF1_VOXELS),
        work_buf1: buffer(SDF1_VOXELS),
        boxes_buf: buffer(64),
        boxes_cap: 64,
        sdf0: texture3d(width: SDF0_SIDE, height: SDF0_SIDE, depth: SDF0_SIDE),
        sdf1: texture3d(width: SDF1_SIDE, height: SDF1_SIDE, depth: SDF1_SIDE),
        s: sampler(filter: Filter::Linear, address: Address::Clamp),
        grid: sdf_grid(vec3(0.0), vec3(0.0), 10.0, enabled: false),
        static_key: 0,
        static_valid: false,
        full_key: 0,
        full_valid: false,
    }
}

impl SdfClipmap {
    fn ensure_boxes(mut self, count: u32) {
        if count > self.boxes_cap {
            var cap = max(self.boxes_cap, 64)
            while cap < count {
                cap *= 2
            }
            self.boxes_buf = buffer(cap)
            self.boxes_cap = cap
        }
    }

    /// Disables the SDF clipmap (`gi == false` reference mode) with zero GPU work.
    pub fn disable(mut self, focus: vec3, wmid: vec3, wrad: f32) {
        self.grid = sdf_grid(focus, wmid, wrad, enabled: false)
        self.full_valid = false
    }

    /// Initializes the static SDF accumulation buffers to `+SDF_MAX`.
    pub fn begin_static(mut self, grid: SdfGrid) {
        self.grid = grid
        label("mesh_sdf")
        dispatch(clear_sdf_i32.bind(n: SDF0_VOXELS, buf: mut self.static_buf0), over: SDF0_VOXELS)
        dispatch(clear_sdf_i32.bind(n: SDF1_VOXELS, buf: mut self.static_buf1), over: SDF1_VOXELS)
    }

    /// Initializes the dynamic SDF accumulation buffers to `+SDF_MAX` (no static split).
    pub fn begin_all(mut self, grid: SdfGrid) {
        self.grid = grid
        label("mesh_sdf")
        dispatch(clear_sdf_i32.bind(n: SDF0_VOXELS, buf: mut self.work_buf0), over: SDF0_VOXELS)
        dispatch(clear_sdf_i32.bind(n: SDF1_VOXELS, buf: mut self.work_buf1), over: SDF1_VOXELS)
    }

    /// Copies the cached static SDF accumulation buffers into the per-frame working buffers (~0.04 ms).
    pub fn begin_from_static(mut self, grid: SdfGrid) {
        self.grid = grid
        label("mesh_sdf")
        copy(from: self.static_buf0.items(), to: self.work_buf0.items_mut())
        copy(from: self.static_buf1.items(), to: self.work_buf1.items_mut())
    }

    /// Splats a single field into both cascades (only its padded voxel sub-box, with sphere early-out).
    pub fn splat_one<M: Field<Substance> + GpuData>(
        mut self,
        field: M,
        bound: vec4,
        to_static: bool,
    ) {
        let b = if bound.w > 0.0 {
            bound
        } else {
            let fb = field.bound()
            vec4(fb.centre, min(fb.radius, 1.0e4))
        }
        let pad0 = if to_static { SDF_MAX } else { 2.0 }
        let pad1 = if to_static { SDF_MAX } else { 2.5 }
        let b0 = box_for_sphere(b, pad0, self.grid.o0, self.grid.v0, SDF0_SIDE, item: 0, base_work: 0)
        let b1 = box_for_sphere(b, pad1, self.grid.o1, self.grid.v1, SDF1_SIDE, item: 0, base_work: 0)
        let has0 = match b0 { Some(_) => true, None => false }
        let has1 = match b1 { Some(_) => true, None => false }
        if !has0 && !has1 {
            return
        }
        let fbuf = buffer_of([field])
        match b0 {
            Some(bx) => {
                let work = bx.size.x * bx.size.y * bx.size.z
                write(mut self.boxes_buf, 0, [bx])
                if to_static {
                    dispatch(
                        sdf_splat_boxes.bind(
                            fields: fbuf.items(), boxes: self.boxes_buf.items(), n_boxes: 1,
                            total_work: work, origin: self.grid.o0, voxel: self.grid.v0,
                            side: SDF0_SIDE, out: mut self.static_buf0,
                        ),
                        over: work,
                    )
                } else {
                    dispatch(
                        sdf_splat_boxes.bind(
                            fields: fbuf.items(), boxes: self.boxes_buf.items(), n_boxes: 1,
                            total_work: work, origin: self.grid.o0, voxel: self.grid.v0,
                            side: SDF0_SIDE, out: mut self.work_buf0,
                        ),
                        over: work,
                    )
                }
            },
            None => {},
        }
        match b1 {
            Some(bx) => {
                let work = bx.size.x * bx.size.y * bx.size.z
                write(mut self.boxes_buf, 0, [bx])
                if to_static {
                    dispatch(
                        sdf_splat_boxes.bind(
                            fields: fbuf.items(), boxes: self.boxes_buf.items(), n_boxes: 1,
                            total_work: work, origin: self.grid.o1, voxel: self.grid.v1,
                            side: SDF1_SIDE, out: mut self.static_buf1,
                        ),
                        over: work,
                    )
                } else {
                    dispatch(
                        sdf_splat_boxes.bind(
                            fields: fbuf.items(), boxes: self.boxes_buf.items(), n_boxes: 1,
                            total_work: work, origin: self.grid.o1, voxel: self.grid.v1,
                            side: SDF1_SIDE, out: mut self.work_buf1,
                        ),
                        over: work,
                    )
                }
            },
            None => {},
        }
    }

    /// Splats an array of `N` fields into both cascades in one flat dispatch per cascade.
    pub fn splat_many<M: Field<Substance> + GpuData, const N: u32>(
        mut self,
        fields: [M; N],
        to_static: bool,
    ) {
        let pad0 = if N > 32 { 0.45 } else if to_static { 2.5 } else { 1.4 }
        let pad1 = if N > 32 { 0.85 } else if to_static { 3.5 } else { 1.8 }
        var boxes0: Vec<SdfBox> = Vec::new()
        var work0: u32 = 0
        var boxes1: Vec<SdfBox> = Vec::new()
        var work1: u32 = 0
        for i in 0..N {
            let fb = fields[i].bound()
            let b = vec4(fb.centre, min(fb.radius, 1.0e4))
            match box_for_sphere(b, pad0, self.grid.o0, self.grid.v0, SDF0_SIDE, i, work0) {
                Some(bx) => {
                    let w = bx.size.x * bx.size.y * bx.size.z
                    if work0 + w <= 524288 {
                        boxes0.push(bx)
                        work0 += w
                    }
                },
                None => {},
            }
            match box_for_sphere(b, pad1, self.grid.o1, self.grid.v1, SDF1_SIDE, i, work1) {
                Some(bx) => {
                    let w = bx.size.x * bx.size.y * bx.size.z
                    if work1 + w <= 262144 {
                        boxes1.push(bx)
                        work1 += w
                    }
                },
                None => {},
            }
        }
        if work0 == 0 && work1 == 0 {
            return
        }
        let fbuf = buffer_of(fields)
        if work0 > 0 {
            let nb0 = boxes0.len()
            self.ensure_boxes(nb0)
            write(mut self.boxes_buf, 0, boxes0)
            if to_static {
                dispatch(
                    sdf_splat_boxes.bind(
                        fields: fbuf.items(), boxes: self.boxes_buf.items(), n_boxes: nb0,
                        total_work: work0, origin: self.grid.o0, voxel: self.grid.v0,
                        side: SDF0_SIDE, out: mut self.static_buf0,
                    ),
                    over: work0,
                )
            } else {
                dispatch(
                    sdf_splat_boxes.bind(
                        fields: fbuf.items(), boxes: self.boxes_buf.items(), n_boxes: nb0,
                        total_work: work0, origin: self.grid.o0, voxel: self.grid.v0,
                        side: SDF0_SIDE, out: mut self.work_buf0,
                    ),
                    over: work0,
                )
            }
        }
        if work1 > 0 {
            let nb1 = boxes1.len()
            self.ensure_boxes(nb1)
            write(mut self.boxes_buf, 0, boxes1)
            if to_static {
                dispatch(
                    sdf_splat_boxes.bind(
                        fields: fbuf.items(), boxes: self.boxes_buf.items(), n_boxes: nb1,
                        total_work: work1, origin: self.grid.o1, voxel: self.grid.v1,
                        side: SDF1_SIDE, out: mut self.static_buf1,
                    ),
                    over: work1,
                )
            } else {
                dispatch(
                    sdf_splat_boxes.bind(
                        fields: fbuf.items(), boxes: self.boxes_buf.items(), n_boxes: nb1,
                        total_work: work1, origin: self.grid.o1, voxel: self.grid.v1,
                        side: SDF1_SIDE, out: mut self.work_buf1,
                    ),
                    over: work1,
                )
            }
        }
    }

    /// Resolves both fixed-point accumulation buffers into hardware-trilinear `Texture3d<R16Float>`.
    pub fn finish(mut self) {
        label("mesh_sdf")
        dispatch(
            sdf_resolve.bind(src: self.work_buf0.items(), side: SDF0_SIDE, out: mut self.sdf0),
            over: (SDF0_SIDE, SDF0_SIDE, SDF0_SIDE),
        )
        dispatch(
            sdf_resolve.bind(src: self.work_buf1.items(), side: SDF1_SIDE, out: mut self.sdf1),
            over: (SDF1_SIDE, SDF1_SIDE, SDF1_SIDE),
        )
    }
}
