) -> Targets2<vec4, vec2> {
    let tid = min(u32(max(vary.meta.y, 0.0)), n_fields - 1)
    let sub0 = fields[tid].channels(vary.wp)
    let interior = interior_length(fields[tid], vary.wp, normalize(vary.wp - v.at), 18.0)
    let c = shade_trans_core(
        pixel,
        vary.wp,
        vary.local_p,
        interior,
        vary.normal,
        vary.meta.x,
        sub0,
        v,
        sv,
        rad_grid,
        sdf_grid,
        sky,
        sky_diff,
        sky_spec0,
        sky_spec1,
        sky_spec2,
        sky_s,
        shadow_map,
        static_shadow_map,
        has_static_shadow,
        cmp,
        rad0,
        rad1,
        rad2,
        rad_s,
        sdf0,
        sdf1,
        sdf_s,
        emitters,
        tile_masks,
        tiles_x,
        hdr_bg,
        refract_refl,
        bg_s,
    )
    Targets2 { first: c, second: motion_of(vary.wp, vary.prev_wp, v, prev_v) }
}

