/// Physically-based refractive / transmissive fragment shader for transmissive heightfields
/// (`height_vs`): an open volume of water, absorbing to whatever lies behind it (colour + motion).
@fragment
@budget(work: 44000)
pub(package) fn mesh_trans_fs<S: Sky>(
    pixel: FragCoord,
    vary: MeshVary,
    v: View,
    prev_v: View,
    sv: ShadowView,
    rad_grid: RadGrid,
    sdf_grid: SdfGrid,
    sky: S,
    sky_diff: Texture<Rgba16Float>,
    sky_spec0: Texture<Rgba16Float>,
    sky_spec1: Texture<Rgba16Float>,
    sky_spec2: Texture<Rgba16Float>,
    sky_s: Sampler,
    shadow_map: DepthTexture,
    static_shadow_map: DepthTexture,
    has_static_shadow: u32,
    cmp: ComparisonSampler,
    rad0: Texture3d<Rgba16Float>,
    rad1: Texture3d<Rgba16Float>,
    rad2: Texture3d<Rgba16Float>,
    rad_s: Sampler,
    sdf0: Texture3d<R16Float>,
    sdf1: Texture3d<R16Float>,
    sdf_s: Sampler,
    emitters: [Emitter],
    tile_masks: [u32],
    tiles_x: u32,
    hdr_bg: Texture<Rgba16Float>,
    refract_refl: Texture<Rgba16Float>,
    bg_s: Sampler,
) -> Targets2<vec4, vec2> {
    let sub0 = vary_substance(vary)
    let interior = -1.0
    let c = shade_trans_core(
        pixel,
        vary.wp,
        vary.wp,
        interior,
        vary.normal,
        vary.pbr.w,
        sub0,
        v,
        sv,
        rad_grid,
        sdf_grid,
        sky,
        sky_diff,
        sky_spec0,
        sky_spec1,
        sky_spec2,
        sky_s,
        shadow_map,
        static_shadow_map,
        has_static_shadow,
        cmp,
        rad0,
        rad1,
        rad2,
        rad_s,
        sdf0,
        sdf1,
        sdf_s,
        emitters,
        tile_masks,
        tiles_x,
        hdr_bg,
        refract_refl,
        bg_s,
    )
    Targets2 { first: c, second: motion_of(vary.wp, vary.prev_wp, v, prev_v) }
}

/// Computes a curvature- and budget-aware cell spacing for a single thing with bounding sphere
/// `(c, r)`. Targets a bounded screen-space sagitta error (`c ≈ sqrt(8 * e * R_feat * px)`),
/// keeping tight `~1.45 px` cells when an object is small on screen (or `1.1 px` for `steep`
/// noise fields) while avoiding sub-2-pixel micro-triangles on large smooth close-ups.
