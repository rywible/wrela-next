/// Half-resolution (`W/2 × H/2`) reflection pre-pass for transmissive heightfields (`height_vs`).
@fragment
@budget(work: 16000)
pub(package) fn refract_refl_fs(
    pixel: FragCoord,
    vary: MeshVary,
    v: View,
    rad_grid: RadGrid,
    sdf_grid: SdfGrid,
    sky_diff: Texture<Rgba16Float>,
