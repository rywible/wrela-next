/// Lean interpolator for Tier-2 `ExactCell` AABB shells (`exact_box_vs` -> `exact_box_one_fs`):
/// passes the cell box `[lo, lo + h]` and brick live-part mask as `Flat` attributes plus the
/// interpolated front-face world point `wp`.
struct ExactVary: Copy {
    clip: ClipPosition,
    wp: vec3,
    cell_lo_h: Flat<vec4>,
    cell_meta: Flat<vec4u>,
}

/// A box's 12 triangles, outward and counter-clockwise, as corners `k = x | (y << 1) | (z << 2)`,
/// a face (2 triangles) at a time: -Z, +Z, -X, +X, -Y, +Y.
const BOX_CORNERS: [u32; 36] = [
    0, 2, 3, 0, 3, 1, 4, 5, 7, 4, 7, 6, 0, 4, 6, 0, 6, 2, 1, 3, 7, 1, 7, 5, 0, 1, 5, 0, 5, 4, 2, 6,
    7, 2, 7, 3,
]

/// Vertex shader for exact cells (`ExactCell`), 36 vertices an instance, drawn with no culling:
/// a face turned away from the eye is folded to nothing, so each pixel the box covers is drawn
/// once, from its near face. With the eye inside the box (or within the near plane of it) every
/// face is kept and set at the near plane: every ray leaves the box through a face in front of the
/// eye, and its depth, the nearest there is, keeps `WithDepthBehind`'s promise. (Drawn with back
/// faces culled, a box the eye stood in was drawn nowhere.)
@vertex
pub(package) fn exact_box_vs(
    cells: [ExactCell],
    xforms: [Rigid],
    v: View,
    vi: VertexIndex,
    ii: InstanceIndex,
) -> ExactVary {
    let c = cells[ii.index]
    let k = BOX_CORNERS[vi.index]
    let face = vi.index / 6
    let lp = c.lo + vec3(f32(k & 1), f32((k >> 1) & 1), f32((k >> 2) & 1)) * c.h
    let xf = xforms[0]
    let wp = xf.apply_point(lp)
    let axis = face / 2
    let sign = if (face & 1) == 1 { 1.0 } else { -1.0 }
    let n_local = vec3(if axis == 2 { sign } else { 0.0 }, if axis == 1 { sign } else {
        0.0
    }, if axis == 0 {
        sign
    } else { 0.0 })
    let centre = c.lo + vec3(0.5 * c.h)
    let eye_in = xf.apply_point(centre) - v.at
    let reach = 0.5 * c.h * xf.scale_factor() + 2.0 * NEAR
    let inside = abs(dot(eye_in, xf.apply_normal(vec3(1.0, 0.0, 0.0)))) < reach &&
        abs(dot(eye_in, xf.apply_normal(vec3(0.0, 1.0, 0.0)))) < reach &&
        abs(dot(eye_in, xf.apply_normal(vec3(0.0, 0.0, 1.0)))) < reach
    let face_c = xf.apply_point(centre + n_local * (0.5 * c.h))
    let faces_eye = dot(xf.apply_normal(n_local), v.at - face_c) > 0.0
    var clip = clip_of(v, wp)
    if inside {
        clip.position.z = clip.position.w
    } else if !faces_eye {
        clip.position = vec4(0.0, 0.0, 0.0, 1.0)
    }
    ExactVary {
        clip,
        wp,
        cell_lo_h: Flat { value: vec4(c.lo, c.h) },
        cell_meta: Flat { value: c.live.words },
    }
}

/// Reversed-Z NDC depth (`NEAR / z`, matching `clip_of`) of world point `p` seen by `v`.
fn depth_of(v: View, p: vec3) -> f32 {
    NEAR / max(dot(p - v.at, v.forward), NEAR)
}

/// Snapshots the Pass-1 opaque DC reversed-Z depth buffer into an `R32Float` readable texture
/// (~0.07 ms at 1080p) so Tier-2 `exact_box_one_fs` rejects the ~95% of box pixels already covered
/// by DC on Line 1 via `prove_behind_opaque` before running a single field evaluation.
@compute(8, 8)
pub(package) fn copy_dc_depth(depth: DepthTexture, w: u32, h: u32, out: mut Texels<R32Float>, id: GlobalId) {
    if id.x >= w || id.y >= h {
        return
    }
    out.store(id, depth.load(id.x, id.y))
}

/// Tier-2 `ExactCell` AABB fragment shader for `One<M>`: checks the Pass-1 DC depth snapshot on
/// Line 1 (`prove_behind_opaque` skips ~95% of box pixels already covered by DC with zero field
/// evaluations), intersects the pixel's ray against the exact cell cube `[lo, lo + h]`, runs
/// `mesh::proof::solve_cell_ray_lipschitz` (`EmptyProof`-gated discard — zero holes, zero extras),
/// shades analytically at the exact surface hit, and writes conservative `WithDepthBehind` depth.
@fragment
@budget(work: 36000)
pub(package) fn exact_box_one_fs<M: Field<Substance>>(
    vary: ExactVary,
    field: M,
    dc_depth: Texture<R32Float>,
    v: View,
    prev_v: View,
    frag: FragCoord,
) -> WithDepthBehind<Targets4<vec4, vec4, vec4, vec2>> {
    let ch = vary.cell_lo_h.value
    let meta = vary.cell_meta.value
    let lo = ch.xyz
    let h = ch.w
    let hi = lo + vec3(h)
    let rel = vary.wp - v.at
    let dist0 = length(rel)
    let d = rel / max(dist0, 1.0e-6)
    let rb = ray_box_bracket(v.at, d, v.forward, lo, hi)
    let z_dc = dc_depth.load(u32(frag.position.x), u32(frag.position.y))
    let bg_z = if z_dc > 0.0 { NEAR / z_dc } else { 1.0e30 }
    match prove_box_unseen(rb, bg_z) {
        Some(proof) => discard_proven(proof),
        None => {},
    }
    let live = Live { words: meta }
    let px = max(max(rb.t_enter, 0.004) * v.pixel(), 1.0e-6)
    // Only what is in front of what the mesh drew here, less half a pixel: a surface nearer by
    // less shows as the mesh within the outline's error, and one past it is hidden.
    let (t0, t1) = seen_part(rb, bg_z, margin: HOLE_PX * px)
    let lip = field.lipschitz(1.7320508 * h)
    // A field that states no bound here (a closure, a warp) is solved by intervals over the ray
    // (`solve_cell_ray`'s affine halving), never taken to fill the box.
    let res = if lip > 0.0 && lip < 1.0e12 {
        solve_cell_ray_lipschitz(field, live, v.at, d, t0, t1, px, lip)
    } else {
        solve_cell_ray(|q: vec3| field.distance_live(q, live), v.at, d, t0, t1, px, lip)
    }
    var t_hit = t0
    match res {
        CellRay::Hit(t) => {
            t_hit = max(t, t0)
        },
        CellRay::Empty(proof) => {
            discard_proven(proof)
        },
    }
    let hit_p = v.at + d * t_hit
    let sub0 = field.channels(hit_p)
    match prove_transmissive_only(sub0) {
        Some(proof) => discard_proven(proof),
        None => {},
    }
    let (_, gv) = value_and_gradient(|q: vec3| field.distance_live(q, live), hit_p)
    let gl = length(gv)
    let n = if gl > 1.0e-6 { gv / gl } else { -d }
    let out = shade_gbuf_core(hit_p, hit_p, hit_p, n, 1.0, sub0, v, prev_v)
    WithDepthBehind { color: out, depth: depth_of(v, hit_p) }
}

/// Lean 1× G-buffer + motion-vector fragment shader for opaque terrain heightfields (`height_vs`).
@fragment
pub(package) fn mesh_gbuf_fs(vary: MeshVary, v: View, prev_v: View) -> Targets4<vec4, vec4, vec4, vec2> {
    shade_gbuf_core(
        vary.wp,
        vary.prev_wp,
        vary.wp,
        vary.normal,
        vary.pbr.w,
        vary_substance(vary),
        v,
        prev_v,
    )
}

/// Reconstructs exact world hit distance along `ray` from 1× reversed-Z depth `ndc_z`.
fn reconstruct_pixel_dist(v: View, ray: vec3, ndc_z: f32) -> f32 {
    (NEAR / ndc_z) / max(dot(ray, v.forward), 0.05)
}

/// `place` (the opaque surfaces' facing and distance, `Picture::place`) with the transmissive
/// surfaces drawn in front of them put in: where the depth after the transmissive pass is nearer
/// than the opaque surface there, the pixel's middle ray met glass, at that depth, facing as the
/// depth turns across the screen. So the hole audit holds glass to its field too.
@fragment
pub(package) fn place_with_trans_fs(
    depth: DepthTexture,
    place: Texture<Rgba32Float>,
    v: View,
    frag: FragCoord,
) -> vec4 {
    let x = u32(frag.position.x)
    let y = u32(frag.position.y)
    let e = place.load(x, y)
    let z = depth.load(x, y)
    let ray = v.ray(vec2(f32(x) + 0.5, f32(y) + 0.5))
    let dist = if z > 1.0e-6 { reconstruct_pixel_dist(v, ray, z) } else { 0.0 }
    let wp = v.at + ray * dist
    let f = cross(dpdx(wp), dpdy(wp))
    let fl = length(f)
    if dist <= 0.0 || (e.w > 0.0 && dist >= e.w - max(1.0e-4, 0.5 * dist * v.pixel())) {
        return e
    }
    let n0 = if fl > 1.0e-12 { f / fl } else { -ray }
    vec4(if dot(n0, ray) > 0.0 { -n0 } else { n0 }, dist)
}

/// Unpacks a unit normal from `Rgba8` `g_normal = (n * 0.5 + 0.5, 1.0)`.
fn decode_gbuf_normal(gn: vec4, fallback: vec3) -> vec3 {
    let nr = gn.xyz * 2.0 - vec3(1.0)
    let nl2 = dot(nr, nr)
    if nl2 > 1.0e-10 { nr * (1.0 / sqrt(nl2)) } else { fallback }
}

/// Shared pixel-rate direct lighting core used identically by both `draw_scene` (`deferred_direct_fs`)
/// and `drawn_only` (`deferred_direct_judge_fs`): evaluates exact SDF variable-width soft shadows +
/// analytical curvature weathering + thickness-modulated backlit SSS + tiled SDF-shadowed local
/// emitters ONCE per screen pixel (zero micro-triangle quad overshading). Returns the direct HDR
/// `(light, dist)`, the judges' `(n, dist)` place, the sun visibility, and the sun's share of the
/// direct light (`0..1` by luma), so the half-res micro-contact shadow (cast toward the sun) darkens
/// only the sun's part and never emission or local emitters.
@budget(work: 48000)
fn shade_direct_pixel<S: Sky>(
    px: u32,
    py: u32,
    pixel_xy: vec2,
    v: View,
    sv: ShadowView,
    rad_grid: RadGrid,
    sdf_grid: SdfGrid,
    sky: S,
    g_normal: Texture<Rgba8>,
    g_albedo: Texture<Rgba8>,
    g_emits: Texture<Rgba16Float>,
    depth: DepthTexture,
    sky_spec0: Texture<Rgba16Float>,
    sky_s: Sampler,
    shadow_map: DepthTexture,
    static_shadow_map: DepthTexture,
    has_static_shadow: u32,
    cmp: ComparisonSampler,
    rad0: Texture3d<Rgba16Float>,
    rad1: Texture3d<Rgba16Float>,
    rad_s: Sampler,
    sdf0: Texture3d<R16Float>,
    sdf1: Texture3d<R16Float>,
    sdf_s: Sampler,
    emitters: [Emitter],
    tile_masks: [u32],
    tiles_x: u32,
    full_w: u32,
    full_h: u32,
) -> (vec4, vec4, f32, f32) {
    let gn = g_normal.load(px, py)
    let ray = v.ray(pixel_xy)
    if gn.w <= 0.5 {
        return (vec4(sky_background(sky, sky_spec0, sky_s, ray), 65000.0), vec4(0.0), 1.0, 0.0)
    }
    let ndc_z = depth.load(px, py)
    if ndc_z <= 1.0e-6 {
        return (vec4(sky_background(sky, sky_spec0, sky_s, ray), 65000.0), vec4(0.0), 1.0, 0.0)
    }
    let n = decode_gbuf_normal(gn, -ray)
    let ga = g_albedo.load(px, py)
    let ge = g_emits.load(px, py)
    let mat_code = ge.w
    var sub = decode_substance(ga.xyz, ga.w, ge.xyz, mat_code)

    let dist = reconstruct_pixel_dist(v, ray, ndc_z)
    let wp = v.at + ray * dist
    let ray_back = -ray

    // Universal world-space analytical curvature weathering (`∇²d` from 3D SDF clipmap):
    // convex bevels/edges subtly polish & catch light; concave crevices darken & roughen.
    if sdf_grid.enabled != 0 &&
        abs(mat_code) >= 0.01 &&
        max(sub.emits.x, max(sub.emits.y, sub.emits.z)) < 0.25 {
        let curv = sdf_curvature(sdf_grid, sdf0, sdf1, sdf_s, wp)
        let convex = clamp(curv, 0.0, 1.0)
        let concave = clamp(-curv, 0.0, 1.0)
        let wear_a = 1.0 + convex * 0.14 - concave * 0.26
        let wear_r = clamp(sub.roughness - convex * 0.06 + concave * 0.10, 0.03, 1.0)
        sub = Substance {
            albedo: clamp(sub.albedo * wear_a, vec3(0.005), vec3(1.0)),
            roughness: wear_r,
            ..sub,
        }
    }

    let sun = sky.sun()
    let ndl = max(dot(n, sun.way), 0.0)
    let vis = if ndl > 0.0 {
        sun_shadow_hybrid(
            shadow_map,
            static_shadow_map,
            has_static_shadow,
            cmp,
            sv,
            sdf_grid,
            sdf0,
            sdf1,
            sdf_s,
            wp,
            n,
            pixel_xy,
        )
    } else {
        0.0
    }
    var direct_sun = sub.shade_direct(n, sun.way, ray_back, sun.light * vis)
    // Exact interior thickness backlit Subsurface Scattering (SSS) via 2-tap 3D SDF thickness.
    if sub.subsurface > 0.01 && sdf_grid.enabled != 0 {
        let thick = sdf_thickness(sdf_grid, sdf0, sdf1, sdf_s, wp, n, sun.way)
        let trans = exp(-thick * 3.8)
        let back = pow(clamp(dot(ray_back, normalize(-sun.way + n * 0.35)), 0.0, 1.0), 3.0)
        let sss_tint = sub.albedo * sqrt(max(sub.albedo, vec3(0.02)))
        direct_sun += sss_tint *
            sun.light *
            (sub.subsurface * trans * (0.25 + 0.75 * back) * ONE_OVER_PI)
    }
    let local_light = eval_emitters_tiled(
        sub,
        wp,
        n,
        ray_back,
        rad_grid,
        rad0,
        rad1,
        rad_s,
        sdf_grid,
        sdf0,
        sdf1,
        sdf_s,
        emitters,
        tile_masks,
        tiles_x,
        px,
        py,
    )
    let direct = sub.emits + direct_sun + local_light
    let sun_share = clamp(
        luma(max(direct_sun, vec3(0.0))) / max(luma(max(direct, vec3(0.0))), 1.0e-6),
        0.0,
        1.0,
    )
    (vec4(direct, min(dist, 65000.0)), vec4(n, dist), vis, sun_share)
}

/// Full-resolution 1× pixel-rate deferred direct lighting pass (`draw_scene`).
@fragment
@budget(work: 50000)
pub(package) fn deferred_direct_fs<S: Sky>(
    pixel: FragCoord,
    v: View,
    sv: ShadowView,
    rad_grid: RadGrid,
    sdf_grid: SdfGrid,
    sky: S,
    g_normal: Texture<Rgba8>,
    g_albedo: Texture<Rgba8>,
    g_emits: Texture<Rgba16Float>,
    depth: DepthTexture,
    sky_spec0: Texture<Rgba16Float>,
    sky_s: Sampler,
    shadow_map: DepthTexture,
    static_shadow_map: DepthTexture,
    has_static_shadow: u32,
    cmp: ComparisonSampler,
    rad0: Texture3d<Rgba16Float>,
    rad1: Texture3d<Rgba16Float>,
    rad_s: Sampler,
    sdf0: Texture3d<R16Float>,
    sdf1: Texture3d<R16Float>,
    sdf_s: Sampler,
    emitters: [Emitter],
    tile_masks: [u32],
    tiles_x: u32,
    full_w: u32,
    full_h: u32,
) -> Targets2<vec4, f32> {
    let px = min(u32(pixel.position.x), full_w - 1)
    let py = min(u32(pixel.position.y), full_h - 1)
    let (hdr_d, _place, _vis, sun_share) = shade_direct_pixel(
        px,
        py,
        pixel.position.xy,
        v,
        sv,
        rad_grid,
        sdf_grid,
        sky,
        g_normal,
        g_albedo,
        g_emits,
        depth,
        sky_spec0,
        sky_s,
        shadow_map,
        static_shadow_map,
        has_static_shadow,
        cmp,
        rad0,
        rad1,
        rad_s,
        sdf0,
        sdf1,
        sdf_s,
        emitters,
        tile_masks,
        tiles_x,
        full_w,
        full_h,
    )
    Targets2 { first: hdr_d, second: sun_share }
}

/// Identical pixel-rate deferred direct pass with `(place, sun)` diagnostic outputs for `drawn_only`
/// so the judges and hole audit verify the exact same renderer that draws the game.
@fragment
@budget(work: 50000)
pub(package) fn deferred_direct_judge_fs<S: Sky>(
    pixel: FragCoord,
    v: View,
    sv: ShadowView,
    rad_grid: RadGrid,
    sdf_grid: SdfGrid,
    sky: S,
    g_normal: Texture<Rgba8>,
    g_albedo: Texture<Rgba8>,
    g_emits: Texture<Rgba16Float>,
    depth: DepthTexture,
    sky_spec0: Texture<Rgba16Float>,
    sky_s: Sampler,
    shadow_map: DepthTexture,
    static_shadow_map: DepthTexture,
    has_static_shadow: u32,
    cmp: ComparisonSampler,
    rad0: Texture3d<Rgba16Float>,
    rad1: Texture3d<Rgba16Float>,
    rad_s: Sampler,
    sdf0: Texture3d<R16Float>,
    sdf1: Texture3d<R16Float>,
    sdf_s: Sampler,
    emitters: [Emitter],
    tile_masks: [u32],
    tiles_x: u32,
    full_w: u32,
    full_h: u32,
) -> Targets4<vec4, vec4, f32, f32> {
    let px = min(u32(pixel.position.x), full_w - 1)
    let py = min(u32(pixel.position.y), full_h - 1)
    let (hdr_d, place, vis, sun_share) = shade_direct_pixel(
        px,
        py,
        pixel.position.xy,
        v,
        sv,
        rad_grid,
        sdf_grid,
        sky,
        g_normal,
        g_albedo,
        g_emits,
        depth,
        sky_spec0,
        sky_s,
        shadow_map,
        static_shadow_map,
        has_static_shadow,
        cmp,
        rad0,
        rad1,
        rad_s,
        sdf0,
        sdf1,
        sdf_s,
        emitters,
        tile_masks,
        tiles_x,
        full_w,
        full_h,
    )
    Targets4 { first: hdr_d, second: place, third: vis, fourth: sun_share }
}

/// Half-resolution (`W/2 × H/2`) indirect lighting pass: computes 4-cone hemisphere diffuse GI +
/// multi-scale 3D SDF bent-normal AO (`first = vec4(bounce + bent_sky_shift, ao)`), Screen-Space
/// Specular Reflections (SSR) seamlessly falling back to SDF-accelerated `spec_cone` + `sky_specular`
/// PMREM (`second.rgb`), and screen-space micro-contact shadow visibility (`second.w`).
@fragment
@budget(work: 12000)
pub(package) fn indirect_half_fs<S: Sky>(
    pixel: FragCoord,
    v: View,
    rad_grid: RadGrid,
    sdf_grid: SdfGrid,
    sky: S,
    hdr_direct: Texture<Rgba16Float>,
    g_normal: Texture<Rgba8>,
    g_albedo: Texture<Rgba8>,
    g_emits: Texture<Rgba16Float>,
    depth: DepthTexture,
    bg_s: Sampler,
    sky_diff: Texture<Rgba16Float>,
    sky_spec0: Texture<Rgba16Float>,
    sky_spec1: Texture<Rgba16Float>,
    sky_spec2: Texture<Rgba16Float>,
    sky_s: Sampler,
    rad0: Texture3d<Rgba16Float>,
    rad1: Texture3d<Rgba16Float>,
    rad2: Texture3d<Rgba16Float>,
    rad_s: Sampler,
    sdf0: Texture3d<R16Float>,
    sdf1: Texture3d<R16Float>,
    sdf_s: Sampler,
    full_w: u32,
    full_h: u32,
    phase_x: u32,
    phase_y: u32,
) -> Targets2<vec4, vec4> {
    let fx = min(u32(pixel.position.x) * 2 + phase_x, full_w - 1)
    let fy = min(u32(pixel.position.y) * 2 + phase_y, full_h - 1)
    let gn = g_normal.load(fx, fy)
    if gn.w <= 0.5 {
        return Targets2 {
            first: vec4(0.0, 0.0, 0.0, 1.0),
            second: vec4(0.0, 0.0, 0.0, 1.0),
        }
    }
    let ndc_z = depth.load(fx, fy)
    if ndc_z <= 1.0e-6 {
        return Targets2 {
            first: vec4(0.0, 0.0, 0.0, 1.0),
            second: vec4(0.0, 0.0, 0.0, 1.0),
        }
    }
    let ray = v.ray(vec2(f32(fx) + 0.5, f32(fy) + 0.5))
    let n = decode_gbuf_normal(gn, -ray)
    let dist = reconstruct_pixel_dist(v, ray, ndc_z)
    let wp = v.at + ray * dist
    let roughness = clamp(g_albedo.load(fx, fy).w, 0.02, 1.0)
    let mat_code = g_emits.load(fx, fy).w

    let ind0 = cone_indirect(rad_grid, rad0, rad1, rad2, rad_s, wp, n)
    var ind = ind0
    if sdf_grid.enabled != 0 {
        let bao = sdf_bent_ao(sdf_grid, sdf0, sdf1, sdf_s, wp, n)
        let ao = clamp(min(ind0.w, bao.w), 0.08, 1.0)
        // Bent-normal sky tint shift steers crevice ambient toward the unoccluded sky opening
        // while keeping full-res normal detail in `combine_indirect_fs`.
        let sky_bent = sky_irradiance(sky_diff, sky_s, bao.xyz)
        let sky_n = sky_irradiance(sky_diff, sky_s, n)
        let bent_shift = (sky_bent - sky_n) * (ao * 0.75)
        ind = vec4(max(ind0.xyz + bent_shift, vec3(0.0)), ao)
    }
    let cshad = if rad_grid.enabled != 0 { contact_shadow(v, depth, wp, n, sky.sun().way) } else {
        1.0
    }

    // Skip specular SSR & voxel/SDF reflection cone completely on pure matte surfaces (`abs(mat_code) < 0.01`).
    var env_spec = vec3(0.0)
    if abs(mat_code) >= 0.01 {
        let ray_back = -ray
        let refl = normalize(n * (2.0 * dot(n, ray_back)) - ray_back)
        let eff_r = if mat_code > 0.15 && mat_code < 1.8 { min(roughness, 0.12) } else { roughness }
        let sky_refl = sky_specular(sky_spec0, sky_spec1, sky_spec2, sky_diff, sky_s, refl, eff_r)
        let w_refl = spec_cone(
            rad_grid,
            rad0,
            rad1,
            rad2,
            rad_s,
            sdf_grid,
            sdf0,
            sdf1,
            sdf_s,
            wp,
            n,
            refl,
            eff_r,
        )
        let spec_occ = clamp(ind.w + (1.0 - eff_r) * 0.25, 0.15, 1.0)
        let fallback = w_refl.xyz + sky_refl * (1.0 - w_refl.w * 0.85) * spec_occ
        let ssr = trace_ssr(v, hdr_direct, bg_s, wp, n, refl, eff_r)
        env_spec = mix(fallback, ssr.xyz, vec3(ssr.w))
    }

    Targets2 {
        first: ind,
        second: vec4(env_spec, cshad),
    }
}

/// Full-resolution depth+normal bilateral upsample of phase-cycled half-res GI, bent-normal AO,
/// SSR, and micro-contact shadows combined with the pixel-rate direct HDR buffer into `hdr_colour`.
/// The contact shadow darkens only the sun's share of the direct light (`sun_share`).
@fragment
pub(package) fn combine_indirect_fs<S: Sky>(
    pixel: FragCoord,
    v: View,
    sky: S,
    hdr_direct: Texture<Rgba16Float>,
    sun_share: Texture<R16Float>,
    g_normal: Texture<Rgba8>,
    g_albedo: Texture<Rgba8>,
    g_emits: Texture<Rgba16Float>,
    gi_diff: Texture<Rgba16Float>,
    gi_spec: Texture<Rgba16Float>,
    sky_diff: Texture<Rgba16Float>,
    sky_s: Sampler,
    full_w: u32,
    full_h: u32,
    phase_x: u32,
    phase_y: u32,
) -> vec4 {
    let px = min(u32(pixel.position.x), full_w - 1)
    let py = min(u32(pixel.position.y), full_h - 1)
    let direct_d = hdr_direct.load(px, py)
    let gn = g_normal.load(px, py)
    if gn.w <= 0.5 {
        return direct_d
    }
    let ga = g_albedo.load(px, py)
    let ge = g_emits.load(px, py)
    let ray = v.ray(pixel.position.xy)
    let n = decode_gbuf_normal(gn, -ray)
    let dist = direct_d.w
    let albedo = clamp(ga.xyz, vec3(0.0), vec3(1.0))
    let roughness = clamp(ga.w, 0.02, 1.0)
    let mat_code = ge.w

    // 4-tap depth + normal weighted bilateral upsample from phase-cycled half-res GI/SSR buffers.
    // Half-res texel `h` was shaded at full-res `2 h + phase`, so the two texels bracketing `px` are
    // `floor((px - phase) / 2)` and the next, weighted bilinearly by where `px` falls between them.
    let hw = max(full_w / 2, 1)
    let hh = max(full_h / 2, 1)
    let hx0 = u32(clamp((i32(px) - i32(phase_x) + 2) / 2 - 1, 0, i32(hw) - 1))
    let hy0 = u32(clamp((i32(py) - i32(phase_y) + 2) / 2 - 1, 0, i32(hh) - 1))
    let hx1 = min(hx0 + 1, hw - 1)
    let hy1 = min(hy0 + 1, hh - 1)
    let tx = clamp((f32(px) - f32(hx0 * 2 + phase_x)) * 0.5, 0.0, 1.0)
    let ty = clamp((f32(py) - f32(hy0 * 2 + phase_y)) * 0.5, 0.0, 1.0)

    let xs = [hx0, hx1, hx0, hx1]
    let ys = [hy0, hy0, hy1, hy1]
    let bw = [(1.0 - tx) * (1.0 - ty), tx * (1.0 - ty), (1.0 - tx) * ty, tx * ty]
    var diff_acc = vec4(0.0)
    var spec_acc = vec4(0.0)
    var w_sum = 0.0
    for k in 0..4 {
        let sx = xs[k]
        let sy = ys[k]
        let fx = min(sx * 2 + phase_x, full_w - 1)
        let fy = min(sy * 2 + phase_y, full_h - 1)
        let sn = g_normal.load(fx, fy)
        let sd = hdr_direct.load(fx, fy).w
        if sn.w > 0.5 {
            let sn_v = decode_gbuf_normal(sn, n)
            let ndot = max(dot(n, sn_v), 0.0)
            let dz = abs(dist - sd) / max(dist * 0.08, 0.15)
            let w = (bw[k] + 0.02) * (ndot * ndot * ndot * ndot + 0.001) * exp(-dz * dz)
            diff_acc += gi_diff.load(sx, sy) * w
            spec_acc += gi_spec.load(sx, sy) * w
            w_sum += w
        }
    }
    let ind = if w_sum > 1.0e-4 { diff_acc / w_sum } else { gi_diff.load(hx0, hy0) }
    let spec_c = if w_sum > 1.0e-4 { spec_acc / w_sum } else { gi_spec.load(hx0, hy0) }

    let cshad = if dot(n, sky.sun().way) > 0.05 { spec_c.w } else { 1.0 }
    var rad = direct_d.xyz * (1.0 - sun_share.load(px, py) * (1.0 - cshad))

    let sky_amb = sky_irradiance(sky_diff, sky_s, n) * multi_bounce_ao(ind.w, albedo) + ind.xyz
    if abs(mat_code) < 0.01 {
        rad += albedo * ONE_OVER_PI * sky_amb
    } else {
        let ray_back = -ray
        let ndv = max(dot(n, ray_back), 0.001)
        let metallic = if mat_code < -0.01 { clamp(-mat_code, 0.0, 1.0) } else { 0.0 }
        let coat = if mat_code > 0.03 && mat_code < 1.8 { clamp(mat_code - 0.02, 0.0, 1.0) } else {
            0.0
        }
        let f0 = mix(vec3(0.04), albedo, metallic)
        let f_env = fresnel_schlick_rough(f0, ndv, roughness)
        let kd = (vec3(1.0) - f_env) * (1.0 - metallic)
        let brdf_ab = env_brdf_approx(roughness, ndv)
        var indirect = albedo * (kd * ONE_OVER_PI) * sky_amb +
            spec_c.xyz * (f0 * brdf_ab.x + vec3(brdf_ab.y))
        if coat > 1.0e-4 {
            let fc = fresnel_schlick_rough(vec3(0.04), ndv, 0.06).x * coat
            indirect = indirect * (1.0 - fc) + spec_c.xyz * fc
        }
        rad += indirect
    }
    vec4(rad, dist)
}

/// Shared half-resolution transmissive SSR + SDF `spec_cone` + Sky PMREM reflection core.
@budget(work: 16000)
fn shade_refract_refl_core(
    pixel: FragCoord,
    wp: vec3,
    mp: vec3,
    normal: vec3,
    smooth: f32,
    sub0: Substance,
    v: View,
    rad_grid: RadGrid,
    sdf_grid: SdfGrid,
    sky_diff: Texture<Rgba16Float>,
    sky_spec0: Texture<Rgba16Float>,
    sky_spec1: Texture<Rgba16Float>,
    sky_spec2: Texture<Rgba16Float>,
    sky_s: Sampler,
    rad0: Texture3d<Rgba16Float>,
    rad1: Texture3d<Rgba16Float>,
    rad2: Texture3d<Rgba16Float>,
    rad_s: Sampler,
    sdf0: Texture3d<R16Float>,
    sdf1: Texture3d<R16Float>,
    sdf_s: Sampler,
    hdr_bg: Texture<Rgba16Float>,
    bg_s: Sampler,
    half_size: vec2,
) -> vec4 {
    match prove_opaque_only(sub0) {
        Some(p) => discard_proven(p),
        None => {},
    }
    let to_eye = v.at - wp
    let dist = length(to_eye)
    let uv = pixel.position.xy / max(half_size, vec2(1.0))
    let bg_d = hdr_bg.sample_level(bg_s, uv, 0.0).w
    match prove_point_behind_opaque(dist, bg_d, 0.25) {
        Some(p) => discard_proven(p),
        None => {},
    }
    let ray_back = if dist > 1.0e-6 { to_eye / dist } else { -v.forward }
    let n0 = resolve_normal_from(wp, normal, smooth, ray_back)
    let (n, sub) = apply_micro_relief(wp, mp, n0, sub0, dist)
    let ndv = max(dot(n, ray_back), 0.001)
    let refl = normalize(n * (2.0 * ndv) - ray_back)

    let sky_refl = sky_specular(
        sky_spec0,
        sky_spec1,
        sky_spec2,
        sky_diff,
        sky_s,
        refl,
        sub.roughness,
    )
    let w_refl = spec_cone(
        rad_grid,
        rad0,
        rad1,
        rad2,
        rad_s,
        sdf_grid,
        sdf0,
        sdf1,
        sdf_s,
        wp,
        n,
        refl,
        sub.roughness,
    )
    let fallback = w_refl.xyz + sky_refl * (1.0 - w_refl.w * 0.85)
    let ssr = trace_ssr(v, hdr_bg, bg_s, wp, n, refl, sub.roughness)
    let env_spec = mix(fallback, ssr.xyz, vec3(ssr.w))
    vec4(env_spec, 1.0)
}

/// Half-res transmissive reflection pre-pass for `One<M>` compact meshlets.
@fragment
@budget(work: 20000)
pub(package) fn field_refract_refl_one_fs<M: Field<Substance>>(
    pixel: FragCoord,
    vary: FieldVary,
    field: M,
    v: View,
    rad_grid: RadGrid,
    sdf_grid: SdfGrid,
    sky_diff: Texture<Rgba16Float>,
    sky_spec0: Texture<Rgba16Float>,
    sky_spec1: Texture<Rgba16Float>,
    sky_spec2: Texture<Rgba16Float>,
    sky_s: Sampler,
    rad0: Texture3d<Rgba16Float>,
    rad1: Texture3d<Rgba16Float>,
    rad2: Texture3d<Rgba16Float>,
    rad_s: Sampler,
    sdf0: Texture3d<R16Float>,
    sdf1: Texture3d<R16Float>,
    sdf_s: Sampler,
    hdr_bg: Texture<Rgba16Float>,
    bg_s: Sampler,
    half_size: vec2,
) -> vec4 {
    let sub0 = field.channels(vary.wp)
    shade_refract_refl_core(
        pixel,
        vary.wp,
        vary.local_p,
        vary.normal,
        vary.meta.x,
        sub0,
        v,
        rad_grid,
        sdf_grid,
        sky_diff,
        sky_spec0,
        sky_spec1,
        sky_spec2,
        sky_s,
        rad0,
        rad1,
        rad2,
        rad_s,
        sdf0,
        sdf1,
        sdf_s,
        hdr_bg,
        bg_s,
        half_size,
    )
}

/// Half-res transmissive reflection pre-pass for `Pool<M>` compact meshlets.
@fragment
@budget(work: 20000)
pub(package) fn field_refract_refl_many_fs<M: Field<Substance>>(
