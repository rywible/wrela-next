pub(package) const FOCUS_RAD: f32 = 9.5

/// Default maximum active surface bricks per batch.
pub(package) const BATCH_BRICKS: u32 = 65536

/// Distance (m) beyond which a large `Pool` (16 things or more) puts a thing in one of its two far
/// batches rather than its near one.
pub(package) const FAR_TIER_DIST: f32 = 9.0

/// Lean vertex-to-fragment interpolator payload for 16-byte compact visibility meshlets (smaller
/// than `MeshVary`): carries ONLY geometry + motion + the extraction-space point `local_p` (which
/// moves with the thing, so per-pixel micro relief stays locked to it) + `(smooth, thing_id)` while
/// `field.channels(wp)` evaluates at infinite resolution at 1× pixel rate.
struct FieldVary: Copy {
    clip: ClipPosition,
    wp: vec3,
    prev_wp: vec3,
    local_p: vec3,
    normal: vec3,
    meta: vec2,
}

/// Interpolator payload for GPU Dual Quaternion Skinned meshlets: adds rest-pose local `rest_p`
/// so procedural materials (`rest_channels(rest_p)`) remain locked to the moving skin.
struct SkinVary: Copy {
    clip: ClipPosition,
    wp: vec3,
    prev_wp: vec3,
    rest_p: vec3,
    normal: vec3,
    meta: vec2,
}

/// Vertex shader for the unified shadow depth pass: projects 16-byte `MeshVertex` through its
/// instance's rigid transform `xforms[ii.index]` into orthographic sun space (5× less fetch BW).
@vertex
pub(package) fn shadow_vs(
    verts: [MeshVertex],
    xforms: [Rigid],
    sv: ShadowView,
    vi: VertexIndex,
    ii: InstanceIndex,
) -> ClipPosition {
    let vert = verts[vi.index]
    let wp = xforms[ii.index].apply_point(vec3(vert.px, vert.py, vert.pz))
    ClipPosition { position: vec4(sv.project(wp), 1.0) }
}

/// Shadow depth vertex shader for `Skinned` meshlets: evaluates 4-bone Dual Quaternion Skinning
/// (Kavan et al. 2007/2008) on rest-pose vertices before applying the instance rigid transform.
@vertex
pub(package) fn skin_shadow_vs(
    verts: [MeshVertex],
    skin: [u32],
    xforms: [Rigid],
    bones: [DualQuat],
    bone_stride: u32,
    sv: ShadowView,
    vi: VertexIndex,
    ii: InstanceIndex,
) -> ClipPosition {
    let vert = verts[vi.index]
    let dq = eval_dqs(bones, ii.index * bone_stride, skin[vi.index * 2], skin[vi.index * 2 + 1])
    let sp = dq.apply_point(vec3(vert.px, vert.py, vert.pz))
    let wp = xforms[ii.index].apply_point(sp)
    ClipPosition { position: vec4(sv.project(wp), 1.0) }
}

/// Depth-only fragment shader for the shadow pass (colour output is ignored by `DepthOnlyPass`).
@fragment
pub(package) fn shadow_fs() -> vec4 {
    vec4(0.0)
}

/// Vertex shader for 16-byte compact meshlets: transforms `MeshVertex` by `xforms[ii.index]` and
/// `prev_xforms[ii.index]` for exact analytical motion vectors and unpacks octahedral normal +
/// thing index for pixel-rate analytical `channels(wp)` shading.
@vertex
pub(package) fn mesh_vs(
    verts: [MeshVertex],
    xforms: [Rigid],
    prev_xforms: [Rigid],
    inst_ids: [u32],
    is_instanced: u32,
    v: View,
    vi: VertexIndex,
    ii: InstanceIndex,
) -> FieldVary {
    let vert = verts[vi.index]
    let xf = xforms[ii.index]
    let pxf = prev_xforms[ii.index]
    let lp = vec3(vert.px, vert.py, vert.pz)
    let wp = xf.apply_point(lp)
    let prev_wp = pxf.apply_point(lp)
    let n = xf.apply_normal(unpack_oct_normal(vert.packed))
    let smooth = if unpack_smooth(vert.packed) { 1.0 } else { 0.0 }
    let tid = if is_instanced != 0 { inst_ids[ii.index] } else { unpack_thing(vert.packed) }
    FieldVary {
        clip: clip_of(v, wp),
        wp,
        prev_wp,
        local_p: lp,
        normal: n,
        meta: vec2(smooth, f32(tid) + 0.5),
    }
}

/// Vertex shader for exact pre-deformed `One<Skinned>` meshlets (`deform_skinned_verts`): reads
/// exact posed local vertex + analytical normal from `verts`, previous-frame posed vertex from
/// `prev_verts` for exact TSR motion vectors, and rest-pose `rest_verts` for skin-locked materials
/// (zero DQS math in the vertex shader).
@vertex
pub(package) fn deformed_mesh_vs(
    verts: [MeshVertex],
    prev_verts: [MeshVertex],
    rest_verts: [MeshVertex],
    xforms: [Rigid],
    prev_xforms: [Rigid],
    v: View,
    vi: VertexIndex,
    ii: InstanceIndex,
) -> SkinVary {
    let vert = verts[vi.index]
    let pvert = prev_verts[vi.index]
    let rvert = rest_verts[vi.index]
    let xf = xforms[ii.index]
    let pxf = prev_xforms[ii.index]
    let wp = xf.apply_point(vec3(vert.px, vert.py, vert.pz))
    let prev_wp = pxf.apply_point(vec3(pvert.px, pvert.py, pvert.pz))
    let n = xf.apply_normal(unpack_oct_normal(vert.packed))
    let smooth = if unpack_smooth(vert.packed) { 1.0 } else { 0.0 }
    let tid = unpack_thing(vert.packed)
    SkinVary {
        clip: clip_of(v, wp),
        wp,
        prev_wp,
        rest_p: vec3(rvert.px, rvert.py, rvert.pz),
        normal: n,
        meta: vec2(smooth, f32(tid) + 0.5),
    }
}

/// Eye/refract vertex shader for `Skinned` meshlets drawn from a `Pool` (instanced, or one mesh
/// of many things): 4-bone Dual Quaternion Skinning of the rest-pose vertex, then the same guarded
/// Newton projection onto the thing's own posed field (`project_posed` on
/// `fields[thing].posed_local_distance`) that `deform_skinned_verts` gives a `One`: DQS alone
/// pinches and lags at joints, so a crowd drawn by it alone is not its fields (the SCENE 6 audit's
/// crowd: 465 holes and 14,036 pixels off at one eye, 320x180). The previous frame's point is the
/// projected one moved by the DQS delta between frames (for TSR motion vectors).
@vertex
pub(package) fn skin_mesh_vs<M: Field<Substance>>(
    fields: [M],
    n_fields: u32,
    verts: [MeshVertex],
    skin: [u32],
    xforms: [Rigid],
    prev_xforms: [Rigid],
    bones: [DualQuat],
    prev_bones: [DualQuat],
    bone_stride: u32,
    inst_ids: [u32],
    is_instanced: u32,
    v: View,
    vi: VertexIndex,
    ii: InstanceIndex,
) -> SkinVary {
    let vert = verts[vi.index]
    let pb = skin[vi.index * 2]
    let pw = skin[vi.index * 2 + 1]
    let base = ii.index * bone_stride
    let dq = eval_dqs(bones, base, pb, pw)
    let pdq = eval_dqs(prev_bones, base, pb, pw)
    let xf = xforms[ii.index]
    let pxf = prev_xforms[ii.index]
    let lp = vec3(vert.px, vert.py, vert.pz)
    let tid = if is_instanced != 0 { inst_ids[ii.index] } else { unpack_thing(vert.packed) }
    let f = fields[min(tid, n_fields - 1)]
    let skinned = dq.apply_point(lp)
    let skinned_n = dq.apply_normal(unpack_oct_normal(vert.packed))
    // Every vertex, of every part of its body: within a smooth union's blend width of another
    // part the posed field isn't one part's rigid motion (projecting only vertices whose weights
    // blend bones left the SCENE 6 crowd 3 cracks, 3 to 4 pixels deep), and a pose brings parts
    // together that a vertex's rest-pose brick doesn't hold (asking only those parts: 19 cracks).
    let (posed, posed_n) = project_posed(|q: vec3| f.posed_local_distance(q), skinned, skinned_n)
    let wp = xf.apply_point(posed)
    let prev_wp = pxf.apply_point(posed + (pdq.apply_point(lp) - skinned))
    let n = xf.apply_normal(posed_n)
    let smooth = if unpack_smooth(vert.packed) { 1.0 } else { 0.0 }
    SkinVary {
        clip: clip_of(v, wp),
        wp,
        prev_wp,
        rest_p: lp,
        normal: n,
        meta: vec2(smooth, f32(tid) + 0.5),
    }
}

/// Reconstructs the interpolated physical `Substance` from `MeshVary`.
fn vary_substance(vary: MeshVary) -> Substance {
    Substance {
        albedo: clamp(vary.albedo, vec3(0.0), vec3(1.0)),
        roughness: clamp(vary.pbr.x, 0.02, 1.0),
        emits: max(vary.emits, vec3(0.0)),
        metallic: clamp(vary.pbr.y, 0.0, 1.0),
        ior: max(vary.pbr.z, 1.0),
        transmission: clamp(vary.optics.x, 0.0, 1.0),
        subsurface: clamp(vary.optics.y, 0.0, 1.0),
        coat: clamp(vary.optics.z, 0.0, 1.0),
        micro: clamp(vary.optics.w, 0.0, 1.0),
        pad0: 0.0,
        pad1: 0.0,
        pad2: 0.0,
    }
}

/// Fast 3D hash-free trigonometric micro-relief field & analytic gradient (zero textures, zero UV
/// seams): perturbs surface normal, roughness, and subtle grain contrast ONLY when `sub.micro > 0.01`.
fn micro_field_grad(p: vec3) -> vec4 {
    // 3 rotated 3D wave octaves (cheap GPU SFU sin/cos, zero lattice artifacts) at fixed world
    // frequencies: the relief's scale is the engine's, its strength the substance's `micro`.
    let p1 = p * 5.2
    let p2 = vec3(p.x * 13.7 + p.z * 7.1, p.y * 15.3 - p.x * 6.4, p.z * 14.1 + p.y * 8.2)
    let p3 = vec3(p.x * 31.0 - p.y * 19.0, p.y * 29.0 + p.z * 17.0, p.z * 33.0 + p.x * 15.0)
    let v1 = sin(p1.x) * cos(p1.y) * sin(p1.z)
    let g1 = vec3(
        cos(p1.x) * cos(p1.y) * sin(p1.z) * 5.2,
        -sin(p1.x) * sin(p1.y) * sin(p1.z) * 5.2,
        sin(p1.x) * cos(p1.y) * cos(p1.z) * 5.2,
    )
    let v2 = sin(p2.x) * sin(p2.y) * cos(p2.z) * 0.45
    let g2 = vec3(
        (cos(p2.x) * sin(p2.y) * cos(p2.z) * 13.7 - sin(p2.x) * cos(p2.y) * cos(p2.z) * 6.4) * 0.45,
        (sin(p2.x) * cos(p2.y) * cos(p2.z) * 15.3 - sin(p2.x) * sin(p2.y) * sin(p2.z) * 8.2) * 0.45,
        (cos(p2.x) * sin(p2.y) * cos(p2.z) * 7.1 - sin(p2.x) * sin(p2.y) * sin(p2.z) * 14.1) * 0.45,
    )
    let v3 = sin(p3.x) * cos(p3.y) * sin(p3.z) * 0.18
    let g3 = vec3(
        (cos(p3.x) * cos(p3.y) * sin(p3.z) * 31.0 + sin(p3.x) * cos(p3.y) * cos(p3.z) * 15.0) *
            0.18,
        (-cos(p3.x) * cos(p3.y) * sin(p3.z) * 19.0 - sin(p3.x) * sin(p3.y) * sin(p3.z) * 29.0) *
            0.18,
        (-sin(p3.x) * sin(p3.y) * sin(p3.z) * 17.0 + sin(p3.x) * cos(p3.y) * cos(p3.z) * 33.0) *
            0.18,
    )
    vec4(g1 + g2 + g3, v1 + v2 + v3)
}

/// Applies per-pixel 3D field-space microsurface relief (normal bump + roughness/albedo micro-grain)
/// with automatic distance attenuation so distant surfaces never alias. The relief is evaluated at
/// the material point `mp` (the thing's extraction-space or rest-pose point, which moves with it, so
/// the grain never swims over a moving or skinned surface); its analytic gradient is carried to the
/// world surface at `wp` through the pixel's screen derivatives of both points (Mikkelsen 2010
/// surface-gradient bump mapping), exact for any rigid or skinned map from `mp` to `wp`.
fn apply_micro_relief(wp: vec3, mp: vec3, n: vec3, sub: Substance, dist: f32) -> (vec3, Substance) {
    // Derivatives first, while every pixel of the quad still runs this code.
    let dwx = dpdx(wp)
    let dwy = dpdy(wp)
    let dmx = dpdx(mp)
    let dmy = dpdy(mp)
    if sub.micro <= 0.01 {
        return (n, sub)
    }
    let fade = clamp(1.0 - (dist - 4.0) / 28.0, 0.0, 1.0)
    if fade <= 0.01 {
        return (n, sub)
    }
    let mg = micro_field_grad(mp)
    let amp = sub.micro * fade
    // World tangent-plane gradient of the relief height `h(mp(wp))`: the analytic gradient's change
    // along each screen axis (`dot(g, dm)`) spread over the world tangent frame (`r1`, `r2`), so the
    // normal tilts physically without flipping. A clearcoat film (`coat > 0.2`) fills the
    // micro-pores beneath it, so its normal tilts about half as far and its reflections stay crisp.
    let r1 = cross(dwy, n)
    let r2 = cross(n, dwx)
    let det = dot(dwx, r1)
    let g_tan = if abs(det) > 1.0e-20 {
        (r1 * dot(mg.xyz, dmx) + r2 * dot(mg.xyz, dmy)) * (1.0 / det)
    } else {
        mg.xyz - n * dot(mg.xyz, n)
    }
    let bump_s = if sub.coat > 0.2 { 0.024 } else { 0.045 }
    let n_bumped = normalize(n - g_tan * (amp * bump_s))
    let grain = clamp(mg.w, -1.0, 1.0)
    let albedo_mod = clamp(sub.albedo * (1.0 + grain * amp * 0.14), vec3(0.01), vec3(1.0))
    let rough_mod = clamp(sub.roughness + grain * amp * 0.12, 0.03, 1.0)
    // A coat's thickness follows the micro-grain, so any coated substance's (`coat > 0.1`)
    // clearcoat varies across its surface with the same relief.
    let coat_mod = if sub.coat > 0.1 { clamp(sub.coat + grain * amp * 0.25, 0.0, 1.0) } else {
        sub.coat
    }
    (n_bumped, Substance {
        albedo: albedo_mod,
        roughness: rough_mod,
        coat: coat_mod,
        ..sub,
    })
}

/// Resolves crease-preserving shading normal from interpolated analytic normal and face derivatives.
fn resolve_normal_from(wp: vec3, normal: vec3, smooth: f32, ray_back: vec3) -> vec3 {
    let nv_l2 = dot(normal, normal)
    let nv = if nv_l2 > 1.0e-12 { normal * (1.0 / sqrt(nv_l2)) } else { ray_back }
    let fraw = cross(dpdx(wp), dpdy(wp))
    let fl2 = dot(fraw, fraw)
    var nf = nv
    if fl2 > 1.0e-18 {
        nf = fraw * (1.0 / sqrt(fl2))
        if dot(nf, ray_back) < 0.0 {
            nf = -nf
        }
    }
    if smooth < 0.5 || dot(nv, nf) < 0.85 { nf } else { nv }
}

/// Exact screen-space motion `prev_uv - curr_uv` of a surface point now at `wp` and last frame at
/// `prev_wp`, both projected without jitter (what `tsr` reprojects by).
fn motion_of(wp: vec3, prev_wp: vec3, v: View, prev_v: View) -> vec2 {
    project_uv_unjittered(prev_v, prev_wp) - project_uv_unjittered(v, wp)
}

/// Shared 1× G-buffer + analytical motion-vector writer used by compact meshlets and heightfields.
fn shade_gbuf_core(
    wp: vec3,
    prev_wp: vec3,
    mp: vec3,
    normal: vec3,
    smooth: f32,
    sub0: Substance,
    v: View,
    prev_v: View,
) -> Targets4<vec4, vec4, vec4, vec2> {
    let to_eye = v.at - wp
    let dist = length(to_eye)
    let ray_back = if dist > 1.0e-6 { to_eye / dist } else { -v.forward }
    let n0 = resolve_normal_from(wp, normal, smooth, ray_back)
    let (n, sub) = apply_micro_relief(wp, mp, n0, sub0, dist)
    let motion = motion_of(wp, prev_wp, v, prev_v)
    Targets4 {
        first: vec4(n * 0.5 + vec3(0.5), 1.0),
        second: vec4(clamp(sub.albedo, vec3(0.0), vec3(1.0)), clamp(sub.roughness, 0.02, 1.0)),
        third: vec4(max(sub.emits, vec3(0.0)), encode_mat_signed(sub)),
        fourth: motion,
    }
}

/// Pixel-rate analytical G-buffer fragment shader for `One<M>` compact meshlets: evaluates
/// `field.channels(wp)` once per visible 1× screen pixel for infinite-resolution procedural detail.
@fragment
@budget(work: 8000)
pub(package) fn field_gbuf_one_fs<M: Field<Substance>>(
    vary: FieldVary,
    field: M,
    v: View,
    prev_v: View,
) -> Targets4<vec4, vec4, vec4, vec2> {
    let sub0 = field.channels(vary.wp)
    shade_gbuf_core(vary.wp, vary.prev_wp, vary.local_p, vary.normal, vary.meta.x, sub0, v, prev_v)
}

/// Pixel-rate analytical G-buffer fragment shader for `Pool<M>` compact meshlets.
@fragment
@budget(work: 8000)
pub(package) fn field_gbuf_many_fs<M: Field<Substance>>(
    vary: FieldVary,
    fields: [M],
    n_fields: u32,
    v: View,
    prev_v: View,
) -> Targets4<vec4, vec4, vec4, vec2> {
    let tid = min(u32(max(vary.meta.y, 0.0)), n_fields - 1)
    let sub0 = fields[tid].channels(vary.wp)
    shade_gbuf_core(vary.wp, vary.prev_wp, vary.local_p, vary.normal, vary.meta.x, sub0, v, prev_v)
}

/// Skin-locked pixel-rate G-buffer fragment shader for `Skinned` `One<M>` meshlets.
@fragment
@budget(work: 8000)
pub(package) fn field_skin_gbuf_one_fs<M: Field<Substance>>(
    vary: SkinVary,
    field: M,
    v: View,
    prev_v: View,
) -> Targets4<vec4, vec4, vec4, vec2> {
    let sub0 = field.rest_channels(vary.rest_p)
    shade_gbuf_core(vary.wp, vary.prev_wp, vary.rest_p, vary.normal, vary.meta.x, sub0, v, prev_v)
}

/// Skin-locked pixel-rate G-buffer fragment shader for `Skinned` `Pool<M>` meshlets.
@fragment
@budget(work: 8000)
pub(package) fn field_skin_gbuf_many_fs<M: Field<Substance>>(
    vary: SkinVary,
    fields: [M],
    n_fields: u32,
    v: View,
    prev_v: View,
) -> Targets4<vec4, vec4, vec4, vec2> {
    let tid = min(u32(max(vary.meta.y, 0.0)), n_fields - 1)
    let sub0 = fields[tid].rest_channels(vary.rest_p)
    shade_gbuf_core(vary.wp, vary.prev_wp, vary.rest_p, vary.normal, vary.meta.x, sub0, v, prev_v)
}

// The opaque side of a quad routed to the transmissive list. A quad with any transmissive vertex
// is drawn only by the transmissive pass, which discards its pixels whose own channels are opaque;
// these `_cut_` shaders draw the same quads (those with an opaque vertex too: `cut_indices`) into
// the G-buffer and keep exactly those pixels, so a boundary between a glass part and an opaque
// part of one field is covered by one pass or the other at every pixel (an opaque detail finer
// than a quad inside one whose every vertex is glass is the glass's). They are separate entry
// points so the plain opaque draws keep their early depth.

/// The opaque pixels of `One<M>`'s transmissive quads into the G-buffer.
@fragment
@budget(work: 8000)
pub(package) fn field_cut_gbuf_one_fs<M: Field<Substance>>(
    vary: FieldVary,
    field: M,
    v: View,
    prev_v: View,
) -> Targets4<vec4, vec4, vec4, vec2> {
    let sub0 = field.channels(vary.wp)
    match prove_transmissive_only(sub0) {
        Some(p) => discard_proven(p),
        None => {},
    }
    shade_gbuf_core(vary.wp, vary.prev_wp, vary.local_p, vary.normal, vary.meta.x, sub0, v, prev_v)
}

/// The opaque pixels of `Pool<M>`'s transmissive quads into the G-buffer.
@fragment
@budget(work: 8000)
pub(package) fn field_cut_gbuf_many_fs<M: Field<Substance>>(
    vary: FieldVary,
    fields: [M],
    n_fields: u32,
    v: View,
    prev_v: View,
) -> Targets4<vec4, vec4, vec4, vec2> {
    let tid = min(u32(max(vary.meta.y, 0.0)), n_fields - 1)
    let sub0 = fields[tid].channels(vary.wp)
    match prove_transmissive_only(sub0) {
        Some(p) => discard_proven(p),
        None => {},
    }
    shade_gbuf_core(vary.wp, vary.prev_wp, vary.local_p, vary.normal, vary.meta.x, sub0, v, prev_v)
}

/// The opaque pixels of a `Skinned` `One<M>`'s transmissive quads into the G-buffer.
@fragment
@budget(work: 8000)
pub(package) fn field_skin_cut_gbuf_one_fs<M: Field<Substance>>(
    vary: SkinVary,
