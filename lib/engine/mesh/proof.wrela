// Zero-hole proof tokens and sound exact-bracket cell ray solving.
//
// In `lib/engine/mesh/`, raw `std::gpu::discard()` is forbidden outside this module (`tools/layers`
// enforces this at build time). Every fragment discard must present an `EmptyProof` that can only
// be constructed here by a mathematically sound witness:
//   - `prove_transmissive_only` / `prove_opaque_only`: exact boolean complements of one shared
//     `is_transmissive_pixel` predicate, so no pixel on a mixed quad can fall between passes.
//   - `prove_point_behind_opaque`: a fragment's own point behind the opaque depth there.
//   - `prove_box_unseen`: a box a pixel's ray misses, or whose nearest point along it is behind the
//     opaque depth there (`RayBox`, made only by `ray_box_bracket`, so the box's far side can't be
//     passed where its near side belongs).
//   - `prove_outside_disc`: circular impostor billboard cutout outside the unit disc.
//   - `solve_cell_ray`: exact ray-AABB bracket `[t_enter, t_exit]` over a cell cube where `Empty`
//     is returned ONLY when every sub-segment of `[t0, t1]` is mathematically proved `f > 0`,
//     either by pure Lipschitz steps `t += f(p) / L` (Mean Value Theorem, never clamped up by a
//     heuristic minimum step) or by compiler-derived IEEE-754-sound 1D `std::derive::affine`.

use mesh::dc::{QUAD_FOLDED, QUAD_INSIDE, finer_than_a_hole, on_outline}
use matter::substance::{Substance, lambert}
use picture::eye::View
use std::derive::{Interval, affine_form, filtered}
use std::field::{ALL_LIVE, Field, Live, Surface, cuboid, fbm, round_cone, sphere}
use std::gpu::discard
use std::mem::size_of

const PROOF_EPS: f32 = 1.0 / 8388608.0
const PROOF_TINY: f32 = 1.2e-38

/// Transmission threshold partitioning opaque pixels (`<= TRANS_CUTOFF`) from transmissive pixels
/// (`> TRANS_CUTOFF`) across all G-buffer cut passes and transmissive passes.
pub const TRANS_CUTOFF: f32 = 0.02

/// Unforgeable zero-sized proof token witnessing that a fragment provably carries no surface for
/// the current pass. The private unit field prevents any module outside `mesh::proof` from
/// constructing one while erasing to 0 bytes across CPU, Metal, and SPIR-V (`Option<EmptyProof>`
/// lowers to a bare `bool`).
pub struct EmptyProof: Copy {
    seal: (),
}

/// Result of solving a ray against a field inside an exact cell box `[t_enter, t_exit]`.
/// `Empty` carries an `EmptyProof` that is only produced when the entire ray segment has been
/// mathematically proved strictly positive (`f > 0`).
pub enum CellRay: Copy {
    Hit(f32),
    Empty(EmptyProof),
}

/// The single shared opaque/transmissive partition predicate used by both opaque cut draws and
/// transmissive draws.
pub fn is_transmissive_pixel(sub: Substance) -> bool {
    sub.transmission > TRANS_CUTOFF
}

/// Witnesses that a pixel belongs to the transmissive pass (so the opaque cut pass may discard it).
pub fn prove_transmissive_only(sub: Substance) -> Option<EmptyProof> {
    if is_transmissive_pixel(sub) {
        Some(EmptyProof { seal: () })
    } else {
        None
    }
}

/// Witnesses that a pixel belongs to the opaque pass (so the transmissive pass may discard it).
pub fn prove_opaque_only(sub: Substance) -> Option<EmptyProof> {
    if !is_transmissive_pixel(sub) {
        Some(EmptyProof { seal: () })
    } else {
        None
    }
}

/// Witnesses that a fragment's own point, `dist` from the eye, lies more than `margin` behind the
/// opaque surface drawn there, `bg_dist` away (a half-res transmissive reflection's).
pub fn prove_point_behind_opaque(dist: f32, bg_dist: f32, margin: f32) -> Option<EmptyProof> {
    if dist > bg_dist + margin {
        Some(EmptyProof { seal: () })
    } else {
        None
    }
}

/// A pixel's ray across a box: where it enters and leaves it (`t` along the ray, the entry no
/// nearer than the eye) and how deep along the eye's forward axis its entry is. Only
/// `ray_box_bracket` makes one (`seal: ()` erases to 0 bytes).
pub struct RayBox: Copy {
    pub t_enter: f32,
    pub t_exit: f32,
    pub z_enter: f32,
    /// `dot(ray, forward)`: depth along the forward axis per unit along the ray.
    pub z_per_t: f32,
    seal: (),
}

/// The ray from `o` along `d` (unit) across the box `[lo, hi]`, for an eye looking along
/// `forward`: missed where `t_enter > t_exit`. Inflates `[lo, hi]` by exact IEEE-754 rounding
/// margin so floating-point slab intersection cannot open a 0-width seam between touching cells.
pub fn ray_box_bracket(o: vec3, d: vec3, forward: vec3, lo: vec3, hi: vec3) -> RayBox {
    let eps = max(max(abs(lo), abs(hi)) * (8.0 * PROOF_EPS), vec3(1.0e-6))
    let (te, tx) = ray_box_interval(o, d, lo - eps, hi + eps)
    let t0 = max(te, 0.0)
    let zpt = dot(d, forward)
    RayBox {
        t_enter: if tx <= 0.0 { 1.0 } else { t0 },
        t_exit: if tx <= 0.0 { 0.0 } else { tx },
        z_enter: t0 * zpt,
        z_per_t: zpt,
        seal: (),
    }
}

/// Exact analytical ray-sphere bracket for ray `(o, d)` (unit `d`) against bounding sphere
/// `(centre, radius)` inflated by IEEE-754 rounding margin: rejects ~48% of empty bounding-cube
/// corner pixels before any field evaluation (`t_enter > t_exit` on miss).
pub fn ray_sphere_bracket(o: vec3, d: vec3, forward: vec3, centre: vec3, radius: f32) -> RayBox {
    let r = radius + max(radius * (16.0 * PROOF_EPS), 1.0e-5)
    let oc = o - centre
    let b = dot(oc, d)
    let c = dot(oc, oc) - r * r
    let disc = b * b - c
    let zpt = dot(d, forward)
    if disc < 0.0 {
        return RayBox { t_enter: 1.0, t_exit: 0.0, z_enter: 1.0e30, z_per_t: zpt, seal: () }
    }
    let sd = sqrt(disc)
    let te = -b - sd
    let tx = -b + sd
    let t0 = max(te, 0.0)
    RayBox {
        t_enter: if tx <= 0.0 { 1.0 } else { t0 },
        t_exit: if tx <= 0.0 { 0.0 } else { tx },
        z_enter: t0 * zpt,
        z_per_t: zpt,
        seal: (),
    }
}

/// Witnesses that nothing in the box `b` can be seen past the opaque depth `bg_z` (along the
/// eye's forward axis) drawn at the pixel: the ray misses the box, or the box's nearest point
/// along it is already behind that depth.
pub fn prove_box_unseen(b: RayBox, bg_z: f32) -> Option<EmptyProof> {
    if b.t_enter > b.t_exit || b.z_enter > bg_z {
        Some(EmptyProof { seal: () })
    } else {
        None
    }
}

/// The part of `b` that can still be seen in front of the opaque depth `bg_z`, less `margin` (along
/// the ray): `(t0, t1)`. A surface less than `margin` in front of what is drawn there shows as it
/// within that, and isn't asked for.
pub fn seen_part(b: RayBox, bg_z: f32, margin: f32) -> (f32, f32) {
    let bg_t = if b.z_per_t > 1.0e-6 { bg_z / b.z_per_t } else { 1.0e30 }
    (b.t_enter, min(b.t_exit, bg_t - margin))
}

/// Witnesses that a particle billboard fragment lies strictly outside its disc radius.
pub fn prove_outside_disc(r2: f32, max_r2: f32) -> Option<EmptyProof> {
    if r2 > max_r2 {
        Some(EmptyProof { seal: () })
    } else {
        None
    }
}

/// Witnesses that a 64-bit Visibility Buffer pixel (`vis_header`) does not belong to `batch_id`:
/// either no opaque triangle covered this pixel (bit 31 clear: sky) or a closer triangle from
/// another batch won hardware depth testing and will be shaded by that batch's own resolve draw.
pub fn prove_vis_not_batch(vis_header: u32, batch_id: u32) -> Option<EmptyProof> {
    if (vis_header & 2147483648) == 0 || ((vis_header >> 16) & 8191) != batch_id {
        Some(EmptyProof { seal: () })
    } else {
        None
    }
}

/// The only place in `lib/engine/` permitted to invoke `std::gpu::discard()`.
pub fn discard_proven(_proof: EmptyProof) {
    discard()
}

/// Unforgeable zero-sized proof token witnessing that a `Substance` was evaluated through
/// compiler-derived Nyquist filtering (`std::derive::filtered` over the pixel's screen-space
/// tangent footprint), proven spatially constant (`has_constant_channels()`), or pre-bandlimited
/// by vertex interpolation. Erases to 0 bytes across CPU, Metal, and SPIR-V.
pub struct FilteredProof: Copy {
    seal: (),
}

/// A `Substance` paired with its zero-byte `FilteredProof` witness. All G-buffer shading entry
/// points accept `FilteredSubstance` rather than raw `Substance`, making unfiltered procedural
/// channel shading structurally unconstructable.
pub struct FilteredSubstance: Copy {
    pub sub: Substance,
    pub proof: FilteredProof,
}

/// Placeholder `FilteredSubstance` for inactive visibility-buffer quad lanes that are discarded
/// immediately after hardware quad derivatives finish.
pub fn unshaded_filtered_placeholder() -> FilteredSubstance {
    FilteredSubstance {
        sub: Substance {
            albedo: vec3(0.5),
            roughness: 0.5,
            emits: vec3(0.0),
            metallic: 0.0,
            ior: 1.5,
            transmission: 0.0,
            subsurface: 0.0,
            coat: 0.0,
            micro: 0.0,
            bump: 0.0,
            pad1: 0.0,
            pad2: 0.0,
        },
        proof: FilteredProof { seal: () },
    }
}

/// Witnesses a vertex-interpolated `Substance` (e.g. terrain `MeshVary`) already band-limited by
/// mesh vertex spacing rather than high-frequency per-fragment procedural evaluation.
pub fn prove_vertex_filtered(sub: Substance) -> FilteredSubstance {
    FilteredSubstance { sub, proof: FilteredProof { seal: () } }
}

/// Analytic world-space pixel tangent-plane footprint `(dwx, dwy)` at surface hit `wp` with
/// normal `n_raw`, computed directly from perspective camera `v` and pixel center `frag_xy`.
/// Zero 2×2 quad-derivative dependency (safe after `discard_proven`) and clamped to <= 6.7×
/// grazing anisotropy so silhouette edges never diverge.
pub fn pixel_tangent_footprint(v: View, frag_xy: vec2, wp: vec3, n_raw: vec3) -> (vec3, vec3) {
    let w = max(v.size.x, 1.0)
    let h = max(v.size.y, 1.0)
    let aspect = h / w
    let fx = max(v.focal * aspect, 1.0e-6)
    let fy = max(v.focal, 1.0e-6)
    let x_ndc = 2.0 * frag_xy.x / w - 1.0
    let y_ndc = 1.0 - 2.0 * frag_xy.y / h
    let jx = 2.0 * v.jitter.x / w
    let jy = 2.0 * v.jitter.y / h
    let r = v.forward + v.right * ((x_ndc + jx) / fx) + v.up * ((y_ndc - jy) / fy)
    let dr_dx = v.right * (2.0 / (w * fx))
    let dr_dy = -v.up * (2.0 / (h * fy))
    let z = max(dot(wp - v.at, v.forward), 1.0e-4)
    let nl2 = dot(n_raw, n_raw)
    let n = if nl2 > 1.0e-12 { n_raw * (1.0 / sqrt(nl2)) } else { -v.forward }
    let rn_raw = dot(r, n)
    let min_rn = 0.15 * length(r)
    let rn = if abs(rn_raw) >= min_rn {
        rn_raw
    } else if rn_raw < 0.0 {
        -min_rn
    } else {
        min_rn
    }
    let inv_rn = 1.0 / rn
    let dwx = (dr_dx - r * (dot(dr_dx, n) * inv_rn)) * z
    let dwy = (dr_dy - r * (dot(dr_dy, n) * inv_rn)) * z
    (dwx, dwy)
}

/// Clamps a screen-space derivative vector so depth discontinuities across 2×2 quads never blow
/// up the filter footprint.
pub fn clamp_footprint_vec(d: vec3, max_len: f32) -> vec3 {
    let l2 = dot(d, d)
    if l2 > max_len * max_len { d * (max_len / sqrt(l2)) } else { d }
}

/// Evaluates `field.channels` through compiler-derived anisotropic 2D Nyquist filtering over the
/// pixel's tangent-plane footprint `(dwx, dwy)`. When `field.has_constant_channels()` is statically
/// true, constant folding erases the filter completely (0 extra GPU instructions).
pub fn filter_channels<M: Field<Substance>>(
    field: M,
    wp: vec3,
    dwx: vec3,
    dwy: vec3,
) -> FilteredSubstance {
    let sub = if field.has_constant_channels() {
        field.channels(wp)
    } else {
        filtered(|uv: vec2| field.channels(wp + dwx * uv.x + dwy * uv.y), vec2(0.0), vec2(1.0))
    }
    FilteredSubstance { sub, proof: FilteredProof { seal: () } }
}

/// Evaluates `field.channels_kept` through compiler-derived anisotropic 2D Nyquist filtering over
/// the pixel's tangent-plane footprint `(dwx, dwy)`.
pub fn filter_channels_kept<M: Field<Substance>>(
    field: M,
    wp: vec3,
    part: u32,
    kept: vec4,
    dwx: vec3,
    dwy: vec3,
) -> FilteredSubstance {
    let sub = if field.has_constant_channels() {
        field.channels_kept(wp, part, kept)
    } else {
        filtered(
            |uv: vec2| field.channels_kept(wp + dwx * uv.x + dwy * uv.y, part, kept),
            vec2(0.0),
            vec2(1.0),
        )
    }
    FilteredSubstance { sub, proof: FilteredProof { seal: () } }
}

/// Lean 1-direction Nyquist filter for exact-cell silhouette shaders (where the grazing footprint
/// is dominated by one major axis, cutting shader code size in half vs. 2-direction `_f2` while
/// still evaluating through compiler-derived `std::derive::filtered` and minting `FilteredProof`).
pub fn filter_channels_1d<M: Field<Substance>>(
    field: M,
    wp: vec3,
    dwx: vec3,
    dwy: vec3,
) -> FilteredSubstance {
    let sub = if field.has_constant_channels() {
        field.channels(wp)
    } else {
        let dir = if dot(dwx, dwy) >= 0.0 { dwx + dwy } else { dwx - dwy }
        filtered(|s: f32| field.channels(wp + dir * s), at: 0.0, width: 1.0)
    }
    FilteredSubstance { sub, proof: FilteredProof { seal: () } }
}

/// Lean 1-direction Nyquist filter for `channels_kept_exact` in exact-cell silhouette shaders
/// (where `kept` was already evaluated at exact hit `wp` via `kept_at(wp)`).
pub fn filter_channels_kept_1d<M: Field<Substance>>(
    field: M,
    wp: vec3,
    part: u32,
    kept: vec4,
    dwx: vec3,
    dwy: vec3,
) -> FilteredSubstance {
    let sub = if field.has_constant_channels() {
        field.channels_kept_exact(wp, part, kept)
    } else {
        let dir = if dot(dwx, dwy) >= 0.0 { dwx + dwy } else { dwx - dwy }
        filtered(|s: f32| field.channels_kept_exact(wp + dir * s, part, kept), at: 0.0, width: 1.0)
    }
    FilteredSubstance { sub, proof: FilteredProof { seal: () } }
}

/// Evaluates `field.rest_channels` through compiler-derived anisotropic 2D Nyquist filtering over
/// the pixel's rest-pose tangent footprint `(dmx, dmy)` for skinned meshes.
pub fn filter_rest_channels<M: Field<Substance>>(
    field: M,
    rest_p: vec3,
    dmx: vec3,
    dmy: vec3,
) -> FilteredSubstance {
    let sub = if field.has_constant_channels() {
        field.rest_channels(rest_p)
    } else {
        filtered(
            |uv: vec2| field.rest_channels(rest_p + dmx * uv.x + dmy * uv.y),
            vec2(0.0),
            vec2(1.0),
        )
    }
    FilteredSubstance { sub, proof: FilteredProof { seal: () } }
}

/// Unforgeable zero-sized proof token witnessing that a `Substance`'s GGX roughness and clearcoat
/// have been variance-filtered against the surface's screen-space normal curvature (Tokuyoshi &
/// Kaplanyan 2021, *JCGT* 10(1)), making sub-pixel bevel specular fireflies structurally
/// unconstructable. Erases to 0 bytes across CPU, Metal, and SPIR-V.
pub struct SpecAAProof: Copy {
    seal: (),
}

/// A `Substance` carrying both `FilteredProof` (Nyquist material prefiltering) and `SpecAAProof`
/// (geometric specular normal-variance filtering). The sole G-buffer packer (`encode_gbuf_targets`)
/// requires `SpecAASubstance`, enforcing specular anti-aliasing at the type level.
pub struct SpecAASubstance: Copy {
    pub sub: Substance,
    pub proof: SpecAAProof,
}

/// Folds screen-space normal derivatives `(dnx, dny)` and optional micro/bump normal-tilt variance
/// `extra_var` into effective GGX perceptual roughness via Tokuyoshi & Kaplanyan (2021)'s
/// isotropic geometric specular AA filter (`sigma2 = 0.25`, `kappa = 0.18`), preserving flat
/// surfaces (`dnx = dny = 0`, `extra_var = 0`) bit-identically.
pub fn prove_specular_aa(
    sub_f: FilteredSubstance,
    dnx: vec3,
    dny: vec3,
    extra_var: f32 = 0.0,
) -> SpecAASubstance {
    let var_raw = dot(dnx, dnx) + dot(dny, dny)
    // Reject quad-derivative depth jumps across silhouettes (> 2.0 rad²/px²) while keeping all
    // real bevel/edge curvature.
    let var_n = if var_raw > 2.0 { 0.0 } else { var_raw }
    let total_var = var_n + max(extra_var, 0.0)
    if total_var <= 1.0e-7 {
        return SpecAASubstance { sub: sub_f.sub, proof: SpecAAProof { seal: () } }
    }
    let kernel_r2 = min(0.25 * total_var, 0.18)
    let r0 = clamp(sub_f.sub.roughness, 0.02, 1.0)
    let a0 = r0 * r0
    let a_eff2 = clamp(a0 * a0 + kernel_r2, 1.6e-7, 1.0)
    let r_eff = sqrt(sqrt(a_eff2))
    let coat_eff = if sub_f.sub.coat > 1.0e-4 {
        sub_f.sub.coat / (1.0 + 18.0 * kernel_r2)
    } else {
        sub_f.sub.coat
    }
    SpecAASubstance {
        sub: Substance { roughness: r_eff, coat: coat_eff, ..sub_f.sub },
        proof: SpecAAProof { seal: () },
    }
}

/// Exact slab intersection of ray `(o, d)` with axis-aligned box `[lo, hi]`.
/// Returns `(t_enter, t_exit)`. The ray misses the box iff `t_enter > t_exit || t_exit < 0.0`.
pub fn ray_box_interval(o: vec3, d: vec3, lo: vec3, hi: vec3) -> (f32, f32) {
    var t_min = -1.0e30
    var t_max = 1.0e30
    if abs(d.x) > 1.0e-12 {
        let inv = 1.0 / d.x
        let a = (lo.x - o.x) * inv
        let b = (hi.x - o.x) * inv
        t_min = max(t_min, min(a, b))
        t_max = min(t_max, max(a, b))
    } else if o.x < lo.x || o.x > hi.x {
        return (1.0, 0.0)
    }
    if abs(d.y) > 1.0e-12 {
        let inv = 1.0 / d.y
        let a = (lo.y - o.y) * inv
        let b = (hi.y - o.y) * inv
        t_min = max(t_min, min(a, b))
        t_max = min(t_max, max(a, b))
    } else if o.y < lo.y || o.y > hi.y {
        return (1.0, 0.0)
    }
    if abs(d.z) > 1.0e-12 {
        let inv = 1.0 / d.z
        let a = (lo.z - o.z) * inv
        let b = (hi.z - o.z) * inv
        t_min = max(t_min, min(a, b))
        t_max = min(t_max, max(a, b))
    } else if o.z < lo.z || o.z > hi.z {
        return (1.0, 0.0)
    }
    (t_min, t_max)
}

/// Refines a sign-bracketed root `[a, b]` (`fa > 0`, `fb <= tol`) using alternating secant and
/// bisection steps so convergence is guaranteed even on sharp creases and high-curvature ridges.
fn refine_root<F: Copy + fn(vec3) -> f32>(
    dist: F,
    o: vec3,
    d: vec3,
    t_out: f32,
    f_out: f32,
    t_in: f32,
    f_in: f32,
    tol: f32,
) -> f32 {
    if f_in >= -tol {
        return t_in
    }
    var a = t_out
    var fa = f_out
    var b = t_in
    var fb = f_in
    for k in 0..5 {
        let denom = fa - fb
        let m = if (k & 1) == 0 && denom > 1.0e-12 {
            clamp(a + (b - a) * (fa / denom), a + 0.1 * (b - a), b - 0.1 * (b - a))
        } else {
            0.5 * (a + b)
        }
        let fm = dist(o + d * m)
        if fm > 0.0 {
            a = m
            fa = fm
        } else {
            b = m
            fb = fm
        }
    }
    b
}

/// Sound 1D affine-form emptiness proof over ray segment `[t0, t1]`.
pub fn prove_ray_segment_empty<F: Copy + fn(vec3) -> f32>(
    dist: F,
    o: vec3,
    d: vec3,
    t0: f32,
    t1: f32,
) -> Option<EmptyProof> {
    if t0 >= t1 {
        return Some(EmptyProof { seal: () })
    }
    let af = affine_form(|s: f32| dist(o + d * s), Interval { lo: t0, hi: t1 })
    if af.lo() > 0.0 { Some(EmptyProof { seal: () }) } else { None }
}

/// Solves for the first surface crossing of `dist(o + t * d) == 0` inside the exact ray-cell
/// bracket `[t_enter, t_exit]` with pixel footprint `px` and sound Lipschitz bound `lip` (pass a
/// non-finite or `<= 0.0` `lip` when unbounded).
///
/// Soundness invariant: returns `CellRay::Empty(proof)` ONLY when every sub-segment of
/// `[max(t_enter, 0.0), t_exit]` is mathematically proved strictly positive (`f > 0`), either by
/// pure Lipschitz steps `t += f / lip` (Mean Value Theorem) or by compiler-derived 1D `affine_form`
/// intervals with sound affine Krawczyk/Newton bracket contraction. If a grazing ray exhausts its
/// step budget without proving emptiness, it returns a `Hit` at its closest approach rather than
/// silently opening a hole.
pub fn solve_cell_ray<F: Copy + fn(vec3) -> f32>(
    dist: F,
    o: vec3,
    d: vec3,
    t_enter: f32,
    t_exit: f32,
    px: f32,
    lip: f32,
) -> CellRay {
    if t_enter > t_exit || t_exit <= 0.0 {
        return CellRay::Empty(EmptyProof { seal: () })
    }
    let t0 = max(t_enter, 0.0)
    let t1 = t_exit
    if t0 >= t1 {
        return CellRay::Empty(EmptyProof { seal: () })
    }
    let tol = max(0.02 * px, 1.0e-6)
    let f0 = dist(o + d * t0)
    if f0 <= tol {
        return CellRay::Hit(t0)
    }

    var rem_t = t0
    var t_near = t0
    var f_near = f0

    // Fast path (>95% of silhouette pixels): pure Lipschitz sphere-tracing with NO heuristic
    // minimum step. Exiting `t1` proves `f > 0` across all of `[t0, t1]` with zero `affine_form` calls.
    if lip > 0.0 && lip < 1.0e12 {
        let inv_lip = 1.0 / max(lip, 1.0)
        var t = t0
        var f = f0
        for _ in 0..14 {
            let next_t = t + f * inv_lip
            if next_t >= t1 {
                let f_end = dist(o + d * t1)
                if f_end <= tol {
                    return CellRay::Hit(refine_root(dist, o, d, t, f, t1, f_end, tol))
                }
                return CellRay::Empty(EmptyProof { seal: () })
            }
            let prev_t = t
            let prev_f = f
            t = next_t
            f = dist(o + d * t)
            if f <= tol {
                return CellRay::Hit(refine_root(dist, o, d, prev_t, prev_f, t, f, tol))
            }
            if f < f_near {
                f_near = f
                t_near = t
            }
        }
        rem_t = t
    }

    // Sound grazing fallback: front-to-back 1D `affine_form` subdivision + affine Krawczyk/Newton
    // bracket contraction on `[rem_t, t1]`. Stack holds at most 4 active sub-intervals (48 B),
    // capped at 5 iterations so static shader work stays well below the GPU render-pass guard.
    var s_lo = [0.0; 4]
    var s_hi = [0.0; 4]
    var s_dep = [0; 4]
    s_lo[0] = rem_t
    s_hi[0] = t1
    s_dep[0] = 0
    var sp: u32 = 1
    var has_hit = false
    var best_t = t1
    var best_a = rem_t

    for _ in 0..5 {
        if sp == 0 {
            break
        }
        sp -= 1
        var a = s_lo[sp]
        let b = s_hi[sp]
        let dep = s_dep[sp]
        if has_hit && a >= best_t {
            continue
        }
        var b_eff = if has_hit { min(b, best_t) } else { b }
        if a >= b_eff {
            continue
        }
        let af = affine_form(|s: f32| dist(o + d * s), Interval { lo: a, hi: b_eff })
        if af.lo() > 0.0 {
            continue
        }
        // Sound 1D affine Krawczyk contraction: discard sub-intervals where `af.c + af.l * u - af.e > 0`
        // strictly (keeping every `u` where `f(s) <= 0` is possible).
        if af.valid() && abs(af.l) > 1.0e-6 {
            let hl = 0.5 * a
            let hh = 0.5 * b_eff
            let c_in = hl + hh
            let h_in = (hh - hl) * (1.0 + 2.0 * PROOF_EPS)
            let mag = abs(af.c) + abs(af.l) + af.e
            let margin_f = mag * (12.0 * PROOF_EPS) + 4.0 * PROOF_TINY
            let s_margin = (abs(c_in) + h_in) * (8.0 * PROOF_EPS) + 4.0 * PROOF_TINY
            if af.l < 0.0 {
                let u_lo = (af.c - af.e - margin_f) / (-af.l)
                if u_lo > 1.0 {
                    continue
                }
                if u_lo > -1.0 {
                    a = max(a, c_in + h_in * u_lo - s_margin)
                }
            } else {
                let u_hi = (-af.c + af.e + margin_f) / af.l
                if u_hi < -1.0 {
                    continue
                }
                if u_hi < 1.0 {
                    b_eff = min(b_eff, c_in + h_in * u_hi + s_margin)
                }
            }
            if a >= b_eff {
                continue
            }
        }
        let m = 0.5 * (a + b_eff)
        let fm = dist(o + d * m)
        if fm <= tol {
            // A hit exists at `m`, so the first hit MUST lie in `[a, m]`. Keep narrowing `[a, m]`
            // so we never return a back-face crossing when an earlier front crossing exists!
            best_t = m
            best_a = a
            has_hit = true
            if m - a <= 4.0 * tol || dep >= 2 || sp + 1 > 4 {
                let fa = dist(o + d * a)
                if fa <= tol {
                    return CellRay::Hit(a)
                }
                return CellRay::Hit(refine_root(dist, o, d, a, fa, m, fm, tol))
            }
            s_lo[sp] = a
            s_hi[sp] = m
            s_dep[sp] = dep + 1
            sp += 1
            continue
        }
        if fm < f_near {
            f_near = fm
            t_near = m
        }
        if b_eff - a <= tol || dep >= 2 || sp + 2 > 4 {
            if has_hit {
                let fa = dist(o + d * best_a)
                let fb = dist(o + d * best_t)
                return CellRay::Hit(refine_root(dist, o, d, best_a, fa, best_t, fb, tol))
            }
            // Sub-interval `[a, b_eff]` is frontmost, tiny (or depth-capped), and not proved empty:
            // never silently discard — return its midpoint `m` to prevent any hole.
            return CellRay::Hit(m)
        }
        // Push back half first so front half `[a, m]` is popped next (front-to-back order).
        s_lo[sp] = m
        s_hi[sp] = b_eff
        s_dep[sp] = dep + 1
        s_lo[sp + 1] = a
        s_hi[sp + 1] = m
        s_dep[sp + 1] = dep + 1
        sp += 2
    }

    if has_hit {
        let fa = dist(o + d * best_a)
        let fb = dist(o + d * best_t)
        return CellRay::Hit(refine_root(dist, o, d, best_a, fa, best_t, fb, tol))
    }
    if sp == 0 {
        CellRay::Empty(EmptyProof { seal: () })
    } else {
        CellRay::Hit(t_near)
    }
}

/// Result of solving a ray against a field inside an exact cell box `[t_enter, t_exit]` together
/// with the surface gradient at the hit (computed through the same single `distance_live` call
/// site to keep GPU shaders compact).
pub enum CellRayGrad: Copy {
    Hit(f32, vec3),
    Empty(EmptyProof),
}

/// GPU-lean, single-call-site exact-bracket cell ray solver + tetrahedron gradient for fields
/// with a build-time-verified Lipschitz bound (`verify_surface_soundness`): runs bidirectional
/// over-relaxed MVT sphere tracing (Keinert et al. 2014, Theorem 1), bracketed secant/bisection
/// refinement, and (when `want_grad` is true) 4-tap tetrahedron normal estimation through ONE
/// `field.distance_live` call site.
pub fn solve_cell_ray_lipschitz_grad<M: Field<Substance>>(
    field: M,
    live: Live,
    o: vec3,
    d: vec3,
    t_enter: f32,
    t_exit: f32,
    px: f32,
    lip: f32,
    want_grad: bool,
) -> CellRayGrad {
    if t_enter > t_exit || t_exit <= 0.0 {
        return CellRayGrad::Empty(EmptyProof { seal: () })
    }
    let t0 = max(t_enter, 0.0)
    let t1 = t_exit
    if t0 >= t1 {
        return CellRayGrad::Empty(EmptyProof { seal: () })
    }
    let tol = max(0.02 * px, 1.0e-6)
    let ne = max(0.25 * px, 1.0e-5)
    let inv_lip = if lip > 0.0 && lip < 1.0e12 { 1.0 / max(lip, 1.0) } else { 0.0 }
    var t_lo = t0
    var f_lo = 0.0
    var r_lo = 0.0
    var t_hi = t1
    var f_hi = 0.0
    var hi_clear = false
    var r_hi = 0.0
    var omega_lo = 1.0
    var omega_hi = 1.85
    var t_near = t0
    var f_near = 1.0e30
    var ref_a = t0
    var ref_fa = 0.0
    var ref_b = t0
    var ref_fb = 0.0
    var t_hit = t0
    var gv = vec3(0.0)
    // phase 0: bidirectional march (iter 0..34), phase 1: refine (sub_k 0..4), phase 2: grad (0..4).
    var phase: u32 = 0
    var march_i: u32 = 0
    var sub_k: u32 = 0
    for _step in 0..44 {
        var probe_p = o + d * t0
        var probe_t = t0
        var step_len = 0.0
        var kv = vec3(0.0)
        var cur_march: u32 = 0
        if phase == 0 {
            if march_i >= 34 {
                t_hit = max(t_near, t0)
                if !want_grad {
                    return CellRayGrad::Hit(t_hit, vec3(0.0))
                }
                phase = 2
                sub_k = 0
                continue
            }
            cur_march = march_i
            march_i += 1
            if cur_march == 0 {
                probe_t = t0
            } else if cur_march == 1 {
                probe_t = t1
            } else if (cur_march & 1) == 0 {
                if hi_clear && t_lo + r_lo + r_hi > t_hi {
                    return CellRayGrad::Empty(EmptyProof { seal: () })
                }
                if t_lo + r_lo >= t_hi {
                    if hi_clear {
                        return CellRayGrad::Empty(EmptyProof { seal: () })
                    }
                    ref_a = t_lo
                    ref_fa = f_lo
                    ref_b = t_hi
                    ref_fb = f_hi
                    if ref_fb >= -tol {
                        t_hit = max(ref_b, t0)
                        if !want_grad {
                            return CellRayGrad::Hit(t_hit, vec3(0.0))
                        }
                        phase = 2
                    } else {
                        phase = 1
                    }
                    sub_k = 0
                    continue
                }
                let max_step_lo = if hi_clear { max(t_hi - r_hi - t_lo, r_lo) } else { t_hi - t_lo }
                step_len = min(omega_lo * r_lo, max_step_lo)
                probe_t = t_lo + step_len
            } else {
                if !hi_clear {
                    continue
                }
                if t_lo + r_lo + r_hi > t_hi {
                    return CellRayGrad::Empty(EmptyProof { seal: () })
                }
                let max_step_hi = max(t_hi - (t_lo + r_lo), r_hi)
                step_len = min(omega_hi * r_hi, max_step_hi)
                probe_t = t_hi - step_len
            }
            probe_p = o + d * probe_t
        } else if phase == 1 {
            let denom = ref_fa - ref_fb
            probe_t = if (sub_k & 1) == 0 && denom > 1.0e-12 {
                clamp(
                    ref_a + (ref_b - ref_a) * (ref_fa / denom),
                    ref_a + 0.1 * (ref_b - ref_a),
                    ref_b - 0.1 * (ref_b - ref_a),
                )
            } else {
                0.5 * (ref_a + ref_b)
            }
            probe_p = o + d * probe_t
        } else {
            let kx = if sub_k == 0 || sub_k == 3 { 1.0 } else { -1.0 }
            let ky = if sub_k >= 2 { 1.0 } else { -1.0 }
            let kz = if sub_k == 1 || sub_k == 3 { 1.0 } else { -1.0 }
            kv = vec3(kx, ky, kz)
            probe_p = o + d * t_hit + kv * ne
        }
        let fv = field.distance_live(probe_p, live)
        if phase == 0 {
            if cur_march == 0 {
                if fv <= tol || inv_lip == 0.0 {
                    t_hit = t0
                    if !want_grad {
                        return CellRayGrad::Hit(t_hit, vec3(0.0))
                    }
                    phase = 2
                    sub_k = 0
                } else {
                    f_lo = fv
                    r_lo = fv * inv_lip
                    t_near = t0
                    f_near = fv
                }
            } else if cur_march == 1 {
                if fv < f_near {
                    f_near = fv
                    t_near = t1
                }
                if t0 + r_lo >= t1 {
                    if fv <= tol {
                        ref_a = t0
                        ref_fa = f_lo
                        ref_b = t1
                        ref_fb = fv
                        if ref_fb >= -tol {
                            t_hit = max(ref_b, t0)
                            if !want_grad {
                                return CellRayGrad::Hit(t_hit, vec3(0.0))
                            }
                            phase = 2
                        } else {
                            phase = 1
                        }
                        sub_k = 0
                    } else {
                        return CellRayGrad::Empty(EmptyProof { seal: () })
                    }
                } else {
                    f_hi = fv
                    hi_clear = fv > tol
                    r_hi = if hi_clear { fv * inv_lip } else { 0.0 }
                    omega_lo = if hi_clear { 1.85 } else { 1.0 }
                }
            } else if (cur_march & 1) == 0 {
                if fv <= tol {
                    if omega_lo <= 1.01 {
                        ref_a = t_lo
                        ref_fa = f_lo
                        ref_b = probe_t
                        ref_fb = fv
                        if ref_fb >= -tol {
                            t_hit = max(ref_b, t0)
                            if !want_grad {
                                return CellRayGrad::Hit(t_hit, vec3(0.0))
                            }
                            phase = 2
                        } else {
                            phase = 1
                        }
                        sub_k = 0
                    } else {
                        t_hi = probe_t
                        f_hi = fv
                        hi_clear = false
                        r_hi = 0.0
                        omega_lo = 1.0
                    }
                } else {
                    let r_cand = fv * inv_lip
                    if omega_lo <= 1.01 || r_lo + r_cand > step_len {
                        t_lo = probe_t
                        f_lo = fv
                        r_lo = r_cand
                        if hi_clear {
                            omega_lo = 1.85
                        }
                    } else {
                        omega_lo = 1.0
                    }
                    if fv < f_near {
                        f_near = fv
                        t_near = probe_t
                    }
                }
            } else {
                if fv <= tol {
                    t_hi = probe_t
                    f_hi = fv
                    hi_clear = false
                    r_hi = 0.0
                    omega_lo = 1.0
                } else {
                    let rh_cand = fv * inv_lip
                    if omega_hi <= 1.01 || r_hi + rh_cand > step_len {
                        t_hi = probe_t
                        f_hi = fv
                        r_hi = rh_cand
                        omega_hi = 1.85
                    } else {
                        omega_hi = 1.0
                    }
                    if fv < f_near {
                        f_near = fv
                        t_near = probe_t
                    }
                }
            }
        } else if phase == 1 {
            if fv > 0.0 {
                ref_a = probe_t
                ref_fa = fv
            } else {
                ref_b = probe_t
                ref_fb = fv
            }
            sub_k += 1
            if sub_k >= 4 {
                t_hit = max(ref_b, t0)
                if !want_grad {
                    return CellRayGrad::Hit(t_hit, vec3(0.0))
                }
                phase = 2
                sub_k = 0
            }
        } else {
            gv = gv + kv * fv
            sub_k += 1
            if sub_k >= 4 {
                return CellRayGrad::Hit(t_hit, gv)
            }
        }
    }
    CellRayGrad::Hit(max(t_hit, t0), gv)
}

/// GPU-lean, zero-copy exact-bracket cell ray solver for fields with a build-time-verified
/// Lipschitz bound (`verify_surface_soundness`): takes `field` and `live` directly (no closure
/// copy, no per-pixel `affine()` explosion).
pub fn solve_cell_ray_lipschitz<M: Field<Substance>>(
    field: M,
    live: Live,
    o: vec3,
    d: vec3,
    t_enter: f32,
    t_exit: f32,
    px: f32,
    lip: f32,
) -> CellRay {
    match solve_cell_ray_lipschitz_grad(
        field,
        live,
        o,
        d,
        t_enter,
        t_exit,
        px,
        lip,
        want_grad: false,
    ) {
        CellRayGrad::Hit(t, _) => CellRay::Hit(t),
        CellRayGrad::Empty(proof) => CellRay::Empty(proof),
    }
}

/// Convenience wrapper for `Field<Substance>` using its stated Lipschitz bound over the cell.
pub fn solve_field_cell_ray<M: Field<Substance>>(
    field: M,
    o: vec3,
    d: vec3,
    lo: vec3,
    hi: vec3,
    px: f32,
) -> CellRay {
    let (te, tx) = ray_box_interval(o, d, lo, hi)
    if te > tx || tx <= 0.0 {
        return CellRay::Empty(EmptyProof { seal: () })
    }
    let diag = length(hi - lo)
    let lip = field.lipschitz(diag)
    solve_cell_ray(|q: vec3| field.distance(q), o, d, te, tx, px, lip)
}

// ---- The sun's visibility (`VisProof`, `SunVisibility`) ----
//
// The sun lights a surface only through a `SunVisibility`, and one is made only here, by one of
// these routes:
//   - `prove_sun_backfacing`: the surface's geometric normal faces away from the sun's way: it
//     hides the whole disc from itself.
//   - `prove_sun_lit`: every caster the sun's map holds over the receiver's footprint and over the
//     cone the highest caster could throw onto it lies on or behind the receiver's own tangent
//     plane (within the meshes' certified error): nothing stands between it and the sun.
//   - `prove_sun_dark`: every texel over that cone holds a caster above the receiver's plane.
//   - `sun_map_penumbra`: taps over the disc's footprint, each decided against the receiver's
//     exact plane depth (Dou et al. 2014's adaptive depth, with no bias), none near (above the
//     plane by no more than the map's own depth changes round the tap, where its raster can't
//     say which is in front).
//   - `trace_sun_near` + `sun_exact`: what the map can't decide (a near caster: a contact, a
//     crease, a terminator) by a short exact ray as far as the near casters reach, against each
//     field,
//     stepped by the field's value over its Lipschitz bound (the mean value theorem: never past
//     a surface wider than its least step), times what the map says of the far casters.
//   - `sun_map_taps`: forward-shaded glass, the radiance volume's injection and the froxels, which
//     have no exact pass: the map's taps at the exact plane depth.
// No comparison sampler, no depth bias and no normal offset is left: a shadow map's raw depth
// is compared only here, to a receiver plane's exact depth at the texel's own centre.

/// Unforgeable zero-sized witness that a sun visibility was found by one of this module's
/// certified routes. Erases to 0 bytes across CPU, Metal and SPIR-V.
pub struct VisProof: Copy {
    seal: (),
}

/// How much of the sun's disc a surface point sees (0..1), with its witness.
pub struct SunVisibility: Copy {
    pub vis: f32,
    pub proof: VisProof,
}

/// The surface's geometric normal faces away from the sun (`ndl`, its cosine to the sun's way,
/// at most 0): it hides the whole disc from itself.
pub fn prove_sun_backfacing(ndl: f32) -> Option<SunVisibility> {
    if ndl <= 0.0 {
        Some(SunVisibility { vis: 0.0, proof: VisProof { seal: () } })
    } else {
        None
    }
}

/// Nothing the map holds stands before the receiver: the nearest caster to the sun over the
/// windows covering the receiver's footprint (`zmin_fine`) and the cone a blocker at the map's
/// highest could throw onto it (`zmin_cone`) is no nearer the sun than the lowest the receiver's
/// tangent plane reaches over each window (`plane_lo_*`), less the meshes' certified error
/// (`eps`). All in the map's depth (0 at the sun's side).
pub fn prove_sun_lit(
    zmin_fine: f32,
    plane_lo_fine: f32,
    zmin_cone: f32,
    plane_lo_cone: f32,
    eps: f32,
) -> Option<SunVisibility> {
    if zmin_fine >= plane_lo_fine - eps && zmin_cone >= plane_lo_cone - eps {
        Some(SunVisibility { vis: 1.0, proof: VisProof { seal: () } })
    } else {
        None
    }
}

/// Every texel over the cone's window holds a caster nearer the sun than the lowest the
/// receiver's plane reaches there by more than `band` (the meshes' error): the whole disc is
/// hidden.
pub fn prove_sun_dark(zmax_cone: f32, plane_lo_cone: f32, band: f32) -> Option<SunVisibility> {
    if zmax_cone < plane_lo_cone - band {
        Some(SunVisibility { vis: 0.0, proof: VisProof { seal: () } })
    } else {
        None
    }
}

/// The map's taps over the disc's footprint, each decided at the receiver's exact plane depth:
/// `blocked` of `taps` hidden by far casters, none near (`near == 0`), so the map alone can say
/// what the receiver sees.
pub fn sun_map_penumbra(blocked: f32, taps: f32, near: u32) -> Option<SunVisibility> {
    if near == 0 && taps > 0.0 {
        Some(SunVisibility {
            vis: clamp(1.0 - blocked / taps, 0.0, 1.0),
            proof: VisProof { seal: () },
        })
    } else {
        None
    }
}

/// The map's taps where no exact pass follows (glass, the radiance volume, the froxels):
/// `open` of `taps` with no caster above the receiver's plane beyond the meshes' error.
pub fn sun_map_taps(open: f32, taps: f32) -> SunVisibility {
    SunVisibility {
        vis: if taps > 0.0 { clamp(open / taps, 0.0, 1.0) } else { 1.0 },
        proof: VisProof { seal: () },
    }
}

/// What the map says of the casters past the near band (`vis_far`) times what the exact rays
/// found within it (`vis_near`, the least over every field).
pub fn sun_exact(vis_far: f32, vis_near: f32) -> SunVisibility {
    SunVisibility {
        vis: clamp(vis_far, 0.0, 1.0) * clamp(vis_near, 0.0, 1.0),
        proof: VisProof { seal: () },
    }
}

/// A triangle or a quad of the mesh shown to be local: no two of its corners further apart than
/// `span`, the most the cells they were solved in allow (a vertex lies within 0.85 of a cell of
/// its own cell, and the four cells round an edge lie in a block 2 by 2 by 1 of them: `QUAD_SPAN`
/// cells from corner to corner; twice that where a level's seam takes the coarser level's cells).
/// Only such are stored for drawing (`mesh::emit`: `store_quad`, `store_tri`), so an index gone
/// astray (a slot never solved, a brick's base mistaken, a buffer run out) can put no triangle
/// across the picture: what is refused is drawn as nothing and counted (`OVERFLOW_UNLOCAL`, which
/// the hole audit fails on); a brick's quad refused also has its cells solved exactly, while a
/// level's seam, which has no cells of its own to solve, is left to the audit.
pub struct LocalProof: Copy {
    seal: (),
}

/// The quad `(p0, p1, p2, p3)` is local to `span` (and none of it is not a number).
pub fn prove_quad_local(p0: vec3, p1: vec3, p2: vec3, p3: vec3, span: f32) -> Option<LocalProof> {
    let s2 = span * span
    let d = |a: vec3, b: vec3| dot(a - b, a - b)
    if d(p0, p1) <= s2 &&
        d(p1, p2) <= s2 &&
        d(p2, p3) <= s2 &&
        d(p3, p0) <= s2 &&
        d(p0, p2) <= s2 &&
        d(p1, p3) <= s2 {
        Some(LocalProof { seal: () })
    } else {
        None
    }
}

/// The triangle `(p0, p1, p2)` is local to `span` (and none of it is not a number).
pub fn prove_tri_local(p0: vec3, p1: vec3, p2: vec3, span: f32) -> Option<LocalProof> {
    let s2 = span * span
    let d = |a: vec3, b: vec3| dot(a - b, a - b)
    if d(p0, p1) <= s2 && d(p1, p2) <= s2 && d(p2, p0) <= s2 {
        Some(LocalProof { seal: () })
    } else {
        None
    }
}

/// A quad of the mesh shown to need no exact cell: it was stored for drawing (a `LocalProof`),
/// and every eye within reach of the one it was meshed for sees all of it from the one side
/// (`dc::on_outline`), or its cells are too fine to stand off the field by a hole
/// (`dc::finer_than_a_hole`). Made only by `quad_cover`.
pub struct CoverProof: Copy {
    seal: (),
}

/// What a quad of the mesh is to the picture's cover: the one answer `mesh::emit` gets for each
/// quad, and must take each case of (a `match`), so that no quad the mesh can't be shown to cover
/// with goes without an exact cell because a rewrite forgot to ask.
pub enum QuadCover: Copy {
    /// Drawn, and shown to need nothing more.
    Covered(CoverProof),
    /// Drawn in a mesh the exact pass doesn't hold: one meshed for no eye (a pool's shared
    /// mesh, a mesh drawn only to the sun's map), or a transmissive quad (glass has its own pass).
    Unheld,
    /// Drawn, on the mesh's outline for some eye within reach: its cells are certified
    /// (`certify_outline`) or solved exactly.
    Outline,
    /// Drawn, but wound against its normals (folded, so culled): its cells are solved exactly.
    Folded,
    /// Not drawn (a vertex of its four never solved, not local, or no room left for its indices):
    /// its cells are solved exactly, whatever their size.
    Unsound,
}

/// The cover of an opaque quad just stored for drawing (`local`), with corners `p0..p3` and unit
/// normals `n0..n3`, split along `p1-p3` when `split13`, in a cell at `cell_lo` of width `h`,
/// held to the eye `eye` (`xyz` its place, `w` its pixel's width a metre out; `w` 0 for no eye)
/// and every eye within `reach` of it.
pub fn quad_cover(
    local: LocalProof,
    p0: vec3,
    p1: vec3,
    p2: vec3,
    p3: vec3,
    n0: vec3,
    n1: vec3,
    n2: vec3,
    n3: vec3,
    split13: bool,
    cell_lo: vec3,
    h: f32,
    eye: vec4,
    reach: f32,
) -> QuadCover {
    let _ = local
    if eye.w <= 0.0 {
        return QuadCover::Unheld
    }
    let kind = on_outline(p0, p1, p2, p3, n0, n1, n2, n3, split13: split13, e: eye.xyz, reach: reach)
    if kind == QUAD_INSIDE || finer_than_a_hole(cell_lo, h, eye) {
        return QuadCover::Covered(CoverProof { seal: () })
    }
    if kind == QUAD_FOLDED { QuadCover::Folded } else { QuadCover::Outline }
}

/// The cover of a transmissive quad shown local (`local`), whether or not its buffer had room:
/// glass is drawn by its own pass, behind what is opaque, and the exact pass (which solves what is
/// opaque) doesn't hold it, so it is `Unheld` either way (a full buffer is `OVERFLOW_TRANS`).
pub fn transmissive_cover(local: LocalProof) -> QuadCover {
    let _ = local
    QuadCover::Unheld
}

/// Steps an exact sun ray takes at the most (`trace_sun_near`).
pub const SUN_RAY_STEPS: u32 = 32

/// The share of the sun's disc (`tan_sun`: the tangent of its angular radius) a point `p` sees
/// past one field within `t_end` m along the sun's way `w`, `x` its penumbra (`min h / (t tan)`,
/// 1 where nothing comes near), asking only the parts `live` names (`Surface::live` of a box
/// holding the whole ray: bit for bit the field there). Stepped by the field's value over its
/// Lipschitz bound `lip` (never past a surface), each step at least `max(e, t_end /
/// SUN_RAY_STEPS)` (`e`: the mesh's certified error at `p`, under which nothing is drawn
/// anyway), so `SUN_RAY_STEPS` steps always reach `t_end`.
///
/// Where `p0` is within `e` of the field (by its value over its Lipschitz bound: the most its
/// surface can be off), it touches it: its own surface (the receiver's), or another's in contact.
/// It is first taken onto the field along the receiver's geometric normal `n` (one step of
/// Newton's, the normal standing in for the gradient: kept only where it brings the value
/// nearer 0, so a point beside another field in contact stays put). The ray is then asked where
/// the receiver's own surface, leaning `dot(n, w)` toward the sun, has risen out of what is left
/// of its value and f32's resolution: inside the field there, the sun is hidden (a contact, or a
/// crease that closes over it); out of it, the ray goes on from there, and a groove's wall a
/// millimetre off is met. A point inside the field by more than `e` sees none of the sun.
pub fn trace_sun_near<M: Field<Substance>>(
    field: M,
    live: Live,
    p0: vec3,
    n: vec3,
    w: vec3,
    t_end: f32,
    tan_sun: f32,
    e: f32,
    lip: f32,
) -> f32 {
    let l = max(lip, 1.0)
    let lean = max(dot(n, w), 0.05)
    var p = p0
    let h0 = field.distance_live(p, live)
    var t = 0.0
    if abs(h0) <= e * l {
        let p1 = p - n * h0
        let h1 = field.distance_live(p1, live)
        var h = h0
        if abs(h1) < abs(h0) {
            p = p1
            h = h1
        }
        t = (2.0 * abs(h) + 0.25 * e + 4.0 * PROOF_EPS * (abs(p.x) + abs(p.y) + abs(p.z))) / lean
        if t < t_end && field.distance_live(p + w * t, live) <= 0.0 {
            return 0.0
        }
    } else if h0 < 0.0 {
        return 0.0
    }
    let least = max(e, t_end / f32(SUN_RAY_STEPS))
    var x = 1.0
    for _i in 0..SUN_RAY_STEPS {
        if t >= t_end {
            break
        }
        let h = field.distance_live(p + w * t, live) / l
        if h <= 0.0 {
            x = -1.0
            break
        }
        if t > 0.0 {
            x = min(x, h / (t * tan_sun))
        }
        t += max(h, least)
    }
    let s = clamp(0.5 + 0.5 * x, 0.0, 1.0)
    s * s * (3.0 - 2.0 * s)
}

// ---- CPU soundness tests (run at build time via `tools/check`) ----

@test
fn vis_proof_is_zero_sized_and_exact_rays_see_contact_and_self() {
    assert(size_of::<VisProof>() == 0, "VisProof must erase to 0 bytes")
    assert(size_of::<SunVisibility>() == 4, "SunVisibility must be one f32")
    let tan_sun = tan(0.0046)
    let up = vec3(0.0, 1.0, 0.0)
    // A 2 mm-thin slab lying 1 mm above a floor point: the point is in its shadow.
    let slab = cuboid(vec3(0.05, 0.001, 0.05))
        .translate(vec3(0.0, 0.002, 0.0))
        .with(lambert(vec3(0.5)))
    let under = trace_sun_near(slab, ALL_LIVE, vec3(0.0), up, up, t_end: 0.05, tan_sun: tan_sun, e: 0.0002, lip: 1.0)
    assert(under < 0.01, f"a point under a slab 1 mm above it must be dark, saw {under}")
    // The slab's own top face, the receiver: it sees the whole sun, however small its error.
    let top = trace_sun_near(slab, ALL_LIVE, vec3(0.01, 0.0030001, 0.0), up, up, t_end: 0.05, tan_sun: tan_sun, e: 0.0002, lip: 1.0)
    assert(top > 0.99, f"a face lit by the sun must see it, saw {top}")
    // Off to the side, beyond the penumbra: lit.
    let side = trace_sun_near(slab, ALL_LIVE, vec3(0.2, 0.0, 0.0), up, up, t_end: 0.05, tan_sun: tan_sun, e: 0.0002, lip: 1.0)
    assert(side > 0.99, f"a point clear of the slab must see the sun, saw {side}")
    // A sphere's own lit face at a lean of 0.2 to the sun: the ray leaves it, lit.
    let ball = sphere(0.3).with(lambert(vec3(0.5)))
    let n = normalize(vec3(0.98, 0.2, 0.0))
    let lean = trace_sun_near(ball, ALL_LIVE, n * 0.3, n, up, t_end: 0.05, tan_sun: tan_sun, e: 0.0002, lip: 1.0)
    assert(lean > 0.99, f"a sphere's face leaning 0.2 to the sun must see it, saw {lean}")
    // The slab's top edge, the receiver its top face.
    let edge = trace_sun_near(slab, ALL_LIVE, vec3(0.05, 0.003, 0.0), up, up, t_end: 0.05, tan_sun: tan_sun, e: 0.0002, lip: 1.0)
    assert(edge > 0.99, f"a lit face's outline must see the sun, saw {edge}")
    // A point on the floor a hair (0.05 mm) beside the slab's foot, the slab overhanging it: dark.
    let under_lip = trace_sun_near(slab, ALL_LIVE, vec3(0.0499, 0.00095, 0.0), up, up, t_end: 0.05, tan_sun: tan_sun, e: 0.0002, lip: 1.0)
    assert(under_lip < 0.01, f"a point under the slab's edge must be dark, saw {under_lip}")
    // The floor of a groove 1 mm wide and 2 mm deep, the sun leaning in across it: its wall a
    // millimetre off hides it; up its middle, the sun is seen.
    let grooved = cuboid(vec3(0.05, 0.01, 0.05))
        .translate(vec3(0.0, -0.01, 0.0))
        .smooth_subtract(cuboid(vec3(0.0005, 0.002, 0.06)), 0.00001)
        .with(lambert(vec3(0.5)))
    let slant = normalize(vec3(1.0, 0.6, 0.0))
    let in_groove = trace_sun_near(grooved, ALL_LIVE, vec3(-0.0003, -0.002, 0.0), up, slant, t_end: 0.05, tan_sun: tan_sun, e: 0.0002, lip: 1.0)
    assert(in_groove < 0.01, f"a groove's floor with the sun across it must be dark, saw {in_groove}")
    let up_groove = trace_sun_near(grooved, ALL_LIVE, vec3(0.0, -0.002, 0.0), up, up, t_end: 0.05, tan_sun: tan_sun, e: 0.0002, lip: 1.0)
    assert(up_groove > 0.5, f"a groove's floor with the sun straight down it must see it, saw {up_groove}")
    assert(prove_sun_backfacing(-0.1).is_some() && prove_sun_backfacing(0.1).is_none(), "backfacing")
    assert(prove_sun_lit(zmin_fine: 0.5, plane_lo_fine: 0.5, zmin_cone: 0.5, plane_lo_cone: 0.49, eps: 0.001).is_some(), "lit")
    assert(prove_sun_lit(zmin_fine: 0.49, plane_lo_fine: 0.5, zmin_cone: 0.5, plane_lo_cone: 0.5, eps: 0.001).is_none(), "a caster above the plane is not lit")
    assert(prove_sun_dark(zmax_cone: 0.3, plane_lo_cone: 0.5, band: 0.1).is_some() &&
            prove_sun_dark(zmax_cone: 0.45, plane_lo_cone: 0.5, band: 0.1).is_none(), "dark")
}

@test
fn proof_tokens_erase_to_zero_bytes() {
    assert(
        size_of::<EmptyProof>() == 0,
        f"EmptyProof must be 0 bytes, got {size_of::<EmptyProof>()}",
    )
    assert(size_of::<LocalProof>() == 0, "LocalProof must be 0 bytes")
    assert(size_of::<CoverProof>() == 0, "CoverProof must be 0 bytes")
    assert(
        size_of::<RayBox>() == 16,
        f"RayBox must be 16 bytes (one vec4), got {size_of::<RayBox>()}",
    )
}

@test
fn a_triangle_is_stored_only_where_it_is_local_and_a_quad_says_what_covers_it() {
    // A quad of 10 cm cells, a metre before an eye whose pixel is a millimetre a metre out.
    let h = 0.1
    let z = vec3(0.0, 0.0, 1.0)
    let p0 = vec3(0.0, 0.0, 0.0)
    let p1 = vec3(h, 0.0, 0.0)
    let p2 = vec3(h, h, 0.0)
    let p3 = vec3(0.0, h, 0.0)
    let span = 6.0 * h
    let local = match prove_quad_local(p0, p1, p2, p3, span) {
        Some(proof) => proof,
        None => panic("a quad within its cells is local"),
    }
    // One corner astray (an index to another brick's vertex, the origin, a slot never written)
    // is refused: it is drawn as nothing.
    let astray = vec3(40.0, 3.0, -7.0)
    assert(prove_quad_local(p0, p1, astray, p3, span).is_none(), "a corner astray is refused")
    assert(prove_tri_local(p0, p1, astray, span).is_none(), "a triangle's corner astray is refused")
    let far = vec3(1.0e30, 0.0, 0.0)
    assert(prove_quad_local(p0, far, p2, p3, span).is_none(), "a corner out of all bounds is refused")
    assert(prove_tri_local(p0, p1, p2, span).is_some(), "a triangle within its cells is local")
    let facing = vec4(0.05, 0.05, 1.0, 0.001)
    let cover = |eye: vec4, n: vec3| quad_cover(
        local,
        p0,
        p1,
        p2,
        p3,
        n,
        n,
        n,
        n,
        split13: false,
        cell_lo: p0,
        h: h,
        eye: eye,
        reach: 0.01,
    )
    // Faced by the eye, it needs no exact cell; with no eye, it isn't held to one.
    match cover(facing, z) {
        QuadCover::Covered(_) => {},
        QuadCover::Unheld => panic("a quad an eye faces is held to it"),
        QuadCover::Outline => panic("a quad an eye faces is not on its outline"),
        QuadCover::Folded => panic("a quad an eye faces is not folded"),
        QuadCover::Unsound => panic("a stored quad is sound"),
    }
    match cover(vec4(0.05, 0.05, 1.0, 0.0), z) {
        QuadCover::Unheld => {},
        QuadCover::Covered(_) => panic("with no eye nothing is shown covered"),
        QuadCover::Outline => panic("with no eye there is no outline"),
        QuadCover::Folded => panic("with no eye nothing is folded"),
        QuadCover::Unsound => panic("a stored quad is sound"),
    }
    // Seen edge on (the eye in its plane), it is on the outline: certified or solved.
    match cover(vec4(1.0, 0.05, 0.0, 0.001), z) {
        QuadCover::Outline => {},
        QuadCover::Folded => {},
        QuadCover::Covered(_) => panic("a quad seen edge on can't be shown covered"),
        QuadCover::Unheld => panic("a quad seen edge on is held to its eye"),
        QuadCover::Unsound => panic("a stored quad is sound"),
    }
}

@test
fn solve_cell_ray_has_zero_holes_and_zero_extras_on_grazing_sphere() {
    let s = sphere(1.0)
    // Cell straddling the +X silhouette of the unit sphere: `[0.75, 1.25] × [-0.25, 0.25] × [-0.75, 0.75]`.
    let lo = vec3(0.75, -0.25, -0.75)
    let hi = vec3(1.25, 0.25, 0.75)
    let px = 0.004
    var hits: u32 = 0
    var misses: u32 = 0
    for i in 0..200 {
        // Sweep x across `[0.80, 1.20]` in steps of 0.002 m (0.5 px) across the exact x=1.0 tangent.
        let x = 0.80 + f32(i) * 0.002
        let o = vec3(x, 0.0, -3.0)
        let d = vec3(0.0, 0.0, 1.0)
        let (te, tx) = ray_box_interval(o, d, lo, hi)
        let res = solve_cell_ray(|q: vec3| s.distance(q), o, d, te, tx, px, s.lipschitz(1.0))
        let inside_true = x <= 1.0 - 0.5 * px
        let outside_true = x >= 1.0 + 0.5 * px
        match res {
            CellRay::Hit(t) => {
                hits += 1
                assert(!outside_true, f"extra hit at x={x} (t={t})")
                if inside_true {
                    let exact_t = 3.0 - sqrt(max(1.0 - x * x, 0.0))
                    assert(abs(t - exact_t) <= 0.35 * px, f"hit off at x={x}: {t} vs {exact_t}")
                }
            },
            CellRay::Empty(_) => {
                misses += 1
                assert(!inside_true, f"HOLE at grazing x={x}")
            },
        }
    }
    assert(hits > 90 && misses > 90, f"expected both hits ({hits}) and misses ({misses})")
}

@test
fn solve_cell_ray_catches_sub_cell_one_millimeter_wand() {
    // 1 mm radius wand sitting cleanly inside a 10 cm cell (100× coarser than the feature! All 8
    // corners are strongly positive so Dual Contouring alone emits 0 triangles).
    let wand = round_cone(vec3(0.0, -0.2, 0.0), vec3(0.0, 0.2, 0.0), r_bottom: 0.001, r_top: 0.001)
    let lo = vec3(-0.05, -0.05, -0.05)
    let hi = vec3(0.05, 0.05, 0.05)
    let px = 0.0005
    // Verify all 8 cell corners are positive (DC would miss it completely).
    for k in 0..8 {
        let c = vec3(
            if (k & 1) != 0 { hi.x } else { lo.x },
            if (k & 2) != 0 { hi.y } else { lo.y },
            if (k & 4) != 0 { hi.z } else { lo.z },
        )
        assert(wand.distance(c) > 0.04, "wand must be strictly sub-cell")
    }
    // Sweep rays across the 1 mm wand inside the 10 cm cell.
    var hits: u32 = 0
    for i in 0..41 {
        let x = -0.004 + f32(i) * 0.0002
        let o = vec3(x, 0.0, -1.0)
        let d = vec3(0.0, 0.0, 1.0)
        let (te, tx) = ray_box_interval(o, d, lo, hi)
        let res = solve_cell_ray(|q: vec3| wand.distance(q), o, d, te, tx, px, wand.lipschitz(0.2))
        let must_hit = abs(x) <= 0.0008
        let must_miss = abs(x) >= 0.0016
        match res {
            CellRay::Hit(_) => {
                hits += 1
                assert(!must_miss, f"extra hit beside 1mm wand at x={x}")
            },
            CellRay::Empty(_) => {
                assert(!must_hit, f"HOLE on 1mm sub-cell wand at x={x}")
            },
        }
    }
    assert(hits >= 9, f"expected >= 9 hits across 1mm wand, got {hits}")
}

@test
fn solve_cell_ray_handles_steep_displaced_noise_and_unbounded_lipschitz() {
    let rock = sphere(1.0).displace(
        fbm(freq: 3.5, octaves: 3, offset: vec3(1.1, 2.3, 0.7)),
        amp: 0.14,
    )
    let lo = vec3(0.70, -0.20, -0.20)
    let hi = vec3(1.25, 0.20, 0.20)
    let px = 0.003
    // Test with BOTH real Lipschitz and unbounded Lipschitz (forces pure 1D affine path).
    for mode in 0..2 {
        let lip = if mode == 0 { rock.lipschitz(1.0) } else { 1.0 / 0.0 }
        for i in 0..40 {
            let y = -0.15 + f32(i) * 0.0075
            let o = vec3(0.95, y, -3.0)
            let d = vec3(0.0, 0.0, 1.0)
            let (te, tx) = ray_box_interval(o, d, lo, hi)
            // Brute-force ground truth along [te, tx] in 256 fine steps.
            var brute_hit = false
            for k in 0..257 {
                let s = te + (tx - te) * (f32(k) / 256.0)
                if rock.distance(o + d * s) < -0.002 {
                    brute_hit = true
                    break
                }
            }
            let res = solve_cell_ray(|q: vec3| rock.distance(q), o, d, te, tx, px, lip)
            match res {
                CellRay::Hit(_) => {},
                CellRay::Empty(_) => {
                    assert(!brute_hit, f"HOLE on steep noise (mode={mode}, y={y})")
                },
            }
        }
    }
}

@test
fn solve_cell_ray_lipschitz_bidirectional_has_zero_holes_and_zero_extras() {
    let s = sphere(1.0).with(lambert(vec3(0.5)))
    // Coarse 10-pixel cell straddling the +X silhouette of the unit sphere (`px = 0.004 m`).
    let lo = vec3(0.98, -0.02, -0.02)
    let hi = vec3(1.02, 0.02, 0.02)
    let px = 0.004
    for i in 0..80 {
        let x = 0.982 + f32(i) * 0.0005
        let o = vec3(x, 0.0, -3.0)
        let d = vec3(0.0, 0.0, 1.0)
        let (te, tx) = ray_box_interval(o, d, lo, hi)
        let res = solve_cell_ray_lipschitz(s, ALL_LIVE, o, d, te, tx, px, s.lipschitz(0.1))
        let inside_true = x <= 1.0 - 0.5 * px
        let outside_true = x >= 1.0 + 0.75 * px
        match res {
            CellRay::Hit(t) => {
                assert(!outside_true, f"extra hit at x={x} (t={t})")
                if inside_true {
                    let exact_t = max(3.0 - sqrt(max(1.0 - x * x, 0.0)), te)
                    assert(abs(t - exact_t) <= 0.25 * px, f"hit off at x={x}: {t} vs {exact_t}")
                }
            },
            CellRay::Empty(_) => {
                assert(!inside_true, f"HOLE at grazing x={x}")
            },
        }
    }
}

@test
fn ray_box_bracket_has_zero_seam_between_touching_cells() {
    // Two touching cells sharing the plane x = 10.0; rays aimed right at the boundary must hit
    // at least one cell (never slip through a floating-point slab seam).
    let d = normalize(vec3(0.01, -0.02, 1.0))
    let fwd = vec3(0.0, 0.0, 1.0)
    for i in 0..9 {
        let ox = 10.0 + f32(i - 4) * 1.0e-6
        let o = vec3(ox, 0.0, -5.0)
        let left = ray_box_bracket(o, d, fwd, vec3(9.0, -1.0, 0.0), vec3(10.0, 1.0, 1.0))
        let right = ray_box_bracket(o, d, fwd, vec3(10.0, -1.0, 0.0), vec3(11.0, 1.0, 1.0))
        let hit_any = left.t_enter <= left.t_exit || right.t_enter <= right.t_exit
        assert(hit_any, f"ray at ox={ox} slipped through touching cell seam")
    }
}

@test
fn ray_sphere_bracket_matches_exact_sphere() {
    let fwd = vec3(0.0, 0.0, 1.0)
    let hit = ray_sphere_bracket(vec3(0.0, 0.0, -4.0), fwd, fwd, vec3(0.0), 1.0)
    assert(hit.t_enter <= hit.t_exit, "center ray must hit sphere")
    assert(
        abs(hit.t_enter - 3.0) < 1.0e-4 && abs(hit.t_exit - 5.0) < 1.0e-4,
        "wrong sphere bracket",
    )
    let miss = ray_sphere_bracket(vec3(1.1, 0.0, -4.0), fwd, fwd, vec3(0.0), 1.0)
    assert(miss.t_enter > miss.t_exit, "outside ray must miss sphere")
}

@test
fn filtered_proof_is_zero_sized_and_cuts_nyquist_shimmer() {
    assert(size_of::<FilteredProof>() == 0, "FilteredProof must erase to 0 bytes")
    // High-frequency procedural gilded-lettering + oak-ring field evaluated across 32 distant
    // pixels: compare unfiltered point samples vs. `filter_channels` against 64-sample brute-force
    // box average over each pixel's tangent footprint.
    let f = sphere(2.0).with_at(|p: vec3| -> Substance {
        let rings = 0.5 + 0.5 * sin(p.x * 180.0 + 0.6 * std::field::value_noise(p * 30.0))
        let stripe = smoothstep(0.45, 0.55, fract(p.y * 90.0))
        lambert(vec3(0.15 + 0.7 * rings, 0.1 + 0.6 * stripe, 0.2))
    })
    let dwx = vec3(0.06, 0.0, 0.0)
    let dwy = vec3(0.0, 0.06, 0.0)
    var err_raw = 0.0
    var err_flt = 0.0
    for i in 0..32 {
        let wp = vec3(-0.5 + f32(i) * 0.031, -0.3 + f32((i * 7) & 15) * 0.04, 1.8)
        // 8×8 = 64-sample brute-force reference over [wp - 0.5*dwx - 0.5*dwy, wp + 0.5*dwx + 0.5*dwy].
        var ref_col = vec3(0.0)
        for sx in 0..8 {
            for sy in 0..8 {
                let u = (f32(sx) + 0.5) / 8.0 - 0.5
                let v = (f32(sy) + 0.5) / 8.0 - 0.5
                let s_ref = Field::<Substance>::channels(f, wp + dwx * u + dwy * v)
                ref_col = ref_col + s_ref.albedo
            }
        }
        ref_col = ref_col * (1.0 / 64.0)
        let raw_col = Field::<Substance>::channels(f, wp).albedo
        let flt_col = filter_channels(f, wp, dwx, dwy).sub.albedo
        err_raw += length(raw_col - ref_col)
        err_flt += length(flt_col - ref_col)
    }
    assert(
        err_flt <= 0.35 * err_raw,
        f"Nyquist error did not drop >=65%: filtered={err_flt}, raw={err_raw}",
    )
}

@test
fn spec_aa_proof_is_zero_sized_and_suppresses_bevel_fireflies() {
    assert(size_of::<SpecAAProof>() == 0, "SpecAAProof must erase to 0 bytes")
    let glossy = Substance {
        albedo: vec3(0.85, 0.68, 0.32),
        roughness: 0.15,
        emits: vec3(0.0),
        metallic: 1.0,
        ior: 1.5,
        transmission: 0.0,
        subsurface: 0.0,
        coat: 0.0,
        micro: 0.0,
        bump: 0.0,
        pad1: 0.0,
        pad2: 0.0,
    }
    let flat_in = prove_vertex_filtered(glossy)
    let flat_out = prove_specular_aa(flat_in, vec3(0.0), vec3(0.0))
    assert(
        flat_out.sub.roughness == glossy.roughness && flat_out.sub.coat == glossy.coat,
        "flat surface must keep exact roughness and coat",
    )
    // A 1-pixel curved brass finial/knob (2D curvature `dtheta = 0.45 rad/px` in x and y) swept
    // across 25 sub-pixel phases crossing `h = (0, 1, 0)`: compare GGX specular firefly error vs.
    // 16×16 = 256-sample 2D ground-truth normal patch integral.
    let from = normalize(vec3(0.25, 0.96, 0.0))
    let to = normalize(vec3(-0.25, 0.96, 0.0))
    let dtheta = 0.45
    var err_raw = 0.0
    var err_aa = 0.0
    for px_i in 0..5 {
        for py_i in 0..5 {
            let cx = -0.24 + (f32(px_i) / 4.0) * 0.48
            let cy = -0.24 + (f32(py_i) / 4.0) * 0.48
            var ref_s = 0.0
            for kx in 0..16 {
                for ky in 0..16 {
                    let ax = cx + ((f32(kx) + 0.5) / 16.0 - 0.5) * dtheta
                    let ay = cy + ((f32(ky) + 0.5) / 16.0 - 0.5) * dtheta
                    let nk = normalize(vec3(ax, 1.0, ay))
                    ref_s += glossy.scatters(nk, from, to).x
                }
            }
            ref_s = ref_s / 256.0
            let nc = normalize(vec3(cx, 1.0, cy))
            let dnx = vec3(dtheta, 0.0, 0.0)
            let dny = vec3(0.0, 0.0, dtheta)
            let raw_s = glossy.scatters(nc, from, to).x
            let aa_sub = prove_specular_aa(flat_in, dnx, dny).sub
            let aa_s = aa_sub.scatters(nc, from, to).x
            err_raw += abs(raw_s - ref_s)
            err_aa += abs(aa_s - ref_s)
        }
    }
    assert(
        err_aa <= 0.30 * err_raw,
        f"SpecAAProof did not cut curved specular firefly error >=70%: aa={err_aa}, raw={err_raw}",
    )
}
