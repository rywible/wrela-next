// The cook (engine-at-build phase 3): what extraction computes from a field and a brick alone,
// the same for every eye, made once and kept. This file holds its census so far: how many bricks
// of a kind hold surface at each cell of the ladder (`grid::ladder_cell`), so how large a cook of
// each cell would be.

use matter::substance::Substance
use mesh::grid::{BRICK, ladder_cell, placement, tight_aabb}
use std::collections::Vec
use std::derive::Box3
use std::field::{ALL_LIVE, Field}

/// One cell of the ladder in a census: the cell, the bricks there whose box (with its halo, as
/// `grid::cull_brick` takes it) may hold the surface, and what their corners and vertices would
/// take (bytes: 512 corners of 4 bytes, and a vertex of 16 for each surface cell, counted as a
/// flat surface's 2 of a brick's 6 layers: `BRICK² · 2`).
pub struct CookLevel: Copy {
    pub cell: f32,
    pub bricks: u32,
    pub bytes: u64,
}

/// The bytes one brick of the cook holds (`CookLevel`).
pub const COOK_BRICK_BYTES: u64 = 4 * 512 + 16 * 72

/// Whether `f` may have surface in the box of the brick at whole-brick coordinates `k` of cell `h`
/// (its corners `k · BRICK` to `k · BRICK + BRICK + 1`, on the world's own placement).
fn may_hold<M: Field<Substance>>(f: M, h: f32, k: vec3i) -> bool {
    let span = h * f32(BRICK)
    let lo = vec3(f32(k.x), f32(k.y), f32(k.z)) * span + placement(0)
    let hi = lo + vec3(h * f32(BRICK + 1))
    let pr = f.pruned(Box3 { lo, hi }, |q: vec3| q, 1.0, ALL_LIVE, 0)
    pr.range.lo <= 0.0 && pr.range.hi >= 0.0
}

/// The bricks of `f` that may hold surface at each cell of the ladder from `coarsest` down to
/// `finest`, halving: a brick is looked at only where the brick of twice its cell that holds it
/// may hold surface (a brick of cell `h` at `k` lies in the one of `2h` at `floor(k / 2)`), so the
/// census costs what the surface's bricks do, not the box's. Stops at a cell whose bricks pass
/// `most` (the next would be about four times as many), with that cell's count.
pub fn cook_census<M: Field<Substance>>(f: M, coarsest: f32, finest: f32, most: u32) -> Vec<CookLevel> {
    let aabb = tight_aabb(f)
    var h = ladder_cell(coarsest)
    let span = h * f32(BRICK)
    let lo = floor((aabb.lo - vec3(2.0 * h)) / span)
    let hi = floor((aabb.hi + vec3(2.0 * h)) / span)
    var live: Vec<vec3i> = Vec::new()
    for z in i32(lo.z)..i32(hi.z) + 1 {
        for y in i32(lo.y)..i32(hi.y) + 1 {
            for x in i32(lo.x)..i32(hi.x) + 1 {
                let k = vec3i(x, y, z)
                if may_hold(f, h, k) {
                    live.push(k)
                }
            }
        }
    }
    var out: Vec<CookLevel> = Vec::new()
    out.push(CookLevel { cell: h, bricks: live.len(), bytes: u64(live.len()) * COOK_BRICK_BYTES })
    while h * 0.5 >= finest * 0.999 && live.len() <= most {
        h = h * 0.5
        var next: Vec<vec3i> = Vec::new()
        for k in live {
            for c in 0..8 {
                let child = k * 2 + vec3i(i32(c & 1), i32((c >> 1) & 1), i32(c >> 2))
                if may_hold(f, h, child) {
                    next.push(child)
                }
            }
        }
        live = take next
        out.push(CookLevel { cell: h, bricks: live.len(), bytes: u64(live.len()) * COOK_BRICK_BYTES })
    }
    out
}
