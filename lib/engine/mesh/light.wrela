// Unified One Light for meshlet, heightfield, and volumetric rendering:
//   - Unified sun shadow map (`ShadowView`, `SHADOW_SIDE = 2048`)
//   - On-demand GPU Sky Cache (`SkyCache`): octahedral diffuse irradiance (`32×32`) + 3-level
//     roughness-prefiltered specular PMREM (`64×64`, `32×32`, `16×16`) built for ANY `S: Sky` only
//     when the sky changes (0 ms/frame when static)
//   - Unified 3-level world-space radiance volume (`64³ -> 32³ -> 16³`) injected from all still,
//     moving, and emissive meshlets for sky occlusion and multi-bounce GI (Crassin et al. 2011)
//   - Auto-extracted GPU dynamic local emitters (`Emitter`, up to 32 clusters) harvested directly
//     from high-`emits` meshlets for crisp GGX specular glints, local soft shadows, and volumetric
//     spell halos—with zero manual light entities in the game layer.

use matter::sky::{Sky, seen}
use matter::substance::{ONE_OVER_PI, Substance}
use mesh::extract::{MeshVertex, prep_list}
use picture::eye::View
use picture::screen::luma
use std::gpu::{
    Address, Append, AppendBuffer, Atomics, ClipPosition, ComparisonSampler, DepthTexture,
    DispatchArgs, Filter, GlobalId, GpuBuffer, GpuSpan, Rgba16Float, Sampler, Slots, Texels,
    Texels3d, Texture, Texture3d, append_buffer, buffer, buffer_of, dispatch, label, sampler,
    texture3d, writable_texture,
}
use std::math::{PI, TAU}

/// Shadow map resolution (square).
pub const SHADOW_SIDE: u32 = 2048

/// Sky irradiance table resolution (octahedral hemisphere map, texels per side).
pub const TABLE: u32 = 32
const GATHER: u32 = 24

/// Specular PMREM octahedral map resolutions (mirror sky dome `128×128`, glossy `32×32`, satin `16×16`).
pub const SPEC0_SIDE: u32 = 128
pub const SPEC1_SIDE: u32 = 32
pub const SPEC2_SIDE: u32 = 16

/// Level-0 radiance volume resolution along each axis (`64×64×64` = 262,144 voxels).
pub const RAD_SIDE: u32 = 64
const RAD_VOXELS: u32 = 262144
const RAD_SCALE: f32 = 256.0
/// 4π: the solid angle of the whole sphere.
pub const FOUR_PI: f32 = 12.5663706

/// Reversed-Z near plane (m): `clip_z = NEAR`, `clip_w = z`, so `ndc_z = NEAR / z` in `(0, 1]`.
pub const NEAR: f32 = 0.005

/// Auto-extracted dynamic local emitters (`8×4×8 = 256` coarse spatial bins -> up to 16 active lights).
const EMIT_CELLS: u32 = 256
const EMIT_STRIDE: u32 = 8
pub const MAX_EMITTERS: u32 = 16
const EMIT_THRESH: f32 = 8.0
const EMIT_SCALE: f32 = 16.0

/// One auto-extracted dynamic local light harvested from emissive meshlets.
pub struct Emitter: Copy + GpuData {
    /// `(world_x, world_y, world_z, effective_radius_m)`.
    pub pos_r: vec4,
    /// `(radiance_r, radiance_g, radiance_b, area_weight)`.
    pub flux_w: vec4,
}

/// Folds a unit direction vector onto an octahedron in `[-1, 1]²`.
pub fn octa(n: vec3) -> vec2 {
    let a = n / (abs(n.x) + abs(n.y) + abs(n.z))
    if a.y >= 0.0 {
        return a.xz
    }
    (vec2(1.0) - abs(vec2(a.z, a.x))) * vec2(if a.x >= 0.0 { 1.0 } else { -1.0 }, if a.z >= 0.0 { 1.0 } else { -1.0 })
}

/// Unfolds an octahedral coordinate in `[-1, 1]²` back to a unit direction vector.
pub fn unocta(e: vec2) -> vec3 {
    var v = vec3(e.x, 1.0 - abs(e.x) - abs(e.y), e.y)
    let t = max(-v.y, 0.0)
    v.x += if v.x >= 0.0 { -t } else { t }
    v.z += if v.z >= 0.0 { -t } else { t }
    normalize(v)
}

/// Builds an orthonormal tangent frame `(u, v)` around unit vector `n` (Duff et al. 2017).
fn basis(n: vec3) -> (vec3, vec3) {
    let s = if n.z >= 0.0 { 1.0 } else { -1.0 }
    let a = -1.0 / (s + n.z)
    let b = n.x * n.y * a
    let u = vec3(1.0 + s * n.x * n.x * a, s * b, -s * n.x)
    let v = vec3(b, s + n.y * n.y * a, -n.y)
    (u, v)
}

/// Projects world point `wp` into eye clip space with reversed-Z depth, matching `View::ray`
/// bit for bit.
pub fn clip_of(v: View, wp: vec3) -> ClipPosition {
    let rel = wp - v.at
    let x = dot(rel, v.right)
    let y = dot(rel, v.up)
    let z = dot(rel, v.forward)
    let aspect = v.size.y / max(v.size.x, 1.0)
    ClipPosition { position: vec4(x * v.focal * aspect, y * v.focal, NEAR, z) }
}

/// Henyey-Greenstein phase function `p(cos_theta, g)` (integrated over sphere = 1).
pub fn hg_phase(cos_t: f32, g: f32) -> f32 {
    let g2 = g * g
    let denom = max(1.0 + g2 - 2.0 * g * cos_t, 1.0e-4)
    (1.0 - g2) / (FOUR_PI * denom * sqrt(denom))
}

/// Encodes `(metallic, ior, coat)` into `[0, 1]` for the 8-bit `Rgba8` G-buffer (`0.5` = matte):
///   `~0.5`   -> pure matte `lambert` (`abs(code) < 0.015`)
///   `< 0.48` -> metallic conductor (`metallic = -code`)
///   `> 0.52` -> dielectric (`ior = 1.5`, uncoated `0.03`, coated `coat >= 0.05`)
pub fn encode_mat_unorm(sub: Substance) -> f32 {
    if sub.metallic > 0.02 {
        return clamp(0.5 - 0.5 * clamp(sub.metallic, 0.04, 1.0), 0.0, 0.48)
    }
    if sub.spec_weight() <= 1.0e-5 && sub.coat <= 1.0e-5 {
        return 0.5
    }
    let c = if sub.coat > 0.04 { clamp(sub.coat, 0.05, 1.0) } else { 0.03 }
    clamp(0.5 + 0.5 * c, 0.515, 1.0)
}

/// Integrates the open sky's cosine-weighted irradiance for every octahedral direction into a
/// `TABLE×TABLE` lookup texture (runs only when the sky changes; 0 ms/frame when still).
@compute(8, 8)
@budget(work: 80000)
pub fn skylit<S: Sky>(sky: S, out: mut Texels<Rgba16Float>, id: GlobalId) {
    if id.x >= TABLE || id.y >= TABLE {
        return
    }
    let n = unocta((vec2(f32(id.x), f32(id.y)) + vec2(0.5)) / f32(TABLE) * 2.0 - vec2(1.0))
    let (u, v) = basis(n)
    var sum = vec3(0.0)
    for i in 0..(GATHER * GATHER) {
        let e = (vec2(f32(i % GATHER), f32(i / GATHER)) + vec2(0.5)) / f32(GATHER)
        let c = sqrt(1.0 - e.x)
        let r = sqrt(max(1.0 - c * c, 0.0))
        let turn = TAU * e.y
        sum += sky.light(normalize(u * (r * cos(turn)) + v * (r * sin(turn)) + n * c))
    }
    out.store(id, vec4(sum * (PI / f32(GATHER * GATHER)), 1.0))
}

/// Radical-inverse base 2 for Hammersley quasi-Monte Carlo sampling (0..32).
fn van_der_corput(bits_in: u32) -> f32 {
    var b = (bits_in << 16) | (bits_in >> 16)
    b = ((b & 0x55555555) << 1) | ((b & 0xAAAAAAAA) >> 1)
    b = ((b & 0x33333333) << 2) | ((b & 0xCCCCCCCC) >> 2)
    b = ((b & 0x0F0F0F0F) << 4) | ((b & 0xF0F0F0F0) >> 4)
    b = ((b & 0x00FF00FF) << 8) | ((b & 0xFF00FF00) >> 8)
    f32(b) * 2.3283064365386963e-10
}

/// Prefilters ANY `S: Sky` for GGX specular reflection at perceptual `roughness` into an octahedral
/// texture of side `side` (runs only when the sky changes; 0 ms/frame when static).
@compute(8, 8)
@budget(work: 80000)
pub fn sky_spec<S: Sky>(sky: S, side: u32, roughness: f32, out: mut Texels<Rgba16Float>, id: GlobalId) {
    if id.x >= side || id.y >= side {
        return
    }
    let n = unocta((vec2(f32(id.x), f32(id.y)) + vec2(0.5)) / f32(side) * 2.0 - vec2(1.0))
    if roughness <= 0.06 {
        // Mirror level: direct sky evaluation (excluding raw sun disc so direct sun specular isn't
        // double-counted, while keeping atmospheric Mie corona and horizon glow razor sharp).
        out.store(id, vec4(sky.light(n), 1.0))
        return
    }
    let (u, v) = basis(n)
    let a = roughness * roughness
    let a2 = a * a
    let n_samples: u32 = 32
    var sum = vec3(0.0)
    var total_w = 0.0
    for i in 0..n_samples {
        let xi1 = (f32(i) + 0.5) / f32(n_samples)
        let xi2 = van_der_corput(i)
        let phi = TAU * xi1
        let cos_t = sqrt(clamp((1.0 - xi2) / max(1.0 + (a2 - 1.0) * xi2, 1.0e-5), 0.0, 1.0))
        let sin_t = sqrt(max(1.0 - cos_t * cos_t, 0.0))
        let h = normalize(u * (cos(phi) * sin_t) + v * (sin(phi) * sin_t) + n * cos_t)
        let l = normalize(h * (2.0 * dot(n, h)) - n)
        let ndl = max(dot(n, l), 0.0)
        if ndl > 0.0 {
            sum += sky.light(l) * ndl
            total_w += ndl
        }
    }
    let rad = if total_w > 1.0e-5 { sum / total_w } else { sky.light(n) }
    out.store(id, vec4(rad, 1.0))
}

/// Persistent GPU cache for ANY `S: Sky`: diffuse irradiance + 3-level GGX specular PMREM.
pub struct SkyCache {
    pub diff: Texture<Rgba16Float>,
    pub spec0: Texture<Rgba16Float>,
    pub spec1: Texture<Rgba16Float>,
    pub spec2: Texture<Rgba16Float>,
    pub s: Sampler,
    sun_way: vec3,
    sun_light: vec3,
    ready: bool,
}

/// Allocates a fresh `SkyCache` (~50 KB total VRAM).
pub fn sky_cache() -> SkyCache {
    SkyCache {
        diff: writable_texture(width: TABLE, height: TABLE),
        spec0: writable_texture(width: SPEC0_SIDE, height: SPEC0_SIDE),
        spec1: writable_texture(width: SPEC1_SIDE, height: SPEC1_SIDE),
        spec2: writable_texture(width: SPEC2_SIDE, height: SPEC2_SIDE),
        s: sampler(filter: Filter::Linear, address: Address::Clamp),
        sun_way: vec3(0.0),
        sun_light: vec3(0.0),
        ready: false,
    }
}

impl SkyCache {
    /// Recomputes sky irradiance and specular PMREM only when `sky` changes (0 ms/frame when static).
    pub fn sync<S: Sky>(mut self, sky: S) {
        let sun = sky.sun()
        if self.ready && length(sun.way - self.sun_way) <= 1.0e-6 && length(sun.light - self.sun_light) <= 1.0e-5 {
            return
        }
        label("mesh_sky")
        dispatch(skylit.bind(sky: sky, out: mut self.diff), over: (TABLE, TABLE))
        dispatch(
            sky_spec.bind(sky: sky, side: SPEC0_SIDE, roughness: 0.04, out: mut self.spec0),
            over: (SPEC0_SIDE, SPEC0_SIDE),
        )
        dispatch(
            sky_spec.bind(sky: sky, side: SPEC1_SIDE, roughness: 0.35, out: mut self.spec1),
            over: (SPEC1_SIDE, SPEC1_SIDE),
        )
        dispatch(
            sky_spec.bind(sky: sky, side: SPEC2_SIDE, roughness: 0.68, out: mut self.spec2),
            over: (SPEC2_SIDE, SPEC2_SIDE),
        )
        self.sun_way = sun.way
        self.sun_light = sun.light
        self.ready = true
    }
}

/// Reads an octahedral map of resolution `side` at direction `d`.
fn sample_octa(tex: Texture<Rgba16Float>, s: Sampler, d: vec3, side: u32) -> vec3 {
    let e = octa(d) * 0.5 + vec2(0.5)
    let fside = f32(side)
    tex.sample_level(s, (e * (fside - 1.0) + vec2(0.5)) / fside, 0.0).xyz
}

/// Reads the cached sky dome (`spec0`) plus crisp analytic sun disc for `sky_fs` (1 texture tap,
/// 0.05 ms at 1080p regardless of how expensive `Sky::light` is).
pub fn sky_background<S: Sky>(sky: S, spec0: Texture<Rgba16Float>, s: Sampler, way: vec3) -> vec3 {
    let base = sample_octa(spec0, s, way, SPEC0_SIDE)
    let sun = sky.sun()
    let c = cos(sun.size)
    if dot(way, sun.way) >= c {
        return base + sun.light / (TAU * max(1.0 - c, 1.0e-9))
    }
    base
}

/// Reads the open sky's cosine-weighted irradiance on a surface facing `n`.
pub fn sky_irradiance(table: Texture<Rgba16Float>, s: Sampler, n: vec3) -> vec3 {
    sample_octa(table, s, n, TABLE)
}

/// Reads the prefiltered sky specular radiance along reflection vector `refl` at `roughness`.
pub fn sky_specular(
    spec0: Texture<Rgba16Float>,
    spec1: Texture<Rgba16Float>,
    spec2: Texture<Rgba16Float>,
    diff: Texture<Rgba16Float>,
    s: Sampler,
    refl: vec3,
    roughness: f32,
) -> vec3 {
    let r = clamp(roughness, 0.0, 1.0)
    if r <= 0.35 {
        let t = r / 0.35
        let a = sample_octa(spec0, s, refl, SPEC0_SIDE)
        let b = sample_octa(spec1, s, refl, SPEC1_SIDE)
        return mix(a, b, vec3(t))
    }
    if r <= 0.68 {
        let t = (r - 0.35) / 0.33
        let a = sample_octa(spec1, s, refl, SPEC1_SIDE)
        let b = sample_octa(spec2, s, refl, SPEC2_SIDE)
        return mix(a, b, vec3(t))
    }
    let t = (r - 0.68) / 0.32
    let a = sample_octa(spec2, s, refl, SPEC2_SIDE)
    let b = sample_octa(diff, s, refl, TABLE) * ONE_OVER_PI
    mix(a, b, vec3(t))
}

/// Orthographic projection for the unified sun shadow map covering the world's bounding sphere.
pub struct ShadowView: Copy + GpuData {
    pub centre: vec3,
    pub radius: f32,
    pub u: vec3,
    pub texel: f32,
    pub v: vec3,
    pub spare: f32,
    pub w: vec3,
    pub spare2: f32,
}

impl ShadowView {
    /// Sun-space position of world point `p`: `(x, y)` in `[-1, 1]` across the map, `z` its depth
    /// in `[0, 1]`.
    pub fn project(self, p: vec3) -> vec3 {
        let d = p - self.centre
        let sx = dot(d, self.u) / self.radius
        let sy = dot(d, self.v) / self.radius
        let sz = (self.radius - dot(d, self.w)) / (2.0 * self.radius)
        vec3(sx, sy, sz)
    }
}

/// Builds a `ShadowView` tightly framing the world bounding sphere `(centre, radius)` from `sun_way`.
pub fn shadow_view(centre: vec3, radius: f32, sun_way: vec3) -> ShadowView {
    let w = normalize(sun_way)
    let up = if abs(w.y) < 0.95 { vec3(0.0, 1.0, 0.0) } else { vec3(1.0, 0.0, 0.0) }
    let u = normalize(cross(up, w))
    let v = cross(w, u)
    let r = max(radius * 1.05, 1.0)
    let texel = (2.0 * r) / f32(SHADOW_SIDE)
    // Snap shadow centre to whole texel increments in light space to prevent shadow-edge shimmer.
    let su = floor(dot(centre, u) / texel) * texel
    let sv = floor(dot(centre, v) / texel) * texel
    let sw = dot(centre, w)
    let snapped = u * su + v * sv + w * sw
    ShadowView {
        centre: snapped,
        radius: r,
        u,
        texel,
        v,
        spare: 0.0,
        w,
        spare2: 0.0,
    }
}

/// Interleaved Gradient Noise (J. Jimenez 2014) in `[0, 1]` for per-pixel PCF rotation.
pub fn ign(px: vec2) -> f32 {
    fract(52.9829189 * fract(dot(px, vec2(0.06711056, 0.00583715))))
}

/// 8-tap rotated Vogel-disk PCF lookup against one shadow cascade with normal-offset bias.
pub fn sun_shadow_soft(
    shadow_map: DepthTexture,
    cmp: ComparisonSampler,
    sv: ShadowView,
    wp: vec3,
    n: vec3,
    px: vec2,
    filter_texels: f32,
) -> f32 {
    let ndl = dot(n, sv.w)
    if ndl <= 0.0 {
        return 0.0
    }
    let slope = sqrt(max(1.0 - ndl * ndl, 0.0))
    let s = sv.project(wp + n * (sv.texel * (1.2 + 1.5 * slope)))
    if abs(s.x) >= 0.995 || abs(s.y) >= 0.995 || s.z <= 0.0 || s.z >= 1.0 {
        return 1.0
    }
    let uv = vec2(s.x * 0.5 + 0.5, 0.5 - s.y * 0.5)
    let rad_uv = filter_texels / f32(SHADOW_SIDE)
    let ref_z = clamp(s.z - 0.00025, 0.0, 1.0)
    let ang0 = ign(px) * TAU
    var sum = 0.0
    for i in 0..8 {
        let r = sqrt((f32(i) + 0.5) * 0.125) * rad_uv
        let a = f32(i) * 2.3999632 + ang0
        let off = vec2(cos(a) * r, sin(a) * r)
        sum += shadow_map.sample_compare_level(cmp, uv + off, ref_z)
    }
    sum * 0.125
}

/// Dual-cascade sun shadow lookup (Near high-res cascade + Far world cascade) with smooth border
/// blend and rotated 8-tap Vogel-disk soft PCF.
pub fn sun_shadow_csm(
    sm_near: DepthTexture,
    sm_far: DepthTexture,
    cmp: ComparisonSampler,
    sv_near: ShadowView,
    sv_far: ShadowView,
    wp: vec3,
    n: vec3,
    px: vec2,
) -> f32 {
    let ndl = dot(n, sv_far.w)
    if ndl <= 0.0 {
        return 0.0
    }
    if sv_near.radius <= 0.0 {
        return sun_shadow_soft(sm_far, cmp, sv_far, wp, n, px, 2.0)
    }
    let d = wp - sv_near.centre
    let m = max(abs(dot(d, sv_near.u)), abs(dot(d, sv_near.v))) / max(sv_near.radius, 0.001)
    if m < 0.84 {
        return sun_shadow_soft(sm_near, cmp, sv_near, wp, n, px, 2.2)
    }
    if m >= 0.96 {
        return sun_shadow_soft(sm_far, cmp, sv_far, wp, n, px, 1.8)
    }
    let t = (m - 0.84) / 0.12
    let s0 = sun_shadow_soft(sm_near, cmp, sv_near, wp, n, px, 2.2)
    let s1 = sun_shadow_soft(sm_far, cmp, sv_far, wp, n, px, 1.8)
    mix(s0, s1, t)
}

/// Short screen-space micro-contact shadow along `sun_way` against resolved reversed-Z depth
/// (grounds boots, wands, and small props in the final 1..16 cm where shadow maps bias away).
pub fn contact_shadow(
    v: View,
    depth: DepthTexture,
    wp: vec3,
    n: vec3,
    sun_way: vec3,
) -> f32 {
    let ndl = dot(n, sun_way)
    if ndl <= 0.05 {
        return 1.0
    }
    let aspect = v.size.y / max(v.size.x, 1.0)
    let w_px = v.size.x
    let h_px = v.size.y
    let p0 = wp + n * 0.015
    for step in 1..6 {
        let t = f32(step) * 0.035
        let p = p0 + sun_way * t
        let rel = p - v.at
        let z = dot(rel, v.forward)
        if z <= NEAR {
            break
        }
        let x_ndc = (dot(rel, v.right) * v.focal * aspect) / z
        let y_ndc = (dot(rel, v.up) * v.focal) / z
        if abs(x_ndc) >= 0.995 || abs(y_ndc) >= 0.995 {
            break
        }
        let sx = u32(clamp((x_ndc * 0.5 + 0.5) * w_px, 0.0, w_px - 1.0))
        let sy = u32(clamp((0.5 - y_ndc * 0.5) * h_px, 0.0, h_px - 1.0))
        let dz = depth.load(sx, sy)
        if dz > 1.0e-6 {
            let scene_z = NEAR / dz
            let diff = z - scene_z
            if diff > 0.012 && diff < 0.22 {
                return 0.35
            }
        }
    }
    1.0
}

/// Screen-Space Specular Reflections (SSR): marches a reflection ray from `wp` along `refl` against
/// `hdr_bg` (`rgb` = linear HDR radiance, `w` = linear eye distance) with 3-step binary hit
/// refinement and smooth screen-edge fade. Returns `vec4(reflected_rgb, confidence)`.
pub fn trace_ssr(
    v: View,
    hdr_bg: Texture<Rgba16Float>,
    bg_s: Sampler,
    wp: vec3,
    n: vec3,
    refl: vec3,
    roughness: f32,
) -> vec4 {
    // Only trace sharp-to-glossy reflections; rough surfaces are already well served by `spec_cone` + PMREM.
    if roughness > 0.52 {
        return vec4(0.0)
    }
    let aspect = v.size.y / max(v.size.x, 1.0)
    let p0 = wp + n * 0.06
    var t_prev = 0.0
    var hit = false
    var hit_t = 0.0
    var hit_uv = vec2(0.0)
    var hit_rgb = vec3(0.0)

    // 16 deterministic geometrically growing steps reaching ~14 m (zero dither speckle on bright emitters).
    var step_len = 0.07
    var t = 0.06
    for _i in 0..16 {
        let p = p0 + refl * t
        let rel = p - v.at
        let z = dot(rel, v.forward)
        if z <= 0.05 {
            break
        }
        let x_ndc = (dot(rel, v.right) * v.focal * aspect) / z
        let y_ndc = (dot(rel, v.up) * v.focal) / z
        if abs(x_ndc) >= 0.99 || abs(y_ndc) >= 0.99 {
            break
        }
        let uv = vec2(x_ndc * 0.5 + 0.5, 0.5 - y_ndc * 0.5)
        let smp = hdr_bg.sample_level(bg_s, uv, 0.0)
        let ray_dist = length(rel)
        let diff = ray_dist - smp.w
        if diff > 0.025 && diff < max(step_len * 2.6, 0.55) && smp.w < 60000.0 {
            hit = true
            hit_t = t
            hit_uv = uv
            hit_rgb = smp.xyz
            break
        }
        t_prev = t
        t += step_len
        step_len *= 1.18
    }
    if !hit {
        return vec4(0.0)
    }
    // 3-step binary search refinement for crisp reflections with zero stair-stepping.
    var lo = t_prev
    var hi = hit_t
    for _r in 0..3 {
        let mid = 0.5 * (lo + hi)
        let p = p0 + refl * mid
        let rel = p - v.at
        let z = max(dot(rel, v.forward), 0.05)
        let uv = vec2((dot(rel, v.right) * v.focal * aspect) / z * 0.5 + 0.5, 0.5 - (dot(rel, v.up) * v.focal) / z * 0.5)
        let smp = hdr_bg.sample_level(bg_s, clamp(uv, vec2(0.002), vec2(0.998)), 0.0)
        if length(rel) > smp.w + 0.02 {
            hi = mid
            hit_uv = uv
            hit_rgb = smp.xyz
        } else {
            lo = mid
        }
    }
    // Soft luminance-preserving clamp in half-res reflections to prevent single-pixel fireflies on wet/coated surfaces.
    let hit_l = luma(hit_rgb)
    let max_l = mix(4.2, 2.2, clamp(roughness * 2.2, 0.0, 1.0))
    let clamped_rgb = if hit_l > max_l { hit_rgb * (max_l / hit_l) } else { hit_rgb }
    let edge = min(min(hit_uv.x, 1.0 - hit_uv.x), min(hit_uv.y, 1.0 - hit_uv.y))
    let edge_fade = clamp(edge / 0.09, 0.0, 1.0)
    let rough_fade = clamp((0.52 - roughness) / 0.24, 0.0, 1.0)
    let back_fade = clamp(1.0 + dot(refl, v.forward) * 0.65, 0.2, 1.0)
    let conf = edge_fade * rough_fade * back_fade
    vec4(clamped_rgb, conf)
}

/// 4-tap PCF lookup against the unified sun shadow map with normal-offset bias.
pub fn sun_shadow(
    shadow_map: DepthTexture,
    cmp: ComparisonSampler,
    sv: ShadowView,
    wp: vec3,
    n: vec3,
) -> f32 {
    let ndl = dot(n, sv.w)
    if ndl <= 0.0 {
        return 0.0
    }
    let slope = sqrt(max(1.0 - ndl * ndl, 0.0))
    let s = sv.project(wp + n * (sv.texel * (1.5 + 1.8 * slope)))
    if abs(s.x) >= 0.999 || abs(s.y) >= 0.999 || s.z <= 0.0 || s.z >= 1.0 {
        return 1.0
    }
    let uv = vec2(s.x * 0.5 + 0.5, 0.5 - s.y * 0.5)
    let o = 0.5 / f32(SHADOW_SIDE)
    let ref_z = clamp(s.z - 0.0003, 0.0, 1.0)
    var sum = 0.0
    sum += shadow_map.sample_compare_level(cmp, uv + vec2(-o, -o), ref_z)
    sum += shadow_map.sample_compare_level(cmp, uv + vec2(o, -o), ref_z)
    sum += shadow_map.sample_compare_level(cmp, uv + vec2(-o, o), ref_z)
    sum += shadow_map.sample_compare_level(cmp, uv + vec2(o, o), ref_z)
    sum * 0.25
}

/// Single-tap sun visibility lookup for volumetrics and voxel injection (no normal offset).
pub fn sun_vis_point(shadow_map: DepthTexture, cmp: ComparisonSampler, sv: ShadowView, wp: vec3) -> f32 {
    let s = sv.project(wp)
    if abs(s.x) >= 0.999 || abs(s.y) >= 0.999 || s.z <= 0.0 || s.z >= 1.0 {
        return 1.0
    }
    let uv = vec2(s.x * 0.5 + 0.5, 0.5 - s.y * 0.5)
    shadow_map.sample_compare_level(cmp, uv, clamp(s.z - 0.0006, 0.0, 1.0))
}

/// Spatial mapping of the world-space radiance volume (`RAD_SIDE³`).
pub struct RadGrid: Copy + GpuData {
    pub origin: vec3,
    pub voxel: f32,
    pub inv_span: f32,
    pub enabled: u32,
    pub pad0: u32,
    pub pad1: u32,
}

/// Builds a voxel-snapped `RadGrid` covering the active world around `(centre, radius)`.
pub fn rad_grid(centre: vec3, radius: f32, enabled: bool) -> RadGrid {
    let half = clamp(radius * 1.05, 4.0, 22.0)
    let span = 2.0 * half
    let voxel = span / f32(RAD_SIDE)
    let raw_origin = centre - vec3(half)
    let origin = floor(raw_origin / voxel) * voxel
    RadGrid {
        origin,
        voxel,
        inv_span: 1.0 / span,
        enabled: if enabled { 1 } else { 0 },
        pad0: 0,
        pad1: 0,
    }
}

/// Clears the first `n` words of a fixed-point accumulation buffer.
@compute(64)
fn clear_u32(n: u32, buf: mut Slots<u32>, id: GlobalId) {
    if id.x >= n {
        return
    }
    buf[id] = 0
}

/// Adds radiance `outgoing` at grid coordinate `uvw` (in `[0, 1)³`) to its voxel in `accum` and,
/// when `peak > thresh`, emission `emits` to its coarse `8×4×8` emitter bin in `emit_accum`.
pub fn deposit(
    uvw: vec3,
    outgoing: vec3,
    emits: vec3,
    peak: f32,
    thresh: f32,
    accum: mut Atomics<u32>,
    emit_accum: mut Atomics<u32>,
) {
    let vx = min(u32(uvw.x * f32(RAD_SIDE)), RAD_SIDE - 1)
    let vy = min(u32(uvw.y * f32(RAD_SIDE)), RAD_SIDE - 1)
    let vz = min(u32(uvw.z * f32(RAD_SIDE)), RAD_SIDE - 1)
    let idx = (vx + (vy << 6) + (vz << 12)) * 4
    let r = u32(clamp(outgoing.x * RAD_SCALE, 0.0, 2000000.0))
    let g = u32(clamp(outgoing.y * RAD_SCALE, 0.0, 2000000.0))
    let b = u32(clamp(outgoing.z * RAD_SCALE, 0.0, 2000000.0))
    let _ = accum.add(idx, r)
    let _ = accum.add(idx + 1, g)
    let _ = accum.add(idx + 2, b)
    let _ = accum.add(idx + 3, 1)

    if peak > thresh {
        let ex = min(u32(uvw.x * 8.0), 7)
        let ey = min(u32(uvw.y * 4.0), 3)
        let ez = min(u32(uvw.z * 8.0), 7)
        let eidx = (ex + (ey << 3) + (ez << 5)) * EMIT_STRIDE
        let qx = u32(clamp(uvw.x * 4095.0, 0.0, 4095.0))
        let qy = u32(clamp(uvw.y * 4095.0, 0.0, 4095.0))
        let qz = u32(clamp(uvw.z * 4095.0, 0.0, 4095.0))
        let er = u32(clamp(emits.x * EMIT_SCALE, 0.0, 65535.0))
        let eg = u32(clamp(emits.y * EMIT_SCALE, 0.0, 65535.0))
        let eb = u32(clamp(emits.z * EMIT_SCALE, 0.0, 65535.0))
        let _ = emit_accum.add(eidx, qx)
        let _ = emit_accum.add(eidx + 1, qy)
        let _ = emit_accum.add(eidx + 2, qz)
        let _ = emit_accum.add(eidx + 3, er)
        let _ = emit_accum.add(eidx + 4, eg)
        let _ = emit_accum.add(eidx + 5, eb)
        let _ = emit_accum.add(eidx + 6, 1)
    }
}

/// Injects extracted meshlet vertices (direct sunlit radiance + emissive glow + previous-frame
/// 1-bounce radiance) into the `64³` atomic accumulation grid AND bins bright emissive vertices
/// into coarse spatial emitter clusters for crisp dynamic specular + local shadow lighting.
@compute(64)
fn rad_inject<S: Sky>(
    verts: [MeshVertex],
    vert_count: [u32],
    cap_verts: u32,
    grid: RadGrid,
    sv: ShadowView,
    sky: S,
    sky_table: Texture<Rgba16Float>,
    sky_s: Sampler,
    shadow_map: DepthTexture,
    cmp: ComparisonSampler,
    prev_rad1: Texture3d<Rgba16Float>,
    rad_s: Sampler,
    accum: mut Atomics<u32>,
    emit_accum: mut Atomics<u32>,
    id: GlobalId,
) {
    let vi = id.x
    let n = min(vert_count[0], cap_verts)
    if vi >= n {
        return
    }
    let vert = verts[vi]
    let wp = vert.pos.xyz
    let uvw = (wp - grid.origin) * grid.inv_span
    if uvw.x < 0.0 || uvw.x >= 1.0 || uvw.y < 0.0 || uvw.y >= 1.0 || uvw.z < 0.0 || uvw.z >= 1.0 {
        return
    }

    let nrm = vert.normal.xyz
    let nl2 = dot(nrm, nrm)
    let normal = if nl2 > 1.0e-12 { nrm * (1.0 / sqrt(nl2)) } else { vec3(0.0, 1.0, 0.0) }
    let sun = sky.sun()
    let ndl = max(dot(normal, sun.way), 0.0)
    let vis = if ndl > 0.0 { sun_shadow(shadow_map, cmp, sv, wp, normal) } else { 0.0 }
    let direct = sun.light * (ndl * vis)

    let sample_uvw = clamp(((wp + normal * (grid.voxel * 1.5)) - grid.origin) * grid.inv_span, vec3(0.01), vec3(0.99))
    let prev = prev_rad1.sample_level(rad_s, sample_uvw, 0.0)
    let sky_est = sky_irradiance(sky_table, sky_s, normal) * (1.0 - clamp(prev.w, 0.0, 0.85))
    let bounce_prev = prev.xyz * PI * 0.75

    // Attenuate raw emission slightly in the voxel bounce grid because auto-extracted local
    // emitters deliver crisp direct illumination & specular; keeps multi-bounce GI natural.
    let emits = vert.emits.xyz
    let emit_peak = max(emits.x, max(emits.y, emits.z))
    let emit_bounce = if emit_peak > EMIT_THRESH { emits * 0.55 } else { emits }
    let outgoing = emit_bounce + vert.albedo.xyz * ONE_OVER_PI * (direct + sky_est * 0.5 + bounce_prev)
    // Auto-extract dynamic local emitters from bright glowing meshlets.
    deposit(uvw, outgoing, emits, emit_peak, EMIT_THRESH, mut accum, mut emit_accum)
}

/// Compacts and spatially merges occupied coarse emissive bins (`8×4×8 = 256`) into at most
/// `MAX_EMITTERS` deduplicated dynamic lights so lights straddling a grid boundary stay ONE
/// energy-conserving emitter with zero boundary popping.
@compute(1)
@budget(work: 32000)
fn emit_compact(
    emit_accum: [u32],
    grid: RadGrid,
    out: mut Append<Emitter>,
    id: GlobalId,
) {
    let _ = id
    let span = 1.0 / max(grid.inv_span, 1.0e-6)
    let base_r = clamp(grid.voxel * 0.75, 0.24, 0.42)
    let merge_d = max(grid.voxel * 4.5, 1.45)
    let merge_r2 = merge_d * merge_d

    var pos_acc = [vec3(0.0); 16]
    var emit_acc = [vec3(0.0); 16]
    var w_acc = [0.0; 16]
    var n_cells = [0.0; 16]
    var count: u32 = 0

    for cell in 0..EMIT_CELLS {
        let base = cell * EMIT_STRIDE
        let cnt = emit_accum[base + 6]
        if cnt == 0 {
            continue
        }
        let inv_cnt = 1.0 / f32(cnt)
        let uvw = vec3(
            f32(emit_accum[base]) * inv_cnt,
            f32(emit_accum[base + 1]) * inv_cnt,
            f32(emit_accum[base + 2]) * inv_cnt,
        ) / 4095.0
        let pos = grid.origin + uvw * span
        let avg_e = vec3(
            f32(emit_accum[base + 3]),
            f32(emit_accum[base + 4]),
            f32(emit_accum[base + 5]),
        ) * (inv_cnt / EMIT_SCALE)
        let w = max(avg_e.x, max(avg_e.y, avg_e.z))

        var merged = false
        for k in 0..count {
            let cur_pos = pos_acc[k] / max(w_acc[k], 1.0e-5)
            let d = pos - cur_pos
            if dot(d, d) <= merge_r2 {
                pos_acc[k] += pos * w
                emit_acc[k] += avg_e * w
                w_acc[k] += w
                n_cells[k] += 1.0
                merged = true
                break
            }
        }
        if !merged && count < MAX_EMITTERS {
            pos_acc[count] = pos * w
            emit_acc[count] = avg_e * w
            w_acc[count] = w
            n_cells[count] = 1.0
            count += 1
        }
    }

    for k in 0..count {
        let inv_w = 1.0 / max(w_acc[k], 1.0e-5)
        let pos = pos_acc[k] * inv_w
        let avg_e = emit_acc[k] * inv_w
        let scale = clamp(1.0 + (sqrt(n_cells[k]) - 1.0) * 0.45, 1.0, 1.55)
        let eff_r = base_r * scale
        let area_w = PI * eff_r * eff_r * 1.25
        let _ = out.push(Emitter {
            pos_r: vec4(pos, eff_r),
            flux_w: vec4(avg_e * area_w, 1.0),
        })
    }
}

/// Resolves fixed-point atomic sums into premultiplied `(radiance * alpha, alpha)` in `rad0` (`64³`).
@compute(4, 4, 4)
fn rad_resolve(accum: [u32], out: mut Texels3d<Rgba16Float>, id: GlobalId) {
    if id.x >= RAD_SIDE || id.y >= RAD_SIDE || id.z >= RAD_SIDE {
        return
    }
    let idx = (id.x + (id.y << 6) + (id.z << 12)) * 4
    let cnt = accum[idx + 3]
    if cnt == 0 {
        out.store(id, vec4(0.0))
        return
    }
    let inv = 1.0 / (RAD_SCALE * f32(cnt))
    let rad = vec3(f32(accum[idx]), f32(accum[idx + 1]), f32(accum[idx + 2])) * inv
    let alpha = clamp(f32(cnt) * 0.35, 0.0, 1.0)
    out.store(id, vec4(rad * alpha, alpha))
}

/// 2×2×2 premultiplied box downsample from `src` into `dst` (size `dst_side³`).
@compute(4, 4, 4)
fn rad_mip(
    src: Texture3d<Rgba16Float>,
    dst_side: u32,
    out: mut Texels3d<Rgba16Float>,
    id: GlobalId,
) {
    if id.x >= dst_side || id.y >= dst_side || id.z >= dst_side {
        return
    }
    let bx = id.x * 2
    let by = id.y * 2
    let bz = id.z * 2
    var sum = vec4(0.0)
    sum += src.load(bx, by, bz)
    sum += src.load(bx + 1, by, bz)
    sum += src.load(bx, by + 1, bz)
    sum += src.load(bx + 1, by + 1, bz)
    sum += src.load(bx, by, bz + 1)
    sum += src.load(bx + 1, by, bz + 1)
    sum += src.load(bx, by + 1, bz + 1)
    sum += src.load(bx + 1, by + 1, bz + 1)
    let avg_rad = sum.xyz * 0.125
    let avg_a = sum.w * 0.125
    let boosted_a = clamp(avg_a * 1.45, 0.0, 1.0)
    let scale = if avg_a > 1.0e-4 { boosted_a / avg_a } else { 1.0 }
    out.store(id, vec4(avg_rad * scale, boosted_a))
}

/// Soft local shadow visibility from surface `wp` toward an auto-extracted emitter at `lp`, traced
/// through the `rad0`/`rad1` occupancy volume with smooth distance fade (no hard radius rings).
fn emitter_vis(
    grid: RadGrid,
    rad0: Texture3d<Rgba16Float>,
    rad1: Texture3d<Rgba16Float>,
    s: Sampler,
    wp: vec3,
    n: vec3,
    lp: vec3,
    lr: f32,
) -> f32 {
    let delta = lp - wp
    let dist = length(delta)
    let start_t = grid.voxel * 1.8
    let end_t = dist - lr - grid.voxel * 1.6
    let span = end_t - start_t
    if span <= 0.0 {
        return 1.0
    }
    let dir = delta / dist
    // Lift slightly along the surface normal so floor/wall pixels never self-shadow in their own voxel.
    let p0 = wp + n * (grid.voxel * 1.8)
    var occ = 0.0
    for step in 0..3 {
        let f = (f32(step) + 0.5) * 0.33333334
        let t = start_t + f * span
        let p = p0 + dir * t
        let uvw = (p - grid.origin) * grid.inv_span
        if uvw.x <= 0.01 || uvw.x >= 0.99 || uvw.y <= 0.01 || uvw.y >= 0.99 || uvw.z <= 0.01 || uvw.z >= 0.99 {
            break
        }
        let smp = rad1.sample_level(s, uvw, 0.0)
        occ += (1.0 - occ) * clamp(smp.w * 0.72, 0.0, 1.0)
        if occ >= 0.92 {
            break
        }
    }
    // Smoothly ramp occlusion in as ray span grows past zero so no circular boundary ever appears.
    let fade = clamp(span / max(grid.voxel * 2.5, 0.25), 0.0, 1.0)
    clamp(1.0 - occ * fade, 0.12, 1.0)
}

/// Evaluates all auto-extracted dynamic local emitters at surface point `(wp, n)` for view `v_dir`.
/// Costs zero loop iterations when no bright emissive matter exists in the scene.
@budget(work: 16000)
pub fn eval_emitters(
    sub: Substance,
    wp: vec3,
    n: vec3,
    v_dir: vec3,
    grid: RadGrid,
    rad0: Texture3d<Rgba16Float>,
    rad1: Texture3d<Rgba16Float>,
    rad_s: Sampler,
    emitters: [Emitter],
    emitter_count: [u32],
) -> vec3 {
    if grid.enabled == 0 {
        return vec3(0.0)
    }
    let n_emit = min(emitter_count[0], MAX_EMITTERS)
    if n_emit == 0 {
        return vec3(0.0)
    }
    var sum = vec3(0.0)
    for i in 0..n_emit {
        let em = emitters[i]
        let to_l = em.pos_r.xyz - wp
        let d2 = dot(to_l, to_l)
        let r = em.pos_r.w
        if d2 < 1.0e-5 {
            continue
        }
        // A glowing surface inside an emitter's own sphere is part of that emitter: the light it
        // gives is already its emission, so it is never lit by itself (however dim its glow).
        if d2 < r * r * 1.15 && max(sub.emits.x, max(sub.emits.y, sub.emits.z)) > 1.0e-3 {
            continue
        }
        let d = sqrt(d2)
        let l = to_l / d
        if dot(n, l) <= 0.0 && sub.subsurface <= 1.0e-4 {
            continue
        }
        let atten = 1.0 / (d2 + r * r)
        let irrad = em.flux_w.xyz * atten
        let peak_i = max(irrad.x, max(irrad.y, irrad.z))
        if peak_i < 0.035 {
            continue
        }
        let vis = if peak_i >= 0.085 {
            emitter_vis(grid, rad0, rad1, rad_s, wp, n, em.pos_r.xyz, r)
        } else {
            1.0
        }
        sum += sub.shade_direct(n, l, v_dir, irrad * vis)
    }
    sum
}

/// Fast direct dynamic emitter evaluation without per-pixel 3D occupancy shadow marching (used on
/// tiny airborne swarm grains where shadow marches are imperceptible and 6× faster).
@budget(work: 6000)
pub fn eval_emitters_fast(
    sub: Substance,
    wp: vec3,
    n: vec3,
    v_dir: vec3,
    grid: RadGrid,
    emitters: [Emitter],
    emitter_count: [u32],
) -> vec3 {
    if grid.enabled == 0 {
        return vec3(0.0)
    }
    let n_emit = min(emitter_count[0], MAX_EMITTERS)
    if n_emit == 0 {
        return vec3(0.0)
    }
    var sum = vec3(0.0)
    for i in 0..n_emit {
        let em = emitters[i]
        let to_l = em.pos_r.xyz - wp
        let d2 = dot(to_l, to_l)
        let r = em.pos_r.w
        if d2 < 1.0e-5 {
            continue
        }
        let d = sqrt(d2)
        let l = to_l / d
        if dot(n, l) <= 0.0 && sub.subsurface <= 1.0e-4 {
            continue
        }
        let irrad = em.flux_w.xyz / (d2 + r * r)
        if max(irrad.x, max(irrad.y, irrad.z)) < 0.04 {
            continue
        }
        sum += sub.shade_direct(n, l, v_dir, irrad)
    }
    sum
}

/// Evaluates auto-extracted dynamic local emitters for a volumetric froxel at `wp` along view `ray`.
pub fn eval_emitters_vol(
    wp: vec3,
    ray: vec3,
    g: f32,
    grid: RadGrid,
    emitters: [Emitter],
    emitter_count: [u32],
) -> vec3 {
    if grid.enabled == 0 {
        return vec3(0.0)
    }
    let n_emit = min(emitter_count[0], MAX_EMITTERS)
    if n_emit == 0 {
        return vec3(0.0)
    }
    var sum = vec3(0.0)
    for i in 0..n_emit {
        let em = emitters[i]
        let to_l = em.pos_r.xyz - wp
        let d2 = dot(to_l, to_l)
        let r = em.pos_r.w
        let d = sqrt(max(d2, 1.0e-4))
        let l = to_l / d
        let phase = hg_phase(dot(ray, l), g)
        let atten = 1.0 / (d2 + r * r + 0.15)
        sum += em.flux_w.xyz * (atten * phase)
    }
    sum
}

/// Traces one diffuse cone through the 3-level radiance volume, returning `vec4(bounce_rad, occlusion)`.
fn trace_cone(
    grid: RadGrid,
    rad0: Texture3d<Rgba16Float>,
    rad1: Texture3d<Rgba16Float>,
    rad2: Texture3d<Rgba16Float>,
    s: Sampler,
    origin: vec3,
    dir: vec3,
) -> vec4 {
    var rad = vec3(0.0)
    var occ = 0.0
    let v = grid.voxel

    let dists = [1.3, 2.8, 5.6, 10.8]
    for step in 0..4 {
        if occ >= 0.96 {
            break
        }
        let p = origin + dir * (dists[step] * v)
        let uvw = (p - grid.origin) * grid.inv_span
        if uvw.x <= 0.01 || uvw.x >= 0.99 || uvw.y <= 0.01 || uvw.y >= 0.99 || uvw.z <= 0.01 || uvw.z >= 0.99 {
            break
        }
        let smp_occ = if step == 0 {
            rad0.sample_level(s, uvw, 0.0)
        } else if step < 3 {
            rad1.sample_level(s, uvw, 0.0)
        } else {
            rad2.sample_level(s, uvw, 0.0)
        }
        let smp_rad = if step < 2 {
            rad1.sample_level(s, uvw, 0.0)
        } else {
            rad2.sample_level(s, uvw, 0.0)
        }
        let a = clamp(smp_occ.w, 0.0, 1.0)
        let w = 1.0 - occ
        rad += w * smp_rad.xyz
        occ += w * a
    }
    vec4(rad, clamp(occ, 0.0, 1.0))
}

/// Computes unified indirect lighting at surface point `(wp, n)` via 4 hemisphere diffuse cones
/// (1 normal + 3 tilted at 120°): returns `vec4(bounce_irradiance.rgb, sky_visibility)`.
@budget(work: 4000)
pub fn cone_indirect(
    grid: RadGrid,
    rad0: Texture3d<Rgba16Float>,
    rad1: Texture3d<Rgba16Float>,
    rad2: Texture3d<Rgba16Float>,
    s: Sampler,
    wp: vec3,
    n: vec3,
) -> vec4 {
    if grid.enabled == 0 {
        return vec4(0.0, 0.0, 0.0, 1.0)
    }
    let up = if abs(n.y) < 0.9 { vec3(0.0, 1.0, 0.0) } else { vec3(1.0, 0.0, 0.0) }
    let t = normalize(cross(up, n))
    let b = cross(n, t)
    let p0 = wp + n * (grid.voxel * 1.15)

    let cn = trace_cone(grid, rad0, rad1, rad2, s, p0, n)
    let c0 = trace_cone(grid, rad0, rad1, rad2, s, p0, normalize(n * 0.55 + t * 0.835))
    let c1 = trace_cone(grid, rad0, rad1, rad2, s, p0, normalize(n * 0.55 - t * 0.4175 + b * 0.723))
    let c2 = trace_cone(grid, rad0, rad1, rad2, s, p0, normalize(n * 0.55 - t * 0.4175 - b * 0.723))

    let rad = cn.xyz * 0.34 + (c0.xyz + c1.xyz + c2.xyz) * 0.22
    let occ = cn.w * 0.34 + (c0.w + c1.w + c2.w) * 0.22
    let sky_vis = clamp(1.0 - occ * 0.85, 0.15, 1.0)
    vec4(rad * PI, sky_vis)
}

/// Traces one glossy specular cone through the radiance volume along reflection direction `refl`,
/// returning `vec4(reflected_world_radiance, opacity)` for world-space reflection blending.
pub fn spec_cone(
    grid: RadGrid,
    rad0: Texture3d<Rgba16Float>,
    rad1: Texture3d<Rgba16Float>,
    rad2: Texture3d<Rgba16Float>,
    s: Sampler,
    wp: vec3,
    n: vec3,
    refl: vec3,
    roughness: f32,
) -> vec4 {
    if grid.enabled == 0 {
        return vec4(0.0)
    }
    let p0 = wp + n * (grid.voxel * 1.25)
    let v = grid.voxel
    var rad = vec3(0.0)
    var occ = 0.0
    let dists = [1.4, 3.0, 5.8, 10.5]
    for step in 0..4 {
        if occ >= 0.95 {
            break
        }
        let p = p0 + refl * (dists[step] * v)
        let uvw = (p - grid.origin) * grid.inv_span
        if uvw.x <= 0.01 || uvw.x >= 0.99 || uvw.y <= 0.01 || uvw.y >= 0.99 || uvw.z <= 0.01 || uvw.z >= 0.99 {
            break
        }
        let use_coarse = roughness > 0.45 || step >= 2
        let smp = if step == 0 && roughness < 0.35 {
            rad0.sample_level(s, uvw, 0.0)
        } else if !use_coarse || step < 3 {
            rad1.sample_level(s, uvw, 0.0)
        } else {
            rad2.sample_level(s, uvw, 0.0)
        }
        let w = 1.0 - occ
        rad += w * smp.xyz
        occ += w * clamp(smp.w, 0.0, 1.0)
    }
    vec4(rad, clamp(occ, 0.0, 1.0))
}

/// Fast isotropic indirect radiance sample for volumetric froxels (fog, smoke, mist).
pub fn volume_indirect(
    grid: RadGrid,
    rad1: Texture3d<Rgba16Float>,
    rad2: Texture3d<Rgba16Float>,
    s: Sampler,
    wp: vec3,
) -> vec3 {
    if grid.enabled == 0 {
        return vec3(0.0)
    }
    let uvw = (wp - grid.origin) * grid.inv_span
    if uvw.x <= 0.01 || uvw.x >= 0.99 || uvw.y <= 0.01 || uvw.y >= 0.99 || uvw.z <= 0.01 || uvw.z >= 0.99 {
        return vec3(0.0)
    }
    let s1 = rad1.sample_level(s, uvw, 0.0)
    let s2 = rad2.sample_level(s, uvw, 0.0)
    (s1.xyz * 0.65 + s2.xyz * 0.35) * PI
}

/// Persistent GPU buffers and 3-level 3D textures for the unified world-space radiance cache
/// and auto-extracted dynamic local emitters.
pub struct RadianceCache {
    pub accum: GpuBuffer<u32>,
    pub emit_accum: GpuBuffer<u32>,
    pub emitters: AppendBuffer<Emitter>,
    pub inject_args: GpuBuffer<DispatchArgs>,
    pub rad0: Texture3d<Rgba16Float>,
    pub rad1: Texture3d<Rgba16Float>,
    pub rad2: Texture3d<Rgba16Float>,
    pub s: Sampler,
    pub grid: RadGrid,
}

/// Allocates a fresh `RadianceCache` (~6.3 MB total VRAM).
pub fn radiance_cache() -> RadianceCache {
    RadianceCache {
        accum: buffer(RAD_VOXELS * 4),
        emit_accum: buffer(EMIT_CELLS * EMIT_STRIDE),
        emitters: append_buffer(MAX_EMITTERS),
        inject_args: buffer_of([DispatchArgs { x: 0, y: 1, z: 1 }]),
        rad0: texture3d(width: RAD_SIDE, height: RAD_SIDE, depth: RAD_SIDE),
        rad1: texture3d(width: RAD_SIDE / 2, height: RAD_SIDE / 2, depth: RAD_SIDE / 2),
        rad2: texture3d(width: RAD_SIDE / 4, height: RAD_SIDE / 4, depth: RAD_SIDE / 4),
        s: sampler(filter: Filter::Linear, address: Address::Clamp),
        grid: rad_grid(vec3(0.0), 10.0, enabled: false),
    }
}

impl RadianceCache {
    /// Begins a radiance volume + dynamic emitter rebuild for the world around `(centre, radius)`.
    pub fn begin(mut self, centre: vec3, radius: f32, enabled: bool) {
        self.grid = rad_grid(centre, radius, enabled: enabled)
        if !enabled {
            return
        }
        label("mesh_radiance")
        dispatch(clear_u32.bind(n: RAD_VOXELS * 4, buf: mut self.accum), over: RAD_VOXELS * 4)
        let emit_n = EMIT_CELLS * EMIT_STRIDE
        dispatch(clear_u32.bind(n: emit_n, buf: mut self.emit_accum), over: emit_n)
        self.emitters.clear()
    }

    /// Injects one meshlet batch's vertices into the active radiance volume and emitter bins.
    pub fn inject<S: Sky>(
        mut self,
        verts: GpuSpan<MeshVertex>,
        vert_count: GpuSpan<u32>,
        cap_verts: u32,
        sv: ShadowView,
        sky: S,
        sky_table: Texture<Rgba16Float>,
        sky_s: Sampler,
        shadow_map: DepthTexture,
        cmp: ComparisonSampler,
    ) {
        if self.grid.enabled == 0 {
            return
        }
        dispatch(
            prep_list.bind(count: vert_count, cap: cap_verts, args: mut self.inject_args),
            over: 1,
        )
        dispatch(
            rad_inject.bind(
                verts: verts,
                vert_count: vert_count,
                cap_verts: cap_verts,
                grid: self.grid,
                sv: sv,
                sky: sky,
                sky_table: sky_table,
                sky_s: sky_s,
                shadow_map: shadow_map,
                cmp: cmp,
                prev_rad1: self.rad1,
                rad_s: self.s,
                accum: mut self.accum,
                emit_accum: mut self.emit_accum,
            ),
            groups: self.inject_args,
            most: (cap_verts + 63) / 64,
        )
    }

    /// Resolves accumulated radiance into `rad0` (`64³`), builds the `32³` and `16³` mip chain,
    /// and compacts bright emissive clusters into `self.emitters`.
    pub fn finish(mut self) {
        if self.grid.enabled == 0 {
            return
        }
        dispatch(
            rad_resolve.bind(accum: self.accum.items(), out: mut self.rad0),
            over: (RAD_SIDE, RAD_SIDE, RAD_SIDE),
        )
        let s1 = RAD_SIDE / 2
        dispatch(
            rad_mip.bind(src: self.rad0, dst_side: s1, out: mut self.rad1),
            over: (s1, s1, s1),
        )
        let s2 = RAD_SIDE / 4
        dispatch(
            rad_mip.bind(src: self.rad1, dst_side: s2, out: mut self.rad2),
            over: (s2, s2, s2),
        )
        dispatch(
            emit_compact.bind(
                emit_accum: self.emit_accum.items(),
                grid: self.grid,
                out: mut self.emitters,
            ),
            over: 1,
        )
    }
}
