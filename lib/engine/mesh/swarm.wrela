// GPU field-driven discrete matter swarm solver (`SwarmSim`): simulates up to `SWARM_CAP` (65,536)
// physical grains/shards/sparks on the GPU with exact analytical `World` SDF collision (the SDF
// clipmap only rules out grains certainly clear of everything; `distance` then `sample` normal on
// contact), injects luminous grains into the unified radiance volume + dynamic local emitters,
// casts real shadows into the unified sun shadow map, and rasterises 3D shaded impostors directly
// into the 1× G-buffer eye pass.

use matter::substance::Substance
use matter::swarm::Swarm
use mesh::light::{RadGrid, ShadowView, clip_of, deposit, encode_mat_signed}
use mesh::proof::{discard_proven, prove_outside_disc}
use mesh::sdf::{GRAIN_MOST, SDF_MAX, SdfGrid, sdf_sample}
use mesh::tsr::project_uv_unjittered
use picture::eye::View
use std::derive::value_and_gradient
use std::field::{Bound, Field, hash_u32}
use std::gpu::{
    Atomics, ClipPosition, GlobalId, GpuBuffer, GpuSpan, InstanceIndex, R16Float, Sampler, Slots,
    Targets4, Texture3d, VertexIndex, buffer, dispatch, label,
}

/// Maximum number of simulated grains in one `SwarmSim` (65,536 grains × 48 B = 3.1 MB per buffer).
pub const SWARM_CAP: u32 = 65536

/// Per-grain GPU state (48 bytes, std430-aligned).
pub struct Grain: Copy + GpuData {
    /// `(world_x, world_y, world_z, radius)`.
    pub pos_r: vec4,
    /// `(vel_x, vel_y, vel_z, age_s)` (`age_s < 0.0` while waiting for staggered emission).
    pub vel_age: vec4,
    /// `(max_life_s, seed_hash_01, alive_flag, pad)`.
    pub meta: vec4,
}

/// Interpolants for physically shaded 3D grain impostors inside `mesh_eye`.
pub struct SwarmVary: Copy {
    pub clip: ClipPosition,
    pub wp: vec3,
    pub prev_wp: vec3,
    pub uv: vec2,
    /// The impostor's `uv` axes on the screen: `(dx, dy)` turns `right` toward `up` (`(1, 0)` unturned).
    pub turn: vec2,
    pub albedo: vec3,
    pub emits: vec3,
    pub pbr: vec4,
    pub optics: vec4,
}

/// Deterministic float hash in `[0, 1)` from grain index `i`.
fn grain_hash(i: u32) -> f32 {
    f32(hash_u32(i ^ 0x9e3779b9) & 16777215) / 16777216.0
}

/// Pass 0: Spawns grains from `swarm.seed_at(id.x)` into `dst` (runs only when `swarm.epoch()` changes).
@compute(64)
fn swarm_spawn<Sw: Swarm>(swarm: Sw, count: u32, dst: mut Slots<Grain>, id: GlobalId) {
    if id.x >= count {
        return
    }
    let s = swarm.seed_at(id.x)
    let delay = max(swarm.seed_delay(id.x), 0.0)
    let alive = if s.life > 0.0 && s.radius > 1.0e-5 { 1.0 } else { 0.0 }
    dst[id] = Grain {
        pos_r: vec4(s.pos, max(s.radius, 0.0)),
        vel_age: vec4(s.vel, -delay),
        meta: vec4(max(s.life, 0.0), grain_hash(id.x), alive, 0.0),
    }
}

/// Pass 1a: Advances every grain under `swarm.force_at` + aerodynamic drag and tests the 1-tap
/// hardware 3D SDF clipmap broad-phase, setting `meta.w = 1.0` only for grains near a surface so
/// subsequent analytical collision passes skip >90% of grains in flight.
@compute(64)
fn swarm_integrate<Sw: Swarm>(
    swarm: Sw,
    sdf_grid: SdfGrid,
    sdf0: Texture3d<R16Float>,
    sdf1: Texture3d<R16Float>,
    sdf_s: Sampler,
    count: u32,
    src: [Grain],
    dst: mut Slots<Grain>,
    id: GlobalId,
) {
    if id.x >= count {
        return
    }
    let g = src[id.x]
    if g.meta.z < 0.5 {
        dst[id] = g
        return
    }
    let dt = clamp(swarm.step_dt(), 0.001, 0.05)
    let age = g.vel_age.w + dt
    if age < 0.0 {
        dst[id] = Grain {
            pos_r: g.pos_r,
            vel_age: vec4(g.vel_age.xyz, age),
            meta: vec4(g.meta.x, g.meta.y, g.meta.z, 0.0),
        }
        return
    }
    let life = g.meta.x
    if age >= life {
        if swarm.looping() {
            let s = swarm.seed_at(id.x)
            let alive = if s.life > 0.0 && s.radius > 1.0e-5 { 1.0 } else { 0.0 }
            dst[id] = Grain {
                pos_r: vec4(s.pos, max(s.radius, 0.0)),
                vel_age: vec4(s.vel, 0.0),
                meta: vec4(max(s.life, 0.0), g.meta.y, alive, 0.0),
            }
        } else {
            dst[id] = Grain {
                pos_r: g.pos_r,
                vel_age: vec4(0.0, 0.0, 0.0, age),
                meta: vec4(life, g.meta.y, 0.0, 0.0),
            }
        }
        return
    }

    var pos = g.pos_r.xyz
    let r = g.pos_r.w
    var vel = g.vel_age.xyz
    let h = g.meta.y

    let acc = swarm.force_at(pos, vel, age, h)
    let damp = exp(-max(swarm.drag(), 0.0) * dt)
    vel = vel * damp + acc * dt
    pos = pos + vel * dt

    var near = true
    if sdf_grid.enabled != 0 && r <= GRAIN_MOST {
        let coarse = sdf_sample(sdf_grid, sdf0, sdf1, sdf_s, pos)
        near = coarse >= SDF_MAX * 0.999 || coarse < r + 1.7320508 * sdf_grid.v1
    }

    dst[id] = Grain {
        pos_r: vec4(pos, r),
        vel_age: vec4(vel, age),
        meta: vec4(life, h, 1.0, if near { 1.0 } else { 0.0 }),
    }
}

/// Pass 1b (single field): Resolves exact analytical SDF collision against `field` for any grain
/// flagged `near` (`meta.w > 0.5`) by the 3D SDF clipmap broad-phase. `bound` is precomputed on the
/// CPU so the GPU skips out-of-bound grains in O(1) without recomputing uniform bounds per thread.
@compute(64)
@budget(work: 20000)
fn swarm_collide_one<F: Field<Substance>>(
    field: F,
    bound: Bound,
    restitution: f32,
    friction: f32,
    count: u32,
    src: [Grain],
    dst: mut Slots<Grain>,
    id: GlobalId,
) {
    if id.x >= count {
        return
    }
    let g = src[id.x]
    if g.meta.z < 0.5 || g.vel_age.w < 0.0 || g.meta.w < 0.5 {
        dst[id] = g
        return
    }
    var pos = g.pos_r.xyz
    let r = g.pos_r.w
    var vel = g.vel_age.xyz
    if bound.below(pos) < r {
        let d0 = field.distance(pos)
        if d0 < r {
            let (d, grad) = value_and_gradient(|q| field.distance(q), pos)
            let gl2 = dot(grad, grad)
            let n = if gl2 > 1.0e-10 { grad * (1.0 / sqrt(gl2)) } else { vec3(0.0, 1.0, 0.0) }
            pos = pos + n * (r - d + 0.002)
            let vn = dot(vel, n)
            if vn < 0.0 {
                let vt = vel - n * vn
                vel = vt * friction - n * (vn * restitution)
            }
        }
    }
    dst[id] = Grain { pos_r: vec4(pos, r), vel_age: vec4(vel, g.vel_age.w), meta: g.meta }
}

/// Maximum number of pool fields tested per `swarm_collide_pool` dispatch so the GPU guard can
/// prove every dispatch finishes well under 50 ms for arbitrarily large dynamic `Pool`s.
const COLLIDE_CHUNK: u32 = 32

/// Pass 1b (dynamic pool): Resolves exact analytical SDF collision against a chunk of up to
/// `COLLIDE_CHUNK` fields in a dynamic `Pool<M>` (skipping out-of-bound fields in O(1) via
/// precomputed `bounds[i].below(pos)`).
@compute(64)
@budget(work: 24000)
fn swarm_collide_pool<F: Field<Substance>>(
    fields: [F],
    bounds: [Bound],
    n_fields: u32,
    restitution: f32,
    friction: f32,
    count: u32,
    src: [Grain],
    dst: mut Slots<Grain>,
    id: GlobalId,
) {
    if id.x >= count {
        return
    }
    let g = src[id.x]
    if g.meta.z < 0.5 || g.vel_age.w < 0.0 || g.meta.w < 0.5 {
        dst[id] = g
        return
    }
    var pos = g.pos_r.xyz
    let r = g.pos_r.w
    var vel = g.vel_age.xyz
    let lim = min(n_fields, COLLIDE_CHUNK)
    for i in 0..lim {
        if bounds[i].below(pos) < r {
            let f = fields[i]
            let d0 = f.distance(pos)
            if d0 < r {
                let (d, grad) = value_and_gradient(|q| f.distance(q), pos)
                let gl2 = dot(grad, grad)
                let n = if gl2 > 1.0e-10 { grad * (1.0 / sqrt(gl2)) } else { vec3(0.0, 1.0, 0.0) }
                pos = pos + n * (r - d + 0.002)
                let vn = dot(vel, n)
                if vn < 0.0 {
                    let vt = vel - n * vn
                    vel = vt * friction - n * (vn * restitution)
                }
            }
        }
    }
    dst[id] = Grain { pos_r: vec4(pos, r), vel_age: vec4(vel, g.vel_age.w), meta: g.meta }
}

/// Injects luminous grains into the unified radiance cache (`rad_accum`) and dynamic emitter bins
/// (`emit_accum`) so glowing transmutation clouds light surrounding stone walls and mist in real time.
@compute(64)
fn swarm_inject_rad<Sw: Swarm>(
    swarm: Sw,
    grains: [Grain],
    count: u32,
    grid: RadGrid,
    accum: mut Atomics<u32>,
    emit_accum: mut Atomics<u32>,
    id: GlobalId,
) {
    let gi = id.x * 4
    if gi >= count {
        return
    }
    let g = grains[gi]
    if g.meta.z < 0.5 || g.vel_age.w < 0.0 {
        return
    }
    let pos = g.pos_r.xyz
    let sub = swarm.substance_at(pos, g.vel_age.xyz, g.vel_age.w, g.meta.y)
    if max(sub.emits.x, max(sub.emits.y, sub.emits.z)) <= 0.2 {
        return
    }
    let uvw = (pos - grid.origin) * grid.inv_span
    if uvw.x < 0.0 || uvw.x >= 1.0 || uvw.y < 0.0 || uvw.y >= 1.0 || uvw.z < 0.0 || uvw.z >= 1.0 {
        return
    }
    // A grain only glows: it reflects nothing the volume keeps; the brightest hand their glow to
    // the local lights (`deposit`).
    deposit(uvw, vec3(0.0), sub.emits, mut accum, mut emit_accum)
}

/// Shadow-map vertex shader for `Swarm` grains (billboarded toward the sun).
@vertex
pub fn swarm_shadow_vs(
    grains: [Grain],
    sv: ShadowView,
    vi: VertexIndex,
    ii: InstanceIndex,
) -> ClipPosition {
    let g = grains[ii.index]
    if g.meta.z < 0.5 || g.vel_age.w < 0.0 || g.pos_r.w <= 1.0e-5 {
        return ClipPosition { position: vec4(0.0, 0.0, 0.0, 0.0) }
    }
    let c = vi.index
    let sx = if c == 1 || c == 2 || c == 4 { 1.0 } else { -1.0 }
    let sy = if c == 2 || c == 4 || c == 5 { 1.0 } else { -1.0 }
    let r = g.pos_r.w * 1.1
    let wp = g.pos_r.xyz + sv.u * (sx * r) + sv.v * (sy * r)
    ClipPosition { position: vec4(sv.project(wp), 1.0) }
}

/// Eye-pass vertex shader for physically shaded 3D grain impostors (velocity-stretched when fast,
/// crisp spheres/shards when slow, matching `View::ray` bit-for-bit with reversed-Z depth).
@vertex
pub fn swarm_vs<Sw: Swarm>(
    swarm: Sw,
    grains: [Grain],
    v: View,
    vi: VertexIndex,
    ii: InstanceIndex,
) -> SwarmVary {
    let g = grains[ii.index]
    if g.meta.z < 0.5 || g.vel_age.w < 0.0 || g.pos_r.w <= 1.0e-5 {
        return SwarmVary {
            clip: ClipPosition { position: vec4(0.0, 0.0, 0.0, 0.0) },
            wp: vec3(0.0),
            prev_wp: vec3(0.0),
            uv: vec2(0.0),
            turn: vec2(1.0, 0.0),
            albedo: vec3(0.0),
            emits: vec3(0.0),
            pbr: vec4(1.0, 0.0, 1.0, 1.0),
            optics: vec4(0.0),
        }
    }
    let c = vi.index
    let ux = if c == 1 || c == 2 || c == 4 { 1.0 } else { -1.0 }
    let uy = if c == 2 || c == 4 || c == 5 { 1.0 } else { -1.0 }

    let pos = g.pos_r.xyz
    let vel = g.vel_age.xyz
    let r = g.pos_r.w
    let rel_c = pos - v.at
    let zc = dot(rel_c, v.forward)
    // Ensure tiny sand grains stay at least ~1.1 screen pixels wide so they shimmer crisply without vanishing.
    let min_r = max(zc * v.pixel() * 0.65, r)

    // Subtle velocity stretch along camera-plane velocity projection for flying shards & sparks.
    let speed = length(vel)
    let v_cam_x = dot(vel, v.right)
    let v_cam_y = dot(vel, v.up)
    let v2 = v_cam_x * v_cam_x + v_cam_y * v_cam_y
    var turn = vec2(1.0, 0.0)
    var stretch = 1.0
    if v2 > 0.25 {
        turn = vec2(v_cam_x, v_cam_y) * (1.0 / sqrt(v2))
        stretch = clamp(1.0 + speed * 0.14, 1.0, 2.8)
    }
    let axis_u = v.right * turn.x + v.up * turn.y
    let axis_v = v.right * (-turn.y) + v.up * turn.x

    let wp = pos + axis_u * (ux * min_r * stretch) + axis_v * (uy * min_r)
    let dt = clamp(swarm.step_dt(), 0.001, 0.05)
    let prev_wp = wp - vel * dt
    let clip = clip_of(v, wp)

    let sub = swarm.substance_at(pos, vel, g.vel_age.w, g.meta.y)
    SwarmVary {
        clip,
        wp,
        prev_wp,
        uv: vec2(ux, uy),
        turn,
        albedo: sub.albedo,
        emits: sub.emits,
        pbr: vec4(sub.roughness, sub.metallic, sub.ior, 1.0),
        optics: vec4(sub.transmission, sub.subsurface, sub.coat, 0.0),
    }
}

/// Lean 3D sphere/shard impostor G-buffer fragment shader writing `(normal, 1)`, `(albedo, roughness)`,
/// `(emits, mat_code)`, and exact analytical screen-space motion vector into the 1× eye pass.
@fragment
pub fn swarm_fs(vary: SwarmVary, v: View, prev_v: View) -> Targets4<vec4, vec4, vec4, vec2> {
    let r2 = dot(vary.uv, vary.uv)
    match prove_outside_disc(r2, 1.0) {
        Some(p) => discard_proven(p),
        None => {},
    }
    let nz = sqrt(max(1.0 - r2, 0.0))
    // The sphere's normal in the impostor's own (velocity-turned) axes.
    let axis_u = v.right * vary.turn.x + v.up * vary.turn.y
    let axis_v = v.right * (-vary.turn.y) + v.up * vary.turn.x
    let n = normalize(axis_u * vary.uv.x + axis_v * vary.uv.y - v.forward * nz)
    let sub = Substance {
        albedo: clamp(vary.albedo, vec3(0.0), vec3(1.0)),
        roughness: clamp(vary.pbr.x, 0.02, 1.0),
        emits: max(vary.emits, vec3(0.0)),
        metallic: clamp(vary.pbr.y, 0.0, 1.0),
        ior: max(vary.pbr.z, 1.0),
        transmission: 0.0,
        subsurface: clamp(vary.optics.y, 0.0, 1.0),
        coat: clamp(vary.optics.z, 0.0, 1.0),
        micro: 0.0,
        bump: 0.0,
        pad1: 0.0,
        pad2: 0.0,
    }
    let motion = project_uv_unjittered(prev_v, vary.prev_wp) - project_uv_unjittered(v, vary.wp)
    Targets4 {
        first: vec4(n * 0.5 + vec3(0.5), 1.0),
        second: vec4(sub.albedo, sub.roughness),
        third: vec4(sub.emits, encode_mat_signed(sub)),
        fourth: motion,
    }
}

/// Persistent ping-pong GPU grain buffers for a `Swarm`.
pub struct SwarmSim {
    pub a: GpuBuffer<Grain>,
    pub b: GpuBuffer<Grain>,
    pub front_is_a: bool,
    pub count: u32,
    epoch: u32,
    initialized: bool,
}

/// Allocates a fresh `SwarmSim` (`SWARM_CAP = 65,536` grains, ~6.2 MB VRAM across ping-pong buffers).
pub fn swarm_sim() -> SwarmSim {
    SwarmSim {
        a: buffer(SWARM_CAP),
        b: buffer(SWARM_CAP),
        front_is_a: true,
        count: 0,
        epoch: 0,
        initialized: false,
    }
}

impl SwarmSim {
    /// The buffer holding the grains' current state.
    pub fn front(self) -> GpuSpan<Grain> {
        if self.front_is_a { self.a.items() } else { self.b.items() }
    }

    /// Prepares the swarm for stepping this frame: spawns if uninitialized or epoch changed, and
    /// returns how many `(integrate + collide)` steps to execute (`0` if inactive).
    pub fn begin_update<Sw: Swarm>(mut self, swarm: Sw) -> u32 {
        if !swarm.active() {
            self.count = 0
            return 0
        }
        let n = min(swarm.count(), SWARM_CAP)
        self.count = n
        if n == 0 {
            return 0
        }
        label("mesh_swarm")
        let ep = swarm.epoch()
        if !self.initialized || self.epoch != ep {
            dispatch(swarm_spawn.bind(swarm: swarm, count: n, dst: mut self.a), over: n)
            self.front_is_a = true
            self.epoch = ep
            self.initialized = true
            return min(swarm.prewarm_steps(), 60)
        }
        1
    }

    /// Integrates one step of forces + drag + SDF clipmap broad-phase (`meta.w` near flag).
    pub fn integrate_once<Sw: Swarm>(
        mut self,
        swarm: Sw,
        sdf_grid: SdfGrid,
        sdf0: Texture3d<R16Float>,
        sdf1: Texture3d<R16Float>,
        sdf_s: Sampler,
    ) {
        let n = self.count
        if n == 0 {
            return
        }
        if self.front_is_a {
            dispatch(
                swarm_integrate.bind(
                    swarm: swarm,
                    sdf_grid: sdf_grid,
                    sdf0: sdf0,
                    sdf1: sdf1,
                    sdf_s: sdf_s,
                    count: n,
                    src: self.a.items(),
                    dst: mut self.b,
                ),
                over: n,
            )
            self.front_is_a = false
        } else {
            dispatch(
                swarm_integrate.bind(
                    swarm: swarm,
                    sdf_grid: sdf_grid,
                    sdf0: sdf0,
                    sdf1: sdf1,
                    sdf_s: sdf_s,
                    count: n,
                    src: self.b.items(),
                    dst: mut self.a,
                ),
                over: n,
            )
            self.front_is_a = true
        }
    }

    /// Resolves exact analytical collision of all `near` grains against a single `field`.
    pub fn collide_one<F: Field<Substance>>(mut self, field: F, restitution: f32, friction: f32) {
        let n = self.count
        if n == 0 {
            return
        }
        let b = field.bound()
        let rest = clamp(restitution, 0.0, 0.95)
        if self.front_is_a {
            dispatch(
                swarm_collide_one.bind(
                    field: field,
                    bound: b,
                    restitution: rest,
                    friction: friction,
                    count: n,
                    src: self.a.items(),
                    dst: mut self.b,
                ),
                over: n,
            )
            self.front_is_a = false
        } else {
            dispatch(
                swarm_collide_one.bind(
                    field: field,
                    bound: b,
                    restitution: rest,
                    friction: friction,
                    count: n,
                    src: self.b.items(),
                    dst: mut self.a,
                ),
                over: n,
            )
            self.front_is_a = true
        }
    }

    /// Resolves exact analytical collision of all `near` grains against a dynamic `Pool<F>` in
    /// bounded `COLLIDE_CHUNK` slices.
    pub fn collide_pool<F: Field<Substance>>(
        mut self,
        fields: GpuSpan<F>,
        bounds: GpuSpan<Bound>,
        n_fields: u32,
        restitution: f32,
        friction: f32,
    ) {
        let n = self.count
        if n == 0 || n_fields == 0 {
            return
        }
        let rest = clamp(restitution, 0.0, 0.95)
        var start: u32 = 0
        while start < n_fields {
            let chunk = min(n_fields - start, COLLIDE_CHUNK)
            if self.front_is_a {
                dispatch(
                    swarm_collide_pool.bind(
                        fields: fields.sub(start: start, count: chunk),
                        bounds: bounds.sub(start: start, count: chunk),
                        n_fields: chunk,
                        restitution: rest,
                        friction: friction,
                        count: n,
                        src: self.a.items(),
                        dst: mut self.b,
                    ),
                    over: n,
                )
                self.front_is_a = false
            } else {
                dispatch(
                    swarm_collide_pool.bind(
                        fields: fields.sub(start: start, count: chunk),
                        bounds: bounds.sub(start: start, count: chunk),
                        n_fields: chunk,
                        restitution: rest,
                        friction: friction,
                        count: n,
                        src: self.b.items(),
                        dst: mut self.a,
                    ),
                    over: n,
                )
                self.front_is_a = true
            }
            start += chunk
        }
    }

    /// Injects bright grains from the current front buffer into the unified radiance cache.
    pub fn inject_radiance<Sw: Swarm>(
        self,
        swarm: Sw,
        grid: RadGrid,
        accum: mut GpuBuffer<u32>,
        emit_accum: mut GpuBuffer<u32>,
    ) {
        if self.count == 0 || grid.enabled == 0 {
            return
        }
        dispatch(
            swarm_inject_rad.bind(
                swarm: swarm,
                grains: self.front(),
                count: self.count,
                grid: grid,
                accum: mut accum,
                emit_accum: mut emit_accum,
            ),
            over: (self.count + 3) / 4,
        )
    }
}
