// Extraction grid specifications, packed vertex/brick/seam records, frustum culling,
// tight AABBs, and view-dependent nested 2:1 multi-LOD grid construction.

use matter::substance::Substance
use picture::eye::View
use std::collections::Vec
use std::derive::{Box3, Interval}
use std::field::{ALL_LIVE, DualQuat, Field, Live}
use std::gpu::LANE_WORK_LEAST
use std::quat::Quat

/// Interior cells per brick along each axis (`6×6×6` owned edges, `7×7×7` dual vertices, `8×8×8`
/// evaluated corners).
pub const BRICK: u32 = 6
pub(package) const CORNERS_BRICK: u32 = 512
pub(package) const VERTS_BRICK: u32 = 343
/// Padded vertex-index stride per brick (6 workgroups × 64 lanes = 384) so `classify_cells` writes
/// directly via `Slots[id]` with 256-byte chunk span alignment.
pub(package) const VERTS_STRIDE: u32 = 384
pub(package) const EDGES_BRICK: u32 = 216
pub(package) const NONE: u32 = 4294967295
/// The most bricks a live cut's patch (`MeshBatch::try_patch_dirty`) meshes: a cut whose dirty
/// box holds more is re-extracted whole.
pub(package) const PATCH_MOST: u32 = 4096

/// No thing (an index no thing has).
pub const NO_THING: u32 = NONE

/// Maximum bricks processed per extraction dispatch chunk so every compute dispatch stays far
/// under the 50 ms step guard even for expensive noise-displaced fields.
pub(package) const CHUNK_BRICKS: u32 = 1024

/// The active bricks a view-dependent extraction after a cut meshes chunks for at least
/// (`chunk_limit`): the most the SCENE 6 audit's cuts found active at 640x360 was 62,924.
pub(package) const CUT_BRICKS: u32 = 65536

/// How wide, in pixels at the surface seen, a view-dependent extraction makes its finest Tier-1
/// Dual Contouring cells (`sync_one_lod`, `MeshWorld::sync_batches`): Tier-1 DC meshes smooth
/// interiors at this coarse rate (6.25× fewer triangles than 1 px cells), while Tier-2
/// `ExactCell` AABBs automatically cover every silhouette, grazing, high-curvature, budget-capped,
/// and sub-cell thin feature with mathematically proved zero-hole `EmptyProof` ray solving.
pub const CELL_PX: f32 = 2.5

/// The finest cells of a field steeper than 2.5 (its value changing faster than a distance does),
/// as a share of `CELL_PX`'s width: 2 pixels at 2.5.
pub const STEEP_CELLS: f32 = 0.8

pub(package) const CULL_CHUNK: u32 = 8192
/// Sharp-crease cells `refine_creases` solves in one dispatch: its exact Hermite solve is the
/// heaviest per-cell work, so a chunk's crease list (which holds every surface cell, so no crease
/// is ever solved any other way) is refined in dispatches of at most this many, each well under
/// the 50 ms GPU dispatch guard. A slice is the heaviest field's: on the Radeon the guard allowed
/// the stack's at most 32,597 a dispatch and the walking creature's, extracted posed near the eye,
/// at most 36,974; the program can't ask a kernel's bound, so every field's slice is this.
pub(package) const CREASE_SLICE: u32 = 16384
/// The fewest cells a work-sized crease or surface slice is cut to for heavy fields.
pub(package) const CREASE_SLICE_LEAST: u32 = 1024

/// The crease slices a chunk dispatches with no readback to go by (cold, after a cut): 65,536
/// creases; the SCENE 6 audit's chunks held at most 4,045.
pub(package) const COLD_CREASE_SLICES: u32 = 4
/// Skinned vertices `deform_skinned_verts` moves in one dispatch (its Newton projection evaluates
/// the posed field up to 4 times a vertex), for the same reason.
pub(package) const DEFORM_SLICE: u32 = 262144
/// The most slices one prepared list is dispatched in: a chunk's creases (`CAP_SURF /
/// CREASE_SLICE_LEAST`, rounded up, for the heaviest field) and a batch's vertices (`8192 · 343 /
/// DEFORM_SLICE`, rounded up).
pub(package) const SLICES_MOST: u32 = 352
/// Normal spread (`Qef::min_dot`) below which a cell is a sharp crease, solved from exact Hermite
/// edge crossings; and at or above which a vertex is shaded smooth.
pub(package) const CREASE_DOT: f32 = 0.78
pub(package) const SMOOTH_DOT: f32 = 0.88
/// Tikhonov weight per sample toward the mass point: a smooth cell's, and a crease's (small, so
/// sharp edges and corners solve to their exact intersection).
pub(package) const REG_SMOOTH: f32 = 0.04
pub(package) const REG_CREASE: f32 = 0.002

/// A field of bound radius `r`'s finest cell before its surface is measured: 180 cells to the
/// radius (60 bricks across its bound), which a compact thing's surface fits in a batch.
pub fn size_floor(r: f32) -> f32 {
    r / 180.0
}

/// Things a general (non-instanced) batch can tell apart: `MeshVertex::packed` holds 10 bits.
pub const THING_IDS: u32 = 1024
/// Per-brick output budgets a batch starts with (vertices, opaque and transmissive indices), and
/// the most one brick can ever need (every cell a vertex; every owned edge of 3 axes a quad).
pub(package) const START_VERTS_PER_BRICK: u32 = 40
pub(package) const START_INDICES_PER_BRICK: u32 = 240
pub(package) const START_TRANS_PER_BRICK: u32 = 96
pub(package) const MOST_INDICES_PER_BRICK: u32 = 3888
/// Lipschitz bound at unit scale above which a field counts as steep (noise-displaced rock,
/// fluted columns, clipped shells): its bricks get 8-octant culling and its cells a finer spacing.
pub(package) const STEEP_LIPSCHITZ: f32 = 1.15
/// Every cell of a full chunk (`(bi << 9) | cell`, 1.4 MB): the compacted list of sign-changing
/// cells can never overflow, so no surface cell is ever dropped.
pub(package) const CAP_SURF: u32 = CHUNK_BRICKS * VERTS_BRICK

/// Compact 16-byte extracted surface vertex (std430-aligned, 5× smaller than 80 B material
/// vertices; Cigolle et al. 2014 octahedral normal encoding):
///   `px, py, pz`: local-space vertex position (`3 × f32`)
///   `packed`:     bits  `0..9`  octahedral unit normal X (`0..1023`, ~0.11° precision)
///                 bits `10..19` octahedral unit normal Y (`0..1023`)
///                 bits `20..29` thing index within batch (`0..1023`)
///                 bit  `30`     smooth shading flag (`1` = smooth, `0` = sharp crease)
///                 bit  `31`     transmissive flag (`1` = transmissive, `0` = opaque)
pub struct MeshVertex: Copy + GpuData {
    pub px: f32,
    pub py: f32,
    pub pz: f32,
    pub packed: u32,
}

/// Folds a unit direction onto the octahedron `[-1, 1]²` about the z axis (Cigolle et al. 2014):
/// the one octahedral map of the engine (packed vertex normals here, the sky maps in `light`).
pub fn octa(n: vec3) -> vec2 {
    let a = n / max(abs(n.x) + abs(n.y) + abs(n.z), 1.0e-8)
    if a.z >= 0.0 {
        return a.xy
    }
    (vec2(1.0) - abs(vec2(a.y, a.x))) * vec2(if a.x >= 0.0 { 1.0 } else { -1.0 }, if a.y >= 0.0 {
        1.0
    } else { -1.0 })
}

/// Unfolds an octahedral coordinate in `[-1, 1]²` back to a unit direction (`octa`'s inverse).
pub fn unocta(e: vec2) -> vec3 {
    var v = vec3(e.x, e.y, 1.0 - abs(e.x) - abs(e.y))
    let t = max(-v.z, 0.0)
    v.x += if v.x >= 0.0 { -t } else { t }
    v.y += if v.y >= 0.0 { -t } else { t }
    normalize(v)
}

/// Packs unit normal `n`, batch thing index `thing_id` (`0..THING_IDS`), `smooth`, and
/// `is_trans` into one 32-bit word, the normal as 10 + 10 bits of its `octa` fold.
pub fn pack_vertex_meta(n: vec3, thing_id: u32, smooth: bool, is_trans: bool) -> u32 {
    let o = octa(n)
    let ux = u32(clamp((o.x * 0.5 + 0.5) * 1023.0 + 0.5, 0.0, 1023.0))
    let uy = u32(clamp((o.y * 0.5 + 0.5) * 1023.0 + 0.5, 0.0, 1023.0))
    // `sync_many` refuses a general batch of more than `THING_IDS` things, so this never aliases.
    let tid = min(thing_id, THING_IDS - 1)
    let sm: u32 = if smooth { 1 } else { 0 }
    let tr: u32 = if is_trans { 1 } else { 0 }
    ux | (uy << 10) | (tid << 20) | (sm << 30) | (tr << 31)
}

/// Decodes the unit normal from `MeshVertex::packed`.
pub fn unpack_oct_normal(packed: u32) -> vec3 {
    let ox = f32(packed & 1023) * (2.0 / 1023.0) - 1.0
    let oy = f32((packed >> 10) & 1023) * (2.0 / 1023.0) - 1.0
    unocta(vec2(ox, oy))
}

/// Decodes the thing index (`0..1023`) from `MeshVertex::packed`.
pub fn unpack_thing(packed: u32) -> u32 {
    (packed >> 20) & 1023
}

/// Decodes the smooth-shading flag from `MeshVertex::packed`.
pub fn unpack_smooth(packed: u32) -> bool {
    ((packed >> 30) & 1) != 0
}

/// Decodes the transmissive-material flag from `MeshVertex::packed`.
pub fn unpack_is_trans(packed: u32) -> bool {
    (packed >> 31) != 0
}

/// The bit of a vertex's kept part word (`MeshBatch::vert_kept`) saying its material lets light
/// through.
pub const KEPT_TRANS: u32 = 2147483648

/// The part a vertex's kept part word names.
pub fn kept_part(w: u32) -> u32 {
    w & (KEPT_TRANS - 1)
}

/// Four numbers in [0, 1] (`Field::kept`) packed as a byte each.
pub fn pack_kept(k: vec4) -> u32 {
    let b = vec4u(clamp(k, vec4(0.0), vec4(1.0)) * 255.0 + vec4(0.5))
    b.x | (b.y << 8) | (b.z << 16) | (b.w << 24)
}

/// Unpacks `pack_kept`'s four numbers in [0, 1].
pub fn unpack_kept(w: u32) -> vec4 {
    vec4(f32(w & 255), f32((w >> 8) & 255), f32((w >> 16) & 255), f32(w >> 24)) * (1.0 / 255.0)
}

/// Evaluates 4-bone Dual Quaternion Skinning (Kavan et al., I3D 2007 / ACM TOG 2008) from packed
/// `(bones_u32, weights_u32)` and a flat bone palette `bones[base..base + stride]`, aligning
/// quaternion signs to the dominant bone (`b0`) for shortest-path volume-preserving blending.
pub fn eval_dqs(bones: [DualQuat], base: u32, packed_bones: u32, packed_weights: u32) -> DualQuat {
    let b0 = packed_bones & 255
    let b1 = (packed_bones >> 8) & 255
    let b2 = (packed_bones >> 16) & 255
    let b3 = packed_bones >> 24
    let inv255 = 1.0 / 255.0
    let w0 = f32(packed_weights & 255) * inv255
    let w1 = f32((packed_weights >> 8) & 255) * inv255
    let w2 = f32((packed_weights >> 16) & 255) * inv255
    let w3 = f32(packed_weights >> 24) * inv255
    let dq0 = bones[base + b0]
    var sr = dq0.real * w0
    var sd = dq0.dual * w0
    if w1 > 0.0 {
        let dq1 = bones[base + b1]
        let s1 = if dot(dq0.real, dq1.real) < 0.0 { -w1 } else { w1 }
        sr += dq1.real * s1
        sd += dq1.dual * s1
    }
    if w2 > 0.0 {
        let dq2 = bones[base + b2]
        let s2 = if dot(dq0.real, dq2.real) < 0.0 { -w2 } else { w2 }
        sr += dq2.real * s2
        sd += dq2.dual * s2
    }
    if w3 > 0.0 {
        let dq3 = bones[base + b3]
        let s3 = if dot(dq0.real, dq3.real) < 0.0 { -w3 } else { w3 }
        sr += dq3.real * s3
        sd += dq3.dual * s3
    }
    DualQuat { real: sr, dual: sd }.normalized()
}

/// Maximum seam quads and unique coarse seam cells per Multi-LOD extraction.
pub(package) const CAP_SEAM: u32 = 131072
/// Maximum seam cells refined per `refine_seam_creases` dispatch (keeps GPU work well under 50 ms).
pub(package) const SEAM_SLICE: u32 = 16384
/// The most slices of `SEAM_SLICE` seam cells a batch's seams are solved, refined and boxed in
/// (`seam_slices`: as many as its last readback says).
pub(package) const SEAM_SLICES: u32 = 16
/// Maximum nested 2:1 LOD levels in a single `MeshBatch` (7 levels = up to 64× resolution ratio).
pub(package) const MAX_LOD_LEVELS: u32 = 7

/// Sticky overflow bitflags reported in `tri_count[7]` and `MeshBatch::overflowed()`: any non-zero
/// bit means an extraction hit a capacity limit and could have dropped geometry if drawn unsettled.
pub const OVERFLOW_SEAMS: u32 = 1
pub const OVERFLOW_CUT: u32 = 2
pub const OVERFLOW_BRICKS: u32 = 4
pub const OVERFLOW_VERTS: u32 = 8
pub const OVERFLOW_INDICES: u32 = 16
pub const OVERFLOW_TRANS: u32 = 32
pub const OVERFLOW_CREASES: u32 = 64
pub const OVERFLOW_EXACT: u32 = 128
/// More things of a `Pool` came near the eye than it has batches to mesh them as `One`s
/// (`NEAR_SLOTS`, in `mesh::draw`): the rest were drawn from the pool's shared mesh.
pub const OVERFLOW_NEAR: u32 = 256
/// A batch had more candidate cells for exact cells (thin, beside the outline, or on it) than its
/// lists hold, or more seam cells than its seam slices take: the rest were not tested.
pub const OVERFLOW_THIN: u32 = 512
/// A quad or triangle was refused for drawing for not being local (`mesh::proof::LocalProof`,
/// counted in `tri_count[13]`): an index gone astray, drawn as nothing.
pub const OVERFLOW_UNLOCAL: u32 = 1024

/// Maximum `ExactCell` AABB shells per batch (32 B each = 8 MB max, allocated as needed).
pub(package) const CAP_EXACT_MAX: u32 = 262144
/// Most thin-feature candidate cells one thin test's dispatch checks (their octants' affine
/// ranges: 16,384 could hold the Radeon 51 ms at worst, over the 50 ms line), fewer where the
/// kernel's own bound says (`dc::lane_slice`).
pub(package) const THIN_SLICE: u32 = 8192
/// Most outline vertices one `certify_watched` dispatch certifies (each a few dozen affine ranges
/// at most: `engine::matter::certify`'s visits), fewer where the kernel's own bound says.
pub(package) const CERT_SLICE: u32 = 6144

/// One exact-bracket surface cell `[lo, lo + h]` rendered as a conservative AABB shell (32 B,
/// std430-aligned) whose fragment shader solves `field.distance_live(p, live) == 0` via
/// `mesh::proof::solve_cell_ray` (`WithDepthBehind` + `EmptyProof`-gated discards).
///   `meta`: `(orig_id, live.lo, live.hi, flags)` (bit 0 = sub-cell thin feature, bit 1 = silhouette/coarse)
pub struct ExactCell: Copy + GpuData {
    pub lo: vec3,
    pub h: f32,
    pub live: Live,
}

/// One active surface brick: `(bx, by, bz, grid_idx)` plus the bitmask of parts live inside it.
pub struct ActiveBrick: Copy + GpuData {
    pub coord: vec4u,
    pub live: Live,
}

/// World-space (or local-space) AABB of one extracted surface brick (`32 B`, std430-aligned).
pub struct BrickBound: Copy + GpuData {
    pub lo: vec3,
    pub pad0: u32,
    pub hi: vec3,
    pub pad1: u32,
}

/// One sign-changing fine edge lying on a 2:1 LOD seam boundary `∂Ω`.
/// Its 4 corner vertex slots live in `seam_verts[quad_idx * 4 .. +4]` (fine slots written by
/// `emit_tris`, coarse slots written by `solve_seam_smooth` / `refine_seam_creases`).
pub struct SeamQuad: Copy + GpuData {
    pub flags: u32,
    pub pad0: u32,
    /// How far apart its corners can lie (`mesh::proof::LocalProof`): its coarser cells' block.
    pub span: f32,
    pub pad2: u32,
}

/// One unique coarse parent cell adjacent to a `SeamQuad` on the outside of `∂Ω`.
pub struct SeamCell: Copy + GpuData {
    /// `(coarse_cx, coarse_cy, coarse_cz, parent_grid_idx)`.
    pub cell_grid: vec4u,
    pub quad_idx: u32,
    /// 4-bit mask of which slots (`0..4`) of `SeamQuad` map to this coarse cell.
    pub slot_mask: u32,
    pub pad0: u32,
    pub pad1: u32,
}

/// Grid layout for one thing or nested 2:1 LOD ring inside a `MeshBatch` (std430-aligned).
/// Every nested ring shares the root grid's `origin` and uses `cell_offset` in its own integer
/// lattice units (`2 * (parent.cell_offset + parent_hole_min)`), guaranteeing
/// `lattice(child, 2 * k) == lattice(parent, parent_hole_min + k)` bit-for-bit in IEEE-754 float.
pub struct GridSpec: Copy + GpuData {
    pub origin: vec3,
    pub cell: f32,
    pub dims: vec3u,
    pub base_brick: u32,
    pub orig_id: u32,
    /// 6-bit mask of faces (`-X,+X,-Y,+Y,-Z,+Z`) that form a 2:1 seam with `parent_grid`.
    pub seam_mask: u32,
    /// Index into `grids` of the coarser parent level (`NONE` when coarsest or single-LOD).
    pub parent_grid: u32,
    /// Non-zero when `[hole_min, hole_max)` is refined by a finer child level.
    pub has_hole: u32,
    pub hole_min: vec3u,
    pub pad0: u32,
    pub hole_max: vec3u,
    pub pad1: u32,
    pub cell_offset: vec3u,
    pub pad2: u32,
    pub parent_hole_min: vec3u,
    pub pad3: u32,
    /// Where the world's lattice of cells stands off the grid's own points (m, `lattice`): one for
    /// every grid of a world (`ExtractScratch::lattice`, `placement`).
    pub shift: vec3,
    pub pad4: u32,
}

/// Coordinate `axis` (`0..3`) of `p`.
pub(package) fn along(p: vec3, axis: u32) -> f32 {
    if axis == 0 {
        p.x
    } else if axis == 1 {
        p.y
    } else {
        p.z
    }
}

/// `p` with coordinate `axis` (`0..3`) set to `x`.
pub(package) fn with_along(p: vec3, axis: u32, x: f32) -> vec3 {
    vec3(
        if axis == 0 { x } else { p.x },
        if axis == 1 { x } else { p.y },
        if axis == 2 { x } else { p.z },
    )
}

/// Proves a slab `[lo, hi]` empty by checking `field.interval_near` directly first, and when a
/// wide slab's diagonal defeats a Lipschitz ball (`stepped_near`), tiling the two perpendicular
/// axes up to 4×4 (short-circuiting on the first sub-box that may cross 0).
fn slab_empty<M: Field<Substance>>(field: M, lo: vec3, hi: vec3, axis: u32) -> bool {
    if !may_cross(field.interval_near(Box3 { lo, hi })) {
        return true
    }
    let ext = hi - lo
    let a1 = (axis + 1) % 3
    let a2 = (axis + 2) % 3
    let e0 = max(along(ext, axis), 1.0e-5)
    let e1 = along(ext, a1)
    let e2 = along(ext, a2)
    if max(e1, e2) <= e0 * 1.5 {
        return false
    }
    let n1: u32 = if e1 > e0 * 3.0 { 4 } else if e1 > e0 * 1.5 { 2 } else { 1 }
    let n2: u32 = if e2 > e0 * 3.0 { 4 } else if e2 > e0 * 1.5 { 2 } else { 1 }
    let lo1 = along(lo, a1)
    let lo2 = along(lo, a2)
    let s1 = e1 / f32(n1)
    let s2 = e2 / f32(n2)
    for i in 0..n1 {
        let u0 = lo1 + f32(i) * s1
        let u1 = if i + 1 == n1 { along(hi, a1) } else { lo1 + f32(i + 1) * s1 }
        for j in 0..n2 {
            let v0 = lo2 + f32(j) * s2
            let v1 = if j + 1 == n2 { along(hi, a2) } else { lo2 + f32(j + 1) * s2 }
            let slo = with_along(with_along(lo, a1, u0), a2, v0)
            let shi = with_along(with_along(hi, a1, u1), a2, v1)
            if may_cross(field.interval_near(Box3 { lo: slo, hi: shi })) {
                return false
            }
        }
    }
    true
}

/// Binary-searches the lower (or `upper`) face of box `(lo, hi)` along `axis` inward (8 steps)
/// while the slab it sweeps provably holds no surface, returning the face's new coordinate.
fn shrink<M: Field<Substance>>(field: M, lo: vec3, hi: vec3, axis: u32, upper: bool) -> f32 {
    var a = along(lo, axis)
    var c = along(hi, axis)
    for _step in 0..8 {
        let mid = 0.5 * (a + c)
        let slab = if upper {
            Box3 { lo: with_along(lo, axis, mid), hi }
        } else {
            Box3 { lo, hi: with_along(hi, axis, mid) }
        }
        let empty = slab_empty(field, slab.lo, slab.hi, axis)
        if upper {
            if empty { c = mid } else { a = mid }
        } else {
            if empty { a = mid } else { c = mid }
        }
    }
    if upper { c } else { a }
}

/// Tightens a thing's bounding sphere into a tight axis-aligned box on the CPU using a bounded
/// 3-level octree prune followed by 6-face `slab_empty` binary search (handles both tight
/// interval fields and `stepped_near` Lipschitz-ball fields whose giant slabs cannot shrink).
pub fn tight_aabb<M: Field<Substance>>(field: M) -> Box3 {
    let b = field.bound()
    let r = min(b.radius, 1.0e4)
    var lo = b.centre - vec3(r)
    var hi = b.centre + vec3(r)
    var boxes: Vec<Box3> = Vec::new()
    boxes.push(Box3 { lo, hi })
    for _lvl in 0..3 {
        var next: Vec<Box3> = Vec::new()
        var overflow = false
        for i in 0..boxes.len() {
            let bx = boxes[i]
            if may_cross(field.interval_near(bx)) {
                if next.len() + 8 <= 512 {
                    for c in bx.split() {
                        next.push(c)
                    }
                } else {
                    overflow = true
                    break
                }
            }
        }
        if overflow {
            break
        }
        boxes = take next
        if boxes.len() == 0 {
            // No box of it may hold its surface: it has none (an absent thing), and its tight
            // box holds nothing.
            return Box3 { lo: b.centre, hi: b.centre }
        }
    }
    var olo = vec3(1.0e30)
    var ohi = vec3(-1.0e30)
    for i in 0..boxes.len() {
        let bx = boxes[i]
        if may_cross(field.interval_near(bx)) {
            olo = min(olo, bx.lo)
            ohi = max(ohi, bx.hi)
        }
    }
    if ohi.x >= olo.x {
        lo = olo
        hi = ohi
    }
    for axis in 0..3 {
        lo = with_along(lo, axis, shrink(field, lo, hi, axis, upper: false))
        hi = with_along(hi, axis, shrink(field, lo, hi, axis, upper: true))
    }
    Box3 { lo, hi }
}

/// Binary-searches one face of a skinned field's rest-pose AABB via `rest_interval_near`.
fn shrink_rest<M: Field<Substance>>(field: M, lo: vec3, hi: vec3, axis: u32, upper: bool) -> f32 {
    var a = along(lo, axis)
    var c = along(hi, axis)
    for _step in 0..8 {
        let mid = 0.5 * (a + c)
        let slab = if upper {
            Box3 { lo: with_along(lo, axis, mid), hi: with_along(hi, axis, c) }
        } else {
            Box3 { lo: with_along(lo, axis, a), hi: with_along(hi, axis, mid) }
        }
        let iv = field.rest_interval_near(slab)
        let empty = !may_cross(iv)
        if upper {
            if empty { c = mid } else { a = mid }
        } else {
            if empty { a = mid } else { c = mid }
        }
    }
    if upper { c } else { a }
}

/// Tightens a skinned field's rest-pose bounding sphere into a tight local AABB.
pub(package) fn tight_aabb_rest<M: Field<Substance>>(field: M) -> Box3 {
    let b = field.rest_bound()
    let r = min(b.radius, 1.0e4)
    var lo = b.centre - vec3(r)
    var hi = b.centre + vec3(r)
    for axis in 0..3 {
        lo = with_along(lo, axis, shrink_rest(field, lo, hi, axis, upper: false))
        hi = with_along(hi, axis, shrink_rest(field, lo, hi, axis, upper: true))
    }
    Box3 { lo, hi }
}

/// Fixed integer power-of-two anchor level for `aabb` (`anchor_step = BRICK * 2^k_anchor`),
/// depending ONLY on `aabb` so every LOD ring and every eye position shares one world-anchored
/// brick lattice (`grid_for_anchored`) with bit-identical brick coordinates `gb = cell_offset / BRICK + b`.
pub fn anchor_level(aabb: Box3) -> i32 {
    let span = max(aabb.hi.x - aabb.lo.x, max(aabb.hi.y - aabb.lo.y, aabb.hi.z - aabb.lo.z))
    max(i32(ceil(log2(max(span / (f32(BRICK) * 2.0), 1.0e-4)))), 0)
}

/// Builds a single-LOD `GridSpec` covering `aabb` with exact power-of-two cell spacing `cell`,
/// anchored to `anchor_step = BRICK * 2^k_anchor` (derived from `aabb` alone). Because `origin`
/// never moves when `cell` or the eye changes and `cell_offset` is always a multiple of `BRICK`,
/// any brick `(level, gb = cell_offset / BRICK + b)` maps to the exact same IEEE-754 corner bits
/// across every cut, enabling persistent `BrickPool` caching with zero re-extraction.
pub(package) fn grid_for_anchored(
    aabb: Box3,
    cell: f32,
    k_anchor: i32,
    base_brick: u32,
    orig_id: u32,
    shift: vec3,
) -> GridSpec {
    let pad = vec3(cell * 2.0)
    let bspan = cell * f32(BRICK)
    let anchor_step = max(f32(BRICK) * exp2(f32(k_anchor)), bspan)
    let origin = (floor((aabb.lo - shift) / anchor_step) - vec3(1.0)) * anchor_step
    let lo_rel = max(aabb.lo - pad - shift - origin, vec3(0.0))
    let b0 = vec3u(u32(floor(lo_rel.x / bspan)), u32(floor(lo_rel.y / bspan)), u32(floor(lo_rel.z / bspan)))
    let g_lo = origin + vec3(f32(b0.x), f32(b0.y), f32(b0.z)) * bspan
    let span = max(aabb.hi + pad - shift - g_lo, vec3(cell))
    let nx = max(u32(ceil(span.x / bspan)), 1)
    let ny = max(u32(ceil(span.y / bspan)), 1)
    let nz = max(u32(ceil(span.z / bspan)), 1)
    GridSpec {
        origin,
        cell,
        dims: vec3u(nx, ny, nz),
        base_brick,
        orig_id,
        seam_mask: 0,
        parent_grid: NONE,
        has_hole: 0,
        hole_min: vec3u(0, 0, 0),
        pad0: 0,
        hole_max: vec3u(0, 0, 0),
        pad1: 0,
        cell_offset: b0 * BRICK,
        pad2: 0,
        parent_hole_min: vec3u(0, 0, 0),
        pad3: 0,
        shift,
        pad4: 0,
    }
}

/// Builds a single-LOD `GridSpec` covering `aabb` with cell spacing `cell`, padded by 2 cells so
/// the surface never touches the grid boundary. Its corners are on the world's lattice placed at
/// `shift` (`lattice`: `shift` and whole cells from the world's origin), and it covers `aabb`
/// whatever `shift` is: a placement moves where the cells fall, never what they cover. (Its
/// origin was the box's padded corner, the lattice that plus `shift`: a shift past two cells cut
/// off the box's low side, and at the gate's placements, 20 cm at most, a thing meshed at
/// millimetre cells lost most of itself.)
pub(package) fn grid_for(aabb: Box3, cell: f32, base_brick: u32, orig_id: u32, shift: vec3) -> GridSpec {
    let pad = vec3(cell * 2.0)
    let bspan = cell * f32(BRICK)
    let origin = floor((aabb.lo - pad - shift) / bspan) * bspan
    let span = max(aabb.hi + pad - shift - origin, vec3(cell))
    let nx = max(u32(ceil(span.x / bspan)), 1)
    let ny = max(u32(ceil(span.y / bspan)), 1)
    let nz = max(u32(ceil(span.z / bspan)), 1)
    GridSpec {
        origin,
        cell,
        dims: vec3u(nx, ny, nz),
        base_brick,
        orig_id,
        seam_mask: 0,
        parent_grid: NONE,
        has_hole: 0,
        hole_min: vec3u(0, 0, 0),
        pad0: 0,
        hole_max: vec3u(0, 0, 0),
        pad1: 0,
        cell_offset: vec3u(0, 0, 0),
        pad2: 0,
        parent_hole_min: vec3u(0, 0, 0),
        pad3: 0,
        shift,
        pad4: 0,
    }
}

/// Builds a strictly 2:1-balanced hierarchy of nested clipmap `GridSpec`s covering `aabb` with
/// finest spacing `h_near` around `focus` stepping up by `2×` per ring to coarsest spacing `h_top`.
/// Every finer ring snaps to integer coarse brick boundaries and keeps a >=1 coarse-brick margin
/// inside any parent seam face so 2:1 balance holds by construction (zero 4:1 transitions).
/// Returns `(grids, total_bricks, has_seams)`.
pub fn build_lod_grids(
    aabb: Box3,
    focus: vec3,
    h_near: f32,
    h_top: f32,
    orig_id: u32,
    half_parent_bricks: u32,
    shift: vec3,
) -> (Vec<GridSpec>, u32, bool) {
    if h_top <= h_near * 1.45 {
        let g = grid_for(aabb, h_near, base_brick: 0, orig_id: orig_id, shift: shift)
        let tb = g.dims.x * g.dims.y * g.dims.z
        var out: Vec<GridSpec> = Vec::new()
        out.push(g)
        return (out, tb, false)
    }
    // Start at the exact coarsest spacing `h_top` and halve per nested ring down to `h_near`,
    // so level 0 never multiplies the whole object's coarse brick count beyond `h_top`.
    var levels: u32 = 1
    var scale = 1.0
    while levels < MAX_LOD_LEVELS && h_near * scale * 1.95 < h_top {
        scale *= 2.0
        levels += 1
    }
    // Align the root cell size to the power-of-two ladder ending at `h_near` (clamped to
    // `[0.60 * h_top, h_top]`) so intermediate levels hit screen-space targets without a 1.6×
    // phase mismatch.
    let h_root = clamp(h_near * scale, 0.60 * h_top, h_top)
    var grids: Vec<GridSpec> = Vec::new()
    grids.push(grid_for(aabb, h_root, base_brick: 0, orig_id: orig_id, shift: shift))
    let fclamped = clamp(focus, aabb.lo, aabb.hi)
    let hb = max(half_parent_bricks, 2)
    for _lvl in 1..levels {
        let pi = grids.len() - 1
        let prev = grids[pi]
        let pbspan = prev.cell * f32(BRICK)
        let prev_origin = prev.origin +
            vec3(f32(prev.cell_offset.x), f32(prev.cell_offset.y), f32(prev.cell_offset.z)) *
                prev.cell
        let rel = (fclamped - prev_origin) / pbspan
        let cx = i32(floor(rel.x))
        let cy = i32(floor(rel.y))
        let cz = i32(floor(rel.z))
        let min_x: i32 = if (prev.seam_mask & 1) != 0 { 1 } else { 0 }
        let min_y: i32 = if (prev.seam_mask & 4) != 0 { 1 } else { 0 }
        let min_z: i32 = if (prev.seam_mask & 16) != 0 { 1 } else { 0 }
        let max_x: i32 = i32(prev.dims.x) - (if (prev.seam_mask & 2) != 0 { 1 } else { 0 })
        let max_y: i32 = i32(prev.dims.y) - (if (prev.seam_mask & 8) != 0 { 1 } else { 0 })
        let max_z: i32 = i32(prev.dims.z) - (if (prev.seam_mask & 32) != 0 { 1 } else { 0 })
        if min_x >= max_x || min_y >= max_y || min_z >= max_z {
            break
        }
        let hbi = i32(hb)
        var lo_x = max(min_x, cx - hbi)
        var hi_x = min(max_x, cx + hbi + 1)
        var lo_y = max(min_y, cy - hbi)
        var hi_y = min(max_y, cy + hbi + 1)
        var lo_z = max(min_z, cz - hbi)
        var hi_z = min(max_z, cz + hbi + 1)
        if lo_x >= hi_x {
            lo_x = min(max(cx, min_x), max_x - 1)
            hi_x = lo_x + 1
        }
        if lo_y >= hi_y {
            lo_y = min(max(cy, min_y), max_y - 1)
            hi_y = lo_y + 1
        }
        if lo_z >= hi_z {
            lo_z = min(max(cz, min_z), max_z - 1)
            hi_z = lo_z + 1
        }
        let blo = vec3u(u32(lo_x), u32(lo_y), u32(lo_z))
        let bhi = vec3u(u32(hi_x), u32(hi_y), u32(hi_z))
        let hole_min = vec3u(blo.x * BRICK, blo.y * BRICK, blo.z * BRICK)
        let hole_max = vec3u(bhi.x * BRICK, bhi.y * BRICK, bhi.z * BRICK)
        var sm: u32 = 0
        if blo.x > 0 {
            sm |= 1
        }
        if bhi.x < prev.dims.x {
            sm |= 2
        }
        if blo.y > 0 {
            sm |= 4
        }
        if bhi.y < prev.dims.y {
            sm |= 8
        }
        if blo.z > 0 {
            sm |= 16
        }
        if bhi.z < prev.dims.z {
            sm |= 32
        }
        let child_dims = vec3u((bhi.x - blo.x) * 2, (bhi.y - blo.y) * 2, (bhi.z - blo.z) * 2)
        let child_off = vec3u(
            (prev.cell_offset.x + hole_min.x) * 2,
            (prev.cell_offset.y + hole_min.y) * 2,
            (prev.cell_offset.z + hole_min.z) * 2,
        )
        if sm == 0 && prev.seam_mask == 0 {
            // Child replaces 100% of root grid cleanly — drop the empty parent so it wastes zero
            // cull bricks and keeps `grids.len() == 1` (single-grid fast path!).
            grids[pi] = GridSpec {
                origin: prev.origin,
                cell: 0.5 * prev.cell,
                dims: child_dims,
                base_brick: 0,
                orig_id,
                seam_mask: 0,
                parent_grid: pi,
                has_hole: 0,
                hole_min: vec3u(0, 0, 0),
                pad0: 0,
                hole_max: vec3u(0, 0, 0),
                pad1: 0,
                cell_offset: child_off,
                pad2: 0,
                parent_hole_min: vec3u(0, 0, 0),
                pad3: 0,
                shift: prev.shift,
                pad4: 0,
            }
        } else {
            grids[pi] = GridSpec { has_hole: 1, hole_min, hole_max, ..prev }
            grids.push(
                GridSpec {
                    origin: prev.origin,
                    cell: 0.5 * prev.cell,
                    dims: child_dims,
                    base_brick: 0,
                    orig_id,
                    seam_mask: sm,
                    parent_grid: pi,
                    has_hole: 0,
                    hole_min: vec3u(0, 0, 0),
                    pad0: 0,
                    hole_max: vec3u(0, 0, 0),
                    pad1: 0,
                    cell_offset: child_off,
                    pad2: 0,
                    parent_hole_min: hole_min,
                    pad3: 0,
                    shift: prev.shift,
                    pad4: 0,
                },
            )
        }
    }
    var total_bricks: u32 = 0
    var has_seams = false
    for i in 0..grids.len() {
        let g = grids[i]
        grids[i] = GridSpec { base_brick: total_bricks, ..g }
        total_bricks += g.dims.x * g.dims.y * g.dims.z
        if g.seam_mask != 0 {
            has_seams = true
        }
    }
    (grids, total_bricks, has_seams)
}

/// Builds a strictly 2:1-balanced hierarchy of world-anchored, **distance-only** nested clipmap
/// `GridSpec`s covering `aabb` around eye position `eye_at` (never depending on `v.forward`, so
/// pure camera rotation changes zero bricks and off-screen sun casters stay resident).
/// Every level has an exact power-of-two `cell` anchored to `anchor_level(aabb)` so every brick
/// `(level, gb = cell_offset / BRICK + b)` keeps bit-identical world coordinates across cuts.
/// Returns `(grids, total_bricks, has_seams)`.
pub fn build_lod_grids_distance(
    aabb: Box3,
    eye_at: vec3,
    px: f32,
    h_near: f32,
    h_top: f32,
    z_near: f32,
    orig_id: u32,
    k_px: f32,
    max_parent_span: u32,
    area_budget: u32,
    shift: vec3,
    reach_mult: f32 = 1.0,
) -> (Vec<GridSpec>, u32, bool) {
    let k_anchor = anchor_level(aabb)
    let h_cap = exp2(f32(k_anchor))
    let h_root_top = min(h_top, h_cap)
    let h_finest = min(h_near, h_root_top)
    if h_root_top <= h_finest * 1.45 {
        let g = grid_for_anchored(aabb, h_finest, k_anchor, base_brick: 0, orig_id: orig_id, shift: shift)
        let tb = g.dims.x * g.dims.y * g.dims.z
        var out: Vec<GridSpec> = Vec::new()
        out.push(g)
        return (out, tb, false)
    }
    var levels: u32 = 1
    var scale = 1.0
    while levels < MAX_LOD_LEVELS && h_finest * scale * 1.5 < h_root_top {
        scale *= 2.0
        levels += 1
    }
    let h_root = min(h_finest * scale, h_cap)
    var grids: Vec<GridSpec> = Vec::new()
    grids.push(grid_for_anchored(aabb, h_root, k_anchor, base_brick: 0, orig_id: orig_id, shift: shift))
    let px_rad = max(px, 1.0e-5)
    let dx_far = max(abs(eye_at.x - aabb.lo.x), abs(eye_at.x - aabb.hi.x))
    let dy_far = max(abs(eye_at.y - aabb.lo.y), abs(eye_at.y - aabb.hi.y))
    let dz_far = max(abs(eye_at.z - aabb.lo.z), abs(eye_at.z - aabb.hi.z))
    let max_reach = sqrt(dx_far * dx_far + dy_far * dy_far + dz_far * dz_far)
    let lin_scale = max(reach_mult, 1.0)
    let area_scale = lin_scale * lin_scale
    let vol_scale = area_scale * lin_scale
    let is_single_ring = levels <= 2
    let base_span = min(max(max_parent_span, 4), if is_single_ring { 40 } else { 28 })
    let span_cap = i32(ceil(f32(base_span) * lin_scale))
    let vol_cap: i32 = i32((if is_single_ring { 48000.0 } else { 24000.0 }) * vol_scale)
    var rem_area: i32 = i32(
        f32(max(area_budget, 1200)) * (if is_single_ring { 2.2 } else { 0.70 }) * area_scale,
    )
    let min_area_cap = i32((if is_single_ring { 400.0 } else { 350.0 }) * area_scale)
    let max_area_cap = i32((if is_single_ring { 2800.0 } else { 1600.0 }) * area_scale)
    for lvl in 1..levels {
        let pi = grids.len() - 1
        let prev = grids[pi]
        let pbspan = prev.cell * f32(BRICK)
        let prev_origin = prev.origin +
            vec3(f32(prev.cell_offset.x), f32(prev.cell_offset.y), f32(prev.cell_offset.z)) *
                prev.cell
        let min_x: i32 = if (prev.seam_mask & 1) != 0 { 1 } else { 0 }
        let min_y: i32 = if (prev.seam_mask & 4) != 0 { 1 } else { 0 }
        let min_z: i32 = if (prev.seam_mask & 16) != 0 { 1 } else { 0 }
        let max_x: i32 = i32(prev.dims.x) - (if (prev.seam_mask & 2) != 0 { 1 } else { 0 })
        let max_y: i32 = i32(prev.dims.y) - (if (prev.seam_mask & 8) != 0 { 1 } else { 0 })
        let max_z: i32 = i32(prev.dims.z) - (if (prev.seam_mask & 32) != 0 { 1 } else { 0 })
        if min_x >= max_x || min_y >= max_y || min_z >= max_z {
            break
        }
        let rem_lvls = max(i32(levels - lvl), 1)
        let area_cap = clamp((rem_area * 5) / (rem_lvls * 4 + 1), min_area_cap, max_area_cap)
        let r_base = prev.cell / (max(k_px, 0.5) * px_rad)
        let zn = max(z_near - 2.0 * pbspan, 0.0)
        if r_base < zn {
            break
        }
        let r_want = r_base * reach_mult
        var reach = clamp(r_want, zn + 2.0 * pbspan, max(max_reach, zn + 2.0 * pbspan))
        let pad = pbspan
        var lo_x: i32 = 0
        var hi_x: i32 = 0
        var lo_y: i32 = 0
        var hi_y: i32 = 0
        var lo_z: i32 = 0
        var hi_z: i32 = 0
        var final_vol: i32 = 0
        for iter in 0..6 {
            let half = vec3(reach + pad)
            let lo_f = (eye_at - half - prev_origin) / pbspan
            let hi_f = (eye_at + half - prev_origin) / pbspan
            lo_x = max(min_x, i32(floor(lo_f.x)))
            hi_x = min(max_x, i32(ceil(hi_f.x)))
            lo_y = max(min_y, i32(floor(lo_f.y)))
            hi_y = min(max_y, i32(ceil(hi_f.y)))
            lo_z = max(min_z, i32(floor(lo_f.z)))
            hi_z = min(max_z, i32(ceil(hi_f.z)))
            let sx = max(hi_x - lo_x, 0)
            let sy = max(hi_y - lo_y, 0)
            let sz = max(hi_z - lo_z, 0)
            let mspan = max(sx, max(sy, sz))
            let area = sx * sy + sy * sz + sz * sx
            let vol = sx * sy * sz
            final_vol = vol
            if (mspan <= span_cap && area <= area_cap && vol <= vol_cap) || iter == 5 {
                break
            }
            var s = 1.0
            if mspan > span_cap {
                s = min(s, (f32(span_cap) / f32(mspan)) * 0.90)
            }
            if area > area_cap {
                s = min(s, sqrt(f32(area_cap) / f32(area)) * 0.90)
            }
            if vol > vol_cap {
                s = min(s, pow(f32(vol_cap) / f32(vol), 0.3333) * 0.92)
            }
            reach = max(zn + 2.0 * pbspan, reach * s)
        }
        // If even the minimum sphere reaching `zn` overflows `vol_cap * 2` on a flat slab, stop
        // refining instead of clamping a huge floor/air slab around `eye_at`.
        if final_vol > vol_cap * 2 {
            break
        }
        let foc_b = (clamp(eye_at, aabb.lo, aabb.hi) - prev_origin) / pbspan
        if hi_x - lo_x > span_cap {
            let mid = clamp(i32(round(foc_b.x)), lo_x + span_cap / 2, hi_x - span_cap / 2)
            lo_x = max(min_x, mid - span_cap / 2)
            hi_x = min(max_x, lo_x + span_cap)
        }
        if hi_y - lo_y > span_cap {
            let mid = clamp(i32(round(foc_b.y)), lo_y + span_cap / 2, hi_y - span_cap / 2)
            lo_y = max(min_y, mid - span_cap / 2)
            hi_y = min(max_y, lo_y + span_cap)
        }
        if hi_z - lo_z > span_cap {
            let mid = clamp(i32(round(foc_b.z)), lo_z + span_cap / 2, hi_z - span_cap / 2)
            lo_z = max(min_z, mid - span_cap / 2)
            hi_z = min(max_z, lo_z + span_cap)
        }
        if lo_x >= hi_x || lo_y >= hi_y || lo_z >= hi_z {
            break
        }
        let used_sx = hi_x - lo_x
        let used_sy = hi_y - lo_y
        let used_sz = hi_z - lo_z
        let used_area = used_sx * used_sy + used_sy * used_sz + used_sz * used_sx
        rem_area = max(rem_area - used_area, 400)
        let blo = vec3u(u32(lo_x), u32(lo_y), u32(lo_z))
        let bhi = vec3u(u32(hi_x), u32(hi_y), u32(hi_z))
        let hole_min = vec3u(blo.x * BRICK, blo.y * BRICK, blo.z * BRICK)
        let hole_max = vec3u(bhi.x * BRICK, bhi.y * BRICK, bhi.z * BRICK)
        var sm: u32 = 0
        if blo.x > 0 {
            sm |= 1
        }
        if bhi.x < prev.dims.x {
            sm |= 2
        }
        if blo.y > 0 {
            sm |= 4
        }
        if bhi.y < prev.dims.y {
            sm |= 8
        }
        if blo.z > 0 {
            sm |= 16
        }
        if bhi.z < prev.dims.z {
            sm |= 32
        }
        let child_dims = vec3u((bhi.x - blo.x) * 2, (bhi.y - blo.y) * 2, (bhi.z - blo.z) * 2)
        let child_off = vec3u(
            (prev.cell_offset.x + hole_min.x) * 2,
            (prev.cell_offset.y + hole_min.y) * 2,
            (prev.cell_offset.z + hole_min.z) * 2,
        )
        if sm == 0 && prev.seam_mask == 0 {
            grids[pi] = GridSpec {
                origin: prev.origin,
                cell: 0.5 * prev.cell,
                dims: child_dims,
                base_brick: 0,
                orig_id,
                seam_mask: 0,
                parent_grid: NONE,
                has_hole: 0,
                hole_min: vec3u(0, 0, 0),
                pad0: 0,
                hole_max: vec3u(0, 0, 0),
                pad1: 0,
                cell_offset: child_off,
                pad2: 0,
                parent_hole_min: vec3u(0, 0, 0),
                pad3: 0,
                shift: prev.shift,
                pad4: 0,
            }
        } else {
            grids[pi] = GridSpec { has_hole: 1, hole_min, hole_max, ..prev }
            grids.push(
                GridSpec {
                    origin: prev.origin,
                    cell: 0.5 * prev.cell,
                    dims: child_dims,
                    base_brick: 0,
                    orig_id,
                    seam_mask: sm,
                    parent_grid: pi,
                    has_hole: 0,
                    hole_min: vec3u(0, 0, 0),
                    pad0: 0,
                    hole_max: vec3u(0, 0, 0),
                    pad1: 0,
                    cell_offset: child_off,
                    pad2: 0,
                    parent_hole_min: hole_min,
                    pad3: 0,
                    shift: prev.shift,
                    pad4: 0,
                },
            )
        }
    }
    var total_bricks: u32 = 0
    var has_seams = false
    for i in 0..grids.len() {
        let g = grids[i]
        grids[i] = GridSpec { base_brick: total_bricks, ..g }
        total_bricks += g.dims.x * g.dims.y * g.dims.z
        if g.seam_mask != 0 {
            has_seams = true
        }
    }
    (grids, total_bricks, has_seams)
}

/// Expands every seamed level of a valid 2:1-balanced distance grid hierarchy `need` outward by
/// `max(span / 4, 2)` parent bricks (clamped to each parent's legal 2:1 interior and volume cap)
/// so the returned `wide` hierarchy is mathematically guaranteed to satisfy `grids_hold(wide, need)`
/// while giving walking cameras dozens of frames of zero-extraction slack before stepping a ring.
pub fn expand_lod_grids(need: Vec<GridSpec>) -> (Vec<GridSpec>, u32, bool) {
    let n = need.len()
    if n <= 1 {
        var tb: u32 = 0
        if n == 1 {
            tb = need[0].dims.x * need[0].dims.y * need[0].dims.z
        }
        return (need.clone(), tb, false)
    }
    var wide: Vec<GridSpec> = Vec::new()
    wide.push(GridSpec { has_hole: 0, hole_min: vec3u(0, 0, 0), hole_max: vec3u(0, 0, 0), ..need[0] })
    for i in 1..n {
        let p = wide[i - 1]
        let w = need[i]
        let min_x: u32 = if (p.seam_mask & 1) != 0 { 1 } else { 0 }
        let min_y: u32 = if (p.seam_mask & 4) != 0 { 1 } else { 0 }
        let min_z: u32 = if (p.seam_mask & 16) != 0 { 1 } else { 0 }
        let max_x: u32 = if p.dims.x > (if (p.seam_mask & 2) != 0 { 1 } else { 0 }) {
            p.dims.x - (if (p.seam_mask & 2) != 0 { 1 } else { 0 })
        } else {
            min_x
        }
        let max_y: u32 = if p.dims.y > (if (p.seam_mask & 8) != 0 { 1 } else { 0 }) {
            p.dims.y - (if (p.seam_mask & 8) != 0 { 1 } else { 0 })
        } else {
            min_y
        }
        let max_z: u32 = if p.dims.z > (if (p.seam_mask & 32) != 0 { 1 } else { 0 }) {
            p.dims.z - (if (p.seam_mask & 32) != 0 { 1 } else { 0 })
        } else {
            min_z
        }
        let w_poff_x = w.cell_offset.x / 2
        let w_poff_y = w.cell_offset.y / 2
        let w_poff_z = w.cell_offset.z / 2
        let blo_x = clamp((w_poff_x - p.cell_offset.x) / BRICK, min_x, max_x)
        let blo_y = clamp((w_poff_y - p.cell_offset.y) / BRICK, min_y, max_y)
        let blo_z = clamp((w_poff_z - p.cell_offset.z) / BRICK, min_z, max_z)
        let bhi_x = clamp(blo_x + w.dims.x / 2, blo_x, max_x)
        let bhi_y = clamp(blo_y + w.dims.y / 2, blo_y, max_y)
        let bhi_z = clamp(blo_z + w.dims.z / 2, blo_z, max_z)
        var px: u32 = 2
        var py: u32 = 2
        var pz: u32 = 2
        var ex_lo_x = if blo_x > min_x + px { blo_x - px } else { min_x }
        var ex_hi_x = min(bhi_x + px, max_x)
        var ex_lo_y = if blo_y > min_y + py { blo_y - py } else { min_y }
        var ex_hi_y = min(bhi_y + py, max_y)
        var ex_lo_z = if blo_z > min_z + pz { blo_z - pz } else { min_z }
        var ex_hi_z = min(bhi_z + pz, max_z)
        // Keep expanded level within super-cull volume cap (<= 64000 parent bricks = 8000 super-bricks).
        for _iter in 0..4 {
            let vol = (ex_hi_x - ex_lo_x) * (ex_hi_y - ex_lo_y) * (ex_hi_z - ex_lo_z)
            if vol <= 64000 || (px == 0 && py == 0 && pz == 0) {
                break
            }
            px = px / 2
            py = py / 2
            pz = pz / 2
            ex_lo_x = if blo_x > min_x + px { blo_x - px } else { min_x }
            ex_hi_x = min(bhi_x + px, max_x)
            ex_lo_y = if blo_y > min_y + py { blo_y - py } else { min_y }
            ex_hi_y = min(bhi_y + py, max_y)
            ex_lo_z = if blo_z > min_z + pz { blo_z - pz } else { min_z }
            ex_hi_z = min(bhi_z + pz, max_z)
        }
        let hole_min = vec3u(ex_lo_x * BRICK, ex_lo_y * BRICK, ex_lo_z * BRICK)
        let hole_max = vec3u(ex_hi_x * BRICK, ex_hi_y * BRICK, ex_hi_z * BRICK)
        var sm: u32 = 0
        if ex_lo_x > 0 { sm |= 1 }
        if ex_hi_x < p.dims.x { sm |= 2 }
        if ex_lo_y > 0 { sm |= 4 }
        if ex_hi_y < p.dims.y { sm |= 8 }
        if ex_lo_z > 0 { sm |= 16 }
        if ex_hi_z < p.dims.z { sm |= 32 }
        let child_dims = vec3u((ex_hi_x - ex_lo_x) * 2, (ex_hi_y - ex_lo_y) * 2, (ex_hi_z - ex_lo_z) * 2)
        let child_off = vec3u(
            (p.cell_offset.x + hole_min.x) * 2,
            (p.cell_offset.y + hole_min.y) * 2,
            (p.cell_offset.z + hole_min.z) * 2,
        )
        wide[i - 1] = GridSpec { has_hole: 1, hole_min, hole_max, ..p }
        wide.push(GridSpec {
            origin: p.origin,
            cell: 0.5 * p.cell,
            dims: child_dims,
            base_brick: 0,
            orig_id: w.orig_id,
            seam_mask: sm,
            parent_grid: i - 1,
            has_hole: 0,
            hole_min: vec3u(0, 0, 0),
            pad0: 0,
            hole_max: vec3u(0, 0, 0),
            pad1: 0,
            cell_offset: child_off,
            pad2: 0,
            parent_hole_min: hole_min,
            pad3: 0,
            shift: p.shift,
            pad4: 0,
        })
    }
    var total_bricks: u32 = 0
    var has_seams = false
    for i in 0..wide.len() {
        let g = wide[i]
        wide[i] = GridSpec { base_brick: total_bricks, ..g }
        total_bricks += g.dims.x * g.dims.y * g.dims.z
        if g.seam_mask != 0 {
            has_seams = true
        }
    }
    (wide, total_bricks, has_seams)
}

/// Whether the nested grids `have` hold every brick the nested grids `want` mesh, level by level:
/// every level of `want` is either strictly coarser than `have[0]` (meaning `have[0]` covers the
/// entire AABB at a finer cell already) or matches a grid in `have` with the same `cell` and
/// `origin` whose brick box contains `want`'s brick box.
pub fn grids_hold(have: Vec<GridSpec>, want: Vec<GridSpec>) -> bool {
    if have.len() == 0 || want.len() == 0 {
        return false
    }
    let h0 = have[0]
    let w0 = want[0]
    if h0.origin != w0.origin {
        return false
    }
    let h0_lo = h0.origin +
        vec3(f32(h0.cell_offset.x), f32(h0.cell_offset.y), f32(h0.cell_offset.z)) * h0.cell
    let h0_hi = h0_lo + vec3(f32(h0.dims.x), f32(h0.dims.y), f32(h0.dims.z)) * (h0.cell * f32(BRICK))
    for j in 0..want.len() {
        let b = want[j]
        if b.cell > h0.cell * 1.01 {
            // `have[0]` covers `b` only if `have[0]`'s world box contains `b`'s world box.
            let b_lo = b.origin +
                vec3(f32(b.cell_offset.x), f32(b.cell_offset.y), f32(b.cell_offset.z)) * b.cell
            let b_hi = b_lo + vec3(f32(b.dims.x), f32(b.dims.y), f32(b.dims.z)) * (b.cell * f32(BRICK))
            let eps = 1.0e-4 * max(b.cell, 1.0)
            if b_lo.x + eps < h0_lo.x || b_lo.y + eps < h0_lo.y || b_lo.z + eps < h0_lo.z ||
                b_hi.x - eps > h0_hi.x || b_hi.y - eps > h0_hi.y || b_hi.z - eps > h0_hi.z {
                return false
            }
            continue
        }
        var found = false
        for i in 0..have.len() {
            let a = have[i]
            if a.cell == b.cell {
                let alo = a.cell_offset
                let ahi = a.cell_offset + a.dims * BRICK
                let blo = b.cell_offset
                let bhi = b.cell_offset + b.dims * BRICK
                if blo.x >= alo.x && blo.y >= alo.y && blo.z >= alo.z && bhi.x <= ahi.x &&
                    bhi.y <= ahi.y && bhi.z <= ahi.z {
                    found = true
                    break
                }
            }
        }
        if !found {
            return false
        }
    }
    true
}

/// World (or rest-local) position of global lattice corner `n` of grid `g`. Every brick and nested
/// LOD level asks for a shared corner by its root-aligned integer `(n + cell_offset)`, so
/// neighbours across bricks and across 2:1 LOD boundaries get the exact same `f32` bits.
pub(package) fn lattice(g: GridSpec, n: vec3u) -> vec3 {
    let gidx = n + g.cell_offset
    g.origin + vec3(f32(gidx.x), f32(gidx.y), f32(gidx.z)) * g.cell + g.shift
}

/// The `k`th placement of the world's lattice (`GridSpec::shift`): 0 the world's own, and others
/// a judge averages its numbers over (`tools/gate`), each a few cm off along each axis by steps
/// that are no simple fraction of one another or of a cell, so a count that moves with where the
/// cells fall is measured as a mean, not as one placement's draw.
///
/// The world's own (`k` 0) stands a fraction of a millimetre off its origin, by no round number:
/// on the origin itself, the lattice's corners fall on the planes content is set on (the ground's
/// top at 0, a wall's at 3 m on a lattice of 0.0628 m cells' multiples), each such corner's value
/// exactly 0, a case of Dual Contouring the 2:1 seams don't stitch (`stage_eye7`'s 75 open edges).
pub fn placement(k: u32) -> vec3 {
    vec3(0.000173, 0.000291, 0.000119) + f32(k) * vec3(0.01731, 0.02917, 0.01193)
}

/// Whether brick `b` of grid `g` lies strictly inside `g`'s refined child hole `[hole_min, hole_max)`.
pub(package) fn brick_in_hole(g: GridSpec, b: vec3u) -> bool {
    if g.has_hole == 0 {
        return false
    }
    let bx = b.x * BRICK
    let by = b.y * BRICK
    let bz = b.z * BRICK
    bx >= g.hole_min.x &&
        bx < g.hole_max.x &&
        by >= g.hole_min.y &&
        by < g.hole_max.y &&
        bz >= g.hole_min.z &&
        bz < g.hole_max.z
}

/// Sign-preserving average of two distances (coarse-edge midpoint on a 2:1 seam boundary).
pub(package) fn avg2_sign(a: f32, b: f32) -> f32 {
    let m = 0.5 * (a + b)
    if a < 0.0 && b < 0.0 && m >= 0.0 {
        return -1.0e-30
    }
    if a >= 0.0 && b >= 0.0 && m < 0.0 {
        return 0.0
    }
    m
}

/// Sign-preserving average of four distances (coarse-face center on a 2:1 seam boundary).
pub(package) fn avg4_sign(a: f32, b: f32, c: f32, d: f32) -> f32 {
    let m = 0.25 * (a + b + c + d)
    if a < 0.0 && b < 0.0 && c < 0.0 && d < 0.0 && m >= 0.0 {
        return -1.0e-30
    }
    if a >= 0.0 && b >= 0.0 && c >= 0.0 && d >= 0.0 && m < 0.0 {
        return 0.0
    }
    m
}

/// Position of local corner `c` (each in `0..8`) of brick `b` (its `xyz`).
pub(package) fn brick_corner(g: GridSpec, b: vec3u, c: vec3u) -> vec3 {
    lattice(g, vec3u(b.x * BRICK + c.x, b.y * BRICK + c.y, b.z * BRICK + c.z))
}

/// The parts of `f` live in an exact cell (`lo`, side `h`), of those `live` in its brick: pruned
/// to the cell's box grown by half a cell each way, which holds every point the exact shader asks
/// (its march inside the cell and its normal's taps beside it), where `distance_live` with them
/// is `distance` bit for bit (`std::field`'s promise). A brick's parts are a 6³ brick's; a cell's
/// are what its march evaluates each step (SCENE 14's candlestick's exact draw took 2.1 ms with
/// one part live a cell where its bricks' masks took 10.6).
pub(package) fn cell_live<M: Field<Substance>>(f: M, lo: vec3, h: f32, live: Live) -> Live {
    let pad = vec3(0.5 * h)
    f.pruned(Box3 { lo: lo - pad, hi: lo + vec3(h) + pad }, |q: vec3| q, 1.0, live, 0).live
}

/// Brick `(bx, by, bz)` of grid `g`'s `local` brick index.
pub(package) fn brick_of(g: GridSpec, local: u32) -> vec3u {
    let xy = g.dims.x * g.dims.y
    let bz = local / xy
    let rem = local - bz * xy
    let by = rem / g.dims.x
    vec3u(rem - by * g.dims.x, by, bz)
}

/// Whether a box whose distance lies in `iv` may hold a piece of the surface a mesh is made of:
/// a corner inside (`< 0`, `classify_cells`' convention, as every pass's) and one not. A box whose
/// least distance is 0 or more has no point inside, so none of its cells changes sign and none of
/// its edges crosses: an absent thing (a path of no width, as the bolt is between strikes)
/// touches 0 without an inside, and is culled whole, with no work done for it.
pub(package) fn may_cross(iv: Interval) -> bool {
    iv.lo < 0.0 && iv.hi >= 0.0
}

/// Whether a `4×4×4` super-brick `sb` (clamped to `g.dims`, halo included) may hold `f`'s surface,
/// together with the parts still live anywhere inside it.
pub(package) fn cull_super_brick<M: Field<Substance>>(f: M, g: GridSpec, sb: vec3u) -> (bool, Live) {
    let b0 = sb * 4
    let b1 = min(b0 + vec3u(4, 4, 4), g.dims)
    let lo = brick_corner(g, b0, vec3u(0, 0, 0))
    let hi_c: u32 = if g.seam_mask != 0 { BRICK + 2 } else { BRICK + 1 }
    let hi = brick_corner(g, b1 - vec3u(1, 1, 1), vec3u(hi_c, hi_c, hi_c))
    let pr = f.pruned(Box3 { lo, hi }, |q: vec3| q, 1.0, ALL_LIVE, 0)
    (may_cross(pr.range), pr.live)
}

/// Whether brick `b`'s full `8×8×8` corner box (halo included) may hold `f`'s surface, starting
/// from `init_live`, and which parts remain live in it.
pub(package) fn cull_brick_with_live<M: Field<Substance>>(
    f: M,
    g: GridSpec,
    b: vec3u,
    init_live: Live,
) -> (bool, Live) {
    let lo = brick_corner(g, b, vec3u(0, 0, 0))
    let hi_c: u32 = if g.seam_mask != 0 { BRICK + 2 } else { BRICK + 1 }
    let hi = brick_corner(g, b, vec3u(hi_c, hi_c, hi_c))
    let pr0 = f.pruned(Box3 { lo, hi }, |q: vec3| q, 1.0, init_live, 0)
    let may = may_cross(pr0.range)
    if !may || !steep(f) {
        return (may, if may { pr0.live } else { init_live })
    }
    // A steep field's range by its bound is that many times wider than the box: one of the box's
    // pieces must straddle 0 too, by its own pruned range (`cull_pieces`: its octants, or its
    // quarters or halves where an invocation can't hold eight tests, or the box alone).
    let pieces = cull_pieces(f)
    if pieces == 1 {
        return (true, pr0.live)
    }
    let mid = 0.5 * (lo + hi)
    for oct in 0..pieces {
        let olo = vec3(
            if (oct & 1) != 0 { mid.x } else { lo.x },
            if pieces >= 4 && (oct & 2) != 0 { mid.y } else { lo.y },
            if pieces >= 8 && (oct & 4) != 0 { mid.z } else { lo.z },
        )
        let ohi = vec3(
            if (oct & 1) != 0 { hi.x } else { mid.x },
            if pieces >= 4 && (oct & 2) == 0 { mid.y } else { hi.y },
            if pieces >= 8 && (oct & 4) == 0 { mid.z } else { hi.z },
        )
        let iv = f.pruned(Box3 { lo: olo, hi: ohi }, |q: vec3| q, 1.0, pr0.live, 0).range
        if may_cross(iv) {
            return (true, pr0.live)
        }
    }
    (false, init_live)
}

/// The pieces a steep field's cull halves a brick's box into (`cull_brick_with_live`): its eight
/// octants where an invocation's work for the box and each of them, with a fifth more, is within
/// half the most one invocation may do on the slowest target (`LANE_WORK_LEAST`: half, for a
/// device slower than its target's); else its four quarters, its two halves, or the box alone
/// (1). A constant of the build for each kind and target, from one strict count of a box's test
/// (`std::derive::strict_work`, as this target's strict kernel computes it): the stack's pillar
/// tests a box in 3.4 times the work on Vulkan that it does on Metal (its divisions std's
/// there), and nine tests an invocation (3,041,177 work) were refused on the Radeon. Fewer
/// pieces keep more bricks that hold no surface, which mesh to nothing.
pub(package) fn cull_pieces<M: Field<Substance>>(f: M) -> u32 {
    let one = max(
        std::derive::strict_work(|b: Box3| f.pruned(b, |q: vec3| q, 1.0, ALL_LIVE, 0).range.lo),
        1,
    )
    let w = one + one / 5
    let most = LANE_WORK_LEAST / 2
    if w <= most / 9 { 8 } else if w <= most / 5 { 4 } else if w <= most / 3 { 2 } else { 1 }
}

/// Whether brick `b`'s full `8×8×8` corner box (halo included) may hold `f`'s surface, and which
/// parts are live in it. A steep field (noise-displaced rock) also needs one of the box's pieces
/// (`cull_pieces`: its 8 octants where an invocation can hold their tests) to straddle zero: a
/// sound, finer check that discards conservative false positives.
pub(package) fn cull_brick<M: Field<Substance>>(f: M, g: GridSpec, b: vec3u) -> (bool, Live) {
    cull_brick_with_live(f, g, b, ALL_LIVE)
}

/// Safe vector normalize.
pub(package) fn safe_norm(v: vec3, fallback: vec3) -> vec3 {
    let l2 = dot(v, v)
    if l2 > 1.0e-12 { v * (1.0 / sqrt(l2)) } else { fallback }
}

/// Whether `field` is steep enough (`STEEP_LIPSCHITZ`) to need finer culling and cells.
pub fn steep<M: Field<Substance>>(field: M) -> bool {
    field.lipschitz(1.0) > STEEP_LIPSCHITZ
}

/// Finds which thing owns global brick index `gb` by binary search over `grids[i].base_brick`.
pub(package) fn owner_of(grids: [GridSpec], n: u32, gb: u32) -> u32 {
    var lo: u32 = 0
    var hi: u32 = n
    for _k in 0..16 {
        if lo + 1 >= hi {
            break
        }
        let mid = (lo + hi) >> 1
        if grids[mid].base_brick <= gb {
            lo = mid
        } else {
            hi = mid
        }
    }
    lo
}

/// Five inward-facing frustum half-spaces (near + left/right/bottom/top) for monotonic per-brick
/// Multi-LOD refinement in `cull_bricks`. Because `B_child ⊂ B_parent` implies
/// `in_frust(B_child) => in_frust(B_parent)`, off-screen parent bricks stay at coarse resolution
/// (keeping off-screen shadows, GI and SDF complete) while all 8 of their off-screen child bricks
/// are skipped immediately before field evaluation.
pub struct FrustumCull: Copy + GpuData {
    pub origin: vec4,
    pub p0: vec4,
    pub p1: vec4,
    pub p2: vec4,
    pub p3: vec4,
    pub p4: vec4,
}

/// Disabled frustum refinement (refines the entire `hole` box).
pub fn frustum_cull_none() -> FrustumCull {
    FrustumCull {
        origin: vec4(0.0),
        p0: vec4(0.0),
        p1: vec4(0.0),
        p2: vec4(0.0),
        p3: vec4(0.0),
        p4: vec4(0.0),
    }
}

/// Padded view frustum (`margin` > 1 widens FOV beyond the viewport edges so no screen ray ever
/// approaches the off-screen coarse/fine boundary).
pub fn frustum_cull_view(v: View, margin: f32) -> FrustumCull {
    let ty = margin / max(v.focal, 1.0e-4)
    let tx = (v.size.x / max(v.size.y, 1.0)) * ty
    FrustumCull {
        origin: vec4(v.at, 1.0),
        p0: vec4(v.forward, 0.05),
        p1: vec4(v.forward * tx + v.right, 0.0),
        p2: vec4(v.forward * tx - v.right, 0.0),
        p3: vec4(v.forward * ty + v.up, 0.0),
        p4: vec4(v.forward * ty - v.up, 0.0),
    }
}

/// True iff AABB `[lo, hi]` intersects the padded view frustum `fc` (or `fc` is disabled).
pub(package) fn box_in_frustum(lo: vec3, hi: vec3, fc: FrustumCull) -> bool {
    if fc.origin.w < 0.5 {
        return true
    }
    let c = 0.5 * (lo + hi) - fc.origin.xyz
    let e = 0.5 * (hi - lo)
    dot(fc.p0.xyz, c) + dot(abs(fc.p0.xyz), e) + fc.p0.w >= 0.0 &&
        dot(fc.p1.xyz, c) + dot(abs(fc.p1.xyz), e) + fc.p1.w >= 0.0 &&
        dot(fc.p2.xyz, c) + dot(abs(fc.p2.xyz), e) + fc.p2.w >= 0.0 &&
        dot(fc.p3.xyz, c) + dot(abs(fc.p3.xyz), e) + fc.p3.w >= 0.0 &&
        dot(fc.p4.xyz, c) + dot(abs(fc.p4.xyz), e) + fc.p4.w >= 0.0
}
/// Pass 0: Interval-culls candidate bricks across all things in a batch, computing both the
/// Lipschitz-narrowed distance range and the per-brick live part mask in one pass.
