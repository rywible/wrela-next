// The outline's exact cells, found each frame for the eye of that frame from what an extraction
// kept, so a mesh is extracted for no eye: its bricks, quads and certificates are the same from
// every eye, and only the cells beside its outline (which an eye sees edge-on, where a mesh can
// miss a pixel the field covers) change as the eye moves.
//
// An extraction keeps (`MeshBatch`'s watched state):
//   - each opaque quad it drew (`QuadRec`: where its indices are, its brick's slot, its four
//     cells and how they wind),
//   - each brick's slot (`SlotBrick`: its first corner's place on the lattice, its cell, the
//     parts live in it),
//   - each cell of a brick all of whose corners are outside (`SLOT_OUT`, one bit a cell),
//   - each all-outside cell near the surface with no surface beside it (`thin_keep`: a wand, a
//     tip, a crest Dual Contouring meshes none of), and the cells it gave exact cells for the eye
//     of no frame (folded quads, quads not drawn, seams).
// Each frame with a new eye (`outline_quads` onward): each kept quad on the outline for that eye
// puts its cells up for a certificate (held in `vert_cert` by its vertex, reused while the eye's
// pixel there is no finer than the one it was made for), and each all-outside cell beside one,
// and each kept thin cell, has its core asked of the field; what nothing proves gets an exact
// cell, after the extraction's own.

use matter::certify::sheet_width
use matter::substance::Substance
use mesh::dc::{HOLE_PX, HOLE_REACH_PX, QUAD_OUTLINE, decode_cell, finer_than_a_hole, on_outline}
use mesh::grid::{
    ActiveBrick, BRICK, ExactCell, FrustumCull, GridSpec, MeshVertex, NONE, TALLY_RUNS, TALLY_SHORT,
    TALLY_DUE_COARSER, TALLY_DUE_FAILED, TALLY_DUE_NONE, TALLY_ROOMLESS_BESIDE, TALLY_ROOMLESS_CERT,
    TALLY_ROOMLESS_KEPT, TALLY_UNASKED, TALLY_UNPROVEN, box_in_frustum, cell_live, unpack_oct_normal,
}
use std::derive::Box3
use std::field::{Field, Live}
use std::gpu::{Append, Atomics, DispatchArgs, GlobalId, Slots}

/// An opaque quad an extraction drew: `x` where its six indices begin, `y` its brick's slot (bits
/// 0..30), whether its cells wind against their order (bit 30: `quad_order`'s `flip`) and its
/// split (bit 31: `split_13`), `z` its first three cells (9 bits each, `x + 7y + 49z` in the
/// brick) and `w` its fourth, in the order of their vertices before `flip`.
pub type QuadRec = vec4u

/// A brick's slot: its first corner on the lattice (`grid::lattice`'s index, the grid's
/// `cell_offset` with it), its cell, the thing of its batch it is of (`GridSpec::orig_id`), and
/// the parts live in it. Stored packed as `SLOT_BRICK_WORDS` (`9`) `u32` words so pooled extraction
/// can write at GPU-allocated slots without CPU alignment padding.
pub struct SlotBrick: Copy + GpuData {
    pub base: vec3u,
    pub cell: f32,
    pub live: Live,
    pub orig: u32,
    pub pad0: u32,
    pub pad1: u32,
    pub pad2: u32,
}

/// Number of `u32` words stored per slot in `MeshBatch::slot_bricks`.
pub const SLOT_BRICK_WORDS: u32 = 9

/// Loads slot `slot` from packed `slots` (`SLOT_BRICK_WORDS` per slot).
pub fn load_slot(slots: [u32], slot: u32) -> SlotBrick {
    let b = slot * SLOT_BRICK_WORDS
    SlotBrick {
        base: vec3u(slots[b], slots[b + 1], slots[b + 2]),
        cell: bitcast_f32(slots[b + 3]),
        live: Live { words: vec4u(slots[b + 4], slots[b + 5], slots[b + 6], slots[b + 7]) },
        orig: slots[b + 8],
        pad0: 0,
        pad1: 0,
        pad2: 0,
    }
}

/// The words a slot keeps of its cells (343 of them, a bit each, 11 words): those all of whose
/// corners are outside (`SLOT_OUT`), and this frame's outline cells (`SLOT_LINE`), cells given an
/// exact cell (`SLOT_EXACT`) and outline cells put up for a certificate (`SLOT_CERT`).
pub const SLOT_WORDS: u32 = 56
pub const SLOT_OUT: u32 = 0
pub const SLOT_LINE: u32 = 11
pub const SLOT_EXACT: u32 = 22
pub const SLOT_CERT: u32 = 33
/// And, kept from frame to frame: the all-outside cells beside an outline whose core its
/// enclosure proved empty (`SLOT_BESIDE`), and the widest margin such a proof was made at
/// (`SLOT_MARGIN`, an `f32`'s bits): each holds while the slot's cells' margins are no
/// narrower (`stale_beside` clears them where the eye has come nearer).
pub const SLOT_BESIDE: u32 = 44
pub const SLOT_MARGIN: u32 = 55

/// How much narrower than an eye needs a certificate's slab is taken before it stops (it may
/// stop sooner where it can say no more), and how much wider than needed a thin cell's proof is
/// made: so an eye coming nearer does not ask again each frame.
pub const WATCH_SLACK: f32 = 0.75

/// The place of corner `c` (in a brick, `0..8`) of the brick in slot `s`: `grid::lattice`'s sum,
/// bit for bit.
pub fn slot_corner(s: SlotBrick, origin: vec3, shift: vec3, c: vec3u) -> vec3 {
    let n = s.base + c
    origin + vec3(f32(n.x), f32(n.y), f32(n.z)) * s.cell + shift
}

/// Cell `k` (`x + 7y + 49z`) as its three coordinates.
fn cell3(k: u32) -> vec3u {
    let (x, y, z) = decode_cell(k)
    vec3u(x, y, z)
}

/// Sets bit `cell` of a slot's set `set` (`SLOT_*`), and says whether it was clear.
fn mark(bits: mut Atomics<u32>, slot: u32, set: u32, cell: u32) -> bool {
    let word = slot * SLOT_WORDS + set + (cell >> 5)
    let bit = 1 << (cell & 31)
    (bits.or(i: word, value: bit) & bit) == 0
}

fn marked(bits: mut Atomics<u32>, slot: u32, set: u32, cell: u32) -> bool {
    (bits.load(i: slot * SLOT_WORDS + set + (cell >> 5)) & (1 << (cell & 31))) != 0
}

/// Clears this frame's sets of each live slot (`SLOT_LINE`, `SLOT_EXACT`, `SLOT_CERT`).
@strict
@compute(64)
pub(package) fn forget_frame(slots: u32, bits: mut Atomics<u32>, id: GlobalId) {
    let per = SLOT_BESIDE - SLOT_LINE
    let s = id.x / per
    if s >= slots {
        return
    }
    bits.store(i: s * SLOT_WORDS + SLOT_LINE + (id.x - s * per), value: 0)
}

/// Gives cell `cell` of slot `slot` an exact cell, once a frame.
fn exact_once<M: Field<Substance>>(
    f: M,
    s: SlotBrick,
    slot: u32,
    cell: u32,
    origin: vec3,
    shift: vec3,
    bits: mut Atomics<u32>,
    exact_cells: mut Append<ExactCell>,
) {
    if mark(mut bits, slot, SLOT_EXACT, cell) {
        let lo = slot_corner(s, origin, shift, cell3(cell))
        let _ = exact_cells.push(ExactCell { lo, h: s.cell, live: cell_live(f, lo, s.cell, s.live) })
    }
}

/// Gives cell `cell` of slot `slot` an exact cell, once a frame, with the parts live in its brick
/// (more than live in the cell, which costs its rays more and draws the same): for a cell put
/// up past its list's room, asked nothing of the field.
fn exact_once_brick(
    s: SlotBrick,
    slot: u32,
    cell: u32,
    origin: vec3,
    shift: vec3,
    bits: mut Atomics<u32>,
    exact_cells: mut Append<ExactCell>,
) {
    if mark(mut bits, slot, SLOT_EXACT, cell) {
        let _ = exact_cells.push(ExactCell { lo: slot_corner(s, origin, shift, cell3(cell)), h: s.cell, live: s.live })
    }
}

/// Each kept quad (`QuadRec`) of a live slot, held to the eye `eye` (`xyz` its place, `w` its
/// pixel's width a metre out): on the outline (`on_outline`, the eye this frame's alone) and not
/// finer than a hole there, its four cells are this frame's outline cells (`SLOT_LINE`), each
/// put up for a certificate once (`cert_cands`: `(slot << 9 | cell, vertex)`), and each of its
/// all-outside face neighbours in the brick (`SLOT_OUT`) put up as a thin candidate
/// (`thin_cands`: `slot << 9 | cell`), for what of the field reaches past the outline. A cell put
/// up past the room this frame's slices give its list (`cands_room`, `beside_room`) is given an
/// exact cell instead: nothing this frame is left unsaid (the slices are sized by counts read
/// frames late, and a pool's commit or a turn brought five times them).
@strict
@compute(64)
pub(package) fn outline_quads(
    quads: [QuadRec],
    quad_count: [u32],
    cap_quads: u32,
    indices: [u32],
    verts: [MeshVertex],
    slots: [u32],
    alive: [u32],
    origin: vec3,
    shift: vec3,
    first: u32,
    eye: vec4,
    fc: FrustumCull,
    cands_room: u32,
    beside_room: u32,
    bits: mut Atomics<u32>,
    cert_cands: mut Append<vec2u>,
    thin_cands: mut Append<u32>,
    exact_cells: mut Append<ExactCell>,
    id: GlobalId,
) {
    let qi = first + id.x
    if qi >= min(quad_count[0], cap_quads) {
        return
    }
    let q = quads[qi]
    let slot = q.y & 1073741823
    if alive[slot] == 0 {
        return
    }
    let s = load_slot(slots, slot)
    let blo = slot_corner(s, origin, shift, vec3u(0, 0, 0))
    let bside = s.cell * f32(BRICK + 2)
    if !box_in_frustum(blo - vec3(s.cell), blo + vec3(bside), fc) {
        return
    }
    let flip = ((q.y >> 30) & 1) != 0
    let split13 = (q.y >> 31) != 0
    // The quad's corners as stored (`store_quad`): (a, b, c, a, c, d), its corners (q0..q3)
    // `(d, a, b, c)` where it is split along `q1–q3`, else `(a, b, c, d)`.
    let a = indices[q.x]
    let b = indices[q.x + 1]
    let c = indices[q.x + 2]
    let d = indices[q.x + 5]
    let (q0, q1, q2, q3) = if split13 { (d, a, b, c) } else { (a, b, c, d) }
    let v0 = verts[q0]
    let v1 = verts[q1]
    let v2 = verts[q2]
    let v3 = verts[q3]
    let p0 = vec3(v0.px, v0.py, v0.pz)
    let p1 = vec3(v1.px, v1.py, v1.pz)
    let p2 = vec3(v2.px, v2.py, v2.pz)
    let p3 = vec3(v3.px, v3.py, v3.pz)
    let kind = on_outline(
        p0,
        p1,
        p2,
        p3,
        unpack_oct_normal(v0.packed),
        unpack_oct_normal(v1.packed),
        unpack_oct_normal(v2.packed),
        unpack_oct_normal(v3.packed),
        split13: split13,
        e: eye.xyz,
        reach: 0.0,
    )
    if kind != QUAD_OUTLINE {
        return
    }
    let cs = [q.z & 511, (q.z >> 9) & 511, (q.z >> 18) & 511, q.w & 511]
    if finer_than_a_hole(slot_corner(s, origin, shift, cell3(cs[0])), s.cell, eye) {
        return
    }
    // The vertices of the cells, in the cells' order (`quad_order` undone).
    let vs = if flip { [q0, q3, q2, q1] } else { [q0, q1, q2, q3] }
    for k in 0..4 {
        let cell = cs[k]
        if mark(mut bits, slot, SLOT_LINE, cell) {
            if mark(mut bits, slot, SLOT_CERT, cell) {
                if cert_cands.push(vec2u((slot << 9) | cell, vs[k])) >= cands_room {
                    exact_once_brick(s, slot, cell, origin, shift, mut bits, mut exact_cells)
                }
            }
            let (cx, cy, cz) = decode_cell(cell)
            for f in 0..6 {
                let axis = f >> 1
                let up = (f & 1) == 1
                let at = if axis == 0 { cx } else if axis == 1 { cy } else { cz }
                if (up && at < BRICK) || (!up && at > 0) {
                    let step = if axis == 0 { 1 } else if axis == 1 { 7 } else { 49 }
                    let n = if up { cell + step } else { cell - step }
                    if marked(mut bits, slot, SLOT_OUT, n) && mark(mut bits, slot, SLOT_LINE, n) &&
                        !marked(mut bits, slot, SLOT_BESIDE, n) {
                        if thin_cands.push((slot << 9) | n) >= beside_room {
                            exact_once_brick(s, slot, n, origin, shift, mut bits, mut exact_cells)
                        }
                    }
                }
            }
        }
    }
}

/// Each outline cell put up for a certificate (`outline_quads`), held to what its vertex's
/// certificate says (`vert_cert`: the width of the slab that holds the cell's surface,
/// `matter::certify::sheet_width`): a slab no wider than this frame's needs (`HOLE_REACH_PX`
/// pixels: a mesh and surface nearer than that across it miss no pixel whose middle the field
/// covers half a pixel to each side, the audit's hole, whichever way the outline runs; at
/// `HOLE_PX` the pillars lost 16 at an outline, at twice it the crowd's near body one) holds,
/// and the cell needs nothing; a wider one that is all its certificate can say fails, and the
/// cell is given an exact cell; one not yet made, or one that stopped at a wider slab than this
/// eye needs, is put up to be certified (`due`), or given an exact cell where that is past the
/// room `certify_watched`'s slices give it this frame (`room`).
@strict
@compute(64)
pub(package) fn cert_due<M: Field<Substance>>(
    fields: [M],
    slots: [u32],
    cert_cands: [vec2u],
    cert_count: [u32],
    cap: u32,
    first: u32,
    origin: vec3,
    shift: vec3,
    eye: vec4,
    vert_cert: mut Atomics<u32>,
    bits: mut Atomics<u32>,
    exact_cells: mut Append<ExactCell>,
    room: u32,
    due: mut Append<u32>,
    id: GlobalId,
) {
    let i = first + id.x
    if i >= min(cert_count[0], cap) {
        return
    }
    let packed = cert_cands[i].x
    let vi = cert_cands[i].y
    let slot = packed >> 9
    let cell = packed & 511
    let s = load_slot(slots, slot)
    if vi != NONE {
        let lo = slot_corner(s, origin, shift, cell3(cell))
        let need = HOLE_REACH_PX * length(eye.xyz - (lo + vec3(0.5 * s.cell))) * eye.w
        let kept = bitcast_f32(vert_cert.load(i: vi))
        if abs(kept) <= need && kept != 0.0 {
            return
        }
        if !(kept < 0.0) && due.push(i) < room {
            return
        }
    }
    exact_once(fields[s.orig], s, slot, cell, origin, shift, mut bits, mut exact_cells)
}

/// Each outline cell `cert_due` put up: the width of the slab that holds its surface
/// (`sheet_width`), narrowed until it is `WATCH_SLACK` of what this frame's pixel needs or the
/// certificate can say no more, and an exact cell where that is wider than the need; the width
/// kept in `vert_cert`, by vertex, for every later eye (a cache of them by the cell's place, `place_cert_*`, was not sound:
/// a static citadel's far floor, its cells taken as certified from earlier eyes, drew 203 pixels
/// of sky at its sixth).
@strict
@compute(64)
pub(package) fn certify_watched<M: Field<Substance>>(
    fields: [M],
    slots: [u32],
    verts: [MeshVertex],
    cert_cands: [vec2u],
    due: [u32],
    due_count: [u32],
    cap: u32,
    first: u32,
    origin: vec3,
    shift: vec3,
    eye: vec4,
    vert_cert: mut Atomics<u32>,
    bits: mut Atomics<u32>,
    exact_cells: mut Append<ExactCell>,
    id: GlobalId,
) {
    let i = first + id.x
    if i >= min(due_count[0], cap) {
        return
    }
    let at = due[i]
    let packed = cert_cands[at].x
    let vi = cert_cands[at].y
    let slot = packed >> 9
    let cell = packed & 511
    let s = load_slot(slots, slot)
    let lo = slot_corner(s, origin, shift, cell3(cell))
    let need = HOLE_REACH_PX * length(eye.xyz - (lo + vec3(0.5 * s.cell))) * eye.w
    let v = verts[vi]
    let (w, all) = sheet_width(
        fields,
        s.orig,
        s.live,
        lo,
        s.cell,
        vec3(v.px, v.py, v.pz),
        unpack_oct_normal(v.packed),
        WATCH_SLACK * need,
    )
    // Kept: the slab's width, the surface's own and no eye's; negative where it is all the
    // certificate can say (asked again it would say the same).
    let kept = max(w, 1.0e-30)
    vert_cert.store(i: vi, value: bitcast_u32(if all { -kept } else { kept }))
    if !(w <= need) {
        exact_once(fields[s.orig], s, slot, cell, origin, shift, mut bits, mut exact_cells)
    }
}

/// The core of cell `cell` of slot `s` for the eye `eye` (the cell
/// less a quarter pixel on every side), as its low corner and width; a width of 0 or less where
/// the cell is thinner than a hole.
fn watched_core(s: SlotBrick, origin: vec3, shift: vec3, cell: u32, eye: vec4) -> (vec3, f32) {
    let lo = slot_corner(s, origin, shift, cell3(cell))
    let px = length(eye.xyz - (lo + vec3(0.5 * s.cell))) * eye.w
    let m = 0.5 * HOLE_PX * px
    (lo + vec3(m), s.cell - 2.0 * m)
}

/// What a thin list's tests are of (`thin_watched`, `thin_watched_octants`' `keep`): the cells
/// beside this frame's outline (their proofs kept in the slot's bits), the kept thin cells due
/// for this eye (`thin_due`'s list, into `thin_keep`), and the kept thin cells a chunk has just
/// meshed (`thin_keep` itself, from `from[0]`: proven for the eye of the update that meshes
/// them, in the chunk, so a commit that draws their slots brings none due; their slots are not
/// yet alive, and they give no exact cell, which is a frame's).
pub(package) const THIN_BESIDE: u32 = 0
pub(package) const THIN_DUE: u32 = 1
pub(package) const THIN_MESHED: u32 = 2

/// A thin candidate's first half: the core whole, and the
/// octants its form doesn't clear into `thin_masks` (a slice's, by invocation). A kept
/// candidate's (`keep` not `THIN_BESIDE`) proof is kept for this eye's margin (`thin_proof`, the
/// core's margin it was proven empty at: an eye whose margin there is no finer holds it): the whole core's, or, where its form leaves octants to ask, the same
/// until `thin_watched_octants` (dispatched over the same slice after it) finds one it can't
/// prove empty and undoes it.
@strict
@compute(64)
pub(package) fn thin_watched<M: Field<Substance>>(
    fields: [M],
    slots: [u32],
    alive: [u32],
    cands: [u32],
    order: [u32],
    count: [u32],
    cap: u32,
    from: [u32],
    first: u32,
    origin: vec3,
    shift: vec3,
    eye: vec4,
    keep: u32,
    thin_proof: mut Atomics<u32>,
    bits: mut Atomics<u32>,
    thin_masks: mut Slots<u32>,
    id: GlobalId,
) {
    let i = from[0] + first + id.x
    thin_masks[id] = 0
    if i >= min(count[0], cap) {
        return
    }
    // A due cell's place in `thin_keep` (from `thin_due`'s list), or the cell's own.
    let at = if keep == THIN_DUE { order[i] } else { i }
    let packed = cands[at]
    if keep != THIN_MESHED && alive[packed >> 9] == 0 {
        return
    }
    let s = load_slot(slots, packed >> 9)
    let cell = packed & 511
    let (lo, w) = watched_core(s, origin, shift, cell, eye)
    if w <= 0.0 {
        return
    }
    let m = 0.5 * (s.cell - w)
    // Asked for `WATCH_SLACK` of this frame's margin: a wider core, held by eyes nearer still.
    let mt = WATCH_SLACK * m
    let lt = lo - vec3(m - mt)
    let wt = w + 2.0 * (m - mt)
    let af = fields[s.orig].slope_affine(Box3 { lo: lt, hi: lt + vec3(wt) }, s.live)
    var mask: u32 = 0
    if af.lo() <= 0.0 {
        for j in 0..8 {
            if af.octant_range(j).lo <= 0.0 {
                mask = mask | (u32(1) << j)
            }
        }
    }
    // A kept cell's proof is kept for the octants to undo (they are dispatched over the slice
    // this one is, so none is left unconfirmed); a beside cell's only where the whole core is
    // proven here. A pool keeps it from eye to eye (a citadel's far floor, its thin cells taken
    // as proven, drew 136 pixels of sky): it holds only while an eye's margin is no finer.
    if keep != THIN_BESIDE {
        thin_proof.store(i: at, value: bitcast_u32(mt))
    } else if mask == 0 {
        let slot = packed >> 9
        let _ = bits.or(i: slot * SLOT_WORDS + SLOT_BESIDE + (cell >> 5), value: 1 << (cell & 31))
        let _ = bits.max(i: slot * SLOT_WORDS + SLOT_MARGIN, value: bitcast_u32(mt))
    }
    thin_masks[id] = mask
}

/// The second half: an octant of a candidate's core an invocation (eight a candidate), each the
/// octant's own enclosure where the whole's form didn't clear it; an exact cell for a candidate
/// one of whose octants the field's enclosure can't prove empty (and its proof undone; for a
/// cell just meshed, `THIN_MESHED`, no exact cell: those are a frame's).
@strict
@compute(64)
pub(package) fn thin_watched_octants<M: Field<Substance>>(
    fields: [M],
    slots: [u32],
    alive: [u32],
    cands: [u32],
    order: [u32],
    count: [u32],
    cap: u32,
    thin_masks: [u32],
    from: [u32],
    first: u32,
    origin: vec3,
    shift: vec3,
    eye: vec4,
    keep: u32,
    thin_proof: mut Atomics<u32>,
    bits: mut Atomics<u32>,
    exact_cells: mut Append<ExactCell>,
    id: GlobalId,
) {
    let i = from[0] + first + id.x / 8
    let j = id.x % 8
    if i >= min(count[0], cap) {
        return
    }
    let tm = thin_masks[id.x / 8]
    if ((tm >> j) & 1) == 0 {
        return
    }
    let at = if keep == THIN_DUE { order[i] } else { i }
    let packed = cands[at]
    let slot = packed >> 9
    if keep != THIN_MESHED && alive[slot] == 0 {
        return
    }
    let cell = packed & 511
    let s = load_slot(slots, slot)
    let f = fields[s.orig]
    let (lo, w) = watched_core(s, origin, shift, cell, eye)
    let m = 0.5 * (s.cell - w)
    let mt = WATCH_SLACK * m
    let lt = lo - vec3(m - mt)
    let wt = w + 2.0 * (m - mt)
    let o = lt + vec3(f32(j & 1), f32((j >> 1) & 1), f32((j >> 2) & 1)) * (0.5 * wt)
    let af = f.slope_affine(Box3 { lo: o, hi: o + vec3(0.5 * wt) }, s.live)
    if af.lo() <= 0.0 {
        // Failed: an exact cell for this eye, and for any whose margin is no wider than this
        // one's by the slack a proof is made with (`WATCH_SLACK`): asked again only past it, as a
        // proof is. (An exact cell where the core might be proven empty draws nothing amiss. Kept
        // at the wider core asked, `mt`, the cell came up again for the same eye each frame, and
        // at this eye's margin, each frame of an eye going back from it: SCENE 13 VIEW 3's
        // kept lists put 9,000 to 94,000 cells due a run.)
        if keep != THIN_BESIDE {
            thin_proof.store(i: at, value: bitcast_u32(-m / WATCH_SLACK))
        } else {
            let _ = bits.and(
                i: slot * SLOT_WORDS + SLOT_BESIDE + (cell >> 5),
                value: NONE ^ (u32(1) << (cell & 31)),
            )
        }
        if keep != THIN_MESHED {
            exact_once(f, s, slot, cell, origin, shift, mut bits, mut exact_cells)
        }
    }
}

/// The args of a chunk's just-meshed thin cells' tests (`thin_watched` in `whole`, its octants in
/// `octs`, `slices` of `most` from `first[0]`), and the most a chunk kept noted in `seen[16]`
/// (what the next chunks' slices are sized by: `MeshBatch::thin_slices`); those past its slices
/// are left unproven, for the watch to ask (`thin_due`), and counted in `tally`.
@strict
@compute(64)
pub(package) fn prep_meshed_thin(
    count: [u32],
    cap: u32,
    first: [u32],
    most: u32,
    slices: u32,
    whole: mut Slots<DispatchArgs>,
    octs: mut Slots<DispatchArgs>,
    seen: mut Atomics<u32>,
    tally: mut Atomics<u32>,
    id: GlobalId,
) {
    if id.x >= slices {
        return
    }
    let n = min(count[0], cap)
    let at = first[0] + id.x * most
    let m = if n > at { min(n - at, most) } else { 0 }
    whole[id] = DispatchArgs { x: (m + 63) / 64, y: 1, z: 1 }
    octs[id] = DispatchArgs { x: (m * 8 + 63) / 64, y: 1, z: 1 }
    if id.x == 0 && n > first[0] {
        let _ = seen.max(i: 16, value: n - first[0])
        if n - first[0] > slices * most {
            let _ = tally.add(i: TALLY_UNPROVEN, value: n - first[0] - slices * most)
        }
    }
}

/// Each active brick of a chunk (`chunk_start` on) of a held mesh: writes its packed `SlotBrick`
/// words into `slots` at `slot = slot_base[0] + bi`, and clears its `SLOT_OUT`/`SLOT_BESIDE`/
/// `SLOT_MARGIN` bits.
@strict
@compute(64)
pub(package) fn keep_slots(
    grids: [GridSpec],
    active: [ActiveBrick],
    active_count: [u32],
    cap_bricks: u32,
    chunk_start: u32,
    slot_base: [u32],
    max_slots: u32,
    slots: mut Atomics<u32>,
    bits: mut Atomics<u32>,
    id: GlobalId,
) {
    let bi = chunk_start + id.x
    if bi >= min(active_count[0], cap_bricks) {
        return
    }
    let slot = slot_base[0] + bi
    if slot >= max_slots {
        return
    }
    let ab = active[bi]
    let g = grids[ab.coord.w]
    let base = ab.coord.xyz * BRICK + g.cell_offset
    let sb = slot * SLOT_BRICK_WORDS
    slots.store(i: sb, value: base.x)
    slots.store(i: sb + 1, value: base.y)
    slots.store(i: sb + 2, value: base.z)
    slots.store(i: sb + 3, value: bitcast_u32(g.cell))
    slots.store(i: sb + 4, value: ab.live.words.x)
    slots.store(i: sb + 5, value: ab.live.words.y)
    slots.store(i: sb + 6, value: ab.live.words.z)
    slots.store(i: sb + 7, value: ab.live.words.w)
    slots.store(i: sb + 8, value: g.orig_id)
    for w in 0..11 {
        bits.store(i: slot * SLOT_WORDS + SLOT_OUT + w, value: 0)
        bits.store(i: slot * SLOT_WORDS + SLOT_BESIDE + w, value: 0)
    }
    bits.store(i: slot * SLOT_WORDS + SLOT_MARGIN, value: 0)
}

/// Each live slot whose beside proofs (`SLOT_BESIDE`) may no longer hold for the eye `eye`: its
/// nearest cell's margin narrower than the widest it proved one at (`SLOT_MARGIN`). Its proofs
/// are forgotten, to be made again for this eye.
@strict
@compute(64)
pub(package) fn stale_beside(
    count: u32,
    slots: [u32],
    alive: [u32],
    origin: vec3,
    shift: vec3,
    eye: vec4,
    bits: mut Atomics<u32>,
    id: GlobalId,
) {
    let slot = id.x
    if slot >= count || alive[slot] == 0 {
        return
    }
    let kept = bitcast_f32(bits.load(i: slot * SLOT_WORDS + SLOT_MARGIN))
    if !(kept > 0.0) {
        return
    }
    let s = load_slot(slots, slot)
    let lo = slot_corner(s, origin, shift, vec3u(0, 0, 0))
    let side = s.cell * f32(BRICK + 1)
    let near = length(max(max(lo - eye.xyz, eye.xyz - (lo + vec3(side))), vec3(0.0)))
    if 0.5 * HOLE_PX * near * eye.w >= kept {
        return
    }
    for w in 0..11 {
        bits.store(i: slot * SLOT_WORDS + SLOT_BESIDE + w, value: 0)
    }
    bits.store(i: slot * SLOT_WORDS + SLOT_MARGIN, value: 0)
}

/// A watch run's counts (`MeshBatch::watch_counts`: outline cells put up for a certificate `[0]`,
/// thin cells beside the outline `[1]`, kept thin cells due `[2]`, certificate candidates `[7]`,
/// kept thin cells `[9]`, kept quads `[14]`) held to its lists' rooms (`room`, in that order of
/// the first four) and to what its slices examined of the quads and the kept cells (`examined`):
/// the run counted in `tally` (`grid::TALLY_RUNS`); where quads or kept cells were left
/// unexamined, a short run (`TALLY_SHORT`) and the cells it left (`TALLY_UNASKED`); and the cells
/// put up past a list's room, given exact cells (`TALLY_ROOMLESS_*`).
@strict
@compute(1)
pub(package) fn watch_tally(
    counts: [u32],
    room: vec4u,
    examined: vec2u,
    quads_cap: u32,
    kept_cap: u32,
    tally: mut Atomics<u32>,
    id: GlobalId,
) {
    let _ = id
    let cert = (if counts[0] > room.x { counts[0] - room.x } else { 0 }) +
        (if counts[7] > room.w { counts[7] - room.w } else { 0 })
    let beside = if counts[1] > room.y { counts[1] - room.y } else { 0 }
    let kept = if counts[2] > room.z { counts[2] - room.z } else { 0 }
    let quads = min(counts[14], quads_cap)
    let thin = min(counts[9], kept_cap)
    let left = (if quads > examined.x { quads - examined.x } else { 0 }) +
        (if thin > examined.y { thin - examined.y } else { 0 })
    let _ = tally.add(i: TALLY_RUNS, value: 1)
    let _ = tally.add(i: TALLY_ROOMLESS_CERT, value: cert)
    let _ = tally.add(i: TALLY_ROOMLESS_BESIDE, value: beside)
    let _ = tally.add(i: TALLY_ROOMLESS_KEPT, value: kept)
    if left > 0 {
        let _ = tally.add(i: TALLY_SHORT, value: 1)
        let _ = tally.add(i: TALLY_UNASKED, value: left)
    }
}

/// Zeroes `words`.
@strict
@compute(64)
pub(package) fn zero_words(words: mut Slots<u32>, id: GlobalId) {
    words[id] = 0
}

/// Each kept thin cell (`thin_keep`) of a live slot in view, held to its last proof
/// (`thin_proof`) for the eye `eye`: proven empty at a margin no finer than the eye's, nothing;
/// failed at a margin no finer (its core holds the one that failed), an exact cell, at once; else
/// (proven at a finer margin, failed at a coarser one, or none) put up to be asked again this
/// frame (`due`: its place in `thin_keep`). A pass over every kept cell, so the asking is of the
/// few the eye's move left unsaid, and a list of what a turn brings into view only of those (the
/// cells failed, asked each frame they were in view, were 7.5 million of SCENE 13 VIEW 3's 8.1
/// million due and came due with every turn). One put up past the room this frame's slices give
/// the list (`room`) is given an exact cell.
@strict
@compute(64)
pub(package) fn thin_due<M: Field<Substance>>(
    fields: [M],
    cands: [u32],
    count: [u32],
    cap: u32,
    slots: [u32],
    alive: [u32],
    origin: vec3,
    shift: vec3,
    first: u32,
    eye: vec4,
    fc: FrustumCull,
    thin_proof: [u32],
    bits: mut Atomics<u32>,
    exact_cells: mut Append<ExactCell>,
    room: u32,
    due: mut Append<u32>,
    tally: mut Atomics<u32>,
    id: GlobalId,
) {
    let i = first + id.x
    if i >= min(count[0], cap) {
        return
    }
    let packed = cands[i]
    let slot = packed >> 9
    if alive[slot] == 0 {
        return
    }
    let s = load_slot(slots, slot)
    let blo = slot_corner(s, origin, shift, vec3u(0, 0, 0))
    let bside = s.cell * f32(BRICK + 2)
    if !box_in_frustum(blo - vec3(s.cell), blo + vec3(bside), fc) {
        return
    }
    let (_, w) = watched_core(s, origin, shift, packed & 511, eye)
    if w <= 0.0 {
        return
    }
    let m = 0.5 * (s.cell - w)
    let proven = bitcast_f32(thin_proof[i])
    if proven > 0.0 && proven <= m {
        return
    }
    if proven < 0.0 && -proven >= m {
        let _ = tally.add(i: TALLY_DUE_FAILED, value: 1)
        exact_once(fields[s.orig], s, slot, packed & 511, origin, shift, mut bits, mut exact_cells)
        return
    }
    let why = if proven > 0.0 { TALLY_DUE_COARSER } else { TALLY_DUE_NONE }
    let _ = tally.add(i: why, value: 1)
    if due.push(i) >= room {
        exact_once(fields[s.orig], s, slot, packed & 511, origin, shift, mut bits, mut exact_cells)
    }
}

/// Each outline cell put up for a certificate given an exact cell, unasked: where one invocation
/// of `certify_watched` would do more than a dispatch's invocation may on this device (its field's
/// enclosure too costly for its visits, `certify_sheet`), the cells are solved instead.
@strict
@compute(64)
pub(package) fn uncertified<M: Field<Substance>>(
    fields: [M],
    slots: [u32],
    cert_cands: [vec2u],
    cert_count: [u32],
    cap: u32,
    first: u32,
    origin: vec3,
    shift: vec3,
    bits: mut Atomics<u32>,
    exact_cells: mut Append<ExactCell>,
    id: GlobalId,
) {
    let i = first + id.x
    if i >= min(cert_count[0], cap) {
        return
    }
    let packed = cert_cands[i].x
    let slot = packed >> 9
    let s = load_slot(slots, slot)
    exact_once(fields[s.orig], s, slot, packed & 511, origin, shift, mut bits, mut exact_cells)
}
