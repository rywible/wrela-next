// `MeshSight` frame orchestration: prepares batches, shadows, radiance, SDF clipmap, Hi-Z,
// opaque + indirect lighting, transmissive refraction, TSR, volumetric froxels, bloom, and tone.

use matter::height::{Height, NoHeight}
use matter::medium::{Medium, NoMedium}
use matter::sky::Sky
use matter::swarm::{NoSwarm, Swarm}
use matter::world::one
use mesh::cull::{HiZCuller, hiz_culler}
use mesh::extract::{ExtractScratch, MeshBatch, extract_scratch, mesh_batch}
use mesh::height::{CLIP_RINGS, ClipmapMesh, clipmap_mesh, height_vs}
use mesh::light::{
    RadianceCache, SHADOW_SIDE, ShadowView, SkyCache, radiance_cache, shadow_view, sky_cache,
}
use mesh::sdf::{SdfClipmap, sdf_clipmap, sdf_grid}
use mesh::shade::{
    BATCH_BRICKS, FOCUS_RAD, combine_indirect_fs, copy_dc_depth, deferred_direct_fs,
    deferred_direct_judge_fs, indirect_half_fs, mesh_gbuf_fs, mesh_trans_fs, place_with_trans_fs,
    refract_refl_fs, shadow_fs,
}
use mesh::swarm::{SwarmSim, swarm_fs, swarm_shadow_vs, swarm_sim, swarm_vs}
use mesh::tsr::{TsrState, halton_jitter, tsr_state}
use mesh::volume::{BloomPyramid, FroxelVolume, bloom_pyramid, froxel_volume, hdr_tone_fs}
use mesh::world_draw::draw_shadow_casters
use picture::eye::{Eye, View, view}
use picture::look::Look
use picture::picture::{Picture, picture}
use picture::screen::{cover, luma, show}
use std::collections::Vec
use std::gpu::{
    Address, Compare, ComparisonSampler, Cull, Depth, DepthBias, DepthOnlyPass, DepthPass,
    DepthPass2, DepthPass4, DepthTexture, Filter, GpuBuffer, R16Float, R32Float, Rg16Float, Rgba8,
    Rgba16Float, Rgba32Float, Sampler, Texture, begin_depth_pass, begin_pass, begin_pass2,
    begin_pass2_with_depth, begin_pass4, begin_pass4_with_depth, begin_pass_with_depth, buffer_of,
    comparison_sampler, copy_texture, depth_texture, dispatch, draw, label, sampler, texture,
    writable_texture,
}
use std::hash::Hasher

pub use mesh::world_draw::MeshWorld

pub struct MeshSight {
    pub drawn: Picture,
    /// `drawn.place` with transmissive surfaces in it (`place_with_trans_fs`), copied back.
    place_all: Texture<Rgba32Float>,
    pub hdr_direct: Texture<Rgba16Float>,
    /// The sun's share of `hdr_direct` per pixel (`0..1` by luma): what the contact shadow darkens.
    pub sun_share: Texture<R16Float>,
    pub g_normal: Texture<Rgba8>,
    pub g_albedo: Texture<Rgba8>,
    pub g_emits: Texture<Rgba16Float>,
    pub g_motion: Texture<Rg16Float>,
    pub gi_diff: Texture<Rgba16Float>,
    pub gi_spec: Texture<Rgba16Float>,
    pub refract_refl: Texture<Rgba16Float>,
    pub refract_depth: DepthTexture,
    pub hdr_colour: Texture<Rgba16Float>,
    pub hdr_bg: Texture<Rgba16Float>,
    pub depth: DepthTexture,
    dc_depth: Texture<R32Float>,
    pub sky: SkyCache,
    pub rad: RadianceCache,
    pub sdf: SdfClipmap,
    pub tsr: TsrState,
    pub vol: FroxelVolume,
    pub bloom: BloomPyramid,
    pub swarm: SwarmSim,
    pub cull: HiZCuller,
    scratch: ExtractScratch,
    clipmap: ClipmapMesh,
    cube_indices: GpuBuffer<u32>,
    batches: Vec<MeshBatch>,
    shadow_map: DepthTexture,
    /// The sun shadow map of the still batches alone (same `ShadowView`), drawn only when the
    /// static radiance cache rebuilds, so moving things' shadows are never baked into it.
    static_shadow_map: DepthTexture,
    cmp: ComparisonSampler,
    bg_s: Sampler,
    rad_key: u64,
    rad_built: bool,
    static_shadow_key: u64,
    static_shadow_valid: bool,
    has_static_shadow: bool,
    frame: u32,
    pub gi: bool,
}

/// Creates a fresh `MeshSight` with 2-cascade 3D SDF clipmap, 1× G-buffer + analytical motion
/// vectors + Halton-jittered Temporal Super-Resolution (TSR), pixel-rate deferred direct lighting,
/// 16×16 tiled dynamic emitters, phase-cycled half-res GI/SSR, half-res refract SSR + 3-channel
/// chromatic dispersion, froxel volumetrics, and optical HDR bloom.
pub fn mesh_sight(gi: bool = true) -> MeshSight {
    MeshSight {
        drawn: picture(width: 1, height: 1),
        place_all: texture(width: 1, height: 1),
        hdr_direct: texture(width: 1, height: 1),
        sun_share: texture(width: 1, height: 1),
        g_normal: texture(width: 1, height: 1),
        g_albedo: texture(width: 1, height: 1),
        g_emits: texture(width: 1, height: 1),
        g_motion: texture(width: 1, height: 1),
        gi_diff: texture(width: 1, height: 1),
        gi_spec: texture(width: 1, height: 1),
        refract_refl: texture(width: 1, height: 1),
        refract_depth: depth_texture(width: 1, height: 1),
        hdr_colour: texture(width: 1, height: 1),
        hdr_bg: texture(width: 1, height: 1),
        depth: depth_texture(width: 1, height: 1),
        dc_depth: writable_texture(width: 1, height: 1, levels: 1),
        sky: sky_cache(),
        rad: radiance_cache(),
        sdf: sdf_clipmap(),
        tsr: tsr_state(),
        vol: froxel_volume(),
        bloom: bloom_pyramid(),
        swarm: swarm_sim(),
        cull: hiz_culler(),
        scratch: extract_scratch(BATCH_BRICKS),
        clipmap: clipmap_mesh(),
        // A box's 36 vertices in order (`exact_box_vs` reads each one's corner and face).
        cube_indices: buffer_of(Vec::from_fn(36, |i: u32| i)),
        batches: Vec::new(),
        shadow_map: depth_texture(width: SHADOW_SIDE, height: SHADOW_SIDE),
        static_shadow_map: depth_texture(width: SHADOW_SIDE, height: SHADOW_SIDE),
        cmp: comparison_sampler(compare: Compare::LessEqual),
        bg_s: sampler(filter: Filter::Linear, address: Address::Clamp),
        rad_key: 0,
        rad_built: false,
        static_shadow_key: 0,
        static_shadow_valid: false,
        has_static_shadow: false,
        frame: 0,
        gi: gi,
    }
}

impl MeshSight {
    fn resize(mut self, width: u32, height: u32) {
        if self.drawn.width() != width || self.drawn.height() != height {
            let hw = max(width / 2, 1)
            let hh = max(height / 2, 1)
            self.drawn = picture(width: width, height: height)
            self.drawn.placed = true
            self.place_all = texture(width: width, height: height)
            self.hdr_direct = texture(width: width, height: height)
            self.sun_share = texture(width: width, height: height)
            self.g_normal = texture(width: width, height: height)
            self.g_albedo = texture(width: width, height: height)
            self.g_emits = texture(width: width, height: height)
            self.g_motion = texture(width: width, height: height)
            self.gi_diff = texture(width: hw, height: hh)
            self.gi_spec = texture(width: hw, height: hh)
            self.refract_refl = texture(width: hw, height: hh)
            self.refract_depth = depth_texture(width: hw, height: hh)
            self.hdr_colour = texture(width: width, height: height)
            self.hdr_bg = texture(width: width, height: height)
            self.depth = depth_texture(width: width, height: height)
            self.dc_depth = writable_texture(width: width, height: height, levels: 1)
            self.tsr.resize(width, height)
            self.cull.resize(width, height)
        }
    }

    fn ensure_batches(mut self, count: u32) {
        while self.batches.len() < count {
            self.batches.push(mesh_batch(BATCH_BRICKS))
        }
    }

    /// Updates Sky PMREM, syncs meshlets, builds/updates the 2-cascade 3D SDF clipmap, steps
    /// `swarm` accelerated by the SDF clipmap, renders the unified sun shadow map, and updates
    /// the camera-focused radiance volume & dynamic emitters.
    fn prepare_and_shadow<W: MeshWorld, Sw: Swarm, S: Sky>(
        mut self,
        world: W,
        fbufs: W::FieldBufs,
        swarm: Sw,
        sky: S,
        eye: Eye,
        width: u32,
        height: u32,
        frame: u32,
    ) -> (u32, View, ShadowView) {
        self.resize(width, height)
        let v = view(eye, width: width, height: height)

        self.sky.sync(sky)

        let nb = world.batch_count()
        self.ensure_batches(nb)
        self.scratch.begin_frame()
        world.sync_batches(mut self.scratch, mut self.batches, 0, v)

        var wlo = vec3(1.0e20)
        var whi = vec3(-1.0e20)
        var rk = Hasher::new()
        var sdf_fk = Hasher::new()
        var static_opaque_count: u32 = 0
        for i in 0..nb {
            self.batches[i].finish_poll()
            let b = self.batches[i].bound
            self.batches[i].hash.state_hash(mut rk)
            if self.batches[i].has_opaque {
                i.state_hash(mut sdf_fk)
                self.batches[i].hash.state_hash(mut sdf_fk)
                if self.batches[i].still_frames >= 1 {
                    static_opaque_count += 1
                }
            }
            if b.w > 0.0 {
                wlo = min(wlo, b.xyz - vec3(b.w))
                whi = max(whi, b.xyz + vec3(b.w))
            }
        }
        let wmid = 0.5 * (wlo + whi)
        let wrad = if whi.x > wlo.x { 0.5 * length(whi - wlo) } else { 10.0 }
        let sun = sky.sun()
        let sv = shadow_view(wmid, wrad, sun.way)

        // Focus near SDF cascade + radiance volume around camera look target (clamped to world).
        let focus_raw = v.at + v.forward * min(FOCUS_RAD * 0.75, wrad * 0.65)
        let focus = clamp(focus_raw, wlo, whi)

        // Pass 0b: Sparse 2-cascade 3D SDF clipmap (`96³` near + `64³` world, static/dynamic split).
        // Runs BEFORE `swarm.update` so grain physics uses 1-tap hardware SDF broad-phase culling.
        if !self.gi {
            self.sdf.disable(focus, wmid, wrad)
        } else {
            let sg = sdf_grid(focus, wmid, wrad, enabled: true)
            sg.o0.state_hash(mut sdf_fk)
            sg.v0.state_hash(mut sdf_fk)
            sg.o1.state_hash(mut sdf_fk)
            sg.v1.state_hash(mut sdf_fk)
            let full_sdf_key = sdf_fk.finish()
            if !self.sdf.full_valid || self.sdf.full_key != full_sdf_key {
                if static_opaque_count > 0 {
                    var ssk = Hasher::new()
                    sg.o0.state_hash(mut ssk)
                    sg.v0.state_hash(mut ssk)
                    sg.o1.state_hash(mut ssk)
                    sg.v1.state_hash(mut ssk)
                    for i in 0..nb {
                        if self.batches[i].has_opaque && self.batches[i].still_frames >= 1 {
                            i.state_hash(mut ssk)
                            self.batches[i].hash.state_hash(mut ssk)
                        }
                    }
                    let skey = ssk.finish()
                    if !self.sdf.static_valid || self.sdf.static_key != skey {
                        self.sdf.begin_static(sg)
                        world.splat_sdf(
                            mut self.sdf,
                            mut self.batches,
                            0,
                            static_only: true,
                            all_batches: false,
                        )
                        self.sdf.static_key = skey
                        self.sdf.static_valid = true
                    }
                    self.sdf.begin_from_static(sg)
                    world.splat_sdf(
                        mut self.sdf,
                        mut self.batches,
                        0,
                        static_only: false,
                        all_batches: false,
                    )
                } else {
                    self.sdf.begin_all(sg)
                    world.splat_sdf(
                        mut self.sdf,
                        mut self.batches,
                        0,
                        static_only: false,
                        all_batches: true,
                    )
                }
                self.sdf.finish()
                self.sdf.full_key = full_sdf_key
                self.sdf.full_valid = true
            } else {
                self.sdf.grid = sg
            }
        }

        let swarm_steps = self.swarm.begin_update(swarm)
        if swarm_steps > 0 {
            let rest = swarm.restitution()
            let fric = swarm.friction()
            for _s in 0..swarm_steps {
                self.swarm.integrate_once(
                    swarm,
                    self.sdf.grid,
                    self.sdf.sdf0,
                    self.sdf.sdf1,
                    self.sdf.s,
                )
                world.collide_swarm(fbufs, mut self.swarm, rest, fric)
            }
        }

        // Pass 1: Static/dynamic split sun shadow maps (one cached `2048²` static map rebuilt only
        // when still architecture or sun changes — 0.000 ms on steady frames — plus one dynamic
        // map for moving characters/spells/swarm, paired with exact 3D SDF cone penumbra).
        var static_sh_key = Hasher::new()
        sv.centre.state_hash(mut static_sh_key)
        sv.radius.state_hash(mut static_sh_key)
        sun.way.state_hash(mut static_sh_key)
        for i in 0..nb {
            if self.batches[i].has_opaque && self.batches[i].still_frames >= 1 {
                i.state_hash(mut static_sh_key)
                self.batches[i].hash.state_hash(mut static_sh_key)
            }
        }
        let sh_key = static_sh_key.finish()
        if static_opaque_count > 0 {
            if !self.static_shadow_valid || self.static_shadow_key != sh_key {
                label("mesh_shadow_static")
                let ssp: DepthOnlyPass = begin_depth_pass(
                    mut self.static_shadow_map,
                    clear_depth: 1.0,
                    keep_depth: false,
                )
                draw_shadow_casters(ssp, mut self.batches, nb, sv, mode: 1)
                ssp.end()
                self.static_shadow_key = sh_key
                self.static_shadow_valid = true
            }
            label("mesh_shadow")
            let sp: DepthOnlyPass = begin_depth_pass(
                mut self.shadow_map,
                clear_depth: 1.0,
                keep_depth: false,
            )
            draw_shadow_casters(sp, mut self.batches, nb, sv, mode: 2)
            if self.swarm.count > 0 {
                draw(
                    sp,
                    swarm_shadow_vs.bind(grains: self.swarm.front(), sv: sv),
                    shadow_fs,
                    vertices: 6,
                    instances: self.swarm.count,
                    depth: Depth { compare: Compare::Less, write: true },
                )
            }
            sp.end()
            self.has_static_shadow = true
        } else {
            label("mesh_shadow")
            let sp: DepthOnlyPass = begin_depth_pass(
                mut self.shadow_map,
                clear_depth: 1.0,
                keep_depth: false,
            )
            draw_shadow_casters(sp, mut self.batches, nb, sv, mode: 0)
            if self.swarm.count > 0 {
                draw(
                    sp,
                    swarm_shadow_vs.bind(grains: self.swarm.front(), sv: sv),
                    shadow_fs,
                    vertices: 6,
                    instances: self.swarm.count,
                    depth: Depth { compare: Compare::Less, write: true },
                )
            }
            sp.end()
            self.has_static_shadow = false
        }

        // Pass 1b: Camera-focused radiance cache & dynamic local emitters.
        // Skips rebuild completely (0 ms/frame) when the whole world is static; when only dynamic
        // batches move, copies the cached static accumulation buffers and injects only dynamic
        // batches + swarm instead of re-injecting static architecture every frame.
        // The key holds everything injection reads: the batches (above), the sun's way and light,
        // the sky, the volume's place, and the warm-up stage. Injection gathers its bounce from last
        // frame's volume (`prev_rad1`), zero before the first build, so a still scene rebuilds on
        // frames 0, 1 and 2 (`min(frame, 2)`) until the bounce has been gathered, then holds.
        let rad_centre = if wrad > 16.0 { focus } else { wmid }
        let rad_rad = min(wrad, 16.0)
        let warmup_stage = min(frame, 2)
        sun.way.state_hash(mut rk)
        sun.light.state_hash(mut rk)
        self.sky.key().state_hash(mut rk)
        rad_centre.state_hash(mut rk)
        warmup_stage.state_hash(mut rk)
        if self.swarm.count > 0 {
            frame.state_hash(mut rk)
        }
        let rkey = rk.finish()
        if !self.gi {
            self.rad.begin(rad_centre, rad_rad, enabled: false)
            self.rad_built = false
        } else if !self.rad_built || self.rad_key != rkey {
            // The static key holds everything static injection reads: the still batches, the sun, the sky,
            // the volume's place and size, the warm-up stage, and the shadow view its own shadow
            // map is drawn through (which follows the whole world's bound).
            var sk = Hasher::new()
            sun.way.state_hash(mut sk)
            sun.light.state_hash(mut sk)
            self.sky.key().state_hash(mut sk)
            sv.centre.state_hash(mut sk)
            sv.radius.state_hash(mut sk)
            rad_centre.state_hash(mut sk)
            rad_rad.state_hash(mut sk)
            warmup_stage.state_hash(mut sk)
            var static_count: u32 = 0
            for i in 0..nb {
                if self.batches[i].still_frames >= 1 {
                    i.state_hash(mut sk)
                    self.batches[i].hash.state_hash(mut sk)
                    static_count += 1
                }
            }
            let skey = sk.finish()
            if static_count > 0 {
                if !self.rad.static_valid || self.rad.static_key != skey {
                    if !self.has_static_shadow {
                        label("mesh_shadow_static")
                        let ssp: DepthOnlyPass = begin_depth_pass(
                            mut self.static_shadow_map,
                            clear_depth: 1.0,
                            keep_depth: false,
                        )
                        draw_shadow_casters(ssp, mut self.batches, nb, sv, mode: 1)
                        ssp.end()
                    }
                    self.rad.begin_static(rad_centre, rad_rad, enabled: true)
                    world.inject_radiance(
                        fbufs,
                        mut self.rad,
                        mut self.batches,
                        0,
                        sv,
                        sky,
                        self.sky.diff,
                        self.sky.s,
                        self.static_shadow_map,
                        self.cmp,
                        static_only: true,
                        all_batches: false,
                    )
                    self.rad.static_key = skey
                    self.rad.static_valid = true
                }
                self.rad.begin_from_static(rad_centre, rad_rad)
                if self.has_static_shadow {
                    world.inject_radiance(
                        fbufs,
                        mut self.rad,
                        mut self.batches,
                        0,
                        sv,
                        sky,
                        self.sky.diff,
                        self.sky.s,
                        self.static_shadow_map,
                        self.cmp,
                        static_only: false,
                        all_batches: false,
                    )
                } else {
                    world.inject_radiance(
                        fbufs,
                        mut self.rad,
                        mut self.batches,
                        0,
                        sv,
                        sky,
                        self.sky.diff,
                        self.sky.s,
                        self.shadow_map,
                        self.cmp,
                        static_only: false,
                        all_batches: false,
                    )
                }
            } else {
                self.rad.begin(rad_centre, rad_rad, enabled: true)
                world.inject_radiance(
                    fbufs,
                    mut self.rad,
                    mut self.batches,
                    0,
                    sv,
                    sky,
                    self.sky.diff,
                    self.sky.s,
                    self.shadow_map,
                    self.cmp,
                    static_only: false,
                    all_batches: true,
                )
            }
            if self.swarm.count > 0 {
                self.swarm.inject_radiance(
                    swarm,
                    self.rad.grid,
                    mut self.rad.accum,
                    mut self.rad.emit_accum,
                )
            }
            self.rad.finish()
            self.rad_key = rkey
            self.rad_built = true
        }
        (nb, v, sv)
    }

    /// Shared opaque geometry + tiled emitter culling + pixel-rate deferred direct + phase-cycled
    /// half-res bilateral GI/SSR + full-res combine pipeline used identically by BOTH `draw_scene`
    /// and `drawn_only` (the judges test the exact same renderer that draws the game).
    fn render_opaque_and_indirect<W: MeshWorld, H: Height, Sw: Swarm, S: Sky>(
        mut self,
        world: W,
        fbufs: W::FieldBufs,
        height: H,
        swarm: Sw,
        sky: S,
        v: View,
        prev_v: View,
        sv: ShadowView,
        width: u32,
        height_px: u32,
        phase_x: u32,
        phase_y: u32,
        write_judge: bool,
    ) {
        self.rad.cull_tiles(v, width, height_px)

        // Pass 2a: 2-pass Reversed-Z Hi-Z occlusion culling + lean 1× G-buffer + analytical motion
        // vectors with pixel-rate `channels(wp)`.
        let nb = world.batch_count()
        let use_hiz = self.cull.begin(mut self.batches, nb)
        let do_pass2 = use_hiz && self.cull.hiz_ready
        if use_hiz {
            self.cull.cull_pass1(mut self.batches, nb, v)
        }
        label("mesh_eye")
        let ep: DepthPass4<Rgba8, Rgba8, Rgba16Float, Rg16Float> = begin_pass4_with_depth(
            mut self.g_normal,
            mut self.g_albedo,
            mut self.g_emits,
            mut self.g_motion,
            mut self.depth,
            clear: vec4(0.0, 0.0, 0.0, 0.0),
            clear_depth: 0.0,
        )
        world.draw_eye(
            fbufs,
            ep,
            mut self.batches,
            mut self.cull,
            self.cube_indices,
            self.dc_depth,
            first: 0,
            pass_idx: 0,
            v: v,
            prev_v: prev_v,
        )
        if height.active() && height.has_opaque() {
            draw(
                ep,
                height_vs.bind(height: height, v: v, base_level: 0, trans_pass: 0),
                mesh_gbuf_fs.bind(v: v, prev_v: prev_v),
                indices: self.clipmap.inner_indices,
                index_count: self.clipmap.inner_count,
                instances: 1,
                cull: Cull::Back,
                depth: Depth { compare: Compare::Greater, write: true },
            )
            draw(
                ep,
                height_vs.bind(height: height, v: v, base_level: 1, trans_pass: 0),
                mesh_gbuf_fs.bind(v: v, prev_v: prev_v),
                indices: self.clipmap.outer_indices,
                index_count: self.clipmap.outer_count,
                instances: CLIP_RINGS - 1,
                cull: Cull::Back,
                depth: Depth { compare: Compare::Greater, write: true },
            )
        }
        if self.swarm.count > 0 {
            draw(
                ep,
                swarm_vs.bind(swarm: swarm, grains: self.swarm.front(), v: v),
                swarm_fs.bind(v: v, prev_v: prev_v),
                vertices: 6,
                instances: self.swarm.count,
                depth: Depth { compare: Compare::Greater, write: true },
            )
        }
        ep.end()

        if use_hiz {
            self.cull.build_hiz(self.depth, width, height_px)
            if do_pass2 {
                self.cull.cull_pass2(mut self.batches, nb, v)
                label("mesh_eye_pass2")
                let ep2: DepthPass4<Rgba8, Rgba8, Rgba16Float, Rg16Float> = begin_pass4_with_depth(
                    mut self.g_normal,
                    mut self.g_albedo,
                    mut self.g_emits,
                    mut self.g_motion,
                    mut self.depth,
                    keep: true,
                    keep_depth: true,
                )
                world.draw_eye(
                    fbufs,
                    ep2,
                    mut self.batches,
                    mut self.cull,
                    self.cube_indices,
                    self.dc_depth,
                    first: 0,
                    pass_idx: 1,
                    v: v,
                    prev_v: prev_v,
                )
                ep2.end()
            }
            self.cull.finish_frame(v)
        }

        // Pass 2a-exact: Snapshot DC reversed-Z depth (~0.07 ms) and resolve Tier-2 `ExactCell`
        // AABBs ONLY on the ~2–5% of pixels not already covered in front of `z_back` by DC.
        var any_exact = false
        for i in 0..nb {
            if self.batches[i].has_exact {
                any_exact = true
            }
        }
        if any_exact {
            label("mesh_exact_depth")
            dispatch(
                copy_dc_depth.bind(
                    depth: self.depth,
                    w: width,
                    h: height_px,
                    out: self.dc_depth.level_mut(0),
                ),
                groups: ((width + 7) / 8, (height_px + 7) / 8, 1),
            )
            label("mesh_exact")
            let epx: DepthPass4<Rgba8, Rgba8, Rgba16Float, Rg16Float> = begin_pass4_with_depth(
                mut self.g_normal,
                mut self.g_albedo,
                mut self.g_emits,
                mut self.g_motion,
                mut self.depth,
                keep: true,
                keep_depth: true,
            )
            world.draw_eye(
                fbufs,
                epx,
                mut self.batches,
                mut self.cull,
                self.cube_indices,
                self.dc_depth,
                first: 0,
                pass_idx: 2,
                v: v,
                prev_v: prev_v,
            )
            epx.end()
        }

        // Pass 2b: Full-res 1× pixel-rate deferred direct lighting (SDF soft shadows + curvature + SSS + tiled emitters).
        label("mesh_direct")
        if write_judge {
            let dp = begin_pass4(
                mut self.hdr_direct,
                mut self.drawn.place,
                mut self.drawn.sun,
                mut self.sun_share,
                keep: false,
            )
            draw(
                dp,
                cover,
                deferred_direct_judge_fs.bind(
                    v: v,
                    sv: sv,
                    rad_grid: self.rad.grid,
                    sdf_grid: self.sdf.grid,
                    sky: sky,
                    g_normal: self.g_normal,
                    g_albedo: self.g_albedo,
                    g_emits: self.g_emits,
                    depth: self.depth,
                    sky_spec0: self.sky.spec0,
                    sky_s: self.sky.s,
                    shadow_map: self.shadow_map,
                    static_shadow_map: self.static_shadow_map,
                    has_static_shadow: if self.has_static_shadow { 1 } else { 0 },
                    cmp: self.cmp,
                    rad0: self.rad.rad0,
                    rad1: self.rad.rad1,
                    rad_s: self.rad.s,
                    sdf0: self.sdf.sdf0,
                    sdf1: self.sdf.sdf1,
                    sdf_s: self.sdf.s,
                    emitters: self.rad.emitters.items(),
                    tile_masks: self.rad.tile_masks.items(),
                    tiles_x: self.rad.tiles_x,
                    full_w: width,
                    full_h: height_px,
                ),
                vertices: 3,
            )
            dp.end()
        } else {
            let dp = begin_pass2(mut self.hdr_direct, mut self.sun_share, keep: false)
            draw(
                dp,
                cover,
                deferred_direct_fs.bind(
                    v: v,
                    sv: sv,
                    rad_grid: self.rad.grid,
                    sdf_grid: self.sdf.grid,
                    sky: sky,
                    g_normal: self.g_normal,
                    g_albedo: self.g_albedo,
                    g_emits: self.g_emits,
                    depth: self.depth,
                    sky_spec0: self.sky.spec0,
                    sky_s: self.sky.s,
                    shadow_map: self.shadow_map,
                    static_shadow_map: self.static_shadow_map,
                    has_static_shadow: if self.has_static_shadow { 1 } else { 0 },
                    cmp: self.cmp,
                    rad0: self.rad.rad0,
                    rad1: self.rad.rad1,
                    rad_s: self.rad.s,
                    sdf0: self.sdf.sdf0,
                    sdf1: self.sdf.sdf1,
                    sdf_s: self.sdf.s,
                    emitters: self.rad.emitters.items(),
                    tile_masks: self.rad.tile_masks.items(),
                    tiles_x: self.rad.tiles_x,
                    full_w: width,
                    full_h: height_px,
                ),
                vertices: 3,
            )
            dp.end()
        }

        // Pass 2c: Half-res (`W/2 × H/2`) 4-cone diffuse GI + SDF bent-normal AO + SSR + micro-contact shadows.
        label("mesh_indirect")
        let ip = begin_pass2(mut self.gi_diff, mut self.gi_spec, keep: false)
        draw(
            ip,
            cover,
            indirect_half_fs.bind(
                v: v,
                rad_grid: self.rad.grid,
                sdf_grid: self.sdf.grid,
                sky: sky,
                hdr_direct: self.hdr_direct,
                g_normal: self.g_normal,
                g_albedo: self.g_albedo,
                g_emits: self.g_emits,
                depth: self.depth,
                bg_s: self.bg_s,
                sky_diff: self.sky.diff,
                sky_spec0: self.sky.spec0,
                sky_spec1: self.sky.spec1,
                sky_spec2: self.sky.spec2,
                sky_s: self.sky.s,
                rad0: self.rad.rad0,
                rad1: self.rad.rad1,
                rad2: self.rad.rad2,
                rad_s: self.rad.s,
                sdf0: self.sdf.sdf0,
                sdf1: self.sdf.sdf1,
                sdf_s: self.sdf.s,
                full_w: width,
                full_h: height_px,
                phase_x: phase_x,
                phase_y: phase_y,
            ),
            vertices: 3,
        )
        ip.end()

        // Pass 2d: Full-res depth+normal bilateral upsample of phase-cycled GI/SSR.
        label("mesh_combine")
        let cp = begin_pass(mut self.hdr_colour, keep: false)
        draw(
            cp,
            cover,
            combine_indirect_fs.bind(
                v: v,
                sky: sky,
                hdr_direct: self.hdr_direct,
                sun_share: self.sun_share,
                g_normal: self.g_normal,
                g_albedo: self.g_albedo,
                g_emits: self.g_emits,
                gi_diff: self.gi_diff,
                gi_spec: self.gi_spec,
                sky_diff: self.sky.diff,
                sky_s: self.sky.s,
                full_w: width,
                full_h: height_px,
                phase_x: phase_x,
                phase_y: phase_y,
            ),
            vertices: 3,
        )
        cp.end()
    }

    /// Unified refractive / transmissive pass (half-res SSR pre-pass + full-res 3-channel chromatic
    /// dispersion, Beer-Lambert absorption, tiled emitter specular, and motion vectors) over the
    /// opaque frame in `hdr_colour`, shared by `draw_scene` and `drawn_only`. Skipped completely
    /// (0.0 ms) when no heightfield or batch contains transmissive triangles.
    fn render_transmissive<W: MeshWorld, H: Height, S: Sky>(
        mut self,
        world: W,
        fbufs: W::FieldBufs,
        height: H,
        sky: S,
        v: View,
        prev_v: View,
        sv: ShadowView,
        width: u32,
        height_px: u32,
        nb: u32,
    ) {
        var any_trans = height.active() && height.has_transmissive()
        for i in 0..nb {
            self.batches[i].finish_poll()
            if self.batches[i].has_trans {
                any_trans = true
            }
        }
        if any_trans {
            label("mesh_refract")
            copy_texture(from: self.hdr_colour.level(0), to: self.hdr_bg.level_mut(0))
            let half_size = vec2(f32(max(width / 2, 1)), f32(max(height_px / 2, 1)))
            let rrp: DepthPass<Rgba16Float> = begin_pass_with_depth(
                mut self.refract_refl,
                mut self.refract_depth,
                clear: vec4(0.0, 0.0, 0.0, 0.0),
                clear_depth: 0.0,
            )
            world.draw_refract_refl(
                fbufs,
                rrp,
                mut self.batches,
                0,
                v,
                self.rad.grid,
                self.sdf.grid,
                self.sky.diff,
                self.sky.spec0,
                self.sky.spec1,
                self.sky.spec2,
                self.sky.s,
                self.rad.rad0,
                self.rad.rad1,
                self.rad.rad2,
                self.rad.s,
                self.sdf.sdf0,
                self.sdf.sdf1,
                self.sdf.s,
                self.hdr_bg,
                self.bg_s,
                half_size,
            )
            if height.active() && height.has_transmissive() {
                draw(
                    rrp,
                    height_vs.bind(height: height, v: v, base_level: 0, trans_pass: 1),
                    refract_refl_fs.bind(
                        v: v,
                        rad_grid: self.rad.grid,
                        sdf_grid: self.sdf.grid,
                        sky_diff: self.sky.diff,
                        sky_spec0: self.sky.spec0,
                        sky_spec1: self.sky.spec1,
                        sky_spec2: self.sky.spec2,
                        sky_s: self.sky.s,
                        rad0: self.rad.rad0,
                        rad1: self.rad.rad1,
                        rad2: self.rad.rad2,
                        rad_s: self.rad.s,
                        sdf0: self.sdf.sdf0,
                        sdf1: self.sdf.sdf1,
                        sdf_s: self.sdf.s,
                        hdr_bg: self.hdr_bg,
                        bg_s: self.bg_s,
                        half_size: half_size,
                    ),
                    indices: self.clipmap.inner_indices,
                    index_count: self.clipmap.inner_count,
                    instances: 1,
                    cull: Cull::Back,
                    depth: Depth { compare: Compare::Greater, write: true },
                )
                draw(
                    rrp,
                    height_vs.bind(height: height, v: v, base_level: 1, trans_pass: 1),
                    refract_refl_fs.bind(
                        v: v,
                        rad_grid: self.rad.grid,
                        sdf_grid: self.sdf.grid,
                        sky_diff: self.sky.diff,
                        sky_spec0: self.sky.spec0,
                        sky_spec1: self.sky.spec1,
                        sky_spec2: self.sky.spec2,
                        sky_s: self.sky.s,
                        rad0: self.rad.rad0,
                        rad1: self.rad.rad1,
                        rad2: self.rad.rad2,
                        rad_s: self.rad.s,
                        sdf0: self.sdf.sdf0,
                        sdf1: self.sdf.sdf1,
                        sdf_s: self.sdf.s,
                        hdr_bg: self.hdr_bg,
                        bg_s: self.bg_s,
                        half_size: half_size,
                    ),
                    indices: self.clipmap.outer_indices,
                    index_count: self.clipmap.outer_count,
                    instances: CLIP_RINGS - 1,
                    cull: Cull::Back,
                    depth: Depth { compare: Compare::Greater, write: true },
                )
            }
            rrp.end()

            // Transmissive surfaces write their own motion beside their colour and depth, so TSR
            // (which takes each pixel's motion where its 3×3 depth is nearest) reprojects glass and
            // water by their own movement, not by what lies behind them.
            let rp: DepthPass2<Rgba16Float, Rg16Float> = begin_pass2_with_depth(
                mut self.hdr_colour,
                mut self.g_motion,
                mut self.depth,
                keep: true,
                keep_depth: true,
            )
            world.draw_refract(
                fbufs,
                rp,
                mut self.batches,
                0,
                v,
                prev_v,
                sv,
                self.rad.grid,
                self.sdf.grid,
                sky,
                self.sky.diff,
                self.sky.spec0,
                self.sky.spec1,
                self.sky.spec2,
                self.sky.s,
                self.shadow_map,
                self.static_shadow_map,
                if self.has_static_shadow { 1 } else { 0 },
                self.cmp,
                self.rad.rad0,
                self.rad.rad1,
                self.rad.rad2,
                self.rad.s,
                self.sdf.sdf0,
                self.sdf.sdf1,
                self.sdf.s,
                self.rad.emitters.items(),
                self.rad.tile_masks.items(),
                self.rad.tiles_x,
                self.hdr_bg,
                self.refract_refl,
                self.bg_s,
            )
            if height.active() && height.has_transmissive() {
                draw(
                    rp,
                    height_vs.bind(height: height, v: v, base_level: 0, trans_pass: 1),
                    mesh_trans_fs.bind(
                        v: v,
                        prev_v: prev_v,
                        sv: sv,
                        rad_grid: self.rad.grid,
                        sdf_grid: self.sdf.grid,
                        sky: sky,
                        sky_diff: self.sky.diff,
                        sky_spec0: self.sky.spec0,
                        sky_spec1: self.sky.spec1,
                        sky_spec2: self.sky.spec2,
                        sky_s: self.sky.s,
                        shadow_map: self.shadow_map,
                        static_shadow_map: self.static_shadow_map,
                        has_static_shadow: if self.has_static_shadow { 1 } else { 0 },
                        cmp: self.cmp,
                        rad0: self.rad.rad0,
                        rad1: self.rad.rad1,
                        rad2: self.rad.rad2,
                        rad_s: self.rad.s,
                        sdf0: self.sdf.sdf0,
                        sdf1: self.sdf.sdf1,
                        sdf_s: self.sdf.s,
                        emitters: self.rad.emitters.items(),
                        tile_masks: self.rad.tile_masks.items(),
                        tiles_x: self.rad.tiles_x,
                        hdr_bg: self.hdr_bg,
                        refract_refl: self.refract_refl,
                        bg_s: self.bg_s,
                    ),
                    indices: self.clipmap.inner_indices,
                    index_count: self.clipmap.inner_count,
                    instances: 1,
                    cull: Cull::Back,
                    depth: Depth { compare: Compare::Greater, write: true },
                )
                draw(
                    rp,
                    height_vs.bind(height: height, v: v, base_level: 1, trans_pass: 1),
                    mesh_trans_fs.bind(
                        v: v,
                        prev_v: prev_v,
                        sv: sv,
                        rad_grid: self.rad.grid,
                        sdf_grid: self.sdf.grid,
                        sky: sky,
                        sky_diff: self.sky.diff,
                        sky_spec0: self.sky.spec0,
                        sky_spec1: self.sky.spec1,
                        sky_spec2: self.sky.spec2,
                        sky_s: self.sky.s,
                        shadow_map: self.shadow_map,
                        static_shadow_map: self.static_shadow_map,
                        has_static_shadow: if self.has_static_shadow { 1 } else { 0 },
                        cmp: self.cmp,
                        rad0: self.rad.rad0,
                        rad1: self.rad.rad1,
                        rad2: self.rad.rad2,
                        rad_s: self.rad.s,
                        sdf0: self.sdf.sdf0,
                        sdf1: self.sdf.sdf1,
                        sdf_s: self.sdf.s,
                        emitters: self.rad.emitters.items(),
                        tile_masks: self.rad.tile_masks.items(),
                        tiles_x: self.rad.tiles_x,
                        hdr_bg: self.hdr_bg,
                        refract_refl: self.refract_refl,
                        bg_s: self.bg_s,
                    ),
                    indices: self.clipmap.outer_indices,
                    index_count: self.clipmap.outer_count,
                    instances: CLIP_RINGS - 1,
                    cull: Cull::Back,
                    depth: Depth { compare: Compare::Greater, write: true },
                )
            }
            rp.end()
        }
    }

    /// Whether every batch's mesh drawn this frame is known complete (`MeshBatch::settled`): a
    /// frame drawn from a view not seen before can be drawn from meshes extracted for it whose
    /// counts are not yet back, so a picture judged as the engine's settled picture of a view is
    /// one drawn when this holds.
    pub fn settled(self) -> bool {
        for i in 0..self.batches.len() {
            if !self.batches[i].settled() {
                return false
            }
        }
        true
    }

    /// Bitwise OR of all batches' `OVERFLOW_*` bitflags (`0` = no capacity truncation anywhere).
    pub fn overflowed(self) -> u32 {
        var flags: u32 = 0
        for i in 0..self.batches.len() {
            flags |= self.batches[i].overflowed()
        }
        flags
    }

    /// Renders `world` into `self.drawn` (`colour`, `place`, `sun`) without presenting (for
    /// judging against `Reference`), executing the exact same 1× + Halton-jittered TSR pipeline as
    /// `draw_scene` (opaque, indirect, transmissive, resolve) over 8 subpixel frames so offline
    /// judges verify the real temporal resolve.
    pub fn drawn_only<W: MeshWorld, S: Sky, L: Look>(
        mut self,
        world: W,
        sky: S,
        look: L,
        eye: Eye,
        width: u32,
        height: u32,
    ) {
        let fbufs = world.upload_fields()
        let (nb, v_unjit, sv) = self.prepare_and_shadow(
            world,
            fbufs,
            NoSwarm {},
            sky,
            eye,
            width,
            height,
            0,
        )
        self.tsr.valid = false

        // Subframe 0: exact pixel-center view writes `drawn.place` and `drawn.sun`, and seeds TSR.
        self.render_opaque_and_indirect(
            world,
            fbufs,
            NoHeight {},
            NoSwarm {},
            sky,
            v_unjit,
            v_unjit,
            sv,
            width,
            height,
            phase_x: 0,
            phase_y: 0,
            write_judge: true,
        )
        self.render_transmissive(
            world,
            fbufs,
            NoHeight {},
            sky,
            v_unjit,
            v_unjit,
            sv,
            width,
            height,
            nb,
        )
        let pp = begin_pass(mut self.place_all, keep: false)
        draw(
            pp,
            cover,
            place_with_trans_fs.bind(depth: self.depth, place: self.drawn.place, v: v_unjit),
            vertices: 3,
        )
        pp.end()
        copy_texture(from: self.place_all.level(0), to: self.drawn.place.level_mut(0))
        self.tsr.resolve(mut self.hdr_colour, self.g_motion, self.depth, v_unjit, width, height)

        // Subframes 1..7: converge Halton(2, 3) TSR supersampling. `drawn.place` keeps subframe 0's
        // middle-ray hit alone, as `Picture::place` promises, so a hole at a pixel's middle is seen.
        for s in 1..8 {
            let j = halton_jitter(s)
            let vj = v_unjit.moved(j)
            let px = s & 1
            let py = (s >> 1) & 1
            self.render_opaque_and_indirect(
                world,
                fbufs,
                NoHeight {},
                NoSwarm {},
                sky,
                vj,
                v_unjit,
                sv,
                width,
                height,
                phase_x: px,
                phase_y: py,
                write_judge: false,
            )
            self.render_transmissive(
                world,
                fbufs,
                NoHeight {},
                sky,
                vj,
                v_unjit,
                sv,
                width,
                height,
                nb,
            )
            self.tsr.resolve(mut self.hdr_colour, self.g_motion, self.depth, v_unjit, width, height)
        }

        label("mesh_tone")
        let tp = begin_pass(mut self.drawn.colour, keep: false)
        draw(
            tp,
            cover,
            hdr_tone_fs.bind(
                hdr: self.hdr_colour,
                depth: self.depth,
                froxel_acc: self.vol.acc,
                vol_s: self.vol.s,
                vol_active: 0,
                bloom_tex: self.bloom.u0,
                bloom_s: self.bloom.s,
                bloom_strength: 0.0,
                v: v_unjit,
                look: look,
            ),
            vertices: 3,
        )
        tp.end()
        self.drawn.placed = true
        for i in 0..nb {
            self.batches[i].maybe_queue_poll()
        }
    }

    /// Renders a complete scene (`world` solids, `height` clipmap, `medium` froxels, and `swarm`
    /// field-colliding GPU grains) through ONE depth buffer, ONE light store, 2-cascade 3D SDF
    /// clipmap, 1× G-buffer + motion vectors, phase-cycled half-res GI/SSR, half-res refract SSR +
    /// 3-channel chromatic dispersion, Temporal Super-Resolution (TSR), froxel volumetrics,
    /// optical HDR bloom, and ONE `Look::tone` pass.
    pub fn draw_scene<W: MeshWorld, H: Height, Med: Medium, Sw: Swarm, S: Sky, L: Look>(
        mut self,
        world: W,
        height: H,
        medium: Med,
        swarm: Sw,
        sky: S,
        look: L,
        eye: Eye,
        width: u32,
        height_px: u32,
    ) {
        let cur_frame = self.frame
        let fbufs = world.upload_fields()
        let (nb, v_unjit, sv) = self.prepare_and_shadow(
            world,
            fbufs,
            swarm,
            sky,
            eye,
            width,
            height_px,
            cur_frame,
        )
        self.frame += 1

        let jitter = halton_jitter(cur_frame)
        let v = v_unjit.moved(jitter)
        let prev_v = if self.tsr.valid { self.tsr.prev_v } else { v_unjit }
        let phase_x = cur_frame & 1
        let phase_y = (cur_frame >> 1) & 1

        self.render_opaque_and_indirect(
            world,
            fbufs,
            height,
            swarm,
            sky,
            v,
            prev_v,
            sv,
            width,
            height_px,
            phase_x,
            phase_y,
            write_judge: false,
        )

        self.render_transmissive(world, fbufs, height, sky, v, prev_v, sv, width, height_px, nb)

        // Pass 2f: Temporal Super-Resolution (TSR): merges Halton-jittered subpixel frames and
        // 2×2 phase-cycled half-res GI/SSR into crisp full-resolution supersampled HDR.
        self.tsr.resolve(mut self.hdr_colour, self.g_motion, self.depth, v_unjit, width, height_px)

        // Pass 2g: Unified volumetric froxel pass (0 ms when `medium.active()` is false).
        let has_vol = medium.active()
        if has_vol {
            self.vol.update(
                medium,
                v_unjit,
                sv,
                self.rad.grid,
                sky,
                self.sky.diff,
                self.sky.s,
                self.shadow_map,
                self.static_shadow_map,
                if self.has_static_shadow { 1 } else { 0 },
                self.cmp,
                self.rad.rad1,
                self.rad.rad2,
                self.rad.s,
                self.rad.emitters.items(),
                self.rad.emitters.count(),
            )
        }

        // Pass 2f: Optical HDR bloom pyramid (0 ms when `look.bloom().strength <= 0.0`).
        let bloom_cfg = look.bloom()
        self.bloom.build(self.hdr_colour, width, height_px, bloom_cfg)

        // Pass 3: Unified volumetric composite + optical bloom + ONE `Look::tone` pass.
        label("mesh_tone")
        let tp = begin_pass(mut self.drawn.colour, keep: false)
        draw(
            tp,
            cover,
            hdr_tone_fs.bind(
                hdr: self.hdr_colour,
                depth: self.depth,
                froxel_acc: self.vol.acc,
                vol_s: self.vol.s,
                vol_active: if has_vol { 1 } else { 0 },
                bloom_tex: self.bloom.u0,
                bloom_s: self.bloom.s,
                bloom_strength: bloom_cfg.strength,
                v: v,
                look: look,
            ),
            vertices: 3,
        )
        tp.end()
        self.drawn.placed = false
        show(self.drawn.colour)
        for i in 0..nb {
            self.batches[i].maybe_queue_poll()
        }
    }

    /// Renders `world` (`Surface`s only) into `self.drawn` and presents it to the screen.
    pub fn draw<W: MeshWorld, S: Sky, L: Look>(
        mut self,
        world: W,
        sky: S,
        look: L,
        eye: Eye,
        width: u32,
        height: u32,
    ) {
        self.draw_scene(world, NoHeight {}, NoMedium {}, NoSwarm {}, sky, look, eye, width, height)
    }
}
