/// Pixel-rate transmissive fragment shader for `Skinned` `Many<M, N>` meshlets (colour + motion).
@fragment
@budget(work: 44000)
fn field_skin_trans_many_fs<M: Field<Substance>, S: Sky>(
    pixel: FragCoord,
    vary: SkinVary,
    fields: [M],
    n_fields: u32,
    v: View,
    prev_v: View,
    sv: ShadowView,
    rad_grid: RadGrid,
    sdf_grid: SdfGrid,
    sky: S,
    sky_diff: Texture<Rgba16Float>,
    sky_spec0: Texture<Rgba16Float>,
    sky_spec1: Texture<Rgba16Float>,
    sky_spec2: Texture<Rgba16Float>,
    sky_s: Sampler,
    shadow_map: DepthTexture,
    cmp: ComparisonSampler,
    rad0: Texture3d<Rgba16Float>,
    rad1: Texture3d<Rgba16Float>,
    rad2: Texture3d<Rgba16Float>,
    rad_s: Sampler,
    sdf0: Texture3d<R16Float>,
    sdf1: Texture3d<R16Float>,
    sdf_s: Sampler,
    emitters: [Emitter],
    tile_masks: [u32],
    tiles_x: u32,
    hdr_bg: Texture<Rgba16Float>,
    refract_refl: Texture<Rgba16Float>,
    bg_s: Sampler,
) -> Targets2<vec4, vec2> {
    let tid = min(u32(max(vary.meta.y, 0.0)), n_fields - 1)
    let sub0 = fields[tid].rest_channels(vary.rest_p)
    let interior = interior_length(fields[tid], vary.wp, normalize(vary.wp - v.at), 18.0)
    let c = shade_trans_core(
        pixel,
        vary.wp,
        vary.rest_p,
        interior,
        vary.normal,
        vary.meta.x,
        sub0,
        v,
        sv,
        rad_grid,
        sdf_grid,
        sky,
        sky_diff,
        sky_spec0,
        sky_spec1,
        sky_spec2,
        sky_s,
        shadow_map,
        cmp,
        rad0,
        rad1,
        rad2,
        rad_s,
        sdf0,
        sdf1,
        sdf_s,
        emitters,
        tile_masks,
        tiles_x,
        hdr_bg,
        refract_refl,
        bg_s,
    )
    Targets2 { first: c, second: motion_of(vary.wp, vary.prev_wp, v, prev_v) }
}

/// Physically-based refractive / transmissive fragment shader for transmissive heightfields
/// (`height_vs`): an open volume of water, absorbing to whatever lies behind it (colour + motion).
@fragment
@budget(work: 44000)
fn mesh_trans_fs<S: Sky>(
    pixel: FragCoord,
    vary: MeshVary,
    v: View,
    prev_v: View,
    sv: ShadowView,
    rad_grid: RadGrid,
    sdf_grid: SdfGrid,
    sky: S,
    sky_diff: Texture<Rgba16Float>,
    sky_spec0: Texture<Rgba16Float>,
    sky_spec1: Texture<Rgba16Float>,
    sky_spec2: Texture<Rgba16Float>,
    sky_s: Sampler,
    shadow_map: DepthTexture,
    cmp: ComparisonSampler,
    rad0: Texture3d<Rgba16Float>,
    rad1: Texture3d<Rgba16Float>,
    rad2: Texture3d<Rgba16Float>,
    rad_s: Sampler,
    sdf0: Texture3d<R16Float>,
    sdf1: Texture3d<R16Float>,
    sdf_s: Sampler,
    emitters: [Emitter],
    tile_masks: [u32],
    tiles_x: u32,
    hdr_bg: Texture<Rgba16Float>,
    refract_refl: Texture<Rgba16Float>,
    bg_s: Sampler,
) -> Targets2<vec4, vec2> {
    let sub0 = vary_substance(vary)
    let interior = -1.0
    let c = shade_trans_core(
        pixel,
        vary.wp,
        vary.wp,
        interior,
        vary.normal,
        vary.pbr.w,
        sub0,
        v,
        sv,
        rad_grid,
        sdf_grid,
        sky,
        sky_diff,
        sky_spec0,
        sky_spec1,
        sky_spec2,
        sky_s,
        shadow_map,
        cmp,
        rad0,
        rad1,
        rad2,
        rad_s,
        sdf0,
        sdf1,
        sdf_s,
        emitters,
        tile_masks,
        tiles_x,
        hdr_bg,
        refract_refl,
        bg_s,
    )
    Targets2 { first: c, second: motion_of(vary.wp, vary.prev_wp, v, prev_v) }
}

/// Computes a curvature- and budget-aware cell spacing for a single thing with bounding sphere
/// `(c, r)`. Targets a bounded screen-space sagitta error (`c ≈ sqrt(8 * e * R_feat * px)`),
/// keeping tight `~1.45 px` cells when an object is small on screen (or `1.1 px` for `steep`
/// noise fields) while avoiding sub-2-pixel micro-triangles on large smooth close-ups.
fn cell_for_one(c: vec3, r: f32, v: View, steep: bool, floor: f32) -> f32 {
    let near = max(length(c - v.at) - r, 0.25)
    let px = near * v.pixel()
    let r_px = r / max(px, 1.0e-5)
    let mult = if steep { 1.1 } else { clamp(0.253 * sqrt(r_px), 1.45, 2.55) }
    clamp(max(px * mult, max(floor, 0.005)), 0.005, 0.25)
}

/// Computes a curvature- and budget-aware cell spacing for one thing in a `Many` batch.
fn cell_for_share(c: vec3, r: f32, bricks_for_this: f32, v: View) -> f32 {
    let near = max(length(c - v.at) - r, 0.25)
    let px = near * v.pixel()
    let r_px = r / max(px, 1.0e-5)
    let mult = clamp(0.253 * sqrt(r_px), 1.35, 2.50)
    let per_thing = max(bricks_for_this, 4.0)
    let by_budget = r / max(sqrt(per_thing * 2.5), 3.5)
    clamp(max(px * mult, by_budget), 0.006, 0.25)
}

/// Any world (`One`, `Many`, `And`) that can sync its 16-byte GPU meshlet batches, splat its
/// opaque geometry into the 3D SDF clipmap, inject analytical vertex radiance, and draw directly
/// with pixel-rate analytical `field.channels(wp)`.
pub trait MeshWorld: Copy {
    type FieldBufs
    fn batch_count(self) -> u32
    fn upload_fields(self) -> Self::FieldBufs
    fn sync_batches(
        self,
        scratch: mut ExtractScratch,
        batches: mut Vec<MeshBatch>,
        first: u32,
        v: View,
    )
    fn splat_sdf(
        self,
        sdf: mut SdfClipmap,
        batches: mut Vec<MeshBatch>,
        first: u32,
        static_only: bool,
        all_batches: bool,
    )
    fn inject_radiance<S: Sky>(
        self,
        fbufs: Self::FieldBufs,
        rad: mut RadianceCache,
        batches: mut Vec<MeshBatch>,
        first: u32,
        sv: ShadowView,
        sky: S,
        sky_diff: Texture<Rgba16Float>,
        sky_s: Sampler,
        shadow_map: DepthTexture,
        cmp: ComparisonSampler,
        static_only: bool,
        all_batches: bool,
    )
    fn draw_eye(
        self,
        fbufs: Self::FieldBufs,
        ep: DepthPass4<Rgba8, Rgba8, Rgba16Float, Rg16Float>,
        batches: mut Vec<MeshBatch>,
        first: u32,
        v: View,
        prev_v: View,
    )
    fn draw_refract_refl(
        self,
        fbufs: Self::FieldBufs,
        rrp: DepthPass<Rgba16Float>,
        batches: mut Vec<MeshBatch>,
        first: u32,
        v: View,
        rad_grid: RadGrid,
        sdf_grid: SdfGrid,
        sky_diff: Texture<Rgba16Float>,
        sky_spec0: Texture<Rgba16Float>,
        sky_spec1: Texture<Rgba16Float>,
        sky_spec2: Texture<Rgba16Float>,
        sky_s: Sampler,
        rad0: Texture3d<Rgba16Float>,
        rad1: Texture3d<Rgba16Float>,
        rad2: Texture3d<Rgba16Float>,
        rad_s: Sampler,
        sdf0: Texture3d<R16Float>,
        sdf1: Texture3d<R16Float>,
        sdf_s: Sampler,
        hdr_bg: Texture<Rgba16Float>,
        bg_s: Sampler,
        half_size: vec2,
    )
    fn draw_refract<S: Sky>(
        self,
        fbufs: Self::FieldBufs,
        rp: DepthPass2<Rgba16Float, Rg16Float>,
        batches: mut Vec<MeshBatch>,
        first: u32,
        v: View,
        prev_v: View,
        sv: ShadowView,
        rad_grid: RadGrid,
        sdf_grid: SdfGrid,
        sky: S,
        sky_diff: Texture<Rgba16Float>,
        sky_spec0: Texture<Rgba16Float>,
        sky_spec1: Texture<Rgba16Float>,
        sky_spec2: Texture<Rgba16Float>,
        sky_s: Sampler,
        shadow_map: DepthTexture,
        cmp: ComparisonSampler,
        rad0: Texture3d<Rgba16Float>,
        rad1: Texture3d<Rgba16Float>,
        rad2: Texture3d<Rgba16Float>,
        rad_s: Sampler,
        sdf0: Texture3d<R16Float>,
        sdf1: Texture3d<R16Float>,
        sdf_s: Sampler,
        emitters: GpuSpan<Emitter>,
        tile_masks: GpuSpan<u32>,
        tiles_x: u32,
        hdr_bg: Texture<Rgba16Float>,
        refract_refl: Texture<Rgba16Float>,
        bg_s: Sampler,
    )
}

impl<M: Field<Substance> + StateHash + GpuData> MeshWorld for One<M> {
    type FieldBufs = u32

    fn batch_count(self) -> u32 {
        1
    }

    fn upload_fields(self) -> u32 {
        0
    }

    fn sync_batches(
        self,
        scratch: mut ExtractScratch,
        batches: mut Vec<MeshBatch>,
        first: u32,
        v: View,
    ) {
        let b = self.field.bound()
        let r = min(b.radius, 1.0e4)
        let cell = cell_for_one(b.centre, r, v, steep(self.field), size_floor(r))
        batches[first].sync_one(mut scratch, self.field, cell)
    }

    fn splat_sdf(
        self,
        sdf: mut SdfClipmap,
        batches: mut Vec<MeshBatch>,
        first: u32,
        static_only: bool,
        all_batches: bool,
    ) {
        if !batches[first].has_opaque {
            return
        }
        let is_static = batches[first].still_frames >= 1
        if !all_batches && is_static != static_only {
            return
        }
        sdf.splat_one(self.field, batches[first].bound, to_static: !all_batches && static_only)
    }

    fn inject_radiance<S: Sky>(
        self,
        _fbufs: u32,
        rad: mut RadianceCache,
        batches: mut Vec<MeshBatch>,
        first: u32,
        sv: ShadowView,
        sky: S,
        sky_diff: Texture<Rgba16Float>,
        sky_s: Sampler,
        shadow_map: DepthTexture,
        cmp: ComparisonSampler,
        static_only: bool,
        all_batches: bool,
    ) {
        let is_static = batches[first].still_frames >= 1
        if !all_batches && is_static != static_only {
            return
        }
        if batches[first].is_deformed {
            rad.inject_one(
                self.field,
                batches[first].deformed_verts.items(),
                batches[first].verts.count(),
                batches[first].cap_verts,
                batches[first].xforms.items(),
                batches[first].inst_count,
                sv,
                sky,
                sky_diff,
                sky_s,
                shadow_map,
                cmp,
                to_static: !all_batches && static_only,
            )
            return
        }
        rad.inject_one(
            self.field,
            batches[first].verts.items(),
            batches[first].verts.count(),
            batches[first].cap_verts,
            batches[first].xforms.items(),
            batches[first].inst_count,
            sv,
            sky,
            sky_diff,
            sky_s,
            shadow_map,
            cmp,
            to_static: !all_batches && static_only,
        )
    }

    fn draw_eye(
        self,
        _fbufs: u32,
        ep: DepthPass4<Rgba8, Rgba8, Rgba16Float, Rg16Float>,
        batches: mut Vec<MeshBatch>,
        first: u32,
        v: View,
        prev_v: View,
    ) {
        // Opaque quads, then the opaque pixels of the transmissive quads (`_cut_` shaders).
        if batches[first].is_deformed {
            let vs = deformed_mesh_vs.bind(
                verts: batches[first].deformed_verts.items(),
                prev_verts: batches[first].prev_deformed_verts.items(),
                rest_verts: batches[first].verts.items(),
                xforms: batches[first].xforms.items(),
                prev_xforms: batches[first].prev_xforms.items(),
                v: v,
            )
            if batches[first].has_opaque {
                draw(
                    ep,
                    vs,
                    field_skin_gbuf_one_fs.bind(field: self.field, v: v, prev_v: prev_v),
                    indices: batches[first].indices,
                    indirect: batches[first].draw_args,
                    cull: Cull::Back,
                    depth: Depth { compare: Compare::Greater, write: true },
                )
            }
            if batches[first].has_trans {
                draw(
                    ep,
                    vs,
                    field_skin_cut_gbuf_one_fs.bind(field: self.field, v: v, prev_v: prev_v),
                    indices: batches[first].trans_indices,
                    indirect: batches[first].trans_draw_args,
                    cull: Cull::Back,
                    depth: Depth { compare: Compare::Greater, write: true },
                )
            }
            return
        }
        let vs = mesh_vs.bind(
            verts: batches[first].verts.items(),
            xforms: batches[first].xforms.items(),
            prev_xforms: batches[first].prev_xforms.items(),
            inst_ids: batches[first].inst_ids.items(),
            is_instanced: 0,
            v: v,
        )
        if batches[first].has_opaque {
            draw(
                ep,
                vs,
                field_gbuf_one_fs.bind(field: self.field, v: v, prev_v: prev_v),
                indices: batches[first].indices,
                indirect: batches[first].draw_args,
                cull: Cull::Back,
                depth: Depth { compare: Compare::Greater, write: true },
            )
        }
        if batches[first].has_trans {
            draw(
                ep,
                vs,
                field_cut_gbuf_one_fs.bind(field: self.field, v: v, prev_v: prev_v),
                indices: batches[first].trans_indices,
                indirect: batches[first].trans_draw_args,
                cull: Cull::Back,
                depth: Depth { compare: Compare::Greater, write: true },
            )
        }
    }

    fn draw_refract_refl(
        self,
        _fbufs: u32,
        rrp: DepthPass<Rgba16Float>,
        batches: mut Vec<MeshBatch>,
        first: u32,
        v: View,
        rad_grid: RadGrid,
        sdf_grid: SdfGrid,
        sky_diff: Texture<Rgba16Float>,
        sky_spec0: Texture<Rgba16Float>,
        sky_spec1: Texture<Rgba16Float>,
        sky_spec2: Texture<Rgba16Float>,
        sky_s: Sampler,
        rad0: Texture3d<Rgba16Float>,
        rad1: Texture3d<Rgba16Float>,
        rad2: Texture3d<Rgba16Float>,
        rad_s: Sampler,
        sdf0: Texture3d<R16Float>,
        sdf1: Texture3d<R16Float>,
        sdf_s: Sampler,
        hdr_bg: Texture<Rgba16Float>,
        bg_s: Sampler,
        half_size: vec2,
    ) {
        if !batches[first].has_trans {
            return
        }
        if batches[first].is_deformed {
            draw(
                rrp,
                deformed_mesh_vs.bind(
                    verts: batches[first].deformed_verts.items(),
                    prev_verts: batches[first].prev_deformed_verts.items(),
                    rest_verts: batches[first].verts.items(),
                    xforms: batches[first].xforms.items(),
                    prev_xforms: batches[first].prev_xforms.items(),
                    v: v,
                ),
                field_skin_refract_refl_one_fs.bind(
                    field: self.field,
                    v: v,
                    rad_grid: rad_grid,
                    sdf_grid: sdf_grid,
                    sky_diff: sky_diff,
                    sky_spec0: sky_spec0,
                    sky_spec1: sky_spec1,
                    sky_spec2: sky_spec2,
                    sky_s: sky_s,
                    rad0: rad0,
                    rad1: rad1,
                    rad2: rad2,
                    rad_s: rad_s,
                    sdf0: sdf0,
                    sdf1: sdf1,
                    sdf_s: sdf_s,
                    hdr_bg: hdr_bg,
                    bg_s: bg_s,
                    half_size: half_size,
                ),
                indices: batches[first].trans_indices,
                indirect: batches[first].trans_draw_args,
                cull: Cull::Back,
                depth: Depth { compare: Compare::Greater, write: true },
            )
            return
        }
        draw(
            rrp,
            mesh_vs.bind(
                verts: batches[first].verts.items(),
                xforms: batches[first].xforms.items(),
                prev_xforms: batches[first].prev_xforms.items(),
                inst_ids: batches[first].inst_ids.items(),
                is_instanced: 0,
                v: v,
            ),
            field_refract_refl_one_fs.bind(
                field: self.field,
                v: v,
                rad_grid: rad_grid,
                sdf_grid: sdf_grid,
                sky_diff: sky_diff,
                sky_spec0: sky_spec0,
                sky_spec1: sky_spec1,
                sky_spec2: sky_spec2,
                sky_s: sky_s,
                rad0: rad0,
                rad1: rad1,
                rad2: rad2,
                rad_s: rad_s,
                sdf0: sdf0,
                sdf1: sdf1,
                sdf_s: sdf_s,
                hdr_bg: hdr_bg,
                bg_s: bg_s,
                half_size: half_size,
            ),
            indices: batches[first].trans_indices,
            indirect: batches[first].trans_draw_args,
            cull: Cull::Back,
            depth: Depth { compare: Compare::Greater, write: true },
        )
    }

    fn draw_refract<S: Sky>(
        self,
        _fbufs: u32,
        rp: DepthPass2<Rgba16Float, Rg16Float>,
        batches: mut Vec<MeshBatch>,
        first: u32,
        v: View,
        prev_v: View,
        sv: ShadowView,
        rad_grid: RadGrid,
        sdf_grid: SdfGrid,
        sky: S,
        sky_diff: Texture<Rgba16Float>,
        sky_spec0: Texture<Rgba16Float>,
        sky_spec1: Texture<Rgba16Float>,
        sky_spec2: Texture<Rgba16Float>,
        sky_s: Sampler,
        shadow_map: DepthTexture,
        cmp: ComparisonSampler,
        rad0: Texture3d<Rgba16Float>,
        rad1: Texture3d<Rgba16Float>,
        rad2: Texture3d<Rgba16Float>,
        rad_s: Sampler,
        sdf0: Texture3d<R16Float>,
        sdf1: Texture3d<R16Float>,
        sdf_s: Sampler,
        emitters: GpuSpan<Emitter>,
        tile_masks: GpuSpan<u32>,
        tiles_x: u32,
        hdr_bg: Texture<Rgba16Float>,
        refract_refl: Texture<Rgba16Float>,
        bg_s: Sampler,
    ) {
        if !batches[first].has_trans {
            return
        }
        if batches[first].is_deformed {
            draw(
                rp,
                deformed_mesh_vs.bind(
                    verts: batches[first].deformed_verts.items(),
                    prev_verts: batches[first].prev_deformed_verts.items(),
                    rest_verts: batches[first].verts.items(),
                    xforms: batches[first].xforms.items(),
                    prev_xforms: batches[first].prev_xforms.items(),
                    v: v,
                ),
                field_skin_trans_one_fs.bind(
                    field: self.field,
                    v: v,
                    prev_v: prev_v,
                    sv: sv,
                    rad_grid: rad_grid,
                    sdf_grid: sdf_grid,
                    sky: sky,
                    sky_diff: sky_diff,
                    sky_spec0: sky_spec0,
                    sky_spec1: sky_spec1,
                    sky_spec2: sky_spec2,
                    sky_s: sky_s,
                    shadow_map: shadow_map,
                    cmp: cmp,
                    rad0: rad0,
                    rad1: rad1,
                    rad2: rad2,
                    rad_s: rad_s,
                    sdf0: sdf0,
                    sdf1: sdf1,
                    sdf_s: sdf_s,
                    emitters: emitters,
                    tile_masks: tile_masks,
                    tiles_x: tiles_x,
                    hdr_bg: hdr_bg,
                    refract_refl: refract_refl,
                    bg_s: bg_s,
                ),
                indices: batches[first].trans_indices,
                indirect: batches[first].trans_draw_args,
                cull: Cull::Back,
                depth: Depth { compare: Compare::Greater, write: true },
            )
            return
        }
        draw(
            rp,
            mesh_vs.bind(
                verts: batches[first].verts.items(),
                xforms: batches[first].xforms.items(),
                prev_xforms: batches[first].prev_xforms.items(),
                inst_ids: batches[first].inst_ids.items(),
                is_instanced: 0,
                v: v,
            ),
            field_trans_one_fs.bind(
                field: self.field,
                v: v,
                prev_v: prev_v,
                sv: sv,
                rad_grid: rad_grid,
                sdf_grid: sdf_grid,
                sky: sky,
                sky_diff: sky_diff,
                sky_spec0: sky_spec0,
                sky_spec1: sky_spec1,
                sky_spec2: sky_spec2,
                sky_s: sky_s,
                shadow_map: shadow_map,
                cmp: cmp,
                rad0: rad0,
                rad1: rad1,
                rad2: rad2,
                rad_s: rad_s,
                sdf0: sdf0,
                sdf1: sdf1,
                sdf_s: sdf_s,
                emitters: emitters,
                tile_masks: tile_masks,
                tiles_x: tiles_x,
                hdr_bg: hdr_bg,
                refract_refl: refract_refl,
                bg_s: bg_s,
            ),
            indices: batches[first].trans_indices,
            indirect: batches[first].trans_draw_args,
            cull: Cull::Back,
            depth: Depth { compare: Compare::Greater, write: true },
        )
    }
}

/// Whether a sphere `(c, r)` intersects the view frustum.
fn in_view(c: vec3, r: f32, v: View) -> bool {
    let rel = c - v.at
    let z = dot(rel, v.forward)
    if z + r < NEAR {
        return false
    }
    let aspect = v.size.x / max(v.size.y, 1.0)
    let half_y = max(z, 0.0) / v.focal + r * 1.4
    let half_x = half_y * aspect + r * 1.4
    abs(dot(rel, v.up)) <= half_y && abs(dot(rel, v.right)) <= half_x
}

impl<M: Field<Substance> + StateHash + GpuData, const N: u32> MeshWorld for Many<M, N> {
    type FieldBufs = GpuBuffer<M>

    fn batch_count(self) -> u32 {
        if N >= 16 { 3 } else { 1 }
    }

    fn upload_fields(self) -> GpuBuffer<M> {
        buffer_of(self.fields)
    }

    fn sync_batches(
        self,
        scratch: mut ExtractScratch,
        batches: mut Vec<MeshBatch>,
        first: u32,
        v: View,
    ) {
        let cap = batches[first].max_bricks
        // Each thing's bound, distance and screen-share weight (`0.0` when out of view), once.
        var centres = [vec3(0.0); N]
        var radii = [0.0; N]
        var nears = [0.0; N]
        var weights = [0.0; N]
        var total_w = 0.0
        for i in 0..N {
            let b = self.fields[i].bound()
            let r = min(b.radius, 1.0e4)
            let near = max(length(b.centre - v.at) - r, 0.25)
            centres[i] = b.centre
            radii[i] = r
            nears[i] = near
            if in_view(b.centre, r, v) {
                let s = r / near
                weights[i] = clamp(s * s, 0.002, 4.0)
                total_w += weights[i]
            }
        }
        let inv_w = if total_w > 1.0e-6 { f32(cap) / total_w } else { f32(cap) }

        // Fast path for skinned crowds: split `N >= 16` into 2 distance LOD templates (`<= 12 m`
        // near, `> 12 m` far) so every visible character renders at distance-appropriate density
        // with 0.000 ms per-frame extraction and 1–2 GPU-instanced DQS draw calls.
        let first_skinned = match self.fields[0].skin_shape_hash() {
            Some(_) => true,
            None => false,
        }
        if first_skinned {
            if N < 16 {
                var cells = [0.0; N]
                for i in 0..N {
                    if weights[i] > 0.0 {
                        cells[i] = cell_for_one(
                            centres[i],
                            radii[i],
                            v,
                            steep(self.fields[i]),
                            size_floor(radii[i]),
                        )
                    }
                }
                batches[first].sync_many(mut scratch, self.fields, cells)
                return
            }
            var c_near = [0.0; N]
            var c_far = [0.0; N]
            for i in 0..N {
                if weights[i] > 0.0 {
                    let c = cell_for_one(
                        centres[i],
                        radii[i],
                        v,
                        steep(self.fields[i]),
                        size_floor(radii[i]),
                    )
                    if nears[i] <= 12.0 {
                        c_near[i] = c
                    } else {
                        c_far[i] = c
                    }
                }
            }
            batches[first].sync_many(mut scratch, self.fields, c_near)
            batches[first + 1].sync_many(mut scratch, self.fields, c_far)
            batches[first + 2].has_opaque = false
            batches[first + 2].has_trans = false
            batches[first + 2].inst_count = 0
            batches[first + 2].still_frames += 1
            return
        }
        if N < 16 {
            var cells = [0.0; N]
            for i in 0..N {
                if weights[i] > 0.0 {
                    cells[i] = cell_for_share(centres[i], radii[i], weights[i] * inv_w, v)
                }
            }
            batches[first].sync_many(mut scratch, self.fields, cells)
            return
        }

        // Three batches: things within `FAR_TIER_DIST` (near), and the farther ones split by index
        // parity, so a change re-extracts only the batch it falls in. Every batch syncs every
        // frame (a still batch's sync is a hash check), so each batch's mesh is always this
        // frame's and is shaded by this frame's fields (`fbuf`) with exact motion vectors.
        var c_near = [0.0; N]
        var c_even = [0.0; N]
        var c_odd = [0.0; N]
        for i in 0..N {
            if weights[i] > 0.0 {
                let cell = cell_for_share(centres[i], radii[i], weights[i] * inv_w, v)
                if nears[i] <= FAR_TIER_DIST {
                    c_near[i] = cell
                } else if (i & 1) == 0 {
                    c_even[i] = cell
                } else {
                    c_odd[i] = cell
                }
            }
        }
        batches[first].sync_many(mut scratch, self.fields, c_near)
        batches[first + 1].sync_many(mut scratch, self.fields, c_even)
        batches[first + 2].sync_many(mut scratch, self.fields, c_odd)
    }

    fn splat_sdf(
        self,
        sdf: mut SdfClipmap,
        batches: mut Vec<MeshBatch>,
        first: u32,
        static_only: bool,
        all_batches: bool,
    ) {
        let any_opaque = batches[first].has_opaque ||
            (N >= 16 && (batches[first + 1].has_opaque || batches[first + 2].has_opaque))
        if !any_opaque {
            return
        }
        let is_static = if N < 16 {
            batches[first].still_frames >= 1
        } else {
            batches[first].still_frames >= 1 &&
                batches[first + 1].still_frames >= 1 &&
                batches[first + 2].still_frames >= 1
        }
        if !all_batches && is_static != static_only {
            return
        }
        sdf.splat_many(self.fields, to_static: !all_batches && static_only)
    }

    fn inject_radiance<S: Sky>(
        self,
        fbuf: GpuBuffer<M>,
        rad: mut RadianceCache,
        batches: mut Vec<MeshBatch>,
        first: u32,
        sv: ShadowView,
        sky: S,
        sky_diff: Texture<Rgba16Float>,
        sky_s: Sampler,
        shadow_map: DepthTexture,
        cmp: ComparisonSampler,
        static_only: bool,
        all_batches: bool,
    ) {
        let n_sub: u32 = if N >= 16 { 3 } else { 1 }
        for k in 0..n_sub {
            let bi = first + k
            let is_static = batches[bi].still_frames >= 1
            if all_batches || is_static == static_only {
                if batches[bi].is_skinned {
                    rad.inject_skin_many(
                        fbuf.items(),
                        N,
                        batches[bi].verts.items(),
                        batches[bi].skin_verts.items(),
                        batches[bi].verts.count(),
                        batches[bi].cap_verts,
                        batches[bi].xforms.items(),
                        batches[bi].bones.items(),
                        batches[bi].bone_stride,
                        batches[bi].inst_ids.items(),
                        batches[bi].inst_count,
                        sv,
                        sky,
                        sky_diff,
                        sky_s,
                        shadow_map,
                        cmp,
                        to_static: !all_batches && static_only,
                    )
                } else {
                    let is_inst: u32 = if batches[bi].instanced { 1 } else { 0 }
                    rad.inject_many(
                        fbuf.items(),
                        N,
                        batches[bi].verts.items(),
                        batches[bi].verts.count(),
                        batches[bi].cap_verts,
                        batches[bi].xforms.items(),
                        batches[bi].inst_ids.items(),
                        is_inst,
                        batches[bi].inst_count,
                        sv,
                        sky,
                        sky_diff,
                        sky_s,
                        shadow_map,
                        cmp,
                        to_static: !all_batches && static_only,
                    )
                }
            }
        }
    }

    fn draw_eye(
        self,
        fbuf: GpuBuffer<M>,
        ep: DepthPass4<Rgba8, Rgba8, Rgba16Float, Rg16Float>,
        batches: mut Vec<MeshBatch>,
        first: u32,
        v: View,
        prev_v: View,
    ) {
        // Per batch: opaque quads, then the opaque pixels of the transmissive quads (`_cut_`).
        let n_sub: u32 = if N >= 16 { 3 } else { 1 }
        for k in 0..n_sub {
            let bi = first + k
            let is_inst: u32 = if batches[bi].instanced { 1 } else { 0 }
            if batches[bi].is_skinned {
                let vs = skin_mesh_vs.bind(
                    verts: batches[bi].verts.items(),
                    skin: batches[bi].skin_verts.items(),
                    xforms: batches[bi].xforms.items(),
                    prev_xforms: batches[bi].prev_xforms.items(),
                    bones: batches[bi].bones.items(),
                    prev_bones: batches[bi].prev_bones.items(),
                    bone_stride: batches[bi].bone_stride,
                    inst_ids: batches[bi].inst_ids.items(),
                    is_instanced: is_inst,
                    v: v,
                )
                if batches[bi].has_opaque {
                    draw(
                        ep,
                        vs,
                        field_skin_gbuf_many_fs.bind(
                            fields: fbuf.items(),
                            n_fields: N,
                            v: v,
                            prev_v: prev_v,
                        ),
                        indices: batches[bi].indices,
                        indirect: batches[bi].draw_args,
                        cull: Cull::Back,
                        depth: Depth { compare: Compare::Greater, write: true },
                    )
                }
                if batches[bi].has_trans {
                    draw(
                        ep,
                        vs,
                        field_skin_cut_gbuf_many_fs.bind(
                            fields: fbuf.items(),
                            n_fields: N,
                            v: v,
                            prev_v: prev_v,
                        ),
                        indices: batches[bi].trans_indices,
                        indirect: batches[bi].trans_draw_args,
                        cull: Cull::Back,
                        depth: Depth { compare: Compare::Greater, write: true },
                    )
                }
            } else {
                let vs = mesh_vs.bind(
                    verts: batches[bi].verts.items(),
                    xforms: batches[bi].xforms.items(),
                    prev_xforms: batches[bi].prev_xforms.items(),
                    inst_ids: batches[bi].inst_ids.items(),
                    is_instanced: is_inst,
                    v: v,
                )
                if batches[bi].has_opaque {
                    draw(
                        ep,
                        vs,
                        field_gbuf_many_fs.bind(
                            fields: fbuf.items(),
                            n_fields: N,
                            v: v,
                            prev_v: prev_v,
                        ),
                        indices: batches[bi].indices,
                        indirect: batches[bi].draw_args,
                        cull: Cull::Back,
                        depth: Depth { compare: Compare::Greater, write: true },
                    )
                }
                if batches[bi].has_trans {
                    draw(
                        ep,
                        vs,
                        field_cut_gbuf_many_fs.bind(
                            fields: fbuf.items(),
                            n_fields: N,
                            v: v,
                            prev_v: prev_v,
                        ),
                        indices: batches[bi].trans_indices,
                        indirect: batches[bi].trans_draw_args,
                        cull: Cull::Back,
                        depth: Depth { compare: Compare::Greater, write: true },
                    )
                }
            }
        }
    }

    fn draw_refract_refl(
        self,
        fbuf: GpuBuffer<M>,
        rrp: DepthPass<Rgba16Float>,
        batches: mut Vec<MeshBatch>,
        first: u32,
        v: View,
        rad_grid: RadGrid,
        sdf_grid: SdfGrid,
        sky_diff: Texture<Rgba16Float>,
        sky_spec0: Texture<Rgba16Float>,
        sky_spec1: Texture<Rgba16Float>,
        sky_spec2: Texture<Rgba16Float>,
        sky_s: Sampler,
        rad0: Texture3d<Rgba16Float>,
        rad1: Texture3d<Rgba16Float>,
        rad2: Texture3d<Rgba16Float>,
        rad_s: Sampler,
        sdf0: Texture3d<R16Float>,
        sdf1: Texture3d<R16Float>,
        sdf_s: Sampler,
        hdr_bg: Texture<Rgba16Float>,
        bg_s: Sampler,
        half_size: vec2,
    ) {
        let n_sub: u32 = if N >= 16 { 3 } else { 1 }
        for k in 0..n_sub {
            let bi = first + k
            if batches[bi].has_trans {
                let is_inst: u32 = if batches[bi].instanced { 1 } else { 0 }
                if batches[bi].is_skinned {
                    draw(
                        rrp,
                        skin_mesh_vs.bind(
                            verts: batches[bi].verts.items(),
                            skin: batches[bi].skin_verts.items(),
                            xforms: batches[bi].xforms.items(),
                            prev_xforms: batches[bi].prev_xforms.items(),
                            bones: batches[bi].bones.items(),
                            prev_bones: batches[bi].prev_bones.items(),
                            bone_stride: batches[bi].bone_stride,
                            inst_ids: batches[bi].inst_ids.items(),
                            is_instanced: is_inst,
                            v: v,
                        ),
                        field_skin_refract_refl_many_fs.bind(
                            fields: fbuf.items(),
                            n_fields: N,
                            v: v,
                            rad_grid: rad_grid,
                            sdf_grid: sdf_grid,
                            sky_diff: sky_diff,
                            sky_spec0: sky_spec0,
                            sky_spec1: sky_spec1,
                            sky_spec2: sky_spec2,
                            sky_s: sky_s,
                            rad0: rad0,
                            rad1: rad1,
                            rad2: rad2,
                            rad_s: rad_s,
                            sdf0: sdf0,
                            sdf1: sdf1,
                            sdf_s: sdf_s,
                            hdr_bg: hdr_bg,
                            bg_s: bg_s,
                            half_size: half_size,
                        ),
                        indices: batches[bi].trans_indices,
                        indirect: batches[bi].trans_draw_args,
                        cull: Cull::Back,
                        depth: Depth { compare: Compare::Greater, write: true },
                    )
                } else {
                    draw(
                        rrp,
                        mesh_vs.bind(
                            verts: batches[bi].verts.items(),
                            xforms: batches[bi].xforms.items(),
                            prev_xforms: batches[bi].prev_xforms.items(),
                            inst_ids: batches[bi].inst_ids.items(),
                            is_instanced: is_inst,
                            v: v,
                        ),
                        field_refract_refl_many_fs.bind(
                            fields: fbuf.items(),
                            n_fields: N,
                            v: v,
                            rad_grid: rad_grid,
                            sdf_grid: sdf_grid,
                            sky_diff: sky_diff,
                            sky_spec0: sky_spec0,
                            sky_spec1: sky_spec1,
                            sky_spec2: sky_spec2,
                            sky_s: sky_s,
                            rad0: rad0,
                            rad1: rad1,
                            rad2: rad2,
                            rad_s: rad_s,
                            sdf0: sdf0,
                            sdf1: sdf1,
                            sdf_s: sdf_s,
                            hdr_bg: hdr_bg,
                            bg_s: bg_s,
                            half_size: half_size,
                        ),
                        indices: batches[bi].trans_indices,
                        indirect: batches[bi].trans_draw_args,
                        cull: Cull::Back,
                        depth: Depth { compare: Compare::Greater, write: true },
                    )
                }
            }
        }
    }

    fn draw_refract<S: Sky>(
        self,
        fbuf: GpuBuffer<M>,
        rp: DepthPass2<Rgba16Float, Rg16Float>,
        batches: mut Vec<MeshBatch>,
        first: u32,
        v: View,
        prev_v: View,
        sv: ShadowView,
        rad_grid: RadGrid,
        sdf_grid: SdfGrid,
        sky: S,
        sky_diff: Texture<Rgba16Float>,
        sky_spec0: Texture<Rgba16Float>,
        sky_spec1: Texture<Rgba16Float>,
        sky_spec2: Texture<Rgba16Float>,
        sky_s: Sampler,
        shadow_map: DepthTexture,
        cmp: ComparisonSampler,
        rad0: Texture3d<Rgba16Float>,
        rad1: Texture3d<Rgba16Float>,
        rad2: Texture3d<Rgba16Float>,
        rad_s: Sampler,
        sdf0: Texture3d<R16Float>,
        sdf1: Texture3d<R16Float>,
        sdf_s: Sampler,
        emitters: GpuSpan<Emitter>,
        tile_masks: GpuSpan<u32>,
        tiles_x: u32,
        hdr_bg: Texture<Rgba16Float>,
        refract_refl: Texture<Rgba16Float>,
        bg_s: Sampler,
    ) {
        let n_sub: u32 = if N >= 16 { 3 } else { 1 }
        for k in 0..n_sub {
            let bi = first + k
            if batches[bi].has_trans {
                let is_inst: u32 = if batches[bi].instanced { 1 } else { 0 }
                if batches[bi].is_skinned {
                    draw(
                        rp,
                        skin_mesh_vs.bind(
                            verts: batches[bi].verts.items(),
                            skin: batches[bi].skin_verts.items(),
                            xforms: batches[bi].xforms.items(),
                            prev_xforms: batches[bi].prev_xforms.items(),
                            bones: batches[bi].bones.items(),
                            prev_bones: batches[bi].prev_bones.items(),
                            bone_stride: batches[bi].bone_stride,
                            inst_ids: batches[bi].inst_ids.items(),
                            is_instanced: is_inst,
                            v: v,
                        ),
                        field_skin_trans_many_fs.bind(
                            fields: fbuf.items(),
                            n_fields: N,
                            v: v,
                            prev_v: prev_v,
                            sv: sv,
                            rad_grid: rad_grid,
                            sdf_grid: sdf_grid,
                            sky: sky,
                            sky_diff: sky_diff,
                            sky_spec0: sky_spec0,
                            sky_spec1: sky_spec1,
                            sky_spec2: sky_spec2,
                            sky_s: sky_s,
                            shadow_map: shadow_map,
                            cmp: cmp,
                            rad0: rad0,
                            rad1: rad1,
                            rad2: rad2,
                            rad_s: rad_s,
                            sdf0: sdf0,
                            sdf1: sdf1,
                            sdf_s: sdf_s,
                            emitters: emitters,
                            tile_masks: tile_masks,
                            tiles_x: tiles_x,
                            hdr_bg: hdr_bg,
                            refract_refl: refract_refl,
                            bg_s: bg_s,
                        ),
                        indices: batches[bi].trans_indices,
                        indirect: batches[bi].trans_draw_args,
                        cull: Cull::Back,
                        depth: Depth { compare: Compare::Greater, write: true },
                    )
                } else {
                    draw(
                        rp,
                        mesh_vs.bind(
                            verts: batches[bi].verts.items(),
                            xforms: batches[bi].xforms.items(),
                            prev_xforms: batches[bi].prev_xforms.items(),
                            inst_ids: batches[bi].inst_ids.items(),
                            is_instanced: is_inst,
                            v: v,
                        ),
                        field_trans_many_fs.bind(
                            fields: fbuf.items(),
                            n_fields: N,
                            v: v,
                            prev_v: prev_v,
                            sv: sv,
                            rad_grid: rad_grid,
                            sdf_grid: sdf_grid,
                            sky: sky,
                            sky_diff: sky_diff,
                            sky_spec0: sky_spec0,
                            sky_spec1: sky_spec1,
                            sky_spec2: sky_spec2,
                            sky_s: sky_s,
                            shadow_map: shadow_map,
                            cmp: cmp,
                            rad0: rad0,
                            rad1: rad1,
                            rad2: rad2,
                            rad_s: rad_s,
                            sdf0: sdf0,
                            sdf1: sdf1,
                            sdf_s: sdf_s,
                            emitters: emitters,
                            tile_masks: tile_masks,
                            tiles_x: tiles_x,
                            hdr_bg: hdr_bg,
                            refract_refl: refract_refl,
                            bg_s: bg_s,
                        ),
                        indices: batches[bi].trans_indices,
                        indirect: batches[bi].trans_draw_args,
                        cull: Cull::Back,
                        depth: Depth { compare: Compare::Greater, write: true },
                    )
                }
            }
        }
    }
}

impl<A: MeshWorld, B: MeshWorld> MeshWorld for And<A, B> {
    type FieldBufs = (A::FieldBufs, B::FieldBufs)

    fn batch_count(self) -> u32 {
        self.a.batch_count() + self.b.batch_count()
    }

    fn upload_fields(self) -> (A::FieldBufs, B::FieldBufs) {
        (self.a.upload_fields(), self.b.upload_fields())
    }

    fn sync_batches(
        self,
        scratch: mut ExtractScratch,
        batches: mut Vec<MeshBatch>,
        first: u32,
        v: View,
    ) {
        let na = self.a.batch_count()
        self.a.sync_batches(mut scratch, mut batches, first, v)
        self.b.sync_batches(mut scratch, mut batches, first + na, v)
    }

    fn splat_sdf(
        self,
        sdf: mut SdfClipmap,
        batches: mut Vec<MeshBatch>,
        first: u32,
        static_only: bool,
        all_batches: bool,
    ) {
        let na = self.a.batch_count()
        self.a.splat_sdf(mut sdf, mut batches, first, static_only, all_batches)
        self.b.splat_sdf(mut sdf, mut batches, first + na, static_only, all_batches)
    }

    fn inject_radiance<S: Sky>(
        self,
        fbufs: (A::FieldBufs, B::FieldBufs),
        rad: mut RadianceCache,
        batches: mut Vec<MeshBatch>,
        first: u32,
        sv: ShadowView,
        sky: S,
        sky_diff: Texture<Rgba16Float>,
        sky_s: Sampler,
        shadow_map: DepthTexture,
        cmp: ComparisonSampler,
        static_only: bool,
        all_batches: bool,
    ) {
        let na = self.a.batch_count()
        self.a.inject_radiance(
            fbufs.0,
            mut rad,
            mut batches,
            first,
            sv,
            sky,
            sky_diff,
            sky_s,
            shadow_map,
            cmp,
            static_only: static_only,
            all_batches: all_batches,
        )
        self.b.inject_radiance(
            fbufs.1,
            mut rad,
            mut batches,
            first + na,
            sv,
            sky,
            sky_diff,
            sky_s,
            shadow_map,
            cmp,
            static_only: static_only,
            all_batches: all_batches,
        )
    }

    fn draw_eye(
        self,
        fbufs: (A::FieldBufs, B::FieldBufs),
        ep: DepthPass4<Rgba8, Rgba8, Rgba16Float, Rg16Float>,
        batches: mut Vec<MeshBatch>,
        first: u32,
        v: View,
        prev_v: View,
    ) {
        let na = self.a.batch_count()
        self.a.draw_eye(fbufs.0, ep, mut batches, first, v, prev_v)
        self.b.draw_eye(fbufs.1, ep, mut batches, first + na, v, prev_v)
    }

    fn draw_refract_refl(
        self,
        fbufs: (A::FieldBufs, B::FieldBufs),
        rrp: DepthPass<Rgba16Float>,
        batches: mut Vec<MeshBatch>,
        first: u32,
        v: View,
        rad_grid: RadGrid,
        sdf_grid: SdfGrid,
        sky_diff: Texture<Rgba16Float>,
        sky_spec0: Texture<Rgba16Float>,
        sky_spec1: Texture<Rgba16Float>,
        sky_spec2: Texture<Rgba16Float>,
        sky_s: Sampler,
        rad0: Texture3d<Rgba16Float>,
        rad1: Texture3d<Rgba16Float>,
        rad2: Texture3d<Rgba16Float>,
        rad_s: Sampler,
        sdf0: Texture3d<R16Float>,
        sdf1: Texture3d<R16Float>,
        sdf_s: Sampler,
        hdr_bg: Texture<Rgba16Float>,
        bg_s: Sampler,
        half_size: vec2,
    ) {
        let na = self.a.batch_count()
        self.a.draw_refract_refl(
            fbufs.0,
            rrp,
            mut batches,
            first,
            v,
            rad_grid,
            sdf_grid,
            sky_diff,
            sky_spec0,
            sky_spec1,
            sky_spec2,
            sky_s,
            rad0,
            rad1,
            rad2,
            rad_s,
            sdf0,
            sdf1,
            sdf_s,
            hdr_bg,
            bg_s,
            half_size,
        )
        self.b.draw_refract_refl(
            fbufs.1,
            rrp,
            mut batches,
            first + na,
            v,
            rad_grid,
            sdf_grid,
            sky_diff,
            sky_spec0,
            sky_spec1,
            sky_spec2,
            sky_s,
            rad0,
            rad1,
            rad2,
            rad_s,
            sdf0,
            sdf1,
            sdf_s,
            hdr_bg,
            bg_s,
            half_size,
        )
    }

    fn draw_refract<S: Sky>(
        self,
        fbufs: (A::FieldBufs, B::FieldBufs),
        rp: DepthPass2<Rgba16Float, Rg16Float>,
        batches: mut Vec<MeshBatch>,
        first: u32,
        v: View,
        prev_v: View,
        sv: ShadowView,
        rad_grid: RadGrid,
        sdf_grid: SdfGrid,
        sky: S,
        sky_diff: Texture<Rgba16Float>,
        sky_spec0: Texture<Rgba16Float>,
        sky_spec1: Texture<Rgba16Float>,
        sky_spec2: Texture<Rgba16Float>,
        sky_s: Sampler,
        shadow_map: DepthTexture,
        cmp: ComparisonSampler,
        rad0: Texture3d<Rgba16Float>,
        rad1: Texture3d<Rgba16Float>,
        rad2: Texture3d<Rgba16Float>,
        rad_s: Sampler,
        sdf0: Texture3d<R16Float>,
        sdf1: Texture3d<R16Float>,
        sdf_s: Sampler,
        emitters: GpuSpan<Emitter>,
        tile_masks: GpuSpan<u32>,
        tiles_x: u32,
        hdr_bg: Texture<Rgba16Float>,
        refract_refl: Texture<Rgba16Float>,
        bg_s: Sampler,
    ) {
        let na = self.a.batch_count()
        self.a.draw_refract(
            fbufs.0,
            rp,
            mut batches,
            first,
            v,
            prev_v,
            sv,
            rad_grid,
            sdf_grid,
            sky,
            sky_diff,
            sky_spec0,
            sky_spec1,
            sky_spec2,
            sky_s,
            shadow_map,
            cmp,
            rad0,
            rad1,
            rad2,
            rad_s,
            sdf0,
            sdf1,
            sdf_s,
            emitters,
            tile_masks,
            tiles_x,
            hdr_bg,
            refract_refl,
            bg_s,
        )
        self.b.draw_refract(
            fbufs.1,
            rp,
            mut batches,
            first + na,
            v,
            prev_v,
            sv,
            rad_grid,
            sdf_grid,
            sky,
            sky_diff,
            sky_spec0,
            sky_spec1,
            sky_spec2,
            sky_s,
            shadow_map,
            cmp,
            rad0,
            rad1,
            rad2,
            rad_s,
            sdf0,
            sdf1,
            sdf_s,
            emitters,
            tile_masks,
            tiles_x,
            hdr_bg,
            refract_refl,
            bg_s,
        )
    }
}

/// Draws every opaque batch (or, with `static_only`, only those still since their last sync) into
/// the sun shadow pass `sp` through `sv`: the one way the engine draws shadow casters, used for the
/// frame's shadow map and for the static radiance cache's own.
fn draw_shadow_casters(
    sp: DepthOnlyPass,
    batches: mut Vec<MeshBatch>,
    nb: u32,
    sv: ShadowView,
    static_only: bool,
) {
    for i in 0..nb {
        if batches[i].has_opaque && (!static_only || batches[i].still_frames >= 1) {
            if batches[i].is_deformed {
                draw(
                    sp,
                    shadow_vs.bind(
                        verts: batches[i].deformed_verts.items(),
                        xforms: batches[i].xforms.items(),
                        sv: sv,
                    ),
                    shadow_fs,
                    indices: batches[i].indices,
                    indirect: batches[i].draw_args,
                    cull: Cull::Back,
                    depth_bias: DepthBias { constant: 2, slope: 1.5, clamp: 0.0 },
                    depth: Depth { compare: Compare::Less, write: true },
                )
            } else if batches[i].is_skinned {
                draw(
                    sp,
                    skin_shadow_vs.bind(
                        verts: batches[i].verts.items(),
                        skin: batches[i].skin_verts.items(),
                        xforms: batches[i].xforms.items(),
                        bones: batches[i].bones.items(),
                        bone_stride: batches[i].bone_stride,
                        sv: sv,
                    ),
                    shadow_fs,
                    indices: batches[i].indices,
                    indirect: batches[i].draw_args,
                    cull: Cull::Back,
                    depth_bias: DepthBias { constant: 2, slope: 1.5, clamp: 0.0 },
                    depth: Depth { compare: Compare::Less, write: true },
                )
            } else {
                draw(
                    sp,
                    shadow_vs.bind(
                        verts: batches[i].verts.items(),
                        xforms: batches[i].xforms.items(),
                        sv: sv,
                    ),
                    shadow_fs,
                    indices: batches[i].indices,
                    indirect: batches[i].draw_args,
                    cull: Cull::Back,
                    depth_bias: DepthBias { constant: 2, slope: 1.5, clamp: 0.0 },
                    depth: Depth { compare: Compare::Less, write: true },
                )
            }
        }
    }
}

/// Complete meshlet renderer state: owns extracted batches, unified sun shadow map + 2-cascade
/// 3D SDF clipmap, GPU Sky PMREM cache, camera-focused radiance cache + auto-extracted dynamic
/// emitters, 1× G-buffer + motion vectors, Temporal Super-Resolution (TSR), half-res phase-cycled
/// GI/SSR + half-res refract SSR buffers, volumetric froxels, optical HDR bloom, and `Picture`.
pub struct MeshSight {
    pub drawn: Picture,
    pub hdr_direct: Texture<Rgba16Float>,
    /// The sun's share of `hdr_direct` per pixel (`0..1` by luma): what the contact shadow darkens.
    pub sun_share: Texture<R16Float>,
    pub g_normal: Texture<Rgba8>,
    pub g_albedo: Texture<Rgba8>,
    pub g_emits: Texture<Rgba16Float>,
    pub g_motion: Texture<Rg16Float>,
    pub gi_diff: Texture<Rgba16Float>,
    pub gi_spec: Texture<Rgba16Float>,
    pub refract_refl: Texture<Rgba16Float>,
    pub refract_depth: DepthTexture,
    pub hdr_colour: Texture<Rgba16Float>,
    pub hdr_bg: Texture<Rgba16Float>,
    pub depth: DepthTexture,
    pub sky: SkyCache,
    pub rad: RadianceCache,
    pub sdf: SdfClipmap,
    pub tsr: TsrState,
    pub vol: FroxelVolume,
    pub bloom: BloomPyramid,
    pub swarm: SwarmSim,
    scratch: ExtractScratch,
    clipmap: ClipmapMesh,
    batches: Vec<MeshBatch>,
    shadow_map: DepthTexture,
    /// The sun shadow map of the still batches alone (same `ShadowView`), drawn only when the
    /// static radiance cache rebuilds, so moving things' shadows are never baked into it.
    static_shadow_map: DepthTexture,
    cmp: ComparisonSampler,
    bg_s: Sampler,
    rad_key: u64,
    rad_built: bool,
    frame: u32,
    pub gi: bool,
}

/// Creates a fresh `MeshSight` with 2-cascade 3D SDF clipmap, 1× G-buffer + analytical motion
/// vectors + Halton-jittered Temporal Super-Resolution (TSR), pixel-rate deferred direct lighting,
/// 16×16 tiled dynamic emitters, phase-cycled half-res GI/SSR, half-res refract SSR + 3-channel
/// chromatic dispersion, froxel volumetrics, and optical HDR bloom.
pub fn mesh_sight(gi: bool = true) -> MeshSight {
    MeshSight {
        drawn: picture(width: 1, height: 1),
        hdr_direct: texture(width: 1, height: 1),
        sun_share: texture(width: 1, height: 1),
        g_normal: texture(width: 1, height: 1),
        g_albedo: texture(width: 1, height: 1),
        g_emits: texture(width: 1, height: 1),
        g_motion: texture(width: 1, height: 1),
        gi_diff: texture(width: 1, height: 1),
        gi_spec: texture(width: 1, height: 1),
        refract_refl: texture(width: 1, height: 1),
        refract_depth: depth_texture(width: 1, height: 1),
        hdr_colour: texture(width: 1, height: 1),
        hdr_bg: texture(width: 1, height: 1),
        depth: depth_texture(width: 1, height: 1),
        sky: sky_cache(),
        rad: radiance_cache(),
        sdf: sdf_clipmap(),
        tsr: tsr_state(),
        vol: froxel_volume(),
        bloom: bloom_pyramid(),
        swarm: swarm_sim(),
        scratch: extract_scratch(BATCH_BRICKS),
        clipmap: clipmap_mesh(),
        batches: Vec::new(),
        shadow_map: depth_texture(width: SHADOW_SIDE, height: SHADOW_SIDE),
        static_shadow_map: depth_texture(width: SHADOW_SIDE, height: SHADOW_SIDE),
        cmp: comparison_sampler(compare: Compare::LessEqual),
        bg_s: sampler(filter: Filter::Linear, address: Address::Clamp),
        rad_key: 0,
        rad_built: false,
        frame: 0,
        gi: gi,
    }
}

impl MeshSight {
    fn resize(mut self, width: u32, height: u32) {
        if self.drawn.width() != width || self.drawn.height() != height {
            let hw = max(width / 2, 1)
            let hh = max(height / 2, 1)
            self.drawn = picture(width: width, height: height)
            self.drawn.placed = true
            self.hdr_direct = texture(width: width, height: height)
            self.sun_share = texture(width: width, height: height)
            self.g_normal = texture(width: width, height: height)
            self.g_albedo = texture(width: width, height: height)
            self.g_emits = texture(width: width, height: height)
            self.g_motion = texture(width: width, height: height)
            self.gi_diff = texture(width: hw, height: hh)
            self.gi_spec = texture(width: hw, height: hh)
            self.refract_refl = texture(width: hw, height: hh)
            self.refract_depth = depth_texture(width: hw, height: hh)
            self.hdr_colour = texture(width: width, height: height)
            self.hdr_bg = texture(width: width, height: height)
            self.depth = depth_texture(width: width, height: height)
            self.tsr.resize(width, height)
        }
    }

    fn ensure_batches(mut self, count: u32) {
        while self.batches.len() < count {
            self.batches.push(mesh_batch(BATCH_BRICKS))
        }
    }

    /// Updates Sky PMREM, syncs meshlets, builds/updates the 2-cascade 3D SDF clipmap, steps
    /// `swarm` accelerated by the SDF clipmap, renders the unified sun shadow map, and updates
    /// the camera-focused radiance volume & dynamic emitters.
    fn prepare_and_shadow<W: World + MeshWorld, Sw: Swarm, S: Sky>(
        mut self,
        world: W,
        fbufs: W::FieldBufs,
        swarm: Sw,
        sky: S,
        eye: Eye,
        width: u32,
        height: u32,
        frame: u32,
    ) -> (u32, View, ShadowView) {
        self.resize(width, height)
        let v = view(eye, width: width, height: height)

        self.sky.sync(sky)

        let nb = world.batch_count()
        self.ensure_batches(nb)
        world.sync_batches(mut self.scratch, mut self.batches, 0, v)

        var wlo = vec3(1.0e20)
        var whi = vec3(-1.0e20)
        var rk = Hasher::new()
        var sdf_fk = Hasher::new()
        var static_opaque_count: u32 = 0
        for i in 0..nb {
            self.batches[i].finish_poll()
            let b = self.batches[i].bound
            self.batches[i].hash.state_hash(mut rk)
            if self.batches[i].has_opaque {
                i.state_hash(mut sdf_fk)
                self.batches[i].hash.state_hash(mut sdf_fk)
                if self.batches[i].still_frames >= 1 {
                    static_opaque_count += 1
                }
            }
            if b.w > 0.0 {
                wlo = min(wlo, b.xyz - vec3(b.w))
                whi = max(whi, b.xyz + vec3(b.w))
            }
        }
        let wmid = 0.5 * (wlo + whi)
        let wrad = if whi.x > wlo.x { 0.5 * length(whi - wlo) } else { 10.0 }
        let sun = sky.sun()
        let sv = shadow_view(wmid, wrad, sun.way)

        // Focus near SDF cascade + radiance volume around camera look target (clamped to world).
        let focus_raw = v.at + v.forward * min(FOCUS_RAD * 0.75, wrad * 0.65)
        let focus = clamp(focus_raw, wlo, whi)

        // Pass 0b: Sparse 2-cascade 3D SDF clipmap (`96³` near + `64³` world, static/dynamic split).
        // Runs BEFORE `swarm.update` so grain physics uses 1-tap hardware SDF broad-phase culling.
        if !self.gi {
            self.sdf.disable(focus, wmid, wrad)
        } else {
            let sg = sdf_grid(focus, wmid, wrad, enabled: true)
            sg.o0.state_hash(mut sdf_fk)
            sg.v0.state_hash(mut sdf_fk)
            sg.o1.state_hash(mut sdf_fk)
            sg.v1.state_hash(mut sdf_fk)
            let full_sdf_key = sdf_fk.finish()
            if !self.sdf.full_valid || self.sdf.full_key != full_sdf_key {
                if static_opaque_count > 0 {
                    var ssk = Hasher::new()
                    sg.o0.state_hash(mut ssk)
                    sg.v0.state_hash(mut ssk)
                    sg.o1.state_hash(mut ssk)
                    sg.v1.state_hash(mut ssk)
                    for i in 0..nb {
                        if self.batches[i].has_opaque && self.batches[i].still_frames >= 1 {
                            i.state_hash(mut ssk)
                            self.batches[i].hash.state_hash(mut ssk)
                        }
                    }
                    let skey = ssk.finish()
                    if !self.sdf.static_valid || self.sdf.static_key != skey {
                        self.sdf.begin_static(sg)
                        world.splat_sdf(
                            mut self.sdf,
                            mut self.batches,
                            0,
                            static_only: true,
                            all_batches: false,
                        )
                        self.sdf.static_key = skey
                        self.sdf.static_valid = true
                    }
                    self.sdf.begin_from_static(sg)
                    world.splat_sdf(
                        mut self.sdf,
                        mut self.batches,
                        0,
                        static_only: false,
                        all_batches: false,
                    )
                } else {
                    self.sdf.begin_all(sg)
                    world.splat_sdf(
                        mut self.sdf,
                        mut self.batches,
                        0,
                        static_only: false,
                        all_batches: true,
                    )
                }
                self.sdf.finish()
                self.sdf.full_key = full_sdf_key
                self.sdf.full_valid = true
            } else {
                self.sdf.grid = sg
            }
        }

        self.swarm.update(
            swarm,
            world.field(),
            self.sdf.grid,
            self.sdf.sdf0,
            self.sdf.sdf1,
            self.sdf.s,
        )

        // Pass 1: Unified sun shadow map (one `2048²` world map paired with exact 3D SDF cone penumbra).
        label("mesh_shadow")
        let sp: DepthOnlyPass = begin_depth_pass(
            mut self.shadow_map,
            clear_depth: 1.0,
            keep_depth: false,
        )
        draw_shadow_casters(sp, mut self.batches, nb, sv, static_only: false)
        if self.swarm.count > 0 {
            draw(
                sp,
                swarm_shadow_vs.bind(grains: self.swarm.front(), sv: sv),
                shadow_fs,
                vertices: 6,
                instances: self.swarm.count,
                depth: Depth { compare: Compare::Less, write: true },
            )
        }
        sp.end()

        // Pass 1b: Camera-focused radiance cache & dynamic local emitters.
        // Skips rebuild completely (0 ms/frame) when the whole world is static; when only dynamic
        // batches move, copies the cached static accumulation buffers and injects only dynamic
        // batches + swarm instead of re-injecting static architecture every frame.
        // The key holds everything injection reads: the batches (above), the sun's way and light,
        // the sky, the volume's place, and the warm-up stage. Injection gathers its bounce from last
        // frame's volume (`prev_rad1`), zero before the first build, so a still scene rebuilds on
        // frames 0, 1 and 2 (`min(frame, 2)`) until the bounce has been gathered, then holds.
        let rad_centre = if wrad > 16.0 { focus } else { wmid }
        let rad_rad = min(wrad, 16.0)
        let warmup_stage = min(frame, 2)
        sun.way.state_hash(mut rk)
        sun.light.state_hash(mut rk)
        self.sky.key().state_hash(mut rk)
        rad_centre.state_hash(mut rk)
        warmup_stage.state_hash(mut rk)
        if self.swarm.count > 0 {
            frame.state_hash(mut rk)
        }
        let rkey = rk.finish()
        if !self.gi {
            self.rad.begin(rad_centre, rad_rad, enabled: false)
            self.rad_built = false
        } else if !self.rad_built || self.rad_key != rkey {
            // The static key holds everything static injection reads: the still batches, the sun, the sky,
            // the volume's place and size, the warm-up stage, and the shadow view its own shadow
            // map is drawn through (which follows the whole world's bound).
            var sk = Hasher::new()
            sun.way.state_hash(mut sk)
            sun.light.state_hash(mut sk)
            self.sky.key().state_hash(mut sk)
            sv.centre.state_hash(mut sk)
            sv.radius.state_hash(mut sk)
            rad_centre.state_hash(mut sk)
            rad_rad.state_hash(mut sk)
            warmup_stage.state_hash(mut sk)
            var static_count: u32 = 0
            for i in 0..nb {
                if self.batches[i].still_frames >= 1 {
                    i.state_hash(mut sk)
                    self.batches[i].hash.state_hash(mut sk)
                    static_count += 1
                }
            }
            let skey = sk.finish()
            if static_count > 0 {
                if !self.rad.static_valid || self.rad.static_key != skey {
                    label("mesh_shadow_static")
                    let ssp: DepthOnlyPass = begin_depth_pass(
                        mut self.static_shadow_map,
                        clear_depth: 1.0,
                        keep_depth: false,
                    )
                    draw_shadow_casters(ssp, mut self.batches, nb, sv, static_only: true)
                    ssp.end()
                    self.rad.begin_static(rad_centre, rad_rad, enabled: true)
                    world.inject_radiance(
                        fbufs,
                        mut self.rad,
                        mut self.batches,
                        0,
                        sv,
                        sky,
                        self.sky.diff,
                        self.sky.s,
                        self.static_shadow_map,
                        self.cmp,
                        static_only: true,
                        all_batches: false,
                    )
                    self.rad.static_key = skey
                    self.rad.static_valid = true
                }
                self.rad.begin_from_static(rad_centre, rad_rad)
                world.inject_radiance(
                    fbufs,
                    mut self.rad,
                    mut self.batches,
                    0,
                    sv,
                    sky,
                    self.sky.diff,
                    self.sky.s,
                    self.shadow_map,
                    self.cmp,
                    static_only: false,
                    all_batches: false,
                )
            } else {
                self.rad.begin(rad_centre, rad_rad, enabled: true)
                world.inject_radiance(
                    fbufs,
                    mut self.rad,
                    mut self.batches,
                    0,
                    sv,
                    sky,
                    self.sky.diff,
                    self.sky.s,
                    self.shadow_map,
                    self.cmp,
                    static_only: false,
                    all_batches: true,
                )
            }
            if self.swarm.count > 0 {
                self.swarm.inject_radiance(
                    swarm,
                    self.rad.grid,
                    mut self.rad.accum,
                    mut self.rad.emit_accum,
                )
            }
            self.rad.finish()
            self.rad_key = rkey
            self.rad_built = true
        }
        (nb, v, sv)
    }

    /// Shared opaque geometry + tiled emitter culling + pixel-rate deferred direct + phase-cycled
    /// half-res bilateral GI/SSR + full-res combine pipeline used identically by BOTH `draw_scene`
    /// and `drawn_only` (the judges test the exact same renderer that draws the game).
    fn render_opaque_and_indirect<W: World + MeshWorld, H: Height, Sw: Swarm, S: Sky>(
        mut self,
        world: W,
        fbufs: W::FieldBufs,
        height: H,
        swarm: Sw,
        sky: S,
        v: View,
        prev_v: View,
        sv: ShadowView,
        width: u32,
        height_px: u32,
        phase_x: u32,
        phase_y: u32,
        write_judge: bool,
    ) {
        self.rad.cull_tiles(v, width, height_px)

        // Pass 2a: Lean 1× G-buffer + analytical motion-vector pass with pixel-rate `channels(wp)`.
        label("mesh_eye")
        let ep: DepthPass4<Rgba8, Rgba8, Rgba16Float, Rg16Float> = begin_pass4_with_depth(
            mut self.g_normal,
            mut self.g_albedo,
            mut self.g_emits,
            mut self.g_motion,
            mut self.depth,
            clear: vec4(0.0, 0.0, 0.0, 0.0),
            clear_depth: 0.0,
        )
        world.draw_eye(fbufs, ep, mut self.batches, 0, v, prev_v)
        if height.active() && height.has_opaque() {
            draw(
                ep,
                height_vs.bind(height: height, v: v, base_level: 0, trans_pass: 0),
                mesh_gbuf_fs.bind(v: v, prev_v: prev_v),
                indices: self.clipmap.inner_indices,
                index_count: self.clipmap.inner_count,
                instances: 1,
                cull: Cull::Back,
                depth: Depth { compare: Compare::Greater, write: true },
            )
            draw(
                ep,
                height_vs.bind(height: height, v: v, base_level: 1, trans_pass: 0),
                mesh_gbuf_fs.bind(v: v, prev_v: prev_v),
                indices: self.clipmap.outer_indices,
                index_count: self.clipmap.outer_count,
                instances: CLIP_RINGS - 1,
                cull: Cull::Back,
                depth: Depth { compare: Compare::Greater, write: true },
            )
        }
        if self.swarm.count > 0 {
            draw(
                ep,
                swarm_vs.bind(swarm: swarm, grains: self.swarm.front(), v: v),
                swarm_fs.bind(v: v, prev_v: prev_v),
                vertices: 6,
                instances: self.swarm.count,
                depth: Depth { compare: Compare::Greater, write: true },
            )
        }
        ep.end()

        // Pass 2b: Full-res 1× pixel-rate deferred direct lighting (SDF soft shadows + curvature + SSS + tiled emitters).
        label("mesh_direct")
        if write_judge {
            let dp = begin_pass4(
                mut self.hdr_direct,
                mut self.drawn.place,
                mut self.drawn.sun,
                mut self.sun_share,
                keep: false,
            )
            draw(
                dp,
                cover,
                deferred_direct_judge_fs.bind(
                    v: v,
                    sv: sv,
                    rad_grid: self.rad.grid,
                    sdf_grid: self.sdf.grid,
                    sky: sky,
                    g_normal: self.g_normal,
                    g_albedo: self.g_albedo,
                    g_emits: self.g_emits,
                    depth: self.depth,
                    sky_spec0: self.sky.spec0,
                    sky_s: self.sky.s,
                    shadow_map: self.shadow_map,
                    cmp: self.cmp,
                    rad0: self.rad.rad0,
                    rad1: self.rad.rad1,
                    rad_s: self.rad.s,
                    sdf0: self.sdf.sdf0,
                    sdf1: self.sdf.sdf1,
                    sdf_s: self.sdf.s,
                    emitters: self.rad.emitters.items(),
                    tile_masks: self.rad.tile_masks.items(),
                    tiles_x: self.rad.tiles_x,
                    full_w: width,
                    full_h: height_px,
                ),
                vertices: 3,
            )
            dp.end()
        } else {
            let dp = begin_pass2(mut self.hdr_direct, mut self.sun_share, keep: false)
            draw(
                dp,
                cover,
                deferred_direct_fs.bind(
                    v: v,
                    sv: sv,
                    rad_grid: self.rad.grid,
                    sdf_grid: self.sdf.grid,
                    sky: sky,
                    g_normal: self.g_normal,
                    g_albedo: self.g_albedo,
                    g_emits: self.g_emits,
                    depth: self.depth,
                    sky_spec0: self.sky.spec0,
                    sky_s: self.sky.s,
                    shadow_map: self.shadow_map,
                    cmp: self.cmp,
                    rad0: self.rad.rad0,
                    rad1: self.rad.rad1,
                    rad_s: self.rad.s,
                    sdf0: self.sdf.sdf0,
                    sdf1: self.sdf.sdf1,
                    sdf_s: self.sdf.s,
                    emitters: self.rad.emitters.items(),
                    tile_masks: self.rad.tile_masks.items(),
                    tiles_x: self.rad.tiles_x,
                    full_w: width,
                    full_h: height_px,
                ),
                vertices: 3,
            )
            dp.end()
        }

        // Pass 2c: Half-res (`W/2 × H/2`) 4-cone diffuse GI + SDF bent-normal AO + SSR + micro-contact shadows.
        label("mesh_indirect")
        let ip = begin_pass2(mut self.gi_diff, mut self.gi_spec, keep: false)
        draw(
            ip,
            cover,
            indirect_half_fs.bind(
                v: v,
                rad_grid: self.rad.grid,
                sdf_grid: self.sdf.grid,
                sky: sky,
                hdr_direct: self.hdr_direct,
                g_normal: self.g_normal,
                g_albedo: self.g_albedo,
                g_emits: self.g_emits,
                depth: self.depth,
                bg_s: self.bg_s,
                sky_diff: self.sky.diff,
                sky_spec0: self.sky.spec0,
                sky_spec1: self.sky.spec1,
                sky_spec2: self.sky.spec2,
                sky_s: self.sky.s,
                rad0: self.rad.rad0,
                rad1: self.rad.rad1,
                rad2: self.rad.rad2,
                rad_s: self.rad.s,
                sdf0: self.sdf.sdf0,
                sdf1: self.sdf.sdf1,
                sdf_s: self.sdf.s,
                full_w: width,
                full_h: height_px,
                phase_x: phase_x,
                phase_y: phase_y,
            ),
            vertices: 3,
        )
        ip.end()

        // Pass 2d: Full-res depth+normal bilateral upsample of phase-cycled GI/SSR.
        label("mesh_combine")
        let cp = begin_pass(mut self.hdr_colour, keep: false)
        draw(
            cp,
            cover,
            combine_indirect_fs.bind(
                v: v,
                sky: sky,
                hdr_direct: self.hdr_direct,
                sun_share: self.sun_share,
                g_normal: self.g_normal,
                g_albedo: self.g_albedo,
                g_emits: self.g_emits,
                gi_diff: self.gi_diff,
                gi_spec: self.gi_spec,
                sky_diff: self.sky.diff,
                sky_s: self.sky.s,
                full_w: width,
                full_h: height_px,
                phase_x: phase_x,
                phase_y: phase_y,
            ),
            vertices: 3,
        )
        cp.end()
    }

    /// Unified refractive / transmissive pass (half-res SSR pre-pass + full-res 3-channel chromatic
    /// dispersion, Beer-Lambert absorption, tiled emitter specular, and motion vectors) over the
    /// opaque frame in `hdr_colour`, shared by `draw_scene` and `drawn_only`. Skipped completely
    /// (0.0 ms) when no heightfield or batch contains transmissive triangles.
    fn render_transmissive<W: World + MeshWorld, H: Height, S: Sky>(
        mut self,
        world: W,
        fbufs: W::FieldBufs,
        height: H,
        sky: S,
        v: View,
        prev_v: View,
        sv: ShadowView,
        width: u32,
        height_px: u32,
        nb: u32,
    ) {
        var any_trans = height.active() && height.has_transmissive()
        for i in 0..nb {
            self.batches[i].finish_poll()
            if self.batches[i].has_trans {
                any_trans = true
            }
        }
        if any_trans {
            label("mesh_refract")
            copy_texture(from: self.hdr_colour.level(0), to: self.hdr_bg.level_mut(0))
            let half_size = vec2(f32(max(width / 2, 1)), f32(max(height_px / 2, 1)))
            let rrp: DepthPass<Rgba16Float> = begin_pass_with_depth(
                mut self.refract_refl,
                mut self.refract_depth,
                clear: vec4(0.0, 0.0, 0.0, 0.0),
                clear_depth: 0.0,
            )
            world.draw_refract_refl(
                fbufs,
                rrp,
                mut self.batches,
                0,
                v,
                self.rad.grid,
                self.sdf.grid,
                self.sky.diff,
                self.sky.spec0,
                self.sky.spec1,
                self.sky.spec2,
                self.sky.s,
                self.rad.rad0,
                self.rad.rad1,
                self.rad.rad2,
                self.rad.s,
                self.sdf.sdf0,
                self.sdf.sdf1,
                self.sdf.s,
                self.hdr_bg,
                self.bg_s,
                half_size,
            )
            if height.active() && height.has_transmissive() {
                draw(
                    rrp,
                    height_vs.bind(height: height, v: v, base_level: 0, trans_pass: 1),
                    refract_refl_fs.bind(
                        v: v,
                        rad_grid: self.rad.grid,
                        sdf_grid: self.sdf.grid,
                        sky_diff: self.sky.diff,
                        sky_spec0: self.sky.spec0,
                        sky_spec1: self.sky.spec1,
                        sky_spec2: self.sky.spec2,
                        sky_s: self.sky.s,
                        rad0: self.rad.rad0,
                        rad1: self.rad.rad1,
                        rad2: self.rad.rad2,
                        rad_s: self.rad.s,
                        sdf0: self.sdf.sdf0,
                        sdf1: self.sdf.sdf1,
                        sdf_s: self.sdf.s,
                        hdr_bg: self.hdr_bg,
                        bg_s: self.bg_s,
                        half_size: half_size,
                    ),
                    indices: self.clipmap.inner_indices,
                    index_count: self.clipmap.inner_count,
                    instances: 1,
                    cull: Cull::Back,
                    depth: Depth { compare: Compare::Greater, write: true },
                )
                draw(
                    rrp,
                    height_vs.bind(height: height, v: v, base_level: 1, trans_pass: 1),
                    refract_refl_fs.bind(
                        v: v,
                        rad_grid: self.rad.grid,
                        sdf_grid: self.sdf.grid,
                        sky_diff: self.sky.diff,
                        sky_spec0: self.sky.spec0,
                        sky_spec1: self.sky.spec1,
                        sky_spec2: self.sky.spec2,
                        sky_s: self.sky.s,
                        rad0: self.rad.rad0,
                        rad1: self.rad.rad1,
                        rad2: self.rad.rad2,
                        rad_s: self.rad.s,
                        sdf0: self.sdf.sdf0,
                        sdf1: self.sdf.sdf1,
                        sdf_s: self.sdf.s,
                        hdr_bg: self.hdr_bg,
                        bg_s: self.bg_s,
                        half_size: half_size,
                    ),
                    indices: self.clipmap.outer_indices,
                    index_count: self.clipmap.outer_count,
                    instances: CLIP_RINGS - 1,
                    cull: Cull::Back,
                    depth: Depth { compare: Compare::Greater, write: true },
                )
            }
            rrp.end()

            // Transmissive surfaces write their own motion beside their colour and depth, so TSR
            // (which takes each pixel's motion where its 3×3 depth is nearest) reprojects glass and
            // water by their own movement, not by what lies behind them.
            let rp: DepthPass2<Rgba16Float, Rg16Float> = begin_pass2_with_depth(
                mut self.hdr_colour,
                mut self.g_motion,
                mut self.depth,
                keep: true,
                keep_depth: true,
            )
            world.draw_refract(
                fbufs,
                rp,
                mut self.batches,
                0,
                v,
                prev_v,
                sv,
                self.rad.grid,
                self.sdf.grid,
                sky,
                self.sky.diff,
                self.sky.spec0,
                self.sky.spec1,
                self.sky.spec2,
                self.sky.s,
                self.shadow_map,
                self.cmp,
                self.rad.rad0,
                self.rad.rad1,
                self.rad.rad2,
                self.rad.s,
                self.sdf.sdf0,
                self.sdf.sdf1,
                self.sdf.s,
                self.rad.emitters.items(),
                self.rad.tile_masks.items(),
                self.rad.tiles_x,
                self.hdr_bg,
                self.refract_refl,
                self.bg_s,
            )
            if height.active() && height.has_transmissive() {
                draw(
                    rp,
                    height_vs.bind(height: height, v: v, base_level: 0, trans_pass: 1),
                    mesh_trans_fs.bind(
                        v: v,
                        prev_v: prev_v,
                        sv: sv,
                        rad_grid: self.rad.grid,
                        sdf_grid: self.sdf.grid,
                        sky: sky,
                        sky_diff: self.sky.diff,
                        sky_spec0: self.sky.spec0,
                        sky_spec1: self.sky.spec1,
                        sky_spec2: self.sky.spec2,
                        sky_s: self.sky.s,
                        shadow_map: self.shadow_map,
                        cmp: self.cmp,
                        rad0: self.rad.rad0,
                        rad1: self.rad.rad1,
                        rad2: self.rad.rad2,
                        rad_s: self.rad.s,
                        sdf0: self.sdf.sdf0,
                        sdf1: self.sdf.sdf1,
                        sdf_s: self.sdf.s,
                        emitters: self.rad.emitters.items(),
                        tile_masks: self.rad.tile_masks.items(),
                        tiles_x: self.rad.tiles_x,
                        hdr_bg: self.hdr_bg,
                        refract_refl: self.refract_refl,
                        bg_s: self.bg_s,
                    ),
                    indices: self.clipmap.inner_indices,
                    index_count: self.clipmap.inner_count,
                    instances: 1,
                    cull: Cull::Back,
                    depth: Depth { compare: Compare::Greater, write: true },
                )
                draw(
                    rp,
                    height_vs.bind(height: height, v: v, base_level: 1, trans_pass: 1),
                    mesh_trans_fs.bind(
                        v: v,
                        prev_v: prev_v,
                        sv: sv,
                        rad_grid: self.rad.grid,
                        sdf_grid: self.sdf.grid,
                        sky: sky,
                        sky_diff: self.sky.diff,
                        sky_spec0: self.sky.spec0,
                        sky_spec1: self.sky.spec1,
                        sky_spec2: self.sky.spec2,
                        sky_s: self.sky.s,
                        shadow_map: self.shadow_map,
                        cmp: self.cmp,
                        rad0: self.rad.rad0,
                        rad1: self.rad.rad1,
                        rad2: self.rad.rad2,
                        rad_s: self.rad.s,
                        sdf0: self.sdf.sdf0,
                        sdf1: self.sdf.sdf1,
                        sdf_s: self.sdf.s,
                        emitters: self.rad.emitters.items(),
                        tile_masks: self.rad.tile_masks.items(),
                        tiles_x: self.rad.tiles_x,
                        hdr_bg: self.hdr_bg,
                        refract_refl: self.refract_refl,
                        bg_s: self.bg_s,
                    ),
                    indices: self.clipmap.outer_indices,
                    index_count: self.clipmap.outer_count,
                    instances: CLIP_RINGS - 1,
                    cull: Cull::Back,
                    depth: Depth { compare: Compare::Greater, write: true },
                )
            }
            rp.end()
        }
    }

    /// Renders `world` into `self.drawn` (`colour`, `place`, `sun`) without presenting (for
    /// judging against `Reference`), executing the exact same 1× + Halton-jittered TSR pipeline as
    /// `draw_scene` (opaque, indirect, transmissive, resolve) over 8 subpixel frames so offline
    /// judges verify the real temporal resolve.
    pub fn drawn_only<W: World + MeshWorld, S: Sky, L: Look>(
        mut self,
        world: W,
        sky: S,
        look: L,
        eye: Eye,
        width: u32,
        height: u32,
    ) {
        let fbufs = world.upload_fields()
        let (nb, v_unjit, sv) = self.prepare_and_shadow(
            world,
            fbufs,
            NoSwarm {},
            sky,
            eye,
            width,
            height,
            0,
        )
        self.tsr.valid = false

        // Subframe 0: exact pixel-center view writes `drawn.place` and `drawn.sun`, and seeds TSR.
        self.render_opaque_and_indirect(
            world,
            fbufs,
            NoHeight {},
            NoSwarm {},
            sky,
            v_unjit,
            v_unjit,
            sv,
            width,
            height,
            phase_x: 0,
            phase_y: 0,
            write_judge: true,
        )
        self.render_transmissive(
            world,
            fbufs,
            NoHeight {},
            sky,
            v_unjit,
            v_unjit,
            sv,
            width,
            height,
            nb,
        )
        self.tsr.resolve(mut self.hdr_colour, self.g_motion, self.depth, v_unjit, width, height)

        // Subframes 1..7: converge Halton(2, 3) TSR supersampling. `drawn.place` keeps subframe 0's
        // middle-ray hit alone, as `Picture::place` promises, so a hole at a pixel's middle is seen.
        for s in 1..8 {
            let j = halton_jitter(s)
            let vj = v_unjit.moved(j)
            let px = s & 1
            let py = (s >> 1) & 1
            self.render_opaque_and_indirect(
                world,
                fbufs,
                NoHeight {},
                NoSwarm {},
                sky,
                vj,
                v_unjit,
                sv,
                width,
                height,
                phase_x: px,
                phase_y: py,
                write_judge: false,
            )
            self.render_transmissive(
                world,
                fbufs,
                NoHeight {},
                sky,
                vj,
                v_unjit,
                sv,
                width,
                height,
                nb,
            )
            self.tsr.resolve(mut self.hdr_colour, self.g_motion, self.depth, v_unjit, width, height)
        }

        label("mesh_tone")
        let tp = begin_pass(mut self.drawn.colour, keep: false)
        draw(
            tp,
            cover,
            hdr_tone_fs.bind(
                hdr: self.hdr_colour,
                depth: self.depth,
                froxel_acc: self.vol.acc,
                vol_s: self.vol.s,
                vol_active: 0,
                bloom_tex: self.bloom.u0,
                bloom_s: self.bloom.s,
                bloom_strength: 0.0,
                v: v_unjit,
                look: look,
            ),
            vertices: 3,
        )
        tp.end()
        self.drawn.placed = true
        for i in 0..nb {
            self.batches[i].maybe_queue_poll()
        }
    }

    /// Renders a complete scene (`world` solids, `height` clipmap, `medium` froxels, and `swarm`
    /// field-colliding GPU grains) through ONE depth buffer, ONE light store, 2-cascade 3D SDF
    /// clipmap, 1× G-buffer + motion vectors, phase-cycled half-res GI/SSR, half-res refract SSR +
    /// 3-channel chromatic dispersion, Temporal Super-Resolution (TSR), froxel volumetrics,
    /// optical HDR bloom, and ONE `Look::tone` pass.
    pub fn draw_scene<W: World + MeshWorld, H: Height, Med: Medium, Sw: Swarm, S: Sky, L: Look>(
        mut self,
        world: W,
        height: H,
        medium: Med,
        swarm: Sw,
        sky: S,
        look: L,
        eye: Eye,
        width: u32,
        height_px: u32,
    ) {
        let cur_frame = self.frame
        let fbufs = world.upload_fields()
        let (nb, v_unjit, sv) = self.prepare_and_shadow(
            world,
            fbufs,
            swarm,
            sky,
            eye,
            width,
            height_px,
            cur_frame,
        )
        self.frame += 1

        let jitter = halton_jitter(cur_frame)
        let v = v_unjit.moved(jitter)
        let prev_v = if self.tsr.valid { self.tsr.prev_v } else { v_unjit }
        let phase_x = cur_frame & 1
        let phase_y = (cur_frame >> 1) & 1

        self.render_opaque_and_indirect(
            world,
            fbufs,
            height,
            swarm,
            sky,
            v,
            prev_v,
            sv,
            width,
            height_px,
            phase_x,
            phase_y,
            write_judge: false,
        )

        self.render_transmissive(world, fbufs, height, sky, v, prev_v, sv, width, height_px, nb)

        // Pass 2f: Temporal Super-Resolution (TSR): merges Halton-jittered subpixel frames and
        // 2×2 phase-cycled half-res GI/SSR into crisp full-resolution supersampled HDR.
        self.tsr.resolve(mut self.hdr_colour, self.g_motion, self.depth, v_unjit, width, height_px)

        // Pass 2g: Unified volumetric froxel pass (0 ms when `medium.active()` is false).
        let has_vol = medium.active()
        if has_vol {
            self.vol.update(
                medium,
                v_unjit,
                sv,
                self.rad.grid,
                sky,
                self.sky.diff,
                self.sky.s,
                self.shadow_map,
                self.cmp,
                self.rad.rad1,
                self.rad.rad2,
                self.rad.s,
                self.rad.emitters.items(),
                self.rad.emitters.count(),
            )
        }

        // Pass 2f: Optical HDR bloom pyramid (0 ms when `look.bloom().strength <= 0.0`).
        let bloom_cfg = look.bloom()
        self.bloom.build(self.hdr_colour, width, height_px, bloom_cfg)

        // Pass 3: Unified volumetric composite + optical bloom + ONE `Look::tone` pass.
        label("mesh_tone")
        let tp = begin_pass(mut self.drawn.colour, keep: false)
        draw(
            tp,
            cover,
            hdr_tone_fs.bind(
                hdr: self.hdr_colour,
                depth: self.depth,
                froxel_acc: self.vol.acc,
                vol_s: self.vol.s,
                vol_active: if has_vol { 1 } else { 0 },
                bloom_tex: self.bloom.u0,
                bloom_s: self.bloom.s,
                bloom_strength: bloom_cfg.strength,
                v: v,
                look: look,
            ),
            vertices: 3,
        )
        tp.end()
        self.drawn.placed = false
        show(self.drawn.colour)
        for i in 0..nb {
            self.batches[i].maybe_queue_poll()
        }
    }

    /// Renders `world` (`Surface`s only) into `self.drawn` and presents it to the screen.
    pub fn draw<W: World + MeshWorld, S: Sky, L: Look>(
        mut self,
        world: W,
        sky: S,
        look: L,
        eye: Eye,
        width: u32,
        height: u32,
    ) {
        self.draw_scene(world, NoHeight {}, NoMedium {}, NoSwarm {}, sky, look, eye, width, height)
    }
}
