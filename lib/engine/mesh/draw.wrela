// Unified hardware rasterization of extracted surface meshlets (`extract`) and clipmap heightfields
// (`height`): dual-cascade rotated-PCF sun shadows, camera-focused world-space radiance cache +
// auto-extracted dynamic local emitters, 1× Halton-jittered G-buffer + analytical motion vectors,
// pixel-rate deferred direct lighting, phase-cycled half-res bilateral 4-cone GI + Screen-Space
// Specular Reflections (SSR) + micro-contact shadows, unified refractive pass (glass/water/crystal
// with SSR + Snell refraction + Beer-Lambert absorption over the field's own interior length),
// Temporal Super-Resolution (TSR), volumetric froxels, Dual Kawase HDR bloom, and ONE `Look::tone`
// pass.

use matter::height::{Height, NoHeight}
use matter::medium::{Medium, NoMedium}
use matter::sky::Sky
use matter::substance::{ONE_OVER_PI, Substance, env_brdf_approx, fresnel_schlick_rough}
use matter::swarm::{NoSwarm, Swarm}
use matter::world::{And, Many, One, World}
use mesh::extract::{
    ExtractScratch, MeshBatch, MeshVertex, eval_dqs, extract_scratch, mesh_batch, size_floor, steep,
    unpack_oct_normal, unpack_smooth, unpack_thing,
}
use mesh::height::{CLIP_RINGS, ClipmapMesh, MeshVary, clipmap_mesh, height_vs}
use mesh::light::{
    Emitter, NEAR, RadGrid, RadianceCache, SHADOW_SIDE, ShadowView, SkyCache, clip_of,
    cone_indirect, contact_shadow, decode_substance, encode_mat_signed, eval_emitters_tiled,
    radiance_cache, shadow_view, sky_background, sky_cache, sky_irradiance, sky_specular, spec_cone,
    sun_shadow_hybrid, sun_vis_point, trace_ssr,
}
use mesh::sdf::{
    SdfClipmap, SdfGrid, multi_bounce_ao, sdf_bent_ao, sdf_clipmap, sdf_curvature, sdf_grid,
    sdf_thickness,
}
use mesh::swarm::{SwarmSim, swarm_fs, swarm_shadow_vs, swarm_sim, swarm_vs}
use mesh::tsr::{TsrState, halton_jitter, project_uv_unjittered, tsr_state}
use mesh::volume::{BloomPyramid, FroxelVolume, bloom_pyramid, froxel_volume, hdr_tone_fs}
use picture::eye::{Eye, View, view}
use picture::look::Look
use picture::picture::{Picture, picture}
use picture::screen::{cover, luma, show}
use std::collections::Vec
use std::field::{DualQuat, Field, Rigid}
use std::gpu::{
    Address, ClipPosition, Compare, ComparisonSampler, Cull, Depth, DepthBias, DepthOnlyPass,
    DepthPass, DepthPass2, DepthPass4, DepthTexture, Filter, FragCoord, GpuBuffer, GpuSpan,
    InstanceIndex, R16Float, Rg16Float, Rgba8, Rgba16Float, Sampler, Targets2, Targets4, Texture,
    Texture3d, VertexIndex, begin_depth_pass, begin_pass, begin_pass2, begin_pass2_with_depth,
    begin_pass4, begin_pass4_with_depth, begin_pass_with_depth, buffer_of, comparison_sampler,
    copy_texture, depth_texture, discard, draw, label, sampler, texture,
}
use std::hash::{Hasher, StateHash}

/// Camera-focused clipmap / radiance focus distance (m).
const FOCUS_RAD: f32 = 9.5

/// Default maximum active surface bricks per batch.
const BATCH_BRICKS: u32 = 8192

/// Distance (m) beyond which a large `Many` (`N >= 16`) puts a thing in one of its two far
/// batches rather than its near one.
const FAR_TIER_DIST: f32 = 9.0

/// Lean vertex-to-fragment interpolator payload for 16-byte compact visibility meshlets (smaller
/// than `MeshVary`): carries ONLY geometry + motion + the extraction-space point `local_p` (which
/// moves with the thing, so per-pixel micro relief stays locked to it) + `(smooth, thing_id)` while
/// `field.channels(wp)` evaluates at infinite resolution at 1× pixel rate.
struct FieldVary: Copy {
    clip: ClipPosition,
    wp: vec3,
    prev_wp: vec3,
    local_p: vec3,
    normal: vec3,
    meta: vec2,
}

/// Interpolator payload for GPU Dual Quaternion Skinned meshlets: adds rest-pose local `rest_p`
/// so procedural materials (`rest_channels(rest_p)`) remain locked to the moving skin.
struct SkinVary: Copy {
    clip: ClipPosition,
    wp: vec3,
    prev_wp: vec3,
    rest_p: vec3,
    normal: vec3,
    meta: vec2,
}

/// Vertex shader for the unified shadow depth pass: projects 16-byte `MeshVertex` through its
/// instance's rigid transform `xforms[ii.index]` into orthographic sun space (5× less fetch BW).
@vertex
fn shadow_vs(
    verts: [MeshVertex],
    xforms: [Rigid],
    sv: ShadowView,
    vi: VertexIndex,
    ii: InstanceIndex,
) -> ClipPosition {
    let vert = verts[vi.index]
    let wp = xforms[ii.index].apply_point(vec3(vert.px, vert.py, vert.pz))
    ClipPosition { position: vec4(sv.project(wp), 1.0) }
}

/// Shadow depth vertex shader for `Skinned` meshlets: evaluates 4-bone Dual Quaternion Skinning
/// (Kavan et al. 2007/2008) on rest-pose vertices before applying the instance rigid transform.
@vertex
fn skin_shadow_vs(
    verts: [MeshVertex],
    skin: [u32],
    xforms: [Rigid],
    bones: [DualQuat],
    bone_stride: u32,
    sv: ShadowView,
    vi: VertexIndex,
    ii: InstanceIndex,
) -> ClipPosition {
    let vert = verts[vi.index]
    let dq = eval_dqs(bones, ii.index * bone_stride, skin[vi.index * 2], skin[vi.index * 2 + 1])
    let sp = dq.apply_point(vec3(vert.px, vert.py, vert.pz))
    let wp = xforms[ii.index].apply_point(sp)
    ClipPosition { position: vec4(sv.project(wp), 1.0) }
}

/// Depth-only fragment shader for the shadow pass (colour output is ignored by `DepthOnlyPass`).
@fragment
fn shadow_fs() -> vec4 {
    vec4(0.0)
}

/// Vertex shader for 16-byte compact meshlets: transforms `MeshVertex` by `xforms[ii.index]` and
/// `prev_xforms[ii.index]` for exact analytical motion vectors and unpacks octahedral normal +
/// thing index for pixel-rate analytical `channels(wp)` shading.
@vertex
fn mesh_vs(
    verts: [MeshVertex],
    xforms: [Rigid],
    prev_xforms: [Rigid],
    inst_ids: [u32],
    is_instanced: u32,
    v: View,
    vi: VertexIndex,
    ii: InstanceIndex,
) -> FieldVary {
    let vert = verts[vi.index]
    let xf = xforms[ii.index]
    let pxf = prev_xforms[ii.index]
    let lp = vec3(vert.px, vert.py, vert.pz)
    let wp = xf.apply_point(lp)
    let prev_wp = pxf.apply_point(lp)
    let n = xf.apply_normal(unpack_oct_normal(vert.packed))
    let smooth = if unpack_smooth(vert.packed) { 1.0 } else { 0.0 }
    let tid = if is_instanced != 0 { inst_ids[ii.index] } else { unpack_thing(vert.packed) }
    FieldVary {
        clip: clip_of(v, wp),
        wp,
        prev_wp,
        local_p: lp,
        normal: n,
        meta: vec2(smooth, f32(tid) + 0.5),
    }
}

/// Vertex shader for exact pre-deformed `One<Skinned>` meshlets (`deform_skinned_verts`): reads
/// exact posed local vertex + analytical normal from `verts`, previous-frame posed vertex from
/// `prev_verts` for exact TSR motion vectors, and rest-pose `rest_verts` for skin-locked materials
/// (zero DQS math in the vertex shader).
@vertex
fn deformed_mesh_vs(
    verts: [MeshVertex],
    prev_verts: [MeshVertex],
    rest_verts: [MeshVertex],
    xforms: [Rigid],
    prev_xforms: [Rigid],
    v: View,
    vi: VertexIndex,
    ii: InstanceIndex,
) -> SkinVary {
    let vert = verts[vi.index]
    let pvert = prev_verts[vi.index]
    let rvert = rest_verts[vi.index]
    let xf = xforms[ii.index]
    let pxf = prev_xforms[ii.index]
    let wp = xf.apply_point(vec3(vert.px, vert.py, vert.pz))
    let prev_wp = pxf.apply_point(vec3(pvert.px, pvert.py, pvert.pz))
    let n = xf.apply_normal(unpack_oct_normal(vert.packed))
    let smooth = if unpack_smooth(vert.packed) { 1.0 } else { 0.0 }
    let tid = unpack_thing(vert.packed)
    SkinVary {
        clip: clip_of(v, wp),
        wp,
        prev_wp,
        rest_p: vec3(rvert.px, rvert.py, rvert.pz),
        normal: n,
        meta: vec2(smooth, f32(tid) + 0.5),
    }
}

/// Eye/refract vertex shader for `Skinned` meshlets: evaluates Dual Quaternion Skinning for both
/// current (`bones`) and previous (`prev_bones`) frames for exact analytical TSR motion vectors.
@vertex
fn skin_mesh_vs(
    verts: [MeshVertex],
    skin: [u32],
    xforms: [Rigid],
    prev_xforms: [Rigid],
    bones: [DualQuat],
    prev_bones: [DualQuat],
    bone_stride: u32,
    inst_ids: [u32],
    is_instanced: u32,
    v: View,
    vi: VertexIndex,
    ii: InstanceIndex,
) -> SkinVary {
    let vert = verts[vi.index]
    let pb = skin[vi.index * 2]
    let pw = skin[vi.index * 2 + 1]
    let base = ii.index * bone_stride
    let dq = eval_dqs(bones, base, pb, pw)
    let pdq = eval_dqs(prev_bones, base, pb, pw)
    let xf = xforms[ii.index]
    let pxf = prev_xforms[ii.index]
    let lp = vec3(vert.px, vert.py, vert.pz)
    let wp = xf.apply_point(dq.apply_point(lp))
    let prev_wp = pxf.apply_point(pdq.apply_point(lp))
    let n = xf.apply_normal(dq.apply_normal(unpack_oct_normal(vert.packed)))
    let smooth = if unpack_smooth(vert.packed) { 1.0 } else { 0.0 }
    let tid = if is_instanced != 0 { inst_ids[ii.index] } else { unpack_thing(vert.packed) }
    SkinVary {
        clip: clip_of(v, wp),
        wp,
        prev_wp,
        rest_p: lp,
        normal: n,
        meta: vec2(smooth, f32(tid) + 0.5),
    }
}

/// Reconstructs the interpolated physical `Substance` from `MeshVary`.
fn vary_substance(vary: MeshVary) -> Substance {
    Substance {
        albedo: clamp(vary.albedo, vec3(0.0), vec3(1.0)),
        roughness: clamp(vary.pbr.x, 0.02, 1.0),
        emits: max(vary.emits, vec3(0.0)),
        metallic: clamp(vary.pbr.y, 0.0, 1.0),
        ior: max(vary.pbr.z, 1.0),
        transmission: clamp(vary.optics.x, 0.0, 1.0),
        subsurface: clamp(vary.optics.y, 0.0, 1.0),
        coat: clamp(vary.optics.z, 0.0, 1.0),
        micro: clamp(vary.optics.w, 0.0, 1.0),
        pad0: 0.0,
        pad1: 0.0,
        pad2: 0.0,
    }
}

/// Fast 3D hash-free trigonometric micro-relief field & analytic gradient (zero textures, zero UV
/// seams): perturbs surface normal, roughness, and subtle grain contrast ONLY when `sub.micro > 0.01`.
fn micro_field_grad(p: vec3) -> vec4 {
    // 3 rotated 3D wave octaves (cheap GPU SFU sin/cos, zero lattice artifacts) at fixed world
    // frequencies: the relief's scale is the engine's, its strength the substance's `micro`.
    let p1 = p * 5.2
    let p2 = vec3(p.x * 13.7 + p.z * 7.1, p.y * 15.3 - p.x * 6.4, p.z * 14.1 + p.y * 8.2)
    let p3 = vec3(p.x * 31.0 - p.y * 19.0, p.y * 29.0 + p.z * 17.0, p.z * 33.0 + p.x * 15.0)
    let v1 = sin(p1.x) * cos(p1.y) * sin(p1.z)
    let g1 = vec3(
        cos(p1.x) * cos(p1.y) * sin(p1.z) * 5.2,
        -sin(p1.x) * sin(p1.y) * sin(p1.z) * 5.2,
        sin(p1.x) * cos(p1.y) * cos(p1.z) * 5.2,
    )
    let v2 = sin(p2.x) * sin(p2.y) * cos(p2.z) * 0.45
    let g2 = vec3(
        (cos(p2.x) * sin(p2.y) * cos(p2.z) * 13.7 - sin(p2.x) * cos(p2.y) * cos(p2.z) * 6.4) * 0.45,
        (sin(p2.x) * cos(p2.y) * cos(p2.z) * 15.3 - sin(p2.x) * sin(p2.y) * sin(p2.z) * 8.2) * 0.45,
        (cos(p2.x) * sin(p2.y) * cos(p2.z) * 7.1 - sin(p2.x) * sin(p2.y) * sin(p2.z) * 14.1) * 0.45,
    )
    let v3 = sin(p3.x) * cos(p3.y) * sin(p3.z) * 0.18
    let g3 = vec3(
        (cos(p3.x) * cos(p3.y) * sin(p3.z) * 31.0 + sin(p3.x) * cos(p3.y) * cos(p3.z) * 15.0) *
            0.18,
        (-cos(p3.x) * cos(p3.y) * sin(p3.z) * 19.0 - sin(p3.x) * sin(p3.y) * sin(p3.z) * 29.0) *
            0.18,
        (-sin(p3.x) * sin(p3.y) * sin(p3.z) * 17.0 + sin(p3.x) * cos(p3.y) * cos(p3.z) * 33.0) *
            0.18,
    )
    vec4(g1 + g2 + g3, v1 + v2 + v3)
}

/// Applies per-pixel 3D field-space microsurface relief (normal bump + roughness/albedo micro-grain)
/// with automatic distance attenuation so distant surfaces never alias. The relief is evaluated at
/// the material point `mp` (the thing's extraction-space or rest-pose point, which moves with it, so
/// the grain never swims over a moving or skinned surface); its analytic gradient is carried to the
/// world surface at `wp` through the pixel's screen derivatives of both points (Mikkelsen 2010
/// surface-gradient bump mapping), exact for any rigid or skinned map from `mp` to `wp`.
fn apply_micro_relief(wp: vec3, mp: vec3, n: vec3, sub: Substance, dist: f32) -> (vec3, Substance) {
    // Derivatives first, while every pixel of the quad still runs this code.
    let dwx = dpdx(wp)
    let dwy = dpdy(wp)
    let dmx = dpdx(mp)
    let dmy = dpdy(mp)
    if sub.micro <= 0.01 {
        return (n, sub)
    }
    let fade = clamp(1.0 - (dist - 4.0) / 28.0, 0.0, 1.0)
    if fade <= 0.01 {
        return (n, sub)
    }
    let mg = micro_field_grad(mp)
    let amp = sub.micro * fade
    // World tangent-plane gradient of the relief height `h(mp(wp))`: the analytic gradient's change
    // along each screen axis (`dot(g, dm)`) spread over the world tangent frame (`r1`, `r2`), so the
    // normal tilts physically without flipping. A clearcoat film (`coat > 0.2`) fills the
    // micro-pores beneath it, so its normal tilts about half as far and its reflections stay crisp.
    let r1 = cross(dwy, n)
    let r2 = cross(n, dwx)
    let det = dot(dwx, r1)
    let g_tan = if abs(det) > 1.0e-20 {
        (r1 * dot(mg.xyz, dmx) + r2 * dot(mg.xyz, dmy)) * (1.0 / det)
    } else {
        mg.xyz - n * dot(mg.xyz, n)
    }
    let bump_s = if sub.coat > 0.2 { 0.024 } else { 0.045 }
    let n_bumped = normalize(n - g_tan * (amp * bump_s))
    let grain = clamp(mg.w, -1.0, 1.0)
    let albedo_mod = clamp(sub.albedo * (1.0 + grain * amp * 0.14), vec3(0.01), vec3(1.0))
    let rough_mod = clamp(sub.roughness + grain * amp * 0.12, 0.03, 1.0)
    // A coat's thickness follows the micro-grain, so any coated substance's (`coat > 0.1`)
    // clearcoat varies across its surface with the same relief.
    let coat_mod = if sub.coat > 0.1 { clamp(sub.coat + grain * amp * 0.25, 0.0, 1.0) } else {
        sub.coat
    }
    (n_bumped, Substance {
        albedo: albedo_mod,
        roughness: rough_mod,
        coat: coat_mod,
        ..sub,
    })
}

/// Resolves crease-preserving shading normal from interpolated analytic normal and face derivatives.
fn resolve_normal_from(wp: vec3, normal: vec3, smooth: f32, ray_back: vec3) -> vec3 {
    let nv_l2 = dot(normal, normal)
    let nv = if nv_l2 > 1.0e-12 { normal * (1.0 / sqrt(nv_l2)) } else { ray_back }
    let fraw = cross(dpdx(wp), dpdy(wp))
    let fl2 = dot(fraw, fraw)
    var nf = nv
    if fl2 > 1.0e-18 {
        nf = fraw * (1.0 / sqrt(fl2))
        if dot(nf, ray_back) < 0.0 {
            nf = -nf
        }
    }
    if smooth < 0.5 || dot(nv, nf) < 0.85 { nf } else { nv }
}

/// Exact screen-space motion `prev_uv - curr_uv` of a surface point now at `wp` and last frame at
/// `prev_wp`, both projected without jitter (what `tsr` reprojects by).
fn motion_of(wp: vec3, prev_wp: vec3, v: View, prev_v: View) -> vec2 {
    project_uv_unjittered(prev_v, prev_wp) - project_uv_unjittered(v, wp)
}

/// Shared 1× G-buffer + analytical motion-vector writer used by compact meshlets and heightfields.
fn shade_gbuf_core(
    wp: vec3,
    prev_wp: vec3,
    mp: vec3,
    normal: vec3,
    smooth: f32,
    sub0: Substance,
    v: View,
    prev_v: View,
) -> Targets4<vec4, vec4, vec4, vec2> {
    let to_eye = v.at - wp
    let dist = length(to_eye)
    let ray_back = if dist > 1.0e-6 { to_eye / dist } else { -v.forward }
    let n0 = resolve_normal_from(wp, normal, smooth, ray_back)
    let (n, sub) = apply_micro_relief(wp, mp, n0, sub0, dist)
    let motion = motion_of(wp, prev_wp, v, prev_v)
    Targets4 {
        first: vec4(n * 0.5 + vec3(0.5), 1.0),
        second: vec4(clamp(sub.albedo, vec3(0.0), vec3(1.0)), clamp(sub.roughness, 0.02, 1.0)),
        third: vec4(max(sub.emits, vec3(0.0)), encode_mat_signed(sub)),
        fourth: motion,
    }
}

/// Pixel-rate analytical G-buffer fragment shader for `One<M>` compact meshlets: evaluates
/// `field.channels(wp)` once per visible 1× screen pixel for infinite-resolution procedural detail.
@fragment
@budget(work: 8000)
fn field_gbuf_one_fs<M: Field<Substance>>(
    vary: FieldVary,
    field: M,
    v: View,
    prev_v: View,
) -> Targets4<vec4, vec4, vec4, vec2> {
    let sub0 = field.channels(vary.wp)
    shade_gbuf_core(vary.wp, vary.prev_wp, vary.local_p, vary.normal, vary.meta.x, sub0, v, prev_v)
}

/// Pixel-rate analytical G-buffer fragment shader for `Many<M, N>` compact meshlets.
@fragment
@budget(work: 8000)
fn field_gbuf_many_fs<M: Field<Substance>>(
    vary: FieldVary,
    fields: [M],
    n_fields: u32,
    v: View,
    prev_v: View,
) -> Targets4<vec4, vec4, vec4, vec2> {
    let tid = min(u32(max(vary.meta.y, 0.0)), n_fields - 1)
    let sub0 = fields[tid].channels(vary.wp)
    shade_gbuf_core(vary.wp, vary.prev_wp, vary.local_p, vary.normal, vary.meta.x, sub0, v, prev_v)
}

/// Skin-locked pixel-rate G-buffer fragment shader for `Skinned` `One<M>` meshlets.
@fragment
@budget(work: 8000)
fn field_skin_gbuf_one_fs<M: Field<Substance>>(
    vary: SkinVary,
    field: M,
    v: View,
    prev_v: View,
) -> Targets4<vec4, vec4, vec4, vec2> {
    let sub0 = field.rest_channels(vary.rest_p)
    shade_gbuf_core(vary.wp, vary.prev_wp, vary.rest_p, vary.normal, vary.meta.x, sub0, v, prev_v)
}

/// Skin-locked pixel-rate G-buffer fragment shader for `Skinned` `Many<M, N>` meshlets.
@fragment
@budget(work: 8000)
fn field_skin_gbuf_many_fs<M: Field<Substance>>(
    vary: SkinVary,
    fields: [M],
    n_fields: u32,
    v: View,
    prev_v: View,
) -> Targets4<vec4, vec4, vec4, vec2> {
    let tid = min(u32(max(vary.meta.y, 0.0)), n_fields - 1)
    let sub0 = fields[tid].rest_channels(vary.rest_p)
    shade_gbuf_core(vary.wp, vary.prev_wp, vary.rest_p, vary.normal, vary.meta.x, sub0, v, prev_v)
}

// The opaque side of a quad routed to the transmissive list. A quad with any transmissive vertex
// is drawn only by the transmissive pass, which discards its pixels whose own channels are opaque;
// these `_cut_` shaders draw the same quads into the G-buffer and keep exactly those pixels, so a
// boundary between a glass part and an opaque part of one field is covered by one pass or the other
// at every pixel. They are separate entry points so the plain opaque draws keep their early depth.

/// The opaque pixels of `One<M>`'s transmissive quads into the G-buffer.
@fragment
@budget(work: 8000)
fn field_cut_gbuf_one_fs<M: Field<Substance>>(
    vary: FieldVary,
    field: M,
    v: View,
    prev_v: View,
) -> Targets4<vec4, vec4, vec4, vec2> {
    let sub0 = field.channels(vary.wp)
    if sub0.transmission > 0.02 {
        discard()
    }
    shade_gbuf_core(vary.wp, vary.prev_wp, vary.local_p, vary.normal, vary.meta.x, sub0, v, prev_v)
}

/// The opaque pixels of `Many<M, N>`'s transmissive quads into the G-buffer.
@fragment
@budget(work: 8000)
fn field_cut_gbuf_many_fs<M: Field<Substance>>(
    vary: FieldVary,
    fields: [M],
    n_fields: u32,
    v: View,
    prev_v: View,
) -> Targets4<vec4, vec4, vec4, vec2> {
    let tid = min(u32(max(vary.meta.y, 0.0)), n_fields - 1)
    let sub0 = fields[tid].channels(vary.wp)
    if sub0.transmission > 0.02 {
        discard()
    }
    shade_gbuf_core(vary.wp, vary.prev_wp, vary.local_p, vary.normal, vary.meta.x, sub0, v, prev_v)
}

/// The opaque pixels of a `Skinned` `One<M>`'s transmissive quads into the G-buffer.
@fragment
@budget(work: 8000)
fn field_skin_cut_gbuf_one_fs<M: Field<Substance>>(
    vary: SkinVary,
    field: M,
    v: View,
    prev_v: View,
) -> Targets4<vec4, vec4, vec4, vec2> {
    let sub0 = field.rest_channels(vary.rest_p)
    if sub0.transmission > 0.02 {
        discard()
    }
    shade_gbuf_core(vary.wp, vary.prev_wp, vary.rest_p, vary.normal, vary.meta.x, sub0, v, prev_v)
}

/// The opaque pixels of a `Skinned` `Many<M, N>`'s transmissive quads into the G-buffer.
@fragment
@budget(work: 8000)
fn field_skin_cut_gbuf_many_fs<M: Field<Substance>>(
    vary: SkinVary,
    fields: [M],
    n_fields: u32,
    v: View,
    prev_v: View,
) -> Targets4<vec4, vec4, vec4, vec2> {
    let tid = min(u32(max(vary.meta.y, 0.0)), n_fields - 1)
    let sub0 = fields[tid].rest_channels(vary.rest_p)
    if sub0.transmission > 0.02 {
        discard()
    }
    shade_gbuf_core(vary.wp, vary.prev_wp, vary.rest_p, vary.normal, vary.meta.x, sub0, v, prev_v)
}

/// Lean 1× G-buffer + motion-vector fragment shader for opaque terrain heightfields (`height_vs`).
@fragment
fn mesh_gbuf_fs(vary: MeshVary, v: View, prev_v: View) -> Targets4<vec4, vec4, vec4, vec2> {
    shade_gbuf_core(
        vary.wp,
        vary.prev_wp,
        vary.wp,
        vary.normal,
        vary.pbr.w,
        vary_substance(vary),
        v,
        prev_v,
    )
}

/// Reconstructs exact world hit distance along `ray` from 1× reversed-Z depth `ndc_z`.
fn reconstruct_pixel_dist(v: View, ray: vec3, ndc_z: f32) -> f32 {
    (NEAR / ndc_z) / max(dot(ray, v.forward), 0.05)
}

/// Unpacks a unit normal from `Rgba8` `g_normal = (n * 0.5 + 0.5, 1.0)`.
fn decode_gbuf_normal(gn: vec4, fallback: vec3) -> vec3 {
    let nr = gn.xyz * 2.0 - vec3(1.0)
    let nl2 = dot(nr, nr)
    if nl2 > 1.0e-10 { nr * (1.0 / sqrt(nl2)) } else { fallback }
}

/// Shared pixel-rate direct lighting core used identically by both `draw_scene` (`deferred_direct_fs`)
/// and `drawn_only` (`deferred_direct_judge_fs`): evaluates exact SDF variable-width soft shadows +
/// analytical curvature weathering + thickness-modulated backlit SSS + tiled SDF-shadowed local
/// emitters ONCE per screen pixel (zero micro-triangle quad overshading). Returns the direct HDR
/// `(light, dist)`, the judges' `(n, dist)` place, the sun visibility, and the sun's share of the
/// direct light (`0..1` by luma), so the half-res micro-contact shadow (cast toward the sun) darkens
/// only the sun's part and never emission or local emitters.
@budget(work: 48000)
fn shade_direct_pixel<S: Sky>(
    px: u32,
    py: u32,
    pixel_xy: vec2,
    v: View,
    sv: ShadowView,
    rad_grid: RadGrid,
    sdf_grid: SdfGrid,
    sky: S,
    g_normal: Texture<Rgba8>,
    g_albedo: Texture<Rgba8>,
    g_emits: Texture<Rgba16Float>,
    depth: DepthTexture,
    sky_spec0: Texture<Rgba16Float>,
    sky_s: Sampler,
    shadow_map: DepthTexture,
    cmp: ComparisonSampler,
    rad0: Texture3d<Rgba16Float>,
    rad1: Texture3d<Rgba16Float>,
    rad_s: Sampler,
    sdf0: Texture3d<R16Float>,
    sdf1: Texture3d<R16Float>,
    sdf_s: Sampler,
    emitters: [Emitter],
    tile_masks: [u32],
    tiles_x: u32,
    full_w: u32,
    full_h: u32,
) -> (vec4, vec4, f32, f32) {
    let gn = g_normal.load(px, py)
    let ray = v.ray(pixel_xy)
    if gn.w <= 0.5 {
        return (vec4(sky_background(sky, sky_spec0, sky_s, ray), 65000.0), vec4(0.0), 1.0, 0.0)
    }
    let ndc_z = depth.load(px, py)
    if ndc_z <= 1.0e-6 {
        return (vec4(sky_background(sky, sky_spec0, sky_s, ray), 65000.0), vec4(0.0), 1.0, 0.0)
    }
    let n = decode_gbuf_normal(gn, -ray)
    let ga = g_albedo.load(px, py)
    let ge = g_emits.load(px, py)
    let mat_code = ge.w
    var sub = decode_substance(ga.xyz, ga.w, ge.xyz, mat_code)

    let dist = reconstruct_pixel_dist(v, ray, ndc_z)
    let wp = v.at + ray * dist
    let ray_back = -ray

    // Universal world-space analytical curvature weathering (`∇²d` from 3D SDF clipmap):
    // convex bevels/edges subtly polish & catch light; concave crevices darken & roughen.
    if sdf_grid.enabled != 0 &&
        abs(mat_code) >= 0.01 &&
        max(sub.emits.x, max(sub.emits.y, sub.emits.z)) < 0.25 {
        let curv = sdf_curvature(sdf_grid, sdf0, sdf1, sdf_s, wp)
        let convex = clamp(curv, 0.0, 1.0)
        let concave = clamp(-curv, 0.0, 1.0)
        let wear_a = 1.0 + convex * 0.14 - concave * 0.26
        let wear_r = clamp(sub.roughness - convex * 0.06 + concave * 0.10, 0.03, 1.0)
        sub = Substance {
            albedo: clamp(sub.albedo * wear_a, vec3(0.005), vec3(1.0)),
            roughness: wear_r,
            ..sub,
        }
    }

    let sun = sky.sun()
    let ndl = max(dot(n, sun.way), 0.0)
    let vis = if ndl > 0.0 {
        sun_shadow_hybrid(shadow_map, cmp, sv, sdf_grid, sdf0, sdf1, sdf_s, wp, n, pixel_xy)
    } else {
        0.0
    }
    var direct_sun = sub.shade_direct(n, sun.way, ray_back, sun.light * vis)
    // Exact interior thickness backlit Subsurface Scattering (SSS) via 2-tap 3D SDF thickness.
    if sub.subsurface > 0.01 && sdf_grid.enabled != 0 {
        let thick = sdf_thickness(sdf_grid, sdf0, sdf1, sdf_s, wp, n, sun.way)
        let trans = exp(-thick * 3.8)
        let back = pow(clamp(dot(ray_back, normalize(-sun.way + n * 0.35)), 0.0, 1.0), 3.0)
        let sss_tint = sub.albedo * sqrt(max(sub.albedo, vec3(0.02)))
        direct_sun += sss_tint *
            sun.light *
            (sub.subsurface * trans * (0.25 + 0.75 * back) * ONE_OVER_PI)
    }
    let local_light = eval_emitters_tiled(
        sub,
        wp,
        n,
        ray_back,
        rad_grid,
        rad0,
        rad1,
        rad_s,
        sdf_grid,
        sdf0,
        sdf1,
        sdf_s,
        emitters,
        tile_masks,
        tiles_x,
        px,
        py,
    )
    let direct = sub.emits + direct_sun + local_light
    let sun_share = clamp(
        luma(max(direct_sun, vec3(0.0))) / max(luma(max(direct, vec3(0.0))), 1.0e-6),
        0.0,
        1.0,
    )
    (vec4(direct, min(dist, 65000.0)), vec4(n, dist), vis, sun_share)
}

/// Full-resolution 1× pixel-rate deferred direct lighting pass (`draw_scene`).
@fragment
@budget(work: 50000)
fn deferred_direct_fs<S: Sky>(
    pixel: FragCoord,
    v: View,
    sv: ShadowView,
    rad_grid: RadGrid,
    sdf_grid: SdfGrid,
    sky: S,
    g_normal: Texture<Rgba8>,
    g_albedo: Texture<Rgba8>,
    g_emits: Texture<Rgba16Float>,
    depth: DepthTexture,
    sky_spec0: Texture<Rgba16Float>,
    sky_s: Sampler,
    shadow_map: DepthTexture,
    cmp: ComparisonSampler,
    rad0: Texture3d<Rgba16Float>,
    rad1: Texture3d<Rgba16Float>,
    rad_s: Sampler,
    sdf0: Texture3d<R16Float>,
    sdf1: Texture3d<R16Float>,
    sdf_s: Sampler,
    emitters: [Emitter],
    tile_masks: [u32],
    tiles_x: u32,
    full_w: u32,
    full_h: u32,
) -> Targets2<vec4, f32> {
    let px = min(u32(pixel.position.x), full_w - 1)
    let py = min(u32(pixel.position.y), full_h - 1)
    let (hdr_d, _place, _vis, sun_share) = shade_direct_pixel(
        px,
        py,
        pixel.position.xy,
        v,
        sv,
        rad_grid,
        sdf_grid,
        sky,
        g_normal,
        g_albedo,
        g_emits,
        depth,
        sky_spec0,
        sky_s,
        shadow_map,
        cmp,
        rad0,
        rad1,
        rad_s,
        sdf0,
        sdf1,
        sdf_s,
        emitters,
        tile_masks,
        tiles_x,
        full_w,
        full_h,
    )
    Targets2 { first: hdr_d, second: sun_share }
}

/// Identical pixel-rate deferred direct pass with `(place, sun)` diagnostic outputs for `drawn_only`
/// so the judges and hole audit verify the exact same renderer that draws the game.
@fragment
@budget(work: 50000)
fn deferred_direct_judge_fs<S: Sky>(
    pixel: FragCoord,
    v: View,
    sv: ShadowView,
    rad_grid: RadGrid,
    sdf_grid: SdfGrid,
    sky: S,
    g_normal: Texture<Rgba8>,
    g_albedo: Texture<Rgba8>,
    g_emits: Texture<Rgba16Float>,
    depth: DepthTexture,
    sky_spec0: Texture<Rgba16Float>,
    sky_s: Sampler,
    shadow_map: DepthTexture,
    cmp: ComparisonSampler,
    rad0: Texture3d<Rgba16Float>,
    rad1: Texture3d<Rgba16Float>,
    rad_s: Sampler,
    sdf0: Texture3d<R16Float>,
    sdf1: Texture3d<R16Float>,
    sdf_s: Sampler,
    emitters: [Emitter],
    tile_masks: [u32],
    tiles_x: u32,
    full_w: u32,
    full_h: u32,
) -> Targets4<vec4, vec4, f32, f32> {
    let px = min(u32(pixel.position.x), full_w - 1)
    let py = min(u32(pixel.position.y), full_h - 1)
    let (hdr_d, place, vis, sun_share) = shade_direct_pixel(
        px,
        py,
        pixel.position.xy,
        v,
        sv,
        rad_grid,
        sdf_grid,
        sky,
        g_normal,
        g_albedo,
        g_emits,
        depth,
        sky_spec0,
        sky_s,
        shadow_map,
        cmp,
        rad0,
        rad1,
        rad_s,
        sdf0,
        sdf1,
        sdf_s,
        emitters,
        tile_masks,
        tiles_x,
        full_w,
        full_h,
    )
    Targets4 { first: hdr_d, second: place, third: vis, fourth: sun_share }
}

/// Half-resolution (`W/2 × H/2`) indirect lighting pass: computes 4-cone hemisphere diffuse GI +
/// multi-scale 3D SDF bent-normal AO (`first = vec4(bounce + bent_sky_shift, ao)`), Screen-Space
/// Specular Reflections (SSR) seamlessly falling back to SDF-accelerated `spec_cone` + `sky_specular`
/// PMREM (`second.rgb`), and screen-space micro-contact shadow visibility (`second.w`).
@fragment
@budget(work: 12000)
fn indirect_half_fs<S: Sky>(
    pixel: FragCoord,
    v: View,
    rad_grid: RadGrid,
    sdf_grid: SdfGrid,
    sky: S,
    hdr_direct: Texture<Rgba16Float>,
    g_normal: Texture<Rgba8>,
    g_albedo: Texture<Rgba8>,
    g_emits: Texture<Rgba16Float>,
    depth: DepthTexture,
    bg_s: Sampler,
    sky_diff: Texture<Rgba16Float>,
    sky_spec0: Texture<Rgba16Float>,
    sky_spec1: Texture<Rgba16Float>,
    sky_spec2: Texture<Rgba16Float>,
    sky_s: Sampler,
    rad0: Texture3d<Rgba16Float>,
    rad1: Texture3d<Rgba16Float>,
    rad2: Texture3d<Rgba16Float>,
    rad_s: Sampler,
    sdf0: Texture3d<R16Float>,
    sdf1: Texture3d<R16Float>,
    sdf_s: Sampler,
    full_w: u32,
    full_h: u32,
    phase_x: u32,
    phase_y: u32,
) -> Targets2<vec4, vec4> {
    let fx = min(u32(pixel.position.x) * 2 + phase_x, full_w - 1)
    let fy = min(u32(pixel.position.y) * 2 + phase_y, full_h - 1)
    let gn = g_normal.load(fx, fy)
    if gn.w <= 0.5 {
        return Targets2 {
            first: vec4(0.0, 0.0, 0.0, 1.0),
            second: vec4(0.0, 0.0, 0.0, 1.0),
        }
    }
    let ndc_z = depth.load(fx, fy)
    if ndc_z <= 1.0e-6 {
        return Targets2 {
            first: vec4(0.0, 0.0, 0.0, 1.0),
            second: vec4(0.0, 0.0, 0.0, 1.0),
        }
    }
    let ray = v.ray(vec2(f32(fx) + 0.5, f32(fy) + 0.5))
    let n = decode_gbuf_normal(gn, -ray)
    let dist = reconstruct_pixel_dist(v, ray, ndc_z)
    let wp = v.at + ray * dist
    let roughness = clamp(g_albedo.load(fx, fy).w, 0.02, 1.0)
    let mat_code = g_emits.load(fx, fy).w

    let ind0 = cone_indirect(rad_grid, rad0, rad1, rad2, rad_s, wp, n)
    var ind = ind0
    if sdf_grid.enabled != 0 {
        let bao = sdf_bent_ao(sdf_grid, sdf0, sdf1, sdf_s, wp, n)
        let ao = clamp(min(ind0.w, bao.w), 0.08, 1.0)
        // Bent-normal sky tint shift steers crevice ambient toward the unoccluded sky opening
        // while keeping full-res normal detail in `combine_indirect_fs`.
        let sky_bent = sky_irradiance(sky_diff, sky_s, bao.xyz)
        let sky_n = sky_irradiance(sky_diff, sky_s, n)
        let bent_shift = (sky_bent - sky_n) * (ao * 0.75)
        ind = vec4(max(ind0.xyz + bent_shift, vec3(0.0)), ao)
    }
    let cshad = if rad_grid.enabled != 0 { contact_shadow(v, depth, wp, n, sky.sun().way) } else {
        1.0
    }

    // Skip specular SSR & voxel/SDF reflection cone completely on pure matte surfaces (`abs(mat_code) < 0.01`).
    var env_spec = vec3(0.0)
    if abs(mat_code) >= 0.01 {
        let ray_back = -ray
        let refl = normalize(n * (2.0 * dot(n, ray_back)) - ray_back)
        let eff_r = if mat_code > 0.15 && mat_code < 1.8 { min(roughness, 0.12) } else { roughness }
        let sky_refl = sky_specular(sky_spec0, sky_spec1, sky_spec2, sky_diff, sky_s, refl, eff_r)
        let w_refl = spec_cone(
            rad_grid,
            rad0,
            rad1,
            rad2,
            rad_s,
            sdf_grid,
            sdf0,
            sdf1,
            sdf_s,
            wp,
            n,
            refl,
            eff_r,
        )
        let spec_occ = clamp(ind.w + (1.0 - eff_r) * 0.25, 0.15, 1.0)
        let fallback = w_refl.xyz + sky_refl * (1.0 - w_refl.w * 0.85) * spec_occ
        let ssr = trace_ssr(v, hdr_direct, bg_s, wp, n, refl, eff_r)
        env_spec = mix(fallback, ssr.xyz, vec3(ssr.w))
    }

    Targets2 {
        first: ind,
        second: vec4(env_spec, cshad),
    }
}

/// Full-resolution depth+normal bilateral upsample of phase-cycled half-res GI, bent-normal AO,
/// SSR, and micro-contact shadows combined with the pixel-rate direct HDR buffer into `hdr_colour`.
/// The contact shadow darkens only the sun's share of the direct light (`sun_share`).
@fragment
fn combine_indirect_fs<S: Sky>(
    pixel: FragCoord,
    v: View,
    sky: S,
    hdr_direct: Texture<Rgba16Float>,
    sun_share: Texture<R16Float>,
    g_normal: Texture<Rgba8>,
    g_albedo: Texture<Rgba8>,
    g_emits: Texture<Rgba16Float>,
    gi_diff: Texture<Rgba16Float>,
    gi_spec: Texture<Rgba16Float>,
    sky_diff: Texture<Rgba16Float>,
    sky_s: Sampler,
    full_w: u32,
    full_h: u32,
    phase_x: u32,
    phase_y: u32,
) -> vec4 {
    let px = min(u32(pixel.position.x), full_w - 1)
    let py = min(u32(pixel.position.y), full_h - 1)
    let direct_d = hdr_direct.load(px, py)
    let gn = g_normal.load(px, py)
    if gn.w <= 0.5 {
        return direct_d
    }
    let ga = g_albedo.load(px, py)
    let ge = g_emits.load(px, py)
    let ray = v.ray(pixel.position.xy)
    let n = decode_gbuf_normal(gn, -ray)
    let dist = direct_d.w
    let albedo = clamp(ga.xyz, vec3(0.0), vec3(1.0))
    let roughness = clamp(ga.w, 0.02, 1.0)
    let mat_code = ge.w

    // 4-tap depth + normal weighted bilateral upsample from phase-cycled half-res GI/SSR buffers.
    // Half-res texel `h` was shaded at full-res `2 h + phase`, so the two texels bracketing `px` are
    // `floor((px - phase) / 2)` and the next, weighted bilinearly by where `px` falls between them.
    let hw = max(full_w / 2, 1)
    let hh = max(full_h / 2, 1)
    let hx0 = u32(clamp((i32(px) - i32(phase_x) + 2) / 2 - 1, 0, i32(hw) - 1))
    let hy0 = u32(clamp((i32(py) - i32(phase_y) + 2) / 2 - 1, 0, i32(hh) - 1))
    let hx1 = min(hx0 + 1, hw - 1)
    let hy1 = min(hy0 + 1, hh - 1)
    let tx = clamp((f32(px) - f32(hx0 * 2 + phase_x)) * 0.5, 0.0, 1.0)
    let ty = clamp((f32(py) - f32(hy0 * 2 + phase_y)) * 0.5, 0.0, 1.0)

    let xs = [hx0, hx1, hx0, hx1]
    let ys = [hy0, hy0, hy1, hy1]
    let bw = [(1.0 - tx) * (1.0 - ty), tx * (1.0 - ty), (1.0 - tx) * ty, tx * ty]
    var diff_acc = vec4(0.0)
    var spec_acc = vec4(0.0)
    var w_sum = 0.0
    for k in 0..4 {
        let sx = xs[k]
        let sy = ys[k]
        let fx = min(sx * 2 + phase_x, full_w - 1)
        let fy = min(sy * 2 + phase_y, full_h - 1)
        let sn = g_normal.load(fx, fy)
        let sd = hdr_direct.load(fx, fy).w
        if sn.w > 0.5 {
            let sn_v = decode_gbuf_normal(sn, n)
            let ndot = max(dot(n, sn_v), 0.0)
            let dz = abs(dist - sd) / max(dist * 0.08, 0.15)
            let w = (bw[k] + 0.02) * (ndot * ndot * ndot * ndot + 0.001) * exp(-dz * dz)
            diff_acc += gi_diff.load(sx, sy) * w
            spec_acc += gi_spec.load(sx, sy) * w
            w_sum += w
        }
    }
    let ind = if w_sum > 1.0e-4 { diff_acc / w_sum } else { gi_diff.load(hx0, hy0) }
    let spec_c = if w_sum > 1.0e-4 { spec_acc / w_sum } else { gi_spec.load(hx0, hy0) }

    let cshad = if dot(n, sky.sun().way) > 0.05 { spec_c.w } else { 1.0 }
    var rad = direct_d.xyz * (1.0 - sun_share.load(px, py) * (1.0 - cshad))

    let sky_amb = sky_irradiance(sky_diff, sky_s, n) * multi_bounce_ao(ind.w, albedo) + ind.xyz
    if abs(mat_code) < 0.01 {
        rad += albedo * ONE_OVER_PI * sky_amb
    } else {
        let ray_back = -ray
        let ndv = max(dot(n, ray_back), 0.001)
        let metallic = if mat_code < -0.01 { clamp(-mat_code, 0.0, 1.0) } else { 0.0 }
        let coat = if mat_code > 0.03 && mat_code < 1.8 { clamp(mat_code - 0.02, 0.0, 1.0) } else {
            0.0
        }
        let f0 = mix(vec3(0.04), albedo, metallic)
        let f_env = fresnel_schlick_rough(f0, ndv, roughness)
        let kd = (vec3(1.0) - f_env) * (1.0 - metallic)
        let brdf_ab = env_brdf_approx(roughness, ndv)
        var indirect = albedo * (kd * ONE_OVER_PI) * sky_amb +
            spec_c.xyz * (f0 * brdf_ab.x + vec3(brdf_ab.y))
        if coat > 1.0e-4 {
            let fc = fresnel_schlick_rough(vec3(0.04), ndv, 0.06).x * coat
            indirect = indirect * (1.0 - fc) + spec_c.xyz * fc
        }
        rad += indirect
    }
    vec4(rad, dist)
}

/// Shared half-resolution transmissive SSR + SDF `spec_cone` + Sky PMREM reflection core.
@budget(work: 16000)
fn shade_refract_refl_core(
    pixel: FragCoord,
    wp: vec3,
    mp: vec3,
    normal: vec3,
    smooth: f32,
    sub0: Substance,
    v: View,
    rad_grid: RadGrid,
    sdf_grid: SdfGrid,
    sky_diff: Texture<Rgba16Float>,
    sky_spec0: Texture<Rgba16Float>,
    sky_spec1: Texture<Rgba16Float>,
    sky_spec2: Texture<Rgba16Float>,
    sky_s: Sampler,
    rad0: Texture3d<Rgba16Float>,
    rad1: Texture3d<Rgba16Float>,
    rad2: Texture3d<Rgba16Float>,
    rad_s: Sampler,
    sdf0: Texture3d<R16Float>,
    sdf1: Texture3d<R16Float>,
    sdf_s: Sampler,
    hdr_bg: Texture<Rgba16Float>,
    bg_s: Sampler,
    half_size: vec2,
) -> vec4 {
    if sub0.transmission <= 0.02 {
        discard()
    }
    let to_eye = v.at - wp
    let dist = length(to_eye)
    let uv = pixel.position.xy / max(half_size, vec2(1.0))
    let bg_d = hdr_bg.sample_level(bg_s, uv, 0.0).w
    if dist > bg_d + 0.25 {
        discard()
    }
    let ray_back = if dist > 1.0e-6 { to_eye / dist } else { -v.forward }
    let n0 = resolve_normal_from(wp, normal, smooth, ray_back)
    let (n, sub) = apply_micro_relief(wp, mp, n0, sub0, dist)
    let ndv = max(dot(n, ray_back), 0.001)
    let refl = normalize(n * (2.0 * ndv) - ray_back)

    let sky_refl = sky_specular(
        sky_spec0,
        sky_spec1,
        sky_spec2,
        sky_diff,
        sky_s,
        refl,
        sub.roughness,
    )
    let w_refl = spec_cone(
        rad_grid,
        rad0,
        rad1,
        rad2,
        rad_s,
        sdf_grid,
        sdf0,
        sdf1,
        sdf_s,
        wp,
        n,
        refl,
        sub.roughness,
    )
    let fallback = w_refl.xyz + sky_refl * (1.0 - w_refl.w * 0.85)
    let ssr = trace_ssr(v, hdr_bg, bg_s, wp, n, refl, sub.roughness)
    let env_spec = mix(fallback, ssr.xyz, vec3(ssr.w))
    vec4(env_spec, 1.0)
}

/// Half-res transmissive reflection pre-pass for `One<M>` compact meshlets.
@fragment
@budget(work: 20000)
fn field_refract_refl_one_fs<M: Field<Substance>>(
    pixel: FragCoord,
    vary: FieldVary,
    field: M,
    v: View,
    rad_grid: RadGrid,
    sdf_grid: SdfGrid,
    sky_diff: Texture<Rgba16Float>,
    sky_spec0: Texture<Rgba16Float>,
    sky_spec1: Texture<Rgba16Float>,
    sky_spec2: Texture<Rgba16Float>,
    sky_s: Sampler,
    rad0: Texture3d<Rgba16Float>,
    rad1: Texture3d<Rgba16Float>,
    rad2: Texture3d<Rgba16Float>,
    rad_s: Sampler,
    sdf0: Texture3d<R16Float>,
    sdf1: Texture3d<R16Float>,
    sdf_s: Sampler,
    hdr_bg: Texture<Rgba16Float>,
    bg_s: Sampler,
    half_size: vec2,
) -> vec4 {
    let sub0 = field.channels(vary.wp)
    shade_refract_refl_core(
        pixel,
        vary.wp,
        vary.local_p,
        vary.normal,
        vary.meta.x,
        sub0,
        v,
        rad_grid,
        sdf_grid,
        sky_diff,
        sky_spec0,
        sky_spec1,
        sky_spec2,
        sky_s,
        rad0,
        rad1,
        rad2,
        rad_s,
        sdf0,
        sdf1,
        sdf_s,
        hdr_bg,
        bg_s,
        half_size,
    )
}

