// Unified hardware rasterization of extracted surface meshlets (`extract`) and clipmap heightfields
// (`height`): dual-cascade rotated-PCF sun shadows, camera-focused world-space radiance cache +
// auto-extracted dynamic local emitters, 4× hardware MSAA direct HDR + G-buffer pass, half-res
// bilateral 4-cone GI + Screen-Space Specular Reflections (SSR) + micro-contact shadows, unified
// refractive pass (glass/water/crystal with SSR + Snell refraction + Beer-Lambert absorption),
// volumetric froxels, Dual Kawase HDR bloom, and ONE `Look::tone` pass.

use matter::height::{Height, NoHeight}
use matter::medium::{Medium, NoMedium}
use matter::sky::Sky
use matter::substance::{
    ONE_OVER_PI, Substance, env_brdf_approx, fresnel_schlick_rough,
}
use matter::swarm::{NoSwarm, Swarm}
use matter::world::{And, Many, One, World}
use mesh::extract::{ExtractScratch, MeshBatch, MeshVertex, extract_scratch, mesh_batch, steep}
use mesh::height::{CLIP_RINGS, ClipmapMesh, MeshVary, clipmap_mesh, height_vs}
use mesh::light::{
    Emitter, NEAR, RadGrid, RadianceCache, SHADOW_SIDE, ShadowView, SkyCache, clip_of,
    cone_indirect, contact_shadow, decode_substance, encode_mat_signed, eval_emitters_tiled,
    radiance_cache, shadow_view, sky_background, sky_cache, sky_irradiance, sky_specular,
    spec_cone, sun_shadow_hybrid, sun_vis_point, trace_ssr,
}
use mesh::sdf::{
    SdfClipmap, SdfGrid, multi_bounce_ao, sdf_bent_ao, sdf_clipmap, sdf_curvature, sdf_grid,
    sdf_thickness,
}
use mesh::swarm::{SwarmSim, swarm_fs, swarm_shadow_vs, swarm_sim, swarm_vs}
use mesh::tsr::{TsrState, halton_jitter, project_uv_unjittered, tsr_state}
use mesh::volume::{
    BloomPyramid, FroxelVolume, bloom_pyramid, froxel_volume, hdr_tone_fs,
}
use picture::eye::{Eye, View, view}
use picture::look::Look
use picture::picture::{Picture, picture}
use picture::screen::{cover, luma, show}
use std::collections::Vec
use std::field::{Field, Rigid}
use std::gpu::{
    Address, ClipPosition, Compare, ComparisonSampler, Cull, Depth, DepthBias, DepthOnlyPass,
    DepthPass, DepthPass4, DepthTexture, Filter, FragCoord, InstanceIndex, R8, R16Float, Rg16Float,
    Rgba8, Rgba16Float, Rgba32Float, Sampler, Targets2, Targets3, Targets4, Texture, Texture3d,
    VertexIndex, begin_depth_pass, begin_pass, begin_pass2, begin_pass3, begin_pass4_with_depth,
    begin_pass_with_depth, comparison_sampler, copy_texture, depth_texture, discard, draw, label,
    sampler, texture,
}
use std::hash::{Hasher, StateHash}

/// Camera-focused clipmap / radiance focus distance (m).
const FOCUS_RAD: f32 = 9.5

/// Default maximum active surface bricks per batch.
const BATCH_BRICKS: u32 = 8192

/// Distance threshold (m) beyond which `Many` things refresh on alternating 30 Hz frames while
/// foreground things refresh every frame (60 Hz).
const FAR_TIER_DIST: f32 = 9.0

/// Vertex shader for the unified shadow depth pass: projects `MeshVertex` through its instance's
/// rigid transform `xforms[ii.index]` into orthographic sun space.
@vertex
fn shadow_vs(verts: [MeshVertex], xforms: [Rigid], sv: ShadowView, vi: VertexIndex, ii: InstanceIndex) -> ClipPosition {
    let wp = xforms[ii.index].apply_point(verts[vi.index].pos.xyz)
    ClipPosition { position: vec4(sv.project(wp), 1.0) }
}

/// Depth-only fragment shader for the shadow pass (colour output is ignored by `DepthOnlyPass`).
@fragment
fn shadow_fs() -> vec4 {
    vec4(0.0)
}

/// Vertex shader for the unified eye pass: transforms `MeshVertex` by `xforms[ii.index]` and
/// `prev_xforms[ii.index]` for exact analytical motion vectors, matching `View::ray` bit-for-bit.
@vertex
fn mesh_vs(
    verts: [MeshVertex],
    xforms: [Rigid],
    prev_xforms: [Rigid],
    v: View,
    vi: VertexIndex,
    ii: InstanceIndex,
) -> MeshVary {
    let vert = verts[vi.index]
    let xf = xforms[ii.index]
    let pxf = prev_xforms[ii.index]
    let wp = xf.apply_point(vert.pos.xyz)
    let prev_wp = pxf.apply_point(vert.pos.xyz)
    MeshVary {
        clip: clip_of(v, wp),
        wp,
        prev_wp,
        normal: xf.apply_normal(vert.normal.xyz),
        albedo: vert.albedo.xyz,
        emits: vert.emits.xyz,
        pbr: vec4(vert.normal.w, vert.albedo.w, vert.emits.w, vert.pos.w),
        optics: vert.optics,
    }
}

/// Reconstructs the interpolated physical `Substance` from `MeshVary`.
fn vary_substance(vary: MeshVary) -> Substance {
    Substance {
        albedo: clamp(vary.albedo, vec3(0.0), vec3(1.0)),
        roughness: clamp(vary.pbr.x, 0.02, 1.0),
        emits: max(vary.emits, vec3(0.0)),
        metallic: clamp(vary.pbr.y, 0.0, 1.0),
        ior: max(vary.pbr.z, 1.0),
        transmission: clamp(vary.optics.x, 0.0, 1.0),
        subsurface: clamp(vary.optics.y, 0.0, 1.0),
        coat: clamp(vary.optics.z, 0.0, 1.0),
        micro: clamp(vary.optics.w, 0.0, 1.0),
        pad0: 0.0,
        pad1: 0.0,
        pad2: 0.0,
    }
}

/// Fast 3D hash-free trigonometric micro-relief field & analytic gradient (zero textures, zero UV
/// seams): perturbs surface normal, roughness, and subtle grain contrast ONLY when `sub.micro > 0.01`.
fn micro_field_grad(p: vec3) -> vec4 {
    // 3 rotated 3D wave octaves (cheap GPU SFU sin/cos, zero lattice artifacts) at fixed world
    // frequencies: the relief's scale is the engine's, its strength the substance's `micro`.
    let p1 = p * 5.2
    let p2 = vec3(p.x * 13.7 + p.z * 7.1, p.y * 15.3 - p.x * 6.4, p.z * 14.1 + p.y * 8.2)
    let p3 = vec3(p.x * 31.0 - p.y * 19.0, p.y * 29.0 + p.z * 17.0, p.z * 33.0 + p.x * 15.0)
    let v1 = sin(p1.x) * cos(p1.y) * sin(p1.z)
    let g1 = vec3(
        cos(p1.x) * cos(p1.y) * sin(p1.z) * 5.2,
        -sin(p1.x) * sin(p1.y) * sin(p1.z) * 5.2,
        sin(p1.x) * cos(p1.y) * cos(p1.z) * 5.2,
    )
    let v2 = sin(p2.x) * sin(p2.y) * cos(p2.z) * 0.45
    let g2 = vec3(
        (cos(p2.x) * sin(p2.y) * cos(p2.z) * 13.7 - sin(p2.x) * cos(p2.y) * cos(p2.z) * 6.4) * 0.45,
        (sin(p2.x) * cos(p2.y) * cos(p2.z) * 15.3 - sin(p2.x) * sin(p2.y) * sin(p2.z) * 8.2) * 0.45,
        (cos(p2.x) * sin(p2.y) * cos(p2.z) * 7.1 - sin(p2.x) * sin(p2.y) * sin(p2.z) * 14.1) * 0.45,
    )
    let v3 = sin(p3.x) * cos(p3.y) * sin(p3.z) * 0.18
    let g3 = vec3(
        (cos(p3.x) * cos(p3.y) * sin(p3.z) * 31.0 + sin(p3.x) * cos(p3.y) * cos(p3.z) * 15.0) * 0.18,
        (-cos(p3.x) * cos(p3.y) * sin(p3.z) * 19.0 - sin(p3.x) * sin(p3.y) * sin(p3.z) * 29.0) * 0.18,
        (-sin(p3.x) * sin(p3.y) * sin(p3.z) * 17.0 + sin(p3.x) * cos(p3.y) * cos(p3.z) * 33.0) * 0.18,
    )
    vec4(g1 + g2 + g3, v1 + v2 + v3)
}

/// Applies per-pixel 3D field-space microsurface relief (normal bump + roughness/albedo micro-grain)
/// with automatic distance attenuation so distant surfaces never alias.
fn apply_micro_relief(wp: vec3, n: vec3, sub: Substance, dist: f32) -> (vec3, Substance) {
    if sub.micro <= 0.01 {
        return (n, sub)
    }
    let fade = clamp(1.0 - (dist - 4.0) / 28.0, 0.0, 1.0)
    if fade <= 0.01 {
        return (n, sub)
    }
    let mg = micro_field_grad(wp)
    let amp = sub.micro * fade
    // Project 3D gradient onto tangent plane so surface normal tilts physically without flipping.
    // A clearcoat film (`coat > 0.2`) fills the micro-pores beneath it, so its normal tilts about
    // half as far and its reflections stay crisp.
    let g_tan = mg.xyz - n * dot(mg.xyz, n)
    let bump_s = if sub.coat > 0.2 { 0.024 } else { 0.045 }
    let n_bumped = normalize(n - g_tan * (amp * bump_s))
    let grain = clamp(mg.w, -1.0, 1.0)
    let albedo_mod = clamp(sub.albedo * (1.0 + grain * amp * 0.14), vec3(0.01), vec3(1.0))
    let rough_mod = clamp(sub.roughness + grain * amp * 0.12, 0.03, 1.0)
    // A coat's thickness follows the micro-grain, so any coated substance's (`coat > 0.1`)
    // clearcoat varies across its surface with the same relief.
    let coat_mod = if sub.coat > 0.1 { clamp(sub.coat + grain * amp * 0.25, 0.0, 1.0) } else { sub.coat }
    (
        n_bumped,
        Substance {
            albedo: albedo_mod,
            roughness: rough_mod,
            coat: coat_mod,
            ..sub
        },
    )
}

/// Resolves crease-preserving shading normal from interpolated analytic normal and face derivatives.
fn resolve_normal(vary: MeshVary, ray_back: vec3) -> vec3 {
    let nv_l2 = dot(vary.normal, vary.normal)
    let nv = if nv_l2 > 1.0e-12 { vary.normal * (1.0 / sqrt(nv_l2)) } else { ray_back }
    let fraw = cross(dpdx(vary.wp), dpdy(vary.wp))
    let fl2 = dot(fraw, fraw)
    var nf = nv
    if fl2 > 1.0e-18 {
        nf = fraw * (1.0 / sqrt(fl2))
        if dot(nf, ray_back) < 0.0 {
            nf = -nf
        }
    }
    if vary.pbr.w < 0.5 || dot(nv, nf) < 0.85 { nf } else { nv }
}

/// Lean 1× G-buffer + analytical motion-vector fragment shader for the opaque eye pass (shared by
/// solid meshlets and opaque terrain heightfields). Writes `(n, 1)`, `(albedo, roughness)`,
/// `(emits, mat_code)`, and exact screen-space motion vector `prev_uv - curr_uv` with 100% Early-Z
/// and 4× less bandwidth than 4× MSAA; Halton-jittered TSR reconstructs 8× temporal supersampling.
@fragment
fn mesh_gbuf_fs(
    vary: MeshVary,
    v: View,
    prev_v: View,
) -> Targets4<vec4, vec4, vec4, vec2> {
    let to_eye = v.at - vary.wp
    let dist = length(to_eye)
    let ray_back = if dist > 1.0e-6 { to_eye / dist } else { -v.forward }
    let n0 = resolve_normal(vary, ray_back)
    let sub0 = vary_substance(vary)
    let (n, sub) = apply_micro_relief(vary.wp, n0, sub0, dist)
    let motion = project_uv_unjittered(prev_v, vary.prev_wp) - project_uv_unjittered(v, vary.wp)
    Targets4 {
        first: vec4(n * 0.5 + vec3(0.5), 1.0),
        second: vec4(sub.albedo, clamp(sub.roughness, 0.02, 1.0)),
        third: vec4(sub.emits, encode_mat_signed(sub)),
        fourth: motion,
    }
}

/// Reconstructs exact world hit distance along `ray` from 1× reversed-Z depth `ndc_z`.
fn reconstruct_pixel_dist(v: View, ray: vec3, ndc_z: f32) -> f32 {
    (NEAR / ndc_z) / max(dot(ray, v.forward), 0.05)
}

/// Unpacks a unit normal from `Rgba8` `g_normal = (n * 0.5 + 0.5, 1.0)`.
fn decode_gbuf_normal(gn: vec4, fallback: vec3) -> vec3 {
    let nr = gn.xyz * 2.0 - vec3(1.0)
    let nl2 = dot(nr, nr)
    if nl2 > 1.0e-10 { nr * (1.0 / sqrt(nl2)) } else { fallback }
}

/// Shared pixel-rate direct lighting core used identically by both `draw_scene` (`deferred_direct_fs`)
/// and `drawn_only` (`deferred_direct_judge_fs`): evaluates exact SDF variable-width soft shadows +
/// analytical curvature weathering + thickness-modulated backlit SSS + tiled SDF-shadowed local
/// emitters ONCE per screen pixel (zero micro-triangle quad overshading).
@budget(work: 48000)
fn shade_direct_pixel<S: Sky>(
    px: u32,
    py: u32,
    pixel_xy: vec2,
    v: View,
    sv: ShadowView,
    rad_grid: RadGrid,
    sdf_grid: SdfGrid,
    sky: S,
    g_normal: Texture<Rgba8>,
    g_albedo: Texture<Rgba8>,
    g_emits: Texture<Rgba16Float>,
    depth: DepthTexture,
    sky_spec0: Texture<Rgba16Float>,
    sky_s: Sampler,
    shadow_map: DepthTexture,
    cmp: ComparisonSampler,
    rad0: Texture3d<Rgba16Float>,
    rad1: Texture3d<Rgba16Float>,
    rad_s: Sampler,
    sdf0: Texture3d<R16Float>,
    sdf1: Texture3d<R16Float>,
    sdf_s: Sampler,
    emitters: [Emitter],
    tile_masks: [u32],
    tiles_x: u32,
    full_w: u32,
    full_h: u32,
) -> (vec4, vec4, f32) {
    let gn = g_normal.load(px, py)
    let ray = v.ray(pixel_xy)
    if gn.w <= 0.5 {
        return (vec4(sky_background(sky, sky_spec0, sky_s, ray), 65000.0), vec4(0.0), 1.0)
    }
    let ndc_z = depth.load(px, py)
    if ndc_z <= 1.0e-6 {
        return (vec4(sky_background(sky, sky_spec0, sky_s, ray), 65000.0), vec4(0.0), 1.0)
    }
    let n = decode_gbuf_normal(gn, -ray)
    let ga = g_albedo.load(px, py)
    let ge = g_emits.load(px, py)
    let mat_code = ge.w
    var sub = decode_substance(ga.xyz, ga.w, ge.xyz, mat_code)

    let dist = reconstruct_pixel_dist(v, ray, ndc_z)
    let wp = v.at + ray * dist
    let ray_back = -ray

    // Universal world-space analytical curvature weathering (`∇²d` from 3D SDF clipmap):
    // convex bevels/edges subtly polish & catch light; concave crevices darken & roughen.
    if sdf_grid.enabled != 0 && abs(mat_code) >= 0.01 && max(sub.emits.x, max(sub.emits.y, sub.emits.z)) < 0.25 {
        let curv = sdf_curvature(sdf_grid, sdf0, sdf1, sdf_s, wp)
        let convex = clamp(curv, 0.0, 1.0)
        let concave = clamp(-curv, 0.0, 1.0)
        let wear_a = 1.0 + convex * 0.14 - concave * 0.26
        let wear_r = clamp(sub.roughness - convex * 0.06 + concave * 0.10, 0.03, 1.0)
        sub = Substance {
            albedo: clamp(sub.albedo * wear_a, vec3(0.005), vec3(1.0)),
            roughness: wear_r,
            ..sub
        }
    }

    let sun = sky.sun()
    let ndl = max(dot(n, sun.way), 0.0)
    let vis = if ndl > 0.0 {
        sun_shadow_hybrid(shadow_map, cmp, sv, sdf_grid, sdf0, sdf1, sdf_s, wp, n, pixel_xy)
    } else {
        0.0
    }
    var direct_sun = sub.shade_direct(n, sun.way, ray_back, sun.light * vis)
    // Exact interior thickness backlit Subsurface Scattering (SSS) via 2-tap 3D SDF thickness.
    if sub.subsurface > 0.01 && sdf_grid.enabled != 0 {
        let thick = sdf_thickness(sdf_grid, sdf0, sdf1, sdf_s, wp, n, sun.way)
        let trans = exp(-thick * 3.8)
        let back = pow(clamp(dot(ray_back, normalize(-sun.way + n * 0.35)), 0.0, 1.0), 3.0)
        let sss_tint = sub.albedo * sqrt(max(sub.albedo, vec3(0.02)))
        direct_sun += sss_tint * sun.light * (sub.subsurface * trans * (0.25 + 0.75 * back) * ONE_OVER_PI)
    }
    let local_light = eval_emitters_tiled(
        sub, wp, n, ray_back, rad_grid, rad0, rad1, rad_s, sdf_grid, sdf0, sdf1, sdf_s,
        emitters, tile_masks, tiles_x, px, py,
    )
    let direct = sub.emits + direct_sun + local_light
    (vec4(direct, min(dist, 65000.0)), vec4(n, dist), vis)
}

/// Full-resolution 1× pixel-rate deferred direct lighting pass (`draw_scene`).
@fragment
@budget(work: 50000)
fn deferred_direct_fs<S: Sky>(
    pixel: FragCoord,
    v: View,
    sv: ShadowView,
    rad_grid: RadGrid,
    sdf_grid: SdfGrid,
    sky: S,
    g_normal: Texture<Rgba8>,
    g_albedo: Texture<Rgba8>,
    g_emits: Texture<Rgba16Float>,
    depth: DepthTexture,
    sky_spec0: Texture<Rgba16Float>,
    sky_s: Sampler,
    shadow_map: DepthTexture,
    cmp: ComparisonSampler,
    rad0: Texture3d<Rgba16Float>,
    rad1: Texture3d<Rgba16Float>,
    rad_s: Sampler,
    sdf0: Texture3d<R16Float>,
    sdf1: Texture3d<R16Float>,
    sdf_s: Sampler,
    emitters: [Emitter],
    tile_masks: [u32],
    tiles_x: u32,
    full_w: u32,
    full_h: u32,
) -> vec4 {
    let px = min(u32(pixel.position.x), full_w - 1)
    let py = min(u32(pixel.position.y), full_h - 1)
    let (hdr_d, _place, _vis) = shade_direct_pixel(
        px, py, pixel.position.xy, v, sv, rad_grid, sdf_grid, sky,
        g_normal, g_albedo, g_emits, depth, sky_spec0, sky_s,
        shadow_map, cmp, rad0, rad1, rad_s, sdf0, sdf1, sdf_s,
        emitters, tile_masks, tiles_x, full_w, full_h,
    )
    hdr_d
}

/// Identical pixel-rate deferred direct pass with `(place, sun)` diagnostic outputs for `drawn_only`
/// so the judges and hole audit verify the exact same renderer that draws the game.
@fragment
@budget(work: 50000)
fn deferred_direct_judge_fs<S: Sky>(
    pixel: FragCoord,
    v: View,
    sv: ShadowView,
    rad_grid: RadGrid,
    sdf_grid: SdfGrid,
    sky: S,
    g_normal: Texture<Rgba8>,
    g_albedo: Texture<Rgba8>,
    g_emits: Texture<Rgba16Float>,
    depth: DepthTexture,
    sky_spec0: Texture<Rgba16Float>,
    sky_s: Sampler,
    shadow_map: DepthTexture,
    cmp: ComparisonSampler,
    rad0: Texture3d<Rgba16Float>,
    rad1: Texture3d<Rgba16Float>,
    rad_s: Sampler,
    sdf0: Texture3d<R16Float>,
    sdf1: Texture3d<R16Float>,
    sdf_s: Sampler,
    emitters: [Emitter],
    tile_masks: [u32],
    tiles_x: u32,
    full_w: u32,
    full_h: u32,
) -> Targets3<vec4, vec4, f32> {
    let px = min(u32(pixel.position.x), full_w - 1)
    let py = min(u32(pixel.position.y), full_h - 1)
    let (hdr_d, place, vis) = shade_direct_pixel(
        px, py, pixel.position.xy, v, sv, rad_grid, sdf_grid, sky,
        g_normal, g_albedo, g_emits, depth, sky_spec0, sky_s,
        shadow_map, cmp, rad0, rad1, rad_s, sdf0, sdf1, sdf_s,
        emitters, tile_masks, tiles_x, full_w, full_h,
    )
    Targets3 { first: hdr_d, second: place, third: vis }
}

/// Half-resolution (`W/2 × H/2`) indirect lighting pass: computes 4-cone hemisphere diffuse GI +
/// multi-scale 3D SDF bent-normal AO (`first = vec4(bounce + bent_sky_shift, ao)`), Screen-Space
/// Specular Reflections (SSR) seamlessly falling back to SDF-accelerated `spec_cone` + `sky_specular`
/// PMREM (`second.rgb`), and screen-space micro-contact shadow visibility (`second.w`).
@fragment
@budget(work: 12000)
fn indirect_half_fs<S: Sky>(
    pixel: FragCoord,
    v: View,
    rad_grid: RadGrid,
    sdf_grid: SdfGrid,
    sky: S,
    hdr_direct: Texture<Rgba16Float>,
    g_normal: Texture<Rgba8>,
    g_albedo: Texture<Rgba8>,
    g_emits: Texture<Rgba16Float>,
    depth: DepthTexture,
    bg_s: Sampler,
    sky_diff: Texture<Rgba16Float>,
    sky_spec0: Texture<Rgba16Float>,
    sky_spec1: Texture<Rgba16Float>,
    sky_spec2: Texture<Rgba16Float>,
    sky_s: Sampler,
    rad0: Texture3d<Rgba16Float>,
    rad1: Texture3d<Rgba16Float>,
    rad2: Texture3d<Rgba16Float>,
    rad_s: Sampler,
    sdf0: Texture3d<R16Float>,
    sdf1: Texture3d<R16Float>,
    sdf_s: Sampler,
    full_w: u32,
    full_h: u32,
    phase_x: u32,
    phase_y: u32,
) -> Targets2<vec4, vec4> {
    let fx = min(u32(pixel.position.x) * 2 + phase_x, full_w - 1)
    let fy = min(u32(pixel.position.y) * 2 + phase_y, full_h - 1)
    let gn = g_normal.load(fx, fy)
    if gn.w <= 0.5 {
        return Targets2 {
            first: vec4(0.0, 0.0, 0.0, 1.0),
            second: vec4(0.0, 0.0, 0.0, 1.0),
        }
    }
    let ndc_z = depth.load(fx, fy)
    if ndc_z <= 1.0e-6 {
        return Targets2 {
            first: vec4(0.0, 0.0, 0.0, 1.0),
            second: vec4(0.0, 0.0, 0.0, 1.0),
        }
    }
    let ray = v.ray(vec2(f32(fx) + 0.5, f32(fy) + 0.5))
    let n = decode_gbuf_normal(gn, -ray)
    let dist = reconstruct_pixel_dist(v, ray, ndc_z)
    let wp = v.at + ray * dist
    let roughness = clamp(g_albedo.load(fx, fy).w, 0.02, 1.0)
    let mat_code = g_emits.load(fx, fy).w

    let ind0 = cone_indirect(rad_grid, rad0, rad1, rad2, rad_s, wp, n)
    var ind = ind0
    if sdf_grid.enabled != 0 {
        let bao = sdf_bent_ao(sdf_grid, sdf0, sdf1, sdf_s, wp, n)
        let ao = clamp(min(ind0.w, bao.w), 0.08, 1.0)
        // Bent-normal sky tint shift steers crevice ambient toward the unoccluded sky opening
        // while keeping full-res normal detail in `combine_indirect_fs`.
        let sky_bent = sky_irradiance(sky_diff, sky_s, bao.xyz)
        let sky_n = sky_irradiance(sky_diff, sky_s, n)
        let bent_shift = (sky_bent - sky_n) * (ao * 0.75)
        ind = vec4(max(ind0.xyz + bent_shift, vec3(0.0)), ao)
    }
    let cshad = if rad_grid.enabled != 0 { contact_shadow(v, depth, wp, n, sky.sun().way) } else { 1.0 }

    // Skip specular SSR & voxel/SDF reflection cone completely on pure matte surfaces (`abs(mat_code) < 0.01`).
    var env_spec = vec3(0.0)
    if abs(mat_code) >= 0.01 {
        let ray_back = -ray
        let refl = normalize(n * (2.0 * dot(n, ray_back)) - ray_back)
        let eff_r = if mat_code > 0.15 && mat_code < 1.8 { min(roughness, 0.12) } else { roughness }
        let sky_refl = sky_specular(sky_spec0, sky_spec1, sky_spec2, sky_diff, sky_s, refl, eff_r)
        let w_refl = spec_cone(
            rad_grid, rad0, rad1, rad2, rad_s, sdf_grid, sdf0, sdf1, sdf_s, wp, n, refl, eff_r,
        )
        let spec_occ = clamp(ind.w + (1.0 - eff_r) * 0.25, 0.15, 1.0)
        let fallback = w_refl.xyz + sky_refl * (1.0 - w_refl.w * 0.85) * spec_occ
        let ssr = trace_ssr(v, hdr_direct, bg_s, wp, n, refl, eff_r)
        env_spec = mix(fallback, ssr.xyz, vec3(ssr.w))
    }

    Targets2 {
        first: ind,
        second: vec4(env_spec, cshad),
    }
}

/// Full-resolution depth+normal bilateral upsample of phase-cycled half-res GI, bent-normal AO,
/// SSR, and micro-contact shadows combined with the pixel-rate direct HDR buffer into `hdr_colour`.
@fragment
fn combine_indirect_fs<S: Sky>(
    pixel: FragCoord,
    v: View,
    sky: S,
    hdr_direct: Texture<Rgba16Float>,
    g_normal: Texture<Rgba8>,
    g_albedo: Texture<Rgba8>,
    g_emits: Texture<Rgba16Float>,
    gi_diff: Texture<Rgba16Float>,
    gi_spec: Texture<Rgba16Float>,
    sky_diff: Texture<Rgba16Float>,
    sky_s: Sampler,
    full_w: u32,
    full_h: u32,
    phase_x: u32,
    phase_y: u32,
) -> vec4 {
    let px = min(u32(pixel.position.x), full_w - 1)
    let py = min(u32(pixel.position.y), full_h - 1)
    let direct_d = hdr_direct.load(px, py)
    let gn = g_normal.load(px, py)
    if gn.w <= 0.5 {
        return direct_d
    }
    let ga = g_albedo.load(px, py)
    let ge = g_emits.load(px, py)
    let ray = v.ray(pixel.position.xy)
    let n = decode_gbuf_normal(gn, -ray)
    let dist = direct_d.w
    let albedo = clamp(ga.xyz, vec3(0.0), vec3(1.0))
    let roughness = clamp(ga.w, 0.02, 1.0)
    let mat_code = ge.w

    // 4-tap depth + normal weighted bilateral upsample from phase-cycled half-res GI/SSR buffers.
    let hw = max(full_w / 2, 1)
    let hh = max(full_h / 2, 1)
    let hx0 = min(px / 2, hw - 1)
    let hy0 = min(py / 2, hh - 1)
    let hx1 = min(hx0 + 1, hw - 1)
    let hy1 = min(hy0 + 1, hh - 1)

    let xs = [hx0, hx1, hx0, hx1]
    let ys = [hy0, hy0, hy1, hy1]
    var diff_acc = vec4(0.0)
    var spec_acc = vec4(0.0)
    var w_sum = 0.0
    for k in 0..4 {
        let sx = xs[k]
        let sy = ys[k]
        let fx = min(sx * 2 + phase_x, full_w - 1)
        let fy = min(sy * 2 + phase_y, full_h - 1)
        let sn = g_normal.load(fx, fy)
        let sd = hdr_direct.load(fx, fy).w
        if sn.w > 0.5 {
            let sn_v = decode_gbuf_normal(sn, n)
            let ndot = max(dot(n, sn_v), 0.0)
            let dz = abs(dist - sd) / max(dist * 0.08, 0.15)
            let w = (ndot * ndot * ndot * ndot + 0.001) * exp(-dz * dz)
            diff_acc += gi_diff.load(sx, sy) * w
            spec_acc += gi_spec.load(sx, sy) * w
            w_sum += w
        }
    }
    let ind = if w_sum > 1.0e-4 { diff_acc / w_sum } else { gi_diff.load(hx0, hy0) }
    let spec_c = if w_sum > 1.0e-4 { spec_acc / w_sum } else { gi_spec.load(hx0, hy0) }

    let emit_luma = luma(max(ge.xyz, vec3(0.0)))
    let cshad = if emit_luma < 0.5 && dot(n, sky.sun().way) > 0.05 { spec_c.w } else { 1.0 }
    var rad = direct_d.xyz * cshad

    let sky_amb = sky_irradiance(sky_diff, sky_s, n) * multi_bounce_ao(ind.w, albedo) + ind.xyz
    if abs(mat_code) < 0.01 {
        rad += albedo * ONE_OVER_PI * sky_amb
    } else {
        let ray_back = -ray
        let ndv = max(dot(n, ray_back), 0.001)
        let metallic = if mat_code < -0.01 { clamp(-mat_code, 0.0, 1.0) } else { 0.0 }
        let coat = if mat_code > 0.03 && mat_code < 1.8 { clamp(mat_code - 0.02, 0.0, 1.0) } else { 0.0 }
        let f0 = mix(vec3(0.04), albedo, metallic)
        let f_env = fresnel_schlick_rough(f0, ndv, roughness)
        let kd = (vec3(1.0) - f_env) * (1.0 - metallic)
        let brdf_ab = env_brdf_approx(roughness, ndv)
        var indirect = albedo * (kd * ONE_OVER_PI) * sky_amb + spec_c.xyz * (f0 * brdf_ab.x + vec3(brdf_ab.y))
        if coat > 1.0e-4 {
            let fc = fresnel_schlick_rough(vec3(0.04), ndv, 0.06).x * coat
            indirect = indirect * (1.0 - fc) + spec_c.xyz * fc
        }
        rad += indirect
    }
    vec4(rad, dist)
}

/// Half-resolution (`W/2 × H/2`) reflection pre-pass for transmissive surfaces (water, glass,
/// crystal): evaluates real-time SSR + SDF-accelerated `spec_cone` + Sky PMREM at 1/4 pixel count,
/// skipping fragments behind opaque geometry, and outputs premultiplied `(env_spec, 1.0)` so
/// full-res `mesh_trans_fs` reads reflections in 1 bilinear tap with zero edge fringing.
@fragment
@budget(work: 16000)
fn refract_refl_fs(
    pixel: FragCoord,
    vary: MeshVary,
    v: View,
    rad_grid: RadGrid,
    sdf_grid: SdfGrid,
    sky_diff: Texture<Rgba16Float>,
    sky_spec0: Texture<Rgba16Float>,
    sky_spec1: Texture<Rgba16Float>,
    sky_spec2: Texture<Rgba16Float>,
    sky_s: Sampler,
    rad0: Texture3d<Rgba16Float>,
    rad1: Texture3d<Rgba16Float>,
    rad2: Texture3d<Rgba16Float>,
    rad_s: Sampler,
    sdf0: Texture3d<R16Float>,
    sdf1: Texture3d<R16Float>,
    sdf_s: Sampler,
    hdr_bg: Texture<Rgba16Float>,
    bg_s: Sampler,
    half_size: vec2,
) -> vec4 {
    if vary.optics.x <= 0.02 {
        discard()
    }
    let to_eye = v.at - vary.wp
    let dist = length(to_eye)
    let uv = pixel.position.xy / max(half_size, vec2(1.0))
    let bg_d = hdr_bg.sample_level(bg_s, uv, 0.0).w
    if dist > bg_d + 0.25 {
        discard()
    }
    let ray_back = if dist > 1.0e-6 { to_eye / dist } else { -v.forward }
    let n0 = resolve_normal(vary, ray_back)
    let sub0 = vary_substance(vary)
    let (n, sub) = apply_micro_relief(vary.wp, n0, sub0, dist)
    let ndv = max(dot(n, ray_back), 0.001)
    let refl = normalize(n * (2.0 * ndv) - ray_back)

    let sky_refl = sky_specular(sky_spec0, sky_spec1, sky_spec2, sky_diff, sky_s, refl, sub.roughness)
    let w_refl = spec_cone(
        rad_grid, rad0, rad1, rad2, rad_s, sdf_grid, sdf0, sdf1, sdf_s, vary.wp, n, refl, sub.roughness,
    )
    let fallback = w_refl.xyz + sky_refl * (1.0 - w_refl.w * 0.85)
    let ssr = trace_ssr(v, hdr_bg, bg_s, vary.wp, n, refl, sub.roughness)
    let env_spec = mix(fallback, ssr.xyz, vec3(ssr.w))
    vec4(env_spec, 1.0)
}

/// Projects refracted exit point along Snell direction `rdir` at `ior` to screen UV.
fn refract_uv_for(v: View, wp: vec3, n: vec3, ray_back: vec3, ndv: f32, ior: f32, refract_dist: f32) -> vec2 {
    let eta = 1.0 / max(ior, 1.02)
    let k = 1.0 - eta * eta * (1.0 - ndv * ndv)
    let rdir = if k > 0.0 {
        normalize(-ray_back * eta + n * (eta * ndv - sqrt(k)))
    } else {
        normalize(n * (2.0 * ndv) - ray_back)
    }
    let exit_wp = wp + rdir * min(refract_dist * 0.45, 1.2)
    let erel = exit_wp - v.at
    let ez = max(dot(erel, v.forward), 0.05)
    let aspect = v.size.y / max(v.size.x, 1.0)
    let ex_ndc = (dot(erel, v.right) * v.focal * aspect) / ez
    let ey_ndc = (dot(erel, v.up) * v.focal) / ez
    clamp(vec2(ex_ndc * 0.5 + 0.5, 0.5 - ey_ndc * 0.5), vec2(0.002), vec2(0.998))
}

/// Physically-based refractive / transmissive fragment shader for glass, water, crystal, and ice:
/// 3-channel spectral chromatic dispersion (glass/crystal `ior > 1.38`), Snell screen-space
/// refraction + Beer-Lambert depth absorption (`hdr_bg.w - dist`), 1-tap upsampled half-res SSR
/// (`refract_refl`), thin-film Fresnel sheen, and crisp GGX specular from sun & tiled spell emitters.
@fragment
@budget(work: 38000)
fn mesh_trans_fs<S: Sky>(
    pixel: FragCoord,
    vary: MeshVary,
    v: View,
    sv: ShadowView,
    rad_grid: RadGrid,
    sdf_grid: SdfGrid,
    sky: S,
    sky_diff: Texture<Rgba16Float>,
    sky_spec0: Texture<Rgba16Float>,
    sky_spec1: Texture<Rgba16Float>,
    sky_spec2: Texture<Rgba16Float>,
    sky_s: Sampler,
    shadow_map: DepthTexture,
    cmp: ComparisonSampler,
    rad0: Texture3d<Rgba16Float>,
    rad1: Texture3d<Rgba16Float>,
    rad2: Texture3d<Rgba16Float>,
    rad_s: Sampler,
    sdf0: Texture3d<R16Float>,
    sdf1: Texture3d<R16Float>,
    sdf_s: Sampler,
    emitters: [Emitter],
    tile_masks: [u32],
    tiles_x: u32,
    hdr_bg: Texture<Rgba16Float>,
    refract_refl: Texture<Rgba16Float>,
    bg_s: Sampler,
) -> vec4 {
    if vary.optics.x <= 0.02 {
        discard()
    }
    let to_eye = v.at - vary.wp
    let dist = length(to_eye)
    let ray_back = if dist > 1.0e-6 { to_eye / dist } else { -v.forward }
    let n0 = resolve_normal(vary, ray_back)
    let sub0 = vary_substance(vary)
    let (n, sub) = apply_micro_relief(vary.wp, n0, sub0, dist)
    let ndv = max(dot(n, ray_back), 0.001)

    let uv = pixel.position.xy / max(v.size, vec2(1.0))
    let bg_here = hdr_bg.sample_level(bg_s, uv, 0.0)
    let raw_thick = max(bg_here.w - dist, 0.05)
    let refract_dist = min(raw_thick, 3.5)

    let refr_uv = refract_uv_for(v, vary.wp, n, ray_back, ndv, sub.ior, refract_dist)
    let bg_refr = hdr_bg.sample_level(bg_s, refr_uv, 0.0)
    let valid_g = bg_refr.w >= dist - 0.08
    let use_uv = if valid_g { refr_uv } else { uv }
    var bg_rad = if valid_g { bg_refr.xyz } else { bg_here.xyz }
    let bg_depth = if valid_g { bg_refr.w } else { bg_here.w }

    // 3-channel spectral chromatic dispersion on high-IOR glass/crystal (`ior > 1.38`).
    if sub.ior > 1.38 && valid_g {
        let uv_r = refract_uv_for(v, vary.wp, n, ray_back, ndv, sub.ior - 0.032, refract_dist)
        let uv_b = refract_uv_for(v, vary.wp, n, ray_back, ndv, sub.ior + 0.032, refract_dist)
        let smp_r = hdr_bg.sample_level(bg_s, uv_r, 0.0)
        let smp_b = hdr_bg.sample_level(bg_s, uv_b, 0.0)
        let cr = if smp_r.w >= dist - 0.08 { smp_r.x } else { bg_rad.x }
        let cb = if smp_b.w >= dist - 0.08 { smp_b.z } else { bg_rad.z }
        bg_rad = vec3(cr, bg_rad.y, cb)
    }

    if sub.roughness > 0.06 {
        let blur = (sub.roughness * 0.012) * clamp(refract_dist, 0.25, 2.0)
        var acc = bg_rad
        acc += hdr_bg.sample_level(bg_s, clamp(use_uv + vec2(blur, blur), vec2(0.002), vec2(0.998)), 0.0).xyz
        acc += hdr_bg.sample_level(bg_s, clamp(use_uv + vec2(-blur, blur), vec2(0.002), vec2(0.998)), 0.0).xyz
        acc += hdr_bg.sample_level(bg_s, clamp(use_uv + vec2(blur, -blur), vec2(0.002), vec2(0.998)), 0.0).xyz
        acc += hdr_bg.sample_level(bg_s, clamp(use_uv + vec2(-blur, -blur), vec2(0.002), vec2(0.998)), 0.0).xyz
        bg_rad = acc * 0.2
    }

    let thickness = clamp(bg_depth - dist, 0.04, 18.0)
    let absorb = (vec3(1.0) - clamp(sub.albedo, vec3(0.03), vec3(0.98))) * 0.95
    let beer = exp(-absorb * thickness)
    let transmitted = bg_rad * beer

    let sun = sky.sun()
    let ndl = max(dot(n, sun.way), 0.0)
    let vis = if ndl > 0.0 { sun_vis_point(shadow_map, cmp, sv, vary.wp) } else { 0.0 }
    let sky_amb = sky_irradiance(sky_diff, sky_s, n)
    let deep_scatter = sub.albedo * (vec3(1.0) - beer) * ONE_OVER_PI * (sun.light * (0.25 * vis + 0.1) + sky_amb * 0.45)

    // 1-tap upsample of half-res SSR + SDF `spec_cone` + Sky PMREM (zero full-res raymarching!).
    let refl = normalize(n * (2.0 * ndv) - ray_back)
    let f0 = sub.f0()
    var f_env = fresnel_schlick_rough(f0, ndv, sub.roughness)
    // Subtle grazing thin-film spectral iridescence on crystalline glass (`ior > 1.38`).
    if sub.ior > 1.38 {
        let phase = (1.0 - ndv) * 6.2831853
        let irid = vec3(0.5 + 0.5 * cos(phase), 0.5 + 0.5 * cos(phase + 2.0944), 0.5 + 0.5 * cos(phase + 4.1888))
        let graze = (1.0 - ndv) * (1.0 - ndv) * (1.0 - sub.roughness)
        f_env = clamp(f_env * mix(vec3(1.0), vec3(0.82) + irid * 0.36, vec3(graze * 0.65)), vec3(0.0), vec3(1.0))
    }
    let rr = refract_refl.sample_level(bg_s, uv, 0.0)
    let env_spec = if rr.w > 0.02 {
        rr.xyz / rr.w
    } else {
        sky_specular(sky_spec0, sky_spec1, sky_spec2, sky_diff, sky_s, refl, sub.roughness)
    }

    let direct_spec = sub.shade_direct(n, sun.way, ray_back, sun.light * vis)
    let px = u32(max(pixel.position.x, 0.0))
    let py = u32(max(pixel.position.y, 0.0))
    let local_spec = eval_emitters_tiled(
        sub, vary.wp, n, ray_back, rad_grid, rad0, rad1, rad_s, sdf_grid, sdf0, sdf1, sdf_s,
        emitters, tile_masks, tiles_x, px, py,
    )

    let tr = sub.transmission
    let body = mix(sub.albedo * ONE_OVER_PI * (sun.light * (ndl * vis) + sky_amb), transmitted + deep_scatter, vec3(tr))
    let rad = sub.emits + body * (vec3(1.0) - f_env) + env_spec * f_env + direct_spec + local_spec
    vec4(rad, min(dist, 65000.0))
}

/// Computes a curvature- and budget-aware cell spacing for a single thing with bounding sphere
/// `(c, r)`. Targets a bounded screen-space sagitta error (`c ≈ sqrt(8 * e * R_feat * px)`),
/// keeping tight `~1.45 px` cells when an object is small on screen (or `1.1 px` for `steep`
/// noise fields) while avoiding sub-2-pixel micro-triangles on large smooth close-ups.
fn cell_for_one(c: vec3, r: f32, v: View, steep: bool) -> f32 {
    let near = max(length(c - v.at) - r, 0.25)
    let px = near * v.pixel()
    let r_px = r / max(px, 1.0e-5)
    let mult = if steep { 1.1 } else { clamp(0.253 * sqrt(r_px), 1.45, 2.55) }
    let by_size = max(r / 180.0, 0.005)
    clamp(max(px * mult, by_size), 0.005, 0.25)
}

/// Computes a curvature- and budget-aware cell spacing for one thing in a `Many` batch.
fn cell_for_share(c: vec3, r: f32, bricks_for_this: f32, v: View) -> f32 {
    let near = max(length(c - v.at) - r, 0.25)
    let px = near * v.pixel()
    let r_px = r / max(px, 1.0e-5)
    let mult = clamp(0.253 * sqrt(r_px), 1.35, 2.50)
    let per_thing = max(bricks_for_this, 4.0)
    let by_budget = r / max(sqrt(per_thing * 2.5), 3.5)
    clamp(max(px * mult, by_budget), 0.006, 0.25)
}

/// Any world (`One`, `Many`, `And`) that can sync its GPU meshlet batches and splat its opaque
/// geometry into the unified 2-cascade 3D SDF clipmap.
pub trait MeshWorld: Copy {
    fn batch_count(self) -> u32
    fn sync_batches(self, scratch: mut ExtractScratch, batches: mut Vec<MeshBatch>, first: u32, v: View, frame: u32)
    fn splat_sdf(
        self,
        sdf: mut SdfClipmap,
        batches: mut Vec<MeshBatch>,
        first: u32,
        static_only: bool,
        all_batches: bool,
    )
}

impl<M: Field<Substance> + StateHash + GpuData> MeshWorld for One<M> {
    fn batch_count(self) -> u32 {
        1
    }

    fn sync_batches(self, scratch: mut ExtractScratch, batches: mut Vec<MeshBatch>, first: u32, v: View, _frame: u32) {
        let b = self.field.bound()
        let cell = cell_for_one(b.centre, min(b.radius, 1.0e4), v, steep(self.field))
        batches[first].sync_one(mut scratch, self.field, cell)
    }

    fn splat_sdf(
        self,
        sdf: mut SdfClipmap,
        batches: mut Vec<MeshBatch>,
        first: u32,
        static_only: bool,
        all_batches: bool,
    ) {
        if !batches[first].has_opaque {
            return
        }
        let is_static = batches[first].still_frames >= 1
        if !all_batches && is_static != static_only {
            return
        }
        sdf.splat_one(self.field, batches[first].bound, to_static: !all_batches && static_only)
    }
}

/// Whether a sphere `(c, r)` intersects the view frustum.
fn in_view(c: vec3, r: f32, v: View) -> bool {
    let rel = c - v.at
    let z = dot(rel, v.forward)
    if z + r < NEAR {
        return false
    }
    let aspect = v.size.x / max(v.size.y, 1.0)
    let half_y = max(z, 0.0) / v.focal + r * 1.4
    let half_x = half_y * aspect + r * 1.4
    abs(dot(rel, v.up)) <= half_y && abs(dot(rel, v.right)) <= half_x
}

impl<M: Field<Substance> + StateHash + GpuData, const N: u32> MeshWorld for Many<M, N> {
    fn batch_count(self) -> u32 {
        if N >= 16 { 3 } else { 1 }
    }

    fn sync_batches(self, scratch: mut ExtractScratch, batches: mut Vec<MeshBatch>, first: u32, v: View, frame: u32) {
        let cap = batches[first].max_bricks
        // Each thing's bound, distance and screen-share weight (`0.0` when out of view), once.
        var centres = [vec3(0.0); N]
        var radii = [0.0; N]
        var nears = [0.0; N]
        var weights = [0.0; N]
        var total_w = 0.0
        for i in 0..N {
            let b = self.fields[i].bound()
            let r = min(b.radius, 1.0e4)
            let near = max(length(b.centre - v.at) - r, 0.25)
            centres[i] = b.centre
            radii[i] = r
            nears[i] = near
            if in_view(b.centre, r, v) {
                let s = r / near
                weights[i] = clamp(s * s, 0.002, 4.0)
                total_w += weights[i]
            }
        }
        let inv_w = if total_w > 1.0e-6 { f32(cap) / total_w } else { f32(cap) }

        if N < 16 {
            var cells = [0.0; N]
            for i in 0..N {
                if weights[i] > 0.0 {
                    cells[i] = cell_for_share(centres[i], radii[i], weights[i] * inv_w, v)
                }
            }
            batches[first].sync_many(mut scratch, self.fields, cells)
            return
        }

        let init_tiers = batches[first].tiers.len() != N
        if init_tiers {
            batches[first].tiers = Vec::new()
            for _i in 0..N {
                batches[first].tiers.push(0)
            }
        }
        let update_even = init_tiers || frame == 0 || (frame & 1) == 0
        let update_odd = init_tiers || frame == 0 || (frame & 1) == 1

        var c_near = [0.0; N]
        var c_even = [0.0; N]
        var c_odd = [0.0; N]
        for i in 0..N {
            let vis = weights[i] > 0.0
            let far_slot: u32 = if (i & 1) == 0 { 1 } else { 2 }
            let want_tier: u32 = if !vis {
                far_slot
            } else if nears[i] <= FAR_TIER_DIST {
                0
            } else {
                far_slot
            }
            var cur = if init_tiers { want_tier } else { batches[first].tiers[i] }
            let can_change = (cur == 0 && (want_tier == 0 || (want_tier == 1 && update_even) || (want_tier == 2 && update_odd)))
                || (cur == 1 && update_even)
                || (cur == 2 && update_odd)
            if can_change {
                cur = want_tier
                batches[first].tiers[i] = cur
            }
            if vis {
                let cell = cell_for_share(centres[i], radii[i], weights[i] * inv_w, v)
                if cur == 0 {
                    c_near[i] = cell
                } else if cur == 1 {
                    c_even[i] = cell
                } else {
                    c_odd[i] = cell
                }
            }
        }
        batches[first].sync_many(mut scratch, self.fields, c_near)
        if update_even {
            batches[first + 1].sync_many(mut scratch, self.fields, c_even)
        } else {
            batches[first + 1].still_frames += 1
        }
        if update_odd {
            batches[first + 2].sync_many(mut scratch, self.fields, c_odd)
        } else {
            batches[first + 2].still_frames += 1
        }
    }

    fn splat_sdf(
        self,
        sdf: mut SdfClipmap,
        batches: mut Vec<MeshBatch>,
        first: u32,
        static_only: bool,
        all_batches: bool,
    ) {
        let any_opaque = batches[first].has_opaque || (N >= 16 && (batches[first + 1].has_opaque || batches[first + 2].has_opaque))
        if !any_opaque {
            return
        }
        let is_static = if N < 16 {
            batches[first].still_frames >= 1
        } else {
            batches[first].still_frames >= 1 && batches[first + 1].still_frames >= 1 && batches[first + 2].still_frames >= 1
        }
        if !all_batches && is_static != static_only {
            return
        }
        sdf.splat_many(self.fields, to_static: !all_batches && static_only)
    }
}

impl<A: MeshWorld, B: MeshWorld> MeshWorld for And<A, B> {
    fn batch_count(self) -> u32 {
        self.a.batch_count() + self.b.batch_count()
    }

    fn sync_batches(self, scratch: mut ExtractScratch, batches: mut Vec<MeshBatch>, first: u32, v: View, frame: u32) {
        let na = self.a.batch_count()
        self.a.sync_batches(mut scratch, mut batches, first, v, frame)
        self.b.sync_batches(mut scratch, mut batches, first + na, v, frame)
    }

    fn splat_sdf(
        self,
        sdf: mut SdfClipmap,
        batches: mut Vec<MeshBatch>,
        first: u32,
        static_only: bool,
        all_batches: bool,
    ) {
        let na = self.a.batch_count()
        self.a.splat_sdf(mut sdf, mut batches, first, static_only, all_batches)
        self.b.splat_sdf(mut sdf, mut batches, first + na, static_only, all_batches)
    }
}

/// Fills `prev_place` with the current jittered subframe's hit ONLY where no prior subframe hit,
/// keeping the exact pixel-center hit from subframe 0 while recording TSR subpixel coverage.
@fragment
fn merge_place_fs(
    pixel: FragCoord,
    prev_place: Texture<Rgba32Float>,
    g_normal: Texture<Rgba8>,
    depth: DepthTexture,
    v: View,
    full_w: u32,
    full_h: u32,
) -> vec4 {
    let px = min(u32(pixel.position.x), full_w - 1)
    let py = min(u32(pixel.position.y), full_h - 1)
    let old = prev_place.load(px, py)
    if old.w > 0.0 {
        return old
    }
    let gn = g_normal.load(px, py)
    if gn.w <= 0.5 {
        return old
    }
    let ndc_z = depth.load(px, py)
    if ndc_z <= 1.0e-6 {
        return old
    }
    let ray = v.ray(pixel.position.xy)
    let n = decode_gbuf_normal(gn, -ray)
    let dist = reconstruct_pixel_dist(v, ray, ndc_z)
    vec4(n, dist)
}

/// Complete meshlet renderer state: owns extracted batches, unified sun shadow map + 2-cascade
/// 3D SDF clipmap, GPU Sky PMREM cache, camera-focused radiance cache + auto-extracted dynamic
/// emitters, 1× G-buffer + motion vectors, Temporal Super-Resolution (TSR), half-res phase-cycled
/// GI/SSR + half-res refract SSR buffers, volumetric froxels, optical HDR bloom, and `Picture`.
pub struct MeshSight {
    pub drawn: Picture,
    pub hdr_direct: Texture<Rgba16Float>,
    pub g_normal: Texture<Rgba8>,
    pub g_albedo: Texture<Rgba8>,
    pub g_emits: Texture<Rgba16Float>,
    pub g_motion: Texture<Rg16Float>,
    pub gi_diff: Texture<Rgba16Float>,
    pub gi_spec: Texture<Rgba16Float>,
    pub refract_refl: Texture<Rgba16Float>,
    pub refract_depth: DepthTexture,
    pub hdr_colour: Texture<Rgba16Float>,
    pub hdr_bg: Texture<Rgba16Float>,
    place_tmp: Texture<Rgba32Float>,
    place_tmp_w: u32,
    place_tmp_h: u32,
    pub depth: DepthTexture,
    pub sky: SkyCache,
    pub rad: RadianceCache,
    pub sdf: SdfClipmap,
    pub tsr: TsrState,
    pub vol: FroxelVolume,
    pub bloom: BloomPyramid,
    pub swarm: SwarmSim,
    scratch: ExtractScratch,
    clipmap: ClipmapMesh,
    batches: Vec<MeshBatch>,
    shadow_map: DepthTexture,
    cmp: ComparisonSampler,
    bg_s: Sampler,
    rad_key: u64,
    rad_built: bool,
    frame: u32,
    pub gi: bool,
}

/// Creates a fresh `MeshSight` with 2-cascade 3D SDF clipmap, 1× G-buffer + analytical motion
/// vectors + Halton-jittered Temporal Super-Resolution (TSR), pixel-rate deferred direct lighting,
/// 16×16 tiled dynamic emitters, phase-cycled half-res GI/SSR, half-res refract SSR + 3-channel
/// chromatic dispersion, froxel volumetrics, and optical HDR bloom.
pub fn mesh_sight(gi: bool = true) -> MeshSight {
    MeshSight {
        drawn: picture(width: 1, height: 1),
        hdr_direct: texture(width: 1, height: 1),
        g_normal: texture(width: 1, height: 1),
        g_albedo: texture(width: 1, height: 1),
        g_emits: texture(width: 1, height: 1),
        g_motion: texture(width: 1, height: 1),
        gi_diff: texture(width: 1, height: 1),
        gi_spec: texture(width: 1, height: 1),
        refract_refl: texture(width: 1, height: 1),
        refract_depth: depth_texture(width: 1, height: 1),
        hdr_colour: texture(width: 1, height: 1),
        hdr_bg: texture(width: 1, height: 1),
        place_tmp: texture(width: 1, height: 1),
        place_tmp_w: 0,
        place_tmp_h: 0,
        depth: depth_texture(width: 1, height: 1),
        sky: sky_cache(),
        rad: radiance_cache(),
        sdf: sdf_clipmap(),
        tsr: tsr_state(),
        vol: froxel_volume(),
        bloom: bloom_pyramid(),
        swarm: swarm_sim(),
        scratch: extract_scratch(BATCH_BRICKS),
        clipmap: clipmap_mesh(),
        batches: Vec::new(),
        shadow_map: depth_texture(width: SHADOW_SIDE, height: SHADOW_SIDE),
        cmp: comparison_sampler(compare: Compare::LessEqual),
        bg_s: sampler(filter: Filter::Linear, address: Address::Clamp),
        rad_key: 0,
        rad_built: false,
        frame: 0,
        gi: gi,
    }
}

impl MeshSight {
    fn resize(mut self, width: u32, height: u32) {
        if self.drawn.width() != width || self.drawn.height() != height {
            let hw = max(width / 2, 1)
            let hh = max(height / 2, 1)
            self.drawn = picture(width: width, height: height)
            self.drawn.placed = true
            self.hdr_direct = texture(width: width, height: height)
            self.g_normal = texture(width: width, height: height)
            self.g_albedo = texture(width: width, height: height)
            self.g_emits = texture(width: width, height: height)
            self.g_motion = texture(width: width, height: height)
            self.gi_diff = texture(width: hw, height: hh)
            self.gi_spec = texture(width: hw, height: hh)
            self.refract_refl = texture(width: hw, height: hh)
            self.refract_depth = depth_texture(width: hw, height: hh)
            self.hdr_colour = texture(width: width, height: height)
            self.hdr_bg = texture(width: width, height: height)
            self.depth = depth_texture(width: width, height: height)
            self.tsr.resize(width, height)
        }
    }

    fn ensure_batches(mut self, count: u32) {
        while self.batches.len() < count {
            self.batches.push(mesh_batch(BATCH_BRICKS))
        }
    }

    /// Updates Sky PMREM, syncs meshlets, builds/updates the 2-cascade 3D SDF clipmap, steps
    /// `swarm` accelerated by the SDF clipmap, renders the unified sun shadow map, and updates
    /// the camera-focused radiance volume & dynamic emitters.
    fn prepare_and_shadow<W: World + MeshWorld, Sw: Swarm, S: Sky>(
        mut self,
        world: W,
        swarm: Sw,
        sky: S,
        eye: Eye,
        width: u32,
        height: u32,
        frame: u32,
    ) -> (u32, View, ShadowView) {
        self.resize(width, height)
        let v = view(eye, width: width, height: height)

        self.sky.sync(sky)

        let nb = world.batch_count()
        self.ensure_batches(nb)
        world.sync_batches(mut self.scratch, mut self.batches, 0, v, frame)

        var wlo = vec3(1.0e20)
        var whi = vec3(-1.0e20)
        var rk = Hasher::new()
        var sdf_fk = Hasher::new()
        var static_opaque_count: u32 = 0
        for i in 0..nb {
            self.batches[i].finish_poll()
            let b = self.batches[i].bound
            self.batches[i].hash.state_hash(mut rk)
            if self.batches[i].has_opaque {
                i.state_hash(mut sdf_fk)
                self.batches[i].hash.state_hash(mut sdf_fk)
                if self.batches[i].still_frames >= 1 {
                    static_opaque_count += 1
                }
            }
            if b.w > 0.0 {
                wlo = min(wlo, b.xyz - vec3(b.w))
                whi = max(whi, b.xyz + vec3(b.w))
            }
        }
        let wmid = 0.5 * (wlo + whi)
        let wrad = if whi.x > wlo.x { 0.5 * length(whi - wlo) } else { 10.0 }
        let sun = sky.sun()
        let sv = shadow_view(wmid, wrad, sun.way)

        // Focus near SDF cascade + radiance volume around camera look target (clamped to world).
        let focus_raw = v.at + v.forward * min(FOCUS_RAD * 0.75, wrad * 0.65)
        let focus = clamp(focus_raw, wlo, whi)

        // Pass 0b: Sparse 2-cascade 3D SDF clipmap (`96³` near + `64³` world, static/dynamic split).
        // Runs BEFORE `swarm.update` so grain physics uses 1-tap hardware SDF broad-phase culling.
        if !self.gi {
            self.sdf.disable(focus, wmid, wrad)
        } else {
            let sg = sdf_grid(focus, wmid, wrad, enabled: true)
            sg.o0.state_hash(mut sdf_fk)
            sg.v0.state_hash(mut sdf_fk)
            sg.o1.state_hash(mut sdf_fk)
            sg.v1.state_hash(mut sdf_fk)
            let full_sdf_key = sdf_fk.finish()
            if !self.sdf.full_valid || self.sdf.full_key != full_sdf_key {
                if static_opaque_count > 0 {
                    var ssk = Hasher::new()
                    sg.o0.state_hash(mut ssk)
                    sg.v0.state_hash(mut ssk)
                    sg.o1.state_hash(mut ssk)
                    sg.v1.state_hash(mut ssk)
                    for i in 0..nb {
                        if self.batches[i].has_opaque && self.batches[i].still_frames >= 1 {
                            i.state_hash(mut ssk)
                            self.batches[i].hash.state_hash(mut ssk)
                        }
                    }
                    let skey = ssk.finish()
                    if !self.sdf.static_valid || self.sdf.static_key != skey {
                        self.sdf.begin_static(sg)
                        world.splat_sdf(mut self.sdf, mut self.batches, 0, static_only: true, all_batches: false)
                        self.sdf.static_key = skey
                        self.sdf.static_valid = true
                    }
                    self.sdf.begin_from_static(sg)
                    world.splat_sdf(mut self.sdf, mut self.batches, 0, static_only: false, all_batches: false)
                } else {
                    self.sdf.begin_all(sg)
                    world.splat_sdf(mut self.sdf, mut self.batches, 0, static_only: false, all_batches: true)
                }
                self.sdf.finish()
                self.sdf.full_key = full_sdf_key
                self.sdf.full_valid = true
            } else {
                self.sdf.grid = sg
            }
        }

        self.swarm.update(swarm, world.field(), self.sdf.grid, self.sdf.sdf0, self.sdf.sdf1, self.sdf.s)

        // Pass 1: Unified sun shadow map (one `2048²` world map paired with exact 3D SDF cone penumbra).
        label("mesh_shadow")
        let sp: DepthOnlyPass = begin_depth_pass(mut self.shadow_map, clear_depth: 1.0, keep_depth: false)
        for i in 0..nb {
            if self.batches[i].has_opaque {
                draw(
                    sp,
                    shadow_vs.bind(verts: self.batches[i].verts.items(), xforms: self.batches[i].xforms.items(), sv: sv),
                    shadow_fs,
                    indices: self.batches[i].indices,
                    indirect: self.batches[i].draw_args,
                    cull: Cull::Back,
                    depth_bias: DepthBias { constant: 2, slope: 1.5, clamp: 0.0 },
                    depth: Depth { compare: Compare::Less, write: true },
                )
            }
        }
        if self.swarm.count > 0 {
            draw(
                sp,
                swarm_shadow_vs.bind(grains: self.swarm.front(), sv: sv),
                shadow_fs,
                vertices: 6,
                instances: self.swarm.count,
                depth: Depth { compare: Compare::Less, write: true },
            )
        }
        sp.end()

        // Pass 1b: Camera-focused radiance cache & dynamic local emitters.
        // Skips rebuild completely (0 ms/frame) when the whole world is static; when only dynamic
        // batches move, copies the cached static accumulation buffers and injects only dynamic
        // batches + swarm instead of re-injecting static architecture every frame.
        let rad_centre = if wrad > 16.0 { focus } else { wmid }
        let rad_rad = min(wrad, 16.0)
        sun.way.state_hash(mut rk)
        rad_centre.state_hash(mut rk)
        if self.swarm.count > 0 {
            frame.state_hash(mut rk)
        }
        let rkey = rk.finish()
        if !self.gi {
            self.rad.begin(rad_centre, rad_rad, enabled: false)
            self.rad_built = false
        } else if !self.rad_built || self.rad_key != rkey {
            var sk = Hasher::new()
            sun.way.state_hash(mut sk)
            rad_centre.state_hash(mut sk)
            rad_rad.state_hash(mut sk)
            let warmup_bounce: u32 = if frame <= 1 { 1 } else { 0 }
            warmup_bounce.state_hash(mut sk)
            var static_count: u32 = 0
            for i in 0..nb {
                if self.batches[i].still_frames >= 1 {
                    i.state_hash(mut sk)
                    self.batches[i].hash.state_hash(mut sk)
                    static_count += 1
                }
            }
            let skey = sk.finish()
            if static_count > 0 {
                if !self.rad.static_valid || self.rad.static_key != skey {
                    self.rad.begin_static(rad_centre, rad_rad, enabled: true)
                    for i in 0..nb {
                        if self.batches[i].still_frames >= 1 {
                            self.rad.inject_static(
                                self.batches[i].verts.items(),
                                self.batches[i].verts.count(),
                                self.batches[i].cap_verts,
                                self.batches[i].xforms.items(),
                                self.batches[i].inst_count,
                                sv,
                                sky,
                                self.sky.diff,
                                self.sky.s,
                                self.shadow_map,
                                self.cmp,
                            )
                        }
                    }
                    self.rad.static_key = skey
                    self.rad.static_valid = true
                }
                self.rad.begin_from_static(rad_centre, rad_rad)
                for i in 0..nb {
                    if self.batches[i].still_frames == 0 {
                        self.rad.inject(
                            self.batches[i].verts.items(),
                            self.batches[i].verts.count(),
                            self.batches[i].cap_verts,
                            self.batches[i].xforms.items(),
                            self.batches[i].inst_count,
                            sv,
                            sky,
                            self.sky.diff,
                            self.sky.s,
                            self.shadow_map,
                            self.cmp,
                        )
                    }
                }
            } else {
                self.rad.begin(rad_centre, rad_rad, enabled: true)
                for i in 0..nb {
                    self.rad.inject(
                        self.batches[i].verts.items(),
                        self.batches[i].verts.count(),
                        self.batches[i].cap_verts,
                        self.batches[i].xforms.items(),
                        self.batches[i].inst_count,
                        sv,
                        sky,
                        self.sky.diff,
                        self.sky.s,
                        self.shadow_map,
                        self.cmp,
                    )
                }
            }
            if self.swarm.count > 0 {
                self.swarm.inject_radiance(swarm, self.rad.grid, mut self.rad.accum, mut self.rad.emit_accum)
            }
            self.rad.finish()
            self.rad_key = rkey
            self.rad_built = true
        }
        (nb, v, sv)
    }

    /// Shared opaque geometry + tiled emitter culling + pixel-rate deferred direct + phase-cycled
    /// half-res bilateral GI/SSR + full-res combine pipeline used identically by BOTH `draw_scene`
    /// and `drawn_only` (the judges test the exact same renderer that draws the game).
    fn render_opaque_and_indirect<H: Height, Sw: Swarm, S: Sky>(
        mut self,
        nb: u32,
        height: H,
        swarm: Sw,
        sky: S,
        v: View,
        prev_v: View,
        sv: ShadowView,
        width: u32,
        height_px: u32,
        phase_x: u32,
        phase_y: u32,
        write_judge: bool,
    ) {
        self.rad.cull_tiles(v, width, height_px)

        // Pass 2a: Lean 1× G-buffer + analytical motion-vector pass (4× less bandwidth than MSAA).
        label("mesh_eye")
        let ep: DepthPass4<Rgba8, Rgba8, Rgba16Float, Rg16Float> = begin_pass4_with_depth(
            mut self.g_normal,
            mut self.g_albedo,
            mut self.g_emits,
            mut self.g_motion,
            mut self.depth,
            clear: vec4(0.0, 0.0, 0.0, 0.0),
            clear_depth: 0.0,
        )
        for i in 0..nb {
            if self.batches[i].has_opaque {
                draw(
                    ep,
                    mesh_vs.bind(
                        verts: self.batches[i].verts.items(),
                        xforms: self.batches[i].xforms.items(),
                        prev_xforms: self.batches[i].prev_xforms.items(),
                        v: v,
                    ),
                    mesh_gbuf_fs.bind(v: v, prev_v: prev_v),
                    indices: self.batches[i].indices,
                    indirect: self.batches[i].draw_args,
                    cull: Cull::Back,
                    depth: Depth { compare: Compare::Greater, write: true },
                )
            }
        }
        if height.active() && height.has_opaque() {
            draw(
                ep,
                height_vs.bind(height: height, v: v, base_level: 0, trans_pass: 0),
                mesh_gbuf_fs.bind(v: v, prev_v: prev_v),
                indices: self.clipmap.inner_indices,
                index_count: self.clipmap.inner_count,
                instances: 1,
                cull: Cull::Back,
                depth: Depth { compare: Compare::Greater, write: true },
            )
            draw(
                ep,
                height_vs.bind(height: height, v: v, base_level: 1, trans_pass: 0),
                mesh_gbuf_fs.bind(v: v, prev_v: prev_v),
                indices: self.clipmap.outer_indices,
                index_count: self.clipmap.outer_count,
                instances: CLIP_RINGS - 1,
                cull: Cull::Back,
                depth: Depth { compare: Compare::Greater, write: true },
            )
        }
        if self.swarm.count > 0 {
            draw(
                ep,
                swarm_vs.bind(swarm: swarm, grains: self.swarm.front(), v: v),
                swarm_fs.bind(v: v, prev_v: prev_v),
                vertices: 6,
                instances: self.swarm.count,
                depth: Depth { compare: Compare::Greater, write: true },
            )
        }
        ep.end()

        // Pass 2b: Full-res 1× pixel-rate deferred direct lighting (SDF soft shadows + curvature + SSS + tiled emitters).
        label("mesh_direct")
        if write_judge {
            let dp = begin_pass3(mut self.hdr_direct, mut self.drawn.place, mut self.drawn.sun, keep: false)
            draw(
                dp,
                cover,
                deferred_direct_judge_fs.bind(
                    v: v,
                    sv: sv,
                    rad_grid: self.rad.grid,
                    sdf_grid: self.sdf.grid,
                    sky: sky,
                    g_normal: self.g_normal,
                    g_albedo: self.g_albedo,
                    g_emits: self.g_emits,
                    depth: self.depth,
                    sky_spec0: self.sky.spec0,
                    sky_s: self.sky.s,
                    shadow_map: self.shadow_map,
                    cmp: self.cmp,
                    rad0: self.rad.rad0,
                    rad1: self.rad.rad1,
                    rad_s: self.rad.s,
                    sdf0: self.sdf.sdf0,
                    sdf1: self.sdf.sdf1,
                    sdf_s: self.sdf.s,
                    emitters: self.rad.emitters.items(),
                    tile_masks: self.rad.tile_masks.items(),
                    tiles_x: self.rad.tiles_x,
                    full_w: width,
                    full_h: height_px,
                ),
                vertices: 3,
            )
            dp.end()
        } else {
            let dp = begin_pass(mut self.hdr_direct, keep: false)
            draw(
                dp,
                cover,
                deferred_direct_fs.bind(
                    v: v,
                    sv: sv,
                    rad_grid: self.rad.grid,
                    sdf_grid: self.sdf.grid,
                    sky: sky,
                    g_normal: self.g_normal,
                    g_albedo: self.g_albedo,
                    g_emits: self.g_emits,
                    depth: self.depth,
                    sky_spec0: self.sky.spec0,
                    sky_s: self.sky.s,
                    shadow_map: self.shadow_map,
                    cmp: self.cmp,
                    rad0: self.rad.rad0,
                    rad1: self.rad.rad1,
                    rad_s: self.rad.s,
                    sdf0: self.sdf.sdf0,
                    sdf1: self.sdf.sdf1,
                    sdf_s: self.sdf.s,
                    emitters: self.rad.emitters.items(),
                    tile_masks: self.rad.tile_masks.items(),
                    tiles_x: self.rad.tiles_x,
                    full_w: width,
                    full_h: height_px,
                ),
                vertices: 3,
            )
            dp.end()
        }

        // Pass 2c: Half-res (`W/2 × H/2`) 4-cone diffuse GI + SDF bent-normal AO + SSR + micro-contact shadows.
        label("mesh_indirect")
        let ip = begin_pass2(mut self.gi_diff, mut self.gi_spec, keep: false)
        draw(
            ip,
            cover,
            indirect_half_fs.bind(
                v: v,
                rad_grid: self.rad.grid,
                sdf_grid: self.sdf.grid,
                sky: sky,
                hdr_direct: self.hdr_direct,
                g_normal: self.g_normal,
                g_albedo: self.g_albedo,
                g_emits: self.g_emits,
                depth: self.depth,
                bg_s: self.bg_s,
                sky_diff: self.sky.diff,
                sky_spec0: self.sky.spec0,
                sky_spec1: self.sky.spec1,
                sky_spec2: self.sky.spec2,
                sky_s: self.sky.s,
                rad0: self.rad.rad0,
                rad1: self.rad.rad1,
                rad2: self.rad.rad2,
                rad_s: self.rad.s,
                sdf0: self.sdf.sdf0,
                sdf1: self.sdf.sdf1,
                sdf_s: self.sdf.s,
                full_w: width,
                full_h: height_px,
                phase_x: phase_x,
                phase_y: phase_y,
            ),
            vertices: 3,
        )
        ip.end()

        // Pass 2d: Full-res depth+normal bilateral upsample of phase-cycled GI/SSR.
        label("mesh_combine")
        let cp = begin_pass(mut self.hdr_colour, keep: false)
        draw(
            cp,
            cover,
            combine_indirect_fs.bind(
                v: v,
                sky: sky,
                hdr_direct: self.hdr_direct,
                g_normal: self.g_normal,
                g_albedo: self.g_albedo,
                g_emits: self.g_emits,
                gi_diff: self.gi_diff,
                gi_spec: self.gi_spec,
                sky_diff: self.sky.diff,
                sky_s: self.sky.s,
                full_w: width,
                full_h: height_px,
                phase_x: phase_x,
                phase_y: phase_y,
            ),
            vertices: 3,
        )
        cp.end()
    }

    /// Renders `world` into `self.drawn` (`colour`, `place`, `sun`) without presenting (for
    /// judging against `Reference`), executing the exact same 1× + Halton-jittered TSR pipeline as
    /// `draw_scene` over 8 subpixel frames so offline judges verify the real temporal resolve.
    pub fn drawn_only<W: World + MeshWorld, S: Sky, L: Look>(
        mut self,
        world: W,
        sky: S,
        look: L,
        eye: Eye,
        width: u32,
        height: u32,
    ) {
        let (nb, v_unjit, sv) = self.prepare_and_shadow(world, NoSwarm {}, sky, eye, width, height, 0)
        if self.place_tmp_w != width || self.place_tmp_h != height {
            self.place_tmp = texture(width: width, height: height)
            self.place_tmp_w = width
            self.place_tmp_h = height
        }
        self.tsr.valid = false

        // Subframe 0: exact pixel-center view writes `drawn.place` and `drawn.sun`, and seeds TSR.
        self.render_opaque_and_indirect(
            nb, NoHeight {}, NoSwarm {}, sky, v_unjit, v_unjit, sv, width, height,
            phase_x: 0, phase_y: 0, write_judge: true,
        )
        self.tsr.resolve(mut self.hdr_colour, self.g_motion, self.depth, v_unjit, width, height)

        // Subframes 1..8: converge Halton(2, 3) TSR supersampling and record subpixel coverage
        // within the pixel's cardinal diamond (`|jx| + |jy| <= 0.5`, matching 4× MSAA's footprint).
        for s in 1..8 {
            let j = halton_jitter(s)
            let vj = v_unjit.moved(j)
            let px = s & 1
            let py = (s >> 1) & 1
            self.render_opaque_and_indirect(
                nb, NoHeight {}, NoSwarm {}, sky, vj, v_unjit, sv, width, height,
                phase_x: px, phase_y: py, write_judge: false,
            )
            self.tsr.resolve(mut self.hdr_colour, self.g_motion, self.depth, v_unjit, width, height)
            if abs(j.x) + abs(j.y) <= 0.5 {
                let mp = begin_pass(mut self.place_tmp, keep: false)
                draw(
                    mp,
                    cover,
                    merge_place_fs.bind(
                        prev_place: self.drawn.place,
                        g_normal: self.g_normal,
                        depth: self.depth,
                        v: vj,
                        full_w: width,
                        full_h: height,
                    ),
                    vertices: 3,
                )
                mp.end()
                copy_texture(from: self.place_tmp.level(0), to: self.drawn.place.level_mut(0))
            }
        }

        label("mesh_tone")
        let tp = begin_pass(mut self.drawn.colour, keep: false)
        draw(
            tp,
            cover,
            hdr_tone_fs.bind(
                hdr: self.hdr_colour,
                depth: self.depth,
                froxel_acc: self.vol.acc,
                vol_s: self.vol.s,
                vol_active: 0,
                bloom_tex: self.bloom.u0,
                bloom_s: self.bloom.s,
                bloom_strength: 0.0,
                v: v_unjit,
                look: look,
            ),
            vertices: 3,
        )
        tp.end()
        self.drawn.placed = true
        for i in 0..nb {
            self.batches[i].maybe_queue_poll()
        }
    }

    /// Renders a complete scene (`world` solids, `height` clipmap, `medium` froxels, and `swarm`
    /// field-colliding GPU grains) through ONE depth buffer, ONE light store, 2-cascade 3D SDF
    /// clipmap, 1× G-buffer + motion vectors, phase-cycled half-res GI/SSR, half-res refract SSR +
    /// 3-channel chromatic dispersion, Temporal Super-Resolution (TSR), froxel volumetrics,
    /// optical HDR bloom, and ONE `Look::tone` pass.
    pub fn draw_scene<W: World + MeshWorld, H: Height, Med: Medium, Sw: Swarm, S: Sky, L: Look>(
        mut self,
        world: W,
        height: H,
        medium: Med,
        swarm: Sw,
        sky: S,
        look: L,
        eye: Eye,
        width: u32,
        height_px: u32,
    ) {
        let cur_frame = self.frame
        let (nb, v_unjit, sv) = self.prepare_and_shadow(world, swarm, sky, eye, width, height_px, cur_frame)
        self.frame += 1

        let jitter = halton_jitter(cur_frame)
        let v = v_unjit.moved(jitter)
        let prev_v = if self.tsr.valid { self.tsr.prev_v } else { v_unjit }
        let phase_x = cur_frame & 1
        let phase_y = (cur_frame >> 1) & 1

        self.render_opaque_and_indirect(
            nb, height, swarm, sky, v, prev_v, sv, width, height_px, phase_x, phase_y, write_judge: false,
        )

        // Pass 2e: Unified refractive / transmissive pass (half-res SSR pre-pass + full-res
        // 3-channel chromatic dispersion, Beer-Lambert absorption, and tiled emitter specular).
        // Skipped completely (0.0 ms) when no heightfield or batch contains transmissive triangles.
        var any_trans = height.active() && height.has_transmissive()
        for i in 0..nb {
            self.batches[i].finish_poll()
            if self.batches[i].has_trans {
                any_trans = true
            }
        }
        if any_trans {
            label("mesh_refract")
            copy_texture(from: self.hdr_colour.level(0), to: self.hdr_bg.level_mut(0))
            let half_size = vec2(f32(max(width / 2, 1)), f32(max(height_px / 2, 1)))
            let rrp: DepthPass<Rgba16Float> = begin_pass_with_depth(
                mut self.refract_refl,
                mut self.refract_depth,
                clear: vec4(0.0, 0.0, 0.0, 0.0),
                clear_depth: 0.0,
            )
            for i in 0..nb {
                if self.batches[i].has_trans {
                    draw(
                        rrp,
                        mesh_vs.bind(
                            verts: self.batches[i].verts.items(),
                            xforms: self.batches[i].xforms.items(),
                            prev_xforms: self.batches[i].prev_xforms.items(),
                            v: v,
                        ),
                        refract_refl_fs.bind(
                            v: v,
                            rad_grid: self.rad.grid,
                            sdf_grid: self.sdf.grid,
                            sky_diff: self.sky.diff,
                            sky_spec0: self.sky.spec0,
                            sky_spec1: self.sky.spec1,
                            sky_spec2: self.sky.spec2,
                            sky_s: self.sky.s,
                            rad0: self.rad.rad0,
                            rad1: self.rad.rad1,
                            rad2: self.rad.rad2,
                            rad_s: self.rad.s,
                            sdf0: self.sdf.sdf0,
                            sdf1: self.sdf.sdf1,
                            sdf_s: self.sdf.s,
                            hdr_bg: self.hdr_bg,
                            bg_s: self.bg_s,
                            half_size: half_size,
                        ),
                        indices: self.batches[i].trans_indices,
                        indirect: self.batches[i].trans_draw_args,
                        cull: Cull::Back,
                        depth: Depth { compare: Compare::Greater, write: true },
                    )
                }
            }
            if height.active() && height.has_transmissive() {
                draw(
                    rrp,
                    height_vs.bind(height: height, v: v, base_level: 0, trans_pass: 1),
                    refract_refl_fs.bind(
                        v: v,
                        rad_grid: self.rad.grid,
                        sdf_grid: self.sdf.grid,
                        sky_diff: self.sky.diff,
                        sky_spec0: self.sky.spec0,
                        sky_spec1: self.sky.spec1,
                        sky_spec2: self.sky.spec2,
                        sky_s: self.sky.s,
                        rad0: self.rad.rad0,
                        rad1: self.rad.rad1,
                        rad2: self.rad.rad2,
                        rad_s: self.rad.s,
                        sdf0: self.sdf.sdf0,
                        sdf1: self.sdf.sdf1,
                        sdf_s: self.sdf.s,
                        hdr_bg: self.hdr_bg,
                        bg_s: self.bg_s,
                        half_size: half_size,
                    ),
                    indices: self.clipmap.inner_indices,
                    index_count: self.clipmap.inner_count,
                    instances: 1,
                    cull: Cull::Back,
                    depth: Depth { compare: Compare::Greater, write: true },
                )
                draw(
                    rrp,
                    height_vs.bind(height: height, v: v, base_level: 1, trans_pass: 1),
                    refract_refl_fs.bind(
                        v: v,
                        rad_grid: self.rad.grid,
                        sdf_grid: self.sdf.grid,
                        sky_diff: self.sky.diff,
                        sky_spec0: self.sky.spec0,
                        sky_spec1: self.sky.spec1,
                        sky_spec2: self.sky.spec2,
                        sky_s: self.sky.s,
                        rad0: self.rad.rad0,
                        rad1: self.rad.rad1,
                        rad2: self.rad.rad2,
                        rad_s: self.rad.s,
                        sdf0: self.sdf.sdf0,
                        sdf1: self.sdf.sdf1,
                        sdf_s: self.sdf.s,
                        hdr_bg: self.hdr_bg,
                        bg_s: self.bg_s,
                        half_size: half_size,
                    ),
                    indices: self.clipmap.outer_indices,
                    index_count: self.clipmap.outer_count,
                    instances: CLIP_RINGS - 1,
                    cull: Cull::Back,
                    depth: Depth { compare: Compare::Greater, write: true },
                )
            }
            rrp.end()

            let rp: DepthPass<Rgba16Float> = begin_pass_with_depth(
                mut self.hdr_colour,
                mut self.depth,
                keep: true,
                keep_depth: true,
            )
            for i in 0..nb {
                if self.batches[i].has_trans {
                    draw(
                        rp,
                        mesh_vs.bind(
                            verts: self.batches[i].verts.items(),
                            xforms: self.batches[i].xforms.items(),
                            prev_xforms: self.batches[i].prev_xforms.items(),
                            v: v,
                        ),
                        mesh_trans_fs.bind(
                            v: v,
                            sv: sv,
                            rad_grid: self.rad.grid,
                            sdf_grid: self.sdf.grid,
                            sky: sky,
                            sky_diff: self.sky.diff,
                            sky_spec0: self.sky.spec0,
                            sky_spec1: self.sky.spec1,
                            sky_spec2: self.sky.spec2,
                            sky_s: self.sky.s,
                            shadow_map: self.shadow_map,
                            cmp: self.cmp,
                            rad0: self.rad.rad0,
                            rad1: self.rad.rad1,
                            rad2: self.rad.rad2,
                            rad_s: self.rad.s,
                            sdf0: self.sdf.sdf0,
                            sdf1: self.sdf.sdf1,
                            sdf_s: self.sdf.s,
                            emitters: self.rad.emitters.items(),
                            tile_masks: self.rad.tile_masks.items(),
                            tiles_x: self.rad.tiles_x,
                            hdr_bg: self.hdr_bg,
                            refract_refl: self.refract_refl,
                            bg_s: self.bg_s,
                        ),
                        indices: self.batches[i].trans_indices,
                        indirect: self.batches[i].trans_draw_args,
                        cull: Cull::Back,
                        depth: Depth { compare: Compare::Greater, write: true },
                    )
                }
            }
            if height.active() && height.has_transmissive() {
                draw(
                    rp,
                    height_vs.bind(height: height, v: v, base_level: 0, trans_pass: 1),
                    mesh_trans_fs.bind(
                        v: v,
                        sv: sv,
                        rad_grid: self.rad.grid,
                        sdf_grid: self.sdf.grid,
                        sky: sky,
                        sky_diff: self.sky.diff,
                        sky_spec0: self.sky.spec0,
                        sky_spec1: self.sky.spec1,
                        sky_spec2: self.sky.spec2,
                        sky_s: self.sky.s,
                        shadow_map: self.shadow_map,
                        cmp: self.cmp,
                        rad0: self.rad.rad0,
                        rad1: self.rad.rad1,
                        rad2: self.rad.rad2,
                        rad_s: self.rad.s,
                        sdf0: self.sdf.sdf0,
                        sdf1: self.sdf.sdf1,
                        sdf_s: self.sdf.s,
                        emitters: self.rad.emitters.items(),
                        tile_masks: self.rad.tile_masks.items(),
                        tiles_x: self.rad.tiles_x,
                        hdr_bg: self.hdr_bg,
                        refract_refl: self.refract_refl,
                        bg_s: self.bg_s,
                    ),
                    indices: self.clipmap.inner_indices,
                    index_count: self.clipmap.inner_count,
                    instances: 1,
                    cull: Cull::Back,
                    depth: Depth { compare: Compare::Greater, write: true },
                )
                draw(
                    rp,
                    height_vs.bind(height: height, v: v, base_level: 1, trans_pass: 1),
                    mesh_trans_fs.bind(
                        v: v,
                        sv: sv,
                        rad_grid: self.rad.grid,
                        sdf_grid: self.sdf.grid,
                        sky: sky,
                        sky_diff: self.sky.diff,
                        sky_spec0: self.sky.spec0,
                        sky_spec1: self.sky.spec1,
                        sky_spec2: self.sky.spec2,
                        sky_s: self.sky.s,
                        shadow_map: self.shadow_map,
                        cmp: self.cmp,
                        rad0: self.rad.rad0,
                        rad1: self.rad.rad1,
                        rad2: self.rad.rad2,
                        rad_s: self.rad.s,
                        sdf0: self.sdf.sdf0,
                        sdf1: self.sdf.sdf1,
                        sdf_s: self.sdf.s,
                        emitters: self.rad.emitters.items(),
                        tile_masks: self.rad.tile_masks.items(),
                        tiles_x: self.rad.tiles_x,
                        hdr_bg: self.hdr_bg,
                        refract_refl: self.refract_refl,
                        bg_s: self.bg_s,
                    ),
                    indices: self.clipmap.outer_indices,
                    index_count: self.clipmap.outer_count,
                    instances: CLIP_RINGS - 1,
                    cull: Cull::Back,
                    depth: Depth { compare: Compare::Greater, write: true },
                )
            }
            rp.end()
        }

        // Pass 2f: Temporal Super-Resolution (TSR): merges Halton-jittered subpixel frames and
        // 2×2 phase-cycled half-res GI/SSR into crisp full-resolution supersampled HDR.
        self.tsr.resolve(mut self.hdr_colour, self.g_motion, self.depth, v_unjit, width, height_px)

        // Pass 2g: Unified volumetric froxel pass (0 ms when `medium.active()` is false).
        let has_vol = medium.active()
        if has_vol {
            self.vol.update(
                medium,
                v_unjit,
                sv,
                self.rad.grid,
                sky,
                self.sky.diff,
                self.sky.s,
                self.shadow_map,
                self.cmp,
                self.rad.rad1,
                self.rad.rad2,
                self.rad.s,
                self.rad.emitters.items(),
                self.rad.emitters.count(),
            )
        }

        // Pass 2f: Optical HDR bloom pyramid (0 ms when `look.bloom().strength <= 0.0`).
        let bloom_cfg = look.bloom()
        self.bloom.build(self.hdr_colour, width, height_px, bloom_cfg)

        // Pass 3: Unified volumetric composite + optical bloom + ONE `Look::tone` pass.
        label("mesh_tone")
        let tp = begin_pass(mut self.drawn.colour, keep: false)
        draw(
            tp,
            cover,
            hdr_tone_fs.bind(
                hdr: self.hdr_colour,
                depth: self.depth,
                froxel_acc: self.vol.acc,
                vol_s: self.vol.s,
                vol_active: if has_vol { 1 } else { 0 },
                bloom_tex: self.bloom.u0,
                bloom_s: self.bloom.s,
                bloom_strength: bloom_cfg.strength,
                v: v,
                look: look,
            ),
            vertices: 3,
        )
        tp.end()
        self.drawn.placed = false
        show(self.drawn.colour)
        for i in 0..nb {
            self.batches[i].maybe_queue_poll()
        }
    }

    /// Renders `world` (`Surface`s only) into `self.drawn` and presents it to the screen.
    pub fn draw<W: World + MeshWorld, S: Sky, L: Look>(
        mut self,
        world: W,
        sky: S,
        look: L,
        eye: Eye,
        width: u32,
        height: u32,
    ) {
        self.draw_scene(world, NoHeight {}, NoMedium {}, NoSwarm {}, sky, look, eye, width, height)
    }
}
