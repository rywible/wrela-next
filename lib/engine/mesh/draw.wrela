// Unified hardware rasterization of extracted surface meshlets (`extract`): one vertex shader,
// one fragment shader, and one shadow map for still and moving matter alike.
//
// Every thing in a `MeshWorld` (`One`, `Many`, `And`) extracts its sparse Dual Contouring meshlets
// into a `MeshBatch` (0 ms/frame once built for still things), renders into one unified sun shadow
// map, and rasterizes into a 4× hardware MSAA reversed-Z target (tile-memoryless on Metal, dynamic
// resolve on Vulkan) with automatic crease-preserving shading normals, resolving directly to
// `Picture` for display or judging against `engine::reference`.

use matter::height::{Height, NoHeight}
use matter::medium::{Medium, NoMedium}
use matter::sky::{Sky, seen}
use matter::substance::{ONE_OVER_PI, Substance}
use matter::world::{And, Many, One}
use mesh::extract::{MeshBatch, MeshVertex, mesh_batch}
use mesh::height::{CLIP_RINGS, CLIP_VERTS, MeshVary, height_vs}
use mesh::light::{
    RadGrid, RadianceCache, SHADOW_SIDE, ShadowView, TABLE, cone_indirect, radiance_cache,
    shadow_view, sky_irradiance, skylit, sun_shadow,
}
use mesh::volume::{FroxelVolume, froxel_volume, hdr_tone_fs}
use picture::eye::{Eye, View, view}
use picture::look::Look
use picture::picture::{Picture, picture}
use picture::screen::{cover, show}
use std::collections::Vec
use std::field::Field
use std::gpu::{
    Address, ClipPosition, Compare, ComparisonSampler, Cull, Depth, DepthBias, DepthOnlyPass,
    DepthTexture, Filter, FragCoord, MsaaDepthPass, MsaaDepthPass3, R8, Rgba16Float, Rgba32Float,
    Sampler, Targets3, Texture, Texture3d, VertexIndex, begin_depth_pass, begin_pass,
    begin_pass3_msaa_with_depth, begin_pass_msaa_with_depth, comparison_sampler, depth_texture,
    dispatch, draw, label, sampler, texture, writable_texture,
}
use std::hash::StateHash

/// Reversed-Z near plane (m): `clip_z = NEAR`, `clip_w = z`, so `ndc_z = NEAR / z` in `(0, 1]`.
pub const NEAR: f32 = 0.005

/// Default maximum active surface bricks per batch.
const BATCH_BRICKS: u32 = 8192

/// Distance threshold (m) beyond which `Many` things refresh on alternating 30 Hz frames while
/// foreground things refresh every frame (60 Hz).
const FAR_TIER_DIST: f32 = 9.0

/// Vertex shader for the unified shadow depth pass: projects `MeshVertex` into orthographic sun space.
@vertex
fn shadow_vs(verts: [MeshVertex], sv: ShadowView, vi: VertexIndex) -> ClipPosition {
    let wp = verts[vi.index].pos.xyz
    let d = wp - sv.centre
    let sx = dot(d, sv.u) / sv.radius
    let sy = dot(d, sv.v) / sv.radius
    let sz = (sv.radius - dot(d, sv.w)) / (2.0 * sv.radius)
    ClipPosition { position: vec4(sx, sy, sz, 1.0) }
}

/// Depth-only fragment shader for the shadow pass (colour output is ignored by `DepthOnlyPass`).
@fragment
fn shadow_fs() -> vec4 {
    vec4(0.0)
}

/// Vertex shader for the unified eye pass: matches `View::ray` bit-for-bit with reversed-Z depth.
@vertex
fn mesh_vs(verts: [MeshVertex], v: View, vi: VertexIndex) -> MeshVary {
    let vert = verts[vi.index]
    let wp = vert.pos.xyz
    let rel = wp - v.at
    let x = dot(rel, v.right)
    let y = dot(rel, v.up)
    let z = dot(rel, v.forward)
    let aspect = v.size.y / max(v.size.x, 1.0)
    let clip = ClipPosition { position: vec4(x * v.focal * aspect, y * v.focal, NEAR, z) }
    MeshVary {
        clip,
        wp,
        normal: vert.normal.xyz,
        albedo: vert.albedo.xyz,
        emits: vert.emits.xyz,
        smooth: vert.normal.w,
    }
}

/// Shared linear-HDR shading computation for both surface meshlets and clipmap heightfields:
/// crease-preserving normals, unified sun shadow, and unified world-space radiance cache (sky
/// occlusion + multi-bounce GI + emissive glow). Outputs linear physical radiance; `Look::tone`
/// runs once at the end of the frame after volumetric compositing.
fn shade_mesh<S: Sky>(
    vary: MeshVary,
    v: View,
    sv: ShadowView,
    rad_grid: RadGrid,
    sky: S,
    table: Texture<Rgba16Float>,
    s: Sampler,
    shadow_map: DepthTexture,
    cmp: ComparisonSampler,
    rad0: Texture3d<Rgba16Float>,
    rad1: Texture3d<Rgba16Float>,
    rad2: Texture3d<Rgba16Float>,
    rad_s: Sampler,
) -> (vec4, vec4, f32) {
    let to_eye = v.at - vary.wp
    let dist = length(to_eye)
    let ray_back = if dist > 1.0e-6 { to_eye / dist } else { -v.forward }

    let nv_l2 = dot(vary.normal, vary.normal)
    let nv = if nv_l2 > 1.0e-12 { vary.normal * (1.0 / sqrt(nv_l2)) } else { ray_back }

    // Geometric face normal from screen-space derivatives of world position: keeps 90° box corners
    // and sharp creases exact while smooth curved surfaces keep interpolated analytic normals.
    let fraw = cross(dpdx(vary.wp), dpdy(vary.wp))
    let fl2 = dot(fraw, fraw)
    var nf = nv
    if fl2 > 1.0e-18 {
        nf = fraw * (1.0 / sqrt(fl2))
        if dot(nf, ray_back) < 0.0 {
            nf = -nf
        }
    }
    let n = if vary.smooth < 0.5 || dot(nv, nf) < 0.85 { nf } else { nv }

    let sun = sky.sun()
    let ndl = max(dot(n, sun.way), 0.0)
    let vis = if ndl > 0.0 { sun_shadow(shadow_map, cmp, sv, vary.wp, n) } else { 0.0 }
    let direct = sun.light * (ndl * vis)
    let ind = cone_indirect(rad_grid, rad0, rad1, rad2, rad_s, vary.wp, n)
    let amb = sky_irradiance(table, s, n) * ind.w + ind.xyz
    let rad = vary.emits + vary.albedo * ONE_OVER_PI * (direct + amb)
    (vec4(rad, 1.0), vec4(n, dist), vis)
}

/// Colour-only linear-HDR fragment shader for the 4× MSAA eye pass (12 B/sample total).
@fragment
fn mesh_fs<S: Sky>(
    vary: MeshVary,
    v: View,
    sv: ShadowView,
    rad_grid: RadGrid,
    sky: S,
    table: Texture<Rgba16Float>,
    s: Sampler,
    shadow_map: DepthTexture,
    cmp: ComparisonSampler,
    rad0: Texture3d<Rgba16Float>,
    rad1: Texture3d<Rgba16Float>,
    rad2: Texture3d<Rgba16Float>,
    rad_s: Sampler,
) -> vec4 {
    shade_mesh(vary, v, sv, rad_grid, sky, table, s, shadow_map, cmp, rad0, rad1, rad2, rad_s).0
}

/// Multi-target linear-HDR fragment shader for `drawn_only` (writes `(hdr, place, sun)` for `Judge`).
@fragment
fn mesh_judge_fs<S: Sky>(
    vary: MeshVary,
    v: View,
    sv: ShadowView,
    rad_grid: RadGrid,
    sky: S,
    table: Texture<Rgba16Float>,
    s: Sampler,
    shadow_map: DepthTexture,
    cmp: ComparisonSampler,
    rad0: Texture3d<Rgba16Float>,
    rad1: Texture3d<Rgba16Float>,
    rad2: Texture3d<Rgba16Float>,
    rad_s: Sampler,
) -> Targets3<vec4, vec4, f32> {
    let out = shade_mesh(vary, v, sv, rad_grid, sky, table, s, shadow_map, cmp, rad0, rad1, rad2, rad_s)
    Targets3 { first: out.0, second: out.1, third: out.2 }
}

/// Fullscreen background sky shader: runs only on uncovered pixels (`Depth::Equal` at `z = 0.0`).
@vertex
fn sky_vs(vi: VertexIndex) -> ClipPosition {
    let x = f32(vi.index % 2) * 4.0 - 1.0
    let y = f32(vi.index / 2) * 4.0 - 1.0
    ClipPosition { position: vec4(x, y, 0.0, 1.0) }
}

@fragment
fn sky_fs<S: Sky>(pixel: FragCoord, v: View, sky: S) -> vec4 {
    let d = v.ray(pixel.position.xy)
    vec4(seen(sky, d), 1.0)
}

@fragment
fn sky_judge_fs<S: Sky>(pixel: FragCoord, v: View, sky: S) -> Targets3<vec4, vec4, f32> {
    let d = v.ray(pixel.position.xy)
    Targets3 {
        first: vec4(seen(sky, d), 1.0),
        second: vec4(0.0, 0.0, 0.0, 0.0),
        third: 1.0,
    }
}

/// Computes a view- and budget-aware cell spacing for a single thing with bounding sphere `(c, r)`.
fn cell_for_one(c: vec3, r: f32, v: View) -> f32 {
    let near = max(length(c - v.at) - r, 0.25)
    let px = near * v.pixel()
    // Keep thin features (down to 5 mm) when near the eye, while respecting the batch brick budget.
    let by_size = max(r / 180.0, 0.005)
    clamp(max(px * 1.1, by_size), 0.005, 0.25)
}

/// Computes a view- and budget-aware cell spacing for one thing in a `Many` batch, given its
/// allocated brick share `bricks_for_this`.
fn cell_for_share(c: vec3, r: f32, bricks_for_this: f32, v: View) -> f32 {
    let near = max(length(c - v.at) - r, 0.25)
    let px = near * v.pixel()
    let per_thing = max(bricks_for_this, 4.0)
    // Account for articulated surface area and interval-box padding so active bricks stay within cap.
    let by_budget = r / max(sqrt(per_thing * 2.5), 3.5)
    clamp(max(px * 1.2, by_budget), 0.006, 0.25)
}

/// Any world (`One`, `Many`, `And`) that can sync its GPU meshlet batches.
pub trait MeshWorld: Copy {
    fn batch_count(self) -> u32
    fn sync_batches(self, batches: mut Vec<MeshBatch>, first: u32, v: View, frame: u32)
}

impl<M: Field<Substance> + StateHash + GpuData> MeshWorld for One<M> {
    fn batch_count(self) -> u32 {
        1
    }

    fn sync_batches(self, batches: mut Vec<MeshBatch>, first: u32, v: View, _frame: u32) {
        let b = self.field.bound()
        let cell = cell_for_one(b.centre, min(b.radius, 1.0e4), v)
        batches[first].sync_one(self.field, cell)
    }
}

/// Whether a sphere `(c, r)` intersects the view frustum (with a generous margin so shadow-casting
/// silhouettes just off-screen stay included).
fn in_view(c: vec3, r: f32, v: View) -> bool {
    let rel = c - v.at
    let z = dot(rel, v.forward)
    if z + r < NEAR {
        return false
    }
    let aspect = v.size.x / max(v.size.y, 1.0)
    let half_y = max(z, 0.0) / v.focal + r * 1.4
    let half_x = half_y * aspect + r * 1.4
    abs(dot(rel, v.up)) <= half_y && abs(dot(rel, v.right)) <= half_x
}

impl<M: Field<Substance> + StateHash + GpuData, const N: u32> MeshWorld for Many<M, N> {
    fn batch_count(self) -> u32 {
        if N >= 16 { 3 } else { 1 }
    }

    fn sync_batches(self, batches: mut Vec<MeshBatch>, first: u32, v: View, frame: u32) {
        let cap = batches[first].cap_bricks
        // Weight brick budget by approximate screen area (r / near)² so foreground things get fine
        // detail while distant things stay lean and fast.
        var total_w = 0.0
        for i in 0..N {
            let b = self.fields[i].bound()
            let r = min(b.radius, 1.0e4)
            if in_view(b.centre, r, v) {
                let near = max(length(b.centre - v.at) - r, 0.25)
                let s = r / near
                total_w += clamp(s * s, 0.002, 4.0)
            }
        }
        let inv_w = if total_w > 1.0e-6 { f32(cap) / total_w } else { f32(cap) }

        if N < 16 {
            var cells = [0.0; N]
            for i in 0..N {
                let b = self.fields[i].bound()
                let r = min(b.radius, 1.0e4)
                if in_view(b.centre, r, v) {
                    let near = max(length(b.centre - v.at) - r, 0.25)
                    let s = r / near
                    let share = clamp(s * s, 0.002, 4.0) * inv_w
                    cells[i] = cell_for_share(b.centre, r, share, v)
                }
            }
            batches[first].sync_many(self.fields, cells)
            return
        }

        // 2-tier glitch-free staggered refresh for large crowds:
        //   tier 0 (`first + 0`): foreground things (<= FAR_TIER_DIST m), refreshed every frame (60 Hz).
        //   tier 1 (`first + 1`): far even-index things, refreshed on even frames (30 Hz) & frame 0.
        //   tier 2 (`first + 2`): far odd-index things, refreshed on odd frames (30 Hz) & frame 0.
        // A thing only transitions into/out of a far tier on a frame that tier refreshes, so nothing
        // is ever double-drawn or skipped for a frame.
        let init_tiers = batches[first].tiers.len() != N
        if init_tiers {
            batches[first].tiers = Vec::new()
            for _i in 0..N {
                batches[first].tiers.push(0)
            }
        }
        let update_even = init_tiers || frame == 0 || (frame & 1) == 0
        let update_odd = init_tiers || frame == 0 || (frame & 1) == 1

        var c_near = [0.0; N]
        var c_even = [0.0; N]
        var c_odd = [0.0; N]
        for i in 0..N {
            let b = self.fields[i].bound()
            let r = min(b.radius, 1.0e4)
            let vis = in_view(b.centre, r, v)
            let near = max(length(b.centre - v.at) - r, 0.25)
            let far_slot: u32 = if (i & 1) == 0 { 1 } else { 2 }
            let want_tier: u32 = if !vis {
                far_slot
            } else if near <= FAR_TIER_DIST {
                0
            } else {
                far_slot
            }
            var cur = if init_tiers { want_tier } else { batches[first].tiers[i] }
            let can_change = (cur == 0 && (want_tier == 0 || (want_tier == 1 && update_even) || (want_tier == 2 && update_odd)))
                || (cur == 1 && update_even)
                || (cur == 2 && update_odd)
            if can_change {
                cur = want_tier
                batches[first].tiers[i] = cur
            }
            if vis {
                let s = r / near
                let share = clamp(s * s, 0.002, 4.0) * inv_w
                let cell = cell_for_share(b.centre, r, share, v)
                if cur == 0 {
                    c_near[i] = cell
                } else if cur == 1 {
                    c_even[i] = cell
                } else {
                    c_odd[i] = cell
                }
            }
        }
        batches[first].sync_many(self.fields, c_near)
        if update_even {
            batches[first + 1].sync_many(self.fields, c_even)
        }
        if update_odd {
            batches[first + 2].sync_many(self.fields, c_odd)
        }
    }
}

impl<A: MeshWorld, B: MeshWorld> MeshWorld for And<A, B> {
    fn batch_count(self) -> u32 {
        self.a.batch_count() + self.b.batch_count()
    }

    fn sync_batches(self, batches: mut Vec<MeshBatch>, first: u32, v: View, frame: u32) {
        let na = self.a.batch_count()
        self.a.sync_batches(mut batches, first, v, frame)
        self.b.sync_batches(mut batches, first + na, v, frame)
    }
}

/// Complete meshlet renderer state: owns extracted batches, shadow map, sky irradiance table,
/// unified world-space radiance cache (GI + sky occlusion + emissive glow), volumetric froxel
/// grid, linear HDR colour + resolved eye depth buffer, and tone-mapped `Picture`.
pub struct MeshSight {
    pub drawn: Picture,
    pub hdr_colour: Texture<Rgba16Float>,
    pub depth: DepthTexture,
    pub rad: RadianceCache,
    pub vol: FroxelVolume,
    batches: Vec<MeshBatch>,
    shadow_depth: DepthTexture,
    cmp: ComparisonSampler,
    sky_table: Texture<Rgba16Float>,
    sky_sampler: Sampler,
    sky_sun: vec3,
    sky_ready: bool,
    frame: u32,
    pub gi: bool,
}

/// Creates a fresh `MeshSight` using 4× hardware MSAA, unified world-space GI, and froxel volumetrics.
pub fn mesh_sight(gi: bool = true) -> MeshSight {
    MeshSight {
        drawn: picture(width: 1, height: 1),
        hdr_colour: texture(width: 1, height: 1),
        depth: depth_texture(width: 1, height: 1),
        rad: radiance_cache(),
        vol: froxel_volume(),
        batches: Vec::new(),
        shadow_depth: depth_texture(width: SHADOW_SIDE, height: SHADOW_SIDE),
        cmp: comparison_sampler(compare: Compare::LessEqual),
        sky_table: writable_texture(width: TABLE, height: TABLE),
        sky_sampler: sampler(filter: Filter::Linear, address: Address::Clamp),
        sky_sun: vec3(0.0),
        sky_ready: false,
        frame: 0,
        gi: gi,
    }
}

impl MeshSight {
    fn resize(mut self, width: u32, height: u32) {
        if self.drawn.width() != width || self.drawn.height() != height {
            self.drawn = picture(width: width, height: height)
            self.drawn.placed = true
            self.hdr_colour = texture(width: width, height: height)
            self.depth = depth_texture(width: width, height: height)
        }
    }

    fn ensure_batches(mut self, count: u32) {
        while self.batches.len() < count {
            self.batches.push(mesh_batch(BATCH_BRICKS))
        }
    }

    /// Updates sky irradiance, syncs extracted GPU meshlets, and renders the unified sun shadow
    /// map. Returns `(batch_count, view, shadow_view)`.
    fn prepare_and_shadow<W: MeshWorld, S: Sky>(
        mut self,
        world: W,
        sky: S,
        eye: Eye,
        width: u32,
        height: u32,
        frame: u32,
    ) -> (u32, View, ShadowView) {
        self.resize(width, height)
        let v = view(eye, width: width, height: height)

        // Update sky irradiance table only when sky changes (0 ms/frame when still).
        let sun_way = sky.sun().way
        if !self.sky_ready || length(sun_way - self.sky_sun) > 1.0e-6 {
            label("mesh_sky")
            dispatch(skylit.bind(sky: sky, out: mut self.sky_table), over: (TABLE, TABLE))
            self.sky_sun = sun_way
            self.sky_ready = true
        }

        // Sync extracted GPU meshlets for every batch in the world.
        let nb = world.batch_count()
        self.ensure_batches(nb)
        world.sync_batches(mut self.batches, 0, v, frame)

        // Compute combined world bounding sphere for the unified sun shadow map.
        var wlo = vec3(1.0e20)
        var whi = vec3(-1.0e20)
        for i in 0..nb {
            let b = self.batches[i].bound
            if b.w > 0.0 {
                wlo = min(wlo, b.xyz - vec3(b.w))
                whi = max(whi, b.xyz + vec3(b.w))
            }
        }
        let wmid = 0.5 * (wlo + whi)
        let wrad = if whi.x > wlo.x { 0.5 * length(whi - wlo) } else { 10.0 }
        let sv = shadow_view(wmid, wrad, sky.sun().way)

        // Pass 1: Unified sun shadow map (all still + moving meshlets in one pass).
        label("mesh_shadow")
        let sp: DepthOnlyPass = begin_depth_pass(mut self.shadow_depth, clear_depth: 1.0, keep_depth: false)
        for i in 0..nb {
            draw(
                sp,
                shadow_vs.bind(verts: self.batches[i].verts.items(), sv: sv),
                shadow_fs,
                indices: self.batches[i].indices,
                indirect: self.batches[i].draw_args,
                cull: Cull::Back,
                depth_bias: DepthBias { constant: 2, slope: 1.5, clamp: 0.0 },
                depth: Depth { compare: Compare::Less, write: true },
            )
        }
        sp.end()

        // Pass 1b: Rebuild unified world-space radiance cache from all extracted still & moving
        // meshlets (sky occlusion, multi-bounce diffuse GI, emissive spell glow).
        self.rad.begin(wmid, wrad, enabled: self.gi)
        if self.gi {
            for i in 0..nb {
                self.rad.inject(
                    self.batches[i].verts.items(),
                    self.batches[i].verts.count(),
                    self.batches[i].cap_verts,
                    sv,
                    sky,
                    self.sky_table,
                    self.sky_sampler,
                    self.shadow_depth,
                    self.cmp,
                )
            }
            self.rad.finish()
        }
        (nb, v, sv)
    }

    /// Renders `world` into `self.drawn` (`colour`, `place`, `sun`) without presenting (for
    /// judging against `Reference`).
    pub fn drawn_only<W: MeshWorld, S: Sky, L: Look>(
        mut self,
        world: W,
        sky: S,
        look: L,
        eye: Eye,
        width: u32,
        height: u32,
    ) {
        let (nb, v, sv) = self.prepare_and_shadow(world, sky, eye, width, height, 0)

        // Pass 2: Unified 4× hardware MSAA eye pass writing linear HDR + `(place, sun)` + depth.
        label("mesh_eye")
        let ep: MsaaDepthPass3<Rgba16Float, Rgba32Float, R8> = begin_pass3_msaa_with_depth(
            mut self.hdr_colour,
            mut self.drawn.place,
            mut self.drawn.sun,
            mut self.depth,
            clear: vec4(0.0, 0.0, 0.0, 1.0),
            clear_depth: 0.0,
        )
        for i in 0..nb {
            draw(
                ep,
                mesh_vs.bind(verts: self.batches[i].verts.items(), v: v),
                mesh_judge_fs.bind(
                    v: v,
                    sv: sv,
                    rad_grid: self.rad.grid,
                    sky: sky,
                    table: self.sky_table,
                    s: self.sky_sampler,
                    shadow_map: self.shadow_depth,
                    cmp: self.cmp,
                    rad0: self.rad.rad0,
                    rad1: self.rad.rad1,
                    rad2: self.rad.rad2,
                    rad_s: self.rad.s,
                ),
                indices: self.batches[i].indices,
                indirect: self.batches[i].draw_args,
                cull: Cull::Back,
                depth: Depth { compare: Compare::Greater, write: true },
            )
        }
        draw(
            ep,
            sky_vs,
            sky_judge_fs.bind(v: v, sky: sky),
            vertices: 3,
            depth: Depth { compare: Compare::Equal, write: false },
        )
        ep.end()

        // Pass 3: Single unified `Look::tone` pass into `self.drawn.colour`.
        label("mesh_tone")
        let tp = begin_pass(mut self.drawn.colour, keep: false)
        draw(
            tp,
            cover,
            hdr_tone_fs.bind(
                hdr: self.hdr_colour,
                depth: self.depth,
                froxel_acc: self.vol.acc,
                vol_s: self.vol.s,
                vol_active: 0,
                near_plane: NEAR,
                v: v,
                look: look,
            ),
            vertices: 3,
        )
        tp.end()
        self.drawn.placed = true
    }

    /// Renders `world` (`Surface`s), `height` (`Height` clipmap), and `medium` (`Medium` froxels)
    /// through ONE depth buffer, ONE light store, and ONE `Look::tone` pass, and presents.
    pub fn draw_all<W: MeshWorld, H: Height, Med: Medium, S: Sky, L: Look>(
        mut self,
        world: W,
        height: H,
        medium: Med,
        sky: S,
        look: L,
        eye: Eye,
        width: u32,
        height_px: u32,
    ) {
        let (nb, v, sv) = self.prepare_and_shadow(world, sky, eye, width, height_px, self.frame)
        self.frame += 1

        // Pass 2: Unified 4× hardware MSAA linear-HDR eye pass (solids + height clipmap + sky).
        label("mesh_eye")
        let ep: MsaaDepthPass<Rgba16Float> = begin_pass_msaa_with_depth(
            mut self.hdr_colour,
            mut self.depth,
            clear: vec4(0.0, 0.0, 0.0, 1.0),
            clear_depth: 0.0,
        )
        for i in 0..nb {
            draw(
                ep,
                mesh_vs.bind(verts: self.batches[i].verts.items(), v: v),
                mesh_fs.bind(
                    v: v,
                    sv: sv,
                    rad_grid: self.rad.grid,
                    sky: sky,
                    table: self.sky_table,
                    s: self.sky_sampler,
                    shadow_map: self.shadow_depth,
                    cmp: self.cmp,
                    rad0: self.rad.rad0,
                    rad1: self.rad.rad1,
                    rad2: self.rad.rad2,
                    rad_s: self.rad.s,
                ),
                indices: self.batches[i].indices,
                indirect: self.batches[i].draw_args,
                cull: Cull::Back,
                depth: Depth { compare: Compare::Greater, write: true },
            )
        }
        if height.active() {
            draw(
                ep,
                height_vs.bind(height: height, v: v),
                mesh_fs.bind(
                    v: v,
                    sv: sv,
                    rad_grid: self.rad.grid,
                    sky: sky,
                    table: self.sky_table,
                    s: self.sky_sampler,
                    shadow_map: self.shadow_depth,
                    cmp: self.cmp,
                    rad0: self.rad.rad0,
                    rad1: self.rad.rad1,
                    rad2: self.rad.rad2,
                    rad_s: self.rad.s,
                ),
                vertices: CLIP_VERTS,
                instances: CLIP_RINGS,
                cull: Cull::Back,
                depth: Depth { compare: Compare::Greater, write: true },
            )
        }
        draw(
            ep,
            sky_vs,
            sky_fs.bind(v: v, sky: sky),
            vertices: 3,
            depth: Depth { compare: Compare::Equal, write: false },
        )
        ep.end()

        // Pass 2b: Unified volumetric froxel pass (0 ms when `medium.active()` is false).
        let has_vol = medium.active()
        if has_vol {
            self.vol.update(
                medium,
                v,
                sv,
                self.rad.grid,
                sky,
                self.sky_table,
                self.sky_sampler,
                self.shadow_depth,
                self.cmp,
                self.rad.rad1,
                self.rad.rad2,
                self.rad.s,
            )
        }

        // Pass 3: Unified volumetric composite + ONE `Look::tone` pass.
        label("mesh_tone")
        let tp = begin_pass(mut self.drawn.colour, keep: false)
        draw(
            tp,
            cover,
            hdr_tone_fs.bind(
                hdr: self.hdr_colour,
                depth: self.depth,
                froxel_acc: self.vol.acc,
                vol_s: self.vol.s,
                vol_active: if has_vol { 1 } else { 0 },
                near_plane: NEAR,
                v: v,
                look: look,
            ),
            vertices: 3,
        )
        tp.end()
        self.drawn.placed = false
        show(self.drawn.colour)
    }

    /// Renders `world` with 4× hardware MSAA, One Light GI, and One `Look`, and presents.
    pub fn draw<W: MeshWorld, S: Sky, L: Look>(
        mut self,
        world: W,
        sky: S,
        look: L,
        eye: Eye,
        width: u32,
        height: u32,
    ) {
        self.draw_all(world, NoHeight {}, NoMedium {}, sky, look, eye, width, height)
    }
}
