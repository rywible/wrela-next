// Unified hardware rasterization of extracted surface meshlets (`extract`) and clipmap heightfields
// (`height`): one physically-based shading model, one shadow map, one GPU Sky PMREM cache, one
// world-space radiance volume + auto-extracted dynamic local emitters, one refractive/transmissive
// pass (glass/water/crystal), one volumetric froxel pass, one optical HDR bloom pyramid, and one
// `Look::tone` pass.

use matter::height::{Height, NoHeight}
use matter::medium::{Medium, NoMedium}
use matter::sky::{Sky, seen}
use matter::substance::{
    ONE_OVER_PI, Substance, env_brdf_approx, fresnel_schlick_rough,
}
use matter::world::{And, Many, One}
use mesh::extract::{MeshBatch, MeshVertex, mesh_batch}
use mesh::height::{CLIP_RINGS, CLIP_VERTS, MeshVary, height_vs}
use mesh::light::{
    Emitter, RadGrid, RadianceCache, SHADOW_SIDE, ShadowView, SkyCache, cone_indirect,
    eval_emitters, radiance_cache, shadow_view, sky_background, sky_cache, sky_irradiance,
    sky_specular, spec_cone, sun_shadow,
}
use mesh::volume::{
    BloomPyramid, FroxelVolume, bloom_pyramid, froxel_volume, hdr_tone_fs,
}
use picture::eye::{Eye, View, view}
use picture::look::Look
use picture::picture::{Picture, picture}
use picture::screen::{cover, show}
use std::collections::Vec
use std::field::Field
use std::gpu::{
    Address, ClipPosition, Compare, ComparisonSampler, Cull, Depth, DepthBias, DepthOnlyPass,
    DepthPass, DepthTexture, Filter, FragCoord, MsaaDepthPass, MsaaDepthPass3, R8, Rgba16Float,
    Rgba32Float, Sampler, Targets3, Texture, Texture3d, VertexIndex, begin_depth_pass, begin_pass,
    begin_pass3_msaa_with_depth, begin_pass_msaa_with_depth, begin_pass_with_depth,
    comparison_sampler, copy_texture, depth_texture, discard, draw, label, sampler, texture,
}
use std::hash::StateHash

/// Reversed-Z near plane (m): `clip_z = NEAR`, `clip_w = z`, so `ndc_z = NEAR / z` in `(0, 1]`.
pub const NEAR: f32 = 0.005

/// Default maximum active surface bricks per batch.
const BATCH_BRICKS: u32 = 8192

/// Distance threshold (m) beyond which `Many` things refresh on alternating 30 Hz frames while
/// foreground things refresh every frame (60 Hz).
const FAR_TIER_DIST: f32 = 9.0

/// Vertex shader for the unified shadow depth pass: projects `MeshVertex` into orthographic sun space.
@vertex
fn shadow_vs(verts: [MeshVertex], sv: ShadowView, vi: VertexIndex) -> ClipPosition {
    let wp = verts[vi.index].pos.xyz
    let d = wp - sv.centre
    let sx = dot(d, sv.u) / sv.radius
    let sy = dot(d, sv.v) / sv.radius
    let sz = (sv.radius - dot(d, sv.w)) / (2.0 * sv.radius)
    ClipPosition { position: vec4(sx, sy, sz, 1.0) }
}

/// Depth-only fragment shader for the shadow pass (colour output is ignored by `DepthOnlyPass`).
@fragment
fn shadow_fs() -> vec4 {
    vec4(0.0)
}

/// Vertex shader for the unified eye pass: matches `View::ray` bit-for-bit with reversed-Z depth.
@vertex
fn mesh_vs(verts: [MeshVertex], v: View, vi: VertexIndex) -> MeshVary {
    let vert = verts[vi.index]
    let wp = vert.pos.xyz
    let rel = wp - v.at
    let x = dot(rel, v.right)
    let y = dot(rel, v.up)
    let z = dot(rel, v.forward)
    let aspect = v.size.y / max(v.size.x, 1.0)
    let clip = ClipPosition { position: vec4(x * v.focal * aspect, y * v.focal, NEAR, z) }
    MeshVary {
        clip,
        wp,
        normal: vert.normal.xyz,
        albedo: vert.albedo.xyz,
        emits: vert.emits.xyz,
        pbr: vec4(vert.normal.w, vert.albedo.w, vert.emits.w, vert.pos.w),
        optics: vert.optics,
    }
}

/// Reconstructs the interpolated physical `Substance` from `MeshVary`.
fn vary_substance(vary: MeshVary) -> Substance {
    Substance {
        albedo: clamp(vary.albedo, vec3(0.0), vec3(1.0)),
        roughness: clamp(vary.pbr.x, 0.02, 1.0),
        emits: max(vary.emits, vec3(0.0)),
        metallic: clamp(vary.pbr.y, 0.0, 1.0),
        ior: max(vary.pbr.z, 1.0),
        transmission: clamp(vary.optics.x, 0.0, 1.0),
        subsurface: clamp(vary.optics.y, 0.0, 1.0),
        coat: clamp(vary.optics.z, 0.0, 1.0),
    }
}

/// Resolves crease-preserving shading normal from interpolated analytic normal and face derivatives.
fn resolve_normal(vary: MeshVary, ray_back: vec3) -> vec3 {
    let nv_l2 = dot(vary.normal, vary.normal)
    let nv = if nv_l2 > 1.0e-12 { vary.normal * (1.0 / sqrt(nv_l2)) } else { ray_back }
    let fraw = cross(dpdx(vary.wp), dpdy(vary.wp))
    let fl2 = dot(fraw, fraw)
    var nf = nv
    if fl2 > 1.0e-18 {
        nf = fraw * (1.0 / sqrt(fl2))
        if dot(nf, ray_back) < 0.0 {
            nf = -nf
        }
    }
    if vary.pbr.w < 0.5 || dot(nv, nf) < 0.85 { nf } else { nv }
}

/// Shared physically-based linear-HDR shading for opaque solids and terrain heightfields:
/// Cook-Torrance GGX specular + Schlick Fresnel + Clearcoat + Subsurface wrap + unified sun shadow
/// + auto-extracted dynamic local emitters + 3-level radiance volume GI + GPU Sky PMREM.
/// Outputs `(vec4(linear_hdr, eye_dist), vec4(normal, eye_dist), sun_vis)`.
@budget(work: 18000)
fn shade_mesh<S: Sky>(
    vary: MeshVary,
    v: View,
    sv: ShadowView,
    rad_grid: RadGrid,
    sky: S,
    sky_diff: Texture<Rgba16Float>,
    sky_spec0: Texture<Rgba16Float>,
    sky_spec1: Texture<Rgba16Float>,
    sky_spec2: Texture<Rgba16Float>,
    sky_s: Sampler,
    shadow_map: DepthTexture,
    cmp: ComparisonSampler,
    rad0: Texture3d<Rgba16Float>,
    rad1: Texture3d<Rgba16Float>,
    rad2: Texture3d<Rgba16Float>,
    rad_s: Sampler,
    emitters: [Emitter],
    emitter_count: [u32],
) -> (vec4, vec4, f32) {
    let to_eye = v.at - vary.wp
    let dist = length(to_eye)
    let ray_back = if dist > 1.0e-6 { to_eye / dist } else { -v.forward }
    let n = resolve_normal(vary, ray_back)
    let sub = vary_substance(vary)

    let sun = sky.sun()
    let ndl = max(dot(n, sun.way), 0.0)
    let vis = if ndl > 0.0 { sun_shadow(shadow_map, cmp, sv, vary.wp, n) } else { 0.0 }
    let direct_sun = sub.shade_direct(n, sun.way, ray_back, sun.light * vis)
    let local_light = eval_emitters(sub, vary.wp, n, ray_back, rad_grid, rad0, rad1, rad_s, emitters, emitter_count)

    let ind = cone_indirect(rad_grid, rad0, rad1, rad2, rad_s, vary.wp, n)
    let sky_amb = sky_irradiance(sky_diff, sky_s, n) * ind.w + ind.xyz

    let sw = sub.spec_weight()
    var rad = sub.emits + direct_sun + local_light
    if sw <= 1.0e-5 && sub.coat <= 1.0e-5 {
        // Pure matte fast path: zero specular environment fetches (bit-identical to Lambertian).
        rad += sub.albedo * ONE_OVER_PI * sky_amb
    } else {
        let ndv = max(dot(n, ray_back), 0.001)
        let refl = normalize(n * (2.0 * dot(n, ray_back)) - ray_back)
        let f0 = sub.f0()
        let f_env = fresnel_schlick_rough(f0, ndv, sub.roughness) * sw
        let kd = (vec3(1.0) - f_env) * (1.0 - sub.metallic)
        let brdf_ab = env_brdf_approx(sub.roughness, ndv)
        let sky_refl = sky_specular(sky_spec0, sky_spec1, sky_spec2, sky_diff, sky_s, refl, sub.roughness)
        let w_refl = spec_cone(rad_grid, rad0, rad1, rad2, rad_s, vary.wp, n, refl, sub.roughness)
        // Specular occlusion attenuates distant sky reflections inside occluded cavities while
        // preserving near-field world reflections.
        let spec_occ = clamp(ind.w + (1.0 - sub.roughness) * 0.25, 0.15, 1.0)
        let env_spec = w_refl.xyz + sky_refl * (1.0 - w_refl.w * 0.85) * spec_occ
        var indirect = sub.albedo * (kd * ONE_OVER_PI) * sky_amb + env_spec * (f0 * brdf_ab.x + vec3(brdf_ab.y)) * sw

        if sub.coat > 1.0e-4 {
            let fc = fresnel_schlick_rough(vec3(0.04), ndv, 0.06).x * sub.coat
            let coat_sky = sky_specular(sky_spec0, sky_spec1, sky_spec2, sky_diff, sky_s, refl, 0.06)
            let coat_env = w_refl.xyz * 0.65 + coat_sky * (1.0 - w_refl.w * 0.65) * spec_occ
            indirect = indirect * (1.0 - fc) + coat_env * fc
        }
        rad += indirect
    }
    (vec4(rad, min(dist, 65000.0)), vec4(n, dist), vis)
}

/// Colour-only linear-HDR fragment shader for opaque meshlets (no `discard()` -> full hardware Early-Z).
@fragment
fn mesh_fs<S: Sky>(
    vary: MeshVary,
    v: View,
    sv: ShadowView,
    rad_grid: RadGrid,
    sky: S,
    sky_diff: Texture<Rgba16Float>,
    sky_spec0: Texture<Rgba16Float>,
    sky_spec1: Texture<Rgba16Float>,
    sky_spec2: Texture<Rgba16Float>,
    sky_s: Sampler,
    shadow_map: DepthTexture,
    cmp: ComparisonSampler,
    rad0: Texture3d<Rgba16Float>,
    rad1: Texture3d<Rgba16Float>,
    rad2: Texture3d<Rgba16Float>,
    rad_s: Sampler,
    emitters: [Emitter],
    emitter_count: [u32],
) -> vec4 {
    shade_mesh(
        vary, v, sv, rad_grid, sky, sky_diff, sky_spec0, sky_spec1, sky_spec2, sky_s,
        shadow_map, cmp, rad0, rad1, rad2, rad_s, emitters, emitter_count,
    ).0
}

/// Opaque clipmap heightfield shader (defers transmissive water fragments to `mesh_trans_fs`).
@fragment
fn height_opaque_fs<S: Sky>(
    vary: MeshVary,
    v: View,
    sv: ShadowView,
    rad_grid: RadGrid,
    sky: S,
    sky_diff: Texture<Rgba16Float>,
    sky_spec0: Texture<Rgba16Float>,
    sky_spec1: Texture<Rgba16Float>,
    sky_spec2: Texture<Rgba16Float>,
    sky_s: Sampler,
    shadow_map: DepthTexture,
    cmp: ComparisonSampler,
    rad0: Texture3d<Rgba16Float>,
    rad1: Texture3d<Rgba16Float>,
    rad2: Texture3d<Rgba16Float>,
    rad_s: Sampler,
    emitters: [Emitter],
    emitter_count: [u32],
) -> vec4 {
    if vary.optics.x > 0.02 {
        discard()
    }
    shade_mesh(
        vary, v, sv, rad_grid, sky, sky_diff, sky_spec0, sky_spec1, sky_spec2, sky_s,
        shadow_map, cmp, rad0, rad1, rad2, rad_s, emitters, emitter_count,
    ).0
}

/// Physically-based refractive / transmissive fragment shader for glass, water, crystal, and ice:
/// Snell screen-space refraction over the resolved opaque HDR buffer, Beer-Lambert depth absorption
/// (`hdr_bg.w - dist`), rough frosted-glass sampling, Schlick Fresnel reflection from Sky PMREM +
/// radiance volume, and crisp GGX specular highlights from sun and dynamic spell emitters.
@fragment
@budget(work: 20000)
fn mesh_trans_fs<S: Sky>(
    pixel: FragCoord,
    vary: MeshVary,
    v: View,
    sv: ShadowView,
    rad_grid: RadGrid,
    sky: S,
    sky_diff: Texture<Rgba16Float>,
    sky_spec0: Texture<Rgba16Float>,
    sky_spec1: Texture<Rgba16Float>,
    sky_spec2: Texture<Rgba16Float>,
    sky_s: Sampler,
    shadow_map: DepthTexture,
    cmp: ComparisonSampler,
    rad0: Texture3d<Rgba16Float>,
    rad1: Texture3d<Rgba16Float>,
    rad2: Texture3d<Rgba16Float>,
    rad_s: Sampler,
    emitters: [Emitter],
    emitter_count: [u32],
    hdr_bg: Texture<Rgba16Float>,
    bg_s: Sampler,
) -> vec4 {
    if vary.optics.x <= 0.02 {
        discard()
    }
    let to_eye = v.at - vary.wp
    let dist = length(to_eye)
    let ray_back = if dist > 1.0e-6 { to_eye / dist } else { -v.forward }
    let n = resolve_normal(vary, ray_back)
    let sub = vary_substance(vary)
    let ndv = max(dot(n, ray_back), 0.001)

    // Snell refraction vector in world space -> projected screen UV offset scaled by optical depth.
    let uv = pixel.position.xy / max(v.size, vec2(1.0))
    let bg_here = hdr_bg.sample_level(bg_s, uv, 0.0)
    let raw_thick = max(bg_here.w - dist, 0.05)
    let refract_dist = min(raw_thick, 3.5)
    let eta = 1.0 / max(sub.ior, 1.02)
    let k = 1.0 - eta * eta * (1.0 - ndv * ndv)
    let rdir = if k > 0.0 {
        normalize(-ray_back * eta + n * (eta * ndv - sqrt(k)))
    } else {
        normalize(n * (2.0 * ndv) - ray_back)
    }
    // Project refracted exit point `(wp + rdir * refract_dist)` to screen UV.
    let exit_wp = vary.wp + rdir * min(refract_dist * 0.45, 1.2)
    let erel = exit_wp - v.at
    let ez = max(dot(erel, v.forward), 0.05)
    let aspect = v.size.y / max(v.size.x, 1.0)
    let ex_ndc = (dot(erel, v.right) * v.focal * aspect) / ez
    let ey_ndc = (dot(erel, v.up) * v.focal) / ez
    let refr_uv = clamp(vec2(ex_ndc * 0.5 + 0.5, 0.5 - ey_ndc * 0.5), vec2(0.002), vec2(0.998))

    // Reject refracted samples that hit foreground occluders nearer than the transmissive surface.
    let bg_refr = hdr_bg.sample_level(bg_s, refr_uv, 0.0)
    let use_uv = if bg_refr.w >= dist - 0.08 { refr_uv } else { uv }
    var bg_rad = if bg_refr.w >= dist - 0.08 { bg_refr.xyz } else { bg_here.xyz }
    let bg_depth = if bg_refr.w >= dist - 0.08 { bg_refr.w } else { bg_here.w }

    // 4-tap frosted/rough refraction blur when `roughness > 0.06`.
    if sub.roughness > 0.06 {
        let blur = (sub.roughness * 0.012) * clamp(refract_dist, 0.25, 2.0)
        var acc = bg_rad
        acc += hdr_bg.sample_level(bg_s, clamp(use_uv + vec2(blur, blur), vec2(0.002), vec2(0.998)), 0.0).xyz
        acc += hdr_bg.sample_level(bg_s, clamp(use_uv + vec2(-blur, blur), vec2(0.002), vec2(0.998)), 0.0).xyz
        acc += hdr_bg.sample_level(bg_s, clamp(use_uv + vec2(blur, -blur), vec2(0.002), vec2(0.998)), 0.0).xyz
        acc += hdr_bg.sample_level(bg_s, clamp(use_uv + vec2(-blur, -blur), vec2(0.002), vec2(0.998)), 0.0).xyz
        bg_rad = acc * 0.2
    }

    // Beer-Lambert spectral absorption through medium depth (deep water turns rich teal/abyssal;
    // thin glass stays crystalline with subtle edge tint).
    let thickness = clamp(bg_depth - dist, 0.04, 18.0)
    let absorb = (vec3(1.0) - clamp(sub.albedo, vec3(0.03), vec3(0.98))) * 0.95
    let beer = exp(-absorb * thickness)
    let transmitted = bg_rad * beer

    // Subtle deep-water volumetric scatter tint when looking into deep water/ice.
    let sun = sky.sun()
    let ndl = max(dot(n, sun.way), 0.0)
    let vis = if ndl > 0.0 { sun_shadow(shadow_map, cmp, sv, vary.wp, n) } else { 0.0 }
    let sky_amb = if sub.transmission > 0.7 {
        sky_irradiance(sky_diff, sky_s, n)
    } else {
        let ind = cone_indirect(rad_grid, rad0, rad1, rad2, rad_s, vary.wp, n)
        sky_irradiance(sky_diff, sky_s, n) * ind.w + ind.xyz
    }
    let deep_scatter = sub.albedo * (vec3(1.0) - beer) * ONE_OVER_PI * (sun.light * (0.25 * vis + 0.1) + sky_amb * 0.45)

    // Physical Fresnel reflection (Sky PMREM + world radiance cone + sun & dynamic emitter specular).
    let refl = normalize(n * (2.0 * ndv) - ray_back)
    let f0 = sub.f0()
    let f_env = fresnel_schlick_rough(f0, ndv, sub.roughness)
    let sky_refl = sky_specular(sky_spec0, sky_spec1, sky_spec2, sky_diff, sky_s, refl, sub.roughness)
    let w_refl = spec_cone(rad_grid, rad0, rad1, rad2, rad_s, vary.wp, n, refl, sub.roughness)
    let env_spec = w_refl.xyz + sky_refl * (1.0 - w_refl.w * 0.85)

    let direct_spec = sub.shade_direct(n, sun.way, ray_back, sun.light * vis)
    let local_spec = eval_emitters(sub, vary.wp, n, ray_back, rad_grid, rad0, rad1, rad_s, emitters, emitter_count)

    let tr = sub.transmission
    let body = mix(sub.albedo * ONE_OVER_PI * (sun.light * (ndl * vis) + sky_amb), transmitted + deep_scatter, vec3(tr))
    let rad = sub.emits + body * (vec3(1.0) - f_env) + env_spec * f_env + direct_spec + local_spec
    vec4(rad, min(dist, 65000.0))
}

/// Multi-target linear-HDR fragment shader for `drawn_only` (writes `(hdr, place, sun)` for `Judge`).
@fragment
fn mesh_judge_fs<S: Sky>(
    vary: MeshVary,
    v: View,
    sv: ShadowView,
    rad_grid: RadGrid,
    sky: S,
    sky_diff: Texture<Rgba16Float>,
    sky_spec0: Texture<Rgba16Float>,
    sky_spec1: Texture<Rgba16Float>,
    sky_spec2: Texture<Rgba16Float>,
    sky_s: Sampler,
    shadow_map: DepthTexture,
    cmp: ComparisonSampler,
    rad0: Texture3d<Rgba16Float>,
    rad1: Texture3d<Rgba16Float>,
    rad2: Texture3d<Rgba16Float>,
    rad_s: Sampler,
    emitters: [Emitter],
    emitter_count: [u32],
) -> Targets3<vec4, vec4, f32> {
    let out = shade_mesh(
        vary, v, sv, rad_grid, sky, sky_diff, sky_spec0, sky_spec1, sky_spec2, sky_s,
        shadow_map, cmp, rad0, rad1, rad2, rad_s, emitters, emitter_count,
    )
    Targets3 { first: out.0, second: out.1, third: out.2 }
}

/// Fullscreen background sky shader: runs only on uncovered pixels (`Depth::Equal` at `z = 0.0`).
@vertex
fn sky_vs(vi: VertexIndex) -> ClipPosition {
    let x = f32(vi.index % 2) * 4.0 - 1.0
    let y = f32(vi.index / 2) * 4.0 - 1.0
    ClipPosition { position: vec4(x, y, 0.0, 1.0) }
}

@fragment
fn sky_fs<S: Sky>(pixel: FragCoord, v: View, sky: S, sky_spec0: Texture<Rgba16Float>, sky_s: Sampler) -> vec4 {
    let d = v.ray(pixel.position.xy)
    vec4(sky_background(sky, sky_spec0, sky_s, d), 65000.0)
}

@fragment
fn sky_judge_fs<S: Sky>(pixel: FragCoord, v: View, sky: S) -> Targets3<vec4, vec4, f32> {
    let d = v.ray(pixel.position.xy)
    Targets3 {
        first: vec4(seen(sky, d), 65000.0),
        second: vec4(0.0, 0.0, 0.0, 0.0),
        third: 1.0,
    }
}

/// Computes a view- and budget-aware cell spacing for a single thing with bounding sphere `(c, r)`.
fn cell_for_one(c: vec3, r: f32, v: View) -> f32 {
    let near = max(length(c - v.at) - r, 0.25)
    let px = near * v.pixel()
    let by_size = max(r / 180.0, 0.005)
    clamp(max(px * 1.1, by_size), 0.005, 0.25)
}

/// Computes a view- and budget-aware cell spacing for one thing in a `Many` batch, given its
/// allocated brick share `bricks_for_this`.
fn cell_for_share(c: vec3, r: f32, bricks_for_this: f32, v: View) -> f32 {
    let near = max(length(c - v.at) - r, 0.25)
    let px = near * v.pixel()
    let per_thing = max(bricks_for_this, 4.0)
    let by_budget = r / max(sqrt(per_thing * 2.5), 3.5)
    clamp(max(px * 1.2, by_budget), 0.006, 0.25)
}

/// Any world (`One`, `Many`, `And`) that can sync its GPU meshlet batches.
pub trait MeshWorld: Copy {
    fn batch_count(self) -> u32
    fn sync_batches(self, batches: mut Vec<MeshBatch>, first: u32, v: View, frame: u32)
}

impl<M: Field<Substance> + StateHash + GpuData> MeshWorld for One<M> {
    fn batch_count(self) -> u32 {
        1
    }

    fn sync_batches(self, batches: mut Vec<MeshBatch>, first: u32, v: View, _frame: u32) {
        let b = self.field.bound()
        let cell = cell_for_one(b.centre, min(b.radius, 1.0e4), v)
        batches[first].sync_one(self.field, cell)
    }
}

/// Whether a sphere `(c, r)` intersects the view frustum (with a generous margin so shadow-casting
/// silhouettes just off-screen stay included).
fn in_view(c: vec3, r: f32, v: View) -> bool {
    let rel = c - v.at
    let z = dot(rel, v.forward)
    if z + r < NEAR {
        return false
    }
    let aspect = v.size.x / max(v.size.y, 1.0)
    let half_y = max(z, 0.0) / v.focal + r * 1.4
    let half_x = half_y * aspect + r * 1.4
    abs(dot(rel, v.up)) <= half_y && abs(dot(rel, v.right)) <= half_x
}

impl<M: Field<Substance> + StateHash + GpuData, const N: u32> MeshWorld for Many<M, N> {
    fn batch_count(self) -> u32 {
        if N >= 16 { 3 } else { 1 }
    }

    fn sync_batches(self, batches: mut Vec<MeshBatch>, first: u32, v: View, frame: u32) {
        let cap = batches[first].cap_bricks
        var total_w = 0.0
        for i in 0..N {
            let b = self.fields[i].bound()
            let r = min(b.radius, 1.0e4)
            if in_view(b.centre, r, v) {
                let near = max(length(b.centre - v.at) - r, 0.25)
                let s = r / near
                total_w += clamp(s * s, 0.002, 4.0)
            }
        }
        let inv_w = if total_w > 1.0e-6 { f32(cap) / total_w } else { f32(cap) }

        if N < 16 {
            var cells = [0.0; N]
            for i in 0..N {
                let b = self.fields[i].bound()
                let r = min(b.radius, 1.0e4)
                if in_view(b.centre, r, v) {
                    let near = max(length(b.centre - v.at) - r, 0.25)
                    let s = r / near
                    let share = clamp(s * s, 0.002, 4.0) * inv_w
                    cells[i] = cell_for_share(b.centre, r, share, v)
                }
            }
            batches[first].sync_many(self.fields, cells)
            return
        }

        let init_tiers = batches[first].tiers.len() != N
        if init_tiers {
            batches[first].tiers = Vec::new()
            for _i in 0..N {
                batches[first].tiers.push(0)
            }
        }
        let update_even = init_tiers || frame == 0 || (frame & 1) == 0
        let update_odd = init_tiers || frame == 0 || (frame & 1) == 1

        var c_near = [0.0; N]
        var c_even = [0.0; N]
        var c_odd = [0.0; N]
        for i in 0..N {
            let b = self.fields[i].bound()
            let r = min(b.radius, 1.0e4)
            let vis = in_view(b.centre, r, v)
            let near = max(length(b.centre - v.at) - r, 0.25)
            let far_slot: u32 = if (i & 1) == 0 { 1 } else { 2 }
            let want_tier: u32 = if !vis {
                far_slot
            } else if near <= FAR_TIER_DIST {
                0
            } else {
                far_slot
            }
            var cur = if init_tiers { want_tier } else { batches[first].tiers[i] }
            let can_change = (cur == 0 && (want_tier == 0 || (want_tier == 1 && update_even) || (want_tier == 2 && update_odd)))
                || (cur == 1 && update_even)
                || (cur == 2 && update_odd)
            if can_change {
                cur = want_tier
                batches[first].tiers[i] = cur
            }
            if vis {
                let s = r / near
                let share = clamp(s * s, 0.002, 4.0) * inv_w
                let cell = cell_for_share(b.centre, r, share, v)
                if cur == 0 {
                    c_near[i] = cell
                } else if cur == 1 {
                    c_even[i] = cell
                } else {
                    c_odd[i] = cell
                }
            }
        }
        batches[first].sync_many(self.fields, c_near)
        if update_even {
            batches[first + 1].sync_many(self.fields, c_even)
        }
        if update_odd {
            batches[first + 2].sync_many(self.fields, c_odd)
        }
    }
}

impl<A: MeshWorld, B: MeshWorld> MeshWorld for And<A, B> {
    fn batch_count(self) -> u32 {
        self.a.batch_count() + self.b.batch_count()
    }

    fn sync_batches(self, batches: mut Vec<MeshBatch>, first: u32, v: View, frame: u32) {
        let na = self.a.batch_count()
        self.a.sync_batches(mut batches, first, v, frame)
        self.b.sync_batches(mut batches, first + na, v, frame)
    }
}

/// Complete meshlet renderer state: owns extracted batches, shadow map, GPU Sky PMREM cache,
/// unified world-space radiance cache + dynamic emitters, volumetric froxel grid, optical HDR
/// bloom pyramid, linear HDR colour + background refraction copy + resolved depth, and `Picture`.
pub struct MeshSight {
    pub drawn: Picture,
    pub hdr_colour: Texture<Rgba16Float>,
    pub hdr_bg: Texture<Rgba16Float>,
    pub depth: DepthTexture,
    pub sky: SkyCache,
    pub rad: RadianceCache,
    pub vol: FroxelVolume,
    pub bloom: BloomPyramid,
    batches: Vec<MeshBatch>,
    shadow_depth: DepthTexture,
    cmp: ComparisonSampler,
    bg_s: Sampler,
    frame: u32,
    pub gi: bool,
}

/// Creates a fresh `MeshSight` using 4× hardware MSAA, PBR + refraction, One Light GI + dynamic
/// emitters, froxel volumetrics, and optical HDR bloom.
pub fn mesh_sight(gi: bool = true) -> MeshSight {
    MeshSight {
        drawn: picture(width: 1, height: 1),
        hdr_colour: texture(width: 1, height: 1),
        hdr_bg: texture(width: 1, height: 1),
        depth: depth_texture(width: 1, height: 1),
        sky: sky_cache(),
        rad: radiance_cache(),
        vol: froxel_volume(),
        bloom: bloom_pyramid(),
        batches: Vec::new(),
        shadow_depth: depth_texture(width: SHADOW_SIDE, height: SHADOW_SIDE),
        cmp: comparison_sampler(compare: Compare::LessEqual),
        bg_s: sampler(filter: Filter::Linear, address: Address::Clamp),
        frame: 0,
        gi: gi,
    }
}

impl MeshSight {
    fn resize(mut self, width: u32, height: u32) {
        if self.drawn.width() != width || self.drawn.height() != height {
            self.drawn = picture(width: width, height: height)
            self.drawn.placed = true
            self.hdr_colour = texture(width: width, height: height)
            self.hdr_bg = texture(width: width, height: height)
            self.depth = depth_texture(width: width, height: height)
        }
    }

    fn ensure_batches(mut self, count: u32) {
        while self.batches.len() < count {
            self.batches.push(mesh_batch(BATCH_BRICKS))
        }
    }

    /// Updates GPU Sky PMREM cache, syncs extracted GPU meshlets, renders the unified sun shadow
    /// map, and rebuilds the radiance volume + auto-extracted dynamic local emitters.
    fn prepare_and_shadow<W: MeshWorld, S: Sky>(
        mut self,
        world: W,
        sky: S,
        eye: Eye,
        width: u32,
        height: u32,
        frame: u32,
    ) -> (u32, View, ShadowView) {
        self.resize(width, height)
        let v = view(eye, width: width, height: height)

        // Update sky diffuse irradiance + 3-level specular PMREM only when sky changes (0 ms/frame when still).
        self.sky.sync(sky)

        // Sync extracted GPU meshlets for every batch in the world.
        let nb = world.batch_count()
        self.ensure_batches(nb)
        world.sync_batches(mut self.batches, 0, v, frame)

        // Compute combined world bounding sphere for the unified sun shadow map.
        var wlo = vec3(1.0e20)
        var whi = vec3(-1.0e20)
        for i in 0..nb {
            let b = self.batches[i].bound
            if b.w > 0.0 {
                wlo = min(wlo, b.xyz - vec3(b.w))
                whi = max(whi, b.xyz + vec3(b.w))
            }
        }
        let wmid = 0.5 * (wlo + whi)
        let wrad = if whi.x > wlo.x { 0.5 * length(whi - wlo) } else { 10.0 }
        let sv = shadow_view(wmid, wrad, sky.sun().way)

        // Pass 1: Unified sun shadow map (all opaque still + moving meshlets in one pass).
        label("mesh_shadow")
        let sp: DepthOnlyPass = begin_depth_pass(mut self.shadow_depth, clear_depth: 1.0, keep_depth: false)
        for i in 0..nb {
            draw(
                sp,
                shadow_vs.bind(verts: self.batches[i].verts.items(), sv: sv),
                shadow_fs,
                indices: self.batches[i].indices,
                indirect: self.batches[i].draw_args,
                cull: Cull::Back,
                depth_bias: DepthBias { constant: 2, slope: 1.5, clamp: 0.0 },
                depth: Depth { compare: Compare::Less, write: true },
            )
        }
        sp.end()

        // Pass 1b: Rebuild unified world-space radiance cache & dynamic local emitters.
        self.rad.begin(wmid, wrad, enabled: self.gi)
        if self.gi {
            for i in 0..nb {
                self.rad.inject(
                    self.batches[i].verts.items(),
                    self.batches[i].verts.count(),
                    self.batches[i].cap_verts,
                    sv,
                    sky,
                    self.sky.diff,
                    self.sky.s,
                    self.shadow_depth,
                    self.cmp,
                )
            }
            self.rad.finish()
        }
        (nb, v, sv)
    }

    /// Renders `world` into `self.drawn` (`colour`, `place`, `sun`) without presenting (for
    /// judging against `Reference`).
    pub fn drawn_only<W: MeshWorld, S: Sky, L: Look>(
        mut self,
        world: W,
        sky: S,
        look: L,
        eye: Eye,
        width: u32,
        height: u32,
    ) {
        let (nb, v, sv) = self.prepare_and_shadow(world, sky, eye, width, height, 0)

        // Pass 2: Unified 4× hardware MSAA eye pass writing linear HDR + `(place, sun)` + depth.
        label("mesh_eye")
        let ep: MsaaDepthPass3<Rgba16Float, Rgba32Float, R8> = begin_pass3_msaa_with_depth(
            mut self.hdr_colour,
            mut self.drawn.place,
            mut self.drawn.sun,
            mut self.depth,
            clear: vec4(0.0, 0.0, 0.0, 65000.0),
            clear_depth: 0.0,
        )
        for i in 0..nb {
            draw(
                ep,
                mesh_vs.bind(verts: self.batches[i].verts.items(), v: v),
                mesh_judge_fs.bind(
                    v: v,
                    sv: sv,
                    rad_grid: self.rad.grid,
                    sky: sky,
                    sky_diff: self.sky.diff,
                    sky_spec0: self.sky.spec0,
                    sky_spec1: self.sky.spec1,
                    sky_spec2: self.sky.spec2,
                    sky_s: self.sky.s,
                    shadow_map: self.shadow_depth,
                    cmp: self.cmp,
                    rad0: self.rad.rad0,
                    rad1: self.rad.rad1,
                    rad2: self.rad.rad2,
                    rad_s: self.rad.s,
                    emitters: self.rad.emitters.items(),
                    emitter_count: self.rad.emitters.count(),
                ),
                indices: self.batches[i].indices,
                indirect: self.batches[i].draw_args,
                cull: Cull::Back,
                depth: Depth { compare: Compare::Greater, write: true },
            )
        }
        draw(
            ep,
            sky_vs,
            sky_judge_fs.bind(v: v, sky: sky),
            vertices: 3,
            depth: Depth { compare: Compare::Equal, write: false },
        )
        ep.end()

        // Pass 3: Single unified `Look::tone` pass into `self.drawn.colour`.
        label("mesh_tone")
        let tp = begin_pass(mut self.drawn.colour, keep: false)
        draw(
            tp,
            cover,
            hdr_tone_fs.bind(
                hdr: self.hdr_colour,
                depth: self.depth,
                froxel_acc: self.vol.acc,
                vol_s: self.vol.s,
                vol_active: 0,
                bloom_tex: self.bloom.u0,
                bloom_s: self.bloom.s,
                bloom_strength: 0.0,
                near_plane: NEAR,
                v: v,
                look: look,
            ),
            vertices: 3,
        )
        tp.end()
        self.drawn.placed = true
    }

    /// Renders `world` (`Surface`s), `height` (`Height` clipmap), and `medium` (`Medium` froxels)
    /// through ONE depth buffer, ONE light store, ONE refractive pass, optional optical HDR bloom,
    /// and ONE `Look::tone` pass, and presents.
    pub fn draw_all<W: MeshWorld, H: Height, Med: Medium, S: Sky, L: Look>(
        mut self,
        world: W,
        height: H,
        medium: Med,
        sky: S,
        look: L,
        eye: Eye,
        width: u32,
        height_px: u32,
    ) {
        let (nb, v, sv) = self.prepare_and_shadow(world, sky, eye, width, height_px, self.frame)
        self.frame += 1

        // Pass 2: Unified 4× hardware MSAA opaque linear-HDR eye pass (solids + opaque height + sky).
        label("mesh_eye")
        let ep: MsaaDepthPass<Rgba16Float> = begin_pass_msaa_with_depth(
            mut self.hdr_colour,
            mut self.depth,
            clear: vec4(0.0, 0.0, 0.0, 65000.0),
            clear_depth: 0.0,
        )
        for i in 0..nb {
            draw(
                ep,
                mesh_vs.bind(verts: self.batches[i].verts.items(), v: v),
                mesh_fs.bind(
                    v: v,
                    sv: sv,
                    rad_grid: self.rad.grid,
                    sky: sky,
                    sky_diff: self.sky.diff,
                    sky_spec0: self.sky.spec0,
                    sky_spec1: self.sky.spec1,
                    sky_spec2: self.sky.spec2,
                    sky_s: self.sky.s,
                    shadow_map: self.shadow_depth,
                    cmp: self.cmp,
                    rad0: self.rad.rad0,
                    rad1: self.rad.rad1,
                    rad2: self.rad.rad2,
                    rad_s: self.rad.s,
                    emitters: self.rad.emitters.items(),
                    emitter_count: self.rad.emitters.count(),
                ),
                indices: self.batches[i].indices,
                indirect: self.batches[i].draw_args,
                cull: Cull::Back,
                depth: Depth { compare: Compare::Greater, write: true },
            )
        }
        if height.active() {
            draw(
                ep,
                height_vs.bind(height: height, v: v),
                height_opaque_fs.bind(
                    v: v,
                    sv: sv,
                    rad_grid: self.rad.grid,
                    sky: sky,
                    sky_diff: self.sky.diff,
                    sky_spec0: self.sky.spec0,
                    sky_spec1: self.sky.spec1,
                    sky_spec2: self.sky.spec2,
                    sky_s: self.sky.s,
                    shadow_map: self.shadow_depth,
                    cmp: self.cmp,
                    rad0: self.rad.rad0,
                    rad1: self.rad.rad1,
                    rad2: self.rad.rad2,
                    rad_s: self.rad.s,
                    emitters: self.rad.emitters.items(),
                    emitter_count: self.rad.emitters.count(),
                ),
                vertices: CLIP_VERTS,
                instances: CLIP_RINGS,
                cull: Cull::Back,
                depth: Depth { compare: Compare::Greater, write: true },
            )
        }
        draw(
            ep,
            sky_vs,
            sky_fs.bind(v: v, sky: sky, sky_spec0: self.sky.spec0, sky_s: self.sky.s),
            vertices: 3,
            depth: Depth { compare: Compare::Equal, write: false },
        )
        ep.end()

        // Pass 2a: Unified refractive / transmissive pass (glass, water, crystal, ice).
        // Skipped completely (0.0 ms) when no heightfield or batch contains transmissive triangles.
        var any_trans = height.active()
        for i in 0..nb {
            if self.batches[i].poll_trans() {
                any_trans = true
            }
        }
        if any_trans {
            label("mesh_refract")
            copy_texture(from: self.hdr_colour.level(0), to: self.hdr_bg.level_mut(0))
            let rp: DepthPass<Rgba16Float> = begin_pass_with_depth(
                mut self.hdr_colour,
                mut self.depth,
                keep: true,
                keep_depth: true,
            )
            for i in 0..nb {
                draw(
                    rp,
                    mesh_vs.bind(verts: self.batches[i].verts.items(), v: v),
                    mesh_trans_fs.bind(
                        v: v,
                        sv: sv,
                        rad_grid: self.rad.grid,
                        sky: sky,
                        sky_diff: self.sky.diff,
                        sky_spec0: self.sky.spec0,
                        sky_spec1: self.sky.spec1,
                        sky_spec2: self.sky.spec2,
                        sky_s: self.sky.s,
                        shadow_map: self.shadow_depth,
                        cmp: self.cmp,
                        rad0: self.rad.rad0,
                        rad1: self.rad.rad1,
                        rad2: self.rad.rad2,
                        rad_s: self.rad.s,
                        emitters: self.rad.emitters.items(),
                        emitter_count: self.rad.emitters.count(),
                        hdr_bg: self.hdr_bg,
                        bg_s: self.bg_s,
                    ),
                    indices: self.batches[i].trans_indices,
                    indirect: self.batches[i].trans_draw_args,
                    cull: Cull::Back,
                    depth: Depth { compare: Compare::Greater, write: true },
                )
            }
            if height.active() {
                draw(
                    rp,
                    height_vs.bind(height: height, v: v),
                    mesh_trans_fs.bind(
                        v: v,
                        sv: sv,
                        rad_grid: self.rad.grid,
                        sky: sky,
                        sky_diff: self.sky.diff,
                        sky_spec0: self.sky.spec0,
                        sky_spec1: self.sky.spec1,
                        sky_spec2: self.sky.spec2,
                        sky_s: self.sky.s,
                        shadow_map: self.shadow_depth,
                        cmp: self.cmp,
                        rad0: self.rad.rad0,
                        rad1: self.rad.rad1,
                        rad2: self.rad.rad2,
                        rad_s: self.rad.s,
                        emitters: self.rad.emitters.items(),
                        emitter_count: self.rad.emitters.count(),
                        hdr_bg: self.hdr_bg,
                        bg_s: self.bg_s,
                    ),
                    vertices: CLIP_VERTS,
                    instances: CLIP_RINGS,
                    cull: Cull::Back,
                    depth: Depth { compare: Compare::Greater, write: true },
                )
            }
            rp.end()
        }

        // Pass 2b: Unified volumetric froxel pass (0 ms when `medium.active()` is false).
        let has_vol = medium.active()
        if has_vol {
            self.vol.update(
                medium,
                v,
                sv,
                self.rad.grid,
                sky,
                self.sky.diff,
                self.sky.s,
                self.shadow_depth,
                self.cmp,
                self.rad.rad1,
                self.rad.rad2,
                self.rad.s,
                self.rad.emitters.items(),
                self.rad.emitters.count(),
            )
        }

        // Pass 2c: Optical HDR bloom pyramid (0 ms when `look.bloom().strength <= 0.0`).
        let bloom_cfg = look.bloom()
        self.bloom.build(self.hdr_colour, width, height_px, bloom_cfg)

        // Pass 3: Unified volumetric composite + optical bloom + ONE `Look::tone` pass.
        label("mesh_tone")
        let tp = begin_pass(mut self.drawn.colour, keep: false)
        draw(
            tp,
            cover,
            hdr_tone_fs.bind(
                hdr: self.hdr_colour,
                depth: self.depth,
                froxel_acc: self.vol.acc,
                vol_s: self.vol.s,
                vol_active: if has_vol { 1 } else { 0 },
                bloom_tex: self.bloom.u0,
                bloom_s: self.bloom.s,
                bloom_strength: bloom_cfg.strength,
                near_plane: NEAR,
                v: v,
                look: look,
            ),
            vertices: 3,
        )
        tp.end()
        self.drawn.placed = false
        show(self.drawn.colour)
    }

    /// Renders `world` (`Surface`s only) into `self.drawn` and presents it to the screen.
    pub fn draw<W: MeshWorld, S: Sky, L: Look>(
        mut self,
        world: W,
        sky: S,
        look: L,
        eye: Eye,
        width: u32,
        height: u32,
    ) {
        self.draw_all(world, NoHeight {}, NoMedium {}, sky, look, eye, width, height)
    }
}
