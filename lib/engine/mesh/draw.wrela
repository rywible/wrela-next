/// Projects refracted exit point along Snell direction `rdir` at `ior` to screen UV in the frame's
/// jittered raster (where `hdr_bg` holds it: a point at unjittered `q` is drawn at `q - jitter`).
fn refract_uv_for(
    v: View,
    wp: vec3,
    n: vec3,
    ray_back: vec3,
    ndv: f32,
    ior: f32,
    refract_dist: f32,
) -> vec2 {
    let eta = 1.0 / max(ior, 1.02)
    let k = 1.0 - eta * eta * (1.0 - ndv * ndv)
    let rdir = if k > 0.0 {
        normalize(-ray_back * eta + n * (eta * ndv - sqrt(k)))
    } else {
        normalize(n * (2.0 * ndv) - ray_back)
    }
    let exit_wp = wp + rdir * min(refract_dist * 0.45, 1.2)
    let erel = exit_wp - v.at
    let ez = max(dot(erel, v.forward), 0.05)
    let aspect = v.size.y / max(v.size.x, 1.0)
    let ex_ndc = (dot(erel, v.right) * v.focal * aspect) / ez
    let ey_ndc = (dot(erel, v.up) * v.focal) / ez
    let uv = vec2(ex_ndc * 0.5 + 0.5, 0.5 - ey_ndc * 0.5) - v.jitter / max(v.size, vec2(1.0))
    clamp(uv, vec2(0.002), vec2(0.998))
}

/// How far a ray entering `field`'s solid at its surface point `wp` along `dir` runs inside before
/// it leaves (m, at most `max_len`): the field's own distance sphere-traced from inside, so the
/// Beer-Lambert path through a glass thing is its real interior length and not the gap to whatever
/// lies behind it.
fn interior_length<M: Field<Substance>>(field: M, wp: vec3, dir: vec3, max_len: f32) -> f32 {
    var t = 0.004
    var out = false
    for _ in 0..24 {
        if !out && t < max_len {
            let d = field.distance(wp + dir * t)
            if d >= 0.0 {
                out = true
            } else {
                t += max(-d, 0.004)
            }
        }
    }
    min(t, max_len)
}

/// Shared physically-based refractive / transmissive shading core: 3-channel spectral chromatic
/// dispersion, Snell refraction + Beer-Lambert absorption, 1-tap upsampled half-res SSR, thin-film
/// iridescence, and GGX specular from sun & tiled spell emitters. `interior` is the light's path
/// length inside the thing (`interior_length`), or negative for an open volume (a heightfield's
/// water), whose path runs to whatever lies behind it.
@budget(work: 38000)
fn shade_trans_core<S: Sky>(
    pixel: FragCoord,
    wp: vec3,
    mp: vec3,
    interior: f32,
    normal: vec3,
    smooth: f32,
    sub0: Substance,
    v: View,
    sv: ShadowView,
    rad_grid: RadGrid,
    sdf_grid: SdfGrid,
    sky: S,
    sky_diff: Texture<Rgba16Float>,
    sky_spec0: Texture<Rgba16Float>,
    sky_spec1: Texture<Rgba16Float>,
    sky_spec2: Texture<Rgba16Float>,
    sky_s: Sampler,
    shadow_map: DepthTexture,
    cmp: ComparisonSampler,
    rad0: Texture3d<Rgba16Float>,
    rad1: Texture3d<Rgba16Float>,
    rad2: Texture3d<Rgba16Float>,
    rad_s: Sampler,
    sdf0: Texture3d<R16Float>,
    sdf1: Texture3d<R16Float>,
    sdf_s: Sampler,
    emitters: [Emitter],
    tile_masks: [u32],
    tiles_x: u32,
    hdr_bg: Texture<Rgba16Float>,
    refract_refl: Texture<Rgba16Float>,
    bg_s: Sampler,
) -> vec4 {
    if sub0.transmission <= 0.02 {
        discard()
    }
    let to_eye = v.at - wp
    let dist = length(to_eye)
    let ray_back = if dist > 1.0e-6 { to_eye / dist } else { -v.forward }
    let n0 = resolve_normal_from(wp, normal, smooth, ray_back)
    let (n, sub) = apply_micro_relief(wp, mp, n0, sub0, dist)
    let ndv = max(dot(n, ray_back), 0.001)

    let uv = pixel.position.xy / max(v.size, vec2(1.0))
    let bg_here = hdr_bg.sample_level(bg_s, uv, 0.0)
    let raw_thick = max(bg_here.w - dist, 0.05)
    let refract_dist = min(raw_thick, 3.5)

    let refr_uv = refract_uv_for(v, wp, n, ray_back, ndv, sub.ior, refract_dist)
    let bg_refr = hdr_bg.sample_level(bg_s, refr_uv, 0.0)
    let valid_g = bg_refr.w >= dist - 0.08
    let use_uv = if valid_g { refr_uv } else { uv }
    var bg_rad = if valid_g { bg_refr.xyz } else { bg_here.xyz }
    let bg_depth = if valid_g { bg_refr.w } else { bg_here.w }

    // 3-channel spectral chromatic dispersion on high-IOR glass/crystal (`ior > 1.38`).
    if sub.ior > 1.38 && valid_g {
        let uv_r = refract_uv_for(v, wp, n, ray_back, ndv, sub.ior - 0.032, refract_dist)
        let uv_b = refract_uv_for(v, wp, n, ray_back, ndv, sub.ior + 0.032, refract_dist)
        let smp_r = hdr_bg.sample_level(bg_s, uv_r, 0.0)
        let smp_b = hdr_bg.sample_level(bg_s, uv_b, 0.0)
        let cr = if smp_r.w >= dist - 0.08 { smp_r.x } else { bg_rad.x }
        let cb = if smp_b.w >= dist - 0.08 { smp_b.z } else { bg_rad.z }
        bg_rad = vec3(cr, bg_rad.y, cb)
    }

    if sub.roughness > 0.06 {
        let blur = (sub.roughness * 0.012) * clamp(refract_dist, 0.25, 2.0)
        var acc = bg_rad
        acc += hdr_bg.sample_level(
            bg_s,
            clamp(use_uv + vec2(blur, blur), vec2(0.002), vec2(0.998)),
            0.0,
        ).xyz
        acc += hdr_bg.sample_level(
            bg_s,
            clamp(use_uv + vec2(-blur, blur), vec2(0.002), vec2(0.998)),
            0.0,
        ).xyz
        acc += hdr_bg.sample_level(
            bg_s,
            clamp(use_uv + vec2(blur, -blur), vec2(0.002), vec2(0.998)),
            0.0,
        ).xyz
        acc += hdr_bg.sample_level(
            bg_s,
            clamp(use_uv + vec2(-blur, -blur), vec2(0.002), vec2(0.998)),
            0.0,
        ).xyz
        bg_rad = acc * 0.2
    }

    let behind = bg_depth - dist
    let thickness = clamp(if interior >= 0.0 { min(interior, behind) } else { behind }, 0.04, 18.0)
    let absorb = (vec3(1.0) - clamp(sub.albedo, vec3(0.03), vec3(0.98))) * 0.95
    let beer = exp(-absorb * thickness)
    let transmitted = bg_rad * beer

    let sun = sky.sun()
    let ndl = max(dot(n, sun.way), 0.0)
    let vis = if ndl > 0.0 { sun_vis_point(shadow_map, cmp, sv, wp) } else { 0.0 }
    let sky_amb = sky_irradiance(sky_diff, sky_s, n)
    let deep_scatter = sub.albedo *
        (vec3(1.0) - beer) *
        ONE_OVER_PI *
        (sun.light * (0.25 * vis + 0.1) + sky_amb * 0.45)

    // 1-tap upsample of half-res SSR + SDF `spec_cone` + Sky PMREM (zero full-res raymarching!).
    let refl = normalize(n * (2.0 * ndv) - ray_back)
    let f0 = sub.f0()
    var f_env = fresnel_schlick_rough(f0, ndv, sub.roughness)
    // Subtle grazing thin-film spectral iridescence on crystalline glass (`ior > 1.38`).
    if sub.ior > 1.38 {
        let phase = (1.0 - ndv) * 6.2831853
        let irid = vec3(
            0.5 + 0.5 * cos(phase),
            0.5 + 0.5 * cos(phase + 2.0944),
            0.5 + 0.5 * cos(phase + 4.1888),
        )
        let graze = (1.0 - ndv) * (1.0 - ndv) * (1.0 - sub.roughness)
        f_env = clamp(
            f_env * mix(vec3(1.0), vec3(0.82) + irid * 0.36, vec3(graze * 0.65)),
            vec3(0.0),
            vec3(1.0),
        )
    }
    let rr = refract_refl.sample_level(bg_s, uv, 0.0)
    let env_spec = if rr.w > 0.02 {
        rr.xyz / rr.w
    } else {
        sky_specular(sky_spec0, sky_spec1, sky_spec2, sky_diff, sky_s, refl, sub.roughness)
    }

    // The sun's full BRDF on the surface (its diffuse already weighted by `1 - transmission`).
    let direct_sun = sub.shade_direct(n, sun.way, ray_back, sun.light * vis)
    let px = u32(max(pixel.position.x, 0.0))
    let py = u32(max(pixel.position.y, 0.0))
    let local_spec = eval_emitters_tiled(
        sub,
        wp,
        n,
        ray_back,
        rad_grid,
        rad0,
        rad1,
        rad_s,
        sdf_grid,
        sdf0,
        sdf1,
        sdf_s,
        emitters,
        tile_masks,
        tiles_x,
        px,
        py,
    )

    let tr = sub.transmission
    let body = mix(sub.albedo * ONE_OVER_PI * sky_amb, transmitted + deep_scatter, vec3(tr))
    let rad = sub.emits + body * (vec3(1.0) - f_env) + env_spec * f_env + direct_sun + local_spec
    vec4(rad, min(dist, 65000.0))
}

/// Pixel-rate transmissive fragment shader for `One<M>` compact meshlets (colour + motion).
@fragment
@budget(work: 44000)
fn field_trans_one_fs<M: Field<Substance>, S: Sky>(
    pixel: FragCoord,
    vary: FieldVary,
    field: M,
    v: View,
    prev_v: View,
    sv: ShadowView,
    rad_grid: RadGrid,
    sdf_grid: SdfGrid,
    sky: S,
    sky_diff: Texture<Rgba16Float>,
    sky_spec0: Texture<Rgba16Float>,
    sky_spec1: Texture<Rgba16Float>,
    sky_spec2: Texture<Rgba16Float>,
    sky_s: Sampler,
    shadow_map: DepthTexture,
    cmp: ComparisonSampler,
    rad0: Texture3d<Rgba16Float>,
    rad1: Texture3d<Rgba16Float>,
    rad2: Texture3d<Rgba16Float>,
    rad_s: Sampler,
    sdf0: Texture3d<R16Float>,
    sdf1: Texture3d<R16Float>,
    sdf_s: Sampler,
    emitters: [Emitter],
    tile_masks: [u32],
    tiles_x: u32,
    hdr_bg: Texture<Rgba16Float>,
    refract_refl: Texture<Rgba16Float>,
    bg_s: Sampler,
) -> Targets2<vec4, vec2> {
    let sub0 = field.channels(vary.wp)
    let interior = interior_length(field, vary.wp, normalize(vary.wp - v.at), 18.0)
    let c = shade_trans_core(
        pixel,
        vary.wp,
        vary.local_p,
        interior,
        vary.normal,
        vary.meta.x,
        sub0,
        v,
        sv,
        rad_grid,
        sdf_grid,
        sky,
        sky_diff,
        sky_spec0,
        sky_spec1,
        sky_spec2,
        sky_s,
        shadow_map,
        cmp,
        rad0,
        rad1,
        rad2,
        rad_s,
        sdf0,
        sdf1,
        sdf_s,
        emitters,
        tile_masks,
        tiles_x,
        hdr_bg,
        refract_refl,
        bg_s,
    )
    Targets2 { first: c, second: motion_of(vary.wp, vary.prev_wp, v, prev_v) }
}

