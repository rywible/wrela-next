// Unified frustum-aligned volumetric froxel pass (S. Hillaire, Frostbite SIGGRAPH 2015),
// Dual Kawase HDR optical bloom pyramid (M. Marius / Jorge Jimenez SIGGRAPH 2014), and
// unified linear-HDR `Look::tone` resolve pass.
//
// Every participating medium (`Medium`: fog, mist, smoke, fire, spell plumes) is evaluated on a
// `160×90×32` frustum grid, lit by the exact same sun shadow map (real god-rays from still and
// moving matter), sky irradiance table, 3-level world-space radiance volume, and auto-extracted
// dynamic local emitters, integrated front-to-back analytically, and composited against the exact
// resolved reversed-Z depth buffer before optical bloom and the frame's single `Look::tone` pass.

use matter::medium::Medium
use matter::sky::Sky
use mesh::light::{
    Emitter, FOUR_PI, NEAR, RadGrid, ShadowView, eval_emitters_vol, hg_phase, sky_irradiance,
    volume_indirect,
}
use mesh::sunlight::sun_map_vis
use picture::eye::View
use picture::look::{Bloom, Look, Seen}
use picture::screen::{cover, luma}
use std::gpu::{
    Address, DepthTexture, Filter, FragCoord, GlobalId, GpuSpan, Rgba16Float,
    Sampler, Texels3d, Texture, Texture3d, begin_pass, dispatch, draw, label, sampler, texture,
    texture3d,
}

/// Froxel grid dimensions (`160×90×32` = 460,800 froxels, ~3.7 MB per `Rgba16Float` volume).
pub const FROXEL_W: u32 = 160
pub const FROXEL_H: u32 = 90
pub const FROXEL_D: u32 = 32

/// Exponential depth range covered by the froxel grid (m).
pub const VOL_NEAR: f32 = 0.25
pub const VOL_FAR: f32 = 64.0
const LOG_RATIO: f32 = 5.54517744 // ln(64.0 / 0.25) = ln(256)

/// Depth `z` (m along camera forward) of slice boundary `s` in `[0, FROXEL_D]`.
fn slice_z(s: f32) -> f32 {
    VOL_NEAR * exp(LOG_RATIO * (s / f32(FROXEL_D)))
}

/// Normalized depth coordinate `w` in `[0, 1]` corresponding to camera-forward distance `z`.
fn z_to_w(z: f32) -> f32 {
    if z <= VOL_NEAR {
        return 0.0
    }
    clamp(log(z / VOL_NEAR) / LOG_RATIO, 0.0, 1.0)
}

/// Pass 1: Evaluates `medium` at each froxel centre and computes in-scattered radiance from the
/// unified One Light (sun shadow god-rays + sky ambient + 3D radiance volume + dynamic emitters).
@compute(4, 4, 4)
fn froxel_scatter<Med: Medium, S: Sky>(
    medium: Med,
    v: View,
    sv: ShadowView,
    rad_grid: RadGrid,
    sky: S,
    sky_table: Texture<Rgba16Float>,
    sky_s: Sampler,
    shadow_map: DepthTexture,
    static_shadow_map: DepthTexture,
    has_static_shadow: u32,
    rad1: Texture3d<Rgba16Float>,
    rad2: Texture3d<Rgba16Float>,
    rad_s: Sampler,
    emitters: [Emitter],
    emitter_count: [u32],
    out: mut Texels3d<Rgba16Float>,
    id: GlobalId,
) {
    if id.x >= FROXEL_W || id.y >= FROXEL_H || id.z >= FROXEL_D {
        return
    }
    let px = (f32(id.x) + 0.5) * (v.size.x / f32(FROXEL_W))
    let py = (f32(id.y) + 0.5) * (v.size.y / f32(FROXEL_H))
    let ray = v.ray(vec2(px, py))
    let z0 = slice_z(f32(id.z))
    let z1 = slice_z(f32(id.z + 1))
    let zmid = 0.5 * (z0 + z1)
    let cos_fwd = max(dot(ray, v.forward), 0.1)
    let wp = v.at + ray * (zmid / cos_fwd)

    let smp = medium.sample_at(wp)
    if smp.density <= 1.0e-5 && dot(smp.emits, smp.emits) <= 1.0e-10 {
        out.store(id, vec4(0.0))
        return
    }

    let sun = sky.sun()
    // A point in the medium has no plane: the map's taps at its own depth, good to a texel.
    let sun_vis = sun_map_vis(
        shadow_map,
        static_shadow_map,
        has_static_shadow,
        sv,
        sun,
        wp,
        vec3(0.0),
        sv.texel,
    ).vis()
    let g = clamp(smp.g, -0.9, 0.9)
    let phase = hg_phase(dot(ray, sun.way), g)
    let direct = sun.light * (sun_vis * phase)
    let local = eval_emitters_vol(wp, ray, g, rad_grid, emitters, emitter_count)
    let amb = (sky_irradiance(sky_table, sky_s, vec3(0.0, 1.0, 0.0)) +
        volume_indirect(rad_grid, rad1, rad2, rad_s, wp)) *
        (1.0 / FOUR_PI)
    let inscatter = smp.emits + smp.albedo * smp.density * (direct + local + amb)
    out.store(id, vec4(inscatter, max(smp.density, 0.0)))
}

/// Pass 2: Analytically integrates each froxel `(id.x, id.y, id.z)` front-to-back from the near
/// plane to the centre of slice `id.z` (`w = (id.z + 0.5) / FROXEL_D`, where linear filtering puts
/// its texel), storing `(accumulated_inscatter.rgb, transmittance)` in `out`, so a surface at depth
/// `w` gathers the medium in front of it and none from behind it.
@compute(4, 4, 4)
fn froxel_integrate(
    raw: Texture3d<Rgba16Float>,
    v: View,
    out: mut Texels3d<Rgba16Float>,
    id: GlobalId,
) {
    if id.x >= FROXEL_W || id.y >= FROXEL_H || id.z >= FROXEL_D {
        return
    }
    let px = (f32(id.x) + 0.5) * (v.size.x / f32(FROXEL_W))
    let py = (f32(id.y) + 0.5) * (v.size.y / f32(FROXEL_H))
    let ray = v.ray(vec2(px, py))
    let inv_cos = 1.0 / max(dot(ray, v.forward), 0.1)

    var accum = vec3(0.0)
    var trans = 1.0
    var z_prev = VOL_NEAR
    for k in 0..FROXEL_D {
        if k > id.z {
            break
        }
        let z_next = if k == id.z { slice_z(f32(k) + 0.5) } else { slice_z(f32(k + 1)) }
        let ds = (z_next - z_prev) * inv_cos
        z_prev = z_next
        let s = raw.load(id.x, id.y, k)
        let sigma = max(s.w, 0.0)
        let step_t = exp(-sigma * ds)
        let integ = if sigma > 1.0e-5 { (1.0 - step_t) / sigma } else { ds }
        accum += trans * s.xyz * integ
        trans *= step_t
    }
    out.store(id, vec4(accum, trans))
}

// ---- Optical HDR Bloom Pyramid (4-level Dual Kawase with Karis firefly suppression) ----

fn karis_weight(c: vec3) -> f32 {
    1.0 / (1.0 + max(luma(c), 0.0))
}

fn soft_threshold(c: vec3, threshold: f32, knee: f32) -> vec3 {
    let br = max(c.x, max(c.y, c.z))
    let k = max(knee, 1.0e-4)
    let rq = clamp(br - threshold + k, 0.0, 2.0 * k)
    let soft = (rq * rq) / (4.0 * k)
    let contrib = max(soft, br - threshold) / max(br, 1.0e-5)
    c * max(contrib, 0.0)
}

/// Bloom prefilter: downsamples HDR image 2× with Karis firefly average and soft threshold knee.
@fragment
fn bloom_prefilter_fs(
    pixel: FragCoord,
    src: Texture<Rgba16Float>,
    s: Sampler,
    inv_dst: vec2,
    inv_src: vec2,
    bloom: Bloom,
) -> vec4 {
    let uv = pixel.position.xy * inv_dst
    let o = inv_src * 0.5
    let c0 = soft_threshold(
        max(src.sample_level(s, uv + vec2(-o.x, -o.y), 0.0).xyz, vec3(0.0)),
        bloom.threshold,
        bloom.knee,
    )
    let c1 = soft_threshold(
        max(src.sample_level(s, uv + vec2(o.x, -o.y), 0.0).xyz, vec3(0.0)),
        bloom.threshold,
        bloom.knee,
    )
    let c2 = soft_threshold(
        max(src.sample_level(s, uv + vec2(-o.x, o.y), 0.0).xyz, vec3(0.0)),
        bloom.threshold,
        bloom.knee,
    )
    let c3 = soft_threshold(
        max(src.sample_level(s, uv + vec2(o.x, o.y), 0.0).xyz, vec3(0.0)),
        bloom.threshold,
        bloom.knee,
    )
    let w0 = karis_weight(c0)
    let w1 = karis_weight(c1)
    let w2 = karis_weight(c2)
    let w3 = karis_weight(c3)
    let avg = (c0 * w0 + c1 * w1 + c2 * w2 + c3 * w3) / max(w0 + w1 + w2 + w3, 1.0e-5)
    vec4(min(avg, vec3(64.0)), 1.0)
}

/// 5-tap Kawase downsample.
@fragment
fn bloom_down_fs(
    pixel: FragCoord,
    src: Texture<Rgba16Float>,
    s: Sampler,
    inv_dst: vec2,
    inv_src: vec2,
) -> vec4 {
    let uv = pixel.position.xy * inv_dst
    let o = inv_src
    var sum = src.sample_level(s, uv, 0.0).xyz * 4.0
    sum += src.sample_level(s, uv + vec2(-o.x, -o.y), 0.0).xyz
    sum += src.sample_level(s, uv + vec2(o.x, -o.y), 0.0).xyz
    sum += src.sample_level(s, uv + vec2(-o.x, o.y), 0.0).xyz
    sum += src.sample_level(s, uv + vec2(o.x, o.y), 0.0).xyz
    vec4(sum * 0.125, 1.0)
}

/// 9-tap tent upsample + additive blend with the finer pyramid level.
@fragment
fn bloom_up_fs(
    pixel: FragCoord,
    lo: Texture<Rgba16Float>,
    hi: Texture<Rgba16Float>,
    s: Sampler,
    inv_dst: vec2,
    inv_lo: vec2,
    radius: f32,
) -> vec4 {
    let uv = pixel.position.xy * inv_dst
    let o = inv_lo * max(radius, 0.5)
    var tent = lo.sample_level(s, uv, 0.0).xyz * 4.0
    tent += (lo.sample_level(s, uv + vec2(-o.x, 0.0), 0.0).xyz +
        lo.sample_level(s, uv + vec2(o.x, 0.0), 0.0).xyz +
        lo.sample_level(s, uv + vec2(0.0, -o.y), 0.0).xyz +
        lo.sample_level(s, uv + vec2(0.0, o.y), 0.0).xyz) *
        2.0
    tent += lo.sample_level(s, uv + vec2(-o.x, -o.y), 0.0).xyz +
        lo.sample_level(s, uv + vec2(o.x, -o.y), 0.0).xyz +
        lo.sample_level(s, uv + vec2(-o.x, o.y), 0.0).xyz +
        lo.sample_level(s, uv + vec2(o.x, o.y), 0.0).xyz
    let base = hi.sample_level(s, uv, 0.0).xyz
    vec4(base + tent * 0.0625, 1.0)
}

/// Persistent 4-level HDR optical bloom pyramid (`W/2 .. W/16`, ~4 MB at 1080p).
pub struct BloomPyramid {
    pub d0: Texture<Rgba16Float>,
    pub d1: Texture<Rgba16Float>,
    pub d2: Texture<Rgba16Float>,
    pub d3: Texture<Rgba16Float>,
    pub u2: Texture<Rgba16Float>,
    pub u1: Texture<Rgba16Float>,
    pub u0: Texture<Rgba16Float>,
    pub s: Sampler,
    w: u32,
    h: u32,
}

pub fn bloom_pyramid() -> BloomPyramid {
    BloomPyramid {
        d0: texture(width: 1, height: 1),
        d1: texture(width: 1, height: 1),
        d2: texture(width: 1, height: 1),
        d3: texture(width: 1, height: 1),
        u2: texture(width: 1, height: 1),
        u1: texture(width: 1, height: 1),
        u0: texture(width: 1, height: 1),
        s: sampler(filter: Filter::Linear, address: Address::Clamp),
        w: 0,
        h: 0,
    }
}

/// Sizes of the 4 pyramid levels for a `width × height` image (each half the last, at least 1).
fn levels(width: u32, height: u32) -> [vec2u; 4] {
    var sizes = [vec2u(1, 1); 4]
    var w = width
    var h = height
    for i in 0..4 {
        w = max(w / 2, 1)
        h = max(h / 2, 1)
        sizes[i] = vec2u(w, h)
    }
    sizes
}

/// One texel's size in uv for a level of size `size`.
fn texel(size: vec2u) -> vec2 {
    vec2(1.0 / f32(size.x), 1.0 / f32(size.y))
}

impl BloomPyramid {
    fn resize(mut self, width: u32, height: u32) {
        if self.w == width && self.h == height {
            return
        }
        let l = levels(width, height)
        self.d0 = texture(width: l[0].x, height: l[0].y)
        self.d1 = texture(width: l[1].x, height: l[1].y)
        self.d2 = texture(width: l[2].x, height: l[2].y)
        self.d3 = texture(width: l[3].x, height: l[3].y)
        self.u2 = texture(width: l[2].x, height: l[2].y)
        self.u1 = texture(width: l[1].x, height: l[1].y)
        self.u0 = texture(width: l[0].x, height: l[0].y)
        self.w = width
        self.h = height
    }

    /// Runs the 4-level Dual Kawase bloom pyramid if `bloom.strength > 0.0` (0 ms when disabled).
    pub fn build(mut self, hdr: Texture<Rgba16Float>, width: u32, height: u32, bloom: Bloom) {
        if bloom.strength <= 1.0e-5 {
            return
        }
        self.resize(width, height)
        label("mesh_bloom")
        let l = levels(width, height)

        let p0 = begin_pass(mut self.d0, keep: false)
        draw(
            p0,
            cover,
            bloom_prefilter_fs.bind(
                src: hdr,
                s: self.s,
                inv_dst: texel(l[0]),
                inv_src: texel(vec2u(max(width, 1), max(height, 1))),
                bloom: bloom,
            ),
            vertices: 3,
        )
        p0.end()

        let p1 = begin_pass(mut self.d1, keep: false)
        draw(
            p1,
            cover,
            bloom_down_fs.bind(src: self.d0, s: self.s, inv_dst: texel(l[1]), inv_src: texel(l[0])),
            vertices: 3,
        )
        p1.end()

        let p2 = begin_pass(mut self.d2, keep: false)
        draw(
            p2,
            cover,
            bloom_down_fs.bind(src: self.d1, s: self.s, inv_dst: texel(l[2]), inv_src: texel(l[1])),
            vertices: 3,
        )
        p2.end()

        let p3 = begin_pass(mut self.d3, keep: false)
        draw(
            p3,
            cover,
            bloom_down_fs.bind(src: self.d2, s: self.s, inv_dst: texel(l[3]), inv_src: texel(l[2])),
            vertices: 3,
        )
        p3.end()

        let pu2 = begin_pass(mut self.u2, keep: false)
        draw(
            pu2,
            cover,
            bloom_up_fs.bind(
                lo: self.d3,
                hi: self.d2,
                s: self.s,
                inv_dst: texel(l[2]),
                inv_lo: texel(l[3]),
                radius: bloom.radius,
            ),
            vertices: 3,
        )
        pu2.end()

        let pu1 = begin_pass(mut self.u1, keep: false)
        draw(
            pu1,
            cover,
            bloom_up_fs.bind(
                lo: self.u2,
                hi: self.d1,
                s: self.s,
                inv_dst: texel(l[1]),
                inv_lo: texel(l[2]),
                radius: bloom.radius,
            ),
            vertices: 3,
        )
        pu1.end()

        let pu0 = begin_pass(mut self.u0, keep: false)
        draw(
            pu0,
            cover,
            bloom_up_fs.bind(
                lo: self.u1,
                hi: self.d0,
                s: self.s,
                inv_dst: texel(l[0]),
                inv_lo: texel(l[1]),
                radius: bloom.radius,
            ),
            vertices: 3,
        )
        pu0.end()
    }
}

/// Final unified composite + optional optical bloom + `Look::tone` fragment shader: reads linear
/// HDR radiance, composites volumetric froxels up to the exact resolved depth hit, adds optical
/// HDR bloom when enabled by `look.bloom()`, and applies `Look::tone` ONCE.
@fragment
pub fn hdr_tone_fs<L: Look>(
    pixel: FragCoord,
    hdr: Texture<Rgba16Float>,
    depth: DepthTexture,
    froxel_acc: Texture3d<Rgba16Float>,
    vol_s: Sampler,
    vol_active: u32,
    bloom_tex: Texture<Rgba16Float>,
    bloom_s: Sampler,
    bloom_strength: f32,
    v: View,
    look: L,
) -> vec4 {
    let px = u32(pixel.position.x)
    let py = u32(pixel.position.y)
    var rad = hdr.load(px, py).xyz
    let uv = pixel.position.xy / max(v.size, vec2(1.0))
    if vol_active != 0 {
        let ndc_z = depth.load(px, py)
        let lin_z = if ndc_z > 1.0e-6 { min(NEAR / ndc_z, VOL_FAR) } else { VOL_FAR }
        let w = z_to_w(lin_z)
        let vol = froxel_acc.sample_level(vol_s, vec3(uv.x, uv.y, w), 0.0)
        rad = rad * vol.w + vol.xyz
    }
    if bloom_strength > 1.0e-5 {
        rad += bloom_tex.sample_level(bloom_s, uv, 0.0).xyz * bloom_strength
    }
    vec4(look.tone(Seen { light: rad }), 1.0)
}

/// Persistent GPU 3D froxel volumes for participating media.
pub struct FroxelVolume {
    pub raw: Texture3d<Rgba16Float>,
    pub acc: Texture3d<Rgba16Float>,
    pub s: Sampler,
}

/// Allocates a fresh `FroxelVolume` (~7.4 MB VRAM across `raw` and `acc`).
pub fn froxel_volume() -> FroxelVolume {
    FroxelVolume {
        raw: texture3d(width: FROXEL_W, height: FROXEL_H, depth: FROXEL_D),
        acc: texture3d(width: FROXEL_W, height: FROXEL_H, depth: FROXEL_D),
        s: sampler(filter: Filter::Linear, address: Address::Clamp),
    }
}

impl FroxelVolume {
    /// Scatters and integrates `medium` across the frustum if its kind is `Medium::ACTIVE`.
    pub fn update<Med: Medium, S: Sky>(
        mut self,
        medium: Med,
        v: View,
        sv: ShadowView,
        rad_grid: RadGrid,
        sky: S,
        sky_table: Texture<Rgba16Float>,
        sky_s: Sampler,
        shadow_map: DepthTexture,
        static_shadow_map: DepthTexture,
        has_static_shadow: u32,
        rad1: Texture3d<Rgba16Float>,
        rad2: Texture3d<Rgba16Float>,
        rad_s: Sampler,
        emitters: GpuSpan<Emitter>,
        emitter_count: GpuSpan<u32>,
    ) {
        if !Med::ACTIVE {
            return
        }
        label("mesh_volume")
        dispatch(
            froxel_scatter.bind(
                medium: medium,
                v: v,
                sv: sv,
                rad_grid: rad_grid,
                sky: sky,
                sky_table: sky_table,
                sky_s: sky_s,
                shadow_map: shadow_map,
                static_shadow_map: static_shadow_map,
                has_static_shadow: has_static_shadow,
                rad1: rad1,
                rad2: rad2,
                rad_s: rad_s,
                emitters: emitters,
                emitter_count: emitter_count,
                out: mut self.raw,
            ),
            over: (FROXEL_W, FROXEL_H, FROXEL_D),
        )
        dispatch(
            froxel_integrate.bind(raw: self.raw, v: v, out: mut self.acc),
            over: (FROXEL_W, FROXEL_H, FROXEL_D),
        )
    }
}
