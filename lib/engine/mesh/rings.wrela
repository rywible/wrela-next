// The levels a thing is meshed at, by the eye's distance alone: nested rings on one lattice of
// cells anchored to the thing (not to the eye, nor to where it looks), each a power of two of a
// metre, so a brick of a level is the same brick from every eye that wants it and turning the eye
// changes no brick.
//
// Level `k` has cells `2^k` m wide. A point `d` m from the eye wants cells no wider than
// `cell_px` pixels there: `2^k <= cell_px · px · d` (`px` the pixel's width a metre out). So
// level `k` is wanted out to `R_k = 2^(k+1) / (cell_px · px)`, where level `k + 1` is fine enough:
// the ring of level `k` is the cube about the eye of half-width `R_k`, snapped out to its parent
// level's bricks. Each ring keeps at least one parent brick inside its parent's seam faces (2:1:
// no cell meets one more than twice its width), and the coarsest level holds the whole thing.
//
// A ring moves only when the eye leaves the parent bricks round its centre (`RING_SLACK` of them):
// its centre is the eye snapped to that lattice, and its half-width grows by as much, so it always
// holds `R_k`. Between such moves, nothing about the cut changes.

use matter::substance::Substance
use mesh::grid::{BRICK, GridSpec, MAX_LOD_LEVELS, NONE}
use std::collections::Vec
use std::derive::Box3
use std::gpu::{Atomics, DepthTexture, GlobalId, Rg32Uint, Texture}

/// The parent bricks the eye may move from a ring's centre before the ring moves with it.
pub const RING_SLACK: f32 = 2.0

/// The most bricks the coarsest level spans along its longest axis: past it, it is coarser.
pub const ROOT_BRICKS: f32 = 64.0

/// `2^k`.
fn pow2(k: i32) -> f32 {
    exp2(f32(k))
}

/// The level whose cells are no wider than `h` (and `2^(k+1)` wider).
pub fn level_of(h: f32) -> i32 {
    i32(floor(log2(max(h, 1.0e-6))))
}

/// The distance from `e` to the nearest point of box `b` (0 inside it), and to the farthest.
fn box_reach(b: Box3, e: vec3) -> (f32, f32) {
    let near = length(max(max(b.lo - e, e - b.hi), vec3(0.0)))
    let far = length(max(abs(b.lo - e), abs(b.hi - e)))
    (near, far)
}

/// The steps a ring's reach takes below the rule's (`ring_reach`): a quarter of a power of two.
pub const REACH_STEP: f32 = 1.1892071

/// The most steps in (`REACH_STEP`) a reach takes: a 64th of the rule's.
pub const REACH_STEPS: u32 = 24

/// The share of what a batch holds a reach chosen afresh aims its kept bricks at (`ring_reach`):
/// a cut whose cull keeps more of its candidates than the last one did still fits.
pub const REACH_AIM: f32 = 0.7

/// The share of what a batch holds a step out may keep for a reach to grow (`ring_reach`): below
/// `REACH_AIM`, so a reach chosen afresh at it doesn't grow on the next readback (the citadel's
/// cull keeps 5 to 17 in a hundred of a cut's candidates as the eye moves).
pub const REACH_GROW: f32 = 0.5

/// The levels whose share of candidates kept a batch keeps (`level_slot`): cells from 2^-24 m to
/// 2^7 m.
pub const LEVEL_SLOTS: u32 = 32
const LEVEL_BIAS: i32 = 24

/// The slot of a level whose cell is `cell` (a power of two) among `LEVEL_SLOTS`.
pub fn level_slot(cell: f32) -> u32 {
    u32(clamp(i32(round(log2(max(cell, 1.0e-30)))) + LEVEL_BIAS, 0, i32(LEVEL_SLOTS) - 1))
}

/// The candidate bricks of grid `g`: its bricks less its finer level's hole.
pub fn grid_candidates(g: GridSpec) -> u32 {
    let all = g.dims.x * g.dims.y * g.dims.z
    if g.has_hole == 0 {
        return all
    }
    let h = (g.hole_max - g.hole_min) / BRICK
    all - min(h.x * h.y * h.z, all)
}

/// The share of its candidates a level of cell slot `slot` keeps, by `shares`: its own where it was
/// read for this eye (0 or more), else (below 0) `fallback`; and `fallback` where it was read to
/// keep none if `grown` (its ring larger than the one read, which may reach the surface it missed).
pub fn level_share(shares: [f32; LEVEL_SLOTS], slot: u32, fallback: f32, grown: bool = false) -> f32 {
    if shares[slot] > 0.0 || (shares[slot] == 0.0 && !grown) { shares[slot] } else { fallback }
}

/// The candidate bricks of grid `g` that may hold a surface no nearer the eye `eye` than `clear`:
/// none where the whole of its box is nearer (a level an eye in open space has round it).
pub fn grid_reached(g: GridSpec, eye: vec3, clear: f32) -> u32 {
    let lo = g.origin + g.shift + vec3(f32(g.cell_offset.x), f32(g.cell_offset.y), f32(g.cell_offset.z)) * g.cell
    let hi = lo + vec3(f32(g.dims.x), f32(g.dims.y), f32(g.dims.z)) * (g.cell * f32(BRICK + 1))
    let far = length(max(abs(lo - eye), abs(hi - eye)))
    if far < clear { 0 } else { grid_candidates(g) }
}

/// The bricks the rings `build_ring_grids` makes at `reach` keep, as `shares` say each level's
/// cull keeps (`level_share`), none of a level whose box lies within `clear` of the eye.
pub fn ring_kept(
    aabb: Box3,
    eye: vec3,
    px: f32,
    cell_px: f32,
    h_floor: f32,
    shift: vec3,
    reach: f32,
    shares: [f32; LEVEL_SLOTS],
    fallback: f32,
    clear: f32,
    grown: bool,
) -> f32 {
    let (grids, _, _) = build_ring_grids(aabb, eye, px, cell_px, h_floor, orig_id: 0, shift: shift, reach: reach)
    var kept = 0.0
    for i in 0..grids.len() {
        kept += level_share(shares, level_slot(grids[i].cell), fallback, grown: grown) * f32(grid_reached(grids[i], eye, clear))
    }
    kept
}

/// The reach of the rings (`build_ring_grids`' `reach`) for a batch that holds `holds` bricks and
/// whose cull keeps `shares` of each level's candidates (as its readbacks found for this eye,
/// `level_share`; `fallback` where none was), with no surface within `clear` of the eye. The last
/// reach, `last`, while the bricks it would keep are no more than the batch holds; one step out
/// (`REACH_STEP`) where `may_grow` (the shares were read of a cut at `last`) and that step would
/// keep no more than `REACH_GROW` of it, a level read to keep none taken at `fallback` (its ring
/// grows, and may reach the surface it missed: a walking creature's finest rings, read empty at a
/// cautious first cut, held 65,536 bricks at the rule's reach). Else the most, `last` or a power of
/// `1 / REACH_STEP` below it (the rule's, 1, for a first cut), whose bricks are no more than
/// `REACH_AIM` of it. With it, whether a step in was still to be had: false when the rings at a
/// 64th of the rule's reach keep more (what the batch's cells coarsen for, `took_counts`).
pub fn ring_reach(
    aabb: Box3,
    eye: vec3,
    px: f32,
    cell_px: f32,
    h_floor: f32,
    shift: vec3,
    holds: u32,
    shares: [f32; LEVEL_SLOTS],
    fallback: f32,
    clear: f32,
    last: f32,
    may_grow: bool,
) -> (f32, bool) {
    let room = f32(holds)
    let aim = REACH_AIM * room
    let valid = last > 0.0 && last <= 1.0
    if valid && ring_kept(aabb, eye, px, cell_px, h_floor, shift, last, shares, fallback, clear, grown: false) <= room {
        if last < 1.0 && may_grow {
            let out = min(last * REACH_STEP, 1.0)
            if ring_kept(aabb, eye, px, cell_px, h_floor, shift, out, shares, fallback, clear, grown: true) <= REACH_GROW * room {
                return (out, true)
            }
        }
        return (last, true)
    }
    var reach = if valid { last } else { 1.0 }
    for _step in 0..REACH_STEPS {
        if ring_kept(aabb, eye, px, cell_px, h_floor, shift, reach, shares, fallback, clear, grown: false) <= aim {
            return (reach, true)
        }
        reach = reach / REACH_STEP
    }
    (reach, false)
}

/// The finest cell a ring has (m): no finer than `CELL_LEAST` four times over, the finest a
/// thing seen closest is meshed at.
pub const RING_FINEST: f32 = 0.0004

/// The lattice the rings of a thing whose tight box is `aabb` stand on, the world's placed at
/// `shift` (`grid::lattice`): its origin, whole steps of `BRICK` cells of the thing's coarsest
/// possible root level (`ROOT_BRICKS` across its span) from the world's origin, below the box's
/// low corner less a margin and less `shift`, so the grids cover the box whatever the placement
/// (one at the box's own corner, `shift` on, lost the book's low side at the gate's fifth
/// placement, 15 cm up, and its shadow). The same for every eye. Every level's corners are at whole
/// numbers of its own cells from it, and a corner a finer level shares with a coarser is the same
/// sum of the same origin and a power of two times a whole number, the same bits.
pub fn ring_anchor(aabb: Box3, shift: vec3) -> vec3 {
    let span = max(aabb.hi.x - aabb.lo.x, max(aabb.hi.y - aabb.lo.y, aabb.hi.z - aabb.lo.z))
    let k_root = i32(ceil(log2(max(span / (ROOT_BRICKS * f32(BRICK)), 1.0e-6))))
    let step = f32(BRICK) * pow2(k_root)
    floor((aabb.lo - vec3(0.02 * span + 1.0e-3) - shift) / step) * step
}

/// The rings of a thing whose tight box is `aabb`, for an eye at `eye` whose pixel is `px` wide
/// (each reaching `reach` of the distance the rule wants it to: 1 but where what the batch holds
/// is less, `ring_reach`)
/// a metre out, cells `cell_px` pixels wide, the coarsest no finer than `h_floor` (`grid::
/// size_floor`, what a compact thing's surface fits in) and none finer than `RING_FINEST`: the
/// grids
/// (`grid::GridSpec`, nested as `build_lod_grids` nests them, each level's cell `2^k`), their
/// bricks in all, and whether any level has a seam.
pub fn build_ring_grids(
    aabb: Box3,
    eye: vec3,
    px: f32,
    cell_px: f32,
    h_floor: f32,
    orig_id: u32,
    shift: vec3,
    reach: f32 = 1.0,
) -> (Vec<GridSpec>, u32, bool) {
    let per = cell_px * max(px, 1.0e-7)
    let (near, far) = box_reach(aabb, eye)
    let span = max(aabb.hi.x - aabb.lo.x, max(aabb.hi.y - aabb.lo.y, aabb.hi.z - aabb.lo.z))
    let k_least = i32(ceil(log2(RING_FINEST)))
    // The coarsest level: fine enough for the farthest point, no finer than `h_floor`, and no
    // more bricks across than `ROOT_BRICKS`.
    var k_top = max(level_of(per * far), level_of(h_floor))
    k_top = max(k_top, i32(ceil(log2(max(span / (ROOT_BRICKS * f32(BRICK)), 1.0e-6)))))
    // The finest: fine enough for the nearest point, within `MAX_LOD_LEVELS` of the coarsest.
    let k_near = clamp(level_of(per * max(near, 1.0e-3)), max(k_least, k_top - i32(MAX_LOD_LEVELS) + 1), k_top)
    let origin = ring_anchor(aabb, shift)
    let h_top = pow2(k_top)
    let bspan = h_top * f32(BRICK)
    let d = aabb.hi + vec3(2.0 * h_top) - origin - shift
    var grids: Vec<GridSpec> = Vec::new()
    grids.push(
        GridSpec {
            origin,
            cell: h_top,
            dims: vec3u(
                max(u32(ceil(d.x / bspan)), 1),
                max(u32(ceil(d.y / bspan)), 1),
                max(u32(ceil(d.z / bspan)), 1),
            ),
            base_brick: 0,
            orig_id,
            seam_mask: 0,
            parent_grid: NONE,
            has_hole: 0,
            hole_min: vec3u(0, 0, 0),
            pad0: 0,
            hole_max: vec3u(0, 0, 0),
            pad1: 0,
            cell_offset: vec3u(0, 0, 0),
            pad2: 0,
            parent_hole_min: vec3u(0, 0, 0),
            pad3: 0,
            shift,
            pad4: 0,
        },
    )
    var k = k_top - 1
    while k >= k_near {
        let pi = grids.len() - 1
        let prev = grids[pi]
        let pbspan = prev.cell * f32(BRICK)
        let prev_origin = prev.origin +
            vec3(f32(prev.cell_offset.x), f32(prev.cell_offset.y), f32(prev.cell_offset.z)) * prev.cell
        let min_x: i32 = if (prev.seam_mask & 1) != 0 { 1 } else { 0 }
        let min_y: i32 = if (prev.seam_mask & 4) != 0 { 1 } else { 0 }
        let min_z: i32 = if (prev.seam_mask & 16) != 0 { 1 } else { 0 }
        let max_x: i32 = i32(prev.dims.x) - (if (prev.seam_mask & 2) != 0 { 1 } else { 0 })
        let max_y: i32 = i32(prev.dims.y) - (if (prev.seam_mask & 8) != 0 { 1 } else { 0 })
        let max_z: i32 = i32(prev.dims.z) - (if (prev.seam_mask & 32) != 0 { 1 } else { 0 })
        if min_x >= max_x || min_y >= max_y || min_z >= max_z {
            break
        }
        // The ring: the eye snapped to the parent's bricks `RING_SLACK` at a time, and the
        // distance level `k` is wanted to (`R_k`) and that slack past it.
        let step = RING_SLACK * pbspan
        let centre = origin + (floor((eye - origin) / step) + vec3(0.5)) * step
        let half = reach * pow2(k + 1) / per + step
        let lo_f = (centre - vec3(half) - prev_origin) / pbspan
        let hi_f = (centre + vec3(half) - prev_origin) / pbspan
        let lo_x = max(min_x, i32(floor(lo_f.x)))
        let hi_x = min(max_x, i32(ceil(hi_f.x)))
        let lo_y = max(min_y, i32(floor(lo_f.y)))
        let hi_y = min(max_y, i32(ceil(hi_f.y)))
        let lo_z = max(min_z, i32(floor(lo_f.z)))
        let hi_z = min(max_z, i32(ceil(hi_f.z)))
        if lo_x >= hi_x || lo_y >= hi_y || lo_z >= hi_z {
            break
        }
        let blo = vec3u(u32(lo_x), u32(lo_y), u32(lo_z))
        let bhi = vec3u(u32(hi_x), u32(hi_y), u32(hi_z))
        let hole_min = blo * BRICK
        let hole_max = bhi * BRICK
        var sm: u32 = 0
        if blo.x > 0 {
            sm |= 1
        }
        if bhi.x < prev.dims.x {
            sm |= 2
        }
        if blo.y > 0 {
            sm |= 4
        }
        if bhi.y < prev.dims.y {
            sm |= 8
        }
        if blo.z > 0 {
            sm |= 16
        }
        if bhi.z < prev.dims.z {
            sm |= 32
        }
        let child = GridSpec {
            origin: prev.origin,
            cell: 0.5 * prev.cell,
            dims: (bhi - blo) * 2,
            base_brick: 0,
            orig_id,
            seam_mask: sm,
            parent_grid: pi,
            has_hole: 0,
            hole_min: vec3u(0, 0, 0),
            pad0: 0,
            hole_max: vec3u(0, 0, 0),
            pad1: 0,
            cell_offset: (prev.cell_offset + hole_min) * 2,
            pad2: 0,
            parent_hole_min: hole_min,
            pad3: 0,
            shift: prev.shift,
            pad4: 0,
        }
        if sm == 0 && prev.seam_mask == 0 {
            // The ring holds all of its parent: the parent goes, and the ring is the coarsest.
            grids[pi] = GridSpec { seam_mask: 0, parent_grid: NONE, parent_hole_min: vec3u(0, 0, 0), ..child }
        } else {
            grids[pi] = GridSpec { has_hole: 1, hole_min, hole_max, ..prev }
            grids.push(child)
        }
        k -= 1
    }
    var total: u32 = 0
    var seams = false
    for i in 0..grids.len() {
        let g = grids[i]
        grids[i] = GridSpec { base_brick: total, ..g }
        total += g.dims.x * g.dims.y * g.dims.z
        if g.seam_mask != 0 {
            seams = true
        }
    }
    (grids, total, seams)
}

// ---- the pixels drawn coarser than the rule wants ---------------------------------------------
//
// A pixel of a meshed thing is drawn from the finest level of its batch's drawn cut that holds the
// point the pixel shows (`drawn_cell`): its cell is the pixel's. The rule wants that cell no wider
// than `rule` pixels at the point's distance (`rule · px · d`, `rule` the batch's `CELL_PX`, finer
// for a steep field); a pixel whose cell is wider is drawn coarser than the rule wants. What a
// moving eye sees drawn coarse is the rings' and the pool's lateness: rings that stop short of
// their reach, or a cut not yet drawn. (A batch drawn in a frame of its own, placed or posed, is
// not counted: its pixels are `counts[2]`.)

/// The cell of the finest of the first `levels` grids of `cuts` (from `base`, coarsest first) that
/// holds `p` outside its hole, or 0 when none does.
pub(package) fn drawn_cell(cuts: [GridSpec], base: u32, levels: u32, p: vec3) -> f32 {
    var cell = 0.0
    for k in 0..MAX_LOD_LEVELS {
        if k >= levels {
            break
        }
        let g = cuts[base + k]
        let lo = g.origin + vec3(f32(g.cell_offset.x), f32(g.cell_offset.y), f32(g.cell_offset.z)) * g.cell + g.shift
        let span = vec3(f32(g.dims.x), f32(g.dims.y), f32(g.dims.z)) * (g.cell * f32(BRICK))
        let q = p - lo
        if q.x >= 0.0 && q.y >= 0.0 && q.z >= 0.0 && q.x < span.x && q.y < span.y && q.z < span.z {
            let c = vec3u(u32(q.x / g.cell), u32(q.y / g.cell), u32(q.z / g.cell))
            let in_hole = g.has_hole != 0 &&
                c.x >= g.hole_min.x && c.x < g.hole_max.x &&
                c.y >= g.hole_min.y && c.y < g.hole_max.y &&
                c.z >= g.hole_min.z && c.z < g.hole_max.z
            if !in_hole {
                cell = g.cell
            }
        }
    }
    cell
}

/// The words of `coarse_pixels`' counts: three of the whole frame (and one spare), then a row of
/// each of the first `COARSE_BATCHES` batches (the last for the rest): its pixels judged, drawn
/// coarse, and how many times the rule's cell those were, summed in sixteenths.
pub const COARSE_ROWS: u32 = 8
pub const COARSE_ROW_WORDS: u32 = 4
pub const COARSE_BATCHES: u32 = 16
pub const COARSE_WORDS: u32 = COARSE_ROWS + COARSE_ROW_WORDS * COARSE_BATCHES

/// The pixels `coarse_pixels` judges: the middle one of each `COARSE_STRIDE` × `COARSE_STRIDE`
/// block, a sample whose shares are the frame's (a judge of every pixel adds to the same few
/// counts two million times a 1080p frame: 4.7 ms on the M4, inside the frames the gate times).
pub const COARSE_STRIDE: u32 = 4

/// Each pixel of the frame's sample (`COARSE_STRIDE`) held to the rule: `counts[0]` the pixels judged, `[1]` those drawn
/// coarser than the rule wants, `[2]` those of a batch that draws no cut, and each batch's row. A batch's `levels` is its
/// cut's grids, coarsest first, or with bit 31 set the one grid of a thing meshed in a frame of
/// its own (placed or posed: its cell is the pixel's wherever the point lies). The point a
/// pixel shows is the eye's ray to its depth (`NEAR / depth` along the view, the reversed depth of
/// `light::clip_of`).
@compute(8, 8)
pub(package) fn coarse_pixels(
    vis: Texture<Rg32Uint>,
    depth: DepthTexture,
    width: u32,
    height: u32,
    eye: vec3,
    forward: vec3,
    right: vec3,
    up: vec3,
    focal: f32,
    near: f32,
    cuts: [GridSpec],
    levels: [u32],
    rules: [f32],
    n_batches: u32,
    counts: mut Atomics<u32>,
    id: GlobalId,
) {
    let x = id.x * COARSE_STRIDE + COARSE_STRIDE / 2
    let y = id.y * COARSE_STRIDE + COARSE_STRIDE / 2
    if x >= width || y >= height {
        return
    }
    let h = vis.load(x, y).x
    if (h & 2147483648) == 0 {
        return
    }
    let batch = (h >> 16) & 8191
    if batch >= n_batches || levels[batch] == 0 {
        let _ = counts.add(i: 2, value: 1)
        return
    }
    let z_rev = depth.load(x, y)
    if !(z_rev > 0.0) {
        return
    }
    let size = vec2(f32(width), f32(height))
    let uv = ((vec2(f32(x), f32(y)) + vec2(0.5)) * 2.0 - size) / size.y
    let ray = normalize(forward * focal + right * uv.x - up * uv.y)
    let z = near / z_rev
    let t = z / max(dot(ray, forward), 1.0e-6)
    let p = eye + ray * t
    // A thing meshed in a frame of its own (placed or posed) is meshed at its one grid's cell.
    let placed = (levels[batch] & 2147483648) != 0
    let cell = if placed { cuts[batch * MAX_LOD_LEVELS].cell } else {
        drawn_cell(cuts, batch * MAX_LOD_LEVELS, levels[batch], p)
    }
    let _ = counts.add(i: 0, value: 1)
    let px = 2.0 / (size.y * focal)
    let row = COARSE_ROWS + COARSE_ROW_WORDS * min(batch, COARSE_BATCHES - 1)
    let _ = counts.add(i: row, value: 1)
    if cell > rules[batch] * px * t {
        let _ = counts.add(i: 1, value: 1)
        let _ = counts.add(i: row + 1, value: 1)
        // How many times the rule's cell it is, in sixteenths (64 times at most).
        let over = cell / max(rules[batch] * px * t, 1.0e-9)
        let _ = counts.add(i: row + 2, value: u32(min(over, 64.0) * 16.0))
    }
}
