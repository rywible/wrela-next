// Persistent GPU sparse brick pool (`BrickPool`) and non-generic compute kernels for continual
// per-brick streaming LOD:
// - Stores each cached octree brick's interior indices, 2:1 seam indices, optional trans/cut
//   indices, and exact cells (packed 8 × u32 = 32 B/cell) in persistent GPU arenas indexed by
//   `pool_slot`.
// - Compacts ONLY the currently active leaf slots into dense `MeshBatch::indices` and
//   `MeshBatch::exact_cells` in `< 0.02 ms` whenever bricks split or merge, keeping 64-bit
//   Visibility Buffer (`PrimitiveIndex`) and single-draw rendering 100% untouched.

use mesh::emit::{quad_order, split_seam_13}
use mesh::grid::{
    CAP_EXACT_MAX, CAP_SEAM, ExactCell, MeshVertex, NONE, OVERFLOW_CREASES, OVERFLOW_CUT,
    OVERFLOW_EXACT, OVERFLOW_INDICES, OVERFLOW_SEAMS, OVERFLOW_THIN, OVERFLOW_TRANS, SeamQuad,
    unpack_is_trans, unpack_oct_normal,
}
use std::field::Live
use std::gpu::{
    Append, Atomics, DrawIndexedArgs, GlobalId, GpuBuffer, GpuSpan, One, Slots, buffer, buffer_of,
    dispatch,
}

/// Maximum active leaf slots compacted in one 2-level scan (`256 groups * 64 = 16,384` active bricks).
pub const POOL_SCAN_GROUPS: u32 = 256
pub const POOL_SCAN_GROUP_SIZE: u32 = 64
pub const POOL_MAX_ACTIVE: u32 = POOL_SCAN_GROUPS * POOL_SCAN_GROUP_SIZE

/// Maximum exact cells collected during a single dirty-brick streaming batch (`<= 1024` bricks).
pub const CAP_BATCH_EXACT: u32 = 65536

/// Per-brick persistent GPU metadata & arena backing one `MeshBatch`'s streaming octree.
pub struct BrickPool {
    pub cap_slots: u32,
    pub cap_pool_idx: u32,
    pub cap_pool_trans: u32,
    pub cap_pool_exact: u32,
    /// `[0] = pool_indices cursor`, `[1] = pool_trans cursor`, `[2] = pool_cut cursor`,
    /// `[3] = pool_exact cursor`.
    pub cursors: GpuBuffer<u32>,
    pub idx_offset: GpuBuffer<u32>,
    pub idx_count: GpuBuffer<u32>,
    pub seam_offset: GpuBuffer<u32>,
    pub seam_count: GpuBuffer<u32>,
    pub trans_offset: GpuBuffer<u32>,
    pub trans_count: GpuBuffer<u32>,
    pub seam_trans_offset: GpuBuffer<u32>,
    pub seam_trans_count: GpuBuffer<u32>,
    pub cut_offset: GpuBuffer<u32>,
    pub cut_count: GpuBuffer<u32>,
    pub seam_cut_offset: GpuBuffer<u32>,
    pub seam_cut_count: GpuBuffer<u32>,
    pub exact_offset: GpuBuffer<u32>,
    pub exact_count: GpuBuffer<u32>,
    pub pool_indices: GpuBuffer<u32>,
    pub pool_trans_indices: GpuBuffer<u32>,
    pub pool_cut_indices: GpuBuffer<u32>,
    /// Packed `ExactCell` arena (`8 u32`s per cell: `lo.xyz`, `h`, `live.words.xyzw`).
    pub pool_exact_u32: GpuBuffer<u32>,
    /// Reusable active-slot upload + scan buffers for compaction.
    pub active_slots: GpuBuffer<u32>,
    pub active_slots_cap: u32,
    pub active_dst_idx: GpuBuffer<u32>,
    pub active_dst_trans: GpuBuffer<u32>,
    pub active_dst_cut: GpuBuffer<u32>,
    pub scan_group_sums: GpuBuffer<u32>,
    pub scan_group_offsets: GpuBuffer<u32>,
    /// `[0]=opaque_total, [1]=trans_total, [2]=cut_total, [3]=reserved` for current compacted draw.
    pub compact_totals: GpuBuffer<u32>,
}

/// Creates a lazy `BrickPool` (minimal 1-element buffers; allocates real arenas only when used).
pub fn brick_pool() -> BrickPool {
    BrickPool {
        cap_slots: 0,
        cap_pool_idx: 0,
        cap_pool_trans: 0,
        cap_pool_exact: 0,
        cursors: buffer_of([0, 0, 0, 0]),
        idx_offset: buffer(1),
        idx_count: buffer(1),
        seam_offset: buffer(1),
        seam_count: buffer(1),
        trans_offset: buffer(1),
        trans_count: buffer(1),
        seam_trans_offset: buffer(1),
        seam_trans_count: buffer(1),
        cut_offset: buffer(1),
        cut_count: buffer(1),
        seam_cut_offset: buffer(1),
        seam_cut_count: buffer(1),
        exact_offset: buffer(1),
        exact_count: buffer(1),
        pool_indices: buffer(6),
        pool_trans_indices: buffer(6),
        pool_cut_indices: buffer(6),
        pool_exact_u32: buffer(8),
        active_slots: buffer(64),
        active_slots_cap: 64,
        active_dst_idx: buffer(64),
        active_dst_trans: buffer(64),
        active_dst_cut: buffer(64),
        scan_group_sums: buffer(POOL_SCAN_GROUPS),
        scan_group_offsets: buffer(POOL_SCAN_GROUPS),
        compact_totals: buffer_of([0, 0, 0, 0]),
    }
}

impl BrickPool {
    /// Ensures slot metadata arrays and persistent arenas can hold at least `(slots, idx, trans, exact)`.
    /// Returns `true` if any arena had to grow (caller resets octree slots and re-seeds cleanly).
    pub fn ensure_cap(
        mut self,
        want_slots: u32,
        want_idx: u32,
        want_trans: u32,
        want_exact: u32,
    ) -> bool {
        var reset = false
        if want_slots > self.cap_slots {
            var cap = max(self.cap_slots, 1024)
            while cap < want_slots {
                cap *= 2
            }
            self.idx_offset = buffer(cap)
            self.idx_count = buffer(cap)
            self.seam_offset = buffer(cap)
            self.seam_count = buffer(cap)
            self.exact_offset = buffer(cap)
            self.exact_count = buffer(cap)
            if want_trans > 0 || self.cap_pool_trans > 0 {
                self.trans_offset = buffer(cap)
                self.trans_count = buffer(cap)
                self.seam_trans_offset = buffer(cap)
                self.seam_trans_count = buffer(cap)
                self.cut_offset = buffer(cap)
                self.cut_count = buffer(cap)
                self.seam_cut_offset = buffer(cap)
                self.seam_cut_count = buffer(cap)
            }
            self.cap_slots = cap
            reset = true
        }
        if want_idx > self.cap_pool_idx {
            var cap = max(self.cap_pool_idx, 524288)
            while cap < want_idx {
                cap *= 2
            }
            self.pool_indices = buffer(cap)
            self.cap_pool_idx = cap
            reset = true
        }
        if want_trans > self.cap_pool_trans {
            var cap = max(self.cap_pool_trans, 131072)
            while cap < want_trans {
                cap *= 2
            }
            self.pool_trans_indices = buffer(cap)
            self.pool_cut_indices = buffer(cap)
            if self.cap_slots > 0 {
                self.trans_offset = buffer(self.cap_slots)
                self.trans_count = buffer(self.cap_slots)
                self.seam_trans_offset = buffer(self.cap_slots)
                self.seam_trans_count = buffer(self.cap_slots)
                self.cut_offset = buffer(self.cap_slots)
                self.cut_count = buffer(self.cap_slots)
                self.seam_cut_offset = buffer(self.cap_slots)
                self.seam_cut_count = buffer(self.cap_slots)
            }
            self.cap_pool_trans = cap
            reset = true
        }
        if want_exact > self.cap_pool_exact {
            var cap = max(self.cap_pool_exact, 65536)
            while cap < want_exact && cap < CAP_EXACT_MAX * 2 {
                cap = min(cap * 2, CAP_EXACT_MAX * 2)
            }
            self.pool_exact_u32 = buffer(cap * 8)
            self.cap_pool_exact = cap
            reset = true
        }
        if reset {
            self.cursors = buffer_of([0, 0, 0, 0])
        }
        reset
    }

    pub fn ensure_active_cap(mut self, count: u32) {
        if count > self.active_slots_cap {
            var cap = max(self.active_slots_cap, 256)
            while cap < count {
                cap *= 2
            }
            self.active_slots = buffer(cap)
            self.active_dst_idx = buffer(cap)
            self.active_dst_trans = buffer(cap)
            self.active_dst_cut = buffer(cap)
            self.active_slots_cap = cap
        }
    }
}

/// Records interior index offsets/counts for each dirty brick `chunk_start + id.x` into its
/// persistent pool slot `dirty_slots[chunk_start + id.x]`, zeroing seam and exact counts prior to
/// seam/exact scatter.
@compute(64)
pub(package) fn record_pool_interior(
    dirty_slots: [u32],
    chunk_start: u32,
    chunk_n: u32,
    brick_idx_offsets: [u32],
    brick_idx_counts: [u32],
    cap_pool_idx: u32,
    pool_idx_offset: mut Atomics<u32>,
    pool_idx_count: mut Atomics<u32>,
    pool_seam_offset: mut Atomics<u32>,
    pool_seam_count: mut Atomics<u32>,
    pool_exact_offset: mut Atomics<u32>,
    pool_exact_count: mut Atomics<u32>,
    id: GlobalId,
) {
    let j = id.x
    if j >= chunk_n {
        return
    }
    let slot = dirty_slots[chunk_start + j]
    let off = brick_idx_offsets[j]
    let cnt = brick_idx_counts[j]
    let clamped = if off >= cap_pool_idx { 0 } else { min(cnt, cap_pool_idx - off) }
    pool_idx_offset.store(i: slot, value: off)
    pool_idx_count.store(i: slot, value: clamped)
    pool_seam_offset.store(i: slot, value: 0)
    pool_seam_count.store(i: slot, value: 0)
    pool_exact_offset.store(i: slot, value: 0)
    pool_exact_count.store(i: slot, value: 0)
}

/// Records interior trans/cut index offsets/counts for each dirty brick `chunk_start + id.x`.
@compute(64)
pub(package) fn record_pool_trans_interior(
    dirty_slots: [u32],
    chunk_start: u32,
    chunk_n: u32,
    brick_trans_offsets: [u32],
    brick_trans_counts: [u32],
    brick_cut_offsets: [u32],
    brick_cut_counts: [u32],
    cap_pool_trans: u32,
    pool_trans_offset: mut Atomics<u32>,
    pool_trans_count: mut Atomics<u32>,
    pool_seam_trans_offset: mut Atomics<u32>,
    pool_seam_trans_count: mut Atomics<u32>,
    pool_cut_offset: mut Atomics<u32>,
    pool_cut_count: mut Atomics<u32>,
    pool_seam_cut_offset: mut Atomics<u32>,
    pool_seam_cut_count: mut Atomics<u32>,
    id: GlobalId,
) {
    let j = id.x
    if j >= chunk_n {
        return
    }
    let slot = dirty_slots[chunk_start + j]
    let toff = brick_trans_offsets[j]
    let tcnt = brick_trans_counts[j]
    let tclamped = if toff >= cap_pool_trans { 0 } else { min(tcnt, cap_pool_trans - toff) }
    let coff = brick_cut_offsets[j]
    let ccnt = brick_cut_counts[j]
    let cclamped = if coff >= cap_pool_trans { 0 } else { min(ccnt, cap_pool_trans - coff) }
    pool_trans_offset.store(i: slot, value: toff)
    pool_trans_count.store(i: slot, value: tclamped)
    pool_seam_trans_offset.store(i: slot, value: 0)
    pool_seam_trans_count.store(i: slot, value: 0)
    pool_cut_offset.store(i: slot, value: coff)
    pool_cut_count.store(i: slot, value: cclamped)
    pool_seam_cut_offset.store(i: slot, value: 0)
    pool_seam_cut_count.store(i: slot, value: 0)
}

/// Computes `(opaque, trans, cut)` index counts emitted by one `SeamQuad` `(v0, v1, v2, v3)`.
fn seam_quad_index_counts(
    v0: u32,
    v1: u32,
    v2: u32,
    v3: u32,
    flip: bool,
    verts: [MeshVertex],
) -> vec3u {
    if v0 == NONE || v1 == NONE || v2 == NONE || v3 == NONE {
        return vec3u(0, 0, 0)
    }
    if v0 != v1 && v1 != v2 && v2 != v3 && v3 != v0 && v0 != v2 && v1 != v3 {
        let t0 = unpack_is_trans(verts[v0].packed)
        let t1 = unpack_is_trans(verts[v1].packed)
        let t2 = unpack_is_trans(verts[v2].packed)
        let t3 = unpack_is_trans(verts[v3].packed)
        if !(t0 || t1 || t2 || t3) {
            return vec3u(6, 0, 0)
        }
        return vec3u(0, 6, if !(t0 && t1 && t2 && t3) { 6 } else { 0 })
    }
    let (q0, q1, q2, q3) = quad_order(v0, v1, v2, v3, flip: flip)
    var out = vec3u(0, 0, 0)
    if q0 != q1 && q1 != q2 && q2 != q0 {
        let ta = unpack_is_trans(verts[q0].packed)
        let tb = unpack_is_trans(verts[q1].packed)
        let tc = unpack_is_trans(verts[q2].packed)
        if !(ta || tb || tc) {
            out.x += 3
        } else {
            out.y += 3
            if !(ta && tb && tc) {
                out.z += 3
            }
        }
    }
    if q0 != q2 && q2 != q3 && q3 != q0 {
        let ta = unpack_is_trans(verts[q0].packed)
        let tb = unpack_is_trans(verts[q2].packed)
        let tc = unpack_is_trans(verts[q3].packed)
        if !(ta || tb || tc) {
            out.x += 3
        } else {
            out.y += 3
            if !(ta && tb && tc) {
                out.z += 3
            }
        }
    }
    out
}

/// Counts seam indices per dirty brick in the current chunk (`[chunk_start .. chunk_start + chunk_n)`).
@compute(64)
pub(package) fn count_seam_tris_per_brick(
    seam_quads: [SeamQuad],
    seam_quad_count: [u32],
    seam_verts: [u32],
    verts: [MeshVertex],
    chunk_start: u32,
    chunk_n: u32,
    track_trans: u32,
    brick_seam_counts: mut Atomics<u32>,
    brick_seam_trans_counts: mut Atomics<u32>,
    brick_seam_cut_counts: mut Atomics<u32>,
    id: GlobalId,
) {
    let n = min(seam_quad_count[0], CAP_SEAM)
    if id.x >= n {
        return
    }
    let sq = seam_quads[id.x]
    if sq.brick_slot < chunk_start || sq.brick_slot >= chunk_start + chunk_n {
        return
    }
    let local_b = sq.brick_slot - chunk_start
    let base = id.x * 4
    let cnt = seam_quad_index_counts(
        seam_verts[base],
        seam_verts[base + 1],
        seam_verts[base + 2],
        seam_verts[base + 3],
        flip: (sq.flags & 1) != 0,
        verts: verts,
    )
    if cnt.x > 0 {
        let _ = brick_seam_counts.add(i: local_b, value: cnt.x)
    }
    if track_trans != 0 {
        if cnt.y > 0 {
            let _ = brick_seam_trans_counts.add(i: local_b, value: cnt.y)
        }
        if cnt.z > 0 {
            let _ = brick_seam_cut_counts.add(i: local_b, value: cnt.z)
        }
    }
}

/// Records scanned seam offsets/counts into each dirty brick's persistent pool slot.
@compute(64)
pub(package) fn record_pool_seam_meta(
    dirty_slots: [u32],
    chunk_start: u32,
    chunk_n: u32,
    seam_offsets: [u32],
    seam_counts: [u32],
    cap_pool_idx: u32,
    pool_seam_offset: mut Atomics<u32>,
    pool_seam_count: mut Atomics<u32>,
    id: GlobalId,
) {
    let j = id.x
    if j >= chunk_n {
        return
    }
    let slot = dirty_slots[chunk_start + j]
    let off = seam_offsets[j]
    let cnt = seam_counts[j]
    let clamped = if off >= cap_pool_idx { 0 } else { min(cnt, cap_pool_idx - off) }
    pool_seam_offset.store(i: slot, value: off)
    pool_seam_count.store(i: slot, value: clamped)
}

/// Writes one triangle into `buf[at..at+3]` if within `cap`.
fn store_pool_tri(buf: mut Atomics<u32>, at: u32, cap: u32, a: u32, b: u32, c: u32) {
    if at + 3 <= cap {
        buf.store(i: at, value: a)
        buf.store(i: at + 1, value: b)
        buf.store(i: at + 2, value: c)
    }
}

/// Writes seam indices directly into each dirty brick's contiguous slice in `pool_indices` (and
/// optional `pool_trans_indices` / `pool_cut_indices` when `track_trans != 0`).
@compute(64)
pub(package) fn finish_seam_tris_pool(
    seam_quads: [SeamQuad],
    seam_quad_count: [u32],
    seam_verts: [u32],
    verts: [MeshVertex],
    chunk_start: u32,
    chunk_n: u32,
    seam_offsets: [u32],
    seam_cursor: mut Atomics<u32>,
    track_trans: u32,
    seam_trans_offsets: [u32],
    seam_trans_cursor: mut Atomics<u32>,
    seam_cut_offsets: [u32],
    seam_cut_cursor: mut Atomics<u32>,
    cap_pool_idx: u32,
    cap_pool_trans: u32,
    pool_indices: mut Atomics<u32>,
    pool_trans_indices: mut Atomics<u32>,
    pool_cut_indices: mut Atomics<u32>,
    id: GlobalId,
) {
    let n = min(seam_quad_count[0], CAP_SEAM)
    if id.x >= n {
        return
    }
    let sq = seam_quads[id.x]
    if sq.brick_slot < chunk_start || sq.brick_slot >= chunk_start + chunk_n {
        return
    }
    let b = sq.brick_slot - chunk_start
    let base = id.x * 4
    let v0 = seam_verts[base]
    let v1 = seam_verts[base + 1]
    let v2 = seam_verts[base + 2]
    let v3 = seam_verts[base + 3]
    if v0 == NONE || v1 == NONE || v2 == NONE || v3 == NONE {
        return
    }
    let flip = (sq.flags & 1) != 0
    if v0 != v1 && v1 != v2 && v2 != v3 && v3 != v0 && v0 != v2 && v1 != v3 {
        let t0 = unpack_is_trans(verts[v0].packed)
        let t1 = unpack_is_trans(verts[v1].packed)
        let t2 = unpack_is_trans(verts[v2].packed)
        let t3 = unpack_is_trans(verts[v3].packed)
        let is_trans = t0 || t1 || t2 || t3
        let (q0, q1, q2, q3) = quad_order(v0, v1, v2, v3, flip: flip)
        let p = |v: u32| vec3(verts[v].px, verts[v].py, verts[v].pz)
        let nm = |v: u32| unpack_oct_normal(verts[v].packed)
        let s13 = split_seam_13(p(q0), p(q1), p(q2), p(q3), nm(q0), nm(q1), nm(q2), nm(q3))
        let (a, bb, c, d) = if s13 { (q1, q2, q3, q0) } else { (q0, q1, q2, q3) }
        if !is_trans {
            let at = seam_offsets[b] + seam_cursor.add(i: b, value: 6)
            store_pool_tri(mut pool_indices, at, cap_pool_idx, a, bb, c)
            store_pool_tri(mut pool_indices, at + 3, cap_pool_idx, a, c, d)
        } else if track_trans != 0 {
            let at = seam_trans_offsets[b] + seam_trans_cursor.add(i: b, value: 6)
            store_pool_tri(mut pool_trans_indices, at, cap_pool_trans, a, bb, c)
            store_pool_tri(mut pool_trans_indices, at + 3, cap_pool_trans, a, c, d)
            if !(t0 && t1 && t2 && t3) {
                let ac = seam_cut_offsets[b] + seam_cut_cursor.add(i: b, value: 6)
                store_pool_tri(mut pool_cut_indices, ac, cap_pool_trans, a, bb, c)
                store_pool_tri(mut pool_cut_indices, ac + 3, cap_pool_trans, a, c, d)
            }
        }
        return
    }
    let (q0, q1, q2, q3) = quad_order(v0, v1, v2, v3, flip: flip)
    for t in 0..2 {
        let a = q0
        let bb = if t == 0 { q1 } else { q2 }
        let c = if t == 0 { q2 } else { q3 }
        if a == bb || bb == c || c == a {
            continue
        }
        let ta = unpack_is_trans(verts[a].packed)
        let tb = unpack_is_trans(verts[bb].packed)
        let tc = unpack_is_trans(verts[c].packed)
        if !(ta || tb || tc) {
            let at = seam_offsets[b] + seam_cursor.add(i: b, value: 3)
            store_pool_tri(mut pool_indices, at, cap_pool_idx, a, bb, c)
        } else if track_trans != 0 {
            let at = seam_trans_offsets[b] + seam_trans_cursor.add(i: b, value: 3)
            store_pool_tri(mut pool_trans_indices, at, cap_pool_trans, a, bb, c)
            if !(ta && tb && tc) {
                let ac = seam_cut_offsets[b] + seam_cut_cursor.add(i: b, value: 3)
                store_pool_tri(mut pool_cut_indices, ac, cap_pool_trans, a, bb, c)
            }
        }
    }
}

/// Counts batch exact cells per dirty brick in `[chunk_start .. chunk_start + chunk_n)`.
@compute(64)
pub(package) fn count_exact_per_brick(
    batch_exact_count: [u32],
    batch_exact_owner: [u32],
    chunk_start: u32,
    chunk_n: u32,
    brick_exact_counts: mut Atomics<u32>,
    id: GlobalId,
) {
    let n = min(batch_exact_count[0], CAP_BATCH_EXACT)
    if id.x >= n {
        return
    }
    let b = batch_exact_owner[id.x]
    if b >= chunk_start && b < chunk_start + chunk_n {
        let _ = brick_exact_counts.add(i: b - chunk_start, value: 1)
    }
}

/// Records scanned exact-cell offsets/counts into each dirty brick's persistent pool slot.
@compute(64)
pub(package) fn record_pool_exact_meta(
    dirty_slots: [u32],
    chunk_start: u32,
    chunk_n: u32,
    exact_offsets: [u32],
    exact_counts: [u32],
    cap_pool_exact: u32,
    pool_exact_offset: mut Atomics<u32>,
    pool_exact_count: mut Atomics<u32>,
    id: GlobalId,
) {
    let j = id.x
    if j >= chunk_n {
        return
    }
    let slot = dirty_slots[chunk_start + j]
    let off = exact_offsets[j]
    let cnt = exact_counts[j]
    let clamped = if off >= cap_pool_exact { 0 } else { min(cnt, cap_pool_exact - off) }
    pool_exact_offset.store(i: slot, value: off)
    pool_exact_count.store(i: slot, value: clamped)
}

/// Scatters `batch_exact` into each dirty brick's contiguous 8-u32-per-cell slice of `pool_exact_u32`.
@compute(64)
pub(package) fn scatter_exact_to_pool(
    batch_exact: [ExactCell],
    batch_exact_count: [u32],
    batch_exact_owner: [u32],
    chunk_start: u32,
    chunk_n: u32,
    exact_offsets: [u32],
    exact_cursor: mut Atomics<u32>,
    cap_pool_exact: u32,
    pool_exact_u32: mut Atomics<u32>,
    id: GlobalId,
) {
    let n = min(batch_exact_count[0], CAP_BATCH_EXACT)
    if id.x >= n {
        return
    }
    let b = batch_exact_owner[id.x]
    if b < chunk_start || b >= chunk_start + chunk_n {
        return
    }
    let local_b = b - chunk_start
    let at = exact_offsets[local_b] + exact_cursor.add(i: local_b, value: 1)
    if at < cap_pool_exact {
        let c = batch_exact[id.x]
        let base = at * 8
        pool_exact_u32.store(i: base, value: bitcast_u32(c.lo.x))
        pool_exact_u32.store(i: base + 1, value: bitcast_u32(c.lo.y))
        pool_exact_u32.store(i: base + 2, value: bitcast_u32(c.lo.z))
        pool_exact_u32.store(i: base + 3, value: bitcast_u32(c.h))
        pool_exact_u32.store(i: base + 4, value: c.live.words.x)
        pool_exact_u32.store(i: base + 5, value: c.live.words.y)
        pool_exact_u32.store(i: base + 6, value: c.live.words.z)
        pool_exact_u32.store(i: base + 7, value: c.live.words.w)
    }
}

/// 2-level scan pass 1: sums `count_a[slot] + count_b[slot]` over 64-slot groups (`<= 16,384` slots).
@compute(64)
fn compact_scan_groups(
    active_slots: [u32],
    active_n: u32,
    count_a: [u32],
    count_b: [u32],
    use_b: u32,
    group_sums: mut Slots<u32>,
    id: GlobalId,
) {
    let g = id.x
    if g >= POOL_SCAN_GROUPS {
        return
    }
    var sum: u32 = 0
    let base = g * POOL_SCAN_GROUP_SIZE
    for k in 0..POOL_SCAN_GROUP_SIZE {
        let i = base + k
        if i < active_n {
            let slot = active_slots[i]
            sum += count_a[slot] + (if use_b != 0 { count_b[slot] } else { 0 })
        }
    }
    group_sums[id] = sum
}

/// 2-level scan pass 2: exclusive prefix sum over `POOL_SCAN_GROUPS` group sums + writes total.
@compute(1)
fn compact_scan_totals(
    group_sums: [u32],
    total_idx: u32,
    group_offsets: mut Atomics<u32>,
    compact_totals: mut Atomics<u32>,
    id: GlobalId,
) {
    let _ = id
    var acc: u32 = 0
    for g in 0..POOL_SCAN_GROUPS {
        group_offsets.store(i: g, value: acc)
        acc += group_sums[g]
    }
    compact_totals.store(i: total_idx, value: acc)
}

/// 2-level scan pass 3: writes per-active-slot destination offset into `dst_offsets`.
@compute(64)
fn compact_scan_local(
    active_slots: [u32],
    active_n: u32,
    count_a: [u32],
    count_b: [u32],
    use_b: u32,
    group_offsets: [u32],
    dst_offsets: mut Atomics<u32>,
    id: GlobalId,
) {
    let g = id.x
    if g >= POOL_SCAN_GROUPS {
        return
    }
    var off = group_offsets[g]
    let base = g * POOL_SCAN_GROUP_SIZE
    for k in 0..POOL_SCAN_GROUP_SIZE {
        let i = base + k
        if i < active_n {
            dst_offsets.store(i: i, value: off)
            let slot = active_slots[i]
            off += count_a[slot] + (if use_b != 0 { count_b[slot] } else { 0 })
        }
    }
}

/// Runs the 2-level prefix scan for `active_n` active leaf slots into `dst_offsets` and
/// `compact_totals[total_idx]`.
pub(package) fn scan_active_pool(
    active_slots: GpuSpan<u32>,
    active_n: u32,
    count_a: GpuSpan<u32>,
    count_b: GpuSpan<u32>,
    use_b: bool,
    total_idx: u32,
    group_sums: mut GpuBuffer<u32>,
    group_offsets: mut GpuBuffer<u32>,
    dst_offsets: mut GpuBuffer<u32>,
    compact_totals: mut GpuBuffer<u32>,
) {
    let ub: u32 = if use_b { 1 } else { 0 }
    dispatch(
        compact_scan_groups.bind(
            active_slots: active_slots,
            active_n: active_n,
            count_a: count_a,
            count_b: count_b,
            use_b: ub,
            group_sums: group_sums.span_mut(start: 0, count: POOL_SCAN_GROUPS),
        ),
        over: POOL_SCAN_GROUPS,
    )
    dispatch(
        compact_scan_totals.bind(
            group_sums: group_sums.items(),
            total_idx: total_idx,
            group_offsets: mut group_offsets,
            compact_totals: mut compact_totals,
        ),
        over: 1,
    )
    dispatch(
        compact_scan_local.bind(
            active_slots: active_slots,
            active_n: active_n,
            count_a: count_a,
            count_b: count_b,
            use_b: ub,
            group_offsets: group_offsets.items(),
            dst_offsets: mut dst_offsets,
        ),
        over: POOL_SCAN_GROUPS,
    )
}

/// Copies all active leaf bricks' cached interior + seam index slices from `pool_indices` into
/// dense `out_indices` (64 coalesced lanes per active brick, `~15 µs`).
@compute(64)
pub(package) fn compact_pool_indices(
    active_slots: [u32],
    active_n: u32,
    dst_offsets: [u32],
    pool_idx_offset: [u32],
    pool_idx_count: [u32],
    pool_seam_offset: [u32],
    pool_seam_count: [u32],
    pool_indices: [u32],
    cap_out: u32,
    out_indices: mut Atomics<u32>,
    id: GlobalId,
) {
    let ai = id.x >> 6
    let lane = id.x & 63
    if ai >= active_n {
        return
    }
    let slot = active_slots[ai]
    let dst = dst_offsets[ai]
    let off0 = pool_idx_offset[slot]
    let cnt0 = pool_idx_count[slot]
    // At most `MOST_INDICES_PER_BRICK = 3888` indices per brick (`61 * 64 = 3904`).
    for step in 0..64 {
        let k = step * 64 + lane
        if k >= cnt0 {
            break
        }
        let d = dst + k
        if d < cap_out {
            out_indices.store(i: d, value: pool_indices[off0 + k])
        }
    }
    let off1 = pool_seam_offset[slot]
    let cnt1 = pool_seam_count[slot]
    let dst1 = dst + cnt0
    for step in 0..64 {
        let k = step * 64 + lane
        if k >= cnt1 {
            break
        }
        let d = dst1 + k
        if d < cap_out {
            out_indices.store(i: d, value: pool_indices[off1 + k])
        }
    }
}

/// Pushes all active leaf bricks' cached `ExactCell` slices from `pool_exact_u32` into dense
/// `out_exact` (`AppendBuffer<ExactCell>`, 16 lanes per active brick, `~5 µs`).
@compute(64)
pub(package) fn compact_pool_exact(
    active_slots: [u32],
    active_n: u32,
    pool_exact_offset: [u32],
    pool_exact_count: [u32],
    pool_exact_u32: [u32],
    out_exact: mut Append<ExactCell>,
    id: GlobalId,
) {
    let ai = id.x >> 4
    let lane = id.x & 15
    if ai >= active_n {
        return
    }
    let slot = active_slots[ai]
    let off = pool_exact_offset[slot]
    let cnt = pool_exact_count[slot]
    // At most `VERTS_BRICK + seam cells <= 512` exact cells per brick (`32 * 16 = 512`).
    for step in 0..32 {
        let k = step * 16 + lane
        if k >= cnt {
            break
        }
        let base = (off + k) * 8
        let lo = vec3(
            bitcast_f32(pool_exact_u32[base]),
            bitcast_f32(pool_exact_u32[base + 1]),
            bitcast_f32(pool_exact_u32[base + 2]),
        )
        let h = bitcast_f32(pool_exact_u32[base + 3])
        let live = Live {
            words: vec4u(
                pool_exact_u32[base + 4],
                pool_exact_u32[base + 5],
                pool_exact_u32[base + 6],
                pool_exact_u32[base + 7],
            ),
        }
        let _ = out_exact.push(ExactCell { lo, h, live })
    }
}

/// Finalizes indirect draw args (`draw_args`, `trans_draw_args`, `cut_draw_args`, `exact_draw_args`)
/// and `tri_count` readback stats after compacting active octree pool slots.
@compute(1)
pub(package) fn finish_pool_draw(
    compact_totals: [u32],
    pool_cursors: [u32],
    vert_count: [u32],
    exact_count: [u32],
    seam_quad_count: [u32],
    seam_cell_count: [u32],
    active_n: u32,
    has_seams: u32,
    cap_indices: u32,
    cap_trans: u32,
    cap_exact: u32,
    cap_pool_idx: u32,
    cap_pool_trans: u32,
    cap_pool_exact: u32,
    tri_count: mut Atomics<u32>,
    args: mut One<DrawIndexedArgs>,
    trans_args: mut One<DrawIndexedArgs>,
    cut_args: mut One<DrawIndexedArgs>,
    seam_args: mut One<DrawIndexedArgs>,
    exact_args: mut One<DrawIndexedArgs>,
    id: GlobalId,
) {
    let raw_idx = compact_totals[0]
    let n = min(raw_idx, cap_indices)
    args.set(id, DrawIndexedArgs {
        indices: n,
        instances: if n > 0 { 1 } else { 0 },
        first_index: 0,
        base_vertex: 0,
        first_instance: 0,
    })
    seam_args.set(
        id,
        DrawIndexedArgs {
            indices: 0,
            instances: 0,
            first_index: 0,
            base_vertex: 0,
            first_instance: 0,
        },
    )
    let raw_trans = compact_totals[1]
    let nt = min(raw_trans, cap_trans)
    trans_args.set(id, DrawIndexedArgs {
        indices: nt,
        instances: if nt > 0 { 1 } else { 0 },
        first_index: 0,
        base_vertex: 0,
        first_instance: 0,
    })
    let raw_cut = compact_totals[2]
    let nc = min(raw_cut, cap_trans)
    cut_args.set(id, DrawIndexedArgs {
        indices: nc,
        instances: if nc > 0 { 1 } else { 0 },
        first_index: 0,
        base_vertex: 0,
        first_instance: 0,
    })
    let raw_ex = exact_count[0]
    let nex = min(raw_ex, cap_exact)
    exact_args.set(id, DrawIndexedArgs {
        indices: if nex > 0 { 36 } else { 0 },
        instances: nex,
        first_index: 0,
        base_vertex: 0,
        first_instance: 0,
    })
    var ovf: u32 = 0
    if has_seams != 0 && (seam_quad_count[0] > CAP_SEAM || seam_cell_count[0] > CAP_SEAM * 2) {
        ovf |= OVERFLOW_SEAMS
    }
    if raw_idx > cap_indices || pool_cursors[0] > cap_pool_idx {
        ovf |= OVERFLOW_INDICES
    }
    if raw_trans > cap_trans || (cap_pool_trans > 0 && pool_cursors[1] > cap_pool_trans) {
        ovf |= OVERFLOW_TRANS
    }
    if raw_cut > cap_trans || (cap_pool_trans > 0 && pool_cursors[2] > cap_pool_trans) {
        ovf |= OVERFLOW_CUT
    }
    if cap_exact > 0 && (raw_ex > cap_exact || pool_cursors[3] > cap_pool_exact) {
        ovf |= OVERFLOW_EXACT
    }
    if tri_count.load(i: 5) > 0 {
        ovf |= OVERFLOW_CREASES
    }
    if tri_count.load(i: 9) > 0 {
        ovf |= OVERFLOW_THIN
    }
    tri_count.store(i: 0, value: raw_idx)
    tri_count.store(i: 1, value: raw_trans)
    tri_count.store(i: 2, value: active_n)
    tri_count.store(i: 3, value: vert_count[0])
    tri_count.store(i: 6, value: raw_cut)
    tri_count.store(i: 7, value: ovf)
    tri_count.store(i: 8, value: raw_ex)
}
