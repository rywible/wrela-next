// GPU Dual Contouring compute kernels: brick culling, corner evaluation, seam corner
// inheritance, QEF/Hermite cell solving, crease refinement, thin-cell filtering, and DQS
// skinned vertex projection.

use matter::substance::Substance
use mesh::grid::{
    ActiveBrick, BRICK, CAP_SURF, CHUNK_BRICKS, CORNERS_BRICK, CREASE_DOT, CREASE_SLICE,
    CREASE_SLICE_LEAST, ExactCell, FrustumCull, GridSpec, KEPT_TRANS, MeshVertex, NONE,
    OVERFLOW_THIN, REG_CREASE, REG_SMOOTH, SMOOTH_DOT, THIN_SLICE, VERTS_BRICK, VERTS_STRIDE, along,
    avg2_sign, avg4_sign, box_in_frustum, brick_corner, brick_in_hole, brick_of, cull_brick,
    eval_dqs, is_heavy_field, owner_of, pack_kept, pack_vertex_meta, safe_norm, unpack_is_trans,
    unpack_oct_normal, unpack_smooth, unpack_thing, with_along,
}
use std::derive::{Box3, affine_form, value_and_gradient}
use std::field::{ALL_LIVE, DualQuat, Field, Live}
use std::gpu::{Append, Atomics, DispatchArgs, GlobalId, LANE_WORK_LEAST, One, Slots, limits}

@strict
@compute(64)
pub(package) fn cull_bricks<M: Field<Substance>>(
    fields: [M],
    grids: [GridSpec],
    things: u32,
    first_brick: u32,
    total_bricks: u32,
    fc: FrustumCull,
    active: mut Append<ActiveBrick>,
    id: GlobalId,
) {
    let gb = first_brick + id.x
    if gb >= total_bricks {
        return
    }
    let ti = owner_of(grids, things, gb)
    let g = grids[ti]
    let b = brick_of(g, gb - g.base_brick)
    if g.parent_grid != NONE {
        let p = grids[g.parent_grid]
        let pb = vec3u(
            p.hole_min.x / BRICK + b.x / 2,
            p.hole_min.y / BRICK + b.y / 2,
            p.hole_min.z / BRICK + b.z / 2,
        )
        let plo = brick_corner(p, pb, vec3u(0, 0, 0))
        let phi = plo + vec3(p.cell * f32(BRICK))
        if !box_in_frustum(plo, phi, fc) {
            return
        }
    }
    if brick_in_hole(g, b) {
        let lo = brick_corner(g, b, vec3u(0, 0, 0))
        let hi = lo + vec3(g.cell * f32(BRICK))
        if box_in_frustum(lo, hi, fc) {
            return
        }
    }
    let (hit, live) = cull_brick(fields[g.orig_id], g, b)
    if hit {
        let _ = active.push(ActiveBrick { coord: vec4u(b.x, b.y, b.z, ti), live })
    }
}

/// Writes indirect dispatch counts for chunk `chunk_idx` (covering `CHUNK_BRICKS` bricks) and
/// clamps to `cap_bricks`.
@strict
@compute(1)
pub(package) fn prep_chunk(
    active_count: [u32],
    cap_bricks: u32,
    chunk_start: u32,
    eval_args: mut One<DispatchArgs>,
    vert_args: mut One<DispatchArgs>,
    quad_args: mut One<DispatchArgs>,
    id: GlobalId,
) {
    let total = min(active_count[0], cap_bricks)
    let n = if total > chunk_start { min(total - chunk_start, CHUNK_BRICKS) } else { 0 }
    eval_args.set(id, DispatchArgs { x: n * 8, y: 1, z: 1 })
    vert_args.set(id, DispatchArgs { x: n * 6, y: 1, z: 1 })
    quad_args.set(id, DispatchArgs { x: n * 4, y: 1, z: 1 })
}

/// Pass 1: Evaluates `field.distance_live` at all 512 (`8×8×8`) corners of each active brick in a
/// chunk, skipping every part pruned out of the brick by `cull_bricks`.
@strict
@compute(64)
pub(package) fn eval_corners<M: Field<Substance>>(
    fields: [M],
    grids: [GridSpec],
    active: [ActiveBrick],
    active_count: [u32],
    cap_bricks: u32,
    chunk_start: u32,
    corners: mut Slots<f32>,
    id: GlobalId,
) {
    let brick_in_chunk = id.x / CORNERS_BRICK
    let bi = chunk_start + brick_in_chunk
    let total = min(active_count[0], cap_bricks)
    if bi >= total {
        return
    }
    let ci = id.x - brick_in_chunk * CORNERS_BRICK
    let ab = active[bi]
    let b = ab.coord
    let g = grids[b.w]
    let cx = ci & 7
    let cy = (ci >> 3) & 7
    let cz = ci >> 6
    let p = brick_corner(g, b.xyz, vec3u(cx, cy, cz))
    corners[id] = fields[g.orig_id].distance_live(p, ab.live)
}

/// Reads a local even corner `(x, y, z)` (`0..=8`) for `inherit_seam_corners`: hits `corners_in`
/// for all in-brick corners `0..=6` and falls back to `f.distance_live` only on the rare `== 8`
/// halo neighbor of a `c == 7` seam corner (`ab.live` covers `[0..8]³` whenever `seam_mask != 0`).
fn seam_even_corner<M: Field<Substance>>(
    f: M,
    g: GridSpec,
    b: vec3u,
    live: Live,
    corners_in: [f32],
    cbase: u32,
    x: u32,
    y: u32,
    z: u32,
) -> f32 {
    if x < 8 && y < 8 && z < 8 {
        return cdist(corners_in, cbase, x, y, z)
    }
    f.distance_live(brick_corner(g, b, vec3u(x, y, z)), live)
}

/// Pass 1b (Multi-LOD only): Overwrites odd-coordinate corners lying on any 2:1 seam face `∂Ω`
/// with the sign-preserving linear/bilinear average of the enclosing even coarse corners,
/// guaranteeing exact sign-topology agreement between fine and coarse levels.
@strict
@compute(64)
pub(package) fn inherit_seam_corners<M: Field<Substance>>(
    fields: [M],
    grids: [GridSpec],
    active: [ActiveBrick],
    active_count: [u32],
    cap_bricks: u32,
    chunk_start: u32,
    brick_off: u32,
    corners_in: [f32],
    corners_out: mut Slots<f32>,
    id: GlobalId,
) {
    let local_id = brick_off * CORNERS_BRICK + id.x
    let brick_in_chunk = brick_off + id.x / CORNERS_BRICK
    let bi = chunk_start + brick_in_chunk
    let total = min(active_count[0], cap_bricks)
    if bi >= total {
        return
    }
    let ci = local_id - brick_in_chunk * CORNERS_BRICK
    let ab = active[bi]
    let b = ab.coord
    let g = grids[b.w]
    let raw = corners_in[local_id]
    if g.seam_mask == 0 {
        corners_out[id] = raw
        return
    }
    let cx = ci & 7
    let cy = (ci >> 3) & 7
    let cz = ci >> 6
    let nx = g.dims.x * BRICK
    let ny = g.dims.y * BRICK
    let nz = g.dims.z * BRICK
    let gx = b.x * BRICK + cx
    let gy = b.y * BRICK + cy
    let gz = b.z * BRICK + cz
    let in_box = gx <= nx && gy <= ny && gz <= nz
    let on_x = (gx == 0 && (g.seam_mask & 1) != 0) || (gx == nx && (g.seam_mask & 2) != 0)
    let on_y = (gy == 0 && (g.seam_mask & 4) != 0) || (gy == ny && (g.seam_mask & 8) != 0)
    let on_z = (gz == 0 && (g.seam_mask & 16) != 0) || (gz == nz && (g.seam_mask & 32) != 0)
    if !in_box || !(on_x || on_y || on_z) {
        corners_out[id] = raw
        return
    }
    let ox = cx & 1
    let oy = cy & 1
    let oz = cz & 1
    let n_odd = ox + oy + oz
    let cbase = brick_in_chunk * CORNERS_BRICK
    let f = fields[g.orig_id]
    if n_odd == 1 || n_odd == 2 {
        var cnt: u32 = 2
        var cs: [vec3u; 4] = [vec3u(0, 0, 0); 4]
        if n_odd == 1 {
            cs[0] = vec3u(cx - ox, cy - oy, cz - oz)
            cs[1] = vec3u(cx + ox, cy + oy, cz + oz)
        } else {
            cnt = 4
            let sx = ox
            let sz = if ox == 1 && oy == 1 { 0 } else { 1 }
            let a0x = if sx == 1 { 1 } else { 0 }
            let a0y = if sx == 0 { 1 } else { 0 }
            let a1y = if sx == 1 && oy == 1 { 1 } else { 0 }
            let a1z = if sz == 1 { 1 } else { 0 }
            cs[0] = vec3u(cx - a0x, cy - a0y - a1y, cz - a1z)
            cs[1] = vec3u(cx + a0x, cy + a0y - a1y, cz - a1z)
            cs[2] = vec3u(cx - a0x, cy - a0y + a1y, cz + a1z)
            cs[3] = vec3u(cx + a0x, cy + a0y + a1y, cz + a1z)
        }
        var ds = [0.0; 4]
        for k in 0..4 {
            if k < cnt {
                let c = cs[k]
                ds[k] = seam_even_corner(f, g, b.xyz, ab.live, corners_in, cbase, c.x, c.y, c.z)
            }
        }
        if n_odd == 1 {
            // Only override with coarse average when the coarse edge has NO sign change; when it
            // DOES cross zero, preserving `raw` keeps exact topology (still exactly 1 fine crossing)
            // with zero linear-interpolation shift on sharp creases and thin shells.
            if (ds[0] < 0.0) == (ds[1] < 0.0) {
                corners_out[id] = avg2_sign(ds[0], ds[1])
            } else {
                corners_out[id] = raw
            }
        } else {
            let s00 = ds[0] < 0.0
            if s00 == (ds[1] < 0.0) && s00 == (ds[2] < 0.0) && s00 == (ds[3] < 0.0) {
                corners_out[id] = avg4_sign(ds[0], ds[1], ds[2], ds[3])
            } else {
                corners_out[id] = raw
            }
        }
    } else {
        corners_out[id] = raw
    }
}

/// Corner distance inside a brick at `(x, y, z)` in `0..8`.
pub(package) fn cdist(corners: [f32], base: u32, x: u32, y: u32, z: u32) -> f32 {
    corners[base + x + (y << 3) + (z << 6)]
}

/// Local cell `(x, y, z)` in `0..7` of packed cell index `cell` (`x + 7y + 49z`).
pub(package) fn decode_cell(cell: u32) -> (u32, u32, u32) {
    let cz = cell / 49
    let rem = cell - cz * 49
    let cy = rem / 7
    let cx = rem - cy * 7
    (cx, cy, cz)
}

/// The 8 corner distances of one cell (`dXYZ` at local corner `(X, Y, Z)`).
pub(package) struct CellCorners: Copy + GpuData {
    pub(package) d000: f32,
    pub(package) d100: f32,
    pub(package) d010: f32,
    pub(package) d110: f32,
    pub(package) d001: f32,
    pub(package) d101: f32,
    pub(package) d011: f32,
    pub(package) d111: f32,
}

/// Loads the 8 corner distances of local cell `(cx, cy, cz)` of the brick whose corners start
/// at `cbase`.
pub(package) fn load_corners(corners: [f32], cbase: u32, cx: u32, cy: u32, cz: u32) -> CellCorners {
    CellCorners {
        d000: cdist(corners, cbase, cx, cy, cz),
        d100: cdist(corners, cbase, cx + 1, cy, cz),
        d010: cdist(corners, cbase, cx, cy + 1, cz),
        d110: cdist(corners, cbase, cx + 1, cy + 1, cz),
        d001: cdist(corners, cbase, cx, cy, cz + 1),
        d101: cdist(corners, cbase, cx + 1, cy, cz + 1),
        d011: cdist(corners, cbase, cx, cy + 1, cz + 1),
        d111: cdist(corners, cbase, cx + 1, cy + 1, cz + 1),
    }
}

impl CellCorners {
    /// The `k`-th corner (`0..8`, bit 0 = x, bit 1 = y, bit 2 = z).
    pub(package) fn at(self, k: u32) -> f32 {
        if k == 0 {
            self.d000
        } else if k == 1 {
            self.d100
        } else if k == 2 {
            self.d010
        } else if k == 3 {
            self.d110
        } else if k == 4 {
            self.d001
        } else if k == 5 {
            self.d101
        } else if k == 6 {
            self.d011
        } else {
            self.d111
        }
    }

    /// Trilinear gradient of the corner distances at local `uvw` in `[0, 1]³`.
    pub(package) fn grad(self, uvw: vec3) -> vec3 {
        let u = uvw.x
        let v = uvw.y
        let w = uvw.z
        let (d000, d100, d010, d110) = (self.d000, self.d100, self.d010, self.d110)
        let (d001, d101, d011, d111) = (self.d001, self.d101, self.d011, self.d111)
        let gx = mix(mix(d100 - d000, d110 - d010, v), mix(d101 - d001, d111 - d011, v), w)
        let gy = mix(mix(d010 - d000, d110 - d100, u), mix(d011 - d001, d111 - d101, u), w)
        let gz = mix(mix(d001 - d000, d101 - d100, u), mix(d011 - d010, d111 - d110, u), v)
        vec3(gx, gy, gz)
    }
}

/// Corner coordinates of local cell corner `k` in `0..8`.
pub(package) fn corner_uvw(k: u32) -> vec3 {
    vec3(f32(k & 1), f32((k >> 1) & 1), f32((k >> 2) & 1))
}

/// A cell's Dual Contouring QEF: the symmetric 3×3 normal equations `A x = b` of its Hermite
/// samples in local cell coordinates relative to the cell centre `(0.5, 0.5, 0.5)`, their mass
/// point and summed normal, and how far their normals spread (`min_dot`, to find sharp creases).
pub(package) struct Qef: Copy + GpuData {
    pub(package) mass: vec3,
    pub(package) a00: f32,
    pub(package) avg_n: vec3,
    pub(package) a01: f32,
    pub(package) first_n: vec3,
    pub(package) a02: f32,
    pub(package) a11: f32,
    pub(package) a12: f32,
    pub(package) a22: f32,
    pub(package) bx: f32,
    pub(package) by: f32,
    pub(package) bz: f32,
    pub(package) count: u32,
    pub(package) min_dot: f32,
}

/// A QEF with no samples.
fn qef_empty() -> Qef {
    Qef {
        a00: 0.0,
        a01: 0.0,
        a02: 0.0,
        a11: 0.0,
        a12: 0.0,
        a22: 0.0,
        bx: 0.0,
        by: 0.0,
        bz: 0.0,
        mass: vec3(0.0),
        avg_n: vec3(0.0),
        count: 0,
        first_n: vec3(0.0),
        min_dot: 1.0,
    }
}

impl Qef {
    /// Adds the Hermite sample at local `uvw` with unit normal `n`.
    pub(package) fn add(mut self, uvw: vec3, n: vec3) {
        let q = uvw - vec3(0.5)
        let dp = dot(n, q)
        self.a00 += n.x * n.x
        self.a01 += n.x * n.y
        self.a02 += n.x * n.z
        self.a11 += n.y * n.y
        self.a12 += n.y * n.z
        self.a22 += n.z * n.z
        self.bx += n.x * dp
        self.by += n.y * dp
        self.bz += n.z * dp
        self.mass += uvw
        self.avg_n += n
        if self.count == 0 {
            self.first_n = n
        } else {
            self.min_dot = min(self.min_dot, dot(self.first_n, n))
        }
        self.count += 1
    }

    /// The unclamped local `uvw` minimising the QEF, with Tikhonov regularisation of weight
    /// `reg_per` per sample toward the mass point.
    pub(package) fn solve_unclamped(self, reg_per: f32) -> vec3 {
        let half = vec3(0.5)
        let inv_c = 1.0 / max(f32(self.count), 1.0)
        let mp = self.mass * inv_c
        let mp_rel = mp - half
        let reg = reg_per * f32(self.count)
        let a00 = self.a00 + reg
        let a01 = self.a01
        let a02 = self.a02
        let a11 = self.a11 + reg
        let a12 = self.a12
        let a22 = self.a22 + reg
        let rhs = vec3(self.bx + mp_rel.x * reg, self.by + mp_rel.y * reg, self.bz + mp_rel.z * reg)

        // Closed-form symmetric 3×3 solve via cofactors (always SPD since reg > 0).
        let c00 = a11 * a22 - a12 * a12
        let c01 = a02 * a12 - a01 * a22
        let c02 = a01 * a12 - a02 * a11
        let c11 = a00 * a22 - a02 * a02
        let c12 = a01 * a02 - a00 * a12
        let c22 = a00 * a11 - a01 * a01
        let det = a00 * c00 + a01 * c01 + a02 * c02
        let sol = if det > 1.0e-12 {
            vec3(
                c00 * rhs.x + c01 * rhs.y + c02 * rhs.z,
                c01 * rhs.x + c11 * rhs.y + c12 * rhs.z,
                c02 * rhs.x + c12 * rhs.y + c22 * rhs.z,
            ) /
                det
        } else {
            mp_rel
        }
        sol + half
    }
}

/// One Newton step from `wp` (where the field is `dv` with gradient `gv`) onto the field's
/// zero-isosurface, kept only if it stays inside the cell `cell_lo + [0, h]³`.
fn newton_snap(wp: vec3, dv: f32, gv: vec3, cell_lo: vec3, h: f32) -> vec3 {
    var out = wp
    let g2 = dot(gv, gv)
    if g2 > 1.0e-8 {
        let step = clamp(dv / g2, -0.75 * h, 0.75 * h)
        let cand = wp - gv * step
        let rel = (cand - cell_lo) / h
        if rel.x >= 0.0 &&
            rel.x <= 1.0 &&
            rel.y >= 0.0 &&
            rel.y <= 1.0 &&
            rel.z >= 0.0 &&
            rel.z <= 1.0 {
            out = cand
        }
    }
    out
}

/// The cube's 12 edges as pairs of corner indices (`0..8`, bit 0 = x, bit 1 = y, bit 2 = z):
/// edges `4a..4a + 4` run along axis `a`, from a corner at `0` on it.
fn edge_ends(e: u32) -> (u32, u32) {
    let e0 = [0, 2, 4, 6, 0, 1, 4, 5, 0, 1, 2, 3]
    let e1 = [1, 3, 5, 7, 2, 3, 6, 7, 4, 5, 6, 7]
    (e0[e], e1[e])
}

/// A sign-changing cell's QEF from its 8 corners alone: each crossing edge's point by linear
/// interpolation, its normal from the cell's trilinear gradient (no field samples).
pub(package) fn trilinear_qef(d: CellCorners) -> Qef {
    var qef = qef_empty()
    for e in 0..12 {
        let (i0, i1) = edge_ends(e)
        let v0 = d.at(i0)
        let v1 = d.at(i1)
        if (v0 < 0.0) != (v1 < 0.0) {
            let t = clamp(v0 / (v0 - v1), 0.0, 1.0)
            let uvw = mix(corner_uvw(i0), corner_uvw(i1), t)
            qef.add(uvw, safe_norm(d.grad(uvw), vec3(0.0, 1.0, 0.0)))
        }
    }
    qef
}

/// Single shared `value_and_gradient` call site so all dual-contouring edge/cell solvers share one
/// monomorphized adjoint derivation instead of duplicating a separate closure gradient per call.
fn sample_dist<F: Copy + fn(vec3) -> f32>(dist: F, p: vec3) -> (f32, vec3) {
    value_and_gradient(|q: vec3| dist(q), p)
}

/// A sharp crease cell's QEF from exact Hermite data: each crossing edge's zero crossing is
/// bracketed by 4 bisection steps (immune to medial-axis kinks inside sharp 90° edges where linear
/// interpolation lands on the wrong face's Voronoi region) then refined by one exact Newton step,
/// using `dist`'s exact gradient at the true root as its normal. Edges whose endpoints only differ
/// in sign due to 2:1 seam inheritance (while `dist` itself does not cross zero along the edge)
/// are skipped when genuine crossings exist so sharp edges stay crisp across LOD seams.
pub(package) fn hermite_qef<F: Copy + fn(vec3) -> f32>(
    dist: F,
    d: CellCorners,
    cell_lo: vec3,
    h: f32,
) -> Qef {
    var qef = qef_empty()
    for e in 0..12 {
        let (i0, i1) = edge_ends(e)
        let v0 = d.at(i0)
        let v1 = d.at(i1)
        if (v0 < 0.0) != (v1 < 0.0) {
            let axis = e / 4
            let p0 = corner_uvw(i0)
            let t0 = clamp(v0 / (v0 - v1), 0.0, 1.0)
            var uvw = with_along(p0, axis, t0)
            let (edv0, egv0) = sample_dist(dist, cell_lo + uvw * h)
            var edv = edv0
            var egv = egv0
            var edot = along(egv, axis) * h
            // On a sharp 90° edge, linear interpolation can land inside the orthogonal face's
            // Voronoi region where `edot ≈ 0` and `|edv|` stays large: bracket the true root with
            // 4 bisection steps when the endpoints genuinely straddle zero. Endpoint checks and
            // bisection share one `dist` call site so composite fields stay compact in MSL.
            if abs(edot) < 0.15 * h && abs(edv) > 0.02 * h {
                var neg0 = false
                var lo = 0.0
                var hi = 1.0
                var straddles = true
                for step in 0..6 {
                    let s = if step == 0 { 0.0 } else if step == 1 { 1.0 } else { 0.5 * (lo + hi) }
                    let ds = dist(cell_lo + with_along(p0, axis, s) * h)
                    if step == 0 {
                        neg0 = ds < 0.0
                    } else if step == 1 {
                        if (ds < 0.0) == neg0 {
                            straddles = false
                            break
                        }
                    } else if (ds < 0.0) == neg0 {
                        lo = s
                    } else {
                        hi = s
                    }
                }
                if !straddles {
                    continue
                }
                let tm = 0.5 * (lo + hi)
                uvw = with_along(p0, axis, tm)
                let (bdv, bgv) = sample_dist(dist, cell_lo + uvw * h)
                edv = bdv
                egv = bgv
                edot = along(egv, axis) * h
                if abs(edot) > 1.0e-6 {
                    uvw = with_along(p0, axis, clamp(tm - edv / edot, lo, hi))
                }
            } else if abs(edot) > 1.0e-6 {
                uvw = with_along(p0, axis, clamp(t0 - edv / edot, 0.0, 1.0))
            }
            qef.add(uvw, safe_norm(egv, safe_norm(d.grad(uvw), vec3(0.0, 1.0, 0.0))))
        }
    }
    if qef.count == 0 {
        return trilinear_qef(d)
    }
    qef
}

/// Whether a cell's trilinear QEF (`trilinear_qef`) marks it a sharp crease.
pub(package) fn is_crease(trilinear: Qef) -> bool {
    trilinear.min_dot < CREASE_DOT
}

/// Whether a cell `is_crease` calls smooth is a crease or thin feature that trilinear interpolation
/// smeared out: either the field's exact gradient `gv` leans from the QEF's mean normal by more
/// than half the crease angle, or the trilinear solution stands more than `0.06 * h` off the zero
/// surface (classic chamfer signature on 90° corners and thin shells).
pub(package) fn hidden_crease(trilinear: Qef, _dv: f32, gv: vec3, _h: f32) -> bool {
    let g2 = dot(gv, gv)
    let m2 = dot(trilinear.avg_n, trilinear.avg_n)
    if g2 <= 1.0e-12 || m2 <= 1.0e-12 {
        return false
    }
    // A 90° corner cell whose inside corner sits close to one face smears `trilinear.avg_n` to
    // within 6°–16° of that face's normal (`dot ≈ 0.96..0.992`); catching any lean past ~5.5°
    // (`0.995`) routes those corners to exact bisection `hermite_qef` with zero bevel.
    dot(gv, trilinear.avg_n) < 0.975 * sqrt(g2 * m2)
}

/// The dual vertex solved from `qef` (`crease` picks its regularisation), snapped onto `dist`'s
/// zero set by one Newton step that stays in the cell, plus `dist`'s pre-snap value and gradient.
pub(package) fn solve_cell<F: Copy + fn(vec3) -> f32>(
    dist: F,
    qef: Qef,
    crease: bool,
    cell_lo: vec3,
    h: f32,
) -> (vec3, f32, vec3) {
    let reg = if crease { REG_CREASE } else { REG_SMOOTH }
    let raw = qef.solve_unclamped(reg)
    // Acute knife-edge wedges (`min_dot < -0.15`, internal angle < 81°) have their true crest
    // vertex slightly outside `[0, 1]³` in an adjacent all-positive cell. Allow a verified crest
    // extension up to `[-0.85, 1.85]³` ONLY when the solved point lies right on the true
    // zero-isosurface (`|dist(wp)| <= 0.04 * h`), recovering razor-sharp acute rims with zero
    // extra geometry.
    if crease && qef.min_dot < -0.15 {
        let ext = clamp(raw, vec3(-0.85), vec3(1.85))
        if ext.x < 0.0 || ext.x > 1.0 || ext.y < 0.0 || ext.y > 1.0 || ext.z < 0.0 || ext.z > 1.0 {
            let ewp = cell_lo + ext * h
            let (edv, egv) = sample_dist(dist, ewp)
            if abs(edv) <= 0.04 * h {
                return (ewp, edv, egv)
            }
        }
    }
    let wp = cell_lo + clamp(raw, vec3(0.0), vec3(1.0)) * h
    let (dv, gv) = sample_dist(dist, wp)
    (newton_snap(wp, dv, gv, cell_lo, h), dv, gv)
}

/// The most steps a crease cell's solve takes (`crease_steps`): past them its clamped dual vertex
/// is its answer.
pub(package) const CREASE_STEPS: u32 = 64

/// A crease cell's solve (`crease_steps`): its corners, and the state of the machine between
/// steps, which a dispatch that takes only some of them keeps for the next; once `done`, its
/// answer (`wp`, `gv` and `qef`).
pub(package) struct CreaseSolve: Copy + GpuData {
    pub(package) qef: Qef,
    pub(package) p0: vec3,
    pub(package) t0: f32,
    pub(package) uvw: vec3,
    pub(package) lo: f32,
    pub(package) wp_clamped: vec3,
    pub(package) hi: f32,
    pub(package) ewp: vec3,
    pub(package) e: u32,
    /// The answer once `done`: the vertex, and `dist`'s gradient there.
    pub(package) wp: vec3,
    /// 0: initial edge probe, 1: bisection step, 2: post-bisection normal, 3: knife-edge crest
    /// check, 4: clamped dual-vertex snap.
    pub(package) stage: u32,
    pub(package) gv: vec3,
    pub(package) d: CellCorners,
    pub(package) axis: u32,
    pub(package) bi: u32,
    pub(package) neg0: u32,
    /// The steps taken.
    pub(package) taken: u32,
    pub(package) done: u32,
}

/// A crease cell's solve before its first step: the cell from `cell_lo` (side `h`), corners `d`.
pub(package) fn crease_start(d: CellCorners, cell_lo: vec3, h: f32) -> CreaseSolve {
    let z = vec3(0.0)
    CreaseSolve {
        d: d,
        qef: qef_empty(),
        p0: z,
        uvw: z,
        wp_clamped: cell_lo + vec3(0.5 * h),
        ewp: cell_lo,
        wp: z,
        gv: z,
        t0: 0.0,
        lo: 0.0,
        hi: 1.0,
        e: 0,
        stage: 0,
        axis: 0,
        bi: 0,
        neg0: 0,
        taken: 0,
        done: 0,
    }
}

/// Unified sharp-crease solver (`hermite_qef` + `solve_cell`) sharing ONE `value_and_gradient`
/// call site across initial edge probes, sharp-corner bisection, knife-edge crest checks, and the
/// final Newton snap so composite carved fields stay compact in MSL/SPIR-V (`<= 288 KiB`) while
/// computing identical Hermite vertices and normals. Whole: `crease_steps` of all its steps.
pub(package) fn solve_crease_cell<F: Copy + fn(vec3) -> f32>(
    dist: F,
    d: CellCorners,
    cell_lo: vec3,
    h: f32,
) -> (vec3, vec3, Qef) {
    let s = crease_steps(dist, crease_start(d, cell_lo, h), cell_lo, h, CREASE_STEPS)
    (s.wp, s.gv, s.qef)
}

/// `solve`, the crease cell from `cell_lo` (side `h`), after `steps` more of its steps, or done
/// before them: each step samples `dist` once. A dispatch whose invocation can't do all of a
/// heavy field's steps does some (`crease_part`), and the next goes on from what it kept; the
/// steps and their answer are the whole solve's.
pub(package) fn crease_steps<F: Copy + fn(vec3) -> f32>(
    dist: F,
    solve: CreaseSolve,
    cell_lo: vec3,
    h: f32,
    steps: u32,
) -> CreaseSolve {
    var s = solve
    let d = s.d
    for _step in 0..steps {
        if s.done != 0 {
            break
        }
        let iter = s.taken
        s.taken += 1
        if iter >= CREASE_STEPS - 3 && s.stage < 3 {
            s.e = 12
            s.stage = 0
        }
        if s.stage == 0 {
            for _skip in 0..12 {
                if s.e >= 12 {
                    break
                }
                let (i0, i1) = edge_ends(s.e)
                let v0 = d.at(i0)
                let v1 = d.at(i1)
                if (v0 < 0.0) != (v1 < 0.0) {
                    s.axis = s.e / 4
                    s.p0 = corner_uvw(i0)
                    s.t0 = clamp(v0 / (v0 - v1), 0.0, 1.0)
                    s.uvw = with_along(s.p0, s.axis, s.t0)
                    break
                }
                s.e += 1
            }
            if s.e >= 12 {
                let tri = trilinear_qef(d)
                if s.qef.count == 0 {
                    s.qef = tri
                }
                let use_hermite = is_crease(tri) || s.qef.min_dot < 0.92
                let final_qef = if use_hermite { s.qef } else { tri }
                let reg = if use_hermite { REG_CREASE } else { REG_SMOOTH }
                let raw = final_qef.solve_unclamped(reg)
                s.wp_clamped = cell_lo + clamp(raw, vec3(0.0), vec3(1.0)) * h
                let ext = clamp(raw, vec3(-0.85), vec3(1.85))
                let out_of_cell = ext.x < 0.0 ||
                    ext.x > 1.0 ||
                    ext.y < 0.0 ||
                    ext.y > 1.0 ||
                    ext.z < 0.0 ||
                    ext.z > 1.0
                if use_hermite && final_qef.min_dot < -0.15 && out_of_cell {
                    s.ewp = cell_lo + ext * h
                    s.stage = 3
                } else {
                    s.stage = 4
                }
            }
        }
        let probe = if s.stage == 0 || s.stage == 2 {
            cell_lo + s.uvw * h
        } else if s.stage == 1 {
            let t = if s.bi == 0 { 0.0 } else if s.bi == 1 { 1.0 } else { 0.5 * (s.lo + s.hi) }
            cell_lo + with_along(s.p0, s.axis, t) * h
        } else if s.stage == 3 {
            s.ewp
        } else {
            s.wp_clamped
        }
        let (sv, sg) = sample_dist(dist, probe)
        if s.stage == 0 {
            let edot = along(sg, s.axis) * h
            if abs(edot) < 0.15 * h && abs(sv) > 0.02 * h {
                s.lo = 0.0
                s.hi = 1.0
                s.neg0 = 0
                s.bi = 0
                s.stage = 1
            } else {
                if abs(edot) > 1.0e-6 {
                    s.uvw = with_along(s.p0, s.axis, clamp(s.t0 - sv / edot, 0.0, 1.0))
                }
                s.qef.add(s.uvw, safe_norm(sg, safe_norm(d.grad(s.uvw), vec3(0.0, 1.0, 0.0))))
                s.e += 1
            }
        } else if s.stage == 1 {
            let neg = if sv < 0.0 { 1 } else { 0 }
            if s.bi == 0 {
                s.neg0 = neg
                s.bi = 1
            } else if s.bi == 1 {
                if neg == s.neg0 {
                    s.e += 1
                    s.stage = 0
                } else {
                    s.bi = 2
                }
            } else {
                let mid = 0.5 * (s.lo + s.hi)
                if neg == s.neg0 {
                    s.lo = mid
                } else {
                    s.hi = mid
                }
                s.bi += 1
                if s.bi >= 6 {
                    s.uvw = with_along(s.p0, s.axis, 0.5 * (s.lo + s.hi))
                    s.stage = 2
                }
            }
        } else if s.stage == 2 {
            let edot = along(sg, s.axis) * h
            if abs(edot) > 1.0e-6 {
                s.uvw = with_along(s.p0, s.axis, clamp(0.5 * (s.lo + s.hi) - sv / edot, s.lo, s.hi))
            }
            s.qef.add(s.uvw, safe_norm(sg, safe_norm(d.grad(s.uvw), vec3(0.0, 1.0, 0.0))))
            s.e += 1
            s.stage = 0
        } else if s.stage == 3 {
            if abs(sv) <= 0.04 * h {
                s.wp = s.ewp
                s.gv = sg
                s.done = 1
            } else {
                s.stage = 4
            }
        } else {
            s.wp = newton_snap(s.wp_clamped, sv, sg, cell_lo, h)
            s.gv = sg
            s.done = 1
        }
        if s.done == 0 && s.taken >= CREASE_STEPS {
            s.wp = s.wp_clamped
            s.gv = safe_norm(d.grad(vec3(0.5)), vec3(0.0, 1.0, 0.0))
            s.done = 1
        }
    }
    s
}

/// What every pass computes for a sign-changing cell with corners `d` at `cell_lo` (side `h`),
/// whichever pass that is: its dual vertex, `dist`'s gradient there, and the QEF it was solved
/// from (whose spread says whether it's shaded smooth). `solve_verts` and `refine_creases` split
/// this between them; the CPU tests call it whole.
pub(package) fn cell_dual_vertex<F: Copy + fn(vec3) -> f32>(
    dist: F,
    d: CellCorners,
    cell_lo: vec3,
    h: f32,
) -> (vec3, vec3, Qef) {
    let tri = trilinear_qef(d)
    if !is_crease(tri) {
        let (wp, dv, gv) = solve_cell(dist, tri, crease: false, cell_lo: cell_lo, h: h)
        if !hidden_crease(tri, dv, gv, h) {
            return (wp, gv, tri)
        }
        let qef = hermite_qef(dist, d, cell_lo, h)
        if qef.min_dot >= 0.92 {
            return (wp, gv, tri)
        }
        let (cwp, _cdv, cgv) = solve_cell(dist, qef, crease: true, cell_lo: cell_lo, h: h)
        return (cwp, cgv, qef)
    }
    let qef = hermite_qef(dist, d, cell_lo, h)
    let (wp, _dv, gv) = solve_cell(dist, qef, crease: true, cell_lo: cell_lo, h: h)
    (wp, gv, qef)
}

/// How near grazing, as the cosine between a surface and the way to the eye, a facing test made
/// on the eye's behalf counts a surface as both facing it and facing away: the eye may move before
/// the next extraction for it (`eye_step`), and this is as far as it can turn a plane's facing.
pub const EYE_ANGLE: f32 = 0.015625

/// The step `sync_one_lod` holds the eye to between extractions for it, with the nearest surface
/// `z_near` m away: a power of two no more than `EYE_ANGLE · z_near / √3` m (and 0.1 mm), so that
/// moving within a step on each axis turns no plane at or beyond `z_near` by more than
/// `EYE_ANGLE` (as a cosine).
pub fn eye_step(z_near: f32) -> f32 {
    exp2(floor(log2(max(EYE_ANGLE * z_near / 1.7320508, 1.0e-4))))
}

/// How the plane through `p` with unit normal `n` faces the eye `e`, for any eye within `reach`
/// of it (the most it moves before the next extraction for it: `eye_step`'s cube): bit 0 seen
/// from the front, bit 1 from behind (both, near grazing). The plane's side of the eye changes
/// by no more than the eye moves, however far the plane is.
pub(package) fn facing(n: vec3, p: vec3, e: vec3, reach: f32) -> u32 {
    let s = dot(n, e - p)
    (if s > -reach { 1 } else { 0 }) | (if s < reach { 2 } else { 0 })
}

/// What a quad is to the outline (`on_outline`): no part of it, maybe part of it (its cells are
/// certified, `certify_outline`, or solved), or folded (its cells are solved).
pub(package) const QUAD_INSIDE: u32 = 0
pub(package) const QUAD_OUTLINE: u32 = 1
pub(package) const QUAD_FOLDED: u32 = 2
/// The most cells apart two corners of a quad can lie: each vertex within 0.85 of a cell of its
/// own cell (`solve_cell`), the four cells round an edge a block 2 by 2 by 1 of them, so a block
/// 3.7 by 3.7 by 2.7 cells, 5.9 from corner to corner (`mesh::proof::LocalProof`).
pub(package) const QUAD_SPAN: f32 = 6.0

/// Whether the opaque quad `(p0, p1, p2, p3)` (vertex normals `n0..n3`, split along `p1–p3` when
/// `split13`) may hold part of the mesh's outline seen from `e` (or an eye near it: `facing`)
/// (`QUAD_OUTLINE`), or is folded (`QUAD_FOLDED`): some triangle or vertex normal of it faces the
/// eye and some faces away. A mesh can miss a pixel the field covers only beside its outline
/// (anywhere else the pixel's ray meets a triangle), and where two quads meet on the outline, one
/// triangle faces the eye and the other away, while the vertices they share face one way: one of
/// the two disagrees with them.
pub(package) fn on_outline(
    p0: vec3,
    p1: vec3,
    p2: vec3,
    p3: vec3,
    n0: vec3,
    n1: vec3,
    n2: vec3,
    n3: vec3,
    split13: bool,
    e: vec3,
    reach: f32,
) -> u32 {
    let out = n0 + n1 + n2 + n3
    // Its triangles as drawn (right-handed, `store_quad`'s winding): one wound against the
    // surface's normals there is folded, culled as back-facing, and leaves a pinhole wherever the
    // quad is seen, outline or not.
    let ta = if split13 { cross(p1 - p0, p3 - p0) } else { cross(p1 - p0, p2 - p0) }
    let tb = if split13 { cross(p2 - p1, p3 - p1) } else { cross(p2 - p0, p3 - p0) }
    if dot(ta, out) < 0.0 || dot(tb, out) < 0.0 {
        return QUAD_FOLDED
    }
    var seen = facing(n0, p0, e, reach) |
        facing(n1, p1, e, reach) |
        facing(n2, p2, e, reach) |
        facing(n3, p3, e, reach)
    let la = length(ta)
    if la > 0.0 {
        seen |= facing(ta / la, p0, e, reach)
    }
    let lb = length(tb)
    if lb > 0.0 {
        seen |= facing(tb / lb, p2, e, reach)
    }
    if seen == 3 { QUAD_OUTLINE } else { QUAD_INSIDE }
}

/// The narrowest a hole is, in pixels: a pixel's middle the mesh misses where the field meets
/// rays half a pixel to each side of it (`engine::judge::audit`). What the mesh misses by less is
/// an outline's error, the judges'.
pub const HOLE_PX: f32 = 0.5

/// Whether a cell `h` wide can't stand off the field by enough to hide a hole (`HOLE_PX`) from
/// the eye `exact_eye` (`xyz` its place, `w` its pixel's width a metre out): a mesh's vertex lies
/// in its cell and its triangles span two, so the mesh is within `2·√3·h` of the field there.
pub(package) fn finer_than_a_hole(cell_lo: vec3, h: f32, exact_eye: vec4) -> bool {
    let px = length(exact_eye.xyz - (cell_lo + vec3(0.5 * h))) * exact_eye.w
    3.4641016 * h < HOLE_PX * px
}

/// Pushes the cell's compact 16-byte dual vertex at `wp` (octahedral normal + thing index +
/// smooth/transmissive flags; full procedural `channels(wp)` runs at 1× pixel rate in `mesh_eye`).
/// A solved cell's vertex at `wp` of thing `thing_id`, its packed normal and flags
/// (`pack_vertex_meta`): the normal `dist`'s gradient `gv` (else the QEF's mean normal), smooth
/// where the QEF's normals agree, transmissive where the field's channels there let light
/// through.
pub(package) fn vertex_meta<M: Field<Substance>>(f: M, thing_id: u32, wp: vec3, gv: vec3, qef: Qef) -> u32 {
    let n_final = safe_norm(gv, safe_norm(qef.avg_n, vec3(0.0, 1.0, 0.0)))
    let is_trans = !f.uses_kept() &&
        f.field_facts().may_transmit &&
        f.channels(wp).transmission > 0.02
    pack_vertex_meta(n_final, thing_id, smooth: qef.min_dot >= SMOOTH_DOT, is_trans: is_trans)
}

/// `vertex_meta` at the rest pose (`rest_channels`).
fn rest_vertex_meta<M: Field<Substance>>(f: M, thing_id: u32, wp: vec3, gv: vec3, qef: Qef) -> u32 {
    let n_final = safe_norm(gv, safe_norm(qef.avg_n, vec3(0.0, 1.0, 0.0)))
    let is_trans = !f.uses_kept() &&
        f.field_facts().may_transmit &&
        f.rest_channels(wp).transmission > 0.02
    pack_vertex_meta(n_final, thing_id, smooth: qef.min_dot >= SMOOTH_DOT, is_trans: is_trans)
}

fn push_vertex<M: Field<Substance>>(
    f: M,
    thing_id: u32,
    wp: vec3,
    gv: vec3,
    qef: Qef,
    slot: u32,
    cap_verts: u32,
    verts: mut Append<MeshVertex>,
    cell_verts: mut Atomics<u32>,
) {
    let vi = verts.push(
        MeshVertex { px: wp.x, py: wp.y, pz: wp.z, packed: vertex_meta(f, thing_id, wp, gv, qef) },
    )
    if vi < cap_verts {
        cell_verts.store(i: slot, value: vi)
    }
}

/// Where in `ExtractScratch::exact_seen`, after each chunk brick's 12 words of claimed cells
/// (`claim_exact_cell`), its 12 words of outline cells (`box_outline`) begin.
pub(package) const OUTLINE_MARKS: u32 = CHUNK_BRICKS * 12

/// Where in `ExtractScratch::exact_seen`, after the outline marks, each chunk brick's 12 words of
/// cells put up for a certificate begin (`box_outline`: each cell once).
pub(package) const CERT_MARKS: u32 = CHUNK_BRICKS * 24

/// Atomically claims `(brick_in_chunk, cell)` in the 48 KB chunk-local deduplication bitset so
/// every cell emits at most ONE Tier-2 `ExactCell` across `solve_verts`, `refine_creases`, and
/// the outline's quads in `emit_tris`/`emit_tris_lod` (no cell drawn twice by one brick).
pub(package) fn claim_exact_cell(
    exact_seen: mut Atomics<u32>,
    brick_in_chunk: u32,
    cell: u32,
) -> bool {
    let word = brick_in_chunk * 12 + (cell >> 5)
    let bit = 1 << (cell & 31)
    (exact_seen.or(i: word, value: bit) & bit) == 0
}

/// Whether a face neighbour of the all-outside cell `(cx, cy, cz)` in the brick (its corners from
/// `base`) has a corner inside: a surface beside it, meshed there, whose outline's exact cells cover
/// what of it reaches into this cell. (A neighbour past the brick's corners counts as not.)
fn surface_beside(corners: [f32], base: u32, cx: u32, cy: u32, cz: u32) -> bool {
    var inside = false
    for a in 0..3 {
        for side in 0..2 {
            let at = if a == 0 { cx } else if a == 1 { cy } else { cz }
            if (side == 0 && at >= 1) || (side == 1 && at + 2 <= 7) {
                let far = if side == 0 { at - 1 } else { at + 2 }
                for k in 0..4 {
                    let u = k & 1
                    let w = k >> 1
                    let x = if a == 0 { far } else { cx + u }
                    let y = if a == 1 { far } else if a == 0 { cy + u } else { cy + w }
                    let z = if a == 2 { far } else { cz + w }
                    if cdist(corners, base, x, y, z) < 0.0 {
                        inside = true
                    }
                }
            }
        }
    }
    inside
}

/// Pass 2a: Classifies every cell of a chunk (`7×7×7 = 343` per brick) from its 8 corner signs,
/// clears its vertex slot and deduplication bit, appends sign-changing cells to `surf`, and appends
/// all-positive owned cells whose minimum corner distance falls within `lip * half_diag` to
/// `thin_cands` so sub-cell thin features (wands, tips, crests) are never dropped by Dual Contouring.
@strict
@compute(64)
pub(package) fn classify_cells(
    grids: [GridSpec],
    active: [ActiveBrick],
    active_count: [u32],
    cap_bricks: u32,
    chunk_start: u32,
    lip: f32,
    exact_eye: vec4,
    corners: [f32],
    cell_verts: mut Slots<u32>,
    exact_seen: mut Atomics<u32>,
    surf: mut Append<u32>,
    thin_cands: mut Append<u32>,
    id: GlobalId,
) {
    // 6 workgroups of 64 = 384 lanes per brick (covering 343 cells).
    let brick_in_chunk = id.x / 384
    let cell = id.x - brick_in_chunk * 384
    let bi = chunk_start + brick_in_chunk
    let total = min(active_count[0], cap_bricks)
    if bi >= total || cell >= VERTS_BRICK {
        return
    }
    if (cell & 31) == 0 {
        exact_seen.store(i: brick_in_chunk * 12 + (cell >> 5), value: 0)
        exact_seen.store(i: OUTLINE_MARKS + brick_in_chunk * 12 + (cell >> 5), value: 0)
        exact_seen.store(i: CERT_MARKS + brick_in_chunk * 12 + (cell >> 5), value: 0)
    }
    cell_verts[id] = NONE
    let (cx, cy, cz) = decode_cell(cell)
    let cbase = brick_in_chunk * CORNERS_BRICK
    var neg: u32 = 0
    var min_d = 1.0e30
    for k in 0..8 {
        let dv = cdist(corners, cbase, cx + (k & 1), cy + ((k >> 1) & 1), cz + (k >> 2))
        if dv < 0.0 {
            neg += 1
        }
        min_d = min(min_d, dv)
    }
    if neg != 0 && neg != 8 {
        let _ = surf.push((brick_in_chunk << 9) | cell)
    } else if neg == 0 && exact_eye.w > 0.0 && cx < BRICK && cy < BRICK && cz < BRICK {
        let ab = active[bi]
        let g = grids[ab.coord.w]
        let thresh = max(lip, 1.0) * 0.8660254 * g.cell
        if min_d <= thresh && !surface_beside(corners, cbase, cx, cy, cz) {
            let cell_lo = brick_corner(g, ab.coord.xyz, vec3u(cx, cy, cz))
            if !finer_than_a_hole(cell_lo, g.cell, exact_eye) {
                let _ = thin_cands.push((brick_in_chunk << 9) | cell)
            }
        }
    }
}

/// Counts in `tri_count[9]` a chunk's candidates past what its `filter_thin_cells` slices test
/// (`OVERFLOW_THIN`, raised by `finish_draw`).
@strict
@compute(64)
pub(package) fn note_untested(
    thin_count: [u32],
    slices: u32,
    tri_count: mut Atomics<u32>,
    id: GlobalId,
) {
    if id.x == 0 {
        let _ = tri_count.max(i: 10, value: thin_count[0])
        if thin_count[0] > slices * THIN_SLICE {
            let _ = tri_count.add(i: 9, value: thin_count[0] - slices * THIN_SLICE)
        }
    }
}

/// Compacted pass over all-positive thin-feature candidates (`classify_cells`): an exact cell for
/// each the compiler's sound interval (`std::derive::affine`) can't prove empty, whole or by
/// octants.
@strict
@compute(64)
pub(package) fn filter_thin_cells<M: Field<Substance>>(
    fields: [M],
    grids: [GridSpec],
    active: [ActiveBrick],
    chunk_start: u32,
    thin_cands: [u32],
    thin_count: [u32],
    first: u32,
    exact_eye: vec4,
    exact_seen: mut Atomics<u32>,
    exact_cells: mut Append<ExactCell>,
    id: GlobalId,
) {
    let i = first + id.x
    if i >= min(thin_count[0], CAP_SURF) {
        return
    }
    let packed = thin_cands[i]
    let local_bi = packed >> 9
    let cell = packed & 511
    let (cx, cy, cz) = decode_cell(cell)
    let ab = active[chunk_start + local_bi]
    let b = ab.coord
    let g = grids[b.w]
    let h = g.cell
    let cell_lo = brick_corner(g, b.xyz, vec3u(cx, cy, cz))
    let f = fields[g.orig_id]
    let live = ab.live
    // Exact cells for every cell whose core the compiler's affine form can't prove empty, whole
    // or by its eight octants (pre-filtered by `af.octant_range(k)` at zero extra field cost): a
    // surface can hide inside a cell all of whose corners are outside it (a wand, a tip, a crest),
    // and Dual Contouring, which sees only sign changes on edges, meshes none of it. The core is
    // the cell less a quarter pixel on every side (`HOLE_PX / 2`): what reaches no further in is
    // thinner than a hole (a pixel's middle missed with the field on every side of it), and asking
    // all of the cell would ask every cell that a neighbour's surface runs along, which no
    // interval proves empty.
    let px = length(exact_eye.xyz - (cell_lo + vec3(0.5 * h))) * exact_eye.w
    let m = 0.5 * HOLE_PX * px
    if 2.0 * m >= h {
        return
    }
    let lo = cell_lo + vec3(m)
    let w = h - 2.0 * m
    var maybe = false
    if is_heavy_field(fields[g.orig_id]) {
        var cur_live = live
        for k in 0..9 {
            if !maybe {
                let bx = if k == 0 {
                    Box3 { lo: lo, hi: lo + vec3(w) }
                } else {
                    let j = k - 1
                    let o = lo + vec3(f32(j & 1), f32((j >> 1) & 1), f32((j >> 2) & 1)) * (0.5 * w)
                    Box3 { lo: o, hi: o + vec3(0.5 * w) }
                }
                let pr = f.pruned(bx, |q: vec3| q, 1.0, cur_live, 0)
                if k == 0 {
                    if pr.range.lo > 0.0 {
                        return
                    }
                    cur_live = pr.live
                } else if pr.range.lo <= 0.0 {
                    maybe = true
                }
            }
        }
    } else {
        let dist = |q: vec3| f.distance_live(q, live)
        let af = affine_form(dist, Box3 { lo: lo, hi: lo + vec3(w) })
        if af.lo() > 0.0 {
            return
        }
        for k in 0..8 {
            if !maybe && af.octant_range(k).lo <= 0.0 {
                let o = lo + vec3(f32(k & 1), f32((k >> 1) & 1), f32((k >> 2) & 1)) * (0.5 * w)
                if affine_form(dist, Box3 { lo: o, hi: o + vec3(0.5 * w) }).lo() <= 0.0 {
                    maybe = true
                }
            }
        }
    }
    if maybe && claim_exact_cell(mut exact_seen, local_bi, cell) {
        let _ = exact_cells.push(ExactCell { lo: cell_lo, h, live })
    }
}

/// Pass 2b: Solves one Dual Contouring vertex per compacted sign-changing cell from ONLY the
/// cell's own 8 corners (the same bits in every brick that shares the cell, so meshes are
/// watertight across brick seams), snapped onto the field's zero set by one exact Newton step.
/// Sharp crease cells are all handed to `refine_creases` (one vertex per cell; its list holds every
/// surface cell), so a crease cell is only ever solved one way.
@strict
@compute(64)
pub(package) fn solve_verts<M: Field<Substance>>(
    fields: [M],
    grids: [GridSpec],
    active: [ActiveBrick],
    chunk_start: u32,
    corners: [f32],
    surf: [u32],
    surf_count: [u32],
    first: u32,
    cap_verts: u32,
    cell_verts: mut Atomics<u32>,
    verts: mut Append<MeshVertex>,
    creases: mut Append<u32>,
    id: GlobalId,
) {
    let n_surf = min(surf_count[0], CAP_SURF)
    let i = first + id.x
    if i >= n_surf {
        return
    }
    let packed = surf[i]
    let local_bi = packed >> 9
    let cell = packed & 511
    let (cx, cy, cz) = decode_cell(cell)
    let d = load_corners(corners, local_bi * CORNERS_BRICK, cx, cy, cz)
    let tri = trilinear_qef(d)
    let crease = is_crease(tri)
    if crease {
        // Solved by `refine_creases`; the list has room for every surface cell.
        let _ = creases.push(packed)
        return
    }
    let ab = active[chunk_start + local_bi]
    let b = ab.coord
    let g = grids[b.w]
    let h = g.cell
    let cell_lo = brick_corner(g, b.xyz, vec3u(cx, cy, cz))
    let f = fields[g.orig_id]
    // Only the brick's live parts are asked: bit for bit the full distance inside the brick.
    let live = ab.live
    let dist = |q: vec3| f.distance_live(q, live)
    let qef = tri
    let (wp, dv, gv) = solve_cell(dist, qef, crease: false, cell_lo: cell_lo, h: h)
    if hidden_crease(tri, dv, gv, h) {
        // A crease after all: solved by `refine_creases`, as `cell_dual_vertex` says.
        let _ = creases.push(packed)
        return
    }
    push_vertex(
        f,
        g.orig_id,
        wp,
        gv,
        qef,
        local_bi * VERTS_STRIDE + cell,
        cap_verts,
        mut verts,
        mut cell_verts,
    )
}

/// Prepares indirect dispatch args for `slices` 64-wide passes over a compacted list of
/// `count[0]` items (clamped to `cap`), each over the next `most` of them (`args[k]`: items
/// `k·most..(k + 1)·most`): no groups for a slice past the list's end. One dispatch, however many
/// slices.
@strict
@compute(64)
pub fn prep_slices(
    count: [u32],
    cap: u32,
    most: u32,
    slices: u32,
    args: mut Slots<DispatchArgs>,
    id: GlobalId,
) {
    if id.x >= slices {
        return
    }
    let n = min(count[0], cap)
    let first = id.x * most
    let m = if n > first { min(n - first, most) } else { 0 }
    args[id] = DispatchArgs { x: (m + 63) / 64, y: 1, z: 1 }
}

/// What one step of a crease cell's solve is given in a kernel, all of it unknown to the count:
/// the solve's state and the parts live in its brick.
struct CreaseStepIn: Copy {
    solve: CreaseSolve,
    live: Live,
    d: CellCorners,
    pass: u32,
}

/// The work of one step of a crease cell's solve of a field like `sample`'s distance
/// (`crease_steps`) from any state and with any parts live (all unknown, so the count takes the
/// costliest step, as the kernel's own count does), as the strict kernel computes it (`std::derive::strict_work`). Every choice
/// of how a field's crease and surface cells are dispatched starts from this one count, so a
/// kind is counted once.
pub(package) fn crease_step_cost_of<M: Field<Substance>>(sample: M) -> u32 {
    max(std::derive::strict_work(|s: CreaseStepIn| crease_steps(|q: vec3| sample.distance_live(q, s.live), s.solve, s.solve.ewp, s.solve.hi, 1)), 1)
}

/// `crease_step_cost_of` of a field like `sample`'s rest-pose distance (`refine_creases_rest`).
pub(package) fn crease_step_cost_rest_of<M: Field<Substance>>(sample: M) -> u32 {
    max(std::derive::strict_work(|s: CreaseStepIn| crease_steps(|q: vec3| sample.rest_distance_live(q, s.live), s.solve, s.solve.ewp, s.solve.hi, 1)), 1)
}

/// The steps of a crease cell's solve one dispatch takes, a step costing `step`: all of them
/// (`CREASE_STEPS`) where an invocation's work for them, with a fifth more, is within half the
/// most one may do on the slowest target (`LANE_WORK_LEAST`: half, for a device slower than its
/// target's), else the most power of two that is. A constant of the build for each kind, worked
/// in integers, which the compiler's count follows, so a kernel's bound counts only these steps.
/// (SCENE 13's desk: 4.06M work an invocation for all 64, past the M4's 2.44M.)
pub(package) fn crease_part(step: u32) -> u32 {
    let most = LANE_WORK_LEAST / 2
    let s = min(step, most)
    let w = s + s / 5
    if w <= most / 64 { 64 } else if w <= most / 32 { 32 } else if w <= most / 16 { 16 } else if
        w <= most / 8 { 8 } else if w <= most / 4 { 4 } else if w <= most / 2 { 2 } else { 1 }
}

/// The dispatches of a crease cell's solve that take `part` steps each.
pub(package) fn crease_passes(part: u32) -> u32 {
    (CREASE_STEPS + part - 1) / part
}

/// The crease cells one dispatch may solve, an invocation of its kernel costing `invocation` (the
/// kernel's own bound, `std::gpu::kernel_work`): as many as keep it within the GPU's step
/// (`limits().step_work`), clamped to `[CREASE_SLICE_LEAST, CREASE_SLICE]`. (A count of the same
/// code in a module of its own was 35% to 55% under some kernels' bounds: the kernel inlines it
/// differently.)
pub(package) fn crease_slice(invocation: u32) -> u32 {
    let work = f32(limits().step_work) * 1000.0
    let n = u32(clamp(work / (f32(invocation) + 2000.0), f32(CREASE_SLICE_LEAST), f32(CREASE_SLICE)))
    max((n / 64) * 64, CREASE_SLICE_LEAST)
}

/// The surface cells one `solve_verts` dispatch may solve, an invocation of its kernel costing
/// `invocation` (its own bound, `std::gpu::kernel_work`): up to `CAP_SURF` (one dispatch for light
/// fields), cut into smaller slices for heavy carved fields. (Sized from a whole crease solve's
/// count, the slices were a third smaller than the kernel's bound lets them be: SCENE 10 made 76
/// `solve_verts` dispatches a frame where 50 do.)
pub(package) fn surf_slice(invocation: u32) -> u32 {
    let work = f32(limits().step_work) * 1000.0
    let n = u32(clamp(work / (f32(invocation) + 2000.0), f32(CREASE_SLICE_LEAST), f32(CAP_SURF)))
    max((n / 64) * 64, CREASE_SLICE_LEAST)
}

/// After a chunk's vertices are made (ONLY for fields with `uses_kept() == true`): stores each
/// vertex's part (`part | trans`) and packed `kept` story in `vert_kept` so pixel-rate shading
/// calls `channels_kept(wp, part, kept)` without re-evaluating the full shape tree.
@strict
@compute(64)
pub(package) fn keep_verts<M: Field<Substance>>(
    fields: [M],
    verts: [MeshVertex],
    vert_count: [u32],
    cap_verts: u32,
    first: [u32],
    from: u32,
    vert_kept: mut Atomics<u32>,
    id: GlobalId,
) {
    let vi = first[0] + from + id.x
    if vi >= min(vert_count[0], cap_verts) {
        return
    }
    let v = verts[vi]
    let p = vec3(v.px, v.py, v.pz)
    let f = fields[unpack_thing(v.packed)]
    let (_, part, kept) = f.kept_at(p)
    let trans = if f.field_facts().may_transmit &&
        f.channels_kept(p, part, kept).transmission > 0.02 {
        KEPT_TRANS
    } else {
        0
    }
    vert_kept.store(i: 2 * vi, value: part | trans)
    vert_kept.store(i: 2 * vi + 1, value: pack_kept(kept))
}

/// What one vertex of `keep_verts` asks of a field, for the compiler's count of its work.
fn keep_vert_work<M: Field<Substance>>(f: M, p: vec3) -> vec4 {
    let (d, part, k) = f.kept_at(p)
    k + vec4(d + f.channels_kept(p, part, k).transmission, f32(part), 0.0, 0.0)
}

/// Where the chunk about to be made starts in the batch's vertices (`keep_verts`).
@strict
@compute(1)
pub(package) fn mark_first(vert_count: [u32], cap_verts: u32, first: mut One<u32>, id: GlobalId) {
    first.set(id, min(vert_count[0], cap_verts))
}

/// The vertices one `keep_verts` dispatch may take for a field like `sample`.
pub(package) fn keep_slice_of<M: Field<Substance>>(sample: M) -> u32 {
    let cell = f32(max(std::derive::strict_work(|p: vec3| keep_vert_work(sample, p)), 1))
    let step = f32(limits().step_work) * 1000.0
    let n = u32(clamp(step / (cell * 1.2 + 2000.0), 1024.0, 1048576.0))
    max((n / 64) * 64, 1024)
}

/// `prep_slices` from item `first[0]`: args for `slices` passes over items `first[0] + k·most` on.
@strict
@compute(64)
pub(package) fn prep_from(
    count: [u32],
    cap: u32,
    first: [u32],
    most: u32,
    slices: u32,
    args: mut Slots<DispatchArgs>,
    id: GlobalId,
) {
    if id.x >= slices {
        return
    }
    let n = min(count[0], cap)
    let at = first[0] + id.x * most
    let m = if n > at { min(n - at, most) } else { 0 }
    args[id] = DispatchArgs { x: (m + 63) / 64, y: 1, z: 1 }
}

/// `prep_slices` for a chunk's crease list (`slices` of `slice`), noting in `seen` the
/// most creases a chunk held (`[4]`) and whether one held more than its slices cover (`[5]`, then
/// those were not solved: `took_counts` extracts again with slices for them).
@strict
@compute(64)
pub(package) fn prep_creases(
    count: [u32],
    slices: u32,
    slice: u32,
    args: mut Slots<DispatchArgs>,
    seen: mut Atomics<u32>,
    id: GlobalId,
) {
    if id.x >= slices {
        return
    }
    let n = min(count[0], CAP_SURF)
    let first = id.x * slice
    let m = if n > first { min(n - first, slice) } else { 0 }
    args[id] = DispatchArgs { x: (m + 63) / 64, y: 1, z: 1 }
    if id.x == 0 {
        let _ = seen.max(i: 4, value: n)
        if n > slices * slice {
            let _ = seen.add(i: 5, value: 1)
        }
    }
}

/// Pass 2c: Runs ONLY on compacted sharp-crease cells, solving them from exact analytic Hermite
/// edge crossings and normals (`hermite_qef`) instead of smeared trilinear gradients.
@strict
@compute(64)
pub(package) fn refine_creases<M: Field<Substance>>(
    fields: [M],
    grids: [GridSpec],
    active: [ActiveBrick],
    chunk_start: u32,
    corners: [f32],
    creases: [u32],
    crease_count: [u32],
    first: u32,
    pass: u32,
    solves: mut Slots<CreaseSolve>,
    cap_verts: u32,
    cell_verts: mut Atomics<u32>,
    verts: mut Append<MeshVertex>,
    id: GlobalId,
) {
    let i = first + id.x
    if i >= min(crease_count[0], CAP_SURF) {
        return
    }
    let packed = creases[i]
    let local_bi = packed >> 9
    let cell = packed & 511
    let (cx, cy, cz) = decode_cell(cell)
    let ab = active[chunk_start + local_bi]
    let b = ab.coord
    let g = grids[b.w]
    let h = g.cell
    let cell_lo = brick_corner(g, b.xyz, vec3u(cx, cy, cz))
    let f = fields[g.orig_id]
    let live = ab.live
    let dist = |q: vec3| f.distance_live(q, live)
    // This pass's steps of the cell's solve, from where the last kept it (`crease_part`).
    let part = crease_part(crease_step_cost_of(f))
    let from = if pass == 0 {
        crease_start(load_corners(corners, local_bi * CORNERS_BRICK, cx, cy, cz), cell_lo, h)
    } else {
        solves[id]
    }
    if from.done != 0 {
        return
    }
    let s = crease_steps(dist, from, cell_lo, h, part)
    if part < CREASE_STEPS {
        solves[id] = s
    }
    if s.done != 0 {
        push_vertex(
            f,
            g.orig_id,
            s.wp,
            s.gv,
            s.qef,
            local_bi * VERTS_STRIDE + cell,
            cap_verts,
            mut verts,
            mut cell_verts,
        )
    }
}

/// Rest-pose Pass 0 for `Skinned` fields: interval-culls bricks against `rest_pruned`.
@strict
@compute(64)
pub(package) fn cull_bricks_rest<M: Field<Substance>>(
    fields: [M],
    grids: [GridSpec],
    things: u32,
    first_brick: u32,
    total_bricks: u32,
    active: mut Append<ActiveBrick>,
    id: GlobalId,
) {
    let gb = first_brick + id.x
    if gb >= total_bricks {
        return
    }
    let ti = owner_of(grids, things, gb)
    let g = grids[ti]
    let b = brick_of(g, gb - g.base_brick)
    let lo = brick_corner(g, b, vec3u(0, 0, 0))
    let hi = brick_corner(g, b, vec3u(BRICK + 1, BRICK + 1, BRICK + 1))
    let pr = fields[g.orig_id].rest_pruned(Box3 { lo, hi }, |q: vec3| q, 1.0, ALL_LIVE, 0)
    if pr.range.lo <= 0.0 && pr.range.hi >= 0.0 {
        let _ = active.push(ActiveBrick { coord: vec4u(b.x, b.y, b.z, ti), live: pr.live })
    }
}

/// Rest-pose Pass 1 for `Skinned` fields: evaluates `rest_distance_live` at brick corners.
@strict
@compute(64)
pub(package) fn eval_corners_rest<M: Field<Substance>>(
    fields: [M],
    grids: [GridSpec],
    active: [ActiveBrick],
    active_count: [u32],
    cap_bricks: u32,
    chunk_start: u32,
    corners: mut Slots<f32>,
    id: GlobalId,
) {
    let brick_in_chunk = id.x / CORNERS_BRICK
    let bi = chunk_start + brick_in_chunk
    let total = min(active_count[0], cap_bricks)
    if bi >= total {
        return
    }
    let ci = id.x - brick_in_chunk * CORNERS_BRICK
    let ab = active[bi]
    let b = ab.coord
    let g = grids[b.w]
    let cx = ci & 7
    let cy = (ci >> 3) & 7
    let cz = ci >> 6
    let p = brick_corner(g, b.xyz, vec3u(cx, cy, cz))
    corners[id] = fields[g.orig_id].rest_distance_live(p, ab.live)
}

/// Pushes a rest-pose skinned vertex alongside its auto-computed 8-byte `(bones, weights)` pair.
fn push_skinned_vertex<M: Field<Substance>>(
    f: M,
    thing_id: u32,
    wp: vec3,
    gv: vec3,
    qef: Qef,
    slot: u32,
    cap_verts: u32,
    verts: mut Append<MeshVertex>,
    skin_verts: mut Atomics<u32>,
    cell_verts: mut Atomics<u32>,
) {
    let sw = f.rest_skin_weights(wp)
    let vi = verts.push(
        MeshVertex {
            px: wp.x,
            py: wp.y,
            pz: wp.z,
            packed: rest_vertex_meta(f, thing_id, wp, gv, qef),
        },
    )
    if vi < cap_verts {
        skin_verts.store(i: vi * 2, value: sw.x)
        skin_verts.store(i: vi * 2 + 1, value: sw.y)
        cell_verts.store(i: slot, value: vi)
    }
}

/// Rest-pose Pass 2b for `Skinned` fields: `solve_verts` on `rest_distance_live`, with per-vertex
/// skin weights from `rest_skin_weights`.
@strict
@compute(64)
pub(package) fn solve_verts_rest<M: Field<Substance>>(
    fields: [M],
    grids: [GridSpec],
    active: [ActiveBrick],
    chunk_start: u32,
    corners: [f32],
    surf: [u32],
    surf_count: [u32],
    first: u32,
    cap_verts: u32,
    cell_verts: mut Atomics<u32>,
    verts: mut Append<MeshVertex>,
    skin_verts: mut Atomics<u32>,
    creases: mut Append<u32>,
    id: GlobalId,
) {
    let n_surf = min(surf_count[0], CAP_SURF)
    let i = first + id.x
    if i >= n_surf {
        return
    }
    let packed = surf[i]
    let local_bi = packed >> 9
    let cell = packed & 511
    let (cx, cy, cz) = decode_cell(cell)
    let d = load_corners(corners, local_bi * CORNERS_BRICK, cx, cy, cz)
    let tri = trilinear_qef(d)
    let crease = is_crease(tri)
    if crease {
        // Solved by `refine_creases`; the list has room for every surface cell.
        let _ = creases.push(packed)
        return
    }
    let ab = active[chunk_start + local_bi]
    let b = ab.coord
    let g = grids[b.w]
    let h = g.cell
    let cell_lo = brick_corner(g, b.xyz, vec3u(cx, cy, cz))
    let f = fields[g.orig_id]
    let live = ab.live
    let dist = |q: vec3| f.rest_distance_live(q, live)
    let qef = tri
    let (wp, dv, gv) = solve_cell(dist, qef, crease: false, cell_lo: cell_lo, h: h)
    if hidden_crease(tri, dv, gv, h) {
        // A crease after all: solved by `refine_creases`, as `cell_dual_vertex` says.
        let _ = creases.push(packed)
        return
    }
    push_skinned_vertex(
        f,
        g.orig_id,
        wp,
        gv,
        qef,
        local_bi * VERTS_STRIDE + cell,
        cap_verts,
        mut verts,
        mut skin_verts,
        mut cell_verts,
    )
}

/// Rest-pose `refine_creases` for `Skinned` fields.
@strict
@compute(64)
pub(package) fn refine_creases_rest<M: Field<Substance>>(
    fields: [M],
    grids: [GridSpec],
    active: [ActiveBrick],
    chunk_start: u32,
    corners: [f32],
    creases: [u32],
    crease_count: [u32],
    first: u32,
    pass: u32,
    solves: mut Slots<CreaseSolve>,
    cap_verts: u32,
    cell_verts: mut Atomics<u32>,
    verts: mut Append<MeshVertex>,
    skin_verts: mut Atomics<u32>,
    id: GlobalId,
) {
    let i = first + id.x
    if i >= min(crease_count[0], CAP_SURF) {
        return
    }
    let packed = creases[i]
    let local_bi = packed >> 9
    let cell = packed & 511
    let (cx, cy, cz) = decode_cell(cell)
    let ab = active[chunk_start + local_bi]
    let b = ab.coord
    let g = grids[b.w]
    let h = g.cell
    let cell_lo = brick_corner(g, b.xyz, vec3u(cx, cy, cz))
    let f = fields[g.orig_id]
    let live = ab.live
    let dist = |q: vec3| f.rest_distance_live(q, live)
    // This pass's steps of the cell's solve, from where the last kept it.
    let part = crease_part(crease_step_cost_rest_of(f))
    let from = if pass == 0 {
        crease_start(load_corners(corners, local_bi * CORNERS_BRICK, cx, cy, cz), cell_lo, h)
    } else {
        solves[id]
    }
    if from.done != 0 {
        return
    }
    let s = crease_steps(dist, from, cell_lo, h, part)
    if part < CREASE_STEPS {
        solves[id] = s
    }
    if s.done != 0 {
        push_skinned_vertex(
            f,
            g.orig_id,
            s.wp,
            s.gv,
            s.qef,
            local_bi * VERTS_STRIDE + cell,
            cap_verts,
            mut verts,
            mut skin_verts,
            mut cell_verts,
        )
    }
}

/// Projects a skinned vertex at `p` (skinned normal `n_ref`) onto `dist`'s zero set by up to 3
/// Newton steps, returning where it lands and its normal there. A step is kept only if it
/// lowers `|dist|` and lands where the gradient still faces `n_ref`, and it moves at most twice
/// `|dist|` (an exact distance needs exactly `|dist|`): a vertex never jumps to another sheet of
/// the surface (the far face of a thin part) or runs off where the gradient vanishes. A vertex
/// whose gradient already faces away from `n_ref` stays where skinning put it.
pub fn project_posed<F: Copy + fn(vec3) -> f32>(dist: F, p: vec3, n_ref: vec3) -> (vec3, vec3) {
    var wp = p
    var nrm = n_ref
    let (d0, g0) = sample_dist(dist, wp)
    var d = d0
    var g = g0
    var gl2 = dot(g, g)
    if gl2 <= 1.0e-10 || dot(g, n_ref) <= 0.0 {
        return (wp, nrm)
    }
    nrm = g * (1.0 / sqrt(gl2))
    for _step in 0..3 {
        if abs(d) <= 1.0e-4 {
            break
        }
        var s = g * (d / gl2)
        let sl = length(s)
        let most = 2.0 * abs(d)
        if sl > most {
            s = s * (most / sl)
        }
        let cand = wp - s
        let (dc, gc) = sample_dist(dist, cand)
        let gc2 = dot(gc, gc)
        if !(abs(dc) < abs(d)) || gc2 <= 1.0e-10 || dot(gc, n_ref) <= 0.0 {
            break
        }
        wp = cand
        d = dc
        g = gc
        gl2 = gc2
        nrm = g * (1.0 / sqrt(gl2))
    }
    (wp, nrm)
}

/// Deforms a `Skinned` `One<M>` rest-pose meshlet on the GPU via 4-bone Dual Quaternion Skinning
/// followed by guarded Newton projection (`project_posed`) onto `field.posed_local_distance`:
/// exact posed geometry and analytical normals with no DQS joint pinching or silhouette lag.
@strict
@compute(64)
pub(package) fn deform_skinned_verts<M: Field<Substance>>(
    field: M,
    rest_verts: [MeshVertex],
    skin: [u32],
    vert_count: [u32],
    cap_verts: u32,
    first: u32,
    bones: [DualQuat],
    out: mut Slots<MeshVertex>,
    id: GlobalId,
) {
    // `out` starts at vertex `first`.
    let i = first + id.x
    if i >= min(vert_count[0], cap_verts) {
        return
    }
    let v = rest_verts[i]
    let dq = eval_dqs(bones, 0, skin[i * 2], skin[i * 2 + 1])
    let lp = vec3(v.px, v.py, v.pz)
    let (wp, nrm) = project_posed(
        |q: vec3| field.posed_local_distance(q),
        dq.apply_point(lp),
        dq.apply_normal(unpack_oct_normal(v.packed)),
    )
    let tid = unpack_thing(v.packed)
    let smooth = unpack_smooth(v.packed)
    let is_trans = unpack_is_trans(v.packed)
    out[id] = MeshVertex {
        px: wp.x,
        py: wp.y,
        pz: wp.z,
        packed: pack_vertex_meta(nrm, tid, smooth: smooth, is_trans: is_trans),
    }
}
/// Dual vertex index of local cell `(x, y, z)` in `0..7` inside brick `bi`.
