// Judging as a scene runs it (docs/design.md, "Order of work", 0), a moment at a time: the engine
// draws the moment once, the reference works on it over as many frames as it takes, and when its
// looks are in the judges hold the engine's picture to the whole reference (with crawl from the
// moment before), and at the first moment the reference's second half to its first (the judges'
// own floor: what they say of a picture that is right but for the reference's noise). It says
// "scene: done" once every moment is judged and every judge heard. A scene says only what is
// judged (its world, sky, look and eye a frame) and how: how many moments, whether each has its
// own reference, what is shown.
//
// With `faults`, the judges are checked themselves: the floor's picture with each of four faults
// planted in it (`judge::planted`), each held to the first half, so their counts show the judges
// finding each.

use judge::judge::{DIMMED, HOLE, Judge, PUSHED, SHIFTED, judge, marks, planted}
use matter::sky::Sky
use matter::world::World
use mesh::draw::{MeshSight, MeshWorld}
use picture::eye::Eye
use picture::look::Look
use picture::picture::{Picture, picture}
use picture::screen::show
use reference::reference::{Reference, Truth, truth}
use std::io::print

/// What is shown while judging: the engine's picture; the reference; where the judges read the
/// engine's coverage as off (`judge::marks`).
pub const SHOW_PICTURE: u32 = 0
pub const SHOW_REFERENCE: u32 = 1
pub const SHOW_MARKS: u32 = 2

/// The planted faults: how wide the hole is (px), and how far the surfaces are pushed (px).
pub const HOLE_SIZE: f32 = 12.0
pub const PUSH: f32 = 0.75

/// A scene's judging: the reference and what it has said, the judges, and where in its moments it
/// is; what it shows (`SHOWN`: `SHOW_PICTURE`..., fixed when built, so a build that never shows
/// marks has no shader for them).
pub struct Judging<const SHOWN: u32> {
    reference: Reference,
    truth: Truth,
    full: Truth,
    scratch: Truth,
    shown: Picture,
    half: Picture,
    marked: Picture,
    judge: Judge,
    /// How many moments are judged; whether each moment after the first has its reference begun
    /// again (false: it is held to the first's, while it is seen through the same eye: a moment
    /// seen through another eye always has its own); the eye the reference is of.
    moments: u32,
    again: bool,
    made_for: Eye,
    moment: u32,
    drawn: bool,
    finished: bool,
    said: bool,
    planted: bool,
}

/// Judging by `reference`, `moments` moments (see `Judging`).
pub fn judging<const SHOWN: u32>(
    reference: take Reference,
    moments: u32,
    again: bool = true,
) -> Judging<SHOWN> {
    Judging {
        reference,
        truth: truth(),
        full: truth(),
        scratch: truth(),
        shown: picture(width: 1, height: 1),
        half: picture(width: 1, height: 1),
        marked: picture(width: 1, height: 1),
        judge: judge(),
        moments,
        again,
        made_for: Eye { at: vec3(0.0), toward: vec3(0.0, 0.0, 1.0), wide: 1.0 },
        moment: 0,
        drawn: false,
        finished: false,
        said: false,
        planted: false,
    }
}

impl<const SHOWN: u32> Judging<SHOWN> {
    /// The moment being judged (from 0; `moments` once all are).
    pub fn moment(self) -> u32 {
        self.moment
    }

    /// A frame of judging `world` under `sky`, in `look`, through `eye` (the walk at `t` s, as it
    /// is said): `mesh` draws the moment, the reference works on it; when its looks are in, the
    /// judges hold the engine's picture to it. Shows what `SHOWN` asks.
    pub fn frame<W: World + MeshWorld, S: Sky, L: Look>(
        mut self,
        mesh: mut MeshSight,
        world: W,
        sky: S,
        look: L,
        eye: Eye,
        width: u32,
        height: u32,
        t: f32,
    ) {
        if self.shown.width() != width || self.shown.height() != height {
            self.shown = picture(width: width, height: height)
        }
        if !self.finished {
            if !self.drawn {
                // (A reference is of one eye: a moment after the first seen through another, or
                // whose world is said to change, has its own begun.)
                if self.moment > 0 && (self.again || !same_eye(eye, self.made_for)) {
                    self.reference.begin()
                }
                self.made_for = eye
                mesh.drawn_only(world, sky, look, eye, width, height)
                self.drawn = true
            }
            if self.drawn && !self.reference.done() {
                self.reference.work(world, sky, look, eye, width, height)
            }
            if self.reference.done() && self.drawn {
                self.reference.picture(0, mut self.shown, mut self.scratch)
                self.reference.settle(0, mut self.full)
                let _ = self.judge.held(
                    mesh.drawn,
                    self.full,
                    eye,
                    crawl: true,
                    what: f"moment {self.moment} (walk at {t} s): the meshlet picture against the reference",
                    sun: mesh.drawn.sun,
                )
                if self.moment == 0 {
                    self.reference.settle(1, mut self.truth)
                    self.reference.picture(2, mut self.half, mut self.scratch)
                    let _ = self.judge.held(
                        self.half,
                        self.truth,
                        eye,
                        crawl: false,
                        what: "the reference's second half against its first (the judges' floor)",
                        sun: mesh.drawn.sun,
                    )
                }
                if SHOWN == SHOW_MARKS {
                    marks(mesh.drawn, self.full, mut self.marked)
                }
                print(f"moment {self.moment} done")
                self.moment += 1
                self.drawn = false
                if self.moment >= self.moments {
                    self.finished = true
                }
            }
        }
        let all_heard = self.judge.heard()
        if self.finished && all_heard && !self.said {
            self.said = true
            print("scene: done")
        }
        if SHOWN == SHOW_REFERENCE {
            show(self.shown.colour)
        } else if SHOWN == SHOW_MARKS && self.marked.width() == width {
            show(self.marked.colour)
        } else if mesh.drawn.placed {
            show(mesh.drawn.colour)
        } else {
            show(self.shown.colour)
        }
    }

    /// Once the first moment's floor is judged (called each frame after `frame`; once): the floor's
    /// picture (the reference's second half) with each fault planted in it, held to the first half
    /// as seen through `eye` (near a shadow's edge as `mesh`'s picture places them, as the floor): a hole `HOLE_SIZE` px square about where `eye` sees `at` (a point on
    /// matter); the picture a pixel right; the light on matter a tenth darker; its surfaces said to
    /// be `PUSH` px farther along each ray. Each judge's counts should show its fault: the hole's
    /// pixels as holes, the outline off, the lit pixels over, the surfaces apart.
    pub fn faults(mut self, mesh: MeshSight, eye: Eye, at: vec3) {
        if self.moment == 0 || self.planted {
            return
        }
        self.planted = true
        var faulty = picture(width: 1, height: 1)
        planted(self.half, self.truth, HOLE, eye, at, HOLE_SIZE, mut faulty)
        let _ = self.judge.held(
            faulty,
            self.truth,
            eye,
            crawl: false,
            what: f"the second half with a hole {HOLE_SIZE} px square planted about {at}",
            sun: mesh.drawn.sun,
        )
        planted(self.half, self.truth, SHIFTED, eye, at, HOLE_SIZE, mut faulty)
        let _ = self.judge.held(
            faulty,
            self.truth,
            eye,
            crawl: false,
            what: "the second half moved a pixel right",
            sun: mesh.drawn.sun,
        )
        planted(self.half, self.truth, DIMMED, eye, at, HOLE_SIZE, mut faulty)
        let _ = self.judge.held(
            faulty,
            self.truth,
            eye,
            crawl: false,
            what: "the second half with the light on matter a tenth darker",
            sun: mesh.drawn.sun,
        )
        planted(self.half, self.truth, PUSHED, eye, at, PUSH, mut faulty)
        let _ = self.judge.held(
            faulty,
            self.truth,
            eye,
            crawl: false,
            what: f"the second half, its surfaces said to be {PUSH} px farther along each ray",
            sun: mesh.drawn.sun,
        )
    }
}

/// Whether two eyes are the same: where they stand, what they look at, how wide they see.
fn same_eye(a: Eye, b: Eye) -> bool {
    a.at.x == b.at.x &&
        a.at.y == b.at.y &&
        a.at.z == b.at.z &&
        a.toward.x == b.toward.x &&
        a.toward.y == b.toward.y &&
        a.toward.z == b.toward.z &&
        a.wide == b.wide
}
