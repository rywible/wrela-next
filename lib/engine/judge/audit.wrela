// The hole audit: an instrument beside the judges, quick enough to run at every change. It needs
// no reference picture: at each pixel of a small picture the engine drew, it marches the pixel's
// middle ray through the thing's own field (`marched`: a plain march by its value over its stated
// steepness to a sign crossing, then halvings, as the reference's) and holds the engine's first
// hit to it. Eyes are placed
// round each kind of thing by a fixed seed (`eye_round`), near and far, inside its bound and out,
// looking at points in it so that some views graze; the judged views look where an author's camera
// would, and this looks everywhere else.
//
// Counted, of each picture's pixels:
// - a HOLE: the field meets matter along the middle ray and along four rays a half pixel to each
//   side (so the pixel is wholly inside an outline), and the engine met nothing;
// - an EXTRA: the engine met matter where the field and the four rays beside it meet none;
// - OFF: both met it, the surface is not grazing (its facing at least a fifth toward the eye), and
//   where they met it differs by more than the pixel's footprint there.
//
// What it does not cover: light, colour, edges and crawl (the judges'); a hole thinner than half a
// pixel (outlines are the judges'); a surface the field's own march misses (it steps by the
// field's stated steepness, as the reference does), or that it reaches only past `STEPS` steps
// (such a ray is not counted); and only the middle ray of each pixel.

use matter::matter::{Matter, matter}
use matter::sky::Sky
use matter::substance::Substance
use mesh::draw::{MeshSight, MeshWorld, mesh_sight}
use picture::eye::{Eye, View, view}
use picture::look::Look
use picture::screen::show
use reference::traced::{FAR, HALVINGS, LEAST, LEAST_FAR}
use std::field::{Field, Union, UnionAll}
use std::gpu::{
    Atomics, GlobalId, GpuBuffer, Rgba32Float, Texture, buffer_of, copy_texture, dispatch, label,
    read, texture,
}
use std::collections::Vec
use std::io::{Pending, print}

/// Counts kept: pixels, pixels the field met, holes, extras, offs, rays out of steps; then whether
/// an off pixel has been named (claimed once, so the three words after it are of one pixel), and
/// that pixel's x and y, and its picture's eye (`Audit::held`'s `eye`).
/// After them, each of the first `EYES_SAID` eyes' holes, then the first hole's `(claimed, x, y,
/// eye, the field's distance there)` and the first extra's `(claimed, x, y, eye)`.
const FIRST_HOLE: u32 = 10 + EYES_SAID
const FIRST_EXTRA: u32 = FIRST_HOLE + 5
/// Then the holes by how far inside the field's own outline they lie (`DEPTHS`: a pixel, two,
/// three or four, deeper: a crack), and the extras by how far outside it.
const HOLE_DEPTHS: u32 = FIRST_EXTRA + 4
const EXTRA_DEPTHS: u32 = HOLE_DEPTHS + 4
const COUNTS: u32 = EXTRA_DEPTHS + 4

/// The farthest, in pixels (a square ring), the audit looks from a hole for a pixel the field
/// misses, or from an extra for one it meets: past this, a hole is a crack.
const DEPTH_MOST: u32 = 4

/// The eyes whose holes the audit says one by one (eyes past these are in the totals alone).
const EYES_SAID: u32 = 64

/// The most steps the audit's march takes (a dispatch's every invocation must be short); its least
/// step and its halvings onto the surface are the reference's (`traced`).
const STEPS: u32 = 512

/// Pixels a dispatch (a band of the picture: no dispatch holds the GPU long).
const BAND: u32 = 256

/// The rays of an eye's march a frame marches (`Auditing::frame`): an eye's march is spread over
/// frames, so no frame holds the GPU long however steep (and so slow to march) its field is.
const MARCH_FRAME: u32 = 256 * BAND

/// Where the field `m` meets matter along the ray from `o` along `d`: its distance along it, -1
/// where it doesn't, -2 where the march ran out of steps.
fn first_hit<M: Field<Substance>>(m: Matter<M>, o: vec3, d: vec3) -> f32 {
    var t = 0.0
    var before = 0.0
    var crossed = false
    for _ in 0..STEPS {
        if !crossed && t < FAR {
            let f = m.far(o + d * t)
            if f < 0.0 {
                crossed = true
            } else {
                before = t
                t += max(f, LEAST + LEAST_FAR * t)
            }
        }
    }
    var lo = before
    var hi = t
    for _ in 0..HALVINGS {
        if crossed {
            let mid = 0.5 * (lo + hi)
            if m.inside(o + d * mid) {
                hi = mid
            } else {
                lo = mid
            }
        }
    }
    if crossed { hi } else if t < FAR { -2.0 } else { -1.0 }
}

/// The ray of pixel `i / 5` of a picture `w` wide through `v`: its middle (`i % 5` 0) or a half
/// pixel to a side (1 to 4).
fn ray_at(v: View, w: u32, i: u32) -> vec3 {
    let px = i / 5
    let k = i % 5
    let o = vec2(if k == 1 { 0.5 } else if k == 2 { -0.5 } else { 0.0 }, if k == 3 {
        0.5
    } else if k == 4 { -0.5 } else { 0.0 })
    v.ray(vec2(f32(px % w) + 0.5, f32(px / w) + 0.5) + o)
}

/// Of two first hits along one ray (`first_hit`'s), the union's: the nearer where either met
/// matter, else out of steps where either march ran out, else none.
fn nearer(a: f32, b: f32) -> f32 {
    if a > 0.0 && b > 0.0 {
        min(a, b)
    } else if a > 0.0 {
        a
    } else if b > 0.0 {
        b
    } else if a < -1.5 || b < -1.5 {
        -2.0
    } else {
        -1.0
    }
}

/// Rays `first` on (`ray_at`) marched through the field `m`: into `hits`, or (`keep`) into
/// `hits` joined with what it holds (`nearer`: `m` one part of a union).
@compute(64)
fn marched<M: Field<Substance>>(
    m: Matter<M>,
    v: View,
    w: u32,
    n: u32,
    first: u32,
    keep: bool,
    hits: mut Atomics<u32>,
    id: GlobalId,
) {
    let i = first + id.x
    if i >= n {
        return
    }
    let t = first_hit(m, v.at, ray_at(v, w, i))
    let joined = if keep { nearer(bitcast_f32(hits.load(i: i)), t) } else { t }
    hits.store(i: i, value: bitcast_u32(joined))
}

/// What the audit holds a picture to: a thing's field, marched whole, or a union marched a part at
/// a time (a union's first hit is its parts' nearest, so no dispatch asks every part at every step:
/// a crowd's union of bodies, marched whole, is more than a dispatch may hold the GPU for).
pub trait Marched: Copy {
    /// The thing as one field, on the CPU: where the audit's eyes are placed round it.
    type Field: Field<Substance>
    fn field(self) -> Self::Field

    /// Rays `first` to `last` of the `n` of a picture `w` wide through `v` (`ray_at`) marched
    /// into `hits`: joined with what it holds (`keep`), or replacing it.
    fn march(
        self,
        v: View,
        w: u32,
        n: u32,
        first: u32,
        last: u32,
        keep: bool,
        hits: mut GpuBuffer<u32>,
    )
}

/// A field marched whole (`whole`).
pub struct Whole<M>: Copy {
    field: M,
}

/// `field`, marched whole.
pub fn whole<M: Field<Substance>>(field: M) -> Whole<M> {
    Whole { field }
}

impl<M: Field<Substance>> Marched for Whole<M> {
    type Field = M

    fn field(self) -> M {
        self.field
    }

    fn march(
        self,
        v: View,
        w: u32,
        n: u32,
        first: u32,
        last: u32,
        keep: bool,
        hits: mut GpuBuffer<u32>,
    ) {
        let m = matter(self.field)
        let end = min(last, n)
        var at = first
        while at < end {
            dispatch(
                marched.bind(m: m, v: v, w: w, n: n, first: at, keep: keep, hits: mut hits),
                over: min(BAND, end - at),
            )
            at += BAND
        }
    }
}

/// The union of a fixed array of fields, marched a part at a time (`each`).
pub struct Each<M, const N: u32>: Copy {
    parts: [M; N],
}

/// `parts`' union, marched a part at a time.
pub fn each<M: Field<Substance>, const N: u32>(parts: [M; N]) -> Each<M, N> {
    Each { parts }
}

impl<M: Field<Substance>, const N: u32> Marched for Each<M, N> {
    type Field = UnionAll<M, N>

    fn field(self) -> UnionAll<M, N> {
        self.parts.union()
    }

    fn march(
        self,
        v: View,
        w: u32,
        n: u32,
        first: u32,
        last: u32,
        keep: bool,
        hits: mut GpuBuffer<u32>,
    ) {
        for i in 0..N {
            whole(self.parts[i]).march(v, w, n, first, last, keep: keep || i > 0, hits: mut hits)
        }
    }
}

/// The union of two marched things, each marched as itself (`both`).
pub struct Both<A, B>: Copy {
    a: A,
    b: B,
}

/// `a` and `b`'s union, each marched as itself.
pub fn both<A: Marched, B: Marched>(a: A, b: B) -> Both<A, B> {
    Both { a, b }
}

impl<A: Marched, B: Marched> Marched for Both<A, B> {
    type Field = Union<A::Field, B::Field>

    fn field(self) -> Union<A::Field, B::Field> {
        Union { a: self.a.field(), b: self.b.field() }
    }

    fn march(
        self,
        v: View,
        w: u32,
        n: u32,
        first: u32,
        last: u32,
        keep: bool,
        hits: mut GpuBuffer<u32>,
    ) {
        self.a.march(v, w, n, first, last, keep: keep, hits: mut hits)
        self.b.march(v, w, n, first, last, keep: true, hits: mut hits)
    }
}

/// How many pixels (square rings) from pixel `i` of a picture `w` × `h` the nearest pixel is whose
/// middle ray (`hits`) the field meets (`met`) or misses (`!met`): 1 to `DEPTH_MOST`, or
/// `DEPTH_MOST + 1` where none is that near.
fn depth_to(hits: [u32], w: u32, h: u32, i: u32, met: bool) -> u32 {
    let x = i32(i % w)
    let y = i32(i / w)
    var best = DEPTH_MOST + 1
    for dy in -4..5 {
        for dx in -4..5 {
            let r = u32(max(abs(dx), abs(dy)))
            let px = x + dx
            let py = y + dy
            if r > 0 && px >= 0 && py >= 0 && px < i32(w) && py < i32(h) {
                let t = bitcast_f32(hits[5 * (u32(py) * w + u32(px))])
                if (met && t > 0.0) || (!met && t == -1.0) {
                    best = min(best, r)
                }
            }
        }
    }
    best
}

/// The slot of depth `d` (`depth_to`) among four: 1, 2, 3 or 4, deeper.
fn depth_slot(d: u32) -> u32 {
    if d <= 1 { 0 } else if d == 2 { 1 } else if d <= DEPTH_MOST { 2 } else { 3 }
}

/// Pixels `first` on of `place` (the engine's: facing and distance, 0 where nothing) held to the
/// field's hits (`hits`, `marched`): into `counts`.
@compute(64)
fn audited(
    v: View,
    place: Texture<Rgba32Float>,
    hits: [u32],
    first: u32,
    eye: u32,
    counts: mut Atomics<u32>,
    id: GlobalId,
) {
    let w = place.width()
    let i = first + id.x
    if i >= w * place.height() {
        return
    }
    let e = place.load(i % w, i / w)
    let tf = bitcast_f32(hits[5 * i])
    var out_of_steps = tf < -1.5
    var all = tf > 0.0
    var none = tf == -1.0
    for k in 1..5 {
        let h = bitcast_f32(hits[5 * i + k])
        all = all && h > 0.0
        none = none && h == -1.0
        out_of_steps = out_of_steps || h < -1.5
    }
    let _ = counts.add(i: 0, value: 1)
    let met = e.w > 0.0
    if out_of_steps {
        let _ = counts.add(i: 5, value: 1)
    } else {
        if tf > 0.0 {
            let _ = counts.add(i: 1, value: 1)
        }
        if all && !met {
            let _ = counts.add(i: 2, value: 1)
            if eye < EYES_SAID {
                let _ = counts.add(i: 10 + eye, value: 1)
            }
            let _ = counts.add(
                i: HOLE_DEPTHS + depth_slot(depth_to(hits, w, place.height(), i, met: false)),
                value: 1,
            )
            if counts.exchange(i: FIRST_HOLE, value: 1) == 0 {
                counts.store(i: FIRST_HOLE + 1, value: i % w)
                counts.store(i: FIRST_HOLE + 2, value: i / w)
                counts.store(i: FIRST_HOLE + 3, value: eye)
                counts.store(i: FIRST_HOLE + 4, value: bitcast_u32(tf))
            }
        } else if none && met {
            let _ = counts.add(i: 3, value: 1)
            let _ = counts.add(
                i: EXTRA_DEPTHS + depth_slot(depth_to(hits, w, place.height(), i, met: true)),
                value: 1,
            )
            if counts.exchange(i: FIRST_EXTRA, value: 1) == 0 {
                counts.store(i: FIRST_EXTRA + 1, value: i % w)
                counts.store(i: FIRST_EXTRA + 2, value: i / w)
                counts.store(i: FIRST_EXTRA + 3, value: eye)
            }
        } else if tf > 0.0 && met {
            let d = ray_at(v, w, 5 * i)
            if abs(dot(e.xyz, d)) > 0.2 && abs(e.w - tf) > v.pixel() * tf {
                let _ = counts.add(i: 4, value: 1)
                if counts.exchange(i: 6, value: 1) == 0 {
                    counts.store(i: 7, value: i % w)
                    counts.store(i: 8, value: i / w)
                    counts.store(i: 9, value: eye)
                }
            }
        }
    }
}

/// How far along the ray from `o` along `d` (unit) a march from outside comes onto the surface of
/// `m` (within 0.00005 m), or stops at `most` m: at most 4096 steps, on the CPU. (Where a step is
/// not taken, the march stands still: every later step would ask the same point again.)
fn onto<M: Field<Substance>>(m: Matter<M>, o: vec3, d: vec3, most: f32) -> f32 {
    var t = 0.0
    for _ in 0..4096 {
        let g = m.far(o + d * t)
        if !(g > 0.00005 && t < most) {
            break
        }
        t += max(g, 0.0001)
    }
    t
}

/// A point on the surface of `field` (`m` its matter) seen from `o` along `d` (unit): where a march
/// from `o` comes onto it (`onto`, within `most` m), or, where the march passes it by (a sparse
/// thing, a crowd, whose bound's middle is air), the point it passed nearest, carried onto the
/// surface down the field's gradient: so every eye looks at matter, and no audited picture is of
/// nothing.
fn on_it<M: Field<Substance>>(field: M, m: Matter<M>, o: vec3, d: vec3, most: f32) -> vec3 {
    let t = onto(m, o, d, most)
    if t < most {
        return o + d * t
    }
    var nearest = o
    var least = 1.0e30
    for k in 0..256 {
        let p = o + d * (most * (f32(k) + 0.5) / 256.0)
        let g = field.distance(p)
        if g < least {
            least = g
            nearest = p
        }
    }
    var p = nearest
    for _ in 0..64 {
        let (g, n) = field.sample(p)
        let len = length(n)
        if abs(g) < 0.00005 || len < 1.0e-6 {
            break
        }
        p = p - n * (g / (len * len))
    }
    p
}

/// The `k`th eye of a fixed seed round the thing `field` within the bound `b` (centre, radius);
/// the first, straight on at its middle, close, through a long lens; the rest:
/// a point on its surface found from outside along a way to its middle, the eye stepped back from
/// it 0.005 to 1 bound radii (on a log scale), looking straight at it (even `k`) or past it along
/// the surface (odd `k`: grazing), 0.6 rad across.
pub fn eye_round<M: Field<Substance>>(field: M, b: vec4, k: u32) -> Eye {
    let m = matter(field)
    if k == 0 {
        // The view the judged set once missed: straight on at its bound's middle, from the side,
        // close (a tenth of its bound's radius off its surface), through a long lens (0.2 rad).
        let o0 = b.xyz - vec3(0.0, 0.0, 1.5 * b.w)
        let s0 = on_it(field, m, o0, vec3(0.0, 0.0, 1.0), 3.0 * b.w)
        let d0 = normalize(s0 - o0)
        let at0 = s0 - d0 * (0.1 * b.w)
        return Eye { at: at0, toward: s0, wide: 0.2 }
    }
    let f = f32(k / 2) + 0.5
    let u = normalize(
        vec3(fract(f * 0.618034), fract(f * 0.754878), fract(f * 0.569840)) * 2.0 -
            vec3(1.0) +
            vec3(1.0e-3),
    )
    let o = b.xyz + u * (1.5 * b.w)
    let d = normalize(
        b.xyz +
            (vec3(fract(f * 0.381966), fract(f * 0.245122), fract(f * 0.430160)) * 2.0 -
                vec3(1.0)) *
                (0.3 * b.w) -
            o,
    )
    let s = on_it(field, m, o, d, 3.0 * b.w)
    let d = normalize(s - o)
    let back = b.w * exp2(log2(0.005) * (1.0 - fract(f * 0.287148)))
    let at = s - d * back
    var toward = s
    if k % 2 == 1 {
        // (Past the point along the surface, the way the eye came turned a quarter round.)
        let side = normalize(cross(d, vec3(0.0, 1.0, 0.0)) + vec3(1.0e-3))
        toward = s + side * back
    }
    Eye { at, toward, wide: 0.6 }
}

/// What the audit has counted, and what it has been asked to say.
pub struct Audit {
    counts: GpuBuffer<u32>,
    said: Option<Pending<u32>>,
}

/// An audit, as yet of nothing.
pub fn audit() -> Audit {
    Audit {
        counts: buffer_of(Vec::filled(COUNTS, 0)),
        said: None,
    }
}

impl Audit {
    /// The engine's picture `place` (`width` × `height`), drawn through `eye`, held to the field's
    /// march through it (`hits`, `Marched::march`).
    pub fn held(
        mut self,
        hits: GpuBuffer<u32>,
        eye: Eye,
        place: Texture<Rgba32Float>,
        width: u32,
        height: u32,
        k: u32,
    ) {
        let v = view(eye, width, height)
        label("audit")
        var first: u32 = 0
        while first < width * height {
            dispatch(
                audited.bind(
                    v: v,
                    place: place,
                    hits: hits.items(),
                    first: first,
                    eye: k,
                    counts: mut self.counts,
                ),
                over: min(4096, width * height - first),
            )
            first += 4096
        }
    }

    /// Asks for the counts, and once they are in says them (`what`) and starts again at nothing:
    /// true then.
    pub fn say(mut self, what: String) -> bool {
        match mut self.said {
            Some(p) => match p.poll() {
                Some(Ok(c)) => {
                    print(
                        f"audit: {what}: {c[0]} px, the field meets matter at {c[1]}; holes {c[2]}, extra {c[3]}, off by more than a pixel {c[4]} (one: eye {c[9]}, pixel ({c[7]}, {c[8]})); pixels not counted (the march out of steps) {c[5]}",
                    )
                    var each = String::new()
                    for k in 0..EYES_SAID {
                        if c[10 + k] > 0 {
                            each = f"{each} {k}:{c[10 + k]}"
                        }
                    }
                    if each.len() > 0 {
                        print(f"audit: {what}: holes by eye (eye:holes):{each}")
                    }
                    if c[2] + c[3] > 0 {
                        print(
                            f"audit: {what}: holes by how far inside the field's outline (px 1, 2, 3-4, deeper): {c[HOLE_DEPTHS]}, {c[HOLE_DEPTHS + 1]}, {c[HOLE_DEPTHS + 2]}, {c[HOLE_DEPTHS + 3]}; extras by how far outside it: {c[EXTRA_DEPTHS]}, {c[EXTRA_DEPTHS + 1]}, {c[EXTRA_DEPTHS + 2]}, {c[EXTRA_DEPTHS + 3]}",
                        )
                    }
                    if c[FIRST_HOLE] != 0 {
                        print(
                            f"audit: {what}: first hole: eye {c[FIRST_HOLE + 3]}, pixel ({c[FIRST_HOLE + 1]}, {c[FIRST_HOLE + 2]}), the field met {bitcast_f32(c[FIRST_HOLE + 4])} m out",
                        )
                    }
                    if c[FIRST_EXTRA] != 0 {
                        print(
                            f"audit: {what}: first extra: eye {c[FIRST_EXTRA + 3]}, pixel ({c[FIRST_EXTRA + 1]}, {c[FIRST_EXTRA + 2]})",
                        )
                    }
                    self.said = None
                    self.counts = buffer_of(Vec::filled(COUNTS, 0))
                    return true
                },
                // (Not read: asked again; the counts are kept until they are said.)
                Some(Err(_)) => {
                    self.said = None
                },
                None => {},
            },
            None => {
                self.said = Some(read(self.counts.items()))
            },
        }
        false
    }
}

/// The most frames an eye is drawn for while the engine's meshes for it settle
/// (`MeshSight::settled`) before it is held to the field as it stands.
pub const SETTLE_MOST: u32 = 12

/// The audit as a scene runs it: things one after another, each from `eyes` eyes round it
/// (`eye_round`), each eye drawn until the engine's meshes for it are settled (at most
/// `SETTLE_MOST` frames) and its field's march through it is in (a slice a frame), and then held to
/// the field, as is its first frame's picture; each thing said once its eyes are in, and the next
/// begun. A new eye is a camera cut: the frames it takes to settle are the engine's lag after one,
/// and are said with the holes.
pub struct Auditing {
    audit: Audit,
    /// The same eyes held to the field at the frame of the cut to them (their first), and
    /// whether its counts have been said for the thing being audited.
    cut: Audit,
    cut_said: bool,
    /// The eye's march (`Marched::march`), its first `marched` rays of `5 · width · height` in, a
    /// slice a frame (`MARCH_FRAME`); the picture of the frame of the cut, kept till it is.
    hits: GpuBuffer<u32>,
    marched: u32,
    cut_place: Texture<Rgba32Float>,
    /// The frames the eye took to settle, once it has (0 till then).
    settle_drawn: u32,
    /// The thing being audited (its place in the scene's list), and its next eye.
    thing: u32,
    eye_k: u32,
    /// Frames the eye being audited has been drawn for, and over this thing's eyes: the most an
    /// eye took to settle, the frames summed, the eyes held unsettled (at `SETTLE_MOST`), and any
    /// eyes whose settled mesh still reported a non-zero `OVERFLOW_*` bitflag.
    drawn: u32,
    most: u32,
    summed: u32,
    unsettled: u32,
    overflows: u32,
    /// The `OVERFLOW_*` bits those eyes' meshes raised, together.
    overflow_bits: u32,
    /// The one eye of each thing audited (`only_eye`), or every eye (`eyes` or more).
    only: u32,
    /// Eyes in pairs (`pair_eyes`): eye `2j + 1` is eye `2j`'s place again, so what changed
    /// between them (an edit, a pose) is met by the mesh as it was, not by a mesh begun afresh.
    paired: bool,
    /// A stroll (`stroll`): eye `k` is eye 1's place moved `k` times this far, so each eye is the
    /// mesh of the eye before it, moved a little.
    stroll_step: vec3,
}

/// An audit run, at its first thing.
pub fn auditing() -> Auditing {
    Auditing {
        audit: audit(),
        cut: audit(),
        cut_said: false,
        hits: buffer_of(Vec::filled(1, 0)),
        marched: 0,
        cut_place: texture(width: 1, height: 1),
        settle_drawn: 0,
        thing: 0,
        eye_k: 0,
        drawn: 0,
        most: 0,
        summed: 0,
        unsettled: 0,
        overflows: 0,
        overflow_bits: 0,
        only: 4294967295,
        paired: false,
        stroll_step: vec3(0.0),
    }
}

impl Auditing {
    /// The thing being audited (its place in the scene's list; past its end, all are said).
    pub fn thing(self) -> u32 {
        self.thing
    }

    /// Audits only eye `k` of each thing (its picture is the last drawn): to look at one eye's
    /// holes (`tools/audit --eye`).
    pub fn only_eye(mut self, k: u32) {
        self.only = k
    }

    /// Eyes in pairs: each odd eye stands where the even eye before it stood (`paired`).
    pub fn pair_eyes(mut self) {
        self.paired = true
    }

    /// Eyes on a stroll: eye `k` is eye 1 moved by `k · step` (`stroll_step`).
    pub fn stroll(mut self, step: vec3) {
        self.stroll_step = step
    }

    /// The eye of the thing being audited (a moving thing is held still while an eye settles:
    /// its time is best taken from this, not from the frame).
    pub fn eye(self) -> u32 {
        self.eye_k
    }

    /// A frame of the audit of `thing` (named `what`, drawn as `world`, within the bound `b`:
    /// centre, radius): its next of `eyes` eyes drawn by `mesh` and held to it; or, its eyes all
    /// in, its counts said once they are back, and the next thing begun (`mesh` begun again).
    pub fn frame<W: MeshWorld, T: Marched, S: Sky, L: Look>(
        mut self,
        mesh: mut MeshSight,
        world: W,
        thing: T,
        b: vec4,
        what: str,
        eyes: u32,
        sky: S,
        look: L,
        width: u32,
        height: u32,
    ) {
        if self.only < eyes && self.eye_k < self.only {
            self.eye_k = self.only
        }
        if self.eye_k >= eyes || (self.only < eyes && self.eye_k > self.only) {
            if !self.cut_said {
                self.cut_said = self.cut.say(f"{what}, the frame of the cut to each of {eyes} eyes")
                return
            }
            if self.audit.say(f"{what}, {eyes} eyes, settled") {
                self.cut_said = false
                print(
                    f"audit: {what}: frames to settle after a cut: most {self.most}, mean {f32(self.summed) / f32(max(eyes, 1))}; eyes held unsettled {self.unsettled}; overflows {self.overflows} (bits {self.overflow_bits})",
                )
                self.thing += 1
                self.eye_k = 0
                self.most = 0
                self.summed = 0
                self.unsettled = 0
                self.overflows = 0
                self.overflow_bits = 0
                self.paired = false
                self.stroll_step = vec3(0.0)
                mesh = mesh_sight(gi: false)
            }
            return
        }
        let field = thing.field()
        let seed = if self.paired { self.eye_k - (self.eye_k % 2) } else { self.eye_k }
        let strolling = dot(self.stroll_step, self.stroll_step) > 0.0
        let placed = eye_round(field, b, if strolling { 1 } else { seed })
        let moved = self.stroll_step * f32(self.eye_k)
        let eye = if strolling {
            Eye { at: placed.at + moved, toward: placed.toward + moved, wide: placed.wide }
        } else {
            out_of(field, placed)
        }
        let n = 5 * width * height
        if self.hits.len() != n {
            self.hits = buffer_of(Vec::filled(n, 0))
        }
        if self.cut_place.width() != width || self.cut_place.height() != height {
            self.cut_place = texture(width: width, height: height)
            return
        }
        mesh.drawn_only(world, sky, look, eye, width, height)
        self.drawn += 1
        show(mesh.drawn.colour)
        if self.drawn == 1 {
            copy_texture(from: mesh.drawn.place.level(0), to: self.cut_place.level_mut(0))
            self.marched = 0
        }
        if self.marched < n {
            label("audit")
            let last = min(self.marched + MARCH_FRAME, n)
            thing.march(
                view(eye, width, height),
                width,
                n,
                self.marched,
                last,
                keep: false,
                hits: mut self.hits,
            )
            self.marched = last
        }
        if self.settle_drawn == 0 {
            let settled = mesh.settled()
            if settled || self.drawn >= SETTLE_MOST {
                self.settle_drawn = self.drawn
                if !settled {
                    self.unsettled += 1
                }
                if mesh.overflowed() != 0 {
                    self.overflows += 1
                    self.overflow_bits |= mesh.overflowed()
                }
            }
        }
        if self.settle_drawn == 0 || self.marched < n {
            return
        }
        self.cut.held(self.hits, eye, self.cut_place, width, height, self.eye_k)
        self.audit.held(self.hits, eye, mesh.drawn.place, width, height, self.eye_k)
        self.most = max(self.most, self.settle_drawn)
        self.summed += self.settle_drawn
        self.drawn = 0
        self.settle_drawn = 0
        self.eye_k += 1
    }
}

/// `eye`, moved out of `field`'s matter along its way from the middle of the view where it is in it.
fn out_of<M: Field<Substance>>(field: M, eye: Eye) -> Eye {
    var e = eye
    var k: u32 = 0
    while k < 64 && field.distance(e.at) <= 0.05 {
        e.at = e.at + normalize(e.at - e.toward) * 0.5
        k += 1
    }
    e
}
