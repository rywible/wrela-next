// The hole audit: an instrument beside the judges, quick enough to run at every change. It needs
// no reference picture: at each pixel of a small picture the engine drew, it marches the pixel's
// middle ray through the thing's own field (`marched`: a plain march by its value over its stated
// steepness to a sign crossing, then halvings, as the reference's) and holds the engine's first
// hit to it. Eyes are placed
// round each kind of thing by a fixed seed (`eye_round`), near and far, inside its bound and out,
// looking at points in it so that some views graze; the judged views look where an author's camera
// would, and this looks everywhere else.
//
// Counted, of each picture's pixels:
// - a HOLE: the field meets matter along the middle ray and along four rays a half pixel to each
//   side (so the pixel is wholly inside an outline), and the engine met nothing;
// - an EXTRA: the engine met matter where the field and the four rays beside it meet none;
// - OFF: both met it, the surface is not grazing (its facing at least a fifth toward the eye), and
//   where they met it differs by more than the pixel's footprint there.
//
// What it does not cover: light, colour, edges and crawl (the judges'); a hole thinner than half a
// pixel (outlines are the judges'); a surface the field's own march misses (it steps by the
// field's stated steepness, as the reference does), or that it reaches only past `STEPS` steps
// (such a ray is not counted); and only the middle ray of each pixel.

use matter::matter::{Matter, matter}
use matter::sky::Sky
use matter::substance::Substance
use matter::world::World
use mesh::draw::{MeshSight, MeshWorld, mesh_sight}
use picture::eye::{Eye, View, view}
use picture::look::Look
use picture::screen::show
use reference::traced::{FAR, HALVINGS, LEAST, LEAST_FAR}
use std::field::Field
use std::gpu::{Atomics, GlobalId, GpuBuffer, Rgba32Float, Texture, buffer_of, dispatch, label, read}
use std::collections::Vec
use std::io::{Pending, print}

/// Counts kept: pixels, pixels the field met, holes, extras, offs, rays out of steps; then whether
/// an off pixel has been named (claimed once, so the three words after it are of one pixel), and
/// that pixel's x and y, and its picture's eye (`Audit::held`'s `eye`).
/// After them, each of the first `EYES_SAID` eyes' holes.
const COUNTS: u32 = 10 + EYES_SAID

/// The eyes whose holes the audit says one by one (eyes past these are in the totals alone).
const EYES_SAID: u32 = 64

/// The most steps the audit's march takes (a dispatch's every invocation must be short); its least
/// step and its halvings onto the surface are the reference's (`traced`).
const STEPS: u32 = 512

/// Pixels a dispatch (a band of the picture: no dispatch holds the GPU long).
const BAND: u32 = 256

/// Where the field `m` meets matter along the ray from `o` along `d`: its distance along it, -1
/// where it doesn't, -2 where the march ran out of steps.
fn first_hit<M: Field<Substance>>(m: Matter<M>, o: vec3, d: vec3) -> f32 {
    var t = 0.0
    var before = 0.0
    var crossed = false
    for _ in 0..STEPS {
        if !crossed && t < FAR {
            let f = m.far(o + d * t)
            if f < 0.0 {
                crossed = true
            } else {
                before = t
                t += max(f, LEAST + LEAST_FAR * t)
            }
        }
    }
    var lo = before
    var hi = t
    for _ in 0..HALVINGS {
        if crossed {
            let mid = 0.5 * (lo + hi)
            if m.inside(o + d * mid) {
                hi = mid
            } else {
                lo = mid
            }
        }
    }
    if crossed { hi } else if t < FAR { -2.0 } else { -1.0 }
}

/// The ray of pixel `i / 5` of a picture `w` wide through `v`: its middle (`i % 5` 0) or a half
/// pixel to a side (1 to 4).
fn ray_at(v: View, w: u32, i: u32) -> vec3 {
    let px = i / 5
    let k = i % 5
    let o = vec2(if k == 1 { 0.5 } else if k == 2 { -0.5 } else { 0.0 }, if k == 3 {
        0.5
    } else if k == 4 { -0.5 } else { 0.0 })
    v.ray(vec2(f32(px % w) + 0.5, f32(px / w) + 0.5) + o)
}

/// Rays `first` on (`ray_at`) marched through the field `m`: into `hits`.
@compute(64)
fn marched<M: Field<Substance>>(
    m: Matter<M>,
    v: View,
    w: u32,
    n: u32,
    first: u32,
    hits: mut Atomics<u32>,
    id: GlobalId,
) {
    let i = first + id.x
    if i >= n {
        return
    }
    hits.store(i: i, value: bitcast_u32(first_hit(m, v.at, ray_at(v, w, i))))
}

/// Pixels `first` on of `place` (the engine's: facing and distance, 0 where nothing) held to the
/// field's hits (`hits`, `marched`): into `counts`.
@compute(64)
fn audited(
    v: View,
    place: Texture<Rgba32Float>,
    hits: [u32],
    first: u32,
    eye: u32,
    counts: mut Atomics<u32>,
    id: GlobalId,
) {
    let w = place.width()
    let i = first + id.x
    if i >= w * place.height() {
        return
    }
    let e = place.load(i % w, i / w)
    let tf = bitcast_f32(hits[5 * i])
    var out_of_steps = tf < -1.5
    var all = tf > 0.0
    var none = tf == -1.0
    for k in 1..5 {
        let h = bitcast_f32(hits[5 * i + k])
        all = all && h > 0.0
        none = none && h == -1.0
        out_of_steps = out_of_steps || h < -1.5
    }
    let _ = counts.add(i: 0, value: 1)
    let met = e.w > 0.0
    if out_of_steps {
        let _ = counts.add(i: 5, value: 1)
    } else {
        if tf > 0.0 {
            let _ = counts.add(i: 1, value: 1)
        }
        if all && !met {
            let _ = counts.add(i: 2, value: 1)
            if eye < EYES_SAID {
                let _ = counts.add(i: 10 + eye, value: 1)
            }
        } else if none && met {
            let _ = counts.add(i: 3, value: 1)
        } else if tf > 0.0 && met {
            let d = ray_at(v, w, 5 * i)
            if abs(dot(e.xyz, d)) > 0.2 && abs(e.w - tf) > v.pixel() * tf {
                let _ = counts.add(i: 4, value: 1)
                if counts.exchange(i: 6, value: 1) == 0 {
                    counts.store(i: 7, value: i % w)
                    counts.store(i: 8, value: i / w)
                    counts.store(i: 9, value: eye)
                }
            }
        }
    }
}

/// How far along the ray from `o` along `d` (unit) a march from outside comes onto the surface of
/// `m` (within 0.00005 m), or stops at `most` m: at most 4096 steps, on the CPU. (Where a step is
/// not taken, the march stands still: every later step would ask the same point again.)
fn onto<M: Field<Substance>>(m: Matter<M>, o: vec3, d: vec3, most: f32) -> f32 {
    var t = 0.0
    for _ in 0..4096 {
        let g = m.far(o + d * t)
        if !(g > 0.00005 && t < most) {
            break
        }
        t += max(g, 0.0001)
    }
    t
}

/// The `k`th eye of a fixed seed round the thing `field` within the bound `b` (centre, radius);
/// the first, straight on at its middle, close, through a long lens; the rest:
/// a point on its surface found from outside along a way to its middle, the eye stepped back from
/// it 0.005 to 1 bound radii (on a log scale), looking straight at it (even `k`) or past it along
/// the surface (odd `k`: grazing), 0.6 rad across.
pub fn eye_round<M: Field<Substance>>(field: M, b: vec4, k: u32) -> Eye {
    let m = matter(field)
    if k == 0 {
        // The view the judged set once missed: straight on at its bound's middle, from the side,
        // close (a tenth of its bound's radius off its surface), through a long lens (0.2 rad).
        let o0 = b.xyz - vec3(0.0, 0.0, 1.5 * b.w)
        let at0 = o0 + vec3(0.0, 0.0, onto(m, o0, vec3(0.0, 0.0, 1.0), 3.0 * b.w) - 0.1 * b.w)
        return Eye { at: at0, toward: at0 + vec3(0.0, 0.0, 1.0), wide: 0.2 }
    }
    let f = f32(k / 2) + 0.5
    let u = normalize(
        vec3(fract(f * 0.618034), fract(f * 0.754878), fract(f * 0.569840)) * 2.0 -
            vec3(1.0) +
            vec3(1.0e-3),
    )
    let o = b.xyz + u * (1.5 * b.w)
    let d = normalize(
        b.xyz +
            (vec3(fract(f * 0.381966), fract(f * 0.245122), fract(f * 0.430160)) * 2.0 -
                vec3(1.0)) *
                (0.3 * b.w) -
            o,
    )
    let s = o + d * onto(m, o, d, 3.0 * b.w)
    let back = b.w * exp2(log2(0.005) * (1.0 - fract(f * 0.287148)))
    let at = s - d * back
    var toward = s
    if k % 2 == 1 {
        // (Past the point along the surface, the way the eye came turned a quarter round.)
        let side = normalize(cross(d, vec3(0.0, 1.0, 0.0)) + vec3(1.0e-3))
        toward = s + side * back
    }
    Eye { at, toward, wide: 0.6 }
}

/// What the audit has counted, and what it has been asked to say.
pub struct Audit {
    counts: GpuBuffer<u32>,
    hits: GpuBuffer<u32>,
    said: Option<Pending<u32>>,
}

/// An audit, as yet of nothing.
pub fn audit() -> Audit {
    Audit {
        counts: buffer_of(Vec::filled(COUNTS, 0)),
        hits: buffer_of(Vec::filled(1, 0)),
        said: None,
    }
}

impl Audit {
    /// The engine's picture `place` (`width` × `height`), drawn through `eye`, held to `field`.
    pub fn held<M: Field<Substance>>(
        mut self,
        field: M,
        eye: Eye,
        place: Texture<Rgba32Float>,
        width: u32,
        height: u32,
        k: u32,
    ) {
        let m = matter(field)
        let v = view(eye, width, height)
        label("audit")
        let n = 5 * width * height
        if self.hits.len() != n {
            self.hits = buffer_of(Vec::filled(n, 0))
        }
        var first: u32 = 0
        while first < n {
            dispatch(
                marched.bind(m: m, v: v, w: width, n: n, first: first, hits: mut self.hits),
                over: min(BAND, n - first),
            )
            first += BAND
        }
        first = 0
        while first < width * height {
            dispatch(
                audited.bind(
                    v: v,
                    place: place,
                    hits: self.hits.items(),
                    first: first,
                    eye: k,
                    counts: mut self.counts,
                ),
                over: min(4096, width * height - first),
            )
            first += 4096
        }
    }

    /// Asks for the counts, and once they are in says them (`what`) and starts again at nothing:
    /// true then.
    pub fn say(mut self, what: String) -> bool {
        match mut self.said {
            Some(p) => match p.poll() {
                Some(Ok(c)) => {
                    print(
                        f"audit: {what}: {c[0]} px, the field meets matter at {c[1]}; holes {c[2]}, extra {c[3]}, off by more than a pixel {c[4]} (one: eye {c[9]}, pixel ({c[7]}, {c[8]})); pixels not counted (the march out of steps) {c[5]}",
                    )
                    var each = String::new()
                    for k in 0..EYES_SAID {
                        if c[10 + k] > 0 {
                            each = f"{each} {k}:{c[10 + k]}"
                        }
                    }
                    if each.len() > 0 {
                        print(f"audit: {what}: holes by eye (eye:holes):{each}")
                    }
                    self.said = None
                    self.counts = buffer_of(Vec::filled(COUNTS, 0))
                    return true
                },
                // (Not read: asked again; the counts are kept until they are said.)
                Some(Err(_)) => {
                    self.said = None
                },
                None => {},
            },
            None => {
                self.said = Some(read(self.counts.items()))
            },
        }
        false
    }
}

/// The most frames an eye is drawn for while the engine's meshes for it settle
/// (`MeshSight::settled`) before it is held to the field as it stands.
pub const SETTLE_MOST: u32 = 12

/// The audit as a scene runs it: things one after another, each from `eyes` eyes round it
/// (`eye_round`), each eye drawn until the engine's meshes for it are settled (at most
/// `SETTLE_MOST` frames) and then held to the field, each thing said once its eyes are in, and the
/// next begun. A new eye is a camera cut: the frames it takes to settle are the engine's lag after
/// one, and are said with the holes.
pub struct Auditing {
    audit: Audit,
    /// The same eyes held to the field at the frame of the cut to them (their first), and
    /// whether its counts have been said for the thing being audited.
    cut: Audit,
    cut_said: bool,
    /// The thing being audited (its place in the scene's list), and its next eye.
    thing: u32,
    eye_k: u32,
    /// Frames the eye being audited has been drawn for, and over this thing's eyes: the most an
    /// eye took to settle, the frames summed, and the eyes held unsettled (at `SETTLE_MOST`).
    drawn: u32,
    most: u32,
    summed: u32,
    unsettled: u32,
}

/// An audit run, at its first thing.
pub fn auditing() -> Auditing {
    Auditing {
        audit: audit(),
        cut: audit(),
        cut_said: false,
        thing: 0,
        eye_k: 0,
        drawn: 0,
        most: 0,
        summed: 0,
        unsettled: 0,
    }
}

impl Auditing {
    /// The thing being audited (its place in the scene's list; past its end, all are said).
    pub fn thing(self) -> u32 {
        self.thing
    }

    /// The eye of the thing being audited (a moving thing is held still while an eye settles:
    /// its time is best taken from this, not from the frame).
    pub fn eye(self) -> u32 {
        self.eye_k
    }

    /// A frame of the audit of the thing `field` (named `what`, drawn as `world`, within the bound
    /// `b`: centre, radius): its next of `eyes` eyes drawn by `mesh` and held to it; or, its eyes
    /// all in, its counts said once they are back, and the next thing begun (`mesh` begun again).
    pub fn frame<W: World + MeshWorld, M: Field<Substance>, S: Sky, L: Look>(
        mut self,
        mesh: mut MeshSight,
        world: W,
        field: M,
        b: vec4,
        what: str,
        eyes: u32,
        sky: S,
        look: L,
        width: u32,
        height: u32,
    ) {
        if self.eye_k >= eyes {
            if !self.cut_said {
                self.cut_said = self.cut.say(f"{what}, the frame of the cut to each of {eyes} eyes")
                return
            }
            if self.audit.say(f"{what}, {eyes} eyes, settled") {
                self.cut_said = false
                print(
                    f"audit: {what}: frames to settle after a cut: most {self.most}, mean {f32(self.summed) / f32(max(eyes, 1))}; eyes held unsettled {self.unsettled}",
                )
                self.thing += 1
                self.eye_k = 0
                self.most = 0
                self.summed = 0
                self.unsettled = 0
                mesh = mesh_sight(gi: false)
            }
            return
        }
        let eye = out_of(field, eye_round(field, b, self.eye_k))
        mesh.drawn_only(world, sky, look, eye, width, height)
        self.drawn += 1
        show(mesh.drawn.colour)
        if self.drawn == 1 {
            self.cut.held(field, eye, mesh.drawn.place, width, height, self.eye_k)
        }
        let settled = mesh.settled()
        if !settled && self.drawn < SETTLE_MOST {
            return
        }
        if !settled {
            self.unsettled += 1
        }
        self.most = max(self.most, self.drawn)
        self.summed += self.drawn
        self.drawn = 0
        self.audit.held(field, eye, mesh.drawn.place, width, height, self.eye_k)
        self.eye_k += 1
    }
}

/// `eye`, moved out of `field`'s matter along its way from the middle of the view where it is in it.
fn out_of<M: Field<Substance>>(field: M, eye: Eye) -> Eye {
    var e = eye
    var k: u32 = 0
    while k < 64 && field.distance(e.at) <= 0.05 {
        e.at = e.at + normalize(e.at - e.toward) * 0.5
        k += 1
    }
    e
}
