// The judges: a picture held to the reference (`reference`)
// in numbers, in place of looking. Carried from branch `backend`'s lib/frame/judge.wrela
// (`compare`, `judge_pictures`) and the volume spike's `light_judged` and `missed_at`
// (spike/volume, spikes/volume/volume.wrela), with one change the spike asked for: a judge needs
// only what any picture can give, its colour. Where it drew matter and where it drew none is read
// from that colour, so a picture drawn in one pass with no depth has its holes counted too.
//
// Coverage from colour. The reference says, at each pixel, the mean colour of its looks that met
// matter (M), what the sky behind looks like along the pixel's middle ray (S), and the share of
// its looks that met matter (its coverage). A pixel that shows matter over a share c of itself
// and the sky over the rest shows c M + (1 - c) S (the looks' colours are linear and averaged), so
// a picture's coverage at the pixel is the share of the way from S to M its colour lies. Where M
// and S are too alike to tell apart (`UNDECIDED`), the pixel is counted as such and not judged for
// coverage. Where the reference meets no matter, a picture whose colour is off the sky's there
// drew something where nothing is.
//
// Every number is of the screen's values (the colours encoded as the screen shows them, in
// 255ths), as the eye sees a difference:
//
// - outline: pixels where the picture and the reference disagree on whether matter covers most of
//   the pixel (missed, extra), over the length of the reference's outline (px: how far off the
//   outline is, as the old judge counted it); and the coverage itself, |c - c_ref| summed near the
//   outline over its length (px, finer: a picture whose edges are smooth but a fifth of a pixel
//   out shows here and not in the first);
// - holes: missed pixels whose eight neighbours the reference covers too;
// - surfaces apart (only for a picture that says where it put each surface, `Picture::placed`):
//   how far the picture's surface is from the reference's along the middle ray, across the view
//   in pixels;
// - lit: pixels over 8/255 from the reference's mean, over all pixels and over pixels matter
//   covers wholly (where only the light can be wrong);
// - edge pixels (the reference covers them in part, or covers them wholly with matter at
//   different distances: an inner edge, a creature before the ground): their error against the
//   many-look mean;
// - crawl: pixels whose brightness steps over 15/255 from one moment to the next, the picture's
//   and the reference's, on edge pixels and on all (the reference crawls a little itself);
// - not a number: pixels whose colour is a NaN, said apart and counted as over 8/255 and as
//   stepping (a comparison with a NaN answers nothing on the GPU, so no other count would see
//   them).

use picture::eye::{Eye, View, view}
use picture::picture::Picture
use picture::screen::{cover, encoded, luma}
use reference::reference::Truth
use std::collections::Vec
use std::gpu::{
    Atomics, FragCoord, GlobalId, GpuBuffer, R8, Rgba16Float, Rgba32Float, Texture, begin_pass,
    buffer_of, copy_texture, dispatch, draw, label, read, texture,
}
use std::io::{Pending, print}

/// How alike (of 255, the greatest channel's difference as the screen shows them) matter's colour
/// and the sky's behind it may be before a picture's coverage can't be read from its colour.
pub const UNDECIDED: f32 = 16.0

/// A pixel is an edge pixel where the reference covers it more than this and less than all but
/// this (an outline's), or where it covers it wholly but how far its looks met matter spreads
/// over this share of how far (an inner edge: matter before other matter, a creature against
/// the ground behind it; a surface seen edge on spreads about a pixel's angle over its cosine,
/// under a hundredth here).
pub const EDGE: f32 = 0.02
pub const INNER: f32 = 0.02

/// How near a shadow's edge (px) a pixel is judged as near it.
pub const SHADOW_NEAR: u32 = 3

/// Matter under this thick (m, straight in from its surface) is thin: a wand, an ear's tip.
pub const THIN: f32 = 0.025

/// How far (m, along the middle ray) a picture's surface may be from the reference's at a thin
/// pixel and still be the thin thing: past it, the picture missed it and shows what is behind.
pub const THIN_OFF: f32 = 0.05

/// How many numbers `judged` counts.
pub const COUNTS: u32 = 45

/// The greatest of the three channels' difference between two linear colours, as the screen
/// shows them (of 255).
fn apart_on_screen(a: vec3, b: vec3) -> f32 {
    let d = abs(encoded(a) - encoded(b)) * 255.0
    max(d.x, max(d.y, d.z))
}

/// Whether any channel of `c` is not a number (a NaN is unequal to itself, on every target).
fn not_a_number(c: vec3) -> bool {
    c.x != c.x || c.y != c.y || c.z != c.z
}

/// `value` added to the sum at `i` of `out`, a pixel at a time, counting at `hi` each time the sum
/// goes past 2^32 (a sum of a 255th's sixteenths over every pixel of a large picture can).
fn added(out: mut Atomics<u32>, i: u32, hi: u32, value: u32) {
    let old = out.add(i: i, value: value)
    if old > 4294967295 - value {
        let _ = out.add(i: hi, value: 1)
    }
}

/// How much of a pixel showing `c` is matter that shows `m` against a sky that shows `s` (all
/// linear), from 0 to 1.
fn covered(c: vec3, m: vec3, s: vec3) -> f32 {
    let ms = m - s
    clamp(dot(c - s, ms) / max(dot(ms, ms), 1.0e-12), 0.0, 1.0)
}

/// The reference's coverage at (`x`, `y`), the screen's edge held.
fn ref_cover(mean: Texture<Rgba32Float>, x: i32, y: i32) -> f32 {
    let w = i32(mean.width())
    let h = i32(mean.height())
    mean.load(u32(clamp(x, 0, w - 1)), u32(clamp(y, 0, h - 1))).w
}

/// What the judges read of a pixel's coverage (`coverage_at`).
struct Coverage: Copy {
    /// Whether matter and the sky behind it differ enough to read coverage from colour.
    decided: bool,
    /// The reference covers most of the pixel; the picture does.
    ref_met: bool,
    pic_met: bool,
    /// The picture's coverage, from 0 to 1 (as `covered` reads it, near the outline).
    c_pic: f32,
    /// How many of the eight pixels round it the reference covers most of, and whether one of
    /// the four beside it it doesn't.
    around: u32,
    side_open: bool,
    /// Whether it is near the reference's outline (covered in part, beside an uncovered pixel,
    /// or uncovered beside a covered one).
    near: bool,
}

/// How far (of 255, as the screen shows it) a picture's colour may be from the sky's behind it
/// and be read as the sky, away from the outline (if it is nearer the sky's than matter's too).
pub const SKY_LIKE: f32 = 8.0

/// A picture's coverage at (`x`, `y`), where it shows `p` (linear), against the reference's
/// (`mean`: its share of looks that met matter; `mm`: their mean colour and spread; `rf`: how far
/// they met it, its spread, and the noise in their mean brightness; `s`: the sky behind). Near the
/// reference's outline, the share of the way from the sky's colour to matter's the picture's
/// colour lies; away from it, whether the picture shows the sky or not (so a picture whose light
/// is wrong on matter, or whose matter is moved, isn't read as a hole: only a pixel that shows the
/// sky is).
fn coverage_at(
    p: vec3,
    mean: Texture<Rgba32Float>,
    mm: vec4,
    rf: vec4,
    s: vec3,
    x: u32,
    y: u32,
) -> Coverage {
    let c_ref = mean.load(x, y).w
    var around: u32 = 0
    var touched: u32 = 0
    var side_open = false
    var k: u32 = 0
    while k < 9 {
        let dx = i32(k % 3) - 1
        let dy = i32(k / 3) - 1
        k += 1
        if dx != 0 || dy != 0 {
            let c = ref_cover(mean, i32(x) + dx, i32(y) + dy)
            if c >= 0.5 {
                around += 1
            } else if dx == 0 || dy == 0 {
                side_open = true
            }
            if c > 0.0 {
                touched += 1
            }
        }
    }
    let ref_met = c_ref >= 0.5
    let inside = c_ref >= 0.9999 && around == 8
    let outside = c_ref <= 0.0 && touched == 0
    let near = !inside && !outside
    // Like the sky: near its colour, and nearer it than matter's.
    let met_any = c_ref > 0.0
    // (Not where the picture is as near matter's mean brightness as the reference itself can
    // say it: at an inner edge, two surfaces, one as dark as the sky behind, the looks' own
    // spread, since a picture may resolve the edge another way; elsewhere only the reference's
    // noise in that mean, so a hole in matter whose single looks are noisy, as in shadow under
    // a few rays a look, is still read as the sky it shows.)
    let off = abs(luma(p) - luma(mm.xyz))
    let noise = if rf.y > INNER { mm.w } else { rf.z }
    let sky_like = apart_on_screen(p, s) <= SKY_LIKE &&
        (!met_any || (covered(p, mm.xyz, s) < 0.5 && off > 3.0 * noise))
    var decided = true
    var c_pic = 0.0
    if met_any && apart_on_screen(mm.xyz, s) < UNDECIDED {
        decided = false
    } else if near && met_any {
        c_pic = covered(p, mm.xyz, s)
    } else {
        c_pic = if sky_like { 0.0 } else { 1.0 }
    }
    Coverage { decided, ref_met, pic_met: c_pic >= 0.5, c_pic, around, side_open, near }
}

/// Where a picture and the reference disagree on coverage, a pixel each, to be seen (the judges
/// count; this shows where): red a hole, orange another pixel missed, green an extra one, blue
/// undecided, magenta not a number; elsewhere the picture, dimmed to a quarter.
@fragment
pub fn marked(
    pixel: FragCoord,
    colour: Texture<Rgba16Float>,
    mean: Texture<Rgba32Float>,
    matter: Texture<Rgba32Float>,
    far: Texture<Rgba32Float>,
    behind: Texture<Rgba32Float>,
) -> vec4 {
    let x = u32(pixel.position.x)
    let y = u32(pixel.position.y)
    let p = colour.load(x, y).xyz
    if not_a_number(p) {
        return vec4(1.0, 0.0, 1.0, 1.0)
    }
    let cov = coverage_at(p, mean, matter.load(x, y), far.load(x, y), behind.load(x, y).xyz, x, y)
    if !cov.decided {
        return vec4(0.0, 0.0, 1.0, 1.0)
    }
    if cov.ref_met && !cov.pic_met {
        return if cov.around == 8 { vec4(1.0, 0.0, 0.0, 1.0) } else { vec4(1.0, 0.35, 0.0, 1.0) }
    }
    if cov.pic_met && !cov.ref_met {
        return vec4(0.0, 1.0, 0.0, 1.0)
    }
    vec4(p * 0.25, 1.0)
}

/// A picture with what `judged` reads in its coverage drawn over it (`marked`), into `out`.
pub fn marks(picture: Picture, truth: Truth, out: mut Picture) {
    let w = picture.width()
    let h = picture.height()
    if out.width() != w || out.height() != h {
        out.colour = texture(width: w, height: h)
        out.place = texture(width: w, height: h)
    }
    label("judge marks")
    let p = begin_pass(mut out.colour)
    draw(
        p,
        cover,
        marked.bind(
            colour: picture.colour,
            mean: truth.mean,
            matter: truth.matter,
            far: truth.far,
            behind: truth.behind,
        ),
        vertices: 3,
    )
    p.end()
    out.placed = false
}

/// A picture held to the reference, a pixel an invocation, rows `first` on, counted into `out`:
///
///    0 pixels                                 1 the reference covers most of
///    2 the picture covers most of             3 missed (the reference covers most, it doesn't)
///    4 extra (it covers most, the reference doesn't)
///    5 holes (missed, and the reference covers most of the eight round it)
///    6 the reference's outline (covered most, a pixel beside it not)
///    7 undecided (matter and the sky behind too alike to read coverage from colour)
///    8 coverage off, |c - c_ref| summed over decided pixels near the outline (thousandths)
///    9 pixels matter covers wholly            10 of them, over 8/255
///   11 of them, the difference summed (16ths of 255)
///   12 all pixels over 8/255                 13 all, the difference summed (16ths of 255)
///   14 edge pixels (an outline's or an inner one) 15 their difference summed (16ths of 255)
///   16 edge pixels over 8/255
///   17 pixels both place a surface at         18..23 apart under 0.05 px, 0.1, 0.25, 0.5, 1, over
///   24 apart summed, each at most 4 px (256ths of a px)    25 apart at the most (thousandths)
///   26 edge pixels judged for steps (now or before)        27 the picture's steps over 15/255 there
///   28 the reference's there                  29 pixels judged for steps
///   30 the picture's steps over 15/255        31 the reference's
///   32 pixels whose middle ray the reference couldn't follow (it ran out of steps)
///   33 of the edge pixels (14), those at an inner edge (matter before matter)
///   34 pixels whose middle ray meets thin matter (under `THIN` through)   35 of them, those the
///      picture shows something else at (its surface over `THIN_OFF` from the reference's)
///   36 wholly covered pixels near a shadow's edge  37 of them, over 8/255
///   38 their difference summed (16ths of 255)
///   39 pixels whose colour is not a number (each also counted over 8/255, as 255/255 off)
///   40 pixels where another of the reference's marches (a look's, a sun ray's, a bounced ray's)
///      ran out of steps
///   41..44 how many times 11, 13, 15 and 38 went past 2^32 (`added`)
@compute(8, 8)
pub fn judged(
    colour: Texture<Rgba16Float>,
    place: Texture<Rgba32Float>,
    placed: u32,
    mean: Texture<Rgba32Float>,
    matter: Texture<Rgba32Float>,
    far: Texture<Rgba32Float>,
    centre: Texture<Rgba32Float>,
    behind: Texture<Rgba32Float>,
    thick: Texture<Rgba32Float>,
    last_colour: Texture<Rgba16Float>,
    last_mean: Texture<Rgba32Float>,
    last_far: Texture<Rgba32Float>,
    moving: u32,
    sun: Texture<R8>,
    v: View,
    first: u32,
    out: mut Atomics<u32>,
    id: GlobalId,
) {
    let x = id.x
    let y = first + id.y
    if x >= colour.width() || y >= colour.height() {
        return
    }
    let p = colour.load(x, y).xyz
    let nan = not_a_number(p)
    let r = mean.load(x, y)
    let mm = matter.load(x, y)
    let rf = far.load(x, y)
    let bh = behind.load(x, y)
    let s = bh.xyz
    let c_ref = r.w
    if bh.w > 1.5 {
        let _ = out.add(i: 32, value: 1)
    }
    if thick.load(x, y).y > 0.5 {
        let _ = out.add(i: 40, value: 1)
    }
    if nan {
        let _ = out.add(i: 39, value: 1)
    }
    let _ = out.add(i: 0, value: 1)
    let cov = coverage_at(p, mean, mm, rf, s, x, y)
    if cov.ref_met {
        let _ = out.add(i: 1, value: 1)
        if cov.side_open {
            let _ = out.add(i: 6, value: 1)
        }
    }
    if !cov.decided {
        let _ = out.add(i: 7, value: 1)
    } else {
        if cov.pic_met {
            let _ = out.add(i: 2, value: 1)
        }
        if cov.ref_met && !cov.pic_met {
            let _ = out.add(i: 3, value: 1)
            if cov.around == 8 {
                let _ = out.add(i: 5, value: 1)
            }
        }
        if cov.pic_met && !cov.ref_met {
            let _ = out.add(i: 4, value: 1)
        }
        if cov.near {
            let _ = out.add(i: 8, value: u32(abs(cov.c_pic - c_ref) * 1000.0 + 0.5))
        }
    }
    // Light (a colour that is not a number as far off as a colour can be).
    let most = if nan { 255.0 } else { apart_on_screen(p, r.xyz) }
    let whole = c_ref >= 0.9999
    if whole {
        let _ = out.add(i: 9, value: 1)
        if most > 8.0 {
            let _ = out.add(i: 10, value: 1)
        }
        added(mut out, i: 11, hi: 41, value: u32(most * 16.0 + 0.5))
    }
    if most > 8.0 {
        let _ = out.add(i: 12, value: 1)
    }
    // (Near a shadow's edge: within `SHADOW_NEAR` px of where the sun the picture says each pixel
    // sees changes.)
    if whole && sun.width() == colour.width() && sun.height() == colour.height() {
        var lo = 1.0
        var hi = 0.0
        let side = 2 * SHADOW_NEAR + 1
        for k in 0..(side * side) {
            let sx = x + k % side
            let sy = y + k / side
            if sx >= SHADOW_NEAR &&
                sy >= SHADOW_NEAR &&
                sx - SHADOW_NEAR < colour.width() &&
                sy - SHADOW_NEAR < colour.height() {
                let v: f32 = sun.load(sx - SHADOW_NEAR, sy - SHADOW_NEAR)
                lo = min(lo, v)
                hi = max(hi, v)
            }
        }
        if lo < 0.5 && hi > 0.5 {
            let _ = out.add(i: 36, value: 1)
            if most > 8.0 {
                let _ = out.add(i: 37, value: 1)
            }
            added(mut out, i: 38, hi: 44, value: u32(most * 16.0 + 0.5))
        }
    }
    added(mut out, i: 13, hi: 42, value: u32(most * 16.0 + 0.5))
    let outline_edge = c_ref > EDGE && c_ref < 1.0 - EDGE
    let inner_edge = c_ref >= 1.0 - EDGE && rf.y > INNER
    let edge = outline_edge || inner_edge
    if inner_edge {
        let _ = out.add(i: 33, value: 1)
    }
    if edge {
        let _ = out.add(i: 14, value: 1)
        added(mut out, i: 15, hi: 43, value: u32(most * 16.0 + 0.5))
        if most > 8.0 {
            let _ = out.add(i: 16, value: 1)
        }
    }
    // Surfaces apart, along the middle ray; and thin matter kept.
    let cr = centre.load(x, y)
    if placed != 0 {
        let cp = place.load(x, y)
        if cr.w > 0.0 && thick.load(x, y).x < THIN {
            let _ = out.add(i: 34, value: 1)
            if cp.w <= 0.0 || abs(cp.w - cr.w) > THIN_OFF {
                let _ = out.add(i: 35, value: 1)
            }
        }
        if cr.w > 0.0 && cp.w > 0.0 {
            let d = v.ray(vec2(f32(x) + 0.5, f32(y) + 0.5))
            let e = abs(cp.w - cr.w) * abs(dot(cr.xyz, d)) / (cr.w * v.pixel())
            var bin: u32 = 23
            if e < 0.05 {
                bin = 18
            } else if e < 0.1 {
                bin = 19
            } else if e < 0.25 {
                bin = 20
            } else if e < 0.5 {
                bin = 21
            } else if e < 1.0 {
                bin = 22
            }
            let _ = out.add(i: 17, value: 1)
            let _ = out.add(i: bin, value: 1)
            let _ = out.add(i: 24, value: u32(min(e, 4.0) * 256.0))
            let _ = out.max(i: 25, value: u32(min(e, 1000.0) * 1000.0))
        }
    }
    // Crawl.
    if moving != 0 {
        let lm = last_mean.load(x, y)
        let lf = last_far.load(x, y)
        let was_edge = edge ||
            (lm.w > EDGE && lm.w < 1.0 - EDGE) ||
            (lm.w >= 1.0 - EDGE && lf.y > INNER)
        let stepped = nan ||
            abs(luma(encoded(p)) - luma(encoded(last_colour.load(x, y).xyz))) * 255.0 > 15.0
        let ref_stepped = abs(luma(encoded(r.xyz)) - luma(encoded(lm.xyz))) * 255.0 > 15.0
        let _ = out.add(i: 29, value: 1)
        if stepped {
            let _ = out.add(i: 30, value: 1)
        }
        if ref_stepped {
            let _ = out.add(i: 31, value: 1)
        }
        if was_edge {
            let _ = out.add(i: 26, value: 1)
            if stepped {
                let _ = out.add(i: 27, value: 1)
            }
            if ref_stepped {
                let _ = out.add(i: 28, value: 1)
            }
        }
    }
}

/// A fault planted in a picture, to see that the judges find it: none; a square of `size` px at
/// (`x`, `y`) where matter is taken away (the sky behind shown: a hole); every pixel shown as the
/// one to its left (the outline a pixel out sideways); the light on matter a tenth darker (the
/// sky as it was, a pixel matter covers in part darker by its share).
pub const NO_FAULT: u32 = 0
pub const HOLE: u32 = 1
pub const SHIFTED: u32 = 2
pub const DIMMED: u32 = 3
/// Its colours as they were, but its surfaces said to be `size` px farther along each middle ray
/// than the reference's (across the view, as `judged` measures surfaces apart).
pub const PUSHED: u32 = 4

/// The reference's middle-ray places pushed `by` px along each ray, as `judged` measures apart.
@fragment
pub fn pushed_place(pixel: FragCoord, centre: Texture<Rgba32Float>, v: View, by: f32) -> vec4 {
    let c = centre.load(u32(pixel.position.x), u32(pixel.position.y))
    if c.w <= 0.0 {
        return c
    }
    let d = v.ray(pixel.position.xy)
    vec4(c.xyz, c.w + by * c.w * v.pixel() / max(abs(dot(c.xyz, d)), 1.0e-6))
}

@fragment
pub fn faulted(
    pixel: FragCoord,
    colour: Texture<Rgba16Float>,
    behind: Texture<Rgba32Float>,
    mean: Texture<Rgba32Float>,
    fault: u32,
    square: vec4,
) -> vec4 {
    let x = u32(pixel.position.x)
    let y = u32(pixel.position.y)
    let c = colour.load(x, y).xyz
    if fault == HOLE {
        if f32(x) >= square.x &&
            f32(x) < square.x + square.z &&
            f32(y) >= square.y &&
            f32(y) < square.y + square.z {
            return vec4(behind.load(x, y).xyz, 1.0)
        }
    } else if fault == SHIFTED {
        return vec4(colour.load(if x > 0 { x - 1 } else { 0 }, y).xyz, 1.0)
    } else if fault == DIMMED {
        // Matter's light alone: the sky as it was.
        let share = mean.load(x, y).w
        return vec4(mix(c, c * 0.9, share), 1.0)
    }
    vec4(c, 1.0)
}

/// `picture` with `fault` planted (a hole's square `size` px a side about where `eye` sees the
/// point `at`; or for `PUSHED`, how far its surfaces are pushed), into `out`, which says where it
/// put its surfaces only when pushed.
pub fn planted(
    picture: Picture,
    truth: Truth,
    fault: u32,
    eye: Eye,
    at: vec3,
    size: f32,
    out: mut Picture,
) {
    let w = picture.width()
    let h = picture.height()
    let corner = view(eye, w, h).pixel_of(at) - vec2(0.5 * size)
    if out.width() != w || out.height() != h {
        out.colour = texture(width: w, height: h)
        out.place = texture(width: w, height: h)
    }
    label("judge planted")
    let p = begin_pass(mut out.colour)
    draw(
        p,
        cover,
        faulted.bind(
            colour: picture.colour,
            behind: truth.behind,
            mean: truth.mean,
            fault: fault,
            square: vec4(floor(corner), size, 0.0),
        ),
        vertices: 3,
    )
    p.end()
    out.placed = false
    if fault == PUSHED {
        let q = begin_pass(mut out.place)
        draw(
            q,
            cover,
            pushed_place.bind(centre: truth.centre, v: view(eye, w, h), by: size),
            vertices: 3,
        )
        q.end()
        out.placed = true
    }
}

/// What was asked of the judges and is not yet heard.
struct Asked {
    number: u32,
    crawl: bool,
    counts: Pending<u32>,
}

/// The judges, and what each was last shown (for crawl).
pub struct Judge {
    last_colour: Texture<Rgba16Float>,
    last_mean: Texture<Rgba32Float>,
    last_far: Texture<Rgba32Float>,
    /// Whether `last_colour` and `last_mean` hold a moment.
    moving: bool,
    asked: Vec<Asked>,
    numbers: u32,
}

pub fn judge() -> Judge {
    Judge {
        last_colour: texture(width: 1, height: 1),
        last_mean: texture(width: 1, height: 1),
        last_far: texture(width: 1, height: 1),
        moving: false,
        asked: Vec::new(),
        numbers: 0,
    }
}

/// A sum kept in two words (`added`): its low and how many times it went past 2^32.
fn wide(lo: u32, hi: u32) -> f32 {
    f32(hi) * 4294967296.0 + f32(lo)
}

/// `n` of `of`, in parts of a hundred.
fn share(n: u32, of: u32) -> f32 {
    100.0 * f32(n) / max(f32(of), 1.0)
}

/// The judges' counts, said.
fn say(n: u32, v: Vec<u32>, crawl: bool) {
    let outline = max(f32(v[6]), 1.0)
    print(
        f"judge {n}: outline: the reference covers {v[1]} px, the picture {v[2]}; outline {v[6]} px; missed {v[3]} ({v[5]} holes), extra {v[4]}; undecided {v[7]} px; outline off {f32(v[3] + v[4]) / outline} px; coverage off {f32(v[8]) / 1000.0 / outline} px",
    )
    if v[39] > 0 {
        print(
            f"judge {n}: NOT A NUMBER: the picture's colour is a NaN at {v[39]} px (counted below as 255/255 off)",
        )
    }
    if v[32] > 0 {
        print(f"judge {n}: THE REFERENCE FAILED: its middle ray ran out of steps at {v[32]} px")
    }
    if v[40] > 0 {
        print(
            f"judge {n}: THE REFERENCE FAILED: another of its marches (a look's, a sun ray's, a bounced ray's) ran out of steps at {v[40]} px, and was taken as getting out",
        )
    }
    print(
        f"judge {n}: lit: over 8/255 {share(v[12], v[0])}% of all px (mean {wide(v[13], v[42]) / 16.0 / max(f32(v[0]), 1.0)}/255); where matter covers wholly ({v[9]} px) {share(v[10], v[9])}% (mean {wide(v[11], v[41]) / 16.0 / max(f32(v[9]), 1.0)}/255)",
    )
    print(
        f"judge {n}: lit near a shadow's edge (within {SHADOW_NEAR} px of where the engine's picture's sun changes, wholly covered): {v[36]} px, {share(v[37], v[36])}% over 8/255 (mean {wide(v[38], v[44]) / 16.0 / max(f32(v[36]), 1.0)}/255)",
    )
    print(
        f"judge {n}: edges: {v[14]} edge px ({v[33]} of them inner), against the many-look mean {wide(v[15], v[43]) / 16.0 / max(f32(v[14]), 1.0)}/255 a pixel, {share(v[16], v[14])}% over 8/255",
    )
    let both = v[17]
    if both > 0 {
        print(
            f"judge {n}: apart, of {both} px: under 0.05 px {share(v[18], both)}%, 0.1 {share(v[19], both)}%, 0.25 {share(v[20], both)}%, 0.5 {share(v[21], both)}%, 1 {share(v[22], both)}%, over {share(v[23], both)}%; mean {f32(v[24]) / 256.0 / max(f32(both), 1.0)} px, most {f32(v[25]) / 1000.0} px",
        )
        print(
            f"judge {n}: thin: {v[34]} px meet matter under {THIN} m thick; the picture shows something else at {v[35]} of them",
        )
    } else {
        print(
            f"judge {n}: apart and thin: not judged (the picture doesn't say where it put its surfaces)",
        )
    }
    if crawl {
        print(
            f"judge {n}: crawl: steps over 15/255 from the moment before, a thousand edge px: the picture {1000.0 * f32(v[27]) / max(f32(v[26]), 1.0)}, the reference {1000.0 * f32(v[28]) / max(f32(v[26]), 1.0)} ({v[26]} edge px); a thousand px: the picture {1000.0 * f32(v[30]) / max(f32(v[29]), 1.0)}, the reference {1000.0 * f32(v[31]) / max(f32(v[29]), 1.0)}",
        )
    }
}

impl Judge {
    /// `picture` held to `truth` (as `eye` saw it on the picture's screen), counted and asked for
    /// (near a shadow's edge as `sun` places them: the engine's picture's, for the floor too);
    /// said when read back (`heard`), as judge number this returns. With `crawl`, also against
    /// the last picture and reference so held, and this one kept for the next.
    pub fn held(
        mut self,
        picture: Picture,
        truth: Truth,
        eye: Eye,
        crawl: bool,
        what: str,
        sun: Texture<R8>,
    ) -> u32 {
        let w = picture.width()
        let h = picture.height()
        let v = view(eye, w, h)
        let n = self.numbers
        self.numbers += 1
        print(f"judge {n}: {what}")
        label("judge")
        var out: GpuBuffer<u32> = buffer_of(Vec::filled(COUNTS, 0))
        let moving: u32 = if crawl &&
            self.moving &&
            self.last_colour.width() == w &&
            self.last_colour.height() == h { 1 } else { 0 }
        var first: u32 = 0
        while first < h {
            dispatch(
                judged.bind(
                    colour: picture.colour,
                    place: picture.place,
                    placed: if picture.placed { 1 } else { 0 },
                    mean: truth.mean,
                    matter: truth.matter,
                    far: truth.far,
                    centre: truth.centre,
                    behind: truth.behind,
                    thick: truth.thick,
                    last_colour: self.last_colour,
                    last_mean: self.last_mean,
                    last_far: self.last_far,
                    moving: moving,
                    sun: sun,
                    v: v,
                    first: first,
                    out: mut out,
                ),
                groups: ((w + 7) / 8, 8, 1),
            )
            first += 64
        }
        self.asked.push(Asked { number: n, crawl: moving != 0, counts: read(out.items()) })
        if crawl {
            if self.last_colour.width() != w || self.last_colour.height() != h {
                self.last_colour = texture(width: w, height: h)
                self.last_mean = texture(width: w, height: h)
                self.last_far = texture(width: w, height: h)
            }
            copy_texture(from: picture.colour.level(0), to: self.last_colour.level_mut(0))
            copy_texture(
                from: truth.mean.level(0),
                to: self.last_mean.level_mut(0),
                width: w,
                height: h,
            )
            copy_texture(
                from: truth.far.level(0),
                to: self.last_far.level_mut(0),
                width: w,
                height: h,
            )
            self.moving = true
        }
        n
    }

    /// The counts said, of each judging read back since; whether every one asked is heard.
    pub fn heard(mut self) -> bool {
        var i: u32 = 0
        while i < self.asked.len() {
            match self.asked[i].counts.poll() {
                Some(Ok(v)) => {
                    say(self.asked[i].number, take v, self.asked[i].crawl)
                    let _ = self.asked.remove(i)
                },
                // (Its counts could not be read: said so, never waited on for ever.)
                Some(Err(e)) => {
                    print(
                        f"judge {self.asked[i].number}: NOT SAID: its counts could not be read ({e.message()})",
                    )
                    let _ = self.asked.remove(i)
                },
                None => {
                    i += 1
                },
            }
        }
        self.asked.len() == 0
    }
}
