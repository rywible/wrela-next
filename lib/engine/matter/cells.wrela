// A thing's roots, and its cells (docs/design.md, "Cost is the engine's"): who answers where, a
// root at a time, and the cache the engine keeps of a thing where its cells answer, true where
// they do: fine enough for whoever asks there.
//
// A thing's roots are a coarse grid over its bound, `ROOTS` bricks across its widest (a moving
// thing's a size wide: `B` cells of the size it is asked at). Each root says, from its field's
// derived range over it (`coarsed`), whether its surface may pass through it; how many roots
// round it hold none (its clearance: a ray crosses them in one stride); and, where the surface
// may pass, who answers there: the parts of its field that can matter there (`Surface::live`'s
// mask) or its cells, whichever an ask weighs less in (`cost`: one comparison, the same on every
// run). A thing that moves keeps no cells: they would be laid again every frame and never be
// measured true, so its roots answer by their parts.
//
// Where cells answer, a root is a tree of bricks; each brick is `B`³ cells (`BS`³ = 729 texels: a
// brick's texels reach its far faces, so a read inside it never reads a neighbour). A kept brick may be split into eight children half its size, each kept or marked
// empty (with its own least distance), and so on down. An ask names a place and a size (m: how
// finely it is asked there, whoever asks: matter never sees the eye or a pixel); it is answered
// by the finest brick there no coarser than that size, or the finest there is yet.
//
// Bricks are split where they were wanted: after each frame the picture hands matter the places
// it showed and the size each was asked at (`Kept::refine`), matter's `refined` kernel walks the
// tree at each and asks for a split where the tree is coarser than the size; splits are made on
// the GPU, at most `BUDGET` a frame (`allotted`, `split`, `filled`, `published`), with no read
// back; until a split is made, its parent answers (a coarser level, never nothing). When room
// runs low, bricks no place asked for in `AGE` frames are folded back into their parent
// (`folded`).
//
// Cells live in buffers, a word a texel (the distance in 16 bits of a brick's side, the facing
// folded 8 + 8), read between the eight texels round a point by hand: any kernel can write any
// brick (a texture can be stored to only at the invoking kernel's own texel: gap 6).
//
// A thing that moves is deposited whole every frame, its roots only, its root cells as fine as it
// is asked (`Kept::deposit`'s size), in bands (the buffers let the deposit be cut).
//
// One deposit, carried from the volume spike (spike/volume, spikes/volume/volume.wrela:
// `coarsed_parts`, `fill_parts`, `redeposit`), rewritten.

use matter::asked::{CELLS, PARTS, WHOLE}
use matter::cost::{counted, weights}
use matter::ranges::{bound_of, longest, stated_steepness}
use std::derive::{Box3, gradient, interval}
use matter::substance::Substance
use std::collections::Vec
use std::field::Field
use std::gpu::{
    Append, AppendBuffer, Atomics, GlobalId, GpuBuffer, GpuSpan, Rgba32Float, Texture, append_buffer, buffer, buffer_of, dispatch,
    label, read,
}
use std::io::{Pending, print}

/// A brick's cells a side, and its texels a side.
pub const B: u32 = 8
pub const BS: u32 = 9
const TEXELS: u32 = 729

/// No brick, no node, no children; an empty child.
pub const NO_BRICK: u32 = 4294967295
pub const NONE: u32 = 4294967295
pub const EMPTY: u32 = 4294967294

/// A root its surface may pass through, answered by its parts (it keeps no cells).
pub const HOLDS: u32 = 4294967293

/// To measure, not an author's: every root held to its parts, or (a still thing's) to its cells.
pub const ASKS_FIELD: u32 = 1
pub const ASKS_CELLS: u32 = 2

/// Root bricks across a still thing's widest; the most levels below a root.
pub const ROOTS: f32 = 24.0
pub const LEVELS: u32 = 14

/// A cell is split until it is no wider than this many times the size it is asked at, or until
/// its cells are off their field by no more than `OFF` of that size (cells are kept only where the
/// field has more in it than the coarser cells show: a smooth stretch stays coarse, whoever asks).
/// A quarter: cells a size wide round a box's edge by a fifth of that size (the stage's outline
/// 0.19 px off at 960x540); a quarter as wide, by 0.06 px.
pub const CELL_PER_SIZE: f32 = 0.25
pub const OFF: f32 = 0.1

/// Words a root holds: its node (`NO_BRICK` none; `HOLDS` answered by its parts; else its brick of
/// cells), its least distance (bits: 0, or below 0 where all of it is inside), the most its
/// field's gradient can be long over it (bits; derived, where its parts answer; else -1), how many
/// roots away the nearest root is that may hold matter (`CLEAR`, `cleared`: so every root nearer
/// than that holds none, and a ray crosses them in one stride), and which of its parts can change
/// its distance in the root (`Surface::live`'s word, every bit past its parts set; all set where
/// its whole field answers), and how many roots away the nearest root is that is answered other
/// than by its whole field (`cleared` again: a ray among roots its whole field answers, or that
/// hold nothing, asks its whole field and fetches no root until it leaves them).
pub const ROOT: u32 = 6

/// The most roots a root's clearance counts.
const CLEAR: u32 = 255

/// Roots a dispatch, deriving ranges (an invocation's work is an interval walk of its field).
const ROOT_BAND: u32 = 8192

/// Words a node holds: its slot (or `EMPTY`), its first child (or `NONE`), its middle's least
/// distance (bits), its level, its least corner (three floats' bits), and how far its cells are off
/// its field at the most (m, bits: `measured`).
pub const NODE: u32 = 8

/// Room: a still thing's slots (bricks of cells, 2,916 bytes each) and nodes (32 bytes each);
/// splits a frame; how many frames unasked before a brick may be folded,
/// and how few free slots start folding.
const STILL_SLOTS: u32 = 163840
const STILL_NODES: u32 = 524288
pub const BUDGET: u32 = 192
const AGE: u32 = 30
const LOW: u32 = 8192

/// Invocations of a filling kernel a dispatch.
const BAND: u32 = 262144

/// How many places a thing is asked at each frame to see whether it moved.
const PROBES: u32 = 27

/// Counters in `Kept::state`: free slots (the top of `free`), the next node never used, free node
/// blocks (the top of `node_free`), splits refused for want of room, the frame.
const FREE_TOP: u32 = 0
const NODE_NEXT: u32 = 1
const BLOCK_TOP: u32 = 2
const REFUSED: u32 = 3
const STATES: u32 = 8

/// A thing's grid as GPU code reads it: its roots' least and greatest corners (m), a root cell's
/// side and a root brick's (m), its last root along x, y and z (as numbers) and its roots along
/// each, how it is asked, how far past a brick's side a ray leaving an empty brick lands, the
/// steepness its field states within `scope` of its surface (what its value is divided by), and
/// the most bricks it may keep. Worked out on the CPU.
pub struct Grid: Copy + GpuData {
    pub lo: vec3,
    pub cell: f32,
    pub hi: vec3,
    pub brick: f32,
    pub top: vec3,
    pub stated: f32,
    pub size: vec3u,
    pub asks: u32,
    pub nudge: vec3,
    pub scope: f32,
    pub kept: u32,
    pub frame: u32,
    /// To measure: every root asks all its parts (1), or only those live there (0, its own).
    pub whole: u32,
    /// Whether it is still (1), so its roots may keep cells.
    pub still: u32,
}

/// A unit vector folded onto an octahedron, 8 bits each way, and back.
pub fn folded8(n: vec3) -> u32 {
    let a = n / max(abs(n.x) + abs(n.y) + abs(n.z), 1.0e-12)
    var e = a.xz
    if a.y < 0.0 {
        e = (vec2(1.0) - abs(vec2(a.z, a.x))) * vec2(if a.x >= 0.0 { 1.0 } else { -1.0 }, if a.z >= 0.0 { 1.0 } else { -1.0 })
    }
    let q = clamp(e * 0.5 + vec2(0.5), vec2(0.0), vec2(1.0)) * 255.0
    u32(q.x + 0.5) | (u32(q.y + 0.5) << 8)
}

pub fn unfolded8(w: u32) -> vec3 {
    let e = vec2(f32(w & 255), f32((w >> 8) & 255)) / 255.0 * 2.0 - vec2(1.0)
    var v = vec3(e.x, 1.0 - abs(e.x) - abs(e.y), e.y)
    let t = max(-v.y, 0.0)
    v.x += if v.x >= 0.0 { -t } else { t }
    v.z += if v.z >= 0.0 { -t } else { t }
    normalize(v)
}

/// A texel's word: its distance in sixteen bits of `side` (from -2 to 2 sides), its facing folded.
pub fn texel_word(d: f32, n: vec3, side: f32) -> u32 {
    let q = clamp(d / side, -2.0, 2.0) * 0.25 + 0.5
    u32(q * 65535.0 + 0.5) | (folded8(n) << 16)
}

/// A texel's distance (m, `side` its brick's side) and facing (unnormalized: a blend reads well).
pub fn texel_of(w: u32, side: f32) -> vec4 {
    let d = (f32(w & 65535) / 65535.0 - 0.5) * 4.0 * side
    vec4(d, unfolded8(w >> 16))
}

/// A brick's cells read at `p` (between the eight texels round it): distance (m) and facing
/// (unnormalized). `slot` its slot, `lo` its least corner, `side` its side.
pub fn read_cells(cells: GpuSpan<u32>, slot: u32, lo: vec3, side: f32, p: vec3) -> vec4 {
    let q = clamp((p - lo) / side * f32(B), vec3(0.0), vec3(f32(B) - 0.0001))
    let i = floor(q)
    let t = q - i
    let base = slot * TEXELS + u32(i.x) + BS * (u32(i.y) + BS * u32(i.z))
    let c000 = texel_of(cells[base], side)
    let c100 = texel_of(cells[base + 1], side)
    let c010 = texel_of(cells[base + BS], side)
    let c110 = texel_of(cells[base + BS + 1], side)
    let c001 = texel_of(cells[base + BS * BS], side)
    let c101 = texel_of(cells[base + BS * BS + 1], side)
    let c011 = texel_of(cells[base + BS * BS + BS], side)
    let c111 = texel_of(cells[base + BS * BS + BS + 1], side)
    let x00 = mix(c000, c100, vec4(t.x))
    let x10 = mix(c010, c110, vec4(t.x))
    let x01 = mix(c001, c101, vec4(t.x))
    let x11 = mix(c011, c111, vec4(t.x))
    mix(mix(x00, x10, vec4(t.y)), mix(x01, x11, vec4(t.y)), vec4(t.z))
}

/// A brick's cells' distance at `p` (m), as `read_cells` reads it, without the facing.
pub fn read_distance(cells: GpuSpan<u32>, slot: u32, lo: vec3, side: f32, p: vec3) -> f32 {
    let q = clamp((p - lo) / side * f32(B), vec3(0.0), vec3(f32(B) - 0.0001))
    let i = floor(q)
    let t = q - i
    let base = slot * TEXELS + u32(i.x) + BS * (u32(i.y) + BS * u32(i.z))
    let x00 = mix(f32(cells[base] & 65535), f32(cells[base + 1] & 65535), t.x)
    let x10 = mix(f32(cells[base + BS] & 65535), f32(cells[base + BS + 1] & 65535), t.x)
    let x01 = mix(f32(cells[base + BS * BS] & 65535), f32(cells[base + BS * BS + 1] & 65535), t.x)
    let x11 = mix(f32(cells[base + BS * BS + BS] & 65535), f32(cells[base + BS * BS + BS + 1] & 65535), t.x)
    let v = mix(mix(x00, x10, t.y), mix(x01, x11, t.y), t.z)
    (v / 65535.0 - 0.5) * 4.0 * side
}

/// How far a brick's cells are off its field at the middle of its cell `k` (m: the distance's
/// error, or the facing's times the cell's side, whichever is more), where the surface is within
/// two cells of it; -1 elsewhere. The brick: `slot`, least corner `lo`, side `side`.
fn off_at<M: Field<Substance>>(field: M, cells: GpuSpan<u32>, slot: u32, lo: vec3, side: f32, k: u32) -> f32 {
    let cell = side / f32(B)
    let p = lo + (vec3(f32(k % B), f32((k / B) % B), f32(k / (B * B))) + vec3(0.5)) * cell
    let f = sampled(field, p, 0.25 * cell)
    if abs(f.x) > 2.0 * cell {
        return -1.0
    }
    let v = read_cells(cells, slot, lo, side, p)
    let n = v.yzw / max(length(v.yzw), 1.0e-6)
    max(abs(v.x - f.x), length(n - f.yzw) * cell)
}

/// The field's distance (over its gradient's length where that is over 1: near the surface, the
/// distance) and facing at `p`; where its gradient vanishes, its slope to each side.
pub fn sampled<M: Field<Substance>>(field: M, p: vec3, h: f32) -> vec4 {
    let (f, grad) = field.sample(p)
    var n = grad
    if dot(n, n) < 1.0e-8 {
        n = vec3(field.distance(p + vec3(h, 0.0, 0.0)) - f, field.distance(p + vec3(0.0, h, 0.0)) - f, field.distance(p + vec3(0.0, 0.0, h)) - f) / h
    }
    let len = length(n)
    if len < 1.0e-6 {
        return vec4(f, 0.0, 1.0, 0.0)
    }
    vec4(f / max(len, 1.0), n / len)
}

/// Whether a brick of side `side` whose middle is `p` may hold the surface (`x` 1: the derived
/// range of its field's value over the brick holds 0: sound, no guess), and its least distance
/// (`y`: 0, or below 0 where all of it is inside).
fn kept_at<M: Field<Substance>>(field: M, p: vec3, side: f32) -> vec2 {
    let v = interval(|q: vec3| field.distance(q), Box3 { lo: p - vec3(0.5 * side), hi: p + vec3(0.5 * side) })
    vec2(if v.lo <= 0.0 && v.hi >= 0.0 { 1.0 } else { 0.0 }, if v.hi < 0.0 { -1.0e-6 } else { 0.0 })
}

/// Root bricks `first` on: whether each may hold its surface, its least distance, and who answers
/// in it, whichever an ask there weighs least by (`weights`, `cost::weights`): its parts live
/// there (`HOLDS` with their mask: what they weigh, and a mask's own work), its whole field (`HOLDS`
/// with every bit set), or its cells (a brick pushed, its push order its node); where it holds
/// nothing, no one (a ray crosses it in a stride, a fetch), or its whole field where that weighs
/// less than the fetch. Where its parts
/// answer, also how steep they can be there. Only a still thing with room keeps cells; held
/// (`g.asks`), every root answers one way.
@compute(64)
fn coarsed<M: Field<Substance>>(field: M, g: Grid, weights: [f32], first: u32, roots: mut Atomics<u32>, bricks: mut Append<u32>, id: GlobalId) {
    let i = first + id.x
    if i >= g.size.x * g.size.y * g.size.z {
        return
    }
    let x = i % g.size.x
    let y = (i / g.size.x) % g.size.y
    let z = i / (g.size.x * g.size.y)
    let mid = g.lo + (vec3(f32(x), f32(y), f32(z)) + vec3(0.5)) * g.brick
    let b = Box3 { lo: mid - vec3(0.5 * g.brick), hi: mid + vec3(0.5 * g.brick) }
    let k = kept_at(field, mid, g.brick)
    var node = NO_BRICK
    var steep = -1.0
    var mask: u32 = 4294967295
    if k.x > 0.5 {
        let n = weights.len() - 5
        var w = weights[n + 1]
        if g.whole == 0 {
            mask = field.live(b).word()
            if n < 32 {
                mask = mask | (4294967295 << n)
            }
            var masked = weights[n] + weights[n + 2]
            for j in 0..min(n, 32) {
                if ((mask >> j) & 1) != 0 {
                    masked += weights[j]
                }
            }
            if masked < w {
                w = masked
            } else {
                mask = 4294967295
            }
        }
        let cells = g.still > 0 && g.kept > 0 && g.asks != ASKS_FIELD && (g.asks == ASKS_CELLS || w > weights[n + 3])
        if cells {
            let s = bricks.push(x | (y << 10) | (z << 20))
            if s < g.kept {
                node = s
            }
        } else {
            node = HOLDS
            let s = longest(interval(|q: vec3| gradient(|r: vec3| field.distance(r), q), b))
            steep = if s < 1.0e30 { s } else { -1.0 }
        }
    }
    if node == NO_BRICK && k.y >= 0.0 && weights[weights.len() - 4] <= weights[weights.len() - 1] && g.asks != ASKS_CELLS {
        // Holds nothing, but its whole field weighs less than the fetch a stride across it
        // would: its whole field answers here too.
        node = HOLDS
    }
    let _ = roots.exchange(i: ROOT * i, value: node)
    let _ = roots.exchange(i: ROOT * i + 1, value: bitcast_u32(k.y))
    let _ = roots.exchange(i: ROOT * i + 2, value: bitcast_u32(steep))
    let _ = roots.exchange(i: ROOT * i + 4, value: mask)
}

/// Whether root `i` may hold matter (its surface may pass through it, or all of it is inside:
/// `kind` 0), or is answered other than by its whole field (by its cells, or a mask: `kind` 1).
fn occupied(roots: [u32], i: u32, kind: u32) -> bool {
    let node = roots[ROOT * i]
    if kind == 0 {
        return node != NO_BRICK || bitcast_f32(roots[ROOT * i + 1]) < 0.0
    }
    node != NO_BRICK && (node != HOLDS || roots[ROOT * i + 4] != 4294967295)
}

/// Each root's clearance, a pass an axis (a chessboard distance transform, separable: G. Borgefors,
/// "Distance transformations in digital images", 1986): along x, how far the nearest root occupied
/// as `kind` says (`occupied`) is in its row (`axis` 0, from `roots`); along y or z (`axis` 1, 2),
/// the most of that and the way along the axis, least over the line (from `from`). Into `out` at
/// `stride` i + `at`.
@compute(64)
fn cleared(g: Grid, roots: [u32], from: [u32], axis: u32, kind: u32, first: u32, stride: u32, at: u32, out: mut Atomics<u32>, id: GlobalId) {
    let i = first + id.x
    if i >= g.size.x * g.size.y * g.size.z {
        return
    }
    let c = vec3u(i % g.size.x, (i / g.size.x) % g.size.y, i / (g.size.x * g.size.y))
    let n = if axis == 0 { g.size.x } else if axis == 1 { g.size.y } else { g.size.z }
    let me = if axis == 0 { c.x } else if axis == 1 { c.y } else { c.z }
    var d = CLEAR
    var j: u32 = 0
    while j < min(n, 1023) {
        let away = if j > me { j - me } else { me - j }
        var q = c
        if axis == 0 { q.x = j } else if axis == 1 { q.y = j } else { q.z = j }
        let k = q.x + g.size.x * (q.y + g.size.y * q.z)
        if axis == 0 {
            if occupied(roots, k, kind) {
                d = min(d, away)
            }
        } else {
            d = min(d, max(away, from[k]))
        }
        j += 1
    }
    let _ = out.exchange(i: stride * i + at, value: d)
}

/// Root nodes `first` on (node `i` is the `i`th root kept, its slot `i`): their records.
@compute(64)
fn rooted<M: Field<Substance>>(field: M, g: Grid, bricks: [u32], count: [u32], first: u32, nodes: mut Atomics<u32>, id: GlobalId) {
    let i = first + id.x
    if i >= min(count[0], g.kept) {
        return
    }
    let c = bricks[i]
    let lo = g.lo + vec3(f32(c & 1023), f32((c >> 10) & 1023), f32(c >> 20)) * g.brick
    let least = kept_at(field, lo + vec3(0.5 * g.brick), g.brick).y
    let at = i * NODE
    nodes.store(i: at, value: i)
    nodes.store(i: at + 1, value: NONE)
    nodes.store(i: at + 2, value: bitcast_u32(least))
    nodes.store(i: at + 3, value: 0)
    nodes.store(i: at + 4, value: bitcast_u32(lo.x))
    nodes.store(i: at + 5, value: bitcast_u32(lo.y))
    nodes.store(i: at + 6, value: bitcast_u32(lo.z))
    nodes.store(i: at + 7, value: 0)
}

/// Root bricks' cells, `first` on (cell `k` of root `i` is `512 i + k`): how far each is off its
/// field, into its node (`off_at`).
@compute(64)
fn measured_roots<M: Field<Substance>>(field: M, g: Grid, count: [u32], first: u32, cells: GpuSpan<u32>, nodes: mut Atomics<u32>, roots: mut Atomics<u32>, id: GlobalId) {
    let i = first + id.x
    let node = i / (B * B * B)
    if node >= min(count[0], g.kept) {
        return
    }
    let at = node * NODE
    let lo = vec3(bitcast_f32(nodes.load(i: at + 4)), bitcast_f32(nodes.load(i: at + 5)), bitcast_f32(nodes.load(i: at + 6)))
    let off = off_at(field, cells, node, lo, g.brick, i % (B * B * B))
    if off > 0.0 {
        let _ = nodes.max(i: at + 7, value: bitcast_u32(off))
    }
    // Off by more than `OFF` of the coarsest size a root's cells are ever read at (a cell over
    // `CELL_PER_SIZE`): they can be true at no size, so its live parts answer there instead,
    // decided once, here (its mask and steepness were laid with the root: `coarsed`).
    if off > OFF * g.cell / CELL_PER_SIZE {
        let c = floor((lo - g.lo) / g.brick + vec3(0.5))
        let r = u32(c.x) + g.size.x * (u32(c.y) + g.size.y * u32(c.z))
        let _ = roots.exchange(i: ROOT * r, value: HOLDS)
    }
}

/// Root cells, texels `first` on (texel `k` of slot `i` is word `729 i + k`).
@compute(64)
fn deposited<M: Field<Substance>>(field: M, g: Grid, bricks: [u32], count: [u32], first: u32, cells: mut Atomics<u32>, id: GlobalId) {
    let i = first + id.x
    let slot = i / TEXELS
    if slot >= min(count[0], g.kept) {
        return
    }
    let k = i % TEXELS
    let c = bricks[slot]
    let local = vec3(f32(k % BS), f32((k / BS) % BS), f32(k / (BS * BS)))
    let p = g.lo + vec3(f32(c & 1023), f32((c >> 10) & 1023), f32(c >> 20)) * g.brick + local * g.cell
    let v = sampled(field, p, 0.25 * g.cell)
    cells.store(i: i, value: texel_word(v.x, v.yzw, g.brick))
}

/// The free slots, `first` on, put on the free stack (slot `kept + i` at place `i`).
@compute(64)
fn stacked(first: u32, count: u32, free: mut Atomics<u32>, id: GlobalId) {
    if id.x < count {
        free.store(i: id.x, value: first + id.x)
    }
}

/// Where each place the picture showed (`asks`: the place, and the size it was asked at; `w` 0
/// for none) wants the tree finer than it is (its cells wider than the size, and off their field
/// by more than `OFF` of it): the leaf there asked to be split, once (`flags`),
/// at most `cap` asks a frame; and the node it stops at stamped with the frame (only that one: a
/// node passed on the way has children, and is never folded while one of them is stamped).
@compute(8, 8)
fn refined(
    asks: Texture<Rgba32Float>,
    g: Grid,
    roots: [u32],
    nodes: [u32],
    flags: mut Atomics<u32>,
    stamps: mut Atomics<u32>,
    requests: mut Append<u32>,
    id: GlobalId,
) {
    if id.x >= asks.width() || id.y >= asks.height() {
        return
    }
    let a = asks.load(id.x, id.y)
    if a.w <= 0.0 {
        return
    }
    let p = a.xyz
    let outside = max(g.lo - p, p - g.hi)
    if max(outside.x, max(outside.y, outside.z)) >= 0.0 {
        return
    }
    let c = clamp(floor((p - g.lo) / g.brick), vec3(0.0), g.top)
    let r = u32(c.x) + g.size.x * (u32(c.y) + g.size.y * u32(c.z))
    var node = roots[ROOT * r]
    if node == NO_BRICK || node == HOLDS {
        return
    }
    var side = g.brick
    var level: u32 = 0
    var going = true
    while level < LEVELS && going {
        level += 1
        if side / f32(B) <= a.w * CELL_PER_SIZE || bitcast_f32(nodes[node * NODE + 7]) <= OFF * a.w {
            going = false
        } else {
            let first = nodes[node * NODE + 1]
            if first == NONE {
                if flags.exchange(i: node, value: 1) == 0 {
                    let _ = requests.push(node)
                }
                going = false
            } else {
                let lo = vec3(bitcast_f32(nodes[node * NODE + 4]), bitcast_f32(nodes[node * NODE + 5]), bitcast_f32(nodes[node * NODE + 6]))
                let half = 0.5 * side
                let o = step(lo + vec3(half), p)
                let child = first + u32(o.x) + 2 * u32(o.y) + 4 * u32(o.z)
                if nodes[child * NODE] == EMPTY {
                    going = false
                } else {
                    node = child
                    side = half
                }
            }
        }
    }
    let _ = stamps.max(i: node, value: g.frame)
}

/// Each request up to `BUDGET` given eight node records (a free block, or new ones) and eight
/// slots (`pending`: the block, then the slots; `NONE` where there was no room: the split waits).
@compute(64)
fn allotted(count: [u32], nodes_most: u32, state: mut Atomics<u32>, free: [u32], node_free: [u32], pending: mut Atomics<u32>, id: GlobalId) {
    let r = id.x
    if r >= min(count[0], BUDGET) {
        return
    }
    let top = state.sub(i: FREE_TOP, value: 8)
    if top < 8 || top > 4000000000 {
        let _ = state.add(i: FREE_TOP, value: 8)
        let _ = state.add(i: REFUSED, value: 1)
        pending.store(i: 9 * r, value: NONE)
        return
    }
    var block = NONE
    let b = state.sub(i: BLOCK_TOP, value: 1)
    if b >= 1 && b < 4000000000 {
        block = node_free[b - 1]
    } else {
        let _ = state.add(i: BLOCK_TOP, value: 1)
        let n = state.add(i: NODE_NEXT, value: 8)
        if n + 8 <= nodes_most {
            block = n
        }
    }
    if block == NONE {
        let _ = state.add(i: FREE_TOP, value: 8)
        let _ = state.add(i: REFUSED, value: 1)
        pending.store(i: 9 * r, value: NONE)
        return
    }
    pending.store(i: 9 * r, value: block)
    var k: u32 = 0
    while k < 8 {
        pending.store(i: 9 * r + 1 + k, value: free[top - 8 + k])
        k += 1
    }
}

/// Each child of each request up to `BUDGET`: whether it is kept, its record; an empty child's
/// slot given back.
@compute(64)
fn split<M: Field<Substance>>(field: M, g: Grid, requests: [u32], count: [u32], pending: [u32], nodes: mut Atomics<u32>, state: mut Atomics<u32>, free: mut Atomics<u32>, id: GlobalId) {
    let r = id.x / 8
    let c = id.x % 8
    if r >= min(count[0], BUDGET) {
        return
    }
    let block = pending[9 * r]
    if block == NONE {
        return
    }
    let parent = requests[r]
    let level = nodes.load(i: parent * NODE + 3) + 1
    let lo = vec3(bitcast_f32(nodes.load(i: parent * NODE + 4)), bitcast_f32(nodes.load(i: parent * NODE + 5)), bitcast_f32(nodes.load(i: parent * NODE + 6)))
    let side = g.brick * exp2(-f32(level))
    let o = vec3(f32(c & 1), f32((c >> 1) & 1), f32((c >> 2) & 1))
    let clo = lo + o * side
    let k = kept_at(field, clo + vec3(0.5 * side), side)
    var slot = pending[9 * r + 1 + c]
    if k.x < 0.5 {
        let at = state.add(i: FREE_TOP, value: 1)
        free.store(i: at, value: slot)
        slot = EMPTY
    }
    let at = (block + c) * NODE
    nodes.store(i: at, value: slot)
    nodes.store(i: at + 1, value: NONE)
    nodes.store(i: at + 2, value: bitcast_u32(k.y))
    nodes.store(i: at + 3, value: level)
    nodes.store(i: at + 4, value: bitcast_u32(clo.x))
    nodes.store(i: at + 5, value: bitcast_u32(clo.y))
    nodes.store(i: at + 6, value: bitcast_u32(clo.z))
    nodes.store(i: at + 7, value: 0)
}

/// The cells of each kept child of each request up to `BUDGET`, `first` on (eight children of 729
/// texels a request).
@compute(64)
fn filled<M: Field<Substance>>(field: M, g: Grid, count: [u32], pending: [u32], nodes: [u32], first: u32, cells: mut Atomics<u32>, id: GlobalId) {
    let i = first + id.x
    let r = i / (8 * TEXELS)
    if r >= min(count[0], BUDGET) {
        return
    }
    let block = pending[9 * r]
    if block == NONE {
        return
    }
    let c = (i / TEXELS) % 8
    let k = i % TEXELS
    let node = block + c
    let slot = nodes[node * NODE]
    if slot == EMPTY {
        return
    }
    let level = nodes[node * NODE + 3]
    let lo = vec3(bitcast_f32(nodes[node * NODE + 4]), bitcast_f32(nodes[node * NODE + 5]), bitcast_f32(nodes[node * NODE + 6]))
    let side = g.brick * exp2(-f32(level))
    let local = vec3(f32(k % BS), f32((k / BS) % BS), f32(k / (BS * BS)))
    let v = sampled(field, lo + local * (side / f32(B)), 0.25 * side / f32(B))
    cells.store(i: slot * TEXELS + k, value: texel_word(v.x, v.yzw, side))
}

/// The cells of each kept child of each request up to `BUDGET`, `first` on (eight children of 512
/// cells a request): how far each is off its field, into its node (`off_at`).
@compute(64)
fn measured<M: Field<Substance>>(field: M, g: Grid, count: [u32], pending: [u32], first: u32, cells: GpuSpan<u32>, nodes: mut Atomics<u32>, id: GlobalId) {
    let i = first + id.x
    let r = i / (8 * B * B * B)
    if r >= min(count[0], BUDGET) {
        return
    }
    let block = pending[9 * r]
    if block == NONE {
        return
    }
    let at = (block + (i / (B * B * B)) % 8) * NODE
    let slot = nodes.load(i: at)
    if slot == EMPTY {
        return
    }
    let side = g.brick * exp2(-f32(nodes.load(i: at + 3)))
    let lo = vec3(bitcast_f32(nodes.load(i: at + 4)), bitcast_f32(nodes.load(i: at + 5)), bitcast_f32(nodes.load(i: at + 6)))
    let off = off_at(field, cells, slot, lo, side, i % (B * B * B))
    if off > 0.0 {
        let _ = nodes.max(i: at + 7, value: bitcast_u32(off))
    }
}

/// Each request made (`pending`): its node given its children; every request's flag cleared, so
/// one that waited asks again.
@compute(64)
fn published(requests: [u32], count: [u32], pending: [u32], nodes: mut Atomics<u32>, flags: mut Atomics<u32>, id: GlobalId) {
    let r = id.x
    if r >= count[0] || r >= 65536 {
        return
    }
    let node = requests[r]
    if r < BUDGET {
        let block = pending[9 * r]
        if block != NONE {
            nodes.store(i: node * NODE + 1, value: block)
        }
    }
    flags.store(i: node, value: 0)
}

/// Nodes `first` on whose eight children are all leaves no place asked for in `AGE` frames: the
/// children folded back (their slots and their block freed), the node a leaf again.
@compute(64)
fn folded(g: Grid, first: u32, most: u32, nodes: mut Atomics<u32>, stamps: [u32], state: mut Atomics<u32>, free: mut Atomics<u32>, node_free: mut Atomics<u32>, id: GlobalId) {
    let n = first + id.x
    if n >= most {
        return
    }
    let block = nodes.load(i: n * NODE + 1)
    if block == NONE || block == 0 {
        return
    }
    var k: u32 = 0
    var old = true
    while k < 8 {
        let child = block + k
        if nodes.load(i: child * NODE + 1) != NONE || stamps[child] + AGE > g.frame {
            old = false
        }
        k += 1
    }
    if !old {
        return
    }
    nodes.store(i: n * NODE + 1, value: NONE)
    k = 0
    while k < 8 {
        let slot = nodes.load(i: (block + k) * NODE)
        if slot != EMPTY {
            let at = state.add(i: FREE_TOP, value: 1)
            free.store(i: at, value: slot)
        }
        k += 1
    }
    let b = state.add(i: BLOCK_TOP, value: 1)
    node_free.store(i: b, value: block)
}

/// Said of a thing held to a way of asking, to measure.
fn held(asks: u32) -> Text {
    if asks != 0 { " (held so, to measure)" } else { "" }
}

/// One thing's cells, and where its deposit stands.
pub struct Kept {
    pub grid: Grid,
    pub roots: GpuBuffer<u32>,
    pub nodes: GpuBuffer<u32>,
    pub cells: GpuBuffer<u32>,
    bricks: AppendBuffer<u32>,
    clear_a: GpuBuffer<u32>,
    clear_b: GpuBuffer<u32>,
    requests: AppendBuffer<u32>,
    flags: GpuBuffer<u32>,
    stamps: GpuBuffer<u32>,
    pending: GpuBuffer<u32>,
    state: GpuBuffer<u32>,
    free: GpuBuffer<u32>,
    node_free: GpuBuffer<u32>,
    counted: Option<Pending<u32>>,
    stated: Option<Pending<u32>>,
    /// 0 to be laid; 1 roots' bands; 2 their count asked for; 3 root cells' bands; 4 deposited
    /// (still); 5 moving (deposited whole every frame).
    stage: u32,
    cursor: u32,
    roots_kept: u32,
    slots_most: u32,
    nodes_most: u32,
    /// Free slots when last read, and whether folding is under way.
    free_slots: u32,
    folding: bool,
    probes: Vec<f32>,
    /// Where its matter can be (centre, radius), derived from its field's ranges (or, where they
    /// can't say yet, as std's shapes state it: `ranges::bound_of`), and whether derived.
    derived: vec4,
    bound_derived: bool,
    /// What its asks weigh (`cost::weights`), for its roots' choice, once the toolchain's counts of
    /// a read of cells and a fetch (`cost::counted`) are read back.
    weights: GpuBuffer<f32>,
    weighed: bool,
    weight: Vec<f32>,
    counts: Option<Pending<u32>>,
    counted_out: GpuBuffer<u32>,
    /// The ways it can be answered (`asked::WHOLE`, `PARTS`, `CELLS`): chosen from the count once
    /// (again when it starts to move), a constant of the pipelines that draw it.
    pub ways: u32,
    pub moving: bool,
    pub held_asks: u32,
    pub held_cell: f32,
    /// An instrument: 1 asks it whole, never by its parts.
    pub held_whole: u32,
    frame: u32,
}

/// A thing's cells, as yet nothing.
pub fn kept() -> Kept {
    Kept {
        grid: Grid {
            lo: vec3(0.0),
            cell: 1.0,
            hi: vec3(8.0),
            brick: 8.0,
            top: vec3(0.0),
            stated: 1.0,
            size: vec3u(1, 1, 1),
            asks: 0,
            nudge: vec3(0.08),
            scope: 1.0,
            kept: 0,
            frame: 0,
            whole: 0,
            still: 1,
        },
        roots: buffer(2),
        nodes: buffer(NODE),
        cells: buffer(TEXELS),
        bricks: append_buffer(1),
        clear_a: buffer(1),
        clear_b: buffer(1),
        requests: append_buffer(1),
        flags: buffer(1),
        stamps: buffer(1),
        pending: buffer(9),
        state: buffer_of(Vec::filled(STATES, 0)),
        free: buffer(1),
        node_free: buffer(1),
        counted: None,
        stated: None,
        stage: 0,
        cursor: 0,
        roots_kept: 0,
        slots_most: 1,
        nodes_most: 1,
        free_slots: 0,
        folding: false,
        probes: Vec::new(),
        weights: buffer(1),
        weighed: false,
        weight: Vec::new(),
        counts: None,
        counted_out: buffer(2),
        ways: 99,
        moving: false,
        held_asks: 0,
        held_cell: 0.0,
        held_whole: 0,
        frame: 0,
        derived: vec4(0.0),
        bound_derived: false,
    }
}

/// `field`'s answers at the thing's probes: a 3 × 3 × 3 lattice through its bound.
fn probed<M: Field<Substance>>(field: M, b: vec4) -> Vec<f32> {
    var out: Vec<f32> = Vec::with_capacity(PROBES)
    for k in 0..PROBES {
        let o = vec3(f32(k % 3), f32((k / 3) % 3), f32(k / 9)) - vec3(1.0)
        out.push(field.distance(b.xyz + o * (0.5 * b.w)))
    }
    out
}

impl Kept {
    /// Where its matter can be (centre, radius; radius 0 until known), derived.
    pub fn derived(self) -> vec4 {
        self.derived
    }

    /// Where `field` can be (`ranges::bound_of`), and the steepness std's shapes state over its
    /// grid's scope (for roots whose derived steepness is unbounded).
    fn bounded<M: Field<Substance>>(mut self, field: M) {
        let (b, derived) = bound_of(field)
        self.derived = b
        self.bound_derived = derived
        self.grid.stated = stated_steepness(field, max(2.0 * b.w, 1.0))
    }

    /// Each root's clearances (`cleared`), once its roots are laid: from roots that may hold
    /// matter (word 3), and from roots answered other than by its whole field (word 5).
    fn clear_roots(mut self) {
        let n = self.grid.size.x * self.grid.size.y * self.grid.size.z
        if self.clear_a.len() != n {
            self.clear_a = buffer(n)
            self.clear_b = buffer(n)
        }
        label("roots cleared")
        for kind in 0..2 {
            var first: u32 = 0
            while first < n {
                dispatch(cleared.bind(g: self.grid, roots: self.roots.items(), from: self.clear_b.items(), axis: 0, kind: kind, first: first, stride: 1, at: 0, out: mut self.clear_a), over: min(BAND, n - first))
                first += BAND
            }
            first = 0
            while first < n {
                dispatch(cleared.bind(g: self.grid, roots: self.roots.items(), from: self.clear_a.items(), axis: 1, kind: kind, first: first, stride: 1, at: 0, out: mut self.clear_b), over: min(BAND, n - first))
                first += BAND
            }
            first = 0
            while first < n {
                dispatch(cleared.bind(g: self.grid, roots: self.clear_a.items(), from: self.clear_b.items(), axis: 2, kind: kind, first: first, stride: ROOT, at: 3 + 2 * kind, out: mut self.roots), over: min(BAND, n - first))
                first += BAND
            }
        }
    }

    /// Whether its cells are ready to be asked.
    pub fn ready(self) -> bool {
        self.stage >= 4
    }

    /// Its roots laid over `field`'s bound: `cell` a root cell's side (m), or for a still thing
    /// `ROOTS` bricks across; `fixed`, its size kept and only its place moved.
    fn laid(mut self, cell: f32, fixed: bool) {
        let b = self.derived
        if !fixed {
            var c = cell
            if self.held_cell > 0.0 {
                c = self.held_cell
            }
            let brick = c * f32(B)
            let n = u32(ceil(2.0 * b.w / brick)) + 1
            if n > 1023 {
                panic(f"engine::matter: a grid of {n} bricks a side: the most is 1023")
            }
            self.grid.cell = c
            self.grid.size = vec3u(n, n, n)
        }
        let brick = self.grid.cell * f32(B)
        self.grid.lo = floor((b.xyz - vec3(b.w)) / brick) * brick
        self.grid.brick = brick
        self.grid.nudge = vec3(0.01 * brick)
        let size = vec3(f32(self.grid.size.x), f32(self.grid.size.y), f32(self.grid.size.z))
        self.grid.hi = self.grid.lo + size * brick
        self.grid.top = size - vec3(1.0)
        // (Steepness asked over the whole grid, so an empty brick far from the surface says how
        // far: a ray then crosses empty space in strides.)
        self.grid.scope = max(2.0 * brick, length(size) * brick)
    }

    /// The ways it can be answered, from the count (`cost`): by its cells where it is still and its
    /// whole ask weighs more than a read of cells; by its whole field alone where every root would
    /// be (its whole ask weighs no more than a fetch, and no mask's ask less than it); else by the
    /// walk, its live parts or its whole field a root.
    fn chosen_ways(self) -> u32 {
        let n = self.weight.len() - 5
        let whole = self.weight[n + 1]
        var least = 1.0e30
        for i in 0..n {
            least = min(least, self.weight[i])
        }
        if !self.moving && self.held_asks != ASKS_FIELD && (self.held_asks == ASKS_CELLS || whole > self.weight[n + 3]) {
            return CELLS
        }
        if whole <= self.weight[n + 4] && (n <= 1 || self.weight[n + 2] + least >= whole) {
            return WHOLE
        }
        PARTS
    }

    /// Brought up to date for this frame: seen whether it moves, then its roots laid where it is
    /// (a moving thing's every frame), and a still thing's cells deposited where its roots chose
    /// them. `size` (m) is the finest it was asked at last frame.
    pub fn deposit<M: Field<Substance>>(mut self, field: M, size: f32) {
        self.frame += 1
        self.grid.frame = self.frame
        if self.derived.w <= 0.0 {
            // Where it can be, derived once (a moving thing's again each frame); and the
            // steepness std's shapes state, for roots whose derived steepness is unbounded.
            self.bounded(field)
            let d = self.derived
            let how = if self.bound_derived { "derived" } else { "NOT derived: its search did not close, so it is laid over the space searched" }
            print(f"engine::matter: where it can be, {how}: within {d.w} m of ({d.x}, {d.y}, {d.z})")
        }
        if !self.weighed {
            // What its asks weigh, once: its roots choose by it. (The counts of a read of cells and
            // a fetch are the GPU's code's: counted in a kernel, read back; until then, nothing
            // is ready.)
            match mut self.counts {
                Some(c) => match c.poll() {
                    Some(Ok(v)) => {
                        let w = weights(field, v[0], v[1])
                        let n = w.len() - 5
                        print(f"engine::matter: {field.parts()} parts; an ask weighs {w[n + 1]} whole, a mask {w[n + 2]} beyond the parts it asks; a read of cells {w[n + 3]}, a fetch of a root {w[n + 4]}{held(self.held_asks)}")
                        self.weights = buffer_of(w)
                        self.weight = weights(field, v[0], v[1])
                        self.weighed = true
                        self.counts = None
                    },
                    _ => {},
                },
                None => {
                    self.counted_out = buffer(2)
                    dispatch(counted.bind(g: self.grid, span: self.cells.items(), out: mut self.counted_out), over: 1)
                    self.counts = Some(read(self.counted_out.items()))
                },
            }
            if !self.weighed {
                return
            }
        }
        let now = probed(field, self.derived)
        if self.probes.len() == now.len() {
            var i: u32 = 0
            while i < now.len() {
                if now[i] != self.probes[i] {
                    self.moving = true
                }
                i += 1
            }
        }
        self.probes = take now
        self.grid.asks = self.held_asks
        self.grid.whole = self.held_whole
        let ways = self.chosen_ways()
        if ways != self.ways {
            self.ways = ways
            print(f"engine::matter: answered {if ways == WHOLE { "by its whole field alone, no root looked up" } else if ways == PARTS { "by the walk: its live parts or its whole field a root" } else { "by the walk: its cells, its live parts or its whole field a root" }}{held(self.held_asks)}")
        }
        if self.ways == WHOLE {
            // Its whole field everywhere: its grid only bounds it; no roots.
            if self.stage == 0 {
                self.laid(2.0 * self.derived.w / ROOTS / f32(B), fixed: false)
            } else if self.moving {
                self.bounded(field)
                self.laid(self.grid.cell, fixed: true)
            }
            self.roots_kept = 0
            self.slots_most = 0
            self.nodes_most = 0
            self.free_slots = 0
            self.stage = 4
            return
        }
        if self.moving {
            // Its roots again where it now is, each answered by its parts: no cells.
            if self.stage != 5 {
                self.stage = 5
                print(f"engine::matter: a moving thing{held(self.held_asks)}: {self.grid.size.x}^3 roots ({self.grid.brick} m each), each answered by its live parts; no cells")
            }
            self.bounded(field)
            self.laid(self.grid.cell, fixed: true)
            self.grid.still = 0
            self.grid.kept = 0
            self.roots_kept = 0
            self.slots_most = 0
            self.nodes_most = 0
            self.free_slots = 0
            let n = self.grid.size.x * self.grid.size.y * self.grid.size.z
            label("deposit roots")
            var r: u32 = 0
            while r < n {
                dispatch(coarsed.bind(field: field, g: self.grid, weights: self.weights.items(), first: r, roots: mut self.roots, bricks: mut self.bricks), over: min(ROOT_BAND, n - r))
                r += ROOT_BAND
            }
            self.clear_roots()
            return
        }
        if self.stage == 0 {
            self.laid(2.0 * self.derived.w / ROOTS / f32(B), fixed: false)
            let n = self.grid.size.x * self.grid.size.y * self.grid.size.z
            self.slots_most = STILL_SLOTS
            self.nodes_most = STILL_NODES
            self.roots = buffer(ROOT * n)
            self.bricks = append_buffer(self.slots_most)
            self.grid.kept = self.slots_most
            self.grid.still = 1
            self.cursor = 0
            self.stage = 1
        }
        let n = self.grid.size.x * self.grid.size.y * self.grid.size.z
        if self.stage == 1 {
            label("deposit roots")
            var b: u32 = 0
            while b < 32 && self.cursor < n {
                dispatch(coarsed.bind(field: field, g: self.grid, weights: self.weights.items(), first: self.cursor, roots: mut self.roots, bricks: mut self.bricks), over: min(ROOT_BAND, n - self.cursor))
                self.cursor += ROOT_BAND
                b += 1
            }
            if self.cursor >= n {
                self.clear_roots()
                self.counted = Some(read(self.bricks.count()))
                self.stage = 2
            }
            return
        }
        if self.stage == 2 {
            match mut self.counted {
                Some(p) => match p.poll() {
                    Some(Ok(c)) => {
                        let count = min(c[0], self.slots_most)
                        self.roots_kept = count
                        self.counted = None
                        if count == 0 {
                            // No root chose cells: none kept, no room.
                            self.slots_most = 0
                            self.nodes_most = 0
                            self.free_slots = 0
                            self.stage = 4
                            print(f"engine::matter: a still thing: {n} roots ({self.grid.brick} m each; derived bound {self.derived.w} m), every one that holds its surface answered by its parts{held(self.held_asks)}")
                            return
                        }
                        self.nodes = buffer(self.nodes_most * NODE)
                        self.cells = buffer(self.slots_most * TEXELS)
                        self.flags = buffer_of(Vec::filled(self.nodes_most, 0))
                        self.stamps = buffer_of(Vec::filled(self.nodes_most, 0))
                        self.free = buffer(self.slots_most)
                        self.node_free = buffer(self.nodes_most / 8)
                        self.requests = append_buffer(65536)
                        self.pending = buffer(9 * BUDGET)
                        var st: Vec<u32> = Vec::filled(STATES, 0)
                        st[FREE_TOP] = self.slots_most - count
                        st[NODE_NEXT] = (count + 7) / 8 * 8
                        self.state = buffer_of(st)
                        self.free_slots = self.slots_most - count
                        dispatch(stacked.bind(first: count, count: self.slots_most - count, free: mut self.free), over: self.slots_most - count)
                        self.cursor = 0
                        self.stage = 3
                        let mb = f32(self.slots_most) * f32(TEXELS * 4) / 1048576.0 + f32(self.nodes_most) * f32(NODE * 4 + 8) / 1048576.0
                        print(f"engine::matter: a still thing: {count} root bricks of {n} answered by cells ({self.grid.brick} m each, cells {self.grid.cell} m; derived bound {self.derived.w} m), the rest that hold its surface by its parts{held(self.held_asks)}; room for {self.slots_most} bricks and {self.nodes_most} nodes, {mb} MB")
                    },
                    _ => {},
                },
                None => {},
            }
            return
        }
        if self.stage == 3 {
            label("deposit root cells")
            let texels = self.roots_kept * TEXELS
            var b: u32 = 0
            while b < 8 && self.cursor < texels {
                dispatch(deposited.bind(field: field, g: self.grid, bricks: self.bricks.items(), count: self.bricks.count(), first: self.cursor, cells: mut self.cells), over: min(BAND, texels - self.cursor))
                self.cursor += BAND
                b += 1
            }
            if self.cursor >= texels {
                var r: u32 = 0
                while r < self.roots_kept {
                    dispatch(rooted.bind(field: field, g: self.grid, bricks: self.bricks.items(), count: self.bricks.count(), first: r, nodes: mut self.nodes), over: min(BAND, self.roots_kept - r))
                    r += BAND
                }
                label("cells measured")
                let cells_at = self.roots_kept * B * B * B
                r = 0
                while r < cells_at {
                    dispatch(measured_roots.bind(field: field, g: self.grid, count: self.bricks.count(), first: r, cells: self.cells.items(), nodes: mut self.nodes, roots: mut self.roots), over: min(BAND, cells_at - r))
                    r += BAND
                }
                self.stage = 4
            }
        }
    }

    /// After a frame: where the picture showed this thing finer than its cells hold
    /// (`asks`: places and the sizes they were asked at), splits asked for and made, at most
    /// `BUDGET`; and, room running low, bricks long unasked folded back.
    pub fn refine<M: Field<Substance>>(mut self, field: M, asks: Texture<Rgba32Float>) {
        if self.roots_kept == 0 || self.moving || self.stage != 4 || self.held_cell > 0.0 {
            // (A cell held to a size, to measure, is not refined.)
            return
        }
        label("cells refined")
        self.requests.clear()
        dispatch(
            refined.bind(
                asks: asks,
                g: self.grid,
                roots: self.roots.items(),
                nodes: self.nodes.items(),
                flags: mut self.flags,
                stamps: mut self.stamps,
                requests: mut self.requests,
            ),
            groups: ((asks.width() + 7) / 8, (asks.height() + 7) / 8, 1),
        )
        label("cells split")
        dispatch(
            allotted.bind(count: self.requests.count(), nodes_most: self.nodes_most, state: mut self.state, free: self.free.items(), node_free: self.node_free.items(), pending: mut self.pending),
            over: BUDGET,
        )
        dispatch(
            split.bind(field: field, g: self.grid, requests: self.requests.items(), count: self.requests.count(), pending: self.pending.items(), nodes: mut self.nodes, state: mut self.state, free: mut self.free),
            over: 8 * BUDGET,
        )
        label("cells filled")
        var first: u32 = 0
        while first < 8 * BUDGET * TEXELS {
            dispatch(
                filled.bind(field: field, g: self.grid, count: self.requests.count(), pending: self.pending.items(), nodes: self.nodes.items(), first: first, cells: mut self.cells),
                over: min(BAND, 8 * BUDGET * TEXELS - first),
            )
            first += BAND
        }
        label("cells measured")
        first = 0
        while first < 8 * BUDGET * B * B * B {
            dispatch(
                measured.bind(field: field, g: self.grid, count: self.requests.count(), pending: self.pending.items(), first: first, cells: self.cells.items(), nodes: mut self.nodes),
                over: min(BAND, 8 * BUDGET * B * B * B - first),
            )
            first += BAND
        }
        label("cells split")
        dispatch(published.bind(requests: self.requests.items(), count: self.requests.count(), pending: self.pending.items(), nodes: mut self.nodes, flags: mut self.flags), over: 65536)
        // Room: the free slots read back now and then; folding while they are few.
        match mut self.stated {
            Some(p) => match p.poll() {
                Some(Ok(v)) => {
                    self.free_slots = v[FREE_TOP]
                    self.folding = v[FREE_TOP] < LOW
                    if v[REFUSED] > 0 && self.frame % 120 == 0 {
                        print(f"engine::matter: splits refused for want of room so far: {v[REFUSED]} ({v[FREE_TOP]} slots free)")
                    }
                    self.stated = None
                },
                _ => {},
            },
            None => {
                self.stated = Some(read(self.state.items()))
            },
        }
        if self.folding {
            label("cells folded")
            var n: u32 = 0
            while n < self.nodes_most {
                dispatch(
                    folded.bind(g: self.grid, first: n, most: self.nodes_most, nodes: mut self.nodes, stamps: self.stamps.items(), state: mut self.state, free: mut self.free, node_free: mut self.node_free),
                    over: min(BAND * 4, self.nodes_most - n),
                )
                n += BAND * 4
            }
        }
    }

    /// The bytes its cells hold (slots and nodes in use, from the last read), and its room.
    pub fn bytes(self) -> (f32, f32) {
        let used = f32(self.slots_most - self.free_slots)
        (used * f32(TEXELS * 4), f32(self.slots_most) * f32(TEXELS * 4) + f32(self.nodes_most) * f32(NODE * 4 + 8))
    }
}
