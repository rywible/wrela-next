// How heavy matter is: its density, as a channel of a field (`shape.with(density(985.0))`). It
// is kept apart from `substance::Substance`, which says only how matter answers light: a field
// that is drawn carries a substance, a field that is weighed (a body's segments,
// `body::mass`) carries a density, and the two are the same shapes with different channels.
// Where two shapes join smoothly their densities blend across the join, as their shapes do.

use std::cmp::Eq
use std::field::Blend
use std::hash::StateHash

/// The mass of a cubic metre of matter (kg/m³).
pub struct Density: Copy + GpuData + Blend + Eq + StateHash {
    pub kg_m3: f32,
}

/// Matter of `kg_m3` kilograms a cubic metre.
pub fn density(kg_m3: f32) -> Density {
    Density { kg_m3 }
}
