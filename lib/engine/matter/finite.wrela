// Finite values for shading: a direction that is a unit vector whatever comes in, and a channel
// or a light held to its physical range, a NaN or an infinity taken to a stated fallback.

/// `v` as a unit vector, or `fallback` as one where `v` is near zero or not finite (and up, +y,
/// where both are).
pub fn normalize_safe(v: vec3, fallback: vec3) -> vec3 {
    let l2 = dot(v, v)
    if l2 > 1.0e-12 && l2 < 1.0e30 {
        return v * (1.0 / sqrt(l2))
    }
    let fl2 = dot(fallback, fallback)
    if fl2 > 1.0e-12 && fl2 < 1.0e30 { fallback * (1.0 / sqrt(fl2)) } else { vec3(0.0, 1.0, 0.0) }
}

/// `x` clamped to `[lo, hi]`, or `fallback` where it is a NaN or past `1e30` either way.
pub fn finite_clamp(x: f32, lo: f32, hi: f32, fallback: f32) -> f32 {
    if x == x && x >= -1.0e30 && x <= 1.0e30 {
        clamp(x, lo, hi)
    } else {
        fallback
    }
}

/// Linear light as finite and never negative: each channel in `[0, 1e6]`, one that is a NaN or
/// past `1e30` taken to 0.
pub fn finite_light(rgb: vec3) -> vec3 {
    vec3(
        finite_clamp(rgb.x, lo: 0.0, hi: 1.0e6, fallback: 0.0),
        finite_clamp(rgb.y, lo: 0.0, hi: 1.0e6, fallback: 0.0),
        finite_clamp(rgb.z, lo: 0.0, hi: 1.0e6, fallback: 0.0),
    )
}

@test
fn finite_values_hold_their_ranges() {
    let n_zero = normalize_safe(vec3(0.0), vec3(0.0, 0.0, 1.0))
    assert(abs(length(n_zero) - 1.0) < 1.0e-5, "a zero vector must normalize to its fallback")
    let n_huge = normalize_safe(vec3(1.0e20, 0.0, 0.0), vec3(0.0, 1.0, 0.0))
    assert(abs(length(n_huge) - 1.0) < 1.0e-5, "an overflowing vector must normalize to its fallback")
    let lit = finite_light(vec3(-5.0, 1.0e35, 2.5))
    assert(lit.x == 0.0 && lit.y == 0.0 && abs(lit.z - 2.5) < 1.0e-6, "out of range or negative light")
    let ok = finite_light(vec3(0.25, 2.5, 100.0))
    assert(
        abs(ok.x - 0.25) < 1.0e-6 && abs(ok.y - 2.5) < 1.0e-6 && abs(ok.z - 100.0) < 1.0e-6,
        "finite light that is never negative is kept",
    )
}
