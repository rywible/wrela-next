// Participating media (`Medium`): fog, mist, smoke, fire, spell plumes. Authors write pure math
// over world position `p`; the engine realises any `Medium` through its unified froxel volume,
// lit by the exact same shadow map and radiance cache as solid matter.

/// Volumetric optical properties at a point in space.
pub struct MediumSample: Copy + GpuData {
    /// Single-scattering albedo (linear RGB in `[0, 1]`).
    pub albedo: vec3,
    /// Extinction coefficient (m⁻¹); 0.0 is clear air.
    pub density: f32,
    /// Volumetric emission (linear radiance per metre, e.g. fire or spell glow).
    pub emits: vec3,
    /// Henyey-Greenstein phase anisotropy `g` in `(-1, 1)` (0 isotropic, ~0.6 forward mist).
    pub g: f32,
}

/// Empty medium sample (zero density, zero emission).
pub fn empty_medium() -> MediumSample {
    MediumSample { density: 0.0, albedo: vec3(0.0), emits: vec3(0.0), g: 0.0 }
}

/// Any participating medium field over 3D world space.
pub trait Medium: Copy {
    /// Whether this medium has any non-zero density or emission (`false` skips volumetric passes).
    fn active(self) -> bool

    /// Optical properties at world point `p`.
    fn sample_at(self, p: vec3) -> MediumSample
}

/// Empty medium (no fog, mist, or volumetric plumes; zero runtime cost).
pub struct NoMedium: Copy + GpuData {}

impl Medium for NoMedium {
    fn active(self) -> bool {
        false
    }

    fn sample_at(self, _p: vec3) -> MediumSample {
        empty_medium()
    }
}
