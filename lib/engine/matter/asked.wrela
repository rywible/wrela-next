// Matter as GPU code asks it (docs/design.md, "The engine's four modules": matter). Four
// questions, and nothing of how they are answered: how far along a ray it may go and not pass
// matter (`step`), how far matter is (`far`, under 0 inside), which way it faces (`facing`), and
// what it is made of (`made_of`). A thing (`Seen`) answers by its field or by its cells, as the
// engine chose for it (`cells`): by its field, its value over its steepness everywhere in its
// grid; by its cells, where a brick holds nothing the ray goes to the brick's far side (or as far
// as the brick's middle says the surface is), and in a kept brick by the cells' distance. A world
// of things (`Both`) answers for whichever thing is nearer. A field's raw value is read only here, and always divided by the
// steepness its field states, so a distance never runs past the true one where the field answers.

use matter::cells::{ASKS_CELLS, B, Grid, NO_BRICK}
use matter::substance::Substance
use std::field::Field
use std::gpu::{Rg32Uint, Rgba16Float, Sampler, Texture3d}

/// Matter as the engine's own groups answer, told which of its things (a bit each, the first the
/// lowest) are asked by their cells: a number the draw gives as a constant (a pipeline for each),
/// so a thing asked by its cells carries no code of its field's into the ray's pipeline, nor one
/// asked by its field any of its cells'. `Chosen` puts the number with the group.
pub trait Answers: Copy {
    fn count(self) -> u32
    fn step_by(self, p: vec3, d: vec3, inv: vec3, cells: u32) -> vec2
    fn far_by(self, p: vec3, cells: u32) -> f32
    fn facing_by(self, p: vec3, came: vec3, cells: u32) -> vec3
    fn made_of(self, p: vec3) -> Substance
    fn span(self, o: vec3, d: vec3) -> vec2
}

/// Matter as GPU code asks it.
pub trait Asked: Copy {
    /// How far along `d` (unit; `inv` its reciprocal, each axis) from `p` a ray may go and not
    /// pass matter (`x`), and how far matter is from `p` at the least (`y`: under 0 inside).
    /// Where cells answer, both are the cells' (as near the surface as the cells hold it).
    fn step(self, p: vec3, d: vec3, inv: vec3) -> vec2

    /// How far matter is from `p` (under 0 inside), as `step`'s `y`.
    fn far(self, p: vec3) -> f32

    /// Which way matter faces at `p` on its surface (unit, out of it); `came` (unit) where it
    /// can't say.
    fn facing(self, p: vec3, came: vec3) -> vec3

    /// What matter is made of at `p`.
    fn made_of(self, p: vec3) -> Substance

    /// Where a ray from `o` along `d` (unit) is within reach of matter at all (m along it: `x`
    /// in, `y` out; `y` under `x` where it never is).
    fn span(self, o: vec3, d: vec3) -> vec2
}

/// One thing as GPU code asks it: its field, its grid, its cells.
pub borrow struct Seen<M: Field<Substance>> {
    pub(package) field: M,
    pub(package) grid: Grid,
    pub(package) coarse: borrow Texture3d<Rg32Uint>,
    pub(package) atlas: borrow Texture3d<Rgba16Float>,
    pub(package) s: borrow Sampler,
}

/// Where a ray from `o` along `d` enters and leaves the box from `lo` to `hi` (m along it).
pub fn box_span(o: vec3, d: vec3, lo: vec3, hi: vec3) -> vec2 {
    box_crossed(o, vec3(1.0) / d, lo, hi)
}

/// The same, given the ray's way's reciprocal (`inv`) once for all its steps.
pub fn box_crossed(o: vec3, inv: vec3, lo: vec3, hi: vec3) -> vec2 {
    let a = (lo - o) * inv
    let b = (hi - o) * inv
    let near = min(a, b)
    let far = max(a, b)
    vec2(max(max(near.x, near.y), near.z), min(min(far.x, far.y), far.z))
}

impl<M: Field<Substance>> Seen<M> {
    /// The answer at `p`, going along `d` (`along` false: no way, so an empty brick says only how
    /// far its middle says the surface is).
    fn answer(self, p: vec3, d: vec3, inv: vec3, along: bool, by_cells: bool) -> vec2 {
        let g = self.grid
        let brick = g.brick
        let hi = g.hi
        let outside = max(g.lo - p, p - hi)
        if max(outside.x, max(outside.y, outside.z)) > 0.0 {
            // Outside its grid, which holds all of it: at least as far as the grid is.
            let clear = length(max(outside, vec3(0.0))) + g.nudge.x
            return vec2(clear, clear)
        }
        if !by_cells {
            // A thing asked by its field: its value over its steepness, never past its surface.
            // (Its cells would only slow a ray: an empty brick says less than the field does.)
            let f = clamp(self.field.distance(p), -g.scope, g.scope) / g.steep
            return vec2(f, f)
        }
        let q = (p - g.lo) / brick
        let c = clamp(floor(q), vec3(0.0), g.top)
        let k = self.coarse.load(u32(c.x), u32(c.y), u32(c.z))
        if k.x == NO_BRICK {
            // A brick that holds no surface: its middle's distance less how far `p` is from it,
            // and, going along `d`, its far side.
            let mid = g.lo + (c + vec3(0.5)) * brick
            let at_mid = bitcast_f32(k.y)
            let off = length(p - mid)
            if at_mid < 0.0 {
                let inside = min(at_mid + off, -1.0e-6)
                return vec2(inside, inside)
            }
            let lower = max(at_mid - off, 0.0)
            if !along {
                return vec2(lower, lower)
            }
            let cell_lo = g.lo + c * brick
            let s = box_crossed(p, inv, cell_lo, cell_lo + vec3(brick))
            return vec2(max(s.y + g.nudge.x, lower), lower)
        }
        let v = self.cell_at(k.x, q, c)
        vec2(v.x, v.x)
    }

    /// What the cells hold at `q` (in bricks) in the brick `c`, kept in slot `slot`: the
    /// distance and the facing, read between the eight texels round it.
    fn cell_at(self, slot: u32, q: vec3, c: vec3) -> vec4 {
        let a = vec3(f32(slot % 64), f32((slot / 64) % 64), f32(slot / 4096)) * f32(B + 1)
        let local = clamp((q - c) * f32(B), vec3(0.0), vec3(f32(B)))
        self.atlas.sample_level(self.s, (a + local + vec3(0.5)) / self.grid.atlas, 0.0)
    }
}

impl<M: Field<Substance>> Answers for Seen<M> {
    fn count(self) -> u32 {
        1
    }

    fn step_by(self, p: vec3, d: vec3, inv: vec3, cells: u32) -> vec2 {
        self.answer(p, d, inv, along: true, by_cells: (cells & 1) != 0)
    }

    fn far_by(self, p: vec3, cells: u32) -> f32 {
        self.answer(p, vec3(0.0, 1.0, 0.0), vec3(1.0e30, 1.0, 1.0e30), along: false, by_cells: (cells & 1) != 0).y
    }

    fn facing_by(self, p: vec3, came: vec3, cells: u32) -> vec3 {
        let g = self.grid
        if (cells & 1) != 0 {
            let q = (p - g.lo) / g.brick
            let c = clamp(floor(q), vec3(0.0), g.top)
            let k = self.coarse.load(u32(c.x), u32(c.y), u32(c.z))
            if k.x != NO_BRICK {
                let n = self.cell_at(k.x, q, c).yzw
                if dot(n, n) > 1.0e-8 {
                    return normalize(n)
                }
            }
            return came
        }
        // (Where the field's own gradient vanishes, back along the ray: asking its value to each
        // side would put six more asks of a dear field into every pixel's code.)
        let grad = self.field.gradient(p)
        if dot(grad, grad) > 1.0e-8 {
            return normalize(grad)
        }
        came
    }

    fn made_of(self, p: vec3) -> Substance {
        self.field.channels(p)
    }

    fn span(self, o: vec3, d: vec3) -> vec2 {
        box_span(o, d, self.grid.lo, self.grid.hi)
    }
}

/// Two worlds as GPU code asks them: whichever is nearer answers.
pub borrow struct Both<A: Answers, B: Answers> {
    pub(package) a: A,
    pub(package) b: B,
}

impl<A: Answers, B: Answers> Answers for Both<A, B> {
    fn count(self) -> u32 {
        self.a.count() + self.b.count()
    }

    fn step_by(self, p: vec3, d: vec3, inv: vec3, cells: u32) -> vec2 {
        let x = self.a.step_by(p, d, inv, cells)
        let y = self.b.step_by(p, d, inv, cells >> self.a.count())
        vec2(min(x.x, y.x), min(x.y, y.y))
    }

    fn far_by(self, p: vec3, cells: u32) -> f32 {
        min(self.a.far_by(p, cells), self.b.far_by(p, cells >> self.a.count()))
    }

    fn facing_by(self, p: vec3, came: vec3, cells: u32) -> vec3 {
        if self.a.far_by(p, cells) <= self.b.far_by(p, cells >> self.a.count()) {
            self.a.facing_by(p, came, cells)
        } else {
            self.b.facing_by(p, came, cells >> self.a.count())
        }
    }

    fn made_of(self, p: vec3) -> Substance {
        if self.a.far_by(p, 0) <= self.b.far_by(p, 0) { self.a.made_of(p) } else { self.b.made_of(p) }
    }

    fn span(self, o: vec3, d: vec3) -> vec2 {
        let x = self.a.span(o, d)
        let y = self.b.span(o, d)
        if x.y < x.x {
            return y
        }
        if y.y < y.x {
            return x
        }
        vec2(min(x.x, y.x), max(x.y, y.y))
    }
}

/// A world's group with which of its things are asked by their cells (`C`, a bit a thing, the
/// first the lowest), as a constant of its type (`Answers`): what GPU code asks (`Asked`). A
/// pipeline for each `C`: a thing asked by its cells carries no code of its field's into it.
pub borrow struct Chosen<W: Answers, const C: u32> {
    pub(package) w: W,
}

impl<W: Answers, const C: u32> Asked for Chosen<W, C> {
    fn step(self, p: vec3, d: vec3, inv: vec3) -> vec2 {
        self.w.step_by(p, d, inv, C)
    }

    fn far(self, p: vec3) -> f32 {
        self.w.far_by(p, C)
    }

    fn facing(self, p: vec3, came: vec3) -> vec3 {
        self.w.facing_by(p, came, C)
    }

    fn made_of(self, p: vec3) -> Substance {
        self.w.made_of(p)
    }

    fn span(self, o: vec3, d: vec3) -> vec2 {
        self.w.span(o, d)
    }
}
