// Matter as GPU code asks it (docs/design.md, "The engine's four modules": matter). Four
// questions, and nothing of how they are answered: how far along a ray it may go and not pass
// matter (`step`), how far matter is (`far`, under 0 inside), which way it faces (`facing`), and
// what it is made of (`made_of`). Each ask says how finely it is asked (`size`, m: whoever asks
// knows; matter never sees the eye).
//
// One way of asking. A thing's grid of roots says, a root at a time, who answers there (`cells`,
// `coarsed`): nothing (an empty root: a ray crosses it and the empty roots round it in a stride,
// unasked), the parts of its field that can matter there (`Surface::distance_live` of the root's
// mask; its whole field where every part can), or its cells (the finest brick of its tree there
// no coarser than `size`, its distance read between the eight texels round the point). A ray
// walks the roots (`Walk`): a root is fetched once, as the ray enters it, and the steps inside it
// read only what the fetch kept. The picture draws each thing by itself (`world::Each`). A
// field's raw value is read only here and in `cells`, always divided by a steepness.

use matter::cells::{B, CELL_PER_SIZE, EMPTY, Grid, HOLDS, LEVELS, NODE, NONE, NO_BRICK, ROOT, brick_crossed, read_cells, read_distance}
use matter::substance::Substance
use std::derive::gradient
use std::field::{Field, Live, live_along}
use std::gpu::GpuSpan

/// Every part of a field live (a root's mask: `coarsed` sets the bits past its parts).
const ALL: u32 = 4294967295

/// The ways a thing can be answered, a constant of its type (`Seen`'s `W`), chosen once a thing
/// (`cells::Kept::ways`): its whole field alone, no root ever fetched (`WHOLE`); the walk, its
/// roots answered by their live parts or its whole field (`PARTS`); the walk with its cells too
/// (`CELLS`); its whole field, and a ray begins where the thing says in closed form, exactly, it
/// first meets it (`MET`: `Surface::meets`). Which of them answers in a root stays a word of the
/// root.
pub const WHOLE: u32 = 0
pub const PARTS: u32 = 1
pub const CELLS: u32 = 2
pub const MET: u32 = 3

/// A step's answer (`Asked::step`): how far along the ray it may go (`x`) and how far matter is at
/// the least (`y`, under 0 inside), and the walk to the next step.
pub struct Stepped<K: Copy>: Copy {
    pub x: f32,
    pub y: f32,
    pub walk: K,
}

/// Matter as GPU code asks it.
pub trait Asked: Copy {
    /// Where a ray is in the world's roots: what `step` fetched and keeps, opaque to the ray.
    type Walk: Copy

    /// Where a ray from `o` along `d` (unit), `wide` m across at `o` and widening `spread` m a
    /// metre, can meet matter (`near` to `far`, m along it; `far` under `near` where it never
    /// can), and the walk it starts with (a ray that goes back starts it again). A ray is told
    /// how nearly it passes matter within half its width.
    fn begun(self, o: vec3, d: vec3, wide: f32, spread: f32) -> Begun<Self::Walk>

    /// How far along `d` (unit; `inv` its reciprocal, each axis) from `p`, `t` m along the ray,
    /// a ray may go and not pass matter (`x`), and how far matter is from `p` at the least (`y`:
    /// under 0 inside), asked `size` m finely. A walk only goes forward: `t` never less than the
    /// last step's.
    fn step(self, walk: Self::Walk, p: vec3, d: vec3, inv: vec3, t: f32, size: f32) -> Stepped<Self::Walk>

    /// How far matter is from `p` (under 0 inside), as `step`'s `y`, at a point near where the
    /// walk `walk` is, `t` m along its ray (between its last two steps, or where it ended),
    /// asked through what the walk fetched: no fetch.
    fn far(self, walk: Self::Walk, p: vec3, t: f32, size: f32) -> f32

    /// Which way matter faces at `p` on its surface (unit, out of it), where the walk ended (as
    /// `far`); `came` (unit) where it can't say.
    fn facing(self, walk: Self::Walk, p: vec3, t: f32, came: vec3, size: f32) -> vec3

    /// What matter is made of at `p`, where the walk ended (as `far`).
    fn made_of(self, walk: Self::Walk, p: vec3, t: f32) -> Substance

    /// An instrument (the ray trace): what the walk `walk` holds at `p`, asked `size` m finely.
    fn told(self, walk: Self::Walk, p: vec3, size: f32) -> Told

    /// Where the surface its walk `walk` reached lies between `p` (outside it) and `span` m on along
    /// `d` (unit), asked `size` m finely: m from `p`, found outright where it can say (a brick of
    /// cells the walk keeps: the cubic its mix less the brick's lowering is along the ray, solved
    /// in its cells, `cells::brick_crossed`), else -1 (the ray halves the span: `ray::met`).
    fn crossed(self, walk: Self::Walk, p: vec3, d: vec3, span: f32, size: f32) -> f32

    /// How many of its parts it gives as round cones inside them (`cone`: a moving thing's, so
    /// what it hides of the sky can be found in closed form), at most 31; 0 for none.
    fn cones(self) -> u32

    /// Part `i` as a round cone inside it (`cone_of`).
    fn cone(self, i: u32) -> Cone

    /// How far past its parts the joins above them can raise its surface (the most of std's
    /// `PartBound::lowers`): the flesh round its cones (0 where it gives none).
    fn flesh(self) -> f32

    /// The least value its field takes along the ray from `o` along `d` (unit), `spread` m wide a
    /// metre, near where it can be seen from a pixel that shows what is `until` m along it
    /// (`least_by`).
    fn least(self, o: vec3, d: vec3, until: f32, spread: f32) -> Least
}

/// The least value of a thing's field along a pixel's ray (`Asked::least`): where along it (`t`,
/// m), the value there (`g`, m: under 0 inside), the field's facing there (`n`, unnormalised),
/// and what it is (`LEAST_*`).
pub struct Least: Copy {
    pub t: f32,
    pub g: f32,
    pub n: vec3,
    pub state: u32,
}

/// What a `Least` is: nothing to say (the thing is behind what the pixel shows, or far from its
/// ray); the least of a thing the ray passes before what it shows; of the thing it shows (from its
/// hit on, inside it); a thing the ray goes through before what it shows, that the march passed
/// by; a thing whose field says only its bound (not known near it).
pub const LEAST_NONE: u32 = 0
pub const LEAST_PASSED: u32 = 1
pub const LEAST_SHOWN: u32 = 2
pub const LEAST_MISSED: u32 = 3
pub const LEAST_UNSURE: u32 = 4

/// The least value `field` takes along the ray from `o` along `d` (unit), `spread` m wide a metre,
/// near what a pixel showing what is `until` m along it can see (its values over `stated`:
/// `Asked::least`). The one place it is asked:
/// - the thing the pixel shows (its value within half the ray's width at `until`): from there on,
///   steps that double until the value rises again, the least between by golden sections;
/// - else std's `Surface::passes` (exact in closed form for std's shapes and sharp unions; a
///   smooth union's bound refined by `Pass::refined`, asked round it within half the ray's width):
///   before `until`, passed (or gone through, which the march passed by); past it, nothing;
/// - a field that answers only by its bound: unsure where that bound comes within `SURE` widths.
/// The facing is the field's gradient at the least place, over `stated` as the value is (the
/// envelope theorem turns it onto the screen: the least's change with the pixel). Its values are
/// `far`'s: the field's own, or a moving thing's over the parts its ray comes near (`Rayed`).
pub fn least_by<M: Field<Substance>, F: Copy + fn(vec3) -> f32>(field: M, far: F, o: vec3, d: vec3, until: f32, spread: f32, stated: f32) -> Least {
    let p0 = field.passes(o, d)
    if !p0.exact() && !(p0.blend > 0.0) {
        let t = max(p0.t, 1.0e-3)
        let state = if p0.distance / stated > SURE * spread * t { LEAST_NONE } else { LEAST_UNSURE }
        return Least { t, g: p0.distance / stated, n: vec3(0.0), state }
    }
    let at = far(o + d * until) / stated
    if at <= 0.5 * spread * until {
        // Its own: on from the hit by steps that double (from a tenth of the ray's width, or the
        // value there, the more) until the value rises again; then the least between the last
        // three by golden sections.
        var ta = until
        var fa = at
        var step = max(abs(at), 0.1 * spread * until)
        var tb = until + step
        var fb = far(o + d * tb) / stated
        var tc = tb
        var fc = fb
        if fb < fa {
            for _k in 0..LEAST_STEPS {
                step = 2.0 * step
                tc = tb + step
                fc = far(o + d * tc) / stated
                if fc >= fb {
                    break
                }
                ta = tb
                fa = fb
                tb = tc
                fb = fc
            }
        } else {
            tc = tb
            tb = ta
            fb = fa
        }
        // (The least lies between `ta` and `tc`; `tb` the least yet.)
        var lo = ta
        var hi = tc
        var t = tb
        var g = fb
        for _k in 0..LEAST_SECTIONS {
            let u = if t - lo > hi - t { t - 0.381966 * (t - lo) } else { t + 0.381966 * (hi - t) }
            let fu = far(o + d * u) / stated
            if fu < g {
                if u < t { hi = t } else { lo = t }
                t = u
                g = fu
            } else {
                if u < t { lo = u } else { hi = u }
            }
        }
        return Least { t, g, n: field.gradient(o + d * t) / stated, state: LEAST_SHOWN }
    }
    let p = p0.refined(o, d, far, 0.5 * spread * max(p0.t, 1.0e-3))
    if p.t > until {
        return Least { t: p.t, g: p.distance / stated, n: vec3(0.0), state: LEAST_NONE }
    }
    let state = if p.distance <= 0.0 { LEAST_MISSED } else { LEAST_PASSED }
    Least { t: p.t, g: p.distance / stated, n: field.gradient(o + d * p.t) / stated, state }
}

/// How many doubling steps past its hit a ray takes inside the thing it shows to bracket its
/// least, and golden sections within (`least_by`); and how near, in the ray's widths, a pass that
/// is only a bound says nothing.
const LEAST_STEPS: u32 = 12
/// How far from its ray (its widths) a part is asked for a moving thing's least (`Rayed::least`):
/// past the outline's reach (`pixels::REACH`, 1.5) and the ray's half width, with a width to spare.
const OUTLINE_REACH: f32 = 3.0
const LEAST_SECTIONS: u32 = 10
const SURE: f32 = 2.0

/// A leaf of a thing's tree of bricks (`Seen::leaf_at`): its node, least corner and side, and
/// whether it is a child that holds no surface.
pub struct Leaf: Copy {
    pub node: u32,
    pub lo: vec3,
    pub side: f32,
    pub empty: bool,
}

/// A round cone (the hull of a sphere of radius `ra` at `a` and one of `rb` at `b`).
pub struct Cone: Copy + GpuData {
    pub a: vec3,
    pub ra: f32,
    pub b: vec3,
    pub rb: f32,
}

/// Part `i` of `field` as a round cone inside it: std's `part_bound` segment, each end's sphere as
/// deep as the part alone is there (inside a convex part: a round cone part is itself).
pub fn cone_of<M: Field<Substance>>(field: M, i: u32) -> Cone {
    let c = field.part_bound(i)
    var w = vec4u(0)
    let bit = u32(1) << (i & 31)
    if i < 32 { w.x = bit } else if i < 64 { w.y = bit } else if i < 96 { w.z = bit } else { w.w = bit }
    let only = Live { words: w }
    Cone { a: c.a, ra: max(-field.distance_live(c.a, only), 0.0), b: c.b, rb: max(-field.distance_live(c.b, only), 0.0) }
}

/// Where the ray from `o` along `d` (unit) first enters the round cone `c` (m along it), or -1
/// where it never does: the tangent cone's body, else the nearer sphere (I. Quilez,
/// "Intersectors", the rounded cone; docs/citations.md).
pub fn cone_met(o: vec3, d: vec3, c: Cone) -> f32 {
    let a = c.a
    let b = c.b
    let ra = c.ra
    let rb = c.rb
    let ba = b - a
    let oa = o - a
    let ob = o - b
    let rr = ra - rb
    let m0 = dot(ba, ba)
    let m1 = dot(ba, oa)
    let m2 = dot(ba, d)
    let m3 = dot(d, oa)
    let m5 = dot(oa, oa)
    let m6 = dot(ob, d)
    let m7 = dot(ob, ob)
    if m0 > 1.0e-12 {
        let d2 = m0 - rr * rr
        let k2 = d2 - m2 * m2
        let k1 = d2 * m3 - m1 * m2 + m2 * rr * ra
        let k0 = d2 * m5 - m1 * m1 + m1 * rr * ra * 2.0 - m0 * ra * ra
        let h = k1 * k1 - k0 * k2
        if h < 0.0 {
            return -1.0
        }
        if abs(k2) > 1.0e-12 {
            let t = (-sqrt(h) - k1) / k2
            let y = m1 - ra * rr + t * m2
            if y > 0.0 && y < d2 {
                return t
            }
        }
    }
    var best = -1.0
    let h1 = m3 * m3 - m5 + ra * ra
    let h2 = m6 * m6 - m7 + rb * rb
    if h1 > 0.0 {
        best = -m3 - sqrt(h1)
    }
    if h2 > 0.0 {
        let t2 = -m6 - sqrt(h2)
        if best < 0.0 || (t2 >= 0.0 && t2 < best) {
            best = t2
        }
    }
    best
}

/// Things of one kind as GPU code asks them, all at once (`world::Each::kind`): each as `Asked`
/// (`one`), and where each one's matter can be (`bound`: a cube, centre and half its side).
pub trait Kinded: Copy {
    type One: Asked

    fn one(self, i: u32) -> Self::One

    fn bound(self, i: u32) -> vec4
}

/// Things of one kind that keep no roots (answered `WHOLE` or `MET`), as GPU code asks them: their
/// fields, grids and bounds in buffers, the `i`th asked as `Seen` asks one.
pub borrow struct Seens<M: Field<Substance> + GpuData, const W: u32> {
    pub(package) fields: GpuSpan<M>,
    pub(package) grids: GpuSpan<Grid>,
    pub(package) bounds: GpuSpan<vec4>,
}

/// A thing that keeps no roots (answered `WHOLE` or `MET`, its `W`) as GPU code asks it: its field
/// and grid, a plain value (a group of bindings, as `Seen` is, can't be built from an index in GPU
/// code: so a kind's `one` hands this). `Seen` answers such a thing through it: one way.
pub struct Lone<M, const W: u32>: Copy {
    pub(package) field: M,
    pub(package) grid: Grid,
}

impl<M: Field<Substance>, const W: u32> Lone<M, W> {
    /// Its whole field's value over the steepness std's shapes state, never past its surface.
    fn lone_at(self, p: vec3) -> f32 {
        let g = self.grid
        clamp(self.field.distance(p), -g.scope, g.scope) / g.stated
    }

    // (Its answers as plain functions, which `Seen` calls too: `Lone<M, W>::Walk` is not seen to
    // be `Within` in generic code.)
    fn lone_begun(self, o: vec3, d: vec3, wide: f32, spread: f32) -> Begun<Within> {
        // Within its grid; and, a thing that says exactly where a ray first meets it (`MET`:
        // `Surface::meets`, std's, in closed form through its combinators), there, unmarched;
        // where it misses, the ray marches only where the thing grown by as much as the ray must
        // be told of (half its widest width over the grid, for its near misses) can be.
        let g = self.grid
        let box = box_span(o, d, g.lo, g.hi)
        var near = box.x
        var far = box.y
        var k = Within { exit: -1.0, node: NO_BRICK, mask: 0, steep: 1.0, leaf: NONE }
        if W == MET && M::EXACT_MEETS && box.y >= box.x && box.y >= 0.0 {
            let m = self.field.meets(o, d)
            if m.exact() && m.near <= m.far {
                near = m.near
                far = m.far
                k = Within { exit: m.near, node: HIT, mask: ALL, steep: 1.0, leaf: NONE }
            } else {
                let grow = 0.5 * (wide + spread * max(box.y, 0.0))
                let n = self.field.meets_grown(o, d, grow, 0.0)
                near = max(near, n.near)
                far = min(far, n.far)
            }
        }
        Begun { near, far, walk: k }
    }

    fn lone_step(self, walk: Within, p: vec3, d: vec3, inv: vec3, t: f32, size: f32) -> Stepped<Within> {
        // (Met where the thing says, and inside from there; else its whole field.)
        let f = if W == MET && walk.node == HIT { if t >= walk.exit { -1.0e-6 } else { walk.exit - t } } else { self.lone_at(p) }
        Stepped { x: f, y: f, walk }
    }

    fn lone_far(self, walk: Within, p: vec3, t: f32, size: f32) -> f32 {
        self.lone_at(p)
    }
}

impl<M: Field<Substance>, const W: u32> Asked for Lone<M, W> {
    type Walk = Within

    fn begun(self, o: vec3, d: vec3, wide: f32, spread: f32) -> Begun<Within> {
        self.lone_begun(o, d, wide, spread)
    }

    fn step(self, walk: Within, p: vec3, d: vec3, inv: vec3, t: f32, size: f32) -> Stepped<Within> {
        self.lone_step(walk, p, d, inv, t, size)
    }

    fn far(self, walk: Within, p: vec3, t: f32, size: f32) -> f32 {
        self.lone_far(walk, p, t, size)
    }

    fn facing(self, walk: Within, p: vec3, t: f32, came: vec3, size: f32) -> vec3 {
        let grad = self.field.gradient(p)
        if dot(grad, grad) > 1.0e-8 {
            return normalize(grad)
        }
        came
    }

    fn made_of(self, walk: Within, p: vec3, t: f32) -> Substance {
        self.field.channels(p)
    }

    fn cones(self) -> u32 {
        0
    }

    fn flesh(self) -> f32 {
        0.0
    }

    fn cone(self, i: u32) -> Cone {
        Cone { a: vec3(0.0), ra: 0.0, b: vec3(0.0), rb: 0.0 }
    }

    fn crossed(self, walk: Within, p: vec3, d: vec3, span: f32, size: f32) -> f32 {
        -1.0
    }

    fn least(self, o: vec3, d: vec3, until: f32, spread: f32) -> Least {
        let f = self.field
        least_by(f, |q: vec3| f.distance(q), o, d, until, spread, self.grid.stated)
    }

    fn told(self, walk: Within, p: vec3, size: f32) -> Told {
        let g = self.grid
        Told { node: walk.node, level: 0, side: 0.0, off: 0.0, cells: 0.0, field: clamp(self.field.distance(p), -g.scope, g.scope) / g.stated, exit: walk.exit, brick: 0 }
    }
}

impl<M: Field<Substance> + GpuData, const W: u32> Kinded for Seens<M, W> {
    type One = Lone<M, W>

    fn one(self, i: u32) -> Lone<M, W> {
        Lone { field: self.fields[i], grid: self.grids[i] }
    }

    fn bound(self, i: u32) -> vec4 {
        self.bounds[i]
    }
}

/// What a walk holds at a point (`Asked::told`, an instrument): its node (or the brick of cells
/// it reads there: its node, level, side, recorded error, and the cells' own distance; -1e9
/// where that is a child that holds no surface), the field's own distance there over the
/// steepness std's shapes state, and where along the ray the walk ends.
pub struct Told: Copy + GpuData {
    pub node: u32,
    pub level: u32,
    pub side: f32,
    pub off: f32,
    pub cells: f32,
    pub field: f32,
    pub exit: f32,
    pub brick: u32,
}

/// Where a ray can meet matter, and the walk it starts with (`Asked::begun`).
pub struct Begun<K: Copy>: Copy {
    pub near: f32,
    pub far: f32,
    pub walk: K,
}

/// A walk's node where the thing says in closed form where the ray first meets it (`exit`, m
/// along the ray: `Surface::meets`, exact): no march, no root.
const HIT: u32 = 4294967292

/// One thing as GPU code asks it, answered only the ways `W` says: its field, its grid, its cells
/// (roots, nodes, texels).
pub borrow struct Seen<M: Field<Substance>, const W: u32> {
    pub(package) field: M,
    pub(package) grid: Grid,
    pub(package) roots: GpuSpan<u32>,
    pub(package) nodes: GpuSpan<u32>,
    pub(package) cells: GpuSpan<u32>,
}

/// Where a ray is in one thing's roots: the roots it is in, as fetched (`node`: `HOLDS` answered by
/// its parts or its whole field, `NO_BRICK` holding nothing, else a brick of cells), their mask
/// (a brick of cells: the root's number) and steepness, and where along the ray they end (`exit`,
/// m; a step past it fetches again). Where they hold nothing, `steep` is how far matter was at
/// the least from where they were fetched, plus how far along the ray that was (so less how far
/// it has gone since, it still is); `mask` 1 there: all of it inside matter.
pub struct Within: Copy {
    pub exit: f32,
    pub node: u32,
    pub mask: u32,
    pub steep: f32,
    /// The leaf brick of cells its last step's descent found (`NONE`: none): a halving or the
    /// facing that a descent would bring to the same brick reads it with no descent
    /// (`Seen::leaf_holds`).
    pub leaf: u32,
}

/// Where a ray from `o` along `d` enters and leaves the box from `lo` to `hi` (m along it).
pub fn box_span(o: vec3, d: vec3, lo: vec3, hi: vec3) -> vec2 {
    box_crossed(o, vec3(1.0) / d, lo, hi)
}

/// The same, given the ray's way's reciprocal (`inv`) once for all its steps.
pub fn box_crossed(o: vec3, inv: vec3, lo: vec3, hi: vec3) -> vec2 {
    let a = (lo - o) * inv
    let b = (hi - o) * inv
    let near = min(a, b)
    let far = max(a, b)
    vec2(max(max(near.x, near.y), near.z), min(min(far.x, far.y), far.z))
}

/// How far `p` is inside the box `side` m a side from `lo`: its nearest face (0 outside). A box
/// that holds no surface holds no matter nearer `p` than that.
fn inside_by(p: vec3, lo: vec3, side: f32) -> f32 {
    let a = min(p - lo, lo + vec3(side) - p)
    max(min(a.x, min(a.y, a.z)), 0.0)
}

/// The roots at `p`, `t` m along a ray going `inv`, fetched: the walk in them. Its words read
/// at once (one wait for memory, not one a word); what it holds said by data, so the step
/// answers one way whatever it holds (`answered`).
pub fn fetched(roots: GpuSpan<u32>, g: Grid, p: vec3, inv: vec3, t: f32) -> Within {
    let outside = max(g.lo - p, p - g.hi)
    let out = max(outside.x, max(outside.y, outside.z)) > 0.0
    let r = root_of(g, p)
    let lo = root_lo(g, p)
    let node = roots[ROOT * r]
    let least = bitcast_f32(roots[ROOT * r + 1])
    let derived = bitcast_f32(roots[ROOT * r + 2])
    let clear = roots[ROOT * r + 3]
    let mask = roots[ROOT * r + 4]
    let region = roots[ROOT * r + 5]
    let empty = !out && node == NO_BRICK
    let whole = !out && node == HOLDS && mask == ALL
    // The roots the walk holds: outside the grid, the grid (on to where the ray enters it,
    // nothing of it along the ray where it never does; matter at least as far as the grid);
    // an empty root and the roots round it that hold nothing either (its clearance), crossed
    // unasked, matter at least as far as their nearest face; a root its whole field answers
    // and every root round it that is answered so or holds nothing (its second clearance),
    // crossed asking its whole field by the steepness std's shapes state over the whole grid,
    // fetching nothing; or the root alone.
    let reach = if empty { clear } else if whole { region } else { 1 }
    let e = f32(max(reach, 1) - 1) * g.brick
    let blo = if out { g.lo } else { lo - vec3(e) }
    let bhi = if out { g.hi } else { lo + vec3(g.brick + e) }
    let s = box_crossed(p, inv, blo, bhi)
    let clear_out = length(max(outside, vec3(0.0))) + g.nudge.x
    let gone = s.y < s.x || s.y < 0.0
    let x_out = if gone { 1.0e9 } else { max(s.x + g.nudge.x, clear_out) }
    let y_empty = inside_by(p, blo, g.brick + 2.0 * e)
    let steep = if whole { g.stated } else if derived > 0.0 { max(min(derived, g.stated), 1.0) } else { g.stated }
    // (Holding nothing, the walk says how far on and how far matter is, as `Within` says;
    // all inside, `mask` 1.)
    let none = out || empty
    Within {
        exit: t + (if out { x_out } else if empty { s.y + g.nudge.x } else { s.y }),
        node: if none { NO_BRICK } else { node },
        mask: if out { 0 } else if empty { if least < 0.0 { 1 } else { 0 } } else if node == HOLDS { mask } else { r },
        steep: if out { clear_out + t } else if empty { y_empty + t } else { steep },
        leaf: NONE,
    }
}

/// The root `p` is in (its number), given `p` is inside the grid `g`.
fn root_of(g: Grid, p: vec3) -> u32 {
    let c = clamp(floor((p - g.lo) / g.brick), vec3(0.0), g.top)
    u32(c.x) + g.size.x * (u32(c.y) + g.size.y * u32(c.z))
}

/// The root `p` is in, its least corner.
fn root_lo(g: Grid, p: vec3) -> vec3 {
    g.lo + clamp(floor((p - g.lo) / g.brick), vec3(0.0), g.top) * g.brick
}

impl<M: Field<Substance>, const W: u32> Seen<M, W> {
    /// Its whole field's value over the steepness std's shapes state, never past its surface.
    fn whole_at(self, p: vec3) -> f32 {
        self.lone().lone_at(p)
    }

    /// It as a thing that keeps no roots asks it (`Lone`).
    fn lone(self) -> Lone<M, W> {
        Lone { field: self.field, grid: self.grid }
    }

    /// Root `r`'s least corner.
    fn lo_of(self, r: u32) -> vec3 {
        let g = self.grid
        g.lo + vec3(f32(r % g.size.x), f32((r / g.size.x) % g.size.y), f32(r / (g.size.x * g.size.y))) * g.brick
    }

    /// Its field's distance at `p` by the parts `mask` names (all of it where all are live).
    fn by_parts(self, p: vec3, mask: u32) -> f32 {
        let g = self.grid
        let v = if mask == ALL { self.field.distance(p) } else { self.field.distance_live(p, Live::from_word(mask)) }
        clamp(v, -g.scope, g.scope)
    }

    /// Its cells' distance at `p`, asked `size` m finely, in the root whose node is `node0` (least
    /// corner `lo0`): the finest brick of its tree there no coarser than `size` (`x`), and, where
    /// that is a child that holds no surface (`w` 1), its least distance less how far `p` is from
    /// its middle, never less than how far `p` is inside it, with its side (`y`) and how far along
    /// the ray it ends from `p` (`z`); a child all inside matter, how far `p` is inside it, below
    /// 0 (`w` 0). Cells are a bound, not a guess: their distance less the
    /// most the brick's cells are off their field (measured where they were filled: `cells::
    /// off_at`), so a ray stepping by it never steps through a surface the cells misplace. Where
    /// that error is more than a tenth of the size asked, the surface it shows is fat by at most
    /// the error, toward the eye, and the place shown asks for the brick's split (`cells::
    /// refined`): never a hole, and the thing's field is never asked by a ray.
    fn cells_at(self, p: vec3, inv: vec3, node0: u32, lo0: vec3, size: f32) -> vec4 {
        self.leaf_read(self.leaf_at(p, node0, lo0, size), p, inv)
    }

    /// The brick of its tree that answers at `p`, asked `size` m finely, in the root whose node is
    /// `node0` (least corner `lo0`): the finest there no coarser than `size` (its node, least
    /// corner and side), or a child that holds no surface (`empty`).
    fn leaf_at(self, p: vec3, node0: u32, lo0: vec3, size: f32) -> Leaf {
        let g = self.grid
        var node = node0
        var lo = lo0
        var side = g.brick
        var level: u32 = 0
        var going = true
        var empty = false
        while level < LEVELS && going && side / f32(B) > size * CELL_PER_SIZE {
            level += 1
            let first = self.nodes[node * NODE + 1]
            if first == NONE {
                going = false
            } else {
                let half = 0.5 * side
                let o = step(lo + vec3(half), p)
                let child = first + u32(o.x) + 2 * u32(o.y) + 4 * u32(o.z)
                lo = lo + o * half
                side = half
                if self.nodes[child * NODE] == EMPTY {
                    empty = true
                    going = false
                }
                node = child
            }
        }
        Leaf { node, lo, side, empty }
    }

    /// Whether the leaf the walk `k` keeps is the brick a descent at `p`, asked `size` m finely,
    /// would find (`leaf_at`'s own conditions): `p` in its box (as the descent's halvings place it:
    /// an upper child holds its lower face), its parent's cells coarser than the size, and its own
    /// no coarser, or it has no children. Then it is read with no descent, the same brick: the
    /// same reads, the same picture.
    fn leaf_holds(self, k: Within, p: vec3, size: f32) -> bool {
        if k.leaf == NONE {
            return false
        }
        let level = self.nodes[k.leaf * NODE + 3]
        let side = self.grid.brick * exp2(-f32(level))
        let lo = self.leaf_lo(k.leaf)
        let hi = lo + vec3(side)
        let inside = p.x >= lo.x && p.y >= lo.y && p.z >= lo.z && p.x < hi.x && p.y < hi.y && p.z < hi.z
        let fine = side / f32(B) <= size * CELL_PER_SIZE || level >= LEVELS || self.nodes[k.leaf * NODE + 1] == NONE
        let coarse = level == 0 || 2.0 * side / f32(B) > size * CELL_PER_SIZE
        inside && fine && coarse
    }

    /// A node's least corner (its words 4-6).
    fn leaf_lo(self, node: u32) -> vec3 {
        vec3(bitcast_f32(self.nodes[node * NODE + 4]), bitcast_f32(self.nodes[node * NODE + 5]), bitcast_f32(self.nodes[node * NODE + 6]))
    }

    /// The leaf at `p` for the walk `k` (its root a brick of cells): the kept one where it holds
    /// (`leaf_holds`), else a descent (`leaf_at`).
    fn leaf_for(self, k: Within, p: vec3, size: f32) -> Leaf {
        if self.leaf_holds(k, p, size) {
            return Leaf { node: k.leaf, lo: self.leaf_lo(k.leaf), side: self.grid.brick * exp2(-f32(self.nodes[k.leaf * NODE + 3])), empty: false }
        }
        self.leaf_at(p, k.node, self.lo_of(k.mask), size)
    }

    /// `cells_at` from its leaf.
    fn leaf_read(self, leaf: Leaf, p: vec3, inv: vec3) -> vec4 {
        let lo = leaf.lo
        let side = leaf.side
        if leaf.empty {
            let least = bitcast_f32(self.nodes[leaf.node * NODE + 2])
            if least < 0.0 {
                // (A child all inside matter: the point is inside, at least as deep as it is inside
                // the child. Read as holding nothing, a ray a step had carried past the surface
                // walked on through the inside unasked, and met the next brick's surface instead.)
                return vec4(-max(inside_by(p, lo, side), 1.0e-6), side, 0.0, 0.0)
            }
            let off = length(p - (lo + vec3(0.5 * side)))
            return vec4(max(least - off, inside_by(p, lo, side)), side, box_crossed(p, inv, lo, lo + vec3(side)).y, 1.0)
        }
        let off = bitcast_f32(self.nodes[leaf.node * NODE + 7])
        vec4(read_distance(self.cells, self.nodes[leaf.node * NODE], lo, side, p) - off, side, 0.0, 0.0)
    }

    /// The roots at `p`, `t` m along a ray going `inv`, fetched: the walk in them (`fetched`).
    pub(package) fn fetched(self, p: vec3, inv: vec3, t: f32) -> Within {
        fetched(self.roots, self.grid, p, inv, t)
    }

    /// The answer at `p` in the roots the walk `k` holds, `t` m along the ray (`along` false: no
    /// way), asked `size` m finely.
    fn answered(self, k: Within, p: vec3, inv: vec3, t: f32, along: bool, size: f32) -> vec2 {
        let g = self.grid
        // Roots that hold nothing: on to their far side, matter at least as far as it was less
        // how far the ray has come; or all inside matter.
        var x = k.exit - t
        var y = max(k.steep - t, 0.0)
        if k.node == NO_BRICK && k.mask == 1 {
            x = -1.0e-6
            y = -1.0e-6
        }
        if W == CELLS && k.node != HOLDS && k.node != NO_BRICK {
            // By its cells, as a bound (`cells_at`; the root's brick: a point just outside it
            // reads its nearest cells); an empty child of its tree: on to its far side at the
            // least.
            let c = self.cells_at(p, inv, k.node, self.lo_of(k.mask), size)
            y = c.x
            x = c.x
            if c.w > 0.5 {
                x = if along { max(c.z + 0.01 * c.y, c.x) } else { c.x + c.y }
                y = if along { c.x } else { c.x + c.y }
            }
        }
        if k.node == HOLDS {
            // By its parts: their value over the steepness, never past the surface. Where the
            // steepness is the derived one (below std's), it holds only in the root: a step goes
            // no farther than the root's far side.
            y = self.by_parts(p, k.mask) / k.steep
            x = if along && k.steep < g.stated && y > k.exit - t { k.exit - t + g.nudge.x } else { y }
        }
        vec2(x, y)
    }

    /// `answered` for a root of cells, from the leaf its descent found (`leaf_at`).
    fn leaf_answered(self, k: Within, leaf: Leaf, p: vec3, inv: vec3, t: f32, along: bool) -> vec2 {
        let c = self.leaf_read(leaf, p, inv)
        var x = c.x
        var y = c.x
        if c.w > 0.5 {
            x = if along { max(c.z + 0.01 * c.y, c.x) } else { c.x + c.y }
            y = if along { c.x } else { c.x + c.y }
        }
        vec2(x, y)
    }

    /// The facing the cells give at `p`, asked `size` m finely (the brick `at` reads).
    fn cells_facing(self, p: vec3, node0: u32, lo0: vec3, size: f32) -> vec3 {
        let g = self.grid
        var node = node0
        var lo = lo0
        var side = g.brick
        var level: u32 = 0
        var going = true
        while level < LEVELS && going && side / f32(B) > size * CELL_PER_SIZE {
            level += 1
            let first = self.nodes[node * NODE + 1]
            if first == NONE {
                going = false
            } else {
                let half = 0.5 * side
                let o = step(lo + vec3(half), p)
                let child = first + u32(o.x) + 2 * u32(o.y) + 4 * u32(o.z)
                if self.nodes[child * NODE] == EMPTY {
                    going = false
                } else {
                    node = child
                    lo = lo + o * half
                    side = half
                }
            }
        }
        read_cells(self.cells, self.nodes[node * NODE], lo, side, p).yzw
    }
}

impl<M: Field<Substance>, const W: u32> Asked for Seen<M, W> {
    type Walk = Within

    fn begun(self, o: vec3, d: vec3, wide: f32, spread: f32) -> Begun<Within> {
        // (A thing that keeps no roots, as `Lone` asks it; any other within its grid: its roots
        // and live parts skip what a stretch would.)
        if W == WHOLE || W == MET {
            return self.lone().lone_begun(o, d, wide, spread)
        }
        let g = self.grid
        let box = box_span(o, d, g.lo, g.hi)
        Begun { near: box.x, far: box.y, walk: Within { exit: -1.0, node: NO_BRICK, mask: 0, steep: 1.0, leaf: NONE } }
    }

    fn step(self, walk: Within, p: vec3, d: vec3, inv: vec3, t: f32, size: f32) -> Stepped<Within> {
        if W == WHOLE || W == MET {
            return self.lone().lone_step(walk, p, d, inv, t, size)
        }
        var k = walk
        if !(t < k.exit) {
            k = self.fetched(p, inv, t)
        }
        if W == CELLS && k.node != HOLDS && k.node != NO_BRICK {
            // (A step descends as ever; the leaf it found is noted for the halvings and the facing
            // that follow where it crosses the surface.)
            let leaf = self.leaf_at(p, k.node, self.lo_of(k.mask), size)
            k.leaf = if leaf.empty { NONE } else { leaf.node }
            let a = self.leaf_answered(k, leaf, p, inv, t, along: true)
            return Stepped { x: a.x, y: a.y, walk: k }
        }
        let a = self.answered(k, p, inv, t, along: true, size: size)
        Stepped { x: a.x, y: a.y, walk: k }
    }

    fn far(self, walk: Within, p: vec3, t: f32, size: f32) -> f32 {
        if W == WHOLE || W == MET {
            return self.lone().lone_far(walk, p, t, size)
        }
        if walk.node == NO_BRICK && walk.mask != 1 {
            // (Roots that hold nothing, from where they were fetched to where the walk now is:
            // its surface is not here, so it is never the nearer thing.)
            return 1.0e9
        }
        if W == CELLS && self.leaf_holds(walk, p, size) {
            // (In the leaf the walk keeps, the brick a descent would find: read with none.)
            return self.leaf_read(self.leaf_for(walk, p, size), p, vec3(1.0)).x
        }
        // (The root at `p` itself: a point between the ray's last two steps may lie in another
        // root than the walk's, whose mask or brick doesn't hold there; asked through the walk's,
        // a brick's cells read past its face put the surface at the ray's start, and the pixel
        // showed nothing: the stack's 41,502 holes at 3 m, cells as a bound.)
        let k = self.fetched(p, vec3(1.0), t)
        if k.node == NO_BRICK && k.mask != 1 {
            return 1.0e9
        }
        self.answered(k, p, vec3(1.0), t, along: false, size: size).y
    }

    fn facing(self, walk: Within, p: vec3, t: f32, came: vec3, size: f32) -> vec3 {
        var grad = vec3(0.0)
        if W != WHOLE && W != MET && walk.node == NO_BRICK {
            return came
        }
        let parts = W == WHOLE || W == MET || walk.node == HOLDS
        let mask = if W == WHOLE || W == MET { ALL } else { walk.mask }
        if W == CELLS && !parts {
            grad = if self.leaf_holds(walk, p, size) { read_cells(self.cells, self.nodes[walk.leaf * NODE], self.leaf_lo(walk.leaf), self.grid.brick * exp2(-f32(self.nodes[walk.leaf * NODE + 3])), p).yzw } else { self.cells_facing(p, walk.node, self.lo_of(walk.mask), size) }
        }
        if parts && mask == ALL {
            grad = self.field.gradient(p)
        } else if parts {
            // (Where the field's own gradient vanishes, back along the ray: asking its value to
            // each side would put six more asks of a dear field into every pixel's code.)
            let field = self.field
            let live = Live::from_word(mask)
            grad = gradient(|q: vec3| field.distance_live(q, live), p)
        }
        if dot(grad, grad) > 1.0e-8 {
            return normalize(grad)
        }
        came
    }

    fn made_of(self, walk: Within, p: vec3, t: f32) -> Substance {
        self.field.channels(p)
    }

    fn cones(self) -> u32 {
        0
    }

    fn flesh(self) -> f32 {
        0.0
    }

    fn cone(self, i: u32) -> Cone {
        Cone { a: vec3(0.0), ra: 0.0, b: vec3(0.0), rb: 0.0 }
    }

    fn crossed(self, walk: Within, p: vec3, d: vec3, span: f32, size: f32) -> f32 {
        // (Only in the brick the walk keeps, where a descent at both ends would find it: there
        // `far` reads that brick's mix less its lowering, the function whose zero this solves.)
        if W != CELLS || !self.leaf_holds(walk, p, size) || !self.leaf_holds(walk, p + d * span, size) {
            return -1.0
        }
        let leaf = self.leaf_for(walk, p, size)
        let node = leaf.node
        brick_crossed(self.cells, self.nodes[node * NODE], leaf.lo, leaf.side, bitcast_f32(self.nodes[node * NODE + 7]), p, d, span).x
    }

    fn least(self, o: vec3, d: vec3, until: f32, spread: f32) -> Least {
        let f = self.field
        least_by(f, |q: vec3| f.distance(q), o, d, until, spread, self.grid.stated)
    }

    fn told(self, walk: Within, p: vec3, size: f32) -> Told {
        let g = self.grid
        var out = Told { node: walk.node, level: 0, side: 0.0, off: 0.0, cells: 0.0, field: clamp(self.field.distance(p), -g.scope, g.scope) / g.stated, exit: walk.exit, brick: 0 }
        if W == CELLS && walk.node != HOLDS && walk.node != NO_BRICK && walk.node < 4000000000 {
            var node = walk.node
            var lo = self.lo_of(walk.mask)
            var side = g.brick
            var level: u32 = 0
            var going = true
            var empty = false
            while level < LEVELS && going && side / f32(B) > size * CELL_PER_SIZE {
                level += 1
                let first = self.nodes[node * NODE + 1]
                if first == NONE {
                    going = false
                } else {
                    let half = 0.5 * side
                    let o = step(lo + vec3(half), p)
                    let child = first + u32(o.x) + 2 * u32(o.y) + 4 * u32(o.z)
                    lo = lo + o * half
                    side = half
                    if self.nodes[child * NODE] == EMPTY {
                        empty = true
                        going = false
                    }
                    node = child
                }
            }
            out.brick = node
            out.level = level
            out.side = side
            out.off = bitcast_f32(self.nodes[node * NODE + 7])
            out.cells = if empty { -1.0e9 } else { read_distance(self.cells, self.nodes[node * NODE], lo, side, p) }
        }
        out
    }

}

/// A thing that moves, as GPU code asks it: its field and its grid (only a box round it: a moving
/// thing lays out no roots, `cells::Kept::deposit`). A ray finds the parts it can come near once,
/// as it begins, from the parts' own bounds along its stretch through the box (std's
/// `live_along`, its reach the joins' own), and its walk holds them (`mask`, a word: parts past
/// the 32nd always asked); its steps ask only them (`Surface::distance_live`).
pub struct Rayed<M>: Copy + GpuData {
    pub(package) field: M,
    pub(package) grid: Grid,
}

impl<M: Field<Substance>> Rayed<M> {
    /// Its field's value at `p` by the parts `mask` names, over the steepness std's shapes state,
    /// never past its surface.
    fn live_at(self, p: vec3, mask: u32) -> f32 {
        let g = self.grid
        let v = if mask == ALL { self.field.distance(p) } else { self.field.distance_live(p, Live::from_word(mask)) }
        clamp(v, -g.scope, g.scope) / g.stated
    }
}

impl<M: Field<Substance>> Asked for Rayed<M> {
    type Walk = Within

    fn begun(self, o: vec3, d: vec3, wide: f32, spread: f32) -> Begun<Within> {
        let g = self.grid
        let box = box_span(o, d, g.lo, g.hi)
        let near = max(box.x, 0.0)
        if box.y < near {
            return Begun { near: box.y, far: box.x - 1.0, walk: Within { exit: -1.0, node: NO_BRICK, mask: 0, steep: 1.0, leaf: NONE } }
        }
        // (The parts its stretch through the box passes within their reach and half the ray's
        // widest width there.)
        let live = live_along(self.field, o + d * near, o + d * box.y, 0.5 * (wide + spread * box.y))
        if !live.any(0, self.field.parts()) {
            return Begun { near: box.y, far: box.x - 1.0, walk: Within { exit: -1.0, node: NO_BRICK, mask: 0, steep: 1.0, leaf: NONE } }
        }
        Begun { near: box.x, far: box.y, walk: Within { exit: box.y, node: HOLDS, mask: live.word(), steep: g.stated, leaf: NONE } }
    }

    fn step(self, walk: Within, p: vec3, d: vec3, inv: vec3, t: f32, size: f32) -> Stepped<Within> {
        let f = self.live_at(p, walk.mask)
        Stepped { x: f, y: f, walk }
    }

    fn far(self, walk: Within, p: vec3, t: f32, size: f32) -> f32 {
        self.live_at(p, walk.mask)
    }

    fn facing(self, walk: Within, p: vec3, t: f32, came: vec3, size: f32) -> vec3 {
        let field = self.field
        let live = Live::from_word(walk.mask)
        let grad = if walk.mask == ALL { field.gradient(p) } else { gradient(|q: vec3| field.distance_live(q, live), p) }
        if dot(grad, grad) > 1.0e-8 {
            return normalize(grad)
        }
        came
    }

    fn made_of(self, walk: Within, p: vec3, t: f32) -> Substance {
        self.field.channels(p)
    }

    fn told(self, walk: Within, p: vec3, size: f32) -> Told {
        Told { node: walk.node, level: 0, side: 0.0, off: 0.0, cells: 0.0, field: self.live_at(p, ALL), exit: walk.exit, brick: walk.mask }
    }

    fn crossed(self, walk: Within, p: vec3, d: vec3, span: f32, size: f32) -> f32 {
        -1.0
    }

    fn cones(self) -> u32 {
        min(self.field.parts(), 31)
    }

    fn cone(self, i: u32) -> Cone {
        cone_of(self.field, i)
    }

    fn flesh(self) -> f32 {
        var most = 0.0
        for i in 0..min(self.field.parts(), 31) {
            most = max(most, self.field.part_bound(i).lowers)
        }
        most
    }

    fn least(self, o: vec3, d: vec3, until: f32, spread: f32) -> Least {
        // (Over the parts its stretch through the box comes within the outline's reach of, and
        // the ray's half width: a part left out is farther than an outline can be drawn from
        // (`pixels::REACH` widths), where the thing's value is its own without that part.)
        let g = self.grid
        let box = box_span(o, d, g.lo, g.hi)
        let near = max(box.x, 0.0)
        if box.y < near {
            return Least { t: box.y, g: 1.0e9, n: vec3(0.0), state: LEAST_NONE }
        }
        let live = live_along(self.field, o + d * near, o + d * box.y, OUTLINE_REACH * spread * box.y)
        if !live.any(0, self.field.parts()) {
            return Least { t: box.y, g: 1.0e9, n: vec3(0.0), state: LEAST_NONE }
        }
        let f = self.field
        least_by(f, |q: vec3| f.distance_live(q, live), o, d, until, spread, g.stated)
    }
}
