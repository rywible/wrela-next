// The world as the author hands it to the engine: things, each a pure field (std::field, its points
// carrying a `Substance`), as plain data each frame: `one(stage()).and(one(creature(pose)))`.
//
// The whole world is also one field, the things' union (`World::field`): what the brute-force
// reference asks, so it checks the engine against the author's own matter.

use matter::substance::Substance
use std::field::{Field, Surface, Union, UnionAll}
use std::hash::StateHash

/// What the engine is given of the world each frame.
pub trait World: Copy {
    /// The whole world as one field.
    type Field: Field<Substance>

    /// The whole world as one field: its things joined.
    fn field(self) -> Self::Field

    /// How many things it is.
    fn count(self) -> u32
}

/// One thing: a field.
pub struct One<M>: Copy {
    pub field: M,
}

/// `field` as one thing.
pub fn one<M: Field<Substance> + StateHash>(field: M) -> One<M> {
    One { field }
}

/// Things of one kind: `N` fields of one type, each its own thing (`many(fields)`).
pub struct Many<M, const N: u32>: Copy {
    pub fields: [M; N],
}

/// `fields`, each a thing.
pub fn many<M: Field<Substance> + Surface + StateHash + GpuData, const N: u32>(
    fields: [M; N],
) -> Many<M, N> {
    Many { fields }
}

/// Two worlds as one.
pub struct And<A, B>: Copy {
    pub a: A,
    pub b: B,
}

impl<M: Field<Substance> + StateHash> One<M> {
    /// This thing and the things of `other`.
    pub fn and<B: World>(self, other: B) -> And<One<M>, B> {
        And { a: self, b: other }
    }
}

impl<A: World, B: World> And<A, B> {
    /// These things and the things of `other`.
    pub fn and<C: World>(self, other: C) -> And<And<A, B>, C> {
        And { a: self, b: other }
    }
}

impl<M: Field<Substance> + StateHash> World for One<M> {
    type Field = M

    fn field(self) -> M {
        self.field
    }

    fn count(self) -> u32 {
        1
    }
}

impl<M: Field<Substance> + Surface + StateHash + GpuData, const N: u32> World for Many<M, N> {
    type Field = UnionAll<M, N>

    fn field(self) -> UnionAll<M, N> {
        self.fields.union()
    }

    fn count(self) -> u32 {
        N
    }
}

impl<A: World, B: World> World for And<A, B> {
    type Field = Union<A::Field, B::Field>

    fn field(self) -> Union<A::Field, B::Field> {
        Union { a: self.a.field(), b: self.b.field() }
    }

    fn count(self) -> u32 {
        self.a.count() + self.b.count()
    }
}
