// The world as the author hands it to the engine: things, each a field (std::field, its points
// carrying a `Substance`), as plain data each frame: `one(stage()).and(one(creature(pose)))`.
// What is one thing and what another is the author's (each is what they wrote as one); what the
// engine keeps of each (its cells), whether it moves, and whether its field or its cells answer an
// ask, are the engine's (`cells`).
//
// The whole world is also one field, the things' union (`World::field`): what the reference
// asks, by brute force, so it checks the engine against the author's own matter.

use matter::asked::{Answers, Both, Seen}
use matter::cells::{ASKS_CELLS, Choice, Kept}
use matter::substance::Substance
use picture::eye::View
use std::collections::Vec
use std::field::{Field, Union}
use std::gpu::Sampler

/// What the engine is given of the world each frame.
pub trait World: Copy {
    /// The whole world as one field.
    type Field: Field<Substance>
    /// The world as GPU code asks it (`Answers`; `asked::chosen` makes it `Asked`).
    type Asked: Answers

    /// The whole world as one field: its things joined.
    fn field(self) -> Self::Field

    /// How many things it is.
    fn count(self) -> u32

    /// Each thing's cells brought up to date for this frame (how it is asked chosen first:
    /// `Choice`; then `Kept::deposit`), the first being `kept[first]`, seen through `v`.
    fn kept(self, kept: mut Vec<Kept>, choice: mut Choice, first: u32, v: View)

    /// Whether every thing's cells are ready to be asked.
    fn ready(self, kept: Vec<Kept>, first: u32) -> bool

    /// The world as GPU code asks it, from its things' cells.
    fn asked(self, kept: Vec<Kept>, s: Sampler, first: u32) -> Self::Asked

    /// Which of its things (a bit each, from `first`) are asked by their cells.
    fn cells(self, kept: Vec<Kept>, first: u32) -> u32
}

/// One thing: a field.
pub struct One<M>: Copy {
    pub field: M,
}

/// `field` as one thing.
pub fn one<M: Field<Substance>>(field: M) -> One<M> {
    One { field }
}

/// Two worlds as one.
pub struct And<A, B>: Copy {
    pub a: A,
    pub b: B,
}

impl<M: Field<Substance>> One<M> {
    /// This thing and the things of `other`.
    pub fn and<B: World>(self, other: B) -> And<One<M>, B> {
        And { a: self, b: other }
    }
}

impl<A: World, B: World> And<A, B> {
    /// These things and the things of `other`.
    pub fn and<C: World>(self, other: C) -> And<And<A, B>, C> {
        And { a: self, b: other }
    }
}

impl<M: Field<Substance>> World for One<M> {
    type Field = M
    type Asked = Seen<M>

    fn field(self) -> M {
        self.field
    }

    fn count(self) -> u32 {
        1
    }

    fn kept(self, kept: mut Vec<Kept>, choice: mut Choice, first: u32, v: View) {
        let _ = choice.chose(self.field, mut kept[first], first)
        kept[first].deposit(self.field, v)
    }

    fn ready(self, kept: Vec<Kept>, first: u32) -> bool {
        kept[first].ready()
    }

    fn cells(self, kept: Vec<Kept>, first: u32) -> u32 {
        if kept[first].asks == ASKS_CELLS { 1 } else { 0 }
    }

    fn asked(self, kept: Vec<Kept>, s: Sampler, first: u32) -> Seen<M> {
        Seen { field: self.field, grid: kept[first].grid, coarse: kept[first].coarse, atlas: kept[first].atlas, s: s }
    }
}

impl<A: World, B: World> World for And<A, B> {
    type Field = Union<A::Field, B::Field>
    type Asked = Both<A::Asked, B::Asked>

    fn field(self) -> Union<A::Field, B::Field> {
        Union { a: self.a.field(), b: self.b.field() }
    }

    fn count(self) -> u32 {
        self.a.count() + self.b.count()
    }

    fn kept(self, kept: mut Vec<Kept>, choice: mut Choice, first: u32, v: View) {
        self.a.kept(mut kept, mut choice, first, v)
        self.b.kept(mut kept, mut choice, first + self.a.count(), v)
    }

    fn ready(self, kept: Vec<Kept>, first: u32) -> bool {
        self.a.ready(kept, first) && self.b.ready(kept, first + self.a.count())
    }

    fn cells(self, kept: Vec<Kept>, first: u32) -> u32 {
        self.a.cells(kept, first) | (self.b.cells(kept, first + self.a.count()) << self.a.count())
    }

    fn asked(self, kept: Vec<Kept>, s: Sampler, first: u32) -> Both<A::Asked, B::Asked> {
        Both { a: self.a.asked(kept, s, first), b: self.b.asked(kept, s, first + self.a.count()) }
    }
}
