// The world as the author hands it to the engine: things, each a pure field (std::field, its points
// carrying a `Substance`), as plain data each frame: `one(stage()).and(pool(entities))`.
//
// `One` and `And` of `One`s also form one combined field (`World::field`): what the brute-force
// reference asks, so it checks the engine against the author's own matter. `Pool<M>` holds a
// dynamic `Vec<M>` of arbitrary runtime count (MMO players, monsters, projectiles, spell effects)
// realised directly by `MeshWorld` on the GPU.

use matter::substance::Substance
use std::collections::Vec
use std::field::{Field, Surface, Union}
use std::hash::StateHash

/// A statically composed world that can also be folded into one uniform `Field<Substance>` for
/// the brute-force path-traced reference and hole audit.
pub trait World {
    /// The whole world as one field.
    type Field: Field<Substance>

    /// The whole world as one field: its things joined.
    fn field(self) -> Self::Field

    /// How many things it is.
    fn count(self) -> u32
}

/// One thing: a field.
pub struct One<M>: Copy {
    pub field: M,
}

/// `field` as one thing.
pub fn one<M: Field<Substance> + StateHash>(field: M) -> One<M> {
    One { field }
}

/// Dynamic pool of things of one kind: arbitrary runtime count backed by `Vec<M>` (`pool(fields)`).
pub struct Pool<M> {
    pub fields: Vec<M>,
}

/// `fields`, each its own thing (arbitrary runtime count).
pub fn pool<M: Field<Substance> + Surface + StateHash + GpuData>(fields: take Vec<M>) -> Pool<M> {
    Pool { fields }
}

/// Convenience constructor turning a fixed array `[M; N]` into a dynamic `Pool<M>`.
pub fn pool_of<M: Field<Substance> + Surface + StateHash + GpuData, const N: u32>(
    fields: [M; N],
) -> Pool<M> {
    var out: Vec<M> = Vec::new()
    for i in 0..N {
        out.push(fields[i])
    }
    Pool { fields: out }
}

/// Two worlds as one.
pub struct And<A, B> {
    pub a: A,
    pub b: B,
}

impl<M: Field<Substance> + StateHash> One<M> {
    /// This thing and the things of `other`.
    pub fn and<B>(self, other: take B) -> And<One<M>, B> {
        And { a: self, b: other }
    }
}

impl<M: Field<Substance> + Surface + StateHash + GpuData> Pool<M> {
    /// These things and the things of `other`.
    pub fn and<B>(take self, other: take B) -> And<Pool<M>, B> {
        And { a: self, b: other }
    }
}

impl<A, B> And<A, B> {
    /// These things and the things of `other`.
    pub fn and<C>(take self, other: take C) -> And<And<A, B>, C> {
        And { a: self, b: other }
    }
}

impl<M: Field<Substance> + StateHash> World for One<M> {
    type Field = M

    fn field(self) -> M {
        self.field
    }

    fn count(self) -> u32 {
        1
    }
}

impl<A: World, B: World> World for And<A, B> {
    type Field = Union<A::Field, B::Field>

    fn field(self) -> Union<A::Field, B::Field> {
        Union { a: self.a.field(), b: self.b.field() }
    }

    fn count(self) -> u32 {
        self.a.count() + self.b.count()
    }
}
