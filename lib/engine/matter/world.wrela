// The world as the author hands it to the engine: things, each a field (std::field, its points
// carrying a `Substance`), as plain data each frame: `one(stage()).and(one(creature(pose)))`.
// What is one thing and what another is the author's (each is what they wrote as one); what the
// engine keeps of each (its roots and cells), whether it moves, and who answers where, are the
// engine's (`cells`).
//
// The whole world is also one field, the things' union (`World::field`): what the reference
// asks, by brute force, so it checks the engine against the author's own matter.

use matter::asked::{Asked, CELLS, Kinded, MET, PARTS, Rayed, Seen, Seens}
use matter::cells::{Grid, Kept}
use matter::substance::Substance
use std::collections::Vec
use std::field::{Field, Surface, Union, UnionAll}
use std::hash::StateHash
use std::gpu::{GpuBuffer, Rgba32Float, Texture, buffer_of}

/// What the engine is given of the world each frame.
pub trait World: Copy {
    /// The whole world as one field.
    type Field: Field<Substance>

    /// The whole world as one field: its things joined.
    fn field(self) -> Self::Field

    /// How many things it is.
    fn count(self) -> u32


    /// Each thing's cells brought up to date for this frame (`Kept::deposit`), the first being
    /// `kept[first]`, each asked as finely as `sizes` says (m).
    fn kept(self, kept: mut Vec<Kept>, first: u32, sizes: Vec<f32>)

    /// After a frame, each thing's cells refined where the picture showed them finer than they
    /// hold (`asks`: places, and the sizes they were asked at); each split and fold counted into
    /// `changes` (`Kept::refine`).
    fn refine(self, kept: mut Vec<Kept>, first: u32, asks: Texture<Rgba32Float>, place: Texture<Rgba32Float>, changes: mut GpuBuffer<u32>)

    /// Whether every thing's cells are ready to be asked.
    fn ready(self, kept: Vec<Kept>, first: u32) -> bool

    /// Each of its things handed to `e` as GPU code asks it, by code that answers only the ways
    /// that thing can be answered (`Kept::ways`), the first being `kept[first]`: a variant a way,
    /// for each kind of thing, never one for each combination of them.
    fn each<E: Each>(self, kept: Vec<Kept>, kinds: Self::Kinds, first: u32, e: mut E)

    /// What its kinds drawn at once need on the GPU this frame (`Each::kind`: a kind's values in
    /// buffers), made before any pass (a buffer can't be made inside one), the first being
    /// `kept[first]`.
    type Kinds

    fn kinds(self, kept: Vec<Kept>, first: u32) -> Self::Kinds
}

/// No kind to draw at once.
pub struct NoKinds {
    none: u32,
}

/// Two worlds' kinds.
pub struct Both<A, B> {
    pub a: A,
    pub b: B,
}

/// A kind's values for the GPU this frame (`Many`): its fields, grids and bounds; `on` where it
/// is drawn at once.
pub struct KindBuffers<M: GpuData> {
    fields: GpuBuffer<M>,
    grids: GpuBuffer<Grid>,
    bounds: GpuBuffer<vec4>,
    on: bool,
}

/// What is done with each thing of a world (`World::each`): the picture draws each by itself.
pub trait Each {
    /// Things `first` to `first + n` (less one), all of one kind and keeping no roots, as GPU code
    /// asks them (`k`): drawn at once.
    fn kind<K: Kinded>(mut self, k: K, n: u32, first: u32)

    /// Thing `k`, as GPU code asks it (`a`), where its matter can be (`bound`: centre, radius).
    fn thing<A: Asked>(mut self, a: A, k: u32, bound: vec4)
}

/// One thing: a field.
pub struct One<M>: Copy {
    pub field: M,
}

/// `field` as one thing.
pub fn one<M: Field<Substance> + StateHash>(field: M) -> One<M> {
    One { field }
}

/// Things of one kind: `N` fields of one type, each its own thing (its own cells, its own draws,
/// as `one` makes it): `many(fields)`.
pub struct Many<M, const N: u32>: Copy {
    pub fields: [M; N],
}

/// `fields`, each a thing.
pub fn many<M: Field<Substance> + Surface + StateHash + GpuData, const N: u32>(fields: [M; N]) -> Many<M, N> {
    Many { fields }
}

impl<M: Field<Substance> + Surface + StateHash + GpuData, const N: u32> World for Many<M, N> {
    type Field = UnionAll<M, N>

    fn field(self) -> UnionAll<M, N> {
        self.fields.union()
    }

    fn count(self) -> u32 {
        N
    }

    fn kept(self, kept: mut Vec<Kept>, first: u32, sizes: Vec<f32>) {
        for i in 0..N {
            kept[first + i].deposit(self.fields[i], sizes[first + i])
        }
    }

    fn refine(self, kept: mut Vec<Kept>, first: u32, asks: Texture<Rgba32Float>, place: Texture<Rgba32Float>, changes: mut GpuBuffer<u32>) {
        for i in 0..N {
            kept[first + i].refine(self.fields[i], asks, place, mut changes)
        }
    }

    fn ready(self, kept: Vec<Kept>, first: u32) -> bool {
        var all = true
        for i in 0..N {
            all = all && kept[first + i].ready()
        }
        all
    }

    type Kinds = KindBuffers<M>

    fn kinds(self, kept: Vec<Kept>, first: u32) -> KindBuffers<M> {
        // (Things that keep no roots, all answered one way, are drawn as a kind: their fields,
        // grids and bounds in buffers made this frame. Only things a ray begins where they say
        // it meets them (`MET`): a field that says so in closed form is small enough to read from
        // a buffer an invocation; a body's isn't. Others, one by one.)
        let w = kept[first].ways
        var on = M::EXACT_MEETS && N > 1 && w == MET
        for i in 0..N {
            on = on && kept[first + i].ways == w
        }
        var fs: Vec<M> = Vec::new()
        var gs: Vec<Grid> = Vec::new()
        var bs: Vec<vec4> = Vec::new()
        for i in 0..(if on { N } else { 1 }) {
            fs.push(self.fields[i])
            gs.push(kept[first + i].grid)
            bs.push(kept[first + i].derived())
        }
        KindBuffers { fields: buffer_of(fs), grids: buffer_of(gs), bounds: buffer_of(bs), on }
    }

    fn each<E: Each>(self, kept: Vec<Kept>, kinds: KindBuffers<M>, first: u32, e: mut E) {
        if !kinds.on {
            for i in 0..N {
                one(self.fields[i]).drawn_by(kept, first + i, mut e)
            }
            return
        }
        if M::EXACT_MEETS {
            let k: Seens<M, 3> = Seens { fields: kinds.fields.items(), grids: kinds.grids.items(), bounds: kinds.bounds.items() }
            e.kind(k, N, first)
        }
    }
}

/// Two worlds as one.
pub struct And<A, B>: Copy {
    pub a: A,
    pub b: B,
}

impl<M: Field<Substance> + StateHash> One<M> {
    /// It handed to `e` as GPU code asks it (`World::each`; `Many` hands its things so too:
    /// `One<M>::Kinds` is not seen to be `NoKinds` in generic code).
    pub(package) fn drawn_by<E: Each>(self, kept: Vec<Kept>, first: u32, e: mut E) {
        let b = kept[first].derived()
        let w = kept[first].ways
        if kept[first].moving {
            // (A thing that moves: asked by rays that find its parts from their own bounds.)
            e.thing(Rayed { field: self.field, grid: kept[first].grid }, first, b)
        } else if w == PARTS {
            let a: Seen<M, 1> = Seen { field: self.field, grid: kept[first].grid, roots: kept[first].roots.items(), nodes: kept[first].nodes.items(), cells: kept[first].cells.items() }
            e.thing(a, first, b)
        } else if w == MET {
            let a: Seen<M, 3> = Seen { field: self.field, grid: kept[first].grid, roots: kept[first].roots.items(), nodes: kept[first].nodes.items(), cells: kept[first].cells.items() }
            e.thing(a, first, b)
        } else if w == CELLS {
            let a: Seen<M, 2> = Seen { field: self.field, grid: kept[first].grid, roots: kept[first].roots.items(), nodes: kept[first].nodes.items(), cells: kept[first].cells.items() }
            e.thing(a, first, b)
        } else {
            let a: Seen<M, 0> = Seen { field: self.field, grid: kept[first].grid, roots: kept[first].roots.items(), nodes: kept[first].nodes.items(), cells: kept[first].cells.items() }
            e.thing(a, first, b)
        }
    }

    /// This thing and the things of `other`.
    pub fn and<B: World>(self, other: B) -> And<One<M>, B> {
        And { a: self, b: other }
    }
}

impl<A: World, B: World> And<A, B> {
    /// These things and the things of `other`.
    pub fn and<C: World>(self, other: C) -> And<And<A, B>, C> {
        And { a: self, b: other }
    }
}

impl<M: Field<Substance> + StateHash> World for One<M> {
    type Field = M

    fn field(self) -> M {
        self.field
    }

    fn count(self) -> u32 {
        1
    }

    fn kept(self, kept: mut Vec<Kept>, first: u32, sizes: Vec<f32>) {
        kept[first].deposit(self.field, sizes[first])
    }

    fn refine(self, kept: mut Vec<Kept>, first: u32, asks: Texture<Rgba32Float>, place: Texture<Rgba32Float>, changes: mut GpuBuffer<u32>) {
        kept[first].refine(self.field, asks, place, mut changes)
    }

    fn ready(self, kept: Vec<Kept>, first: u32) -> bool {
        kept[first].ready()
    }

    type Kinds = NoKinds

    fn kinds(self, kept: Vec<Kept>, first: u32) -> NoKinds {
        NoKinds { none: 0 }
    }

    fn each<E: Each>(self, kept: Vec<Kept>, kinds: NoKinds, first: u32, e: mut E) {
        self.drawn_by(kept, first, mut e)
    }
}

impl<A: World, B: World> World for And<A, B> {
    type Field = Union<A::Field, B::Field>

    fn field(self) -> Union<A::Field, B::Field> {
        Union { a: self.a.field(), b: self.b.field() }
    }

    fn count(self) -> u32 {
        self.a.count() + self.b.count()
    }

    fn kept(self, kept: mut Vec<Kept>, first: u32, sizes: Vec<f32>) {
        self.a.kept(mut kept, first, sizes)
        self.b.kept(mut kept, first + self.a.count(), sizes)
    }

    fn refine(self, kept: mut Vec<Kept>, first: u32, asks: Texture<Rgba32Float>, place: Texture<Rgba32Float>, changes: mut GpuBuffer<u32>) {
        self.a.refine(mut kept, first, asks, place, mut changes)
        self.b.refine(mut kept, first + self.a.count(), asks, place, mut changes)
    }

    fn ready(self, kept: Vec<Kept>, first: u32) -> bool {
        self.a.ready(kept, first) && self.b.ready(kept, first + self.a.count())
    }

    type Kinds = Both<A::Kinds, B::Kinds>

    fn kinds(self, kept: Vec<Kept>, first: u32) -> Both<A::Kinds, B::Kinds> {
        Both { a: self.a.kinds(kept, first), b: self.b.kinds(kept, first + self.a.count()) }
    }

    fn each<E: Each>(self, kept: Vec<Kept>, kinds: Both<A::Kinds, B::Kinds>, first: u32, e: mut E) {
        self.a.each(kept, kinds.a, first, mut e)
        self.b.each(kept, kinds.b, first + self.a.count(), mut e)
    }
}
