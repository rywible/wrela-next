// What an ask of a field costs, as the engine weighs it to choose whether a thing is asked by its
// field or by its cells. A STAND-IN, in this one place, until the toolchain hands the program the
// work it already counts for each pipeline (the build manifest's `work`; asked for, gap 8): then
// this file goes, and `asked_by` reads that.
//
// Deterministic: the toolchain turns any field into a tape of operations (`Surface::to_tape`,
// `std::derive::tape`: what doesn't depend on the point is folded to constants, both sides of a
// branch kept), so the same field weighs the same on every run and machine. Each operation weighs
// 1; a value noise or a lattice hash (one operation on the tape, a hundred or so when run)
// `NOISE_WEIGHT`; an fBm `FBM_OCTAVES` of them. (Slice 1b multiplied the weight by the steepness
// the field states; a stated steepness is no longer read here (slice 1c: only `ranges`' marked
// stand-in reads one), and the choices it made are the same without it: the stage 50, the
// creature 964, the stack 1,058.)
//
// The weights are fitted to slice 1a's measures (wrela-notes/engine/NOTES.md): an ask of the
// creature's field (964 operations) took 0.87 to 1.15 ns on the M4, the stack's (158 and 6 noises)
// 0.9 to 1.6 ns, so a noise is about 130 operations. `AFFORD` sits between the stage's 50, whose
// frame by its cells was dearer (slice 1b: stage and creature both by cells 22.2 ms at 1080p on
// the M4), and the creature's 964, whose frame by its field was dearer (9.26 ms; by its cells,
// the stage by its field, 8.10 ms).

use matter::substance::Substance
use std::field::Field
use std::stage::{FBM3, HASH, NOISE3}

/// What one value noise (or lattice hash) on a tape weighs, in operations.
pub const NOISE_WEIGHT: f32 = 150.0

/// The octaves an fBm on a tape is weighed as.
const FBM_OCTAVES: f32 = 6.0

/// The most an ask of a thing may weigh (operations) for the thing to be asked by its field.
pub const AFFORD: f32 = 500.0

/// What `field`'s ask weighs (operations).
pub fn weighed<M: Field<Substance>>(field: M) -> f32 {
    let t = field.to_tape()
    var w = 0.0
    var i: u32 = 0
    while i < t.len() {
        let op = t.op_at(i)
        let code = op.opcode()
        if code == NOISE3 || code == HASH {
            w += NOISE_WEIGHT
        } else if code == FBM3 {
            // (Its octaves are in the tape's table, which std keeps to itself: weighed as
            // `FBM_OCTAVES`, until the toolchain counts the work: gap 8.)
            w += NOISE_WEIGHT * FBM_OCTAVES
        } else {
            w += 1.0
        }
        i += 1
    }
    w
}

/// Whether `field` is asked by its cells: an ask of it weighs over `AFFORD`.
pub fn by_cells<M: Field<Substance>>(field: M) -> bool {
    weighed(field) > AFFORD
}
