// What an ask costs, as a thing's roots weigh who answers in each (`cells::coarsed`) and a thing
// the ways it can be answered (`cells::Kept::chosen_ways`): the toolchain's own count of work, in
// its units (about one 32-bit operation on one invocation: an operation on a component 1, a
// division 4, a read of a buffer 8; `std::derive::work`), the same on every run and machine. Of a
// field, std's: its whole ask (`Surface::ask_work`), each part's (`part_work`), and what a masked
// ask does beyond the parts it asks (`base_work`; `live_work` is the base and the live parts').
// Of the engine's own reads, the compiler's count of their code: a read of a brick's cells
// (`cells::read_distance`) and a ray's fetch of a root (`asked::fetched`), which read
// buffers, so are counted as GPU code (`counted`).

use matter::asked::fetched
use matter::cells::{Grid, read_distance}
use matter::substance::Substance
use std::collections::Vec
use std::derive::{UNBOUNDED_WORK, work}
use std::field::Field
use std::gpu::{Atomics, GlobalId, GpuSpan}

/// A count as the engine weighs it (an unbounded one, past anything).
fn weight(w: u32) -> f32 {
    if w == UNBOUNDED_WORK { 1.0e30 } else { f32(w) }
}

/// What a read of a brick's cells and a ray's fetch of a root weigh (into `out`, in that order):
/// the compiler's count of their code. (`span` stands for any buffer: the count knows nothing of
/// what it reads.)
@compute(1)
pub fn counted(g: Grid, span: GpuSpan<u32>, out: mut Atomics<u32>, id: GlobalId) {
    out.store(i: 0, value: work(|p: vec3| read_distance(span, 0, vec3(0.0), 1.0, p)))
    out.store(i: 1, value: work(|p: vec3| fetched(span, g, p, p, p.x)))
}

/// What a thing's asks weigh, for its roots' choice: each of its parts' (`part_work`), in std's
/// numbering, the first 32; then every part past them together (a mask names only the first 32:
/// the rest are always asked); then its whole ask's (`ask_work`); then a masked ask's beyond its
/// parts (`base_work`); then a read of cells (`read`) and a fetch of a root (`fetch`), as
/// `counted` counts them.
pub fn weights<M: Field<Substance>>(field: M, read: u32, fetch: u32) -> Vec<f32> {
    let n = field.parts()
    let m = min(n, 32)
    var out: Vec<f32> = Vec::filled(m + 5, 0.0)
    for i in 0..min(n, 4096) {
        let w = weight(field.part_work(i))
        if i < 32 {
            out[i] = w
        } else {
            out[m] += w
        }
    }
    out[m + 1] = weight(field.ask_work())
    out[m + 2] = weight(field.base_work())
    out[m + 3] = weight(read)
    out[m + 4] = weight(fetch)
    out
}
