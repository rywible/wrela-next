// The sky (docs/design.md, "What an author writes"): matter with a direction and no place, the one
// named exception. It is what light comes from far off along each way, and the sun in it. It is
// light, physically: never a tone (the look alone makes tone).
//
// The sun is stated apart from the rest of the sky's light. A brute-force ray that went looking
// for it over the whole sky would almost never find a disc half a degree wide; light by brute
// force asks for it by name (the reference's shadow ray). That the author states it is a debt:
// the toolchain could find where a field over directions is concentrated (its peaks, by interval
// over the sphere of ways) and the engine would not need to be told (wrela-notes/engine/NOTES.md,
// the debts list).

use std::hash::StateHash
use std::math::TAU

/// The sun: the way toward it (unit), how wide its disc is (its angular radius, rad), and the
/// light it lays on a face turned square to it (irradiance, the sky's units times a steradian).
pub struct Sun: Copy + GpuData {
    pub way: vec3,
    pub size: f32,
    pub light: vec3,
    pub spare: f32,
}

/// A sky: the light that comes from far off along each way, the sun's disc apart. Its state
/// hashes (`StateHash`): what the engine keeps from a sky (its cached light) is kept while the
/// sky's hash stays the same.
pub trait Sky: Copy + GpuData + StateHash {
    /// The light (radiance) arriving from far off along `way` (unit, toward where it comes from),
    /// leaving out the sun's disc.
    fn light(self, way: vec3) -> vec3

    /// The sun.
    fn sun(self) -> Sun
}

/// The light seen along `way` of `sky`: its light, and in the sun's disc the sun's light spread
/// over the disc.
pub fn seen<S: Sky>(sky: S, way: vec3) -> vec3 {
    let sun = sky.sun()
    let c = cos(sun.size)
    if dot(way, sun.way) >= c {
        // The disc's solid angle: 2π(1 - cos r).
        return sky.light(way) + sun.light / (TAU * max(1.0 - c, 1.0e-9))
    }
    sky.light(way)
}
