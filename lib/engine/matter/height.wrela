// Vast planar surfaces (`Height`): continuous ocean swells, distant terrain, ground planes.
// Authors write pure math over `(x, z)`; the engine realises any `Height` as nested GPU clipmap
// meshlets drawn into the exact same 4× MSAA depth buffer and One Light store as solid `Surface`s.

use matter::substance::{Substance, lambert}

/// Surface sample of a `Height` field at horizontal coordinate `xz`.
pub struct HeightSample: Copy + GpuData {
    /// Outward unit surface normal.
    pub normal: vec3,
    /// World elevation `y` (m).
    pub y: f32,
    /// Surface material (`Substance`).
    pub sub: Substance,
}

/// Any continuous heightfield over world `(x, z)`.
pub trait Height: Copy {
    /// Whether this heightfield is present: a constant of the kind, so a scene without one has no
    /// clipmap's draw or pipeline.
    const ACTIVE: bool = true

    /// Whether any point of this heightfield is opaque (`transmission <= 0.02`): a constant of
    /// the kind, so its opaque draw is built only where it may have one.
    const HAS_OPAQUE: bool = true

    /// Whether any point of this heightfield is transmissive (`transmission > 0.02`): a constant
    /// of the kind, as `HAS_OPAQUE`.
    const HAS_TRANSMISSIVE: bool = true

    /// Elevation, normal, and substance at world horizontal point `xz`.
    fn height_at(self, xz: vec2) -> HeightSample
}

/// Absent heightfield (zero runtime cost).
pub struct NoHeight: Copy + GpuData {}

impl Height for NoHeight {
    const ACTIVE: bool = false
    const HAS_OPAQUE: bool = false
    const HAS_TRANSMISSIVE: bool = false

    fn height_at(self, _xz: vec2) -> HeightSample {
        HeightSample {
            y: -1.0e6,
            normal: vec3(0.0, 1.0, 0.0),
            sub: lambert(vec3(0.0)),
        }
    }
}
