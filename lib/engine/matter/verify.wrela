// Build-time mathematical soundness verification for `Surface`, `Field<Substance>`, and `Edited<M>`.
//
// Any under-approximated `bound()`, `lipschitz()`, `pruned()`, `interval_near()`, `slope_box()`,
// or `dirty_region()` causes brick culling, tight AABBs, Lipschitz ray marching, sheet
// certificates, or incremental CSG re-extraction to silently drop geometry and open holes. Calling these checks from `@test` suites
// (run automatically by `tools/check`) catches unsound field contracts at build time with zero
// runtime overhead.
//
// Verification uses compiler-derived affine arithmetic (`std::derive::affine`, IEEE-754 sound)
// with adaptive worst-box priority bisection along each box's widest axis so contracts reach
// 100% mathematical proof (0 sampled boxes) instead of falling back to point sampling.

use matter::edits::Edited
use matter::substance::Substance
use std::collections::Vec
use std::derive::{Box3, Box4, Interval, affine, affine_form, gradient, interval, lipschitz, work}
use std::field::{
    ALL_LIVE, Bound, Field, FieldFacts, Live, Surface, Translate, UNBOUNDED, cuboid, fbm, form_box,
    hash_u32, round_cone, sphere,
}
use std::quat::Quat
use std::hash::StateHash
use std::io::print

/// The most work one evaluation of a field's distance may state as its `@budget` (`tools/layers`
/// rule 7; the compiler holds it to the budget, E0710): about one 32-bit operation on one
/// invocation a unit. The stack's noise does 2,631; a field past this is asked hundreds of times
/// a pixel by the extraction's passes and solves, and is the frame's to pay.
pub const FIELD_WORK_MOST: u32 = 4096

/// How a contract's check over a region came out: boxes proven by the compiler's affine ranges
/// (`std::derive::affine`, IEEE-754 sound), boxes where the proof budget ran out and samples
/// didn't break, and boxes not asked (out of the contract's reach).
pub struct Proven: Copy {
    pub proven: u32,
    pub unproven: u32,
}

/// Splits `b` in half along its widest axis so sub-boxes stay well-proportioned and every split
/// costs 2 evaluations rather than 8.
fn bisect_widest(b: Box3) -> (Box3, Box3) {
    let ext = b.hi - b.lo
    if ext.x >= ext.y && ext.x >= ext.z {
        let m = 0.5 * (b.lo.x + b.hi.x)
        (
            Box3 { lo: b.lo, hi: vec3(m, b.hi.y, b.hi.z) },
            Box3 { lo: vec3(m, b.lo.y, b.lo.z), hi: b.hi },
        )
    } else if ext.y >= ext.z {
        let m = 0.5 * (b.lo.y + b.hi.y)
        (
            Box3 { lo: b.lo, hi: vec3(b.hi.x, m, b.hi.z) },
            Box3 { lo: vec3(b.lo.x, m, b.lo.z), hi: b.hi },
        )
    } else {
        let m = 0.5 * (b.lo.z + b.hi.z)
        (
            Box3 { lo: b.lo, hi: vec3(b.hi.x, b.hi.y, m) },
            Box3 { lo: vec3(b.lo.x, b.lo.y, m), hi: b.hi },
        )
    }
}

/// Pops the entry with the highest priority `score` from `work` (swap-remove in O(n), optimal for
/// the small active frontiers produced by affine pruning).
fn pop_worst(work: mut Vec<(Box3, f32, u32)>) -> (Box3, f32, u32) {
    var best_i: u32 = 0
    var best_s = work[0].1
    let n = work.len()
    for i in 1..n {
        if work[i].1 > best_s {
            best_s = work[i].1
            best_i = i
        }
    }
    let chosen = work[best_i]
    let last = work[n - 1]
    work[best_i] = last
    let _ = work.pop()
    chosen
}

/// Where a box past the subdivision budget is sampled: near its middle, and 8 points just in from
/// its corners, none on a line a tiling shares with a field's own.
fn probes(b: Box3, k: u32) -> vec3 {
    if k == 8 {
        b.lo + (b.hi - b.lo) * vec3(0.47, 0.52, 0.49)
    } else {
        let t = vec3(
            if (k & 1) != 0 { 0.87 } else { 0.13 },
            if (k & 2) != 0 { 0.89 } else { 0.11 },
            if (k & 4) != 0 { 0.83 } else { 0.17 },
        )
        b.lo + (b.hi - b.lo) * t
    }
}

/// The `i`th of `n`³ boxes tiling `[lo, lo + n·step]`.
fn tile(lo: vec3, step: f32, n: u32, i: u32) -> Box3 {
    let c = lo + vec3(f32(i % n), f32((i / n) % n), f32(i / (n * n))) * step
    Box3 { lo: c, hi: c + vec3(step) }
}

/// Maximum binary bisection depth and node budget per initial tile before falling back to probes.
/// Binary bisection along the widest axis shrinks volume by `2^depth` (depth 15 = 32× per axis).
const BISECT_DEPTH_MAX: u32 = 15
const BISECT_NODES_MAX: u32 = 96

/// Proves `bound().below(p) <= distance(p)` (to `slack`) wherever `below(p) > 0` in box `b` (the
/// only place it is read): by affine ranges of `distance - below` (which cancel radial slopes
/// linearly), adaptively bisecting the worst violating box along its widest axis.
fn prove_bound<S: Surface>(s: S, b: Box3, slack: f32, label: str) -> Proven {
    let bd = s.bound()
    if affine(|q: vec3| bd.below(q), b).hi <= 0.0 {
        return Proven { proven: 0, unproven: 0 }
    }
    let r0 = affine(|q: vec3| s.distance(q) - bd.below(q), b)
    if r0.lo >= -slack {
        return Proven { proven: 1, unproven: 0 }
    }
    var work: Vec<(Box3, f32, u32)> = Vec::new()
    work.push((b, -r0.lo, 0))
    var proven: u32 = 0
    var unproven: u32 = 0
    var splits: u32 = 0
    while work.len() > 0 {
        let (bx, _score, depth) = pop_worst(mut work)
        let (left, right) = bisect_widest(bx)
        splits += 1
        for side in 0..2 {
            let sub = if side == 0 { left } else { right }
            if affine(|q: vec3| bd.below(q), sub).hi <= 0.0 {
                continue
            }
            let r = affine(|q: vec3| s.distance(q) - bd.below(q), sub)
            if r.lo >= -slack {
                proven += 1
                continue
            }
            if r.hi < -slack {
                let p = sub.center()
                let below = bd.below(p)
                let d = s.distance(p)
                assert(
                    below <= 0.0 || below <= d + slack,
                    f"verify({label}): bound().below({p})={below} exceeds distance={d} (culling would drop matter)",
                )
            }
            if depth + 1 >= BISECT_DEPTH_MAX || splits >= BISECT_NODES_MAX {
                for k in 0..9 {
                    let p = probes(sub, k)
                    let below = bd.below(p)
                    let d = s.distance(p)
                    assert(
                        below <= 0.0 || below <= d + slack,
                        f"verify({label}): bound().below({p})={below} exceeds distance={d} (culling would drop matter)",
                    )
                }
                unproven += 1
            } else {
                work.push((sub, -r.lo, depth + 1))
            }
        }
    }
    Proven { proven, unproven }
}

/// Evaluates a sound upper bound on `sup_{q ∈ b} ||∇distance(q)||₂` via compiler-derived
/// hybrid Clarke-Lipschitz + interval-Jacobian propagation (`std::derive::lipschitz`).
fn grad_norm_bound<S: Surface>(s: S, b: Box3, _lim: f32) -> f32 {
    lipschitz(|q: vec3| s.distance(q), b)
}

/// Proves `|∇distance| <= lip` wherever `|distance| < near` in box `b`: a box whose derived
/// affine distance lies outside `±near` isn't asked; one whose Clarke-Lipschitz / affine gradient
/// bound stays below `lip` is proven; else the worst box is bisected along its widest axis.
fn prove_lipschitz<S: Surface>(s: S, b: Box3, near: f32, lip: f32, label: str) -> Proven {
    let f0 = interval(|q: vec3| s.distance(q), b)
    if f0.lo >= near || f0.hi <= -near {
        return Proven { proven: 0, unproven: 0 }
    }
    let lim = lip * 1.0001 + 1.0e-6
    let g0 = grad_norm_bound(s, b, lim)
    if g0 <= lim {
        return Proven { proven: 1, unproven: 0 }
    }
    var work: Vec<(Box3, f32, u32)> = Vec::new()
    work.push((b, g0, 0))
    var proven: u32 = 0
    var unproven: u32 = 0
    var splits: u32 = 0
    let max_splits: u32 = 32
    while work.len() > 0 {
        let (bx, _score, depth) = pop_worst(mut work)
        let (left, right) = bisect_widest(bx)
        splits += 1
        for side in 0..2 {
            let sub = if side == 0 { left } else { right }
            let f = interval(|q: vec3| s.distance(q), sub)
            if f.lo >= near || f.hi <= -near {
                continue
            }
            let gn = grad_norm_bound(s, sub, lim)
            if gn <= lim {
                proven += 1
                continue
            }
            if depth + 1 >= BISECT_DEPTH_MAX || splits >= max_splits {
                for k in 0..9 {
                    let p = probes(sub, k)
                    if abs(s.distance(p)) < near {
                        let gl = length(gradient(|q: vec3| s.distance(q), p))
                        if !(gl <= lip * 1.001 + 1.0e-4) {
                            let w = 0.01 * (sub.hi - sub.lo)
                            std::derive::precision(
                                |q: vec3| gradient(|z: vec3| s.distance(z), q),
                                Box3 { lo: p - w, hi: p + w },
                            )
                        }
                        assert(
                            gl <= lip * 1.001 + 1.0e-4,
                            f"verify({label}): ||grad({p})||={gl} exceeds lipschitz({near})={lip} (marching would step through surface)",
                        )
                    }
                }
                unproven += 1
            } else {
                work.push((sub, gn, depth + 1))
            }
        }
    }
    Proven { proven, unproven }
}

/// Proves the range `range` (a contract's, over a box holding `b`) holds the distance over `b`:
/// the derived affine interval inside it proves it; else `b` is bisected along its widest axis.
fn prove_holds<S: Surface>(s: S, b: Box3, range: Interval, what: str, label: str) -> Proven {
    let slack = 1.0e-4 * max(abs(range.lo), max(abs(range.hi), 1.0))
    let f0 = affine(|q: vec3| s.distance(q), b)
    if f0.lo >= range.lo - slack && f0.hi <= range.hi + slack {
        return Proven { proven: 1, unproven: 0 }
    }
    var work: Vec<(Box3, f32, u32)> = Vec::new()
    let sc0 = max(range.lo - f0.lo, f0.hi - range.hi)
    work.push((b, sc0, 0))
    var proven: u32 = 0
    var unproven: u32 = 0
    var splits: u32 = 0
    while work.len() > 0 {
        let (bx, _score, depth) = pop_worst(mut work)
        let (left, right) = bisect_widest(bx)
        splits += 1
        for side in 0..2 {
            let sub = if side == 0 { left } else { right }
            let f = affine(|q: vec3| s.distance(q), sub)
            if f.lo >= range.lo - slack && f.hi <= range.hi + slack {
                proven += 1
                continue
            }
            let sc = max(range.lo - f.lo, f.hi - range.hi)
            if depth + 1 >= BISECT_DEPTH_MAX || splits >= BISECT_NODES_MAX {
                for k in 0..9 {
                    let p = probes(sub, k)
                    let d = s.distance(p)
                    assert(
                        range.lo <= d + 1.0e-3 && d <= range.hi + 1.0e-3,
                        f"verify({label}): {what} [{range.lo}, {range.hi}] missed d={d} at {p}",
                    )
                }
                unproven += 1
            } else {
                work.push((sub, sc, depth + 1))
            }
        }
    }
    Proven { proven, unproven }
}

/// The most splits one claim of an enclosure is given before its boxes left are sampled, and how
/// deep: each split is two of the compiler's forms of the whole field, and a claim over a cell
/// is proven at once or after a few where the compiler's form keeps the field's slopes.
const SLOPE_SPLITS_MAX: u32 = 12
const SLOPE_DEPTH_MAX: u32 = 6

/// Proves `lo <= f(q) <= hi` over `b`, as the target computes `f`: by the compiler's affine range
/// of `f` over `b` (`std::derive::affine`, sound as the target rounds), bisecting along the
/// widest axis where the range is too wide; a box past the budget is sampled (`probes`). No
/// slack: a caller whose claim has a tolerance widens `lo` and `hi` by it, and says what it is.
fn prove_between<F: Copy + fn(vec3) -> f32>(
    f: F,
    b: Box3,
    lo: f32,
    hi: f32,
    what: str,
    label: str,
) -> Proven {
    let f0 = affine(|q: vec3| f(q), b)
    if f0.lo >= lo && f0.hi <= hi {
        return Proven { proven: 1, unproven: 0 }
    }
    var work: Vec<(Box3, f32, u32)> = Vec::new()
    work.push((b, max(lo - f0.lo, f0.hi - hi), 0))
    var proven: u32 = 0
    var unproven: u32 = 0
    var splits: u32 = 0
    while work.len() > 0 {
        let (bx, _score, depth) = pop_worst(mut work)
        let (left, right) = bisect_widest(bx)
        splits += 1
        for side in 0..2 {
            let sub = if side == 0 { left } else { right }
            let r = affine(|q: vec3| f(q), sub)
            if r.lo >= lo && r.hi <= hi {
                proven += 1
                continue
            }
            if depth + 1 >= SLOPE_DEPTH_MAX || splits >= SLOPE_SPLITS_MAX {
                for k in 0..9 {
                    let p = probes(sub, k)
                    let v = f(p)
                    assert(
                        lo <= v && v <= hi,
                        f"verify({label}): {what}: {v} at {p} is outside [{lo}, {hi}] (box {b.lo} to {b.hi})",
                    )
                }
                unproven += 1
            } else {
                work.push((sub, max(lo - r.lo, r.hi - hi), depth + 1))
            }
        }
    }
    Proven { proven, unproven }
}

/// Proves what `s.slope_affine(bx, live)` claims of `distance_live(q, live)` over `bx`
/// (`std::field::SlopeBox`, as the form the engine's certificates read): that its range holds the
/// distance, and that the distance is within `e` of its plane, `|distance(q) - (c + dot(l,
/// u(q)))| <= e` with `u(q) = (q - c_b) / h_in` (`form_box`). Each by the compiler's own
/// derivation (`prove_between`): the plane's by the affine range of that residual, in which the
/// field's own slopes cancel against the plane's where the compiler's form keeps them, so a
/// tight claim is proven and not only sampled.
///
/// The plane's tolerance is the claim's own and the check's rounding, nothing more: a form holds
/// for `q = c_b + h_in u + d` with `|d| <= delta` (`form_box`), so `u(q)` as computed here may be
/// `delta / h_in` off the form's (`dot(|l| / h_in, delta)`), and the residual's own sums round
/// by a few ulps of their terms. The range has none. A claim with no bound (`!af.valid()`) says
/// nothing and isn't asked.
fn prove_slope<S: Surface>(s: S, bx: Box3, live: Live, label: str) -> Proven {
    let af = s.slope_affine(bx, live)
    if !af.valid() {
        return Proven { proven: 0, unproven: 0 }
    }
    let range = af.range()
    let dist = |q: vec3| s.distance_live(q, live)
    let a = prove_between(dist, bx, range.lo, range.hi, "slope_affine's range", label)
    let (c_b, h_in, delta) = form_box(bx)
    let per = vec3(
        if h_in.x > 0.0 { af.l.x / h_in.x } else { 0.0 },
        if h_in.y > 0.0 { af.l.y / h_in.y } else { 0.0 },
        if h_in.z > 0.0 { af.l.z / h_in.z } else { 0.0 },
    )
    let size = abs(af.c) +
        abs(af.l.x) +
        abs(af.l.y) +
        abs(af.l.z) +
        max(abs(range.lo), abs(range.hi))
    let tol = dot(abs(per), delta) + size * (8.0 / 8388608.0) + 1.0e-37
    let c = af.c
    let residual = |q: vec3| s.distance_live(q, live) - (c + dot(per, q - c_b))
    let most = af.e + tol
    let b = prove_between(
        residual,
        bx,
        -most,
        most,
        "slope_affine's plane (the distance less it)",
        label,
    )
    Proven { proven: a.proven + b.proven, unproven: a.unproven + b.unproven }
}

/// `prove_slope` over `bx` with every part asked and, where the surface prunes any there, with
/// the parts live in `bx` grown by half its width (as the engine prunes a cell's:
/// `mesh::grid::cell_live`).
fn prove_slopes<S: Surface>(s: S, bx: Box3, label: str) -> Proven {
    let a = prove_slope(s, bx, ALL_LIVE, label)
    let pad = 0.5 * (bx.hi - bx.lo)
    let live = s.pruned(
        Box3 { lo: bx.lo - pad, hi: bx.hi + pad },
        |q: vec3| q,
        1.0,
        ALL_LIVE,
        0,
    ).live
    if live == ALL_LIVE {
        return a
    }
    let b = prove_slope(s, bx, live, label)
    Proven { proven: a.proven + b.proven, unproven: a.unproven + b.unproven }
}

fn unit(k: u32) -> f32 {
    f32(hash_u32(k) >> 8) * (1.0 / 16777216.0)
}

/// The cell sizes `Surface::slope_box` is held at near the surface (m): what the engine
/// certifies at, from the cells of a thing a metre off to those of one across a room.
const SLOPE_CELLS: [f32; 3] = [0.004, 0.012, 0.04]

/// Verifies every culling, marching and certificate contract of `s` by the compiler's affine
/// arithmetic with adaptive worst-box priority bisection (a sample that breaks a contract fails
/// the check, naming where):
/// - `bound()`: `below(p) <= distance(p)` wherever `below(p) > 0`, over an `n`³ tiling of 1.5
///   bound radii;
/// - `lipschitz(scope)`: `|∇distance| <= lipschitz(scope)` wherever `|distance| < scope` there;
/// - `interval_near(box)` and `pruned(box).range`: each holds the distance over `boxes` boxes of
///   three scales, and `distance_live` with `pruned`'s live parts is the distance there;
/// - `slope_box`: `verify_slope_soundness`, over those boxes and cells round `cells` points of
///   its surface.
/// Says how many boxes each proved and how many it left to samples.
pub fn verify_surface_soundness<S: Surface>(
    s: S,
    label: str,
    boxes: u32 = 24,
    samples: u32 = 128,
    cells: u32 = 8,
) {
    let b = s.bound()
    let bounded = b.radius > 0.0 && b.radius < 1.0e12
    assert(bounded, f"verify({label}): surface bound radius {b.radius} is not finite positive")
    let r = b.radius
    let n: u32 = 6
    let step = 3.0 * r / f32(n)
    let lo = b.centre - vec3(1.5 * r)
    var bound_p = Proven { proven: 0, unproven: 0 }
    var lip_p = Proven { proven: 0, unproven: 0 }
    let scope = max(0.25 * r, 0.25)
    let lip = s.lipschitz(scope)
    let check_lip = lip > 0.0 && lip < 1.0e12
    for i in 0..(n * n * n) {
        let bx = tile(lo, step, n, i)
        let far = length(max(abs(bx.lo - b.centre), abs(bx.hi - b.centre)))
        if far > r {
            let p = prove_bound(s, bx, 2.0e-3, label)
            bound_p = Proven {
                proven: bound_p.proven + p.proven,
                unproven: bound_p.unproven + p.unproven,
            }
        }
        if check_lip {
            let p = prove_lipschitz(s, bx, scope, lip, label)
            lip_p = Proven {
                proven: lip_p.proven + p.proven,
                unproven: lip_p.unproven + p.unproven,
            }
        }
    }
    let inner = Box3 { lo: b.centre - vec3(r), hi: b.centre + vec3(r) }
    var near_p = Proven { proven: 0, unproven: 0 }
    for bi in 0..boxes {
        let c = inner.sample(31, bi)
        let tier = bi % 3
        let half = if tier == 0 {
            max(0.20 * r, 0.05)
        } else if tier == 1 {
            max(0.05 * r, 0.02)
        } else {
            max(0.01 * r, 0.005)
        }
        let bx = Box3 { lo: c - vec3(half), hi: c + vec3(half) }
        let pr = s.pruned(bx, |q: vec3| q, 1.0, ALL_LIVE, 0)
        let a = prove_holds(s, bx, s.interval_near(bx), "interval_near", label)
        let c2 = prove_holds(s, bx, pr.range, "pruned range", label)
        near_p = Proven {
            proven: near_p.proven + a.proven + c2.proven,
            unproven: near_p.unproven + a.unproven + c2.unproven,
        }
        if pr.range.lo <= 0.0 && pr.range.hi >= 0.0 {
            for si in 0..16 {
                let p = bx.sample(101 + bi, si)
                let d = s.distance(p)
                let dl = s.distance_live(p, pr.live)
                assert(
                    abs(dl - d) <= 1.0e-3,
                    f"verify({label}): distance_live={dl} diverged from distance={d} at {p}",
                )
            }
        }
    }
    let _ = samples
    print(
        f"verify({label}): bound proven on {bound_p.proven} boxes ({bound_p.unproven} sampled), lipschitz on {lip_p.proven} ({lip_p.unproven} sampled), intervals on {near_p.proven} ({near_p.unproven} sampled)",
    )
    verify_slope_soundness(s, label, boxes, cells)
}

/// Verifies `s`'s enclosure (`Surface::slope_box`, as `slope_affine`; `prove_slope`): its range
/// and its plane hold over `boxes` boxes of three scales anywhere in its bound (those
/// `verify_surface_soundness` holds its other ranges over), and over cells of `SLOPE_CELLS`'
/// sizes (and a half of one, as a certificate halves them) round `cells` points of its surface,
/// each with every part asked and with the parts live there. Says how many boxes it proved and
/// how many it left to samples, and how many of its enclosures had slopes. A part of every
/// surface's contract (`verify_surface_soundness`); alone, the contract of a kind too heavy for
/// the rest (a carved thing's bound and steepness are held part by part, by its kit's own).
pub fn verify_slope_soundness<S: Surface>(s: S, label: str, boxes: u32 = 24, cells: u32 = 8) {
    let b = s.bound()
    let r = b.radius
    assert(
        r > 0.0 && r < 1.0e12,
        f"verify({label}): surface bound radius {r} is not finite positive",
    )
    let inner = Box3 { lo: b.centre - vec3(r), hi: b.centre + vec3(r) }
    var slope_p = Proven { proven: 0, unproven: 0 }
    for bi in 0..boxes {
        let c = inner.sample(31, bi)
        let tier = bi % 3
        let half = if tier == 0 {
            max(0.20 * r, 0.05)
        } else if tier == 1 {
            max(0.05 * r, 0.02)
        } else {
            max(0.01 * r, 0.005)
        }
        let sp = prove_slopes(s, Box3 { lo: c - vec3(half), hi: c + vec3(half) }, label)
        slope_p = Proven {
            proven: slope_p.proven + sp.proven,
            unproven: slope_p.unproven + sp.unproven,
        }
    }
    // Cells round points of its surface: where rays from inside its bound meet it.
    var found: u32 = 0
    var k: u32 = 0
    let reach = min(r, 1.0e4)
    while found < cells && k < 40 * cells {
        let o = b.centre +
            (vec3(unit(k * 11 + 1), unit(k * 11 + 2), unit(k * 11 + 3)) - vec3(0.5)) * reach
        let dv = vec3(unit(k * 11 + 4), unit(k * 11 + 5), unit(k * 11 + 6)) - vec3(0.5)
        k += 1
        if length(dv) < 0.05 {
            continue
        }
        let dir = normalize(dv)
        var t = 0.0
        var hit = false
        for _ in 0..256 {
            let f = s.distance(o + dir * t)
            if abs(f) < 1.0e-5 {
                hit = true
                break
            }
            t += abs(f) / max(s.lipschitz(abs(f)), 1.0)
            if !(t <= 2.0 * reach) {
                break
            }
        }
        if !hit {
            continue
        }
        let p = o + dir * t
        for ci in 0..4 {
            // Each size's cell with the point somewhere in it, then a half of one across an axis.
            let h = SLOPE_CELLS[if ci < 3 { ci } else { found % 3 }]
            let off = vec3(unit(k * 11 + 7 + ci), unit(k * 11 + 8 + ci), unit(k * 11 + 9 + ci)) * h
            let c_lo = p - off
            var ext = vec3(h)
            if ci == 3 {
                let axis = found % 3
                ext = vec3(
                    if axis == 0 { 0.5 * h } else { h },
                    if axis == 1 { 0.5 * h } else { h },
                    if axis == 2 { 0.5 * h } else { h },
                )
            }
            let sp = prove_slopes(s, Box3 { lo: c_lo, hi: c_lo + ext }, label)
            slope_p = Proven {
                proven: slope_p.proven + sp.proven,
                unproven: slope_p.unproven + sp.unproven,
            }
        }
        found += 1
    }
    print(
        f"verify({label}): enclosures proven on {slope_p.proven} boxes ({slope_p.unproven} sampled), {boxes} boxes in its bound and cells round {found} points of its surface",
    )
}

/// What `verify_moving_soundness` found of a field that moves, over a span of time: the boxes
/// (of space and time) its bound and its steepness are proven on and sampled on, and how fast
/// its distance changes where it is near its surface, in metres a second: `rate` the most the
/// compiler's derivation allows anywhere it could bound it (infinite where it bounded none),
/// and `seen` the most met at the points sampled.
pub struct Moving: Copy {
    pub bound: Proven,
    pub steep: Proven,
    pub rated: Proven,
    pub rate: f32,
    pub seen: f32,
}

/// The greater magnitude of `i`'s ends.
fn most_abs(i: Interval) -> f32 {
    max(abs(i.lo), abs(i.hi))
}

/// `b` halved across the axis it is widest along, its span of time weighed as `time` is to
/// `space` (the widths of the box it came from).
fn bisect4(b: Box4, space: f32, time: f32) -> (Box4, Box4) {
    let e = b.hi - b.lo
    let m = 0.5 * (b.lo + b.hi)
    let wide = max(e.x, max(e.y, e.z)) / max(space, 1.0e-12)
    if e.w / max(time, 1.0e-12) > wide {
        (
            Box4 { lo: b.lo, hi: vec4(b.hi.xyz, m.w) },
            Box4 { lo: vec4(b.lo.xyz, m.w), hi: b.hi },
        )
    } else if e.x >= e.y && e.x >= e.z {
        (
            Box4 { lo: b.lo, hi: vec4(m.x, b.hi.y, b.hi.z, b.hi.w) },
            Box4 { lo: vec4(m.x, b.lo.y, b.lo.z, b.lo.w), hi: b.hi },
        )
    } else if e.y >= e.z {
        (
            Box4 { lo: b.lo, hi: vec4(b.hi.x, m.y, b.hi.z, b.hi.w) },
            Box4 { lo: vec4(b.lo.x, m.y, b.lo.z, b.lo.w), hi: b.hi },
        )
    } else {
        (
            Box4 { lo: b.lo, hi: vec4(b.hi.x, b.hi.y, m.z, b.hi.w) },
            Box4 { lo: vec4(b.lo.x, b.lo.y, m.z, b.lo.w), hi: b.hi },
        )
    }
}

/// The boxes of space and time one of `verify_moving_soundness`'s tiles may be halved into
/// before what is still unproven of it is sampled, and how many times over.
const MOVING_NODES_MAX: u32 = 24
const MOVING_DEPTH_MAX: u32 = 6

/// Time as `verify_moving_soundness` scales it where it asks a field's steepness in space alone:
/// the derived bound is of the gradient in space and time together, and with a second this many
/// units long the rate of change is no part of it to speak of.
const MOVING_TIME_SCALE: f32 = 1.0e-4

/// Holds a field that moves to its contract at every moment from `from` to `to` (seconds), not
/// at one: `at(t)` is the field at `t`. A moving thing's `bound()` and `lipschitz()` are stated of
/// the field at a moment, and `verify_surface_soundness` holds them at the moment it is given;
/// here the compiler's ranges are taken over boxes of space and time together (`std::derive`
/// over a `vec4`, time its fourth coordinate), so what is proven is proven of every moment in
/// the span:
///
/// - the bound: `at(t).bound().below(p) <= at(t).distance(p)` for every `p` and `t` of a box;
/// - the steepness: the gradient in space no longer than the greatest `lipschitz` stated in the
///   span, wherever the distance is within the bound's scope of 0;
/// - the rate: the most the distance changes a second there (its derivative by time), which no
///   contract states: it is what the engine may count on of a thing that moves (how far its
///   surface can be from a mesh made a frame ago), and it is returned and said.
///
/// A box the proof can't close is halved, across space or time, to a budget, then sampled (the
/// bound and the steepness asserted at its probes, the rate measured there). `spans` spans of
/// time are each tiled round the bound at their middle.
pub fn verify_moving_soundness<S: Surface, F: Copy + fn(f32) -> S>(
    at: F,
    from: f32,
    to: f32,
    label: str,
    spans: u32 = 8,
) -> Moving {
    assert(to > from && spans > 0, f"verify({label}): a span of time from {from} to {to}")
    let n: u32 = 4
    let dt = (to - from) / f32(spans)
    var bound_p = Proven { proven: 0, unproven: 0 }
    var steep_p = Proven { proven: 0, unproven: 0 }
    var rated_p = Proven { proven: 0, unproven: 0 }
    var rate = 0.0
    var seen = 0.0
    for k in 0..spans {
        let t0 = from + dt * f32(k)
        let t1 = t0 + dt
        let tm = 0.5 * (t0 + t1)
        let b0 = at(t0).bound()
        let b1 = at(t1).bound()
        let bm = at(tm).bound()
        // Round the bound at the span's middle, and as far again as its ends' stand from it.
        let r = max(bm.radius, max(b0.radius, b1.radius)) +
            max(length(b0.centre - bm.centre), length(b1.centre - bm.centre))
        assert(r > 0.0 && r < 1.0e12, f"verify({label}): its bound's radius {r} at {tm} s is not finite positive")
        let near = max(0.25 * r, 0.25)
        let lip = max(at(tm).lipschitz(near), max(at(t0).lipschitz(near), at(t1).lipschitz(near)))
        let check_lip = lip > 0.0 && lip < 1.0e12
        let lim = lip * 1.0001 + 1.0e-6
        let step = 3.0 * r / f32(n)
        let lo = bm.centre - vec3(1.5 * r)
        for i in 0..(n * n * n) {
            let bx = tile(lo, step, n, i)
            var work: Vec<(Box4, u32)> = Vec::new()
            work.push((Box4 { lo: vec4(bx.lo, t0), hi: vec4(bx.hi, t1) }, 0))
            var nodes: u32 = 0
            while work.len() > 0 {
                let (c, depth) = work.pop().unwrap()
                nodes += 1
                // The bound, where it is read (where it says the surface is some way off).
                let asked_bound = affine(|v: vec4| at(v.w).bound().below(v.xyz), c).hi > 0.0
                let bound_ok = !asked_bound ||
                    affine(
                        |v: vec4| {
                            let s = at(v.w)
                            s.distance(v.xyz) - s.bound().below(v.xyz)
                        },
                        c,
                    ).lo >= -2.0e-3
                // The steepness and the rate, where the surface can be near.
                let f = interval(|v: vec4| at(v.w).distance(v.xyz), c)
                let asked_near = !(f.lo >= near || f.hi <= -near)
                // In space alone: with time scaled, the rate is no part of the gradient's length.
                let scaled = Box4 {
                    lo: vec4(c.lo.xyz, (c.lo.w - tm) / MOVING_TIME_SCALE),
                    hi: vec4(c.hi.xyz, (c.hi.w - tm) / MOVING_TIME_SCALE),
                }
                let steep_ok = !asked_near ||
                    !check_lip ||
                    lipschitz(|v: vec4| at(tm + v.w * MOVING_TIME_SCALE).distance(v.xyz), scaled) <= lim
                let by_time = if asked_near {
                    most_abs(interval(|v: vec4| gradient(|u: vec4| at(u.w).distance(u.xyz), v).w, c))
                } else {
                    0.0
                }
                let rate_ok = !asked_near || by_time < 1.0e12
                let done = bound_ok && steep_ok && rate_ok
                if !done && depth < MOVING_DEPTH_MAX && nodes < MOVING_NODES_MAX {
                    let (left, right) = bisect4(c, step, dt)
                    work.push((left, depth + 1))
                    work.push((right, depth + 1))
                    continue
                }
                // A leaf: what is proven of it counted, the rest sampled.
                if asked_bound && bound_ok {
                    bound_p = Proven { proven: bound_p.proven + 1, unproven: bound_p.unproven }
                }
                if asked_near && check_lip && steep_ok {
                    steep_p = Proven { proven: steep_p.proven + 1, unproven: steep_p.unproven }
                }
                if asked_near && rate_ok {
                    rated_p = Proven { proven: rated_p.proven + 1, unproven: rated_p.unproven }
                    rate = max(rate, by_time)
                }
                if asked_bound && !bound_ok {
                    bound_p = Proven { proven: bound_p.proven, unproven: bound_p.unproven + 1 }
                }
                if asked_near && check_lip && !steep_ok {
                    steep_p = Proven { proven: steep_p.proven, unproven: steep_p.unproven + 1 }
                }
                if asked_near && !rate_ok {
                    rated_p = Proven { proven: rated_p.proven, unproven: rated_p.unproven + 1 }
                    rate = 1.0 / 0.0
                }
                if !asked_bound && !asked_near {
                    continue
                }
                let space = Box3 { lo: c.lo.xyz, hi: c.hi.xyz }
                for m in 0..3 {
                    let t = c.lo.w + (c.hi.w - c.lo.w) * (0.13 + 0.37 * f32(m))
                    let s = at(t)
                    for j in 0..9 {
                        let p = probes(space, j)
                        let d = s.distance(p)
                        if asked_bound && !bound_ok {
                            let below = s.bound().below(p)
                            assert(
                                below <= 0.0 || below <= d + 2.0e-3,
                                f"verify({label}): at {t} s bound().below({p})={below} exceeds distance={d} (culling would drop matter)",
                            )
                        }
                        if asked_near && abs(d) < near {
                            let g = gradient(|u: vec4| at(u.w).distance(u.xyz), vec4(p, t))
                            seen = max(seen, abs(g.w))
                            if check_lip && !steep_ok {
                                let gl = length(g.xyz)
                                assert(
                                    gl <= lip * 1.001 + 1.0e-4,
                                    f"verify({label}): at {t} s ||grad({p})||={gl} exceeds lipschitz({near})={lip} (marching would step through surface)",
                                )
                            }
                        }
                    }
                }
            }
        }
    }
    print(
        f"verify({label}) moving, {from} to {to} s: bound proven on {bound_p.proven} boxes ({bound_p.unproven} sampled), steepness on {steep_p.proven} ({steep_p.unproven} sampled); near its surface its distance changes at most {rate} m a second by the derivation (bounded on {rated_p.proven} boxes, {rated_p.unproven} not), the most at a sampled point {seen}",
    )
    Moving { bound: bound_p, steep: steep_p, rated: rated_p, rate, seen }
}

/// Verifies that `Edited<M>`'s `dirty_region()` encloses every point where `edited.distance(p)`
/// differs from `base.distance(p)`, ensuring incremental CSG brick re-extraction never leaves stale
/// bricks (holes or ghost geometry).
pub fn verify_edits_soundness<M: Field<Substance> + StateHash>(
    base: M,
    ed: Edited<M>,
    label: str,
    samples: u32 = 512,
) {
    verify_surface_soundness(ed, label, boxes: 18, samples: 96)
    let dirty = match ed.dirty_region() {
        Some(bx) => bx,
        None => {
            // No dirty region reported => edited field must match base everywhere.
            let b = base.bound()
            let bx = Box3 { lo: b.centre - vec3(b.radius), hi: b.centre + vec3(b.radius) }
            for i in 0..samples {
                let p = bx.sample(59, i)
                assert(
                    abs(ed.distance(p) - base.distance(p)) <= 1.0e-4,
                    f"verify_edits({label}): dirty_region() is None but distance changed at {p}",
                )
            }
            return
        },
    }
    let b = ed.bound()
    let search = Box3 { lo: b.centre - vec3(b.radius), hi: b.centre + vec3(b.radius) }
    let pad_dirty = Box3 { lo: dirty.lo - vec3(1.0e-3), hi: dirty.hi + vec3(1.0e-3) }
    for i in 0..samples {
        let p = search.sample(73, i)
        let db = base.distance(p)
        let de = ed.distance(p)
        let sign_changed = (db < 0.0) != (de < 0.0)
        let near_surface = min(abs(db), abs(de)) <= 0.08
        if sign_changed || (near_surface && abs(de - db) > 1.0e-4) {
            assert(
                pad_dirty.contains(p),
                f"verify_edits({label}): surface/band changed ({db} -> {de}) at {p} outside dirty_region [{dirty.lo}, {dirty.hi}]",
            )
        }
    }
}

/// The ranges a substance's channels hold to: every one finite; albedo, roughness, metalness,
/// transmission, subsurface, coat and relief in `[0, 1]` (albedo above 1 reflects more light than
/// falls on it); index of refraction in `[1, 3]`; emission at least 0.
fn channels_hold(
    albedo: Box3,
    roughness: Interval,
    emits: Box3,
    metallic: Interval,
    ior: Interval,
    transmission: Interval,
    subsurface: Interval,
    coat: Interval,
    micro: Interval,
) -> bool {
    let unit = |x: Interval| x.lo >= 0.0 && x.hi <= 1.0
    let unit3 = |x: Box3| x.lo.x >= 0.0 &&
        x.lo.y >= 0.0 &&
        x.lo.z >= 0.0 &&
        x.hi.x <= 1.0 &&
        x.hi.y <= 1.0 &&
        x.hi.z <= 1.0
    let finite = emits.hi.x < 1.0e30 && emits.hi.y < 1.0e30 && emits.hi.z < 1.0e30
    unit3(albedo) &&
        unit(roughness) &&
        emits.lo.x >= 0.0 &&
        emits.lo.y >= 0.0 &&
        emits.lo.z >= 0.0 &&
        finite &&
        unit(metallic) &&
        ior.lo >= 1.0 &&
        ior.hi <= 3.0 &&
        unit(transmission) &&
        unit(subsurface) &&
        unit(coat) &&
        unit(micro)
}

/// Whether one substance, at a point, holds to `channels_hold`'s ranges (a NaN holds to none).
fn substance_holds(c: Substance) -> bool {
    let point = |x: f32| Interval { lo: x, hi: x }
    let p3 = |v: vec3| Box3 { lo: v, hi: v }
    channels_hold(
        p3(c.albedo),
        point(c.roughness),
        p3(c.emits),
        point(c.metallic),
        point(c.ior),
        point(c.transmission),
        point(c.subsurface),
        point(c.coat),
        point(c.micro),
    )
}

/// Checks all 9 `Substance` channels over `b` using vector `affine<vec3, vec3>` for `albedo`/
/// `emits` and zero-overhead `affine_form` for scalar channels, short-circuiting on first failure.
fn box_channels_ok<F: Field<Substance>>(f: F, b: Box3) -> bool {
    let albedo = affine(|q: vec3| f.channels(q).albedo, b)
    let albedo_ok = albedo.lo.x >= -1.0e-4 &&
        albedo.hi.x <= 1.0 + 1.0e-4 &&
        albedo.lo.y >= -1.0e-4 &&
        albedo.hi.y <= 1.0 + 1.0e-4 &&
        albedo.lo.z >= -1.0e-4 &&
        albedo.hi.z <= 1.0 + 1.0e-4
    if !albedo_ok {
        return false
    }
    let rough = affine(|q: vec3| f.channels(q).roughness, b)
    if !(rough.lo >= -1.0e-4 && rough.hi <= 1.0 + 1.0e-4) {
        return false
    }
    let emits = affine(|q: vec3| f.channels(q).emits, b)
    let emits_ok = emits.lo.x >= -1.0e-4 &&
        emits.lo.y >= -1.0e-4 &&
        emits.lo.z >= -1.0e-4 &&
        emits.hi.x < 1.0e12 &&
        emits.hi.y < 1.0e12 &&
        emits.hi.z < 1.0e12
    if !emits_ok {
        return false
    }
    let metallic = affine(|q: vec3| f.channels(q).metallic, b)
    if !(metallic.lo >= -1.0e-4 && metallic.hi <= 1.0 + 1.0e-4) {
        return false
    }
    let ior = affine(|q: vec3| f.channels(q).ior, b)
    if !(ior.lo >= 1.0 - 1.0e-4 && ior.hi <= 3.0 + 1.0e-4) {
        return false
    }
    let trans = affine(|q: vec3| f.channels(q).transmission, b)
    if !(trans.lo >= -1.0e-4 && trans.hi <= 1.0 + 1.0e-4) {
        return false
    }
    let sss = affine(|q: vec3| f.channels(q).subsurface, b)
    if !(sss.lo >= -1.0e-4 && sss.hi <= 1.0 + 1.0e-4) {
        return false
    }
    let coat = affine(|q: vec3| f.channels(q).coat, b)
    if !(coat.lo >= -1.0e-4 && coat.hi <= 1.0 + 1.0e-4) {
        return false
    }
    let micro = affine(|q: vec3| f.channels(q).micro, b)
    micro.lo >= -1.0e-4 && micro.hi <= 1.0 + 1.0e-4
}

/// Proves `f`'s substance holds to `channels_hold`'s ranges over `b` where its surface can be
/// (`near` of it, by the derived affine range of its distance): by affine bounds on every channel,
/// adaptively bisecting along the widest axis where too wide.
fn prove_channels<F: Field<Substance>>(f: F, b: Box3, near: f32, label: str) -> Proven {
    let d0 = affine(|q: vec3| f.distance(q), b)
    if d0.lo > near || d0.hi < -near {
        return Proven { proven: 0, unproven: 0 }
    }
    if box_channels_ok(f, b) {
        return Proven { proven: 1, unproven: 0 }
    }
    var work: Vec<(Box3, f32, u32)> = Vec::new()
    work.push((b, length(b.hi - b.lo), 0))
    var proven: u32 = 0
    var unproven: u32 = 0
    var splits: u32 = 0
    let max_splits: u32 = 32
    while work.len() > 0 {
        let (bx, _score, depth) = pop_worst(mut work)
        let (left, right) = bisect_widest(bx)
        splits += 1
        for side in 0..2 {
            let sub = if side == 0 { left } else { right }
            let d = affine(|q: vec3| f.distance(q), sub)
            if d.lo > near || d.hi < -near {
                continue
            }
            if box_channels_ok(f, sub) {
                proven += 1
                continue
            }
            if depth + 1 >= BISECT_DEPTH_MAX || splits >= max_splits {
                for k in 0..9 {
                    let p = probes(sub, k)
                    let c = f.channels(p)
                    if !substance_holds(c) {
                        let w = 0.01 * (sub.hi - sub.lo)
                        std::derive::precision(
                            |q: vec3| f.channels(q).albedo,
                            Box3 { lo: p - w, hi: p + w },
                        )
                    }
                    assert(
                        substance_holds(c),
                        f"verify({label}): the substance at {p} leaves its ranges (albedo {c.albedo}, roughness {c.roughness}, emits {c.emits}, metallic {c.metallic}, ior {c.ior}, transmission {c.transmission}, subsurface {c.subsurface}, coat {c.coat}, micro {c.micro}): albedo, roughness, metallic, transmission, subsurface, coat and micro each in [0, 1], ior in [1, 3], emits at least 0, none NaN",
                    )
                }
                unproven += 1
            } else {
                work.push((sub, length(sub.hi - sub.lo), depth + 1))
            }
        }
    }
    Proven { proven, unproven }
}

/// Verifies a field: its surface's contracts (`verify_surface_soundness`), and its substance,
/// wherever its surface can be (within a fiftieth of its bound radius), holds to the physical
/// ranges of `channels_hold` (proven by affine arithmetic with adaptive priority bisection).
pub fn verify_field_soundness<F: Field<Substance>>(f: F, label: str) {
    verify_surface_soundness(f, label)
    let b = f.bound()
    let r = b.radius
    let n: u32 = 6
    let step = 3.0 * r / f32(n)
    let lo = b.centre - vec3(1.5 * r)
    let near = max(0.02 * r, 0.01)
    var p = Proven { proven: 0, unproven: 0 }
    for i in 0..(n * n * n) {
        let sub = prove_channels(f, tile(lo, step, n, i), near, label)
        p = Proven { proven: p.proven + sub.proven, unproven: p.unproven + sub.unproven }
    }
    print(f"verify({label}): substance in range, proven on {p.proven} boxes ({p.unproven} sampled)")
}

/// Zero-sample build-time proof of a finite Lipschitz bound over the near-surface region of `bx`.
/// Returns a finite bound `>= 1.0` ONLY when 100% of active leaves are algebraically bounded by
/// `std::derive::lipschitz` (0 sampled leaves); otherwise returns `+inf` so runtime solvers
/// automatically route to the sound 1D `affine_form` Krawczyk path.
fn prove_lip_zero_sample<F: Field<Substance>>(f: F, bx: Box3, near: f32) -> f32 {
    let root = lipschitz(|q: vec3| f.distance(q), bx)
    if root > 0.0 && root < 1.0e12 {
        return max(root, 1.0)
    }
    var work: Vec<(Box3, f32, u32)> = Vec::new()
    work.push((bx, length(bx.hi - bx.lo), 0))
    var g_max = 1.0
    var splits: u32 = 0
    while work.len() > 0 {
        let (cur, _score, depth) = pop_worst(mut work)
        let (left, right) = bisect_widest(cur)
        splits += 1
        for side in 0..2 {
            let sub = if side == 0 { left } else { right }
            let dr = affine(|q: vec3| f.distance(q), sub)
            if dr.lo > near || dr.hi < -near {
                continue
            }
            let g = lipschitz(|q: vec3| f.distance(q), sub)
            if g > 0.0 && g < 1.0e12 {
                g_max = max(g_max, g)
            } else if depth + 1 >= 6 || splits >= 32 {
                return 1.0 / 0.0
            } else {
                work.push((sub, length(sub.hi - sub.lo), depth + 1))
            }
        }
    }
    g_max
}

/// Zero-sample build-time proof that every `Substance` channel of `f` stays finite and inside
/// physical PBR bounds across every near-surface box of `bx` (`0` sampled leaves).
fn prove_channels_zero_sample<F: Field<Substance>>(f: F, bx: Box3, near: f32) -> bool {
    if box_channels_ok(f, bx) {
        return true
    }
    var work: Vec<(Box3, f32, u32)> = Vec::new()
    work.push((bx, length(bx.hi - bx.lo), 0))
    var splits: u32 = 0
    while work.len() > 0 {
        let (cur, _score, depth) = pop_worst(mut work)
        let (left, right) = bisect_widest(cur)
        splits += 1
        for side in 0..2 {
            let sub = if side == 0 { left } else { right }
            let dr = affine(|q: vec3| f.distance(q), sub)
            if dr.lo > near || dr.hi < -near {
                continue
            }
            if box_channels_ok(f, sub) {
                continue
            }
            if depth + 1 >= 5 || splits >= 24 {
                return false
            }
            work.push((sub, length(sub.hi - sub.lo), depth + 1))
        }
    }
    true
}

/// Proves static `FieldFacts` (`lip`, `may_transmit`, `may_emit`, `may_coat`, `may_subsurface`,
/// `may_micro`, `channels_proven`) at build time (`const`) via zero-sample compiler-
/// derived Clarke-Lipschitz (`lipschitz`) and affine arithmetic (`affine`) over `f.bound()`.
///
/// Soundness: every zero-set point `{d(p) <= 0}` lies inside `f.bound()`. No bound or channel
/// proof ever falls back to point sampling: unproven Lipschitz returns `+inf` (routing to sound
/// 1D affine Krawczyk), and unproven channels set `channels_proven = false` (retaining branchless
/// NaN/range sanitization at shading boundaries). Evaluating this in a `const` erases the verifier
/// completely from shipped binaries.
pub fn prove_field_facts<F: Field<Substance>>(f: F) -> FieldFacts {
    let b = f.bound()
    if !(b.radius > 0.0 && b.radius < 1.0e12) {
        return FieldFacts::unknown()
    }
    let bx = Box3 { lo: b.centre - vec3(b.radius), hi: b.centre + vec3(b.radius) }
    let near = max(0.05 * b.radius, 0.02)
    let lip = prove_lip_zero_sample(f, bx, near)
    let trans = affine(|q: vec3| f.channels(q).transmission, bx)
    let may_transmit = !(trans.hi <= 0.02)
    let em = affine(|q: vec3| f.channels(q).emits, bx)
    let may_emit = !(em.hi.x <= 1.0e-5 && em.hi.y <= 1.0e-5 && em.hi.z <= 1.0e-5)
    let coat = affine(|q: vec3| f.channels(q).coat, bx)
    let may_coat = !(coat.hi <= 0.01)
    let sss = affine(|q: vec3| f.channels(q).subsurface, bx)
    let may_subsurface = !(sss.hi <= 0.01)
    let micro = affine(|q: vec3| f.channels(q).micro, bx)
    let may_micro = !(micro.hi <= 0.01)
    let bp = affine(|q: vec3| f.channels(q).bump, bx)
    let may_bump = !(bp.lo >= -1.0e-7 && bp.hi <= 1.0e-7)
    let channels_proven = prove_channels_zero_sample(f, bx, near)
    FieldFacts::asserted(
        lip: lip,
        may_transmit: may_transmit,
        may_emit: may_emit,
        may_coat: may_coat,
        may_subsurface: may_subsurface,
        may_micro: may_micro,
        may_bump: may_bump,
        channels_proven: channels_proven,
        distance_work: work(|q: vec3| f.distance(q)),
        channels_work: work(|q: vec3| f.channels(q)),
    )
}

// ---- std's combinators' enclosures (`std::field`): each composes its operands' (a join by
// `slope_smin`, a map by its `MapBox`), and none of the game's kinds asks some of them. Held here
// as any kind's are (`verify_slope_soundness`): the compiler's form of the whole proves the
// composed one.

/// A ball with a block beside it, the block a metre a side at most: operands for the joins.
fn two_parts() -> (std::field::Sphere, Translate<std::field::Cuboid>) {
    (sphere(0.5), cuboid(vec3(0.3, 0.2, 0.25)).translate(vec3(0.45, 0.1, -0.05)))
}

@test
fn std_joins_enclosures_are_sound() {
    let (ball, block) = two_parts()
    verify_slope_soundness(ball.union(block), "std union")
    verify_slope_soundness(ball.smooth_union(block, k: 0.08), "std smooth_union")
    verify_slope_soundness(ball.intersect(block), "std intersect")
    verify_slope_soundness(ball.smooth_intersect(block, k: 0.05), "std smooth_intersect")
    verify_slope_soundness(ball.smooth_subtract(block, k: 0.04), "std smooth_subtract")
    let limbs = [
        round_cone(vec3(0.0), vec3(0.0, 0.6, 0.0), r_top: 0.08, r_bottom: 0.12),
        round_cone(vec3(0.0, 0.5, 0.0), vec3(0.3, 0.8, 0.1), r_top: 0.05, r_bottom: 0.08),
        round_cone(vec3(0.0, 0.5, 0.0), vec3(-0.3, 0.7, -0.1), r_top: 0.05, r_bottom: 0.08),
        round_cone(vec3(0.0, 0.1, 0.0), vec3(0.25, -0.2, 0.15), r_top: 0.06, r_bottom: 0.09),
    ]
    verify_slope_soundness(limbs.union(), "std union of an array")
    verify_slope_soundness(limbs.smooth_union(k: 0.06), "std smooth_union of an array")
}

@test
fn std_maps_enclosures_are_sound() {
    let (ball, block) = two_parts()
    let turn = Quat::axis_angle(normalize(vec3(0.3, 1.0, -0.2)), 0.7)
    verify_slope_soundness(block.rotate(turn), "std rotate")
    verify_slope_soundness(
        block.scale(1.7).rotate(turn).translate(vec3(2.0, -1.0, 0.5)),
        "std scale",
    )
    verify_slope_soundness(block.scale(-0.6), "std scale by a negative")
    verify_slope_soundness(block.mirror_x(), "std mirror_x")
    verify_slope_soundness(ball.smooth_union(block, k: 0.08).named("both"), "std named")
    verify_slope_soundness(
        ball.union(block).displace(fbm(freq: 5.0, octaves: 2), amp: 0.01),
        "std displace",
    )
}
