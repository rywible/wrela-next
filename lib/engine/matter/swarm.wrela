// Discrete matter swarms (`Swarm`): clouds of physical grains, shards, sparks, or sand derived
// from pure fields and driven by continuous 3D force fields.
//
// Authors write only pure math (`seed_at`, `force_at`, `substance_at`): the engine simulates up to
// `SWARM_CAP` grains on the GPU with exact analytical `World` SDF collision and renders them inside
// the unified 4× MSAA linear-HDR pass, shadow map, and One Light store.

use matter::substance::{Substance, lambert}

/// Initial spawn state for one grain in a `Swarm` (32 bytes, std430-aligned).
pub struct GrainSeed: Copy + GpuData {
    /// Initial world position `(x, y, z)`.
    pub pos: vec3,
    /// Grain physical radius (m).
    pub radius: f32,
    /// Initial world velocity `(vx, vy, vz)` (m/s).
    pub vel: vec3,
    /// Maximum lifetime (s); `<= 0.0` marks an inactive/unused grain slot.
    pub life: f32,
}

/// Pure field-driven description of a discrete matter swarm (no GPU code in callers).
pub trait Swarm: Copy + GpuData {
    /// Whether this swarm is active (`false` skips all simulation and drawing at 0.0 ms).
    fn active(self) -> bool

    /// Number of grains to simulate (clamped by the engine to `SWARM_CAP`).
    fn count(self) -> u32

    /// State token: whenever `epoch()` changes, the engine respawns all grains from `seed_at`.
    fn epoch(self) -> u32

    /// Simulation timestep in seconds (e.g. `0.016667`).
    fn step_dt(self) -> f32

    /// Initial position, radius, velocity, and lifetime of grain `i`.
    fn seed_at(self, i: u32) -> GrainSeed

    /// Optional initial emission delay (s) for grain `i` so a swarm can emit as a continuous stream.
    fn seed_delay(self, _i: u32) -> f32 {
        0.0
    }

    /// Whether expired grains (`age >= life`) continuously respawn from `seed_at`.
    fn looping(self) -> bool {
        true
    }

    /// Optional physics pre-warm steps run once on epoch spawn (clamped to 60; 0 ms thereafter).
    fn prewarm_steps(self) -> u32 {
        0
    }

    /// Continuous 3D acceleration field (m/s²) acting on a grain at `(pos, vel, age, h)`.
    fn force_at(self, pos: vec3, vel: vec3, age: f32, h: f32) -> vec3

    /// Aerodynamic drag coefficient (1/s) damping velocity smoothly.
    fn drag(self) -> f32 {
        0.35
    }

    /// Collision bounciness against world SDF surfaces (`0.0` dead stop .. `1.0` elastic).
    fn restitution(self) -> f32 {
        0.32
    }

    /// Physical `Substance` of a grain at `(pos, vel, age, h)`—may smoothly transmute over time
    /// or space (e.g., refractive crystal -> glowing golden spark -> warm mineral sand).
    fn substance_at(self, pos: vec3, vel: vec3, age: f32, h: f32) -> Substance
}

/// Absent swarm (zero runtime cost).
pub struct NoSwarm: Copy + GpuData {}

impl Swarm for NoSwarm {
    fn active(self) -> bool {
        false
    }

    fn count(self) -> u32 {
        0
    }

    fn epoch(self) -> u32 {
        0
    }

    fn step_dt(self) -> f32 {
        0.016667
    }

    fn seed_at(self, _i: u32) -> GrainSeed {
        GrainSeed { pos: vec3(0.0), radius: 0.0, vel: vec3(0.0), life: 0.0 }
    }

    fn force_at(self, _pos: vec3, _vel: vec3, _age: f32, _h: f32) -> vec3 {
        vec3(0.0)
    }

    fn substance_at(self, _pos: vec3, _vel: vec3, _age: f32, _h: f32) -> Substance {
        lambert(vec3(0.0))
    }
}
