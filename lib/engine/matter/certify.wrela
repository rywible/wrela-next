// Certificates: what a field's enclosures prove about the surface inside a cell, so a mesh there
// can be trusted to cover what the field covers without solving its pixels.
//
// A sheet certificate says the surface inside a cell lies in a slab no wider than `width`
// parallel to a plane (the plane of the cell's mesh vertex, where the extraction asks it). It is
// proven directly in world space from one enclosure of the field per sub-box
// (`Surface::slope_affine`: the field's own, composed through its combinators, the compiler's
// affine form of a leaf that states none; one path for every kind):
//   `f(p) = c + dot(l, u) + η`, `|η| ≤ e` over `u ∈ [-1, 1]³`, `p = c_b + h_in * u + δ`.
// Projecting the linear part onto `w(p) = dot(p - at, n)` (`w_l = h_in * n`) with optimal slope
// `α = dot(l / h_in, n)` splits `dot(l, u) = α (w(p) - w_mid) + dot(r, u)` (`r = l - α w_l`),
// giving a tight slab `[w_mid - c / α ± (|r|₁ + e) / |α|]` intersected with the box's exact span
// `[w_mid ± |w_l|₁]`. Any sub-box that does not yet fit within `width` is bisected along the world
// axis dominating `|w_l| + |r| / |α|`, pre-pruning halves already proved empty by `af.sub_range`.
// Not certified is not a fault: the cell's pixels are solved.
//
// `certify_sheet` runs on the CPU (the scoreboard, `certify_report`) and in the extraction's
// kernels alike: no recursion, a fixed stack, the field read where it lies (`fields[which]`).

use std::derive::{Box3, gradient}
use std::field::{ALL_LIVE, Live, Surface, hash_u32}
use std::io::print

/// The most parts of a cell a sheet certificate looks at: past it the cell is not certified.
pub const SHEET_VISITS: u32 = 7

const CERT_EPS: f32 = 1.0 / 8388608.0
const CERT_TINY: f32 = 1.2e-38

/// Whether the surface of `fields[which]` (its parts `live`) inside the cell `[lo, lo + h]`
/// provably lies in a slab no wider than `width` parallel to the plane through `at` facing
/// `normal` (unit). A mesh whose vertices lie on the surface lies in any slab that holds them,
/// so mesh and surface stand no further apart, across the plane, than the slab is wide.
pub fn certify_sheet<S: Surface>(
    fields: [S],
    which: u32,
    live: Live,
    lo: vec3,
    h: f32,
    at: vec3,
    normal: vec3,
    width: f32,
) -> bool {
    let n_len = length(normal)
    if !(h > 0.0) || !(width > 0.0) || !(n_len > 1.0e-6) {
        return false
    }
    let n = normal / n_len
    // Where across the plane the surface is proven to be, so far (empty: `lo` above `hi`).
    var w_lo = 1.0e30
    var w_hi = -1.0e30
    var blo: [vec3; 8] = [vec3(0.0); 8]
    var bhi: [vec3; 8] = [vec3(0.0); 8]
    blo[0] = lo
    bhi[0] = lo + vec3(h)
    var top: u32 = 1
    for _visit in 0..SHEET_VISITS {
        if top == 0 {
            return true
        }
        top -= 1
        let b_lo = blo[top]
        let b_hi = bhi[top]
        let bx = Box3 { lo: b_lo, hi: b_hi }
        let af = fields[which].slope_affine(bx, live)
        if af.lo() > 0.0 || af.hi() < 0.0 {
            continue
        }
        // World-space box center & half-extent matching `ir::derive::affine::input_box`.
        let hl = 0.5 * b_lo
        let hh = 0.5 * b_hi
        let c_b = hl + hh
        let h_in = (hh - hl) * (1.0 + 2.0 * CERT_EPS)
        let w_mid = dot(c_b - at, n)
        let w_l = h_in * n
        let margin_w = (abs(c_b.x) + abs(c_b.y) + abs(c_b.z) + abs(at.x) + abs(at.y) + abs(at.z)) *
            (6.0 * CERT_EPS) +
            (h_in.x + h_in.y + h_in.z) * (12.0 * CERT_EPS) +
            8.0 * CERT_TINY
        let span = abs(w_l.x) + abs(w_l.y) + abs(w_l.z) + margin_w
        let box_lo = w_mid - span
        let box_hi = w_mid + span
        // A sub-box already thinner than `width` across `n`: surface lies within its own span.
        if box_hi - box_lo <= width && max(w_hi, box_hi) - min(w_lo, box_lo) <= width {
            w_lo = min(w_lo, box_lo)
            w_hi = max(w_hi, box_hi)
            continue
        }
        var best_axis: u32 = 0
        var score_x = abs(w_l.x)
        var score_y = abs(w_l.y)
        var score_z = abs(w_l.z)
        if af.valid() && h_in.x > 0.0 && h_in.y > 0.0 && h_in.z > 0.0 {
            let g = vec3(af.l.x / h_in.x, af.l.y / h_in.y, af.l.z / h_in.z)
            let alpha = dot(g, n)
            let abs_a = abs(alpha)
            if abs_a > 1.0e-6 {
                let r = af.l - w_l * alpha
                let mag_f = abs(af.c) + abs(af.l.x) + abs(af.l.y) + abs(af.l.z) + af.e
                let margin_f = mag_f * (16.0 * CERT_EPS) + 4.0 * CERT_TINY
                let half_w = (abs(r.x) + abs(r.y) + abs(r.z) + af.e + margin_f) / abs_a + margin_w
                let w_ctr = w_mid - af.c / alpha
                let s_lo = max(w_ctr - half_w, box_lo)
                let s_hi = min(w_ctr + half_w, box_hi)
                if s_lo > s_hi {
                    continue
                }
                if max(w_hi, s_hi) - min(w_lo, s_lo) <= width {
                    w_lo = min(w_lo, s_lo)
                    w_hi = max(w_hi, s_hi)
                    continue
                }
                let inv_a = 1.0 / abs_a
                score_x += abs(r.x) * inv_a
                score_y += abs(r.y) * inv_a
                score_z += abs(r.z) * inv_a
            }
        }
        if score_y >= score_x && score_y >= score_z {
            best_axis = 1
        } else if score_z >= score_x && score_z >= score_y {
            best_axis = 2
        }
        // Pre-prune halves already proved empty by the parent affine form before pushing.
        let lo_u_hi = vec3(
            if best_axis == 0 { 0.0 } else { 1.0 },
            if best_axis == 1 { 0.0 } else { 1.0 },
            if best_axis == 2 { 0.0 } else { 1.0 },
        )
        let hi_u_lo = vec3(
            if best_axis == 0 { 0.0 } else { -1.0 },
            if best_axis == 1 { 0.0 } else { -1.0 },
            if best_axis == 2 { 0.0 } else { -1.0 },
        )
        let r0 = af.sub_range(vec3(-1.0), lo_u_hi)
        let r1 = af.sub_range(hi_u_lo, vec3(1.0))
        let keep0 = !(r0.lo > 0.0 || r0.hi < 0.0)
        let keep1 = !(r1.lo > 0.0 || r1.hi < 0.0)
        let need: u32 = (if keep0 { 1 } else { 0 }) + (if keep1 { 1 } else { 0 })
        if top + need > 8 {
            return false
        }
        let m = 0.5 * (b_lo + b_hi)
        if keep0 {
            blo[top] = b_lo
            bhi[top] = vec3(
                if best_axis == 0 { m.x } else { b_hi.x },
                if best_axis == 1 { m.y } else { b_hi.y },
                if best_axis == 2 { m.z } else { b_hi.z },
            )
            top += 1
        }
        if keep1 {
            blo[top] = vec3(
                if best_axis == 0 { m.x } else { b_lo.x },
                if best_axis == 1 { m.y } else { b_lo.y },
                if best_axis == 2 { m.z } else { b_lo.z },
            )
            bhi[top] = b_hi
            top += 1
        }
    }
    top == 0
}

/// Angular normal-error budget (radians) matched to a GGX BRDF's specular lobe half-angle
/// (`alpha = r²`): keeps specular highlights free of faceting on glossy gold and glass while
/// relaxing smoothly for rough matte surfaces.
pub fn brdf_normal_budget(roughness: f32) -> f32 {
    let r = clamp(roughness, 0.04, 1.0)
    0.25 * max(r * r, 0.04)
}

/// Unified two-sided error bound `(delta_pos, delta_n)` over cell `[lo, lo + h]` for surface
/// `s` (parts `live`) relative to vertex plane `(at, normal)`:
/// - `delta_pos` (metres): full slab width enclosing `s = 0` along `normal` (`1e30` if uncertified
///   with zero slope), bounding both mesh-to-surface and surface-to-mesh error when vertices stay
///   in the dual-region slab.
/// - `delta_n` (radians): upper bound on normal cone half-angle over the cell from the affine
///   remainder `e` relative to the linear gradient magnitude `|g|` (`pi` if uncertified).
pub fn quad_error_bound<S: Surface>(
    s: S,
    live: Live,
    lo: vec3,
    h: f32,
    at: vec3,
    normal: vec3,
) -> vec2 {
    let n_len = length(normal)
    if !(h > 0.0) || !(n_len > 1.0e-6) {
        return vec2(1.0e30, 3.1415927)
    }
    let n = normal / n_len
    let bx = Box3 { lo, hi: lo + vec3(h) }
    let af = s.slope_affine(bx, live)
    if !af.valid() {
        return vec2(1.0e30, 3.1415927)
    }
    let hl = 0.5 * lo
    let hh = 0.5 * (lo + vec3(h))
    let c_b = hl + hh
    let h_in = (hh - hl) * (1.0 + 2.0 * CERT_EPS)
    if !(h_in.x > 0.0 && h_in.y > 0.0 && h_in.z > 0.0) {
        return vec2(1.0e30, 3.1415927)
    }
    let g = vec3(af.l.x / h_in.x, af.l.y / h_in.y, af.l.z / h_in.z)
    let g_len = length(g)
    let alpha = dot(g, n)
    let abs_a = abs(alpha)
    if !(abs_a > 1.0e-6) || !(g_len > 1.0e-6) {
        return vec2(1.0e30, 3.1415927)
    }
    let w_l = h_in * n
    let r = af.l - w_l * alpha
    let mag_f = abs(af.c) + abs(af.l.x) + abs(af.l.y) + abs(af.l.z) + af.e
    let margin_f = mag_f * (16.0 * CERT_EPS) + 4.0 * CERT_TINY
    let margin_w = (abs(c_b.x) + abs(c_b.y) + abs(c_b.z) + abs(at.x) + abs(at.y) + abs(at.z)) *
        (6.0 * CERT_EPS) +
        (h_in.x + h_in.y + h_in.z) * (12.0 * CERT_EPS) +
        8.0 * CERT_TINY
    let delta_pos = 2.0 * ((abs(r.x) + abs(r.y) + abs(r.z) + af.e + margin_f) / abs_a + margin_w)
    let g_dir_dev = acos(clamp(dot(g / g_len, n), -1.0, 1.0))
    // For a C² surface with affine remainder `e` over a cell of width `h`, curvature `κ ≤ 4 e / (h² |g|)`
    // so normal rotation across a 2-cell dual quad (`2 h`) is bounded by `8 e / (h |g|)`.
    let sin_curv = clamp(8.0 * (af.e + margin_f) / max(h * g_len, 1.0e-8), 0.0, 1.0)
    let delta_n = min(g_dir_dev + asin(sin_curv), 3.1415927)
    vec2(delta_pos, delta_n)
}

fn u01(k: u32) -> f32 {
    f32(hash_u32(k) >> 8) * (1.0 / 16777216.0)
}

/// The scoreboard: at cells `h` m wide (2.5 px at 1080p from 10 m is 2.7 cm), cells round points
/// where rays from inside the bound of `s` meet its surface (spread as its area is), and how many
/// `certify_sheet` certifies in a slab parallel to the plane at the point `h / 4` and `h / 10`
/// wide (a quarter pixel for cells `CELL_PX` 2.5 wide).
pub fn certify_report<S: Surface>(s: S, label: str, boxes: u32 = 200) {
    let b = s.bound()
    let r = min(b.radius, 1.0e4)
    let one = [s]
    for h in [0.01, 0.027, 0.08] {
        var n: u32 = 0
        var quarter: u32 = 0
        var tenth: u32 = 0
        var k: u32 = 0
        while n < boxes && k < 40 * boxes {
            let o = b.centre +
                (vec3(u01(k * 7 + 1), u01(k * 7 + 2), u01(k * 7 + 3)) - vec3(0.5)) * r
            let dv = vec3(u01(k * 7 + 4), u01(k * 7 + 5), u01(k * 7 + 6)) - vec3(0.5)
            k += 1
            if length(dv) < 0.05 {
                continue
            }
            let d = normalize(dv)
            var t = 0.0
            var hit = false
            for _ in 0..256 {
                let f = s.distance(o + d * t)
                if abs(f) < 1.0e-5 {
                    hit = true
                    break
                }
                t += abs(f) / max(s.lipschitz(abs(f)), 1.0)
                if t > 2.0 * r {
                    break
                }
            }
            if !hit {
                continue
            }
            let p = o + d * t
            let g = gradient(|q: vec3| s.distance(q), p)
            let gl = length(g)
            if !(gl > 1.0e-6) {
                continue
            }
            let off = (vec3(u01(k * 7 + 8), u01(k * 7 + 9), u01(k * 7 + 10)) - vec3(0.5)) * h
            let lo = p + off - vec3(0.5 * h)
            n += 1
            if certify_sheet(one, 0, ALL_LIVE, lo, h, p, g / gl, 0.25 * h) {
                quarter += 1
            }
            if certify_sheet(one, 0, ALL_LIVE, lo, h, p, g / gl, 0.4 * h) {
                tenth += 1
            }
        }
        print(
            f"certify({label}): cells {h} m: {n} cells; certified within h/4 {quarter}, within h/10 {tenth}",
        )
    }
}
