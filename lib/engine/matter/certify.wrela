// Certificates: what the compiler's affine ranges prove about the surface inside a cell, so a mesh
// there can be trusted to cover what the field covers without solving its pixels.
//
// A sheet certificate says the surface inside a cell lies in a slab no wider than `width`
// parallel to a plane (the plane of the cell's mesh vertex, where the extraction asks it). It is proven in the plane's own frame:
// the field is asked as a function of `(u, v, w)`, `w` across the plane (a rotation, which affine
// forms carry exactly), over a box that holds the cell; a part of the box is done when its affine
// range keeps off zero (no surface), or when the surface in it is placed across the plane (by the
// part's own span, or by the affine range of what the field differs from the plane by: sums are
// exact in affine arithmetic, so the plane's part cancels and only the field's bending is left)
// within the slab so far. The rest is halved across the plane, a few times at most. Not certified is not a fault:
// the cell's pixels are solved.
//
// `certify_sheet` runs on the CPU (the scoreboard, `certify_report`) and in the extraction's
// kernels alike: no recursion, a fixed stack, the field read where it lies (`fields[which]`).

use std::derive::{Box3, Interval, affine, gradient}
use std::field::{ALL_LIVE, Live, Surface, hash_u32}
use std::io::print

/// The most parts of a cell a sheet certificate looks at: past it the cell is not certified.
pub const SHEET_VISITS: u32 = 7

/// The affine range over `b` of the field `fields[which]` (its parts `live`) asked in the frame
/// `p = o + t1 u + t2 v + n w`, less `k w`: the field alone (`k` 0), and what it differs from the
/// plane `w = 0` by. One closure for both, so a kernel derives it once.
fn framed<S: Surface>(
    fields: [S],
    which: u32,
    live: Live,
    o: vec3,
    t1: vec3,
    t2: vec3,
    n: vec3,
    k: f32,
    b: Box3,
) -> Interval {
    affine(
        |u: vec3| fields[which].distance_live(o + t1 * u.x + t2 * u.y + n * u.z, live) - k * u.z,
        b,
    )
}

/// Whether the surface of `fields[which]` (its parts `live`) inside the cell `[lo, lo + h]`
/// provably lies in a slab no wider than `width` parallel to the plane through `at` facing
/// `normal` (unit), the field rising across it as `rise` (its gradient's length there). A mesh
/// whose vertices lie on the surface lies in any slab that holds them, so mesh and surface stand
/// no further apart, across the plane, than the slab is wide.
pub fn certify_sheet<S: Surface>(
    fields: [S],
    which: u32,
    live: Live,
    lo: vec3,
    h: f32,
    at: vec3,
    normal: vec3,
    rise: f32,
    width: f32,
) -> bool {
    if !(rise > 1.0e-6) {
        return false
    }
    // Where across the plane the surface is proven to be, so far (empty: `lo` above `hi`).
    var w_lo = 1.0e30
    var w_hi = -1.0e30
    let o = at
    let n = normal
    let a = if abs(n.x) < 0.6 { vec3(1.0, 0.0, 0.0) } else { vec3(0.0, 1.0, 0.0) }
    let t1 = normalize(cross(n, a))
    let t2 = cross(n, t1)
    // The cell's corners in the plane's frame: the box round them.
    var ulo = vec3(1.0e30)
    var uhi = vec3(-1.0e30)
    for c in 0..8 {
        let p = lo + h * vec3(f32(c & 1), f32((c >> 1) & 1), f32((c >> 2) & 1)) - o
        let u = vec3(dot(p, t1), dot(p, t2), dot(p, n))
        ulo = min(ulo, u)
        uhi = max(uhi, u)
    }
    // A little past the corners, for the frame's own rounding.
    let pad = 1.0e-6 * (h + length(o))
    ulo = ulo - vec3(pad)
    uhi = uhi + vec3(pad)
    var blo: [vec3; 8] = [vec3(0.0); 8]
    var bhi: [vec3; 8] = [vec3(0.0); 8]
    blo[0] = ulo
    bhi[0] = uhi
    var top: u32 = 1
    for _visit in 0..SHEET_VISITS {
        if top == 0 {
            return true
        }
        top -= 1
        let bx = Box3 { lo: blo[top], hi: bhi[top] }
        let f = framed(fields, which, live, o, t1, t2, n, 0.0, bx)
        if f.lo > 0.0 || f.hi < 0.0 {
            continue
        }
        // A part thinner than the slab may be: the surface in it is within its own span across.
        if bx.hi.z - bx.lo.z <= width && max(w_hi, bx.hi.z) - min(w_lo, bx.lo.z) <= width {
            w_lo = min(w_lo, bx.lo.z)
            w_hi = max(w_hi, bx.hi.z)
            continue
        }
        let res = framed(fields, which, live, o, t1, t2, n, rise, bx)
        // `g = rise w + r`, `r` in `[res.lo, res.hi]`: its surface has `w` in
        // `-[res.hi, res.lo] / rise` (and in the part).
        let s_lo = max(-res.hi / rise, bx.lo.z)
        let s_hi = min(-res.lo / rise, bx.hi.z)
        if max(w_hi, s_hi) - min(w_lo, s_lo) <= width {
            w_lo = min(w_lo, s_lo)
            w_hi = max(w_hi, s_hi)
            continue
        }
        if top + 2 > 8 {
            return false
        }
        // Across the plane: a part that holds the surface thins towards the slab, the other proves
        // empty. (Along it, a part's span across stays what it was: no help.)
        let cut = vec3(0.0, 0.0, 0.5 * (bx.hi.z - bx.lo.z))
        blo[top] = bx.lo
        bhi[top] = bx.hi - cut
        blo[top + 1] = bx.lo + cut
        bhi[top + 1] = bx.hi
        top += 2
    }
    top == 0
}

fn u01(k: u32) -> f32 {
    f32(hash_u32(k) >> 8) * (1.0 / 16777216.0)
}

/// The scoreboard: at cells `h` m wide (2.5 px at 1080p from 10 m is 2.7 cm), cells round points
/// where rays from inside the bound of `s` meet its surface (spread as its area is), and how many
/// `certify_sheet` certifies in a slab parallel to the plane at the point `h / 4` and `h / 10`
/// wide (a quarter pixel for cells `CELL_PX` 2.5 wide).
pub fn certify_report<S: Surface>(s: S, label: str, boxes: u32 = 200) {
    let b = s.bound()
    let r = min(b.radius, 1.0e4)
    let one = [s]
    for h in [0.01, 0.027, 0.08] {
        var n: u32 = 0
        var quarter: u32 = 0
        var tenth: u32 = 0
        var k: u32 = 0
        while n < boxes && k < 40 * boxes {
            let o = b.centre +
                (vec3(u01(k * 7 + 1), u01(k * 7 + 2), u01(k * 7 + 3)) - vec3(0.5)) * r
            let dv = vec3(u01(k * 7 + 4), u01(k * 7 + 5), u01(k * 7 + 6)) - vec3(0.5)
            k += 1
            if length(dv) < 0.05 {
                continue
            }
            let d = normalize(dv)
            var t = 0.0
            var hit = false
            for _ in 0..256 {
                let f = s.distance(o + d * t)
                if abs(f) < 1.0e-5 {
                    hit = true
                    break
                }
                t += abs(f) / max(s.lipschitz(abs(f)), 1.0)
                if t > 2.0 * r {
                    break
                }
            }
            if !hit {
                continue
            }
            let p = o + d * t
            let g = gradient(|q: vec3| s.distance(q), p)
            let gl = length(g)
            if !(gl > 1.0e-6) {
                continue
            }
            let off = (vec3(u01(k * 7 + 8), u01(k * 7 + 9), u01(k * 7 + 10)) - vec3(0.5)) * h
            let lo = p + off - vec3(0.5 * h)
            n += 1
            if certify_sheet(one, 0, ALL_LIVE, lo, h, p, g / gl, gl, 0.25 * h) {
                quarter += 1
            }
            if certify_sheet(one, 0, ALL_LIVE, lo, h, p, g / gl, gl, 0.4 * h) {
                tenth += 1
            }
        }
        print(
            f"certify({label}): cells {h} m: {n} cells; certified within h/4 {quarter}, within h/10 {tenth}",
        )
    }
}
