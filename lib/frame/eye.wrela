// The eye: where its rays start, which way they go, and how deep what they meet is.
//
// Depth is reversed and has no far plane: what is z m along the view is `near / z` deep, 1 at the
// near plane and falling toward 0 far off. 0 is nothing met, the clear. A 32-bit float holds
// `near / z` to about the same share of z at every distance, where plain depth loses its digits
// far off. The nearest fragment has the greatest depth, so every draw keeps a fragment whose
// depth is greater than what's there (`NEARER`).
//
// A shader that writes its own depth and promises it is never nearer than its triangle's says so
// as `std::gpu::WithDepthBehind`: under reversed depth "never nearer" is "never greater", Metal's
// `[[depth(less)]]`, which lets the GPU test the triangle's own depth early as a bound.

use std::gpu::{Compare, Depth}

/// How every draw into a depth target tests and writes: the nearer (greater) depth wins.
pub const NEARER = Depth { compare: Compare::Greater, write: true }

/// Depth where nothing is met: the clear.
pub const NOTHING_DEEP: f32 = 0.0

/// An eye: a pinhole at `at` looking along `forward`, `right` and `up` across its screen; its focal
/// length (1 over the tangent of half its field of view upward); its near plane (m); its
/// screen's width over its height and its size (px); and how far its rays are moved within their
/// pixels (px, from their middles: a supersampled reference's looks).
pub struct Eye: Copy + GpuData {
    pub at: vec3,
    pub focal: f32,
    pub forward: vec3,
    pub near: f32,
    pub right: vec3,
    pub aspect: f32,
    pub up: vec3,
    pub spare: f32,
    pub size: vec2,
    pub jitter: vec2,
}

impl Eye {
    /// Where on the screen `pixel` is (px, middles at half-integers), its rays moved by
    /// `jitter`: across and down, 1 the screen's half height.
    pub fn across(self, pixel: vec2) -> vec2 {
        ((pixel + self.jitter) * 2.0 - self.size) / self.size.y
    }

    /// The way of the ray through `pixel`, not of unit length: of the first degree in the pixel,
    /// and as long along the view as the focal length.
    pub fn way(self, pixel: vec2) -> vec3 {
        let uv = self.across(pixel)
        self.forward * self.focal + self.right * uv.x - self.up * uv.y
    }

    /// The ray through `pixel`, a unit vector.
    pub fn ray(self, pixel: vec2) -> vec3 {
        normalize(self.way(pixel))
    }

    /// Where the world point `w` is in clip space: the pixel whose ray (moved by `jitter`)
    /// passes through it, and its reversed depth.
    pub fn clip(self, w: vec3) -> vec4 {
        let v = w - self.at
        let z = dot(v, self.forward)
        let j = self.jitter * 2.0 / self.size
        let x = dot(v, self.right) * self.focal / self.aspect
        let y = dot(v, self.up) * self.focal
        vec4(x - j.x * z, y + j.y * z, self.near, z)
    }

    /// The depth of what's `z` m along the view.
    pub fn depth_along(self, z: f32) -> f32 {
        self.near / z
    }

    /// The depth of the world point `w`.
    pub fn depth(self, w: vec3) -> f32 {
        self.near / dot(w - self.at, self.forward)
    }

    /// How far along the view (m) a depth is.
    pub fn along(self, depth: f32) -> f32 {
        self.near / depth
    }

    /// A pixel's width a metre along the view (m).
    pub fn pixel(self) -> f32 {
        2.0 / (self.size.y * self.focal)
    }

    /// Where the pixel that met something `depth` deep is in the world.
    pub fn place(self, pixel: vec2, depth: f32) -> vec3 {
        let d = self.ray(pixel)
        self.at + d * (self.along(depth) / dot(d, self.forward))
    }

    /// The way from `p` toward the eye (a unit vector), and how far off it is (m).
    pub fn toward(self, p: vec3) -> vec4 {
        let to = self.at - p
        let far = max(length(to), 1.0e-9)
        vec4(to / far, far)
    }
}

/// An eye at `from` looking at `to`, `fov` radians upward, on a `width` × `height` screen, with
/// its near plane 5 cm off.
pub fn eye_at(from: vec3, to: vec3, fov: f32, width: u32, height: u32) -> Eye {
    let forward = normalize(to - from)
    let right = normalize(cross(forward, vec3(0.0, 1.0, 0.0)))
    Eye {
        at: from,
        focal: 1.0 / tan(0.5 * fov),
        forward,
        near: 0.05,
        right,
        aspect: f32(width) / f32(height),
        up: cross(right, forward),
        spare: 0.0,
        size: vec2(f32(width), f32(height)),
        jitter: vec2(0.0),
    }
}
