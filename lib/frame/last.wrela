// The last pass: the picture made into the screen, once a pixel, with no history.
//
// 1. Its edges. Each pixel shows what it met for the part of it on the near side of its own
//    edge's line (`covered`: exactly, for a straight edge through a square), and for the rest
//    what the pixel across that edge shows. A pixel a nearer neighbour's edge reaches into
//    shows that neighbour for the part it covers. Then the sky where nothing is: the scene's
//    `Paint` as the frame's tables hold it (`sky::seen_sky`; no pixel runs the paint itself).
//    After Persson's geometry buffer anti-aliasing (GBAA), with each lister's own edge in place
//    of a triangle's (docs/citations.md); ported from the atoms spike's `resolved_native`
//    (draw.wrela:702). Only pixels whose own record, or a neighbour's across or down, holds an
//    edge read further (a bit a pixel, `ink::edges` marks them): the rest have no edge near, and
//    their own colour is the answer. The edges smoothed are the records', whatever their
//    strength: no line need be drawn along an edge for it to be smoothed. Each colour met is
//    seen through the scene's air by its own depth first (`air::aired`), so an edge between a
//    near form and a far one mixes them as the eye sees them.
// 2. The tone curve, to the screen's values: `c / (1 + 0.12 c)`, then the power 1/2.2, today's
//    `display` (rywible/wrela 7ae6711e, content/humanoid/ink.wrela:465-469). The ink, the drain
//    and the paper work on those values, as today's ink pass did.
// 3. The ink (`ink`'s strokes, drawn before this pass into the strokes target): committed as the
//    moment is energetic, flecks thrown off it, the palette drained toward manga's three values
//    as the frame turns kinetic, the line's colour by what it's drawn on. In an impact frame, two
//    values: the striker solid ink, the rest paper, one clean outline.
// 4. The paper's tooth and vignette (`paper`, made once a screen size).
// 5. Soft things (mediums; far strands to come) are laid over all of it, as a layer of paint is
//    laid over an inked cel, by draws of their own in the same pass to the screen, each over
//    only the screen its layer covers (`soft::laid`); then text and shapes (`text`).
//
// `display` false gives linear light back (the tone curve undone, no paper) for the judges; and
// `cover` gives cover alone (what anything drew white, nothing black, through step 1 only), so a
// judge's difference from a reference's cover is the cover's error.

use air::{Air, aired}
use eye::Eye
use form::ink::InkStyle
use form::kinds::Paint
use form::shade::band
use ink::{IN_MARGIN, hash2, luma, marked, noise}
use moment::{Moment, felt, limb_energy, limb_energy_along}
use picture::{EDGE_REACH, edge_strength, edge_way, group_of}
use sky::{SkySeen, seen_sky}
use sun::{AirSeen, air_seen}
use std::gpu::{
    ClipPosition, DepthTexture, FragCoord, GlobalId, R16Float, R32Uint, Rg8, Rgba16Float, Sampler,
    Texels3d, Texture, Texture3d, VertexIndex,
}

/// A triangle that covers the screen.
@vertex
pub fn cover(v: VertexIndex) -> ClipPosition {
    let x = f32(v.index % 2) * 4.0 - 1.0
    let y = f32(v.index / 2) * 4.0 - 1.0
    ClipPosition { position: vec4(x, y, 0.0, 1.0) }
}

/// What a paint shows along the unit `d` (the world's), in its own frame if it's on the screen.
pub fn painted<P: Paint>(eye: Eye, sky: P, d: vec3) -> vec3 {
    if P::ON_SCREEN {
        return sky.colour(vec3(dot(d, eye.right), dot(d, eye.up), -dot(d, eye.forward))).xyz
    }
    sky.colour(d).xyz
}

/// How much of a pixel (a unit square) lies on the near side of a straight edge whose line
/// passes `d` px from the pixel's middle (over 0: the middle is on the near side), its unit
/// normal `n`: exactly. Across the square's middle the share grows evenly with `d`; where the
/// line cuts only a corner, as the square of how far in it reaches.
pub fn covered(d: f32, n: vec2) -> f32 {
    let wide = max(abs(n.x), abs(n.y))
    let thin = min(abs(n.x), abs(n.y))
    let reach = 0.5 * (wide + thin)
    let even = 0.5 * (wide - thin)
    if d >= reach {
        return 1.0
    }
    if d <= -reach {
        return 0.0
    }
    if abs(d) <= even {
        return 0.5 + d / wide
    }
    let corner = (reach - abs(d)) * (reach - abs(d)) / max(2.0 * wide * thin, 1.0e-9)
    if d > 0.0 { 1.0 - corner } else { corner }
}

/// The step (one pixel across or down) that an edge `e` px off lies along most.
pub fn toward(e: vec2) -> vec2 {
    if abs(e.x) > abs(e.y) {
        vec2(if e.x > 0.0 { 1.0 } else { -1.0 }, 0.0)
    } else {
        vec2(0.0, if e.y > 0.0 { 1.0 } else { -1.0 })
    }
}

/// What pixel (x, y) shows on its own: its colour where something drew it, seen through `air`
/// and (`sunlit`) the sun's light on that air (`sun_air`, read from `air_map`), else the sky (the
/// frame's tables of it, `sky`, which hold the sun's light on the air along a ray that meets
/// nothing); or (`cover`) white where something drew it, else black.
fn seen(
    eye: Eye,
    air: Air,
    sun_air: AirSeen,
    air_map: Texture<Rgba16Float>,
    air_s: Sampler,
    sky: SkySeen,
    colour: Texture<Rgba16Float>,
    depth: DepthTexture,
    x: i32,
    y: i32,
    cover: bool,
    sunlit: bool,
) -> vec3 {
    let z = depth.load(u32(x), u32(y))
    let drawn = z > 0.0
    if cover {
        return vec3(if drawn { 1.0 } else { 0.0 })
    }
    let mid = vec2(f32(x) + 0.5, f32(y) + 0.5)
    let d = eye.ray(mid)
    if drawn {
        let c = aired(air, eye, sky.table, sky.s, mid, z, colour.load(u32(x), u32(y)).xyz)
        if sunlit && sun_air.light.w > 0.0 {
            return c + air_seen(sun_air, air_map, air_s, eye.at, d, length(eye.place(mid, z) - eye.at))
        }
        return c
    }
    seen_sky(sky, d)
}

/// Linear light as the screen takes it: a soft shoulder, `c / (1 + shoulder·c)`, then the power
/// `1/gamma` (today's `display`, ink.wrela:465-469; the screen clips what's past 1).
pub fn displayed(s: InkStyle, c: vec3) -> vec3 {
    graded(s, toned(s, c * s.exposure))
}

// ---- the finish as a table ----------------------------------------------------------------------
//
// `displayed` is a function of a colour alone, and with a filmic curve and a grade it is costly
// at every pixel (0.75 ms at 3840x2160 on the M4). So the last pass reads it from a table made
// once a style (`finish_table`): `FINISH` texels each way, the colour's channels each placed by
// the log of the light (`finish_place`) from none to `FINISH_TOP`, read trilinearly.

/// The finish's table's texels each way.
pub const FINISH: u32 = 32

/// The least light the table tells apart from none, and the most it holds (linear, before the
/// exposure): 18 stops between, a texel each 0.56 of a stop.
const FINISH_LOW: f32 = 0.000244140625
const FINISH_TOP: f32 = 64.0

/// Where linear light `c` lies along the finish's table, 0 to 1 (each channel): none at 0.
fn finish_at(c: vec3) -> vec3 {
    let span = log2(FINISH_TOP + FINISH_LOW) - log2(FINISH_LOW)
    clamp((log2(max(c, vec3(0.0)) + vec3(FINISH_LOW)) - vec3(log2(FINISH_LOW))) / span, vec3(0.0), vec3(1.0))
}

/// Linear light `c` as the screen takes it, read from the finish's table (`finish`, made by
/// `finish_table` for the style): `displayed`, between the table's texels.
pub fn finish_read(finish: Texture3d<Rgba16Float>, s: Sampler, c: vec3) -> vec3 {
    let n = f32(FINISH)
    finish.sample_level(s, (vec3(0.5) + finish_at(c) * (n - 1.0)) / n).xyz
}

/// Texel `id` of the finish's table for style `style`: `displayed` at the light the texel stands
/// for.
@compute(4, 4, 4)
pub fn finish_table(style: InkStyle, out: mut Texels3d<Rgba16Float>, id: GlobalId) {
    if id.x >= FINISH || id.y >= FINISH || id.z >= FINISH {
        return
    }
    let span = log2(FINISH_TOP + FINISH_LOW) - log2(FINISH_LOW)
    let k = vec3(f32(id.x), f32(id.y), f32(id.z)) / f32(FINISH - 1)
    let c = max(exp2(vec3(log2(FINISH_LOW)) + k * span) - vec3(FINISH_LOW), vec3(0.0))
    out.store(id, vec4(displayed(style, c), 1.0))
}

/// Whether two styles finish alike (the same tone curve and grade): the table made for one
/// serves the other.
pub fn finish_alike(a: InkStyle, b: InkStyle) -> bool {
    a.shoulder == b.shoulder && a.gamma == b.gamma && a.exposure == b.exposure &&
        a.film == b.film && a.film_hue == b.film_hue && a.saturation == b.saturation &&
        a.shade_tint == b.shade_tint && a.split_low == b.split_low &&
        a.light_tint == b.light_tint && a.split_high == b.split_high && a.slate == b.slate &&
        a.drain == b.drain && a.contrast == b.contrast && a.press == b.press &&
        a.press_to == b.press_to
}

/// Exposed light through the style's tone curve (`InkStyle::film`), to the screen's values.
fn toned(s: InkStyle, c: vec3) -> vec3 {
    if s.film <= 0.0 {
        let x = c / (vec3(1.0) + c * s.shoulder)
        return pow(max(x, vec3(0.0)), vec3(1.0 / s.gamma))
    }
    // The filmic curve, part on each channel and `film_hue` on the luminance with its hue kept,
    // so a bright coloured light rolls off toward white rather than turning another hue
    // (scenes/opening/ink.wrela:16-33).
    let x = max(c, vec3(0.0))
    let y = luma(x)
    let per = aces(x)
    var kept = x * (aces(vec3(y)).x / max(y, 1.0e-6))
    let top = max(kept.x, max(kept.y, kept.z))
    if top > 1.0 {
        kept = mix(kept / top, vec3(1.0), clamp((top - 1.0) * 0.5, 0.0, 1.0))
    }
    let t = mix(per, kept, s.film_hue)
    // (Far past white, burnt white, as film is.)
    let w = mix(t, vec3(1.0), smoothstep(3.0, 14.0, y))
    vec3(srgb(w.x), srgb(w.y), srgb(w.z))
}

/// Narkowicz's fit of the ACES filmic curve (docs/citations.md): a toe that deepens the darks
/// and a shoulder that reaches white only far past it.
fn aces(x: vec3) -> vec3 {
    clamp((x * (2.51 * x + 0.03)) / (x * (2.43 * x + 0.59) + 0.14), vec3(0.0), vec3(1.0))
}

/// `aces` undone (each channel; under its white).
fn unaces(v: vec3) -> vec3 {
    let y = clamp(v, vec3(0.0), vec3(0.999))
    let a = vec3(2.51) - y * 2.43
    let b = vec3(0.03) - y * 0.59
    (sqrt(b * b + a * y * 0.56) - b) / (2.0 * a)
}

/// The sRGB curve, linear to the screen's values.
fn srgb(x: f32) -> f32 {
    if x <= 0.0031308 { x * 12.92 } else { 1.055 * pow(max(x, 0.0), 1.0 / 2.4) - 0.055 }
}

/// The sRGB curve undone.
fn unsrgb(v: f32) -> f32 {
    if v <= 0.04045 { v / 12.92 } else { pow((max(v, 0.0) + 0.055) / 1.055, 2.4) }
}

/// The screen's values graded as the style grades them (`InkStyle`'s grade: a split of the
/// shade's and the light's tints, saturation, the middle tones pulled apart, a drain toward a
/// tinted grey, the darks pressed). With today's ink's numbers it is the values as they were.
fn graded(s: InkStyle, v: vec3) -> vec3 {
    var c = v * mix(s.shade_tint, s.light_tint, vec3(smoothstep(s.split_low, s.split_high, luma(v))))
    c = mix(vec3(luma(c)), c, s.saturation)
    let lc = clamp(c, vec3(0.0), vec3(1.0))
    c = mix(c, lc * lc * (vec3(3.0) - lc * 2.0), s.contrast)
    let l = luma(c)
    mix(vec3(l), c, 1.0 - s.drain) * s.slate * mix(s.press, 1.0, smoothstep(0.08, s.press_to, l))
}

/// The screen's values back to linear light: the tone curve and the exposure undone (not the
/// grade: where a style grades, linear light is taken before it, `last`'s `display` false).
pub fn undisplayed(s: InkStyle, v: vec3) -> vec3 {
    if s.film > 0.0 {
        let x = vec3(unsrgb(v.x), unsrgb(v.y), unsrgb(v.z))
        return unaces(x) / s.exposure
    }
    let x = pow(max(v, vec3(0.0)), vec3(s.gamma))
    x / max(vec3(1.0) - x * s.shoulder, vec3(1.0e-6)) / s.exposure
}

/// The paper at pixel `px` of a screen `size` px: its tooth, two noises (fibres and grain), and
/// its vignette, as a page's edge darkens; what the picture is multiplied by (ink.wrela:398-402).
/// (Made at half the pixels across and read between texels at 4K it cost the last pass the
/// same: a read is a read, whatever its size.)
@fragment
pub fn paper(pixel: FragCoord, style: InkStyle, size: vec2) -> vec4 {
    let s = style
    let px = pixel.position.xy
    let scale = size.y / s.lines
    let tooth = noise(px / (s.tooth_fine * scale)) * s.tooth_mix +
        noise(px / (s.tooth_coarse * scale)) * (1.0 - s.tooth_mix)
    let uv = px / size - vec2(0.5)
    let page = 1.0 - s.vignette * pow(length(uv * vec2(1.0, s.vignette_tall)), s.vignette_power)
    vec4((s.tooth_floor + s.tooth_gain * tooth) * page, 0.0, 0.0, 1.0)
}

/// The paper at pixel `px` of a screen `size` px: read from `paper` where the style's paper has
/// a tooth, else its vignette alone, worked out here (a painted print's: no texture read).
fn papered(s: InkStyle, paper: Texture<R16Float>, px: vec2, size: vec2) -> f32 {
    if s.tooth_gain > 0.0 {
        return paper.load(u32(px.x), u32(px.y))
    }
    let uv = px / size - vec2(0.5)
    s.tooth_floor * (1.0 - s.vignette * pow(length(uv * vec2(1.0, s.vignette_tall)), s.vignette_power))
}

/// Whether pixel (`x`, `y`)'s edge record, or a neighbour's across or down, holds an edge: the
/// test `ink::edges` marks a pixel by, made here in a frame where no line is drawn and that pass
/// doesn't run. Two gathers of the records' third channel (1 plus a line's strength where an
/// edge is near, 0 where none is or nothing drew): the 2 × 2 up and left of the pixel's middle
/// and the 2 × 2 down and right (past the screen's edge, the edge's texels again).
fn edged(edge: Texture<Rgba16Float>, near: Sampler, x: i32, y: i32, w: i32, h: i32) -> bool {
    let size = vec2(f32(w), f32(h))
    // (A gather's x is the texel down and left of its point, y down and right, z up and right,
    // w up and left.)
    let a = edge.gather(near, vec2(f32(x), f32(y)) / size, component: 2)
    let b = edge.gather(near, vec2(f32(x) + 1.0, f32(y) + 1.0) / size, component: 2)
    max(max(a.x, a.y), max(a.z, max(b.x, b.z))) >= 0.5
}

/// A colour drained to manga's three values: ink, a middle wash, paper, by its value
/// (ink.wrela:368-378).
fn three_values(s: InkStyle, c: vec3) -> vec3 {
    let v = pow(max(luma(c), 0.0), s.value_power)
    let tone = band(v, s.low, s.tone_soft) * 0.5 + band(v, s.high, s.tone_soft) * 0.5
    let black = s.ink * s.dark_ink
    let mid = mix(black, s.paper * s.mid_paper, s.mid)
    if tone < 0.25 { mix(black, mid, tone * 4.0) } else {
        mix(mid, s.paper, clamp(tone * 2.0 - 1.0, 0.0, 1.0))
    }
}

/// A fleck thrown off a line near pixel `px` at energy `e` on a form `dark` (ink.wrela:328-359):
/// a short dash in a cell round it, sparse, each its own angle, where the cell's middle is within
/// reach of a line (`strokes`' `y` there: a line's weight, or within an edge's reach of one).
fn fleck(s: InkStyle, m: Moment, strokes: Texture<Rg8>, px: vec2, e: f32, dark: f32) -> f32 {
    let scale = m.scale
    let seed = m.drawing
    let cell = s.fleck_cells * scale
    let id = floor(px / cell)
    let h = hash2(id + vec2(seed * 3.1, 7.0))
    let centre = (id +
        vec2(0.25 + 0.5 * hash2(id + vec2(1.0, seed)), 0.25 + 0.5 * hash2(id + vec2(seed, 2.0)))) *
        cell
    let turn = hash2(id + vec2(seed * 5.7, 3.0)) * 3.14159
    let axis = vec2(cos(turn), sin(turn))
    let rel = px - centre
    let dash = 1.0 -
        band(abs(dot(rel, vec2(-axis.y, axis.x))), s.fleck_wide * scale, s.fleck_wide_soft * scale)
    let dash_len = 1.0 - band(abs(dot(rel, axis)), s.fleck_long * scale, s.fleck_long_soft * scale)
    let cx = u32(clamp(centre.x, 0.0, f32(strokes.width() - 1)))
    let cy = u32(clamp(centre.y, 0.0, f32(strokes.height() - 1)))
    let near_line = strokes.load(cx, cy).y
    dash *
        dash_len *
        band(h, 1.0 - s.fleck_energy * e, s.fleck_soft) *
        band(e, s.fleck_from, s.fleck_from_soft) *
        band(near_line, s.fleck_line, s.fleck_line_soft) *
        (1.0 - dark)
}

/// The last pass's pixel: as the screen takes it, or (`display` false) linear light.
@fragment
pub fn last(
    pixel: FragCoord,
    eye: Eye,
    air: Air,
    sun_air: AirSeen,
    air_map: Texture<Rgba16Float>,
    air_s: Sampler,
    sky: SkySeen,
    style: InkStyle,
    moment: Moment,
    colour: Texture<Rgba16Float>,
    edge: Texture<Rgba16Float>,
    identity: Texture<R32Uint>,
    depth: DepthTexture,
    strokes: Texture<Rg8>,
    paper: Texture<R16Float>,
    smoothed: [u32],
    near: Sampler,
    lines: u32,
    finish: Texture3d<Rgba16Float>,
    finish_s: Sampler,
    cover: const bool,
    display: const bool,
) -> vec4 {
    let s = style
    let m = moment
    let x = i32(pixel.position.x)
    let y = i32(pixel.position.y)
    let px = pixel.position.xy
    let w = i32(colour.width())
    let h = i32(colour.height())
    let z = depth.load(u32(x), u32(y))
    // (In a frame that draws no line (`lines` 0) the strokes target is clear and the ink's pass
    // that marks the edges didn't run: no read of either.)
    let lined = lines != 0
    let marks = if lined { strokes.load(u32(x), u32(y)) } else { vec2(0.0) }
    var c = seen(eye, air, sun_air, air_map, air_s, sky, colour, depth, x, y, cover, true)
    // What the ink takes its colour from: the pixel smoothed by edges a line is drawn along, not
    // by those smoothed with none (a line drawn over a pixel the land's crest smoothed toward
    // the sky took the sky's paleness, and read broken).
    var inked = c
    // 1. Its edges, where its record or a neighbour's across or down holds one (`ink::marked`,
    // or where no line is drawn, `edged`).
    let smooth = if lined { marked(smoothed, u32(w), u32(x), u32(y)) } else {
        edged(edge, near, x, y, w, h)
    }
    if smooth {
        // Its own edge: the part of it past the edge's line shows what the pixel across shows.
        let own = edge.load(u32(x), u32(y))
        let e = edge_way(own)
        let far = length(e)
        if z > 0.0 && far < EDGE_REACH {
            let n = e / max(far, 1.0e-6)
            let mine = covered(far, n)
            if mine < 1.0 {
                let step = toward(e)
                let nx = clamp(x + i32(step.x), 0, w - 1)
                let ny = clamp(y + i32(step.y), 0, h - 1)
                let across = seen(eye, air, sun_air, air_map, air_s, sky, colour, depth, nx, ny, cover, false)
                c = mix(across, c, mine)
                if edge_strength(own) > 0.0 {
                    inked = mix(across, inked, mine)
                }
            }
        }
        // A nearer neighbour's edge that reaches into this pixel: the most any covers.
        var most = 0.0
        var theirs = c
        var lined = false
        for k in 0..4 {
            let ox = if k == 0 { 1 } else if k == 1 { -1 } else { 0 }
            let oy = if k == 2 { 1 } else if k == 3 { -1 } else { 0 }
            let nx = clamp(x + ox, 0, w - 1)
            let ny = clamp(y + oy, 0, h - 1)
            let zn = depth.load(u32(nx), u32(ny))
            let rn = edge.load(u32(nx), u32(ny))
            let en = edge_way(rn)
            let off = length(en)
            if zn > z && off < EDGE_REACH {
                // This pixel's middle, from the neighbour's, is one step back: along the edge's
                // normal, that far past the neighbour's middle, less the way to the edge.
                let n = en / max(off, 1.0e-6)
                let beyond = dot(vec2(-f32(ox), -f32(oy)), n) - off
                let covers = covered(-beyond, n)
                // It covers part of this pixel only if the neighbour's edge lies on this pixel's
                // side of it: else the record's line isn't the edge between them (a fold of the
                // neighbour's own surface behind it, say), and its half-plane reaches over what
                // the neighbour didn't draw (a brow's fold under a crest put teeth of land in the
                // sky above it). Where this pixel shows something itself, it covers part only if
                // this pixel's middle lies past the edge (else it's the neighbour's own surface
                // going on) and it has no edge of its own (else it has shown the neighbour for
                // its own part already, as two faces do across the edge between them).
                let toward_me = dot(vec2(-f32(ox), -f32(oy)), n) > 0.0
                if covers > most && toward_me && (z <= 0.0 || (far >= EDGE_REACH && beyond > 0.0)) {
                    most = covers
                    // (A nearer neighbour drew: its colour, or in cover alone white.)
                    theirs = seen(eye, air, sun_air, air_map, air_s, sky, colour, depth, nx, ny, cover, false)
                    lined = edge_strength(rn) > 0.0
                }
            }
        }
        c = mix(c, theirs, most)
        if lined {
            inked = mix(inked, theirs, most)
        }
    }
    if cover {
        return vec4(c, 1.0)
    }
    // 2. The tone curve and the grade (the style's finish, from its table).
    let shown = finish_read(finish, finish_s, c)
    let line = marks.x
    // 3. An impact frame: two values and one clean line. The striker in solid ink (its face's
    // pale side kept), the rest paper, a margin of paper round the striker on any other body.
    if m.kinetic > s.impact {
        let id = if z > 0.0 { identity.load(u32(x), u32(y)) } else { 0 }
        let striker = z > 0.0 && m.strikes(id)
        let black = s.ink * s.impact_black
        var flat = s.paper
        if striker {
            let face = group_of(id) == m.face && edge.load(u32(x), u32(y)).w >= 0.0
            flat = if face { s.paper } else { black }
        }
        var fc = mix(flat, black, line)
        if z > 0.0 && !striker && m.knows(id) && marks.y >= IN_MARGIN {
            fc = s.paper
        }
        if display {
            return vec4(displayed(s, fc), 1.0)
        }
        return vec4(fc, 1.0)
    }
    // 3. The ink, where there's a line, or the moment is energetic.
    var out = shown
    if line > 0.0 || m.kinetic > 0.0 || m.by > 0.0 {
        // The energy here: the frame's kinetic as felt here, the striking limb's own, and on a
        // line, `local` of the limb's where it passes (today's ink took that from the pixels
        // round a line).
        var own = 0.0
        var e = felt(m, s, px)
        if m.by > 0.0 {
            if z > 0.0 {
                own = limb_energy(m, s, identity.load(u32(x), u32(y)), eye.place(px, z))
            }
            e = max(e, own)
            if line > 0.0 {
                e = max(e, s.local * limb_energy_along(m, s, eye, px))
            }
        }
        e = clamp(e, 0.0, 1.0)
        // (What the line is drawn on, as the ink sees it: `inked`.)
        var under = displayed(s, inked)
        let dark0 = 1.0 - band(luma(under), s.dark, s.dark_soft)
        // Kinetic, the ink commits: a line is there or it isn't, no grey.
        let committed = mix(
            line,
            band(line, s.commit, s.commit_soft),
            band(e, s.commit_from, s.commit_from_soft),
        )
        var flecked = 0.0
        if lined && e > s.fleck_from - s.fleck_from_soft {
            flecked = fleck(s, m, strokes, px, e, dark0)
        }
        let ink_line = clamp(max(committed, flecked), 0.0, 1.0)
        // The palette drains toward ink and paper as the frame turns kinetic.
        if m.kinetic > s.drain_from - s.drain_soft {
            let drain = band(m.kinetic, s.drain_from, s.drain_soft)
            out = mix(out, three_values(s, out), drain)
            under = mix(under, three_values(s, under), drain)
        }
        // The ink: quiet, the form's own colour deepened; loud, ink; pale on a dark form, but
        // not on a striking limb.
        let on_dark = (1.0 - band(luma(under), s.dark, s.dark_soft)) *
            (1.0 - band(own, s.striking, s.striking_soft))
        let quiet = mix(under * under * s.deepen, s.pale_quiet, vec3(on_dark))
        let loud = mix(s.ink * s.loud, s.pale_loud, vec3(on_dark))
        let ink_c = mix(quiet, loud, vec3(band(e, s.loud_from, s.loud_soft)))
        out = mix(out, ink_c, vec3(ink_line))
    }
    // 4. The paper.
    if display {
        return vec4(out * papered(s, paper, px, vec2(f32(w), f32(h))), 1.0)
    }
    // (Linear light: where no ink was laid, the light met itself, before any grade.)
    if line <= 0.0 && m.kinetic <= 0.0 && m.by <= 0.0 {
        return vec4(c, 1.0)
    }
    vec4(undisplayed(s, out), 1.0)
}

/// Today's ink shows light as it did (the soft shoulder, no grade); the filmic curve with no
/// grade is undone by `undisplayed` (under white); and the filmic curve deepens the darks.
@test
fn the_finish_is_undone_and_todays_is_as_it_was() {
    let today = form::ink::KINETIC_INK_LINES
    let v = displayed(today, vec3(0.1, 0.5, 2.0))
    let was = pow(vec3(0.1, 0.5, 2.0) / (vec3(1.0) + vec3(0.1, 0.5, 2.0) * 0.12), vec3(1.0 / 2.2))
    assert(length(v - was) < 1.0e-5, f"{v} against {was}")
    let film = InkStyle { film: 1.0, exposure: 1.3, ..today }
    for c in [vec3(0.004, 0.02, 0.1), vec3(0.3, 0.25, 0.2), vec3(0.6, 0.62, 0.7)] {
        let back = undisplayed(film, displayed(film, c))
        assert(length(back - c) < 0.02 * length(c), f"{c} came back as {back}")
    }
    assert(displayed(film, vec3(0.01)).x < displayed(today, vec3(0.01)).x * 0.6, "the toe")
}
