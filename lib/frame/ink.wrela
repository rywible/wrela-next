// Ink from the edges the frame already knows: nothing searches the screen.
//
// 1. `edges`, once a pixel: where a line runs past it, from what the picture holds. A pixel whose
//    edge record says an edge crosses toward its neighbour (the record's edge is less than a
//    pixel off along the axis it lies across most) is a stroke at the exact place the record
//    gives. A pixel whose identity differs from its neighbour's, where no record holds the edge
//    between them (two listers' forms passing through each other, say), is a stroke half way
//    between their middles. A pixel whose look's line field changes sign toward its neighbour,
//    the same identity on both sides, is a stroke where the field is 0, along its gradient.
//    Each stroke's weight is by what made it: an outline against another identity or nothing;
//    a fold, one part of a form in front of another of itself, by how far apart they are; a
//    crease, the same surface turning; a seam. Strokes go on a list (`Append`); most pixels
//    have none and stop at their depth.
// 2. `stroke_cover`: each stroke drawn as a short piece of its edge's line, a quad round it no
//    larger than the pen reaches, into the strokes target with the greatest of each channel
//    kept (`Blend::Max`): the line's cover, whether the anti-aliasing must look at this pixel's
//    neighbours, the energy, and in an energetic frame the reach of flecks (in an impact frame,
//    the paper margin round the striker). A pixel's cover is the exact share of it within the
//    pen's radius of the edge (`last::covered` either side): its edges anti-aliased from the
//    distance itself, no supersampling. The pen's radius wobbles and its strands wander by
//    noises of the pixel's place, seeded by the drawing: the same at a pixel whichever stroke
//    draws it, so pieces of one line join, and the line boils once a drawing and holds between.
//
// Today's ink found the same lines by 8 taps a strand at the pen's radius round every pixel
// (rywible/wrela 7ae6711e, content/humanoid/ink.wrela 193-404): 6.08 ms at 1080p. Its numbers
// are `form::ink::KINETIC_INK_LINES`.

use air::{Air, reaching}
use eye::Eye
use form::ink::InkStyle
use form::shade::band
use last::{covered, displayed, toward}
use moment::{Moment, felt, limb_energy, nearness}
use picture::{EDGE_REACH, NO_EDGE, NO_LINE, edge_near, edge_strength, edge_way}
use std::gpu::{
    Append, Atomics, ClipPosition, DepthTexture, DrawArgs, Flat, FragCoord, GlobalId, InstanceIndex,
    R32Uint, Rgba16Float, Sampler, Slots, Texture, VertexIndex,
}

// ---- noise ------------------------------------------------------------------------------------

/// A hash of a point in [0, 1): David Hoskins's "Hash without Sine"
/// (https://www.shadertoy.com/view/4djSRW, its `hash12`), transcribed, under its licence:
///
/// Copyright (c) 2014 David Hoskins.
///
/// Permission is hereby granted, free of charge, to any person obtaining a copy of this software
/// and associated documentation files (the "Software"), to deal in the Software without
/// restriction, including without limitation the rights to use, copy, modify, merge, publish,
/// distribute, sublicense, and/or sell copies of the Software, and to permit persons to whom the
/// Software is furnished to do so, subject to the following conditions:
///
/// The above copyright notice and this permission notice shall be included in all copies or
/// substantial portions of the Software.
///
/// THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED, INCLUDING
/// BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND
/// NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM,
/// DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
/// OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.
///
/// (Carried from rywible/wrela 7ae6711e, content/humanoid/look.wrela, as today's ink draws with.)
pub fn hash2(p: vec2) -> f32 {
    var q = fract(vec3(p.x, p.y, p.x) * 0.1031)
    q += dot(q, vec3(q.y, q.z, q.x) + 33.33)
    fract((q.x + q.y) * q.z)
}

/// Value noise in [0, 1] (today's `noise`, content/humanoid/look.wrela).
pub fn noise(p: vec2) -> f32 {
    let i = floor(p)
    let f = p - i
    let u = f * f * (vec2(3.0) - 2.0 * f)
    let a = hash2(i)
    let b = hash2(i + vec2(1.0, 0.0))
    let c = hash2(i + vec2(0.0, 1.0))
    let d = hash2(i + vec2(1.0, 1.0))
    mix(mix(a, b, u.x), mix(c, d, u.x), u.y)
}

/// The luma of a colour.
pub fn luma(c: vec3) -> f32 {
    dot(c, vec3(0.2126, 0.7152, 0.0722))
}

// ---- strokes ----------------------------------------------------------------------------------

/// A stroke: a point on an edge (px from the screen's top left), the edge's unit normal, how
/// dark a line it makes (0 to 1: its weight by what made it), how energetic it is, and what it
/// is besides (`MARGIN`).
pub struct Stroke: Copy + GpuData {
    pub at: vec2,
    pub normal: vec2,
    pub strength: f32,
    pub energy: f32,
    pub kind: u32,
    pub spare: u32,
}

/// A stroke that is the striker's outline in an impact frame: it lays paper round the striker.
pub const MARGIN: u32 = 1

/// How far along its edge a stroke's piece runs either side of its point, in strides (px a
/// stride: `Moment::stride`, one stroke kept in that many columns or rows): pieces two strides
/// long, so the next kept one along a line overlaps it even where its neighbours keep by
/// columns and it by rows (near 45 degrees; at 1.5 strides a disc's outline at 4K had 5 pixels
/// left out).
pub const PIECE: f32 = 1.0

/// The most strokes a frame draws.
pub const MOST_STROKES: u32 = 524288

/// The way an identity reads where nothing is: no kind, no body.
const NOTHING: u32 = 0

/// What a pixel holds, as `edges` reads it: its depth (0 nothing), identity (0 nothing), edge
/// record (`NO_EDGE` and `NO_LINE` where nothing is).
struct Held: Copy {
    z: f32,
    id: u32,
    record: vec4,
}

fn held(
    edge: Texture<Rgba16Float>,
    identity: Texture<R32Uint>,
    depth: DepthTexture,
    x: u32,
    y: u32,
) -> Held {
    let z = depth.load(x, y)
    if z > 0.0 {
        return Held { z, id: identity.load(x, y), record: edge.load(x, y) }
    }
    Held { z: 0.0, id: NOTHING, record: vec4(NO_EDGE, 0.0, NO_LINE) }
}

/// Whether two identities are one body's (kind and body), whatever their ink groups.
fn one_body(a: u32, b: u32) -> bool {
    (a & 0xffffff00) == (b & 0xffffff00)
}

/// The weight of a line between a pixel showing `a` and one showing `b` across an edge the
/// pixel showing `a` records with weight `w`, quiet: an outline where they differ (in kind, body
/// or ink group, or one shows nothing); where they're one identity, a fold by how far apart
/// they are (in log2 of depth, as today's ink measured it) or else a crease.
fn quiet_weight(s: InkStyle, w: f32, a: Held, b: Held, turn: f32) -> f32 {
    if b.z <= 0.0 || a.id != b.id {
        return w * s.outline
    }
    let fold = band(abs(log2(a.z / b.z)), s.fold, s.fold * s.fold_soft)
    w * max(s.crease * band(turn, s.crease_turn, s.crease_soft), s.fold_weight * fold)
}

/// The way the surface pixel (`x`, `y`) shows faces, toward the eye, from where it and the
/// pixels `away` and `side` of it are in the world; `w` 0 where one of them shows nothing or
/// another identity.
fn face(
    eye: Eye,
    depth: DepthTexture,
    identity: Texture<R32Uint>,
    id: u32,
    x: i32,
    y: i32,
    away: vec2,
    side: vec2,
) -> vec4 {
    let w = i32(depth.width())
    let h = i32(depth.height())
    let bx = clamp(x + i32(away.x), 0, w - 1)
    let by = clamp(y + i32(away.y), 0, h - 1)
    let cx = clamp(x + i32(side.x), 0, w - 1)
    let cy = clamp(y + i32(side.y), 0, h - 1)
    let za = depth.load(u32(x), u32(y))
    let zb = depth.load(u32(bx), u32(by))
    let zc = depth.load(u32(cx), u32(cy))
    if za <= 0.0 ||
        zb <= 0.0 ||
        zc <= 0.0 ||
        identity.load(u32(bx), u32(by)) != id ||
        identity.load(u32(cx), u32(cy)) != id {
        return vec4(0.0)
    }
    let a = eye.place(vec2(f32(x) + 0.5, f32(y) + 0.5), za)
    let b = eye.place(vec2(f32(bx) + 0.5, f32(by) + 0.5), zb)
    let c = eye.place(vec2(f32(cx) + 0.5, f32(cy) + 0.5), zc)
    var n = cross(b - a, c - a)
    let l = length(n)
    if !(l > 1.0e-20) {
        return vec4(0.0)
    }
    n = n / l
    if dot(n, eye.at - a) < 0.0 {
        n = -n
    }
    vec4(n, 1.0)
}

/// How far the faces either side of a crease between pixel (`x`, `y`) and the pixel `hop` steps
/// along `step` turn (`1 - na·nb`), each face's way found from three pixels on its own side,
/// `apart` px apart (the pen's radius: today's ink compared normals that far across a line); 1
/// where either can't be found. `n` is the edge's normal, toward the far side.
fn turn_at(
    eye: Eye,
    depth: DepthTexture,
    identity: Texture<R32Uint>,
    id: u32,
    x: i32,
    y: i32,
    step: vec2,
    hop: f32,
    n: vec2,
    apart: f32,
) -> f32 {
    let perp = vec2(-step.y, step.x)
    let side = if dot(perp, n) <= 0.0 { perp } else { -perp }
    let a = face(eye, depth, identity, id, x, y, away: -step * apart, side: side * apart)
    let qx = x + i32(step.x * hop)
    let qy = y + i32(step.y * hop)
    let b = face(eye, depth, identity, id, qx, qy, away: step * apart, side: -side * apart)
    if a.w < 0.5 || b.w < 0.5 {
        return 1.0
    }
    1.0 - dot(a.xyz, b.xyz)
}

/// The weight of a line between `a` and `b` in an impact frame (ink.wrela:57-80): a body's
/// outline against anything else, whole (its ink groups one shape); within a body, a fold, near
/// where the blow lands (`near`) alone; nothing else.
fn impact_weight(s: InkStyle, m: Moment, a: Held, b: Held, near: f32) -> f32 {
    let body_a = a.z > 0.0 && m.knows(a.id)
    let body_b = b.z > 0.0 && m.knows(b.id)
    var e = 0.0
    if !(a.z > 0.0 && b.z > 0.0 && one_body(a.id, b.id)) {
        e = if body_a || body_b { 1.0 } else { 0.0 }
    } else if body_a {
        let fold = band(abs(log2(a.z / b.z)), s.fold, s.fold * s.fold_soft)
        e = fold * band(near, s.fold_near, s.fold_near_soft)
    }
    band(e, s.impact_line, s.impact_line_soft)
}

/// Whether the edge between `a` and `b` is the striker's outline.
fn striker_edge(m: Moment, a: Held, b: Held) -> bool {
    (a.z > 0.0 && m.strikes(a.id)) != (b.z > 0.0 && m.strikes(b.id))
}

/// How energetic a stroke between `a` (at pixel `pa`) and `b` (at `pb`) is: the frame's kinetic
/// felt there, or either side's own along a striking limb.
fn stroke_energy(
    eye: Eye,
    s: InkStyle,
    m: Moment,
    at: vec2,
    a: Held,
    pa: vec2,
    b: Held,
    pb: vec2,
) -> f32 {
    var e = felt(m, s, at)
    if m.by > 0.0 {
        if a.z > 0.0 {
            e = max(e, limb_energy(m, s, a.id, eye.place(pa, a.z)))
        }
        if b.z > 0.0 {
            e = max(e, limb_energy(m, s, b.id, eye.place(pb, b.z)))
        }
    }
    clamp(e, 0.0, 1.0)
}

/// What made a stroke, in its `kind`'s low two bits: a change of identity, an edge record, or a
/// seam of the line field.
const BY_IDENTITY: u32 = 0
const BY_RECORD: u32 = 1
const BY_SEAM: u32 = 2

/// A stroke as `edges` lists it, before it's weighed: at `at` with normal `n`, made `made`
/// between pixel (`x`, `y`) and the pixel `hop` steps along `step` (one of the four ways), its
/// record's strength `w` (for a record) in `strength`, the pixel in `spare`, and how it was made
/// in `kind`: `made`, the step's way (bits 2 and 3: across, back, down, up) and whether it hops
/// two (bit 4).
fn listed(at: vec2, n: vec2, w: f32, made: u32, x: u32, y: u32, step: vec2, hop: f32) -> Stroke {
    let way: u32 = if step.x > 0.5 { 0 } else if step.x < -0.5 { 1 } else if step.y > 0.5 {
        2
    } else {
        3
    }
    Stroke {
        at,
        normal: n,
        strength: w,
        energy: 0.0,
        kind: made | (way << 2) | (if hop > 1.5 { 16 } else { 0 }),
        spare: x | (y << 16),
    }
}

/// A listed stroke weighed: its weight by what's either side (read again at its two pixels), its
/// energy, and whether it's the striker's outline in an impact frame (`MARGIN`).
fn weigh(
    eye: Eye,
    air: Air,
    s: InkStyle,
    m: Moment,
    edge: Texture<Rgba16Float>,
    identity: Texture<R32Uint>,
    depth: DepthTexture,
    raw: Stroke,
) -> Stroke {
    let made = raw.kind & 3
    let way = (raw.kind >> 2) & 3
    let hop = if (raw.kind & 16) != 0 { 2.0 } else { 1.0 }
    let x = raw.spare & 0xffff
    let y = raw.spare >> 16
    let step = if way == 0 { vec2(1.0, 0.0) } else if way == 1 { vec2(-1.0, 0.0) } else if way ==
        2 {
        vec2(0.0, 1.0)
    } else { vec2(0.0, -1.0) }
    let w = depth.width()
    let h = depth.height()
    let qx = u32(clamp(i32(x) + i32(step.x * hop), 0, i32(w) - 1))
    let qy = u32(clamp(i32(y) + i32(step.y * hop), 0, i32(h) - 1))
    let a = held(edge, identity, depth, x, y)
    let b = held(edge, identity, depth, qx, qy)
    let pb = vec2(f32(qx) + 0.5, f32(qy) + 0.5)
    let pa = vec2(f32(x) + 0.5, f32(y) + 0.5)
    let seam = made == BY_SEAM
    let impact = m.kinetic > s.impact
    var strength = 0.0
    if impact {
        strength = if seam { 0.0 } else { impact_weight(s, m, a, b, nearness(m, s, raw.at)) }
    } else if seam {
        strength = s.seam
    } else {
        var turn = 1.0
        if made == BY_RECORD && b.z > 0.0 && b.id == a.id {
            let apart = max(1.0, floor(m.scale * s.base + 0.5))
            turn = turn_at(eye, depth, identity, a.id, i32(x), i32(y), step, hop, raw.normal, apart)
        }
        strength = quiet_weight(s, raw.strength, a, b, turn)
    }
    if !impact {
        // (Faded with the air at the form it lies on, the nearer side's: what the air has
        // nearly hidden carries no line, `air`.)
        strength *= reaching(air, eye, if a.z >= b.z { pa } else { pb }, max(a.z, b.z))
    }
    Stroke {
        at: raw.at,
        normal: raw.normal,
        strength,
        energy: stroke_energy(eye, s, m, raw.at, a, pa, b, pb),
        kind: if impact && !seam && striker_edge(m, a, b) { MARGIN } else { 0 },
        spare: 0,
    }
}

/// Each listed stroke weighed (`weigh`), an invocation a stroke, from `raw` (`count[0]` of them,
/// `most` at most) into `out`.
@compute(64)
pub fn weighed(
    eye: Eye,
    air: Air,
    style: InkStyle,
    moment: Moment,
    edge: Texture<Rgba16Float>,
    identity: Texture<R32Uint>,
    depth: DepthTexture,
    count: [u32],
    most: u32,
    raw: [Stroke],
    out: mut Slots<Stroke>,
    id: GlobalId,
) {
    if id.x >= min(count[0], most) {
        return
    }
    out[id] = weigh(eye, air, style, moment, edge, identity, depth, raw[id.x])
}

/// How many groups of 64 `weighed` takes for `count[0]` strokes (`most` at most): an indirect
/// dispatch's three counts.
@compute(3)
pub fn strokes_grouped(count: [u32], most: u32, out: mut Slots<u32>, id: GlobalId) {
    out[id] = if id.x == 0 { (min(count[0], most) + 63) / 64 } else { 1 }
}

/// Whether a stroke whose edge runs along x (`along_x`) at pixel (`x`, `y`) is one the frame
/// keeps: one in every `stride` columns (or rows, along y). The pieces are as long.
fn kept(stride: u32, along_x: bool, x: u32, y: u32) -> bool {
    (if along_x { x } else { y }) % stride == 0
}

/// Pixel (`x`, `y`)'s strokes (at most three: its own edge's, and toward its neighbours across
/// and down a change of identity or of the line field's sign) onto `out`, from what it holds
/// (`here`), what its neighbours across (`right`), down (`below`) and across and down
/// (`corner`) hold.
fn pixel_strokes(
    eye: Eye,
    style: InkStyle,
    moment: Moment,
    edge: Texture<Rgba16Float>,
    identity: Texture<R32Uint>,
    depth: DepthTexture,
    out: mut Append<Stroke>,
    x: u32,
    y: u32,
    here: Held,
    right: Held,
    below: Held,
) {
    let w = depth.width()
    let h = depth.height()
    let k = moment.stride
    let mid = vec2(f32(x) + 0.5, f32(y) + 0.5)
    let e = edge_way(here.record)
    let off = length(e)
    let recorded = here.z > 0.0 && off < EDGE_REACH
    // Its own edge, if a line is drawn along it (its record's strength over 0) and it crosses
    // toward its neighbours (less than a pixel and a half off along the axis it lies across
    // most): the stroke at the record's place, its weight by what's across (the first pixel past
    // the edge along that axis). (An edge of strength 0 is smoothed by the last pass from its
    // record, and has no stroke.)
    if recorded && edge_strength(here.record) > 0.0 && kept(k, abs(e.y) >= abs(e.x), x, y) {
        let along = max(abs(e.x), abs(e.y))
        let crossing = off * off / max(along, 1.0e-6)
        if crossing < EDGE_REACH {
            let step = toward(e)
            let hop = if crossing < 1.0 { 1.0 } else { 2.0 }
            let n = e / max(off, 1.0e-6)
            let _ = out.push(
                listed(mid + e, n, edge_strength(here.record), BY_RECORD, x, y, step, hop),
            )
        }
    }
    // Toward the neighbour across (j 0) and down (j 1).
    var seamed = false
    for j in 0..2 {
        let ox: u32 = if j == 0 { 1 } else { 0 }
        let oy: u32 = 1 - ox
        if x + ox < w && y + oy < h {
            let there = if j == 0 { right } else { below }
            let axis = vec2(f32(ox), f32(oy))
            let half = mid + axis * 0.5
            if there.id != here.id {
                // A change of identity no record of a line holds: a stroke half way. (A record of
                // strength 0 holds no line: the change is drawn as if it weren't there.)
                let et = edge_way(there.record)
                let mine = recorded &&
                    edge_strength(here.record) > 0.0 &&
                    length(mid + e - half) < 1.0
                let theirs = there.z > 0.0 &&
                    length(et) < EDGE_REACH &&
                    edge_strength(there.record) > 0.0 &&
                    length(mid + axis + et - half) < 1.0
                if !mine && !theirs && kept(k, j == 1, x, y) {
                    let _ = out.push(listed(half, axis, 1.0, BY_IDENTITY, x, y, axis, 1.0))
                }
            } else if here.z > 0.0 && !seamed {
                // The line field changes sign: a stroke where it's 0, along its slope.
                let a = here.record.w
                let b = there.record.w
                if (a < 0.0) != (b < 0.0) && a != NO_LINE && b != NO_LINE {
                    let other = if j == 0 { below } else { right }
                    var g = axis * (b - a)
                    if other.id == here.id && other.record.w != NO_LINE {
                        g += vec2(f32(oy), f32(ox)) * (other.record.w - a)
                    }
                    let gg = max(dot(g, g), 1.0e-12)
                    if kept(k, abs(g.y) >= abs(g.x), x, y) {
                        let at = mid + axis * (a / (a - b))
                        let _ = out.push(listed(at, g / sqrt(gg), 1.0, BY_SEAM, x, y, axis, 1.0))
                    }
                    seamed = true
                }
            }
        }
    }
}

/// What a pixel `z` deep, with line field `line`, at (`x`, `y`) holds, its identity read; its
/// record read where `record` (else `NO_EDGE`, as only its line field is needed).
fn holding(
    edge: Texture<Rgba16Float>,
    identity: Texture<R32Uint>,
    z: f32,
    line: f32,
    x: u32,
    y: u32,
    record: bool,
) -> Held {
    if z <= 0.0 {
        return Held { z: 0.0, id: NOTHING, record: vec4(NO_EDGE, 0.0, NO_LINE) }
    }
    Held {
        z,
        id: identity.load(x, y),
        record: if record { edge.load(x, y) } else { vec4(NO_EDGE, 0.0, line) },
    }
}

/// A neighbour's record read where it differs in identity from the pixel it's beside: whether
/// its edge is the one between them.
fn told(edge: Texture<Rgba16Float>, beside: Held, n: Held, x: u32, y: u32) -> Held {
    if n.z > 0.0 && n.id != beside.id {
        return Held { z: n.z, id: n.id, record: edge.load(x, y) }
    }
    n
}

/// How many words the marks of a screen `w` × `h` px take: a bit a pixel, a row's in
/// `(w + 31) / 32` words.
pub fn mark_words(w: u32, h: u32) -> u32 {
    (w + 31) / 32 * h
}

/// Whether pixel (`x`, `y`) of a screen `w` px across is marked (`marks`, `edges`'s): its edge
/// record or a neighbour's across or down holds an edge, so the last pass smooths it.
pub fn marked(marks: [u32], w: u32, x: u32, y: u32) -> bool {
    ((marks[y * ((w + 31) / 32) + x / 32] >> (x % 32)) & 1) != 0
}

/// Marks pixel (`x`, `y`) and its neighbours across and down (`marked`), on a screen `w` × `h`.
fn mark(marks: mut Atomics<u32>, w: u32, h: u32, x: u32, y: u32) {
    let row = (w + 31) / 32
    for k in 0..5 {
        let px = i32(x) + (if k == 1 { 1 } else if k == 2 { -1 } else { 0 })
        let py = i32(y) + (if k == 3 { 1 } else if k == 4 { -1 } else { 0 })
        if px >= 0 && py >= 0 && px < i32(w) && py < i32(h) {
            let _ = marks.or(u32(py) * row + u32(px) / 32, 1 << (u32(px) % 32))
        }
    }
}

/// Every mark cleared: `words` of them.
@compute(64)
pub fn unmarked(out: mut Slots<u32>, words: u32, id: GlobalId) {
    if id.x < words {
        out[id] = 0
    }
}

/// Whether the style draws any line this moment: in an impact frame, or where one of its weights
/// is over 0. (Where none is, nothing is listed: the edges are smoothed from their records.)
pub fn lines_drawn(s: InkStyle, m: Moment) -> bool {
    m.kinetic > s.impact || s.outline > 0.0 || s.fold_weight > 0.0 || s.crease > 0.0 || s.seam > 0.0
}

/// Each pixel's strokes, onto `out`, an invocation two pixels side by side (`x0`, `y`) and
/// (`x0 + 1`, `y`). What they and their neighbours across and down show is read in nine
/// fetches: their six depths in two gathers (`near`, a sampler of the nearest texel), their line
/// fields in two more, the two pixels' records, and the five identities (a `R32Uint` target
/// can't be gathered). Nothing more where none of the six shows anything (most of the sky). (An
/// invocation a pixel cost 0.61 ms at 4K on the probe's rock, two 0.57: passes alone, M4.)
@compute(8, 8)
pub fn edges(
    eye: Eye,
    style: InkStyle,
    moment: Moment,
    edge: Texture<Rgba16Float>,
    identity: Texture<R32Uint>,
    depth: DepthTexture,
    near: Sampler,
    out: mut Append<Stroke>,
    marks: mut Atomics<u32>,
    id: GlobalId,
) {
    let w = depth.width()
    let h = depth.height()
    let x0 = id.x * 2
    let y = id.y
    if x0 >= w || y >= h {
        return
    }
    // Each gather is the 2 × 2 from a pixel's top left: x is (x, y + 1), y (x + 1, y + 1),
    // z (x + 1, y), w (x, y) (WGSL's order); past the screen's edge, the edge pixels again.
    let size = vec2(f32(w), f32(h))
    let ua = vec2(f32(x0) + 1.0, f32(y) + 1.0) / size
    let ub = vec2(f32(x0) + 2.0, f32(y) + 1.0) / size
    let za = depth.gather(near, ua)
    let zb = depth.gather(near, ub)
    if za.w <= 0.0 && za.z <= 0.0 && za.x <= 0.0 && za.y <= 0.0 && zb.z <= 0.0 && zb.y <= 0.0 {
        return
    }
    let la = edge.gather(near, ua, component: 3)
    let lb = edge.gather(near, ub, component: 3)
    let x1 = min(x0 + 1, w - 1)
    let x2 = min(x0 + 2, w - 1)
    let yd = min(y + 1, h - 1)
    let a = holding(edge, identity, za.w, la.w, x0, y, record: true)
    let b = holding(edge, identity, za.z, la.z, x1, y, record: true)
    // The pixels the last pass smooths: each whose record holds an edge, and its neighbours.
    if a.z > 0.0 && edge_near(a.record) {
        mark(mut marks, w, h, x0, y)
    }
    if x0 + 1 < w && b.z > 0.0 && edge_near(b.record) {
        mark(mut marks, w, h, x1, y)
    }
    if !lines_drawn(style, moment) {
        return
    }
    let c = holding(edge, identity, zb.z, lb.z, x2, y, record: false)
    let a_down = holding(edge, identity, za.x, la.x, x0, yd, record: false)
    let b_down = holding(edge, identity, za.y, la.y, x1, yd, record: false)
    // Most pixels shown are inside one surface: no record near, one identity, one side of the
    // line field. They stop here, before the work of listing.
    let near_a = a.z > 0.0 && edge_strength(a.record) > 0.0
    let near_b = b.z > 0.0 && edge_strength(b.record) > 0.0
    let ids = a.id != b.id || a.id != a_down.id || b.id != c.id || b.id != b_down.id
    let la_ = a.record.w < 0.0
    let lb_ = b.record.w < 0.0
    let signs = la_ != lb_ ||
        la_ != (a_down.record.w < 0.0) ||
        lb_ != (c.record.w < 0.0) ||
        lb_ != (b_down.record.w < 0.0)
    if !near_a && !near_b && !ids && !signs {
        return
    }
    pixel_strokes(
        eye,
        style,
        moment,
        edge,
        identity,
        depth,
        mut out,
        x0,
        y,
        here: a,
        right: if x0 + 1 < w { b } else { a },
        below: told(edge, a, a_down, x0, yd),
    )
    if x0 + 1 < w {
        pixel_strokes(
            eye,
            style,
            moment,
            edge,
            identity,
            depth,
            mut out,
            x1,
            y,
            here: b,
            right: told(edge, b, c, x2, y),
            below: told(edge, b, b_down, x1, yd),
        )
    }
}

/// The strokes' draw: six vertices a stroke, as many strokes as were listed (`most` at most).
@compute(1)
pub fn strokes_drawn(count: [u32], most: u32, out: mut Slots<DrawArgs>, id: GlobalId) {
    out[id] = DrawArgs {
        vertices: 6,
        instances: min(count[0], most),
        first_vertex: 0,
        first_instance: 0,
    }
}

/// How far from a pixel's middle an edge still touches it: half its diagonal (px).
const AA: f32 = 0.7072

/// A quad's corners as two triangles.
const QUAD: [u32; 6] = [0, 1, 2, 2, 1, 3]

/// A corner of a stroke's quad: which stroke it is, and its pen where it lies (the noises the
/// pen wobbles and wanders by change over tens of pixels, so once a stroke is enough): the
/// pen's radius, and where strand 0's hand puts it (`xy` of `pen`'s `yz`), strands 1's and 2's
/// (`shoves`).
pub struct StrokeCorner: Copy {
    pub clip: ClipPosition,
    pub index: Flat<u32>,
    pub pen: Flat<vec4>,
    pub shoves: Flat<vec4>,
}

/// The pen's radius at pixel `px`, at energy `e` (px).
pub fn pen(s: InkStyle, m: Moment, px: vec2, e: f32) -> f32 {
    let wob = noise(px / (m.scale * s.wob_cells) + vec2(m.drawing * s.boil, 0.0)) - 0.5
    m.scale * (s.base + (s.wob + s.wob_energy * e) * wob) * (1.0 + s.swell * e)
}

/// How far strand `k`'s hand puts its stroke from pixel `px`, at energy `e` (px).
pub fn shoved(s: InkStyle, m: Moment, px: vec2, e: f32, k: u32) -> vec2 {
    let kk = f32(k)
    let cell = px / (m.scale * s.wander_cells)
    let wander = vec2(
        noise(cell + vec2(m.drawing * 1.3 + kk * 17.0, kk * 5.0)),
        noise(cell + vec2(kk * 9.0, m.drawing * 0.9 + kk * 23.0)),
    ) -
        vec2(0.5)
    let by = if k == 0 { s.shove_quiet + s.shove_loud * e } else { 1.0 + kk }
    wander * (m.scale * s.shove * (1.0 + s.shove_energy * e) * by)
}

/// How many strands a stroke of energy `e` lifts.
fn strands_at(s: InkStyle, e: f32) -> u32 {
    var n: u32 = 1
    for k in 1..s.strands {
        if e > s.strand_from + s.strand_step * f32(k) - s.strand_soft {
            n = k + 1
        }
    }
    n
}

/// Vertex `v` of stroke `i`: a corner of its quad on the screen (`size`, px), as far across
/// its line as the pen reaches and along it a little past its piece.
@vertex
pub fn stroke_corner(
    v: VertexIndex,
    i: InstanceIndex,
    strokes: [Stroke],
    style: InkStyle,
    moment: Moment,
    size: vec2,
) -> StrokeCorner {
    let s = style
    let m = moment
    let st = strokes[i.index]
    let e = st.energy
    var r = 0.0
    var s0 = vec2(0.0)
    var s1 = vec2(0.0)
    var s2 = vec2(0.0)
    let piece = PIECE * f32(m.stride)
    // Across its line, the anti-aliasing's reach; and where it draws a line, the pen's (a pixel
    // is touched by an edge `AA` px from its middle at most: half its diagonal).
    var across = EDGE_REACH + 0.25
    var along = piece + 0.25
    let inked = st.strength > 0.0
    if m.kinetic > s.impact {
        r = m.scale * (s.pen + s.pen_near)
        let margin = if st.kind == MARGIN { m.scale * (s.margin + s.margin_near) } else { 0.0 }
        across = max(across, max(if inked { r + AA } else { 0.0 }, margin + 0.5))
    } else {
        r = pen(s, m, st.at, e)
        s0 = shoved(s, m, st.at, e, 0)
        along += length(s0)
        if inked {
            across = max(across, r + length(s0) + AA)
            let n = strands_at(s, e)
            if n > 1 {
                s1 = shoved(s, m, st.at, e, 1)
                across = max(across, r * s.strand_pen + length(s1) + AA)
                along = max(along, piece + 0.25 + length(s1))
            }
            if n > 2 {
                s2 = shoved(s, m, st.at, e, 2)
                across = max(across, r * s.strand_pen + length(s2) + AA)
                along = max(along, piece + 0.25 + length(s2))
            }
            if e > s.fleck_from - s.fleck_from_soft {
                across = max(across, s.fleck_reach * r + 0.5)
            }
        }
    }
    let j = QUAD[v.index % 6]
    let t = vec2(-st.normal.y, st.normal.x)
    let x = if (j & 1) != 0 { 1.0 } else { -1.0 }
    let y = if (j & 2) != 0 { 1.0 } else { -1.0 }
    let p = st.at + st.normal * (x * across) + t * (y * along)
    StrokeCorner {
        clip: ClipPosition {
            position: vec4(p.x / size.x * 2.0 - 1.0, 1.0 - p.y / size.y * 2.0, 0.0, 1.0),
        },
        index: Flat { value: i.index },
        pen: Flat { value: vec4(r, s0, 0.0) },
        shoves: Flat { value: vec4(s1, s2) },
    }
}

/// How much of the pixel whose middle is `p` lies within `r` of the stroke `st`'s piece of line:
/// exactly, for a straight line, either side (`covered` each side, less the whole). Past the
/// piece's ends, by the distance to its end.
pub fn band_cover(st: Stroke, p: vec2, r: f32, piece: f32) -> f32 {
    let d = p - st.at
    let t = vec2(-st.normal.y, st.normal.x)
    let u = dot(d, t)
    let v = dot(d, st.normal)
    if abs(u) <= piece {
        return max(covered(r - v, st.normal) + covered(r + v, st.normal) - 1.0, 0.0)
    }
    let far = length(vec2(abs(u) - piece, v))
    let n = st.normal * v + t * (sign(u) * (abs(u) - piece))
    covered(r - far, n / max(far, 1.0e-6))
}

/// How far the pixel whose middle is `p` is from the stroke's piece of line (px).
fn piece_distance(st: Stroke, p: vec2, piece: f32) -> f32 {
    let d = p - st.at
    let u = dot(d, vec2(-st.normal.y, st.normal.x))
    let v = dot(d, st.normal)
    length(vec2(max(abs(u) - piece, 0.0), v))
}

/// Whether the pixel whose middle is `p` is one whose anti-aliasing reads its neighbours: within
/// the edge's reach of the stroke's piece.
fn within_reach(st: Stroke, p: vec2, piece: f32) -> bool {
    let d = p - st.at
    let u = dot(d, vec2(-st.normal.y, st.normal.x))
    abs(dot(d, st.normal)) < EDGE_REACH && abs(u) <= piece + 0.25
}

/// What a pixel's `y` in the strokes target is at least where its anti-aliasing reads its
/// neighbours (within an edge's reach of a stroke's piece).
pub const NEAR: f32 = 0.5

/// A margin's `y`: past every other.
pub const IN_MARGIN: f32 = 1.0

/// A stroke's pixel into the strokes target (each channel's greatest kept): `x` its line's
/// cover; `y` at least `NEAR` where the last pass's anti-aliasing must read the pixel's
/// neighbours, and in an energetic frame its line's weight where a fleck's middle may be (within
/// `fleck_reach` pens), in an impact frame `IN_MARGIN` within the paper margin round the
/// striker.
@fragment
pub fn stroke_cover(
    f: StrokeCorner,
    pixel: FragCoord,
    strokes: [Stroke],
    style: InkStyle,
    moment: Moment,
    colour: Texture<Rgba16Float>,
    depth: DepthTexture,
) -> vec4 {
    let st = strokes[f.index.value]
    let s = style
    let m = moment
    let px = pixel.position.xy
    let piece = PIECE * f32(m.stride)
    let near = if within_reach(st, px, piece) { NEAR } else { 0.0 }
    let r = f.pen.value.x
    if m.kinetic > s.impact {
        let pen = m.scale * (s.pen + s.pen_near * nearness(m, s, px))
        let line = st.strength * band_cover(st, px, pen, piece)
        var margin = 0.0
        if st.kind == MARGIN &&
            piece_distance(st, px, piece) <=
                m.scale * (s.margin + s.margin_near * nearness(m, s, px)) {
            margin = IN_MARGIN
        }
        return vec4(line, max(near, margin), 0.0, 0.0)
    }
    let e = st.energy
    var line = st.strength * band_cover(st, px + f.pen.value.yz, r, piece)
    let n = strands_at(s, e)
    if n > 1 || e > s.gap_from - s.gap_from_soft {
        // Energetic: strands, lifted in as the energy rises (none on a dark form: pale ones
        // on black were lint, ink.wrela:296-297), and gaps.
        var dark = 0.0
        let z = depth.load(u32(px.x), u32(px.y))
        if z > 0.0 {
            let c = displayed(s, colour.load(u32(px.x), u32(px.y)).xyz)
            dark = 1.0 - band(luma(c), s.dark, s.dark_soft)
        }
        line = 0.0
        for k in 0..3 {
            if k < n {
                let kk = f32(k)
                let lift = if k == 0 { 1.0 } else {
                    band(e, s.strand_from + s.strand_step * kk, s.strand_soft) * (1.0 - dark)
                }
                let shove = if k == 0 { f.pen.value.yz } else if k == 1 { f.shoves.value.xy } else {
                    f.shoves.value.zw
                }
                let rk = if k == 0 { r } else { r * s.strand_pen }
                let c = band_cover(st, px + shove, rk, piece)
                // Each strand breaks where its own slow noise falls: dashes, then fragments.
                let gaps = noise(
                    px / (m.scale * s.gap_cells) + vec2(m.drawing * 2.3 + kk * 41.0, kk * 13.0),
                )
                let kept = 1.0 -
                    band(gaps, 1.0 - s.gap_energy * e, s.gap_soft) *
                        band(e, s.gap_from, s.gap_from_soft)
                line = max(line, st.strength * c * kept * lift * (if k == 0 { 1.0 } else {
                    s.strand_ink
                }))
            }
        }
    }
    var wide = 0.0
    if e > s.fleck_from - s.fleck_from_soft && piece_distance(st, px, piece) <= s.fleck_reach * r {
        wide = st.strength
    }
    vec4(line, max(near, wide), 0.0, 0.0)
}
