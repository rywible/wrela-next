// What the last pass knows of the moment, besides the picture: which drawing it is (the ink boils
// once a drawing, on anime's twos), and each body's blow as the scene's bodies give it: how much
// of an impact frame it is, and where its strike's force runs and how hard. From these the last
// pass draws the energy along a striking limb, the palette's drain toward manga's values, flecks,
// and the impact frame. Gathered on the CPU as a frame is drawn (`Frame::at`, `Frame::blow`),
// handed to the GPU as one uniform.
//
// Today's ink took the same from its `Shot` (rywible/wrela 7ae6711e, content/humanoid/look.wrela
// 36-53; mmo/game/bodies.wrela 860-912): `held`, `kinetic` (the most impact of any body), and the
// strongest blow's force (`force.by` the greatest).

use eye::Eye
use form::ink::InkStyle
use form::shade::band

/// How many bodies a frame knows of: those the impact frame outlines and lays paper round.
pub const MOST_BODIES: u32 = 8

/// No body: an identity no lister writes (kind 7).
pub const NO_BODY: u32 = 0xffffff00

/// No ink group: a body with no face.
pub const NO_GROUP: u32 = 0xffffffff

/// The identity bits that name a body: its kind and body, not its ink group.
pub const BODY_BITS: u32 = 0xffffff00

/// One body's blow on a frame, as the scene's bodies give it (game/bodies' `Drawing`): how much
/// of an impact frame it is (1 a flash), where its strike's force runs from and to (the world)
/// and how hard (0 none to 1), and which of its ink groups is its face, whose pale side (the line
/// field's positive side) keeps its paper when it strikes in an impact frame (`NO_GROUP`: none).
pub struct Blow: Copy {
    pub impact: f32 = 0.0,
    pub from: vec3 = vec3(),
    pub to: vec3 = vec3(),
    pub by: f32 = 0.0,
    pub face: u32 = NO_GROUP,
}

/// The moment as the last pass reads it.
pub struct Moment: Copy + GpuData {
    /// The strongest blow's force: from and to (the world), and how hard (0: none).
    pub from: vec3,
    pub by: f32,
    pub to: vec3,
    /// The frame's kinetic: the most impact of any body.
    pub kinetic: f32,
    /// Where the force lands on the screen (px).
    pub landing: vec2,
    /// The drawing: the boil's seed.
    pub drawing: f32,
    /// The screen's height over the lines the ink's sizes are given on.
    pub scale: f32,
    /// The striker (the strongest blow's body: kind and body, `NO_BODY` for none), its face's
    /// ink group, and how many bodies the frame knows of.
    pub striker: u32,
    pub face: u32,
    pub count: u32,
    /// One stroke of ink kept in this many columns or rows (`ink::edges`): half the pen's
    /// radius, so a line is drawn from as few pieces as hold its curve.
    pub stride: u32,
    /// The bodies (kind and body each), four to a vector.
    pub bodies: [vec4u; 2],
}

/// A moment with no blow, at drawing 0.
pub const STILL_MOMENT = Moment {
    from: vec3(),
    by: 0.0,
    to: vec3(),
    kinetic: 0.0,
    landing: vec2(),
    drawing: 0.0,
    scale: 1.0,
    striker: NO_BODY,
    face: NO_GROUP,
    count: 0,
    stride: 1,
    bodies: [vec4u(NO_BODY); 2],
}

impl Moment {
    /// Body `k` of those the frame knows of.
    pub fn body(self, k: u32) -> u32 {
        let v = self.bodies[k / 4]
        let i = k % 4
        if i == 0 { v.x } else if i == 1 { v.y } else if i == 2 { v.z } else { v.w }
    }

    /// Whether identity `id` is one of the bodies the frame knows of.
    pub fn knows(self, id: u32) -> bool {
        let b = id & BODY_BITS
        var found = false
        for k in 0..MOST_BODIES {
            found = found || (k < self.count && self.body(k) == b)
        }
        found
    }

    /// Whether identity `id` is the striker's.
    pub fn strikes(self, id: u32) -> bool {
        (id & BODY_BITS) == self.striker
    }

    /// `body`'s `blow` taken in: the frame's kinetic its impact if more, the strongest force
    /// its if stronger.
    pub fn took(mut self, body: u32, blow: Blow) {
        let b = body & BODY_BITS
        if self.count < MOST_BODIES && !self.knows(b) {
            let k = self.count
            var v = self.bodies[k / 4]
            let i = k % 4
            if i == 0 {
                v.x = b
            } else if i == 1 {
                v.y = b
            } else if i == 2 {
                v.z = b
            } else {
                v.w = b
            }
            self.bodies[k / 4] = v
            self.count += 1
        }
        self.kinetic = max(self.kinetic, blow.impact)
        if blow.by > self.by {
            self.from = blow.from
            self.to = blow.to
            self.by = blow.by
            self.striker = b
            self.face = blow.face
        }
    }

    /// Made ready for the pass: the drawing at `time` s, the scale of `eye`'s screen, where the
    /// force lands on it.
    pub fn ready(mut self, eye: Eye, style: InkStyle, time: f32) {
        self.drawing = floor(time * style.drawings)
        self.scale = eye.size.y / style.lines
        self.stride = u32(clamp(floor(0.5 * self.scale * style.base + 0.5), 1.0, 3.0))
        if self.by > 0.0 {
            let c = eye.clip(self.to)
            let ndc = c.xy / max(c.w, 1.0e-4)
            self.landing = vec2((ndc.x * 0.5 + 0.5) * eye.size.x, (0.5 - ndc.y * 0.5) * eye.size.y)
        }
    }
}

/// How energetic a pixel showing `id` at world point `p` is from the moment's blow alone: along
/// the striker's striking limb, by the force's line (today's paint pass, fighter.wrela:804-813).
pub fn limb_energy(m: Moment, s: InkStyle, id: u32, p: vec3) -> f32 {
    if m.by <= 0.0 || !m.strikes(id) {
        return 0.0
    }
    let ab = m.to - m.from
    let k = saturate(dot(p - m.from, ab) / max(dot(ab, ab), 1.0e-6))
    let d = length(p - (m.from + ab * k))
    let near = 1.0 - band(d, s.limb, s.limb_soft)
    m.by * near * saturate((k - s.limb_from) / s.limb_rise)
}

/// The frame's kinetic as felt at pixel `px`: all of it where no blow lands, else falling off
/// round where it lands (ink.wrela:288-293).
pub fn felt(m: Moment, s: InkStyle, px: vec2) -> f32 {
    var focus = 1.0
    if m.by > 0.01 {
        focus = 1.0 - band(length(px - m.landing), s.focus * m.scale, s.focus_soft * m.scale)
    }
    m.kinetic * focus
}

/// How near pixel `px` is to where the blow lands, for the impact frame's pen (0 to 1; a half
/// where none does: ink.wrela:221-225).
pub fn nearness(m: Moment, s: InkStyle, px: vec2) -> f32 {
    if m.by > 0.01 {
        return 1.0 - band(length(px - m.landing), s.near_px * m.scale, s.near_soft * m.scale)
    }
    0.5
}

/// How energetic the striking limb is where pixel `px`'s ray passes it, at the depth of where
/// its force lands: what a line beside the limb, off its own pixels, takes of it.
pub fn limb_energy_along(m: Moment, s: InkStyle, eye: Eye, px: vec2) -> f32 {
    if m.by <= 0.0 {
        return 0.0
    }
    let p = eye.place(px, eye.depth(m.to))
    let ab = m.to - m.from
    let k = saturate(dot(p - m.from, ab) / max(dot(ab, ab), 1.0e-6))
    let d = length(p - (m.from + ab * k))
    let near = 1.0 - band(d, s.limb, s.limb_soft)
    m.by * near * saturate((k - s.limb_from) / s.limb_rise)
}
