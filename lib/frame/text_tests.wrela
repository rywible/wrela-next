// Text held to a many-looks reference, on the CPU: each pixel's cover as the glyph's shader
// gives it (`Glyph::cover`), against the share of 16 × 16 looks in the pixel inside the glyph,
// at a capital 12 px tall and 200 px tall.

use form::kinds::Shape
use std::io::print
use text::{Glyph, HALF, advance}

/// What `say` counts: pixels near an edge (within a pixel of it, where a cover can be between
/// 0 and 1), the summed difference, the most, those more than 8/255 off, and pixels partly
/// covered (more than 0.02 and less than 0.98) in the text and in the reference.
struct Held: Copy {
    near: u32,
    apart: f32,
    most: f32,
    over: u32,
    partial: u32,
    partial_ref: u32,
}

/// The line `line` at a capital `height` px tall, held to the reference.
fn held(line: str, height: f32) -> Held {
    var h = Held { near: 0, apart: 0.0, most: 0.0, over: 0, partial: 0, partial_ref: 0 }
    var x0 = HALF * height
    let unit = 1.0 / height
    for i in 0..line.len() {
        let code = u32(line.byte(i))
        let g = Glyph { code }
        let b = g.bound()
        let lo_x = u32(max(floor(x0 + b.lo.x * height) - 1.0, 0.0))
        let hi_x = u32(ceil(x0 + b.hi.x * height) + 1.0)
        let lo_y = i32(floor(-b.hi.y * height) - 1.0)
        let hi_y = i32(ceil(-b.lo.y * height) + 1.0)
        if code != 32 {
            for py in lo_y..hi_y {
                for px in lo_x..hi_x {
                    // The pixel's middle in the glyph's own units (y up from the baseline).
                    let mid = vec2((f32(px) + 0.5 - x0) * unit, -(f32(py) + 0.5) * unit)
                    let d = g.distance(mid) * height
                    if abs(d) <= 1.0 {
                        let c = g.cover(mid, unit)
                        var inside = 0.0
                        for j in 0..16 {
                            for k in 0..16 {
                                let q = mid +
                                    vec2(
                                        (f32(k) + 0.5) / 16.0 - 0.5,
                                        -((f32(j) + 0.5) / 16.0 - 0.5),
                                    ) *
                                        unit
                                if g.distance(q) < 0.0 {
                                    inside += 1.0 / 256.0
                                }
                            }
                        }
                        let a = abs(c - inside)
                        h.near += 1
                        h.apart += a
                        h.most = max(h.most, a)
                        if a > 8.0 / 255.0 {
                            h.over += 1
                        }
                        if c > 0.02 && c < 0.98 {
                            h.partial += 1
                        }
                        if inside > 0.02 && inside < 0.98 {
                            h.partial_ref += 1
                        }
                    }
                }
            }
        }
        x0 += advance(code) * height
    }
    h
}

fn said(height: f32, h: Held) {
    print(
        f"text at {height} px: {h.near} px within a pixel of an edge; cover against 16 x 16 looks: mean {255.0 * h.apart / f32(h.near)} of 255, most {255.0 * h.most} of 255, {100.0 * f32(h.over) / f32(h.near)}% over 8/255; partly covered {h.partial} px (the reference {h.partial_ref})",
    )
}

@test
fn text_is_sharp_at_12_and_200_px() {
    let line = "HAKURO 100   SWORDSMAN 120"
    let small = held(line, 12.0)
    said(12.0, small)
    let large = held(line, 200.0)
    said(200.0, large)
    // Sharp: no more pixels partly covered than the reference has, give or take a tenth; and
    // near it: a mean under 4/255.
    assert(small.apart / f32(small.near) < 4.0 / 255.0, "12 px text is off the reference")
    assert(large.apart / f32(large.near) < 4.0 / 255.0, "200 px text is off the reference")
    assert(f32(small.partial) < 1.1 * f32(small.partial_ref), "12 px text is blurred")
    assert(f32(large.partial) < 1.1 * f32(large.partial_ref), "200 px text is blurred")
}
