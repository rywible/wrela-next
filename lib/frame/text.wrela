// Text: the Shape kind's lister, and a small font written as Shapes. A glyph is a place on a
// plane to a distance (`form::kinds::Shape`): strokes of one width, each a segment or a circular
// arc, the distance to the nearest stroke's middle less half its width, in em (a capital's
// height 1, the baseline 0, y up). A pixel's cover is the exact share of it inside the shape's
// edge: each stroke's band either side of its middle line, as `last::covered` gives a straight
// edge's share of a pixel, exactly for a straight stroke at any size (its round caps' edges taken
// as straight across the pixel). Drawn over everything, after the last pass, into the screen.
//
// A scene says a line of text, where (its top left, px), how big (a capital's height, px) and
// what colour (linear): `frame.text("HAKURO 100", at: vec2(40.0, 40.0), height: 24.0, colour:
// vec3(1.0))`. It names no pass.
//
// The font is this repository's own, drawn for it (wrela-notes/next/scratch/ink/scripts/font.py
// writes `strokes` and `width`): capitals, digits, the space and a few marks. Each glyph is code,
// not a table: a table of strokes read at a run-time index is a function-scope array on the GPU,
// three copies of 4.4 KiB in the glyph's shader, past tools/gpu's 8 KiB guard.

use form::ink::InkStyle
use form::kinds::Shape
use last::{covered, displayed}
use std::derive::Box2
use std::gpu::{ClipPosition, Flat, FragCoord, InstanceIndex, Over, VertexIndex}

/// Half a stroke's width (em), and the room between one glyph's strokes and the next's.
pub const HALF: f32 = 0.07
pub const GAP: f32 = 0.2

/// How far a glyph's strokes reach below the baseline and above a capital (em): a comma's tail,
/// a slash's ends.
const BELOW: f32 = 0.2
const ABOVE: f32 = 0.06

/// How far `p` is from the middle of the nearest of glyph `code`'s strokes (em): each glyph its
/// own function. A code with no glyph has no strokes.
fn strokes(code: u32, p: vec2) -> f32 {
    if code == 33 {
        // '!'
        return min(
            to_segment(p, vec2(0.0, 1.0), vec2(0.0, 0.32)),
            to_segment(p, vec2(0.0, 0.0), vec2(0.0, 0.0)),
        )
    }
    if code == 37 {
        // '%'
        return min(
            min(
                to_arc(p, vec2(0.13, 0.84), r: 0.13, a0: 0.0, a1: 6.283185),
                to_arc(p, vec2(0.49, 0.16), r: 0.13, a0: 0.0, a1: 6.283185),
            ),
            to_segment(p, vec2(0.0, 0.0), vec2(0.62, 1.0)),
        )
    }
    if code == 39 {
        // "'"
        return to_segment(p, vec2(0.0, 1.0), vec2(0.0, 0.74))
    }
    if code == 40 {
        // '('
        return to_arc(p, vec2(0.6, 0.45), r: 0.6, a0: 2.261947, a1: 4.021239)
    }
    if code == 41 {
        // ')'
        return to_arc(p, vec2(-0.38, 0.45), r: 0.6, a0: -0.879646, a1: 0.879646)
    }
    if code == 43 {
        // '+'
        return min(
            to_segment(p, vec2(0.0, 0.45), vec2(0.5, 0.45)),
            to_segment(p, vec2(0.25, 0.2), vec2(0.25, 0.7)),
        )
    }
    if code == 44 {
        // ','
        return to_segment(p, vec2(0.06, 0.0), vec2(0.0, -0.18))
    }
    if code == 45 {
        // '-'
        return to_segment(p, vec2(0.0, 0.45), vec2(0.38, 0.45))
    }
    if code == 46 {
        // '.'
        return to_segment(p, vec2(0.0, 0.0), vec2(0.0, 0.0))
    }
    if code == 47 {
        // '/'
        return to_segment(p, vec2(0.0, -0.05), vec2(0.46, 1.05))
    }
    if code == 48 {
        // '0'
        return min(
            min(
                min(
                    to_arc(p, vec2(0.28, 0.72), r: 0.28, a0: 0.0, a1: 3.141593),
                    to_arc(p, vec2(0.28, 0.28), r: 0.28, a0: 3.141593, a1: 6.283185),
                ),
                to_segment(p, vec2(0.0, 0.28), vec2(0.0, 0.72)),
            ),
            to_segment(p, vec2(0.56, 0.28), vec2(0.56, 0.72)),
        )
    }
    if code == 49 {
        // '1'
        return min(
            min(
                to_segment(p, vec2(0.3, 0.0), vec2(0.3, 1.0)),
                to_segment(p, vec2(0.3, 1.0), vec2(0.08, 0.8)),
            ),
            to_segment(p, vec2(0.06, 0.0), vec2(0.52, 0.0)),
        )
    }
    if code == 50 {
        // '2'
        return min(
            min(
                to_arc(p, vec2(0.27, 0.72), r: 0.27, a0: -0.75, a1: 3.141593),
                to_segment(p, vec2(0.467556, 0.535958), vec2(0.0, 0.0)),
            ),
            to_segment(p, vec2(0.0, 0.0), vec2(0.56, 0.0)),
        )
    }
    if code == 51 {
        // '3'
        return min(
            to_arc(p, vec2(0.27, 0.755), r: 0.245, a0: -1.570796, a1: 2.641593),
            to_arc(p, vec2(0.27, 0.26), r: 0.26, a0: -2.641593, a1: 1.570796),
        )
    }
    if code == 52 {
        // '4'
        return min(
            min(
                to_segment(p, vec2(0.42, 0.0), vec2(0.42, 1.0)),
                to_segment(p, vec2(0.42, 1.0), vec2(0.0, 0.32)),
            ),
            to_segment(p, vec2(0.0, 0.32), vec2(0.56, 0.32)),
        )
    }
    if code == 53 {
        // '5'
        return min(
            min(
                min(
                    to_segment(p, vec2(0.52, 1.0), vec2(0.04, 1.0)),
                    to_segment(p, vec2(0.04, 1.0), vec2(0.04, 0.6)),
                ),
                to_segment(p, vec2(0.04, 0.6), vec2(0.27, 0.6)),
            ),
            to_arc(p, vec2(0.27, 0.3), r: 0.3, a0: -2.541593, a1: 1.570796),
        )
    }
    if code == 54 {
        // '6'
        return min(
            min(
                to_arc(p, vec2(0.28, 0.28), r: 0.28, a0: 0.0, a1: 6.283185),
                to_arc(p, vec2(0.6, 0.4), r: 0.6, a0: 1.822124, a1: 3.141593),
            ),
            to_segment(p, vec2(0.0, 0.4), vec2(0.0, 0.28)),
        )
    }
    if code == 55 {
        // '7'
        return min(
            to_segment(p, vec2(0.0, 1.0), vec2(0.56, 1.0)),
            to_segment(p, vec2(0.56, 1.0), vec2(0.16, 0.0)),
        )
    }
    if code == 56 {
        // '8'
        return min(
            to_arc(p, vec2(0.28, 0.76), r: 0.24, a0: 0.0, a1: 6.283185),
            to_arc(p, vec2(0.28, 0.27), r: 0.27, a0: 0.0, a1: 6.283185),
        )
    }
    if code == 57 {
        // '9'
        return min(
            min(
                to_arc(p, vec2(0.28, 0.72), r: 0.28, a0: 0.0, a1: 6.283185),
                to_arc(p, vec2(-0.04, 0.6), r: 0.6, a0: -1.319469, a1: 0.0),
            ),
            to_segment(p, vec2(0.56, 0.6), vec2(0.56, 0.72)),
        )
    }
    if code == 58 {
        // ':'
        return min(
            to_segment(p, vec2(0.0, 0.0), vec2(0.0, 0.0)),
            to_segment(p, vec2(0.0, 0.55), vec2(0.0, 0.55)),
        )
    }
    if code == 61 {
        // '='
        return min(
            to_segment(p, vec2(0.0, 0.32), vec2(0.46, 0.32)),
            to_segment(p, vec2(0.0, 0.58), vec2(0.46, 0.58)),
        )
    }
    if code == 63 {
        // '?'
        return min(
            min(
                to_arc(p, vec2(0.25, 0.75), r: 0.25, a0: -1.570796, a1: 3.141593),
                to_segment(p, vec2(0.25, 0.5), vec2(0.25, 0.3)),
            ),
            to_segment(p, vec2(0.25, 0.0), vec2(0.25, 0.0)),
        )
    }
    if code == 65 {
        // 'A'
        return min(
            min(
                to_segment(p, vec2(0.0, 0.0), vec2(0.32, 1.0)),
                to_segment(p, vec2(0.32, 1.0), vec2(0.64, 0.0)),
            ),
            to_segment(p, vec2(0.12, 0.33), vec2(0.52, 0.33)),
        )
    }
    if code == 66 {
        // 'B'
        return min(
            min(
                min(
                    min(
                        min(
                            to_segment(p, vec2(0.0, 0.0), vec2(0.0, 1.0)),
                            to_segment(p, vec2(0.0, 1.0), vec2(0.29, 1.0)),
                        ),
                        to_arc(p, vec2(0.29, 0.755), r: 0.245, a0: -1.570796, a1: 1.570796),
                    ),
                    to_segment(p, vec2(0.0, 0.51), vec2(0.31, 0.51)),
                ),
                to_arc(p, vec2(0.31, 0.255), r: 0.255, a0: -1.570796, a1: 1.570796),
            ),
            to_segment(p, vec2(0.0, 0.0), vec2(0.31, 0.0)),
        )
    }
    if code == 67 {
        // 'C'
        return min(
            min(
                to_arc(p, vec2(0.3, 0.7), r: 0.3, a0: 0.35, a1: 3.141593),
                to_segment(p, vec2(0.0, 0.3), vec2(0.0, 0.7)),
            ),
            to_arc(p, vec2(0.3, 0.3), r: 0.3, a0: 3.141593, a1: 5.933185),
        )
    }
    if code == 68 {
        // 'D'
        return min(
            min(
                min(
                    min(
                        min(
                            to_segment(p, vec2(0.0, 0.0), vec2(0.0, 1.0)),
                            to_segment(p, vec2(0.0, 1.0), vec2(0.22, 1.0)),
                        ),
                        to_arc(p, vec2(0.22, 0.62), r: 0.38, a0: 0.0, a1: 1.570796),
                    ),
                    to_segment(p, vec2(0.6, 0.38), vec2(0.6, 0.62)),
                ),
                to_arc(p, vec2(0.22, 0.38), r: 0.38, a0: -1.570796, a1: 0.0),
            ),
            to_segment(p, vec2(0.0, 0.0), vec2(0.22, 0.0)),
        )
    }
    if code == 69 {
        // 'E'
        return min(
            min(
                min(
                    to_segment(p, vec2(0.0, 0.0), vec2(0.0, 1.0)),
                    to_segment(p, vec2(0.0, 1.0), vec2(0.52, 1.0)),
                ),
                to_segment(p, vec2(0.0, 0.51), vec2(0.44, 0.51)),
            ),
            to_segment(p, vec2(0.0, 0.0), vec2(0.52, 0.0)),
        )
    }
    if code == 70 {
        // 'F'
        return min(
            min(
                to_segment(p, vec2(0.0, 0.0), vec2(0.0, 1.0)),
                to_segment(p, vec2(0.0, 1.0), vec2(0.5, 1.0)),
            ),
            to_segment(p, vec2(0.0, 0.51), vec2(0.42, 0.51)),
        )
    }
    if code == 71 {
        // 'G'
        return min(
            min(
                min(
                    min(
                        to_arc(p, vec2(0.3, 0.7), r: 0.3, a0: 0.35, a1: 3.141593),
                        to_segment(p, vec2(0.0, 0.3), vec2(0.0, 0.7)),
                    ),
                    to_arc(p, vec2(0.3, 0.3), r: 0.3, a0: 3.141593, a1: 6.283185),
                ),
                to_segment(p, vec2(0.6, 0.3), vec2(0.6, 0.46)),
            ),
            to_segment(p, vec2(0.34, 0.46), vec2(0.6, 0.46)),
        )
    }
    if code == 72 {
        // 'H'
        return min(
            min(
                to_segment(p, vec2(0.0, 0.0), vec2(0.0, 1.0)),
                to_segment(p, vec2(0.6, 0.0), vec2(0.6, 1.0)),
            ),
            to_segment(p, vec2(0.0, 0.51), vec2(0.6, 0.51)),
        )
    }
    if code == 73 {
        // 'I'
        return to_segment(p, vec2(0.0, 0.0), vec2(0.0, 1.0))
    }
    if code == 74 {
        // 'J'
        return min(
            to_segment(p, vec2(0.5, 1.0), vec2(0.5, 0.25)),
            to_arc(p, vec2(0.25, 0.25), r: 0.25, a0: 3.141593, a1: 6.283185),
        )
    }
    if code == 75 {
        // 'K'
        return min(
            min(
                to_segment(p, vec2(0.0, 0.0), vec2(0.0, 1.0)),
                to_segment(p, vec2(0.0, 0.36), vec2(0.56, 1.0)),
            ),
            to_segment(p, vec2(0.19, 0.58), vec2(0.58, 0.0)),
        )
    }
    if code == 76 {
        // 'L'
        return min(
            to_segment(p, vec2(0.0, 0.0), vec2(0.0, 1.0)),
            to_segment(p, vec2(0.0, 0.0), vec2(0.5, 0.0)),
        )
    }
    if code == 77 {
        // 'M'
        return min(
            min(
                min(
                    to_segment(p, vec2(0.0, 0.0), vec2(0.0, 1.0)),
                    to_segment(p, vec2(0.0, 1.0), vec2(0.37, 0.32)),
                ),
                to_segment(p, vec2(0.37, 0.32), vec2(0.74, 1.0)),
            ),
            to_segment(p, vec2(0.74, 1.0), vec2(0.74, 0.0)),
        )
    }
    if code == 78 {
        // 'N'
        return min(
            min(
                to_segment(p, vec2(0.0, 0.0), vec2(0.0, 1.0)),
                to_segment(p, vec2(0.0, 1.0), vec2(0.6, 0.0)),
            ),
            to_segment(p, vec2(0.6, 0.0), vec2(0.6, 1.0)),
        )
    }
    if code == 79 {
        // 'O'
        return min(
            min(
                min(
                    to_arc(p, vec2(0.31, 0.69), r: 0.31, a0: 0.0, a1: 3.141593),
                    to_arc(p, vec2(0.31, 0.31), r: 0.31, a0: 3.141593, a1: 6.283185),
                ),
                to_segment(p, vec2(0.0, 0.31), vec2(0.0, 0.69)),
            ),
            to_segment(p, vec2(0.62, 0.31), vec2(0.62, 0.69)),
        )
    }
    if code == 80 {
        // 'P'
        return min(
            min(
                min(
                    to_segment(p, vec2(0.0, 0.0), vec2(0.0, 1.0)),
                    to_segment(p, vec2(0.0, 1.0), vec2(0.28, 1.0)),
                ),
                to_arc(p, vec2(0.28, 0.745), r: 0.255, a0: -1.570796, a1: 1.570796),
            ),
            to_segment(p, vec2(0.0, 0.49), vec2(0.28, 0.49)),
        )
    }
    if code == 81 {
        // 'Q'
        return min(
            min(
                min(
                    min(
                        to_arc(p, vec2(0.31, 0.69), r: 0.31, a0: 0.0, a1: 3.141593),
                        to_arc(p, vec2(0.31, 0.31), r: 0.31, a0: 3.141593, a1: 6.283185),
                    ),
                    to_segment(p, vec2(0.0, 0.31), vec2(0.0, 0.69)),
                ),
                to_segment(p, vec2(0.62, 0.31), vec2(0.62, 0.69)),
            ),
            to_segment(p, vec2(0.38, 0.22), vec2(0.64, -0.06)),
        )
    }
    if code == 82 {
        // 'R'
        return min(
            min(
                min(
                    min(
                        to_segment(p, vec2(0.0, 0.0), vec2(0.0, 1.0)),
                        to_segment(p, vec2(0.0, 1.0), vec2(0.28, 1.0)),
                    ),
                    to_arc(p, vec2(0.28, 0.745), r: 0.255, a0: -1.570796, a1: 1.570796),
                ),
                to_segment(p, vec2(0.0, 0.49), vec2(0.28, 0.49)),
            ),
            to_segment(p, vec2(0.28, 0.49), vec2(0.56, 0.0)),
        )
    }
    if code == 83 {
        // 'S'
        return min(
            to_arc(p, vec2(0.28, 0.75), r: 0.25, a0: 0.45, a1: 4.712389),
            to_arc(p, vec2(0.28, 0.25), r: 0.25, a0: -2.691593, a1: 1.570796),
        )
    }
    if code == 84 {
        // 'T'
        return min(
            to_segment(p, vec2(0.0, 1.0), vec2(0.6, 1.0)),
            to_segment(p, vec2(0.3, 1.0), vec2(0.3, 0.0)),
        )
    }
    if code == 85 {
        // 'U'
        return min(
            min(
                to_segment(p, vec2(0.0, 1.0), vec2(0.0, 0.3)),
                to_segment(p, vec2(0.6, 1.0), vec2(0.6, 0.3)),
            ),
            to_arc(p, vec2(0.3, 0.3), r: 0.3, a0: 3.141593, a1: 6.283185),
        )
    }
    if code == 86 {
        // 'V'
        return min(
            to_segment(p, vec2(0.0, 1.0), vec2(0.31, 0.0)),
            to_segment(p, vec2(0.31, 0.0), vec2(0.62, 1.0)),
        )
    }
    if code == 87 {
        // 'W'
        return min(
            min(
                min(
                    to_segment(p, vec2(0.0, 1.0), vec2(0.2, 0.0)),
                    to_segment(p, vec2(0.2, 0.0), vec2(0.42, 0.7)),
                ),
                to_segment(p, vec2(0.42, 0.7), vec2(0.64, 0.0)),
            ),
            to_segment(p, vec2(0.64, 0.0), vec2(0.84, 1.0)),
        )
    }
    if code == 88 {
        // 'X'
        return min(
            to_segment(p, vec2(0.0, 1.0), vec2(0.6, 0.0)),
            to_segment(p, vec2(0.0, 0.0), vec2(0.6, 1.0)),
        )
    }
    if code == 89 {
        // 'Y'
        return min(
            min(
                to_segment(p, vec2(0.0, 1.0), vec2(0.31, 0.48)),
                to_segment(p, vec2(0.62, 1.0), vec2(0.31, 0.48)),
            ),
            to_segment(p, vec2(0.31, 0.48), vec2(0.31, 0.0)),
        )
    }
    if code == 90 {
        // 'Z'
        return min(
            min(
                to_segment(p, vec2(0.0, 1.0), vec2(0.58, 1.0)),
                to_segment(p, vec2(0.58, 1.0), vec2(0.0, 0.0)),
            ),
            to_segment(p, vec2(0.0, 0.0), vec2(0.58, 0.0)),
        )
    }
    1.0e9
}

/// How wide glyph `code` is between its strokes' middles (em): a space where it has none.
pub fn width(code: u32) -> f32 {
    if code == 33 {
        return 0.0
    }
    if code == 37 {
        return 0.62
    }
    if code == 39 {
        return 0.0
    }
    if code == 40 {
        return 0.22
    }
    if code == 41 {
        return 0.22
    }
    if code == 43 {
        return 0.5
    }
    if code == 44 {
        return 0.06
    }
    if code == 45 {
        return 0.38
    }
    if code == 46 {
        return 0.0
    }
    if code == 47 {
        return 0.46
    }
    if code == 48 {
        return 0.56
    }
    if code == 49 {
        return 0.56
    }
    if code == 50 {
        return 0.56
    }
    if code == 51 {
        return 0.56
    }
    if code == 52 {
        return 0.56
    }
    if code == 53 {
        return 0.56
    }
    if code == 54 {
        return 0.56
    }
    if code == 55 {
        return 0.56
    }
    if code == 56 {
        return 0.56
    }
    if code == 57 {
        return 0.56
    }
    if code == 58 {
        return 0.0
    }
    if code == 61 {
        return 0.46
    }
    if code == 63 {
        return 0.5
    }
    if code == 65 {
        return 0.64
    }
    if code == 66 {
        return 0.56
    }
    if code == 67 {
        return 0.58
    }
    if code == 68 {
        return 0.6
    }
    if code == 69 {
        return 0.52
    }
    if code == 70 {
        return 0.5
    }
    if code == 71 {
        return 0.6
    }
    if code == 72 {
        return 0.6
    }
    if code == 73 {
        return 0.0
    }
    if code == 74 {
        return 0.5
    }
    if code == 75 {
        return 0.58
    }
    if code == 76 {
        return 0.5
    }
    if code == 77 {
        return 0.74
    }
    if code == 78 {
        return 0.6
    }
    if code == 79 {
        return 0.62
    }
    if code == 80 {
        return 0.54
    }
    if code == 81 {
        return 0.62
    }
    if code == 82 {
        return 0.56
    }
    if code == 83 {
        return 0.56
    }
    if code == 84 {
        return 0.6
    }
    if code == 85 {
        return 0.6
    }
    if code == 86 {
        return 0.62
    }
    if code == 87 {
        return 0.84
    }
    if code == 88 {
        return 0.6
    }
    if code == 89 {
        return 0.62
    }
    if code == 90 {
        return 0.58
    }
    0.38
}

/// One glyph of the font: its character code (a code with no glyph is a space). A `Shape`.
pub struct Glyph: Copy + GpuData {
    pub code: u32,
}

/// How far `p` is from a segment from `a` to `b`.
fn to_segment(p: vec2, a: vec2, b: vec2) -> f32 {
    let ab = b - a
    let t = saturate(dot(p - a, ab) / max(dot(ab, ab), 1.0e-12))
    length(p - a - ab * t)
}

/// How far `p` is from an arc round `c` of radius `r`, from angle `a0` to `a1`.
fn to_arc(p: vec2, c: vec2, r: f32, a0: f32, a1: f32) -> f32 {
    let q = p - c
    let turn = 6.283185307
    var t = atan2(q.y, q.x) - a0
    t = t - turn * floor(t / turn)
    if t <= a1 - a0 {
        return abs(length(q) - r)
    }
    let e0 = c + vec2(cos(a0), sin(a0)) * r
    let e1 = c + vec2(cos(a1), sin(a1)) * r
    min(length(p - e0), length(p - e1))
}

impl Shape for Glyph {
    fn distance(self, p: vec2) -> f32 {
        strokes(self.code, p) - HALF
    }

    fn bound(self) -> Box2 {
        Box2 {
            lo: vec2(-HALF, -BELOW - HALF),
            hi: vec2(width(self.code) + HALF, 1.0 + ABOVE + HALF),
        }
    }
}

/// How far the pen moves on after glyph `code` (em).
pub fn advance(code: u32) -> f32 {
    width(code) + 2.0 * HALF + GAP
}

/// How much of the pixel whose middle is `p`, a pixel `unit` wide, a band `HALF` either side
/// of a line through `at` with unit normal `n` covers, where `p` is `v` off the line along `n`:
/// exactly, for a straight band (`covered` on each side, less the whole pixel).
fn band_of(v: f32, n: vec2, unit: f32) -> f32 {
    max(covered((HALF - v) / unit, n) + covered((HALF + v) / unit, n) - 1.0, 0.0)
}

/// How much of the pixel whose middle is `p` (em), a pixel `unit` em wide, a stroke from `a` to
/// `b` covers: across its middle, the band either side; past its ends, its round cap's edge as
/// straight across the pixel.
fn segment_cover(p: vec2, a: vec2, b: vec2, unit: f32) -> f32 {
    let ab = b - a
    let l = length(ab)
    if l < 1.0e-6 {
        let d = length(p - a)
        return covered((HALF - d) / unit, if d > 1.0e-9 { (p - a) / d } else { vec2(1.0, 0.0) })
    }
    let t = ab / l
    let n = vec2(-t.y, t.x)
    let u = dot(p - a, t)
    if u >= 0.0 && u <= l {
        return band_of(dot(p - a, n), n, unit)
    }
    let end = if u < 0.0 { a } else { b }
    let d = length(p - end)
    covered((HALF - d) / unit, (p - end) / max(d, 1.0e-9))
}

/// How much of the pixel whose middle is `p` (em), a pixel `unit` em wide, a stroke round `c` of
/// radius `r` from angle `a0` to `a1` covers: across it, the band either side of its circle
/// there; past its ends, their round caps.
fn arc_cover(p: vec2, c: vec2, r: f32, a0: f32, a1: f32, unit: f32) -> f32 {
    let q = p - c
    let turn = 6.283185307
    var t = atan2(q.y, q.x) - a0
    t = t - turn * floor(t / turn)
    let far = length(q)
    if t <= a1 - a0 {
        return band_of(far - r, q / max(far, 1.0e-9), unit)
    }
    let e0 = c + vec2(cos(a0), sin(a0)) * r
    let e1 = c + vec2(cos(a1), sin(a1)) * r
    let d0 = length(p - e0)
    let d1 = length(p - e1)
    let end = if d0 < d1 { e0 } else { e1 }
    let d = min(d0, d1)
    covered((HALF - d) / unit, (p - end) / max(d, 1.0e-9))
}

/// One of a glyph's strokes: a segment from `a` to `b`, or (`arc`) an arc round `a` of radius
/// `r` from the angle `a0` to `a1` (radians, counter-clockwise).
struct Stroke: Copy {
    arc: bool,
    a: vec2,
    b: vec2,
    r: f32,
    a0: f32,
    a1: f32,
}

