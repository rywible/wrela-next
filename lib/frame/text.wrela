/// How much of the pixel whose middle is `p` (em), a pixel `unit` em wide, glyph `code`'s
/// strokes cover: the most any one covers. One loop over the glyph's strokes, so a shader
/// writes `segment_cover` and `arc_cover` out once each, not once a stroke.
fn strokes_cover(code: u32, p: vec2, unit: f32) -> f32 {
    let at = strokes_of(code)
    var most = 0.0
    for k in 0..at.y {
        let s = stroke_at(at.x + k)
        let c = if s.arc {
            arc_cover(p, s.a, r: s.r, a0: s.a0, a1: s.a1, unit: unit)
        } else {
            segment_cover(p, s.a, s.b, unit)
        }
        most = max(most, c)
    }
    most
}

impl Glyph {
    /// How much of the pixel whose middle is `p` (em), a pixel `unit` em wide, the glyph covers:
    /// each stroke's cover exact for a straight band and its caps' edges taken as straight
    /// across the pixel, the most any one covers where they meet.
    pub fn cover(self, p: vec2, unit: f32) -> f32 {
        strokes_cover(self.code, p, unit)
    }
}

/// A glyph placed on the screen: where its baseline starts (px from the top left), a capital's
/// height (px), its code, and its colour (linear) and how much it hides what's under it.
pub struct Placed: Copy + GpuData {
    pub at: vec2,
    pub height: f32,
    pub code: u32,
    pub colour: vec4,
}

/// The most glyphs a frame draws.
pub const MOST_GLYPHS: u32 = 1024

/// The glyphs of `line` placed with its top left at `at` (px), capitals `height` px tall, in
/// `colour` (linear), onto `out` (as many as there's room for, of `MOST_GLYPHS`).
pub fn set(out: mut Vec<Placed>, line: str, at: vec2, height: f32, colour: vec3) {
    var x = at.x + HALF * height
    let base = at.y + height
    for i in 0..line.len() {
        let code = u32(line.byte(i))
        if code != 32 && out.len() < MOST_GLYPHS {
            out.push(Placed { at: vec2(x, base), height, code, colour: vec4(colour, 1.0) })
        }
        x += advance(code) * height
    }
}

/// A corner of a glyph's quad, and which glyph it is.
pub struct GlyphCorner: Copy {
    pub clip: ClipPosition,
    pub index: Flat<u32>,
}

/// A quad's corners as two triangles.
const QUAD: [u32; 6] = [0, 1, 2, 2, 1, 3]

/// Vertex `v` of glyph `i`: a corner of its bound, a pixel out, on a screen `size` px.
@vertex
pub fn glyph_corner(v: VertexIndex, i: InstanceIndex, glyphs: [Placed], size: vec2) -> GlyphCorner {
    let g = glyphs[i.index]
    let b = Glyph { code: g.code }.bound()
    let j = QUAD[v.index % 6]
    let em = vec2(if (j & 1) != 0 { b.hi.x } else { b.lo.x }, if (j & 2) != 0 { b.hi.y } else {
        b.lo.y
    })
    let out = vec2(if (j & 1) != 0 { 1.0 } else { -1.0 }, if (j & 2) != 0 { -1.0 } else { 1.0 })
    let p = g.at + vec2(em.x, -em.y) * g.height + out
    GlyphCorner {
        clip: ClipPosition {
            position: vec4(p.x / size.x * 2.0 - 1.0, 1.0 - p.y / size.y * 2.0, 0.0, 1.0),
        },
        index: Flat { value: i.index },
    }
}

/// A glyph's pixel: its colour over what's there, as much as the glyph covers the pixel; as the
/// screen takes it (`display`), or linear.
@fragment
pub fn glyph_cover(
    f: GlyphCorner,
    pixel: FragCoord,
    glyphs: [Placed],
    style: InkStyle,
    display: const bool,
) -> Over {
    let g = glyphs[f.index.value]
    let px = pixel.position.xy
    let p = vec2(px.x - g.at.x, g.at.y - px.y) / g.height
    let c = Glyph { code: g.code }.cover(p, 1.0 / g.height)
    let colour = if display { displayed(style, g.colour.xyz) } else { g.colour.xyz }
    Over { color: vec4(colour, c * g.colour.w) }
}
