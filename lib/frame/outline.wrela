// An outline from a field: where a smooth surface turns from the eye, found at a pixel from a
// value laid across a triangle from its corners and how it changes across the screen. Any lister
// whose surface is drawn as triangles (charts, heights) takes its outline's edge record from it.
//
// Near a fold outline of a smooth surface, n·v goes as the square root of the distance on the
// screen to the outline, so its square is linear in that distance, and a value laid linearly
// across a triangle from its corners is right for it: `fold_field` at each corner (n the drawn
// surface's own normal there), laid linearly, and `way_to_outline` at the pixel from the laid
// value and its screen derivatives. Its zero is the smooth form's outline, not the triangles'
// edges: a pixel between an inscribed chord and the outline gets its share through the last
// pass's neighbour's edge.

use picture::{EDGE_REACH, NO_EDGE}

/// The outline field of a surface drawn from both sides of its folds (a closed form, whose
/// triangles reach round a fold): (n·v)² unsigned. A triangle with a corner just round the back
/// of a fold has that corner on the screen inside the outline too, its distance to the outline
/// going as (n·v)² as well, so laid linearly across the triangle it stays right; signed, its zero
/// fell short of the outline inside such a triangle (docs/dead-ends.md).
pub fn fold_field(n: vec3, toward: vec3) -> f32 {
    let nv = dot(n, toward)
    nv * nv
}

/// The way from a pixel's middle to where a field falls to 0 (px, x across and y down), from
/// its value there `g` (over 0 on the surface's side) and how it changes a pixel across and down
/// (`grad`, its screen derivatives): `|g|` over its gradient's length, against the gradient where
/// `g` is over 0 and along it where it's under. `NO_EDGE` past `EDGE_REACH`, or where it doesn't
/// change.
pub fn way_to_outline(g: f32, grad: vec2) -> vec2 {
    let gg = dot(grad, grad)
    if !(gg > 1.0e-30) {
        return NO_EDGE
    }
    let e = grad * (-g / gg)
    if dot(e, e) > EDGE_REACH * EDGE_REACH {
        return NO_EDGE
    }
    e
}

@test
fn a_folds_outline_is_found_from_its_squared_facing() {
    // A limb 40 px round seen side on, quads 12.9° round: at 25.8° and 12.9° from its outline,
    // the field and the screen distance to the outline (40 (1 - cos a)) go together, so the way
    // from the nearer corner is the distance, within a tenth of a pixel.
    // (n·v at `a` from the outline is sin a; the outline is 40 (1 - cos a) px off.)
    let at = |a: f32| -> vec2 {
        vec2(fold_field(vec3(sin(a), cos(a), 0.0), vec3(1.0, 0.0, 0.0)), 40.0 * (1.0 - cos(a)))
    }
    let a = at(0.45029)
    let b = at(0.22515)
    // (Laid linearly between them, the field's change a pixel.)
    let slope = (a.x - b.x) / (a.y - b.y)
    let w = way_to_outline(b.x, vec2(slope, 0.0))
    assert(abs(length(w) - b.y) < 0.1, f"{length(w)} px against {b.y}")
}

@test
fn a_pixel_past_the_outline_has_the_way_back_to_it() {
    // A field falling 0.1 a pixel across, -0.05 at the pixel: the outline half a pixel back,
    // toward where the field grows.
    let w = way_to_outline(-0.05, vec2(0.1, 0.0))
    assert(abs(w.x - 0.5) < 1.0e-5 && w.y == 0.0, f"{w}")
    let v = way_to_outline(0.05, vec2(0.1, 0.0))
    assert(abs(v.x + 0.5) < 1.0e-5, f"{v}")
}
