// The judges: a lister's picture held against a reference of the same frame, drawn by tracing
// the forms themselves with many looks a pixel, and against itself from one moment to the next
// under a slowly turning eye. Counts in place of looking. Ported from the atoms spike's `compare`
// and `judge_pictures` (draw.wrela:895, 1011), with the frame's targets.
//
// A frame is one look of the reference. `samples` looks make a moment: each look's rays at
// another place in their pixels (Halton's points), their mean what a pixel would show if it saw
// all of itself. The eye is the moment's, and the scene turns it from moment to moment.
//
// - `compare`, once (moment `settled`, its first look, through the pixels' middles): which
//   pixels each meets, the outline, how far apart their surfaces are, and how far apart their
//   lit colours, a pixel's own and unresolved.
// - `judge_pictures`, each moment: the last pass's picture against the reference's mean, on
//   every pixel and on edge pixels (those the reference covers in part); and how often each
//   steps by more than 15/255 in brightness from the last moment (crawl), the picture and the
//   reference alike, since the reference crawls a little itself.

use air::{Air, aired}
use eye::Eye
use form::ink::InkStyle
use form::kinds::Paint
use last::{cover, displayed, painted}
use picture::{Frame, kind_of}
use std::gpu::{
    Atomics, DepthTexture, FragCoord, GlobalId, GpuBuffer, R32Uint, Rgba16Float, Rgba32Float,
    Sampler, Texture, begin_pass, begin_screen_pass, buffer_of, depth_texture, dispatch, draw, label, read,
    texture,
}
use std::io::{Pending, print}

/// Point `i` of the Halton sequence in base `base`: from 0 to 1.
pub fn halton(i: u32, base: u32) -> f32 {
    var f = 1.0
    var r = 0.0
    var n = i
    for _k in 0..16 {
        if n > 0 {
            f /= f32(base)
            r += f * f32(n % base)
            n /= base
        }
    }
    r
}

/// One look of the reference, as its `share` of a mean of many, added to the looks so far
/// (`sofar`; `first` 1: there are none); or (`cover` 1) its cover alone, white where it meets
/// something. Its alpha adds up how much of the pixel is covered.
/// (Summed in 32-bit floats: sixty-four small shares added in half floats lose 1.5/255.) Seen
/// through the scene's `air` by its own depth, as the last pass sees the picture.
@fragment
pub fn gathered(
    pixel: FragCoord,
    eye: Eye,
    air: Air,
    table: Texture<Rgba16Float>,
    s: Sampler,
    colour: Texture<Rgba16Float>,
    depth: DepthTexture,
    sofar: Texture<Rgba32Float>,
    first: u32,
    share: f32,
    cover: u32,
) -> vec4 {
    let x = u32(pixel.position.x)
    let y = u32(pixel.position.y)
    let z = depth.load(x, y)
    let met = if z > 0.0 { share } else { 0.0 }
    let c = aired(air, eye, table, s, pixel.position.xy, z, colour.load(x, y).xyz)
    let look = vec4(if cover == 1 { vec3(met) } else { c * share }, met)
    if first != 0 { look } else { sofar.load(x, y) + look }
}

/// The gathered looks, as a picture.
@fragment
pub fn settled(pixel: FragCoord, sum: Texture<Rgba32Float>) -> vec4 {
    sum.load(u32(pixel.position.x), u32(pixel.position.y))
}

/// A picture in linear light, as the screen takes it (by `style`'s tone curve).
@fragment
pub fn shown(pixel: FragCoord, picture: Texture<Rgba16Float>, style: InkStyle) -> vec4 {
    vec4(displayed(style, picture.load(u32(pixel.position.x), u32(pixel.position.y)).xyz), 1.0)
}

/// How far apart (px, across the view) two surfaces met by one pixel's ray are: their depths
/// along the view `za` and `zr` (m), the reference's normal `n`, the ray `d`.
fn apart(eye: Eye, za: f32, zr: f32, n: vec3, d: vec3) -> f32 {
    let along = dot(d, eye.forward)
    abs(za - zr) / along * abs(dot(n, d)) / (zr * eye.pixel())
}

/// How many numbers `compare` counts.
pub const COUNTS: u32 = 16

/// The picture's own pixels (its `colour`, `depth`: before the last pass) against one look of
/// the reference (`look_colour`, which holds the sky where it meets nothing; `look_normal`, the
/// way its surface faces, in `xyz`; `look_depth`), a pixel an invocation, counted into `out`:
///
///   0 pixels the reference meets            1 pixels the picture meets
///   2 the picture misses what it meets      3 the picture meets what it doesn't
///   4 the reference's outline (a met pixel beside one that isn't)
///   5 misses inside (the reference meets this pixel and the eight round it): holes
///   6..11 where both meet, how far apart: under 0.05 px, 0.1, 0.25, 0.5, 1, and over
///   12 the farthest apart (px / 1000)      13 the sum apart, each at most 4 px (px / 256)
///   14 the colours' difference, summed (of 255)
///   15 pixels whose colours differ by more than 8 of 255
@compute(8, 8)
pub fn compare<P: Paint>(
    eye: Eye,
    sky: P,
    colour: Texture<Rgba16Float>,
    depth: DepthTexture,
    look_colour: Texture<Rgba16Float>,
    look_normal: Texture<Rgba16Float>,
    look_depth: DepthTexture,
    out: mut Atomics<u32>,
    id: GlobalId,
) {
    let w = colour.width()
    let h = colour.height()
    if id.x >= w || id.y >= h {
        return
    }
    let za = depth.load(id.x, id.y)
    let zr = look_depth.load(id.x, id.y)
    let ha = za > 0.0
    let hr = zr > 0.0
    if hr {
        let _ = out.add(i: 0, value: 1)
    }
    if ha {
        let _ = out.add(i: 1, value: 1)
    }
    // The reference round this pixel: how many of its eight neighbours it meets, and whether
    // one of the four beside it isn't met.
    var met = 0
    var edge = false
    for k in 0..9 {
        let dx = i32(k % 3) - 1
        let dy = i32(k / 3) - 1
        if dx != 0 || dy != 0 {
            let nx = u32(clamp(i32(id.x) + dx, 0, i32(w) - 1))
            let ny = u32(clamp(i32(id.y) + dy, 0, i32(h) - 1))
            if look_depth.load(nx, ny) > 0.0 {
                met += 1
            } else if dx == 0 || dy == 0 {
                edge = true
            }
        }
    }
    if hr && edge {
        let _ = out.add(i: 4, value: 1)
    }
    if hr && !ha {
        let _ = out.add(i: 2, value: 1)
        if met == 8 {
            let _ = out.add(i: 5, value: 1)
        }
    }
    if ha && !hr {
        let _ = out.add(i: 3, value: 1)
    }
    let d = eye.ray(vec2(f32(id.x) + 0.5, f32(id.y) + 0.5))
    let ca = if ha { colour.load(id.x, id.y).xyz } else { painted(eye, sky, d) }
    let dc = abs(saturate(ca) - saturate(look_colour.load(id.x, id.y).xyz)) * 255.0
    let most = max(dc.x, max(dc.y, dc.z))
    let _ = out.add(i: 14, value: u32(most + 0.5))
    if most > 8.0 {
        let _ = out.add(i: 15, value: 1)
    }
    if ha && hr {
        let n = look_normal.load(id.x, id.y).xyz
        let e = apart(eye, eye.along(za), eye.along(zr), n, d)
        var bin = 11
        if e < 0.05 {
            bin = 6
        } else if e < 0.1 {
            bin = 7
        } else if e < 0.25 {
            bin = 8
        } else if e < 0.5 {
            bin = 9
        } else if e < 1.0 {
            bin = 10
        }
        let _ = out.add(i: bin, value: 1)
        let _ = out.max(i: 12, value: u32(min(e, 1000.0) * 1000.0))
        let _ = out.add(i: 13, value: u32(min(e, 4.0) * 256.0))
    }
}

/// How many numbers `judge_pictures` counts.
pub const JUDGED: u32 = 12

/// A colour's brightness as the eye weighs it.
fn luma(c: vec3) -> f32 {
    dot(saturate(c), vec3(0.2126, 0.7152, 0.0722))
}

/// Whether pixel (`x`, `y`) or one of the eight round it shows something of kind `kind`.
fn near_kind(identity: Texture<R32Uint>, depth: DepthTexture, kind: u32, x: u32, y: u32) -> bool {
    let w = i32(depth.width())
    let h = i32(depth.height())
    var near = false
    for k in 0..9 {
        let nx = u32(clamp(i32(x) + i32(k % 3) - 1, 0, w - 1))
        let ny = u32(clamp(i32(y) + i32(k / 3) - 1, 0, h - 1))
        if depth.load(nx, ny) > 0.0 && kind_of(identity.load(nx, ny)) == kind {
            near = true
        }
    }
    near
}

/// The last pass's picture against the reference's mean, and each against its own last moment
/// (`moving` 1: there is one), a pixel an invocation, added to `out` moment after moment. An
/// edge pixel is one the reference covers in part (between a fiftieth and all but a fiftieth).
///
///   0 pixels                                  1 edge pixels
///   2 the pictures' difference, summed (of 255), on every pixel     3 on edge pixels
///   4 pixels differing by more than 8 of 255                         5 of them edge pixels
///   6 pixels whose brightness steps more than 15 of 255 from the last moment, in the
///     picture                                 7 in the reference's mean
///   8 of the picture's steps, on edge pixels  9 of the reference's
///   10 pixels judged for steps               11 edge pixels judged for steps
@compute(8, 8)
pub fn judge_pictures(
    picture: Texture<Rgba16Float>,
    mean: Texture<Rgba16Float>,
    last_picture: Texture<Rgba16Float>,
    last_mean: Texture<Rgba16Float>,
    moving: u32,
    identity: Texture<R32Uint>,
    depth: DepthTexture,
    only: u32,
    out: mut Atomics<u32>,
    id: GlobalId,
) {
    if id.x >= picture.width() || id.y >= picture.height() {
        return
    }
    if only != 0 && !near_kind(identity, depth, only, id.x, id.y) {
        return
    }
    let p = picture.load(id.x, id.y)
    let m = mean.load(id.x, id.y)
    let edge = m.w > 0.02 && m.w < 0.98
    let dc = abs(saturate(p.xyz) - saturate(m.xyz)) * 255.0
    let most = max(dc.x, max(dc.y, dc.z))
    let _ = out.add(i: 0, value: 1)
    let _ = out.add(i: 2, value: u32(most + 0.5))
    if most > 8.0 {
        let _ = out.add(i: 4, value: 1)
    }
    if edge {
        let _ = out.add(i: 1, value: 1)
        let _ = out.add(i: 3, value: u32(most + 0.5))
        if most > 8.0 {
            let _ = out.add(i: 5, value: 1)
        }
    }
    if moving != 0 {
        let lm = last_mean.load(id.x, id.y)
        let was_edge = edge || (lm.w > 0.02 && lm.w < 0.98)
        let stepped = abs(luma(p.xyz) - luma(last_picture.load(id.x, id.y).xyz)) * 255.0 > 15.0
        let ref_stepped = abs(luma(m.xyz) - luma(lm.xyz)) * 255.0 > 15.0
        let _ = out.add(i: 10, value: 1)
        if stepped {
            let _ = out.add(i: 6, value: 1)
        }
        if ref_stepped {
            let _ = out.add(i: 7, value: 1)
        }
        if was_edge {
            let _ = out.add(i: 11, value: 1)
            if stepped {
                let _ = out.add(i: 8, value: 1)
            }
            if ref_stepped {
                let _ = out.add(i: 9, value: 1)
            }
        }
    }
}

/// A judge: how many looks a moment (`samples`) and moments (`moments`), the moment `compare`
/// runs at (`settled`), and its textures: one look of the reference (written by a lister's
/// reference tracer: its colour, the sky where it meets nothing; the way its surface faces; its
/// depth), the last pass's picture and the reference's mean of this moment and the last (by
/// turns), and the looks summed so far (by turns).
pub struct Judge {
    pub samples: u32,
    pub moments: u32,
    pub settled: u32,
    /// Whether cover alone is judged: the picture's (`Frame::end_into`'s `alone`: what anything
    /// drew white, nothing black) against the reference's, so an edge pixel's difference (/255)
    /// is its cover's error, whatever the colours either side of it.
    pub cover: bool,
    /// The kind of identity (`picture::SOLID` ...) whose pixels alone are judged, with the
    /// pixels round them (0: every pixel).
    pub only: u32,
    pub look_colour: Texture<Rgba16Float>,
    pub look_normal: Texture<Rgba16Float>,
    pub look_depth: DepthTexture,
    /// (`pub` on the volume spike's branch: its own pass draws the picture it is judged by.)
    pub picture_even: Texture<Rgba16Float>,
    pub picture_odd: Texture<Rgba16Float>,
    mean_even: Texture<Rgba16Float>,
    mean_odd: Texture<Rgba16Float>,
    sum_even: Texture<Rgba32Float>,
    sum_odd: Texture<Rgba32Float>,
    scores: GpuBuffer<u32>,
    differ: Option<Pending<u32>>,
    judged: Option<Pending<u32>>,
    frames: u32,
}

/// A judge of `samples` looks a moment over `moments` moments, comparing at moment `settled`;
/// of cover alone where `cover`, and only of a kind's pixels where `only` (`Judge`'s).
pub fn judge(
    samples: u32,
    moments: u32,
    settled: u32,
    cover: bool = false,
    only: u32 = 0,
) -> Judge {
    Judge {
        samples,
        moments,
        settled,
        cover,
        only,
        look_colour: texture(width: 1, height: 1),
        look_normal: texture(width: 1, height: 1),
        look_depth: depth_texture(width: 1, height: 1),
        picture_even: texture(width: 1, height: 1),
        picture_odd: texture(width: 1, height: 1),
        mean_even: texture(width: 1, height: 1),
        mean_odd: texture(width: 1, height: 1),
        sum_even: texture(width: 1, height: 1),
        sum_odd: texture(width: 1, height: 1),
        scores: buffer_of(Vec::filled(JUDGED, 0)),
        differ: None,
        judged: None,
        frames: 0,
    }
}

/// What `n` is of `of`, in parts of a hundred.
fn share(n: u32, of: u32) -> f32 {
    100.0 * f32(n) / max(f32(of), 1.0)
}

/// `compare`'s counts, said.
fn say(v: Vec<u32>) {
    let both = v[6] + v[7] + v[8] + v[9] + v[10] + v[11]
    print(
        f"judge: differ: the reference meets {v[0]} px, the picture {v[1]}; outline {v[4]} px; missed {v[2]} ({v[5]} inside), extra {v[3]}",
    )
    print(
        f"judge: differ: outline off by {f32(v[2] + v[3]) / max(f32(v[4]), 1.0)} px (mismatched pixels over the outline's length)",
    )
    print(
        f"judge: differ: apart, of {both} px: under 0.05 px {share(v[6], both)}%, 0.1 {share(v[7], both)}%, 0.25 {share(v[8], both)}%, 0.5 {share(v[9], both)}%, 1 {share(v[10], both)}%, over {share(v[11], both)}%; mean {f32(v[13]) / 256.0 / max(f32(both), 1.0)} px, most {f32(v[12]) / 1000.0} px",
    )
    print(
        f"judge: differ: lit, mean {f32(v[14]) / max(f32(v[0] + v[3]), 1.0)} of 255 a pixel met; over 8 of 255: {share(v[15], v[0] + v[3])}% of pixels met",
    )
}

/// `judge_pictures`' counts, said.
fn score(v: Vec<u32>, samples: u32, moments: u32) {
    print(
        f"judge: judged: against the reference's mean of {samples} looks, over {moments} moments: the picture differs by {f32(v[2]) / max(f32(v[0]), 1.0)} of 255 a pixel, by {f32(v[3]) / max(f32(v[1]), 1.0)} of 255 an edge pixel ({v[1]} edge pixels); over 8 of 255: {share(v[4], v[0])}% of pixels, {share(v[5], v[1])}% of edge pixels",
    )
    print(
        f"judge: judged: steps over 15 of 255 from one moment to the next, a thousand edge pixels: the picture {1000.0 * f32(v[8]) / max(f32(v[11]), 1.0)}, the reference {1000.0 * f32(v[9]) / max(f32(v[11]), 1.0)}; a thousand pixels: the picture {1000.0 * f32(v[6]) / max(f32(v[10]), 1.0)}, the reference {1000.0 * f32(v[7]) / max(f32(v[10]), 1.0)}",
    )
}

impl Judge {
    /// The counts said, once each is read back (every frame, judging or not, till they are).
    pub fn heard(mut self) {
        match mut self.differ {
            Some(p) => match p.poll() {
                Some(Ok(v)) => say(take v),
                _ => {},
            },
            None => {},
        }
        match mut self.judged {
            Some(p) => match p.poll() {
                Some(Ok(v)) => score(take v, self.samples, self.moments),
                _ => {},
            },
            None => {},
        }
    }

    /// The moment this frame is of.
    pub fn moment(self) -> u32 {
        self.frames / self.samples
    }

    /// Which look of its moment this frame is.
    pub fn look(self) -> u32 {
        self.frames % self.samples
    }

    /// Whether the judging is done: every moment judged.
    pub fn done(self) -> bool {
        self.moment() >= self.moments
    }

    /// The reference's eye this frame: `eye`, its rays moved within their pixels (the first
    /// look's through their middles).
    pub fn looking(self, eye: Eye) -> Eye {
        var out = eye
        let k = self.look()
        if k > 0 {
            out.jitter = vec2(halton(k, 2), halton(k, 3)) - vec2(0.5)
        }
        out
    }

    /// Its textures the size of `eye`'s screen.
    pub fn sized(mut self, eye: Eye) {
        let w = u32(eye.size.x)
        let h = u32(eye.size.y)
        if self.look_colour.width() == w && self.look_colour.height() == h {
            return
        }
        self.look_colour = texture(width: w, height: h)
        self.look_normal = texture(width: w, height: h)
        self.look_depth = depth_texture(width: w, height: h)
        self.picture_even = texture(width: w, height: h)
        self.picture_odd = texture(width: w, height: h)
        self.mean_even = texture(width: w, height: h)
        self.mean_odd = texture(width: w, height: h)
        self.sum_even = texture(width: w, height: h)
        self.sum_odd = texture(width: w, height: h)
    }

    /// `frame` ended into this moment's picture, with `sky` where nothing is.
    pub fn resolve<P: Paint>(mut self, frame: mut Frame, sky: P) {
        if self.moment() % 2 == 0 {
            frame.end_into(sky, mut self.picture_even, alone: self.cover)
        } else {
            frame.end_into(sky, mut self.picture_odd, alone: self.cover)
        }
    }

    /// After a frame's picture (`resolve`) and the reference's look (drawn into `look_colour`,
    /// `look_normal` and `look_depth` with the eye `looking` gave): the look added to the
    /// moment's sum; the moment's mean, once its looks are in; the comparison and the judges
    /// when due, said when read back; and the picture shown.
    pub fn after<P: Paint>(mut self, frame: Frame, sky: P) {
        let moment = self.moment()
        let look = self.look()
        let even = moment % 2 == 0
        let w = u32(frame.eye.size.x)
        let h = u32(frame.eye.size.y)
        label("judge")
        let first: u32 = if look == 0 { 1 } else { 0 }
        let part = 1.0 / f32(self.samples)
        if look % 2 == 0 {
            let p = begin_pass(mut self.sum_even, clear: vec4(0.0))
            draw(
                p,
                cover,
                gathered.bind(
                    eye: frame.eye,
                    air: frame.air,
                    table: frame.sky.table,
                    s: frame.sky.s,
                    colour: self.look_colour,
                    depth: self.look_depth,
                    sofar: self.sum_odd,
                    first: first,
                    share: part,
                    cover: if self.cover { 1 } else { 0 },
                ),
                vertices: 3,
            )
            p.end()
        } else {
            let p = begin_pass(mut self.sum_odd, clear: vec4(0.0))
            draw(
                p,
                cover,
                gathered.bind(
                    eye: frame.eye,
                    air: frame.air,
                    table: frame.sky.table,
                    s: frame.sky.s,
                    colour: self.look_colour,
                    depth: self.look_depth,
                    sofar: self.sum_even,
                    first: first,
                    share: part,
                    cover: if self.cover { 1 } else { 0 },
                ),
                vertices: 3,
            )
            p.end()
        }
        if look == self.samples - 1 {
            let p = if even { begin_pass(mut self.mean_even, clear: vec4(0.0)) } else {
                begin_pass(mut self.mean_odd, clear: vec4(0.0))
            }
            if look % 2 == 0 {
                draw(p, cover, settled.bind(sum: self.sum_even), vertices: 3)
            } else {
                draw(p, cover, settled.bind(sum: self.sum_odd), vertices: 3)
            }
            p.end()
        }
        if look == 0 && moment == self.settled {
            var out: GpuBuffer<u32> = buffer_of(Vec::filled(COUNTS, 0))
            dispatch(
                compare.bind(
                    frame.eye,
                    sky: sky,
                    colour: frame.colour,
                    depth: frame.depth,
                    look_colour: self.look_colour,
                    look_normal: self.look_normal,
                    look_depth: self.look_depth,
                    out: mut out,
                ),
                groups: ((w + 7) / 8, (h + 7) / 8, 1),
            )
            self.differ = Some(read(out.items()))
        }
        if look == self.samples - 1 && moment < self.moments {
            let moving: u32 = if moment > 0 { 1 } else { 0 }
            if even {
                dispatch(
                    judge_pictures.bind(
                        picture: self.picture_even,
                        mean: self.mean_even,
                        last_picture: self.picture_odd,
                        last_mean: self.mean_odd,
                        moving: moving,
                        identity: frame.identity,
                        depth: frame.depth,
                        only: self.only,
                        out: mut self.scores,
                    ),
                    groups: ((w + 7) / 8, (h + 7) / 8, 1),
                )
            } else {
                dispatch(
                    judge_pictures.bind(
                        picture: self.picture_odd,
                        mean: self.mean_odd,
                        last_picture: self.picture_even,
                        last_mean: self.mean_even,
                        moving: moving,
                        identity: frame.identity,
                        depth: frame.depth,
                        only: self.only,
                        out: mut self.scores,
                    ),
                    groups: ((w + 7) / 8, (h + 7) / 8, 1),
                )
            }
            if moment == self.moments - 1 {
                self.judged = Some(read(self.scores.items()))
            }
        }
        self.heard()
        label("shown")
        let screen = begin_screen_pass(clear: vec4(0.0, 0.0, 0.0, 1.0))
        if even {
            draw(
                screen,
                cover,
                shown.bind(picture: self.picture_even, style: frame.ink),
                vertices: 3,
            )
        } else {
            draw(
                screen,
                cover,
                shown.bind(picture: self.picture_odd, style: frame.ink),
                vertices: 3,
            )
        }
        screen.present()
        self.frames += 1
    }
}
