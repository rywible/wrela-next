// What holds the light off a point (docs/light.md): how much of the sky's light reaches it past
// the solids round it. Every lister lights a point through `frame::light::worn`, which asks this,
// so a form casts and takes it with nothing written for it.
//
// Each solid holds a volume of its own, in its own frame (`SIDE`³ texels over its bound and a
// margin round it): at each texel, how much of the sky is open in each of four wedges of the dome
// (`WEDGES`: a quarter of the way round each, from the horizon up), past that solid alone. The
// sky is the same all the way round the upright, so a copy turned about it, or moved, reads its
// solid's volume as it stands; a point's open sky is the product of what each copy round it
// leaves (a copy's wedges weighed by how much of each the point's face looks into). The fixed
// world's copies are found by a grid over the ground (`GRID`² cells, up to `IN_CELL` copies a
// cell whose volume reaches into it); the copies that move are listed each frame (`MOST_MOVERS`).
// What builds the volumes from a solid's cooked form is the solid lister's (lib/atoms, `held`);
// what reads them is here, and the textures are the frame's, so their handles live as long as
// the frame and every lister's light can hold them.

use std::gpu::{Rg32Uint, Rgba32Float, Rgba8, Texture3d, Texture3dHandle, texture3d}

/// A volume's texels a side, the most solids that hold one, the most copies that move, the
/// grid's cells a side and the most copies a cell lists.
pub const SIDE: u32 = 64
pub const MOST_HELD: u32 = 32
pub const MOST_MOVERS: u32 = 16
pub const GRID: u32 = 256
pub const IN_CELL: u32 = 8

/// No copy, in a cell's list.
pub const NO_COPY: u32 = 65535

/// A copy's rows: its map's three, the sphere round its cube, its solid and which copy it is
/// (the lister's count, x and y).
pub const ROWS: u32 = 5

/// The most copies the copies' table holds (its rows `ROWS_HIGH` a layer).
pub const MOST_COPIES: u32 = 4096
pub const ROWS_HIGH: u32 = 1024

/// How high over the horizon a wedge's middle is (its sine): the wedges are the dome's four
/// quarters round the upright, wedge `k` round the way `k` quarters past +x toward +z.
const WEDGE_UP: f32 = 0.5

/// What holds the light off a point, as the frame's light carries it to every pixel program.
pub struct Held: Copy + GpuData {
    /// Each solid's volume, the `k`th at layers `k SIDE` to `(k + 1) SIDE`: its four wedges.
    pub shade: Texture3dHandle<Rgba8>,
    /// Each fixed copy's rows: its map from the world to its solid's frame (three rows, x 0 to
    /// 2), the sphere round its cube in the world (row 3: middle and radius) and its solid (row
    /// 4's x); copy `c` at y `c % ROWS_HIGH`, layer `c / ROWS_HIGH`.
    pub copies: Texture3dHandle<Rgba32Float>,
    /// The grid's cells: the copies whose volumes reach into each, two to a word, `NO_COPY` past
    /// the last; a cell's eight at layers 0 and 1.
    pub grid: Texture3dHandle<Rg32Uint>,
    /// Solid `k`'s volume: its low corner in its own frame (`xyz`, m) and a texel's side (`w`).
    pub boxes: [vec4; MOST_HELD],
    /// The copies that move: mover `i`'s rows at `ROWS i` to `ROWS i + 2`, the sphere round its
    /// cube at `ROWS i + 3`, its solid and which copy it is at `ROWS i + 4`'s x and y.
    pub movers: [vec4; ROWS * MOST_MOVERS],
    /// The grid's low corner on the ground (x, z), a cell's side (m), and 1 where it is built.
    pub grid_at: vec4,
    /// How many copies move (`x`).
    pub moving: vec4,
    /// The sphere round every mover's cube (middle and radius).
    pub around: vec4,
}

/// The textures `Held` names, the frame's to keep.
pub struct HeldStore {
    pub shade: Texture3d<Rgba8>,
    pub copies: Texture3d<Rgba32Float>,
    pub grid: Texture3d<Rg32Uint>,
    /// What the frame's light carries.
    pub held: Held,
}

/// The textures, empty: no solid holds anything until its volume is built.
pub fn held_store() -> HeldStore {
    let shade = texture3d::<Rgba8>(width: SIDE, height: SIDE, depth: SIDE * MOST_HELD)
    let copies = texture3d::<Rgba32Float>(
        width: ROWS,
        height: ROWS_HIGH,
        depth: MOST_COPIES / ROWS_HIGH,
    )
    let grid = texture3d::<Rg32Uint>(width: GRID, height: GRID, depth: IN_CELL / 4)
    let held = Held {
        shade: shade.to_handle(),
        copies: copies.to_handle(),
        grid: grid.to_handle(),
        boxes: [vec4(0.0); MOST_HELD],
        movers: [vec4(0.0); ROWS * MOST_MOVERS],
        grid_at: vec4(0.0),
        moving: vec4(0.0),
        around: vec4(0.0),
    }
    HeldStore { shade, copies, grid, held }
}

/// Wedge `k`'s middle way (a unit vector).
pub fn wedge(k: u32) -> vec3 {
    let a = f32(k) * 1.5707964
    let flat = sqrt(1.0 - WEDGE_UP * WEDGE_UP)
    vec3(cos(a) * flat, WEDGE_UP, sin(a) * flat)
}

/// How much a face turned `n` looks into each wedge (both in one frame): its cosine toward the
/// wedge's middle, a little past the face's own horizon (a wedge is a quarter of the dome, so
/// some of it lies in front of a face turned a little away from its middle).
pub fn looks_into(n: vec3) -> vec4 {
    let w = |k: u32| max(dot(n, wedge(k)) + 0.35, 0.0)
    vec4(w(0), w(1), w(2), w(3))
}

/// How much of the sky a face turned `n` sees where the four wedges are open by `v` (both in one
/// frame): each wedge's open share of the part in front of the face, weighed by how much the face
/// looks into it. Every share of the sky a point is given is combined so, whoever worked it out:
/// a volume's here, a vertex's own baked share and its copy's share from the others in the
/// solid lister.
pub fn combined(v: vec4, n: vec3) -> f32 {
    let w = looks_into(n)
    let all = w.x + w.y + w.z + w.w
    if all < 1.0e-4 {
        return 0.25 * (v.x + v.y + v.z + v.w)
    }
    // (A wedge's rays behind the face are blocked by the face itself where it is this solid's,
    // whose volume is read a texel out from its surface: the face sees only the share in front
    // of it, `front`, of which the open rays are all.)
    let f = in_front(n)
    let seen = min(v / max(f, vec4(0.05)), vec4(1.0))
    dot(seen, w) / all
}

/// Solid `k`'s volume at `q` (its own frame): its four wedges' open shares, and how far in from
/// the cube's edge `q` is (0 at its outer texels to 1 past `FADE` of them in; under 0 outside).
fn volume_at(h: Held, k: u32, q: vec3) -> vec4 {
    let b = h.boxes[k]
    let at = (q - b.xyz) / b.w - vec3(0.5)
    let top = f32(SIDE - 1)
    if at.x < 0.0 || at.y < 0.0 || at.z < 0.0 || at.x >= top || at.y >= top || at.z >= top {
        return vec4(1.0)
    }
    let lo = vec3u(u32(at.x), u32(at.y), u32(at.z))
    let f = at - vec3(f32(lo.x), f32(lo.y), f32(lo.z))
    let z0 = lo.z + k * SIDE
    let shade = h.shade
    let x00 = mix(shade.load(lo.x, lo.y, z0), shade.load(lo.x + 1, lo.y, z0), vec4(f.x))
    let x10 = mix(shade.load(lo.x, lo.y + 1, z0), shade.load(lo.x + 1, lo.y + 1, z0), vec4(f.x))
    let x01 = mix(shade.load(lo.x, lo.y, z0 + 1), shade.load(lo.x + 1, lo.y, z0 + 1), vec4(f.x))
    let x11 = mix(
        shade.load(lo.x, lo.y + 1, z0 + 1),
        shade.load(lo.x + 1, lo.y + 1, z0 + 1),
        vec4(f.x),
    )
    let v = mix(mix(x00, x10, vec4(f.y)), mix(x01, x11, vec4(f.y)), vec4(f.z))
    // (Faded to open over the cube's outer `FADE` texels, so where a copy's cube ends no seam
    // shows on what lies round it.)
    let rim = min(min(at, vec3(top) - at), vec3(FADE))
    let fade = min(rim.x, min(rim.y, rim.z)) / FADE
    mix(vec4(1.0), v, vec4(fade))
}

/// How much of the sky a face at `q` turned `n` (both in solid `k`'s frame) sees past solid `k`
/// alone, from its volume: 1 outside it.
fn seen_past(h: Held, k: u32, q: vec3, n: vec3) -> f32 {
    // (A texel off the face, so the face's own texels, half inside it, don't darken it.)
    combined(volume_at(h, k, q + n * h.boxes[k].w), n)
}

/// Over how many texels of its cube's edge a volume fades to open sky.
const FADE: f32 = 4.0

/// About how much of each wedge lies in front of a face turned `n`: all of each for a face
/// turned up, half of those either side of one turned flat, none of the one behind it.
pub fn in_front(n: vec3) -> vec4 {
    let f = |k: u32| saturate(0.5 + 0.58 * dot(n, wedge(k)) + 0.5 * n.y)
    vec4(f(0), f(1), f(2), f(3))
}

/// How much of the sky a face at `p` turned `n` (the world's) sees past a copy whose map to its
/// solid's frame has rows `r0`, `r1`, `r2`, of solid `k`.
fn seen_past_copy(h: Held, r0: vec4, r1: vec4, r2: vec4, k: u32, p: vec3, n: vec3) -> f32 {
    let q = vec3(dot(r0.xyz, p) + r0.w, dot(r1.xyz, p) + r1.w, dot(r2.xyz, p) + r2.w)
    // (The normal carried as a way: right for a copy turned and scaled evenly, near for one
    // stretched.)
    let m = vec3(dot(r0.xyz, n), dot(r1.xyz, n), dot(r2.xyz, n))
    let l = length(m)
    if l < 1.0e-8 {
        return 1.0
    }
    seen_past(h, k, q, m / l)
}

/// The four wedges (the world's) open at `p` (the world's) past a copy whose map to its solid's
/// frame has rows `r0`, `r1`, `r2`, of solid `k`: its volume's wedges there, each of the world's
/// read between the copy's two nearest it round the upright (the same wedges where the copy is
/// turned by quarters).
fn open_past_copy(h: Held, r0: vec4, r1: vec4, r2: vec4, k: u32, p: vec3) -> vec4 {
    let q = vec3(dot(r0.xyz, p) + r0.w, dot(r1.xyz, p) + r1.w, dot(r2.xyz, p) + r2.w)
    let v = volume_at(h, k, q)
    let turned = |j: u32| {
        let d = wedge(j)
        let m = vec3(dot(r0.xyz, d), dot(r1.xyz, d), dot(r2.xyz, d))
        let flat = m.xz / max(length(m.xz), 1.0e-8)
        let u = max(vec4(flat.x, flat.y, -flat.x, -flat.y), vec4(0.0))
        dot(u, v) / max(u.x + u.y + u.z + u.w, 1.0e-8)
    }
    vec4(turned(0), turned(1), turned(2), turned(3))
}

/// The four wedges (the world's) open at `p` (the world's) past the fixed world's copies round it,
/// all but copy `skip`: each wedge the product of what each copy leaves of it. What a copy is
/// given once of the others' shade (the solid lister's `shared`), a point's face then taking it as
/// `combined` takes any share.
pub fn open_past_fixed(h: Held, p: vec3, skip: u32) -> vec4 {
    var s = vec4(1.0)
    if h.grid_at.w > 0.5 {
        let c = (p.xz - h.grid_at.xy) / h.grid_at.z
        if c.x >= 0.0 && c.y >= 0.0 && c.x < f32(GRID) && c.y < f32(GRID) {
            let cx = u32(c.x)
            let cy = u32(c.y)
            for layer in 0..IN_CELL / 4 {
                let words = h.grid.load(cx, cy, layer)
                for half in 0..4 {
                    let word = if half < 2 { words.x } else { words.y }
                    let id = (word >> (16 * (half % 2))) & 65535
                    if id != NO_COPY && id != skip {
                        let y = id % ROWS_HIGH
                        let z = id / ROWS_HIGH
                        let ball = h.copies.load(3, y, z)
                        let o = p - ball.xyz
                        if dot(o, o) < ball.w * ball.w {
                            let r0 = h.copies.load(0, y, z)
                            let r1 = h.copies.load(1, y, z)
                            let r2 = h.copies.load(2, y, z)
                            let k = u32(h.copies.load(4, y, z).x)
                            s *= open_past_copy(h, r0, r1, r2, k, p)
                        }
                    }
                }
            }
        }
    }
    s
}

/// How much of the sky reaches a face at `p` turned `n` (the world's) past the copies that move,
/// all but copy `skip` (`NO_COPY` for none).
pub fn movers_seen(h: Held, p: vec3, n: vec3, skip: u32) -> f32 {
    var s = 1.0
    let o = p - h.around.xyz
    if dot(o, o) < h.around.w * h.around.w {
        for i in 0..MOST_MOVERS {
            if f32(i) >= h.moving.x {
                break
            }
            let ball = h.movers[ROWS * i + 3]
            let oi = p - ball.xyz
            let id = h.movers[ROWS * i + 4]
            if dot(oi, oi) < ball.w * ball.w && u32(id.y) != skip {
                let r = ROWS * i
                s *= seen_past_copy(h, h.movers[r], h.movers[r + 1], h.movers[r + 2], u32(id.x), p, n)
            }
        }
    }
    s
}

/// How much of the sky's light reaches a face at `p` turned `n` (the world's): 1 open, 0 none,
/// as the solids round it leave it, all but copy `skip`.
pub fn sky_seen(h: Held, p: vec3, n: vec3, skip: u32 = NO_COPY) -> f32 {
    var s = 1.0
    if h.grid_at.w > 0.5 {
        let c = (p.xz - h.grid_at.xy) / h.grid_at.z
        if c.x >= 0.0 && c.y >= 0.0 && c.x < f32(GRID) && c.y < f32(GRID) {
            let cx = u32(c.x)
            let cy = u32(c.y)
            for layer in 0..IN_CELL / 4 {
                let words = h.grid.load(cx, cy, layer)
                for half in 0..4 {
                    let word = if half < 2 { words.x } else { words.y }
                    let id = (word >> (16 * (half % 2))) & 65535
                    if id != NO_COPY && id != skip {
                        let y = id % ROWS_HIGH
                        let z = id / ROWS_HIGH
                        let ball = h.copies.load(3, y, z)
                        let o = p - ball.xyz
                        if dot(o, o) < ball.w * ball.w {
                            let r0 = h.copies.load(0, y, z)
                            let r1 = h.copies.load(1, y, z)
                            let r2 = h.copies.load(2, y, z)
                            let k = u32(h.copies.load(4, y, z).x)
                            s *= seen_past_copy(h, r0, r1, r2, k, p, n)
                        }
                    }
                }
            }
        }
    }
    s * movers_seen(h, p, n, skip)
}

/// The sphere round the cube `b` (its low corner and texel's side) of a copy carried to the
/// world by `m`: its middle and radius.
pub fn ball_of(m: mat4, b: vec4) -> vec4 {
    let side = b.w * f32(SIDE)
    let middle = (m * vec4(b.xyz + vec3(0.5 * side), 1.0)).xyz
    let stretch = max(length(m[0].xyz), max(length(m[1].xyz), length(m[2].xyz)))
    vec4(middle, 0.8660254 * side * stretch)
}
