// The load: work for nothing beside the frame. The M4 lowers its GPU clock under a light load,
// and a light frame then reads up to four times slow (docs/dead-ends.md, "Measuring"); a pass
// that keeps the GPU busy keeps the clock up while the frame's own passes are timed. From the
// atoms spike's `burn` (draw.wrela:407).

use std::gpu::FragCoord

/// `rounds` sines a pixel.
@fragment
pub fn burn(pixel: FragCoord, rounds: u32) -> vec4 {
    var x = pixel.position.x * 0.001 + pixel.position.y * 0.002
    for _i in 0..rounds {
        x = sin(x * 1.7 + 0.3) + cos(x * 0.9)
    }
    vec4(x, 0.0, 0.0, 1.0)
}
