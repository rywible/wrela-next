// The sun's reach past a cloud layer: how much of the sun's beam reaches a point under it
// (docs/light.md). The frame marches the layer toward the sun from each place of a map on the
// ground, from the same field its dome is marched from (`sky::SkyTable`, made with the dome, in
// bands, held with it: the old engine's cloud shadow map, rywible/wrela 7ae6711e,
// engine/sky.wrela:1003-1049); a point over the ground reads the map where the sun's way through
// it meets the sea's level. Every lister's light reads it through `frame::light::worn`, so a
// scene with a cloud layer gets its shadow with nothing written for it.

use air::Air
use std::gpu::{GlobalId, R32Float, Rgba16Float, Sampler, Texels, Texels3d, Texture, Texture3d, Texture3dHandle}
use std::math::PI

/// The map's texels a side and the span it covers round its middle (m).
pub const SHADE_SIDE: u32 = 1024
pub const SHADE_SPAN: f32 = 32000.0
pub const SHADE_BLOCK: u32 = 8
const DEBUG_DARK: bool = false

/// The sun's reach past a cloud layer as every pixel program reads it: the map (`SHADE_SIDE`
/// a side, one layer), its middle on the ground (x, z), its span (m) and its state (`at.w`: 0, no
/// cloud layer: the sun reaches everything; 1, whole; 2, not yet whole), the way to the sun and
/// what a point reads off the map or while it isn't whole (`sun.w`).
pub struct SunShade: Copy + GpuData {
    pub map: Texture3dHandle<R32Float>,
    /// The most of the map over each block of `SHADE_BLOCK` texels a side and a texel round it:
    /// a point under a block the sun reaches nowhere reads it alone.
    pub coarse: Texture3dHandle<R32Float>,
    pub at: vec4,
    pub sun: vec4,
}

/// How much of the sun's beam reaches `p` (m, the world's) past the cloud layer, 0 to 1: the map
/// read (bilinearly, four loads) where the sun's way through `p` meets the sea's level.
pub fn through_clouds(s: SunShade, p: vec3) -> f32 {
    if DEBUG_DARK { return 0.0 }
    if s.at.w == 0.0 {
        return 1.0
    }
    if s.at.w > 1.5 {
        return s.sun.w
    }
    let q = vec2(p.x, p.z) - vec2(s.sun.x, s.sun.z) * (p.y / max(s.sun.y, 0.05))
    let uv = (q - s.at.xy) / s.at.z + vec2(0.5)
    if uv.x <= 0.0 || uv.y <= 0.0 || uv.x >= 1.0 || uv.y >= 1.0 {
        return s.sun.w
    }
    let n = f32(SHADE_SIDE)
    let t = uv * n - vec2(0.5)
    let i = floor(t)
    let f = t - i
    let top = n - 1.0
    let x0 = u32(clamp(i.x, 0.0, top))
    let y0 = u32(clamp(i.y, 0.0, top))
    if s.coarse.load(x0 / SHADE_BLOCK, y0 / SHADE_BLOCK, 0) <= 0.0 {
        return 0.0
    }
    let x1 = u32(clamp(i.x + 1.0, 0.0, top))
    let y1 = u32(clamp(i.y + 1.0, 0.0, top))
    let a = mix(s.map.load(x0, y0, 0), s.map.load(x1, y0, 0), f.x)
    let b = mix(s.map.load(x0, y1, 0), s.map.load(x1, y1, 0), f.x)
    mix(a, b, f.y)
}

/// Texel `id` of the map's coarse copy: the most of `map` over its block and a texel round it.
@compute(8, 8)
pub fn shade_coarse(map: Texture3d<R32Float>, out: mut Texels3d<R32Float>, id: GlobalId) {
    let n = SHADE_SIDE / SHADE_BLOCK
    if id.x >= n || id.y >= n {
        return
    }
    var most = 0.0
    for dy in 0..SHADE_BLOCK + 2 {
        for dx in 0..SHADE_BLOCK + 2 {
            let x = clamp(i32(id.x * SHADE_BLOCK + dx) - 1, 0, i32(SHADE_SIDE) - 1)
            let y = clamp(i32(id.y * SHADE_BLOCK + dy) - 1, 0, i32(SHADE_SIDE) - 1)
            most = max(most, map.load(u32(x), u32(y), 0))
        }
    }
    out.store(id, most)
}

/// The sun's light scattered toward the eye by the air along a view ray, where the cloud layer
/// lets the sun in: what a frame's last pass adds (`light` the sun's light on the air, 0 for
/// none, `w` 1 where it is; `scatter` how many times the frame's high haze's own density
/// scatters it, `low` its low haze's (spray over the water, which glows where the sun falls on
/// it); `g` its forward lobe, and `even` of its light scattered evenly every way instead; a ray that meets nothing gathers it `reach` m at most, and no
/// higher than `ceiling` m, where the clouds' layer begins: past it the map says nothing). The
/// frame holds it in a map of directions (`air_lit`), marched from the clouds' map of the sun.
pub struct SunAir: Copy + GpuData {
    pub light: vec4,
    pub scatter: f32,
    pub g: f32,
    pub reach: f32,
    pub ceiling: f32,
    pub low: f32,
    pub even: f32,
    pub spare1: f32,
    pub spare2: f32,
}

/// No light on the air.
pub const NO_SUN_AIR = SunAir {
    light: vec4(0.0),
    scatter: 0.0,
    g: 0.0,
    reach: 0.0,
    ceiling: 0.0,
    low: 0.0,
    even: 0.5,
    spare1: 0.0,
    spare2: 0.0,
}

/// The sun's light on the air as the last pass reads it from the frame's map: its light (`w` 1
/// where the map is whole), and how far a ray that meets nothing gathers it (`reach`, `ceiling`).
pub struct AirSeen: Copy + GpuData {
    pub light: vec4,
    pub reach: f32,
    pub ceiling: f32,
    pub spare0: f32,
    pub spare1: f32,
}

/// How far a ray from `eye` along `d` (a unit vector) that meets nothing gathers the air's light:
/// `reach` m along it, or to where it rises through `ceiling`.
fn sky_end(reach: f32, ceiling: f32, eye: vec3, d: vec3) -> f32 {
    var t = reach
    if d.y > 1.0e-4 {
        t = min(t, max(ceiling - eye.y, 0.0) / d.y)
    }
    t
}

// ---- held: the sun's light on the air, in a map of directions -------------------------------

/// The map of the sun's light on the air: the sphere of ways folded onto a square (octahedrally:
/// no trigonometry to find a way's texel, which at every pixel of the last pass cost 0.39 ms at
/// 3840x2160 where an elevation and azimuth's map was read), `AIR_SIDE` texels a side; the
/// distances along a ray it holds the light gathered to (m: `x`, `y`, `z`; `w` to the ray's end);
/// how many steps each stretch is marched in; and how many rows a frame marches.
pub const AIR_SIDE: u32 = 512
const AIR_AT = vec3(150.0, 700.0, 3000.0)
const AIR_STEPS = vec4(8.0, 12.0, 16.0, 28.0)
pub const AIR_ROWS: u32 = 16

/// Where the way `d` (a unit vector) is in the map (Engelhardt and Dachsbacher's octahedral map).
pub fn on_air(d: vec3) -> vec2 {
    let p = d / (abs(d.x) + abs(d.y) + abs(d.z))
    var q = vec2(p.x, p.z)
    if p.y < 0.0 {
        q = (vec2(1.0) - abs(vec2(p.z, p.x))) * vec2(if p.x >= 0.0 { 1.0 } else { -1.0 }, if p.z >= 0.0 { 1.0 } else { -1.0 })
    }
    q * 0.5 + vec2(0.5)
}

/// The way through the map's texel `t` (its middle).
fn air_way(t: vec2u) -> vec3 {
    let q = (vec2(f32(t.x), f32(t.y)) + vec2(0.5)) / f32(AIR_SIDE) * 2.0 - vec2(1.0)
    let y = 1.0 - abs(q.x) - abs(q.y)
    var xz = q
    if y < 0.0 {
        xz = (vec2(1.0) - abs(vec2(q.y, q.x))) * vec2(if q.x >= 0.0 { 1.0 } else { -1.0 }, if q.y >= 0.0 { 1.0 } else { -1.0 })
    }
    normalize(vec3(xz.x, y, xz.y))
}

/// How far a ray from `eye` along `d` is marched: to `sky_end`, or where it meets the sea's level.
pub fn ray_end(reach: f32, ceiling: f32, eye: vec3, d: vec3) -> f32 {
    if d.y < -1.0e-4 {
        return min(max(eye.y, 0.0) / -d.y, reach)
    }
    sky_end(reach, ceiling, eye, d)
}

/// The air's light gathered along `d` from `eye` between `a` and `b` m, `n` steps moved `jitter`:
/// its sum (`x`, unlit: the sun's light, its phase and colour are the reader's) and the air's
/// optical depth so far (`y`, carried in).
fn gathered(s: SunAir, shade: SunShade, air: Air, eye: vec3, d: vec3, a: f32, b: f32, n: f32, jitter: f32, depth: f32) -> vec2 {
    var sum = 0.0
    var od = depth
    if b <= a {
        return vec2(0.0, od)
    }
    let dt = (b - a) / n
    for k in 0..min(u32(n), 32) {
        let p = eye + d * (a + dt * (f32(k) + jitter))
        let h = max(p.y, 0.0)
        let low = air.thick * exp(-h / air.scale)
        let high = air.high * exp(-h / air.high_scale)
        sum += (low * s.low + high * s.scatter) * exp(-od) * through_clouds(shade, p) * dt
        od += (low + high) * dt
    }
    vec2(sum, od)
}

/// Texel `id` of a band of the map's rows (`AIR_ROWS` tall), its row `from` down the map and short
/// of `to`: the sun's light the air gathers along its
/// way from `eye`, to each of `AIR_AT` and to the ray's end (each the sum from the eye).
@compute(8, 8)
pub fn air_lit(s: SunAir, shade: SunShade, air: Air, eye: vec3, from: u32, to: u32, out: mut Texels<Rgba16Float>, id: GlobalId) {
    let row = from + id.y
    if id.x >= AIR_SIDE || row >= to {
        return
    }
    let t = vec2u(id.x, row)
    let d = air_way(t)
    let end = ray_end(s.reach, s.ceiling, eye, d)
    let j = fract(52.9829189 * fract(0.06711056 * f32(t.x) + 0.00583715 * f32(t.y)))
    let a = min(AIR_AT.x, end)
    let b = min(AIR_AT.y, end)
    let c = min(AIR_AT.z, end)
    let g0 = gathered(s, shade, air, eye, d, 0.0, a, AIR_STEPS.x, j, 0.0)
    let g1 = gathered(s, shade, air, eye, d, a, b, AIR_STEPS.y, j, g0.y)
    let g2 = gathered(s, shade, air, eye, d, b, c, AIR_STEPS.z, j, g1.y)
    let g3 = gathered(s, shade, air, eye, d, c, end, AIR_STEPS.w, j, g2.y)
    // (Its phase, the same all along the way: Henyey and Greenstein's forward lobe, `even` of it
    // even every way instead.)
    let k = dot(d, shade.sun.xyz)
    let g = s.g
    let phase = (s.even + (1.0 - s.even) * (1.0 - g * g) / pow(max(1.0 + g * g - 2.0 * g * k, 1.0e-4), 1.5)) / (4.0 * PI)
    let s1 = g0.x
    let s2 = s1 + g1.x
    let s3 = s2 + g2.x
    out.store(id, vec4(s1, s2, s3, s3 + g3.x) * phase)
}

/// The sun's light the air scatters toward the eye along `d`, to what the ray meets `t` m off (0:
/// nothing), as the frame's map holds it (`map`, read through `smp`), lit as `a` says.
pub fn air_seen(a: AirSeen, map: Texture<Rgba16Float>, smp: Sampler, eye: vec3, d: vec3, t: f32) -> vec3 {
    let v = map.sample_level(smp, on_air(d), 0.0)
    let end = ray_end(a.reach, a.ceiling, eye, d)
    let at = if t <= 0.0 { end } else { min(t, end) }
    // (Piecewise straight between the distances it holds, each no farther than the ray's end.)
    let da = min(AIR_AT.x, end)
    let db = min(AIR_AT.y, end)
    let dc = min(AIR_AT.z, end)
    var sum = v.w
    if at < da {
        sum = v.x * at / max(da, 1.0e-3)
    } else if at < db {
        sum = mix(v.x, v.y, (at - da) / max(db - da, 1.0e-3))
    } else if at < dc {
        sum = mix(v.y, v.z, (at - db) / max(dc - db, 1.0e-3))
    } else {
        sum = mix(v.z, v.w, saturate((at - dc) / max(end - dc, 1.0e-3)))
    }
    a.light.xyz * max(sum, 0.0)
}
