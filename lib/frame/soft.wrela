// Soft things laid over the picture (docs/frame.md, "Soft things"): mediums now, far strands
// later. A soft thing has no surface to write into the picture's targets, so it is drawn into a
// target of its own, smaller than the picture (a texel each `scale` × `scale` pixels), a layer
// for each soft thing in a frame. A texel holds what the thing lays over the ray through its
// middle: its light (linear, premultiplied) and how much of what is behind it it hides; and
// where along that ray the light comes from, as a ramp: none of it nearer than `centre - half`
// (m along the ray), all of it past `centre + half`, evenly between (the light's first two
// moments along the ray, matched).
//
// After the last pass, in the same pass to the screen and before the text, each layer is drawn
// as a rectangle over the screen it covers, the farthest first (`laid`): at each pixel it reads
// the four texels round it, takes from each the share of its ramp nearer than the surface the
// pixel shows (its depth, at full size), and lays itself over what the screen holds as a layer
// of paint is laid over an inked cel: its colour (its light over its cover, through the screen's
// tone curve, on the paper) by its cover. So a soft thing behind a fighter lays nothing on him,
// one in front of him lays itself whole, and neither bleeds across his outline; and pixels it
// doesn't cover pay nothing. (Read inside the last pass, the same reads cost the whole pass
// 0.74 ms more at 4K, 0.34 of it with one small layer: every pixel paid for the code.)

use eye::Eye
use form::ink::InkStyle
use last::displayed
use moment::Moment
use std::gpu::{
    Address, Blend, ClipPosition, RenderPass, DepthTexture, Filter, FragCoord, InstanceIndex,
    R16Float, Rgba16Float, Sampler, Texture, TextureArray, VertexIndex, draw, sampler,
    writable_texture_array,
}

/// The most soft things a frame lays over.
pub const MOST_SOFT: u32 = 4

/// The soft things' targets and what a frame has claimed of them: their light and cover
/// (`colour`), their ramps (`ramp`: `x` the centre and `y` the half width, m along the ray),
/// a layer each; how many pixels across a texel is; and, for each layer claimed this frame, the
/// rectangle of the screen it covers (px: x0, y0, x1, y1) and how far off it is (m: the
/// farther is laid first).
pub struct Soft {
    pub colour: TextureArray<Rgba16Float>,
    pub ramp: TextureArray<Rgba16Float>,
    pub scale: u32,
    /// How the last pass reads them: between texels, clamped at the edges.
    pub s: Sampler,
    /// Whether the last pass reads each texel whole whatever the pixel's depth (the plain
    /// scaling up, with no ramp: a break, to show the judge fails).
    pub plain: bool,
    rects: [vec4; MOST_SOFT],
    far: [f32; MOST_SOFT],
    count: u32,
    width: u32,
    height: u32,
}

/// What the last pass reads of the soft things: each layer's rectangle (px), in the order they
/// are laid (the farthest first), and which layer it is (`order`); how many; how many pixels
/// across a texel is; and whether the ramps are read (1) or each texel taken whole (0).
pub struct SoftSeen: Copy + GpuData {
    pub rects: [vec4; MOST_SOFT],
    pub order: vec4,
    pub count: u32,
    pub scale: f32,
    pub ramped: u32,
    pub spare: f32,
}

/// The soft things' targets, a texel each `scale` × `scale` pixels, before any frame.
pub fn soft(scale: u32) -> Soft {
    Soft {
        colour: writable_texture_array::<Rgba16Float>(width: 1, height: 1, layers: MOST_SOFT),
        ramp: writable_texture_array::<Rgba16Float>(width: 1, height: 1, layers: MOST_SOFT),
        scale,
        s: sampler(filter: Filter::Linear, address: Address::Clamp, mip: Filter::Nearest),
        plain: false,
        rects: [vec4(0.0); MOST_SOFT],
        far: [0.0; MOST_SOFT],
        count: 0,
        width: 0,
        height: 0,
    }
}

/// How many texels a side of `n` pixels takes at `scale` pixels a texel.
pub fn texels(n: u32, scale: u32) -> u32 {
    (n + scale - 1) / scale
}

impl Soft {
    /// A frame begun on a `width` × `height` screen: nothing claimed, the targets sized to it.
    pub fn begin(mut self, width: u32, height: u32) {
        let w = texels(width, self.scale)
        let h = texels(height, self.scale)
        if w != self.width || h != self.height {
            self.colour = writable_texture_array::<Rgba16Float>(
                width: w,
                height: h,
                layers: MOST_SOFT,
            )
            self.ramp = writable_texture_array::<Rgba16Float>(
                width: w,
                height: h,
                layers: MOST_SOFT,
            )
            self.width = w
            self.height = h
        }
        self.count = 0
    }

    /// The targets' size (texels).
    pub fn size(self) -> vec2 {
        vec2(f32(self.width), f32(self.height))
    }

    /// A layer for a soft thing this frame, over `rect` of the screen (px: x0, y0, x1, y1), `far`
    /// m off: its number, or `MOST_SOFT` when every layer is taken (it isn't drawn).
    pub fn claim(mut self, rect: vec4, far: f32) -> u32 {
        if self.count >= MOST_SOFT {
            return MOST_SOFT
        }
        let i = self.count
        self.rects[i] = rect
        self.far[i] = far
        self.count += 1
        i
    }

    /// What the last pass reads: the layers claimed, the farthest first.
    pub fn seen(self) -> SoftSeen {
        var order = vec4(0.0)
        var rects = [vec4(0.0); MOST_SOFT]
        var taken = [false; MOST_SOFT]
        for k in 0..self.count {
            var best = MOST_SOFT
            for i in 0..self.count {
                if !taken[i] && (best == MOST_SOFT || self.far[i] > self.far[best]) {
                    best = i
                }
            }
            taken[best] = true
            order[k] = f32(best)
            rects[k] = self.rects[best]
        }
        SoftSeen {
            rects,
            order,
            count: self.count,
            scale: f32(self.scale),
            ramped: if self.plain { 0 } else { 1 },
            spare: 0.0,
        }
    }
}

impl Soft {
    /// The layers claimed this frame laid over what `pass` (the screen's, after the last pass)
    /// holds, the farthest first, each over its own rectangle: as paint on the screen's values
    /// (`display`), or in linear light. None in an impact frame (`moment` past `ink.impact`),
    /// which is two values.
    pub fn lay<P: RenderPass>(
        self,
        pass: P,
        eye: Eye,
        ink: InkStyle,
        moment: Moment,
        depth: DepthTexture,
        paper: Texture<R16Float>,
        display: bool,
    ) {
        if self.count == 0 || moment.kinetic > ink.impact {
            return
        }
        let seen = self.seen()
        let corner = soft_corner.bind(seen: seen, size: eye.size)
        if display {
            draw(
                pass,
                corner,
                laid.bind(
                    eye,
                    style: ink,
                    seen: seen,
                    colour: self.colour,
                    ramp: self.ramp,
                    s: self.s,
                    depth: depth,
                    paper: paper,
                    display: true,
                ),
                vertices: 6,
                instances: self.count,
                blend: Blend::Premultiplied,
            )
        } else {
            draw(
                pass,
                corner,
                laid.bind(
                    eye,
                    style: ink,
                    seen: seen,
                    colour: self.colour,
                    ramp: self.ramp,
                    s: self.s,
                    depth: depth,
                    paper: paper,
                    display: false,
                ),
                vertices: 6,
                instances: self.count,
                blend: Blend::Premultiplied,
            )
        }
    }
}

/// The share of a ramp (`r`: `x` its centre, `y` its half width, m along the ray) nearer than
/// `far` m along the ray.
pub fn ramped(r: vec4, far: f32) -> f32 {
    let w = 2.0 * r.y
    if w < 1.0e-4 {
        return if far >= r.x { 1.0 } else { 0.0 }
    }
    saturate((far - (r.x - r.y)) / w)
}

/// How far along its ray (m) the surface pixel `px` shows is, from its depth `z` (reversed): as
/// far as a ray goes where nothing is (0).
pub fn far_along(eye: Eye, px: vec2, z: f32) -> f32 {
    if z <= 0.0 {
        return 1.0e9
    }
    eye.along(z) / max(dot(eye.ray(px), eye.forward), 1.0e-6)
}

/// What the soft layer laid `k`th (the farthest first) lays over pixel `px` (its middle, px)
/// whose surface is `far` m along its ray: its light (linear, premultiplied) and how much of what
/// is behind it hides, read between the four texels round the pixel, each texel's share nearer
/// than `far`. Most pixels need one read: where the four are empty, or the surface is past all
/// four ramps, the plain bilinear read (`s`) is the answer; the ramps are two gathers, and only
/// where a ramp cuts are the four read alone. Nothing outside the layer's rectangle.
pub fn layer_over(
    seen: SoftSeen,
    k: u32,
    colour: TextureArray<Rgba16Float>,
    ramp: TextureArray<Rgba16Float>,
    s: Sampler,
    px: vec2,
    far: f32,
) -> vec4 {
    let r = seen.rects[k]
    if px.x < r.x || px.y < r.y || px.x >= r.z || px.y >= r.w {
        return vec4(0.0)
    }
    let size = vec2(f32(colour.width()), f32(colour.height()))
    let uv = px / (seen.scale * size)
    let layer = u32(seen.order[k])
    var sum = colour.sample_level(s, uv, layer, 0.0)
    if seen.ramped != 0 && (sum.w > 0.0 || sum.x + sum.y + sum.z > 0.0) {
        // The four ramps, in a gather's order: (i, j+1), (i+1, j+1), (i+1, j), (i, j).
        let centre = ramp.gather(s, uv, layer, component: 0)
        let half = ramp.gather(s, uv, layer, component: 1)
        let shares = vec4(
            ramped(vec4(centre.x, half.x, 0.0, 0.0), far),
            ramped(vec4(centre.y, half.y, 0.0, 0.0), far),
            ramped(vec4(centre.z, half.z, 0.0, 0.0), far),
            ramped(vec4(centre.w, half.w, 0.0, 0.0), far),
        )
        if min(min(shares.x, shares.y), min(shares.z, shares.w)) < 1.0 {
            let q = px / seen.scale - vec2(0.5)
            let base = floor(q)
            let f = q - base
            let w = i32(size.x)
            let h = i32(size.y)
            let x0 = u32(clamp(i32(base.x), 0, w - 1))
            let x1 = u32(clamp(i32(base.x) + 1, 0, w - 1))
            let y0 = u32(clamp(i32(base.y), 0, h - 1))
            let y1 = u32(clamp(i32(base.y) + 1, 0, h - 1))
            sum = colour.load(x0, y1, layer) * (shares.x * (1.0 - f.x) * f.y) +
                colour.load(x1, y1, layer) * (shares.y * f.x * f.y) +
                colour.load(x1, y0, layer) * (shares.z * f.x * (1.0 - f.y)) +
                colour.load(x0, y0, layer) * (shares.w * (1.0 - f.x) * (1.0 - f.y))
        }
    }
    sum
}

/// What all the soft layers lay over pixel `px` (linear, premultiplied), each over the ones
/// farther: for the judges, which see them all at once.
pub fn soft_over(
    seen: SoftSeen,
    colour: TextureArray<Rgba16Float>,
    ramp: TextureArray<Rgba16Float>,
    s: Sampler,
    px: vec2,
    far: f32,
) -> vec4 {
    var out = vec4(0.0)
    for k in 0..MOST_SOFT {
        if k >= seen.count {
            break
        }
        let c = layer_over(seen, k, colour, ramp, s, px, far)
        out = c + out * (1.0 - c.w)
    }
    out
}

/// A layer's light and cover `c` (linear, premultiplied) as paint on the screen: its colour
/// (its light over its cover, through the tone curve `style` gives, on the paper `paper`) times
/// its cover, and its cover; what the screen's premultiplied blend lays over its values.
pub fn as_paint(style: InkStyle, c: vec4, paper: f32) -> vec4 {
    if c.w <= 1.0e-5 {
        return vec4(0.0)
    }
    vec4(displayed(style, c.xyz / c.w) * (paper * c.w), c.w)
}

/// A corner of a soft layer's rectangle, and which it is in the order laid.
pub struct Laid: Copy {
    pub clip: ClipPosition,
    pub k: f32,
}

/// Corner `v` of the `i`th layer's rectangle (the farthest first), on a screen `size` px.
@vertex
pub fn soft_corner(v: VertexIndex, i: InstanceIndex, seen: SoftSeen, size: vec2) -> Laid {
    let r = seen.rects[i.index]
    let c = if v.index == 0 { 0 } else if v.index == 1 || v.index == 4 { 1 } else if v.index == 2 ||
        v.index == 3 { 2 } else { 3 }
    let px = vec2(if (c & 1) == 0 { r.x } else { r.z }, if (c & 2) == 0 { r.y } else { r.w })
    Laid {
        clip: ClipPosition {
            position: vec4(px.x / size.x * 2.0 - 1.0, 1.0 - px.y / size.y * 2.0, 0.0, 1.0),
        },
        k: f32(i.index),
    }
}

/// A soft layer's pixel, laid over the screen by the premultiplied blend: as paint on the
/// screen's values (`display`), or in linear light for the judges.
@fragment
pub fn laid(
    f: Laid,
    pixel: FragCoord,
    eye: Eye,
    style: InkStyle,
    seen: SoftSeen,
    colour: TextureArray<Rgba16Float>,
    ramp: TextureArray<Rgba16Float>,
    s: Sampler,
    depth: DepthTexture,
    paper: Texture<R16Float>,
    display: const bool,
) -> vec4 {
    let px = pixel.position.xy
    let x = u32(px.x)
    let y = u32(px.y)
    let c = layer_over(
        seen,
        u32(f.k + 0.5),
        colour,
        ramp,
        s,
        px,
        far_along(eye, px, depth.load(x, y)),
    )
    if display {
        return as_paint(style, c, paper.load(x, y))
    }
    c
}
