// Humanoids on a rig: one skeleton named by VRM 1.0's humanoid bones
// (github.com/vrm-c/vrm-specification, `VRMC_vrm-1.0/humanoid.md`), clips of motion on it, poses,
// and a pose's palette. Carried from rywible/wrela's engine/humanoid.wrela at 7ae6711e, cut to
// what plays a body: the readers of glTF and BVH files, the import of a skinned mesh and the
// retargeting of takes stay behind (what they made is written out as literals where it's used).
//
// - A looped clip's last frame is its first again, a stride further on.
// - Posing (`Clip::pose`) and the palette (`palette`) run on the CPU: 52 bones are a few
//   microseconds a frame.

use std::collections::Vec

/// No bone.
pub const NONE: u32 = 4294967295

/// VRM 1.0's humanoid bones, each parent before its children.
pub const BONES: [Text; 55] = [
    "hips",
    "spine",
    "chest",
    "upperChest",
    "neck",
    "head",
    "jaw",
    "leftEye",
    "rightEye",
    "leftUpperLeg",
    "leftLowerLeg",
    "leftFoot",
    "leftToes",
    "rightUpperLeg",
    "rightLowerLeg",
    "rightFoot",
    "rightToes",
    "leftShoulder",
    "leftUpperArm",
    "leftLowerArm",
    "leftHand",
    "rightShoulder",
    "rightUpperArm",
    "rightLowerArm",
    "rightHand",
    "leftThumbMetacarpal",
    "leftThumbProximal",
    "leftThumbDistal",
    "leftIndexProximal",
    "leftIndexIntermediate",
    "leftIndexDistal",
    "leftMiddleProximal",
    "leftMiddleIntermediate",
    "leftMiddleDistal",
    "leftRingProximal",
    "leftRingIntermediate",
    "leftRingDistal",
    "leftLittleProximal",
    "leftLittleIntermediate",
    "leftLittleDistal",
    "rightThumbMetacarpal",
    "rightThumbProximal",
    "rightThumbDistal",
    "rightIndexProximal",
    "rightIndexIntermediate",
    "rightIndexDistal",
    "rightMiddleProximal",
    "rightMiddleIntermediate",
    "rightMiddleDistal",
    "rightRingProximal",
    "rightRingIntermediate",
    "rightRingDistal",
    "rightLittleProximal",
    "rightLittleIntermediate",
    "rightLittleDistal",
]

/// The bone named `name` (VRM's), or `NONE`.
pub fn bone(name: str) -> u32 {
    for i in 0..55 {
        if BONES[i] == name {
            return i
        }
    }
    NONE
}

/// Unreal's mannequin names (Quaternius's Universal Base Characters and Universal Animation

// ---- rigid transforms ------------------------------------------------------------------

/// A rotation then a translation: how a bone sits in its parent, or in the world.
pub struct Rigid: Copy {
    pub q: Quat,
    pub t: vec3,
}

impl Rigid {
    pub fn identity() -> Rigid {
        Rigid { q: Quat::identity(), t: vec3(0.0) }
    }

    /// `self` after `b`: `b`'s frame placed in `self`'s.
    pub fn then(self, b: Rigid) -> Rigid {
        Rigid { q: self.q.mul(b.q), t: self.t + self.q.rotate(b.t) }
    }

    /// The opposite transform.
    pub fn inverse(self) -> Rigid {
        let qi = self.q.inverse()
        Rigid { q: qi, t: -qi.rotate(self.t) }
    }

    pub fn matrix(self) -> mat4 {
        let m = self.q.to_mat3()
        mat4(vec4(m[0], 0.0), vec4(m[1], 0.0), vec4(m[2], 0.0), vec4(self.t, 1.0))
    }
}

/// A body's bones in the body's space, to read and to set: a `Vec<Rigid>`, or a `[Rigid; 64]`.
/// Code that poses a body is written once over either. The array is the one a derivation
/// follows (`std::lift::gradient`, as `wrela solve` runs it): it can't follow values kept in a
/// `Vec`, so a pose made in one comes out with no derivative by the literals it was made from.
pub trait Frames {
    fn frame(self, b: u32) -> Rigid
    fn set_frame(mut self, b: u32, r: Rigid)
}

impl Frames for Vec<Rigid> {
    fn frame(self, b: u32) -> Rigid {
        self[b]
    }

    fn set_frame(mut self, b: u32, r: Rigid) {
        self[b] = r
    }
}

impl Frames for [Rigid; 64] {
    fn frame(self, b: u32) -> Rigid {
        self[b]
    }

    fn set_frame(mut self, b: u32, r: Rigid) {
        self[b] = r
    }
}

/// The shortest turn taking direction `a` onto `b` (both nonzero).
pub fn arc(a: vec3, b: vec3) -> Quat {
    let (u, v) = (normalize(a), normalize(b))
    let d = dot(u, v)
    if d > 0.999999 {
        return Quat::identity()
    }
    if d < -0.999999 {
        let side = if abs(u.x) < 0.9 { vec3(1.0, 0.0, 0.0) } else { vec3(0.0, 1.0, 0.0) }
        return Quat::axis_angle(cross(u, side), 3.14159265)
    }
    Quat { v: normalize(vec4(cross(u, v), 1.0 + d)) }
}

// ---- the rig and its mesh -----------------------------------------------------------------

/// A bone of a rig: which VRM bone it is, its parent in the rig (`NONE` for the hips), where it
/// sits in its parent at rest, and its inverse bind matrix (the mesh's space to its own).
pub struct RigBone: Copy {
    pub vrm: u32,
    pub parent: u32,
    pub rest: Rigid,
    pub ibm: mat4,
}

/// A rig: its bones (each after its parent), each VRM bone's place among them (`NONE` where it
/// has none), and where the hips' parent sits in the body's space.
pub struct Rig: Clone {
    pub bones: Vec<RigBone>,
    pub of: [u32; 55],
    pub base: Rigid,
}

impl Rig {
    /// The rig's bone for VRM bone `name`, or `NONE`.
    pub fn find(self, name: str) -> u32 {
        let v = bone(name)
        if v == NONE { NONE } else { self.of[v] }
    }

    /// Each bone in the body's space, at rest.
    pub fn rest_world(self) -> Vec<Rigid> {
        var out: Vec<Rigid> = Vec::with_capacity(self.bones.len())
        for b in 0..self.bones.len() {
            let p = self.bones[b].parent
            let up = if p == NONE { self.base } else { out[p] }
            out.push(up.then(self.bones[b].rest))
        }
        out
    }

    /// `rest_world` in an array (a bone the rig lacks unturned at the origin): what code a
    /// derivation follows reads. A derived function takes no float out of a `Vec`, so it's
    /// handed the rest pose as a value (`Frames`).
    pub fn rest_frames(self) -> [Rigid; 64] {
        var out = [Rigid::identity(); 64]
        for b in 0..self.bones.len() {
            let p = self.bones[b].parent
            let up = if p == NONE { self.base } else { out[p] }
            out[b] = up.then(self.bones[b].rest)
        }
        out
    }

    /// Each bone's parent, in an array (as `rest_frames`): `NONE` for the hips and past the
    /// rig's last bone.
    pub fn parents(self) -> [u32; 64] {
        var out = [NONE; 64]
        for b in 0..self.bones.len() {
            out[b] = self.bones[b].parent
        }
        out
    }

    /// Each bone's place in its parent at rest, in an array (as `rest_frames`).
    pub fn rests(self) -> [Rigid; 64] {
        var out = [Rigid::identity(); 64]
        for b in 0..self.bones.len() {
            out[b] = self.bones[b].rest
        }
        out
    }
}

/// The bones whose turn about their own length a skin spreads along them (`SPREAD_TO`, each its
/// child: where it's reached whole), as a charted limb does (`chart::Chain::spread`):
/// an upper arm twisted to keep its elbow's hinge turns its skin a little at the shoulder and
/// more toward the elbow, rather than all at once where the shoulder's weights meet the arm's
/// (which wrings the shoulder and draws the arm flat); and a forearm's roll from its elbow to its
/// wrist, as a person's forearm turns along its length (`motion::keys::posed` gives it what a
/// whole twist above would turn the hand by), rather than all at the elbow.
pub const SPREAD: [Text; 4] = ["leftUpperArm", "rightUpperArm", "leftLowerArm", "rightLowerArm"]
pub const SPREAD_TO: [Text; 4] = ["leftLowerArm", "rightLowerArm", "leftHand", "rightHand"]

/// How many steps of a spread bone's twist its skin is bound to besides the bone itself: at 0
/// and half its turn about its length (`twist_slot`). (Two: four bones' steps fit beside a
/// body's 52 bones and its tint in the 64 slots of a palette.)
pub const TWIST_STEPS: u32 = 2

/// The palette's slot for step `k` (`TWIST_STEPS`) of spread bone `s` (`SPREAD`) on `rig`:
/// after its bones.
pub fn twist_slot(rig: Rig, s: u32, k: u32) -> u32 {
    rig.bones.len() + s * TWIST_STEPS + k
}

/// The bone a palette slot moves with: its own, or a twist step's bone (`NONE` for a slot that
/// is neither).
pub fn slot_bone(rig: Rig, slot: u32) -> u32 {
    let n = rig.bones.len()
    if slot < n {
        slot
    } else if slot < twist_slot(rig, SPREAD.len(), 0) {
        rig.find(SPREAD[(slot - n) / TWIST_STEPS])
    } else { NONE }
}

/// `d`, a bone's turn from its rest (in its own frame), with only `share` of its turn about
/// `axis` (its length, in its frame): the swing whole, the twist in part.
pub fn twisted_by(d: Quat, axis: vec3, share: f32) -> Quat {
    let along = axis * dot(d.v.xyz, axis)
    let raw = vec4(along, d.v.w)
    let twist = if length(raw) < 1.0e-6 { Quat::identity() } else {
        Quat { v: raw / length(raw) }
    }
    let swing = d.mul(twist.inverse())
    swing.mul(Quat::identity().nlerp(twist, share))
}

/// A clip on a rig: its frames a second, its frames, every frame's local turn of each of the
/// rig's bones (a frame's bones in order), its hips' translation in their parent, and for a
/// looped clip how far it travels a loop (the body's space: a walk's stride pair).
pub struct Clip: Clone {
    pub fps: f32,
    pub frames: u32,
    pub bones: u32,
    pub turns: Vec<Quat>,
    pub hips: Vec<vec3>,
    pub looped: bool,
    pub travel: vec3,
    /// Its travel in the hips' parent's space.
    pub travel_local: vec3,
}

/// The direction from VRM bone `v` toward what it aims at, at rest: from `pos` (each bone's
/// place by VRM bone, `NONE`'s skipped) and where it has none, `end` (its own end site, in the

/// Each bone in the body's space in frame `f` of `turns` (a frame's bones in order), the hips
/// at `hips` (the body's space).
pub fn frame_world(rig: Rig, turns: [Quat], f: u32, hips: vec3) -> Vec<Rigid> {
    let nb = rig.bones.len()
    var out: Vec<Rigid> = Vec::filled(nb, Rigid::identity())
    for b in 0..nb {
        borrow rb = rig.bones[b]
        let q = turns[f * nb + b]
        if rb.parent == NONE {
            out[b] = Rigid { q: rig.base.q.mul(q), t: hips }
        } else {
            out[b] = out[rb.parent].then(Rigid { q, t: rb.rest.t })
        }
    }
    out
}

/// Each bone of `pose` in the body's space, in an array (`frame_world` of one pose, which a
/// derivation follows: `Frames`).
pub fn pose_world(rig: Rig, pose: Pose) -> [Rigid; 64] {
    let rest = rig.rests()
    let parents = rig.parents()
    var out = [Rigid::identity(); 64]
    for b in 0..rig.bones.len() {
        let up = parents[b]
        let q = pose.turns[b]
        if up == NONE {
            out[b] = Rigid { q: rig.base.q.mul(q), t: rig.base.t + rig.base.q.rotate(pose.hips) }
        } else {
            out[b] = out[up].then(Rigid { q, t: rest[b].t })
        }
    }
    out
}

/// A rig's rest pose as a clip of one frame: the bind pose (a T-pose for Quaternius's bodies).
pub fn rest_clip(rig: Rig) -> Clip {
    var turns: Vec<Quat> = Vec::new()
    for b in rig.bones {
        turns.push(b.rest.q)
    }
    Clip {
        fps: 30.0,
        frames: 1,
        bones: rig.bones.len(),
        turns,
        hips: Vec::from([rig.bones[0].rest.t]),
        looped: false,
        travel: vec3(0.0),
        travel_local: vec3(0.0),
    }
}

/// A pose: each bone's local turn, and the hips' translation in their parent.
pub struct Pose: Copy {
    pub turns: [Quat; 64],
    pub hips: vec3,
}

impl Clip {
    /// How long one play of it lasts (s): from its first frame to its last.
    pub fn length(self) -> f32 {
        f32(max(self.frames, 2) - 1) / self.fps
    }

    /// Its pose at `time` (s): looped, a loop further on each time round (its travel added; a
    /// loop back before 0); else held at its first frame before 0 and its last after its end.
    pub fn pose(self, time: f32) -> Pose {
        var p = Pose { turns: [Quat::identity(); 64], hips: vec3(0.0) }
        if self.frames == 1 {
            for b in 0..self.bones {
                p.turns[b] = self.turns[b]
            }
            p.hips = self.hips[0]
            return p
        }
        let span = f32(self.frames - 1)
        var x = time * self.fps
        var loops = 0.0
        if self.looped {
            loops = floor(x / span)
            x = x - loops * span
        } else {
            x = clamp(x, 0.0, span)
        }
        let i = min(u32(x), self.frames - 2)
        let f = x - f32(i)
        let nb = self.bones
        for b in 0..nb {
            p.turns[b] = self.turns[i * nb + b].nlerp(self.turns[(i + 1) * nb + b], f)
        }
        p.hips = mix(self.hips[i], self.hips[i + 1], vec3(f)) + self.travel_local * loops
        p
    }

    /// `pose`, but between frames along a Catmull-Rom curve through the frames either side: a clip
    /// keyed sparsely (a 30 fps one-off shown at 60) turns smoothly through each frame instead of
    /// kinking at it, which shows as a jolt in a fast limb.
    pub fn smooth_pose(self, time: f32) -> Pose {
        if self.frames < 3 {
            return self.pose(time)
        }
        let last = self.frames - 1
        let span = f32(last)
        var x = time * self.fps
        var loops = 0.0
        if self.looped {
            loops = floor(x / span)
            x = x - loops * span
        } else {
            x = clamp(x, 0.0, span)
        }
        let i = min(u32(x), last - 1)
        let f = x - f32(i)
        // The frames before and after: round a loop (whose last frame is its first, a travel on),
        // or held at a one-off's ends.
        var h = 0
        var h_shift = vec3(0.0)
        if i > 0 {
            h = i - 1
        } else if self.looped {
            h = last - 1
            h_shift = -self.travel_local
        }
        var j = last
        var j_shift = vec3(0.0)
        if i + 2 <= last {
            j = i + 2
        } else if self.looped {
            j = 1
            j_shift = self.travel_local
        }
        let (f2, f3) = (f * f, f * f * f)
        let w0 = 0.5 * (-f3 + 2.0 * f2 - f)
        let w1 = 0.5 * (3.0 * f3 - 5.0 * f2 + 2.0)
        let w2 = 0.5 * (-3.0 * f3 + 4.0 * f2 + f)
        let w3 = 0.5 * (f3 - f2)
        var p = Pose { turns: [Quat::identity(); 64], hips: vec3(0.0) }
        let nb = self.bones
        for b in 0..nb {
            let q1 = self.turns[i * nb + b].v
            var q0 = self.turns[h * nb + b].v
            var q2 = self.turns[(i + 1) * nb + b].v
            if dot(q0, q1) < 0.0 {
                q0 = -q0
            }
            if dot(q2, q1) < 0.0 {
                q2 = -q2
            }
            var q3 = self.turns[j * nb + b].v
            if dot(q3, q2) < 0.0 {
                q3 = -q3
            }
            let m = q0 * w0 + q1 * w1 + q2 * w2 + q3 * w3
            let l = length(m)
            p.turns[b] = if l > 0.0 { Quat { v: m / l } } else { Quat { v: q1 } }
        }
        p.hips = (self.hips[h] + h_shift) * w0 +
            self.hips[i] * w1 +
            self.hips[i + 1] * w2 +
            (self.hips[j] + j_shift) * w3 +
            self.travel_local * loops
        p
    }
}

/// A pose's palette: each bone's matrix from the mesh's space at rest to the world, the body
/// placed by `place` (its feet's spot and its heading). The bones past the rig's are `place`.
pub fn palette(rig: Rig, pose: Pose, place: mat4) -> [mat4; 64] {
    var out = [place; 64]
    var world = [Rigid::identity(); 64]
    for b in 0..rig.bones.len() {
        borrow rb = rig.bones[b]
        let up = if rb.parent == NONE { rig.base } else { world[rb.parent] }
        let t = if rb.parent == NONE { pose.hips } else { rb.rest.t }
        world[b] = up.then(Rigid { q: pose.turns[b], t })
        out[b] = place * world[b].matrix() * rb.ibm
    }
    // Each spread bone's twist steps: its swing whole and its twist in part (`SPREAD`).
    if twist_slot(rig, SPREAD.len(), 0) < 63 {
        for s in 0..SPREAD.len() {
            let (b, c) = (rig.find(SPREAD[s]), rig.find(SPREAD_TO[s]))
            if b == NONE || c == NONE {
                continue
            }
            borrow rb = rig.bones[b]
            let up = if rb.parent == NONE { rig.base } else { world[rb.parent] }
            let axis = normalize(rig.bones[c].rest.t)
            let d = rb.rest.q.inverse().mul(pose.turns[b])
            for k in 0..TWIST_STEPS {
                let share = f32(k) / f32(TWIST_STEPS)
                let q = rb.rest.q.mul(twisted_by(d, axis, share))
                let at = up.then(Rigid { q, t: rb.rest.t })
                out[twist_slot(rig, s, k)] = place * at.matrix() * rb.ibm
            }
        }
    }
    out
}
