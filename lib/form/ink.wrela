/// No ink: every line's weight 0, so nothing is drawn, and the rest as `KINETIC_INK_LINES`.
pub const NO_LINES = InkStyle {
    outline: 0.0,
    fold_weight: 0.0,
    crease: 0.0,
    seam: 0.0,
    fleck_line: 2.0,
    ..KINETIC_INK_LINES,
}

/// The painted look's (`form::shade::PAINTED`): no line, and a print, not a page: no paper's
/// tooth, the vignette kept. The rest as `KINETIC_INK_LINES` (the tone curve, an impact frame's).
pub const PAINTED_LINES = InkStyle {
    tooth_floor: 1.0,
    tooth_gain: 0.0,
    ..NO_LINES,
}
