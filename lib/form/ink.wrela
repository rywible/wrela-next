// The ink's numbers (docs/design.md, "The picture"): the pen, its strands and flecks, the weight of
// a line by what made it, the ink's colour, the palette's drain toward manga's values as a
// moment turns kinetic, the impact frame, and the paper's finish. Beside the shading's (`shade`'s
// `Style`): the one shading function takes those, the frame's last pass these.
//
// `KINETIC_INK_LINES` is the ink drawn today, its numbers carried exactly: `rywible/wrela` at
// 7ae6711e, content/humanoid/ink.wrela, by line (other files named). Lengths in pixels are at 720
// lines: the last pass scales them by the screen's height over 720 (ink.wrela:206), so a line is
// as wide a share of the picture at any size.

/// The ink's style. (Fields are in the order that packs them for the GPU.)
pub struct InkStyle: Copy + GpuData {
    /// What's dark (a form's display luma under `dark`, `dark_soft`): its line is pale
    /// (`pale_quiet`, `pale_loud`), it takes no strands or flecks. The ink quiet is the form's
    /// own colour deepened (its square times `deepen`); loud it's the palette's ink times
    /// `loud`, as the energy passes `loud_from` (`loud_soft`). A striking limb's line stays dark
    /// past energy `striking` (`striking_soft`).
    pub pale_quiet: vec3,
    pub dark: f32,
    pub pale_loud: vec3,
    pub dark_soft: f32,
    /// The finish's grade's tints, with their numbers (`exposure`, below, says what they are).
    pub shade_tint: vec3,
    pub split_low: f32,
    pub light_tint: vec3,
    pub split_high: f32,
    pub slate: vec3,
    pub drain: f32,
    pub deepen: f32,
    pub loud: f32,
    pub loud_from: f32,
    pub loud_soft: f32,
    pub striking: f32,
    pub striking_soft: f32,
    /// The palette: ink and paper (display values, as today's ink pass uses them).
    pub ink: vec3,
    pub drain_from: f32,
    pub paper: vec3,
    pub drain_soft: f32,
    /// The pen's radius (px at 720 lines): `base`, wobbling by a noise over `wob_cells` px,
    /// `wob` of it quiet and `wob_energy` more as the line is energetic, and swelling by `swell`
    /// of itself at full energy: `base + (wob + wob_energy·E)·(noise - 0.5)`, times `1 + swell·E`.
    /// The noise moves `boil` cells a drawing, so the line boils on the drawings.
    pub base: f32,
    pub wob: f32,
    pub wob_energy: f32,
    pub swell: f32,
    pub wob_cells: f32,
    pub boil: f32,
    /// Drawings a second: the boil's seed counts them (anime's twos, twelve a second).
    pub drawings: f32,
    /// The lines on which the pen's sizes are given (the screen's height over it scales them).
    pub lines: f32,
    /// Each stroke is drawn where a hand that doesn't quite find the edge puts it: shoved by a
    /// noise over `wander_cells` px, `shove · (1 + shove_energy·E)` px times `shove_quiet +
    /// shove_loud·E` for the first strand, and `1 + k` for strand k.
    pub wander_cells: f32,
    pub shove: f32,
    pub shove_energy: f32,
    pub shove_quiet: f32,
    pub shove_loud: f32,
    /// How many strands when energetic, each lifted in as the energy passes `strand_from +
    /// strand_step·k` (`strand_soft` either side), at `strand_pen` of the pen and `strand_ink`
    /// of the first's darkness.
    pub strands: u32,
    pub strand_from: f32,
    pub strand_step: f32,
    pub strand_soft: f32,
    pub strand_pen: f32,
    pub strand_ink: f32,
    /// Gaps: each strand breaks where a noise over `gap_cells` px passes `1 - gap_energy·E`
    /// (`gap_soft`), once the energy passes `gap_from` (`gap_from_soft`).
    pub gap_cells: f32,
    pub gap_energy: f32,
    pub gap_soft: f32,
    pub gap_from: f32,
    pub gap_from_soft: f32,
    /// Kinetic, the ink commits: a line is there or isn't, past `commit` (`commit_soft`), as the
    /// energy passes `commit_from` (`commit_from_soft`).
    pub commit: f32,
    pub commit_soft: f32,
    pub commit_from: f32,
    pub commit_from_soft: f32,
    /// Flecks thrown off a line: one in a cell `fleck_cells` px a side where a hash passes `1 -
    /// fleck_energy·E` (`fleck_soft`), past energy `fleck_from` (`fleck_from_soft`), within
    /// `fleck_reach` pens of a line at least `fleck_line` strong (`fleck_line_soft`); a dash
    /// `fleck_wide` px across (`fleck_wide_soft`) and `fleck_long` px along (`fleck_long_soft`).
    pub fleck_cells: f32,
    pub fleck_energy: f32,
    pub fleck_soft: f32,
    pub fleck_from: f32,
    pub fleck_from_soft: f32,
    pub fleck_reach: f32,
    pub fleck_line: f32,
    pub fleck_line_soft: f32,
    pub fleck_wide: f32,
    pub fleck_wide_soft: f32,
    pub fleck_long: f32,
    pub fleck_long_soft: f32,
    /// A line's weight by what made it: a form's outline against another or nothing, one part of
    /// a form folded in front of another (by `fold` in log2 of depth, `fold_soft` of it either
    /// side), a crease (by how far its faces turn, `1 - na·nb`, past `crease_turn`, `crease_soft`
    /// either side), and the look's line field's seam. Each is today's body weight (0.75,
    /// fighter.wrela:817) times what ink.wrela gives that kind of line.
    pub outline: f32,
    pub fold_weight: f32,
    pub fold: f32,
    pub fold_soft: f32,
    pub crease: f32,
    pub crease_turn: f32,
    pub crease_soft: f32,
    pub seam: f32,
    /// The drain toward manga's three values as the frame's kinetic passes `drain_from`
    /// (`drain_soft`): the value (`luma^value_power`) cut at `low` and `high` (`tone_soft`); the
    /// darkest `dark_ink` of the ink, the middle `mid` of the way from it to `mid_paper` of the
    /// paper.
    pub value_power: f32,
    pub low: f32,
    pub high: f32,
    pub tone_soft: f32,
    pub dark_ink: f32,
    pub mid: f32,
    pub mid_paper: f32,
    /// Energy: the frame's kinetic, felt `focus` px round where the strongest blow lands
    /// (`focus_soft`); a striker's own along its striking limb, `limb` m round the force's line
    /// (`limb_soft`), from `limb_from` of the way along it (rising over `limb_rise`); and a
    /// line `local` as energetic as a stroke beside it.
    pub focus: f32,
    pub focus_soft: f32,
    pub limb: f32,
    pub limb_soft: f32,
    pub limb_from: f32,
    pub limb_rise: f32,
    pub local: f32,
    /// The impact frame: past `impact` kinetic the picture is two values, the striker solid ink
    /// (`impact_black` of the ink) and the rest paper; a margin of paper `margin + margin_near·
    /// near` px round the striker on any other body; one clean outline `pen + pen_near·near` px,
    /// heavy where the blow lands (`near` falls over `near_px`, `near_soft`); folds near it
    /// (`fold_near`, `fold_near_soft`); a line drawn past `impact_line` (`impact_line_soft`).
    pub impact: f32,
    pub impact_black: f32,
    pub margin: f32,
    pub margin_near: f32,
    pub pen: f32,
    pub pen_near: f32,
    pub near_px: f32,
    pub near_soft: f32,
    pub fold_near: f32,
    pub fold_near_soft: f32,
    pub impact_line: f32,
    pub impact_line_soft: f32,
    /// The paper's tooth: two noises over `tooth_fine` and `tooth_coarse` px, `tooth_mix` of the
    /// fine, the picture `tooth_floor + tooth_gain·tooth` as bright; and its vignette, `1 -
    /// vignette · |uv · (1, vignette_tall)|^vignette_power`.
    pub tooth_fine: f32,
    pub tooth_coarse: f32,
    pub tooth_mix: f32,
    pub tooth_floor: f32,
    pub tooth_gain: f32,
    pub vignette: f32,
    pub vignette_tall: f32,
    pub vignette_power: f32,
    /// The tone curve: linear light `c / (1 + shoulder·c)`, then the power `1/gamma`.
    pub shoulder: f32,
    pub gamma: f32,
    /// The finish (docs/frame.md, "The last pass"): the light times `exposure`, then the tone
    /// curve: `film` 0 the soft shoulder above; 1 a filmic curve with a toe (Narkowicz's fit of
    /// ACES), `film_hue` of it taken on the light's luminance with its hue kept, the lights past
    /// white washed toward white and far past it burnt white, then sRGB (the old opening's clean
    /// look, rywible/wrela 7ae6711e, scenes/opening/ink.wrela:16-33). Then graded on the screen's
    /// values (ink.wrela:670-690, 759-766): the shade tinted `shade_tint` and the light
    /// `light_tint` (between luma `split_low` and `split_high`), the colour's saturation times
    /// `saturation`, the middle tones pulled apart by `contrast` (a smoothstep's S mixed in),
    /// drained `drain` toward grey and tinted `slate`, the darks pressed by `press` (to none at
    /// luma `press_to`). Today's ink has none of it: exposure 1, the soft shoulder, no grade.
    pub exposure: f32,
    pub film: f32,
    pub film_hue: f32,
    pub saturation: f32,
    pub contrast: f32,
    pub press: f32,
    pub press_to: f32,
    /// The glow round what's brightest: `glow` of the light past `glow_knee` (after exposure)
    /// spread round it (0: none, and its passes don't run).
    pub glow: f32,
    pub glow_knee: f32,
}

/// Today's body weight: every fighter's line is this heavy (fighter.wrela:817).
const BODY = 0.75

