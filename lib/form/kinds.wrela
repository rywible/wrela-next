// The six kinds of form (docs/design.md, "Forms"). What a form is a function of says how it is
// drawn. Each kind is one function an author writes, with a box that holds it, stated or derived,
// where it has one. Every kind is `Copy + GpuData`: its numbers are plain data, so one form runs
// on the CPU and reaches the GPU as a uniform.

use std::derive::{Box2, Box3, Interval, interval}
use std::field::Surface
use std::hash::StateHash

/// A point, to a distance: negative inside, positive outside. Rocks, buildings, land.
///
/// It is the language's own `std::field::Surface` under the design's name: a trait set, so it
/// is not a second trait. Every std surface and combinator is a solid, and std's measures,
/// checks and derivations take a solid as they are. A set can't be implemented, so a solid is
/// written `impl Surface for T`: `distance`, and `bound`, the sphere it lies in.
pub trait Solid = Surface

/// Two numbers, to a point: a place on the form, to where it is. Limbs and garments about a
/// chain of joints (lib/chart's `chart::limb::Limb`), cloth, the sea (`charts`).
pub trait Chart: Copy + GpuData {
    /// The point at place `uv`.
    fn at(self, uv: vec2) -> vec3

    /// Its places: the range of each of its two numbers.
    fn domain(self) -> Box2

    /// Whether its second number wraps round: the place at its domain's last `v` is the one at
    /// its first (a limb's angle round it: 0 is a whole turn), so a lister joins its grid there.
    /// None does unless it says so.
    fn wraps(self) -> bool {
        false
    }

    /// How many faces it shows: 1, its outside; 2, an open sheet seen from both sides. One
    /// unless it says otherwise.
    fn faces(self) -> u32 {
        1
    }

    /// A box that holds it, by intervals over its domain.
    fn bound(self) -> Box3 {
        interval(|uv: vec2| self.at(uv), self.domain())
    }
}

/// One number, to a centre and a radius: a place along it, 0 at its root and 1 at its tip, to
/// the centre there (`xyz`) and its radius (`w`). Hair, grass, reeds, rope.
pub trait Strand: Copy + GpuData {
    /// The centre and radius at `t`.
    fn at(self, t: f32) -> vec4

    /// A box that holds it: its centres' box by intervals, grown by the largest radius.
    fn bound(self) -> Box3 {
        let b = interval(|t: f32| self.at(t), Interval { lo: 0.0, hi: 1.0 })
        Box3 { lo: b.lo.xyz - vec3(b.hi.w), hi: b.hi.xyz + vec3(b.hi.w) }
    }
}

/// A point, to a density: how much of it a ray meets per metre it crosses, 0 where there is
/// none. Cloud, fog, spray, fire, a spell's glow.
pub trait Medium: Copy + GpuData {
    /// Its density at `p`, never negative.
    fn density(self, p: vec3) -> f32

    /// A box outside which its density is 0: nothing can derive it, so the form states it.
    fn bound(self) -> Box3

    /// Its density at `p` as something `footprint` m wide sees it (a cone's width where a march
    /// reads it): detail finer than the footprint fades to its mean instead of aliasing, as
    /// `Solid`'s `filtered` does. The default is the density itself: a medium with no detail
    /// finer than the footprints it's seen at.
    fn filtered(self, p: vec3, footprint: f32) -> f32 {
        self.density(p)
    }

    /// The least distance over which its density changes much (m): a form with no detail finer
    /// than this needs nothing read closer than about half of it, as a solid's `lipschitz` says
    /// how fast its distance can change. 0, unstated: then only how wide it is seen bounds that.
    fn finest(self) -> f32 {
        0.0
    }

    /// A range holding its density over `over`, as `Solid`'s `interval` holds its distance: by
    /// default derived by interval arithmetic over `density`. A medium may state a cheaper one
    /// (its shape's, with its detail's most): a march skips a stretch where it is 0.
    fn interval(self, over: Box3) -> Interval {
        interval(|q: vec3| self.density(q), over)
    }

    /// The medium as the GPU has it this frame, from four numbers a kernel worked out there
    /// before its march (`live`: a sea's crests where a plume is thrown, a simulation's state),
    /// so the CPU need not know them. By default it takes none.
    fn lived(self, live: vec4) -> Self {
        self
    }
}

/// A direction, to a colour: linear red, green and blue, and in `a` how much it hides what is
/// behind it (1 hides it all). Sky, far vista, flashes, smears. It has no bound: it is wherever
/// it is looked at. Its checksum is what it draws: a frame that holds a drawing of a paint draws it
/// again only when the paint's checksum changes (`frame::sky`).
pub trait Paint: Copy + GpuData + StateHash {
    /// Whether the direction is a place on the screen: in the camera's own frame (x right,
    /// y up, looking along -z) instead of the world's.
    const ON_SCREEN: bool = false

    /// The colour seen along `d`, a unit vector.
    fn colour(self, d: vec3) -> vec4

    /// The colour as a footprint `foot` rad across sees it round `d`: what the frame draws its
    /// sky's tables with, a texel's footprint each. A paint with detail finer than a table's
    /// texel gives its mean over the footprint there (so a finer drawing shows finer detail and a
    /// coarser one doesn't alias); any other paint is its colour along `d`.
    fn seen(self, d: vec3, foot: f32) -> vec4 {
        self.colour(d)
    }

    /// How much of the sky's clouds (a medium the frame marches in front of the paint) are seen
    /// along `d`, 0 to 1: 1 where the paint is the far sky behind them; less where it stands in
    /// front of them (a far island) or where they are lost in its own air (the horizon under a
    /// storm's deck).
    fn veiled(self, d: vec3) -> f32 {
        1.0
    }
}

/// A place on a plane, to a distance: negative inside, positive outside, in the plane's own
/// units. Text, UI, a face's features, emblems, a garment's cut edges.
pub trait Shape: Copy + GpuData {
    /// Its distance at `p`.
    fn distance(self, p: vec2) -> f32

    /// A box outside which it is all outside.
    fn bound(self) -> Box2
}
