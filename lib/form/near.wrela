// The one question any surface answers (docs/design.md, "Three places the kinds meet"): from
// this point, how far to you, and which way. Joins, cloth, shadow stand-ins and the rules'
// collision all ask it.
//
// A limb answers it in lib/chart (`chart::limb::Limb::toward`, `foot`): from the point's place
// about its path, how far past the radius there, over how steep the side is.

use charts::Height
use kinds::Solid
use std::derive::value_and_gradient

/// How far to a surface from a point (negative inside), and the unit direction out of it.
pub struct Gap: Copy + GpuData {
    pub out: vec3,
    pub distance: f32,
}

/// A form that answers the question. `K` tags how: the language can't tell a height is no solid,
/// so their impls would overlap without it. Generic code takes `<K, F: Near<K>>`.
pub trait Near<K> {
    /// The answer from `p`.
    fn near(self, p: vec3) -> Gap
}

/// A solid answers: `K` for every solid.
pub struct AsSolid {}

/// A height answers: `K` for every height chart.
pub struct AsHeight {}

/// A solid's distance, and its derived gradient made a unit vector (where it isn't zero).
impl<S: Solid> Near<AsSolid> for S {
    fn near(self, p: vec3) -> Gap {
        let (v, g) = self.sample(p)
        Gap { out: normalize(g), distance: v }
    }
}

/// A height's distance along the normal to its tangent plane under `p`: the height gap over the
/// normal's length, from a derived slope. Exact for a flat height, tilted or not; for a curved
/// one it is good near the surface, which is where the question is asked.
impl<H: Copy + GpuData + fn(vec2) -> f32> Near<AsHeight> for Height<H> {
    fn near(self, p: vec3) -> Gap {
        let h = self.h
        let (y, slope) = value_and_gradient(|q: vec2| h(q), p.xz)
        let n = vec3(-slope.x, 1.0, -slope.y)
        Gap { out: normalize(n), distance: (p.y - y) / length(n) }
    }
}
