// The one shading function every drawn thing shares (docs/design.md, "The picture"): what is
// worn, a normal, the sun and the eye, to a colour, in the game's style. Each lister calls `lit`
// from its own small pixel program. The style's numbers are the game's, passed in.
//
// `lit` is today's `painted` (`rywible/wrela` at 7ae6711e, content/humanoid/fighter.wrela
// 745-820) with two inputs it did not have, a cast shadow and a covered sky, and band edges that
// can hold at any resolution; and with live lights, which it never had. Line numbers below are
// that file's unless named.

use look::{Mist, Skin}

/// The art direction's numbers. (Fields are in the order that packs them for the GPU.)
pub struct Style: Copy + GpuData {
    /// The sun's light, warm, and the half tone: how far from shade toward the sun it is.
    pub sun: vec3,
    pub half: f32,
    /// The shade's light, cool, and how soft every band of n·l is (a smoothstep `soft` either
    /// side of its edge).
    pub shade: vec3,
    pub soft: f32,
    /// The palette's warm, which the glint and the rim are tinted by, and where n·l crosses from
    /// shade to the half tone.
    pub warm: vec3,
    pub lit_edge: f32,
    /// The palette's cool, which the rim in shade is tinted by, and where n·l crosses from the
    /// half tone to full light.
    pub cool: vec3,
    pub full_edge: f32,
    /// What is dark cloth: its value on the screen (`weights` of its colour taken back through
    /// the display's curve, `gamma`) under `dark_edge`, `dark_soft` either side.
    pub weights: vec3,
    pub gamma: f32,
    /// What lifts dark cloth's lit planes, so an arm across a black trunk is a shape: `slate`,
    /// `slate_lit.x` of it in the half tone and `slate_lit.y` more in full light, `slate_bare` of
    /// it where there is no rim.
    pub slate: vec3,
    pub slate_bare: f32,
    pub slate_lit: vec2,
    /// The rim on dark cloth, warm in the light: `x`, and `y` more as the sun is behind the form.
    pub rim_dark: vec2,
    /// The rim on pale cloth, its own colour in the light: `x`, and `y` more as the sun is behind.
    pub rim_pale: vec2,
    pub dark_edge: f32,
    pub dark_soft: f32,
    /// The rim: a band of 1 - n·v. `rim_back` is added to how far the sun is behind the form.
    pub rim_edge: f32,
    pub rim_soft: f32,
    pub rim_back: f32,
    /// The rim on dark cloth in shade, cool.
    pub rim_cool: f32,
    /// The sky's lift: a form is `sky_base + sky_lift · n.y` as bright, so its tops a little
    /// brighter than its sides and its undersides a little darker.
    pub sky_base: f32,
    pub sky_lift: f32,
    /// On the ground a form is `ground_dark` as bright, rising to all of it `ground_reach` m up.
    pub ground_dark: f32,
    pub ground_reach: f32,
    /// Over `metal_from` metal a surface glints: a band of n·h, `glint` strong.
    pub metal_from: f32,
    pub glint_edge: f32,
    pub glint_soft: f32,
    pub glint: f32,
    /// A normal turned from the eye is brought back round to the edge, to `turn` toward it.
    pub turn: f32,
    /// A live light's own band of n·l toward it, and how strong it is at its middle.
    pub spell_edge: f32,
    pub spell_soft: f32,
    pub spell: f32,
    /// How much of the sun's light is cel bands (1: two bands of n·l, at `lit_edge` and
    /// `full_edge`) and how much is continuous (0: the light is n·l itself, from `shade` facing
    /// away to `sun` facing it). A painted style is 0, with `half` 1 and no rim or slate.
    pub cel: f32,
    /// How strongly the sky's own light (`SkyLight`: the frame's sky, as it falls on a face
    /// turned each way) lights a face, in place of the style's `shade`: 0, not at all (the
    /// style's own shade, its sun's light mixed over it as `cel` says); over 0, the sky's light
    /// that many times over (the style's light level, as an exposure sets a camera's), the sun's
    /// (`sun`, then: the direct beam's own light) added on it where it reaches.
    pub sky_light: f32,
    /// How bright a face is, of what the sky gives it, where none of the sky reaches it (`sky`
    /// 0): the light the world round it throws back.
    pub covered: f32,
    /// How much of the sky's light the ground under a face throws back up at it (its albedo, as
    /// the sea's or the land's: 0, none), where the style takes the sky's light.
    pub below: f32,
    /// The open water's light thrown up on what stands near its level (`height` under
    /// `fill_reach` m), where the style takes the sky's light: `fill` of the sky's light low
    /// toward the sun (what a bright sea mirrors up under an overcast), over the share of the
    /// ground a face looks at, more on a face turned down toward the sun's side. 0, none.
    pub fill: f32,
    pub fill_reach: f32,
    pub spare: vec2,
}

const WARM = vec3(1.0, 0.82, 0.58)
const COOL = vec3(0.32, 0.36, 0.58)

/// Kinetic Ink, the look drawn today, its numbers carried exactly.
pub const KINETIC_INK = Style {
    sun: WARM * 1.08, // :769
    half: 0.68, // :771
    shade: mix(COOL, vec3(0.62, 0.56, 0.62), vec3(0.35)) * 0.58, // :770
    soft: 0.035, // :767-768
    warm: WARM, // look.wrela:14
    lit_edge: 0.02, // :767
    cool: COOL, // look.wrela:13
    full_edge: 0.45, // :768
    weights: vec3(0.3, 0.55, 0.15), // :764
    gamma: 2.2, // :765
    slate: vec3(0.026, 0.030, 0.044), // :723
    slate_bare: 0.35, // :795
    slate_lit: vec2(0.4, 0.6),
    rim_dark: vec2(0.07, 0.2), // :790
    rim_pale: vec2(0.25, 0.5), // :792
    dark_edge: 0.12, // :784
    dark_soft: 0.06,
    rim_edge: 0.74, // :782
    rim_soft: 0.05,
    rim_back: 0.35, // :783
    rim_cool: 0.05, // :791
    sky_base: 0.9, // :773
    sky_lift: 0.1,
    ground_dark: 0.82, // :774
    ground_reach: 1.0,
    metal_from: 0.5, // :776
    glint_edge: 0.9, // :778
    glint_soft: 0.03,
    glint: 1.6,
    turn: 0.05, // :758
    // Ours, not carried: today's look has no live light. Its band is of how strongly it falls
    // (n·l times its nearness squared): a tenth of its strength at its middle, its edge a
    // hundredth either side (its strength changes slowly over flat ground), so the sand under a
    // spell takes a clean disc of its colour.
    spell_edge: 0.1,
    spell_soft: 0.01,
    spell: 1.0,
    cel: 1.0,
    sky_light: 0.0,
    // (A covered sky leaves a face as dim as one facing down: `sky_base - sky_lift`, :773.)
    covered: 0.8,
    below: 0.0,
    fill: 0.0,
    fill_reach: 0.0,
    spare: vec2(0.0),
}

/// The painted look: light that turns continuously across a form, as a painter models it (the
/// old opening's, rywible/wrela 7ae6711e, scenes/opening/paint.wrela:588-688 with `LOOK` 3: no
/// bands, no outline), with no rim and no slate: a face's light is n·l itself, from `shade`
/// turned away to `sun` turned toward it, and the sky lifts tops. Drawn with
/// `form::ink::PAINTED_LINES`, which draws no line. Its numbers besides those are Kinetic Ink's;
/// a scene sets its own lights.
pub const PAINTED = Style {
    half: 1.0,
    slate: vec3(0.0),
    rim_dark: vec2(0.0),
    rim_pale: vec2(0.0),
    rim_cool: 0.0,
    glint_soft: 0.08,
    cel: 0.0,
    ..KINETIC_INK
}

/// A soft step of `x` across `edge`, `soft` either side: a painted tone's edge (look.wrela:123).
pub fn band(x: f32, edge: f32, soft: f32) -> f32 {
    smoothstep(edge - soft, edge + soft, x)
}

/// A band whose edge is one pixel wide on the screen, or `soft` wide where that is wider: `rate`
/// is how much `x` changes a pixel across and a pixel down. Where `x` changes fast, the plain
/// band would step from one pixel to the next; this one spreads its edge over the pixel. With
/// no rate it is the plain band.
pub fn band_on_screen(x: f32, edge: f32, soft: f32, rate: vec2) -> f32 {
    band(x, edge, max(soft, 0.5 * length(rate)))
}

/// How a pixel's point, its normal and its skin's relief change a pixel across and a pixel down
/// the screen. A fragment passes `dpdx` and `dpdy` of each; a lister with a jet may pass its own.
/// `STILL`, all zero, gives the plain bands and no relief.
pub struct Steps: Copy + GpuData {
    pub across: vec3,
    pub down: vec3,
    pub normal_across: vec3,
    pub normal_down: vec3,
    /// The relief's change (m): across in `x`, down in `y`.
    pub relief: vec2,
}

pub const STILL = Steps {
    across: vec3(),
    down: vec3(),
    normal_across: vec3(),
    normal_down: vec3(),
    relief: vec2(),
}

/// A normal `n` with a relief on it, tilted by the relief's slope across the screen, with no
/// texture's coordinates to take the slope along (M. Mikkelsen, "Bump Mapping Unparametrized
/// Surfaces on the GPU", 2010; engine/character.wrela:696-706 at 7ae6711e). With no steps, `n`.
pub fn embossed(n: vec3, s: Steps) -> vec3 {
    let r1 = cross(s.down, n)
    let r2 = cross(n, s.across)
    let det = dot(s.across, r1)
    let grad = (r1 * s.relief.x + r2 * s.relief.y) * (if det < 0.0 { -1.0 } else { 1.0 })
    let out = n * abs(det) - grad
    let l = length(out)
    if l > 1.0e-12 { out / l } else { n }
}

/// The most live lights a point is lit by.
pub const MOST_LIGHTS: u32 = 4

/// A light that moves, a spell's: where it is, its colour (linear), and how far it reaches (m).
pub struct Light: Copy + GpuData {
    pub at: vec3,
    pub reach: f32,
    pub colour: vec3,
}

/// The live lights, the first `count` of `each`: plain data, so a pixel program reads them from
/// a uniform.
pub struct Lights: Copy + GpuData {
    pub each: [Light; MOST_LIGHTS],
    pub count: u32,
}

pub const NO_LIGHTS = Lights {
    each: [Light { at: vec3(), reach: 0.0, colour: vec3() }; MOST_LIGHTS],
    count: 0,
}

/// The live lights as seen from one point, which they need to light it: `lights.from(world)`.
pub struct Around: Copy {
    pub lights: Lights,
    pub world: vec3,
}

pub const DARK = Around { lights: NO_LIGHTS, world: vec3() }

impl Lights {
    pub fn from(self, world: vec3) -> Around {
        Around { lights: self, world }
    }
}

/// The sky's light as it falls on a face turned each way: what a white face turned `n` shows
/// (its irradiance over π), as nine numbers of each colour (`c[i].xyz`): the sky's light over
/// the upper half of the world in spherical harmonics to the second order, the cosine already
/// taken (R. Ramamoorthi and P. Hanrahan, "An Efficient Representation for Irradiance
/// Environment Maps", SIGGRAPH 2001). The frame works it out from its sky (`frame::sky`), and
/// what a face turned straight up shows of it (`up`: the ground under a face is lit by it).
pub struct SkyLight: Copy + GpuData {
    pub c: [vec4; 9],
    pub up: vec4,
}

/// No sky light: a style that takes it lights nothing by it.
pub const NO_SKY_LIGHT = SkyLight { c: [vec4(0.0); 9], up: vec4(0.0) }

/// The nine harmonics at the unit direction `d` (y up).
pub fn harmonics(d: vec3) -> [f32; 9] {
    [
        0.282095,
        0.488603 * d.y,
        0.488603 * d.z,
        0.488603 * d.x,
        1.092548 * d.x * d.z,
        1.092548 * d.y * d.z,
        0.315392 * (3.0 * d.y * d.y - 1.0),
        1.092548 * d.x * d.y,
        0.546274 * (d.x * d.x - d.z * d.z),
    ]
}

/// What a white face turned `n` (a unit vector) shows of the sky's light `s`.
pub fn sky_lit(s: SkyLight, n: vec3) -> vec3 {
    let y = harmonics(n)
    var e = vec3(0.0)
    for i in 0..9 {
        e += s.c[i].xyz * y[i]
    }
    max(e, vec3(0.0))
}

/// The colour (linear) of `skin` with unit normal `normal`, under a sun along `sun` and seen
/// along `eye` (both unit, from the point), in `style`. `reach` is how much of the sun reaches
/// the point (0 in a cast shadow), `sky` how much of the sky's light reaches it (1 open, 0
/// covered: `style.covered` of it is left), `height` how far it is above the ground (m);
/// `skylight` the sky's light, for a style that takes it (`style.sky_light`). `steps` hold the band edges to a pixel and tilt
/// the light by the skin's relief; leave them out for the plain bands. `around` is the live
/// lights from the point (`lights.from(world)`); leave it out for the sun alone. `live` is the
/// most of them the caller lights by: a pixel program's `const` (`lights: const u32`), 0 where
/// it's drawn while none is lit, so its pipeline has no loop and pays nothing for them. What the
/// skin emits is added last, unshaded.
pub fn lit(
    style: Style,
    skin: Skin,
    normal: vec3,
    sun: vec3,
    eye: vec3,
    reach: f32,
    sky: f32,
    height: f32,
    steps: Steps = STILL,
    around: Around = DARK,
    live: u32 = MOST_LIGHTS,
    skylight: SkyLight = NO_SKY_LIGHT,
) -> vec3 {
    var n = embossed(normal, steps)
    let facing = dot(n, eye)
    if dot(n, eye) < 0.0 {
        n = normalize(n - eye * (dot(n, eye) - style.turn))
    }
    let albedo = skin.albedo
    // How fast a dot product of the normal with `d` changes across the screen.
    let rate = |d: vec3| vec2(dot(steps.normal_across, d), dot(steps.normal_down, d))
    // The two bands, or n·l itself as the style is painted. A cast shadow takes the sun away: the
    // point is on the shade side of both.
    // (Each term below is worked out only where the style or the skin can make it other than
    // nothing: a test of the uniform style, the same for every pixel of a draw.)
    let ndl = dot(n, sun)
    let turned = saturate(ndl)
    var lit_side = turned * reach
    var full = lit_side
    if style.cel > 0.0 {
        lit_side = mix(turned, band_on_screen(ndl, style.lit_edge, style.soft, rate(sun)), style.cel) * reach
        full = mix(turned, band_on_screen(ndl, style.full_edge, style.soft, rate(sun)), style.cel) * reach
    }
    // The sky lifts the tops of forms; a covered sky leaves a form `covered` as bright.
    let open = style.sky_base + style.sky_lift * n.y
    let let_in = mix(style.covered, open, sky)
    var col = vec3(0.0)
    if style.sky_light <= 0.0 {
        let half = mix(style.shade, style.sun, vec3(style.half))
        col = albedo * mix(style.shade, mix(half, style.sun, vec3(full)), vec3(lit_side)) * let_in
    } else {
        // The sky's own light on the face, and the ground's under it (lit by the sky from
        // above, thrown back as its albedo, `below`: half of it reaches a wall, all of it a
        // face turned down), as much as reaches it; and the sun's beam where it reaches.
        let skyward = sky_lit(skylight, n) + skylight.up.xyz * (style.below * 0.5 * (1.0 - n.y))
        // The water's light thrown up from under it (the old opening's bounce on its skiff and
        // rider, rywible/wrela 7ae6711e, scenes/opening/paint.wrela:1689-1710): the sky low toward
        // the sun, over the share of the ground the face sees, half again on the side toward the
        // sun, as much of it as the face's sky reaches.
        var filled = vec3(0.0)
        if style.fill > 0.0 && height < style.fill_reach {
            let low = normalize(vec3(sun.x, 0.25, sun.z))
            let toward = saturate(dot(n, normalize(vec3(sun.x, -0.4, sun.z))))
            let near = 1.0 - smoothstep(0.0, style.fill_reach, height)
            filled = sky_lit(skylight, low) *
                (style.fill * near * 0.5 * (1.0 - n.y) * (0.5 + 0.5 * toward) * (0.4 + 0.6 * sky))
        }
        col = albedo * (skyward * (let_in * style.sky_light) + filled + style.sun * lit_side)
    }
    if style.ground_dark < 1.0 {
        col *= mix(style.ground_dark, 1.0, saturate(height / style.ground_reach))
    }
    if skin.metal > style.metal_from {
        let h = normalize(sun + eye)
        let glint = band_on_screen(dot(n, h), style.glint_edge, style.glint_soft, rate(h))
        col += albedo * style.warm * glint * style.glint * reach
    }
    // The rim round the edge, and the slate on dark cloth's lit planes. Dark cloth is told by its
    // value on the screen, so its colour is taken back through the display's curve.
    let rim = if skin.rim { 1.0 } else { 0.0 }
    let rimmed = skin.rim && (style.rim_cool > 0.0 || dot(style.rim_dark, style.rim_dark) > 0.0)
    let paled = dot(style.rim_pale, style.rim_pale) > 0.0
    let slated = dot(style.slate, style.slate) > 0.0
    if rimmed || paled || slated {
        let grazing = 1.0 - max(dot(n, eye), 0.0)
        let edge = band_on_screen(grazing, style.rim_edge, style.rim_soft, -rate(eye))
        let back = saturate(-dot(eye, sun) + style.rim_back)
        let value = dot(pow(albedo, vec3(1.0 / style.gamma)), style.weights)
        let dark = 1.0 - band(value, style.dark_edge, style.dark_soft)
        let warm = style.rim_dark.x + style.rim_dark.y * back
        let pale = style.rim_pale.x + style.rim_pale.y * back
        if rimmed {
            col += style.warm * edge * warm * lit_side * dark * rim
            // (Where the style takes the sky's light, the rim in shade is the sky's own light round
            // the form, `cool` its tint, brighter where the form turns up: the old opening's
            // illustrated rim on its rider, scenes/opening/aboard.wrela:948-971.)
            let shade_rim = if style.sky_light > 0.0 {
                // (Not where the surface faces far from the eye: a cloth seen from inside, whose
                // normal turned to its edge would be all rim.)
                style.cool * sky_lit(skylight, normalize(n + vec3(0.0, 0.6, 0.0))) * (0.45 + 0.35 * max(n.y, 0.0)) *
                    smoothstep(-0.35, -0.2, facing)
            } else { style.cool }
            col += shade_rim * edge * style.rim_cool * (1.0 - lit_side) * dark * rim * sky
        }
        col += albedo * style.warm * edge * pale * lit_side * (1.0 - dark)
        let slate = style.slate_lit.x * lit_side + style.slate_lit.y * full
        col += style.slate * dark * slate * mix(style.slate_bare, 1.0, rim)
    }
    // Each live light: a band of its own, of how strongly it falls here (n·l toward it, times the
    // square of how far in from its reach the point is), in its colour, as the sun's bands are
    // cel bands: so it lights a clean shape, edged where its strength passes the style's edge.
    // It lights the shade and a cast shadow as well. (The loop runs to the most there can be,
    // so its cost is bounded; to none where `live` is 0, and then it isn't in the program.) A
    // point past a light's reach pays one test: its strength there is 0, and so is its band,
    // whose edge is past 0 and whose width there is the style's alone (`cel`'s rate is 0 where
    // its nearness is).
    for i in 0..MOST_LIGHTS {
        if i >= live || i >= around.lights.count {
            break
        }
        let light = around.lights.each[i]
        let d = light.at - around.world
        if dot(d, d) < light.reach * light.reach {
            col += albedo * light.colour * cel(style, light, around.world, n, steps) * style.spell
        }
    }
    col + skin.emits
}

/// How strongly live light `light` falls on a point at `world` facing `n` (n·l toward it, times
/// the square of how far in from its reach the point is: 0 past it), and its cel band of that:
/// the style's `spell_edge`, `spell_soft` either side and a pixel wide on the screen, by how
/// the strength changes a pixel across and down (`steps`: the point's change moves the way to
/// the light and how near it is, the normal's moves n·l).
pub fn cel(style: Style, light: Light, world: vec3, n: vec3, steps: Steps) -> f32 {
    let d = light.at - world
    let far = max(length(d), 1.0e-6)
    let toward = d / far
    let reach = max(light.reach, 1.0e-6)
    let near = saturate(1.0 - far / reach)
    let facing = dot(n, toward)
    let strength = facing * near * near
    // A step δp of the point turns the way to the light by -(δp - toward (toward·δp)) / far and
    // brings it nearer by (toward·δp) / reach.
    let changed = |dp: vec3, dn: vec3| {
        let turned = -(dp - toward * dot(toward, dp)) / far
        let nearer = if near > 0.0 { dot(toward, dp) / reach } else { 0.0 }
        (dot(dn, toward) + dot(n, turned)) * near * near + facing * 2.0 * near * nearer
    }
    let rate = vec2(
        changed(steps.across, steps.normal_across),
        changed(steps.down, steps.normal_down),
    )
    band_on_screen(strength, style.spell_edge, style.spell_soft, rate)
}

/// How many times softer a medium's bands are than a surface's (`Style::soft`): a soft thing's
/// shade is a calm shape, its edge wider than a surface's.
pub const MIST_SOFT: f32 = 4.0

/// How far a medium's shade is lifted toward the half tone (0 none, 1 all of it): light it
/// scatters all round inside it reaches its shaded side, so white water in shade is a pale cool
/// grey, not the dark of a surface turned from the sun.
pub const MIST_LIFT: f32 = 0.5

/// The light a medium scatters toward the eye where it is thick enough to hide what is behind
/// it (a march takes its share as it hides less): `mist`, its shape facing `normal` (the way its
/// density falls away, a unit vector), under a sun along `sun`, seen from `eye` (both unit, from
/// the medium), in `style`. Lit as `lit` lights a surface, with bands `MIST_SOFT` times softer:
/// a band of n·l from the shade's light (lifted `MIST_LIFT` toward the half tone) to the half
/// tone and the sun's; and, looking toward the
/// sun through it, its forward lobe (the sun's light by `mist.forward` times the sixth power of
/// how straight toward the sun the eye looks). `reach` is how much of the sun reaches it (the
/// sun's picture will say; 1 for now), `through` how much of its forward lobe comes through it
/// (where it is thick, the sun behind it doesn't reach the eye: a march says), `around` the live
/// lights from it, each a band of its own toward it as in `lit` (`live`, as `lit`'s, the most it's
/// lit by). What it emits isn't here: a march adds it where it is.
pub fn scattered(
    style: Style,
    mist: Mist,
    normal: vec3,
    sun: vec3,
    eye: vec3,
    reach: f32,
    through: f32 = 1.0,
    around: Around = DARK,
    live: u32 = MOST_LIGHTS,
) -> vec3 {
    let soft = style.soft * MIST_SOFT
    let ndl = dot(normal, sun)
    let turned = saturate(ndl)
    let lit_side = mix(turned, band(ndl, style.lit_edge, soft), style.cel) * reach
    let full = mix(turned, band(ndl, style.full_edge, soft), style.cel) * reach
    let half = mix(style.shade, style.sun, vec3(style.half))
    // Light scattered all round inside it lifts its shade toward the half tone.
    let dark = mix(style.shade, half, vec3(MIST_LIFT))
    var col = mist.albedo * mix(dark, mix(half, style.sun, vec3(full)), vec3(lit_side))
    let toward = max(-dot(eye, sun), 0.0)
    let t2 = toward * toward
    col += mist.albedo * style.sun * (mist.forward * t2 * t2 * t2 * reach * through)
    var softer = style
    softer.spell_soft = style.spell_soft * MIST_SOFT
    for i in 0..MOST_LIGHTS {
        if i >= live || i >= around.lights.count {
            break
        }
        let light = around.lights.each[i]
        let d = light.at - around.world
        if dot(d, d) < light.reach * light.reach {
            col += mist.albedo *
                light.colour *
                cel(softer, light, around.world, normal, STILL) *
                style.spell
        }
    }
    col
}
