// Two ways to make a chart (docs/design.md, "Forms"), each the smallest honest one of its sort:
// a sheet from its rest shape, a height over the ground. A limb about a chain of joints is
// lib/chart's (`chart::limb::Limb`).

use kinds::Chart
use std::derive::Box2

/// A sheet: thin, with two faces, given by its rest shape, the point at each place before
/// anything moves it. Cloth.
pub struct Sheet<F>: Copy + GpuData {
    pub rest: F,
    pub places: Box2,
}

impl<F: Copy + GpuData + fn(vec2) -> vec3> Chart for Sheet<F> {
    fn at(self, uv: vec2) -> vec3 {
        let rest = self.rest
        rest(uv)
    }

    fn domain(self) -> Box2 {
        self.places
    }
}

/// A height: the surface y = h(x, z) over a rectangle of the ground. A place is (x, z) itself.
/// The sea.
pub struct Height<H>: Copy + GpuData {
    pub h: H,
    pub places: Box2,
}

impl<H: Copy + GpuData + fn(vec2) -> f32> Chart for Height<H> {
    fn at(self, uv: vec2) -> vec3 {
        let h = self.h
        vec3(uv.x, h(uv), uv.y)
    }

    fn domain(self) -> Box2 {
        self.places
    }
}
