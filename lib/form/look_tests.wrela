// The look and the one shading function, held on the CPU to numbers worked out by hand from
// today's `painted` (rywible/wrela 7ae6711e, content/humanoid/fighter.wrela:745-820): its
// formulas written out in float64 (wrela-notes/next/scratch/look/painted.py), the cloths from
// content/hakuro/hakuro.wrela:51-55.

use look::{Look, Place, Skin}
use shade::{
    KINETIC_INK, Light, Lights, NO_LIGHTS, STILL, Steps, band, band_on_screen, embossed, lit,
}

fn near3(a: vec3, b: vec3) -> bool {
    length(a - b) < 1.0e-5
}

/// A cloth as today's palette holds it, as a skin: its colour raised to 2.2, as `painted` raises
/// it, and its line where its value crosses 0.14.
fn worn(shown: vec3, metal: f32 = 0.0, rim: bool = true) -> Skin {
    Skin {
        albedo: pow(shown, vec3(2.2)),
        line: dot(shown, vec3(0.3, 0.55, 0.15)) - 0.14,
        metal,
        rim,
    }
}

const SKIN = vec3(0.500, 0.250, 0.130)
const BLACK = vec3(0.050, 0.050, 0.066)
const GOLD = vec3(0.690, 0.380, 0.016)
/// Today's sun (content/humanoid/look.wrela:8, 70).
const SUN = normalize(vec3(0.7, 0.6, 0.38))

/// `lit` of `skin` with normal `n` seen along `eye`, held to `want`, worked out by hand.
fn holds(skin: Skin, n: vec3, eye: vec3, want: vec3, height: f32 = 1.2, sky: f32 = 1.0) {
    let got = lit(KINETIC_INK, skin, n, SUN, eye, reach: 1.0, sky: sky, height: height)
    assert(near3(got, want), f"lit {got}, painted {want}")
}

@test
fn lit_gives_todays_painted_colour() {
    let front = vec3(z: 1.0)
    // n·l = 0.25: between the bands, in the half tone.
    let half = vec3(-0.10464930619889196, -0.08969940531333592, 0.9904557230883793)
    // Seen from behind and to the side, the sun behind the form: its normal turns from the eye
    // and is brought back to the edge, where the rim is.
    let behind = normalize(vec3(-0.7, 0.0, -0.3))
    let edge = normalize(vec3(0.6, 0.6, -0.53))
    // Skin facing the sun, turned from it, and between.
    holds(worn(SKIN), SUN, SUN, vec3(0.2256864, 0.0402766, 0.0067589))
    holds(
        worn(SKIN),
        normalize(vec3(-0.7, -0.2, 0.68)),
        front,
        vec3(0.0472059, 0.0103946, 0.0034067),
    )
    holds(worn(SKIN), half, front, vec3(0.1577126, 0.0287843, 0.0053690))
    // Black cloth in full light, lifted by the slate; in the half tone, near the ground.
    holds(worn(BLACK), SUN, SUN, vec3(0.0274240, 0.0311677, 0.0455212))
    holds(worn(BLACK), half, front, vec3(0.0112697, 0.0127293, 0.0186562), height: 0.3)
    // Gold turned to the half-way vector: its glint.
    holds(
        worn(GOLD, metal: 1.0),
        normalize(SUN + front),
        front,
        vec3(1.1542275, 0.2547776, 0.0001696),
    )
    // The rim: warm on black cloth, none on the tails, the skin's own colour on pale.
    holds(worn(BLACK), edge, behind, vec3(0.2814763, 0.2343026, 0.1755070))
    holds(worn(BLACK, rim: false), edge, behind, vec3(0.0047163, 0.0051026, 0.0074670))
    holds(worn(SKIN), edge, behind, vec3(0.3338114, 0.0602634, 0.0106955))
    // A normal turned from the eye, brought round.
    holds(worn(SKIN), normalize(vec3(0.3, 0.5, -0.2)), front, vec3(0.2860804, 0.0510547, 0.0085676))
    // A covered sky takes the cool rim and the lift.
    holds(worn(BLACK), edge, behind, vec3(0.2812934, 0.2341492, 0.1752850), sky: 0.0)
}

@test
fn a_cast_shadow_puts_a_point_in_shade() {
    let open = lit(KINETIC_INK, worn(SKIN), SUN, SUN, SUN, reach: 1.0, sky: 1.0, height: 1.2)
    let shadowed = lit(KINETIC_INK, worn(SKIN), SUN, SUN, SUN, reach: 0.0, sky: 1.0, height: 1.2)
    // Worked out with both bands at 0: the shade's light, and the sky's lift for a normal so high.
    let shade = pow(SKIN, vec3(2.2)) * KINETIC_INK.shade * (0.9 + 0.1 * SUN.y)
    assert(near3(shadowed, vec3(0.0515108, 0.0113426, 0.0037174)), f"shadowed {shadowed}")
    assert(near3(shadowed, shade), f"shadowed {shadowed}, shade {shade}")
    assert(shadowed.x < 0.25 * open.x, "a shadow left the light")
}

@test
fn a_band_on_the_screen_is_a_pixel_wide_and_the_plain_band_at_rest() {
    let on = |x: f32, rate: vec2| band_on_screen(x, edge: 0.0, soft: 0.035, rate: rate)
    // The value changes by 0.5 a pixel, so the edge runs from 0.25 under to 0.25 over.
    let rate = vec2(0.3, 0.4)
    var last = 0.0
    for i in 0..101 {
        let x = -0.5 + 0.01 * f32(i)
        assert(on(x, rate) >= last, f"not monotone at {x}")
        last = on(x, rate)
        assert(on(x, vec2()) == band(x, edge: 0.0, soft: 0.035), "still, not the plain band")
    }
    assert(on(0.0, rate) == 0.5, "not half at the edge")
    let off = band_on_screen(x: 0.45, edge: 0.45, soft: 0.035, rate: rate)
    assert(abs(off - 0.5) < 1.0e-6, "not half at an edge off zero")
    assert(on(-0.25, rate) == 0.0 && on(0.25, rate) == 1.0 && on(0.2, rate) < 1.0, "not a pixel")
    // Where it changes slowly, the style's softness.
    assert(on(0.04, vec2(0.001)) == 1.0, "softer than the style")
}

@test
fn relief_tilts_the_light_as_embossed_does() {
    // A face toward +z, a pixel 1 cm across it each way, a relief rising 1 mm a pixel across:
    // a slope of 0.1, so the normal leans back from +x by 0.1 (Mikkelsen's surface gradient).
    let n = vec3(z: 1.0)
    let s = Steps { across: vec3(x: 0.01), down: vec3(y: 0.01), relief: vec2(0.001, 0.0), ..STILL }
    let tilted = normalize(vec3(-0.1, 0.0, 1.0))
    assert(near3(embossed(n, s), tilted), f"embossed {embossed(n, s)}")
    assert(embossed(n, STILL) == n, "no steps, no tilt")
    // The light sees the tilted normal: lit with the relief is lit of the tilted form. The sun is
    // where the flat face is at the edge of full light (n·l 0.447), so the lean shows.
    let sun = normalize(vec3(-0.9, 0.0, 0.45))
    let skin = worn(SKIN)
    let bumped = lit(KINETIC_INK, skin, n, sun, n, reach: 1.0, sky: 1.0, height: 1.2, steps: s)
    let want = lit(KINETIC_INK, skin, tilted, sun, n, reach: 1.0, sky: 1.0, height: 1.2)
    let flat = lit(KINETIC_INK, skin, n, sun, n, reach: 1.0, sky: 1.0, height: 1.2)
    assert(near3(bumped, want), f"relief {bumped}, tilted {want}")
    assert(bumped.x > 1.1 * flat.x, f"it didn't lean to the sun: {bumped}, flat {flat}")
}

/// A two-tone sleeve: black cloth, gold above 1.4 m at rest, a line between.
struct Sleeve: Copy + GpuData {}

impl Look for Sleeve {
    fn skin(self, at: Place) -> Skin {
        let gold = at.rest.y > 1.4
        let shown = if gold { GOLD } else { BLACK }
        Skin { line: at.rest.y - 1.4, ..worn(shown, metal: if gold { 1.0 } else { 0.0 }) }
    }
}

@test
fn a_look_is_asked_at_rest_and_gives_ink_its_line() {
    // Posed, the place has moved from where it is at rest; what it wears follows the rest.
    let at = Place {
        world: vec3(0.3, 0.9, 0.1),
        rest: vec3(0.2, 1.5, 0.0),
        chart: None,
        normal: vec3(z: 1.0),
    }
    let s = Sleeve {}.skin(at)
    assert(s.metal == 1.0 && near3(s.albedo, pow(GOLD, vec3(2.2))), "not gold")
    let below = Sleeve {}.skin(
        Place { rest: vec3(0.2, 1.3, 0.0), chart: Some(vec2(0.4, 1.0)), ..at },
    )
    assert(s.line * below.line < 0.0, "no line between the gold and the black")
}

/// Six of the cases above as `lit` gave them before it had live lights or emission, bit for bit.
const BEFORE = [
    vec3u(1046944339, 1025833244, 1004370324),
    vec3u(1027693291, 1009405509, 996098826),
    vec3u(1010345118, 1011912381, 1016648905),
    vec3u(1066646970, 1048736308, 959564562),
    vec3u(1049632170, 1047522565, 1043576861),
    vec3u(1028848897, 1010423358, 997433172),
]

fn bits(c: vec3) -> vec3u {
    vec3u(bitcast_u32(c.x), bitcast_u32(c.y), bitcast_u32(c.z))
}

@test
fn no_lights_and_no_emission_is_lit_as_it_was_to_the_bit() {
    let front = vec3(z: 1.0)
    let half = vec3(-0.10464930619889196, -0.08969940531333592, 0.9904557230883793)
    let behind = normalize(vec3(-0.7, 0.0, -0.3))
    let edge = normalize(vec3(0.6, 0.6, -0.53))
    let shaded = normalize(vec3(-0.7, -0.2, 0.68))
    let skins = [
        worn(SKIN),
        worn(SKIN),
        worn(BLACK),
        worn(GOLD, metal: 1.0),
        worn(BLACK),
        worn(SKIN),
    ]
    let ns = [SUN, shaded, half, normalize(SUN + front), edge, SUN]
    let eyes = [SUN, front, front, front, behind, SUN]
    let heights = [1.2, 1.2, 0.3, 1.2, 1.2, 1.2]
    for i in 0..6 {
        let reach = if i == 5 { 0.0 } else { 1.0 }
        let s = skins[i]
        let sun_only = lit(KINETIC_INK, s, ns[i], SUN, eyes[i], reach, sky: 1.0, height: heights[i])
        let empty = NO_LIGHTS.from(vec3(1.0, 2.0, 3.0))
        let none = Skin { emits: vec3(), ..s }
        let named = lit(
            KINETIC_INK,
            none,
            ns[i],
            SUN,
            eyes[i],
            reach,
            sky: 1.0,
            height: heights[i],
            around: empty,
        )
        assert(
            bits(sun_only) == BEFORE[i] && bits(named) == BEFORE[i],
            f"case {i} moved: {sun_only}",
        )
    }
}

/// What a blue spell adds to `skin` with normal `n` at the origin, `far` m along `toward`.
fn spell(skin: Skin, n: vec3, toward: vec3, far: f32, reach: f32 = 1.0) -> vec3 {
    let lights = Lights {
        each: [
            Light { at: toward * far, reach: 3.0, colour: vec3(0.2, 0.4, 1.0) },
            ..NO_LIGHTS.each[0],
        ],
        count: 1,
    }
    let eye = vec3(z: 1.0)
    let with = lit(
        KINETIC_INK,
        skin,
        n,
        SUN,
        eye,
        reach,
        sky: 1.0,
        height: 1.2,
        around: lights.from(vec3()),
    )
    with - lit(KINETIC_INK, skin, n, SUN, eye, reach, sky: 1.0, height: 1.2)
}

@test
fn a_spell_lights_the_shade_side_toward_its_colour_and_nothing_past_its_reach() {
    let n = normalize(vec3(-0.7, -0.2, 0.68))
    let skin = worn(SKIN)
    // Facing the spell 1 m off, in the sun's shade: it falls with (1 - 1/3)² of its strength,
    // well inside its band, which adds the skin's colour in the spell's, whole.
    let added = spell(skin, n, n, 1.0)
    assert(near3(added, skin.albedo * vec3(0.2, 0.4, 1.0)), f"added {added}")
    // In a cast shadow it adds the same.
    assert(near3(spell(skin, n, n, 1.0, reach: 0.0), added), "a cast shadow hid the spell")
    // Past its reach, nothing, to the bit.
    assert(bits(spell(skin, n, n, 3.5)) == bits(vec3()), "lit past its reach")
}

/// Lit for no live light (`live` 0, a pixel program built for none) is lit by the sun alone, to
/// the bit, whatever the lights hold; and a point just inside a light's reach is lit as just
/// past it (the band is 0 at its reach: the test that skips it there changes nothing).
@test
fn lit_for_no_light_is_the_sun_alone_and_the_reach_skips_nothing() {
    let n = normalize(vec3(-0.7, -0.2, 0.68))
    let skin = worn(SKIN)
    let eye = vec3(z: 1.0)
    let lights = Lights {
        each: [Light { at: n, reach: 3.0, colour: vec3(0.2, 0.4, 1.0) }, ..NO_LIGHTS.each[0]],
        count: 1,
    }
    let sun = lit(KINETIC_INK, skin, n, SUN, eye, 1.0, sky: 1.0, height: 1.2)
    let none = lit(
        KINETIC_INK,
        skin,
        n,
        SUN,
        eye,
        1.0,
        sky: 1.0,
        height: 1.2,
        around: lights.from(vec3()),
        live: 0,
    )
    assert(bits(none) == bits(sun), f"{none} against {sun}")
    let inside = spell(skin, n, n, 2.999)
    let past = spell(skin, n, n, 3.001)
    assert(bits(inside) == bits(vec3()) && bits(past) == bits(vec3()), f"{inside} {past}")
}

@test
fn a_spells_band_is_monotone_toward_it_and_falls_with_distance() {
    let skin = worn(BLACK)
    let n = vec3(z: 1.0)
    var last = vec3()
    for i in 0..41 {
        // From behind the surface (n·l -1) round to straight in front of it (n·l 1).
        let a = 3.14159265 * (1.0 - f32(i) / 40.0)
        let got = spell(skin, n, vec3(sin(a), 0.0, cos(a)), 1.0)
        assert(got.z >= last.z && (i < 30 || got.z > 0.0), f"not monotone toward it at {i}")
        last = got
    }
    var before = spell(skin, n, n, 0.05)
    for i in 1..40 {
        let got = spell(skin, n, n, 0.1 * f32(i))
        assert(got.z <= before.z, f"brighter farther at {i}")
        before = got
    }
}

@test
fn emission_passes_through_unshaded() {
    let glow = vec3(0.9, 0.3, 0.05)
    for reach in [0.0, 1.0] {
        let n = normalize(vec3(-0.7, -0.2, 0.68))
        let plain = lit(
            KINETIC_INK,
            worn(BLACK),
            n,
            SUN,
            vec3(z: 1.0),
            reach,
            sky: 0.0,
            height: 0.0,
        )
        let rune = lit(
            KINETIC_INK,
            Skin { emits: glow, ..worn(BLACK) },
            n,
            SUN,
            vec3(z: 1.0),
            reach,
            sky: 0.0,
            height: 0.0,
        )
        assert(near3(rune - plain, glow), f"emission shaded: {rune - plain}")
    }
}
