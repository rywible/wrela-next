// A workgroup size outside what the machine allows: each of `@compute(x, y, z)` at least 1 and
// at most 1024, and their product at most 1024.
// ---- wrong
use std::gpu::{GlobalId, GpuBuffer, Slots, buffer, dispatch}

@compute(2048)
fn big(out: mut Slots<u32>, id: GlobalId) {
    out[id] = id.x
}

pub fn frame(time: f32, width: u32, height: u32) {}
// ---- fixed
use std::gpu::{GlobalId, GpuBuffer, Slots, buffer, dispatch}

@compute(1024)
fn big(out: mut Slots<u32>, id: GlobalId) {
    out[id] = id.x
}

pub fn frame(time: f32, width: u32, height: u32) {}
