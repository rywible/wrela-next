// GPU work every invocation does again that the compiler couldn't move to an earlier rate, and
// that costs (§18.13): a loop of constants the build's fuel ran out for, a loop to a count the
// command gives (the same for every invocation), or a loop of thousands of passes. Here every
// pixel loops to the draw's count of lights, tests it and carries the loop's code, though the
// count is the same for the whole draw. Take the count as a `const` parameter: a pipeline for
// each count a draw has, and one for none has no loop. A loop that's meant is held to a
// `@budget(work: n)`, which quiets it.
// ---- wrong
use std::gpu::{ClipPosition, FragCoord, VertexIndex, begin_screen_pass, draw}

struct Lights: Copy + GpuData {
    at: [vec4; 4],
    count: u32,
}

@vertex
fn cover(v: VertexIndex) -> ClipPosition {
    let x = f32((v.index & 1) * 4) - 1.0
    let y = f32((v.index & 2) * 2) - 1.0
    ClipPosition { position: vec4(x, y, 0.0, 1.0) }
}

@fragment
fn lit(pixel: FragCoord, lights: Lights) -> vec4 {
    let p = vec3(pixel.position.xy * 0.01, 0.0)
    var c = 0.1
    for i in 0..4 {
        if i >= lights.count {
            break
        }
        let d = lights.at[i].xyz - p
        let e = exp(-dot(d, d))
        c += smoothstep(0.2, 0.3, e * pow(abs(sin(d.x)), 2.5) / length(d))
        c += smoothstep(0.5, 0.6, e * pow(abs(cos(d.y)), 1.5) / length(d + 0.1))
    }
    vec4(vec3(c), 1.0)
}

pub fn frame(time: f32, width: u32, height: u32) {
    let screen = begin_screen_pass(clear: vec4(0.0))
    let lights = Lights { at: [vec4(0.0); 4], count: 0 }
    draw(screen, cover, lit.bind(lights: lights), vertices: 3)
    screen.present()
}
// ---- fixed
use std::gpu::{ClipPosition, FragCoord, VertexIndex, begin_screen_pass, draw}

struct Lights: Copy + GpuData {
    at: [vec4; 4],
}

@vertex
fn cover(v: VertexIndex) -> ClipPosition {
    let x = f32((v.index & 1) * 4) - 1.0
    let y = f32((v.index & 2) * 2) - 1.0
    ClipPosition { position: vec4(x, y, 0.0, 1.0) }
}

/// Lit by `count` lights: a pipeline for each count a draw has.
@fragment
fn lit(pixel: FragCoord, lights: Lights, count: const u32) -> vec4 {
    let p = vec3(pixel.position.xy * 0.01, 0.0)
    var c = 0.1
    for i in 0..count {
        let d = lights.at[i].xyz - p
        let e = exp(-dot(d, d))
        c += smoothstep(0.2, 0.3, e * pow(abs(sin(d.x)), 2.5) / length(d))
        c += smoothstep(0.5, 0.6, e * pow(abs(cos(d.y)), 1.5) / length(d + 0.1))
    }
    vec4(vec3(c), 1.0)
}

pub fn frame(time: f32, width: u32, height: u32) {
    let screen = begin_screen_pass(clear: vec4(0.0))
    let lights = Lights { at: [vec4(0.0); 4] }
    draw(screen, cover, lit.bind(lights: lights, count: 0), vertices: 3)
    screen.present()
}
