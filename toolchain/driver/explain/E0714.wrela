// A dispatch whose size the build knows, past the work one dispatch may do (§18.11): every group
// count is a constant of the CPU code (or arithmetic of constants), and its kernel's bound times
// its invocations would hold the GPU past 50 ms on a target, by the host's own arithmetic (each
// target's time a unit of work, never fewer invocations than it runs side by side). The host
// would refuse it when it came; the build says so first. Dispatch it in parts: as many
// invocations a part as `std::gpu::limits().step_work` thousand units over the kernel's own bound
// (`std::gpu::kernel_work`) allow.
// ---- wrong
use std::gpu::{GlobalId, GpuBuffer, Slots, buffer, dispatch}

@compute(64)
fn heavy(out: mut Slots<f32>, id: GlobalId) {
    var a = f32(id.x)
    for _i in 0..2000 {
        a = sin(a) + cos(a)
    }
    out[id] = a
}

pub fn frame(time: f32, width: u32, height: u32) {
    var out: GpuBuffer<f32> = buffer(1048576)
    dispatch(heavy.bind(mut out), over: 1048576)
}
// ---- fixed
use std::gpu::{GlobalId, GpuBuffer, Slots, buffer, dispatch, kernel_work, limits}

@compute(64)
fn heavy(out: mut Slots<f32>, id: GlobalId) {
    var a = f32(id.x)
    for _i in 0..2000 {
        a = sin(a) + cos(a)
    }
    out[id] = a
}

pub fn frame(time: f32, width: u32, height: u32) {
    var out: GpuBuffer<f32> = buffer(1048576)
    // As many invocations a part as one dispatch's work holds at the kernel's own bound, each
    // part's invocations from where the last left off.
    let each = kernel_work(heavy.bind(mut out))
    let part = max(limits().step_work / max(each / 1000, 1) / 64 * 64, 64)
    var from: u32 = 0
    while from < 1048576 {
        let n = min(part, 1048576 - from)
        dispatch(heavy.bind(mut out), over: n, origin: from)
        from += n
    }
}
