// A shipped build with a pipeline over a budget: one that weighs over 300,000 (its entry point's
// statements with every call written out in place, as a GPU's compiler copies a function into
// each place it's called), or keeps over 16 KiB an invocation in variables of arrays, structs and
// enums (a GPU spills what doesn't fit its registers, and a dispatch of such kernels starved the
// display on 2026-11-13). The error is at the command that records the pipeline. A test, debug
// or lifted build isn't checked. Keep less an invocation (compute each number where it's used,
// or keep the run in a buffer), call a big function from fewer places, or move work its own pass
// can do there.
// ---- wrong
use std::gpu::{GlobalId, GpuBuffer, Slots, buffer, dispatch}

/// A sum of a run of numbers each invocation keeps as its own: 32 KiB of local state.
@compute(64)
fn look(out: mut Slots<f32>, id: GlobalId) {
    var run = [0.0; 8192]
    for i in 0..8192 {
        run[i] = f32(id.x + i)
    }
    var t = 0.0
    for i in 0..8192 {
        t += run[(i * 7) % 8192]
    }
    out[id] = t
}

pub fn frame(time: f32, width: u32, height: u32) {
    var out: GpuBuffer<f32> = buffer(64)
    dispatch(look.bind(mut out), over: 64)
}
// ---- fixed
use std::gpu::{GlobalId, GpuBuffer, Slots, buffer, dispatch}

/// The same sum, each number computed where it's used.
@compute(64)
fn look(out: mut Slots<f32>, id: GlobalId) {
    var t = 0.0
    for i in 0..8192 {
        t += f32(id.x + (i * 7) % 8192)
    }
    out[id] = t
}

pub fn frame(time: f32, width: u32, height: u32) {
    var out: GpuBuffer<f32> = buffer(64)
    dispatch(look.bind(mut out), over: 64)
}
