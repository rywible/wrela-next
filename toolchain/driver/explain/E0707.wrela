// A shipped build for Metal with a pipeline whose MSL is over 288 KiB (Metal compiles each
// pipeline's shader while the scene loads, and the GPU's compiler takes longer than in proportion
// as a shader grows); on either target, one whose pipeline weighs over 300,000 (on Vulkan, the
// budget is the weight alone: RADV's build time follows it, not the SPIR-V's size). The error is
// at the command that records the large
// pipeline. A test, debug or lifted build isn't checked. Move work its own pass can do there,
// keep a big function a call (`ir::opt`), or read a large table from a buffer: a constant's
// elements are written out in the MSL of every pipeline that reads it. (How long a scene's
// pipelines take to create is measured, not counted: `clearing::the_clearing_is_playable_cold_within_its_budget`.)
// ---- wrong
use std::gpu::{GlobalId, GpuBuffer, Slots, buffer, dispatch}

/// A table the kernel reads, each of its numbers written out in the MSL.
const TABLE: [f32; 60000] = [0.5; 60000]

@compute(64)
fn look(out: mut Slots<f32>, id: GlobalId) {
    out[id] = TABLE[id.x % 60000]
}

pub fn frame(time: f32, width: u32, height: u32) {
    var out: GpuBuffer<f32> = buffer(64)
    dispatch(look.bind(mut out), over: 64)
}
// ---- fixed
use std::gpu::{GlobalId, GpuBuffer, Slots, buffer, dispatch, write}

/// The same table, in a buffer the kernel reads.
@compute(64)
fn look(table: [f32], out: mut Slots<f32>, id: GlobalId) {
    out[id] = table[id.x % table.len()]
}

pub fn frame(time: f32, width: u32, height: u32) {
    var table: GpuBuffer<f32> = buffer(60000)
    write(mut table, 0, [0.5; 60000])
    var out: GpuBuffer<f32> = buffer(64)
    dispatch(look.bind(table, mut out), over: 64)
}
