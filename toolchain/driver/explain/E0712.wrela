// GPU code that computes, in every invocation, more than 256 work of a value the same for all of
// them (§18.13) that the compiler can't move onto the CPU: one computed from a buffer or a
// texture read at a place that's the same too. (What's computed only from the uniform block and
// constants, the compiler computes once a command on the CPU itself and passes in.) Every pixel
// (or invocation) computes it again, to the same result. Compute it once for the command, in a
// kernel of one invocation (`@compute(1)`), and pass the result in.
// ---- wrong
use std::gpu::{GlobalId, GpuBuffer, Slots, buffer, dispatch}

@compute(64)
fn shade(times: [f32], out: mut Slots<f32>, id: GlobalId) {
    var a = times[0]
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    out[id] = a * f32(id.x)
}

pub fn frame(time: f32, width: u32, height: u32) {
    let times: GpuBuffer<f32> = buffer(1)
    var out: GpuBuffer<f32> = buffer(64)
    dispatch(shade.bind(times: times.items(), out: mut out), over: 64)
}
// ---- fixed
use std::gpu::{GlobalId, GpuBuffer, Slots, buffer, dispatch}

/// What every invocation would compute alike, computed once: by one invocation.
@compute(1)
fn rounds(times: [f32], out: mut Slots<f32>, id: GlobalId) {
    var a = times[0]
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    a = sin(a) + cos(a)
    out[id] = a
}

@compute(64)
fn shade(a: [f32], out: mut Slots<f32>, id: GlobalId) {
    out[id] = a[0] * f32(id.x)
}

pub fn frame(time: f32, width: u32, height: u32) {
    let times: GpuBuffer<f32> = buffer(1)
    var once: GpuBuffer<f32> = buffer(1)
    var out: GpuBuffer<f32> = buffer(64)
    dispatch(rounds.bind(times: times.items(), out: mut once), groups: 1)
    dispatch(shade.bind(a: once.items(), out: mut out), over: 64)
}
