// A `let` or `var` named like a `const` parameter of its entry point. It hides the parameter:
// what follows reads the local, not the constant the pipeline was made for, and a branch on it
// is no longer folded (§18.1). Give the local another name.
// ---- wrong
use std::gpu::{GlobalId, GpuBuffer, Slots, buffer, dispatch}

@compute(64)
fn blur(out: mut Slots<f32>, id: GlobalId, taps: const u32) {
    let taps = taps * 2
    var x = 0.0
    for i in 0..taps {
        x += f32(i)
    }
    out[id] = x
}

pub struct State {
    out: GpuBuffer<f32>,
}

pub fn init() -> State {
    State { out: buffer(64) }
}

pub fn frame(s: mut State, time: f32, width: u32, height: u32) {
    dispatch(blur.bind(out: mut s.out, taps: 4), groups: 1)
}
// ---- fixed
use std::gpu::{GlobalId, GpuBuffer, Slots, buffer, dispatch}

@compute(64)
fn blur(out: mut Slots<f32>, id: GlobalId, taps: const u32) {
    let both = taps * 2
    var x = 0.0
    for i in 0..both {
        x += f32(i)
    }
    out[id] = x
}

pub struct State {
    out: GpuBuffer<f32>,
}

pub fn init() -> State {
    State { out: buffer(64) }
}

pub fn frame(s: mut State, time: f32, width: u32, height: u32) {
    dispatch(blur.bind(out: mut s.out, taps: 4), groups: 1)
}
