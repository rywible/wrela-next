// A draw whose lanes may do more work than a lane's fuel (language.md §18.11), left as written:
// its loops are bounded, within the line's work at the warm clock, so no lane can run away,
// but on an idle GPU one lane may hold its tile for several times the line, which the guard ends
// only after the fact. Every build names such a draw, so the list can be driven to empty. Here
// every pixel runs 64 × 32 × 32 passes of a few sines: about a million work. Bound it within the
// fuel: fewer passes a draw (the work cut over frames or draws).
// ---- wrong
use std::gpu::{ClipPosition, FragCoord, VertexIndex, begin_screen_pass, draw}

@vertex
fn cover(v: VertexIndex) -> ClipPosition {
    let x = f32((v.index & 1) * 4) - 1.0
    let y = f32((v.index & 2) * 2) - 1.0
    ClipPosition { position: vec4(x, y, 0.0, 1.0) }
}

@fragment
fn heavy(pixel: FragCoord) -> vec4 {
    var x = pixel.position.x * 0.01
    for _i in 0..64 {
        for _j in 0..32 {
            for _k in 0..32 {
                x = sin(x) * 0.999 + cos(x * 1.1) * 0.001
            }
        }
    }
    vec4(vec3(x), 1.0)
}

pub fn frame(time: f32, width: u32, height: u32) {
    let screen = begin_screen_pass(clear: vec4(0.0))
    draw(screen, cover, heavy.bind(), vertices: 3)
    screen.present()
}
// ---- fixed
use std::gpu::{ClipPosition, FragCoord, VertexIndex, begin_screen_pass, draw}

@vertex
fn cover(v: VertexIndex) -> ClipPosition {
    let x = f32((v.index & 1) * 4) - 1.0
    let y = f32((v.index & 2) * 2) - 1.0
    ClipPosition { position: vec4(x, y, 0.0, 1.0) }
}

/// A thirty-second of the passes a draw: the rest over the frames after it.
@fragment
fn heavy(pixel: FragCoord) -> vec4 {
    var x = pixel.position.x * 0.01
    for _i in 0..2 {
        for _j in 0..32 {
            for _k in 0..32 {
                x = sin(x) * 0.999 + cos(x * 1.1) * 0.001
            }
        }
    }
    vec4(vec3(x), 1.0)
}

pub fn frame(time: f32, width: u32, height: u32) {
    let screen = begin_screen_pass(clear: vec4(0.0))
    draw(screen, cover, heavy.bind(), vertices: 3)
    screen.present()
}
