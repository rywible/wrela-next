// GPU code that copies a struct or an array of 256 bytes or more from its uniform block or a
// read-only buffer into each invocation's own memory (§18.13). The compiler reads data passed by
// value where it lies wherever the code only reads it, however it's passed: through methods, a
// copy with a field changed, a loop written out. What's left is a copy the code needs: a part of
// it changed where only the invocation knows (an index), then the whole read again. GPU
// compilers keep such a copy in slow memory, and a pass that reads it can run many times
// slower. Change nothing in it: pass what would change as a value of its own.
// ---- wrong
use std::gpu::{GlobalId, GpuBuffer, Slots, buffer, dispatch}

struct Given: Copy + GpuData {
    parts: [vec4; 20],
}

@compute(64)
fn shade(g: Given, out: mut Slots<f32>, id: GlobalId) {
    var parts = g.parts
    parts[id.x % 20] = vec4(0.0)
    var d = 1.0e9
    for i in 0..20 {
        d = min(d, parts[i].w)
    }
    out[id] = d
}

pub fn frame(time: f32, width: u32, height: u32) {
    var out: GpuBuffer<f32> = buffer(64)
    dispatch(shade.bind(g: Given { parts: [vec4(time); 20] }, out: mut out), over: 64)
}
// ---- fixed
use std::gpu::{GlobalId, GpuBuffer, Slots, buffer, dispatch}

struct Given: Copy + GpuData {
    parts: [vec4; 20],
}

@compute(64)
fn shade(g: Given, out: mut Slots<f32>, id: GlobalId) {
    // The part this invocation leaves out is skipped where it's read, not cleared in a copy.
    let skip = id.x % 20
    var d = 1.0e9
    for i in 0..20 {
        let w = if u32(i) == skip { 0.0 } else { g.parts[i].w }
        d = min(d, w)
    }
    out[id] = d
}

pub fn frame(time: f32, width: u32, height: u32) {
    var out: GpuBuffer<f32> = buffer(64)
    dispatch(shade.bind(g: Given { parts: [vec4(time); 20] }, out: mut out), over: 64)
}
