// The engine's shape of asking a smooth fold where a ray meets it (engine 3a65bf9,
// lib/engine/matter/asked.wrela `Seen::begun`): a thing generic over its field and a const way,
// asked under a branch on that const, its `meets_grown` grown by a width that depends on the ray,
// from a pixel program's loop. A shipped build of it must build: std's own code refused there
// (E0712, `fold_lowering`'s loop over a parameter, 3ef4943 to 0eb05c0) broke the engine's tree.
use std::field::{Meets, RoundCone, SmoothUnion, SmoothUnionAll, Surface, With, round_cone}
use std::gpu::{ClipPosition, FragCoord, VertexIndex, begin_screen_pass, draw}

pub type Body = SmoothUnion<With<SmoothUnionAll<RoundCone, 17>, vec3>, With<RoundCone, vec3>>

fn body() -> Body {
    var parts: [RoundCone; 17] = [round_cone(
        vec3(0.0),
        vec3(0.0, 1.0, 0.0),
        r_top: 0.05,
        r_bottom: 0.1,
    ); 17]
    for i in 0..17 {
        let a = f32(i) * 0.37
        parts[i] = round_cone(
            vec3(0.1 * cos(a), 0.06 * f32(i), 0.1 * sin(a)),
            vec3(0.2 * cos(a), 0.06 * f32(i) + 0.1, 0.2 * sin(a)),
            r_top: 0.03,
            r_bottom: 0.04,
        )
    }
    let wand = round_cone(
        vec3(-0.42, 0.87, -0.04),
        vec3(-0.5, 1.05, 0.26),
        r_top: 0.005,
        r_bottom: 0.005,
    )
    parts
        .smooth_union(k: 0.03)
        .with(vec3(0.42, 0.28, 0.16))
        .smooth_union(wand.with(vec3(0.22, 0.13, 0.07)), k: 0.004)
}

const MET: u32 = 2

pub trait Asked: Copy + GpuData {
    fn begun(self, o: vec3, d: vec3, wide: f32, spread: f32) -> vec2
}

pub struct Seen<M: Surface, const W: u32>: Copy + GpuData {
    pub field: M,
    pub lo: vec3,
    pub hi: vec3,
}

fn box_span(o: vec3, d: vec3, lo: vec3, hi: vec3) -> vec2 {
    let a = (lo - o) / d
    let b = (hi - o) / d
    let n = min(a, b)
    let f = max(a, b)
    vec2(max(max(n.x, n.y), n.z), min(min(f.x, f.y), f.z))
}

impl<M: Surface, const W: u32> Asked for Seen<M, W> {
    fn begun(self, o: vec3, d: vec3, wide: f32, spread: f32) -> vec2 {
        let box = box_span(o, d, self.lo, self.hi)
        var near = box.x
        var far = box.y
        if W == MET && box.y >= box.x && box.y >= 0.0 {
            let m = self.field.meets(o, d)
            if m.exact() && m.near <= m.far {
                near = m.near
                far = m.far
            } else {
                let grow = 0.5 * (wide + spread * max(box.y, 0.0))
                let n = self.field.meets_grown(o, d, grow, 0.0)
                near = max(near, n.near)
                far = min(far, n.far)
            }
        }
        vec2(near, far)
    }
}

@vertex
fn cover(v: VertexIndex) -> ClipPosition {
    let x = f32((v.index << 1) & 2) * 2.0 - 1.0
    let y = f32(v.index & 2) * 2.0 - 1.0
    ClipPosition { position: vec4(x, y, 0.5, 1.0) }
}

@fragment
fn eye<A: Asked>(pixel: FragCoord, a: A, wide: f32, spread: f32) -> vec4 {
    var lit = 0.0
    for k in 0..4 {
        let o = vec3(0.35, 0.95, 1.5)
        let d = normalize(vec3(pixel.position.xy * 0.001 - vec2(0.5), -1.0) + vec3(0.01 * f32(k)))
        let r = a.begun(o, d, wide, spread)
        if r.x <= r.y {
            lit += 0.25
        }
    }
    vec4(vec3(lit), 1.0)
}

pub fn frame(time: f32, width: u32, height: u32) {
    let s: Seen<Body, MET> = Seen {
        field: body(),
        lo: vec3(-1.0, 0.0, -1.0),
        hi: vec3(1.0, 2.0, 1.0),
    }
    let p = begin_screen_pass(clear: vec4(0.0))
    draw(p, cover, eye.bind(a: s, wide: 0.002 + 0.0 * time, spread: 0.001), vertices: 3)
    p.present()
}
