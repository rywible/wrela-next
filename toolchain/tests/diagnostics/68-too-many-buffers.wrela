// mistake: a kernel with more storage buffers than a stage may bind
// expect: E0602
// fix: no
use std::gpu::{GlobalId, Slots}

@compute(64)
fn sum(
    b0: [f32],
    b1: [f32],
    b2: [f32],
    b3: [f32],
    b4: [f32],
    b5: [f32],
    b6: [f32],
    b7: [f32],
    b8: [f32],
    b9: [f32],
    b10: [f32],
    b11: [f32],
    b12: [f32],
    b13: [f32],
    b14: [f32],
    b15: [f32],
    b16: [f32],
    b17: [f32],
    b18: [f32],
    b19: [f32],
    b20: [f32],
    b21: [f32],
    b22: [f32],
    b23: [f32],
    b24: [f32],
    b25: [f32],
    b26: [f32],
    b27: [f32],
    b28: [f32],
    out: mut Slots<f32>,
    id: GlobalId,
) {
    out[id] = b0[id.x] + b1[id.x] + b2[id.x] + b3[id.x] + b4[id.x] + b5[id.x] + b6[id.x] + b7[id.x] + b8[id.x] + b9[id.x] + b10[id.x] + b11[id.x] + b12[id.x] + b13[id.x] + b14[id.x] + b15[id.x] + b16[id.x] + b17[id.x] + b18[id.x] + b19[id.x] + b20[id.x] + b21[id.x] + b22[id.x] + b23[id.x] + b24[id.x] + b25[id.x] + b26[id.x] + b27[id.x] + b28[id.x]
}
