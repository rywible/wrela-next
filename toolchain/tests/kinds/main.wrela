// A kind's things in GPU code (gap 29): thing `i`'s group built in a kernel, its field read
// where it lies in a buffer of the kind's fields, its cells a run of one buffer all the things
// share (`GpuSpan::sub`, at a start and count another buffer holds), passed to a generic
// function that reads the cells by index and their count, and the field's distance; a run of
// the run passed on by itself. Each is checked against the same read made directly. The CPU's
// `sub` keeps the buffer and narrows the range. Frame 0 dispatches; the tests read back, on both
// hosts.
use std::collections::Vec
use std::field::{RoundCone, SmoothUnion, SmoothUnionAll, Surface, With, round_cone}
use std::gpu::{GlobalId, GpuBuffer, GpuSpan, Slots, buffer, buffer_of, dispatch, read}
use std::io::Pending

pub type Body = SmoothUnion<With<SmoothUnionAll<RoundCone, 17>, vec3>, With<RoundCone, vec3>>

fn body(s: f32) -> Body {
    var parts: [RoundCone; 17] = [round_cone(
        vec3(0.0),
        vec3(0.0, 1.0, 0.0),
        r_top: 0.05,
        r_bottom: 0.1,
    ); 17]
    for i in 0..17 {
        parts[i] = round_cone(
            vec3(s * f32(i), 0.0, 0.0),
            vec3(0.0, 0.06 * f32(i) + 0.1, 0.0),
            r_top: 0.03,
            r_bottom: 0.04,
        )
    }
    let wand = round_cone(
        vec3(-0.42, 0.87, -0.04),
        vec3(-0.5, 1.05, 0.26),
        r_top: 0.005,
        r_bottom: 0.005,
    )
    parts.smooth_union(k: 0.03).with(vec3(0.4)).smooth_union(wand.with(vec3(0.2)), k: 0.004)
}

/// The things: 4, each a field and a run of the shared cells.
const THINGS: u32 = 4
const INVOCATIONS: u32 = 64

/// A thing as GPU code sees it: its field, and its cells.
pub borrow struct Seen<M: Surface> {
    pub field: M,
    pub cells: GpuSpan<u32>,
}

/// A run's word `k` and how many it holds, as one number.
fn words(cells: GpuSpan<u32>, k: u32) -> u32 {
    cells[k] + 1000 * cells.len()
}

/// What a generic asker reads of a thing: its cells' word `k` and their count, then its last
/// two words as a run of their own.
fn asked<M: Surface>(s: Seen<M>, k: u32) -> u32 {
    words(s.cells, k) + 100000 * words(s.cells.sub(s.cells.len() - 2, 2), 1)
}

fn distance_of<M: Surface>(s: Seen<M>, p: vec3) -> f32 {
    s.field.distance(p)
}

fn point(id: u32) -> vec3 {
    vec3(f32(id) * 0.01, 0.5, 0.0)
}

/// Thing `id % 4`'s group, built here; what `asked` reads of it, and its distance.
@compute(64)
fn by_group(
    fields: GpuSpan<Body>,
    cells: GpuSpan<u32>,
    runs: GpuSpan<vec2u>,
    words_out: mut Slots<u32>,
    distances: mut Slots<f32>,
    id: GlobalId,
) {
    let i = id.x % THINGS
    let s = Seen { field: fields[i], cells: cells.sub(runs[i].x, runs[i].y) }
    words_out[id] = asked(s, id.x % runs[i].y)
    distances[id] = distance_of(s, point(id.x))
}

/// The same reads made directly.
@compute(64)
fn direct(
    fields: GpuSpan<Body>,
    cells: GpuSpan<u32>,
    runs: GpuSpan<vec2u>,
    words_out: mut Slots<u32>,
    distances: mut Slots<f32>,
    id: GlobalId,
) {
    let i = id.x % THINGS
    let start = runs[i].x
    let count = runs[i].y
    let k = id.x % count
    let first = cells[start + k] + 1000 * count
    let last = cells[start + count - 1] + 1000 * 2
    words_out[id] = first + 100000 * last
    distances[id] = fields[i].distance(point(id.x))
}

pub struct State {
    frame: u32,
    pending: Vec<Pending<u32>>,
    pending_f: Vec<Pending<f32>>,
    words: Vec<Vec<u32>>,
    distances: Vec<Vec<f32>>,
    cpu_len: u32,
}

pub fn init() -> State {
    State {
        frame: 0,
        pending: Vec::new(),
        pending_f: Vec::new(),
        words: Vec::new(),
        distances: Vec::new(),
        cpu_len: 0,
    }
}

pub fn frame(s: mut State, time: f32, width: u32, height: u32) {
    if s.frame == 0 {
        let fields: GpuBuffer<Body> = buffer_of([body(0.0), body(0.01), body(0.02), body(0.03)])
        let cells: GpuBuffer<u32> = buffer_of(
            [10, 11, 12, 20, 21, 22, 23, 30, 31, 40, 41, 42, 43, 44],
        )
        let runs: GpuBuffer<vec2u> = buffer_of([vec2u(0, 3), vec2u(3, 4), vec2u(7, 2), vec2u(9, 5)])
        s.cpu_len = cells.items().sub(start: 3, count: 4).sub(start: 1, count: 2).len()
        var w0: GpuBuffer<u32> = buffer(INVOCATIONS)
        var d0: GpuBuffer<f32> = buffer(INVOCATIONS)
        var w1: GpuBuffer<u32> = buffer(INVOCATIONS)
        var d1: GpuBuffer<f32> = buffer(INVOCATIONS)
        dispatch(
            by_group.bind(fields.items(), cells.items(), runs.items(), mut w0, mut d0),
            over: INVOCATIONS,
        )
        dispatch(
            direct.bind(fields.items(), cells.items(), runs.items(), mut w1, mut d1),
            over: INVOCATIONS,
        )
        s.pending.push(read(w0.items()))
        s.pending.push(read(w1.items()))
        s.pending_f.push(read(d0.items()))
        s.pending_f.push(read(d1.items()))
    }
    for i in 0..s.pending.len() {
        if s.words.len() == i {
            if let Some(Ok(v)) = s.pending[i].poll() {
                s.words.push(take v)
            }
        }
    }
    for i in 0..s.pending_f.len() {
        if s.distances.len() == i {
            if let Some(Ok(v)) = s.pending_f[i].poll() {
                s.distances.push(take v)
            }
        }
    }
    s.frame += 1
}

/// A thing's group built in GPU code reads its run of the shared cells as the direct reads do,
/// and its field's distance to the bit.
@test(frames: 4, gpu: true, hosts: both)
fn a_kinds_thing_is_a_group_built_in_a_shader(s: State) {
    assert(s.words.len() == 2 && s.distances.len() == 2)
    for i in 0..INVOCATIONS {
        assert(s.words[0][i] == s.words[1][i])
        assert(s.distances[0][i] == s.distances[1][i])
    }
}

/// On the CPU, a sub-range of a sub-range holds what it was asked for.
@test(frames: 1)
fn the_cpus_sub_narrows_the_range(s: State) {
    assert(s.cpu_len == 2)
}
