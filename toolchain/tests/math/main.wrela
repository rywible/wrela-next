// std's math (std/math.wrela), the CPU's and a strict GPU kernel's, exported for
// toolchain/tests/tests/suite/math.rs: each function is checked against a correctly rounded
// reference, and measured for every argument (`worst_ulps`). The interval interpretation's
// widening relies on their errors, `std::math::STRICT_ULPS`. Also std's fields
// (std/field.wrela), against references at their edge cases.
use std::field::{Noise, Surface, ellipsoid, fbm, half_space, round_cone, smin, sphere, value_noise}

pub fn frame(time: f32, width: u32, height: u32) {}

/// The most error of `STRICT_ULPS`'s function `k` over the arguments whose bits are `start` to
/// `start + count - 1` (the second argument of `atan2` and `pow` the first's, turned: its bits'
/// halves swapped), against the f64 functions; and the bits of the worst argument.
pub fn worst_ulps(k: u32, start: u32, count: u32) -> (f64, u32) {
    var worst = 0.0
    var at: u32 = start
    for i in 0..count {
        let bits = start.wrapping_add(i)
        let x = bitcast_f32(bits)
        let y = bitcast_f32((bits << 16) | (bits >> 16))
        let (got, want) = std::math::strict_and_reference(k, x, y)
        let u = std::math::f32_ulps(got, want)
        if u > worst {
            worst = u
            at = bits
        }
    }
    (worst, at)
}

/// `std::math::sqrt_rounded` and `std::math::rem_exact`: a strict kernel's `sqrt` and `%`.
pub fn f_sqrt_rounded(x: f32) -> f32 {
    std::math::sqrt_rounded(x)
}

pub fn f_rem_exact(a: f32, b: f32) -> f32 {
    std::math::rem_exact(a, b)
}

/// How many of the positive normal arguments whose bits are `start` to `start + count - 1`
/// `std::math::sqrt_from` doesn't give the CPU's root for, from the root or either of its two
/// neighbours, and the first such bits.
pub fn sqrt_from_differences(start: u32, count: u32) -> (u32, u32) {
    var n: u32 = 0
    var first: u32 = 0
    for i in 0..count {
        let bits = start.wrapping_add(i)
        if bits < 0x800000 || bits >= 0x7f800000 {
            continue
        }
        let x = bitcast_f32(bits)
        let want = sqrt(x)
        let w = bitcast_u32(want)
        for r in [w - 1, w, w + 1] {
            if bitcast_u32(std::math::sqrt_from(x, bitcast_f32(r))) != w {
                if n == 0 {
                    first = bits
                }
                n += 1
            }
        }
    }
    (n, first)
}

/// How many of `count` pairs of floats, drawn by a fixed sequence from `seed` (every other pair
/// with a subnormal operand or a quotient near the least normal, every eighth a pair of the hard
/// ones), `std::math::div_from` doesn't give the strict model's quotient for (the CPU's
/// division of the operands with their subnormals zeros, a zero where the exact quotient is
/// below the least normal), from the quotient of their significands moved by each of -3 to 3
/// of its ulps; and the first such pair's place in the sequence.
pub fn div_from_differences(seed: u32, count: u32) -> (u32, u32) {
    let hard = [
        1.0, 3.0, 0.33333334, 0.6666667, 1.9999999, 1.0000001, 16777215.0, 8388609.0,
        1.1754944e-38, 3.4028235e38, 2.3509887e-38, 1.7014118e38, 0.99999994, 5.0, 7.0, 1.5,
    ]
    var n: u32 = 0
    var first: u32 = 0
    for i in 0..count {
        let k = seed.wrapping_add(i)
        var xb = std::hash::pcg(k.wrapping_mul(2).wrapping_add(1))
        var yb = std::hash::pcg(k.wrapping_mul(2).wrapping_add(2) ^ 0x9e3779b9)
        if k % 8 == 7 {
            xb = bitcast_u32(hard[(k >> 3) % 16]) | (xb & 0x80000000)
            yb = bitcast_u32(hard[(k >> 7) % 16]) | (yb & 0x80000000)
        } else if k % 2 == 1 {
            // A subnormal or small operand, and one that brings the quotient near the least normal.
            xb = xb & 0x80ffffff
            yb = (yb & 0x807fffff) | (std::hash::pcg(k ^ 0x51ed) & 0x3f800000)
        }
        let x = bitcast_f32(xb)
        let y = bitcast_f32(yb)
        // The strict model's quotient, from f64s (exact before the one rounding).
        let fx = if (xb & 0x7f800000) == 0 { bitcast_f32(xb & 0x80000000) } else { x }
        let fy = if (yb & 0x7f800000) == 0 { bitcast_f32(yb & 0x80000000) } else { y }
        let exact = f64(fx) / f64(fy)
        let ieee = fx / fy
        let tiny = exact != 0.0 && abs(exact) < 1.1754943508222875e-38
        let flushed = (bitcast_u32(ieee) & 0x7f800000) == 0
        let want = if tiny || flushed { bitcast_f32((xb ^ yb) & 0x80000000) } else { ieee }
        let want = if ieee != ieee { ieee } else { want }
        let sa = bitcast_f32((xb & 0x7fffff) | 0x3f800000)
        let sb = bitcast_f32((yb & 0x7fffff) | 0x3f800000)
        let r = sa / sb
        // An ulp of the quotient: of [1/2, 1) where the first significand is the less.
        let ulp = if (xb & 0x7fffff) < (yb & 0x7fffff) { 5.9604645e-8 } else { 1.1920929e-7 }
        for off in [-3.0, -2.0, -1.0, 0.0, 1.0, 2.0, 3.0] {
            let got = std::math::div_from(x, y, r + off * ulp)
            let same = bitcast_u32(got) == bitcast_u32(want) || (got != got && want != want)
            if !same {
                if n == 0 {
                    first = i
                }
                n += 1
            }
        }
    }
    (n, first)
}

/// How many of the arguments whose bits are `start` to `start + count - 1` `sqrt_rounded` gives
/// other bits for than the CPU's `sqrt` (a subnormal is a zero to it), and the first such bits.
pub fn sqrt_differences(start: u32, count: u32) -> (u32, u32) {
    var n: u32 = 0
    var first: u32 = 0
    for i in 0..count {
        let bits = start.wrapping_add(i)
        let x = bitcast_f32(bits)
        let flushed = if (bits & 0x7fffffff) < 0x800000 { bitcast_f32(bits & 0x80000000) } else {
            x
        }
        let want = sqrt(flushed)
        let got = std::math::sqrt_rounded(x)
        let same = bitcast_u32(got) == bitcast_u32(want) || (got != got && want != want)
        if !same {
            if n == 0 {
                first = bits
            }
            n += 1
        }
    }
    (n, first)
}

/// The error `STRICT_ULPS` states of function `k`.
pub fn stated_ulps(k: u32) -> f32 {
    std::math::STRICT_ULPS[k]
}

pub fn f_sin(x: f32) -> f32 {
    sin(x)
}

pub fn f_cos(x: f32) -> f32 {
    cos(x)
}

pub fn f_tan(x: f32) -> f32 {
    tan(x)
}

pub fn f_exp(x: f32) -> f32 {
    exp(x)
}

pub fn f_sinh(x: f32) -> f32 {
    sinh(x)
}

pub fn f_cosh(x: f32) -> f32 {
    cosh(x)
}

pub fn f_tanh(x: f32) -> f32 {
    tanh(x)
}

pub fn f_exp2(x: f32) -> f32 {
    exp2(x)
}

pub fn f_log(x: f32) -> f32 {
    log(x)
}

pub fn f_log2(x: f32) -> f32 {
    log2(x)
}

pub fn f_pow(x: f32, y: f32) -> f32 {
    pow(x, y)
}

pub fn f_atan(x: f32) -> f32 {
    atan(x)
}

pub fn f_atan2(y: f32, x: f32) -> f32 {
    atan2(y, x)
}

pub fn f_asin(x: f32) -> f32 {
    asin(x)
}

pub fn f_acos(x: f32) -> f32 {
    acos(x)
}

pub fn f_smin(a: f32, b: f32, k: f32) -> f32 {
    smin(a, b, k)
}

/// Two unit spheres at x = -1 and x = 1, blended over `k`: the plane x = 0 is the seam.
pub fn f_blend(x: f32, y: f32, z: f32, k: f32) -> f32 {
    sphere(1.0).translate(vec3(x: -1.0)).smooth_union(sphere(1.0).translate(vec3(x: 1.0)), k: k)
        .distance(vec3(x, y, z))
}

pub fn f_round_cone(a: vec3, b: vec3, r1: f32, r2: f32, p: vec3) -> f32 {
    round_cone(a, b, r1, r2).distance(p)
}

pub fn f_ellipsoid(radii: vec3, p: vec3) -> f32 {
    ellipsoid(radii).distance(p)
}

pub fn f_half_space(normal: vec3, offset: f32, p: vec3) -> f32 {
    half_space(normal, offset).distance(p)
}

pub fn f_value_noise(p: vec3) -> f32 {
    value_noise(p)
}

pub fn f_fbm(p: vec3) -> f32 {
    fbm(freq: 1.0, octaves: 4).value(p)
}
