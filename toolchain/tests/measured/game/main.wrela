// A game reading what its build measured (`../tool`'s table, embedded): which of a kind of
// thing's ways is the cheaper, a constant of the build, from times where the build had a GPU and
// from the compiler's counts where it didn't. The table is `measured.bin` beside this file,
// which the measuring tool writes.

/// The table's bytes, as the build found them.
const TABLE: Bytes = embed("measured.bin")

/// Way `i`'s number: its time (us) or its count.
fn number(i: u32) -> f32 {
    TABLE.f32_le(12 + 4 * i)
}

/// Which way is the cheaper, by the table.
const CHEAPER: u32 = if number(1) < number(0) { 1 } else { 0 }

/// Whether the table's numbers are times (1) or counts (0).
const TIMED: u32 = TABLE.u32_le(8)

pub fn cheaper() -> u32 {
    CHEAPER
}

pub fn timed() -> u32 {
    TIMED
}

pub fn frame(time: f32, width: u32, height: u32) {}
