// A program that does its own output transform, as an engine's last pass does
// (compiler/tests/tests/suite/screen.rs): a ramp of scene light, a different curve in each
// channel and in each row, past white at the right; an SDR screen gets it clipped to white and
// sRGB-encoded, an HDR screen (asked for at the first frame) the light itself. Below white, the
// two screens must hold the same light: the host's 8-bit and half-float screens each keep what
// the program drew.

use std::gpu::{
    ClipPosition, FragCoord, Gamut, VertexIndex, begin_screen_pass, draw, screen, screen_is,
}

pub struct S {
    frames: u32,
}

/// What the fragment knows of the screen.
struct Out: Copy + GpuData {
    hdr: f32,
    width: f32,
    height: f32,
}

pub fn init() -> S {
    S { frames: 0 }
}

@vertex
fn cover(v: VertexIndex) -> ClipPosition {
    let x = f32((v.index << 1) & 2) * 2.0 - 1.0
    let y = f32(v.index & 2) * 2.0 - 1.0
    ClipPosition { position: vec4(x, y, 0.5, 1.0) }
}

/// IEC 61966-2-1's curve: linear light to its sRGB value.
fn srgb(x: f32) -> f32 {
    if x <= 0.0031308 { 12.92 * x } else { 1.055 * pow(max(x, 0.0), 1.0 / 2.4) - 0.055 }
}

@fragment
fn light(pixel: FragCoord, out: Out) -> vec4 {
    let t = pixel.position.x / out.width
    let u = pixel.position.y / out.height
    let l = vec3(1.5 * t, 1.2 * t * t * (0.5 + u), 0.9 * (1.0 - t) * u)
    if out.hdr > 0.5 {
        vec4(l, 1.0)
    } else {
        vec4(srgb(min(l.x, 1.0)), srgb(min(l.y, 1.0)), srgb(min(l.z, 1.0)), 1.0)
    }
}

pub fn frame(s: mut S, time: f32, width: u32, height: u32) {
    if s.frames == 0 {
        screen(hdr: true, gamut: Gamut::Srgb)
    }
    s.frames += 1
    let hdr = if screen_is().hdr { 1.0 } else { 0.0 }
    let out = Out { hdr: hdr, width: f32(width), height: f32(height) }
    let p = begin_screen_pass(clear: vec4(0.0))
    draw(p, cover, light.bind(out: out), vertices: 3)
    p.present()
}

/// Bit 0: the screen is HDR.
pub fn shown(s: S) -> u32 {
    u32(screen_is().hdr)
}
