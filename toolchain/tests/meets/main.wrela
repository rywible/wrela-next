// Where a ray meets a surface, in closed form (§20.5, `Surface::meets`): the engine's stage (two
// boxes and a ball, joined sharply: exact, no march) and its creature (seventeen round cones and
// a wand, joined smoothly: a stretch that holds it, then a march from its start), each drawn a
// frame two ways at the screen's size: marched from its bound's sphere (`marched`), and from
// `meets` (`met`). The hosts' timings say which is faster (labels `stage marched`, `stage met`,
// `creature marched`, `creature met`, alternating order by frame); a compare pass shades both
// pictures by each hit's facing to 8 bits and counts the pixels they differ in.
use std::collections::Vec
use std::field::{Bound, Cuboid, RoundCone, SmoothUnion, SmoothUnionAll, Sphere, Surface, Translate, Union, With, cuboid, round_cone, sphere}
use std::gpu::{
    ClipPosition, FragCoord, GlobalId, GpuBuffer, Rg32Float, Rgba32Float, Slots, Texture, VertexIndex, begin_pass,
    begin_screen_pass, buffer, dispatch, draw, label, read, texture,
}
use std::io::{Pending, print}

pub type Block = With<Translate<Cuboid>, vec3>
pub type Ball = With<Translate<Sphere>, vec3>
pub type Stage = Union<Union<Block, Block>, Ball>

/// The engine's stage (branch engine 393d403, game/world/stage.wrela), its substances colours.
fn stage() -> Stage {
    let ground = cuboid(vec3(8.0, 0.25, 8.0)).translate(vec3(0.0, -0.25, 0.0)).with(vec3(0.36, 0.35, 0.33))
    let wall = cuboid(vec3(3.0, 1.5, 0.1)).translate(vec3(0.0, 1.5, 0.0)).with(vec3(0.42, 0.17, 0.11))
    let ball = sphere(1.0).translate(vec3(-4.5, 1.0, 3.0)).with(vec3(0.33, 0.42, 0.55))
    ground.union(wall).union(ball)
}

pub type Body = SmoothUnion<With<SmoothUnionAll<RoundCone, 17>, vec3>, With<RoundCone, vec3>>

/// The engine's creature at rest (as toolchain/tests/masked).
fn body() -> Body {
    let parts = [
        round_cone(vec3(0.0, 0.5694, -0.0258), vec3(0.0, 0.7866, 0.0042), r_top: 0.102, r_bottom: 0.096),
        round_cone(vec3(0.0, 0.7866, 0.0042), vec3(0.0, 0.912, -0.0246), r_top: 0.096, r_bottom: 0.06),
        round_cone(vec3(0.0, 1.02, 0.0018), vec3(0.0, 1.056, 0.0078), r_top: 0.15, r_bottom: 0.138),
        round_cone(vec3(0.1272, 0.873, -0.039), vec3(0.2778, 0.873, -0.0438), r_top: 0.039, r_bottom: 0.0348),
        round_cone(vec3(0.2778, 0.873, -0.0438), vec3(0.4236, 0.873, -0.039), r_top: 0.0348, r_bottom: 0.03),
        round_cone(vec3(0.4236, 0.873, -0.039), vec3(0.4932, 0.8706, -0.03), r_top: 0.03, r_bottom: 0.027),
        round_cone(vec3(0.0684, 0.5826, -0.0216), vec3(0.0684, 0.3252, -0.0216), r_top: 0.054, r_bottom: 0.0432),
        round_cone(vec3(0.0684, 0.3252, -0.0216), vec3(0.0684, 0.0516, -0.0528), r_top: 0.0432, r_bottom: 0.0336),
        round_cone(vec3(0.0684, 0.0516, -0.0528), vec3(0.0684, 0.009, 0.033), r_top: 0.0336, r_bottom: 0.0276),
        round_cone(vec3(0.078, 1.14, 0.0018), vec3(0.12, 1.272, -0.0102), r_top: 0.03, r_bottom: 0.0075),
        round_cone(vec3(-0.1272, 0.873, -0.039), vec3(-0.2778, 0.873, -0.0438), r_top: 0.039, r_bottom: 0.0348),
        round_cone(vec3(-0.2778, 0.873, -0.0438), vec3(-0.4236, 0.873, -0.039), r_top: 0.0348, r_bottom: 0.03),
        round_cone(vec3(-0.4236, 0.873, -0.039), vec3(-0.4932, 0.8706, -0.03), r_top: 0.03, r_bottom: 0.027),
        round_cone(vec3(-0.0684, 0.5826, -0.0216), vec3(-0.0684, 0.3252, -0.0216), r_top: 0.054, r_bottom: 0.0432),
        round_cone(vec3(-0.0684, 0.3252, -0.0216), vec3(-0.0684, 0.0516, -0.0528), r_top: 0.0432, r_bottom: 0.0336),
        round_cone(vec3(-0.0684, 0.0516, -0.0528), vec3(-0.0684, 0.009, 0.033), r_top: 0.0336, r_bottom: 0.0276),
        round_cone(vec3(-0.078, 1.14, 0.0018), vec3(-0.12, 1.272, -0.0102), r_top: 0.03, r_bottom: 0.0075),
    ]
    let wand = round_cone(vec3(-0.4236, 0.873, -0.039), vec3(-0.4956, 1.053, 0.261), r_top: 0.00504, r_bottom: 0.00504)
    parts.smooth_union(k: 0.03).with(vec3(0.42, 0.28, 0.16)).smooth_union(wand.with(vec3(0.22, 0.13, 0.07)), k: 0.004)
}

/// Where a picture is taken from.
pub struct View: Copy + GpuData {
    pub eye: vec3,
    pub width: f32,
    pub fwd: vec3,
    pub height: f32,
    pub right: vec3,
    pub tan: f32,
    pub up: vec3,
    pub spare: f32,
}

fn looking(eye: vec3, at: vec3, width: u32, height: u32) -> View {
    let fwd = normalize(at - eye)
    let right = normalize(cross(fwd, vec3(0.0, 1.0, 0.0)))
    let up = cross(right, fwd)
    View { eye, fwd, right, up, width: f32(width), height: f32(height), tan: 0.45, spare: 0.0 }
}

/// The stage from where the engine's eye stands; the creature close, as the masked fixture.
fn stage_view(width: u32, height: u32) -> View {
    looking(vec3(2.0, 2.2, 9.0), vec3(-0.5, 0.8, 0.0), width, height)
}

fn body_view(width: u32, height: u32) -> View {
    looking(vec3(0.35, 0.95, 1.5), vec3(0.0, 0.66, 0.0), width, height)
}

/// The ray through a pixel.
fn ray(v: View, px: vec2) -> (vec3, vec3) {
    let a = v.width / v.height
    let s = (2.0 * px.x / v.width - 1.0) * v.tan * a
    let u = (1.0 - 2.0 * px.y / v.height) * v.tan
    (v.eye, normalize(v.fwd + v.right * s + v.up * u))
}

/// How near a march counts as a hit (m), and the most steps it takes.
const NEAR: f32 = 0.0002
const STEPS: u32 = 512

/// The march from `t0` to `t1`: where it met the surface (-1 where it didn't), and its steps.
fn march<S: Surface>(s: S, o: vec3, d: vec3, t0: f32, t1: f32) -> vec2 {
    var t = t0
    var steps: u32 = 0
    var hit = false
    while steps < STEPS && t <= t1 && !hit {
        let f = s.distance(o + d * t)
        if f < NEAR {
            hit = true
        } else {
            t += f
            steps += 1
        }
    }
    vec2(if hit { t } else { -1.0 }, f32(steps))
}

/// Where the ray is in a surface's bound's sphere (`x > y` where it misses it).
fn bounded(b: Bound, o: vec3, d: vec3) -> vec2 {
    let oc = o - b.centre
    let p = dot(oc, d)
    let h = p * p - (dot(oc, oc) - b.radius * b.radius)
    if h < 0.0 {
        return vec2(1.0, 0.0)
    }
    let r = sqrt(h)
    vec2(max(-p - r, 0.0), -p + r)
}

@vertex
fn cover(v: VertexIndex) -> ClipPosition {
    let x = f32((v.index << 1) & 2) * 2.0 - 1.0
    let y = f32(v.index & 2) * 2.0 - 1.0
    ClipPosition { position: vec4(x, y, 0.5, 1.0) }
}

/// Marched from the bound's sphere (`b`, the surface's, found on the CPU).
@fragment
fn marched<S: Surface>(pixel: FragCoord, v: View, s: S, b: Bound) -> vec2 {
    let (o, d) = ray(v, pixel.position.xy)
    let r = bounded(b, o, d)
    if r.x > r.y {
        return vec2(-1.0, 0.0)
    }
    march(s, o, d, r.x, r.y)
}

/// Met: where `meets` is exact, its `near`; else the march over its stretch. A ray that misses
/// the bound's sphere misses, as the march's does (the engine draws a thing only over its
/// bound's rectangle).
@fragment
fn met<S: Surface>(pixel: FragCoord, v: View, s: S, b: Bound) -> vec2 {
    let (o, d) = ray(v, pixel.position.xy)
    let r = bounded(b, o, d)
    if r.x > r.y {
        return vec2(-1.0, 0.0)
    }
    let m = s.meets(o, d)
    if m.is_empty() {
        return vec2(-1.0, 0.0)
    }
    if m.exact() {
        return vec2(m.near, 0.0)
    }
    march(s, o, d, m.near, m.far)
}

/// A hit shaded by its facing, to 8 bits (0 where nothing was met).
fn shade<S: Surface>(s: S, o: vec3, d: vec3, t: f32) -> f32 {
    if t < 0.0 {
        return 0.0
    }
    let n = normalize(s.gradient(o + d * t))
    round((0.15 + 0.8 * max(dot(n, normalize(vec3(0.4, 1.0, 0.6))), 0.0)) * 255.0)
}

/// The two pictures compared at a pixel: whether one met the surface and the other didn't, how
/// far apart their shades are (in 255ths), how far apart their hits are along the ray, and the
/// two's steps.
@fragment
fn compared<S: Surface>(pixel: FragCoord, v: View, s: S, a: Texture<Rg32Float>, b: Texture<Rg32Float>) -> vec4 {
    let (o, d) = ray(v, pixel.position.xy)
    let p = vec2u(u32(pixel.position.x), u32(pixel.position.y))
    let x = a.load(p.x, p.y)
    let y = b.load(p.x, p.y)
    let missed = if (x.x < 0.0) != (y.x < 0.0) { 1.0 } else { 0.0 }
    let apart = if x.x >= 0.0 && y.x >= 0.0 { abs(x.x - y.x) } else { 0.0 }
    vec4(missed, abs(shade(s, o, d, x.x) - shade(s, o, d, y.x)), apart, x.y + 4096.0 * y.y)
}

/// A row of a comparison: pixels that met in one only, whose shades differ by more than 1/255,
/// that met in both; the farthest apart two hits are; the two's steps.
pub struct Row: Copy + GpuData + Plain {
    pub missed: u32,
    pub shaded: u32,
    pub both: u32,
    pub apart: f32,
    pub steps_a: f32,
    pub steps_b: f32,
}

@compute(64)
fn rows(c: Texture<Rgba32Float>, met: Texture<Rg32Float>, width: u32, height: u32, out: mut Slots<Row>, id: GlobalId) {
    if id.x >= height {
        return
    }
    var r = Row { missed: 0, shaded: 0, both: 0, apart: 0.0, steps_a: 0.0, steps_b: 0.0 }
    for x in 0..min(width, 4096) {
        let q = c.load(x, id.x)
        let m = met.load(x, id.x)
        if q.x > 0.5 {
            r.missed += 1
        }
        if q.y > 1.0 {
            r.shaded += 1
        }
        if m.x >= 0.0 && q.x < 0.5 {
            r.both += 1
            r.apart = max(r.apart, q.z)
        }
        r.steps_b += floor(q.w / 4096.0)
        r.steps_a += q.w - 4096.0 * floor(q.w / 4096.0)
    }
    out[id] = r
}

/// What a scene's comparison found, summed over its rows.
pub struct Found: Copy {
    pub missed: u32,
    pub shaded: u32,
    pub both: u32,
    pub apart: f32,
    pub steps_a: f32,
    pub steps_b: f32,
}

pub struct Meets {
    frames: u32,
    size: vec2u,
    pictures: [Texture<Rg32Float>; 4],
    compared: [Texture<Rgba32Float>; 2],
    rows: [Vec<Pending<Row>>; 2],
    found: [Found; 2],
    read: u32,
}

const NONE: Found = Found { missed: 4294967295, shaded: 4294967295, both: 0, apart: 0.0, steps_a: 0.0, steps_b: 0.0 }

pub fn init() -> Meets {
    Meets {
        frames: 0,
        size: vec2u(0, 0),
        pictures: [texture(width: 1, height: 1), texture(width: 1, height: 1), texture(width: 1, height: 1), texture(width: 1, height: 1)],
        compared: [texture(width: 1, height: 1), texture(width: 1, height: 1)],
        rows: [Vec::new(), Vec::new()],
        found: [NONE, NONE],
        read: 0,
    }
}

pub fn frame(s: mut Meets, time: f32, width: u32, height: u32) {
    if s.size.x != width || s.size.y != height {
        for i in 0..4 {
            s.pictures[i] = texture(width, height)
        }
        for i in 0..2 {
            s.compared[i] = texture(width, height)
        }
        s.size = vec2u(width, height)
    }
    let (st, bd) = (stage(), body())
    let (sv, bv) = (stage_view(width, height), body_view(width, height))
    // The four in turn, which way first alternating by frame.
    for k in 0..2 {
        if (k + s.frames) % 2 == 0 {
            label("stage marched")
            let p = begin_pass(mut s.pictures[0], clear: vec4(0.0))
            draw(p, cover, marched.bind(v: sv, s: st, b: st.bound()), vertices: 3)
            p.end()
            label("creature marched")
            let q = begin_pass(mut s.pictures[2], clear: vec4(0.0))
            draw(q, cover, marched.bind(v: bv, s: bd, b: bd.bound()), vertices: 3)
            q.end()
        } else {
            label("stage met")
            let p = begin_pass(mut s.pictures[1], clear: vec4(0.0))
            draw(p, cover, met.bind(v: sv, s: st, b: st.bound()), vertices: 3)
            p.end()
            label("creature met")
            let q = begin_pass(mut s.pictures[3], clear: vec4(0.0))
            draw(q, cover, met.bind(v: bv, s: bd, b: bd.bound()), vertices: 3)
            q.end()
        }
    }
    if s.frames == 1 {
        label("compared")
        let p = begin_pass(mut s.compared[0], clear: vec4(0.0))
        draw(p, cover, compared.bind(v: sv, s: st, a: s.pictures[0], b: s.pictures[1]), vertices: 3)
        p.end()
        let q = begin_pass(mut s.compared[1], clear: vec4(0.0))
        draw(q, cover, compared.bind(v: bv, s: bd, a: s.pictures[2], b: s.pictures[3]), vertices: 3)
        q.end()
        for i in 0..2 {
            var out: GpuBuffer<Row> = buffer(height)
            dispatch(rows.bind(c: s.compared[i], met: s.pictures[2 * i + 1], width: width, height: height, out: mut out), over: height)
            s.rows[i].push(read(out.items()))
        }
    }
    label("shown")
    let p = begin_screen_pass(clear: vec4(0.0))
    draw(p, cover, shown.bind(a: s.pictures[1]), vertices: 3)
    p.present()
    s.frames += 1
    for i in 0..2 {
        for j in 0..u32(s.rows[i].len()) {
            if let Some(Ok(rs)) = s.rows[i][j].poll() {
                var f = Found { missed: 0, shaded: 0, both: 0, apart: 0.0, steps_a: 0.0, steps_b: 0.0 }
                for r in rs {
                    f.missed += r.missed
                    f.shaded += r.shaded
                    f.both += r.both
                    f.apart = max(f.apart, r.apart)
                    f.steps_a += r.steps_a
                    f.steps_b += r.steps_b
                }
                let n = f32(width * height)
                let name = if i == 0 { "stage" } else { "creature" }
                print(f"meets: {name}: of {width * height} pixels, {f.missed} met by one way only, {f.shaded} shaded more than 1/255 apart; {f.both} met by both, at most {f.apart} m apart; steps a pixel {f.steps_a / n} marched, {f.steps_b / n} met")
                s.found[i] = f
                s.read += 1
            }
        }
    }
}

/// A picture, shaded by its hits' distance.
@fragment
fn shown(pixel: FragCoord, a: Texture<Rg32Float>) -> vec4 {
    let r = a.load(u32(pixel.position.x), u32(pixel.position.y))
    if r.x < 0.0 { vec4(0.1, 0.1, 0.12, 1.0) } else { vec4(vec3(clamp(1.0 - r.x * 0.08, 0.0, 1.0)), 1.0) }
}

/// Scene `i`'s pixels met by one way only, and shaded more than 1/255 apart (all ones until read).
pub fn missed(s: Meets, i: u32) -> u32 {
    s.found[i].missed
}

pub fn shaded(s: Meets, i: u32) -> u32 {
    s.found[i].shaded
}

/// Scene `i`'s farthest apart hits (m).
pub fn apart(s: Meets, i: u32) -> f32 {
    s.found[i].apart
}

/// How many scenes' comparisons have been read.
pub fn compared_scenes(s: Meets) -> u32 {
    s.read
}
