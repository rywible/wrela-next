// Fuel (compiler/ir/src/fuel.rs, AGENTS.md rule 2): tests/suite/fuel.rs checks that a pipeline
// whose loops the compiler bounds within a lane's fuel is written as it was, with no counter
// and no flag, and that one it can't bound is charged: under its fuel it draws, and the frame
// whose lanes would go over ends the run naming its pass.
use std::gpu::{ClipPosition, FragCoord, Rgba32Float, Texture, VertexIndex, begin_pass, draw, label, texture}

/// Each lane's passes: under the fuel on the first frames, far over it from frame `OVER_AT`.
const UNDER: u32 = 1000
const OVER: u32 = 1000000
const OVER_AT: u32 = 3

@vertex
fn cover(v: VertexIndex) -> ClipPosition {
    let x = f32((v.index << 1) & 2) * 2.0 - 1.0
    let y = f32(v.index & 2) * 2.0 - 1.0
    ClipPosition { position: vec4(x, y, 0.5, 1.0) }
}

/// A loop of a count the compiler doesn't know: charged.
@fragment
fn march(pixel: FragCoord, passes: u32) -> vec4 {
    var x = pixel.position.x * 0.001
    var n: u32 = 0
    while n < passes {
        x = x * 0.5 + 1.0
        n += 1
    }
    vec4(x, f32(n), 0.0, 1.0)
}

/// A loop of 64 passes: within the fuel, so no counter.
@fragment
fn fixed(pixel: FragCoord) -> vec4 {
    var x = pixel.position.x * 0.001
    for _i in 0..64 {
        x = x * 0.5 + 1.0
    }
    vec4(x, 0.0, 0.0, 1.0)
}

/// Just under the line's work at the warm clock on Metal (a bound the count sees): left as
/// written, and named (W0016).
@fragment
fn under_line(pixel: FragCoord) -> vec4 {
    var x = pixel.position.x * 0.01
    for _i in 0..152 {
        for _j in 0..32 {
            for _k in 0..32 {
                x = sin(x) * 0.999 + cos(x * 1.1) * 0.001
            }
        }
    }
    vec4(x, 0.0, 0.0, 1.0)
}

/// Just over it: charged (and never drawn: its lanes would run out).
@fragment
fn over_line(pixel: FragCoord) -> vec4 {
    var x = pixel.position.x * 0.01
    for _i in 0..162 {
        for _j in 0..32 {
            for _k in 0..32 {
                x = sin(x) * 0.999 + cos(x * 1.1) * 0.001
            }
        }
    }
    vec4(x, 0.0, 0.0, 1.0)
}

pub struct S {
    t: Texture<Rgba32Float>,
    frames: u32,
}

pub fn init() -> S {
    S { t: texture(width: 64, height: 64), frames: 0 }
}

pub fn frame(s: mut S, time: f32, width: u32, height: u32) {
    s.frames += 1
    label("bounded")
    let a = begin_pass(mut s.t, clear: vec4(0.0))
    draw(a, cover, fixed.bind(), vertices: 3)
    a.end()
    label("bounded heavy")
    let h = begin_pass(mut s.t, clear: vec4(0.0))
    h.scissor(0, 0, 1, 1)
    draw(h, cover, under_line.bind(), vertices: 3)
    if s.frames == 0 {
        // (Recorded, so it's built; never drawn: its lanes would run out of fuel.)
        draw(h, cover, over_line.bind(), vertices: 3)
    }
    h.end()
    label("runaway")
    let p = begin_pass(mut s.t, clear: vec4(0.0))
    p.scissor(0, 0, 32, 1)
    draw(p, cover, march.bind(passes: if s.frames >= OVER_AT { OVER } else { UNDER }), vertices: 3)
    p.end()
}
