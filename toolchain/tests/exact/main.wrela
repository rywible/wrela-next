// --exact (language.md §18.11): a function's bits don't depend on the code around it.
// `inlined` runs `f` written into its kernel; `called` runs the same `f` among 300 more calls of
// it, enough that the kernel keeps `f` as a call (ir::opt::outlined). tests/suite/exact.rs
// reads both kernels' results for the same inputs and holds them to the bit in exact mode.
use std::gpu::{GlobalId, GpuBuffer, Slots, buffer, buffer_of, dispatch, read}
use std::io::Pending

/// Arithmetic a compiler could contract or reassociate, and transcendentals, sixty steps.
fn f(x: f32) -> f32 {
    var a = x
    var b = x * 0.5 + 0.25
    a = a * 1.0000 + b * 0.3700
    b = sin(a * 0.1000) * b + cos(b * 0.2000) * 0.9000
    a = a * 1.0130 + b * 0.3810
    b = sin(a * 0.1070) * b + cos(b * 0.2030) * 0.8900
    a = a * 1.0260 + b * 0.3920
    b = sin(a * 0.1140) * b + cos(b * 0.2060) * 0.8800
    a = a * 1.0390 + b * 0.4030
    b = sin(a * 0.1210) * b + cos(b * 0.2090) * 0.8700
    a = a * 1.0520 + b * 0.4140
    b = sin(a * 0.1280) * b + cos(b * 0.2120) * 0.8600
    a = a * 1.0650 + b * 0.4250
    b = sin(a * 0.1350) * b + cos(b * 0.2150) * 0.8500
    a = a * 1.0780 + b * 0.4360
    b = sin(a * 0.1420) * b + cos(b * 0.2180) * 0.8400
    a = a * 1.0910 + b * 0.4470
    b = sin(a * 0.1490) * b + cos(b * 0.2210) * 0.8300
    a = a * 1.1040 + b * 0.4580
    b = sin(a * 0.1560) * b + cos(b * 0.2240) * 0.8200
    a = a * 1.1170 + b * 0.4690
    b = sin(a * 0.1630) * b + cos(b * 0.2270) * 0.8100
    a = a * 1.1300 + b * 0.4800
    b = sin(a * 0.1700) * b + cos(b * 0.2300) * 0.8000
    a = a * 1.1430 + b * 0.4910
    b = sin(a * 0.1770) * b + cos(b * 0.2330) * 0.7900
    a = a * 1.1560 + b * 0.5020
    b = sin(a * 0.1840) * b + cos(b * 0.2360) * 0.7800
    a = a * 1.1690 + b * 0.5130
    b = sin(a * 0.1910) * b + cos(b * 0.2390) * 0.7700
    a = a * 1.1820 + b * 0.5240
    b = sin(a * 0.1980) * b + cos(b * 0.2420) * 0.7600
    a = a * 1.1950 + b * 0.5350
    b = sin(a * 0.2050) * b + cos(b * 0.2450) * 0.7500
    a = a * 1.2080 + b * 0.5460
    b = sin(a * 0.2120) * b + cos(b * 0.2480) * 0.7400
    a = a * 1.2210 + b * 0.5570
    b = sin(a * 0.2190) * b + cos(b * 0.2510) * 0.7300
    a = a * 1.2340 + b * 0.5680
    b = sin(a * 0.2260) * b + cos(b * 0.2540) * 0.7200
    a = a * 1.2470 + b * 0.5790
    b = sin(a * 0.2330) * b + cos(b * 0.2570) * 0.7100
    a = a * 1.2600 + b * 0.5900
    b = sin(a * 0.2400) * b + cos(b * 0.2600) * 0.7000
    a = a * 1.2730 + b * 0.6010
    b = sin(a * 0.2470) * b + cos(b * 0.2630) * 0.6900
    a = a * 1.2860 + b * 0.6120
    b = sin(a * 0.2540) * b + cos(b * 0.2660) * 0.6800
    a = a * 1.2990 + b * 0.6230
    b = sin(a * 0.2610) * b + cos(b * 0.2690) * 0.6700
    a = a * 1.3120 + b * 0.6340
    b = sin(a * 0.2680) * b + cos(b * 0.2720) * 0.6600
    a = a * 1.3250 + b * 0.6450
    b = sin(a * 0.2750) * b + cos(b * 0.2750) * 0.6500
    a = a * 1.3380 + b * 0.6560
    b = sin(a * 0.2820) * b + cos(b * 0.2780) * 0.6400
    a = a * 1.3510 + b * 0.6670
    b = sin(a * 0.2890) * b + cos(b * 0.2810) * 0.6300
    a = a * 1.3640 + b * 0.6780
    b = sin(a * 0.2960) * b + cos(b * 0.2840) * 0.6200
    a = a * 1.3770 + b * 0.6890
    b = sin(a * 0.3030) * b + cos(b * 0.2870) * 0.6100
    a + b
}

@compute(64)
fn inlined(xs: [f32], out: mut Slots<f32>, at: mut Slots<f32>, id: GlobalId) {
    out[id] = f(xs[id.x])
    // `f` of a constant: computed as the shader is built where `f` is written in.
    at[id] = f(1.234)
}

