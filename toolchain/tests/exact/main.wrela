pub const N: u32 = 4096

pub struct S {
    backs: [Pending<f32>; 4],
    got: [bool; 4],
    at: [u32; 2],
    a: Vec<u32>,
    b: Vec<u32>,
}

pub fn init() -> S {
    var xs = Vec::new()
    for i in 0..N {
        xs.push(f32(i) * 0.37 - 700.0)
    }
    let xs = buffer_of(xs)
    var a: GpuBuffer<f32> = buffer(N)
    var b: GpuBuffer<f32> = buffer(N)
    var more: GpuBuffer<f32> = buffer(N)
    var at_a: GpuBuffer<f32> = buffer(64)
    var at_b: GpuBuffer<f32> = buffer(64)
    dispatch(inlined.bind(xs: xs, out: mut a, at: mut at_a), over: N)
    dispatch(called.bind(xs: xs, out: mut b, at: mut at_b, more: mut more), over: N)
    S {
        backs: [read(a.span(start: 0, count: N)), read(b.span(start: 0, count: N)), read(at_a.span(start: 0, count: 1)), read(at_b.span(start: 0, count: 1))],
        got: [false; 4],
        at: [0; 2],
        a: Vec::new(),
        b: Vec::new(),
    }
}

pub fn frame(s: mut S, time: f32, width: u32, height: u32) {
    for k in 0..4 {
        if let Some(Ok(xs)) = s.backs[k].poll() {
            for x in xs {
                if k == 0 {
                    s.a.push(bitcast_u32(x))
                } else if k == 1 {
                    s.b.push(bitcast_u32(x))
                } else {
                    s.at[k - 2] = bitcast_u32(x)
                }
            }
            s.got[k] = true
        }
    }
}

/// How many of the two kernels' results differ in any bit (theirs for the 4,096 inputs, and
/// `f(1.234)` once); `N + 1` until all have arrived.
pub fn differ(s: S) -> u32 {
    if !s.got[0] || !s.got[1] || !s.got[2] || !s.got[3] {
        return N + 1
    }
    var n: u32 = if s.at[0] != s.at[1] { 1 } else { 0 }
    for i in 0..N {
        if s.a[i] != s.b[i] {
            n += 1
        }
    }
    n
}
