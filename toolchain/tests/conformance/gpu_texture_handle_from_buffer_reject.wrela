// rejects: gpu.textures
// A texture's handle read from a buffer names no texture the kernel binds: GPU code reads a
// texture through a handle only as the shader received it (once, this made the compiler panic).
use std::gpu::{
    GlobalId, GpuBuffer, GpuSpan, R32Float, Slots, Texture3d, Texture3dHandle, buffer, buffer_of,
    dispatch, texture3d,
}

@compute(64)
fn read(hs: GpuSpan<Texture3dHandle<R32Float>>, out: mut Slots<f32>, id: GlobalId) {
    let h = hs[id.x % 2]
    out[id] = h.load(x: 0, y: 1, z: 2) //~ E0702
}

pub struct State {
    a: Texture3d<R32Float>,
    b: Texture3d<R32Float>,
}

pub fn init() -> State {
    State {
        a: texture3d(width: 4, height: 4, depth: 4),
        b: texture3d(width: 4, height: 4, depth: 4),
    }
}

pub fn frame(s: mut State, time: f32, width: u32, height: u32) {
    let hs: GpuBuffer<Texture3dHandle<R32Float>> = buffer_of([s.a.to_handle(), s.b.to_handle()])
    var out: GpuBuffer<f32> = buffer(64)
    dispatch(read.bind(hs.items(), mut out), over: 64)
}
