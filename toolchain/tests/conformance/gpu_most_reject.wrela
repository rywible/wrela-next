// rejects: gpu.outputs
// `most:` is a `u32`, given once, and only for a dispatch whose groups come from a buffer; a
// constant 0 states nothing (0 is an unstated `most:`).
use std::gpu::{DispatchArgs, GlobalId, GpuBuffer, Slots, buffer, dispatch}

@compute(64)
fn line(out: mut Slots<f32>, id: GlobalId) {
    out[id] = f32(id.x)
}

pub fn frame(time: f32, width: u32, height: u32) {
    var out: GpuBuffer<f32> = buffer(256)
    var args: GpuBuffer<DispatchArgs> = buffer(1)
    dispatch(line.bind(mut out), groups: 4, most: 4) //~ E0603
    dispatch(line.bind(mut out), groups: args, most: 1.5) //~ E0300
    dispatch(line.bind(mut out), groups: args, most: 1, most: 2) //~ E0304
    dispatch(line.bind(mut out), groups: args, most: 0) //~ E0603
}
