// accepts: trait.items
// A generic type's associated type, named in generic code, is the one its impl names where that
// impl alone could be the type's for any of its parameters: inside one generic impl, another's
// `Lone<M, W>::Walk` is `Within`.
pub struct Within: Copy {
    pub exit: f32,
}

pub trait Asked: Copy {
    type Walk: Copy
    fn begun(self) -> Self::Walk
}

pub struct Lone<M, const W: u32>: Copy {
    pub field: M,
}

impl<M: Copy, const W: u32> Asked for Lone<M, W> {
    type Walk = Within
    fn begun(self) -> Within {
        Within { exit: f32(W) }
    }
}

pub struct Seen<M, const W: u32>: Copy {
    pub field: M,
}

impl<M: Copy, const W: u32> Asked for Seen<M, W> {
    type Walk = Within
    fn begun(self) -> Within {
        let l: Lone<M, W> = Lone { field: self.field }
        let w: Within = l.begun()
        Within { exit: w.exit + 1.0 }
    }
}

pub fn frame(time: f32, width: u32, height: u32) {
    let s: Seen<f32, 3> = Seen { field: 1.0 }
    let w = s.begun()
}
