// rejects: gpu.entry
// A stage has at most 29 storage buffers on the machine (Metal's 31 buffer slots, less the two the binding model keeps): each `[T]` and
// `Slots<T>` is one, and so are the uniform values when they're over 64 KiB.
use std::gpu::{
    ClipPosition, GlobalId, GpuBuffer, Slots, VertexIndex, begin_screen_pass, buffer, draw,
}

@compute(64)
fn many(
    b0: [f32],
    b1: [f32],
    b2: [f32],
    b3: [f32],
    b4: [f32],
    b5: [f32],
    b6: [f32],
    b7: [f32],
    b8: [f32],
    b9: [f32],
    b10: [f32],
    b11: [f32],
    b12: [f32],
    b13: [f32],
    b14: [f32],
    b15: [f32],
    b16: [f32],
    b17: [f32],
    b18: [f32],
    b19: [f32],
    b20: [f32],
    b21: [f32],
    b22: [f32],
    b23: [f32],
    b24: [f32],
    b25: [f32],
    b26: [f32],
    b27: [f32],
    b28: [f32],
    out: mut Slots<f32>, //~ E0602
    id: GlobalId,
) {
    out[id] = b0[0] + b1[0] + b2[0] + b3[0] + b4[0] + b5[0] + b6[0] + b7[0] + b8[0] + b9[0] + b10[0] + b11[0] + b12[0] + b13[0] + b14[0] + b15[0] + b16[0] + b17[0] + b18[0] + b19[0] + b20[0] + b21[0] + b22[0] + b23[0] + b24[0] + b25[0] + b26[0] + b27[0] + b28[0]
}

struct Table: Copy + GpuData {
    rows: [vec4; 5000],
}

@compute(64)
fn wide(
    b0: [f32],
    b1: [f32],
    b2: [f32],
    b3: [f32],
    b4: [f32],
    b5: [f32],
    b6: [f32],
    b7: [f32],
    b8: [f32],
    b9: [f32],
    b10: [f32],
    b11: [f32],
    b12: [f32],
    b13: [f32],
    b14: [f32],
    b15: [f32],
    b16: [f32],
    b17: [f32],
    b18: [f32],
    b19: [f32],
    b20: [f32],
    b21: [f32],
    b22: [f32],
    b23: [f32],
    b24: [f32],
    b25: [f32],
    b26: [f32],
    b27: [f32],
    out: mut Slots<f32>,
    table: Table, //~ E0602
    id: GlobalId,
) {
    out[id] = b0[0] + b1[0] + b2[0] + b3[0] + b4[0] + b5[0] + b6[0] + b7[0] + b8[0] + b9[0] + b10[0] + b11[0] + b12[0] + b13[0] + b14[0] + b15[0] + b16[0] + b17[0] + b18[0] + b19[0] + b20[0] + b21[0] + b22[0] + b23[0] + b24[0] + b25[0] + b26[0] + b27[0] + table.rows[id.x].x
}

// Each of a render pipeline's shaders counts its own.
@vertex
fn spread(
    v: VertexIndex,
    b0: [f32],
    b1: [f32],
    b2: [f32],
    b3: [f32],
    b4: [f32],
    b5: [f32],
    b6: [f32],
    b7: [f32],
    b8: [f32],
    b9: [f32],
    b10: [f32],
    b11: [f32],
    b12: [f32],
    b13: [f32],
    b14: [f32],
    b15: [f32],
    b16: [f32],
    b17: [f32],
    b18: [f32],
    b19: [f32],
    b20: [f32],
    b21: [f32],
    b22: [f32],
    b23: [f32],
    b24: [f32],
    b25: [f32],
    b26: [f32],
    b27: [f32],
    b28: [f32],
    extra: [f32], //~ E0602
) -> ClipPosition {
    let x = b0[0] + b1[0] + b2[0] + b3[0] + b4[0] + b5[0] + b6[0] + b7[0] + b8[0] + b9[0] + b10[0] + b11[0] + b12[0] + b13[0] + b14[0] + b15[0] + b16[0] + b17[0] + b18[0] + b19[0] + b20[0] + b21[0] + b22[0] + b23[0] + b24[0] + b25[0] + b26[0] + b27[0] + b28[0] + extra[0]
    ClipPosition { position: vec4(x, f32(v.index), 0.5, 1.0) }
}

@fragment
fn white() -> vec4 {
    vec4(1.0)
}

pub fn frame(time: f32, width: u32, height: u32) {
    let x: GpuBuffer<f32> = buffer(1)
    let screen = begin_screen_pass(clear: vec4(0.0, 0.0, 0.0, 1.0))
    draw(screen, spread.bind(x, x, x, x, x, x, x, x, x, x, x, x, x, x, x, x, x, x, x, x, x, x, x, x, x, x, x, x, x, x), white, vertices: 3)
    screen.present()
}
