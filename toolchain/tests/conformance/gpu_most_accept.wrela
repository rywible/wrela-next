// accepts: gpu.outputs
// An indirect dispatch states the most groups its buffer can ask (`most:`), what it is weighed
// and booked as.
use std::gpu::{DispatchArgs, GlobalId, GpuBuffer, Slots, buffer, dispatch}

struct State {
    out: GpuBuffer<f32>,
    args: GpuBuffer<DispatchArgs>,
}

@compute(64)
fn line(out: mut Slots<f32>, id: GlobalId) {
    out[id] = f32(id.x)
}

pub fn init() -> State {
    State { out: buffer(8192), args: buffer(1) }
}

pub fn frame(s: mut State, time: f32, width: u32, height: u32) {
    dispatch(line.bind(mut s.out), groups: s.args, most: 128)
    let n: u32 = 32
    dispatch(line.bind(mut s.out), groups: s.args, most: n)
}
