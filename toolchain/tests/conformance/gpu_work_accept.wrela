// accepts: gpu.work
// `@budget(work: n)` holds a GPU function to at most n work a call: eight passes of a sine and a
// sum are within 100.
use std::gpu::{GlobalId, GpuBuffer, Slots, buffer, dispatch}

@budget(work: 100)
fn waves(x: f32) -> f32 {
    var a = x
    for _i in 0..8 {
        a = a + sin(a)
    }
    a
}

@compute(64)
fn look(out: mut Slots<f32>, id: GlobalId) {
    out[id] = waves(f32(id.x))
}

pub fn frame(time: f32, width: u32, height: u32) {
    var out: GpuBuffer<f32> = buffer(64)
    dispatch(look.bind(mut out), over: 64)
}
