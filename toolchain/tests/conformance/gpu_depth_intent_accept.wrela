// accepts: gpu.entry
// A fragment's own depth, promised never nearer than its triangle's (`WithDepthBehind`): under
// the default test (`Less`, depth 0 near) it is never less, under a reversed one (`Greater`)
// never greater, and under one with no near side (`Always`) it promises nothing.
use std::gpu::{
    ClipPosition, Compare, Depth, DepthTexture, VertexIndex, WithDepthBehind,
    begin_screen_pass_with_depth, depth_texture, draw,
}

@vertex
fn v(i: VertexIndex) -> ClipPosition {
    ClipPosition { position: vec4(0.0, 0.0, 0.5, 1.0) }
}

@fragment
fn pushed() -> WithDepthBehind<vec4> {
    WithDepthBehind { color: vec4(1.0), depth: 0.75 }
}

@fragment
fn pulled() -> WithDepthBehind<vec4> {
    WithDepthBehind { color: vec4(1.0), depth: 0.25 }
}

pub struct S {
    depth: DepthTexture,
}

pub fn init() -> S {
    S { depth: depth_texture(width: 4, height: 4) }
}

pub fn frame(s: mut S, time: f32, width: u32, height: u32) {
    let p = begin_screen_pass_with_depth(mut s.depth, clear: vec4(0.0))
    draw(p, v, pushed, vertices: 3)
    draw(p, v, pulled, vertices: 3, depth: Depth { compare: Compare::Greater })
    draw(p, v, pushed, vertices: 3, depth: Depth { compare: Compare::Always })
    p.present()
}
