// accepts: gpu.origin gpu.domains
// A dispatch starts its invocations at an origin: a count's in x, a size's of two or three, over
// a domain or by groups, direct or indirect. A kernel that writes `Slots` takes one along a row:
// over a count whatever its workgroup, which runs one row of it.
use std::gpu::{
    DispatchArgs, GlobalId, GpuBuffer, Rgba16Float, Slots, Texels3d, Texture3d, buffer, dispatch,
    texture3d,
}

struct State {
    out: GpuBuffer<f32>,
    volume: Texture3d<Rgba16Float>,
    args: GpuBuffer<DispatchArgs>,
}

@compute(64)
fn line(out: mut Slots<f32>, id: GlobalId) {
    out[id] = f32(id.x)
}

@compute(8, 8)
fn sheet(out: mut Slots<f32>, id: GlobalId) {
    out[id] = f32(id.x)
}

@compute(4, 4, 4)
fn space(out: mut Texels3d<Rgba16Float>, id: GlobalId) {
    out.store(id, vec4(f32(id.z)))
}

pub fn init() -> State {
    State {
        out: buffer(256),
        volume: texture3d::<Rgba16Float>(width: 16, height: 16, depth: 16),
        args: buffer(1),
    }
}

pub fn frame(s: mut State, time: f32, width: u32, height: u32) {
    dispatch(line.bind(mut s.out), over: 64, origin: 128)
    dispatch(line.bind(mut s.out), groups: 1, origin: 64)
    dispatch(sheet.bind(mut s.out), over: 64, origin: 64)
    dispatch(space.bind(mut s.volume), over: (8, 8, 8), origin: (8, 0, 8))
    dispatch(space.bind(mut s.volume), groups: (2, 2, 2), origin: (0, 8, 0))
    dispatch(space.bind(mut s.volume), over: (16, 8), origin: (0, 8))
    dispatch(space.bind(mut s.volume), groups: s.args, origin: (4, 4, 4))
}
