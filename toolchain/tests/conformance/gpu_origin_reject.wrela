// rejects: gpu.origin
// An origin is a count or a size of `u32`s, given once; a kernel that writes `Slots` is given one
// only along a row, since its slots are numbered row by row across the dispatch.
use std::gpu::{GlobalId, GpuBuffer, Slots, buffer, dispatch}

@compute(8, 8)
fn sheet(out: mut Slots<f32>, id: GlobalId) {
    out[id] = f32(id.y)
}

pub fn frame(time: f32, width: u32, height: u32) {
    var out: GpuBuffer<f32> = buffer(256)
    dispatch(sheet.bind(mut out), over: 64, origin: 1.5) //~ E0300
    dispatch(sheet.bind(mut out), over: 64, origin: 1, origin: 2) //~ E0304
    dispatch(sheet.bind(mut out), over: (8, 8), origin: (0, 8)) //~ E0603
    dispatch(sheet.bind(mut out), over: 64, origin: (0, 8)) //~ E0603
}
