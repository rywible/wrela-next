// rejects: gpu.work
// The count follows every way out of a loop: a `break` on a value it doesn't know leaves what
// it knew then, so what follows the loop is counted for each. Here the inner loop may leave with
// `i` anywhere under 8, so the heavy step after it may run in each of the 64 passes (16 sines,
// over 64 work), far past 2,000. (A count that kept only the inner loop's last pass took `i` as
// 8 there, left the outer loop at once, and stated 134: the opening's cloud march, 2026-11-16.)
use std::gpu::{GlobalId, GpuBuffer, Slots, buffer, dispatch}

@budget(work: 2000) //~ E0710
fn march(marked: u32, x: f32) -> f32 {
    var i: u32 = 0
    var j: u32 = 0
    var a = x
    for _s in 0..64 {
        for _k in 0..8 {
            if i >= 8 || ((marked >> i) & 1) != 0 {
                break
            }
            i += 1
        }
        if i >= 8 {
            break
        }
        for _h in 0..16 {
            a = a + sin(a)
        }
        j += 1
        if j >= 4 {
            j = 0
            i += 1
        }
    }
    a
}

@compute(64)
fn look(out: mut Slots<f32>, id: GlobalId) {
    out[id] = march(id.x, f32(id.x))
}

pub fn frame(time: f32, width: u32, height: u32) {
    var out: GpuBuffer<f32> = buffer(64)
    dispatch(look.bind(mut out), over: 64)
}
