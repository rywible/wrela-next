// rejects: build.budget
// A shipped build's pipeline keeps at most 16 KiB a invocation in variables of arrays, structs
// and enums (a GPU spills what it can't hold in registers): one over it is E0707, at the command
// that records it.
use std::gpu::{GlobalId, GpuBuffer, Slots, buffer, dispatch}

/// A sum of a run of numbers each invocation keeps as its own: 32 KiB of local state.
@compute(64)
fn look(out: mut Slots<f32>, id: GlobalId) {
    var run = [0.0; 8192]
    for i in 0..8192 {
        run[i] = f32(id.x + i)
    }
    var t = 0.0
    for i in 0..8192 {
        t += run[(i * 7) % 8192]
    }
    out[id] = t
}

pub fn frame(time: f32, width: u32, height: u32) {
    var out: GpuBuffer<f32> = buffer(64)
    dispatch(look.bind(mut out), over: 64) //~ E0707
}
