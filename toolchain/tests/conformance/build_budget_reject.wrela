// rejects: build.budget
// A shipped build's pipeline has at most 288 KiB of MSL on Metal (the cases build for it on any
// machine): one over it is E0707, at the command that records it.
use std::gpu::{GlobalId, GpuBuffer, Slots, buffer, dispatch}

/// A table the kernel reads, each of its numbers written out in the MSL: about 300 KiB.
const TABLE: [f32; 60000] = [0.5; 60000]

@compute(64)
fn look(out: mut Slots<f32>, id: GlobalId) {
    out[id] = TABLE[id.x % 60000]
}

pub fn frame(time: f32, width: u32, height: u32) {
    var out: GpuBuffer<f32> = buffer(64)
    dispatch(look.bind(mut out), over: 64) //~ E0707
}
