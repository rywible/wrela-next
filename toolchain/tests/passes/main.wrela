// Where a ray passes nearest a surface, in closed form (`Surface::passes`, beside `meets`): the
// engine's stage (two boxes and a ball, joined sharply: exact) and its creature (seventeen round
// cones and a wand, joined smoothly: its parts' least less its lowering below, four asks of its
// own distance above; refined, four more), drawn a frame at the screen's
// size six ways a pixel, each its own labelled pass: the nearest of 512 even samples of the
// distance along the ray through the bound's sphere (`march512`), `passes`, `passes` refined
// (`refined`), `meets` alone, `meets` and `passes` in one program, and today's edge ray (`meets`,
// then the march over its stretch: `edge ray`). The hosts' timings say what each costs; a compare pass counts, of the rays through
// the bound, any pass whose `low` is farther than the march's nearest sample (none may be: `low`
// is the least or below it) and how often the refined pass is at least as near as that sample.
use std::collections::Vec
use std::field::{Bound, Cuboid, Pass, RoundCone, SmoothUnion, SmoothUnionAll, Sphere, Surface, Translate, Union, With, cuboid, round_cone, sphere}
use std::gpu::{
    ClipPosition, FragCoord, GlobalId, GpuBuffer, Rg32Float, Rgba32Float, Slots, Texture, VertexIndex, begin_pass,
    begin_screen_pass, buffer, dispatch, draw, label, read, texture,
}
use std::io::{Pending, print}

pub type Block = With<Translate<Cuboid>, vec3>
pub type Ball = With<Translate<Sphere>, vec3>
pub type Stage = Union<Union<Block, Block>, Ball>

/// The engine's stage (branch engine 393d403, game/world/stage.wrela), its substances colours.
fn stage() -> Stage {
    let ground = cuboid(vec3(8.0, 0.25, 8.0)).translate(vec3(0.0, -0.25, 0.0)).with(vec3(0.36, 0.35, 0.33))
    let wall = cuboid(vec3(3.0, 1.5, 0.1)).translate(vec3(0.0, 1.5, 0.0)).with(vec3(0.42, 0.17, 0.11))
    let ball = sphere(1.0).translate(vec3(-4.5, 1.0, 3.0)).with(vec3(0.33, 0.42, 0.55))
    ground.union(wall).union(ball)
}

pub type Body = SmoothUnion<With<SmoothUnionAll<RoundCone, 17>, vec3>, With<RoundCone, vec3>>

/// The engine's creature at rest (as toolchain/tests/masked).
fn body() -> Body {
    let parts = [
        round_cone(vec3(0.0, 0.5694, -0.0258), vec3(0.0, 0.7866, 0.0042), r_top: 0.102, r_bottom: 0.096),
        round_cone(vec3(0.0, 0.7866, 0.0042), vec3(0.0, 0.912, -0.0246), r_top: 0.096, r_bottom: 0.06),
        round_cone(vec3(0.0, 1.02, 0.0018), vec3(0.0, 1.056, 0.0078), r_top: 0.15, r_bottom: 0.138),
        round_cone(vec3(0.1272, 0.873, -0.039), vec3(0.2778, 0.873, -0.0438), r_top: 0.039, r_bottom: 0.0348),
        round_cone(vec3(0.2778, 0.873, -0.0438), vec3(0.4236, 0.873, -0.039), r_top: 0.0348, r_bottom: 0.03),
        round_cone(vec3(0.4236, 0.873, -0.039), vec3(0.4932, 0.8706, -0.03), r_top: 0.03, r_bottom: 0.027),
        round_cone(vec3(0.0684, 0.5826, -0.0216), vec3(0.0684, 0.3252, -0.0216), r_top: 0.054, r_bottom: 0.0432),
        round_cone(vec3(0.0684, 0.3252, -0.0216), vec3(0.0684, 0.0516, -0.0528), r_top: 0.0432, r_bottom: 0.0336),
        round_cone(vec3(0.0684, 0.0516, -0.0528), vec3(0.0684, 0.009, 0.033), r_top: 0.0336, r_bottom: 0.0276),
        round_cone(vec3(0.078, 1.14, 0.0018), vec3(0.12, 1.272, -0.0102), r_top: 0.03, r_bottom: 0.0075),
        round_cone(vec3(-0.1272, 0.873, -0.039), vec3(-0.2778, 0.873, -0.0438), r_top: 0.039, r_bottom: 0.0348),
        round_cone(vec3(-0.2778, 0.873, -0.0438), vec3(-0.4236, 0.873, -0.039), r_top: 0.0348, r_bottom: 0.03),
        round_cone(vec3(-0.4236, 0.873, -0.039), vec3(-0.4932, 0.8706, -0.03), r_top: 0.03, r_bottom: 0.027),
        round_cone(vec3(-0.0684, 0.5826, -0.0216), vec3(-0.0684, 0.3252, -0.0216), r_top: 0.054, r_bottom: 0.0432),
        round_cone(vec3(-0.0684, 0.3252, -0.0216), vec3(-0.0684, 0.0516, -0.0528), r_top: 0.0432, r_bottom: 0.0336),
        round_cone(vec3(-0.0684, 0.0516, -0.0528), vec3(-0.0684, 0.009, 0.033), r_top: 0.0336, r_bottom: 0.0276),
        round_cone(vec3(-0.078, 1.14, 0.0018), vec3(-0.12, 1.272, -0.0102), r_top: 0.03, r_bottom: 0.0075),
    ]
    let wand = round_cone(vec3(-0.4236, 0.873, -0.039), vec3(-0.4956, 1.053, 0.261), r_top: 0.00504, r_bottom: 0.00504)
    parts.smooth_union(k: 0.03).with(vec3(0.42, 0.28, 0.16)).smooth_union(wand.with(vec3(0.22, 0.13, 0.07)), k: 0.004)
}

/// Where a picture is taken from.
pub struct View: Copy + GpuData {
    pub eye: vec3,
    pub width: f32,
    pub fwd: vec3,
    pub height: f32,
    pub right: vec3,
    pub tan: f32,
    pub up: vec3,
    pub spare: f32,
}

fn looking(eye: vec3, at: vec3, width: u32, height: u32) -> View {
    let fwd = normalize(at - eye)
    let right = normalize(cross(fwd, vec3(0.0, 1.0, 0.0)))
    let up = cross(right, fwd)
    View { eye, fwd, right, up, width: f32(width), height: f32(height), tan: 0.45, spare: 0.0 }
}

/// The stage from where the engine's eye stands; the creature close, as the masked fixture.
fn stage_view(width: u32, height: u32) -> View {
    looking(vec3(2.0, 2.2, 9.0), vec3(-0.5, 0.8, 0.0), width, height)
}

fn body_view(width: u32, height: u32) -> View {
    looking(vec3(0.35, 0.95, 1.5), vec3(0.0, 0.66, 0.0), width, height)
}

/// The ray through a pixel.
fn ray(v: View, px: vec2) -> (vec3, vec3) {
    let a = v.width / v.height
    let s = (2.0 * px.x / v.width - 1.0) * v.tan * a
    let u = (1.0 - 2.0 * px.y / v.height) * v.tan
    (v.eye, normalize(v.fwd + v.right * s + v.up * u))
}

/// How near a march counts as a hit (m), and the most steps it takes.
const NEAR: f32 = 0.0002
const STEPS: u32 = 512

/// The march from `t0` to `t1`: where it met the surface (-1 where it didn't), and its steps.
fn march<S: Surface>(s: S, o: vec3, d: vec3, t0: f32, t1: f32) -> vec2 {
    var t = t0
    var steps: u32 = 0
    var hit = false
    while steps < STEPS && t <= t1 && !hit {
        let f = s.distance(o + d * t)
        if f < NEAR {
            hit = true
        } else {
            t += f
            steps += 1
        }
    }
    vec2(if hit { t } else { -1.0 }, f32(steps))
}

/// Where the ray is in a surface's bound's sphere (`x > y` where it misses it).
fn bounded(b: Bound, o: vec3, d: vec3) -> vec2 {
    let oc = o - b.centre
    let p = dot(oc, d)
    let h = p * p - (dot(oc, oc) - b.radius * b.radius)
    if h < 0.0 {
        return vec2(1.0, 0.0)
    }
    let r = sqrt(h)
    vec2(max(-p - r, 0.0), -p + r)
}

@vertex
fn cover(v: VertexIndex) -> ClipPosition {
    let x = f32((v.index << 1) & 2) * 2.0 - 1.0
    let y = f32(v.index & 2) * 2.0 - 1.0
    ClipPosition { position: vec4(x, y, 0.5, 1.0) }
}


/// The nearest of 512 even samples of the distance along the ray through the bound's sphere:
/// (its distance, its `t`); (-1, -1) off the bound.
@fragment
fn march512<S: Surface>(pixel: FragCoord, v: View, s: S, b: Bound) -> vec2 {
    let (o, d) = ray(v, pixel.position.xy)
    let r = bounded(b, o, d)
    if r.x > r.y {
        return vec2(-1.0, -1.0)
    }
    let step = (r.y - r.x) / 511.0
    var least = 1.0e9
    var at = r.x
    for i in 0..512 {
        let t = r.x + step * f32(i)
        let f = s.distance(o + d * t)
        if f < least {
            least = f
            at = t
        }
    }
    vec2(least, at)
}

/// `passes`: (its `low`, its `t`); (-1, -1) off the bound.
@fragment
fn passed<S: Surface>(pixel: FragCoord, v: View, s: S, b: Bound) -> vec2 {
    let (o, d) = ray(v, pixel.position.xy)
    let r = bounded(b, o, d)
    if r.x > r.y {
        return vec2(-1.0, -1.0)
    }
    let p = s.passes(o, d)
    vec2(p.low, p.t)
}

/// `passes` refined by four asks of the distance, half a pixel's footprint apart where it is.
@fragment
fn refined<S: Surface>(pixel: FragCoord, v: View, s: S, b: Bound) -> vec2 {
    let (o, d) = ray(v, pixel.position.xy)
    let r = bounded(b, o, d)
    if r.x > r.y {
        return vec2(-1.0, -1.0)
    }
    let p = s.passes(o, d)
    let foot = 2.0 * v.tan / v.height * max(p.t, 0.01)
    let q = p.refined(o, d, |x: vec3| s.distance(x), 0.5 * foot)
    vec2(q.distance, q.t)
}

/// `meets` alone: (its near, its far).
@fragment
fn met_only<S: Surface>(pixel: FragCoord, v: View, s: S, b: Bound) -> vec2 {
    let (o, d) = ray(v, pixel.position.xy)
    let r = bounded(b, o, d)
    if r.x > r.y {
        return vec2(-1.0, -1.0)
    }
    let m = s.meets(o, d)
    vec2(m.near, m.far)
}

/// `meets` and `passes` both, in one program: (the pass's distance, `meets`'s near).
@fragment
fn both<S: Surface>(pixel: FragCoord, v: View, s: S, b: Bound) -> vec2 {
    let (o, d) = ray(v, pixel.position.xy)
    let r = bounded(b, o, d)
    if r.x > r.y {
        return vec2(-1.0, -1.0)
    }
    let m = s.meets(o, d)
    let p = s.passes(o, d)
    vec2(p.distance, m.near)
}

/// Today's edge ray: `meets`, then the march over its stretch (as toolchain/tests/meets `met`).
@fragment
fn edge_ray<S: Surface>(pixel: FragCoord, v: View, s: S, b: Bound) -> vec2 {
    let (o, d) = ray(v, pixel.position.xy)
    let r = bounded(b, o, d)
    if r.x > r.y {
        return vec2(-1.0, 0.0)
    }
    let m = s.meets(o, d)
    if m.is_empty() {
        return vec2(-1.0, 0.0)
    }
    if m.exact() {
        return vec2(m.near, 0.0)
    }
    let end = min(m.far, m.first)
    let h = march(s, o, d, m.near, end)
    if h.x < 0.0 && m.first <= m.far { vec2(m.first, h.y) } else { h }
}

/// At a pixel, against the march's nearest sample `m`: through the bound (1), the pass farther
/// than it, or not meeting what the march meets (1, never: 0), the refined pass farther than it by more than a twentieth of a
/// footprint where the march passes within a footprint (1), and the march passing within one.
@fragment
fn compared(pixel: FragCoord, v: View, m: Texture<Rg32Float>, p: Texture<Rg32Float>, r: Texture<Rg32Float>) -> vec4 {
    let x = u32(pixel.position.x)
    let y = u32(pixel.position.y)
    let a = m.load(x, y)
    if a.y < 0.0 {
        return vec4(0.0)
    }
    let b = p.load(x, y)
    let c = r.load(x, y)
    let foot = 2.0 * v.tan / v.height * a.y
    // Where the march meets it (a sample inside), the pass must say so (at most 0).
    let farther = if (a.x > 0.0 && b.x > a.x + 1.0e-5 * (1.0 + a.x)) || (a.x <= 0.0 && b.x > 1.0e-5) { 1.0 } else { 0.0 }
    let within = a.x > 0.0 && a.x <= foot
    let off = if within && c.x - a.x > foot / 20.0 { 1.0 } else { 0.0 }
    vec4(1.0, farther, off, if within { 1.0 } else { 0.0 })
}

/// A row of a comparison: rays through the bound, passes farther than the march, refined passes
/// off by more than a twentieth of a footprint where the march passes within one, and those.
pub struct Row: Copy + GpuData + Plain {
    pub rays: u32,
    pub farther: u32,
    pub off: u32,
    pub within: u32,
}

@compute(64)
fn rows(c: Texture<Rgba32Float>, width: u32, height: u32, out: mut Slots<Row>, id: GlobalId) {
    if id.x >= height {
        return
    }
    var r = Row { rays: 0, farther: 0, off: 0, within: 0 }
    for x in 0..min(width, 4096) {
        let q = c.load(x, id.x)
        r.rays += if q.x > 0.5 { 1 } else { 0 }
        r.farther += if q.y > 0.5 { 1 } else { 0 }
        r.off += if q.z > 0.5 { 1 } else { 0 }
        r.within += if q.w > 0.5 { 1 } else { 0 }
    }
    out[id] = r
}

pub struct Passes {
    frames: u32,
    size: vec2u,
    // Stage march, passes, refined, meets; creature march, passes, refined, meets, edge ray;
    // stage and creature meets and passes.
    pictures: [Texture<Rg32Float>; 11],
    compared: [Texture<Rgba32Float>; 2],
    rows: [Vec<Pending<Row>>; 2],
    found: [Row; 2],
    read: u32,
}

pub fn init() -> Passes {
    Passes {
        frames: 0,
        size: vec2u(0, 0),
        pictures: [
            texture(width: 1, height: 1), texture(width: 1, height: 1), texture(width: 1, height: 1),
            texture(width: 1, height: 1), texture(width: 1, height: 1), texture(width: 1, height: 1),
            texture(width: 1, height: 1), texture(width: 1, height: 1), texture(width: 1, height: 1),
            texture(width: 1, height: 1), texture(width: 1, height: 1),
        ],
        compared: [texture(width: 1, height: 1), texture(width: 1, height: 1)],
        rows: [Vec::new(), Vec::new()],
        found: [Row { rays: 0, farther: 4294967295, off: 4294967295, within: 0 }; 2],
        read: 0,
    }
}

/// How many rows a band of the march is, each band its own pass (the creature's march is at most
/// about 5.5 ms a 1920-pixel row on the M4, about 20 on the Radeon).
const BAND_ROWS: u32 = 1

fn one<S: Surface>(t: mut Texture<Rg32Float>, way: u32, v: View, s: S) {
    let b = s.bound()
    if way == 0 {
        let rows = BAND_ROWS
        for i in 0..((u32(v.height) + rows - 1) / rows) {
            if i * rows < u32(v.height) {
                let q = begin_pass(mut t, clear: vec4(0.0), keep: i > 0)
                q.scissor(0, i * rows, u32(v.width), min(rows, u32(v.height) - i * rows))
                draw(q, cover, march512.bind(v: v, s: s, b: b), vertices: 3)
                q.end()
            }
        }
        return
    }
    let p = begin_pass(mut t, clear: vec4(0.0))
    if way == 1 {
        draw(p, cover, passed.bind(v: v, s: s, b: b), vertices: 3)
    } else if way == 2 {
        draw(p, cover, refined.bind(v: v, s: s, b: b), vertices: 3)
    } else if way == 3 {
        draw(p, cover, met_only.bind(v: v, s: s, b: b), vertices: 3)
    } else if way == 5 {
        draw(p, cover, both.bind(v: v, s: s, b: b), vertices: 3)
    } else {
        draw(p, cover, edge_ray.bind(v: v, s: s, b: b), vertices: 3)
    }
    p.end()
}

const WAYS: [Text; 6] = ["march512", "passes", "refined", "meets", "edge ray", "meets and passes"]

/// Whether the march is drawn (and the compare): `--set MARCH=false` times the other ways alone.
pub const MARCH: bool = true

pub fn frame(s: mut Passes, time: f32, width: u32, height: u32) {
    if s.size.x != width || s.size.y != height {
        for i in 0..11 {
            s.pictures[i] = texture(width, height)
        }
        for i in 0..2 {
            s.compared[i] = texture(width, height)
        }
        s.size = vec2u(width, height)
    }
    let (st, bd) = (stage(), body())
    let (sv, bv) = (stage_view(width, height), body_view(width, height))
    // Each way in turn, starting one further along each frame.
    for k in 0..6 {
        let way = (k + s.frames) % 6
        if way == 0 && !MARCH {
            continue
        }
        if way < 4 || way == 5 {
            label(f"stage {WAYS[way]}")
            one(mut s.pictures[if way == 5 { 9 } else { way }], way, sv, st)
        }
        label(f"creature {WAYS[way]}")
        one(mut s.pictures[if way == 5 { 10 } else { 4 + way }], way, bv, bd)
    }
    if s.frames == 1 && MARCH {
        label("compared")
        let p = begin_pass(mut s.compared[0], clear: vec4(0.0))
        draw(p, cover, compared.bind(v: sv, m: s.pictures[0], p: s.pictures[1], r: s.pictures[2]), vertices: 3)
        p.end()
        let q = begin_pass(mut s.compared[1], clear: vec4(0.0))
        draw(q, cover, compared.bind(v: bv, m: s.pictures[4], p: s.pictures[5], r: s.pictures[6]), vertices: 3)
        q.end()
        for i in 0..2 {
            var out: GpuBuffer<Row> = buffer(height)
            dispatch(rows.bind(c: s.compared[i], width: width, height: height, out: mut out), over: height)
            s.rows[i].push(read(out.items()))
        }
    }
    label("shown")
    let p = begin_screen_pass(clear: vec4(0.0))
    draw(p, cover, shown.bind(a: s.pictures[5]), vertices: 3)
    p.present()
    s.frames += 1
    for i in 0..2 {
        for j in 0..u32(s.rows[i].len()) {
            if let Some(Ok(rs)) = s.rows[i][j].poll() {
                var f = Row { rays: 0, farther: 0, off: 0, within: 0 }
                for r in rs {
                    f.rays += r.rays
                    f.farther += r.farther
                    f.off += r.off
                    f.within += r.within
                }
                let name = if i == 0 { "stage" } else { "creature" }
                print(f"passes: {name}: {f.rays} rays through the bound, {f.farther} passes farther than the march's nearest sample; {f.within} pass within a footprint of it, the refined pass more than a twentieth of one farther on {f.off}")
                s.found[i] = f
                s.read += 1
            }
        }
    }
}

/// The creature's passes, shaded by how near (white within a centimetre).
@fragment
fn shown(pixel: FragCoord, a: Texture<Rg32Float>) -> vec4 {
    let r = a.load(u32(pixel.position.x), u32(pixel.position.y))
    if r.y < 0.0 { vec4(0.1, 0.1, 0.12, 1.0) } else { vec4(vec3(clamp(1.0 - abs(r.x) * 100.0, 0.0, 1.0)), 1.0) }
}

/// Scene `i`'s passes farther than the march (all ones until read).
pub fn farther(s: Passes, i: u32) -> u32 {
    s.found[i].farther
}

/// How many scenes' comparisons have been read.
pub fn compared_scenes(s: Passes) -> u32 {
    s.read
}
