// A field written while the program runs (`std::field::Written`), asked in a kernel: every leaf
// kind, map and join and a displacement, against the compiled tree of the same kinds in the same
// kernel, at 4,096 points, and its rays' `meets`, `passes` and deciding part at 1,024 rays; the
// tests read both back, on both hosts.
use std::collections::Vec
use std::derive::Box3
use std::field::{ALL_LIVE, Live, Surface, Written, cuboid, ellipsoid, fbm, half_space, round_cone, sphere, writing}
use std::gpu::{GlobalId, GpuBuffer, GpuSpan, Slots, buffer, buffer_of, dispatch, read}
use std::io::Pending
use std::quat::Quat

const N: u32 = 4096

/// Rays a dispatch (a written field's `passes` asks a subtree's distance at each smooth union
/// and displacement: the guard's count of one ask is large, so a dispatch holds few).
const RAYS: u32 = 64

/// Dispatches of rays.
const BATCHES: u32 = 16

fn turn() -> Quat {
    Quat::axis_angle(normalize(vec3(1.0, 2.0, 0.5)), 0.7)
}

fn written() -> Written {
    var w = writing()
    let a = w.sphere(0.6, matter: 1)
    let a1 = w.translate(a, vec3(0.5, 0.0, 0.0))
    let b = w.round_cone(vec3(-0.6, -0.3, 0.1), vec3(0.1, 0.4, -0.2), r_top: 0.15, r_bottom: 0.35, matter: 2)
    let ab = w.smooth_union(a1, b, 0.3)
    let c = w.cuboid(vec3(0.4, 0.3, 0.2), matter: 3)
    let c1 = w.rotate(c, turn())
    let c2 = w.translate(c1, vec3(0.2, 0.5, 0.3))
    let abc = w.smooth_subtract(ab, c2, 0.1)
    let e = w.ellipsoid(vec3(0.3, 0.5, 0.4), matter: 4)
    let e1 = w.scale(e, 1.5)
    let all = w.union(abc, e1)
    let h = w.half_space(normalize(vec3(0.1, 1.0, 0.05)), 0.7, matter: 5)
    let cut = w.smooth_intersect(all, h, 0.05)
    let d = w.displace(cut, amp: 0.02, freq: 4.0, octaves: 3)
    w.done().unwrap()
}

/// The written field's distance and the compiled tree's (passed as a value, as the engine
/// passes a thing) at each point.
@compute(64)
fn both<S: Surface>(w: Written, compiled: S, points: GpuSpan<vec3>, out: mut Slots<vec2>, id: GlobalId) {
    if id.x >= N {
        return
    }
    let p = points[id.x]
    out[id] = vec2(w.distance(p), compiled.distance(p))
}

/// Where the ray from an origin toward its target meets `s` (near, far, first) and the part that
/// decides the distance at the target; and the distance asked of the parts a box round the target
/// keeps (`live`, found on the CPU), and of every part. (`passes` and `pruned` are a written
/// field's CPU answers: asking a subtree's distance at each smooth union inside the node loop,
/// one GPU ask of `passes` counts 31 M, past what a dispatch may hold.)
@compute(64)
fn rays<S: Surface>(s: S, origins: GpuSpan<vec3>, targets: GpuSpan<vec3>, lives: GpuSpan<Live>, met: mut Slots<vec4>, asked: mut Slots<vec4>, id: GlobalId) {
    if id.x >= RAYS {
        return
    }
    let o = origins[id.x]
    let d = targets[id.x] - o
    let m = s.meets(o, d)
    let (_, part) = s.part_at(targets[id.x])
    met[id] = vec4(m.near, m.far, m.first, f32(part))
    let q = targets[id.x]
    asked[id] = vec4(s.distance_live(q, lives[id.x]), s.distance(q), 0.0, 0.0)
}

pub struct State {
    frame: u32,
    points: GpuBuffer<vec3>,
    out: GpuBuffer<vec2>,
    origins: GpuBuffer<vec3>,
    targets: GpuBuffer<vec3>,
    /// The parts a box round each target keeps.
    lives: GpuBuffer<Live>,
    /// Each batch's: where the written field meets, where it passes; the compiled tree's.
    met_w: Vec<GpuBuffer<vec4>>,
    asked_w: Vec<GpuBuffer<vec4>>,
    met_c: Vec<GpuBuffer<vec4>>,
    asked_c: Vec<GpuBuffer<vec4>>,
    pending: Vec<Pending<vec2>>,
    seen: Vec<Vec<vec2>>,
    ray_pending: Vec<Pending<vec4>>,
    ray_seen: Vec<Vec<vec4>>,
}

/// A buffer of rays' answers for each batch.
fn outs() -> Vec<GpuBuffer<vec4>> {
    var v: Vec<GpuBuffer<vec4>> = Vec::new()
    for _i in 0..BATCHES {
        v.push(buffer(RAYS))
    }
    v
}

pub fn init() -> State {
    var pts: Vec<vec3> = Vec::new()
    for i in 0..N {
        pts.push(Box3 { lo: vec3(-2.0), hi: vec3(2.0) }.sample(3, i))
    }
    var os: Vec<vec3> = Vec::new()
    var ts: Vec<vec3> = Vec::new()
    var lv: Vec<Live> = Vec::new()
    let w = written()
    for i in 0..RAYS * BATCHES {
        os.push(Box3 { lo: vec3(-3.0), hi: vec3(3.0) }.sample(7, i))
        let t = Box3 { lo: vec3(-1.0), hi: vec3(1.0) }.sample(9, i)
        ts.push(t)
        lv.push(w.live(Box3 { lo: t - vec3(0.05), hi: t + vec3(0.05) }))
    }
    State {
        frame: 0,
        points: buffer_of(pts),
        out: buffer(N),
        origins: buffer_of(os),
        targets: buffer_of(ts),
        lives: buffer_of(lv),
        met_w: outs(),
        asked_w: outs(),
        met_c: outs(),
        asked_c: outs(),
        pending: Vec::new(),
        seen: Vec::new(),
        ray_pending: Vec::new(),
        ray_seen: Vec::new(),
    }
}

pub fn frame(s: mut State, time: f32, width: u32, height: u32) {
    if s.frame == 0 {
        let compiled = sphere(0.6).translate(vec3(0.5, 0.0, 0.0))
            .smooth_union(round_cone(vec3(-0.6, -0.3, 0.1), vec3(0.1, 0.4, -0.2), r_top: 0.15, r_bottom: 0.35), k: 0.3)
            .smooth_subtract(cuboid(vec3(0.4, 0.3, 0.2)).rotate(turn()).translate(vec3(0.2, 0.5, 0.3)), k: 0.1)
            .union(ellipsoid(vec3(0.3, 0.5, 0.4)).scale(1.5))
            .smooth_intersect(half_space(normalize(vec3(0.1, 1.0, 0.05)), 0.7), k: 0.05)
            .displace(fbm(4.0, 3), amp: 0.02)
        dispatch(both.bind(w: written(), compiled: compiled, points: s.points.items(), out: mut s.out), over: N)
        s.pending.push(read(s.out.items()))
        for b in 0..BATCHES {
            let os = s.origins.items().sub(b * RAYS, RAYS)
            let ts = s.targets.items().sub(b * RAYS, RAYS)
            let ls = s.lives.items().sub(b * RAYS, RAYS)
            dispatch(rays.bind(s: written(), origins: os, targets: ts, lives: ls, met: mut s.met_w[b], asked: mut s.asked_w[b]), over: RAYS)
            dispatch(rays.bind(s: compiled, origins: os, targets: ts, lives: ls, met: mut s.met_c[b], asked: mut s.asked_c[b]), over: RAYS)
        }
        for b in 0..BATCHES {
            s.ray_pending.push(read(s.met_w[b].items()))
            s.ray_pending.push(read(s.asked_w[b].items()))
            s.ray_pending.push(read(s.met_c[b].items()))
            s.ray_pending.push(read(s.asked_c[b].items()))
        }
    }
    for i in 0..s.pending.len() {
        if s.seen.len() == i {
            if let Some(Ok(v)) = s.pending[i].poll() {
                s.seen.push(take v)
            }
        }
    }
    for i in 0..s.ray_pending.len() {
        if s.ray_seen.len() == i {
            if let Some(Ok(v)) = s.ray_pending[i].poll() {
                s.ray_seen.push(take v)
            }
        }
    }
    s.frame += 1
}

/// In GPU code the written field is the compiled tree within 1e-6 (relative past 1 m): the same
/// kinds' code, rounded by the GPU each its own way.
@test(frames: 4, gpu: true, hosts: both)
fn a_written_field_is_its_compiled_tree_on_the_gpu(s: State) {
    assert(s.seen.len() == 1)
    var worst = 0.0
    for i in 0..N {
        let v = s.seen[0][i]
        let off = abs(v.x - v.y) / max(1.0, abs(v.y))
        worst = max(worst, off)
    }
    assert(worst <= 1.0e-6, f"the written field is {worst} off the compiled tree")
}

/// In GPU code the written field's rays meet it where they meet the compiled tree, within 1e-5
/// (relative past 1 m: each side's own rounding), the part deciding each target is the same but
/// where two parts tie within that, and its masked ask is the compiled tree's and its own whole
/// ask's within 1e-6.
@test(frames: 8, gpu: true, hosts: both)
fn a_written_fields_rays_are_its_compiled_trees_on_the_gpu(s: State) {
    assert(s.ray_seen.len() == 4 * BATCHES)
    var worst = 0.0
    var masked = 0.0
    var parts_differ = 0
    for i in 0..RAYS * BATCHES {
        let (b, r) = (i / RAYS, i % RAYS)
        let (mw, mc) = (s.ray_seen[4 * b][r], s.ray_seen[4 * b + 2][r])
        let (aw, ac) = (s.ray_seen[4 * b + 1][r], s.ray_seen[4 * b + 3][r])
        for j in 0..3 {
            if abs(mc[j]) < 1.0e20 {
                worst = max(worst, abs(mw[j] - mc[j]) / max(1.0, abs(mc[j])))
            } else {
                assert(mw[j] == mc[j], f"ray {i}: meets' {j} differs: {mw[j]} against {mc[j]}")
            }
        }
        if mw.w != mc.w {
            parts_differ += 1
        }
        masked = max(masked, abs(aw.x - ac.x) / max(1.0, abs(ac.x)))
        masked = max(masked, abs(aw.x - aw.y) / max(1.0, abs(aw.y)))
    }
    assert(worst <= 1.0e-5, f"the written field's rays are {worst} off the compiled tree's")
    assert(parts_differ <= 4, f"{parts_differ} targets' deciding parts differ")
    assert(masked <= 1.0e-6, f"the masked ask is {masked} off")
}
