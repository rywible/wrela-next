// The spike's forms as the one path takes them: each says which of its parts matter near a
// place and answers for those alone (`volume::Parted`). A form of one part answers for itself.

use opening::stacks::Pillar
use std::field::Surface
use volume::Parted

impl Parted for Pillar {
    fn near(self, p: vec3, reach: f32) -> u32 {
        1
    }

    fn sample_of(self, p: vec3, parts: u32) -> (f32, vec3) {
        self.sample(p)
    }

    fn distance_of(self, p: vec3, parts: u32) -> f32 {
        self.distance(p)
    }
}
