// The light test's stage (Gate 3): a ground slab, a thin wall with the sun on one side of it,
// and a ball that casts a shadow. Exact distances, so a reference can march it as it is.

use form::look::{Look, Place, Skin}
use std::field::{Bound, Surface}

/// The wall's half thickness (m): 20 cm through, about three cells of the volume.
pub const WALL_HALF: f32 = 0.1

/// How high the ground's top is (m): on the volume's lattice, as ground laid on whole metres is.
pub const GROUND: f32 = 0.0

/// The stage.
pub struct Stage: Copy + GpuData {
    pub spare: vec4,
}

/// The distance from `p` to a box about `c` with half sides `h`.
fn boxed(p: vec3, c: vec3, h: vec3) -> f32 {
    let q = abs(p - c) - h
    length(max(q, vec3(0.0))) + min(max(q.x, max(q.y, q.z)), 0.0)
}

impl Surface for Stage {
    fn distance(self, p: vec3) -> f32 {
        let ground = boxed(p, vec3(0.0, GROUND - 0.25, 0.0), vec3(8.0, 0.25, 8.0))
        let wall = boxed(p, vec3(0.0, 1.5, 0.0), vec3(3.0, 1.5, WALL_HALF))
        let ball = length(p - vec3(-4.5, 1.0, 3.0)) - 1.0
        min(min(ground, wall), ball)
    }

    fn bound(self) -> Bound {
        Bound { centre: vec3(0.0, 1.0, 0.0), radius: 12.0, slope: 0.5 }
    }

    fn lipschitz(self, near: f32) -> f32 {
        1.0
    }
}

/// What the stage wears: the wall red, the ball pale blue, the ground grey.
pub struct StageLook: Copy + GpuData {
    pub spare: vec4,
}

impl Look for StageLook {
    fn skin(self, at: Place) -> Skin {
        let p = at.world
        var albedo = vec3(0.6)
        if p.y > GROUND + 0.01 && abs(p.z) < WALL_HALF + 0.03 && abs(p.x) < 3.03 {
            albedo = vec3(0.7, 0.2, 0.15)
        } else if p.y > GROUND + 0.01 {
            albedo = vec3(0.55, 0.6, 0.75)
        }
        Skin { albedo, line: 1.0, metal: 0.0, rim: false, emits: vec3(0.0) }
    }
}
