// The volume spike's scene: one form held still before a still eye, drawn by the way `MODE`
// names, and judged against the form traced (`atoms::reference::trace`) where `JUDGE` asks.
//
//     MODE 0  today's mesh path (`atoms::solids`): the column every other mode is held to
//     MODE 1  the form deposited once into a sparse volume of `CELL` m cells and marched at every
//             pixel (`volume`)
//
// The form is the opening's tallest-but-one stack (`PILLARS[2]`: 44 m tall, 11 m round at its
// foot, six noises a distance), seen from 100 m with a long lens so it covers about half the
// screen, the distance its mesh was baked for.

use atoms::reference::trace
use atoms::solids::{Solids, solids}
use form::ink::NO_LINES
use frame::eye::{Eye, eye_at}
use frame::judge::{Judge, judge}
use frame::light::sunlit
use frame::picture::{Frame, picture}
use frame::sky::{Plain, plain}
use opening::stacks::{PILLARS, PILLAR_2_MESH, Pillar, Wears}
use std::transform::identity
use form::look::{Look, Place, Skin}
use volume::{Volume, volume}

/// Which way the form is drawn (see the head of the file).
pub const MODE: u32 = 0

/// A fine cell of the volume (m).
pub const CELL: f32 = 0.0625

/// One scouting ray each `RATE` × `RATE` pixels, each pixel joined from them; 1, every pixel
/// marched.
pub const RATE: u32 = 1

/// The most steps a ray takes; whether pixels show their steps (64 a step of red, then green,
/// then blue); whether the form wears one plain grey in place of the stone (to part the look's
/// cost from the march's).
pub const STEPS: u32 = 1024
pub const DEBUG: u32 = 0
pub const PLAIN: bool = false

/// Whether a pixel wears the albedo stored in the cells at the deposit, not its look asked there.
pub const STORED: bool = false

/// Whether a joined pixel reads the volume once (true) or takes its facing and albedo from its
/// four scouts alone.
pub const READS: bool = true

/// The steepness the empty-space skip takes the form to have (0: the form's own).
pub const STEEP: f32 = 0.0

/// The load beside the frame while it is timed (sines a pixel; 0 for none).
pub const LOAD: u32 = 0

/// Whether the ink draws its lines (off to judge the edges themselves, which the reference draws
/// with none).
pub const INK: bool = true

/// The judge: `SAMPLES` looks a moment, `MOMENTS` moments, the eye turning `TURN` rad about the
/// form's upright a moment; the reference drawn in `BANDS` bands of rows.
pub const JUDGE: bool = false
pub const SAMPLES: u32 = 16
pub const MOMENTS: u32 = 8
pub const TURN: f32 = 0.0005
pub const BANDS: u32 = 16

/// The frames a look of the reference is drawn over (its bands shared among them, the eye held):
/// a 1080p look is about 350 ms of the GPU's, more than a frame may hold with others queued.
pub const SPLIT: u32 = 2

/// The form, what it wears, and the sun.
const FORM: Pillar = PILLARS[2]
const STONE = Wears { spare: vec3(1.0), kind: 0.0 }
const SUN = vec3(0.55, 0.62, 0.56)

/// Where the eye stands (m, the form's foot at the origin), what it looks at, and its field of
/// view (rad, upward).
const FROM = vec3(0.0, 24.0, -100.0)
const TO = vec3(0.0, 21.0, 0.0)
const FOV: f32 = 0.2

pub struct Program {
    frame: Frame,
    solids: Solids<Wears>,
    vol: Volume<Pillar>,
    judge: Judge,
    placed: bool,
    frames: u32,
    /// Which of a look's `SPLIT` frames this is.
    part: u32,
}

pub fn init() -> Program {
    var frame = picture(load: LOAD)
    if !INK {
        frame.ink = NO_LINES
    }
    Program {
        frame,
        solids: solids(),
        vol: stepped(volume(FORM, cell: CELL)),
        judge: judge(samples: SAMPLES, moments: MOMENTS, settled: 1),
        placed: false,
        frames: 0,
        part: 0,
    }
}

/// The eye turned `turned` rad about the form's upright.
fn eye_for(width: u32, height: u32, turned: f32) -> Eye {
    let c = cos(turned)
    let s = sin(turned)
    let from = vec3(FROM.x * c - FROM.z * s, FROM.y, FROM.x * s + FROM.z * c)
    eye_at(from, TO, FOV, width: width, height: height)
}

pub fn frame(p: mut Program, time: f32, width: u32, height: u32) {
    let turned = if JUDGE { TURN * f32(p.judge.moment()) } else { 0.0 }
    let eye = eye_for(width, height, turned)
    let sky: Plain = plain(normalize(SUN))
    if MODE == 0 && !p.placed {
        let pillar = p.solids.load(PILLAR_2_MESH.clone())
        let _ = p.solids.place(pillar, STONE, at: identity(), body: 1, group: 0)
        p.placed = true
    }
    p.frame.begin(eye, sunlit(normalize(SUN), ground: -1000.0))
    if MODE == 0 {
        p.solids.hold = false
        p.solids.cast(mut p.frame)
    }
    if MODE == 1 && !p.vol.filled() {
        p.vol.fill(STONE)
    }
    if MODE == 1 && p.vol.filled() {
        if PLAIN {
            p.vol.draw_into(mut p.frame, Grey { spare: vec4(0.0) }, body: 1, rate: RATE)
        } else {
            p.vol.draw_into(mut p.frame, STONE, body: 1, rate: RATE)
        }
    } else {
        p.frame.draw(|d| {
            if MODE == 0 {
                p.solids.draw_into(d)
            }
        })
    }
    p.frames += 1
    let ready = MODE != 1 || p.vol.filled()
    if JUDGE && ready && !p.judge.done() {
        p.judge.sized(eye)
        let last = p.part + 1 == SPLIT
        if last {
            p.judge.resolve(mut p.frame, sky)
        } else {
            p.frame.end(sky)
        }
        let look = p.judge.looking(eye)
        for b in p.part * BANDS / SPLIT..(p.part + 1) * BANDS / SPLIT {
            trace(mut p.judge, look, p.frame.light, FORM, STONE, sky, band: b, bands: BANDS)
        }
        if last {
            p.judge.after(p.frame, sky)
            p.part = 0
        } else {
            p.part += 1
        }
        return
    }
    p.judge.heard()
    p.frame.end(sky)
}

/// The volume with the scene's step limit and debug view.
fn stepped(v: take Volume<Pillar>) -> Volume<Pillar> {
    var w = take v
    w.grid.most = STEPS
    w.grid.debug = DEBUG
    w.grid.stored = if STORED { 1 } else { 0 }
    w.grid.reads = if READS { 1 } else { 0 }
    if STEEP > 0.0 {
        w.grid.steep = STEEP
    }
    w
}

/// One plain grey, for parting the look's cost from the march's.
pub struct Grey: Copy + GpuData {
    pub spare: vec4,
}

impl Look for Grey {
    fn skin(self, at: Place) -> Skin {
        Skin { albedo: vec3(0.3), line: 1.0, metal: 0.0, rim: false, emits: vec3(0.0) }
    }
}
