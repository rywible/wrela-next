// The volume spike's scene: one form held still before a still eye, drawn by the way `MODE`
// names, and judged against the form traced (`atoms::reference::trace`) where `JUDGE` asks.
//
//     MODE 0  today's mesh path (`atoms::solids`): the column every other mode is held to
//
// The form is the opening's tallest-but-one stack (`PILLARS[2]`: 44 m tall, 11 m round at its
// foot, six noises a distance), seen from 100 m with a long lens so it covers about half the
// screen, the distance its mesh was baked for.

use atoms::reference::trace
use atoms::solids::{Solids, solids}
use form::ink::NO_LINES
use frame::eye::{Eye, eye_at}
use frame::judge::{Judge, judge}
use frame::light::sunlit
use frame::picture::{Frame, picture}
use frame::sky::{Plain, plain}
use opening::stacks::{PILLARS, PILLAR_2_MESH, Pillar, Wears}
use std::transform::identity

/// Which way the form is drawn (see the head of the file).
pub const MODE: u32 = 0

/// The load beside the frame while it is timed (sines a pixel; 0 for none).
pub const LOAD: u32 = 0

/// Whether the ink draws its lines (off to judge the edges themselves, which the reference draws
/// with none).
pub const INK: bool = true

/// The judge: `SAMPLES` looks a moment, `MOMENTS` moments, the eye turning `TURN` rad about the
/// form's upright a moment; the reference drawn in `BANDS` bands of rows.
pub const JUDGE: bool = false
pub const SAMPLES: u32 = 16
pub const MOMENTS: u32 = 8
pub const TURN: f32 = 0.0005
pub const BANDS: u32 = 8

/// The form, what it wears, and the sun.
const FORM: Pillar = PILLARS[2]
const STONE = Wears { spare: vec3(1.0), kind: 0.0 }
const SUN = vec3(0.55, 0.62, 0.56)

/// Where the eye stands (m, the form's foot at the origin), what it looks at, and its field of
/// view (rad, upward).
const FROM = vec3(0.0, 24.0, -100.0)
const TO = vec3(0.0, 21.0, 0.0)
const FOV: f32 = 0.2

pub struct Program {
    frame: Frame,
    solids: Solids<Wears>,
    judge: Judge,
    placed: bool,
    frames: u32,
}

pub fn init() -> Program {
    var frame = picture(load: LOAD)
    if !INK {
        frame.ink = NO_LINES
    }
    Program {
        frame,
        solids: solids(),
        judge: judge(samples: SAMPLES, moments: MOMENTS, settled: 1),
        placed: false,
        frames: 0,
    }
}

/// The eye turned `turned` rad about the form's upright.
fn eye_for(width: u32, height: u32, turned: f32) -> Eye {
    let c = cos(turned)
    let s = sin(turned)
    let from = vec3(FROM.x * c - FROM.z * s, FROM.y, FROM.x * s + FROM.z * c)
    eye_at(from, TO, FOV, width: width, height: height)
}

pub fn frame(p: mut Program, time: f32, width: u32, height: u32) {
    let turned = if JUDGE { TURN * f32(p.judge.moment()) } else { 0.0 }
    let eye = eye_for(width, height, turned)
    let sky: Plain = plain(normalize(SUN))
    if MODE == 0 && !p.placed {
        let pillar = p.solids.load(PILLAR_2_MESH.clone())
        let _ = p.solids.place(pillar, STONE, at: identity(), body: 1, group: 0)
        p.placed = true
    }
    p.frame.begin(eye, sunlit(normalize(SUN), ground: -1000.0))
    if MODE == 0 {
        p.solids.hold = false
        p.solids.cast(mut p.frame)
    }
    p.frame.draw(|d| {
        if MODE == 0 {
            p.solids.draw_into(d)
        }
    })
    p.frames += 1
    if JUDGE && !p.judge.done() {
        p.judge.sized(eye)
        p.judge.resolve(mut p.frame, sky)
        let look = p.judge.looking(eye)
        for b in 0..BANDS {
            trace(mut p.judge, look, p.frame.light, FORM, STONE, sky, band: b, bands: BANDS)
        }
        p.judge.after(p.frame, sky)
        return
    }
    p.judge.heard()
    p.frame.end(sky)
}
