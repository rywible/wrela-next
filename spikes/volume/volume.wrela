// One form deposited into a sparse volume of cells, and the eye's rays marched through it.
//
// The volume: a grid of coarse cells over the form's bound, each a brick of `B`³ fine cells
// `cell` m a side. A brick is kept where the form's surface may pass through it (its distance at
// the brick's middle within `NEAR_BRICK` brick sides); the coarse grid holds, for each brick,
// where in the atlas it was put (`NO_BRICK` for none) and the form's value at its middle. The
// atlas holds each kept brick as `BS`³ texels (`B` + 1: a brick's texels reach its far faces, so
// a filtered read inside it never reads its neighbour), each the form's distance there (its value
// over its gradient's length: near the surface, the distance itself, whatever the form's
// steepness) and the way it faces (its gradient, of unit length).
//
// The march: a ray through the coarse grid, skipping a brick that holds no surface (to its far
// side, or by the form's value over its steepness where that is longer), and through a kept
// brick by the stored distance, until the distance is under a share of the pixel's footprint.
// A few steps more put the point on the surface. It is lit through the frame's one shading
// function, with the stored facing as its normal, and written into the picture's four targets as
// any lister writes them: colour, an edge record (the way to its outline, from the fold field
// `frame::outline` finds a triangle's from, worked out a pixel toward the outline), identity,
// depth.
//
// Static and filled once: the structure a volume filled on demand would hold, without the demand.

use form::ink::InkStyle
use form::kinds::{Paint, Solid}
use form::look::{Look, Place, Skin}
use form::shade::STILL
use frame::eye::{Eye, NEARER}
use frame::last::{cover, covered, displayed, painted}
use frame::load::burn
use frame::light::{Lighting, Shaded, sun_reach, worn}
use frame::outline::{fold_field, way_to_outline}
use frame::picture::{EDGE_REACH, Frame, NO_EDGE, NO_LINE, SOLID, edge_record, identity}
use std::gpu::{
    ClipPosition, DepthTexture, DrawArgs, InstanceIndex, R32Uint, R8, RenderPass, Slots, Texels,
    VertexIndex, buffer_of,
    begin_screen_pass, writable_texture,
    Address, Append, AppendBuffer, Atomics, Filter, FragCoord, GlobalId, GpuBuffer, Rgba32Float,
    Rg32Uint, Rgba16Float, Rgba8, Sampler, Targets3, Texels3d, Texture, Texture3d, WithDepth, append_buffer,
    begin_pass, begin_pass3_with_depth, buffer, dispatch, draw, label, read, sampler, texture,
    texture3d,
}
use std::field::hash_u32
use std::io::{Pending, print}

/// A brick's fine cells a side, and its texels a side in the atlas.
pub const B: u32 = 8
pub const BS: u32 = 9

/// No brick: a coarse cell the surface doesn't pass through.
pub const NO_BRICK: u32 = 4294967295

/// A coarse cell that holds no brick says, from this value up, how many cells off the nearest
/// that holds one is (in its low byte: the greatest of the three ways' counts; `RINGS` + 1 or
/// more: farther than was counted).
const FAR_FROM: u32 = 4294967040

/// How many cells off the nearest kept brick is counted.
const RINGS: u32 = 15

/// The atlas's bricks along x and along y (its bricks along z as many as it needs).
const ROW: u32 = 64

/// The most bricks a volume keeps.
const MOST_BRICKS: u32 = 1048576

/// A brick is kept where the form's distance at its middle is within this many brick sides (its
/// half diagonal is 0.87 of one).
const NEAR_BRICK: f32 = 1.2

/// The most steps a ray takes; how near the surface (a share of the pixel's footprint) a ray has
/// met it (a ray that only passes near it hasn't: its pixel is covered from its neighbour's edge
/// record); and the least a step through a brick is (a share of the footprint: one that crosses
/// the surface is put back on it after).
const MOST_STEPS: u32 = 1024
const TOUCH: f32 = 0.02
const LEAST: f32 = 0.25

/// How many steps through bricks a ray takes before its least step has doubled.
const SKIM: f32 = 1.0e9

/// How near the form (in its own footprints, `rate` pixels each) a scout says it came: a block
/// none of whose four scouts met the form or came this near is sky to its last pixel (the
/// farthest of its pixels is 0.71 footprints from a corner, and an edge's cover reaches 0.75 px
/// more). The bricks kept (`NEAR_BRICK`) hold every place this near the surface at the sizes run.
const SCOUT_NEAR: f32 = 0.9

/// How far from the surface any point of a brick that holds nothing is, at the least (of a
/// brick's side): its middle is `NEAR_BRICK` sides off or more, and its corners 0.87 from that.
const CLEAR_OF: f32 = 0.33

/// How fast a ray closes on a surface or leaves it (the stored facing along the ray) past
/// which it isn't running level with it, for the walk's least step.
const LEVEL_OFF: f32 = 0.1

/// Where a ray steps to the surface's tangent plane rather than by the distance: the stored
/// distance under this share of a brick (where the facing stored with it is the surface's).
const PLANE: f32 = 0.5

/// Where the fold field is read for an outline: facing the eye less than this.
const FOLD_NEAR: f32 = 0.45

/// How far before the nearest of its scouting rays' meetings a joined pixel starts, in the
/// scouting rays' footprints.
const MARGIN: f32 = 2.0

/// How near the four scouting rays' tangent planes must put a joined pixel's ray's meeting, in
/// the scouting rays' footprints, for it to be read once from there rather than walked.
const AGREE: f32 = 0.5

/// How near the surface (in the pixel's footprints) a solve must end to count as settled.
const SETTLED: f32 = 0.5

/// How many bricks that hold nothing a solve looks on through for its sheet.
const PROBED: u32 = 12

/// The most rounds a solve takes, a read each.
const ROUNDS: u32 = 5

/// How level the stored distance runs along a ray (its slope's size) where the ray is at its
/// nearest to a sheet.
const LEVEL: f32 = 0.05

/// How fast a ray may still be closing on a sheet (the slope's size) and count as at its nearest.
const CLOSING: f32 = 0.01

/// The most half-brick steps a ray is looked along for where it next comes on the form.
const NEXT: u32 = 16

/// How far past the farthest its scouts met or came near the form a pixel's walk goes, where
/// its solve couldn't say (bricks).
const PAST: f32 = 4.0

/// The volume's frame as every kernel and pixel program reads it: its least corner (m), a fine
/// cell's side (m), its coarse cells along x, y and z and how many bricks it kept (`size.w`), the
/// form's steepness (its gradient's most, for the skip), and the atlas's texels a side.
pub struct Grid: Copy + GpuData {
    pub lo: vec3,
    pub cell: f32,
    pub size: vec4u,
    pub atlas: vec3,
    pub steep: f32,
    /// The most steps a ray takes (at most `MOST_STEPS`), and whether a pixel shows how many it
    /// took instead of its colour (1).
    pub most: u32,
    pub debug: u32,
    /// Whether a pixel wears the albedo stored in the cells (1) or asks the look (0).
    pub stored: u32,
    /// Whether a joined pixel whose scouts agree reads the volume once (1) or takes its facing
    /// and albedo from its four scouts alone (0).
    pub reads: u32,
    /// Whether smooth blocks are drawn as quads between their scouts (1) or joined at each pixel
    /// by a full-screen pass (0).
    pub quads: u32,
    /// Whether an edge block's pixels are solved (1) or walked (0).
    pub solves: u32,
    /// Whether edge blocks are narrowed to quarters before their pixels are solved (1). Measured
    /// a loss on the pillar (0.15 ms of scouts and sorting for no cheaper pass), so 0.
    pub narrow: u32,
    pub spare: f32,
}

/// The most invocations of a filling kernel in one dispatch (its work bound times this stays
/// well under the host's step limit, `std::gpu::limits().step_work`), and the dispatches a frame.
const BAND: u32 = 2097152
const BANDS_A_FRAME: u32 = 4

/// The same for the coarse grid, which asks the form at each brick's middle (four times over,
/// where its gradient vanishes there: `sloped`).
const COARSE_BAND: u32 = 524288

/// The same for the deposit, which asks the form up to nine times a texel (its place on the
/// surface, and whether that is buried) and the look once.
const DEPOSIT_BAND: u32 = 65536
const DEPOSITS_A_FRAME: u32 = 16

/// A form's volume, and where its filling stands.
pub struct Volume<S> {
    pub form: S,
    pub grid: Grid,
    coarse: Texture3d<Rg32Uint>,
    atlas: Texture3d<Rgba16Float>,
    /// The look's albedo at each atlas texel (its square root, so the darks keep their steps).
    albedo: Texture3d<Rgba8>,
    bricks: AppendBuffer<u32>,
    /// What the filling kernels write, two words a coarse cell or an atlas texel, before a copy
    /// puts it in its texture (a kernel stores only its own texel, so a texture can't be filled a
    /// band at a time).
    raw: GpuBuffer<u32>,
    counted: Option<Pending<u32>>,
    /// 0 the coarse grid's bands; 1 its count asked for; 2 the atlas's bands; 3 filled.
    pub stage: u32,
    /// The next invocation of the stage's kernel, and how many it has.
    cursor: u32,
    total: u32,
    /// The ring being counted (0: the coarse grid's bands aren't done).
    ring: u32,
    s: Sampler,
    /// The scouting march's texels: how far along each met the form and first came near it.
    scout: Texture<Rgba32Float>,
    /// Each scouting block's class, the edge blocks listed, and the draw of them.
    classes: Texture<R32Uint>,
    edges: AppendBuffer<u32>,
    draws: GpuBuffer<DrawArgs>,
    smooth: AppendBuffer<u32>,
    smooth_draws: GpuBuffer<DrawArgs>,
    /// The picture laid out (`laid_out`): each scout's colour (linear; and as the screen shows
    /// it), and the blocks of each kind listed with their draws: those filled from their
    /// corners' colours, those shaded at each pixel, sky painted at each pixel, edges solved.
    scout_k: Texture<Rgba32Float>,
    glow: Texture<Rgba16Float>,
    glow_shown: Texture<Rgba16Float>,
    checks: Texture<R32Uint>,
    fills: AppendBuffer<u32>,
    shades: AppendBuffer<u32>,
    skies: AppendBuffer<u32>,
    kinds_drawn: GpuBuffer<DrawArgs>,
    /// The edge blocks narrowed: their five more scouts each, their quarters, the quarters
    /// listed by kind, and their draws.
    more: GpuBuffer<vec4>,
    quarters: GpuBuffer<Quarter>,
    sky_quarters: AppendBuffer<u32>,
    sheet_quarters: AppendBuffer<u32>,
    edge_quarters: AppendBuffer<u32>,
    quarters_drawn: GpuBuffer<DrawArgs>,
    /// The load beside the frame while it's timed (sines a pixel; 0 none), and its target.
    pub load: u32,
    burned: Texture<R8>,
    /// Light stored on the cells (see "light on the cells"): the light falling on each atlas
    /// texel's surface point; what its surface gives back toward anything (its albedo's share
    /// of that, over π), as an eye's pixel reads it; what the lighting kernels write before a
    /// copy puts it in the textures (four words a texel); the texels near enough the surface
    /// to hold light, listed; and where the lighting stands.
    irr: Texture3d<Rgba16Float>,
    glowing: Texture3d<Rgba8>,
    light_raw: GpuBuffer<u32>,
    shell: AppendBuffer<u32>,
    shell_count: u32,
    shell_asked: Option<Pending<u32>>,
    /// 0 the shell not listed; 1 its count asked for; 2 lighting.
    light_stage: u32,
    light_cursor: u32,
    /// How many whole sweeps of the shell are in the stored light.
    pub sweeps: u32,
    /// The sun the cells last asked about (toward it).
    lit_sun: vec3,
}

/// `form`'s volume, its fine cells `cell` m a side, over a cube round its bound.
pub fn volume<S: Solid>(form: S, cell: f32) -> Volume<S> {
    let b = form.bound()
    let brick = cell * f32(B)
    let n = u32(ceil(2.0 * b.radius / brick))
    assert(n <= 1023, f"a volume of {n} bricks a side: the most is 1023")
    let lo = b.centre - vec3(0.5 * f32(n) * brick)
    Volume {
        form,
        grid: Grid {
            lo,
            cell,
            size: vec4u(n, n, n, 0),
            atlas: vec3(1.0),
            steep: max(form.lipschitz(brick), 1.0),
            most: MOST_STEPS,
            debug: 0,
            stored: 0,
            reads: 1,
            quads: 1,
            solves: 1,
            narrow: 0,
            spare: 0.0,
        },
        coarse: texture3d(width: n, height: n, depth: n),
        atlas: texture3d(width: 1, height: 1, depth: 1),
        albedo: texture3d(width: 1, height: 1, depth: 1),
        bricks: append_buffer(MOST_BRICKS),
        raw: buffer(2 * n * n * n),
        counted: None,
        stage: 0,
        cursor: 0,
        total: n * n * n,
        ring: 0,
        s: sampler(filter: Filter::Linear, address: Address::Clamp),
        scout: texture(width: 1, height: 1),
        classes: writable_texture(width: 1, height: 1),
        edges: append_buffer(1),
        draws: buffer(1),
        smooth: append_buffer(1),
        smooth_draws: buffer(1),
        scout_k: writable_texture(width: 1, height: 1),
        glow: writable_texture(width: 1, height: 1),
        glow_shown: writable_texture(width: 1, height: 1),
        checks: writable_texture(width: 1, height: 1),
        fills: append_buffer(1),
        shades: append_buffer(1),
        skies: append_buffer(1),
        kinds_drawn: buffer(4),
        more: buffer(5),
        quarters: buffer(4),
        sky_quarters: append_buffer(1),
        sheet_quarters: append_buffer(1),
        edge_quarters: append_buffer(1),
        quarters_drawn: buffer(3),
        load: 0,
        burned: texture(width: 1920, height: 1080),
        irr: texture3d(width: 1, height: 1, depth: 1),
        glowing: texture3d(width: 1, height: 1, depth: 1),
        light_raw: buffer(3),
        shell: append_buffer(1),
        shell_count: 0,
        shell_asked: None,
        light_stage: 0,
        light_cursor: 0,
        sweeps: 0,
        lit_sun: vec3(0.0),
    }
}

/// A unit vector in two 16-bit numbers, folded onto an octahedron, and back.
fn folded(n: vec3) -> u32 {
    let a = n / (abs(n.x) + abs(n.y) + abs(n.z))
    var e = a.xz
    if a.y < 0.0 {
        e = (vec2(1.0) - abs(vec2(a.z, a.x))) * vec2(if a.x >= 0.0 { 1.0 } else { -1.0 }, if a.z >= 0.0 { 1.0 } else { -1.0 })
    }
    let q = clamp(e * 0.5 + vec2(0.5), vec2(0.0), vec2(1.0)) * 65535.0
    u32(q.x + 0.5) | (u32(q.y + 0.5) << 16)
}

fn unfolded(w: u32) -> vec3 {
    let e = vec2(f32(w & 65535), f32(w >> 16)) / 65535.0 * 2.0 - vec2(1.0)
    var v = vec3(e.x, 1.0 - abs(e.x) - abs(e.y), e.y)
    let t = max(-v.y, 0.0)
    v.x += if v.x >= 0.0 { -t } else { t }
    v.z += if v.z >= 0.0 { -t } else { t }
    normalize(v)
}

/// A unit vector and an albedo in one word: the vector folded onto an octahedron, 8 bits each
/// way; the albedo's square root in 5, 6 and 5 bits. And back.
fn packed(n: vec3, albedo: vec3) -> u32 {
    let a = n / (abs(n.x) + abs(n.y) + abs(n.z))
    var e = a.xz
    if a.y < 0.0 {
        e = (vec2(1.0) - abs(vec2(a.z, a.x))) * vec2(if a.x >= 0.0 { 1.0 } else { -1.0 }, if a.z >= 0.0 { 1.0 } else { -1.0 })
    }
    let q = clamp(e * 0.5 + vec2(0.5), vec2(0.0), vec2(1.0)) * 255.0 + vec2(0.5)
    let r = sqrt(saturate(albedo)) * vec3(31.0, 63.0, 31.0) + vec3(0.5)
    u32(q.x) | (u32(q.y) << 8) | (u32(r.x) << 16) | (u32(r.y) << 21) | (u32(r.z) << 27)
}

fn unpacked_way(w: u32) -> vec3 {
    let e = vec2(f32(w & 255), f32((w >> 8) & 255)) / 255.0 * 2.0 - vec2(1.0)
    var v = vec3(e.x, 1.0 - abs(e.x) - abs(e.y), e.y)
    let t = max(-v.y, 0.0)
    v.x += if v.x >= 0.0 { -t } else { t }
    v.z += if v.z >= 0.0 { -t } else { t }
    normalize(v)
}

fn unpacked_albedo(w: u32) -> vec3 {
    let r = vec3(f32((w >> 16) & 31) / 31.0, f32((w >> 21) & 63) / 63.0, f32(w >> 27) / 31.0)
    r * r
}

/// A unit vector folded onto an octahedron, as two numbers from -1 to 1, and back.
fn octa(n: vec3) -> vec2 {
    let a = n / (abs(n.x) + abs(n.y) + abs(n.z))
    if a.y >= 0.0 {
        return a.xz
    }
    (vec2(1.0) - abs(vec2(a.z, a.x))) * vec2(if a.x >= 0.0 { 1.0 } else { -1.0 }, if a.z >= 0.0 { 1.0 } else { -1.0 })
}

fn unocta(e: vec2) -> vec3 {
    var v = vec3(e.x, 1.0 - abs(e.x) - abs(e.y), e.y)
    let t = max(-v.y, 0.0)
    v.x += if v.x >= 0.0 { -t } else { t }
    v.z += if v.z >= 0.0 { -t } else { t }
    normalize(v)
}

/// A unit vector as one whole number a float holds exactly (folded, 12 bits each way), and back.
fn faced(n: vec3) -> f32 {
    let q = floor(clamp(octa(n) * 0.5 + vec2(0.5), vec2(0.0), vec2(1.0)) * 4095.0 + vec2(0.5))
    q.x + q.y * 4096.0
}

fn unfaced(w: f32) -> vec3 {
    let k = u32(w)
    unocta(vec2(f32(k & 4095), f32(k >> 12)) / 4095.0 * 2.0 - vec2(1.0))
}

/// An albedo as one whole number a float holds exactly (its square roots, 8 bits each), and back.
fn rooted(albedo: vec3) -> f32 {
    let r = floor(sqrt(saturate(albedo)) * 255.0 + vec3(0.5))
    r.x + r.y * 256.0 + r.z * 65536.0
}

fn unrooted(w: f32) -> vec3 {
    let k = u32(w)
    let r = vec3(f32(k & 255), f32((k >> 8) & 255), f32((k >> 16) & 255)) / 255.0
    r * r
}

/// Coarse cells `first` on: whether the surface may pass through each one's brick (kept, given
/// its place in the atlas) and the form's value at its middle.
@compute(64)
fn coarsed<S: Solid>(form: S, g: Grid, first: u32, out: mut Atomics<u32>, bricks: mut Append<u32>, id: GlobalId) {
    let i = first + id.x
    if i >= g.size.x * g.size.y * g.size.z {
        return
    }
    let x = i % g.size.x
    let y = (i / g.size.x) % g.size.y
    let z = i / (g.size.x * g.size.y)
    let brick = g.cell * f32(B)
    let mid = g.lo + (vec3(f32(x), f32(y), f32(z)) + vec3(0.5)) * brick
    let (f, grad) = sloped(form, mid, 0.25 * g.cell)
    let d = f / max(length(grad), 1.0e-6)
    var slot = NO_BRICK
    if abs(d) < brick * NEAR_BRICK {
        slot = bricks.push(x | (y << 10) | (z << 20))
    }
    let _ = out.exchange(i: 2 * i, value: slot)
    let _ = out.exchange(i: 2 * i + 1, value: bitcast_u32(f))
}

/// Coarse cells `first` on that hold no brick and aren't yet counted: `ring` cells off the
/// nearest that holds one, where one of the 26 round it is `ring` - 1 off (or, `ring` 1, holds
/// one). In place: a cell counted in this pass reads as `ring`, which no cell looks for.
@compute(64)
fn spread(g: Grid, ring: u32, first: u32, out: mut Atomics<u32>, id: GlobalId) {
    let i = first + id.x
    if i >= g.size.x * g.size.y * g.size.z {
        return
    }
    if out.load(2 * i) != NO_BRICK {
        return
    }
    let x = i % g.size.x
    let y = (i / g.size.x) % g.size.y
    let z = i / (g.size.x * g.size.y)
    var found = false
    for dz in 0..3 {
        for dy in 0..3 {
            for dx in 0..3 {
                if x + dx >= 1 && y + dy >= 1 && z + dz >= 1 && x + dx <= g.size.x && y + dy <= g.size.y && z + dz <= g.size.z {
                    let j = (x + dx - 1) + g.size.x * ((y + dy - 1) + g.size.y * (z + dz - 1))
                    let w = out.load(2 * j)
                    if (ring == 1 && w < FAR_FROM) || (ring > 1 && w == (FAR_FROM | (ring - 1))) {
                        found = true
                    }
                }
            }
        }
    }
    if found {
        let _ = out.exchange(i: 2 * i, value: FAR_FROM | ring)
    }
}

/// The coarse grid put in its texture.
@compute(4, 4, 4)
fn coarse_copied(raw: [u32], g: Grid, out: mut Texels3d<Rg32Uint>, id: GlobalId) {
    let i = id.x + g.size.x * (id.y + g.size.y * id.z)
    out.store(id, vec2u(raw[2 * i], raw[2 * i + 1]))
}

/// The mark, in a texel's albedo word, of one whose place on the surface is buried (`deposited`).
const BURIED: u32 = 16777216

/// The form's value and gradient at `p`. Where its gradient vanishes (on a flat face, or midway
/// through a slab, where its nearest face is either: the lattice's places fall on both whenever
/// a form is laid on whole metres), its slope to one side over `h` m is a gradient there, and
/// where that vanishes too, one of unit length straight up: a value over a vanished gradient
/// would be a distance of millions, and a brick or a cell holding the surface dropped.
fn sloped<S: Solid>(form: S, p: vec3, h: f32) -> (f32, vec3) {
    let (f, grad) = form.sample(p)
    if length(grad) >= 1.0e-3 {
        return (f, grad)
    }
    let side = vec3(form.distance(p + vec3(h, 0.0, 0.0)) - f, form.distance(p + vec3(0.0, h, 0.0)) - f, form.distance(p + vec3(0.0, 0.0, h)) - f) / h
    if length(side) >= 1.0e-3 {
        return (f, side)
    }
    (f, vec3(0.0, 1.0, 0.0))
}

/// Atlas texels `first` on, brick by brick: the form's distance and facing at each one's place.
@compute(64)
fn deposited<S: Solid, L: Look>(form: S, look: L, g: Grid, bricks: [u32], first: u32, out: mut Atomics<u32>, id: GlobalId) {
    let i = first + id.x
    let slot = i / (BS * BS * BS)
    if slot >= g.size.w {
        return
    }
    let k = i % (BS * BS * BS)
    let c = bricks[slot]
    let at = vec3(f32(c & 1023), f32((c >> 10) & 1023), f32(c >> 20))
    let local = vec3(f32(k % BS), f32((k / BS) % BS), f32(k / (BS * BS)))
    let p = g.lo + (at * f32(B) + local) * g.cell
    let (f, grad) = sloped(form, p, 0.25 * g.cell)
    let len = length(grad)
    let n = grad / len
    // (What the surface wears where this texel's place falls on it, not at the place itself: a
    // look that changes sharply across a corner must not colour the other face's cells.)
    var on = p - n * (f / len)
    var k: u32 = 0
    var off = true
    while k < 2 && off {
        k += 1
        let (f2, g2) = sloped(form, on, 0.25 * g.cell)
        if abs(f2) > 0.05 * g.cell * length(g2) {
            on = on - g2 * (f2 / dot(g2, g2))
        } else {
            off = false
        }
    }
    let skin = look.skin(Place { world: on, rest: on, chart: None, normal: n })
    let a = sqrt(saturate(skin.albedo)) * 255.0 + vec3(0.5)
    // Whether the texel's place on the surface is buried: no open space a quarter of a cell off
    // it along its facing. Where two forms are joined, the distance inside is to the nearer face
    // of either, and the face of one that lies inside the other (a wall's foot on the ground) is
    // a sheet of zero inside the solid: a surface that isn't there, which a ray could stop on.
    // A texel whose place is on such a sheet is stored as inside (half a cell at the least) with
    // no facing, and holds no light (`BURIED`).
    var d = f / len
    var mark: u32 = 0
    if d < 0.01 * g.cell {
        let eps = 0.25 * g.cell
        let (_, go) = sloped(form, on, eps)
        let (fp, gp) = sloped(form, on + go * (eps / length(go)), eps)
        if fp < -0.5 * eps * length(gp) {
            d = min(d, -0.5 * g.cell)
            mark = BURIED
        }
    }
    let _ = out.exchange(i: 3 * i, value: bitcast_u32(d))
    let _ = out.exchange(i: 3 * i + 1, value: folded(n))
    let _ = out.exchange(i: 3 * i + 2, value: u32(a.x) | (u32(a.y) << 8) | (u32(a.z) << 16) | mark)
}

/// The atlas put in its texture: each texel's brick and place in it, read from what `deposited`
/// wrote.
@compute(4, 4, 4)
fn atlas_copied(raw: [u32], g: Grid, out: mut Texels3d<Rgba16Float>, albedo: mut Texels3d<Rgba8>, id: GlobalId) {
    let slot = id.x / BS + ROW * (id.y / BS + ROW * (id.z / BS))
    if slot >= g.size.w {
        out.store(id, vec4(1.0, 0.0, 0.0, 0.0))
        albedo.store(id, vec4(0.0))
        return
    }
    let i = slot * BS * BS * BS + id.x % BS + BS * (id.y % BS + BS * (id.z % BS))
    // (A buried texel has no facing, so it leans no read of the facing round it; and its
    // albedo's alpha is 0, an open one's 1: light read there is shared among the open.)
    let a = raw[3 * i + 2]
    let open = (a & BURIED) == 0
    out.store(id, vec4(bitcast_f32(raw[3 * i]), if open { unfolded(raw[3 * i + 1]) } else { vec3(0.0) }))
    albedo.store(id, vec4(f32(a & 255), f32((a >> 8) & 255), f32((a >> 16) & 255), if open { 255.0 } else { 0.0 }) / 255.0)
}

impl<S: Solid> Volume<S> {
    /// Some of the filling, `BANDS_A_FRAME` dispatches of it a frame: the coarse grid in bands
    /// and its count asked for; then, once the count is read, the atlas made to hold the bricks
    /// kept and filled in bands; each copied into its texture when its last band is done.
    pub fn fill<L: Look>(mut self, look: L) {
        if self.stage == 0 && self.ring == 0 {
            label("coarse")
            for _b in 0..BANDS_A_FRAME {
                if self.cursor < self.total {
                    dispatch(
                        coarsed.bind(self.form, g: self.grid, first: self.cursor, out: mut self.raw, bricks: mut self.bricks),
                        over: COARSE_BAND,
                    )
                    self.cursor += COARSE_BAND
                }
            }
            if self.cursor >= self.total && self.ring == 0 {
                self.ring = 1
                self.cursor = 0
            }
            return
        }
        if self.stage == 0 {
            // How far each cell that holds no brick is from the nearest that does, a ring a pass.
            label("spread")
            for _b in 0..BANDS_A_FRAME {
                if self.cursor < self.total {
                    dispatch(spread.bind(g: self.grid, ring: self.ring, first: self.cursor, out: mut self.raw), over: BAND)
                    self.cursor += BAND
                }
            }
            if self.cursor >= self.total {
                self.ring += 1
                self.cursor = 0
            }
            if self.ring > RINGS {
                dispatch(coarse_copied.bind(raw: self.raw.items(), g: self.grid, out: mut self.coarse), over: self.coarse)
                self.counted = Some(read(self.bricks.count()))
                self.stage = 1
            }
            return
        }
        if self.stage == 1 {
            match mut self.counted {
                Some(p) => match p.poll() {
                    Some(Ok(v)) => {
                        let n = min(v[0], MOST_BRICKS)
                        let layers = (n + ROW * ROW - 1) / (ROW * ROW)
                        let size = vec3u(ROW * BS, ROW * BS, max(layers, 1) * BS)
                        self.atlas = texture3d(width: size.x, height: size.y, depth: size.z)
                        self.grid.size.w = n
                        self.grid.atlas = vec3(f32(size.x), f32(size.y), f32(size.z))
                        self.total = n * BS * BS * BS
                        self.raw = buffer(max(3 * self.total, 3))
                        self.albedo = texture3d(width: size.x, height: size.y, depth: size.z)
                        self.cursor = 0
                        let brick = self.grid.cell * f32(B)
                        let mb = f32(size.x * size.y * size.z) * 8.0 / 1048576.0
                        print(
                            f"volume: {n} bricks kept of {self.grid.size.x * self.grid.size.y * self.grid.size.z} ({brick} m each, cells {self.grid.cell} m); atlas {size.x} x {size.y} x {size.z}, {mb} MB",
                        )
                        self.counted = None
                        self.stage = 2
                    },
                    _ => {},
                },
                None => {},
            }
            return
        }
        if self.stage == 2 {
            label("deposited")
            for _b in 0..DEPOSITS_A_FRAME {
                if self.cursor < self.total {
                    dispatch(
                        deposited.bind(self.form, look: look, g: self.grid, bricks: self.bricks.items(), first: self.cursor, out: mut self.raw),
                        over: DEPOSIT_BAND,
                    )
                    self.cursor += DEPOSIT_BAND
                }
            }
            if self.cursor >= self.total {
                dispatch(atlas_copied.bind(raw: self.raw.items(), g: self.grid, out: mut self.atlas, albedo: mut self.albedo), over: self.atlas)
                self.raw = buffer(2)
                self.stage = 3
            }
        }
    }

    /// Whether the volume is filled.
    pub fn filled(self) -> bool {
        self.stage == 3
    }

    /// The form marched through its volume as `look` wears it, into `frame`'s picture, as body
    /// `body`: at every pixel where `rate` is 1; else scouted at one ray each `rate` × `rate`
    /// pixels first, and each pixel joined from it.
    pub fn draw_into<L: Look>(mut self, frame: mut Frame, look: L, body: u32, rate: u32) {
        let w = u32(frame.eye.size.x)
        let h = u32(frame.eye.size.y)
        if rate > 1 {
            let sw = (w + rate - 1) / rate + 1
            let sh = (h + rate - 1) / rate + 1
            if self.scout.width() != sw || self.scout.height() != sh {
                self.scout = texture(width: sw, height: sh)
            }
            if self.classes.width() != sw || self.classes.height() != sh {
                self.classes = writable_texture(width: sw, height: sh)
                self.edges = append_buffer(sw * sh)
                self.smooth = append_buffer(sw * sh)
            }
            label("scouted")
            let p = begin_pass(mut self.scout, clear: vec4(0.0))
            draw(
                p,
                cover,
                scouted.bind(
                    eye: frame.eye,
                    g: self.grid,
                    coarse: self.coarse,
                    atlas: self.atlas,
                    albedo: self.albedo,
                    s: self.s,
                    rate: f32(rate),
                ),
                vertices: 3,
            )
            p.end()
            label("classed")
            self.edges.clear()
            self.smooth.clear()
            dispatch(
                classed.bind(
                    eye: frame.eye,
                    scout: self.scout,
                    rate: f32(rate),
                    out: mut self.classes,
                    edges: mut self.edges,
                    smooth: mut self.smooth,
                ),
                groups: ((sw + 7) / 8, (sh + 7) / 8, 1),
            )
            dispatch(edges_drawn.bind(count: self.edges.count(), most: sw * sh, out: mut self.draws), groups: 1)
            dispatch(edges_drawn.bind(count: self.smooth.count(), most: sw * sh, out: mut self.smooth_draws), groups: 1)
        }
        label(if rate > 1 { "joined" } else { "marched" })
        let first = frame.first()
        let q = begin_pass3_with_depth(
            mut frame.colour,
            mut frame.edge,
            mut frame.identity,
            mut frame.depth,
            clear: vec4(0.0),
            keep: !first,
            clear_depth: 0.0,
            keep_depth: !first,
        )
        if rate > 1 {
            if self.grid.quads == 1 && (self.grid.debug & 8192) != 0 {
                // (The patches left out, to time the edge blocks alone.)
            } else if self.grid.quads == 1 {
                draw(
                    q,
                    patch_corner.bind(blocks: self.smooth.items(), eye: frame.eye, scout: self.scout, rate: f32(rate)),
                    patched.bind(
                        eye: frame.eye,
                        light: frame.light,
                        g: self.grid,
                        coarse: self.coarse,
                        atlas: self.atlas,
                        albedo: self.albedo,
                        s: self.s,
                        body: body,
                    ),
                    indirect: self.smooth_draws.span(start: 0, count: 1),
                    depth: NEARER,
                )
            } else {
                draw(
                    q,
                    cover,
                    joined.bind(
                        eye: frame.eye,
                        light: frame.light,
                        look: look,
                        g: self.grid,
                        coarse: self.coarse,
                        atlas: self.atlas,
                        albedo: self.albedo,
                        s: self.s,
                        body: body,
                        scout: self.scout,
                        classes: self.classes,
                        rate: f32(rate),
                    ),
                    vertices: 3,
                    depth: NEARER,
                )
            }
            if (self.grid.debug & 4096) == 0 {
                draw(
                    q,
                    block_corner.bind(edges: self.edges.items(), size: frame.eye.size, rate: f32(rate)),
                    edged.bind(
                        eye: frame.eye,
                        light: frame.light,
                        look: look,
                        g: self.grid,
                        coarse: self.coarse,
                        atlas: self.atlas,
                        albedo: self.albedo,
                        s: self.s,
                        body: body,
                        scout: self.scout,
                        rate: f32(rate),
                    ),
                    indirect: self.draws.span(start: 0, count: 1),
                    depth: NEARER,
                )
            }
        } else {
            draw(
                q,
                cover,
                marched.bind(
                    eye: frame.eye,
                    light: frame.light,
                    look: look,
                    g: self.grid,
                    coarse: self.coarse,
                    atlas: self.atlas,
                    albedo: self.albedo,
                    s: self.s,
                    body: body,
                ),
                vertices: 3,
                depth: NEARER,
            )
        }
        q.end()
    }
}

/// The stored distance and facing at `p`, or the brick's side and nothing where no brick is kept.
fn field_at(
    g: Grid,
    coarse: Texture3d<Rg32Uint>,
    atlas: Texture3d<Rgba16Float>,
    s: Sampler,
    brick: f32,
    top: vec3,
    p: vec3,
) -> vec4 {
    let q = (p - g.lo) / brick
    let c = clamp(floor(q), vec3(0.0), top)
    let k = coarse.load(u32(c.x), u32(c.y), u32(c.z))
    if k.x >= FAR_FROM {
        // (A brick that holds nothing is a brick's side from the surface at the least: outside
        // the form, or by its sign inside it.)
        return vec4(if bitcast_f32(k.y) < 0.0 { -brick } else { brick }, 0.0, 0.0, 0.0)
    }
    let a = vec3(f32(k.x % ROW), f32((k.x / ROW) % ROW), f32(k.x / (ROW * ROW))) * f32(BS)
    let local = clamp((q - c) * f32(B), vec3(0.0), vec3(f32(B)))
    atlas.sample_level(s, (a + local + vec3(0.5)) / g.atlas, 0.0)
}

/// The stored distance and facing at `p` (as `field_at`) and the albedo stored there (`w` 1; all
/// 0 where no brick is kept), from one look in the coarse grid.
fn cell_at(
    g: Grid,
    coarse: Texture3d<Rg32Uint>,
    atlas: Texture3d<Rgba16Float>,
    albedo: Texture3d<Rgba8>,
    s: Sampler,
    brick: f32,
    top: vec3,
    p: vec3,
) -> (vec4, vec4) {
    let q = (p - g.lo) / brick
    let c = clamp(floor(q), vec3(0.0), top)
    let k = coarse.load(u32(c.x), u32(c.y), u32(c.z))
    if k.x >= FAR_FROM {
        return (vec4(brick, 0.0, 0.0, 0.0), vec4(0.0))
    }
    let a = vec3(f32(k.x % ROW), f32((k.x / ROW) % ROW), f32(k.x / (ROW * ROW))) * f32(BS)
    let local = clamp((q - c) * f32(B), vec3(0.0), vec3(f32(B)))
    let uvw = (a + local + vec3(0.5)) / g.atlas
    let r = albedo.sample_level(s, uvw, 0.0).xyz
    (atlas.sample_level(s, uvw, 0.0), vec4(r * r, 1.0))
}

/// Where a ray from `o` along `d` (unit) enters and leaves the box from `lo` to `hi` (m along it).
fn box_span(o: vec3, d: vec3, lo: vec3, hi: vec3) -> vec2 {
    let inv = vec3(1.0) / d
    let a = (lo - o) * inv
    let b = (hi - o) * inv
    let near = min(a, b)
    let far = max(a, b)
    vec2(max(max(near.x, near.y), near.z), min(min(far.x, far.y), far.z))
}

/// What a walk along a ray found: whether it met the surface, how far along it (m), the stored
/// field there, and how far along it the ray first came within its `near` footprints of the
/// surface without meeting it (0: never).
struct Walked: Copy {
    met: bool,
    t: f32,
    v: vec4,
    near: f32,
    steps: u32,
    empty: u32,
    /// How many steps onto the surface it still wants (2 after a walk, 0 where already settled).
    again: u32,
    /// The look's albedo stored where it was last read (`w` 1), or none yet (`w` 0).
    albedo: vec4,
    /// How far along the ray was last within its `near` footprints of the surface (0: never).
    last: f32,
    /// The least stored distance it read (m), and where along the ray and what was stored there.
    least: f32,
    least_t: f32,
    least_v: vec4,
}

/// A ray from `o` along `d` walked through the volume from `from` to `to` m along it: through a
/// brick that holds no surface to its far side, or by the form's value over its steepness where
/// that is longer; through a kept brick by the stored distance, never less than a share of the
/// pixel's footprint (`px` a metre off), until it is within a smaller share of it.
fn walk(
    g: Grid,
    coarse: Texture3d<Rg32Uint>,
    atlas: Texture3d<Rgba16Float>,
    s: Sampler,
    o: vec3,
    d: vec3,
    from: f32,
    to: f32,
    px: f32,
    near: f32,
) -> Walked {
    let brick = g.cell * f32(B)
    let touch = TOUCH * px
    let floor_step = LEAST * px
    let whole = g.cell
    let clear_of = CLEAR_OF * brick
    let half_cell = 0.5 * g.cell
    let close = near * px
    let plane = PLANE * brick
    let top = vec3(f32(g.size.x - 1), f32(g.size.y - 1), f32(g.size.z - 1))
    let nudge = 0.02 * brick
    let half = vec3(0.5 * brick)
    var t = from
    var met = false
    var v = vec4(0.0)
    var first_near = 0.0
    var last_near = 0.0
    var least = 1.0e9
    var least_t = 0.0
    var least_v = vec4(0.0)
    var steps: u32 = 0
    var empty: u32 = 0
    // (How far the last step went, where it went farther than the distance read: a guess.)
    var guessed = 0.0
    while steps < MOST_STEPS && steps < g.most && !met && t < to {
        {
            steps += 1
            let p = o + d * t
            let q = (p - g.lo) / brick
            let c = clamp(floor(q), vec3(0.0), top)
            let k = coarse.load(u32(c.x), u32(c.y), u32(c.z))
            if k.x >= FAR_FROM {
                empty += 1
                let cell_lo = g.lo + c * brick
                let ex = if d.x > 0.0 { (cell_lo.x + brick - p.x) / d.x } else if d.x < 0.0 { (cell_lo.x - p.x) / d.x } else { 1.0e30 }
                let ey = if d.y > 0.0 { (cell_lo.y + brick - p.y) / d.y } else if d.y < 0.0 { (cell_lo.y - p.y) / d.y } else { 1.0e30 }
                let ez = if d.z > 0.0 { (cell_lo.z + brick - p.z) / d.z } else if d.z < 0.0 { (cell_lo.z - p.z) / d.z } else { 1.0e30 }
                let exit = min(ex, min(ey, ez))
                let mid = cell_lo + half
                let far = abs(bitcast_f32(k.y)) / g.steep - length(p - mid)
                // (Or as many bricks as lie between here and the nearest that holds any, less one.)
                let rings = f32(min(k.x & 255, RINGS + 1) - 1) * brick
                // (Here the surface is at least that far off, and what a brick that holds
                // nothing is from it besides.)
                if rings + clear_of < least {
                    least = rings + clear_of
                    least_t = t
                    least_v = vec4(0.0)
                }
                t += max(max(exit, far), rings) + nudge
                guessed = 0.0
            } else {
                let a = vec3(f32(k.x % ROW), f32((k.x / ROW) % ROW), f32(k.x / (ROW * ROW))) * f32(BS)
                let local = clamp((q - c) * f32(B), vec3(0.0), vec3(f32(B)))
                v = atlas.sample_level(s, (a + local + vec3(0.5)) / g.atlas, 0.0)
                if v.x < least {
                    least = v.x
                    least_t = t
                    least_v = v
                }
                if v.x + floor_step * t < 0.0 && guessed > floor_step * t {
                    // A guessed step (to a tangent plane, or its least) that went well into the
                    // form: the plane it aimed at was behind another face (a wall's, where it
                    // stands on the ground). Half of it is taken back, and half again, until
                    // the ray is out of the form or within its least step of where it went in.
                    guessed = 0.5 * guessed
                    t -= guessed
                } else if v.x < touch * t {
                    met = true
                } else {
                    if v.x < close * t {
                        if first_near == 0.0 {
                            first_near = t
                        }
                        last_near = t
                    }
                    // To the surface's tangent plane where the stored facing is good (the
                    // distance over the cosine, at most four times it), else by the distance.
                    var step = v.x
                    let lean_in = -dot(v.yzw, d)
                    if v.x < plane && lean_in > 0.2 {
                        step = min(v.x / lean_in, 4.0 * v.x)
                    }
                    // The least step: a share of the footprint; and, where the ray isn't closing
                    // on the surface, of a cell: half one where it runs level with it, a whole
                    // one where it is leaving it. (A ray level with a surface a metre round goes
                    // a tenth of a millimetre into it over half a cell: what is stepped over is
                    // far under a pixel, and finer than the cells hold.)
                    let along = dot(v.yzw, d)
                    let by_cell = if along > LEVEL_OFF { whole } else if along > -LEVEL_OFF { half_cell } else { 0.0 }
                    let took = max(step, max(floor_step * t, by_cell))
                    guessed = if took > v.x { took } else { 0.0 }
                    t += took
                }
            }
        }
    }
    Walked { met, t, v, near: first_near, steps, empty, again: 2, albedo: vec4(0.0), last: last_near, least, least_t, least_v }
}

/// Nothing drawn at a pixel.
fn nothing() -> WithDepth<Targets3<vec4, vec4, u32>> {
    WithDepth { color: Targets3 { first: vec4(0.0), second: vec4(0.0), third: 0 }, depth: 0.0 }
}

/// The pixel where a walk met the form: put on its surface, lit, its outline's way, written as
/// a lister writes its pixels.
fn shown<L: Look>(
    pixel: vec2,
    eye: Eye,
    light: Lighting,
    look: L,
    g: Grid,
    coarse: Texture3d<Rg32Uint>,
    atlas: Texture3d<Rgba16Float>,
    albedo: Texture3d<Rgba8>,
    s: Sampler,
    body: u32,
    o: vec3,
    d: vec3,
    met: Walked,
) -> WithDepth<Targets3<vec4, vec4, u32>> {
    let brick = g.cell * f32(B)
    let top = vec3(f32(g.size.x - 1), f32(g.size.y - 1), f32(g.size.z - 1))
    let px = eye.pixel()
    var t = met.t
    var v = met.v
    // Onto the surface: the stored distance taken along the ray, twice.
    for k in 0..2 {
        if k < met.again {
            t += v.x / max(-dot(v.yzw, d), 0.25)
            let w = field_at(g, coarse, atlas, s, brick, top, o + d * t)
            if w.y != 0.0 || w.z != 0.0 || w.w != 0.0 {
                v = w
            }
        }
    }
    let p = o + d * t
    let n = normalize(v.yzw)
    var skin = Skin { albedo: vec3(0.0), line: 1.0, metal: 0.0, rim: false, emits: vec3(0.0) }
    if g.stored == 1 && met.albedo.w > 0.5 {
        skin.albedo = met.albedo.xyz
    } else if g.stored == 1 {
        let q = (p - g.lo) / brick
        let c = clamp(floor(q), vec3(0.0), top)
        let k = coarse.load(u32(c.x), u32(c.y), u32(c.z))
        if k.x < FAR_FROM {
            let a = vec3(f32(k.x % ROW), f32((k.x / ROW) % ROW), f32(k.x / (ROW * ROW))) * f32(BS)
            let local = clamp((q - c) * f32(B), vec3(0.0), vec3(f32(B)))
            let r = albedo.sample_level(s, (a + local + vec3(0.5)) / g.atlas, 0.0).xyz
            skin.albedo = r * r
        }
    } else {
        skin = look.skin(Place { world: p, rest: p, chart: None, normal: n })
    }
    var lit = Shaded { colour: skin.albedo, line: 1.0 }
    if (g.debug & 8) == 0 {
        lit = worn(light, skin, p, n, -d, STILL, reach: sun_reach(light, p))
    }
    // The way to its outline. A ray a little inside a smooth outline dips into the form and out,
    // as deep at its deepest as it is inside, so that depth over the footprint a pixel moves the
    // ray (along the way the normal leans on the screen) is how many pixels inside it is. Its
    // depth from the field along the ray: met with slope n·d, bending by how the facing changes a
    // cell on (the field's second derivative along the ray), deepest at (n·d)² over twice that.
    var way = NO_EDGE
    let nv = dot(n, -d)
    if nv < FOLD_NEAR && (g.debug & 4) == 0 {
        let lean = vec2(dot(n, eye.right), -dot(n, eye.up))
        if dot(lean, lean) > 1.0e-8 {
            let w = field_at(g, coarse, atlas, s, brick, top, p + d * g.cell)
            if w.y != 0.0 || w.z != 0.0 || w.w != 0.0 {
                let bend = (dot(normalize(w.yzw), d) + nv) / g.cell
                if bend > 1.0e-6 {
                    let deep = nv * nv / (2.0 * bend)
                    way = normalize(lean) * (deep / (px * t * length(lean)))
                }
            }
        }
    }
    var colour = lit.colour
    if (g.debug & 3) == 2 {
        colour = vec3(f32(met.empty) / 48.0, f32(met.steps - met.empty) / 48.0, 0.0)
    }
    if (g.debug & 3) == 1 {
        let k = f32(met.steps) / 64.0
        colour = vec3(saturate(k), saturate(k - 1.0), saturate(k - 2.0))
    }
    WithDepth {
        color: Targets3 {
            first: vec4(colour, 0.0),
            second: edge_record(way, 1.0, NO_LINE),
            third: identity(SOLID, body: body, group: 0),
        },
        depth: eye.depth(p),
    }
}

/// Where a pixel's ray crosses the volume's box (m along it), from the eye's near plane.
fn crossing(eye: Eye, g: Grid, d: vec3) -> vec2 {
    let brick = g.cell * f32(B)
    let hi = g.lo + vec3(f32(g.size.x), f32(g.size.y), f32(g.size.z)) * brick
    let span = box_span(eye.at, d, g.lo, hi)
    vec2(max(span.x, eye.near), span.y)
}

/// A pixel of the form, marched through its volume.
@fragment
pub fn marched<L: Look>(
    pixel: FragCoord,
    eye: Eye,
    light: Lighting,
    look: L,
    g: Grid,
    coarse: Texture3d<Rg32Uint>,
    atlas: Texture3d<Rgba16Float>,
    albedo: Texture3d<Rgba8>,
    s: Sampler,
    body: u32,
) -> WithDepth<Targets3<vec4, vec4, u32>> {
    let d = eye.ray(pixel.position.xy)
    let span = crossing(eye, g, d)
    if !(span.x < span.y) {
        return nothing()
    }
    let w = walk(g, coarse, atlas, s, eye.at, d, from: span.x, to: span.y, px: eye.pixel(), near: 0.0)
    if !w.met {
        return nothing()
    }
    if (g.debug & 128) != 0 {
        return WithDepth {
            color: Targets3 { first: vec4(w.v.yzw, 0.0), second: edge_record(NO_EDGE, 1.0, NO_LINE), third: identity(SOLID, body: body, group: 0) },
            depth: eye.depth(eye.at + d * w.t),
        }
    }
    shown(pixel.position.xy, eye, light, look, g, coarse, atlas, albedo, s, body, eye.at, d, w)
}

/// A texel of the scouting march, one each `rate` × `rate` pixels: how far along its ray it met
/// the form (not: under 0, less how far along it was last within two of its footprints of the
/// form, or 0), its facing and albedo there, and how far along the ray first came within two of
/// its footprints of the form (0: never), whether or not it went on to meet it. One that didn't
/// meet it holds, in place of a facing, whether it came near it (`SCOUT_NEAR`: 1 or 0).
@fragment
pub fn scouted(
    pixel: FragCoord,
    eye: Eye,
    g: Grid,
    coarse: Texture3d<Rg32Uint>,
    atlas: Texture3d<Rgba16Float>,
    albedo: Texture3d<Rgba8>,
    s: Sampler,
    rate: f32,
) -> vec4 {
    // (Scouts stand at the corners of blocks of `rate` × `rate` pixels: texel (i, j)'s ray is
    // through the screen at (i, j) × `rate`.)
    let d = eye.ray((pixel.position.xy - vec2(0.5)) * rate)
    let span = crossing(eye, g, d)
    if !(span.x < span.y) {
        return vec4(0.0)
    }
    let w = walk(g, coarse, atlas, s, eye.at, d, from: span.x, to: span.y, px: eye.pixel() * rate, near: 2.0)
    if !w.met {
        return vec4(-w.last, if w.least < SCOUT_NEAR * rate * eye.pixel() * w.least_t { 1.0 } else { 0.0 }, 0.0, w.near)
    }
    let n = normalize(w.v.yzw)
    let t = w.t + w.v.x / max(-dot(n, d), 0.25)
    let brick = g.cell * f32(B)
    let top = vec3(f32(g.size.x - 1), f32(g.size.y - 1), f32(g.size.z - 1))
    let (_, a) = cell_at(g, coarse, atlas, albedo, s, brick, top, eye.at + d * t)
    vec4(t, faced(n), rooted(a.xyz), w.near)
}

/// The same, a scout an invocation (a pass this small costs more to begin than its rays do).
@compute(8, 8)
fn scouted_each(
    eye: Eye,
    g: Grid,
    coarse: Texture3d<Rg32Uint>,
    atlas: Texture3d<Rgba16Float>,
    albedo: Texture3d<Rgba8>,
    s: Sampler,
    out_size: vec2u,
    rate: f32,
    out: mut Texels<Rgba32Float>,
    id: GlobalId,
) {
    if id.x >= out_size.x || id.y >= out_size.y {
        return
    }
    // (Scouts stand at the corners of blocks of `rate` × `rate` pixels: texel (i, j)'s ray is
    // through the screen at (i, j) × `rate`.)
    let d = eye.ray(vec2(f32(id.x), f32(id.y)) * rate)
    let span = crossing(eye, g, d)
    if !(span.x < span.y) {
        out.store(id, vec4(0.0))
        return
    }
    let w = walk(g, coarse, atlas, s, eye.at, d, from: span.x, to: span.y, px: eye.pixel() * rate, near: 2.0)
    if !w.met {
        out.store(id, vec4(-w.last, if w.least < SCOUT_NEAR * rate * eye.pixel() * w.least_t { 1.0 } else { 0.0 }, 0.0, w.near))
        return
    }
    let n = normalize(w.v.yzw)
    let t = w.t + w.v.x / max(-dot(n, d), 0.25)
    let brick = g.cell * f32(B)
    let top = vec3(f32(g.size.x - 1), f32(g.size.y - 1), f32(g.size.z - 1))
    let (_, a) = cell_at(g, coarse, atlas, albedo, s, brick, top, eye.at + d * t)
    out.store(id, vec4(t, faced(n), rooted(a.xyz), w.near))
}

/// What a pixel reads from its four scouting rays: the nearest that any met the form or came near
/// it (m along its ray; 1e30 for none); and, where all four met it, where their tangent planes
/// meet this pixel's ray, blended by how near each scout is, how far those meetings are spread
/// (`least`, `most`), and the facing and albedo blended the same way.
struct Scouts: Copy {
    start: f32,
    met: u32,
    blend: f32,
    least: f32,
    most: f32,
    way: vec3,
    albedo: vec3,
    /// The farthest any of the four met the form or was last near it (m along its own ray; 0
    /// where none did).
    far: f32,
    /// How far along this pixel's ray each of the four puts the form where it met it (by its
    /// tangent plane, where that faces the ray; else as far as it met it itself; 0: it didn't).
    depths: vec4,
    /// Where each of the four met the form (the world's; unset where it didn't: `depths` 0).
    q0: vec3,
    q1: vec3,
    q2: vec3,
    q3: vec3,
}

fn scouts_at(eye: Eye, scout: Texture<Rgba32Float>, rate: f32, pixel: vec2, d: vec3) -> Scouts {
    let c = pixel / rate
    let top = vec2(f32(scout.width() - 1), f32(scout.height() - 1))
    let lo = clamp(floor(c), vec2(0.0), top)
    let hi = min(lo + vec2(1.0), top)
    let f = saturate(c - lo)
    var out = Scouts { start: 1.0e30, met: 0, blend: 0.0, least: 1.0e30, most: 0.0, way: vec3(0.0), albedo: vec3(0.0), far: 0.0, depths: vec4(0.0), q0: vec3(0.0), q1: vec3(0.0), q2: vec3(0.0), q3: vec3(0.0) }
    for k in 0..4 {
        let x = if k % 2 == 0 { lo.x } else { hi.x }
        let y = if k / 2 == 0 { lo.y } else { hi.y }
        let e = scout.load(u32(x), u32(y))
        if e.x > 0.0 {
            out.start = min(out.start, e.x)
            out.far = max(out.far, e.x)
        }
        if e.w > 0.0 {
            out.start = min(out.start, e.w)
        }
        if e.x < 0.0 {
            out.far = max(out.far, -e.x)
        }
        if e.x > 0.0 {
            let n = unfaced(e.y)
            let at = eye.at + eye.ray(vec2(x, y) * rate) * e.x
            let facing = dot(n, d)
            var depth = e.x
            if facing < -0.05 {
                depth = clamp(dot(n, at - eye.at) / facing, 0.5 * e.x, 2.0 * e.x)
            }
            if k == 0 {
                out.depths.x = depth
                out.q0 = at
            } else if k == 1 {
                out.depths.y = depth
                out.q1 = at
            } else if k == 2 {
                out.depths.z = depth
                out.q2 = at
            } else {
                out.depths.w = depth
                out.q3 = at
            }
            if facing < -0.05 {
                let tp = dot(n, at - eye.at) / facing
                let wx = if k % 2 == 0 { 1.0 - f.x } else { f.x }
                let wy = if k / 2 == 0 { 1.0 - f.y } else { f.y }
                out.blend += tp * wx * wy
                out.way += n * (wx * wy)
                out.albedo += unrooted(e.z) * (wx * wy)
                out.least = min(out.least, tp)
                out.most = max(out.most, tp)
                out.met += 1
            }
        }
    }
    out
}

/// What a block of the scouting march is (the output pixels between four scouts, each block's
/// pixels joined from the same four): `EMPTY` none of the four met the form or came near it;
/// `SMOOTH` all four met it and their tangent planes agree where the block's middle ray meets
/// them; `EDGE` anything else.
const EMPTY: u32 = 0
const SMOOTH: u32 = 1
const EDGE: u32 = 2

/// Each block of the scouting march, classed, and an edge block listed (x | y << 16).
@compute(8, 8)
fn classed(
    eye: Eye,
    scout: Texture<Rgba32Float>,
    rate: f32,
    out: mut Texels<R32Uint>,
    edges: mut Append<u32>,
    smooth: mut Append<u32>,
    id: GlobalId,
) {
    if id.x + 1 >= scout.width() || id.y + 1 >= scout.height() {
        return
    }
    let mid = (vec2(f32(id.x), f32(id.y)) + vec2(0.5)) * rate
    let d = eye.ray(mid)
    let k = scouts_at(eye, scout, rate, mid, d)
    var class = EMPTY
    if k.start < 1.0e29 {
        class = EDGE
        if k.met == 4 && k.most - k.least < AGREE * rate * eye.pixel() * k.least {
            class = SMOOTH
        }
    }
    if class == EDGE {
        let _ = edges.push(id.x | (id.y << 16))
    }
    if class == SMOOTH {
        let _ = smooth.push(id.x | (id.y << 16))
    }
    out.store(id, class)
}

/// The draw of the edge blocks: six corners an edge block.
@compute(1)
fn edges_drawn(count: [u32], most: u32, out: mut Slots<DrawArgs>, id: GlobalId) {
    out[id] = DrawArgs { vertices: 6, instances: min(count[0], most), first_vertex: 0, first_instance: 0 }
}

/// A corner of an edge block's quad, over the output pixels it joins.
pub struct BlockCorner: Copy {
    pub clip: ClipPosition,
}

const QUAD: [u32; 6] = [0, 1, 2, 2, 1, 3]

@vertex
pub fn block_corner(v: VertexIndex, i: InstanceIndex, edges: [u32], size: vec2, rate: f32) -> BlockCorner {
    let b = edges[i.index]
    let j = QUAD[v.index % 6]
    let x = f32(b & 65535) + f32(j & 1)
    let y = f32(b >> 16) + f32((j >> 1) & 1)
    let p = vec2(x, y) * rate
    BlockCorner { clip: ClipPosition { position: vec4(p.x / size.x * 2.0 - 1.0, 1.0 - p.y / size.y * 2.0, 0.0, 1.0) } }
}

/// A corner of a smooth block's quad, at one of its four scouts: where that scout met the form,
/// its facing and albedo there, and its outline's field (`frame::outline`).
pub struct Patch: Copy {
    pub clip: ClipPosition,
    pub world: vec3,
    pub normal: vec3,
    pub albedo: vec3,
    pub field: f32,
}

@vertex
pub fn patch_corner(v: VertexIndex, i: InstanceIndex, blocks: [u32], eye: Eye, scout: Texture<Rgba32Float>, rate: f32) -> Patch {
    let b = blocks[i.index]
    let j = QUAD[v.index % 6]
    let x = (b & 65535) + (j & 1)
    let y = (b >> 16) + ((j >> 1) & 1)
    let e = scout.load(x, y)
    let pixel = vec2(f32(x), f32(y)) * rate
    let d = eye.ray(pixel)
    let world = eye.at + d * e.x
    let n = unfaced(e.y)
    // On the screen exactly where the block's corner is (so quads and edge blocks share their
    // sides to the bit), as deep as its point.
    let z = dot(world - eye.at, eye.forward)
    let on = vec2(pixel.x / eye.size.x * 2.0 - 1.0, 1.0 - pixel.y / eye.size.y * 2.0)
    Patch {
        clip: ClipPosition { position: vec4(on * z, eye.near, z) },
        world,
        normal: n,
        albedo: unrooted(e.z),
        field: fold_field(n, -d),
    }
}

/// A pixel of a smooth block's quad: its place, facing and albedo laid across the quad from its
/// scouts by the rasteriser (or, with `g.reads` 1, its facing and albedo read once from the
/// volume at its place), lit, its outline from the field laid the same way.
@fragment
pub fn patched(
    f: Patch,
    eye: Eye,
    light: Lighting,
    g: Grid,
    coarse: Texture3d<Rg32Uint>,
    atlas: Texture3d<Rgba16Float>,
    albedo: Texture3d<Rgba8>,
    s: Sampler,
    body: u32,
) -> Targets3<vec4, vec4, u32> {
    let way = way_to_outline(f.field, vec2(dpdx(f.field), dpdy(f.field)))
    var n = normalize(f.normal)
    var a = f.albedo
    if g.reads == 1 {
        let brick = g.cell * f32(B)
        let cube = vec3(f32(g.size.x - 1), f32(g.size.y - 1), f32(g.size.z - 1))
        let (rv, ra) = cell_at(g, coarse, atlas, albedo, s, brick, cube, f.world)
        if rv.y != 0.0 || rv.z != 0.0 || rv.w != 0.0 {
            n = normalize(rv.yzw)
            a = ra.xyz
        }
    }
    let toward = normalize(eye.at - f.world)
    let skin = Skin { albedo: a, line: 1.0, metal: 0.0, rim: false, emits: vec3(0.0) }
    let lit = worn(light, skin, f.world, n, toward, STILL, reach: sun_reach(light, f.world))
    Targets3 {
        first: vec4(lit.colour, 0.0),
        second: edge_record(way, 1.0, NO_LINE),
        third: identity(SOLID, body: body, group: 0),
    }
}

/// A pixel of a smooth block, joined from its four scouts: where their tangent planes put it,
/// then read once from the volume there (or, with `g.reads` 0, its facing and albedo blended from
/// the scouts too).
@fragment
pub fn joined<L: Look>(
    pixel: FragCoord,
    eye: Eye,
    light: Lighting,
    look: L,
    g: Grid,
    coarse: Texture3d<Rg32Uint>,
    atlas: Texture3d<Rgba16Float>,
    albedo: Texture3d<Rgba8>,
    s: Sampler,
    body: u32,
    scout: Texture<Rgba32Float>,
    classes: Texture<R32Uint>,
    rate: f32,
) -> WithDepth<Targets3<vec4, vec4, u32>> {
    let c = pixel.position.xy / rate
    let top = vec2(f32(scout.width() - 1), f32(scout.height() - 1))
    let lo = clamp(floor(c), vec2(0.0), top)
    if classes.load(u32(lo.x), u32(lo.y)) != SMOOTH {
        return nothing()
    }
    let d = eye.ray(pixel.position.xy)
    let k = scouts_at(eye, scout, rate, pixel.position.xy, d)
    if k.met == 0 {
        return nothing()
    }
    let brick = g.cell * f32(B)
    let cube = vec3(f32(g.size.x - 1), f32(g.size.y - 1), f32(g.size.z - 1))
    var v = vec4(0.0, normalize(k.way))
    var a = vec4(k.albedo, 1.0)
    if g.reads == 1 {
        let (rv, ra) = cell_at(g, coarse, atlas, albedo, s, brick, cube, eye.at + d * k.blend)
        if rv.y != 0.0 || rv.z != 0.0 || rv.w != 0.0 {
            v = rv
            a = ra
        }
    }
    let n = normalize(v.yzw)
    let w = Walked { met: true, t: k.blend + v.x / max(-dot(n, d), 0.25), v: v, near: 0.0, steps: 1, empty: 0, again: 0, albedo: a, last: 0.0, least: 1.0e9, least_t: 0.0, least_v: vec4(0.0) }
    shown(pixel.position.xy, eye, light, look, g, coarse, atlas, albedo, s, body, eye.at, d, w)
}

/// What solving a ray against one sheet of the form found: `MET` it meets it (at `t` m along
/// it, the stored field there `v`); `CLEAR` it passes it without meeting it; `UNSURE` the volume
/// holds nothing where the solve looked, or it didn't settle.
const MET: u32 = 1
const CLEAR: u32 = 2
const UNSURE: u32 = 0

struct Solved: Copy {
    state: u32,
    t: f32,
    v: vec4,
    /// Why it is unsure: 1 nothing stored where it began, 2 nothing stored where a round went,
    /// 3 it didn't settle.
    why: u32,
    /// The least the stored distance comes to along the ray by this sheet (m): under 0, how
    /// far in the ray goes; over 0, by how much it clears the sheet.
    least: f32,
}

/// The first place a quadratic of value `f`, slope `g` and bend `bend` reaches 0 (how far on;
/// `x`), or where it comes nearest 0 if it never does (`y` 1). Where it hardly bends: by its
/// slope, or by its value where it isn't falling.
fn rooted_at(f: f32, g: f32, bend: f32) -> vec2 {
    if bend > 1.0e-4 {
        let disc = g * g - 2.0 * bend * f
        if disc < 0.0 {
            return vec2(-g / bend, 1.0)
        }
        return vec2((-g - sqrt(disc)) / bend, 0.0)
    }
    vec2(if g < -0.05 { -f / g } else { f }, 0.0)
}

/// A ray from `o` along `d` against the sheet of the form it first comes on from `t0` m along it
/// (`t0` in front of the sheet), in a handful of reads of the volume and no walk. Along the ray
/// the stored distance is taken as a quadratic about where it was last read: its value there,
/// its slope (the stored facing along the ray) and its bend (how the slope changed since the
/// read before; at first, a cell on). Each round goes to the quadratic's first root, or to where
/// it comes nearest 0 if it has none (back, where the ray is already leaving the sheet), and
/// reads there. It says only what a read shows: met, where the distance read is 0 or under (the
/// ray is in the sheet); clear, where the distance read is over 0 and runs level along the ray
/// (the ray's nearest point to the sheet: a ray past an outline, the case a walk skims for a
/// long way). The least the distance comes to, over the pixel's footprint, is how many pixels
/// inside or outside the outline the pixel's middle is.
fn solved(
    g: Grid,
    coarse: Texture3d<Rg32Uint>,
    atlas: Texture3d<Rgba16Float>,
    s: Sampler,
    brick: f32,
    top: vec3,
    o: vec3,
    d: vec3,
    t0: f32,
    px: f32,
) -> Solved {
    // From `t0`, on through bricks that hold nothing (a few: the sheet its scouts found is near)
    // to the first that holds some of it; none, and the ray clears the sheet.
    var t = t0
    var held = false
    for _b in 0..PROBED {
        if !held {
            let p = o + d * t
            let c = clamp(floor((p - g.lo) / brick), vec3(0.0), top)
            let kc = coarse.load(u32(c.x), u32(c.y), u32(c.z)).x
            if kc < FAR_FROM {
                held = true
            } else {
                let lo = g.lo + c * brick
                let ex = if d.x > 0.0 { (lo.x + brick - p.x) / d.x } else if d.x < 0.0 { (lo.x - p.x) / d.x } else { 1.0e30 }
                let ey = if d.y > 0.0 { (lo.y + brick - p.y) / d.y } else if d.y < 0.0 { (lo.y - p.y) / d.y } else { 1.0e30 }
                let ez = if d.z > 0.0 { (lo.z + brick - p.z) / d.z } else if d.z < 0.0 { (lo.z - p.z) / d.z } else { 1.0e30 }
                t += max(min(ex, min(ey, ez)), f32(min(kc & 255, RINGS + 1) - 1) * brick) + 0.02 * brick
            }
        }
    }
    if !held {
        return Solved { state: CLEAR, t, v: vec4(0.0), why: 0, least: 1.0e9 }
    }
    var v = field_at(g, coarse, atlas, s, brick, top, o + d * t)
    if v.y == 0.0 && v.z == 0.0 && v.w == 0.0 {
        return Solved { state: UNSURE, t: 0.0, v: vec4(0.0), why: 1, least: 0.0 }
    }
    var slope = dot(v.yzw, d)
    // Its bend from a cell on, or (where that is in a brick that holds nothing) a cell back.
    var bend = 0.0
    let ahead = field_at(g, coarse, atlas, s, brick, top, o + d * (t + g.cell))
    if ahead.y != 0.0 || ahead.z != 0.0 || ahead.w != 0.0 {
        bend = max((dot(ahead.yzw, d) - slope) / g.cell, 0.0)
    } else {
        let back = field_at(g, coarse, atlas, s, brick, top, o + d * (t - g.cell))
        if back.y != 0.0 || back.z != 0.0 || back.w != 0.0 {
            bend = max((slope - dot(back.yzw, d)) / g.cell, 0.0)
        }
    }
    for _round in 0..ROUNDS {
        if v.x <= TOUCH * px * t {
            // In the sheet, or touching it: met. The last of the way back to its surface by the
            // slope; how far in the ray goes at its deepest by the quadratic here.
            let back = if slope < -0.05 { clamp(-v.x / slope, -g.cell, g.cell) } else { 0.0 }
            let deep = if bend > 1.0e-4 { v.x - slope * slope / (2.0 * bend) } else { -1.0e9 }
            return Solved { state: MET, t: t + back, v, why: 0, least: min(deep, v.x) }
        }
        if slope > -CLOSING && slope < LEVEL {
            // Clear of the sheet, no longer closing on it and running level with it: the ray's
            // nearest point to it (less the little the quadratic says is still to come).
            let more = if bend > 1.0e-3 { min(slope * slope / (2.0 * bend), 0.5 * v.x) } else { 0.0 }
            return Solved { state: CLEAR, t, v, why: 0, least: v.x - more }
        }
        var step = -brick
        if slope < 0.0 {
            step = rooted_at(v.x, slope, bend).x
        } else if bend > 1.0e-4 {
            step = -slope / bend
        }
        let on = t + clamp(step, -brick, brick)
        let w = field_at(g, coarse, atlas, s, brick, top, o + d * on)
        if w.y == 0.0 && w.z == 0.0 && w.w == 0.0 {
            // A brick that holds nothing. Inside the form: the ray entered it on the way there.
            // Outside: it is well clear there, so it cleared the sheet by what was last read.
            if w.x < 0.0 {
                let back = if slope < -0.05 { clamp(-v.x / slope, 0.0, abs(on - t)) } else { 0.0 }
                return Solved { state: MET, t: t + back, v, why: 0, least: -1.0e9 }
            }
            return Solved { state: CLEAR, t, v, why: 0, least: v.x }
        }
        let slope_on = dot(w.yzw, d)
        if abs(on - t) > 0.25 * g.cell {
            bend = max((slope_on - slope) / (on - t), 0.0)
        }
        t = on
        v = w
        slope = slope_on
    }
    Solved { state: UNSURE, t: 0.0, v: vec4(0.0), why: 3, least: 0.0 }
}

/// Where to look for the form past `past` m along a pixel's ray, by what its scouts met beyond
/// there: from two bricks in front of the nearest of them to two bricks past the farthest
/// (`x`, `y`; m along the ray), or `x` 0: none of them met anything beyond.
fn beyond_of(k: Scouts, past: f32, brick: f32) -> vec2 {
    var nearest = 1.0e30
    var farthest = 0.0
    if k.depths.x > past {
        nearest = min(nearest, k.depths.x)
        farthest = max(farthest, k.depths.x)
    }
    if k.depths.y > past {
        nearest = min(nearest, k.depths.y)
        farthest = max(farthest, k.depths.y)
    }
    if k.depths.z > past {
        nearest = min(nearest, k.depths.z)
        farthest = max(farthest, k.depths.z)
    }
    if k.depths.w > past {
        nearest = min(nearest, k.depths.w)
        farthest = max(farthest, k.depths.w)
    }
    if nearest > 1.0e29 {
        return vec2(0.0)
    }
    vec2(max(past, nearest - 2.0 * brick), farthest + 2.0 * brick)
}

/// Whether any of a pixel's scouts met the form on the far side of a plane (through `p`, facing
/// `n`) by more than `by` m: past a sheet the pixel's ray cleared at `p`, that is somewhere the
/// sheet itself isn't (its own points lie behind its tangent plane where it bulges toward the
/// ray), so something else the ray may yet meet.
fn met_past(k: Scouts, p: vec3, n: vec3, by: f32) -> bool {
    (k.depths.x > 0.0 && dot(k.q0 - p, n) > by) ||
        (k.depths.y > 0.0 && dot(k.q1 - p, n) > by) ||
        (k.depths.z > 0.0 && dot(k.q2 - p, n) > by) ||
        (k.depths.w > 0.0 && dot(k.q3 - p, n) > by)
}

/// Past `from` m along a ray, where it next comes on the form: is in it, or near it and falling
/// toward it. Looked for at half-brick steps as far as `to` (a place within half a brick of any
/// sheet is in a brick that holds it; a brick that holds nothing says by its sign whether it is
/// inside the form). Where to solve from, or 0: nowhere.
fn next_from(
    g: Grid,
    coarse: Texture3d<Rg32Uint>,
    atlas: Texture3d<Rgba16Float>,
    s: Sampler,
    brick: f32,
    top: vec3,
    o: vec3,
    d: vec3,
    from: f32,
    to: f32,
) -> f32 {
    var found = 0.0
    var t = from
    for _p in 0..NEXT {
        if found == 0.0 && t < to {
            let was = t
            t += 0.5 * brick
            let p = o + d * t
            let q = (p - g.lo) / brick
            let c = clamp(floor(q), vec3(0.0), top)
            let k = coarse.load(u32(c.x), u32(c.y), u32(c.z))
            if k.x >= FAR_FROM {
                if bitcast_f32(k.y) < 0.0 {
                    found = was
                } else {
                    t += f32(min(k.x & 255, RINGS + 1) - 1) * brick
                }
            } else {
                let a = vec3(f32(k.x % ROW), f32((k.x / ROW) % ROW), f32(k.x / (ROW * ROW))) * f32(BS)
                let local = clamp((q - c) * f32(B), vec3(0.0), vec3(f32(B)))
                let v = atlas.sample_level(s, (a + local + vec3(0.5)) / g.atlas, 0.0)
                if v.x <= 0.0 {
                    found = was
                } else if dot(v.yzw, d) < -LEVEL {
                    found = t
                }
            }
        }
    }
    found
}

/// A pixel of an edge block, solved: its ray against the sheet of the form its scouts found
/// nearest (`solved`), then, where it clears that one, against the farthest; walked only where a
/// solve can't say (`g.solves` 0: always walked, from the nearest less a margin).
@fragment
pub fn edged<L: Look>(
    corner: BlockCorner,
    pixel: FragCoord,
    eye: Eye,
    light: Lighting,
    look: L,
    g: Grid,
    coarse: Texture3d<Rg32Uint>,
    atlas: Texture3d<Rgba16Float>,
    albedo: Texture3d<Rgba8>,
    s: Sampler,
    body: u32,
    scout: Texture<Rgba32Float>,
    rate: f32,
) -> WithDepth<Targets3<vec4, vec4, u32>> {
    let d = eye.ray(pixel.position.xy)
    let k = scouts_at(eye, scout, rate, pixel.position.xy, d)
    if (g.debug & 2048) != 0 {
        return WithDepth {
            color: Targets3 { first: vec4(1.0, 0.0, 0.0, 0.0), second: edge_record(NO_EDGE, 1.0, NO_LINE), third: identity(SOLID, body: body, group: 0) },
            depth: 0.9,
        }
    }
    if k.start > 1.0e29 {
        return nothing()
    }
    let span = crossing(eye, g, d)
    let px = eye.pixel()
    var w = Walked { met: false, t: 0.0, v: vec4(0.0), near: 0.0, steps: 0, empty: 0, again: 0, albedo: vec4(0.0), last: 0.0, least: 1.0e9, least_t: 0.0, least_v: vec4(0.0) }
    var walked = g.solves == 0
    var why: u32 = 0
    let brick = g.cell * f32(B)
    let top = vec3(f32(g.size.x - 1), f32(g.size.y - 1), f32(g.size.z - 1))
    let ahead = max(k.start - rate * px * k.start, span.x)
    let to = min(span.y, max(k.far, k.start) + PAST * brick)
    var from = ahead
    if g.solves == 1 {
        let first = solved(g, coarse, atlas, s, brick, top, eye.at, d, t0: ahead, px: px)
        if first.state == MET {
            w = Walked { met: true, t: first.t, v: first.v, near: 0.0, steps: 4, empty: 0, again: 0, albedo: vec4(0.0), last: 0.0, least: 1.0e9, least_t: 0.0, least_v: vec4(0.0) }
        } else if first.state == UNSURE {
            walked = true
            why = first.why
        } else {
            // It clears the nearest sheet: where it next comes on the form, if its scouts met
            // anything beyond.
            let look = beyond_of(k, first.t, brick)
            var on = 0.0
            if look.x > 0.0 {
                on = next_from(g, coarse, atlas, s, brick, top, eye.at, d, from: look.x, to: look.y)
            }
            if on > 0.0 {
                let second = solved(g, coarse, atlas, s, brick, top, eye.at, d, t0: on, px: px)
                if second.state == MET {
                    w = Walked { met: true, t: second.t, v: second.v, near: 0.0, steps: 8, empty: 0, again: 0, albedo: vec4(0.0), last: 0.0, least: 1.0e9, least_t: 0.0, least_v: vec4(0.0) }
                } else if second.state == UNSURE {
                    walked = true
                    why = second.why + 3
                    from = on
                }
            }
        }
    }
    if (g.debug & 32768) != 0 {
        // Which way each pixel went: red walked, green solved and met, blue solved and clear.
        let c = if walked { vec4(1.0, 0.0, 0.0, f32(why)) } else if w.met { vec4(0.0, 1.0, 0.0, 0.0) } else { vec4(0.0, 0.0, 1.0, 0.0) }
        return WithDepth {
            color: Targets3 { first: c, second: edge_record(NO_EDGE, 1.0, NO_LINE), third: identity(SOLID, body: body, group: 0) },
            depth: 0.9,
        }
    }
    if walked && (g.debug & 16384) == 0 {
        let start = if g.solves == 1 { from } else { max(k.start - MARGIN * rate * px * k.start, span.x) }
        let end = if g.solves == 1 { to } else { span.y }
        w = walk(g, coarse, atlas, s, eye.at, d, from: start, to: end, px: px, near: 0.0)
    }
    if !w.met {
        return nothing()
    }
    shown(pixel.position.xy, eye, light, look, g, coarse, atlas, albedo, s, body, eye.at, d, w)
}


// ---- the picture laid out: one pass to the screen -------------------------------------------------
//
// The scouts' picture drawn straight to the screen (or to a picture in linear light), with no
// picture targets, no depth and no pass after it. Each scout is shaded once (`glowed`: lit where
// it met the form, the sky's paint where it didn't). Each block of four scouts is then one of
// (`sorted`):
//
//   FILL   what a quad lays across it from its corners' colours is the picture, to within `tol`
//          of the screen's range at its middle and the middles of its four sides (where the
//          form, or the sky, is read and shaded again): its pixels are filled, nothing more
//   SHADE  one sheet of the form, but its colour isn't laid from its corners (a band's edge, a
//          mark on the stone): each pixel reads the volume once where the quad puts it, and is lit
//   SKY    sky whose paint isn't laid from its corners (the horizon): painted at each pixel
//   EDGE   anything else (an outline, one part of the form in front of another): each pixel's
//          ray solved against the nearest sheet its scouts found (`solved`), its share of the
//          pixel from how far in or clear the ray is (`frame::last::covered`), over the farthest
//          sheet, or the sky
//
// So every pixel is drawn once, by one draw, and an edge pixel mixes what it shows itself.

/// A block filled from its corners' colours, shaded at each pixel, sky painted at each pixel.
const FILL: u32 = 0
const SHADE: u32 = 1
const SKYED: u32 = 2
const EDGED: u32 = 3

/// How far from the form (in the pixel's footprints) a quad may put a point of a block that is
/// one sheet of it.
const SHEET: f32 = 1.0

/// A colour as a plain screen shows it (a soft shoulder, then the power 1/2.2): what `tol`
/// compares in, whatever the frame's own finish.
fn as_seen(c: vec3) -> vec3 {
    pow(max(c, vec3(0.0)) / (vec3(1.0) + 0.12 * max(c, vec3(0.0))), vec3(1.0 / 2.2))
}

/// Whether two colours are apart by more than `tol` of the screen's range.
fn apart(a: vec3, b: vec3, tol: f32) -> bool {
    let d = abs(as_seen(a) - as_seen(b))
    max(d.x, max(d.y, d.z)) > tol
}

/// The form lit at `p` (its facing `n`, its albedo `a`), seen along `d`.
fn lit_at(light: Lighting, p: vec3, n: vec3, a: vec3, d: vec3) -> vec3 {
    let skin = Skin { albedo: a, line: 1.0, metal: 0.0, rim: false, emits: vec3(0.0) }
    worn(light, skin, p, n, -d, STILL, reach: sun_reach(light, p)).colour
}

/// Each scout's colour: lit where it met the form, the sky's paint where it didn't (`w` 1 or 0);
/// in linear light, and as the screen shows it.
@compute(8, 8)
fn glowed<P: Paint>(
    eye: Eye,
    light: Lighting,
    sky: P,
    style: InkStyle,
    scout: Texture<Rgba32Float>,
    rate: f32,
    out: mut Texels<Rgba16Float>,
    shown: mut Texels<Rgba16Float>,
    id: GlobalId,
) {
    if id.x >= scout.width() || id.y >= scout.height() {
        return
    }
    let e = scout.load(id.x, id.y)
    let d = eye.ray(vec2(f32(id.x), f32(id.y)) * rate)
    var c = painted(eye, sky, d)
    if e.x > 0.0 {
        c = lit_at(light, eye.at + d * e.x, unfaced(e.y), unrooted(e.z), d)
    }
    let met = if e.x > 0.0 { 1.0 } else { 0.0 }
    out.store(id, vec4(c, met))
    shown.store(id, vec4(displayed(style, c), met))
}

/// How a quad's laying holds at the screen place `at` (px), where it lays `t` m along the ray
/// and the colour `c` (the mean of two of its corners'): 0 it holds; 1 the form is there but
/// its colour is off; 2 the form isn't there.
fn laid_holds(
    eye: Eye,
    light: Lighting,
    g: Grid,
    coarse: Texture3d<Rg32Uint>,
    atlas: Texture3d<Rgba16Float>,
    albedo: Texture3d<Rgba8>,
    s: Sampler,
    at: vec2,
    t: f32,
    c: vec3,
    tol: f32,
) -> u32 {
    let brick = g.cell * f32(B)
    let top = vec3(f32(g.size.x - 1), f32(g.size.y - 1), f32(g.size.z - 1))
    let d = eye.ray(at)
    let p = eye.at + d * t
    let (v, a) = cell_at(g, coarse, atlas, albedo, s, brick, top, p)
    if (v.y == 0.0 && v.z == 0.0 && v.w == 0.0) || abs(v.x) > SHEET * eye.pixel() * t {
        return 2
    }
    let n = normalize(v.yzw)
    let on = p + d * (v.x / max(-dot(n, d), 0.25))
    if apart(lit_at(light, on, n, a.xyz, d), c, tol) { 1 } else { 0 }
}

/// Whether a scout that didn't meet the form came near it (`SCOUT_NEAR`).
fn close_by(e: vec4) -> bool {
    e.x <= 0.0 && e.y > 0.5
}

/// How a quad's laying holds at the screen place `at`, the middle of a side between two scouts
/// (`ea`, `eb`: their texels; `ca`, `cb`: their colours): 0 it holds; 1 its colour is off; 2
/// it isn't laid at all there (one scout met the form and the other didn't, or came near it).
fn side_holds<P: Paint>(
    eye: Eye,
    light: Lighting,
    sky: P,
    g: Grid,
    coarse: Texture3d<Rg32Uint>,
    atlas: Texture3d<Rgba16Float>,
    albedo: Texture3d<Rgba8>,
    s: Sampler,
    at: vec2,
    ea: vec4,
    eb: vec4,
    ca: vec3,
    cb: vec3,
    tol: f32,
    reach: f32,
) -> u32 {
    if ea.x > 0.0 && eb.x > 0.0 {
        return laid_holds(eye, light, g, coarse, atlas, albedo, s, at, 0.5 * (ea.x + eb.x), 0.5 * (ca + cb), tol)
    }
    if ea.x > 0.0 || eb.x > 0.0 || close_by(ea) || close_by(eb) {
        return 2
    }
    if apart(painted(eye, sky, eye.ray(at)), 0.5 * (ca + cb), tol) { 1 } else { 0 }
}

/// For each scout: how what quads lay holds at the middle of the side to the scout on its right
/// (bits 0 and 1), of the side to the scout below it (bits 2 and 3), and of the block they
/// corner (bits 4 and 5); each as `side_holds` says. A side is checked once, for both the
/// blocks it lies between.
@compute(8, 8)
fn checked<P: Paint>(
    eye: Eye,
    light: Lighting,
    sky: P,
    g: Grid,
    coarse: Texture3d<Rg32Uint>,
    atlas: Texture3d<Rgba16Float>,
    albedo: Texture3d<Rgba8>,
    s: Sampler,
    scout: Texture<Rgba32Float>,
    glow: Texture<Rgba16Float>,
    rate: f32,
    tol: f32,
    out: mut Texels<R32Uint>,
    id: GlobalId,
) {
    if id.x >= scout.width() || id.y >= scout.height() {
        return
    }
    let x1 = min(id.x + 1, scout.width() - 1)
    let y1 = min(id.y + 1, scout.height() - 1)
    let e00 = scout.load(id.x, id.y)
    let e10 = scout.load(x1, id.y)
    let e01 = scout.load(id.x, y1)
    let e11 = scout.load(x1, y1)
    let c00 = glow.load(id.x, id.y).xyz
    let c10 = glow.load(x1, id.y).xyz
    let c01 = glow.load(id.x, y1).xyz
    let c11 = glow.load(x1, y1).xyz
    let o = vec2(f32(id.x), f32(id.y)) * rate
    let across = side_holds(eye, light, sky, g, coarse, atlas, albedo, s, o + vec2(0.5, 0.0) * rate, e00, e10, c00, c10, tol, reach: rate)
    let down = side_holds(eye, light, sky, g, coarse, atlas, albedo, s, o + vec2(0.0, 0.5) * rate, e00, e01, c00, c01, tol, reach: rate)
    // The block's middle, laid from all four.
    let mid = o + vec2(0.5, 0.5) * rate
    let mean = 0.25 * (c00 + c10 + c01 + c11)
    let met = (if e00.x > 0.0 { 1 } else { 0 }) + (if e10.x > 0.0 { 1 } else { 0 }) + (if e01.x > 0.0 { 1 } else { 0 }) + (if e11.x > 0.0 { 1 } else { 0 })
    let near = close_by(e00) || close_by(e10) || close_by(e01) || close_by(e11)
    var middle: u32 = 2
    if met == 4 {
        middle = laid_holds(eye, light, g, coarse, atlas, albedo, s, mid, 0.25 * (e00.x + e10.x + e01.x + e11.x), mean, tol)
    } else if met == 0 && !near {
        middle = if apart(painted(eye, sky, eye.ray(mid)), mean, tol) { 1 } else { 0 }
    }
    out.store(id, across | (down << 2) | (middle << 4))
}

/// Each block of four scouts, sorted (see the head of this part) by how its laying holds at its
/// middle and its four sides' middles (`checked`), and listed by its kind.
@compute(8, 8)
fn sorted(
    eye: Eye,
    scout: Texture<Rgba32Float>,
    checks: Texture<R32Uint>,
    rate: f32,
    shades: mut Append<u32>,
    skies: mut Append<u32>,
    edges: mut Append<u32>,
    id: GlobalId,
) {
    if id.x + 1 >= scout.width() || id.y + 1 >= scout.height() {
        return
    }
    let here = id.x | (id.y << 16)
    let e00 = scout.load(id.x, id.y)
    let e10 = scout.load(id.x + 1, id.y)
    let e01 = scout.load(id.x, id.y + 1)
    let e11 = scout.load(id.x + 1, id.y + 1)
    let met = (if e00.x > 0.0 { 1 } else { 0 }) + (if e10.x > 0.0 { 1 } else { 0 }) + (if e01.x > 0.0 { 1 } else { 0 }) + (if e11.x > 0.0 { 1 } else { 0 })
    let near = close_by(e00) || close_by(e10) || close_by(e01) || close_by(e11)
    let own = checks.load(id.x, id.y)
    let right = (checks.load(id.x + 1, id.y) >> 2) & 3
    let below = checks.load(id.x, id.y + 1) & 3
    let worst = max(max(own & 3, (own >> 2) & 3), max((own >> 4) & 3, max(right, below)))
    if met == 0 && !near {
        if worst > 0 {
            let _ = skies.push(here)
        }
        return
    }
    var one_sheet = false
    if met == 4 {
        let mid = (vec2(f32(id.x), f32(id.y)) + vec2(0.5)) * rate
        let k = scouts_at(eye, scout, rate, mid, eye.ray(mid))
        one_sheet = k.met == 4 && k.most - k.least < AGREE * rate * eye.pixel() * k.least
    }
    if one_sheet && worst == 0 {
        // (Filled: the pass's first draw fills every pixel, so it is listed nowhere.)
    } else if one_sheet && worst == 1 {
        let _ = shades.push(here)
    } else {
        let _ = edges.push(here)
    }
}

/// The four kinds' draws: six corners a block of each (an invocation a kind).
@compute(4)
fn kinds_counted(fills: [u32], shades: [u32], skies: [u32], edges: [u32], most: u32, out: mut Slots<DrawArgs>, id: GlobalId) {
    let n = if id.x == 0 { fills[0] } else if id.x == 1 { shades[0] } else if id.x == 2 { skies[0] } else { edges[0] }
    out[id] = DrawArgs { vertices: 6, instances: min(n, most), first_vertex: 0, first_instance: 0 }
}

/// A corner of a filled block's quad: its scout's colour.
pub struct Fill: Copy {
    pub clip: ClipPosition,
    pub colour: vec3,
}

@vertex
pub fn fill_corner(v: VertexIndex, i: InstanceIndex, blocks: [u32], glow: Texture<Rgba16Float>, size: vec2, rate: f32) -> Fill {
    let b = blocks[i.index]
    let j = QUAD[v.index % 6]
    let x = (b & 65535) + (j & 1)
    let y = (b >> 16) + ((j >> 1) & 1)
    let p = vec2(f32(x), f32(y)) * rate
    Fill {
        clip: ClipPosition { position: vec4(p.x / size.x * 2.0 - 1.0, 1.0 - p.y / size.y * 2.0, 0.5, 1.0) },
        colour: glow.load(x, y).xyz,
    }
}

/// A pixel of a filled block: the colour its quad lays there.
@fragment
pub fn filled(f: Fill) -> vec4 {
    vec4(f.colour, 1.0)
}

/// Any pixel, filled from the scouts' colours round it (laid bilinearly by the sampler: scout
/// (i, j) stands at the screen's (i, j) × `rate`, its texel's middle). Drawn over the whole
/// screen in three corners; the blocks that aren't filled are drawn over it after.
@fragment
pub fn filled_over(pixel: FragCoord, glow: Texture<Rgba16Float>, s: Sampler, rate: f32) -> vec4 {
    let uv = (pixel.position.xy / rate + vec2(0.5)) / vec2(f32(glow.width()), f32(glow.height()))
    vec4(glow.sample_level(s, uv, 0.0).xyz, 1.0)
}

/// A colour for the pass: as the screen shows it (`display` 1) or in linear light.
fn out_as(style: InkStyle, c: vec3, display: u32) -> vec4 {
    if display == 1 {
        return vec4(displayed(style, c), 1.0)
    }
    vec4(c, 1.0)
}

/// A pixel of a shaded block: the volume read once where its quad puts it, and lit.
@fragment
pub fn shaded_out(
    f: Patch,
    eye: Eye,
    light: Lighting,
    style: InkStyle,
    g: Grid,
    coarse: Texture3d<Rg32Uint>,
    atlas: Texture3d<Rgba16Float>,
    albedo: Texture3d<Rgba8>,
    s: Sampler,
    display: u32,
) -> vec4 {
    let brick = g.cell * f32(B)
    let cube = vec3(f32(g.size.x - 1), f32(g.size.y - 1), f32(g.size.z - 1))
    var n = normalize(f.normal)
    var a = f.albedo
    let (rv, ra) = cell_at(g, coarse, atlas, albedo, s, brick, cube, f.world)
    if rv.y != 0.0 || rv.z != 0.0 || rv.w != 0.0 {
        n = normalize(rv.yzw)
        a = ra.xyz
    }
    let d = normalize(f.world - eye.at)
    out_as(style, lit_at(light, f.world, n, a, d), display)
}

/// A pixel of sky painted itself.
@fragment
pub fn skied<P: Paint>(corner: BlockCorner, pixel: FragCoord, eye: Eye, sky: P, style: InkStyle, display: u32, tint: vec3) -> vec4 {
    out_as(style, painted(eye, sky, eye.ray(pixel.position.xy)) * tint, display)
}

/// One sheet of the form as a pixel's ray sees it: its colour, how much of the pixel it covers
/// (0: none of it), how far along the ray it is met or passed nearest, whether the ray enters it,
/// and the way its outline's far side lies on the screen (a unit vector, x across and y down; 0
/// where it faces the eye).
struct Sheet: Copy {
    colour: vec3,
    cover: f32,
    t: f32,
    met: bool,
    out: vec2,
    /// The sheet's point there (met, or nearest the ray) and its facing.
    at: vec3,
    facing: vec3,
}

/// The sheet of the form a pixel's ray first comes on from `t0` m along it (`solved`), walked
/// (as far as `to`) where the solve can't say.
fn sheet_seen(
    eye: Eye,
    light: Lighting,
    g: Grid,
    coarse: Texture3d<Rg32Uint>,
    atlas: Texture3d<Rgba16Float>,
    albedo: Texture3d<Rgba8>,
    s: Sampler,
    d: vec3,
    t0: f32,
    to: f32,
) -> Sheet {
    let brick = g.cell * f32(B)
    let top = vec3(f32(g.size.x - 1), f32(g.size.y - 1), f32(g.size.z - 1))
    let px = eye.pixel()
    let r = solved(g, coarse, atlas, s, brick, top, eye.at, d, t0: t0, px: px)
    var t = r.t
    var v = r.v
    var met = r.state == MET
    var cover = if met { 1.0 } else { 0.0 }
    var out = vec2(0.0)
    var off = 0.0
    var least = r.least
    if r.state == UNSURE && (g.debug & 1048576) != 0 {
        return Sheet { colour: vec3(1.0, 0.0, 0.0), cover: 1.0, t: t0, met: true, out, at: vec3(0.0), facing: vec3(0.0) }
    }
    if r.state == UNSURE {
        // Walked: met where the walk met it, else clear of it by the least the walk read.
        let w = walk(g, coarse, atlas, s, eye.at, d, from: t0, to: to, px: px, near: 0.0)
        if w.met {
            t = w.t + w.v.x / max(-dot(normalize(w.v.yzw), d), 0.25)
            v = w.v
            met = true
        } else {
            if w.least > 1.0e8 {
                return Sheet { colour: vec3(0.0), cover: 0.0, t: t0, met: false, out, at: vec3(0.0), facing: vec3(0.0) }
            }
            t = w.least_t
            v = w.least_v
            least = w.least
        }
        cover = if met { 1.0 } else { 0.0 }
    }
    if v.y == 0.0 && v.z == 0.0 && v.w == 0.0 {
        return Sheet { colour: vec3(0.0), cover: 0.0, t, met: false, out, at: vec3(0.0), facing: vec3(0.0) }
    }
    // How many pixels inside the outline (over 0) or clear of it the pixel's middle is, and the
    // share of the pixel on the sheet's side of it. Clear of it: by the least distance read. In
    // it: how deep the ray goes at its deepest, from how its facing along the ray changes a cell
    // on (as `shown` finds its outline's way), over how the facing leans on the screen.
    var inside = -least / (px * t)
    let lean = vec2(dot(v.yzw, eye.right), -dot(v.yzw, eye.up))
    if met {
        inside = 1.0e9
        let nv = -dot(normalize(v.yzw), d)
        if nv < FOLD_NEAR && dot(lean, lean) > 1.0e-8 {
            let w = field_at(g, coarse, atlas, s, brick, top, eye.at + d * (t + g.cell))
            if w.y != 0.0 || w.z != 0.0 || w.w != 0.0 {
                let bend = (dot(normalize(w.yzw), d) + nv) / g.cell
                if bend > 1.0e-6 {
                    inside = nv * nv / (2.0 * bend) / (px * t * length(lean))
                }
            }
        }
    }
    if dot(lean, lean) > 1.0e-6 {
        out = normalize(lean)
        if abs(inside) < 0.75 {
            cover = covered(inside, out)
        }
    }
    if !met {
        off = max(least, 0.0)
    }
    if cover <= 0.0 {
        let n0 = normalize(v.yzw)
        return Sheet { colour: vec3(0.0), cover: 0.0, t, met, out, at: eye.at + d * t - n0 * off, facing: n0 }
    }
    let n = normalize(v.yzw)
    // (Where the ray clears the sheet, the sheet's point nearest it.)
    let p = eye.at + d * t - n * off
    let (_, a) = cell_at(g, coarse, atlas, albedo, s, brick, top, p)
    Sheet { colour: lit_at(light, p, n, a.xyz, d), cover, t, met, out, at: p, facing: n }
}

/// A pixel of an edge block: the sheet of the form its ray first comes on, by its share of the
/// pixel, over what the rest of the pixel shows: the form where a ray past that sheet's outline
/// next enters it, else the sky.
@fragment
pub fn edged_out<P: Paint>(
    corner: BlockCorner,
    pixel: FragCoord,
    eye: Eye,
    light: Lighting,
    sky: P,
    style: InkStyle,
    g: Grid,
    coarse: Texture3d<Rg32Uint>,
    atlas: Texture3d<Rgba16Float>,
    albedo: Texture3d<Rgba8>,
    s: Sampler,
    scout: Texture<Rgba32Float>,
    rate: f32,
    display: u32,
) -> vec4 {
    let d = eye.ray(pixel.position.xy)
    let k = scouts_at(eye, scout, rate, pixel.position.xy, d)
    var colour = painted(eye, sky, d)
    if (g.debug & 524288) != 0 {
        return out_as(style, colour, display)
    }
    if (g.debug & 2097152) != 0 {
        let n = (if k.depths.x > 0.0 { 1.0 } else { 0.0 }) + (if k.depths.y > 0.0 { 1.0 } else { 0.0 }) + (if k.depths.z > 0.0 { 1.0 } else { 0.0 }) + (if k.depths.w > 0.0 { 1.0 } else { 0.0 })
        return vec4(8.0, n, 0.0, 1.0)
    }
    if k.start < 1.0e29 {
        let brick = g.cell * f32(B)
        let top = vec3(f32(g.size.x - 1), f32(g.size.y - 1), f32(g.size.z - 1))
        let span = crossing(eye, g, d)
        let px = eye.pixel()
        let ahead = max(k.start - rate * px * k.start, span.x)
        let to = min(span.y, max(k.far, k.start) + PAST * brick)
        let near = sheet_seen(eye, light, g, coarse, atlas, albedo, s, d, t0: ahead, to: to)
        var behind = false
        if near.cover < 1.0 && (g.debug & 4194304) == 0 {
            // The rest of the pixel: along this ray past the sheet, where it clears it; where it
            // enters it, along the ray a pixel and a half out past its outline.
            var past = d
            var from = near.t
            if near.met {
                past = eye.ray(pixel.position.xy + near.out * 1.5)
                from = near.t - 0.5 * brick
            }
            let look = beyond_of(k, near.t, brick)
            var on = 0.0
            if look.x > 0.0 {
                on = next_from(g, coarse, atlas, s, brick, top, eye.at, past, from: max(look.x, from), to: look.y)
            }
            if on > 0.0 {
                let far = sheet_seen(eye, light, g, coarse, atlas, albedo, s, past, t0: on, to: look.y)
                if far.met {
                    colour = far.colour
                    behind = true
                }
            }
        }
        if (g.debug & 65536) != 0 {
            return vec4(near.cover, if behind { 1.0 } else { 0.0 }, if near.met { 1.0 } else { 0.0 }, 1.0)
        }
        colour = mix(colour, near.colour, near.cover)
    }
    out_as(style, colour, display)
}

// ---- edge blocks narrowed --------------------------------------------------------------------------
//
// An edge block is `rate` pixels a side, and only its pixels within one or two of an outline need
// solving. So each edge block gets five more scouts (the middles of its sides and its own) and is
// cut in four; each quarter is sorted again from its own four scouts: sky (painted), one sheet
// (each pixel reads the volume once where a quad puts it), or still an edge (solved).

/// A quarter of an edge block: how far along its ray each of its four scouts met the form, and
/// where it is (`at.xy`: in half blocks).
pub struct Quarter: Copy + GpuData {
    pub t: vec4,
    pub at: vec4,
}

/// The five more scouts of each edge block (an invocation a scout: the middle of its top side,
/// of its left, its own, of its right, of its bottom), each a scout's texel (`scouted`), walked
/// from a little in front of where the block's own scouts first found the form.
@compute(5)
fn scouted_more(
    eye: Eye,
    g: Grid,
    coarse: Texture3d<Rg32Uint>,
    atlas: Texture3d<Rgba16Float>,
    albedo: Texture3d<Rgba8>,
    s: Sampler,
    scout: Texture<Rgba32Float>,
    edges: [u32],
    rate: f32,
    out: mut Slots<vec4>,
    id: GlobalId,
) {
    let b = edges[id.x / 5]
    let j = id.x % 5
    let off = if j == 0 { vec2(0.5, 0.0) } else if j == 1 { vec2(0.0, 0.5) } else if j == 2 { vec2(0.5, 0.5) } else if j == 3 { vec2(1.0, 0.5) } else { vec2(0.5, 1.0) }
    let pixel = (vec2(f32(b & 65535), f32(b >> 16)) + off) * rate
    let d = eye.ray(pixel)
    let span = crossing(eye, g, d)
    if !(span.x < span.y) {
        out[id] = vec4(0.0)
        return
    }
    let brick = g.cell * f32(B)
    let k = scouts_at(eye, scout, rate, pixel, d)
    let from = if k.start < 1.0e29 { max(span.x, k.start - 2.0 * rate * eye.pixel() * k.start - brick) } else { span.x }
    let w = walk(g, coarse, atlas, s, eye.at, d, from: from, to: span.y, px: eye.pixel() * rate * 0.5, near: 2.0)
    if !w.met {
        out[id] = vec4(-w.last, if w.least < SCOUT_NEAR * 0.5 * rate * eye.pixel() * w.least_t { 1.0 } else { 0.0 }, 0.0, w.near)
        return
    }
    let n = normalize(w.v.yzw)
    let t = w.t + w.v.x / max(-dot(n, d), 0.25)
    let top = vec3(f32(g.size.x - 1), f32(g.size.y - 1), f32(g.size.z - 1))
    let (_, a) = cell_at(g, coarse, atlas, albedo, s, brick, top, eye.at + d * t)
    out[id] = vec4(t, faced(n), rooted(a.xyz), w.near)
}

/// How far along the ray `d` a scout's tangent plane puts the form (the scout's texel `e`, its
/// ray through the screen at `at` px); 0 where it didn't meet it or its plane doesn't face `d`.
fn plane_along(eye: Eye, e: vec4, at: vec2, d: vec3) -> f32 {
    if e.x <= 0.0 {
        return 0.0
    }
    let n = unfaced(e.y)
    let facing = dot(n, d)
    if facing > -0.05 {
        return 0.0
    }
    dot(n, eye.ray(at) * e.x) / facing
}

/// Each quarter of each edge block (an invocation a quarter), sorted from its four scouts and
/// listed: sky (none met the form or came near it), one sheet (all four met it, their tangent
/// planes agree at its middle, and the form is there), or an edge.
@compute(4)
fn quartered(
    eye: Eye,
    g: Grid,
    coarse: Texture3d<Rg32Uint>,
    atlas: Texture3d<Rgba16Float>,
    s: Sampler,
    scout: Texture<Rgba32Float>,
    edges: [u32],
    more: [vec4],
    rate: f32,
    quarters: mut Slots<Quarter>,
    skies: mut Append<u32>,
    sheets: mut Append<u32>,
    solved_at: mut Append<u32>,
    id: GlobalId,
) {
    let block = id.x / 4
    let q = id.x % 4
    let b = edges[block]
    let i = b & 65535
    let j = b >> 16
    let qx = q & 1
    let qy = q >> 1
    let top = more[5 * block]
    let left = more[5 * block + 1]
    let mid = more[5 * block + 2]
    let right = more[5 * block + 3]
    let bottom = more[5 * block + 4]
    // Its four scouts: across the top, then across the bottom.
    var e0 = scout.load(i, j)
    var e1 = top
    var e2 = left
    var e3 = mid
    if q == 1 {
        e0 = top
        e1 = scout.load(i + 1, j)
        e2 = mid
        e3 = right
    } else if q == 2 {
        e0 = left
        e1 = mid
        e2 = scout.load(i, j + 1)
        e3 = bottom
    } else if q == 3 {
        e0 = mid
        e1 = right
        e2 = bottom
        e3 = scout.load(i + 1, j + 1)
    }
    let half = 0.5 * rate
    let hx = 2 * i + qx
    let hy = 2 * j + qy
    let here = hx | (hy << 16)
    quarters[id] = Quarter { t: vec4(e0.x, e1.x, e2.x, e3.x), at: vec4(f32(hx), f32(hy), 0.0, 0.0) }
    let met = (if e0.x > 0.0 { 1 } else { 0 }) + (if e1.x > 0.0 { 1 } else { 0 }) + (if e2.x > 0.0 { 1 } else { 0 }) + (if e3.x > 0.0 { 1 } else { 0 })
    let near = close_by(e0) || close_by(e1) || close_by(e2) || close_by(e3)
    if met == 0 && !near {
        let _ = skies.push(here)
        return
    }
    if met == 4 {
        let o = vec2(f32(hx), f32(hy)) * half
        let c = o + vec2(0.5) * half
        let d = eye.ray(c)
        let p0 = plane_along(eye, e0, o, d)
        let p1 = plane_along(eye, e1, o + vec2(half, 0.0), d)
        let p2 = plane_along(eye, e2, o + vec2(0.0, half), d)
        let p3 = plane_along(eye, e3, o + vec2(half, half), d)
        let least = min(min(p0, p1), min(p2, p3))
        let most = max(max(p0, p1), max(p2, p3))
        if least > 0.0 && most - least < AGREE * half * eye.pixel() * least {
            let brick = g.cell * f32(B)
            let cube = vec3(f32(g.size.x - 1), f32(g.size.y - 1), f32(g.size.z - 1))
            let v = field_at(g, coarse, atlas, s, brick, cube, eye.at + d * (0.25 * (p0 + p1 + p2 + p3)))
            if (v.y != 0.0 || v.z != 0.0 || v.w != 0.0) && abs(v.x) < SHEET * eye.pixel() * least {
                let _ = sheets.push(id.x)
                return
            }
        }
    }
    let _ = solved_at.push(here)
}

/// The three kinds of quarters' draws: six corners a quarter of each.
@compute(3)
fn quarters_counted(skies: [u32], sheets: [u32], edges: [u32], most: u32, out: mut Slots<DrawArgs>, id: GlobalId) {
    let n = if id.x == 0 { skies[0] } else if id.x == 1 { sheets[0] } else { edges[0] }
    out[id] = DrawArgs { vertices: 6, instances: min(n, most), first_vertex: 0, first_instance: 0 }
}

/// A corner of a one-sheet quarter's quad: where its scout met the form.
@vertex
pub fn quarter_corner(v: VertexIndex, i: InstanceIndex, sheets: [u32], quarters: [Quarter], eye: Eye, half: f32) -> Patch {
    let q = quarters[sheets[i.index]]
    let j = QUAD[v.index % 6]
    let t = if j == 0 { q.t.x } else if j == 1 { q.t.y } else if j == 2 { q.t.z } else { q.t.w }
    let pixel = (q.at.xy + vec2(f32(j & 1), f32((j >> 1) & 1))) * half
    let d = eye.ray(pixel)
    let world = eye.at + d * t
    let z = dot(world - eye.at, eye.forward)
    let on = vec2(pixel.x / eye.size.x * 2.0 - 1.0, 1.0 - pixel.y / eye.size.y * 2.0)
    Patch {
        clip: ClipPosition { position: vec4(on * z, eye.near, z) },
        world,
        normal: -d,
        albedo: vec3(0.0),
        field: 1.0,
    }
}

impl<S: Solid> Volume<S> {
    /// The picture laid out for `eye`: the scouting march (one ray each `rate` × `rate` pixels),
    /// each scout shaded, each block sorted and listed (`sorted`, to within `tol` of the
    /// screen's range). Before the pass it is drawn into (`laid_into`).
    pub fn laid_out<P: Paint>(mut self, eye: Eye, light: Lighting, sky: P, style: InkStyle, rate: u32, tol: f32) {
        let w = u32(eye.size.x)
        let h = u32(eye.size.y)
        let sw = (w + rate - 1) / rate + 1
        let sh = (h + rate - 1) / rate + 1
        if self.scout.width() != sw || self.scout.height() != sh {
            self.scout = texture(width: sw, height: sh)
        }
        if self.glow.width() != sw || self.glow.height() != sh {
            self.glow = writable_texture(width: sw, height: sh)
            self.glow_shown = writable_texture(width: sw, height: sh)
            self.checks = writable_texture(width: sw, height: sh)
            self.more = buffer(5 * sw * sh)
            self.quarters = buffer(4 * sw * sh)
            self.sky_quarters = append_buffer(4 * sw * sh)
            self.sheet_quarters = append_buffer(4 * sw * sh)
            self.edge_quarters = append_buffer(4 * sw * sh)
            self.fills = append_buffer(sw * sh)
            self.shades = append_buffer(sw * sh)
            self.skies = append_buffer(sw * sh)
            self.edges = append_buffer(sw * sh)
        }
        if self.load > 0 {
            label("load")
            let b = begin_pass(mut self.burned, clear: vec4(0.0))
            draw(b, cover, burn.bind(rounds: self.load), vertices: 3)
            b.end()
        }
        label("scouted")
        let p = begin_pass(mut self.scout, clear: vec4(0.0))
        draw(
            p,
            cover,
            scouted.bind(
                eye: eye,
                g: self.grid,
                coarse: self.coarse,
                atlas: self.atlas,
                albedo: self.albedo,
                s: self.s,
                rate: f32(rate),
            ),
            vertices: 3,
        )
        p.end()
        label("glowed")
        dispatch(
            glowed.bind(
                eye: eye,
                light: light,
                sky: sky,
                style: style,
                scout: self.scout,
                rate: f32(rate),
                out: mut self.glow,
                shown: mut self.glow_shown,
            ),
            groups: ((sw + 7) / 8, (sh + 7) / 8, 1),
        )
        label("checked")
        dispatch(
            checked.bind(
                eye: eye,
                light: light,
                sky: sky,
                g: self.grid,
                coarse: self.coarse,
                atlas: self.atlas,
                albedo: self.albedo,
                s: self.s,
                scout: self.scout,
                glow: self.glow,
                rate: f32(rate),
                tol: tol,
                out: mut self.checks,
            ),
            groups: ((sw + 7) / 8, (sh + 7) / 8, 1),
        )
        label("sorted")
        self.fills.clear()
        self.shades.clear()
        self.skies.clear()
        self.edges.clear()
        dispatch(
            sorted.bind(
                eye: eye,
                scout: self.scout,
                checks: self.checks,
                rate: f32(rate),
                shades: mut self.shades,
                skies: mut self.skies,
                edges: mut self.edges,
            ),
            groups: ((sw + 7) / 8, (sh + 7) / 8, 1),
        )
        dispatch(
            kinds_counted.bind(
                fills: self.fills.count(),
                shades: self.shades.count(),
                skies: self.skies.count(),
                edges: self.edges.count(),
                most: sw * sh,
                out: mut self.kinds_drawn,
            ),
            groups: 1,
        )
        if self.grid.narrow == 0 {
            return
        }
        // The edge blocks narrowed: five more scouts each, then their quarters sorted.
        label("narrowed")
        dispatch(
            scouted_more.bind(
                eye: eye,
                g: self.grid,
                coarse: self.coarse,
                atlas: self.atlas,
                albedo: self.albedo,
                s: self.s,
                scout: self.scout,
                edges: self.edges.items(),
                rate: f32(rate),
                out: mut self.more,
            ),
            groups: self.edges.count(),
        )
        self.sky_quarters.clear()
        self.sheet_quarters.clear()
        self.edge_quarters.clear()
        dispatch(
            quartered.bind(
                eye: eye,
                g: self.grid,
                coarse: self.coarse,
                atlas: self.atlas,
                s: self.s,
                scout: self.scout,
                edges: self.edges.items(),
                more: self.more.items(),
                rate: f32(rate),
                quarters: mut self.quarters,
                skies: mut self.sky_quarters,
                sheets: mut self.sheet_quarters,
                solved_at: mut self.edge_quarters,
            ),
            groups: self.edges.count(),
        )
        dispatch(
            quarters_counted.bind(
                skies: self.sky_quarters.count(),
                sheets: self.sheet_quarters.count(),
                edges: self.edge_quarters.count(),
                most: 4 * sw * sh,
                out: mut self.quarters_drawn,
            ),
            groups: 1,
        )
    }

    /// The laid-out picture drawn into `pass`: as the screen shows it (`display`) or in linear
    /// light. Four draws, each pixel by one of them.
    pub fn laid_into<R: RenderPass, P: Paint>(self, pass: R, eye: Eye, light: Lighting, sky: P, style: InkStyle, rate: u32, display: bool) {
        let shows: u32 = if display { 1 } else { 0 }
        if display {
            draw(pass, cover, filled_over.bind(glow: self.glow_shown, s: self.s, rate: f32(rate)), vertices: 3)
        } else {
            draw(pass, cover, filled_over.bind(glow: self.glow, s: self.s, rate: f32(rate)), vertices: 3)
        }
        if (self.grid.debug & 262144) == 0 {
        draw(
            pass,
            patch_corner.bind(blocks: self.shades.items(), eye: eye, scout: self.scout, rate: f32(rate)),
            shaded_out.bind(
                eye: eye,
                light: light,
                style: style,
                g: self.grid,
                coarse: self.coarse,
                atlas: self.atlas,
                albedo: self.albedo,
                s: self.s,
                display: shows,
            ),
            indirect: self.kinds_drawn.span(start: 1, count: 1),
        )
        }
        draw(
            pass,
            block_corner.bind(edges: self.skies.items(), size: eye.size, rate: f32(rate)),
            skied.bind(eye: eye, sky: sky, style: style, display: shows, tint: vec3(1.0)),
            indirect: self.kinds_drawn.span(start: 2, count: 1),
        )
        if self.grid.narrow == 0 {
            draw(
                pass,
                block_corner.bind(edges: self.edges.items(), size: eye.size, rate: f32(rate)),
                edged_out.bind(
                    eye: eye,
                    light: light,
                    sky: sky,
                    style: style,
                    g: self.grid,
                    coarse: self.coarse,
                    atlas: self.atlas,
                    albedo: self.albedo,
                    s: self.s,
                    scout: self.scout,
                    rate: f32(rate),
                    display: shows,
                ),
                indirect: self.kinds_drawn.span(start: 3, count: 1),
            )
            return
        }
        // The edge blocks' quarters: sky painted, one sheet read at each pixel, edges solved.
        draw(
            pass,
            block_corner.bind(edges: self.sky_quarters.items(), size: eye.size, rate: 0.5 * f32(rate)),
            skied.bind(eye: eye, sky: sky, style: style, display: shows, tint: if (self.grid.debug & 8388608) != 0 { vec3(1.0, 0.3, 0.3) } else { vec3(1.0) }),
            indirect: self.quarters_drawn.span(start: 0, count: 1),
        )
        draw(
            pass,
            quarter_corner.bind(sheets: self.sheet_quarters.items(), quarters: self.quarters.items(), eye: eye, half: 0.5 * f32(rate)),
            shaded_out.bind(
                eye: eye,
                light: light,
                style: style,
                g: self.grid,
                coarse: self.coarse,
                atlas: self.atlas,
                albedo: self.albedo,
                s: self.s,
                display: shows,
            ),
            indirect: self.quarters_drawn.span(start: 1, count: 1),
        )
        if (self.grid.debug & 4096) == 0 {
            draw(
                pass,
                block_corner.bind(edges: self.edge_quarters.items(), size: eye.size, rate: 0.5 * f32(rate)),
                edged_out.bind(
                    eye: eye,
                    light: light,
                    sky: sky,
                    style: style,
                    g: self.grid,
                    coarse: self.coarse,
                    atlas: self.atlas,
                    albedo: self.albedo,
                    s: self.s,
                    scout: self.scout,
                    rate: f32(rate),
                    display: shows,
                ),
                indirect: self.quarters_drawn.span(start: 2, count: 1),
            )
        }
    }

    /// The laid-out picture drawn to the screen and shown.
    pub fn shown_laid<P: Paint>(self, eye: Eye, light: Lighting, sky: P, style: InkStyle, rate: u32) {
        label("laid")
        let screen = begin_screen_pass(clear: vec4(0.0, 0.0, 0.0, 1.0))
        self.laid_into(screen, eye, light, sky, style, rate, display: true)
        screen.present()
    }

    /// The laid-out picture drawn into `into`, in linear light (for the judges).
    pub fn laid_linear<P: Paint>(self, into: mut Texture<Rgba16Float>, eye: Eye, light: Lighting, sky: P, style: InkStyle, rate: u32) {
        label("laid")
        let p = begin_pass(mut into, clear: vec4(0.0, 0.0, 0.0, 1.0))
        self.laid_into(p, eye, light, sky, style, rate, display: false)
        p.end()
    }
}


// ---- light on the cells ----------------------------------------------------------------------------
//
// Each atlas texel within `SHELL` cells of the surface holds the light falling on its surface
// point (its place moved onto the surface by the stored distance, facing as the stored facing):
// the sun, where a ray to it gets through the volume; the sky, by a few rays over the hemisphere
// a sweep; and what the form itself gives back, by reading the light stored where a sky ray
// stops (so light bounces once more each sweep). A sweep lights every such texel once; while
// nothing changes each sweep is added into a running mean, so the stored light settles toward
// what many rays would give. Every ray stops at the stored surface and light is read only where
// it stops: nothing is mixed across a wall.

/// How near the surface (cells) a texel holds light: a read at the surface touches the eight
/// texels round it, the farthest 1.73 cells off.
const SHELL: f32 = 1.75

/// How far off its surface (cells) a texel's rays start.
const LIFT: f32 = 0.75

/// The most steps a light ray takes, the most sky rays a texel takes a sweep, and the texels
/// lit a dispatch (its bound of work times these stays under the host's step limit).
const LIGHT_STEPS: u32 = 96
const MOST_RAYS: u32 = 8
const LIGHT_BAND: u32 = 65536

/// How many sweeps' worth the stored light still counts for once the sun has moved, where the
/// form's own light is in it.
const FORGET: u32 = 4

/// Where atlas texel `i` (as the deposit numbers them: a brick's 729 in turn) is in the atlas.
fn texel_of(i: u32) -> vec3u {
    let slot = i / (BS * BS * BS)
    let k = i % (BS * BS * BS)
    vec3u(
        (slot % ROW) * BS + k % BS,
        ((slot / ROW) % ROW) * BS + (k / BS) % BS,
        (slot / (ROW * ROW)) * BS + k / (BS * BS),
    )
}

/// Where atlas texel `i` is in the world.
fn place_of(g: Grid, bricks: [u32], i: u32) -> vec3 {
    let k = i % (BS * BS * BS)
    let c = bricks[i / (BS * BS * BS)]
    let at = vec3(f32(c & 1023), f32((c >> 10) & 1023), f32(c >> 20))
    let local = vec3(f32(k % BS), f32((k / BS) % BS), f32(k / (BS * BS)))
    g.lo + (at * f32(B) + local) * g.cell
}

/// Atlas texels `first` on that hold light (within `SHELL` cells of the surface, their place on
/// it in the open), listed.
@compute(64)
fn shelled(g: Grid, atlas: Texture3d<Rgba16Float>, first: u32, out: mut Append<u32>, id: GlobalId) {
    let i = first + id.x
    if i / (BS * BS * BS) >= g.size.w {
        return
    }
    let x = texel_of(i)
    let v = atlas.load(x.x, x.y, x.z)
    if abs(v.x) < SHELL * g.cell && dot(v.yzw, v.yzw) > 0.0 {
        let _ = out.push(i)
    }
}

/// Whether a ray from `o` along `d` meets the form within `to` m (`x` 1 or 0), and how far along
/// it (`y`). A thin ray, stepped by the stored distance (a quarter cell at the least), through
/// bricks that hold nothing by the count of cells to the nearest that does.
fn reaches(g: Grid, coarse: Texture3d<Rg32Uint>, atlas: Texture3d<Rgba16Float>, s: Sampler, o: vec3, d: vec3, to: f32) -> vec2 {
    let brick = g.cell * f32(B)
    let top = vec3(f32(g.size.x - 1), f32(g.size.y - 1), f32(g.size.z - 1))
    let nudge = 0.02 * brick
    let least = 0.25 * g.cell
    let touch = 0.05 * g.cell
    var t = 0.0
    var met = false
    var steps: u32 = 0
    while steps < LIGHT_STEPS && !met && t < to {
        steps += 1
        let p = o + d * t
        let q = (p - g.lo) / brick
        let c = clamp(floor(q), vec3(0.0), top)
        let k = coarse.load(u32(c.x), u32(c.y), u32(c.z))
        if k.x >= FAR_FROM {
            if bitcast_f32(k.y) < 0.0 {
                met = true
            } else {
                let lo = g.lo + c * brick
                let ex = if d.x > 0.0 { (lo.x + brick - p.x) / d.x } else if d.x < 0.0 { (lo.x - p.x) / d.x } else { 1.0e30 }
                let ey = if d.y > 0.0 { (lo.y + brick - p.y) / d.y } else if d.y < 0.0 { (lo.y - p.y) / d.y } else { 1.0e30 }
                let ez = if d.z > 0.0 { (lo.z + brick - p.z) / d.z } else if d.z < 0.0 { (lo.z - p.z) / d.z } else { 1.0e30 }
                t += max(min(ex, min(ey, ez)), f32(min(k.x & 255, RINGS + 1) - 1) * brick) + nudge
            }
        } else {
            let a = vec3(f32(k.x % ROW), f32((k.x / ROW) % ROW), f32(k.x / (ROW * ROW))) * f32(BS)
            let local = clamp((q - c) * f32(B), vec3(0.0), vec3(f32(B)))
            let v = atlas.sample_level(s, (a + local + vec3(0.5)) / g.atlas, 0.0)
            if v.x < touch {
                met = true
            } else {
                t += max(v.x, least)
            }
        }
    }
    vec2(if met { 1.0 } else { 0.0 }, t)
}

/// What the form gives back at `p` (on its surface): the light stored there by its albedo (its
/// radiance times π), or nothing where no brick holds it; shared among the texels round it
/// that are in the open (the albedo's alpha).
fn given_at(
    g: Grid,
    coarse: Texture3d<Rg32Uint>,
    irr: Texture3d<Rgba16Float>,
    albedo: Texture3d<Rgba8>,
    s: Sampler,
    p: vec3,
) -> vec3 {
    let brick = g.cell * f32(B)
    let top = vec3(f32(g.size.x - 1), f32(g.size.y - 1), f32(g.size.z - 1))
    let q = (p - g.lo) / brick
    let c = clamp(floor(q), vec3(0.0), top)
    let k = coarse.load(u32(c.x), u32(c.y), u32(c.z))
    if k.x >= FAR_FROM {
        return vec3(0.0)
    }
    let a = vec3(f32(k.x % ROW), f32((k.x / ROW) % ROW), f32(k.x / (ROW * ROW))) * f32(BS)
    let local = clamp((q - c) * f32(B), vec3(0.0), vec3(f32(B)))
    let uvw = (a + local + vec3(0.5)) / g.atlas
    let r = albedo.sample_level(s, uvw, 0.0)
    if r.w < 0.02 {
        return vec3(0.0)
    }
    irr.sample_level(s, uvw, 0.0).xyz * r.xyz * r.xyz / r.w
}

/// Two numbers in [0, 1) from three whole ones.
fn hashed2(a: u32, b: u32, c: u32) -> vec2 {
    let h = hash_u32(a ^ hash_u32(b ^ hash_u32(c)))
    let k = hash_u32(h)
    vec2(f32(h >> 8), f32(k >> 8)) / 16777216.0
}

/// The light on the listed texels `first` on, this sweep, four words a texel. With `part`'s
/// first bit, whether the sun reaches it (a ray toward `sun` gets through): its fourth word, 1
/// or 0, replaced. With its second bit, the light that isn't straight from the sun: the sky's
/// (`sky_e`: what an open sky lays on a face) over `rays` rays, and, with `bounce`, what the
/// form gives back where a sky ray stops; added into the running mean of the sweeps so far
/// (`sweep` of them), its first three words.
@compute(64)
fn lit_cells(
    g: Grid,
    bricks: [u32],
    shell: [u32],
    coarse: Texture3d<Rg32Uint>,
    atlas: Texture3d<Rgba16Float>,
    albedo: Texture3d<Rgba8>,
    irr: Texture3d<Rgba16Float>,
    s: Sampler,
    sun: vec3,
    sun_e: vec3,
    sky_e: vec3,
    bounce: u32,
    rays: u32,
    sweep: u32,
    part: u32,
    first: u32,
    count: u32,
    out: mut Atomics<u32>,
    id: GlobalId,
) {
    if first + id.x >= count {
        return
    }
    let i = shell[first + id.x]
    let x = texel_of(i)
    let v = atlas.load(x.x, x.y, x.z)
    let n = normalize(v.yzw)
    let o = place_of(g, bricks, i) - n * v.x + n * (LIFT * g.cell)
    let side = g.cell * f32(B) * f32(g.size.x)
    let far = 2.0 * side
    if (part & 1) != 0 {
        let seen = dot(n, sun) > 0.0 && reaches(g, coarse, atlas, s, o, sun, far).x < 0.5
        let _ = out.exchange(i: 4 * i + 3, value: bitcast_u32(if seen { 1.0 } else { 0.0 }))
    }
    if (part & 2) == 0 {
        return
    }
    var e = vec3(0.0)
    // The sky's rays: over the hemisphere round the facing, more of them where they count for
    // more (by the cosine), so each counts alike.
    let up = if abs(n.y) < 0.99 { vec3(0.0, 1.0, 0.0) } else { vec3(1.0, 0.0, 0.0) }
    let across = normalize(cross(up, n))
    let along = cross(n, across)
    for r in 0..MOST_RAYS {
        if r < rays {
            let u = hashed2(i, sweep, r)
            let ring = sqrt(u.x)
            let turn = 6.2831853 * u.y
            let d = normalize(across * (ring * cos(turn)) + along * (ring * sin(turn)) + n * sqrt(1.0 - u.x))
            let w = reaches(g, coarse, atlas, s, o, d, far)
            if w.x < 0.5 {
                e += sky_e / f32(rays)
            } else if bounce == 1 {
                e += given_at(g, coarse, irr, albedo, s, o + d * w.y) / f32(rays)
            }
        }
    }
    if sweep > 0 {
        let was = vec3(bitcast_f32(out.load(4 * i)), bitcast_f32(out.load(4 * i + 1)), bitcast_f32(out.load(4 * i + 2)))
        e = was + (e - was) / f32(sweep + 1)
    }
    let _ = out.exchange(i: 4 * i, value: bitcast_u32(e.x))
    let _ = out.exchange(i: 4 * i + 1, value: bitcast_u32(e.y))
    let _ = out.exchange(i: 4 * i + 2, value: bitcast_u32(e.z))
}

/// The stored light put in its textures. `out`: all the light on each texel (the sun's by the
/// texel's own facing, where it reaches it), which a bounce reads, and whether the sun reaches
/// it. `glowing`: what its surface gives back toward an eye of the light that isn't straight
/// from the sun (its albedo's share over π, its square root in 8 bits as the albedo is), and
/// whether the sun reaches it: an eye adds the sun's by its own pixel's facing.
@compute(4, 4, 4)
fn light_copied(
    raw: [u32],
    g: Grid,
    atlas: Texture3d<Rgba16Float>,
    albedo: Texture3d<Rgba8>,
    sun: vec3,
    sun_e: vec3,
    out: mut Texels3d<Rgba16Float>,
    glowing: mut Texels3d<Rgba8>,
    id: GlobalId,
) {
    let slot = id.x / BS + ROW * (id.y / BS + ROW * (id.z / BS))
    if slot >= g.size.w {
        out.store(id, vec4(0.0))
        glowing.store(id, vec4(0.0))
        return
    }
    let i = slot * BS * BS * BS + id.x % BS + BS * (id.y % BS + BS * (id.z % BS))
    let e = vec3(bitcast_f32(raw[4 * i]), bitcast_f32(raw[4 * i + 1]), bitcast_f32(raw[4 * i + 2]))
    let seen = bitcast_f32(raw[4 * i + 3])
    let r = albedo.load(id.x, id.y, id.z).xyz
    let v = atlas.load(id.x, id.y, id.z)
    let toward = if dot(v.yzw, v.yzw) > 0.0 { max(dot(normalize(v.yzw), sun), 0.0) } else { 0.0 }
    out.store(id, vec4(e + sun_e * (toward * seen), seen))
    glowing.store(id, vec4(sqrt(saturate(r * r * e / 3.14159265)), seen))
}

/// The leak test's sums over the listed texels `first` on, for a wall across z = 0 whose faces
/// are `half` m off it, the sun on its +z side: the light (in thousandths) on its lit face, on
/// its dark face, and on the ground (its top `ground` m up) in its shadow, and how many texels
/// each is of.
@compute(64)
fn leak_summed(
    g: Grid,
    bricks: [u32],
    shell: [u32],
    atlas: Texture3d<Rgba16Float>,
    raw: [u32],
    sun: vec3,
    sun_e: vec3,
    half: f32,
    ground: f32,
    count: u32,
    out: mut Atomics<u32>,
    id: GlobalId,
) {
    if id.x >= count {
        return
    }
    let i = shell[id.x]
    let x = texel_of(i)
    let v = atlas.load(x.x, x.y, x.z)
    if abs(v.x) > 0.6 * g.cell {
        return
    }
    let n = normalize(v.yzw)
    let q = place_of(g, bricks, i) - n * v.x
    let direct = sun_e * (max(dot(n, sun), 0.0) * bitcast_f32(raw[4 * i + 3]))
    let e = (bitcast_f32(raw[4 * i]) + bitcast_f32(raw[4 * i + 1]) + bitcast_f32(raw[4 * i + 2]) + direct.x + direct.y + direct.z) / 3.0
    let k = u32(max(e, 0.0) * 1000.0)
    if abs(q.x) < 2.5 && q.y > 0.3 && q.y < 2.7 {
        if n.z > 0.7 && abs(q.z - half) < 0.03 {
            let _ = out.add(i: 0, value: k)
            let _ = out.add(i: 1, value: 1)
        }
        if n.z < -0.7 && abs(q.z + half) < 0.03 {
            let _ = out.add(i: 2, value: k)
            let _ = out.add(i: 3, value: 1)
        }
    }
    if abs(q.x) < 2.0 && abs(q.y - ground) < 0.03 && n.y > 0.7 && q.z < -0.3 && q.z > -1.0 {
        let _ = out.add(i: 4, value: k)
        let _ = out.add(i: 5, value: 1)
    }
}

/// A pixel of the form, marched through its volume and lit from its cells: what its surface gives
/// back of the stored light, and of the sun's, by the pixel's own facing, where the sun reaches
/// it. Whether it does is read from the cells round it; where they disagree (a shadow's edge
/// crosses them) and `sharp` is set, a ray of the pixel's own through the same volume says.
@fragment
pub fn marched_lit(
    pixel: FragCoord,
    eye: Eye,
    g: Grid,
    coarse: Texture3d<Rg32Uint>,
    atlas: Texture3d<Rgba16Float>,
    albedo: Texture3d<Rgba8>,
    glowing: Texture3d<Rgba8>,
    s: Sampler,
    sun: vec3,
    sun_e: vec3,
    sharp: u32,
    body: u32,
) -> WithDepth<Targets3<vec4, vec4, u32>> {
    let d = eye.ray(pixel.position.xy)
    let span = crossing(eye, g, d)
    if !(span.x < span.y) {
        return nothing()
    }
    let met = walk(g, coarse, atlas, s, eye.at, d, from: span.x, to: span.y, px: eye.pixel(), near: 0.0)
    if !met.met {
        return nothing()
    }
    let brick = g.cell * f32(B)
    let top = vec3(f32(g.size.x - 1), f32(g.size.y - 1), f32(g.size.z - 1))
    var t = met.t
    var v = met.v
    for k in 0..2 {
        if k < met.again {
            t += v.x / max(-dot(v.yzw, d), 0.25)
            let w = field_at(g, coarse, atlas, s, brick, top, eye.at + d * t)
            if w.y != 0.0 || w.z != 0.0 || w.w != 0.0 {
                v = w
            }
        }
    }
    let p = eye.at + d * t
    let n = normalize(v.yzw)
    let q = (p - g.lo) / brick
    let c = clamp(floor(q), vec3(0.0), top)
    let k = coarse.load(u32(c.x), u32(c.y), u32(c.z))
    var colour = vec3(0.0)
    if k.x < FAR_FROM {
        let a = vec3(f32(k.x % ROW), f32((k.x / ROW) % ROW), f32(k.x / (ROW * ROW))) * f32(BS)
        let local = clamp((q - c) * f32(B), vec3(0.0), vec3(f32(B)))
        let uvw = (a + local + vec3(0.5)) / g.atlas
        // (Shared among the texels round it that are in the open: a buried one holds nothing.)
        let wear = albedo.sample_level(s, uvw, 0.0)
        let open = max(wear.w, 0.02)
        let glow = glowing.sample_level(s, uvw, 0.0) / open
        colour = glow.xyz * glow.xyz
        let toward = dot(n, sun)
        if toward > 0.0 {
            var seen = glow.w
            if sharp != 0 && seen > 0.02 && seen < 0.98 {
                let side = brick * f32(g.size.x)
                seen = if reaches(g, coarse, atlas, s, p + n * (LIFT * g.cell), sun, 2.0 * side).x < 0.5 { 1.0 } else { 0.0 }
                if sharp == 2 {
                    colour = vec3(100.0, 0.0, 0.0)
                }
            }
            colour += wear.xyz * wear.xyz * sun_e * (toward * seen / 3.14159265)
        }
        if sharp == 3 {
            // (Why a pixel is dark: green, every texel round it buried; blue, facing off the sun
            // and no stored light; else its facing.)
            colour = if wear.w < 0.02 { vec3(0.0, 1.0, 0.0) } else if toward <= 0.0 && glow.x + glow.y + glow.z < 0.01 { vec3(0.0, 0.0, 1.0) } else { vec3(0.3) + 0.3 * n }
        }
    } else if sharp == 3 {
        // (Red: where the walk stopped, no brick is kept.)
        colour = vec3(1.0, 0.0, 0.0)
    }
    WithDepth {
        color: Targets3 { first: vec4(colour, 0.0), second: edge_record(NO_EDGE, 1.0, NO_LINE), third: identity(SOLID, body: body, group: 0) },
        depth: eye.depth(p),
    }
}

impl<S: Solid> Volume<S> {
    /// A frame's lighting. The shell is listed once. Then, whenever the sun has moved, every
    /// cell asks again whether it reaches it, within the frame; and the rest of the light (the
    /// sky's, the form's own) is swept `bands` dispatches a frame until `settled` sweeps are in
    /// it, after which a frame in which nothing changed costs nothing. The light's textures
    /// are written again whenever either changed them.
    pub fn relit(mut self, sun: vec3, sun_e: vec3, sky_e: vec3, bounce: bool, rays: u32, bands: u32, settled: u32) {
        let texels = self.grid.size.w * BS * BS * BS
        if self.light_stage == 0 {
            label("shelled")
            self.shell = append_buffer(texels)
            self.light_raw = buffer(max(4 * texels, 4))
            let size = vec3u(u32(self.grid.atlas.x), u32(self.grid.atlas.y), u32(self.grid.atlas.z))
            self.irr = texture3d(width: size.x, height: size.y, depth: size.z)
            self.glowing = texture3d(width: size.x, height: size.y, depth: size.z)
            var first: u32 = 0
            for _b in 0..64 {
                if first < texels {
                    dispatch(shelled.bind(g: self.grid, atlas: self.atlas, first: first, out: mut self.shell), over: BAND)
                    first += BAND
                }
            }
            self.shell_asked = Some(read(self.shell.count()))
            self.light_stage = 1
            return
        }
        if self.light_stage == 1 {
            match mut self.shell_asked {
                Some(p) => match p.poll() {
                    Some(Ok(v)) => {
                        self.shell_count = v[0]
                        print(f"light: {v[0]} texels hold light, of {texels} in the atlas")
                        self.shell_asked = None
                        self.light_stage = 2
                    },
                    _ => {},
                },
                None => {},
            }
            return
        }
        // The sun moved (or was never asked about): every cell asks again whether it reaches it,
        // now; and where the form's own light is counted, the light stored forgets most of what
        // it held (it was the old sun's).
        var copy = false
        if sun.x != self.lit_sun.x || sun.y != self.lit_sun.y || sun.z != self.lit_sun.z {
            label("sun asked")
            var first: u32 = 0
            for _b in 0..1024 {
                if first < self.shell_count {
                    self.lit_band(sun, sun_e, sky_e, bounce, rays, part: 1, first: first)
                    first += LIGHT_BAND
                }
            }
            self.lit_sun = sun
            if bounce {
                self.sweeps = min(self.sweeps, FORGET)
            }
            copy = true
        }
        // The rest of the light, `bands` dispatches of it a frame, until it has settled.
        if self.sweeps < settled {
            label("relit")
            for _b in 0..bands {
                if self.light_cursor < self.shell_count {
                    self.lit_band(sun, sun_e, sky_e, bounce, rays, part: 2, first: self.light_cursor)
                    self.light_cursor += LIGHT_BAND
                }
            }
            if self.light_cursor >= self.shell_count {
                self.light_cursor = 0
                self.sweeps += 1
                copy = true
            }
        }
        if copy {
            label("light copied")
            dispatch(
                light_copied.bind(
                    raw: self.light_raw.items(),
                    g: self.grid,
                    atlas: self.atlas,
                    albedo: self.albedo,
                    sun: sun,
                    sun_e: sun_e,
                    out: mut self.irr,
                    glowing: mut self.glowing,
                ),
                over: self.irr,
            )
        }
    }

    /// One dispatch of the lighting (`lit_cells`): `LIGHT_BAND` of the listed texels, `first` on.
    fn lit_band(mut self, sun: vec3, sun_e: vec3, sky_e: vec3, bounce: bool, rays: u32, part: u32, first: u32) {
        dispatch(
            lit_cells.bind(
                g: self.grid,
                bricks: self.bricks.items(),
                shell: self.shell.items(),
                coarse: self.coarse,
                atlas: self.atlas,
                albedo: self.albedo,
                irr: self.irr,
                s: self.s,
                sun: sun,
                sun_e: sun_e,
                sky_e: sky_e,
                bounce: if bounce { 1 } else { 0 },
                rays: rays,
                sweep: self.sweeps,
                part: part,
                first: first,
                count: self.shell_count,
                out: mut self.light_raw,
            ),
            over: LIGHT_BAND,
        )
    }

    /// The form marched at every pixel into `frame`'s picture, each pixel showing what its
    /// surface gives back of the light stored there, and of the sun's by its own facing. `sharp`
    /// 1: where the cells round a pixel disagree on whether the sun reaches them, the pixel asks
    /// by a ray of its own; 2: those pixels shown red, to count them.
    pub fn draw_lit_into(self, frame: mut Frame, sun: vec3, sun_e: vec3, sharp: u32, body: u32) {
        let g = self.grid
        label("marched")
        let first = frame.first()
        let q = begin_pass3_with_depth(
            mut frame.colour,
            mut frame.edge,
            mut frame.identity,
            mut frame.depth,
            clear: vec4(0.0),
            keep: !first,
            clear_depth: 0.0,
            keep_depth: !first,
        )
        draw(
            q,
            cover,
            marched_lit.bind(
                eye: frame.eye,
                g: g,
                coarse: self.coarse,
                atlas: self.atlas,
                albedo: self.albedo,
                glowing: self.glowing,
                s: self.s,
                sun: sun,
                sun_e: sun_e,
                sharp: sharp,
                body: body,
            ),
            vertices: 3,
            depth: NEARER,
        )
        q.end()
    }

    /// The leak test's sums, asked for (`leak_summed`).
    pub fn leak_asked(self, sun: vec3, sun_e: vec3, half: f32, ground: f32) -> Pending<u32> {
        label("judge")
        var out: GpuBuffer<u32> = buffer_of(Vec::filled(6, 0))
        dispatch(
            leak_summed.bind(
                g: self.grid,
                bricks: self.bricks.items(),
                shell: self.shell.items(),
                atlas: self.atlas,
                raw: self.light_raw.items(),
                sun: sun,
                sun_e: sun_e,
                half: half,
                ground: ground,
                count: self.shell_count,
                out: mut out,
            ),
            over: self.shell_count,
        )
        read(out.items())
    }
}

/// How far along a ray from `o` along `d` it meets `form` (under 0: not within `far` m): by its
/// distance, which is exact.
fn met_at<F: Solid>(form: F, o: vec3, d: vec3, far: f32) -> f32 {
    var t = 0.0
    var met = false
    var steps: u32 = 0
    while steps < 160 && !met && t < far {
        steps += 1
        let v = form.distance(o + d * t)
        if v < 0.0005 {
            met = true
        } else {
            t += v
        }
    }
    if met { t } else { -1.0 }
}

/// Whether a ray from `o` along `d` meets `form` within `far` m.
fn blocked<F: Solid>(form: F, o: vec3, d: vec3, far: f32) -> bool {
    met_at(form, o, d, far) >= 0.0
}

/// One more look of the light's reference at a pixel, added to the looks so far: the form
/// itself met along the pixel's ray, and what it gives back there under the same sun and sky by
/// rays against the form itself: each sky ray that meets the form followed on, `bounces` times,
/// taking the sun's light where it stops and going on by one ray more. Its alpha counts the
/// looks that met the form.
@fragment
pub fn lit_truly<F: Solid, L: Look>(
    pixel: FragCoord,
    eye: Eye,
    form: F,
    look: L,
    bound: vec4,
    sun: vec3,
    sun_e: vec3,
    sky_e: vec3,
    rays: u32,
    bounces: u32,
    looks: u32,
    sofar: Texture<Rgba32Float>,
) -> vec4 {
    let before = if looks > 0 { sofar.load(u32(pixel.position.x), u32(pixel.position.y)) } else { vec4(0.0) }
    let d = eye.ray(pixel.position.xy)
    let oc = eye.at - bound.xyz
    let b = dot(oc, d)
    let h = b * b - (dot(oc, oc) - bound.w * bound.w)
    if !(h >= 0.0) {
        return before
    }
    var t = max(-b - sqrt(h), eye.near)
    let end = -b + sqrt(h)
    var met = false
    var steps: u32 = 0
    while steps < 256 && !met && t < end {
        steps += 1
        let v = form.distance(eye.at + d * t)
        if v < 0.0002 * t {
            met = true
        } else {
            t += v
        }
    }
    if !met {
        return before
    }
    let p = eye.at + d * t
    let n = normalize(form.gradient(p))
    let o = p + n * 0.01
    var e = vec3(0.0)
    let toward = dot(n, sun)
    if toward > 0.0 && !blocked(form, o, sun, 40.0) {
        e += sun_e * toward
    }
    let up = if abs(n.y) < 0.99 { vec3(0.0, 1.0, 0.0) } else { vec3(1.0, 0.0, 0.0) }
    let across = normalize(cross(up, n))
    let along = cross(n, across)
    let at = u32(pixel.position.x) + 8192 * u32(pixel.position.y)
    for r in 0..MOST_RAYS {
        if r < rays {
            let u = hashed2(at, looks, r)
            let ring = sqrt(u.x)
            let turn = 6.2831853 * u.y
            var way = normalize(across * (ring * cos(turn)) + along * (ring * sin(turn)) + n * sqrt(1.0 - u.x))
            var from = o
            var share = vec3(1.0 / f32(rays))
            var depth: u32 = 0
            var going = true
            while going {
                let far = met_at(form, from, way, 40.0)
                if far < 0.0 {
                    e += share * sky_e
                    going = false
                } else if depth >= bounces {
                    going = false
                } else {
                    // What the form gives back where the ray stopped: the sun's light there, and
                    // (by the next turn of the loop) one ray's worth of everything else's.
                    let at_q = from + way * far
                    let nq = normalize(form.gradient(at_q))
                    let oq = at_q + nq * 0.01
                    share = share * look.skin(Place { world: at_q, rest: at_q, chart: None, normal: nq }).albedo
                    let lean = dot(nq, sun)
                    if lean > 0.0 && !blocked(form, oq, sun, 40.0) {
                        e += share * sun_e * lean
                    }
                    depth += 1
                    let uq = hashed2(at, looks, r + 8 * depth)
                    let upq = if abs(nq.y) < 0.99 { vec3(0.0, 1.0, 0.0) } else { vec3(1.0, 0.0, 0.0) }
                    let acq = normalize(cross(upq, nq))
                    let alq = cross(nq, acq)
                    let rq = sqrt(uq.x)
                    let tq = 6.2831853 * uq.y
                    way = normalize(acq * (rq * cos(tq)) + alq * (rq * sin(tq)) + nq * sqrt(1.0 - uq.x))
                    from = oq
                }
            }
        }
    }
    let skin = look.skin(Place { world: p, rest: p, chart: None, normal: n })
    before + vec4(skin.albedo * e / 3.14159265, 1.0)
}

/// How far the picture's surface may be from the form's (cells), and the least its facing may
/// agree with the form's (their dot: 15 degrees apart), for a pixel's surface to count as the
/// form's own: past either, what is wrong at the pixel is where the volume holds the surface (a
/// sharp edge it rounds, an outline a part of a pixel off), not the light on it.
const SAME_PLACE: f32 = 0.5
const SAME_FACING: f32 = 0.966

/// The picture's stored light against the reference's, counted over rows `first` on: pixels
/// both meet the form at; of them, those over 8 and over 16 of 255 apart (as a plain screen
/// shows them); the sum of how far apart (in hundredths of 255); and the same three again over
/// only the pixels whose surface is the form's own (`SAME_PLACE`, `SAME_FACING`), after their
/// count.
@compute(8, 8)
fn light_judged<F: Solid>(
    colour: Texture<Rgba16Float>,
    depth: DepthTexture,
    truth: Texture<Rgba32Float>,
    looks: f32,
    eye: Eye,
    form: F,
    bound: vec4,
    g: Grid,
    coarse: Texture3d<Rg32Uint>,
    atlas: Texture3d<Rgba16Float>,
    s: Sampler,
    first: u32,
    out: mut Atomics<u32>,
    id: GlobalId,
) {
    let y = first + id.y
    if id.x >= colour.width() || y >= colour.height() {
        return
    }
    let b = truth.load(id.x, y)
    let z = depth.load(id.x, y)
    if z <= 0.0 || b.w < 0.99 * looks {
        return
    }
    let apart = abs(as_seen(colour.load(id.x, y).xyz) - as_seen(b.xyz / b.w)) * 255.0
    let most = max(apart.x, max(apart.y, apart.z))
    let _ = out.add(i: 0, value: 1)
    if most > 8.0 {
        let _ = out.add(i: 1, value: 1)
    }
    if most > 16.0 {
        let _ = out.add(i: 2, value: 1)
    }
    let _ = out.add(i: 3, value: u32(most * 100.0))
    // The form itself along the pixel's ray, as the reference meets it.
    let at = vec2(f32(id.x) + 0.5, f32(y) + 0.5)
    let d = eye.ray(at)
    let oc = eye.at - bound.xyz
    let half = dot(oc, d)
    let h = half * half - (dot(oc, oc) - bound.w * bound.w)
    if !(h >= 0.0) {
        return
    }
    var t = max(-half - sqrt(h), eye.near)
    let end = -half + sqrt(h)
    var met = false
    var steps: u32 = 0
    while steps < 256 && !met && t < end {
        steps += 1
        let v = form.distance(eye.at + d * t)
        if v < 0.0002 * t {
            met = true
        } else {
            t += v
        }
    }
    if !met {
        return
    }
    let p = eye.at + d * t
    let n = normalize(form.gradient(p))
    let shown = eye.place(at, z)
    let brick = g.cell * f32(B)
    let top = vec3(f32(g.size.x - 1), f32(g.size.y - 1), f32(g.size.z - 1))
    let w = field_at(g, coarse, atlas, s, brick, top, shown)
    if length(shown - p) > SAME_PLACE * g.cell || dot(w.yzw, w.yzw) == 0.0 || dot(normalize(w.yzw), n) < SAME_FACING {
        return
    }
    let _ = out.add(i: 4, value: 1)
    if most > 8.0 {
        let _ = out.add(i: 5, value: 1)
    }
    if most > 16.0 {
        let _ = out.add(i: 6, value: 1)
    }
    let _ = out.add(i: 7, value: u32(most * 100.0))
}

/// The light's reference: the looks added up so far (by turns, into one of two), and how many.
pub struct LitTruth {
    even: Texture<Rgba32Float>,
    odd: Texture<Rgba32Float>,
    pub looks: u32,
}

pub fn lit_truth() -> LitTruth {
    LitTruth { even: texture(width: 1, height: 1), odd: texture(width: 1, height: 1), looks: 0 }
}

impl LitTruth {
    /// One more look of the reference (`lit_truly`), as `eye` sees `form`.
    pub fn look<F: Solid, L: Look>(mut self, eye: Eye, form: F, look: L, sun: vec3, sun_e: vec3, sky_e: vec3, rays: u32, bounces: u32) {
        let w = u32(eye.size.x)
        let h = u32(eye.size.y)
        if self.even.width() != w || self.even.height() != h {
            self.even = texture(width: w, height: h)
            self.odd = texture(width: w, height: h)
            self.looks = 0
        }
        let b = form.bound()
        label("light reference")
        if self.looks % 2 == 0 {
            let p = begin_pass(mut self.even, clear: vec4(0.0))
            draw(
                p,
                cover,
                lit_truly.bind(eye: eye, form: form, look: look, bound: vec4(b.centre, b.radius), sun: sun, sun_e: sun_e, sky_e: sky_e, rays: rays, bounces: bounces, looks: self.looks, sofar: self.odd),
                vertices: 3,
            )
            p.end()
        } else {
            let p = begin_pass(mut self.odd, clear: vec4(0.0))
            draw(
                p,
                cover,
                lit_truly.bind(eye: eye, form: form, look: look, bound: vec4(b.centre, b.radius), sun: sun, sun_e: sun_e, sky_e: sky_e, rays: rays, bounces: bounces, looks: self.looks, sofar: self.even),
                vertices: 3,
            )
            p.end()
        }
        self.looks += 1
    }

    /// `frame`'s picture (before its last pass) of `vol` against the reference, counted and
    /// asked for (`light_judged`), 64 rows a dispatch.
    pub fn judged<F: Solid>(self, frame: Frame, form: F, vol: Volume<F>) -> Pending<u32> {
        let w = u32(frame.eye.size.x)
        let h = u32(frame.eye.size.y)
        let b = form.bound()
        label("judge")
        var out: GpuBuffer<u32> = buffer_of(Vec::filled(8, 0))
        var first: u32 = 0
        for _b in 0..64 {
            if first < h {
                if self.looks % 2 == 1 {
                    dispatch(
                        light_judged.bind(
                            colour: frame.colour,
                            depth: frame.depth,
                            truth: self.even,
                            looks: f32(self.looks),
                            eye: frame.eye,
                            form: form,
                            bound: vec4(b.centre, b.radius),
                            g: vol.grid,
                            coarse: vol.coarse,
                            atlas: vol.atlas,
                            s: vol.s,
                            first: first,
                            out: mut out,
                        ),
                        groups: ((w + 7) / 8, 8, 1),
                    )
                } else {
                    dispatch(
                        light_judged.bind(
                            colour: frame.colour,
                            depth: frame.depth,
                            truth: self.odd,
                            looks: f32(self.looks),
                            eye: frame.eye,
                            form: form,
                            bound: vec4(b.centre, b.radius),
                            g: vol.grid,
                            coarse: vol.coarse,
                            atlas: vol.atlas,
                            s: vol.s,
                            first: first,
                            out: mut out,
                        ),
                        groups: ((w + 7) / 8, 8, 1),
                    )
                }
                first += 64
            }
        }
        read(out.items())
    }
}
